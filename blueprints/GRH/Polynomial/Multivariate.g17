-- Polynomials in a set I of variables over a commutative ring R, on top
-- of Cumulus's polynomialRing(R, I) (finitely supported maps from the
-- exponent maps monomials(I) to R): coefficients, monomials, the
-- constant coefficient, support and variables, evaluation in an algebra
-- (MvPolynomial.aeval) and along a ring homomorphism (eval₂Hom),
-- renaming of variables (rename), substitution of polynomials for
-- variables (bind₁), coefficient maps (MvPolynomial.map), partial
-- derivatives (pderiv), the total degree, homogeneous polynomials and
-- components, polynomials with restricted support, induction on
-- polynomials, and MvPolynomial.funext.
-- Part of the GRH blueprint.
-- Planned home: Algebra/Polynomial/Multivariate.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Polynomial.Multivariate
import GRH.Polynomial.Univariate
import GRH.Linear.Tensor
import Grace.Cumulus.Cardinal.NaturalSum
import Grace.Cumulus.Algebra.Polynomial.Variables

-- Section: Coefficients and monomials
-- The coefficient of the monomial m (MvPolynomial.coeff), the monomial
-- a X^m (MvPolynomial.monomial), and the constant a (MvPolynomial.C).
def mvCoeff (p m : Set) : Set := p(m)

def mvMonomial (R I m a : Set) : Set :=
  coefficientSingle(monomials(I), Ring.carrier(R), Ring.zero(R), a, m)

def mvC (R I a : Set) : Set := polynomialConstant(R, I)(a)

-- The support {m | coeff m p ≠ 0} (MvPolynomial.support), the variables
-- occurring in p (MvPolynomial.vars, Cumulus's polynomialVariablesUsed),
-- and the constant coefficient p(0) (MvPolynomial.constantCoeff).
def mvSupport (R I p : Set) : Set := functionSupport(p, monomials(I), Ring.zero(R))

def mvVars (R I p : Set) : Set :=
  polynomialVariablesUsed(I, Ring.carrier(R), Ring.zero(R), p)

def mvConstantCoeff (R I p : Set) : Set := p(monomialOne(I))

-- The degree Σᵢ m(i) of a monomial, the total degree of p, the largest
-- degree in its support (0 for p = 0) (MvPolynomial.totalDegree).
def monomialDegree (I m : Set) : Set := natSum(functionSupport(m, I, 0), m)

-- Helper: the degree of a monomial is a natural number, and m ↦ deg m as
-- a function on the monomials.
theorem mv.monomial_degree_nat (I m : Set)
  requires member : m ∈ monomials(I)
  shows Nat(monomialDegree(I, m))
proof
  have map := monomials.map with member
  obtain ⟨_, finite⟩ := map
  have weights : ∀ v ∈ functionSupport(m, I, 0), m(v) ∈ ℕ
    intros v hv
    obtain ⟨vIn, _⟩ := functionSupport.membership.forward with hv
    have e := monomials.exponent at I, m, v with member, vIn
    exact nat.omega.forward with e
  unfold monomialDegree
  exact natSum.natural with finite, weights

defgraph monomialDegreeMap (I : Set) (m ∈ monomials(I)) : ℕ := monomialDegree(I, m)
proof
  have n := mv.monomial_degree_nat at I, m with member
  exact nat.omega.forward with n

defunique mvTotalDegree (R I p : Set) (d ∈ ℕ) :=
  (mvSupport(R, I, p) = ∅ ∧ d = 0) ∨
  ((∃ m ∈ mvSupport(R, I, p), monomialDegree(I, m) = d) ∧
    (∀ m ∈ mvSupport(R, I, p), monomialDegree(I, m) ≤ d))
requires ring : CommRing(R)
requires member : p ∈ Ring.carrier(polynomialRing(R, I))
proof
  have polys := polynomialRing.comm_ring at R, I with ring
  have pp := polynomialRing.member_parts at R, I, p with ring, polys, member
  have finite := polynomials.finite_support with pp
  have domain := functionSupport.subset at p, monomials(I), R.zero
  have dmap := monomialDegreeMap.function at I
  have imageFinite := Finite.function_image with dmap, finite, domain
  have naturals := functionImage.subset at monomialDegreeMap(I), functionSupport(p, monomials(I), R.zero), ℕ
  by_cases empty : mvSupport(R, I, p) = ∅
  . witness 0
    have zN : (0:Nat) ∈ ℕ by typecheck
    refine ⟨zN, ?_⟩
    left
    exact ⟨empty, rfl⟩
  . have ne := Nonempty.of_ne_empty with empty
    obtain ⟨m0, hm0⟩ := ne
    unfold mvSupport at hm0
    obtain ⟨m0In, _⟩ := functionSupport.membership.forward with hm0
    have v0 := monomialDegreeMap.value at I, m0 with m0In
    have d0 := FunctionBetween.apply_closed with dmap, m0In
    have img0 : monomialDegreeMap(I)(m0) ∈ functionImage(monomialDegreeMap(I), functionSupport(p, monomials(I), R.zero), ℕ)
      apply functionImage.membership.backward
      refine ⟨d0, m0, hm0, rfl⟩
    have inhabited : Nonempty(functionImage(monomialDegreeMap(I), functionSupport(p, monomials(I), R.zero), ℕ)) := ⟨monomialDegreeMap(I)(m0), img0⟩
    obtain ⟨n, nN, nIn, below⟩ := Finite.greatest_natural with inhabited, naturals, imageFinite
    have nNat := nat.omega.backward with nN
    witness n
    refine ⟨nN, ?_⟩
    right
    obtain ⟨_, m, hm, eq⟩ := functionImage.membership.forward with nIn
    have hm2 := hm
    obtain ⟨mIn, _⟩ := functionSupport.membership.forward with hm2
    rw (monomialDegreeMap.value at I, m with mIn) at eq
    have hmS : m ∈ mvSupport(R, I, p)
      unfold mvSupport
      exact hm
    refine ⟨⟨m, hmS, ?_⟩, ?_⟩
    . rw eq
    . intros k hk
      have hk2 := hk
      unfold mvSupport at hk2
      obtain ⟨kIn, _⟩ := functionSupport.membership.forward with hk2
      have dk := FunctionBetween.apply_closed with dmap, kIn
      have imgk : monomialDegreeMap(I)(k) ∈ functionImage(monomialDegreeMap(I), functionSupport(p, monomials(I), R.zero), ℕ)
        apply functionImage.membership.backward
        refine ⟨dk, k, hk2, rfl⟩
      have kb := below with monomialDegreeMap(I)(k), imgk
      rw (monomialDegreeMap.value at I, k with kIn) at kb
      have kNat := mv.monomial_degree_nat at I, k with kIn
      have lt := Less.of_membership at monomialDegree(I, k), succ(n)
      have l := lt with kb
      exact Less.successor_upper with l
uniqueness
  intros u hu first v hv second
  have uNat := nat.omega.backward with hu
  have vNat := nat.omega.backward with hv
  cases first with fe | fm
  . cases second with se | sm
    . have a := fe.right
      have b := se.right
      cc
    . obtain ⟨⟨m, hm, _⟩, _⟩ := sm
      have e := fe.left
      rw e at hm
      have no := empty.membership at m
      exfalso
      exact no with hm
  . cases second with se | sm
    . obtain ⟨⟨m, hm, _⟩, _⟩ := fm
      have e := se.left
      rw e at hm
      have no := empty.membership at m
      exfalso
      exact no with hm
    . obtain ⟨⟨m1, hm1, e1⟩, b1⟩ := fm
      obtain ⟨⟨m2, hm2, e2⟩, b2⟩ := sm
      have a := b1 with m2, hm2
      have b := b2 with m1, hm1
      rw e2 at a
      rw e1 at b
      exact LessEqual.antisymmetric with a, b

-- p is homogeneous of degree n (MvPolynomial.IsHomogeneous); the
-- homogeneous polynomials of degree n (homogeneousSubmodule); the degree-n
-- component of p (homogeneousComponent).
predicate MvHomogeneous (R I p n : Set) :=
  p ∈ Ring.carrier(polynomialRing(R, I)) ∧
  (∀ m ∈ mvSupport(R, I, p), monomialDegree(I, m) = n)

def homogeneousPolynomials (R I n : Set) : Set :=
  { p ∈ Ring.carrier(polynomialRing(R, I)) | MvHomogeneous(R, I, p, n) }

def homogeneousComponent (R I n p : Set) : Set :=
  { u ∈ monomials(I) × Ring.carrier(R) | ∃ m ∈ monomials(I),
    (monomialDegree(I, m) = n ∧ u = (m, p(m))) ∨
    (monomialDegree(I, m) ≠ n ∧ u = (m, Ring.zero(R))) }

-- The polynomials supported in a set s of monomials
-- (MvPolynomial.restrictSupport).
def restrictSupport (R I s : Set) : Set :=
  { p ∈ Ring.carrier(polynomialRing(R, I)) | mvSupport(R, I, p) ⊆ s }

-- The polynomial ring as an R-module (through track A's algebraModule).
def mvModule (R I : Set) : Set := algebraModule(polynomialAlgebra(R, I))

-- Section: Evaluation, renaming, substitution, coefficient maps
-- Evaluation along f : R →+* S at v : I → S (MvPolynomial.eval₂Hom) is
-- Cumulus's evaluationHom(R, S, I, f, v); at v : I → R (MvPolynomial.eval)
-- it is evaluationAt(R, I, v). In an R-algebra A at v : I → A
-- (MvPolynomial.aeval):
def mvAeval (A I v : Set) : Set :=
  evaluationHom(Algebra.base(A), Algebra.ring(A), I, Algebra.map(A), v)

-- Renaming along σ : I → J is Cumulus's polynomialRename(R, I, J, σ)
-- (MvPolynomial.rename). Substitution of g(i) ∈ R[J] for Xᵢ
-- (MvPolynomial.bind₁):
def mvBind (R I J g : Set) : Set :=
  evaluationHom(R, polynomialRing(R, J), I, polynomialConstant(R, J), g)

-- The coefficientwise image under f : R → S (MvPolynomial.map).
def mvMap (R S I f : Set) : Set :=
  polynomialMap(I, Ring.carrier(R), Ring.zero(R), Ring.carrier(S), Ring.zero(S), f)

-- The partial derivative ∂/∂Xᵢ is Cumulus's partialDerivative(R, I, i)
-- (MvPolynomial.pderiv).

-- The family i ↦ Xᵢ, and the composite assignment i ↦ φ(v(i)).
def mvVariables (R I : Set) : Set :=
  { u ∈ I × Ring.carrier(polynomialRing(R, I)) | ∃ i ∈ I, u = (i, X(R, I, i)) }

def assignmentImage (I B φ v : Set) : Set :=
  { u ∈ I × B | ∃ i ∈ I, u = (i, φ(v(i))) }

-- The family i ↦ aeval v (g(i)) of values of substituted polynomials.
def bindValues (A I J g v : Set) : Set :=
  { u ∈ I × algebraCarrier(A) | ∃ i ∈ I, u = (i, mvAeval(A, J, v)(g(i))) }

-- The family i ↦ bind g' (g(i)).
def bindCompose (R I J K g h : Set) : Set :=
  { u ∈ I × Ring.carrier(polynomialRing(R, K)) | ∃ i ∈ I,
    u = (i, mvBind(R, J, K, h)(g(i))) }

-- The coefficients m ↦ coeff m (p(k)) of a family, as a family over k.
def coefficientFamily (R V p m : Set) : Set :=
  { u ∈ V × Ring.carrier(R) | ∃ k ∈ V, u = (k, p(k)(m)) }

-- Families used below: the monomial basis m ↦ X^m, the monomials of p over
-- its support, the terms of a value, the homogeneous components indexed
-- by degree, and the scaled point t v.
def monomialBasisFamily (R I : Set) : Set :=
  { u ∈ monomials(I) × Ring.carrier(polynomialRing(R, I)) | ∃ m ∈ monomials(I),
    u = (m, mvMonomial(R, I, m, Ring.one(R))) }

def monomialTerms (R I p : Set) : Set :=
  { u ∈ mvSupport(R, I, p) × Ring.carrier(polynomialRing(R, I)) |
    ∃ m ∈ mvSupport(R, I, p), u = (m, mvMonomial(R, I, m, p(m))) }

def monomialValueTerms (R I v p : Set) : Set :=
  { u ∈ mvSupport(R, I, p) × Ring.carrier(R) | ∃ m ∈ mvSupport(R, I, p),
    u = (m, call2(Ring.mul(R), p(m),
      evaluationAt(R, I, v)(mvMonomial(R, I, m, Ring.one(R))))) }

def componentFamily (R I p : Set) : Set :=
  { u ∈ ℕ × Ring.carrier(polynomialRing(R, I)) | ∃ n ∈ ℕ,
    u = (n, homogeneousComponent(R, I, n, p)) }

def pointwiseScale (R I t v : Set) : Set :=
  { u ∈ I × Ring.carrier(R) | ∃ i ∈ I, u = (i, call2(Ring.mul(R), t, v(i))) }

-- Helpers: the families of the module, written as graphs, are functions.
theorem mv.variables_function (R I : Set)
  requires values : ∀ i ∈ I, X(R, I, i) ∈ Ring.carrier(polynomialRing(R, I))
  shows (mvVariables(R, I) : I → Ring.carrier(polynomialRing(R, I))) ∧ (∀ i ∈ I, mvVariables(R, I)(i) = X(R, I, i))
proof
  have rel : ∀ i ∈ I, relates(mvVariables(R, I), i, X(R, I, i))
    intros i hi
    have vIn := values with i, hi
    unfold relates
    apply mvVariables.membership.backward
    refine ⟨(product.pair at i, X(R, I, i), I, Ring.carrier(polynomialRing(R, I)) with hi, vIn), i, hi, rfl⟩
  have fn : mvVariables(R, I) : I → Ring.carrier(polynomialRing(R, I))
    constructor
      intros q0 mem
      obtain ⟨bounded, _⟩ := mvVariables.membership.forward with mem
      exact bounded
    . constructor
        intros z0 first xFirst second xSecond
        unfold relates at xFirst
        obtain ⟨_, a1, a1In, firstShape⟩ := mvVariables.membership.forward with xFirst
        unfold relates at xSecond
        obtain ⟨_, a2, a2In, secondShape⟩ := mvVariables.membership.forward with xSecond
        obtain ⟨xi, firstEqual⟩ := orderedPair.injective with firstShape
        obtain ⟨xj, secondEqual⟩ := orderedPair.injective with secondShape
        rw [firstEqual, secondEqual]
        cc
      . intros i xIn
        have vIn := values with i, xIn
        refine ⟨X(R, I, i), vIn, (rel with i, xIn)⟩
  refine ⟨fn, ?_⟩
  intros i hi
  exact FunctionBetween.apply_value with fn, hi, (rel with i, hi)

theorem mv.assignment_image_function (I B φ v : Set)
  requires values : ∀ i ∈ I, φ(v(i)) ∈ B
  shows (assignmentImage(I, B, φ, v) : I → B) ∧ (∀ i ∈ I, assignmentImage(I, B, φ, v)(i) = φ(v(i)))
proof
  have rel : ∀ i ∈ I, relates(assignmentImage(I, B, φ, v), i, φ(v(i)))
    intros i hi
    have vIn := values with i, hi
    unfold relates
    apply assignmentImage.membership.backward
    refine ⟨(product.pair at i, φ(v(i)), I, B with hi, vIn), i, hi, rfl⟩
  have fn : assignmentImage(I, B, φ, v) : I → B
    constructor
      intros q0 mem
      obtain ⟨bounded, _⟩ := assignmentImage.membership.forward with mem
      exact bounded
    . constructor
        intros z0 first xFirst second xSecond
        unfold relates at xFirst
        obtain ⟨_, a1, a1In, firstShape⟩ := assignmentImage.membership.forward with xFirst
        unfold relates at xSecond
        obtain ⟨_, a2, a2In, secondShape⟩ := assignmentImage.membership.forward with xSecond
        obtain ⟨xi, firstEqual⟩ := orderedPair.injective with firstShape
        obtain ⟨xj, secondEqual⟩ := orderedPair.injective with secondShape
        rw [firstEqual, secondEqual]
        cc
      . intros i xIn
        have vIn := values with i, xIn
        refine ⟨φ(v(i)), vIn, (rel with i, xIn)⟩
  refine ⟨fn, ?_⟩
  intros i hi
  exact FunctionBetween.apply_value with fn, hi, (rel with i, hi)

theorem mv.bind_values_function (A I J g v : Set)
  requires values : ∀ i ∈ I, mvAeval(A, J, v)(g(i)) ∈ algebraCarrier(A)
  shows (bindValues(A, I, J, g, v) : I → algebraCarrier(A)) ∧ (∀ i ∈ I, bindValues(A, I, J, g, v)(i) = mvAeval(A, J, v)(g(i)))
proof
  have rel : ∀ i ∈ I, relates(bindValues(A, I, J, g, v), i, mvAeval(A, J, v)(g(i)))
    intros i hi
    have vIn := values with i, hi
    unfold relates
    apply bindValues.membership.backward
    refine ⟨(product.pair at i, mvAeval(A, J, v)(g(i)), I, algebraCarrier(A) with hi, vIn), i, hi, rfl⟩
  have fn : bindValues(A, I, J, g, v) : I → algebraCarrier(A)
    constructor
      intros q0 mem
      obtain ⟨bounded, _⟩ := bindValues.membership.forward with mem
      exact bounded
    . constructor
        intros z0 first xFirst second xSecond
        unfold relates at xFirst
        obtain ⟨_, a1, a1In, firstShape⟩ := bindValues.membership.forward with xFirst
        unfold relates at xSecond
        obtain ⟨_, a2, a2In, secondShape⟩ := bindValues.membership.forward with xSecond
        obtain ⟨xi, firstEqual⟩ := orderedPair.injective with firstShape
        obtain ⟨xj, secondEqual⟩ := orderedPair.injective with secondShape
        rw [firstEqual, secondEqual]
        cc
      . intros i xIn
        have vIn := values with i, xIn
        refine ⟨mvAeval(A, J, v)(g(i)), vIn, (rel with i, xIn)⟩
  refine ⟨fn, ?_⟩
  intros i hi
  exact FunctionBetween.apply_value with fn, hi, (rel with i, hi)

theorem mv.bind_compose_function (R I J K g h : Set)
  requires values : ∀ i ∈ I, mvBind(R, J, K, h)(g(i)) ∈ Ring.carrier(polynomialRing(R, K))
  shows (bindCompose(R, I, J, K, g, h) : I → Ring.carrier(polynomialRing(R, K))) ∧ (∀ i ∈ I, bindCompose(R, I, J, K, g, h)(i) = mvBind(R, J, K, h)(g(i)))
proof
  have rel : ∀ i ∈ I, relates(bindCompose(R, I, J, K, g, h), i, mvBind(R, J, K, h)(g(i)))
    intros i hi
    have vIn := values with i, hi
    unfold relates
    apply bindCompose.membership.backward
    refine ⟨(product.pair at i, mvBind(R, J, K, h)(g(i)), I, Ring.carrier(polynomialRing(R, K)) with hi, vIn), i, hi, rfl⟩
  have fn : bindCompose(R, I, J, K, g, h) : I → Ring.carrier(polynomialRing(R, K))
    constructor
      intros q0 mem
      obtain ⟨bounded, _⟩ := bindCompose.membership.forward with mem
      exact bounded
    . constructor
        intros z0 first xFirst second xSecond
        unfold relates at xFirst
        obtain ⟨_, a1, a1In, firstShape⟩ := bindCompose.membership.forward with xFirst
        unfold relates at xSecond
        obtain ⟨_, a2, a2In, secondShape⟩ := bindCompose.membership.forward with xSecond
        obtain ⟨xi, firstEqual⟩ := orderedPair.injective with firstShape
        obtain ⟨xj, secondEqual⟩ := orderedPair.injective with secondShape
        rw [firstEqual, secondEqual]
        cc
      . intros i xIn
        have vIn := values with i, xIn
        refine ⟨mvBind(R, J, K, h)(g(i)), vIn, (rel with i, xIn)⟩
  refine ⟨fn, ?_⟩
  intros i hi
  exact FunctionBetween.apply_value with fn, hi, (rel with i, hi)


-- Helper: the degree of monomials is additive.
theorem tkJ.degree_mul (I a c : Set)
  requires first : a ∈ monomials(I)
  requires second : c ∈ monomials(I)
  shows monomialDegree(I, monomialProduct(I, a, c)) = monomialDegree(I, a) + monomialDegree(I, c)
proof
  obtain ⟨_, aFin⟩ := monomials.map at I, a with first
  obtain ⟨_, cFin⟩ := monomials.map at I, c with second
  have supp := monomialProduct.support at I, a, c with first, second
  have sFin := Finite.union with aFin, cFin
  have subA := union2.subset_left at functionSupport(a, I, 0), functionSupport(c, I, 0)
  have subC := union2.subset_right at functionSupport(a, I, 0), functionSupport(c, I, 0)
  have suppSub : functionSupport(a, I, 0) ∪ functionSupport(c, I, 0) ⊆ I
    have sa := functionSupport.subset at a, I, 0
    have sc := functionSupport.subset at c, I, 0
    exact union2.subset with sa, sc
  have wa : ∀ v ∈ functionSupport(a, I, 0) ∪ functionSupport(c, I, 0), a(v) ∈ ℕ
    intros v hv
    have vI := suppSub with v, hv
    exact nat.omega.forward with (monomials.exponent at I, a, v with first, vI)
  have wc : ∀ v ∈ functionSupport(a, I, 0) ∪ functionSupport(c, I, 0), c(v) ∈ ℕ
    intros v hv
    have vI := suppSub with v, hv
    exact nat.omega.forward with (monomials.exponent at I, c, v with second, vI)
  have agree : ∀ v ∈ functionSupport(a, I, 0) ∪ functionSupport(c, I, 0), monomialProduct(I, a, c)(v) = a(v) + c(v)
    intros v hv
    have vI := suppSub with v, hv
    exact monomialProduct.value at I, a, c, v with first, second, vI
  have add := natSum.add_pointwise at functionSupport(a, I, 0) ∪ functionSupport(c, I, 0), monomialProduct(I, a, c), a, c with sFin, wa, wc, agree
  have outA : ∀ v ∈ (functionSupport(a, I, 0) ∪ functionSupport(c, I, 0)) ∖ functionSupport(a, I, 0), a(v) = 0
    intros v hv
    obtain ⟨vIn, vOut⟩ := difference.membership.forward with hv
    have vI := suppSub with v, vIn
    exact functionSupport.outside at a, I, 0, v with vI, vOut
  have outC : ∀ v ∈ (functionSupport(a, I, 0) ∪ functionSupport(c, I, 0)) ∖ functionSupport(c, I, 0), c(v) = 0
    intros v hv
    obtain ⟨vIn, vOut⟩ := difference.membership.forward with hv
    have vI := suppSub with v, vIn
    exact functionSupport.outside at c, I, 0, v with vI, vOut
  have ra := natSum.restrict at functionSupport(a, I, 0) ∪ functionSupport(c, I, 0), functionSupport(a, I, 0), a with sFin, subA, wa, outA
  have rc := natSum.restrict at functionSupport(a, I, 0) ∪ functionSupport(c, I, 0), functionSupport(c, I, 0), c with sFin, subC, wc, outC
  unfold monomialDegree
  rw [supp, add, ra, rc]

-- Helper: only the unit monomial has degree 0.
theorem tkJ.degree_zero (I c : Set)
  requires monomial : c ∈ monomials(I)
  requires zero : monomialDegree(I, c) = 0
  shows c = monomialOne(I)
proof
  obtain ⟨_, cFin⟩ := monomials.map at I, c with monomial
  have one := monomialOne.member at I
  apply monomials.ext at I, c, monomialOne(I) with monomial, one
  intros i hi
  rw (monomialOne.value at I, i with hi)
  by_contra ne
  have inS : i ∈ functionSupport(c, I, 0)
    exact functionSupport.membership.backward with ⟨hi, ne⟩
  have sSub := functionSupport.subset at c, I, 0
  have wc : ∀ v ∈ functionSupport(c, I, 0), c(v) ∈ ℕ
    intros v hv
    have vI := sSub with v, hv
    exact nat.omega.forward with (monomials.exponent at I, c, v with monomial, vI)
  have single : {i} ⊆ functionSupport(c, I, 0)
    intros x hx
    rw singleton.membership at hx
    rw hx
    exact inS
  have mono := natSum.monotone at {i}, functionSupport(c, I, 0), c with cFin, single, wc
  have ci := wc with i, inS
  rw (natSum.singleton at c, i with ci) at mono
  have cz : natSum(functionSupport(c, I, 0), c) = 0
    unfold monomialDegree at zero
    exact zero
  rw cz at mono
  have cNat := nat.omega.backward with ci
  apply ne
  arith

-- Section: Laws
section Laws
variable (R I : Set)
hypothesis comm : CommRing(R)
hypothesis polys : CommRing(polynomialRing(R, I))

-- Helper: the coefficient of a constant at the unit monomial.
theorem mv.C_coeff_one (a : R)
  shows polynomialConstant(R, I)(a)(monomialOne(I)) = a
proof
  have zeroIn : R.zero ∈ R.carrier by typecheck
  have aIn : a ∈ R.carrier by typecheck
  have m1 := monomialOne.member at I
  rw (polynomialConstant.apply at R, I, a with comm, aIn)
  unfold polynomialConstant
  exact polynomialTerm.same at I, R.carrier, R.zero, a, monomialOne(I) with zeroIn, aIn, m1

-- MvPolynomial.ext: polynomials with equal coefficients are equal.
theorem mvPolynomial.ext (p q : polynomialRing(R, I))
  requires agree : ∀ m ∈ monomials(I), mvCoeff(p, m) = mvCoeff(q, m)
  shows p = q
proof
  apply polynomialRing.ext at R, I, p, q with comm, polys
  intros m hm
  have e := agree with m, hm
  unfold mvCoeff at e
  exact e

-- Monomials: polynomials, with one coefficient (MvPolynomial.coeff_monomial),
-- multiplying by adding exponents (monomial_mul), and
-- monomial m a = C a · Π Xᵢ^{m(i)} (MvPolynomial.monomial_eq), with
-- monomial 0 a = C a (monomial_zero').
theorem mvMonomial.mem (m a : Set)
  requires monomial : m ∈ monomials(I)
  requires scalar : a ∈ R.carrier
  shows mvMonomial(R, I, m, a) ∈ Ring.carrier(polynomialRing(R, I))
proof
  have zeroIn : R.zero ∈ R.carrier by typecheck
  have t := polynomialTerm.member at I, R.carrier, R.zero, a, m with zeroIn, scalar
  unfold polynomialTerm at t
  unfold mvMonomial
  exact polynomialRing.member_of_parts at R, I, coefficientSingle(monomials(I), R.carrier, R.zero, a, m) with comm, polys, t

theorem mvMonomial.coeff (m a n : Set)
  requires monomial : m ∈ monomials(I)
  requires scalar : a ∈ R.carrier
  requires other : n ∈ monomials(I)
  shows (n = m → mvCoeff(mvMonomial(R, I, m, a), n) = a) ∧
    (n ≠ m → mvCoeff(mvMonomial(R, I, m, a), n) = R.zero)
proof
  have zeroIn : R.zero ∈ R.carrier by typecheck
  unfold mvCoeff
  unfold mvMonomial
  constructor
  . intro e
    rw e
    have s := polynomialTerm.same at I, R.carrier, R.zero, a, m with zeroIn, scalar, monomial
    unfold polynomialTerm at s
    exact s
  . intro ne
    have s := polynomialTerm.other at I, R.carrier, R.zero, a, m, n with zeroIn, scalar, other, ne
    unfold polynomialTerm at s
    exact s

theorem mvMonomial.mul (m n a b : Set)
  requires first : m ∈ monomials(I)
  requires second : n ∈ monomials(I)
  requires scalarA : a ∈ R.carrier
  requires scalarB : b ∈ R.carrier
  shows call2(Ring.mul(polynomialRing(R, I)), mvMonomial(R, I, m, a),
      mvMonomial(R, I, n, b)) =
    mvMonomial(R, I, monomialMul(I)((m, n)), call2(R.mul, a, b))
proof
  have parts := CommRing.parts with comm
  have ma := mvMonomial.mem at R, I, m, a with comm, polys, first, scalarA
  have mb := mvMonomial.mem at R, I, n, b with comm, polys, second, scalarB
  rw (polynomialRing.mul_apply at R, I, mvMonomial(R, I, m, a), mvMonomial(R, I, n, b) with comm, polys, ma, mb)
  have t := polynomialProduct.terms at I, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, a, b, m, n with parts, scalarA, scalarB, first, second
  unfold polynomialTerm at t
  unfold mvMonomial
  rw t
  have v := monomialMul.apply at I, m, n with first, second
  unfold call2 at v
  rw v

theorem mvMonomial.zero (a : R)
  shows mvMonomial(R, I, monomialOne(I), a) = mvC(R, I, a)
proof
  have aIn : a ∈ R.carrier by typecheck
  unfold mvC
  rw (polynomialConstant.apply at R, I, a with comm, aIn)
  unfold mvMonomial
  unfold polynomialConstant
  unfold polynomialTerm
  rfl

-- MvPolynomial.X_pow_eq_monomial and monomial_sum_one: Xᵢ is the
-- monomial of the unit exponent at i.
theorem X.eq_monomial (i : Set)
  requires index : i ∈ I
  shows X(R, I, i) = mvMonomial(R, I, monomialVariable(I, i), R.one)
proof
  rw X.value
  unfold polynomialVariable
  unfold polynomialTerm
  unfold mvMonomial
  rfl

-- MvPolynomial.C_mul', smul_eq_C_mul, C_eq_smul_one: multiplying by a
-- constant is the module action, coefficientwise.
theorem mvC.mul_coeff (a m : Set) (p : polynomialRing(R, I))
  requires scalar : a ∈ R.carrier
  requires monomial : m ∈ monomials(I)
  shows mvCoeff(call2(Ring.mul(polynomialRing(R, I)), mvC(R, I, a), p), m) =
    call2(R.mul, a, mvCoeff(p, m))
proof
  unfold mvCoeff
  unfold mvC
  exact polynomialRing.constant_mul at R, I, a, p, m with comm, polys, scalar, monomial

theorem mvC.mul_eq_smul (a : Set) (p : polynomialRing(R, I))
  requires scalar : a ∈ R.carrier
  shows call2(Ring.mul(polynomialRing(R, I)), mvC(R, I, a), p) =
    call2(Module.smul(mvModule(R, I)), a, p)
proof
  have pa := polynomialAlgebra.algebra at R, I with comm
  have pIn : p ∈ Ring.carrier(polynomialRing(R, I)) by assumption
  have hr : a ∈ Ring.carrier(Algebra.base(polynomialAlgebra(R, I)))
    rw polynomialAlgebra.base
    exact scalar
  have ha : p ∈ algebraCarrier(polynomialAlgebra(R, I))
    rw polynomialAlgebra.carrierOf
    exact pIn
  have sv := algebraModule.smul_value at polynomialAlgebra(R, I), a, p with pa, hr, ha
  rw [polynomialAlgebra.ring, polynomialAlgebra.map] at sv
  unfold mvModule
  rw sv
  unfold mvC
  rfl

-- Coefficients are additive (coeff_add), and of a finite sum
-- (MvPolynomial.coeff_sum): the coefficient of the sum is the sum of the
-- coefficients; the coefficient at m is an R-linear form (lcoeff).
theorem mvCoeff.add (p q : polynomialRing(R, I)) (m : Set)
  requires monomial : m ∈ monomials(I)
  shows mvCoeff(p + q, m) = call2(R.add, mvCoeff(p, m), mvCoeff(q, m))
proof
  unfold mvCoeff
  exact polynomialRing.coefficient_add at R, I, p, q, m with comm, polys, monomial

-- Helpers: the family of coefficients at m, and the coefficient at m of an
-- indexed sum.
theorem tkJ.mv_coefficient_family (V p m : Set)
  requires family : p : V → Ring.carrier(polynomialRing(R, I))
  requires monomial : m ∈ monomials(I)
  shows (coefficientFamily(R, V, p, m) : V → R.carrier) ∧
    (∀ k ∈ V, coefficientFamily(R, V, p, m)(k) = p(k)(m))
proof
  have rel : ∀ k ∈ V, (k, p(k)(m)) ∈ coefficientFamily(R, V, p, m) ∧ p(k)(m) ∈ R.carrier
    intros k hk
    have pk := FunctionBetween.apply_closed with family, hk
    have v := polynomialRing.coefficient_mem at R, I, p(k), m with comm, polys, pk, monomial
    have r : (k, p(k)(m)) ∈ coefficientFamily(R, V, p, m)
      apply coefficientFamily.membership.backward
      refine ⟨(product.pair with hk, v), k, hk, rfl⟩
    exact ⟨r, v⟩
  have fn : coefficientFamily(R, V, p, m) : V → R.carrier
    apply tkJ.uni_graph_function
    . intros u hu
      exact (coefficientFamily.membership.forward with hu).left
    . intros x y z hy hz
      obtain ⟨_, a, aIn, ea⟩ := coefficientFamily.membership.forward with hy
      obtain ⟨_, b, bIn, eb⟩ := coefficientFamily.membership.forward with hz
      obtain ⟨xa, ya⟩ := orderedPair.injective with ea
      obtain ⟨xb, yb⟩ := orderedPair.injective with eb
      rw [ya, yb, ← xa, ← xb]
    . intros x hx
      obtain ⟨r, v⟩ := rel with x, hx
      exact ⟨p(x)(m), v, r⟩
  refine ⟨fn, ?_⟩
  intros k hk
  obtain ⟨r, v⟩ := rel with k, hk
  exact FunctionBetween.apply_value with fn, hk, r

theorem tkJ.mv_indexed_coeff (w e c m : Set) (N : Nat)
  requires monomial : m ∈ monomials(I)
  shows (∀ i ∈ N, w(e(i)) ∈ Ring.carrier(polynomialRing(R, I)) ∧ c(e(i)) = w(e(i))(m)) →
    indexedRingSum(w, e, Ring.add(polynomialRing(R, I)), Ring.zero(polynomialRing(R, I)), N) ∈ Ring.carrier(polynomialRing(R, I)) ∧
    indexedRingSum(w, e, Ring.add(polynomialRing(R, I)), Ring.zero(polynomialRing(R, I)), N)(m) =
      indexedRingSum(c, e, R.add, R.zero, N)
proof
  have zIn : Ring.zero(polynomialRing(R, I)) ∈ Ring.carrier(polynomialRing(R, I)) by typecheck
  induction N
  | zero =>
    intro h
    rw [indexedRingSum, indexedRingSum]
    exact ⟨zIn, (polynomialRing.coefficient_zero at R, I, m with comm, polys, monomial)⟩
  | succ(k) using ih =>
    intro h
    have prefix : ∀ i ∈ k, w(e(i)) ∈ Ring.carrier(polynomialRing(R, I)) ∧ c(e(i)) = w(e(i))(m)
      intros i hi
      exact h with i, (membership.into_successor at i, k with hi)
    obtain ⟨sIn, sV⟩ := ih with prefix
    obtain ⟨lastIn, lastV⟩ := h with k, (membership.self_successor at k)
    have ss : call2(Ring.add(polynomialRing(R, I)), indexedRingSum(w, e, Ring.add(polynomialRing(R, I)), Ring.zero(polynomialRing(R, I)), k), w(e(k))) ∈ Ring.carrier(polynomialRing(R, I)) by typecheck
    rw [indexedRingSum, indexedRingSum]
    refine ⟨ss, ?_⟩
    rw [(polynomialRing.coefficient_add at R, I, indexedRingSum(w, e, Ring.add(polynomialRing(R, I)), Ring.zero(polynomialRing(R, I)), k), w(e(k)), m with comm, polys, sIn, lastIn, monomial), sV, lastV]

-- Helper: a finite sum with a single nonzero term.
theorem tkJ.mv_sum_single (w L j : Set)
  requires finite : Finite(L)
  requires weights : w : L → R.carrier
  requires index : j ∈ L
  requires others : ∀ k ∈ L, k ≠ j → w(k) = R.zero
  shows finiteRingSum(L, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, w) = w(j)
proof
  have parts := CommRing.parts with comm
  have sub : {j} ⊆ L
    intros x hx
    rw singleton.membership at hx
    rw hx
    exact index
  have closed : ∀ x ∈ {j}, w(x) ∈ R.carrier
    intros x hx
    have xL := sub with x, hx
    exact FunctionBetween.apply_closed with weights, xL
  have rF := restrict.function at w, L, R.carrier, {j}, R.carrier with weights, sub, closed
  have agree : ∀ s ∈ {j}, w(s) = restrict(w, {j})(s)
    intros s hs
    rw (restrict.apply at w, L, R.carrier, {j}, R.carrier, s with weights, sub, closed, hs)
  have zero : ∀ d ∈ L, ¬(d ∈ {j}) → w(d) = R.zero
    intros d hd out
    apply others with d, hd
    intro e
    apply out
    rw e
    simp [singleton.membership]
  have jj : j ∈ {j} by simp [singleton.membership]
  rw [(finiteRingSum.zero_extension at L, {j}, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, w, restrict(w, {j}) with parts, finite, weights, rF, sub, agree, zero), (finiteRingSum.singleton at R.carrier, R.add, R.zero, R.neg, R.mul, R.one, restrict(w, {j}), j with parts, rF), (restrict.apply at w, L, R.carrier, {j}, R.carrier, j with weights, sub, closed, jj)]

theorem mvCoeff.sum (V p m : Set)
  requires finite : Finite(V)
  requires family : p : V → Ring.carrier(polynomialRing(R, I))
  requires monomial : m ∈ monomials(I)
  shows mvCoeff(finiteRingSum(V, Ring.carrier(polynomialRing(R, I)),
      Ring.add(polynomialRing(R, I)), Ring.zero(polynomialRing(R, I)),
      Ring.neg(polynomialRing(R, I)), Ring.mul(polynomialRing(R, I)),
      Ring.one(polynomialRing(R, I)), p), m) =
    finiteRingSum(V, R.carrier, R.add, R.zero, R.neg, R.mul, R.one,
      coefficientFamily(R, V, p, m))
proof
  have pParts := CommRing.parts with polys
  have parts := CommRing.parts with comm
  obtain ⟨cF, cV⟩ := tkJ.mv_coefficient_family at R, I, V, p, m with comm, polys, family, monomial
  have fin2 := finite
  obtain ⟨N, natural, equivalent⟩ := fin2
  obtain ⟨f, bijective⟩ := equivalent
  have enumeration := converse.bijective with bijective
  have eF := converse.function_of_bijective with bijective
  have eqP := finiteRingSum.enumeration at V, Ring.carrier(polynomialRing(R, I)), Ring.add(polynomialRing(R, I)), Ring.zero(polynomialRing(R, I)), Ring.neg(polynomialRing(R, I)), Ring.mul(polynomialRing(R, I)), Ring.one(polynomialRing(R, I)), p, converse(f, V, N), N with pParts, family, enumeration
  have eqR := finiteRingSum.enumeration at V, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, coefficientFamily(R, V, p, m), converse(f, V, N), N with parts, cF, enumeration
  have vals : ∀ i ∈ N, p(converse(f, V, N)(i)) ∈ Ring.carrier(polynomialRing(R, I)) ∧ coefficientFamily(R, V, p, m)(converse(f, V, N)(i)) = p(converse(f, V, N)(i))(m)
    intros i hi
    have ei := FunctionBetween.apply_closed with eF, hi
    exact ⟨(FunctionBetween.apply_closed with family, ei), (cV with converse(f, V, N)(i), ei)⟩
  obtain ⟨_, ic⟩ := (tkJ.mv_indexed_coeff at R, I, p, converse(f, V, N), coefficientFamily(R, V, p, m), m, N with comm, polys, monomial) with vals
  unfold mvCoeff
  rw [eqP, eqR, ic]

theorem mvModule.module
  shows Module(mvModule(R, I), R)
proof
  have pa := polynomialAlgebra.algebra at R, I with comm
  have m := algebraModule.module_of at polynomialAlgebra(R, I) with pa
  rw (polynomialAlgebra.base at R, I) at m
  unfold mvModule
  exact m

-- Every polynomial is the finite sum of its monomials over its support
-- (MvPolynomial.as_sum, support finite).
theorem mvSupport.finite (p : polynomialRing(R, I))
  shows Finite(mvSupport(R, I, p))
proof
  have pIn : p ∈ Ring.carrier(polynomialRing(R, I)) by assumption
  have pp := polynomialRing.member_parts at R, I, p with comm, polys, pIn
  unfold mvSupport
  exact polynomials.finite_support with pp

-- Helper: the monomials of p over its support, as a family.
theorem tkJ.monomial_terms (p : polynomialRing(R, I))
  shows (monomialTerms(R, I, p) : mvSupport(R, I, p) → Ring.carrier(polynomialRing(R, I))) ∧
    (∀ m ∈ mvSupport(R, I, p), monomialTerms(R, I, p)(m) = mvMonomial(R, I, m, p(m)))
proof
  have pIn : p ∈ Ring.carrier(polynomialRing(R, I)) by assumption
  have rel : ∀ m ∈ mvSupport(R, I, p), (m, mvMonomial(R, I, m, p(m))) ∈ monomialTerms(R, I, p) ∧ mvMonomial(R, I, m, p(m)) ∈ Ring.carrier(polynomialRing(R, I))
    intros m hm
    have hm2 := hm
    unfold mvSupport at hm2
    obtain ⟨mIn, _⟩ := functionSupport.membership.forward with hm2
    have pm := polynomialRing.coefficient_mem at R, I, p, m with comm, polys, pIn, mIn
    have v := mvMonomial.mem at R, I, m, p(m) with comm, polys, mIn, pm
    have r : (m, mvMonomial(R, I, m, p(m))) ∈ monomialTerms(R, I, p)
      apply monomialTerms.membership.backward
      refine ⟨(product.pair with hm, v), m, hm, rfl⟩
    exact ⟨r, v⟩
  have fn : monomialTerms(R, I, p) : mvSupport(R, I, p) → Ring.carrier(polynomialRing(R, I))
    apply tkJ.uni_graph_function
    . intros u hu
      exact (monomialTerms.membership.forward with hu).left
    . intros x y z hy hz
      obtain ⟨_, a, aIn, ea⟩ := monomialTerms.membership.forward with hy
      obtain ⟨_, b, bIn, eb⟩ := monomialTerms.membership.forward with hz
      obtain ⟨xa, ya⟩ := orderedPair.injective with ea
      obtain ⟨xb, yb⟩ := orderedPair.injective with eb
      rw [ya, yb, ← xa, ← xb]
    . intros x hx
      obtain ⟨r, v⟩ := rel with x, hx
      exact ⟨mvMonomial(R, I, x, p(x)), v, r⟩
  refine ⟨fn, ?_⟩
  intros m hm
  obtain ⟨r, v⟩ := rel with m, hm
  exact FunctionBetween.apply_value with fn, hm, r

theorem mvPolynomial.as_sum (p : polynomialRing(R, I))
  shows p = finiteRingSum(mvSupport(R, I, p), Ring.carrier(polynomialRing(R, I)),
    Ring.add(polynomialRing(R, I)), Ring.zero(polynomialRing(R, I)),
    Ring.neg(polynomialRing(R, I)), Ring.mul(polynomialRing(R, I)),
    Ring.one(polynomialRing(R, I)), monomialTerms(R, I, p))
proof
  have pIn : p ∈ Ring.carrier(polynomialRing(R, I)) by assumption
  have pParts := CommRing.parts with polys
  have parts := CommRing.parts with comm
  have zeroIn : R.zero ∈ R.carrier by typecheck
  have fin := mvSupport.finite at R, I, p with comm, polys, pIn
  obtain ⟨tF, tV⟩ := tkJ.monomial_terms at R, I, p with comm, polys, pIn
  have sumIn := finiteRingSum.closed with pParts, fin, tF
  apply polynomialRing.ext at R, I, p, finiteRingSum(mvSupport(R, I, p), Ring.carrier(polynomialRing(R, I)), Ring.add(polynomialRing(R, I)), Ring.zero(polynomialRing(R, I)), Ring.neg(polynomialRing(R, I)), Ring.mul(polynomialRing(R, I)), Ring.one(polynomialRing(R, I)), monomialTerms(R, I, p)) with comm, polys, pIn, sumIn
  intros n hn
  have c := mvCoeff.sum at R, I, mvSupport(R, I, p), monomialTerms(R, I, p), n with comm, polys, fin, tF, hn
  unfold mvCoeff at c
  rw c
  obtain ⟨cF, cV⟩ := tkJ.mv_coefficient_family at R, I, mvSupport(R, I, p), monomialTerms(R, I, p), n with comm, polys, tF, hn
  have termAt : ∀ m ∈ mvSupport(R, I, p), coefficientFamily(R, mvSupport(R, I, p), monomialTerms(R, I, p), n)(m) = mvCoeff(mvMonomial(R, I, m, p(m)), n)
    intros m hm
    rw [(cV with m, hm), (tV with m, hm)]
    unfold mvCoeff
    rfl
  have memberOf : ∀ m ∈ mvSupport(R, I, p), m ∈ monomials(I) ∧ p(m) ∈ R.carrier
    intros m hm
    have hm2 := hm
    unfold mvSupport at hm2
    obtain ⟨mIn, _⟩ := functionSupport.membership.forward with hm2
    exact ⟨mIn, (polynomialRing.coefficient_mem at R, I, p, m with comm, polys, pIn, mIn)⟩
  by_cases inS : n ∈ mvSupport(R, I, p)
  . have others : ∀ m ∈ mvSupport(R, I, p), m ≠ n → coefficientFamily(R, mvSupport(R, I, p), monomialTerms(R, I, p), n)(m) = R.zero
      intros m hm ne
      obtain ⟨mIn, pm⟩ := memberOf with m, hm
      obtain ⟨_, other⟩ := mvMonomial.coeff at R, I, m, p(m), n with comm, polys, mIn, pm, hn
      have ne2 : n ≠ m
        intro e
        apply ne
        rw e
      rw [(termAt with m, hm), (other with ne2)]
    obtain ⟨nIn, pn⟩ := memberOf with n, inS
    obtain ⟨same, _⟩ := mvMonomial.coeff at R, I, n, p(n), n with comm, polys, nIn, pn, hn
    have e : n = n by rfl
    rw [(tkJ.mv_sum_single at R, I, coefficientFamily(R, mvSupport(R, I, p), monomialTerms(R, I, p), n), mvSupport(R, I, p), n with comm, polys, fin, cF, inS, others), (termAt with n, inS), (same with e)]
  . have hn2 : ¬(n ∈ functionSupport(p, monomials(I), R.zero))
      unfold mvSupport at inS
      exact inS
    have pz := functionSupport.outside at p, monomials(I), R.zero, n with hn, hn2
    have allZero : ∀ m ∈ mvSupport(R, I, p), coefficientFamily(R, mvSupport(R, I, p), monomialTerms(R, I, p), n)(m) = R.zero
      intros m hm
      obtain ⟨mIn, pm⟩ := memberOf with m, hm
      obtain ⟨_, other⟩ := mvMonomial.coeff at R, I, m, p(m), n with comm, polys, mIn, pm, hn
      have ne2 : n ≠ m
        intro e
        apply inS
        rw e
        exact hm
      rw [(termAt with m, hm), (other with ne2)]
    rw [pz, (finiteRingSum.zero with parts, fin, cF, allZero)]

-- The constant coefficient is a ring homomorphism, the value at 0
-- (MvPolynomial.constantCoeff, constantCoeff_C, constantCoeff_X).
theorem mvConstantCoeff.hom
  shows RingHom(polynomialAtOrigin(I, R.carrier, R.zero), polynomialRing(R, I), R)
proof
  have parts := CommRing.parts with comm
  have pr := CommRing.to_ring with polys
  have ringR := CommRing.to_ring with comm
  have engine := polynomialAtOrigin.hom at I, R.carrier, R.add, R.zero, R.neg, R.mul, R.one with parts
  have shifted : IsRingHom(polynomialAtOrigin(I, R.carrier, R.zero),
      Ring.carrier(polynomialRing(R, I)), Ring.add(polynomialRing(R, I)),
      Ring.zero(polynomialRing(R, I)), Ring.neg(polynomialRing(R, I)),
      Ring.mul(polynomialRing(R, I)), Ring.one(polynomialRing(R, I)),
      R.carrier, R.add, R.zero, R.neg, R.mul, R.one)
    rw [polynomialRing.carrierOf, polynomialRing.addOf, polynomialRing.zeroOf,
      polynomialRing.negOf, polynomialRing.mulOf, polynomialRing.oneOf]
    exact engine
  exact RingHom.of_projections with pr, ringR, shifted

theorem mvConstantCoeff.eq_eval (p : polynomialRing(R, I))
  shows mvConstantCoeff(R, I, p) =
    evaluationAt(R, I, constantFunction(I, R.carrier, R.zero))(p)
proof
  have zeroIn : R.zero ∈ R.carrier by typecheck
  have oneIn : R.one ∈ R.carrier by typecheck
  have pIn : p ∈ Ring.carrier(polynomialRing(R, I)) by assumption
  have v0 := constantFunction.function at I, R.carrier, R.zero with *
  have eh := evaluationAt.hom at R, I, constantFunction(I, R.carrier, R.zero) with comm, v0
  have oh := mvConstantCoeff.hom at R, I with comm, polys
  have eq : polynomialAtOrigin(I, R.carrier, R.zero) = evaluationAt(R, I, constantFunction(I, R.carrier, R.zero))
    apply polynomialRing.hom_ext at R, I, R, polynomialAtOrigin(I, R.carrier, R.zero), evaluationAt(R, I, constantFunction(I, R.carrier, R.zero)) with comm, oh, eh
    . intros a ha
      rw (evaluationAt.map_constant at R, I, constantFunction(I, R.carrier, R.zero), a with comm, v0, ha)
      rw (polynomialConstant.apply at R, I, a with comm, ha)
      exact polynomialAtOrigin.constant at I, R.carrier, R.zero, a with zeroIn, ha
    . intros j hj
      rw (evaluationAt.map_X at R, I, constantFunction(I, R.carrier, R.zero), j with comm, v0, hj)
      rw (constantFunction.apply at I, R.carrier, j, R.zero with hj, zeroIn)
      rw X.value
      exact polynomialAtOrigin.variable at I, R.carrier, R.zero, R.one, j with zeroIn, oneIn, hj
  rw ← eq
  have pp := polynomialRing.member_parts at R, I, p with comm, polys, pIn
  rw (polynomialAtOrigin.value at I, R.carrier, R.zero, p with pp)
  unfold mvConstantCoeff
  rfl

-- Variables: a polynomial lies in the image of the renaming from the
-- finite set of its variables (MvPolynomial.exists_finset_rename).
theorem mvVars.finite (p : polynomialRing(R, I))
  shows Finite(mvVars(R, I, p)) ∧ mvVars(R, I, p) ⊆ I
proof
  have pIn : p ∈ Ring.carrier(polynomialRing(R, I)) by assumption
  have pp := polynomialRing.member_parts at R, I, p with comm, polys, pIn
  unfold mvVars
  have f := polynomialVariablesUsed.finite at I, R.carrier, R.zero, p with pp
  have s := polynomialVariablesUsed.subset at I, R.carrier, R.zero, p
  exact ⟨f, s⟩

-- Helper: the assignment I → R[J] sending i ∈ V to Xᵢ and the rest of I
-- to 0, and evaluation at the variables is the identity.
def tkJVariablesOn (V J : Set) : Set :=
  { u ∈ I × Ring.carrier(polynomialRing(R, J)) | ∃ i ∈ I,
    (i ∈ V ∧ u = (i, X(R, J, i))) ∨
    (i ∉ V ∧ u = (i, Ring.zero(polynomialRing(R, J)))) }

theorem tkJ.variables_on (V J : Set)
  shows (tkJVariablesOn(R, I, V, J) : I → Ring.carrier(polynomialRing(R, J))) ∧
    (∀ i ∈ I, i ∈ V → tkJVariablesOn(R, I, V, J)(i) = X(R, J, i)) ∧
    (∀ i ∈ I, i ∉ V →
      tkJVariablesOn(R, I, V, J)(i) = Ring.zero(polynomialRing(R, J)))
proof
  have pcJ := polynomialRing.comm_ring at R, J with comm
  have zIn : Ring.zero(polynomialRing(R, J)) ∈ Ring.carrier(polynomialRing(R, J)) by typecheck
  have relIn : ∀ i ∈ I, i ∈ V → (i, X(R, J, i)) ∈ tkJVariablesOn(R, I, V, J)
    intros i hi iv
    have xi := X.mem at R, J, i with comm
    apply tkJVariablesOn.membership.backward
    refine ⟨(product.pair with hi, xi), i, hi, ?_⟩
    left
    exact ⟨iv, rfl⟩
  have relOut : ∀ i ∈ I, i ∉ V → (i, Ring.zero(polynomialRing(R, J))) ∈ tkJVariablesOn(R, I, V, J)
    intros i hi iv
    apply tkJVariablesOn.membership.backward
    refine ⟨(product.pair with hi, zIn), i, hi, ?_⟩
    right
    exact ⟨iv, rfl⟩
  have fn : tkJVariablesOn(R, I, V, J) : I → Ring.carrier(polynomialRing(R, J))
    apply tkJ.uni_graph_function
    . intros u hu
      exact (tkJVariablesOn.membership.forward with hu).left
    . intros x y z hy hz
      obtain ⟨_, a, aIn, ca⟩ := tkJVariablesOn.membership.forward with hy
      obtain ⟨_, b, bIn, cb⟩ := tkJVariablesOn.membership.forward with hz
      rcases ca with ⟨av, ea⟩ | ⟨av, ea⟩
      . obtain ⟨xa, ya⟩ := orderedPair.injective with ea
        rcases cb with ⟨bv, eb⟩ | ⟨bv, eb⟩
        . obtain ⟨xb, yb⟩ := orderedPair.injective with eb
          rw [ya, yb, ← xa, ← xb]
        . obtain ⟨xb, yb⟩ := orderedPair.injective with eb
          exfalso
          rw [← xa, xb] at av
          exact bv with av
      . obtain ⟨xa, ya⟩ := orderedPair.injective with ea
        rcases cb with ⟨bv, eb⟩ | ⟨bv, eb⟩
        . obtain ⟨xb, yb⟩ := orderedPair.injective with eb
          exfalso
          rw [← xb, xa] at bv
          exact av with bv
        . obtain ⟨xb, yb⟩ := orderedPair.injective with eb
          rw [ya, yb]
    . intros x hx
      by_cases xv : x ∈ V
      . have xi := X.mem at R, J, x with comm
        exact ⟨X(R, J, x), xi, (relIn with x, hx, xv)⟩
      . exact ⟨Ring.zero(polynomialRing(R, J)), zIn, (relOut with x, hx, xv)⟩
  refine ⟨fn, ?_, ?_⟩
  . intros i hi iv
    exact FunctionBetween.apply_value with fn, hi, (relIn with i, hi, iv)
  . intros i hi iv
    exact FunctionBetween.apply_value with fn, hi, (relOut with i, hi, iv)

theorem tkJ.eval_variables (p : polynomialRing(R, I))
  shows evaluationHom(R, polynomialRing(R, I), I, polynomialConstant(R, I),
    mvVariables(R, I))(p) = p
proof
  have pIn : p ∈ Ring.carrier(polynomialRing(R, I)) by assumption
  have ch := polynomialConstant.hom at R, I with comm
  have xs : ∀ i ∈ I, X(R, I, i) ∈ Ring.carrier(polynomialRing(R, I))
    intros i hi
    exact X.mem at R, I, i with comm
  obtain ⟨fn, vals⟩ := mv.variables_function at R, I with xs
  have idh := RingHom.id at polynomialRing(R, I) with polys
  have u := evaluationHom.unique at R, polynomialRing(R, I), I, polynomialConstant(R, I), mvVariables(R, I), identity(Ring.carrier(polynomialRing(R, I))) with comm, polys, ch, fn, idh
  have eq : identity(Ring.carrier(polynomialRing(R, I))) = evaluationHom(R, polynomialRing(R, I), I, polynomialConstant(R, I), mvVariables(R, I))
    apply u
    . intros a ha
      have cIn := polynomialConstant.mem at R, I, a with comm, ha
      exact identity.apply at polynomialConstant(R, I)(a), Ring.carrier(polynomialRing(R, I)) with cIn
    . intros j hj
      have xIn := X.mem at R, I, j with comm
      rw (vals with j, hj)
      exact identity.apply at X(R, I, j), Ring.carrier(polynomialRing(R, I)) with xIn
  rw ← eq
  exact identity.apply at p, Ring.carrier(polynomialRing(R, I)) with pIn

theorem mvVars.exists_rename (p : polynomialRing(R, I))
  shows ∃ q ∈ Ring.carrier(polynomialRing(R, mvVars(R, I, p))),
    polynomialRename(R, mvVars(R, I, p), I, identity(mvVars(R, I, p)))(q) = p
proof
  have pIn : p ∈ Ring.carrier(polynomialRing(R, I)) by assumption
  obtain ⟨_, VI⟩ := mvVars.finite at R, I, p with comm, polys, pIn
  have idF := identity.inclusion at mvVars(R, I, p), I with VI
  have pcV := polynomialRing.comm_ring at R, mvVars(R, I, p) with comm
  have chV := polynomialConstant.hom at R, mvVars(R, I, p) with comm
  have chI := polynomialConstant.hom at R, I with comm
  obtain ⟨uF, uIn, uOut⟩ := tkJ.variables_on at R, I, mvVars(R, I, p), mvVars(R, I, p) with comm, polys
  obtain ⟨wF, wIn, wOut⟩ := tkJ.variables_on at R, I, mvVars(R, I, p), I with comm, polys
  have eh := evaluationHom.hom at R, polynomialRing(R, mvVars(R, I, p)), I, polynomialConstant(R, mvVars(R, I, p)), tkJVariablesOn(R, I, mvVars(R, I, p), mvVars(R, I, p)) with comm, pcV, chV, uF
  have wh := evaluationHom.hom at R, polynomialRing(R, I), I, polynomialConstant(R, I), tkJVariablesOn(R, I, mvVars(R, I, p), I) with comm, polys, chI, wF
  have qIn := RingHom.map_mem at evaluationHom(R, polynomialRing(R, mvVars(R, I, p)), I, polynomialConstant(R, mvVars(R, I, p)), tkJVariablesOn(R, I, mvVars(R, I, p), mvVars(R, I, p))), polynomialRing(R, I), polynomialRing(R, mvVars(R, I, p)), p with eh, pIn
  refine ⟨evaluationHom(R, polynomialRing(R, mvVars(R, I, p)), I, polynomialConstant(R, mvVars(R, I, p)), tkJVariablesOn(R, I, mvVars(R, I, p), mvVars(R, I, p)))(p), qIn, ?_⟩
  have rn := polynomialRename.hom at R, mvVars(R, I, p), I, identity(mvVars(R, I, p)) with comm, idF
  have rh := AlgebraHom.ring_hom at polynomialRename(R, mvVars(R, I, p), I, identity(mvVars(R, I, p))), polynomialAlgebra(R, mvVars(R, I, p)), polynomialAlgebra(R, I) with rn
  rw [polynomialAlgebra.ring, polynomialAlgebra.ring] at rh
  have c := RingHom.comp at evaluationHom(R, polynomialRing(R, mvVars(R, I, p)), I, polynomialConstant(R, mvVars(R, I, p)), tkJVariablesOn(R, I, mvVars(R, I, p), mvVars(R, I, p))), polynomialRename(R, mvVars(R, I, p), I, identity(mvVars(R, I, p))), polynomialRing(R, I), polynomialRing(R, mvVars(R, I, p)), polynomialRing(R, I) with polys, eh, rh
  have e0 := eh
  obtain ⟨_, _, efn, _⟩ := e0
  have r0 := rh
  obtain ⟨_, _, rfn, _⟩ := r0
  have eq : compose(polynomialRename(R, mvVars(R, I, p), I, identity(mvVars(R, I, p))), evaluationHom(R, polynomialRing(R, mvVars(R, I, p)), I, polynomialConstant(R, mvVars(R, I, p)), tkJVariablesOn(R, I, mvVars(R, I, p), mvVars(R, I, p))), Ring.carrier(polynomialRing(R, I)), Ring.carrier(polynomialRing(R, mvVars(R, I, p))), Ring.carrier(polynomialRing(R, I))) = evaluationHom(R, polynomialRing(R, I), I, polynomialConstant(R, I), tkJVariablesOn(R, I, mvVars(R, I, p), I))
    apply polynomialRing.hom_ext at R, I, polynomialRing(R, I), compose(polynomialRename(R, mvVars(R, I, p), I, identity(mvVars(R, I, p))), evaluationHom(R, polynomialRing(R, mvVars(R, I, p)), I, polynomialConstant(R, mvVars(R, I, p)), tkJVariablesOn(R, I, mvVars(R, I, p), mvVars(R, I, p))), Ring.carrier(polynomialRing(R, I)), Ring.carrier(polynomialRing(R, mvVars(R, I, p))), Ring.carrier(polynomialRing(R, I))), evaluationHom(R, polynomialRing(R, I), I, polynomialConstant(R, I), tkJVariablesOn(R, I, mvVars(R, I, p), I)) with comm, c, wh
    . intros a ha
      have cIn := polynomialConstant.mem at R, I, a with comm, ha
      rw (compose.apply at polynomialRename(R, mvVars(R, I, p), I, identity(mvVars(R, I, p))), evaluationHom(R, polynomialRing(R, mvVars(R, I, p)), I, polynomialConstant(R, mvVars(R, I, p)), tkJVariablesOn(R, I, mvVars(R, I, p), mvVars(R, I, p))), Ring.carrier(polynomialRing(R, I)), Ring.carrier(polynomialRing(R, mvVars(R, I, p))), Ring.carrier(polynomialRing(R, I)), polynomialConstant(R, I)(a) with efn, rfn, cIn)
      rw (evaluationHom.map_constant at R, polynomialRing(R, mvVars(R, I, p)), I, polynomialConstant(R, mvVars(R, I, p)), tkJVariablesOn(R, I, mvVars(R, I, p), mvVars(R, I, p)), a with comm, pcV, chV, uF, ha)
      rw (evaluationHom.map_constant at R, polynomialRing(R, I), I, polynomialConstant(R, I), tkJVariablesOn(R, I, mvVars(R, I, p), I), a with comm, polys, chI, wF, ha)
      have ha2 : a ∈ Ring.carrier(Algebra.base(polynomialAlgebra(R, mvVars(R, I, p))))
        rw polynomialAlgebra.base
        exact ha
      have mb := AlgebraHom.map_base at polynomialRename(R, mvVars(R, I, p), I, identity(mvVars(R, I, p))), polynomialAlgebra(R, mvVars(R, I, p)), polynomialAlgebra(R, I), a with rn, ha2
      rw [polynomialAlgebra.map, polynomialAlgebra.map] at mb
      exact mb
    . intros j hj
      have xIn := X.mem at R, I, j with comm
      rw (compose.apply at polynomialRename(R, mvVars(R, I, p), I, identity(mvVars(R, I, p))), evaluationHom(R, polynomialRing(R, mvVars(R, I, p)), I, polynomialConstant(R, mvVars(R, I, p)), tkJVariablesOn(R, I, mvVars(R, I, p), mvVars(R, I, p))), Ring.carrier(polynomialRing(R, I)), Ring.carrier(polynomialRing(R, mvVars(R, I, p))), Ring.carrier(polynomialRing(R, I)), X(R, I, j) with efn, rfn, xIn)
      rw (evaluationHom.map_X at R, polynomialRing(R, mvVars(R, I, p)), I, polynomialConstant(R, mvVars(R, I, p)), tkJVariablesOn(R, I, mvVars(R, I, p), mvVars(R, I, p)), j with comm, pcV, chV, uF, hj)
      rw (evaluationHom.map_X at R, polynomialRing(R, I), I, polynomialConstant(R, I), tkJVariablesOn(R, I, mvVars(R, I, p), I), j with comm, polys, chI, wF, hj)
      by_cases jv : j ∈ mvVars(R, I, p)
      . rw [(uIn with j, hj, jv), (wIn with j, hj, jv)]
        rw (polynomialRename.map_X at R, mvVars(R, I, p), I, identity(mvVars(R, I, p)), j with comm, idF, jv)
        rw (identity.apply at j, mvVars(R, I, p) with jv)
      . rw [(uOut with j, hj, jv), (wOut with j, hj, jv)]
        exact RingHom.map_zero at polynomialRename(R, mvVars(R, I, p), I, identity(mvVars(R, I, p))), polynomialRing(R, mvVars(R, I, p)), polynomialRing(R, I) with rh
  rw ← (compose.apply at polynomialRename(R, mvVars(R, I, p), I, identity(mvVars(R, I, p))), evaluationHom(R, polynomialRing(R, mvVars(R, I, p)), I, polynomialConstant(R, mvVars(R, I, p)), tkJVariablesOn(R, I, mvVars(R, I, p), mvVars(R, I, p))), Ring.carrier(polynomialRing(R, I)), Ring.carrier(polynomialRing(R, mvVars(R, I, p))), Ring.carrier(polynomialRing(R, I)), p with efn, rfn, pIn)
  rw eq
  -- Evaluation at w agrees with evaluation at the variables on p.
  have xs : ∀ i ∈ I, X(R, I, i) ∈ Ring.carrier(polynomialRing(R, I))
    intros i hi
    exact X.mem at R, I, i with comm
  obtain ⟨vF, vV⟩ := mv.variables_function at R, I with xs
  have sourceParts := CommRing.parts with comm
  have targetParts := CommRing.parts with polys
  have homParts := RingHom.parts with chI
  have pp := polynomialRing.member_parts at R, I, p with comm, polys, pIn
  have agree : ∀ i ∈ polynomialVariablesUsed(I, R.carrier, R.zero, p), tkJVariablesOn(R, I, mvVars(R, I, p), I)(i) = mvVariables(R, I)(i)
    intros i hi
    have iv : i ∈ mvVars(R, I, p)
      unfold mvVars
      exact hi
    have iI := VI with i, iv
    rw [(wIn with i, iI, iv), (vV with i, iI)]
  have same := polynomialAtOver.agree_on_variables at I, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, Ring.carrier(polynomialRing(R, I)), Ring.add(polynomialRing(R, I)), Ring.zero(polynomialRing(R, I)), Ring.neg(polynomialRing(R, I)), Ring.mul(polynomialRing(R, I)), Ring.one(polynomialRing(R, I)), polynomialConstant(R, I), tkJVariablesOn(R, I, mvVars(R, I, p), I), mvVariables(R, I), p with sourceParts, targetParts, homParts, wF, vF, pp, agree
  have back := tkJ.eval_variables at R, I, p with comm, polys, pIn
  unfold evaluationHom at back
  unfold evaluationHom
  rw same
  exact back

-- Evaluation along a homomorphism: the universal property
-- (MvPolynomial.eval₂Hom_X', eval₂Hom_C, and uniqueness).
theorem evaluationHom.map_X_mv (S f v i : Set)
  requires target : CommRing(S)
  requires hom : f : R →+* S
  requires values : v : I → S.carrier
  requires index : i ∈ I
  shows evaluationHom(R, S, I, f, v)(X(R, I, i)) = v(i)
proof
  exact evaluationHom.map_X at R, S, I, f, v, i with comm, target, hom, values, index

-- Helper: the terms p(m) v^m of a value, as a family over the support.
theorem tkJ.value_terms (v : Set) (p : polynomialRing(R, I))
  requires values : v : I → R.carrier
  shows (monomialValueTerms(R, I, v, p) : mvSupport(R, I, p) → R.carrier) ∧
    (∀ m ∈ mvSupport(R, I, p), monomialValueTerms(R, I, v, p)(m) = call2(R.mul, p(m),
      evaluationAt(R, I, v)(mvMonomial(R, I, m, R.one))))
proof
  have pIn : p ∈ Ring.carrier(polynomialRing(R, I)) by assumption
  have oneIn : R.one ∈ R.carrier by typecheck
  have hom := evaluationAt.hom at R, I, v with comm, values
  have rel : ∀ m ∈ mvSupport(R, I, p), (m, call2(R.mul, p(m), evaluationAt(R, I, v)(mvMonomial(R, I, m, R.one)))) ∈ monomialValueTerms(R, I, v, p) ∧ call2(R.mul, p(m), evaluationAt(R, I, v)(mvMonomial(R, I, m, R.one))) ∈ R.carrier
    intros m hm
    have hm2 := hm
    unfold mvSupport at hm2
    obtain ⟨mIn, _⟩ := functionSupport.membership.forward with hm2
    have pm := polynomialRing.coefficient_mem at R, I, p, m with comm, polys, pIn, mIn
    have mono := mvMonomial.mem at R, I, m, R.one with comm, polys, mIn, oneIn
    have ev := RingHom.map_mem at evaluationAt(R, I, v), polynomialRing(R, I), R, mvMonomial(R, I, m, R.one) with hom, mono
    have val : call2(R.mul, p(m), evaluationAt(R, I, v)(mvMonomial(R, I, m, R.one))) ∈ R.carrier by typecheck
    have r : (m, call2(R.mul, p(m), evaluationAt(R, I, v)(mvMonomial(R, I, m, R.one)))) ∈ monomialValueTerms(R, I, v, p)
      apply monomialValueTerms.membership.backward
      refine ⟨(product.pair with hm, val), m, hm, rfl⟩
    exact ⟨r, val⟩
  have fn : monomialValueTerms(R, I, v, p) : mvSupport(R, I, p) → R.carrier
    apply tkJ.uni_graph_function
    . intros u hu
      exact (monomialValueTerms.membership.forward with hu).left
    . intros x y z hy hz
      obtain ⟨_, a, aIn, ea⟩ := monomialValueTerms.membership.forward with hy
      obtain ⟨_, b, bIn, eb⟩ := monomialValueTerms.membership.forward with hz
      obtain ⟨xa, ya⟩ := orderedPair.injective with ea
      obtain ⟨xb, yb⟩ := orderedPair.injective with eb
      rw [ya, yb, ← xa, ← xb]
    . intros x hx
      obtain ⟨r, val⟩ := rel with x, hx
      exact ⟨call2(R.mul, p(x), evaluationAt(R, I, v)(mvMonomial(R, I, x, R.one))), val, r⟩
  refine ⟨fn, ?_⟩
  intros m hm
  obtain ⟨r, val⟩ := rel with m, hm
  exact FunctionBetween.apply_value with fn, hm, r

-- MvPolynomial.eval_eq': the value of p at v is the sum over the support
-- of coefficients times monomial values.
theorem evaluationAt.as_sum (v : Set) (p : polynomialRing(R, I))
  requires values : v : I → R.carrier
  shows evaluationAt(R, I, v)(p) = finiteRingSum(mvSupport(R, I, p), R.carrier,
    R.add, R.zero, R.neg, R.mul, R.one, monomialValueTerms(R, I, v, p))
proof
  have pIn : p ∈ Ring.carrier(polynomialRing(R, I)) by assumption
  have pParts := CommRing.parts with polys
  have parts := CommRing.parts with comm
  have oneIn : R.one ∈ R.carrier by typecheck
  have one := monomialOne.member at I
  have hom := evaluationAt.hom at R, I, v with comm, values
  have homParts := RingHom.parts with hom
  have fin := mvSupport.finite at R, I, p with comm, polys, pIn
  obtain ⟨tF, tV⟩ := tkJ.monomial_terms at R, I, p with comm, polys, pIn
  obtain ⟨vF, vV⟩ := tkJ.value_terms at R, I, v, p with comm, polys, values, pIn
  have s := mvPolynomial.as_sum at R, I, p with comm, polys, pIn
  have e : evaluationAt(R, I, v)(p) = evaluationAt(R, I, v)(finiteRingSum(mvSupport(R, I, p), Ring.carrier(polynomialRing(R, I)), Ring.add(polynomialRing(R, I)), Ring.zero(polynomialRing(R, I)), Ring.neg(polynomialRing(R, I)), Ring.mul(polynomialRing(R, I)), Ring.one(polynomialRing(R, I)), monomialTerms(R, I, p))) by cc [s]
  have entries : ∀ m ∈ mvSupport(R, I, p), monomialValueTerms(R, I, v, p)(m) = evaluationAt(R, I, v)(monomialTerms(R, I, p)(m))
    intros m hm
    have hm2 := hm
    unfold mvSupport at hm2
    obtain ⟨mIn, _⟩ := functionSupport.membership.forward with hm2
    have pm := polynomialRing.coefficient_mem at R, I, p, m with comm, polys, pIn, mIn
    have split := mvMonomial.mul at R, I, monomialOne(I), m, p(m), R.one with comm, polys, one, mIn, pm, oneIn
    have mv := monomialMul.apply at I, monomialOne(I), m with one, mIn
    unfold call2 at mv
    rw [mv, (monomialProduct.commutative at I, monomialOne(I), m with one, mIn), (monomialProduct.one at I, m with mIn), (mvMonomial.zero at R, I, p(m) with comm, polys, pm)] at split
    have r1 : call2(R.mul, p(m), R.one) = p(m) by ring
    rw r1 at split
    have cIn := mvMonomial.mem at R, I, monomialOne(I), p(m) with comm, polys, one, pm
    rw (mvMonomial.zero at R, I, p(m) with comm, polys, pm) at cIn
    have mIn1 := mvMonomial.mem at R, I, m, R.one with comm, polys, mIn, oneIn
    rw [(vV with m, hm), (tV with m, hm), ← split, (RingHom.map_mul at evaluationAt(R, I, v), polynomialRing(R, I), R, mvC(R, I, p(m)), mvMonomial(R, I, m, R.one) with hom, cIn, mIn1)]
    unfold mvC
    rw (evaluationAt.map_constant at R, I, v, p(m) with comm, values, pm)
  have mapped := finiteRingSum.map at Ring.carrier(polynomialRing(R, I)), Ring.add(polynomialRing(R, I)), Ring.zero(polynomialRing(R, I)), Ring.neg(polynomialRing(R, I)), Ring.mul(polynomialRing(R, I)), Ring.one(polynomialRing(R, I)), R.carrier, R.add, R.zero, R.neg, R.mul, R.one, evaluationAt(R, I, v), mvSupport(R, I, p), monomialTerms(R, I, p), monomialValueTerms(R, I, v, p) with pParts, parts, homParts, fin, tF, vF, entries
  rw [e, mapped]

-- Coefficient maps: a homomorphism R[I] → S[I] (MvPolynomial.map,
-- coeff_map, map_X, map_C), functorial, injective for injective f
-- (map_injective), commuting with evaluation (MvPolynomial.eval_map,
-- map_aeval, eval₂_comp_left) and with partial derivatives
-- (MvPolynomial.pderiv_map).
theorem mvMap.hom (S f : Set)
  requires target : CommRing(S)
  requires hom : f : R →+* S
  shows mvMap(R, S, I, f) : polynomialRing(R, I) →+* polynomialRing(S, I)
proof
  have partsR := CommRing.parts with comm
  have partsS := CommRing.parts with target
  have homParts := RingHom.parts with hom
  have prR := CommRing.to_ring with polys
  have prS := CommRing.to_ring with (polynomialRing.comm_ring at S, I with target)
  have engine := polynomialMap.hom at I, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, S.carrier, S.add, S.zero, S.neg, S.mul, S.one, f with partsR, partsS, homParts
  have shifted : IsRingHom(polynomialMap(I, R.carrier, R.zero, S.carrier, S.zero, f),
      Ring.carrier(polynomialRing(R, I)), Ring.add(polynomialRing(R, I)),
      Ring.zero(polynomialRing(R, I)), Ring.neg(polynomialRing(R, I)),
      Ring.mul(polynomialRing(R, I)), Ring.one(polynomialRing(R, I)),
      Ring.carrier(polynomialRing(S, I)), Ring.add(polynomialRing(S, I)),
      Ring.zero(polynomialRing(S, I)), Ring.neg(polynomialRing(S, I)),
      Ring.mul(polynomialRing(S, I)), Ring.one(polynomialRing(S, I)))
    rw [polynomialRing.carrierOf, polynomialRing.addOf, polynomialRing.zeroOf,
      polynomialRing.negOf, polynomialRing.mulOf, polynomialRing.oneOf]
    rw [polynomialRing.carrierOf, polynomialRing.addOf, polynomialRing.zeroOf,
      polynomialRing.negOf, polynomialRing.mulOf, polynomialRing.oneOf]
    exact engine
  unfold mvMap
  exact RingHom.of_projections with prR, prS, shifted

theorem mvMap.coeff (S f m : Set) (p : polynomialRing(R, I))
  requires target : CommRing(S)
  requires hom : f : R →+* S
  requires monomial : m ∈ monomials(I)
  shows mvCoeff(mvMap(R, S, I, f)(p), m) = f(mvCoeff(p, m))
proof
  have homParts := RingHom.parts with hom
  have function := IsRingHom.function with homParts
  have zero := IsRingHom.zero with homParts
  have pIn : p ∈ Ring.carrier(polynomialRing(R, I)) by assumption
  have pp := polynomialRing.member_parts at R, I, p with comm, polys, pIn
  unfold mvMap
  unfold mvCoeff
  exact polynomialMap.coefficient at I, R.carrier, R.zero, S.carrier, S.zero, f, p, m with function, zero, pp, monomial

theorem mvMap.X (S f i : Set)
  requires target : CommRing(S)
  requires hom : f : R →+* S
  requires index : i ∈ I
  shows mvMap(R, S, I, f)(X(R, I, i)) = X(S, I, i)
proof
  have pcS := polynomialRing.comm_ring at S, I with target
  have mh := mvMap.hom at R, I, S, f with comm, polys, target, hom
  have xR := X.mem at R, I, i with comm
  have xS := X.mem at S, I, i with target
  have lm := RingHom.map_mem at mvMap(R, S, I, f), polynomialRing(R, I), polynomialRing(S, I), X(R, I, i) with mh, xR
  apply polynomialRing.ext at S, I, mvMap(R, S, I, f)(X(R, I, i)), X(S, I, i) with target, pcS, lm, xS
  intros m hm
  have c := mvMap.coeff at R, I, S, f, m, X(R, I, i) with comm, polys, xR, target, hom, hm
  unfold mvCoeff at c
  rw c
  by_cases e : m = monomialVariable(I, i)
  . rw e
    rw (X.coefficient_same at R, I, i with comm, polys, index)
    rw (X.coefficient_same at S, I, i with target, pcS, index)
    exact RingHom.map_one at f, R, S with hom
  . rw (X.coefficient_other at R, I, i, m with comm, polys, hm, e)
    rw (X.coefficient_other at S, I, i, m with target, pcS, hm, e)
    exact RingHom.map_zero at f, R, S with hom

theorem mvMap.C (S f a : Set)
  requires target : CommRing(S)
  requires hom : f : R →+* S
  requires scalar : a ∈ R.carrier
  shows mvMap(R, S, I, f)(mvC(R, I, a)) = mvC(S, I, f(a))
proof
  have pcS := polynomialRing.comm_ring at S, I with target
  have mh := mvMap.hom at R, I, S, f with comm, polys, target, hom
  have fa := RingHom.map_mem at f, R, S, a with hom, scalar
  have cR := polynomialConstant.mem at R, I, a with comm, scalar
  have cS := polynomialConstant.mem at S, I, f(a) with target, fa
  have lm := RingHom.map_mem at mvMap(R, S, I, f), polynomialRing(R, I), polynomialRing(S, I), polynomialConstant(R, I)(a) with mh, cR
  unfold mvC
  apply polynomialRing.ext at S, I, mvMap(R, S, I, f)(polynomialConstant(R, I)(a)), polynomialConstant(S, I)(f(a)) with target, pcS, lm, cS
  intros m hm
  have c := mvMap.coeff at R, I, S, f, m, polynomialConstant(R, I)(a) with comm, polys, cR, target, hom, hm
  unfold mvCoeff at c
  rw c
  by_cases e : m = monomialOne(I)
  . rw e
    rw (mv.C_coeff_one at R, I, a with comm, polys, scalar)
    rw (mv.C_coeff_one at S, I, f(a) with target, pcS, fa)
  . rw (polynomialConstant.coefficient_other at R, I, a, m with comm, polys, scalar, hm, e)
    rw (polynomialConstant.coefficient_other at S, I, f(a), m with target, pcS, fa, hm, e)
    exact RingHom.map_zero at f, R, S with hom

theorem mvMap.injective (S f : Set)
  requires target : CommRing(S)
  requires hom : f : R →+* S
  requires injective : InjectiveBetween(f, R.carrier, S.carrier)
  shows InjectiveBetween(mvMap(R, S, I, f), Ring.carrier(polynomialRing(R, I)),
    Ring.carrier(polynomialRing(S, I)))
proof
  have pcS := polynomialRing.comm_ring at S, I with target
  have mh := mvMap.hom at R, I, S, f with comm, polys, target, hom
  have m0 := mh
  obtain ⟨_, _, mfn, _⟩ := m0
  apply Injective.of_pointwise with mfn
  intros p hp q hq same
  apply polynomialRing.ext at R, I, p, q with comm, polys, hp, hq
  intros m hm
  have cp := mvMap.coeff at R, I, S, f, m, p with comm, polys, hp, target, hom, hm
  have cq := mvMap.coeff at R, I, S, f, m, q with comm, polys, hq, target, hom, hm
  rw same at cp
  rw cp at cq
  unfold mvCoeff at cq
  have pk := polynomialRing.coefficient_mem at R, I, p, m with comm, polys, hp, hm
  have qk := polynomialRing.coefficient_mem at R, I, q, m with comm, polys, hq, hm
  have fn := Injective.function with injective
  have fp := FunctionBetween.apply_closed with fn, pk
  have r1 := FunctionBetween.relates_apply with fn, pk
  have r2 := FunctionBetween.relates_apply with fn, qk
  rw ← cq at r2
  exact Injective.cancel at f, R.carrier, S.carrier, p(m), q(m), f(p(m)) with injective, pk, qk, fp, r1, r2

theorem mvMap.eval (S f v : Set) (p : polynomialRing(R, I))
  requires target : CommRing(S)
  requires hom : f : R →+* S
  requires values : v : I → S.carrier
  shows evaluationAt(S, I, v)(mvMap(R, S, I, f)(p)) = evaluationHom(R, S, I, f, v)(p)
proof
  have pcS := polynomialRing.comm_ring at S, I with target
  have pIn : p ∈ Ring.carrier(polynomialRing(R, I)) by assumption
  have eh := evaluationAt.hom at S, I, v with target, values
  have mh := mvMap.hom at R, I, S, f with comm, polys, target, hom
  have c := RingHom.comp at mvMap(R, S, I, f), evaluationAt(S, I, v), polynomialRing(R, I), polynomialRing(S, I), S with polys, mh, eh
  have m0 := mh
  obtain ⟨_, _, mfn, _⟩ := m0
  have e0 := eh
  obtain ⟨_, _, efn, _⟩ := e0
  have u := evaluationHom.unique at R, S, I, f, v, compose(evaluationAt(S, I, v), mvMap(R, S, I, f), Ring.carrier(polynomialRing(R, I)), Ring.carrier(polynomialRing(S, I)), S.carrier) with comm, target, hom, values, c
  have eq : compose(evaluationAt(S, I, v), mvMap(R, S, I, f), Ring.carrier(polynomialRing(R, I)), Ring.carrier(polynomialRing(S, I)), S.carrier) = evaluationHom(R, S, I, f, v)
    apply u
    . intros a ha
      have cIn := polynomialConstant.mem at R, I, a with comm, ha
      rw (compose.apply at evaluationAt(S, I, v), mvMap(R, S, I, f), Ring.carrier(polynomialRing(R, I)), Ring.carrier(polynomialRing(S, I)), S.carrier, polynomialConstant(R, I)(a) with mfn, efn, cIn)
      have mc := mvMap.C at R, I, S, f, a with comm, polys, target, hom, ha
      unfold mvC at mc
      rw mc
      have fa := RingHom.map_mem at f, R, S, a with hom, ha
      exact evaluationAt.map_constant at S, I, v, f(a) with target, values, fa
    . intros j hj
      have xIn := X.mem at R, I, j with comm
      rw (compose.apply at evaluationAt(S, I, v), mvMap(R, S, I, f), Ring.carrier(polynomialRing(R, I)), Ring.carrier(polynomialRing(S, I)), S.carrier, X(R, I, j) with mfn, efn, xIn)
      rw (mvMap.X at R, I, S, f, j with comm, polys, target, hom, hj)
      exact evaluationAt.map_X at S, I, v, j with target, values, hj
  rw ← eq
  rw (compose.apply at evaluationAt(S, I, v), mvMap(R, S, I, f), Ring.carrier(polynomialRing(R, I)), Ring.carrier(polynomialRing(S, I)), S.carrier, p with mfn, efn, pIn)

theorem mvMap.compose (S T f g : Set) (p : polynomialRing(R, I))
  requires targetS : CommRing(S)
  requires targetT : CommRing(T)
  requires first : f : R →+* S
  requires second : g : S →+* T
  shows mvMap(S, T, I, g)(mvMap(R, S, I, f)(p)) =
    mvMap(R, T, I, compose(g, f, R.carrier, S.carrier, T.carrier))(p)
proof
  have pcS := polynomialRing.comm_ring at S, I with targetS
  have pcT := polynomialRing.comm_ring at T, I with targetT
  have pIn : p ∈ Ring.carrier(polynomialRing(R, I)) by assumption
  have gf := RingHom.comp at f, g, R, S, T with comm, first, second
  have mf := mvMap.hom at R, I, S, f with comm, polys, targetS, first
  have mg := mvMap.hom at S, I, T, g with targetS, pcS, targetT, second
  have mgf := mvMap.hom at R, I, T, compose(g, f, R.carrier, S.carrier, T.carrier) with comm, polys, targetT, gf
  have l1 := RingHom.map_mem at mvMap(R, S, I, f), polynomialRing(R, I), polynomialRing(S, I), p with mf, pIn
  have l2 := RingHom.map_mem at mvMap(S, T, I, g), polynomialRing(S, I), polynomialRing(T, I), mvMap(R, S, I, f)(p) with mg, l1
  have l3 := RingHom.map_mem at mvMap(R, T, I, compose(g, f, R.carrier, S.carrier, T.carrier)), polynomialRing(R, I), polynomialRing(T, I), p with mgf, pIn
  apply polynomialRing.ext at T, I, mvMap(S, T, I, g)(mvMap(R, S, I, f)(p)), mvMap(R, T, I, compose(g, f, R.carrier, S.carrier, T.carrier))(p) with targetT, pcT, l2, l3
  intros m hm
  have c1 := mvMap.coeff at S, I, T, g, m, mvMap(R, S, I, f)(p) with targetS, pcS, l1, targetT, second, hm
  have c2 := mvMap.coeff at R, I, S, f, m, p with comm, polys, pIn, targetS, first, hm
  have c3 := mvMap.coeff at R, I, T, compose(g, f, R.carrier, S.carrier, T.carrier), m, p with comm, polys, pIn, targetT, gf, hm
  unfold mvCoeff at c1
  unfold mvCoeff at c2
  unfold mvCoeff at c3
  rw [c1, c2, c3]
  have f0 := first
  obtain ⟨_, _, ffn, _⟩ := f0
  have g0 := second
  obtain ⟨_, _, gfn, _⟩ := g0
  have ck := polynomialRing.coefficient_mem at R, I, p, m with comm, polys, pIn, hm
  rw (compose.apply at g, f, R.carrier, S.carrier, T.carrier, p(m) with ffn, gfn, ck)

theorem mvMap.partial_derivative (S f i : Set) (p : polynomialRing(R, I))
  requires target : CommRing(S)
  requires hom : f : R →+* S
  requires index : i ∈ I
  shows mvMap(R, S, I, f)(partialDerivative(R, I, i)(p)) =
    partialDerivative(S, I, i)(mvMap(R, S, I, f)(p))
proof
  have pcS := polynomialRing.comm_ring at S, I with target
  have pIn : p ∈ Ring.carrier(polynomialRing(R, I)) by assumption
  have mh := mvMap.hom at R, I, S, f with comm, polys, target, hom
  have dIn := partialDerivative.map_mem at R, I, i, p with comm, polys, index, pIn
  have l1 := RingHom.map_mem at mvMap(R, S, I, f), polynomialRing(R, I), polynomialRing(S, I), partialDerivative(R, I, i)(p) with mh, dIn
  have l2 := RingHom.map_mem at mvMap(R, S, I, f), polynomialRing(R, I), polynomialRing(S, I), p with mh, pIn
  have l3 := partialDerivative.map_mem at S, I, i, mvMap(R, S, I, f)(p) with target, pcS, index, l2
  apply polynomialRing.ext at S, I, mvMap(R, S, I, f)(partialDerivative(R, I, i)(p)), partialDerivative(S, I, i)(mvMap(R, S, I, f)(p)) with target, pcS, l1, l3
  intros m hm
  have c1 := mvMap.coeff at R, I, S, f, m, partialDerivative(R, I, i)(p) with comm, polys, dIn, target, hom, hm
  unfold mvCoeff at c1
  rw c1
  rw (partialDerivative.coefficient at R, I, i, p, m with comm, polys, index, pIn, hm)
  rw (partialDerivative.coefficient at S, I, i, mvMap(R, S, I, f)(p), m with target, pcS, index, l2, hm)
  have sm := shiftMonomial.member at I, i, m with index, hm
  have c2 := mvMap.coeff at R, I, S, f, shiftMonomial(I, m, i), p with comm, polys, pIn, target, hom, sm
  unfold mvCoeff at c2
  rw c2
  have pk := polynomialRing.coefficient_mem at R, I, p, shiftMonomial(I, m, i) with comm, polys, pIn, sm
  have mi := monomials.exponent at I, m, i with hm, index
  have nk : ringNat(R.add, R.zero, R.one, succ(m(i))) ∈ R.carrier by typecheck
  rw (RingHom.map_mul at f, R, S, ringNat(R.add, R.zero, R.one, succ(m(i))), p(shiftMonomial(I, m, i)) with hom, nk, pk)
  rw (RingHom.map_numeral at R, S, f, succ(m(i)) with comm, target, hom)

-- Partial derivatives (MvPolynomial.pderiv_X, pderiv_C, pderiv_mul, and
-- the coefficient formula coeff_pderiv: the coefficient at m of ∂ᵢp is
-- (m(i) + 1) times the coefficient of p at m + eᵢ).
theorem partialDerivative.X_mv (i j : Set)
  requires first : i ∈ I
  requires second : j ∈ I
  shows (i = j → partialDerivative(R, I, i)(X(R, I, j)) = Ring.one(polynomialRing(R, I))) ∧
    (i ≠ j → partialDerivative(R, I, i)(X(R, I, j)) = Ring.zero(polynomialRing(R, I)))
proof
  constructor
  . intro e
    rw ← e
    exact partialDerivative.X_self at R, I, i with comm, polys, first
  . intro ne
    have ne2 : j ≠ i
      intro e
      apply ne
      rw e
    exact partialDerivative.X_other at R, I, i, j with comm, polys, first, second, ne2

theorem partialDerivative.coeff_mv (i m : Set) (p : polynomialRing(R, I))
  requires index : i ∈ I
  requires monomial : m ∈ monomials(I)
  shows mvCoeff(partialDerivative(R, I, i)(p), m) =
    call2(R.mul, mvCoeff(p, monomialMul(I)((m, monomialVariable(I, i)))),
      ringNat(R.add, R.zero, R.one, succ(m(i))))
proof
  have pIn : p ∈ Ring.carrier(polynomialRing(R, I)) by assumption
  have c := partialDerivative.coefficient at R, I, i, p, m with comm, polys, index, pIn, monomial
  have sh := shiftMonomial.product at I, i, m with index, monomial
  have mv := monomialVariable.member at I, i
  have cm := monomialProduct.commutative at I, monomialVariable(I, i), m with mv, monomial
  have ap := monomialMul.apply at I, m, monomialVariable(I, i) with monomial, mv
  unfold call2 at ap
  rw [sh, cm, ← ap] at c
  unfold mvCoeff
  rw c
  have sm := monomialProduct.member at I, m, monomialVariable(I, i) with monomial, mv
  rw ← ap at sm
  have pk := polynomialRing.coefficient_mem at R, I, p, monomialMul(I)((m, monomialVariable(I, i))) with comm, polys, pIn, sm
  have mi := monomials.exponent at I, m, i with monomial, index
  have nk : ringNat(R.add, R.zero, R.one, succ(m(i))) ∈ R.carrier by typecheck
  ring

-- Total degree (MvPolynomial.le_totalDegree, totalDegree_add,
-- totalDegree_mul, totalDegree_X, totalDegree_C).
theorem mvTotalDegree.le (m : Set) (p : polynomialRing(R, I))
  requires support : m ∈ mvSupport(R, I, p)
  shows monomialDegree(I, m) ≤ mvTotalDegree(R, I, p)
proof
  have pIn : p ∈ Ring.carrier(polynomialRing(R, I)) by assumption
  have sel := mvTotalDegree.selected at R, I, p with comm, pIn
  obtain ⟨_, spec⟩ := sel
  cases spec with e | b
  . have s := support
    rw e.left at s
    have no := empty.membership at m
    exfalso
    exact no with s
  . exact b.right with m, support

-- Helper: the unit monomial has degree 0.
theorem rmEMv.one_degree
  shows monomialDegree(I, monomialOne(I)) = 0
proof
  have empty : functionSupport(monomialOne(I), I, 0) = ∅
    apply Subset.antisymmetric
    . intros i hi
      obtain ⟨iI, nz⟩ := functionSupport.membership.forward at monomialOne(I), I, 0, i with hi
      exfalso
      exact nz with (monomialOne.value at I, i with iI)
    . exact empty.subset at functionSupport(monomialOne(I), I, 0)
  unfold monomialDegree
  rw empty
  exact natSum.empty at monomialOne(I)

-- Helper: the unit exponent at i has degree 1.
theorem rmEMv.variable_degree (i : Set)
  requires index : i ∈ I
  shows monomialDegree(I, monomialVariable(I, i)) = 1
proof
  have single : functionSupport(monomialVariable(I, i), I, 0) = {i}
    apply Subset.antisymmetric
    . intros j hj
      obtain ⟨jI, nz⟩ := functionSupport.membership.forward at monomialVariable(I, i), I, 0, j with hj
      apply singleton.membership.backward
      by_contra ne
      exact nz with (monomialVariable.other at I, i, j with jI, ne)
    . intros j hj
      have ji := singleton.membership.forward with hj
      rw ji
      have one := monomialVariable.same at I, i with index
      have nz : monomialVariable(I, i)(i) ≠ 0
        rw one
        arith
      exact functionSupport.membership.backward at monomialVariable(I, i), I, 0, i with ⟨index, nz⟩
  have one := monomialVariable.same at I, i with index
  have w : monomialVariable(I, i)(i) ∈ ℕ
    rw one
    typecheck
  unfold monomialDegree
  rw single
  rw (natSum.singleton at monomialVariable(I, i), i with w)
  exact one

-- Helper: under the hypotheses of the induction, every monomial a X^m of
-- degree k lies in P.
theorem tkJ.monomials_in (P : Set) (k : Nat)
  requires constants : ∀ a ∈ R.carrier, mvC(R, I, a) ∈ P
  requires variables : ∀ p ∈ P ∩ Ring.carrier(polynomialRing(R, I)), ∀ i ∈ I,
    call2(Ring.mul(polynomialRing(R, I)), p, X(R, I, i)) ∈ P
  shows ∀ m ∈ monomials(I), monomialDegree(I, m) = k → ∀ a ∈ R.carrier,
    mvMonomial(R, I, m, a) ∈ P
proof
  have oneIn : R.one ∈ R.carrier by typecheck
  have one := monomialOne.member at I
  induction k
  | zero =>
    intros m hm d a ha
    have m1 := tkJ.degree_zero at I, m with hm, d
    rw [m1, (mvMonomial.zero at R, I, a with comm, polys, ha)]
    exact constants with a, ha
  | succ(j) using ih =>
    intros m hm d a ha
    have ne : m ≠ monomialOne(I)
      intro e
      rw e at d
      rw (rmEMv.one_degree at R, I with comm, polys) at d
      arith
    have exists : ∃ i ∈ I, m(i) ≠ 0
      by_contra none
      apply ne
      apply monomials.ext at I, m, monomialOne(I) with hm, one
      intros i hi
      rw (monomialOne.value at I, i with hi)
      by_contra nz
      exact none with ⟨i, hi, nz⟩
    obtain ⟨i, iI, nz⟩ := exists
    obtain ⟨n, nIn, mEq⟩ := monomials.unshift at I, i, m with iI, hm, nz
    have vi := monomialVariable.member at I, i
    rw (shiftMonomial.product at I, i, n with iI, nIn) at mEq
    have deg := tkJ.degree_mul at I, monomialVariable(I, i), n with vi, nIn
    rw [← mEq, (rmEMv.variable_degree at R, I, i with comm, polys, iI), d] at deg
    have nn := mv.monomial_degree_nat at I, n with nIn
    have dn : monomialDegree(I, n) = j by arith
    have inP := ih with n, nIn, dn, a, ha
    have inC := mvMonomial.mem at R, I, n, a with comm, polys, nIn, ha
    have both : mvMonomial(R, I, n, a) ∈ P ∩ Ring.carrier(polynomialRing(R, I)) := ⟨inP, inC⟩
    have step := variables with mvMonomial(R, I, n, a), both, i, iI
    rw [(X.eq_monomial at R, I, i with comm, polys, iI), (mvMonomial.mul at R, I, n, monomialVariable(I, i), a, R.one with comm, polys, nIn, vi, ha, oneIn)] at step
    have mv := monomialMul.apply at I, n, monomialVariable(I, i) with nIn, vi
    unfold call2 at mv
    have r1 : call2(R.mul, a, R.one) = a by ring
    rw [mv, r1, (monomialProduct.commutative at I, n, monomialVariable(I, i) with nIn, vi), ← mEq] at step
    exact step

-- MvPolynomial.induction_on: a set of polynomials containing the
-- constants and closed under sums and under multiplication by variables
-- contains every polynomial.
theorem mvPolynomial.induction (P : Set)
  requires constants : ∀ a ∈ R.carrier, mvC(R, I, a) ∈ P
  requires sums : ∀ p q ∈ P ∩ Ring.carrier(polynomialRing(R, I)),
    call2(Ring.add(polynomialRing(R, I)), p, q) ∈ P
  requires variables : ∀ p ∈ P ∩ Ring.carrier(polynomialRing(R, I)), ∀ i ∈ I,
    call2(Ring.mul(polynomialRing(R, I)), p, X(R, I, i)) ∈ P
  shows Ring.carrier(polynomialRing(R, I)) ⊆ P
proof
  have parts := CommRing.parts with comm
  have zeroIn : R.zero ∈ R.carrier by typecheck
  have pc := polynomialConstant.hom at R, I with comm
  intros p hp
  have pp := polynomialRing.member_parts at R, I, p with comm, polys, hp
  have base : constantFunction(monomials(I), R.carrier, R.zero) ∈ P ∩ Ring.carrier(polynomialRing(R, I))
    have z := RingHom.map_zero with pc
    have c0 := constants with R.zero, zeroIn
    unfold mvC at c0
    rw [z, polynomialRing.zeroOf] at c0
    have zc : Ring.zero(polynomialRing(R, I)) ∈ Ring.carrier(polynomialRing(R, I)) by typecheck
    rw polynomialRing.zeroOf at zc
    exact ⟨c0, zc⟩
  have terms : ∀ a ∈ R.carrier, ∀ m ∈ monomials(I), polynomialTerm(I, R.carrier, R.zero, a, m) ∈ P ∩ Ring.carrier(polynomialRing(R, I))
    intros a ha m hm
    have dn := mv.monomial_degree_nat at I, m with hm
    have inP := (tkJ.monomials_in at R, I, P, monomialDegree(I, m) with comm, polys, constants, variables) with m, hm, rfl, a, ha
    have inC := mvMonomial.mem at R, I, m, a with comm, polys, hm, ha
    unfold mvMonomial at inP
    unfold mvMonomial at inC
    unfold polynomialTerm
    exact ⟨inP, inC⟩
  have closedSums : ∀ f ∈ P ∩ Ring.carrier(polynomialRing(R, I)), ∀ g ∈ P ∩ Ring.carrier(polynomialRing(R, I)), coefficientAdd(monomials(I), R.carrier, R.add, R.zero, R.neg, R.mul, R.one, f, g) ∈ P ∩ Ring.carrier(polynomialRing(R, I))
    intros f hf g hg
    obtain ⟨_, fC⟩ := hf
    obtain ⟨_, gC⟩ := hg
    have s := sums with f, hf, g, hg
    have sc : call2(Ring.add(polynomialRing(R, I)), f, g) ∈ Ring.carrier(polynomialRing(R, I)) by typecheck
    rw (polynomialRing.add_apply at R, I, f, g with comm, polys, fC, gC) at s
    rw (polynomialRing.add_apply at R, I, f, g with comm, polys, fC, gC) at sc
    exact ⟨s, sc⟩
  have res := polynomials.induction at I, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, P ∩ Ring.carrier(polynomialRing(R, I)), p with parts, pp, base, terms, closedSums
  obtain ⟨inP, _⟩ := res
  exact inP

theorem mvTotalDegree.add_le (p q : polynomialRing(R, I)) (n : Nat)
  requires first : mvTotalDegree(R, I, p) ≤ n
  requires second : mvTotalDegree(R, I, q) ≤ n
  shows mvTotalDegree(R, I, p + q) ≤ n
proof
  have pIn : p ∈ Ring.carrier(polynomialRing(R, I)) by assumption
  have qIn : q ∈ Ring.carrier(polynomialRing(R, I)) by assumption
  have sIn : p + q ∈ Ring.carrier(polynomialRing(R, I)) by typecheck
  have sel := mvTotalDegree.selected at R, I, p + q with comm, sIn
  obtain ⟨dN, spec⟩ := sel
  cases spec with emp | b
  . rw emp.right
    arith
  . obtain ⟨⟨m, mS, md⟩, _⟩ := b
    rw ← md
    have mS0 := mS
    unfold mvSupport at mS0
    obtain ⟨mIn, nz⟩ := functionSupport.membership.forward at p + q, monomials(I), R.zero, m with mS0
    have ca := polynomialRing.coefficient_add at R, I, p, q, m with comm, polys, pIn, qIn, mIn
    have mNat := mv.monomial_degree_nat at I, m with mIn
    by_cases pz : p(m) = R.zero
    . have qnz : q(m) ≠ R.zero
        intro qz
        have qmIn := polynomialRing.coefficient_mem at R, I, q, m with comm, polys, qIn, mIn
        rw [pz, qz] at ca
        have z : call2(R.add, R.zero, R.zero) = R.zero by ring
        rw z at ca
        exact nz with ca
      have qS : m ∈ mvSupport(R, I, q)
        unfold mvSupport
        exact functionSupport.membership.backward at q, monomials(I), R.zero, m with ⟨mIn, qnz⟩
      have le := mvTotalDegree.le at R, I, m, q with comm, polys, qIn, qS
      have qdN := (mvTotalDegree.selected at R, I, q with comm, qIn).left
      have qdNat := nat.omega.backward with qdN
      arith
    . have pS : m ∈ mvSupport(R, I, p)
        unfold mvSupport
        exact functionSupport.membership.backward at p, monomials(I), R.zero, m with ⟨mIn, pz⟩
      have le := mvTotalDegree.le at R, I, m, p with comm, polys, pIn, pS
      have pdN := (mvTotalDegree.selected at R, I, p with comm, pIn).left
      have pdNat := nat.omega.backward with pdN
      arith

theorem mvTotalDegree.mul_le (p q : polynomialRing(R, I))
  shows mvTotalDegree(R, I, p * q) ≤ mvTotalDegree(R, I, p) + mvTotalDegree(R, I, q)
proof
  have parts := CommRing.parts with comm
  have pIn : p ∈ Ring.carrier(polynomialRing(R, I)) by assumption
  have qIn : q ∈ Ring.carrier(polynomialRing(R, I)) by assumption
  have pqIn : p * q ∈ Ring.carrier(polynomialRing(R, I)) by typecheck
  have pp := polynomialRing.member_parts at R, I, p with comm, polys, pIn
  have qp := polynomialRing.member_parts at R, I, q with comm, polys, qIn
  have pdN := (mvTotalDegree.selected at R, I, p with comm, pIn).left
  have qdN := (mvTotalDegree.selected at R, I, q with comm, qIn).left
  have pdNat := nat.omega.backward with pdN
  have qdNat := nat.omega.backward with qdN
  obtain ⟨dN, spec⟩ := mvTotalDegree.selected at R, I, p * q with comm, pqIn
  have dNat := nat.omega.backward with dN
  cases spec with e | b
  . rw e.right
    arith
  . obtain ⟨⟨m, hm, dm⟩, _⟩ := b
    have hm2 := hm
    unfold mvSupport at hm2
    rw (polynomialRing.mul_apply at R, I, p, q with comm, polys, pIn, qIn) at hm2
    obtain ⟨u, hu, v, hv, mEq⟩ := polynomialProduct.support_factor at I, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, p, q, m with parts, pp, qp, hm2
    obtain ⟨uIn, _⟩ := functionSupport.membership.forward with hu
    obtain ⟨vIn, _⟩ := functionSupport.membership.forward with hv
    have uS : u ∈ mvSupport(R, I, p)
      unfold mvSupport
      exact hu
    have vS : v ∈ mvSupport(R, I, q)
      unfold mvSupport
      exact hv
    have lu := mvTotalDegree.le at R, I, u, p with comm, polys, pIn, uS
    have lv := mvTotalDegree.le at R, I, v, q with comm, polys, qIn, vS
    have deg := tkJ.degree_mul at I, u, v with uIn, vIn
    rw ← mEq at deg
    have un := mv.monomial_degree_nat at I, u with uIn
    have vn := mv.monomial_degree_nat at I, v with vIn
    obtain ⟨mIn, _⟩ := functionSupport.membership.forward with hm2
    have mn := mv.monomial_degree_nat at I, m with mIn
    rw ← dm
    arith

theorem mvTotalDegree.X (i : Set)
  requires index : i ∈ I
  requires nontrivial : R.zero ≠ R.one
  shows mvTotalDegree(R, I, X(R, I, i)) = 1
proof
  have oneIn : R.one ∈ R.carrier by typecheck
  have vm := monomialVariable.member at I, i
  have xIn := mvMonomial.mem at R, I, monomialVariable(I, i), R.one with comm, polys, vm, oneIn
  rw (X.eq_monomial at R, I, i with comm, polys, index)
  have vS : monomialVariable(I, i) ∈ mvSupport(R, I, mvMonomial(R, I, monomialVariable(I, i), R.one))
    have c := (mvMonomial.coeff at R, I, monomialVariable(I, i), R.one, monomialVariable(I, i) with comm, polys, vm, oneIn, vm).left with rfl
    unfold mvCoeff at c
    have nz : mvMonomial(R, I, monomialVariable(I, i), R.one)(monomialVariable(I, i)) ≠ R.zero
      rw c
      intro e
      have e2 : R.zero = R.one
        rw e
      exact nontrivial with e2
    unfold mvSupport
    exact functionSupport.membership.backward at mvMonomial(R, I, monomialVariable(I, i), R.one), monomials(I), R.zero, monomialVariable(I, i) with ⟨vm, nz⟩
  have sel := mvTotalDegree.selected at R, I, mvMonomial(R, I, monomialVariable(I, i), R.one) with comm, xIn
  obtain ⟨_, spec⟩ := sel
  cases spec with emp | b
  . exfalso
    have s := vS
    rw emp.left at s
    exact (empty.membership at monomialVariable(I, i)) with s
  . obtain ⟨⟨n, nS, nd⟩, _⟩ := b
    have nS0 := nS
    unfold mvSupport at nS0
    obtain ⟨nIn, nz⟩ := functionSupport.membership.forward at mvMonomial(R, I, monomialVariable(I, i), R.one), monomials(I), R.zero, n with nS0
    by_cases nv : n = monomialVariable(I, i)
    . rw nv at nd
      rw (rmEMv.variable_degree at R, I, i with comm, polys, index) at nd
      rw nd
    . exfalso
      have c := (mvMonomial.coeff at R, I, monomialVariable(I, i), R.one, n with comm, polys, vm, oneIn, nIn).right with nv
      unfold mvCoeff at c
      exact nz with c

theorem mvTotalDegree.C (a : R)
  shows mvTotalDegree(R, I, mvC(R, I, a)) = 0
proof
  have aIn : a ∈ R.carrier by typecheck
  have m1 := monomialOne.member at I
  have e := mvMonomial.zero at R, I, a with comm, polys, aIn
  have cIn := mvMonomial.mem at R, I, monomialOne(I), a with comm, polys, m1, aIn
  rw ← e
  have sel := mvTotalDegree.selected at R, I, mvMonomial(R, I, monomialOne(I), a) with comm, cIn
  obtain ⟨_, spec⟩ := sel
  cases spec with emp | b
  . exact emp.right
  . obtain ⟨⟨n, nS, nd⟩, _⟩ := b
    unfold mvSupport at nS
    obtain ⟨nIn, nz⟩ := functionSupport.membership.forward at mvMonomial(R, I, monomialOne(I), a), monomials(I), R.zero, n with nS
    by_cases nOne : n = monomialOne(I)
    . rw nOne at nd
      rw (rmEMv.one_degree at R, I with comm, polys) at nd
      rw nd
    . exfalso
      have c := (mvMonomial.coeff at R, I, monomialOne(I), a, n with comm, polys, m1, aIn, nIn).right with nOne
      unfold mvCoeff at c
      exact nz with c

-- Homogeneous polynomials: X is homogeneous of degree 1, monomials of
-- their degree (MvPolynomial.isHomogeneous_X, isHomogeneous_monomial),
-- products add degrees (IsHomogeneous.mul), the homogeneous polynomials of
-- degree n form a submodule (homogeneousSubmodule), components are
-- homogeneous (homogeneousComponent_mem), and p is the finite sum of its
-- components up to its total degree (sum_homogeneousComponent).
theorem MvHomogeneous.monomial (m a : Set)
  requires monomial : m ∈ monomials(I)
  requires scalar : a ∈ R.carrier
  shows MvHomogeneous(R, I, mvMonomial(R, I, m, a), monomialDegree(I, m))
proof
  have mm := mvMonomial.mem at R, I, m, a with comm, polys, monomial, scalar
  refine ⟨mm, ?_⟩
  intros n hn
  unfold mvSupport at hn
  obtain ⟨nIn, nz⟩ := functionSupport.membership.forward at mvMonomial(R, I, m, a), monomials(I), R.zero, n with hn
  by_contra ne
  have nm : n ≠ m
    intro e
    rw e at ne
    exact ne with rfl
  have c := (mvMonomial.coeff at R, I, m, a, n with comm, polys, monomial, scalar, nIn).right with nm
  unfold mvCoeff at c
  exact nz with c

theorem MvHomogeneous.X (i : Set)
  requires index : i ∈ I
  shows MvHomogeneous(R, I, X(R, I, i), 1)
proof
  have oneIn : R.one ∈ R.carrier by typecheck
  have vm := monomialVariable.member at I, i
  have h := MvHomogeneous.monomial at R, I, monomialVariable(I, i), R.one with comm, polys, vm, oneIn
  rw (rmEMv.variable_degree at R, I, i with comm, polys, index) at h
  rw (X.eq_monomial at R, I, i with comm, polys, index)
  exact h

theorem MvHomogeneous.mul (p q : polynomialRing(R, I)) (m n : Nat)
  requires first : MvHomogeneous(R, I, p, m)
  requires second : MvHomogeneous(R, I, q, n)
  shows MvHomogeneous(R, I, p * q, m + n)
proof
  have parts := CommRing.parts with comm
  have pIn : p ∈ Ring.carrier(polynomialRing(R, I)) by assumption
  have qIn : q ∈ Ring.carrier(polynomialRing(R, I)) by assumption
  have pqIn : p * q ∈ Ring.carrier(polynomialRing(R, I)) by typecheck
  have pp := polynomialRing.member_parts at R, I, p with comm, polys, pIn
  have qp := polynomialRing.member_parts at R, I, q with comm, polys, qIn
  obtain ⟨_, hp⟩ := first
  obtain ⟨_, hq⟩ := second
  unfold MvHomogeneous
  refine ⟨pqIn, ?_⟩
  intros k hk
  have hk2 := hk
  unfold mvSupport at hk2
  rw (polynomialRing.mul_apply at R, I, p, q with comm, polys, pIn, qIn) at hk2
  obtain ⟨u, hu, v, hv, kEq⟩ := polynomialProduct.support_factor at I, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, p, q, k with parts, pp, qp, hk2
  obtain ⟨uIn, _⟩ := functionSupport.membership.forward with hu
  obtain ⟨vIn, _⟩ := functionSupport.membership.forward with hv
  have uS : u ∈ mvSupport(R, I, p)
    unfold mvSupport
    exact hu
  have vS : v ∈ mvSupport(R, I, q)
    unfold mvSupport
    exact hv
  have deg := tkJ.degree_mul at I, u, v with uIn, vIn
  rw [← kEq, (hp with u, uS), (hq with v, vS)] at deg
  exact deg

theorem homogeneousComponent.homogeneous (p : polynomialRing(R, I)) (n : Nat)
  shows homogeneousComponent(R, I, n, p) ∈ homogeneousPolynomials(R, I, n)
proof
  have pIn : p ∈ Ring.carrier(polynomialRing(R, I)) by assumption
  have pp := polynomialRing.member_parts at R, I, p with comm, polys, pIn
  unfold polynomials at pp
  obtain ⟨_, pmap⟩ := coefficientMaps.membership.forward with pp
  obtain ⟨pF, pFin⟩ := pmap
  have zeroIn : R.zero ∈ R.carrier by typecheck
  have rel : ∀ m ∈ monomials(I), (monomialDegree(I, m) = n → relates(homogeneousComponent(R, I, n, p), m, p(m))) ∧ (monomialDegree(I, m) ≠ n → relates(homogeneousComponent(R, I, n, p), m, R.zero))
    intros m mIn
    have pm := FunctionBetween.apply_closed with pF, mIn
    constructor
    . intro d
      have pq := product.pair with mIn, pm
      unfold relates
      have o : (monomialDegree(I, m) = n ∧ (m, p(m)) = (m, p(m))) ∨ (monomialDegree(I, m) ≠ n ∧ (m, p(m)) = (m, R.zero))
        left
        exact ⟨d, rfl⟩
      exact homogeneousComponent.membership.backward with ⟨pq, m, mIn, o⟩
    . intro d
      have pq := product.pair with mIn, zeroIn
      unfold relates
      have o : (monomialDegree(I, m) = n ∧ (m, R.zero) = (m, p(m))) ∨ (monomialDegree(I, m) ≠ n ∧ (m, R.zero) = (m, R.zero))
        right
        exact ⟨d, rfl⟩
      exact homogeneousComponent.membership.backward with ⟨pq, m, mIn, o⟩
  have fn : homogeneousComponent(R, I, n, p) : monomials(I) → R.carrier
    unfold FunctionBetween
    refine ⟨?_, ?_, ?_⟩
    . unfold RelationBetween
      intros q hq
      exact (homogeneousComponent.membership.forward with hq).left
    . unfold Functional
      intros x y hxy z hxz
      unfold relates at hxy
      unfold relates at hxz
      obtain ⟨_, a, aIn, c1⟩ := homogeneousComponent.membership.forward with hxy
      obtain ⟨_, b, bIn, c2⟩ := homogeneousComponent.membership.forward with hxz
      rcases c1 with ⟨d1, e1⟩ | ⟨d1, e1⟩
      . obtain ⟨x1, y1⟩ := orderedPair.injective with e1
        rcases c2 with ⟨d2, e2⟩ | ⟨d2, e2⟩
        . obtain ⟨x2, z2⟩ := orderedPair.injective with e2
          have ab : a = b
            rw [← x1, ← x2]
          rw [y1, z2, ab]
        . obtain ⟨x2, z2⟩ := orderedPair.injective with e2
          have ab : a = b
            rw [← x1, ← x2]
          rw ab at d1
          exfalso
          exact d2 with d1
      . obtain ⟨x1, y1⟩ := orderedPair.injective with e1
        rcases c2 with ⟨d2, e2⟩ | ⟨d2, e2⟩
        . obtain ⟨x2, z2⟩ := orderedPair.injective with e2
          have ab : a = b
            rw [← x1, ← x2]
          rw ab at d1
          exfalso
          exact d1 with d2
        . obtain ⟨x2, z2⟩ := orderedPair.injective with e2
          rw [y1, z2]
    . intros m mIn
      have pm := FunctionBetween.apply_closed with pF, mIn
      obtain ⟨r1, r2⟩ := rel with m, mIn
      by_cases d : monomialDegree(I, m) = n
      . exact ⟨p(m), pm, (r1 with d)⟩
      . exact ⟨R.zero, zeroIn, (r2 with d)⟩
  have degs : ∀ m ∈ mvSupport(R, I, homogeneousComponent(R, I, n, p)), monomialDegree(I, m) = n ∧ m ∈ mvSupport(R, I, p)
    intros m hm
    unfold mvSupport at hm
    obtain ⟨mIn, ne⟩ := functionSupport.membership.forward with hm
    obtain ⟨r1, r2⟩ := rel with m, mIn
    by_cases d : monomialDegree(I, m) = n
    . have v := FunctionBetween.apply_value with fn, mIn, (r1 with d)
      rw v at ne
      have ms : m ∈ mvSupport(R, I, p)
        unfold mvSupport
        exact functionSupport.membership.backward with ⟨mIn, ne⟩
      exact ⟨d, ms⟩
    . have v := FunctionBetween.apply_value with fn, mIn, (r2 with d)
      exfalso
      exact ne with v
  have sub : functionSupport(homogeneousComponent(R, I, n, p), monomials(I), R.zero) ⊆ functionSupport(p, monomials(I), R.zero)
    intros m hm
    have hm2 : m ∈ mvSupport(R, I, homogeneousComponent(R, I, n, p))
      unfold mvSupport
      exact hm
    have r := (degs with m, hm2).right
    unfold mvSupport at r
    exact r
  have fin := Finite.subset with pFin, sub
  have cm : CoefficientMap(homogeneousComponent(R, I, n, p), monomials(I), R.carrier, R.zero)
    unfold CoefficientMap
    exact ⟨fn, fin⟩
  have hIn : homogeneousComponent(R, I, n, p) ∈ Ring.carrier(polynomialRing(R, I))
    rw polynomialRing.carrierOf
    unfold polynomials
    exact coefficientMaps.contains with cm
  have degs2 : ∀ m ∈ mvSupport(R, I, homogeneousComponent(R, I, n, p)), monomialDegree(I, m) = n
    intros m hm
    exact (degs with m, hm).left
  have hom : MvHomogeneous(R, I, homogeneousComponent(R, I, n, p), n)
    unfold MvHomogeneous
    exact ⟨hIn, degs2⟩
  exact homogeneousPolynomials.membership.backward with ⟨hIn, hom⟩

-- Helpers: the coefficients of a homogeneous component, and the family of
-- components.
theorem tkJ.component_value (p : polynomialRing(R, I)) (n : Nat) (m : Set)
  requires monomial : m ∈ monomials(I)
  shows (monomialDegree(I, m) = n → homogeneousComponent(R, I, n, p)(m) = p(m)) ∧
    (monomialDegree(I, m) ≠ n → homogeneousComponent(R, I, n, p)(m) = R.zero)
proof
  have pIn : p ∈ Ring.carrier(polynomialRing(R, I)) by assumption
  have zeroIn : R.zero ∈ R.carrier by typecheck
  have hom := homogeneousComponent.homogeneous at R, I, p, n with comm, polys, pIn
  obtain ⟨hIn, _⟩ := homogeneousPolynomials.membership.forward with hom
  have hp := polynomialRing.member_parts at R, I, homogeneousComponent(R, I, n, p) with comm, polys, hIn
  have hF := polynomials.function with hp
  have pm := polynomialRing.coefficient_mem at R, I, p, m with comm, polys, pIn, monomial
  constructor
  . intro d
    have r : (m, p(m)) ∈ homogeneousComponent(R, I, n, p)
      apply homogeneousComponent.membership.backward
      refine ⟨(product.pair with monomial, pm), m, monomial, ?_⟩
      left
      exact ⟨d, rfl⟩
    exact FunctionBetween.apply_value with hF, monomial, r
  . intro d
    have r : (m, R.zero) ∈ homogeneousComponent(R, I, n, p)
      apply homogeneousComponent.membership.backward
      refine ⟨(product.pair with monomial, zeroIn), m, monomial, ?_⟩
      right
      exact ⟨d, rfl⟩
    exact FunctionBetween.apply_value with hF, monomial, r

theorem tkJ.component_family (p : polynomialRing(R, I))
  shows (componentFamily(R, I, p) : ℕ → Ring.carrier(polynomialRing(R, I))) ∧
    (∀ n ∈ ℕ, componentFamily(R, I, p)(n) = homogeneousComponent(R, I, n, p))
proof
  have pIn : p ∈ Ring.carrier(polynomialRing(R, I)) by assumption
  have rel : ∀ n ∈ ℕ, (n, homogeneousComponent(R, I, n, p)) ∈ componentFamily(R, I, p) ∧ homogeneousComponent(R, I, n, p) ∈ Ring.carrier(polynomialRing(R, I))
    intros n hn
    have nNat := nat.omega.backward with hn
    have hom := homogeneousComponent.homogeneous at R, I, p, n with comm, polys, pIn
    obtain ⟨v, _⟩ := homogeneousPolynomials.membership.forward with hom
    have r : (n, homogeneousComponent(R, I, n, p)) ∈ componentFamily(R, I, p)
      apply componentFamily.membership.backward
      refine ⟨(product.pair with hn, v), n, hn, rfl⟩
    exact ⟨r, v⟩
  have fn : componentFamily(R, I, p) : ℕ → Ring.carrier(polynomialRing(R, I))
    apply tkJ.uni_graph_function
    . intros u hu
      exact (componentFamily.membership.forward with hu).left
    . intros x y z hy hz
      obtain ⟨_, a, aIn, ea⟩ := componentFamily.membership.forward with hy
      obtain ⟨_, b, bIn, eb⟩ := componentFamily.membership.forward with hz
      obtain ⟨xa, ya⟩ := orderedPair.injective with ea
      obtain ⟨xb, yb⟩ := orderedPair.injective with eb
      rw [ya, yb, ← xa, ← xb]
    . intros x hx
      obtain ⟨r, v⟩ := rel with x, hx
      exact ⟨homogeneousComponent(R, I, x, p), v, r⟩
  refine ⟨fn, ?_⟩
  intros n hn
  obtain ⟨r, v⟩ := rel with n, hn
  exact FunctionBetween.apply_value with fn, hn, r

theorem homogeneousComponent.sum (p : polynomialRing(R, I))
  shows p = finiteRingSum(succ(mvTotalDegree(R, I, p)),
    Ring.carrier(polynomialRing(R, I)), Ring.add(polynomialRing(R, I)),
    Ring.zero(polynomialRing(R, I)), Ring.neg(polynomialRing(R, I)),
    Ring.mul(polynomialRing(R, I)), Ring.one(polynomialRing(R, I)),
    restrict(componentFamily(R, I, p), succ(mvTotalDegree(R, I, p))))
proof
  have pIn : p ∈ Ring.carrier(polynomialRing(R, I)) by assumption
  have pParts := CommRing.parts with polys
  have parts := CommRing.parts with comm
  have zeroIn : R.zero ∈ R.carrier by typecheck
  have tdN := (mvTotalDegree.selected at R, I, p with comm, pIn).left
  have tdNat := nat.omega.backward with tdN
  have fin := Finite.natural at succ(mvTotalDegree(R, I, p))
  obtain ⟨cfF, cfV⟩ := tkJ.component_family at R, I, p with comm, polys, pIn
  have sub : succ(mvTotalDegree(R, I, p)) ⊆ ℕ
    intros x hx
    have xNat := natural.member at succ(mvTotalDegree(R, I, p)) with x, hx
    exact nat.omega.forward with xNat
  have closed : ∀ x ∈ succ(mvTotalDegree(R, I, p)), componentFamily(R, I, p)(x) ∈ Ring.carrier(polynomialRing(R, I))
    intros x hx
    exact FunctionBetween.apply_closed with cfF, (sub with x, hx)
  have rF := restrict.function at componentFamily(R, I, p), ℕ, Ring.carrier(polynomialRing(R, I)), succ(mvTotalDegree(R, I, p)), Ring.carrier(polynomialRing(R, I)) with cfF, sub, closed
  have sumIn := finiteRingSum.closed with pParts, fin, rF
  apply polynomialRing.ext at R, I, p, finiteRingSum(succ(mvTotalDegree(R, I, p)), Ring.carrier(polynomialRing(R, I)), Ring.add(polynomialRing(R, I)), Ring.zero(polynomialRing(R, I)), Ring.neg(polynomialRing(R, I)), Ring.mul(polynomialRing(R, I)), Ring.one(polynomialRing(R, I)), restrict(componentFamily(R, I, p), succ(mvTotalDegree(R, I, p)))) with comm, polys, pIn, sumIn
  intros n hn
  have c := mvCoeff.sum at R, I, succ(mvTotalDegree(R, I, p)), restrict(componentFamily(R, I, p), succ(mvTotalDegree(R, I, p))), n with comm, polys, fin, rF, hn
  unfold mvCoeff at c
  rw c
  obtain ⟨cF, cV⟩ := tkJ.mv_coefficient_family at R, I, succ(mvTotalDegree(R, I, p)), restrict(componentFamily(R, I, p), succ(mvTotalDegree(R, I, p))), n with comm, polys, rF, hn
  have termAt : ∀ d ∈ succ(mvTotalDegree(R, I, p)), coefficientFamily(R, succ(mvTotalDegree(R, I, p)), restrict(componentFamily(R, I, p), succ(mvTotalDegree(R, I, p))), n)(d) = homogeneousComponent(R, I, d, p)(n)
    intros d hd
    have dN := sub with d, hd
    rw [(cV with d, hd), (restrict.apply at componentFamily(R, I, p), ℕ, Ring.carrier(polynomialRing(R, I)), succ(mvTotalDegree(R, I, p)), Ring.carrier(polynomialRing(R, I)), d with cfF, sub, closed, hd), (cfV with d, dN)]
  have dn := mv.monomial_degree_nat at I, n with hn
  by_cases pz : p(n) = R.zero
  . have allZero : ∀ d ∈ succ(mvTotalDegree(R, I, p)), coefficientFamily(R, succ(mvTotalDegree(R, I, p)), restrict(componentFamily(R, I, p), succ(mvTotalDegree(R, I, p))), n)(d) = R.zero
      intros d hd
      have dNat := natural.member at succ(mvTotalDegree(R, I, p)) with d, hd
      obtain ⟨same, other⟩ := tkJ.component_value at R, I, p, d, n with comm, polys, pIn, hn
      rw (termAt with d, hd)
      by_cases e : monomialDegree(I, n) = d
      . rw [(same with e), pz]
      . exact other with e
    rw [pz, (finiteRingSum.zero with parts, fin, cF, allZero)]
  . have nS : n ∈ mvSupport(R, I, p)
      unfold mvSupport
      exact functionSupport.membership.backward with ⟨hn, pz⟩
    have le := mvTotalDegree.le at R, I, n, p with comm, polys, pIn, nS
    have dIn := membership.successor_of_LessEqual at monomialDegree(I, n), mvTotalDegree(R, I, p) with le
    have others : ∀ d ∈ succ(mvTotalDegree(R, I, p)), d ≠ monomialDegree(I, n) → coefficientFamily(R, succ(mvTotalDegree(R, I, p)), restrict(componentFamily(R, I, p), succ(mvTotalDegree(R, I, p))), n)(d) = R.zero
      intros d hd ne
      have dNat := natural.member at succ(mvTotalDegree(R, I, p)) with d, hd
      obtain ⟨_, other⟩ := tkJ.component_value at R, I, p, d, n with comm, polys, pIn, hn
      have ne2 : monomialDegree(I, n) ≠ d
        intro e
        apply ne
        rw e
      rw [(termAt with d, hd), (other with ne2)]
    obtain ⟨same, _⟩ := tkJ.component_value at R, I, p, monomialDegree(I, n), n with comm, polys, pIn, hn
    have e : monomialDegree(I, n) = monomialDegree(I, n) by rfl
    rw [(tkJ.mv_sum_single at R, I, coefficientFamily(R, succ(mvTotalDegree(R, I, p)), restrict(componentFamily(R, I, p), succ(mvTotalDegree(R, I, p))), n), succ(mvTotalDegree(R, I, p)), monomialDegree(I, n) with comm, polys, fin, cF, dIn, others), (termAt with monomialDegree(I, n), dIn), (same with e)]

-- Helpers: the scaled point t v, and the value of a monomial X^m of
-- degree k at t v.
theorem tkJ.scale_point (v t : Set)
  requires values : v : I → R.carrier
  requires scalar : t ∈ R.carrier
  shows (pointwiseScale(R, I, t, v) : I → R.carrier) ∧
    (∀ i ∈ I, pointwiseScale(R, I, t, v)(i) = call2(R.mul, t, v(i)))
proof
  have rel : ∀ i ∈ I, (i, call2(R.mul, t, v(i))) ∈ pointwiseScale(R, I, t, v) ∧ call2(R.mul, t, v(i)) ∈ R.carrier
    intros i hi
    have vi := FunctionBetween.apply_closed with values, hi
    have val : call2(R.mul, t, v(i)) ∈ R.carrier by typecheck
    have r : (i, call2(R.mul, t, v(i))) ∈ pointwiseScale(R, I, t, v)
      apply pointwiseScale.membership.backward
      refine ⟨(product.pair with hi, val), i, hi, rfl⟩
    exact ⟨r, val⟩
  have fn : pointwiseScale(R, I, t, v) : I → R.carrier
    apply tkJ.uni_graph_function
    . intros u hu
      exact (pointwiseScale.membership.forward with hu).left
    . intros x y z hy hz
      obtain ⟨_, a, aIn, ea⟩ := pointwiseScale.membership.forward with hy
      obtain ⟨_, b, bIn, eb⟩ := pointwiseScale.membership.forward with hz
      obtain ⟨xa, ya⟩ := orderedPair.injective with ea
      obtain ⟨xb, yb⟩ := orderedPair.injective with eb
      rw [ya, yb, ← xa, ← xb]
    . intros x hx
      obtain ⟨r, val⟩ := rel with x, hx
      exact ⟨call2(R.mul, t, v(x)), val, r⟩
  refine ⟨fn, ?_⟩
  intros i hi
  obtain ⟨r, val⟩ := rel with i, hi
  exact FunctionBetween.apply_value with fn, hi, r

theorem tkJ.eval_scale_monomial (v t : Set) (k : Nat)
  requires values : v : I → R.carrier
  requires scalar : t ∈ R.carrier
  shows ∀ m ∈ monomials(I), monomialDegree(I, m) = k →
    evaluationAt(R, I, pointwiseScale(R, I, t, v))(mvMonomial(R, I, m, R.one)) =
      call2(R.mul, Ring.pow(R, t, k), evaluationAt(R, I, v)(mvMonomial(R, I, m, R.one)))
proof
  have ringR := CommRing.to_ring with comm
  have oneIn : R.one ∈ R.carrier by typecheck
  have one := monomialOne.member at I
  obtain ⟨sF, sV⟩ := tkJ.scale_point at R, I, v, t with comm, polys, values, scalar
  have homV := evaluationAt.hom at R, I, v with comm, values
  have homS := evaluationAt.hom at R, I, pointwiseScale(R, I, t, v) with comm, sF
  induction k
  | zero =>
    intros m hm d
    have m1 := tkJ.degree_zero at I, m with hm, d
    rw [m1, (mvMonomial.zero at R, I, R.one with comm, polys, oneIn), (Ring.pow_zero at R, t with ringR, scalar)]
    unfold mvC
    rw [(evaluationAt.map_constant at R, I, pointwiseScale(R, I, t, v), R.one with comm, sF, oneIn), (evaluationAt.map_constant at R, I, v, R.one with comm, values, oneIn)]
    ring
  | succ(j) using ih =>
    intros m hm d
    have ne : m ≠ monomialOne(I)
      intro e
      rw e at d
      rw (rmEMv.one_degree at R, I with comm, polys) at d
      arith
    have exists : ∃ i ∈ I, m(i) ≠ 0
      by_contra none
      apply ne
      apply monomials.ext at I, m, monomialOne(I) with hm, one
      intros i hi
      rw (monomialOne.value at I, i with hi)
      by_contra nz
      exact none with ⟨i, hi, nz⟩
    obtain ⟨i, iI, nz⟩ := exists
    obtain ⟨n, nIn, mEq⟩ := monomials.unshift at I, i, m with iI, hm, nz
    have vi := monomialVariable.member at I, i
    rw (shiftMonomial.product at I, i, n with iI, nIn) at mEq
    have deg := tkJ.degree_mul at I, monomialVariable(I, i), n with vi, nIn
    rw [← mEq, (rmEMv.variable_degree at R, I, i with comm, polys, iI), d] at deg
    have nn := mv.monomial_degree_nat at I, n with nIn
    have dn : monomialDegree(I, n) = j by arith
    have split := mvMonomial.mul at R, I, n, monomialVariable(I, i), R.one, R.one with comm, polys, nIn, vi, oneIn, oneIn
    have mv := monomialMul.apply at I, n, monomialVariable(I, i) with nIn, vi
    unfold call2 at mv
    have r1 : call2(R.mul, R.one, R.one) = R.one by ring
    rw [mv, r1, (monomialProduct.commutative at I, n, monomialVariable(I, i) with nIn, vi), ← mEq, ← (X.eq_monomial at R, I, i with comm, polys, iI)] at split
    have nm := mvMonomial.mem at R, I, n, R.one with comm, polys, nIn, oneIn
    have xm := X.mem at R, I, i with comm
    have vI := FunctionBetween.apply_closed with values, iI
    have en := RingHom.map_mem at evaluationAt(R, I, v), polynomialRing(R, I), R, mvMonomial(R, I, n, R.one) with homV, nm
    have pj := Ring.pow_mem at R, t, j with ringR, scalar
    have shift := add.right_one at j with *
    rw [← split, (RingHom.map_mul at evaluationAt(R, I, pointwiseScale(R, I, t, v)), polynomialRing(R, I), R, mvMonomial(R, I, n, R.one), X(R, I, i) with homS, nm, xm), (RingHom.map_mul at evaluationAt(R, I, v), polynomialRing(R, I), R, mvMonomial(R, I, n, R.one), X(R, I, i) with homV, nm, xm), (ih with n, nIn, dn), (evaluationAt.map_X at R, I, pointwiseScale(R, I, t, v), i with comm, sF, iI), (evaluationAt.map_X at R, I, v, i with comm, values, iI), (sV with i, iI), ← shift, (Ring.pow_succ at R, t, j with ringR, scalar)]
    ring

-- A homogeneous polynomial of degree n has the value tⁿ p(v) at t v
-- (IsHomogeneous.eval_smul... in the form used for scaling).
theorem MvHomogeneous.eval_scale (v t : Set) (p : polynomialRing(R, I)) (n : Nat)
  requires homogeneous : MvHomogeneous(R, I, p, n)
  requires values : v : I → R.carrier
  requires scalar : t ∈ R.carrier
  shows evaluationAt(R, I, pointwiseScale(R, I, t, v))(p) =
    call2(R.mul, Ring.pow(R, t, n), evaluationAt(R, I, v)(p))
proof
  have pIn : p ∈ Ring.carrier(polynomialRing(R, I)) by assumption
  have ringR := CommRing.to_ring with comm
  have parts := CommRing.parts with comm
  have oneIn : R.one ∈ R.carrier by typecheck
  obtain ⟨sF, _⟩ := tkJ.scale_point at R, I, v, t with comm, polys, values, scalar
  obtain ⟨_, degs⟩ := homogeneous
  have fin := mvSupport.finite at R, I, p with comm, polys, pIn
  obtain ⟨wF, wV⟩ := tkJ.value_terms at R, I, v, p with comm, polys, values, pIn
  obtain ⟨uF, uV⟩ := tkJ.value_terms at R, I, pointwiseScale(R, I, t, v), p with comm, polys, sF, pIn
  have pn := Ring.pow_mem at R, t, n with ringR, scalar
  have homV := evaluationAt.hom at R, I, v with comm, values
  have entries : ∀ m ∈ mvSupport(R, I, p), monomialValueTerms(R, I, pointwiseScale(R, I, t, v), p)(m) = call2(R.mul, Ring.pow(R, t, n), monomialValueTerms(R, I, v, p)(m))
    intros m hm
    have hm2 := hm
    unfold mvSupport at hm2
    obtain ⟨mIn, _⟩ := functionSupport.membership.forward with hm2
    have pm := polynomialRing.coefficient_mem at R, I, p, m with comm, polys, pIn, mIn
    have nm := mvMonomial.mem at R, I, m, R.one with comm, polys, mIn, oneIn
    have em := RingHom.map_mem at evaluationAt(R, I, v), polynomialRing(R, I), R, mvMonomial(R, I, m, R.one) with homV, nm
    have sc := (tkJ.eval_scale_monomial at R, I, v, t, n with comm, polys, values, scalar) with m, mIn, (degs with m, hm)
    rw [(uV with m, hm), (wV with m, hm), sc]
    ring
  have scaled := finiteRingSum.scale_eq at mvSupport(R, I, p), R.carrier, R.add, R.zero, R.neg, R.mul, R.one, monomialValueTerms(R, I, v, p), monomialValueTerms(R, I, pointwiseScale(R, I, t, v), p), Ring.pow(R, t, n) with parts, fin, wF, uF, pn, entries
  rw [(evaluationAt.as_sum at R, I, pointwiseScale(R, I, t, v), p with comm, polys, sF, pIn), (evaluationAt.as_sum at R, I, v, p with comm, polys, values, pIn), scaled]

-- Helpers: the module of polynomials has the ring's carrier, addition,
-- and zero; a polynomial vanishes off its support.
theorem cldEMvModule.projections
  shows Module.carrier(mvModule(R, I)) = Ring.carrier(polynomialRing(R, I)) ∧
    Module.add(mvModule(R, I)) = Ring.add(polynomialRing(R, I)) ∧
    Module.zero(mvModule(R, I)) = Ring.zero(polynomialRing(R, I))
proof
  unfold mvModule
  unfold algebraModule
  rw [Module.mk.carrier, Module.mk.add, Module.mk.zero]
  rw [polynomialAlgebra.carrierOf, polynomialAlgebra.ring]
  exact ⟨rfl, rfl, rfl⟩

theorem cldEMvSupport.zero_off (s m : Set) (p : polynomialRing(R, I))
  requires support : mvSupport(R, I, p) ⊆ s
  requires monomial : m ∈ monomials(I)
  requires outside : m ∉ s
  shows p(m) = R.zero
proof
  by_contra ne
  have ms : m ∈ mvSupport(R, I, p)
    unfold mvSupport
    exact functionSupport.membership.backward with ⟨monomial, ne⟩
  exact outside with (support with ms)

-- Restricted support: a submodule (restrictSupport), monotone in the
-- support set (restrictSupport_mono), spanned by its monomials
-- (restrictSupport_eq_span).
theorem restrictSupport.submodule (s : Set)
  shows SubmoduleOf(restrictSupport(R, I, s), mvModule(R, I), R)
proof
  have mm := mvModule.module at R, I with comm, polys
  obtain ⟨pc, pa, pz⟩ := cldEMvModule.projections at R, I with comm, polys
  unfold SubmoduleOf
  refine ⟨mm, ?_, ?_, ?_, ?_⟩
  . intros p hp
    rw pc
    exact (restrictSupport.membership.forward with hp).left
  . rw pz
    have zIn : Ring.zero(polynomialRing(R, I)) ∈ Ring.carrier(polynomialRing(R, I)) by typecheck
    have sub : mvSupport(R, I, Ring.zero(polynomialRing(R, I))) ⊆ s
      intros m hm
      unfold mvSupport at hm
      obtain ⟨mMon, ne⟩ := functionSupport.membership.forward with hm
      exfalso
      exact ne with (polynomialRing.coefficient_zero at R, I, m with comm, polys, mMon)
    exact restrictSupport.membership.backward with ⟨zIn, sub⟩
  . intros p hp q hq
    rw pa
    obtain ⟨pIn, ps⟩ := restrictSupport.membership.forward with hp
    obtain ⟨qIn, qs⟩ := restrictSupport.membership.forward with hq
    have sIn : p + q ∈ Ring.carrier(polynomialRing(R, I)) by typecheck
    have sub : mvSupport(R, I, p + q) ⊆ s
      intros m hm
      unfold mvSupport at hm
      obtain ⟨mMon, ne⟩ := functionSupport.membership.forward with hm
      by_contra ms
      have p0 := cldEMvSupport.zero_off at R, I, s, m, p with comm, polys, pIn, ps, mMon, ms
      have q0 := cldEMvSupport.zero_off at R, I, s, m, q with comm, polys, qIn, qs, mMon, ms
      rw (polynomialRing.coefficient_add at R, I, p, q, m with comm, polys, pIn, qIn, mMon) at ne
      rw [p0, q0] at ne
      have e : R.zero + R.zero = R.zero by ring
      exact ne with e
    exact restrictSupport.membership.backward with ⟨sIn, sub⟩
  . intros a ha p hp
    obtain ⟨pIn, ps⟩ := restrictSupport.membership.forward with hp
    rw ← (mvC.mul_eq_smul at R, I, a, p with comm, polys, ha, pIn)
    have cIn : call2(Ring.mul(polynomialRing(R, I)), mvC(R, I, a), p) ∈ Ring.carrier(polynomialRing(R, I))
      unfold mvC
      typecheck
    have sub : mvSupport(R, I, call2(Ring.mul(polynomialRing(R, I)), mvC(R, I, a), p)) ⊆ s
      intros m hm
      unfold mvSupport at hm
      obtain ⟨mMon, ne⟩ := functionSupport.membership.forward with hm
      by_contra ms
      have p0 := cldEMvSupport.zero_off at R, I, s, m, p with comm, polys, pIn, ps, mMon, ms
      have c := mvC.mul_coeff at R, I, a, m, p with comm, polys, ha, mMon, pIn
      unfold mvCoeff at c
      rw [c, p0] at ne
      have e : a * R.zero = R.zero by ring
      exact ne with e
    exact restrictSupport.membership.backward with ⟨cIn, sub⟩

-- Helper: the monomials of degree n.
def cldEDegreeMonomials (n : Set) : Set :=
  { m ∈ monomials(I) | monomialDegree(I, m) = n }

theorem homogeneousPolynomials.submodule (n : Set)
  shows SubmoduleOf(homogeneousPolynomials(R, I, n), mvModule(R, I), R)
proof
  have e : homogeneousPolynomials(R, I, n) = restrictSupport(R, I, cldEDegreeMonomials(R, I, n))
    apply Subset.antisymmetric
    . intros p hp
      obtain ⟨pIn, hom⟩ := homogeneousPolynomials.membership.forward with hp
      obtain ⟨_, degs⟩ := hom
      have sub : mvSupport(R, I, p) ⊆ cldEDegreeMonomials(R, I, n)
        intros m hm
        have hm2 := hm
        unfold mvSupport at hm2
        obtain ⟨mMon, _⟩ := functionSupport.membership.forward with hm2
        exact cldEDegreeMonomials.membership.backward with ⟨mMon, (degs with m, hm)⟩
      exact restrictSupport.membership.backward with ⟨pIn, sub⟩
    . intros p hp
      obtain ⟨pIn, sub⟩ := restrictSupport.membership.forward with hp
      have degs : ∀ m ∈ mvSupport(R, I, p), monomialDegree(I, m) = n
        intros m hm
        exact (cldEDegreeMonomials.membership.forward with (sub with hm)).right
      have hom : MvHomogeneous(R, I, p, n)
        unfold MvHomogeneous
        exact ⟨pIn, degs⟩
      exact homogeneousPolynomials.membership.backward with ⟨pIn, hom⟩
  rw e
  exact restrictSupport.submodule at R, I, cldEDegreeMonomials(R, I, n) with comm, polys

theorem restrictSupport.mono (s t : Set)
  requires subset : s ⊆ t
  shows restrictSupport(R, I, s) ⊆ restrictSupport(R, I, t)
proof
  intros p hp
  unfold restrictSupport at hp
  obtain ⟨pIn, sub⟩ := hp
  unfold restrictSupport
  refine ⟨pIn, ?_⟩
  exact Subset.transitive with sub, subset

-- Helper: a monomial a X^m has total degree at most deg m.
theorem tkJ.monomial_total_le (m a : Set)
  requires monomial : m ∈ monomials(I)
  requires scalar : a ∈ R.carrier
  shows mvTotalDegree(R, I, mvMonomial(R, I, m, a)) ≤ monomialDegree(I, m)
proof
  have mIn := mvMonomial.mem at R, I, m, a with comm, polys, monomial, scalar
  have mNat := mv.monomial_degree_nat at I, m with monomial
  obtain ⟨_, spec⟩ := mvTotalDegree.selected at R, I, mvMonomial(R, I, m, a) with comm, mIn
  cases spec with emp | b
  . rw emp.right
    arith
  . obtain ⟨⟨n, nS, nd⟩, _⟩ := b
    unfold mvSupport at nS
    obtain ⟨nIn, nz⟩ := functionSupport.membership.forward at mvMonomial(R, I, m, a), monomials(I), R.zero, n with nS
    by_cases nm : n = m
    . rw nm at nd
      rw ← nd
      arith
    . exfalso
      have c := (mvMonomial.coeff at R, I, m, a, n with comm, polys, monomial, scalar, nIn).right with nm
      unfold mvCoeff at c
      exact nz with c

-- Helpers: the monomial basis family m ↦ X^m, a monomial a X^m as the
-- multiple a • X^m, and module sums of polynomials as ring sums.
theorem tkJ.mv_basis_family
  shows (monomialBasisFamily(R, I) : monomials(I) → Ring.carrier(polynomialRing(R, I))) ∧
    (∀ m ∈ monomials(I), monomialBasisFamily(R, I)(m) = mvMonomial(R, I, m, R.one))
proof
  have oneIn : R.one ∈ R.carrier by typecheck
  have rel : ∀ m ∈ monomials(I), (m, mvMonomial(R, I, m, R.one)) ∈ monomialBasisFamily(R, I) ∧ mvMonomial(R, I, m, R.one) ∈ Ring.carrier(polynomialRing(R, I))
    intros m hm
    have v := mvMonomial.mem at R, I, m, R.one with comm, polys, hm, oneIn
    have r : (m, mvMonomial(R, I, m, R.one)) ∈ monomialBasisFamily(R, I)
      apply monomialBasisFamily.membership.backward
      refine ⟨(product.pair with hm, v), m, hm, rfl⟩
    exact ⟨r, v⟩
  have fn : monomialBasisFamily(R, I) : monomials(I) → Ring.carrier(polynomialRing(R, I))
    apply tkJ.uni_graph_function
    . intros u hu
      exact (monomialBasisFamily.membership.forward with hu).left
    . intros x y z hy hz
      obtain ⟨_, a, aIn, ea⟩ := monomialBasisFamily.membership.forward with hy
      obtain ⟨_, b, bIn, eb⟩ := monomialBasisFamily.membership.forward with hz
      obtain ⟨xa, ya⟩ := orderedPair.injective with ea
      obtain ⟨xb, yb⟩ := orderedPair.injective with eb
      rw [ya, yb, ← xa, ← xb]
    . intros x hx
      obtain ⟨r, v⟩ := rel with x, hx
      exact ⟨mvMonomial(R, I, x, R.one), v, r⟩
  refine ⟨fn, ?_⟩
  intros m hm
  obtain ⟨r, v⟩ := rel with m, hm
  exact FunctionBetween.apply_value with fn, hm, r

theorem tkJ.mv_monomial_smul (m a : Set)
  requires monomial : m ∈ monomials(I)
  requires scalar : a ∈ R.carrier
  shows mvMonomial(R, I, m, a) =
    call2(Module.smul(mvModule(R, I)), a, mvMonomial(R, I, m, R.one))
proof
  have oneIn : R.one ∈ R.carrier by typecheck
  have m1 := mvMonomial.mem at R, I, m, R.one with comm, polys, monomial, oneIn
  have ma := mvMonomial.mem at R, I, m, a with comm, polys, monomial, scalar
  rw ← (mvC.mul_eq_smul at R, I, a, mvMonomial(R, I, m, R.one) with comm, polys, scalar, m1)
  have cIn : call2(Ring.mul(polynomialRing(R, I)), mvC(R, I, a), mvMonomial(R, I, m, R.one)) ∈ Ring.carrier(polynomialRing(R, I))
    unfold mvC
    typecheck
  apply polynomialRing.ext at R, I, mvMonomial(R, I, m, a), call2(Ring.mul(polynomialRing(R, I)), mvC(R, I, a), mvMonomial(R, I, m, R.one)) with comm, polys, ma, cIn
  intros n hn
  have c := mvC.mul_coeff at R, I, a, n, mvMonomial(R, I, m, R.one) with comm, polys, scalar, hn, m1
  unfold mvCoeff at c
  rw c
  obtain ⟨s1, o1⟩ := mvMonomial.coeff at R, I, m, a, n with comm, polys, monomial, scalar, hn
  obtain ⟨s2, o2⟩ := mvMonomial.coeff at R, I, m, R.one, n with comm, polys, monomial, oneIn, hn
  unfold mvCoeff at s1
  unfold mvCoeff at o1
  unfold mvCoeff at s2
  unfold mvCoeff at o2
  by_cases e : n = m
  . rw [(s1 with e), (s2 with e)]
    ring
  . rw [(o1 with e), (o2 with e)]
    ring

theorem tkJ.mv_module_sum (V w : Set)
  requires finite : Finite(V)
  requires family : w : V → Ring.carrier(polynomialRing(R, I))
  shows moduleSum(mvModule(R, I), V, w) = finiteRingSum(V,
    Ring.carrier(polynomialRing(R, I)), Ring.add(polynomialRing(R, I)),
    Ring.zero(polynomialRing(R, I)), Ring.neg(polynomialRing(R, I)),
    Ring.mul(polynomialRing(R, I)), Ring.one(polynomialRing(R, I)), w)
proof
  have pParts := CommRing.parts with polys
  have ringR := CommRing.to_ring with comm
  have mm := mvModule.module at R, I with comm, polys
  obtain ⟨pc, pa, pz⟩ := cldEMvModule.projections at R, I with comm, polys
  have fin2 := finite
  obtain ⟨N, natural, equivalent⟩ := fin2
  obtain ⟨f, bijective⟩ := equivalent
  have enumeration := converse.bijective with bijective
  have wM := family
  rw ← pc at wM
  have eqM := moduleSum.enumeration at R, mvModule(R, I), V, w, converse(f, V, N), N with ringR, mm, wM, enumeration
  have eqP := finiteRingSum.enumeration at V, Ring.carrier(polynomialRing(R, I)), Ring.add(polynomialRing(R, I)), Ring.zero(polynomialRing(R, I)), Ring.neg(polynomialRing(R, I)), Ring.mul(polynomialRing(R, I)), Ring.one(polynomialRing(R, I)), w, converse(f, V, N), N with pParts, family, enumeration
  rw [eqM, eqP, pa, pz]

theorem restrictSupport.span (s : Set)
  requires monomialsIn : s ⊆ monomials(I)
  shows restrictSupport(R, I, s) = moduleSpan(mvModule(R, I), R,
    functionImage(monomialBasisFamily(R, I), s, Ring.carrier(polynomialRing(R, I))))
proof
  have ringR := CommRing.to_ring with comm
  have mm := mvModule.module at R, I with comm, polys
  have pParts := CommRing.parts with polys
  obtain ⟨pc, pa, pz⟩ := cldEMvModule.projections at R, I with comm, polys
  obtain ⟨bF, bV⟩ := tkJ.mv_basis_family at R, I with comm, polys
  have oneIn : R.one ∈ R.carrier by typecheck
  have imgSub : functionImage(monomialBasisFamily(R, I), s, Ring.carrier(polynomialRing(R, I))) ⊆ Module.carrier(mvModule(R, I))
    rw pc
    exact functionImage.subset at monomialBasisFamily(R, I), s, Ring.carrier(polynomialRing(R, I))
  have spanSub := moduleSpan.submodule_of at R, mvModule(R, I), functionImage(monomialBasisFamily(R, I), s, Ring.carrier(polynomialRing(R, I))) with ringR, mm
  have inSpan := moduleSpan.subset_of at R, mvModule(R, I), functionImage(monomialBasisFamily(R, I), s, Ring.carrier(polynomialRing(R, I))) with ringR, mm, imgSub
  have termsIn : ∀ m ∈ s, ∀ a ∈ R.carrier, mvMonomial(R, I, m, a) ∈ moduleSpan(mvModule(R, I), R, functionImage(monomialBasisFamily(R, I), s, Ring.carrier(polynomialRing(R, I))))
    intros m hm a ha
    have mMon := monomialsIn with m, hm
    have v := mvMonomial.mem at R, I, m, R.one with comm, polys, mMon, oneIn
    have img : mvMonomial(R, I, m, R.one) ∈ functionImage(monomialBasisFamily(R, I), s, Ring.carrier(polynomialRing(R, I)))
      apply functionImage.membership.backward
      refine ⟨v, m, hm, ?_⟩
      rw (bV with m, mMon)
    have sp := inSpan with mvMonomial(R, I, m, R.one), img
    rw (tkJ.mv_monomial_smul at R, I, m, a with comm, polys, mMon, ha)
    exact SubmoduleOf.smul_mem at R, mvModule(R, I), moduleSpan(mvModule(R, I), R, functionImage(monomialBasisFamily(R, I), s, Ring.carrier(polynomialRing(R, I)))), a, mvMonomial(R, I, m, R.one) with ringR, mm, spanSub, ha, sp
  apply Subset.antisymmetric
  . intros p hp
    obtain ⟨pIn, ps⟩ := restrictSupport.membership.forward with hp
    have fin := mvSupport.finite at R, I, p with comm, polys, pIn
    obtain ⟨tF, tV⟩ := tkJ.monomial_terms at R, I, p with comm, polys, pIn
    have e := mvPolynomial.as_sum at R, I, p with comm, polys, pIn
    have fin2 := fin
    obtain ⟨N, natural, equivalent⟩ := fin2
    obtain ⟨f, bijective⟩ := equivalent
    have enumeration := converse.bijective with bijective
    have eF := converse.function_of_bijective with bijective
    have eqP := finiteRingSum.enumeration at mvSupport(R, I, p), Ring.carrier(polynomialRing(R, I)), Ring.add(polynomialRing(R, I)), Ring.zero(polynomialRing(R, I)), Ring.neg(polynomialRing(R, I)), Ring.mul(polynomialRing(R, I)), Ring.one(polynomialRing(R, I)), monomialTerms(R, I, p), converse(f, mvSupport(R, I, p), N), N with pParts, tF, enumeration
    rw eqP at e
    rw [← pa, ← pz] at e
    rw e
    apply indexedRingSum.submodule_mem at R, mvModule(R, I), moduleSpan(mvModule(R, I), R, functionImage(monomialBasisFamily(R, I), s, Ring.carrier(polynomialRing(R, I)))), monomialTerms(R, I, p), converse(f, mvSupport(R, I, p), N), N with ringR, mm, spanSub
    intros i hi
    have ei := FunctionBetween.apply_closed with eF, hi
    rw (tV with converse(f, mvSupport(R, I, p), N)(i), ei)
    have ms := ps with converse(f, mvSupport(R, I, p), N)(i), ei
    have mMon := monomialsIn with converse(f, mvSupport(R, I, p), N)(i), ms
    have pm := polynomialRing.coefficient_mem at R, I, p, converse(f, mvSupport(R, I, p), N)(i) with comm, polys, pIn, mMon
    exact termsIn with converse(f, mvSupport(R, I, p), N)(i), ms, p(converse(f, mvSupport(R, I, p), N)(i)), pm
  . have rs := restrictSupport.submodule at R, I, s with comm, polys
    have least := (moduleSpan.least_of at R, mvModule(R, I), functionImage(monomialBasisFamily(R, I), s, Ring.carrier(polynomialRing(R, I))), restrictSupport(R, I, s) with ringR, mm, imgSub, rs).backward
    apply least
    intros u hu
    obtain ⟨uIn, m, hm, eu⟩ := functionImage.membership.forward with hu
    have mMon := monomialsIn with m, hm
    rw (bV with m, mMon) at eu
    rw eu
    apply restrictSupport.membership.backward
    refine ⟨(mvMonomial.mem at R, I, m, R.one with comm, polys, mMon, oneIn), ?_⟩
    intros n hn
    unfold mvSupport at hn
    obtain ⟨nMon, ne⟩ := functionSupport.membership.forward with hn
    obtain ⟨_, other⟩ := mvMonomial.coeff at R, I, m, R.one, n with comm, polys, mMon, oneIn, nMon
    by_contra out
    have nm : n ≠ m
      intro e
      apply out
      rw e
      exact hm
    have z := other with nm
    unfold mvCoeff at z
    exact ne with z

-- The monomials form a basis of the R-module of polynomials
-- (MvPolynomial.basisMonomials).
theorem mvModule.monomial_basis
  shows ModuleBasis(mvModule(R, I), R, monomials(I), monomialBasisFamily(R, I))
proof
  have ringR := CommRing.to_ring with comm
  have mm := mvModule.module at R, I with comm, polys
  obtain ⟨pc, pa, pz⟩ := cldEMvModule.projections at R, I with comm, polys
  obtain ⟨bF, bV⟩ := tkJ.mv_basis_family at R, I with comm, polys
  have bM := bF
  rw ← pc at bM
  have refl : monomials(I) ⊆ monomials(I)
    intros x hx
    exact hx
  have sp := restrictSupport.span at R, I, monomials(I) with comm, polys, refl
  have all : restrictSupport(R, I, monomials(I)) = Ring.carrier(polynomialRing(R, I))
    apply Subset.antisymmetric
    . intros p hp
      exact (restrictSupport.membership.forward with hp).left
    . intros p hp
      apply restrictSupport.membership.backward
      refine ⟨hp, ?_⟩
      intros m hm
      unfold mvSupport at hm
      exact (functionSupport.membership.forward with hm).left
  unfold ModuleBasis
  constructor
  . unfold LinearIndependent
    refine ⟨mm, bM, ?_⟩
    intros J JSub Jfin c cF zero j hj
    have closed : ∀ x ∈ J, monomialBasisFamily(R, I)(x) ∈ Module.carrier(mvModule(R, I))
      intros x hx
      exact FunctionBetween.apply_closed with bM, (JSub with x, hx)
    have rF := restrict.function at monomialBasisFamily(R, I), monomials(I), Module.carrier(mvModule(R, I)), J, Module.carrier(mvModule(R, I)) with bM, JSub, closed
    have tF := combinationTerms.function at mvModule(R, I), R, J, c, restrict(monomialBasisFamily(R, I), J) with mm, cF, rF
    have tvals : ∀ k ∈ J, combinationTerms(mvModule(R, I), R, J, c, restrict(monomialBasisFamily(R, I), J))(k) = mvMonomial(R, I, k, c(k))
      intros k hk
      have kMon := JSub with k, hk
      have ck := FunctionBetween.apply_closed with cF, hk
      rw (combinationTerms.value at mvModule(R, I), R, J, c, restrict(monomialBasisFamily(R, I), J), k with mm, cF, rF, hk)
      rw (restrict.apply at monomialBasisFamily(R, I), monomials(I), Module.carrier(mvModule(R, I)), J, Module.carrier(mvModule(R, I)), k with bM, JSub, closed, hk)
      rw (bV with k, kMon)
      rw ← (tkJ.mv_monomial_smul at R, I, k, c(k) with comm, polys, kMon, ck)
    have tP := tF
    rw pc at tP
    unfold moduleCombination at zero
    rw (tkJ.mv_module_sum at R, I, J, combinationTerms(mvModule(R, I), R, J, c, restrict(monomialBasisFamily(R, I), J)) with comm, polys, Jfin, tP) at zero
    rw pz at zero
    have jMon := JSub with j, hj
    have cj := FunctionBetween.apply_closed with cF, hj
    have co := mvCoeff.sum at R, I, J, combinationTerms(mvModule(R, I), R, J, c, restrict(monomialBasisFamily(R, I), J)), j with comm, polys, Jfin, tP, jMon
    rw zero at co
    unfold mvCoeff at co
    rw (polynomialRing.coefficient_zero at R, I, j with comm, polys, jMon) at co
    obtain ⟨cfF, cfV⟩ := tkJ.mv_coefficient_family at R, I, J, combinationTerms(mvModule(R, I), R, J, c, restrict(monomialBasisFamily(R, I), J)), j with comm, polys, tP, jMon
    have others : ∀ k ∈ J, k ≠ j → coefficientFamily(R, J, combinationTerms(mvModule(R, I), R, J, c, restrict(monomialBasisFamily(R, I), J)), j)(k) = R.zero
      intros k hk ne
      have kMon := JSub with k, hk
      have ck := FunctionBetween.apply_closed with cF, hk
      rw [(cfV with k, hk), (tvals with k, hk)]
      obtain ⟨_, other⟩ := mvMonomial.coeff at R, I, k, c(k), j with comm, polys, kMon, ck, jMon
      have ne2 : j ≠ k
        intro e
        apply ne
        rw e
      have z := other with ne2
      unfold mvCoeff at z
      exact z
    have single := tkJ.mv_sum_single at R, I, coefficientFamily(R, J, combinationTerms(mvModule(R, I), R, J, c, restrict(monomialBasisFamily(R, I), J)), j), J, j with comm, polys, Jfin, cfF, hj, others
    rw single at co
    rw [(cfV with j, hj), (tvals with j, hj)] at co
    obtain ⟨same, _⟩ := mvMonomial.coeff at R, I, j, c(j), j with comm, polys, jMon, cj, jMon
    have jj : j = j by rfl
    have z := same with jj
    unfold mvCoeff at z
    rw z at co
    symm
    exact co
  . unfold SpansModule
    refine ⟨mm, bM, ?_⟩
    rw pc
    rw ← sp
    exact all

end Laws

-- Section: Evaluation in algebras, renaming and substitution
section AlgebraEvaluation
variable (A I : Set)
hypothesis algebra : Algebra(A)

-- MvPolynomial.aeval: an algebra homomorphism R[I] → A with Xᵢ ↦ v(i)
-- (aeval_X, aeval_C), unique (MvPolynomial.algHom_ext, aeval_unique).
theorem mvAeval.algebra_hom (v : Set)
  requires values : v : I → algebraCarrier(A)
  shows AlgebraHom(mvAeval(A, I, v), polynomialAlgebra(Algebra.base(A), I), A)
proof
  have base := Algebra.base_comm_ring at A with algebra
  have over : Algebra.base(A) = Algebra.base(A) by rfl
  unfold mvAeval
  exact evaluationHom.algebra_hom at Algebra.base(A), I, A, v with base, algebra, over, values

theorem mvAeval.X (v i : Set)
  requires values : v : I → algebraCarrier(A)
  requires index : i ∈ I
  shows mvAeval(A, I, v)(X(Algebra.base(A), I, i)) = v(i)
proof
  have base := Algebra.base_comm_ring at A with algebra
  have over : Algebra.base(A) = Algebra.base(A) by rfl
  unfold mvAeval
  exact evaluationHom.algebra_X at Algebra.base(A), I, A, v, i with base, algebra, over, values, index

theorem mvAeval.C (v a : Set)
  requires values : v : I → algebraCarrier(A)
  requires scalar : a ∈ Ring.carrier(Algebra.base(A))
  shows mvAeval(A, I, v)(mvC(Algebra.base(A), I, a)) = Algebra.map(A)(a)
proof
  have base := Algebra.base_comm_ring at A with algebra
  have ringA := Algebra.comm_ring at A with algebra
  have sh := Algebra.structure_hom at A with algebra
  have vs := values
  unfold algebraCarrier at vs
  unfold mvAeval
  unfold mvC
  exact evaluationHom.map_constant at Algebra.base(A), Algebra.ring(A), I, Algebra.map(A), v, a with base, ringA, sh, vs, scalar

theorem mvAeval.unique (v f : Set)
  requires values : v : I → algebraCarrier(A)
  requires hom : AlgebraHom(f, polynomialAlgebra(Algebra.base(A), I), A)
  requires variables : ∀ i ∈ I, f(X(Algebra.base(A), I, i)) = v(i)
  shows f = mvAeval(A, I, v)
proof
  have base := Algebra.base_comm_ring at A with algebra
  have g := mvAeval.algebra_hom at A, I, v with algebra, values
  apply AlgebraHom.polynomial_ext at Algebra.base(A), I, A, f, mvAeval(A, I, v) with base, hom, g
  intros j hj
  rw (mvAeval.X at A, I, v, j with algebra, values, hj)
  exact variables with j, hj

-- MvPolynomial.algHom_ext.
theorem mvAeval.hom_ext (f g : Set)
  requires first : AlgebraHom(f, polynomialAlgebra(Algebra.base(A), I), A)
  requires second : AlgebraHom(g, polynomialAlgebra(Algebra.base(A), I), A)
  requires variables : ∀ i ∈ I, f(X(Algebra.base(A), I, i)) = g(X(Algebra.base(A), I, i))
  shows f = g
proof
  have base := Algebra.base_comm_ring at A with algebra
  exact AlgebraHom.polynomial_ext at Algebra.base(A), I, A, f, g with base, first, second, variables

-- MvPolynomial.comp_aeval and aeval_algHom_apply: algebra homomorphisms
-- commute with aeval.
theorem mvAeval.compose (B φ v p : Set)
  requires hom : φ : A →ₐ B
  requires values : v : I → algebraCarrier(A)
  requires member : p ∈ Ring.carrier(polynomialRing(Algebra.base(A), I))
  shows φ(mvAeval(A, I, v)(p)) =
    mvAeval(B, I, assignmentImage(I, algebraCarrier(B), φ, v))(p)
proof
  have base := Algebra.base_comm_ring at A with algebra
  have algB := AlgebraHom.target at φ, A, B with hom
  have bEq := AlgebraHom.base_eq at φ, A, B with hom
  have φfn := AlgebraHom.function at φ, A, B with hom
  have wv : ∀ i ∈ I, φ(v(i)) ∈ algebraCarrier(B)
    intros i hi
    have vi := FunctionBetween.apply_closed with values, hi
    exact FunctionBetween.apply_closed with φfn, vi
  obtain ⟨wfn, wval⟩ := mv.assignment_image_function at I, algebraCarrier(B), φ, v with wv
  have f := mvAeval.algebra_hom at A, I, v with algebra, values
  have h := mvAeval.algebra_hom at B, I, assignmentImage(I, algebraCarrier(B), φ, v) with algB, wfn
  rw ← bEq at h
  have pmem := member
  rw ← (polynomialAlgebra.carrierOf at Algebra.base(A), I) at pmem
  have ag : ∀ i ∈ I, φ(mvAeval(A, I, v)(X(Algebra.base(A), I, i))) = mvAeval(B, I, assignmentImage(I, algebraCarrier(B), φ, v))(X(Algebra.base(A), I, i))
    intros i hi
    rw (mvAeval.X at A, I, v, i with algebra, values, hi)
    have hx := mvAeval.X at B, I, assignmentImage(I, algebraCarrier(B), φ, v), i with algB, wfn, hi
    rw ← bEq at hx
    rw hx
    rw (wval with i, hi)
  exact polynomial_composite_agree at Algebra.base(A), I, A, B, mvAeval(A, I, v), φ, mvAeval(B, I, assignmentImage(I, algebraCarrier(B), φ, v)), p with base, f, hom, h, ag, pmem

-- MvPolynomial.aeval_rename: evaluating a renamed polynomial is
-- evaluating at the composite assignment; rename is functorial
-- (rename_rename), sends Xᵢ to X_σ(i) (rename_X), and is injective for
-- injective σ (MvPolynomial.rename_injective).
theorem mvAeval.rename (J σ v p : Set)
  requires map : σ : I → J
  requires values : v : J → algebraCarrier(A)
  requires member : p ∈ Ring.carrier(polynomialRing(Algebra.base(A), I))
  shows mvAeval(A, J, v)(polynomialRename(Algebra.base(A), I, J, σ)(p)) =
    mvAeval(A, I, compose(v, σ, I, J, algebraCarrier(A)))(p)
proof
  have base := Algebra.base_comm_ring at A with algebra
  have rn := polynomialRename.hom at Algebra.base(A), I, J, σ with base, map
  have g := mvAeval.algebra_hom at A, J, v with algebra, values
  have cf := compose.function at v, σ, I, J, algebraCarrier(A) with map, values
  have h := mvAeval.algebra_hom at A, I, compose(v, σ, I, J, algebraCarrier(A)) with algebra, cf
  have pmem := member
  rw ← (polynomialAlgebra.carrierOf at Algebra.base(A), I) at pmem
  have ag : ∀ i ∈ I, mvAeval(A, J, v)(polynomialRename(Algebra.base(A), I, J, σ)(X(Algebra.base(A), I, i))) = mvAeval(A, I, compose(v, σ, I, J, algebraCarrier(A)))(X(Algebra.base(A), I, i))
    intros i hi
    rw (polynomialRename.map_X at Algebra.base(A), I, J, σ, i with base, map, hi)
    have si := FunctionBetween.apply_closed with map, hi
    rw (mvAeval.X at A, J, v, σ(i) with algebra, values, si)
    rw (mvAeval.X at A, I, compose(v, σ, I, J, algebraCarrier(A)), i with algebra, cf, hi)
    rw (compose.apply at v, σ, I, J, algebraCarrier(A), i with map, values, hi)
  exact polynomial_composite_agree at Algebra.base(A), I, polynomialAlgebra(Algebra.base(A), J), A, polynomialRename(Algebra.base(A), I, J, σ), mvAeval(A, J, v), mvAeval(A, I, compose(v, σ, I, J, algebraCarrier(A))), p with base, rn, g, h, ag, pmem

-- MvPolynomial.aeval_bind₁: evaluating a substitution evaluates the
-- substituted polynomials first.
theorem mvAeval.bind (J g v p : Set)
  requires substitution : g : I → Ring.carrier(polynomialRing(Algebra.base(A), J))
  requires values : v : J → algebraCarrier(A)
  requires member : p ∈ Ring.carrier(polynomialRing(Algebra.base(A), I))
  shows mvAeval(A, J, v)(mvBind(Algebra.base(A), I, J, g)(p)) =
    mvAeval(A, I, bindValues(A, I, J, g, v))(p)
proof
  have base := Algebra.base_comm_ring at A with algebra
  have paJ := polynomialAlgebra.algebra at Algebra.base(A), J with base
  have over := polynomialAlgebra.base at Algebra.base(A), J
  have gv := substitution
  rw ← (polynomialAlgebra.carrierOf at Algebra.base(A), J) at gv
  have bh := evaluationHom.algebra_hom at Algebra.base(A), I, polynomialAlgebra(Algebra.base(A), J), g with base, paJ, over, gv
  rw [polynomialAlgebra.ring, polynomialAlgebra.map] at bh
  have g2 := mvAeval.algebra_hom at A, J, v with algebra, values
  have bv : ∀ i ∈ I, mvAeval(A, J, v)(g(i)) ∈ algebraCarrier(A)
    intros i hi
    have gi := FunctionBetween.apply_closed with substitution, hi
    have af := AlgebraHom.function at mvAeval(A, J, v), polynomialAlgebra(Algebra.base(A), J), A with g2
    rw (polynomialAlgebra.carrierOf at Algebra.base(A), J) at af
    exact FunctionBetween.apply_closed with af, gi
  obtain ⟨bfn, bval⟩ := mv.bind_values_function at A, I, J, g, v with bv
  have h := mvAeval.algebra_hom at A, I, bindValues(A, I, J, g, v) with algebra, bfn
  have pmem := member
  rw ← (polynomialAlgebra.carrierOf at Algebra.base(A), I) at pmem
  have ag : ∀ i ∈ I, mvAeval(A, J, v)(evaluationHom(Algebra.base(A), polynomialRing(Algebra.base(A), J), I, polynomialConstant(Algebra.base(A), J), g)(X(Algebra.base(A), I, i))) = mvAeval(A, I, bindValues(A, I, J, g, v))(X(Algebra.base(A), I, i))
    intros i hi
    have pcJ := polynomialRing.comm_ring at Algebra.base(A), J with base
    have ch := polynomialConstant.hom at Algebra.base(A), J with base
    rw (evaluationHom.map_X at Algebra.base(A), polynomialRing(Algebra.base(A), J), I, polynomialConstant(Algebra.base(A), J), g, i with base, pcJ, ch, substitution, hi)
    rw (mvAeval.X at A, I, bindValues(A, I, J, g, v), i with algebra, bfn, hi)
    rw (bval with i, hi)
  unfold mvBind
  exact polynomial_composite_agree at Algebra.base(A), I, polynomialAlgebra(Algebra.base(A), J), A, evaluationHom(Algebra.base(A), polynomialRing(Algebra.base(A), J), I, polynomialConstant(Algebra.base(A), J), g), mvAeval(A, J, v), mvAeval(A, I, bindValues(A, I, J, g, v)), p with base, bh, g2, h, ag, pmem

-- In the polynomial algebra itself, aeval at the variables is the
-- identity (MvPolynomial.aeval_X_left).
theorem mvAeval.variables_self (p : Set)
  requires member : p ∈ Ring.carrier(polynomialRing(Algebra.base(A), I))
  shows mvAeval(polynomialAlgebra(Algebra.base(A), I), I,
    mvVariables(Algebra.base(A), I))(p) = p
proof
  have base := Algebra.base_comm_ring at A with algebra
  have pa := polynomialAlgebra.algebra at Algebra.base(A), I with base
  have xs : ∀ i ∈ I, X(Algebra.base(A), I, i) ∈ Ring.carrier(polynomialRing(Algebra.base(A), I))
    intros i hi
    exact X.mem at Algebra.base(A), I, i with base
  obtain ⟨vfn, vval⟩ := mv.variables_function at Algebra.base(A), I with xs
  have vfn2 := vfn
  rw ← (polynomialAlgebra.carrierOf at Algebra.base(A), I) at vfn2
  have idh := AlgebraHom.identity at polynomialAlgebra(Algebra.base(A), I) with pa
  have u := mvAeval.unique at polynomialAlgebra(Algebra.base(A), I), I, mvVariables(Algebra.base(A), I), identity(algebraCarrier(polynomialAlgebra(Algebra.base(A), I))) with pa, vfn2
  rw (polynomialAlgebra.base at Algebra.base(A), I) at u
  rw (polynomialAlgebra.base at Algebra.base(A), I) at u
  have ag : ∀ i ∈ I, identity(algebraCarrier(polynomialAlgebra(Algebra.base(A), I)))(X(Algebra.base(A), I, i)) = mvVariables(Algebra.base(A), I)(i)
    intros i hi
    rw (vval with i, hi)
    have xIn := X.algebra_mem at Algebra.base(A), I, i with base, hi
    exact identity.apply at X(Algebra.base(A), I, i), algebraCarrier(polynomialAlgebra(Algebra.base(A), I)) with xIn
  have eq := u with idh, ag
  rw ← eq
  have pmem := member
  rw ← (polynomialAlgebra.carrierOf at Algebra.base(A), I) at pmem
  exact identity.apply at p, algebraCarrier(polynomialAlgebra(Algebra.base(A), I)) with pmem

end AlgebraEvaluation

-- Helpers: nonvanishing of polynomials over an infinite integral domain,
-- following Cumulus's Algebra/Polynomial/{HornerRoots, HornerNormalization,
-- Nonvanishing} with the field replaced by an integral domain (only the
-- absence of zero divisors is used): a Horner polynomial with a nonzero
-- coefficient has finitely many roots, and a nonzero polynomial has a
-- nonvanishing value.
section TkJDomainRoots
variable (A add z neg mul one leading : Set)
notation ring R := (A, add, z, neg, mul, one)
hypothesis domain : IsIntegralDomain(R)
hypothesis initial : leading ∈ R

theorem tkJ.horner_roots_divide (a c : Set) (cs : List(A))
  requires center : a ∈ R
  requires coefficient : c ∈ R
  requires root : hornerAt{A}(add, mul, leading, a, c :: cs) = R[0]
  shows hornerRoots{A}(add, z, mul, leading, c :: cs) ⊆ insert(a, hornerRoots{A}(add, z, mul, leading, hornerQuotient{A}(add, mul, leading, a, cs)))
proof
  have dom0 := domain
  obtain ⟨ring, _, _⟩ := dom0
  have ordinary := IsCommRing.ring with ring
  have quotient := hornerQuotient.closed at A, add, z, neg, mul, one, leading, a, cs with *
  have dom1 := domain
  obtain ⟨_, _, noZero⟩ := dom1
  intros x hx
  obtain ⟨element, vanishes⟩ := hornerRoots.membership.forward at
    A, add, z, mul, leading, c :: cs, x with *
  have division := hornerAt.synthetic_division at A, add, z, neg, mul, one, leading, a, x, c, cs with *
  have value := hornerAt.closed at A, add, z, neg, mul, one, leading, x, hornerQuotient{A}(add, mul, leading, a, cs) with *
  have negative := IsRing.neg_closed with ordinary, center
  have difference := IsRing.add_closed with ordinary, element, negative
  rw [root, vanishes] at division
  have productZero : R[(x - a) * hornerAt{A}(add, mul, leading, x, hornerQuotient{A}(add, mul, leading, a, cs))] = R[0]
    linear_combination -division
  have alternatives := noZero with R[x - a], difference, hornerAt{A}(add, mul, leading, x, hornerQuotient{A}(add, mul, leading, a, cs)), productZero
  cases alternatives with same | remaining
  . have equal : x = a
      linear_combination same
    rw equal
    exact insert.self
  . have member : x ∈ hornerRoots{A}(add, z, mul, leading, hornerQuotient{A}(add, mul, leading, a, cs))
      apply hornerRoots.membership.backward
      refine ⟨element, remaining⟩
    exact insert.contains with member

hypothesis nonzero : leading ≠ R[0]

theorem tkJ.horner_roots_finite_of_length (n : Nat) (cs : List(A))
  requires size : length{A}(cs) = n
  shows Finite(hornerRoots{A}(add, z, mul, leading, cs))
proof
  induction n generalizing cs
  | zero =>
    intros cs list size
    have cases := List.cases with list
    cases cases with empty | cons
    . rw [empty, hornerRoots.nil]
      exact Finite.empty
    . obtain ⟨c, coefficient, tail, tailList, shape⟩ := cons
      rw [shape, length.cons] at size
      have impossible := Naturals.disjoint.zero.succ at length{A}(tail)
      exfalso
      apply impossible
      symm
      exact size
  | succ(k) using ih =>
    intros cs list size
    have cases := List.cases with list
    cases cases with empty | cons
    . rw [empty, hornerRoots.nil]
      exact Finite.empty
    . obtain ⟨c, coefficient, tail, tailList, shape⟩ := cons
      have tailSize : length{A}(tail) = k
        rw [shape, length.cons] at size
        exact Naturals.injective.succ with size
      have alternatives : (∃ a, a ∈ hornerRoots{A}(add, z, mul, leading, cs)) ∨ ¬(∃ a, a ∈ hornerRoots{A}(add, z, mul, leading, cs))
        tauto
      cases alternatives with inhabited | emptyRoots
      . obtain ⟨a, ha⟩ := inhabited
        rw shape at ha
        obtain ⟨center, root⟩ := hornerRoots.membership.forward at
          A, add, z, mul, leading, c :: tail, a with *
        have dom0 := domain
        obtain ⟨ring, _, _⟩ := dom0
        have quotient := hornerQuotient.closed at A, add, z, neg, mul, one, leading, a, tail with *
        have quotientLength := hornerQuotient.length at A, add, z, neg, mul, one, leading, a, tail with *
        have quotientSize : length{A}(hornerQuotient{A}(add, mul, leading, a, tail)) = k by cc
        have finite := ih with hornerQuotient{A}(add, mul, leading, a, tail), quotientSize
        have inserted := Finite.insert at hornerRoots{A}(add, z, mul, leading, hornerQuotient{A}(add, mul, leading, a, tail)), a with finite
        have subset := tkJ.horner_roots_divide at A, add, z, neg, mul, one, leading, a, c, tail with *
        rw shape
        exact Finite.subset with inserted, subset
      . have empty : hornerRoots{A}(add, z, mul, leading, cs) = ∅
          ext x
          constructor
          . intro member
            exfalso
            apply emptyRoots
            refine ⟨x, member⟩
          . intro impossible
            exfalso
            exact set.empty with impossible
        rw empty
        exact Finite.empty

theorem tkJ.horner_roots_finite (cs : List(A))
  shows Finite(hornerRoots{A}(add, z, mul, leading, cs))
proof
  have size : length{A}(cs) = length{A}(cs) by rfl
  exact tkJ.horner_roots_finite_of_length with *

theorem tkJ.horner_exists_nonzero (cs : List(A))
  requires infinite : ¬Finite(R)
  shows ∃ x ∈ R, hornerAt{A}(add, mul, leading, x, cs) ≠ R[0]
proof
  have finite := tkJ.horner_roots_finite with *
  by_contra absent
  have equal : hornerRoots{A}(add, z, mul, leading, cs) = R
    ext x
    constructor
    . intro member
      have data := hornerRoots.membership.forward with member
      exact data.left
    . intro member
      apply hornerRoots.membership.backward
      refine ⟨member, ?_⟩
      by_contra value
      apply absent
      refine ⟨x, member, value⟩
  rw equal at finite
  exact infinite with finite

end TkJDomainRoots

section TkJDomainCoefficients
variable (A add z neg mul one : Set)
notation ring R := (A, add, z, neg, mul, one)
hypothesis domain : IsIntegralDomain(R)

theorem tkJ.horner_exists_nonzero_of_coefficient (cs : List(A))
  requires infinite : ¬Finite(R)
  requires nonzero : ∃ n, Nat(n) ∧ listCoefficient{A}(z, cs, n) ≠ z
  shows ∃ x ∈ R, hornerAt{A}(add, mul, z, x, cs) ≠ z
proof
  have dom0 := domain
  obtain ⟨ring, _, _⟩ := dom0
  obtain ⟨leading, initial, different, lower, list, equal⟩ := hornerAt.normalize at A, add, z, neg, mul, one, cs with *
  obtain ⟨x, element, value⟩ := tkJ.horner_exists_nonzero at A, add, z, neg, mul, one, leading, lower with *
  have same := equal with x, element
  refine ⟨x, element, ?_⟩
  rwa same

end TkJDomainCoefficients

section TkJDomainNonvanishing
variable (I A add z neg mul one : Set)
notation ring R := (A, add, z, neg, mul, one)
notation ring P := R[I]
hypothesis domain : IsIntegralDomain(R)
hypothesis infinite : ¬Finite(R)

theorem tkJ.nonvanishing_from_coefficient (p j v : Set, n : Nat)
  requires polynomial : p ∈ P
  requires index : j ∈ I
  requires assignment : v : I → R
  requires nonzero : polynomialAt(I, R, v)(polynomialVariableCoefficient(I, R, p, j, n)) ≠ z
  shows ∃ w, FunctionBetween(w, I, R) ∧ polynomialAt(I, R, w)(p) ≠ z
proof
  have dom0 := domain
  obtain ⟨ring, _, _⟩ := dom0
  have zeroIn : z ∈ R by typecheck
  have polynomialRing := polynomials.comm_ring at I, A, add, z, neg, mul, one with *
  have zeroMember : P[0] ∈ P by typecheck
  obtain ⟨cs, list, coefficients⟩ := polynomialCoefficientFamily.list_representation at I, A, z, p, j with *
  have hom := polynomialAt.hom with *
  have function := IsRingHom.function with hom
  have zeroValue := IsRingHom.zero with hom
  have lookup := listCoefficient.map at P, A, polynomialAt(I, R, v), P[0], cs, n with *
  have value := coefficients with n
  have scalarNonzero : ∃ k, Nat(k) ∧ listCoefficient{A}(z, listMap{P}(polynomialAt(I, R, v), cs), k) ≠ z
    refine ⟨n, assumption, ?_⟩
    rw [zeroValue, value] at lookup
    rwa lookup
  obtain ⟨a, element, avoids⟩ := tkJ.horner_exists_nonzero_of_coefficient at A, add, z, neg, mul, one, listMap{P}(polynomialAt(I, R, v), cs) with *
  have updated := coefficientErase.function at I, A, a, v, j with *
  have coordinate := coefficientErase.same at I, A, a, v, j with *
  have away : ∀ i ∈ I, i ≠ j → v(i) = coefficientErase(I, A, a, v, j)(i)
    intros i hi different
    symm
    exact coefficientErase.other with *
  have same : ∀ k, Nat(k) → polynomialAt(I, R, v)(listCoefficient{P}(P[0], cs, k)) = polynomialAt(I, R, coefficientErase(I, A, a, v, j))(listCoefficient{P}(P[0], cs, k))
    intros k natural
    have coefficient := coefficients with k, natural
    rw coefficient
    exact polynomialVariableCoefficient.agree_away with *
  have maps := listMap.congr_coefficients with *
  have evaluation := polynomialAt.reconstruction at I, A, add, z, neg, mul, one, p, j, coefficientErase(I, A, a, v, j), cs with *
  refine ⟨coefficientErase(I, A, a, v, j), updated, ?_⟩
  rwa [evaluation, coordinate, ← maps]

theorem tkJ.nonvanishing_on_list (p : Set) (xs : List(I))
  requires polynomial : p ∈ P
  requires nonzero : p ≠ P[0]
  requires variables : polynomialVariablesUsed(I, A, z, p) ⊆ listSupport{I}(xs)
  shows ∃ v, FunctionBetween(v, I, R) ∧ polynomialAt(I, R, v)(p) ≠ z
proof
  induction xs generalizing p
  | List.nil =>
    intros p polynomial nonzero variables
    have dom0 := domain
    obtain ⟨ring, _, _⟩ := dom0
    have zeroIn : z ∈ R by typecheck
    rw listSupport at variables
    have constant := polynomialVariablesUsed.empty_constant with *
    have unit := monomialOne.member at I
    have coefficient := polynomials.coefficient with *
    have different : p(monomialOne(I)) ≠ z
      intro equal
      have zero := polynomialConstant.zero at I, A, z with *
      apply nonzero
      rwa [constant, equal]
    have assignment := constantFunction.function at I, A, z with *
    have evaluation := polynomialAt.constant with coefficient
    refine ⟨constantFunction(I, A, z), assignment, ?_⟩
    rwa [constant, evaluation]
  | List.cons(j, tail) using ih =>
    intros p polynomial nonzero variables
    have index : j ∈ I by assumption
    have dom0 := domain
    obtain ⟨ring, _, _⟩ := dom0
    have zeroIn : z ∈ R by typecheck
    obtain ⟨n, nIn, coefficientNonzero⟩ := polynomialVariableCoefficient.exists_nonzero at I, A, z, p, j with *
    have natural := nat.omega.backward with nIn
    have coefficient := polynomialVariableCoefficient.member at I, A, z, p, j, n with *
    have smaller := polynomialVariableCoefficient.variables at I, A, z, p, j, n with *
    have bounded : polynomialVariablesUsed(I, A, z, polynomialVariableCoefficient(I, R, p, j, n)) ⊆ listSupport{I}(tail)
      intros i hi
      have reduced := smaller with i, hi
      obtain ⟨used, absent⟩ := difference.membership.forward with reduced
      have member := variables with i, used
      rw listSupport at member
      have alternatives := insert.membership.forward with member
      cases alternatives with same | old
      . exfalso
        apply absent
        exact singleton.membership.backward with same
      . exact old
    obtain ⟨v, assignment, value⟩ := ih with polynomialVariableCoefficient(I, R, p, j, n), coefficient, coefficientNonzero, bounded
    exact tkJ.nonvanishing_from_coefficient with *

theorem tkJ.poly_exists_nonzero (p : Set)
  requires polynomial : p ∈ P
  requires nonzero : p ≠ P[0]
  shows ∃ v, FunctionBetween(v, I, R) ∧ polynomialAt(I, R, v)(p) ≠ z
proof
  have finite := polynomialVariablesUsed.finite with *
  have subset := polynomialVariablesUsed.subset at I, A, z, p
  obtain ⟨xs, list, covers⟩ := Finite.cover_in at polynomialVariablesUsed(I, A, z, p), I with *
  exact tkJ.nonvanishing_on_list with *

theorem tkJ.poly_at_ext (p q : Set)
  requires left : p ∈ P
  requires right : q ∈ P
  requires agreement : ∀ v, FunctionBetween(v, I, R) → polynomialAt(I, R, v)(p) = polynomialAt(I, R, v)(q)
  shows p = q
proof
  have dom0 := domain
  obtain ⟨ring, _, _⟩ := dom0
  have source := polynomials.comm_ring at I, A, add, z, neg, mul, one with *
  have ordinary := IsCommRing.ring with source
  have negative := IsRing.neg_closed with ordinary, right
  have difference : P[p - q] ∈ P
    exact IsRing.add_closed with *
  by_contra different
  have nonzero : P[p - q] ≠ P[0]
    intro vanishes
    apply different
    linear_combination vanishes
  obtain ⟨v, assignment, value⟩ := tkJ.poly_exists_nonzero at I, A, add, z, neg, mul, one, P[p - q] with *
  have hom := polynomialAt.hom with *
  have mapped := IsRingHom.sub with source, hom, left, right
  have same := agreement with v, assignment
  have inQ := IsRingHom.closed with hom, right
  apply value
  rw [mapped, same]
  ring

end TkJDomainNonvanishing


section RenameBind
variable (R : Set)
hypothesis comm : CommRing(R)

theorem polynomialRename.compose (I J K σ τ p : Set)
  requires first : σ : I → J
  requires second : τ : J → K
  requires member : p ∈ Ring.carrier(polynomialRing(R, I))
  shows polynomialRename(R, J, K, τ)(polynomialRename(R, I, J, σ)(p)) =
    polynomialRename(R, I, K, compose(τ, σ, I, J, K))(p)
proof
  have pa := polynomialRename.hom at R, I, J, σ with comm, first
  have pb := polynomialRename.hom at R, J, K, τ with comm, second
  have cf := compose.function at τ, σ, I, J, K with first, second
  have pc := polynomialRename.hom at R, I, K, compose(τ, σ, I, J, K) with comm, cf
  have pmem := member
  rw ← (polynomialAlgebra.carrierOf at R, I) at pmem
  have ag : ∀ i ∈ I, polynomialRename(R, J, K, τ)(polynomialRename(R, I, J, σ)(X(R, I, i))) = polynomialRename(R, I, K, compose(τ, σ, I, J, K))(X(R, I, i))
    intros i hi
    rw (polynomialRename.map_X at R, I, J, σ, i with comm, first, hi)
    have si := FunctionBetween.apply_closed with first, hi
    rw (polynomialRename.map_X at R, J, K, τ, σ(i) with comm, second, si)
    rw (polynomialRename.map_X at R, I, K, compose(τ, σ, I, J, K), i with comm, cf, hi)
    rw (compose.apply at τ, σ, I, J, K, i with first, second, hi)
  exact polynomial_composite_agree at R, I, polynomialAlgebra(R, J), polynomialAlgebra(R, K), polynomialRename(R, I, J, σ), polynomialRename(R, J, K, τ), polynomialRename(R, I, K, compose(τ, σ, I, J, K)), p with comm, pa, pb, pc, ag, pmem

-- Helper: for injective σ : I → J, the assignment J → R[I] sending σ(i)
-- to X_i and the rest of J to 0; evaluation along it undoes renaming.
def cldERenameBack (I J σ : Set) : Set :=
  { p ∈ J × Ring.carrier(polynomialRing(R, I)) |
    (∃ i ∈ I, p = (σ(i), X(R, I, i))) ∨
    (∃ j ∈ J, j ∉ functionImage(σ, I, J) ∧
      p = (j, Ring.zero(polynomialRing(R, I)))) }

theorem cldERenameBack.function (I J σ : Set)
  requires map : σ : I → J
  requires injective : InjectiveBetween(σ, I, J)
  shows (cldERenameBack(R, I, J, σ) : J → Ring.carrier(polynomialRing(R, I))) ∧
    (∀ i ∈ I, cldERenameBack(R, I, J, σ)(σ(i)) = X(R, I, i))
proof
  have pr := polynomialRing.comm_ring at R, I with comm
  have zeroIn : Ring.zero(polynomialRing(R, I)) ∈ Ring.carrier(polynomialRing(R, I)) by typecheck
  have relX : ∀ i ∈ I, relates(cldERenameBack(R, I, J, σ), σ(i), X(R, I, i))
    intros i hi
    have si := FunctionBetween.apply_closed with map, hi
    have xi : X(R, I, i) ∈ Ring.carrier(polynomialRing(R, I)) by typecheck
    have pq := product.pair with si, xi
    have o : (∃ k ∈ I, (σ(i), X(R, I, i)) = (σ(k), X(R, I, k))) ∨ (∃ j ∈ J, j ∉ functionImage(σ, I, J) ∧ (σ(i), X(R, I, i)) = (j, Ring.zero(polynomialRing(R, I))))
      left
      exact ⟨i, hi, rfl⟩
    unfold relates
    exact cldERenameBack.membership.backward with ⟨pq, o⟩
  have fn : cldERenameBack(R, I, J, σ) : J → Ring.carrier(polynomialRing(R, I))
    unfold FunctionBetween
    refine ⟨?_, ?_, ?_⟩
    . unfold RelationBetween
      intros q hq
      exact (cldERenameBack.membership.forward with hq).left
    . unfold Functional
      intros x y hxy z hxz
      unfold relates at hxy
      unfold relates at hxz
      obtain ⟨_, c1⟩ := cldERenameBack.membership.forward with hxy
      obtain ⟨_, c2⟩ := cldERenameBack.membership.forward with hxz
      rcases c1 with ⟨i1, hi1, e1⟩ | ⟨j1, hj1, out1, e1⟩
      . obtain ⟨x1, y1⟩ := orderedPair.injective with e1
        rcases c2 with ⟨i2, hi2, e2⟩ | ⟨j2, hj2, out2, e2⟩
        . obtain ⟨x2, z2⟩ := orderedPair.injective with e2
          have s : σ(i1) = σ(i2)
            rw [← x1, ← x2]
          have ii := Injective.apply_cancel with injective, hi1, hi2, s
          rw [y1, z2, ii]
        . obtain ⟨x2, z2⟩ := orderedPair.injective with e2
          exfalso
          have s : j2 = σ(i1)
            rw [← x1, ← x2]
          have im := functionImage.membership.backward at σ, I, J, j2 with ⟨hj2, i1, hi1, s⟩
          exact out2 with im
      . obtain ⟨x1, y1⟩ := orderedPair.injective with e1
        rcases c2 with ⟨i2, hi2, e2⟩ | ⟨j2, hj2, out2, e2⟩
        . obtain ⟨x2, z2⟩ := orderedPair.injective with e2
          exfalso
          have s : j1 = σ(i2)
            rw [← x1, ← x2]
          have im := functionImage.membership.backward at σ, I, J, j1 with ⟨hj1, i2, hi2, s⟩
          exact out1 with im
        . obtain ⟨x2, z2⟩ := orderedPair.injective with e2
          rw [y1, z2]
    . intros j hj
      by_cases im : j ∈ functionImage(σ, I, J)
      . obtain ⟨_, i, hi, ji⟩ := functionImage.membership.forward with im
        have r := relX with i, hi
        rw ← ji at r
        have xi : X(R, I, i) ∈ Ring.carrier(polynomialRing(R, I)) by typecheck
        exact ⟨X(R, I, i), xi, r⟩
      . have pq := product.pair with hj, zeroIn
        have o : (∃ k ∈ I, (j, Ring.zero(polynomialRing(R, I))) = (σ(k), X(R, I, k))) ∨ (∃ j2 ∈ J, j2 ∉ functionImage(σ, I, J) ∧ (j, Ring.zero(polynomialRing(R, I))) = (j2, Ring.zero(polynomialRing(R, I))))
          right
          exact ⟨j, hj, im, rfl⟩
        have m := cldERenameBack.membership.backward with ⟨pq, o⟩
        have r : relates(cldERenameBack(R, I, J, σ), j, Ring.zero(polynomialRing(R, I)))
          unfold relates
          exact m
        exact ⟨Ring.zero(polynomialRing(R, I)), zeroIn, r⟩
  refine ⟨fn, ?_⟩
  intros i hi
  have si := FunctionBetween.apply_closed with map, hi
  exact FunctionBetween.apply_value with fn, si, (relX with i, hi)

theorem polynomialRename.injective (I J σ : Set)
  requires map : σ : I → J
  requires injective : InjectiveBetween(σ, I, J)
  shows InjectiveBetween(polynomialRename(R, I, J, σ),
    Ring.carrier(polynomialRing(R, I)), Ring.carrier(polynomialRing(R, J)))
proof
  obtain ⟨wF, wV⟩ := cldERenameBack.function at R, I, J, σ with comm, map, injective
  have algI := polynomialAlgebra.algebra at R, I with comm
  have over := polynomialAlgebra.base at R, I
  have values : cldERenameBack(R, I, J, σ) : J → algebraCarrier(polynomialAlgebra(R, I))
    rw polynomialAlgebra.carrierOf
    exact wF
  have back := evaluationHom.algebra_hom at R, J, polynomialAlgebra(R, I), cldERenameBack(R, I, J, σ) with comm, algI, over, values
  rw [polynomialAlgebra.ring, polynomialAlgebra.map] at back
  have forward := polynomialRename.hom at R, I, J, σ with comm, map
  have pI := polynomialRing.comm_ring at R, I with comm
  have pJ := polynomialRing.comm_ring at R, J with comm
  have cst := polynomialConstant.hom at R, I with comm
  have vars : ∀ i ∈ I, evaluationHom(R, polynomialRing(R, I), J, polynomialConstant(R, I), cldERenameBack(R, I, J, σ))(polynomialRename(R, I, J, σ)(X(R, I, i))) = X(R, I, i)
    intros i hi
    rw (polynomialRename.map_X at R, I, J, σ, i with comm, map, hi)
    have si := FunctionBetween.apply_closed with map, hi
    rw (evaluationHom.map_X at R, polynomialRing(R, I), J, polynomialConstant(R, I), cldERenameBack(R, I, J, σ), σ(i) with comm, pI, cst, wF, si)
    exact wV with i, hi
  have trip := AlgebraHom.polynomial_round_trip at R, I, polynomialAlgebra(R, J), polynomialRename(R, I, J, σ), evaluationHom(R, polynomialRing(R, I), J, polynomialConstant(R, I), cldERenameBack(R, I, J, σ)) with comm, forward, back, vars
  have rf := AlgebraHom.function with forward
  rw [polynomialAlgebra.carrierOf, polynomialAlgebra.carrierOf] at rf
  refine ⟨rf, ?_⟩
  intros x hx y hy z hz rx ry
  have vx := FunctionBetween.apply_value with rf, hx, rx
  have vy := FunctionBetween.apply_value with rf, hy, ry
  have hx2 := hx
  rw ← (polynomialAlgebra.carrierOf at R, I) at hx2
  have hy2 := hy
  rw ← (polynomialAlgebra.carrierOf at R, I) at hy2
  have tx := trip with x, hx2
  have ty := trip with y, hy2
  rw vx at tx
  rw vy at ty
  rw tx at ty
  exact ty

-- MvPolynomial.eval_rename.
theorem polynomialRename.eval (I J σ v p : Set)
  requires map : σ : I → J
  requires values : v : J → R.carrier
  requires member : p ∈ Ring.carrier(polynomialRing(R, I))
  shows evaluationAt(R, J, v)(polynomialRename(R, I, J, σ)(p)) =
    evaluationAt(R, I, compose(v, σ, I, J, R.carrier))(p)
proof
  have pcI := polynomialRing.comm_ring at R, I with comm
  have pcJ := polynomialRing.comm_ring at R, J with comm
  have rn := polynomialRename.hom at R, I, J, σ with comm, map
  have rh := AlgebraHom.ring_hom at polynomialRename(R, I, J, σ), polynomialAlgebra(R, I), polynomialAlgebra(R, J) with rn
  rw [polynomialAlgebra.ring, polynomialAlgebra.ring] at rh
  have eh := evaluationAt.hom at R, J, v with comm, values
  have c := RingHom.comp at polynomialRename(R, I, J, σ), evaluationAt(R, J, v), polynomialRing(R, I), polynomialRing(R, J), R with pcI, rh, eh
  have cf := compose.function at v, σ, I, J, R.carrier with map, values
  have eh2 := evaluationAt.hom at R, I, compose(v, σ, I, J, R.carrier) with comm, cf
  have r0 := rh
  obtain ⟨_, _, rfn, _⟩ := r0
  have e0 := eh
  obtain ⟨_, _, efn, _⟩ := e0
  have eq : compose(evaluationAt(R, J, v), polynomialRename(R, I, J, σ), Ring.carrier(polynomialRing(R, I)), Ring.carrier(polynomialRing(R, J)), R.carrier) = evaluationAt(R, I, compose(v, σ, I, J, R.carrier))
    apply polynomialRing.hom_ext at R, I, R, compose(evaluationAt(R, J, v), polynomialRename(R, I, J, σ), Ring.carrier(polynomialRing(R, I)), Ring.carrier(polynomialRing(R, J)), R.carrier), evaluationAt(R, I, compose(v, σ, I, J, R.carrier)) with comm, c, eh2
    . intros a ha
      have cIn := polynomialConstant.mem at R, I, a with comm, ha
      rw (compose.apply at evaluationAt(R, J, v), polynomialRename(R, I, J, σ), Ring.carrier(polynomialRing(R, I)), Ring.carrier(polynomialRing(R, J)), R.carrier, polynomialConstant(R, I)(a) with rfn, efn, cIn)
      have ha2 : a ∈ Ring.carrier(Algebra.base(polynomialAlgebra(R, I)))
        rw polynomialAlgebra.base
        exact ha
      have mb := AlgebraHom.map_base at polynomialRename(R, I, J, σ), polynomialAlgebra(R, I), polynomialAlgebra(R, J), a with rn, ha2
      rw [polynomialAlgebra.map, polynomialAlgebra.map] at mb
      rw mb
      rw (evaluationAt.map_constant at R, J, v, a with comm, values, ha)
      rw (evaluationAt.map_constant at R, I, compose(v, σ, I, J, R.carrier), a with comm, cf, ha)
    . intros j hj
      have xIn := X.mem at R, I, j with comm
      rw (compose.apply at evaluationAt(R, J, v), polynomialRename(R, I, J, σ), Ring.carrier(polynomialRing(R, I)), Ring.carrier(polynomialRing(R, J)), R.carrier, X(R, I, j) with rfn, efn, xIn)
      rw (polynomialRename.map_X at R, I, J, σ, j with comm, map, hj)
      have sj := FunctionBetween.apply_closed with map, hj
      rw (evaluationAt.map_X at R, J, v, σ(j) with comm, values, sj)
      rw (evaluationAt.map_X at R, I, compose(v, σ, I, J, R.carrier), j with comm, cf, hj)
      rw (compose.apply at v, σ, I, J, R.carrier, j with map, values, hj)
  rw ← eq
  rw (compose.apply at evaluationAt(R, J, v), polynomialRename(R, I, J, σ), Ring.carrier(polynomialRing(R, I)), Ring.carrier(polynomialRing(R, J)), R.carrier, p with rfn, efn, member)

-- Helpers: a homomorphism R[I] → R[J] fixing the constants and sending
-- each variable to a polynomial of degree at most 1 does not raise the
-- total degree (on monomials by induction on their degree, then on the
-- span of the monomials of bounded degree).
def tkJDegreeAtMost (I n : Set) : Set :=
  { m ∈ monomials(I) | monomialDegree(I, m) ∈ succ(n) }

def tkJDegreePreimage (I J h n : Set) : Set :=
  { q ∈ Ring.carrier(polynomialRing(R, I)) |
    h(q) ∈ restrictSupport(R, J, tkJDegreeAtMost(R, J, n)) }

theorem tkJ.degree_hom_monomial (I J h : Set) (k : Nat)
  requires hom : h : polynomialRing(R, I) →+* polynomialRing(R, J)
  requires constants : ∀ a ∈ R.carrier, h(mvC(R, I, a)) = mvC(R, J, a)
  requires variables : ∀ i ∈ I, mvTotalDegree(R, J, h(X(R, I, i))) ≤ 1
  shows ∀ m ∈ monomials(I), monomialDegree(I, m) = k → ∀ a ∈ R.carrier,
    mvTotalDegree(R, J, h(mvMonomial(R, I, m, a))) ≤ k
proof
  have pcI := polynomialRing.comm_ring at R, I with comm
  have pcJ := polynomialRing.comm_ring at R, J with comm
  have oneIn : R.one ∈ R.carrier by typecheck
  have one := monomialOne.member at I
  induction k
  | zero =>
    intros m hm d a ha
    have m1 := tkJ.degree_zero at I, m with hm, d
    rw [m1, (mvMonomial.zero at R, I, a with comm, pcI, ha), (constants with a, ha), (mvTotalDegree.C at R, J, a with comm, pcJ, ha)]
    arith
  | succ(j) using ih =>
    intros m hm d a ha
    have ne : m ≠ monomialOne(I)
      intro e
      rw e at d
      rw (rmEMv.one_degree at R, I with comm, pcI) at d
      arith
    have exists : ∃ i ∈ I, m(i) ≠ 0
      by_contra none
      apply ne
      apply monomials.ext at I, m, monomialOne(I) with hm, one
      intros i hi
      rw (monomialOne.value at I, i with hi)
      by_contra nz
      exact none with ⟨i, hi, nz⟩
    obtain ⟨i, iI, nz⟩ := exists
    obtain ⟨n, nIn, mEq⟩ := monomials.unshift at I, i, m with iI, hm, nz
    have vi := monomialVariable.member at I, i
    rw (shiftMonomial.product at I, i, n with iI, nIn) at mEq
    have deg := tkJ.degree_mul at I, monomialVariable(I, i), n with vi, nIn
    rw [← mEq, (rmEMv.variable_degree at R, I, i with comm, pcI, iI), d] at deg
    have nn := mv.monomial_degree_nat at I, n with nIn
    have dn : monomialDegree(I, n) = j by arith
    have le1 := ih with n, nIn, dn, a, ha
    have inC := mvMonomial.mem at R, I, n, a with comm, pcI, nIn, ha
    have xIn := X.mem at R, I, i with comm
    have eqm : call2(Ring.mul(polynomialRing(R, I)), mvMonomial(R, I, n, a), X(R, I, i)) = mvMonomial(R, I, m, a)
      rw [(X.eq_monomial at R, I, i with comm, pcI, iI), (mvMonomial.mul at R, I, n, monomialVariable(I, i), a, R.one with comm, pcI, nIn, vi, ha, oneIn)]
      have mv := monomialMul.apply at I, n, monomialVariable(I, i) with nIn, vi
      unfold call2 at mv
      have r1 : call2(R.mul, a, R.one) = a by ring
      rw [mv, r1, (monomialProduct.commutative at I, n, monomialVariable(I, i) with nIn, vi), ← mEq]
    rw ← eqm
    rw (RingHom.map_mul at h, polynomialRing(R, I), polynomialRing(R, J), mvMonomial(R, I, n, a), X(R, I, i) with hom, inC, xIn)
    have hn := RingHom.map_mem at h, polynomialRing(R, I), polynomialRing(R, J), mvMonomial(R, I, n, a) with hom, inC
    have hx := RingHom.map_mem at h, polynomialRing(R, I), polynomialRing(R, J), X(R, I, i) with hom, xIn
    have ml := mvTotalDegree.mul_le at R, J, h(mvMonomial(R, I, n, a)), h(X(R, I, i)) with comm, pcJ, hn, hx
    have vx := variables with i, iI
    have d1 := (mvTotalDegree.selected at R, J, h(mvMonomial(R, I, n, a)) with comm, hn).left
    have d2 := (mvTotalDegree.selected at R, J, h(X(R, I, i)) with comm, hx).left
    have n1 := nat.omega.backward with d1
    have n2 := nat.omega.backward with d2
    have prodIn : call2(Ring.mul(polynomialRing(R, J)), h(mvMonomial(R, I, n, a)), h(X(R, I, i))) ∈ Ring.carrier(polynomialRing(R, J)) by typecheck
    have d3 := (mvTotalDegree.selected at R, J, call2(Ring.mul(polynomialRing(R, J)), h(mvMonomial(R, I, n, a)), h(X(R, I, i))) with comm, prodIn).left
    have n3 := nat.omega.backward with d3
    arith

theorem tkJ.degree_at_most (J x : Set) (d : Nat)
  requires member : x ∈ Ring.carrier(polynomialRing(R, J))
  shows x ∈ restrictSupport(R, J, tkJDegreeAtMost(R, J, d)) ↔
    mvTotalDegree(R, J, x) ≤ d
proof
  have pcJ := polynomialRing.comm_ring at R, J with comm
  have xN := (mvTotalDegree.selected at R, J, x with comm, member).left
  have xNat := nat.omega.backward with xN
  constructor
  . intro hx
    obtain ⟨_, sub⟩ := restrictSupport.membership.forward with hx
    obtain ⟨_, spec⟩ := mvTotalDegree.selected at R, J, x with comm, member
    cases spec with emp | b
    . rw emp.right
      arith
    . obtain ⟨⟨m, mS, md⟩, _⟩ := b
      obtain ⟨mMon, mlt⟩ := tkJDegreeAtMost.membership.forward with (sub with m, mS)
      have mNat := mv.monomial_degree_nat at J, m with mMon
      have lt := Less.of_membership at monomialDegree(J, m), succ(d)
      have l := lt with mlt
      rw ← md
      exact Less.successor_upper with l
  . intro le
    apply restrictSupport.membership.backward
    refine ⟨member, ?_⟩
    intros m mS
    have mS2 := mS
    unfold mvSupport at mS2
    obtain ⟨mMon, _⟩ := functionSupport.membership.forward with mS2
    have mNat := mv.monomial_degree_nat at J, m with mMon
    have lm := mvTotalDegree.le at R, J, m, x with comm, pcJ, member, mS
    have le2 : monomialDegree(J, m) ≤ d by arith
    have lt : monomialDegree(J, m) < succ(d) by arith
    have sNat : Nat(succ(d)) by typecheck
    have mem := (membership.of_Less at monomialDegree(J, m), succ(d) with mNat, sNat) with lt
    exact tkJDegreeAtMost.membership.backward with ⟨mMon, mem⟩

theorem tkJ.degree_hom (I J h p : Set)
  requires hom : h : polynomialRing(R, I) →+* polynomialRing(R, J)
  requires constants : ∀ a ∈ R.carrier, h(mvC(R, I, a)) = mvC(R, J, a)
  requires variables : ∀ i ∈ I, mvTotalDegree(R, J, h(X(R, I, i))) ≤ 1
  requires member : p ∈ Ring.carrier(polynomialRing(R, I))
  shows mvTotalDegree(R, J, h(p)) ≤ mvTotalDegree(R, I, p)
proof
  have pcI := polynomialRing.comm_ring at R, I with comm
  have pcJ := polynomialRing.comm_ring at R, J with comm
  have ringR := CommRing.to_ring with comm
  have oneIn : R.one ∈ R.carrier by typecheck
  have mmI := mvModule.module at R, I with comm, pcI
  have mmJ := mvModule.module at R, J with comm, pcJ
  obtain ⟨pcI2, paI, pzI⟩ := cldEMvModule.projections at R, I with comm, pcI
  obtain ⟨pcJ2, paJ, pzJ⟩ := cldEMvModule.projections at R, J with comm, pcJ
  obtain ⟨bF, bV⟩ := tkJ.mv_basis_family at R, I with comm, pcI
  have dN := (mvTotalDegree.selected at R, I, p with comm, member).left
  have dNat := nat.omega.backward with dN
  have DIsub : tkJDegreeAtMost(R, I, mvTotalDegree(R, I, p)) ⊆ monomials(I)
    intros m hm
    exact (tkJDegreeAtMost.membership.forward with hm).left
  have dle : mvTotalDegree(R, I, p) ≤ mvTotalDegree(R, I, p) by arith
  have pD := (tkJ.degree_at_most at R, I, p, mvTotalDegree(R, I, p) with comm, member).backward with dle
  rw (restrictSupport.span at R, I, tkJDegreeAtMost(R, I, mvTotalDegree(R, I, p)) with comm, pcI, DIsub) at pD
  have Tsub := restrictSupport.submodule at R, J, tkJDegreeAtMost(R, J, mvTotalDegree(R, I, p)) with comm, pcJ
  have imgSub : functionImage(monomialBasisFamily(R, I), tkJDegreeAtMost(R, I, mvTotalDegree(R, I, p)), Ring.carrier(polynomialRing(R, I))) ⊆ Module.carrier(mvModule(R, I))
    rw pcI2
    exact functionImage.subset at monomialBasisFamily(R, I), tkJDegreeAtMost(R, I, mvTotalDegree(R, I, p)), Ring.carrier(polynomialRing(R, I))
  have base : functionImage(monomialBasisFamily(R, I), tkJDegreeAtMost(R, I, mvTotalDegree(R, I, p)), Ring.carrier(polynomialRing(R, I))) ⊆ tkJDegreePreimage(R, I, J, h, mvTotalDegree(R, I, p))
    intros u hu
    obtain ⟨uIn, m, hm, eu⟩ := functionImage.membership.forward with hu
    obtain ⟨mMon, mlt⟩ := tkJDegreeAtMost.membership.forward with hm
    have mNat := mv.monomial_degree_nat at I, m with mMon
    have lt := Less.of_membership at monomialDegree(I, m), succ(mvTotalDegree(R, I, p))
    have l := lt with mlt
    have mle := Less.successor_upper with l
    rw (bV with m, mMon) at eu
    rw eu
    have monoIn := mvMonomial.mem at R, I, m, R.one with comm, pcI, mMon, oneIn
    have hIn := RingHom.map_mem at h, polynomialRing(R, I), polynomialRing(R, J), mvMonomial(R, I, m, R.one) with hom, monoIn
    have hle := (tkJ.degree_hom_monomial at R, I, J, h, monomialDegree(I, m) with comm, hom, constants, variables) with m, mMon, rfl, R.one, oneIn
    have hN := (mvTotalDegree.selected at R, J, h(mvMonomial(R, I, m, R.one)) with comm, hIn).left
    have hNat := nat.omega.backward with hN
    have le : mvTotalDegree(R, J, h(mvMonomial(R, I, m, R.one))) ≤ mvTotalDegree(R, I, p) by arith
    have inT := (tkJ.degree_at_most at R, J, h(mvMonomial(R, I, m, R.one)), mvTotalDegree(R, I, p) with comm, hIn).backward with le
    exact tkJDegreePreimage.membership.backward with ⟨monoIn, inT⟩
  have zeroIn : Module.zero(mvModule(R, I)) ∈ tkJDegreePreimage(R, I, J, h, mvTotalDegree(R, I, p))
    rw pzI
    have zIn : Ring.zero(polynomialRing(R, I)) ∈ Ring.carrier(polynomialRing(R, I)) by typecheck
    have z0 := SubmoduleOf.zero_mem at R, mvModule(R, J), restrictSupport(R, J, tkJDegreeAtMost(R, J, mvTotalDegree(R, I, p))) with ringR, mmJ, Tsub
    rw pzJ at z0
    rw ← (RingHom.map_zero at h, polynomialRing(R, I), polynomialRing(R, J) with hom) at z0
    exact tkJDegreePreimage.membership.backward with ⟨zIn, z0⟩
  have addIn : ∀ v w ∈ tkJDegreePreimage(R, I, J, h, mvTotalDegree(R, I, p)) ∩ Module.carrier(mvModule(R, I)), call2(Module.add(mvModule(R, I)), v, w) ∈ tkJDegreePreimage(R, I, J, h, mvTotalDegree(R, I, p))
    intros v hv w hw
    obtain ⟨vP, _⟩ := intersection.membership.forward with hv
    obtain ⟨wP, _⟩ := intersection.membership.forward with hw
    obtain ⟨vIn, vT⟩ := tkJDegreePreimage.membership.forward with vP
    obtain ⟨wIn, wT⟩ := tkJDegreePreimage.membership.forward with wP
    rw paI
    have sIn : call2(Ring.add(polynomialRing(R, I)), v, w) ∈ Ring.carrier(polynomialRing(R, I)) by typecheck
    have s := SubmoduleOf.add_mem at R, mvModule(R, J), restrictSupport(R, J, tkJDegreeAtMost(R, J, mvTotalDegree(R, I, p))), h(v), h(w) with ringR, mmJ, Tsub, vT, wT
    rw paJ at s
    rw ← (RingHom.map_add at h, polynomialRing(R, I), polynomialRing(R, J), v, w with hom, vIn, wIn) at s
    exact tkJDegreePreimage.membership.backward with ⟨sIn, s⟩
  have smulIn : ∀ r ∈ R.carrier, ∀ v ∈ tkJDegreePreimage(R, I, J, h, mvTotalDegree(R, I, p)) ∩ Module.carrier(mvModule(R, I)), call2(Module.smul(mvModule(R, I)), r, v) ∈ tkJDegreePreimage(R, I, J, h, mvTotalDegree(R, I, p))
    intros r hr v hv
    obtain ⟨vP, _⟩ := intersection.membership.forward with hv
    obtain ⟨vIn, vT⟩ := tkJDegreePreimage.membership.forward with vP
    rw ← (mvC.mul_eq_smul at R, I, r, v with comm, pcI, hr, vIn)
    have cIn : mvC(R, I, r) ∈ Ring.carrier(polynomialRing(R, I))
      unfold mvC
      exact polynomialConstant.mem at R, I, r with comm, hr
    have sIn : call2(Ring.mul(polynomialRing(R, I)), mvC(R, I, r), v) ∈ Ring.carrier(polynomialRing(R, I)) by typecheck
    have hvIn := RingHom.map_mem at h, polynomialRing(R, I), polynomialRing(R, J), v with hom, vIn
    have s := SubmoduleOf.smul_mem at R, mvModule(R, J), restrictSupport(R, J, tkJDegreeAtMost(R, J, mvTotalDegree(R, I, p))), r, h(v) with ringR, mmJ, Tsub, hr, vT
    rw ← (mvC.mul_eq_smul at R, J, r, h(v) with comm, pcJ, hr, hvIn) at s
    rw ← (constants with r, hr) at s
    rw ← (RingHom.map_mul at h, polynomialRing(R, I), polynomialRing(R, J), mvC(R, I, r), v with hom, cIn, vIn) at s
    exact tkJDegreePreimage.membership.backward with ⟨sIn, s⟩
  have ind := moduleSpan.induction at R, mvModule(R, I), functionImage(monomialBasisFamily(R, I), tkJDegreeAtMost(R, I, mvTotalDegree(R, I, p)), Ring.carrier(polynomialRing(R, I))), tkJDegreePreimage(R, I, J, h, mvTotalDegree(R, I, p)) with ringR, mmI, imgSub, base, zeroIn, addIn, smulIn
  have pP := ind with p, pD
  obtain ⟨_, hT⟩ := tkJDegreePreimage.membership.forward with pP
  have hpIn := RingHom.map_mem at h, polynomialRing(R, I), polynomialRing(R, J), p with hom, member
  exact (tkJ.degree_at_most at R, J, h(p), mvTotalDegree(R, I, p) with comm, hpIn).forward with hT

-- Renaming keeps the total degree.
theorem polynomialRename.total_degree (I J σ p : Set)
  requires map : σ : I → J
  requires injective : InjectiveBetween(σ, I, J)
  requires member : p ∈ Ring.carrier(polynomialRing(R, I))
  shows mvTotalDegree(R, J, polynomialRename(R, I, J, σ)(p)) = mvTotalDegree(R, I, p)
proof
  have pcI := polynomialRing.comm_ring at R, I with comm
  have pcJ := polynomialRing.comm_ring at R, J with comm
  have zeroIn : R.zero ∈ R.carrier by typecheck
  have oneIn : R.one ∈ R.carrier by typecheck
  obtain ⟨wF, wV⟩ := cldERenameBack.function at R, I, J, σ with comm, map, injective
  have algI := polynomialAlgebra.algebra at R, I with comm
  have over := polynomialAlgebra.base at R, I
  have values : cldERenameBack(R, I, J, σ) : J → algebraCarrier(polynomialAlgebra(R, I))
    rw polynomialAlgebra.carrierOf
    exact wF
  have back := evaluationHom.algebra_hom at R, J, polynomialAlgebra(R, I), cldERenameBack(R, I, J, σ) with comm, algI, over, values
  rw [polynomialAlgebra.ring, polynomialAlgebra.map] at back
  have forward := polynomialRename.hom at R, I, J, σ with comm, map
  have cstI := polynomialConstant.hom at R, I with comm
  have vars : ∀ i ∈ I, evaluationHom(R, polynomialRing(R, I), J, polynomialConstant(R, I), cldERenameBack(R, I, J, σ))(polynomialRename(R, I, J, σ)(X(R, I, i))) = X(R, I, i)
    intros i hi
    rw (polynomialRename.map_X at R, I, J, σ, i with comm, map, hi)
    have si := FunctionBetween.apply_closed with map, hi
    rw (evaluationHom.map_X at R, polynomialRing(R, I), J, polynomialConstant(R, I), cldERenameBack(R, I, J, σ), σ(i) with comm, pcI, cstI, wF, si)
    exact wV with i, hi
  have trip := AlgebraHom.polynomial_round_trip at R, I, polynomialAlgebra(R, J), polynomialRename(R, I, J, σ), evaluationHom(R, polynomialRing(R, I), J, polynomialConstant(R, I), cldERenameBack(R, I, J, σ)) with comm, forward, back, vars
  have fh := AlgebraHom.ring_hom at polynomialRename(R, I, J, σ), polynomialAlgebra(R, I), polynomialAlgebra(R, J) with forward
  rw [polynomialAlgebra.ring, polynomialAlgebra.ring] at fh
  have bh := AlgebraHom.ring_hom at evaluationHom(R, polynomialRing(R, I), J, polynomialConstant(R, I), cldERenameBack(R, I, J, σ)), polynomialAlgebra(R, J), polynomialAlgebra(R, I) with back
  rw [polynomialAlgebra.ring, polynomialAlgebra.ring] at bh
  -- Renaming fixes constants and sends variables to variables.
  have fc : ∀ a ∈ R.carrier, polynomialRename(R, I, J, σ)(mvC(R, I, a)) = mvC(R, J, a)
    intros a ha
    have ha2 : a ∈ Ring.carrier(Algebra.base(polynomialAlgebra(R, I)))
      rw polynomialAlgebra.base
      exact ha
    have mb := AlgebraHom.map_base at polynomialRename(R, I, J, σ), polynomialAlgebra(R, I), polynomialAlgebra(R, J), a with forward, ha2
    rw [polynomialAlgebra.map, polynomialAlgebra.map] at mb
    unfold mvC
    exact mb
  have fv : ∀ i ∈ I, mvTotalDegree(R, J, polynomialRename(R, I, J, σ)(X(R, I, i))) ≤ 1
    intros i hi
    have si := FunctionBetween.apply_closed with map, hi
    rw (polynomialRename.map_X at R, I, J, σ, i with comm, map, hi)
    rw (X.eq_monomial at R, J, σ(i) with comm, pcJ, si)
    have vm := monomialVariable.member at J, σ(i)
    have le := tkJ.monomial_total_le at R, J, monomialVariable(J, σ(i)), R.one with comm, pcJ, vm, oneIn
    rw (rmEMv.variable_degree at R, J, σ(i) with comm, pcJ, si) at le
    exact le
  -- Renaming back fixes constants and sends each variable to a variable
  -- or to 0.
  have bc : ∀ a ∈ R.carrier, evaluationHom(R, polynomialRing(R, I), J, polynomialConstant(R, I), cldERenameBack(R, I, J, σ))(mvC(R, J, a)) = mvC(R, I, a)
    intros a ha
    unfold mvC
    exact evaluationHom.map_constant at R, polynomialRing(R, I), J, polynomialConstant(R, I), cldERenameBack(R, I, J, σ), a with comm, pcI, cstI, wF, ha
  have zeroDeg : mvTotalDegree(R, I, Ring.zero(polynomialRing(R, I))) = 0
    have c0 := mvTotalDegree.C at R, I, R.zero with comm, pcI, zeroIn
    unfold mvC at c0
    rw (RingHom.map_zero at polynomialConstant(R, I), R, polynomialRing(R, I) with cstI) at c0
    exact c0
  have bv : ∀ j ∈ J, mvTotalDegree(R, I, evaluationHom(R, polynomialRing(R, I), J, polynomialConstant(R, I), cldERenameBack(R, I, J, σ))(X(R, J, j))) ≤ 1
    intros j hj
    rw (evaluationHom.map_X at R, polynomialRing(R, I), J, polynomialConstant(R, I), cldERenameBack(R, I, J, σ), j with comm, pcI, cstI, wF, hj)
    have r := FunctionBetween.relates_apply with wF, hj
    unfold relates at r
    obtain ⟨_, alt⟩ := cldERenameBack.membership.forward with r
    rcases alt with ⟨i, hi, e⟩ | ⟨k, hk, out, e⟩
    . obtain ⟨_, ye⟩ := orderedPair.injective with e
      rw ye
      rw (X.eq_monomial at R, I, i with comm, pcI, hi)
      have vm := monomialVariable.member at I, i
      have le := tkJ.monomial_total_le at R, I, monomialVariable(I, i), R.one with comm, pcI, vm, oneIn
      rw (rmEMv.variable_degree at R, I, i with comm, pcI, hi) at le
      exact le
    . obtain ⟨_, ye⟩ := orderedPair.injective with e
      rw [ye, zeroDeg]
      arith
  have le1 := tkJ.degree_hom at R, I, J, polynomialRename(R, I, J, σ), p with comm, fh, fc, fv, member
  have rIn := RingHom.map_mem at polynomialRename(R, I, J, σ), polynomialRing(R, I), polynomialRing(R, J), p with fh, member
  have le2 := tkJ.degree_hom at R, J, I, evaluationHom(R, polynomialRing(R, I), J, polynomialConstant(R, I), cldERenameBack(R, I, J, σ)), polynomialRename(R, I, J, σ)(p) with comm, bh, bc, bv, rIn
  have pmem := member
  rw ← (polynomialAlgebra.carrierOf at R, I) at pmem
  rw (trip with p, pmem) at le2
  have n1 := nat.omega.backward with ((mvTotalDegree.selected at R, I, p with comm, member).left)
  have d2 := (mvTotalDegree.selected at R, J, polynomialRename(R, I, J, σ)(p) with comm, rIn).left
  have n2 := nat.omega.backward with d2
  arith

-- bind₁: a homomorphism R[I] → R[J] with Xᵢ ↦ g(i) (bind₁_X_right), bind
-- of the variables is the identity (bind₁_X_left), substitution composes
-- (MvPolynomial.bind₁_bind₁), and rename is bind along variables
-- (rename_eq_bind₁... written with mvVariables), and aeval is
-- MvPolynomial.aeval_eq_bind₁ at a polynomial algebra.
theorem mvBind.hom (I J g : Set)
  requires substitution : g : I → Ring.carrier(polynomialRing(R, J))
  shows mvBind(R, I, J, g) : polynomialRing(R, I) →+* polynomialRing(R, J)
proof
  have pcJ := polynomialRing.comm_ring at R, J with comm
  have pcI := polynomialRing.comm_ring at R, I with comm
  have ch := polynomialConstant.hom at R, J with comm
  unfold mvBind
  exact evaluationHom.hom at R, polynomialRing(R, J), I, polynomialConstant(R, J), g with comm, pcJ, ch, substitution

theorem mvBind.X (I J g i : Set)
  requires substitution : g : I → Ring.carrier(polynomialRing(R, J))
  requires index : i ∈ I
  shows mvBind(R, I, J, g)(X(R, I, i)) = g(i)
proof
  have pcJ := polynomialRing.comm_ring at R, J with comm
  have ch := polynomialConstant.hom at R, J with comm
  unfold mvBind
  exact evaluationHom.map_X at R, polynomialRing(R, J), I, polynomialConstant(R, J), g, i with comm, pcJ, ch, substitution, index

theorem mvBind.variables (I p : Set)
  requires member : p ∈ Ring.carrier(polynomialRing(R, I))
  shows mvBind(R, I, I, mvVariables(R, I))(p) = p
proof
  have pcI := polynomialRing.comm_ring at R, I with comm
  have ch := polynomialConstant.hom at R, I with comm
  have vf := mv.variables_function at R, I
  have xs : ∀ i ∈ I, X(R, I, i) ∈ Ring.carrier(polynomialRing(R, I))
    intros i hi
    exact X.mem at R, I, i with comm
  obtain ⟨fn, vals⟩ := vf with xs
  have idh := RingHom.id at polynomialRing(R, I) with pcI
  have u := evaluationHom.unique at R, polynomialRing(R, I), I, polynomialConstant(R, I), mvVariables(R, I), identity(Ring.carrier(polynomialRing(R, I))) with comm, pcI, ch, fn, idh
  have eq : identity(Ring.carrier(polynomialRing(R, I))) = evaluationHom(R, polynomialRing(R, I), I, polynomialConstant(R, I), mvVariables(R, I))
    apply u
    . intros a ha
      have cIn := polynomialConstant.mem at R, I, a with comm, ha
      exact identity.apply at polynomialConstant(R, I)(a), Ring.carrier(polynomialRing(R, I)) with cIn
    . intros j hj
      have xIn := X.mem at R, I, j with comm
      rw (vals with j, hj)
      exact identity.apply at X(R, I, j), Ring.carrier(polynomialRing(R, I)) with xIn
  unfold mvBind
  rw ← eq
  exact identity.apply at p, Ring.carrier(polynomialRing(R, I)) with member

theorem mvBind.bind (I J K g h p : Set)
  requires first : g : I → Ring.carrier(polynomialRing(R, J))
  requires second : h : J → Ring.carrier(polynomialRing(R, K))
  requires member : p ∈ Ring.carrier(polynomialRing(R, I))
  shows mvBind(R, J, K, h)(mvBind(R, I, J, g)(p)) =
    mvBind(R, I, K, bindCompose(R, I, J, K, g, h))(p)
proof
  have pcI := polynomialRing.comm_ring at R, I with comm
  have pcJ := polynomialRing.comm_ring at R, J with comm
  have pcK := polynomialRing.comm_ring at R, K with comm
  have bg := mvBind.hom at R, I, J, g with comm, first
  have bh := mvBind.hom at R, J, K, h with comm, second
  have c := RingHom.comp at mvBind(R, I, J, g), mvBind(R, J, K, h), polynomialRing(R, I), polynomialRing(R, J), polynomialRing(R, K) with pcI, bg, bh
  have bv : ∀ i ∈ I, mvBind(R, J, K, h)(g(i)) ∈ Ring.carrier(polynomialRing(R, K))
    intros i hi
    have gi := FunctionBetween.apply_closed with first, hi
    exact RingHom.map_mem at mvBind(R, J, K, h), polynomialRing(R, J), polynomialRing(R, K), g(i) with bh, gi
  obtain ⟨bcf, bcv⟩ := mv.bind_compose_function at R, I, J, K, g, h with bv
  have bc := mvBind.hom at R, I, K, bindCompose(R, I, J, K, g, h) with comm, bcf
  have b0 := bg
  obtain ⟨_, _, gfn, _⟩ := b0
  have b1 := bh
  obtain ⟨_, _, hfn, _⟩ := b1
  have chJ := polynomialConstant.hom at R, J with comm
  have chK := polynomialConstant.hom at R, K with comm
  have eq : compose(mvBind(R, J, K, h), mvBind(R, I, J, g), Ring.carrier(polynomialRing(R, I)), Ring.carrier(polynomialRing(R, J)), Ring.carrier(polynomialRing(R, K))) = mvBind(R, I, K, bindCompose(R, I, J, K, g, h))
    apply polynomialRing.hom_ext at R, I, polynomialRing(R, K), compose(mvBind(R, J, K, h), mvBind(R, I, J, g), Ring.carrier(polynomialRing(R, I)), Ring.carrier(polynomialRing(R, J)), Ring.carrier(polynomialRing(R, K))), mvBind(R, I, K, bindCompose(R, I, J, K, g, h)) with comm, c, bc
    . intros a ha
      have cIn := polynomialConstant.mem at R, I, a with comm, ha
      rw (compose.apply at mvBind(R, J, K, h), mvBind(R, I, J, g), Ring.carrier(polynomialRing(R, I)), Ring.carrier(polynomialRing(R, J)), Ring.carrier(polynomialRing(R, K)), polynomialConstant(R, I)(a) with gfn, hfn, cIn)
      unfold mvBind
      rw (evaluationHom.map_constant at R, polynomialRing(R, J), I, polynomialConstant(R, J), g, a with comm, pcJ, chJ, first, ha)
      rw (evaluationHom.map_constant at R, polynomialRing(R, K), J, polynomialConstant(R, K), h, a with comm, pcK, chK, second, ha)
      rw (evaluationHom.map_constant at R, polynomialRing(R, K), I, polynomialConstant(R, K), bindCompose(R, I, J, K, g, h), a with comm, pcK, chK, bcf, ha)
    . intros i hi
      have xIn := X.mem at R, I, i with comm
      rw (compose.apply at mvBind(R, J, K, h), mvBind(R, I, J, g), Ring.carrier(polynomialRing(R, I)), Ring.carrier(polynomialRing(R, J)), Ring.carrier(polynomialRing(R, K)), X(R, I, i) with gfn, hfn, xIn)
      rw (mvBind.X at R, I, J, g, i with comm, first, hi)
      rw (mvBind.X at R, I, K, bindCompose(R, I, J, K, g, h), i with comm, bcf, hi)
      rw (bcv with i, hi)
  rw ← eq
  rw (compose.apply at mvBind(R, J, K, h), mvBind(R, I, J, g), Ring.carrier(polynomialRing(R, I)), Ring.carrier(polynomialRing(R, J)), Ring.carrier(polynomialRing(R, K)), p with gfn, hfn, member)

theorem mvBind.rename (I J σ p : Set)
  requires map : σ : I → J
  requires member : p ∈ Ring.carrier(polynomialRing(R, I))
  shows polynomialRename(R, I, J, σ)(p) =
    mvBind(R, I, J, compose(mvVariables(R, J), σ, I, J,
      Ring.carrier(polynomialRing(R, J))))(p)
proof
  have xs : ∀ j ∈ J, X(R, J, j) ∈ Ring.carrier(polynomialRing(R, J))
    intros j hj
    exact X.mem at R, J, j with comm
  obtain ⟨vfn, vval⟩ := mv.variables_function at R, J with xs
  have va := variableAssignment.function at R, I, J, σ with comm, map
  have cf := compose.function at mvVariables(R, J), σ, I, J, Ring.carrier(polynomialRing(R, J)) with map, vfn
  have eq : variableAssignment(R, I, J, σ) = compose(mvVariables(R, J), σ, I, J, Ring.carrier(polynomialRing(R, J)))
    apply FunctionBetween.ext with va, cf
    intros i hi
    rw (variableAssignment.apply at R, I, J, σ, i with comm, map, hi)
    rw (compose.apply at mvVariables(R, J), σ, I, J, Ring.carrier(polynomialRing(R, J)), i with map, vfn, hi)
    have si := FunctionBetween.apply_closed with map, hi
    rw (vval with σ(i), si)
  unfold polynomialRename
  unfold mvBind
  rw eq

-- MvPolynomial.funext: over an infinite domain, polynomials with the same
-- values at every point are equal.
theorem mvPolynomial.funext (I p q : Set)
  requires domain : IntegralDomain(R)
  requires infinite : ¬Finite(R.carrier)
  requires first : p ∈ Ring.carrier(polynomialRing(R, I))
  requires second : q ∈ Ring.carrier(polynomialRing(R, I))
  requires agree : ∀ v, (v : I → R.carrier) →
    evaluationAt(R, I, v)(p) = evaluationAt(R, I, v)(q)
  shows p = q
proof
  have dom0 := domain
  obtain ⟨comm2, ne, nzd⟩ := dom0
  have parts := CommRing.parts with comm
  have pcI := polynomialRing.comm_ring at R, I with comm
  have zeroIn : R.zero ∈ R.carrier by typecheck
  have oneIn : R.one ∈ R.carrier by typecheck
  have dom : IsIntegralDomain(R.carrier, R.add, R.zero, R.neg, R.mul, R.one)
    unfold IsIntegralDomain
    refine ⟨parts, ?_, ?_⟩
    . unfold Nontrivial
      exact ⟨zeroIn, oneIn, ne⟩
    . unfold NoZeroDivisors
      intros x hx y hy e
      exact nzd with x, hx, y, hy, e
  have pp := polynomialRing.member_parts at R, I, p with comm, pcI, first
  have qp := polynomialRing.member_parts at R, I, q with comm, pcI, second
  have ag : ∀ v, FunctionBetween(v, I, R.carrier) → polynomialAt(I, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, v)(p) = polynomialAt(I, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, v)(q)
    intros v hv
    have e := agree with v, hv
    unfold evaluationAt at e
    exact e
  exact tkJ.poly_at_ext at I, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, p, q with dom, infinite, pp, qp, ag

-- One variable: R[{0}] with X_0 is the univariate ring of
-- GRH.Polynomial.Univariate, and aeval in one variable is polyAeval.
theorem mvAeval.univariate (A x p : Set)
  requires algebra : Algebra(A)
  requires point : x ∈ algebraCarrier(A)
  requires member : p ∈ Ring.carrier(polynomialRing(Algebra.base(A), {0}))
  shows mvAeval(A, {0}, constantFunction({0}, algebraCarrier(A), x))(p) =
    polyAeval(A, x, p)
proof
  unfold mvAeval
  unfold polyAeval
  unfold polyEval2
  unfold algebraCarrier
  rfl

end RenameBind
