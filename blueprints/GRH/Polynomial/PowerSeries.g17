-- Formal power series over a commutative ring R: in one variable, the
-- functions ℕ → R with the Cauchy product (Mathlib's PowerSeries R), and
-- in a set I of variables, the functions monomials(I) → R
-- (MvPowerSeries I R). Coefficients, constants, the variable, the
-- constant coefficient, polynomials as power series, coefficient maps,
-- truncation, rescaling, the derivative and partial derivatives, units
-- (invertibility of the constant coefficient), divisibility by powers of
-- X, substitution of a series with nilpotent constant coefficient
-- (PowerSeries.subst on its HasSubst domain for discrete R), and the
-- exponential series over a ring where every n! is a unit.
-- Part of the GRH blueprint.
-- Planned home: Algebra/PowerSeries.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Polynomial.PowerSeries
import GRH.Polynomial.Multivariate

-- Section: Power series in one variable
-- The coefficient sequences, and the operations: pointwise sum and
-- negation, the Cauchy product (f g)ₙ = Σ_{i + j = n} fᵢ gⱼ, zero, and one.
def powerSeriesCarrier (R : Set) : Set := functionSpace(ℕ, Ring.carrier(R))

def ringCauchyTerms (R f g : Set, n : Nat) : Set :=
  { u ∈ antidiagonal(n) × Ring.carrier(R) | ∃ i ∈ ℕ, ∃ j ∈ ℕ,
    u = ((i, j), call2(Ring.mul(R), f(i), g(j))) }

def ringCauchyProduct (R f g : Set) : Set :=
  { u ∈ ℕ × Ring.carrier(R) | ∃ n ∈ ℕ, u = (n, finiteRingSum(antidiagonal(n),
    Ring.carrier(R), Ring.add(R), Ring.zero(R), Ring.neg(R), Ring.mul(R),
    Ring.one(R), ringCauchyTerms(R, f, g, n))) }

def seriesSum (R f g : Set) : Set :=
  { u ∈ ℕ × Ring.carrier(R) | ∃ n ∈ ℕ, u = (n, call2(Ring.add(R), f(n), g(n))) }

def seriesNeg (R f : Set) : Set :=
  { u ∈ ℕ × Ring.carrier(R) | ∃ n ∈ ℕ, u = (n, apply(Ring.neg(R), f(n))) }

-- The sequence a, 0, 0, … (PowerSeries.C a), and X = 0, 1, 0, 0, …
def seriesConstant (R a : Set) : Set :=
  { u ∈ ℕ × Ring.carrier(R) | ∃ n ∈ ℕ,
    (n = 0 ∧ u = (n, a)) ∨ (n ≠ 0 ∧ u = (n, Ring.zero(R))) }

def seriesX (R : Set) : Set :=
  { u ∈ ℕ × Ring.carrier(R) | ∃ n ∈ ℕ,
    (n = 1 ∧ u = (n, Ring.one(R))) ∨ (n ≠ 1 ∧ u = (n, Ring.zero(R))) }

def seriesAdd (R : Set) : Set :=
  { q ∈ (powerSeriesCarrier(R) × powerSeriesCarrier(R)) × powerSeriesCarrier(R) |
    ∃ f ∈ powerSeriesCarrier(R), ∃ g ∈ powerSeriesCarrier(R),
      q = ((f, g), seriesSum(R, f, g)) }

def seriesMul (R : Set) : Set :=
  { q ∈ (powerSeriesCarrier(R) × powerSeriesCarrier(R)) × powerSeriesCarrier(R) |
    ∃ f ∈ powerSeriesCarrier(R), ∃ g ∈ powerSeriesCarrier(R),
      q = ((f, g), ringCauchyProduct(R, f, g)) }

def seriesNegation (R : Set) : Set :=
  { q ∈ powerSeriesCarrier(R) × powerSeriesCarrier(R) |
    ∃ f ∈ powerSeriesCarrier(R), q = (f, seriesNeg(R, f)) }

-- R[[X]] (PowerSeries R).
def powerSeriesRing (R : Set) : Set :=
  Ring.mk(powerSeriesCarrier(R), seriesAdd(R),
    constantFunction(ℕ, Ring.carrier(R), Ring.zero(R)), seriesNegation(R),
    seriesMul(R), seriesConstant(R, Ring.one(R)))

-- The coefficient of Xⁿ (PowerSeries.coeff) and the constant coefficient
-- (PowerSeries.constantCoeff). A sequence ℕ → R is itself a series
-- (PowerSeries.mk is the identity here).
def seriesCoeff (f : Set, n : Nat) : Set := f(n)

def seriesConstantCoeff (f : Set) : Set := f(0)

-- The constants as a map R → R[[X]] (PowerSeries.C as a homomorphism).
def seriesConstantMap (R : Set) : Set :=
  { u ∈ Ring.carrier(R) × powerSeriesCarrier(R) | ∃ a ∈ Ring.carrier(R),
    u = (a, seriesConstant(R, a)) }

-- A polynomial as a power series (Polynomial.coeToPowerSeries): its
-- coefficient sequence.
def polySequence (R p : Set) : Set :=
  { v ∈ ℕ × Ring.carrier(R) | ∃ n ∈ ℕ, v = (n, p({(0, n)})) }

def polynomialToSeries (R : Set) : Set :=
  { u ∈ Ring.carrier(polynomialRing(R, {0})) × powerSeriesCarrier(R) |
    ∃ p ∈ Ring.carrier(polynomialRing(R, {0})),
      u = (p, polySequence(R, p)) }

-- The coefficientwise image (PowerSeries.map), as a map on series.
def seriesMap (R S f : Set) : Set :=
  { u ∈ powerSeriesCarrier(R) × powerSeriesCarrier(S) |
    ∃ g ∈ powerSeriesCarrier(R), u = (g, compose(f, g, ℕ, Ring.carrier(R),
      Ring.carrier(S))) }

-- The truncation Σ_{k < n} fₖ Xᵏ, a polynomial (PowerSeries.trunc).
def seriesTrunc (R f : Set, n : Nat) : Set :=
  { u ∈ monomials({0}) × Ring.carrier(R) | ∃ k ∈ ℕ,
    (k < n ∧ u = ({(0, k)}, f(k))) ∨ (n ≤ k ∧ u = ({(0, k)}, Ring.zero(R))) }

-- f(a X): the coefficients aⁿ fₙ (PowerSeries.rescale).
def seriesRescale (R a f : Set) : Set :=
  { u ∈ ℕ × Ring.carrier(R) | ∃ n ∈ ℕ,
    u = (n, call2(Ring.mul(R), Ring.pow(R, a, n), f(n))) }

-- The derivative: (f')ₙ = (n + 1) fₙ₊₁ (PowerSeries.derivative).
def seriesDerivative (R f : Set) : Set :=
  { u ∈ ℕ × Ring.carrier(R) | ∃ n ∈ ℕ, u = (n, call2(Ring.mul(R),
    ringNat(Ring.add(R), Ring.zero(R), Ring.one(R), succ(n)), f(succ(n)))) }

-- The exponential series Σ Xⁿ / n!, over a ring in which every n! is a
-- unit (PowerSeries.exp over a ℚ-algebra).
def seriesExp (R : Set) : Set :=
  { u ∈ ℕ × Ring.carrier(R) | ∃ n ∈ ℕ, u = (n, ringInverse(R,
    ringNat(Ring.add(R), Ring.zero(R), Ring.one(R), factorial(n)))) }

-- Substitution of g with nilpotent constant coefficient into f: the n-th
-- coefficient of Σₖ fₖ gᵏ, a sum that is eventually constant in the
-- number of terms because (gᵏ)ₙ = 0 for large k (PowerSeries.subst and
-- PowerSeries.coeff_subst on HasSubst for the discrete topology).
def substTerms (R f g : Set, n L : Nat) : Set :=
  { u ∈ L × Ring.carrier(R) | ∃ k ∈ ℕ, k < L ∧ u = (k, call2(Ring.mul(R), f(k),
    Ring.pow(powerSeriesRing(R), g, k)(n))) }

defunique substCoeff (R f g : Set, n : Nat) (c ∈ Ring.carrier(R)) :=
  ∃ K ∈ ℕ, ∀ L ∈ ℕ, K ≤ L → c = finiteRingSum(L, Ring.carrier(R),
    Ring.add(R), Ring.zero(R), Ring.neg(R), Ring.mul(R), Ring.one(R),
    substTerms(R, f, g, n, L))
requires ring : CommRing(R)
requires series : f ∈ powerSeriesCarrier(R)
requires substituted : g ∈ powerSeriesCarrier(R)
requires nilpotent : RingNilpotent(R, g(0))
proof
  sorry
uniqueness
  sorry

def seriesSubst (R f g : Set) : Set :=
  { u ∈ ℕ × Ring.carrier(R) | ∃ n ∈ ℕ, u = (n, substCoeff(R, f, g, n)) }

-- PowerSeries.HasSubst for discrete R: the constant coefficient is
-- nilpotent.
predicate SeriesHasSubst (R g : Set) :=
  g ∈ powerSeriesCarrier(R) ∧ RingNilpotent(R, g(0))

-- Section: Power series in several variables
-- MvPowerSeries I R: maps monomials(I) → R with the product over the
-- finitely many pairs of exponents adding to m.
def mvSeriesCarrier (R I : Set) : Set := functionSpace(monomials(I), Ring.carrier(R))

def monomialAntidiagonal (I m : Set) : Set :=
  { t ∈ monomials(I) × monomials(I) | monomialMul(I)(t) = m }

def mvCauchyTerms (R I f g m : Set) : Set :=
  { u ∈ monomialAntidiagonal(I, m) × Ring.carrier(R) |
    ∃ a ∈ monomials(I), ∃ b ∈ monomials(I),
      u = ((a, b), call2(Ring.mul(R), f(a), g(b))) }

def mvCauchyProduct (R I f g : Set) : Set :=
  { u ∈ monomials(I) × Ring.carrier(R) | ∃ m ∈ monomials(I),
    u = (m, finiteRingSum(monomialAntidiagonal(I, m), Ring.carrier(R),
      Ring.add(R), Ring.zero(R), Ring.neg(R), Ring.mul(R), Ring.one(R),
      mvCauchyTerms(R, I, f, g, m))) }

def mvSeriesSum (R I f g : Set) : Set :=
  { u ∈ monomials(I) × Ring.carrier(R) | ∃ m ∈ monomials(I),
    u = (m, call2(Ring.add(R), f(m), g(m))) }

def mvSeriesNeg (R I f : Set) : Set :=
  { u ∈ monomials(I) × Ring.carrier(R) | ∃ m ∈ monomials(I),
    u = (m, apply(Ring.neg(R), f(m))) }

-- The constant a (MvPowerSeries.C) and the variable Xᵢ (MvPowerSeries.X).
def mvSeriesConstant (R I a : Set) : Set :=
  coefficientSingle(monomials(I), Ring.carrier(R), Ring.zero(R), a, monomialOne(I))

def mvSeriesX (R I i : Set) : Set :=
  coefficientSingle(monomials(I), Ring.carrier(R), Ring.zero(R), Ring.one(R),
    monomialVariable(I, i))

def mvSeriesAdd (R I : Set) : Set :=
  { q ∈ (mvSeriesCarrier(R, I) × mvSeriesCarrier(R, I)) × mvSeriesCarrier(R, I) |
    ∃ f ∈ mvSeriesCarrier(R, I), ∃ g ∈ mvSeriesCarrier(R, I),
      q = ((f, g), mvSeriesSum(R, I, f, g)) }

def mvSeriesMul (R I : Set) : Set :=
  { q ∈ (mvSeriesCarrier(R, I) × mvSeriesCarrier(R, I)) × mvSeriesCarrier(R, I) |
    ∃ f ∈ mvSeriesCarrier(R, I), ∃ g ∈ mvSeriesCarrier(R, I),
      q = ((f, g), mvCauchyProduct(R, I, f, g)) }

def mvSeriesNegation (R I : Set) : Set :=
  { q ∈ mvSeriesCarrier(R, I) × mvSeriesCarrier(R, I) |
    ∃ f ∈ mvSeriesCarrier(R, I), q = (f, mvSeriesNeg(R, I, f)) }

def mvPowerSeriesRing (R I : Set) : Set :=
  Ring.mk(mvSeriesCarrier(R, I), mvSeriesAdd(R, I),
    constantFunction(monomials(I), Ring.carrier(R), Ring.zero(R)),
    mvSeriesNegation(R, I), mvSeriesMul(R, I),
    mvSeriesConstant(R, I, Ring.one(R)))

-- The constant coefficient f(0) (MvPowerSeries.constantCoeff).
def mvSeriesConstantCoeff (I f : Set) : Set := f(monomialOne(I))

-- A polynomial is a series (MvPolynomial.coeToMvPowerSeries): the inclusion
-- of finitely supported maps.
def mvPolynomialToSeries (R I : Set) : Set :=
  identity(Ring.carrier(polynomialRing(R, I)))

-- The coefficientwise image (MvPowerSeries.map).
def mvSeriesMap (R S I f : Set) : Set :=
  { u ∈ mvSeriesCarrier(R, I) × mvSeriesCarrier(S, I) |
    ∃ g ∈ mvSeriesCarrier(R, I), u = (g, compose(f, g, monomials(I),
      Ring.carrier(R), Ring.carrier(S))) }

-- The partial derivative ∂/∂Xᵢ: the coefficient at m is (m(i) + 1) times
-- the coefficient at m + eᵢ (MvPowerSeries.pderiv, coeff_pderiv).
def mvSeriesPartial (R I i f : Set) : Set :=
  { u ∈ monomials(I) × Ring.carrier(R) | ∃ m ∈ monomials(I),
    u = (m, call2(Ring.mul(R), ringNat(Ring.add(R), Ring.zero(R), Ring.one(R),
      succ(m(i))), f(monomialMul(I)((m, monomialVariable(I, i)))))) }

-- The truncation to total degree below n, a polynomial
-- (MvPowerSeries.truncTotal).
def mvSeriesTruncTotal (R I f : Set, n : Nat) : Set :=
  { u ∈ monomials(I) × Ring.carrier(R) | ∃ m ∈ monomials(I),
    (monomialDegree(I, m) < n ∧ u = (m, f(m))) ∨
    (n ≤ monomialDegree(I, m) ∧ u = (m, Ring.zero(R))) }

-- Renaming along an injective σ : I → J: the coefficient at the image
-- m ∘ σ⁻¹ of m is f(m), and 0 at exponents involving variables outside
-- the range (MvPowerSeries.rename for an embedding).
def monomialPushforward (I J σ m : Set) : Set :=
  { u ∈ J × ℕ | ∃ j ∈ J, ((∃ i ∈ I, σ(i) = j ∧ u = (j, m(i))) ∨
    ((∀ i ∈ I, σ(i) ≠ j) ∧ u = (j, 0))) }

def mvSeriesRename (R I J σ f : Set) : Set :=
  { u ∈ monomials(J) × Ring.carrier(R) | ∃ n ∈ monomials(J),
    ((∃ m ∈ monomials(I), monomialPushforward(I, J, σ, m) = n ∧ u = (n, f(m))) ∨
     ((∀ m ∈ monomials(I), monomialPushforward(I, J, σ, m) ≠ n) ∧
      u = (n, Ring.zero(R)))) }

-- A series in one variable as a series in the variables {0}
-- (PowerSeries.toMvPowerSeries, which is definitional in Mathlib).
def seriesToMv (R f : Set) : Set :=
  { u ∈ monomials({0}) × Ring.carrier(R) | ∃ m ∈ monomials({0}), u = (m, f(m(0))) }

-- The maps f ↦ f(a X) and f ↦ f(g) on series.
def rescaleMap (R a : Set) : Set :=
  { u ∈ powerSeriesCarrier(R) × powerSeriesCarrier(R) |
    ∃ f ∈ powerSeriesCarrier(R), u = (f, seriesRescale(R, a, f)) }

def substMap (R g : Set) : Set :=
  { u ∈ powerSeriesCarrier(R) × powerSeriesCarrier(R) |
    ∃ f ∈ powerSeriesCarrier(R), u = (f, seriesSubst(R, f, g)) }

-- The maps C : R → R[[I]] and rename f ↦ f ∘ σ⁻¹ on series.
def mvSeriesConstantMap (R I : Set) : Set :=
  { u ∈ Ring.carrier(R) × mvSeriesCarrier(R, I) | ∃ a ∈ Ring.carrier(R),
    u = (a, mvSeriesConstant(R, I, a)) }

def mvSeriesRenameMap (R I J σ : Set) : Set :=
  { u ∈ mvSeriesCarrier(R, I) × mvSeriesCarrier(R, J) |
    ∃ f ∈ mvSeriesCarrier(R, I), u = (f, mvSeriesRename(R, I, J, σ, f)) }

-- The isomorphism from one-variable series to series over {0}.
def seriesToMvMap (R : Set) : Set :=
  { u ∈ powerSeriesCarrier(R) × mvSeriesCarrier(R, {0}) |
    ∃ f ∈ powerSeriesCarrier(R), u = (f, seriesToMv(R, f)) }

-- Helper: the map k ↦ {(0, k)} onto the univariate monomials.
def tkJMonomialOf (I : Set) : Set :=
  { u ∈ ℕ × monomials({0}) | ∃ k ∈ ℕ, u = (k, {(0, k)}) }

theorem tkJ.monomial_of (I : Set)
  shows (tkJMonomialOf(I) : ℕ → monomials({0})) ∧
    (∀ k ∈ ℕ, tkJMonomialOf(I)(k) = {(0, k)})
proof
  have rel : ∀ k ∈ ℕ, (k, {(0, k)}) ∈ tkJMonomialOf(I) ∧ {(0, k)} ∈ monomials({0})
    intros k kN
    have kNat := nat.omega.backward with kN
    have mk := monomials.univariate at k
    have m : (k, {(0, k)}) ∈ tkJMonomialOf(I)
      apply tkJMonomialOf.membership.backward
      refine ⟨(product.pair with kN, mk), k, kN, rfl⟩
    exact ⟨m, mk⟩
  have fn : tkJMonomialOf(I) : ℕ → monomials({0})
    apply tkJ.uni_graph_function
    . intros u hu
      exact (tkJMonomialOf.membership.forward with hu).left
    . intros x y z hy hz
      obtain ⟨_, a, aIn, ea⟩ := tkJMonomialOf.membership.forward with hy
      obtain ⟨_, b, bIn, eb⟩ := tkJMonomialOf.membership.forward with hz
      obtain ⟨xa, ya⟩ := orderedPair.injective with ea
      obtain ⟨xb, yb⟩ := orderedPair.injective with eb
      rw [ya, yb, ← xa, ← xb]
    . intros x hx
      obtain ⟨m, v⟩ := rel with x, hx
      exact ⟨{(0, x)}, v, m⟩
  refine ⟨fn, ?_⟩
  intros k kN
  obtain ⟨m, v⟩ := rel with k, kN
  exact FunctionBetween.apply_value with fn, kN, m

-- Helper: the shifted sequence m ↦ f(m + n), so that f = Xⁿ · shift.
def tkJSeriesShift (R f : Set, n : Nat) : Set :=
  { u ∈ ℕ × Ring.carrier(R) | ∃ m ∈ ℕ, u = (m, f(m + n)) }

-- Helper: the indices of the nonzero coefficients of f.
def tkJSeriesSupport (R f : Set) : Set := { k ∈ ℕ | f(k) ≠ Ring.zero(R) }

-- Section: Laws of power series in one variable
section Series
variable (R : Set)
hypothesis comm : CommRing(R)

-- Helpers: the coefficientwise operations give series, with the expected
-- coefficients.
theorem tkJ.series_function (f : Set)
  requires series : f ∈ powerSeriesCarrier(R)
  shows f : ℕ → R.carrier
proof
  unfold powerSeriesCarrier at series
  exact functionSpace.mem_iff.forward with series

theorem tkJ.series_coeff_mem (f : Set) (n : Nat)
  requires series : f ∈ powerSeriesCarrier(R)
  shows f(n) ∈ R.carrier
proof
  have fF := tkJ.series_function at R, f with comm, series
  have nN : n ∈ ℕ by typecheck
  exact FunctionBetween.apply_closed with fF, nN

theorem tkJ.series_of_function (f : Set)
  requires map : f : ℕ → R.carrier
  shows f ∈ powerSeriesCarrier(R)
proof
  unfold powerSeriesCarrier
  exact functionSpace.mem_iff.backward with map

theorem tkJ.series_sum (f g : Set)
  requires first : f ∈ powerSeriesCarrier(R)
  requires second : g ∈ powerSeriesCarrier(R)
  shows seriesSum(R, f, g) ∈ powerSeriesCarrier(R) ∧
    (∀ n ∈ ℕ, seriesSum(R, f, g)(n) = call2(R.add, f(n), g(n)))
proof
  have rel : ∀ n ∈ ℕ, (n, call2(R.add, f(n), g(n))) ∈ seriesSum(R, f, g) ∧ call2(R.add, f(n), g(n)) ∈ R.carrier
    intros n hn
    have nNat := nat.omega.backward with hn
    have fn := tkJ.series_coeff_mem at R, f, n with comm, first
    have gn := tkJ.series_coeff_mem at R, g, n with comm, second
    have v : call2(R.add, f(n), g(n)) ∈ R.carrier by typecheck
    have m : (n, call2(R.add, f(n), g(n))) ∈ seriesSum(R, f, g)
      apply seriesSum.membership.backward
      refine ⟨(product.pair with hn, v), n, hn, rfl⟩
    exact ⟨m, v⟩
  have fn : seriesSum(R, f, g) : ℕ → R.carrier
    apply tkJ.uni_graph_function
    . intros u hu
      exact (seriesSum.membership.forward with hu).left
    . intros x y z hy hz
      obtain ⟨_, a, aIn, ea⟩ := seriesSum.membership.forward with hy
      obtain ⟨_, b, bIn, eb⟩ := seriesSum.membership.forward with hz
      obtain ⟨xa, ya⟩ := orderedPair.injective with ea
      obtain ⟨xb, yb⟩ := orderedPair.injective with eb
      rw [ya, yb, ← xa, ← xb]
    . intros x hx
      obtain ⟨m, v⟩ := rel with x, hx
      exact ⟨call2(R.add, f(x), g(x)), v, m⟩
  have mem := tkJ.series_of_function at R, seriesSum(R, f, g) with comm, fn
  refine ⟨mem, ?_⟩
  intros n hn
  obtain ⟨m, v⟩ := rel with n, hn
  exact FunctionBetween.apply_value with fn, hn, m

theorem tkJ.series_neg (f : Set)
  requires series : f ∈ powerSeriesCarrier(R)
  shows seriesNeg(R, f) ∈ powerSeriesCarrier(R) ∧
    (∀ n ∈ ℕ, seriesNeg(R, f)(n) = apply(R.neg, f(n)))
proof
  have rel : ∀ n ∈ ℕ, (n, apply(R.neg, f(n))) ∈ seriesNeg(R, f) ∧ apply(R.neg, f(n)) ∈ R.carrier
    intros n hn
    have nNat := nat.omega.backward with hn
    have fn := tkJ.series_coeff_mem at R, f, n with comm, series
    have v : apply(R.neg, f(n)) ∈ R.carrier by typecheck
    have m : (n, apply(R.neg, f(n))) ∈ seriesNeg(R, f)
      apply seriesNeg.membership.backward
      refine ⟨(product.pair with hn, v), n, hn, rfl⟩
    exact ⟨m, v⟩
  have fn : seriesNeg(R, f) : ℕ → R.carrier
    apply tkJ.uni_graph_function
    . intros u hu
      exact (seriesNeg.membership.forward with hu).left
    . intros x y z hy hz
      obtain ⟨_, a, aIn, ea⟩ := seriesNeg.membership.forward with hy
      obtain ⟨_, b, bIn, eb⟩ := seriesNeg.membership.forward with hz
      obtain ⟨xa, ya⟩ := orderedPair.injective with ea
      obtain ⟨xb, yb⟩ := orderedPair.injective with eb
      rw [ya, yb, ← xa, ← xb]
    . intros x hx
      obtain ⟨m, v⟩ := rel with x, hx
      exact ⟨apply(R.neg, f(x)), v, m⟩
  have mem := tkJ.series_of_function at R, seriesNeg(R, f) with comm, fn
  refine ⟨mem, ?_⟩
  intros n hn
  obtain ⟨m, v⟩ := rel with n, hn
  exact FunctionBetween.apply_value with fn, hn, m

theorem tkJ.series_add_apply (f g : Set)
  requires first : f ∈ powerSeriesCarrier(R)
  requires second : g ∈ powerSeriesCarrier(R)
  shows call2(Ring.add(powerSeriesRing(R)), f, g) = seriesSum(R, f, g)
proof
  have opEq : Ring.add(powerSeriesRing(R)) = seriesAdd(R)
    unfold powerSeriesRing
    ring_projections
  obtain ⟨sumIn, _⟩ := tkJ.series_sum at R, f, g with comm, first, second
  have fn : seriesAdd(R) : powerSeriesCarrier(R) × powerSeriesCarrier(R) → powerSeriesCarrier(R)
    apply tkJ.uni_graph_function
    . intros u hu
      exact (seriesAdd.membership.forward with hu).left
    . intros x y z hy hz
      obtain ⟨_, a, aIn, b, bIn, ea⟩ := seriesAdd.membership.forward with hy
      obtain ⟨_, c, cIn, d, dIn, eb⟩ := seriesAdd.membership.forward with hz
      obtain ⟨xa, ya⟩ := orderedPair.injective with ea
      obtain ⟨xb, yb⟩ := orderedPair.injective with eb
      have same : (a, b) = (c, d) by cc
      obtain ⟨ac, bd⟩ := orderedPair.injective with same
      rw [ya, yb, ac, bd]
    . intros x hx
      obtain ⟨_, a, aIn, b, bIn, shape⟩ := product.membership.forward with hx
      obtain ⟨s, _⟩ := tkJ.series_sum at R, a, b with comm, aIn, bIn
      have pair := product.pair with aIn, bIn
      refine ⟨seriesSum(R, a, b), s, ?_⟩
      rw shape
      apply seriesAdd.membership.backward
      refine ⟨(product.pair with pair, s), a, aIn, b, bIn, rfl⟩
  have pairIn := product.pair with first, second
  have m : ((f, g), seriesSum(R, f, g)) ∈ seriesAdd(R)
    apply seriesAdd.membership.backward
    refine ⟨(product.pair with pairIn, sumIn), f, first, g, second, rfl⟩
  rw opEq
  unfold call2
  exact FunctionBetween.apply_value with fn, pairIn, m

theorem tkJ.series_constant (a : Set)
  requires scalar : a ∈ R.carrier
  shows seriesConstant(R, a) ∈ powerSeriesCarrier(R) ∧
    seriesConstant(R, a)(0) = a ∧
    (∀ n ∈ ℕ, n ≠ 0 → seriesConstant(R, a)(n) = R.zero)
proof
  have zeroIn : R.zero ∈ R.carrier by typecheck
  have zN : (0:Nat) ∈ ℕ by typecheck
  have relZero : (0, a) ∈ seriesConstant(R, a)
    apply seriesConstant.membership.backward
    refine ⟨(product.pair with zN, scalar), 0, zN, ?_⟩
    left
    exact ⟨rfl, rfl⟩
  have relOther : ∀ n ∈ ℕ, n ≠ 0 → (n, R.zero) ∈ seriesConstant(R, a)
    intros n hn ne
    apply seriesConstant.membership.backward
    refine ⟨(product.pair with hn, zeroIn), n, hn, ?_⟩
    right
    exact ⟨ne, rfl⟩
  have fn : seriesConstant(R, a) : ℕ → R.carrier
    apply tkJ.uni_graph_function
    . intros u hu
      exact (seriesConstant.membership.forward with hu).left
    . intros x y z hy hz
      obtain ⟨_, k, kIn, ck⟩ := seriesConstant.membership.forward with hy
      obtain ⟨_, l, lIn, cl⟩ := seriesConstant.membership.forward with hz
      rcases ck with ⟨k0, ek⟩ | ⟨k0, ek⟩
      . obtain ⟨xk, yk⟩ := orderedPair.injective with ek
        rcases cl with ⟨l0, el⟩ | ⟨l0, el⟩
        . obtain ⟨xl, yl⟩ := orderedPair.injective with el
          rw [yk, yl]
        . obtain ⟨xl, yl⟩ := orderedPair.injective with el
          exfalso
          apply l0
          cc
      . obtain ⟨xk, yk⟩ := orderedPair.injective with ek
        rcases cl with ⟨l0, el⟩ | ⟨l0, el⟩
        . obtain ⟨xl, yl⟩ := orderedPair.injective with el
          exfalso
          apply k0
          cc
        . obtain ⟨xl, yl⟩ := orderedPair.injective with el
          rw [yk, yl]
    . intros x hx
      by_cases e : x = 0
      . rw e
        exact ⟨a, scalar, relZero⟩
      . exact ⟨R.zero, zeroIn, (relOther with x, hx, e)⟩
  have mem := tkJ.series_of_function at R, seriesConstant(R, a) with comm, fn
  have v0 := FunctionBetween.apply_value with fn, zN, relZero
  refine ⟨mem, v0, ?_⟩
  intros n hn ne
  exact FunctionBetween.apply_value with fn, hn, (relOther with n, hn, ne)

theorem tkJ.series_X
  shows seriesX(R) ∈ powerSeriesCarrier(R) ∧
    seriesX(R)(1) = R.one ∧
    (∀ n ∈ ℕ, n ≠ 1 → seriesX(R)(n) = R.zero)
proof
  have zeroIn : R.zero ∈ R.carrier by typecheck
  have oneIn : R.one ∈ R.carrier by typecheck
  have oN : (1:Nat) ∈ ℕ by typecheck
  have relOne : (1, R.one) ∈ seriesX(R)
    apply seriesX.membership.backward
    refine ⟨(product.pair with oN, oneIn), 1, oN, ?_⟩
    left
    exact ⟨rfl, rfl⟩
  have relOther : ∀ n ∈ ℕ, n ≠ 1 → (n, R.zero) ∈ seriesX(R)
    intros n hn ne
    apply seriesX.membership.backward
    refine ⟨(product.pair with hn, zeroIn), n, hn, ?_⟩
    right
    exact ⟨ne, rfl⟩
  have fn : seriesX(R) : ℕ → R.carrier
    apply tkJ.uni_graph_function
    . intros u hu
      exact (seriesX.membership.forward with hu).left
    . intros x y z hy hz
      obtain ⟨_, k, kIn, ck⟩ := seriesX.membership.forward with hy
      obtain ⟨_, l, lIn, cl⟩ := seriesX.membership.forward with hz
      rcases ck with ⟨k0, ek⟩ | ⟨k0, ek⟩
      . obtain ⟨xk, yk⟩ := orderedPair.injective with ek
        rcases cl with ⟨l0, el⟩ | ⟨l0, el⟩
        . obtain ⟨xl, yl⟩ := orderedPair.injective with el
          rw [yk, yl]
        . obtain ⟨xl, yl⟩ := orderedPair.injective with el
          exfalso
          apply l0
          cc
      . obtain ⟨xk, yk⟩ := orderedPair.injective with ek
        rcases cl with ⟨l0, el⟩ | ⟨l0, el⟩
        . obtain ⟨xl, yl⟩ := orderedPair.injective with el
          exfalso
          apply k0
          cc
        . obtain ⟨xl, yl⟩ := orderedPair.injective with el
          rw [yk, yl]
    . intros x hx
      by_cases e : x = 1
      . rw e
        exact ⟨R.one, oneIn, relOne⟩
      . exact ⟨R.zero, zeroIn, (relOther with x, hx, e)⟩
  have mem := tkJ.series_of_function at R, seriesX(R) with comm, fn
  have v1 := FunctionBetween.apply_value with fn, oN, relOne
  refine ⟨mem, v1, ?_⟩
  intros n hn ne
  exact FunctionBetween.apply_value with fn, hn, (relOther with n, hn, ne)

theorem tkJ.cauchy_terms (f g : Set) (n : Nat)
  requires first : f ∈ powerSeriesCarrier(R)
  requires second : g ∈ powerSeriesCarrier(R)
  shows (ringCauchyTerms(R, f, g, n) : antidiagonal(n) → R.carrier) ∧
    (∀ i ∈ ℕ, ∀ j ∈ ℕ, i + j = n →
      ringCauchyTerms(R, f, g, n)((i, j)) = call2(R.mul, f(i), g(j)))
proof
  have rel : ∀ i ∈ ℕ, ∀ j ∈ ℕ, i + j = n → ((i, j), call2(R.mul, f(i), g(j))) ∈ ringCauchyTerms(R, f, g, n) ∧ (i, j) ∈ antidiagonal(n) ∧ call2(R.mul, f(i), g(j)) ∈ R.carrier
    intros i iN j jN s
    have iNat := nat.omega.backward with iN
    have jNat := nat.omega.backward with jN
    have fi := tkJ.series_coeff_mem at R, f, i with comm, first
    have gj := tkJ.series_coeff_mem at R, g, j with comm, second
    have v : call2(R.mul, f(i), g(j)) ∈ R.carrier by typecheck
    have ad := (tkJ.antidiagonal_pair at n, i, j).backward with s
    have m : ((i, j), call2(R.mul, f(i), g(j))) ∈ ringCauchyTerms(R, f, g, n)
      apply ringCauchyTerms.membership.backward
      refine ⟨(product.pair with ad, v), i, iN, j, jN, rfl⟩
    exact ⟨m, ad, v⟩
  have fn : ringCauchyTerms(R, f, g, n) : antidiagonal(n) → R.carrier
    apply tkJ.uni_graph_function
    . intros u hu
      exact (ringCauchyTerms.membership.forward with hu).left
    . intros x y z hy hz
      obtain ⟨_, a, aIn, b, bIn, ea⟩ := ringCauchyTerms.membership.forward with hy
      obtain ⟨_, c, cIn, d, dIn, eb⟩ := ringCauchyTerms.membership.forward with hz
      obtain ⟨xa, ya⟩ := orderedPair.injective with ea
      obtain ⟨xb, yb⟩ := orderedPair.injective with eb
      have same : (a, b) = (c, d) by cc
      obtain ⟨ac, bd⟩ := orderedPair.injective with same
      rw [ya, yb, ac, bd]
    . intros x hx
      obtain ⟨_, i, iN, j, jN, e, s⟩ := antidiagonal.membership.forward with hx
      obtain ⟨m, ad, v⟩ := rel with i, iN, j, jN, s
      rw e
      exact ⟨call2(R.mul, f(i), g(j)), v, m⟩
  refine ⟨fn, ?_⟩
  intros i iN j jN s
  obtain ⟨m, ad, v⟩ := rel with i, iN, j, jN, s
  exact FunctionBetween.apply_value with fn, ad, m

theorem tkJ.cauchy_product (f g : Set)
  requires first : f ∈ powerSeriesCarrier(R)
  requires second : g ∈ powerSeriesCarrier(R)
  shows ringCauchyProduct(R, f, g) ∈ powerSeriesCarrier(R) ∧
    (∀ n ∈ ℕ, ringCauchyProduct(R, f, g)(n) = finiteRingSum(antidiagonal(n),
      R.carrier, R.add, R.zero, R.neg, R.mul, R.one, ringCauchyTerms(R, f, g, n)))
proof
  have rel : ∀ n ∈ ℕ, (n, finiteRingSum(antidiagonal(n), R.carrier, R.add, R.zero, R.neg, R.mul, R.one, ringCauchyTerms(R, f, g, n))) ∈ ringCauchyProduct(R, f, g) ∧ finiteRingSum(antidiagonal(n), R.carrier, R.add, R.zero, R.neg, R.mul, R.one, ringCauchyTerms(R, f, g, n)) ∈ R.carrier
    intros n hn
    have nNat := nat.omega.backward with hn
    obtain ⟨terms, _⟩ := tkJ.cauchy_terms at R, f, g, n with comm, first, second
    have fin := tkJ.antidiagonal_finite at n
    have parts := CommRing.parts with comm
    have v := finiteRingSum.closed with parts, fin, terms
    have m : (n, finiteRingSum(antidiagonal(n), R.carrier, R.add, R.zero, R.neg, R.mul, R.one, ringCauchyTerms(R, f, g, n))) ∈ ringCauchyProduct(R, f, g)
      apply ringCauchyProduct.membership.backward
      refine ⟨(product.pair with hn, v), n, hn, rfl⟩
    exact ⟨m, v⟩
  have fn : ringCauchyProduct(R, f, g) : ℕ → R.carrier
    apply tkJ.uni_graph_function
    . intros u hu
      exact (ringCauchyProduct.membership.forward with hu).left
    . intros x y z hy hz
      obtain ⟨_, a, aIn, ea⟩ := ringCauchyProduct.membership.forward with hy
      obtain ⟨_, b, bIn, eb⟩ := ringCauchyProduct.membership.forward with hz
      obtain ⟨xa, ya⟩ := orderedPair.injective with ea
      obtain ⟨xb, yb⟩ := orderedPair.injective with eb
      rw [ya, yb, ← xa, ← xb]
    . intros x hx
      obtain ⟨m, v⟩ := rel with x, hx
      exact ⟨finiteRingSum(antidiagonal(x), R.carrier, R.add, R.zero, R.neg, R.mul, R.one, ringCauchyTerms(R, f, g, x)), v, m⟩
  have mem := tkJ.series_of_function at R, ringCauchyProduct(R, f, g) with comm, fn
  refine ⟨mem, ?_⟩
  intros n hn
  obtain ⟨m, v⟩ := rel with n, hn
  exact FunctionBetween.apply_value with fn, hn, m

theorem tkJ.series_mul_apply (f g : Set)
  requires first : f ∈ powerSeriesCarrier(R)
  requires second : g ∈ powerSeriesCarrier(R)
  shows call2(Ring.mul(powerSeriesRing(R)), f, g) = ringCauchyProduct(R, f, g)
proof
  have opEq : Ring.mul(powerSeriesRing(R)) = seriesMul(R)
    unfold powerSeriesRing
    ring_projections
  obtain ⟨prodIn, _⟩ := tkJ.cauchy_product at R, f, g with comm, first, second
  have fn : seriesMul(R) : powerSeriesCarrier(R) × powerSeriesCarrier(R) → powerSeriesCarrier(R)
    apply tkJ.uni_graph_function
    . intros u hu
      exact (seriesMul.membership.forward with hu).left
    . intros x y z hy hz
      obtain ⟨_, a, aIn, b, bIn, ea⟩ := seriesMul.membership.forward with hy
      obtain ⟨_, c, cIn, d, dIn, eb⟩ := seriesMul.membership.forward with hz
      obtain ⟨xa, ya⟩ := orderedPair.injective with ea
      obtain ⟨xb, yb⟩ := orderedPair.injective with eb
      have same : (a, b) = (c, d) by cc
      obtain ⟨ac, bd⟩ := orderedPair.injective with same
      rw [ya, yb, ac, bd]
    . intros x hx
      obtain ⟨_, a, aIn, b, bIn, shape⟩ := product.membership.forward with hx
      obtain ⟨s, _⟩ := tkJ.cauchy_product at R, a, b with comm, aIn, bIn
      have pair := product.pair with aIn, bIn
      refine ⟨ringCauchyProduct(R, a, b), s, ?_⟩
      rw shape
      apply seriesMul.membership.backward
      refine ⟨(product.pair with pair, s), a, aIn, b, bIn, rfl⟩
  have pairIn := product.pair with first, second
  have m : ((f, g), ringCauchyProduct(R, f, g)) ∈ seriesMul(R)
    apply seriesMul.membership.backward
    refine ⟨(product.pair with pairIn, prodIn), f, first, g, second, rfl⟩
  rw opEq
  unfold call2
  exact FunctionBetween.apply_value with fn, pairIn, m

-- Truncation (PowerSeries.trunc, coeff_trunc, trunc of a polynomial).
theorem seriesTrunc.coeff (f : Set) (n k : Nat)
  requires series : f ∈ powerSeriesCarrier(R)
  shows seriesTrunc(R, f, n) ∈ Ring.carrier(polynomialRing(R, {0})) ∧
    (k < n → polyCoeff(seriesTrunc(R, f, n), k) = f(k)) ∧
    (n ≤ k → polyCoeff(seriesTrunc(R, f, n), k) = R[0])
proof
  have polys := polynomialRing.comm_ring at R, {0} with comm
  have zeroIn : R.zero ∈ R.carrier by typecheck
  have rel1 : ∀ j ∈ ℕ, j < n → ({(0, j)}, f(j)) ∈ seriesTrunc(R, f, n)
    intros j jN lt
    have jNat := nat.omega.backward with jN
    have mj := monomials.univariate at j
    have fj := tkJ.series_coeff_mem at R, f, j with comm, series
    apply seriesTrunc.membership.backward
    refine ⟨(product.pair with mj, fj), j, jN, ?_⟩
    left
    exact ⟨lt, rfl⟩
  have rel2 : ∀ j ∈ ℕ, n ≤ j → ({(0, j)}, R.zero) ∈ seriesTrunc(R, f, n)
    intros j jN le
    have jNat := nat.omega.backward with jN
    have mj := monomials.univariate at j
    apply seriesTrunc.membership.backward
    refine ⟨(product.pair with mj, zeroIn), j, jN, ?_⟩
    right
    exact ⟨le, rfl⟩
  have fn : seriesTrunc(R, f, n) : monomials({0}) → R.carrier
    apply tkJ.uni_graph_function
    . intros u hu
      exact (seriesTrunc.membership.forward with hu).left
    . intros x y z hy hz
      obtain ⟨_, a, aN, ca⟩ := seriesTrunc.membership.forward with hy
      obtain ⟨_, b, bN, cb⟩ := seriesTrunc.membership.forward with hz
      have aNat := nat.omega.backward with aN
      have bNat := nat.omega.backward with bN
      rcases ca with ⟨la, ea⟩ | ⟨la, ea⟩
      . obtain ⟨xa, ya⟩ := orderedPair.injective with ea
        rcases cb with ⟨lb, eb⟩ | ⟨lb, eb⟩
        . obtain ⟨xb, yb⟩ := orderedPair.injective with eb
          have same : {(0, a)} = {(0, b)} by cc
          have ab := uni.monomial_inj at a, b with same
          rw [ya, yb, ab]
        . obtain ⟨xb, yb⟩ := orderedPair.injective with eb
          have same : {(0, a)} = {(0, b)} by cc
          have ab := uni.monomial_inj at a, b with same
          exfalso
          arith
      . obtain ⟨xa, ya⟩ := orderedPair.injective with ea
        rcases cb with ⟨lb, eb⟩ | ⟨lb, eb⟩
        . obtain ⟨xb, yb⟩ := orderedPair.injective with eb
          have same : {(0, a)} = {(0, b)} by cc
          have ab := uni.monomial_inj at a, b with same
          exfalso
          arith
        . obtain ⟨xb, yb⟩ := orderedPair.injective with eb
          rw [ya, yb]
    . intros x hx
      obtain ⟨eNat, shape⟩ := uni.monomial_shape at x with hx
      have eN := nat.omega.forward with eNat
      have fe := tkJ.series_coeff_mem at R, f, x(0) with comm, series
      rw shape
      by_cases lt : x(0) < n
      . exact ⟨f(x(0)), fe, (rel1 with x(0), eN, lt)⟩
      . have le := LessEqual.of_not_Less at x(0), n with lt
        exact ⟨R.zero, zeroIn, (rel2 with x(0), eN, le)⟩
  obtain ⟨mapF, mapV⟩ := tkJ.monomial_of at {0}
  have nSub : n ⊆ ℕ
    intros j hj
    have jNat := natural.member at n with j, hj
    exact nat.omega.forward with jNat
  have nFin := Finite.natural at n
  have imgFin := Finite.function_image with mapF, nFin, nSub
  have supp : functionSupport(seriesTrunc(R, f, n), monomials({0}), R.zero) ⊆ functionImage(tkJMonomialOf({0}), n, monomials({0}))
    intros m hm
    obtain ⟨mIn, ne⟩ := functionSupport.membership.forward with hm
    obtain ⟨eNat, shape⟩ := uni.monomial_shape at m with mIn
    have eN := nat.omega.forward with eNat
    by_cases lt : m(0) < n
    . have mem := membership.of_Less at m(0), n with eNat
      have mn := mem with lt
      have img := functionImage.value with mapF, eN
      rw (mapV with m(0), eN) at img
      rw ← shape at img
      apply functionImage.membership.backward
      refine ⟨mIn, m(0), mn, ?_⟩
      rw (mapV with m(0), eN)
      exact shape
    . have le := LessEqual.of_not_Less at m(0), n with lt
      have r := rel2 with m(0), eN, le
      rw ← shape at r
      have v := FunctionBetween.apply_value with fn, mIn, r
      exfalso
      exact ne with v
  have suppFin := Finite.subset with imgFin, supp
  have cm : CoefficientMap(seriesTrunc(R, f, n), monomials({0}), R.carrier, R.zero)
    unfold CoefficientMap
    exact ⟨fn, suppFin⟩
  have pp := polynomials.contains with cm
  have tIn := polynomialRing.member_of_parts at R, {0}, seriesTrunc(R, f, n) with comm, polys, pp
  have kN : k ∈ ℕ by typecheck
  have mk := monomials.univariate at k
  refine ⟨tIn, ?_, ?_⟩
  . intro lt
    unfold polyCoeff
    exact FunctionBetween.apply_value with fn, mk, (rel1 with k, kN, lt)
  . intro le
    unfold polyCoeff
    exact FunctionBetween.apply_value with fn, mk, (rel2 with k, kN, le)

-- PowerSeries.ext.
theorem powerSeries.ext (f g : Set)
  requires first : f ∈ powerSeriesCarrier(R)
  requires second : g ∈ powerSeriesCarrier(R)
  requires agree : ∀ n ∈ ℕ, f(n) = g(n)
  shows f = g
proof
  have fF := tkJ.series_function at R, f with comm, first
  have gF := tkJ.series_function at R, g with comm, second
  exact FunctionBetween.ext with fF, gF, agree

-- Helpers: a coefficient of the Cauchy product is the coefficient of a
-- product of polynomials agreeing with the factors up to that degree; in
-- particular of the product of the truncations.
theorem tkJ.cauchy_poly (f g p q : Set) (n : Nat)
  requires first : f ∈ powerSeriesCarrier(R)
  requires second : g ∈ powerSeriesCarrier(R)
  requires pIn : p ∈ Ring.carrier(polynomialRing(R, {0}))
  requires qIn : q ∈ Ring.carrier(polynomialRing(R, {0}))
  requires agreeP : ∀ i ∈ ℕ, i ≤ n → polyCoeff(p, i) = f(i)
  requires agreeQ : ∀ i ∈ ℕ, i ≤ n → polyCoeff(q, i) = g(i)
  shows ringCauchyProduct(R, f, g)(n) =
    polyCoeff(call2(Ring.mul(polynomialRing(R, {0})), p, q), n)
proof
  have polys := polynomialRing.comm_ring at R, {0} with comm
  have parts := CommRing.parts with comm
  have nN : n ∈ ℕ by typecheck
  obtain ⟨_, values⟩ := tkJ.cauchy_product at R, f, g with comm, first, second
  obtain ⟨termsF, termsV⟩ := tkJ.cauchy_terms at R, f, g, n with comm, first, second
  obtain ⟨polyF, polyV⟩ := tkJ.product_terms at R, p, q, n with comm, polys, pIn, qIn
  have adFin := tkJ.antidiagonal_finite at n
  have product := polyCoeff.mul at R, p, q, n with comm, polys, pIn, qIn
  have same : ∀ x ∈ antidiagonal(n), ringCauchyTerms(R, f, g, n)(x) = polyProductTerms(R, p, q, n)(x)
    intros x hx
    obtain ⟨_, i, iN, j, jN, e, s⟩ := antidiagonal.membership.forward with hx
    have iNat := nat.omega.backward with iN
    have jNat := nat.omega.backward with jN
    have il : i ≤ n by arith
    have jl : j ≤ n by arith
    have pi := agreeP with i, iN, il
    have qj := agreeQ with j, jN, jl
    unfold polyCoeff at pi
    unfold polyCoeff at qj
    rw e
    rw [(termsV with i, iN, j, jN, s), (polyV with i, iN, j, jN, s), pi, qj]
  have congr := finiteRingSum.congr with parts, adFin, termsF, polyF, same
  rw [(values with n, nN), congr, product]

theorem tkJ.trunc_agree (f : Set) (n : Nat)
  requires series : f ∈ powerSeriesCarrier(R)
  shows seriesTrunc(R, f, succ(n)) ∈ Ring.carrier(polynomialRing(R, {0})) ∧
    (∀ i ∈ ℕ, i ≤ n → polyCoeff(seriesTrunc(R, f, succ(n)), i) = f(i))
proof
  have mem := (seriesTrunc.coeff at R, f, succ(n), 0 with comm, series).left
  refine ⟨mem, ?_⟩
  intros i iN le
  have iNat := nat.omega.backward with iN
  have lt : i < succ(n) by arith
  have c := seriesTrunc.coeff at R, f, succ(n), i with comm, series
  obtain ⟨_, below, _⟩ := c
  exact below with lt

theorem tkJ.cauchy_trunc (f g : Set) (n : Nat)
  requires first : f ∈ powerSeriesCarrier(R)
  requires second : g ∈ powerSeriesCarrier(R)
  shows call2(Ring.mul(polynomialRing(R, {0})), seriesTrunc(R, f, succ(n)),
      seriesTrunc(R, g, succ(n))) ∈ Ring.carrier(polynomialRing(R, {0})) ∧
    (∀ i ∈ ℕ, i ≤ n → polyCoeff(call2(Ring.mul(polynomialRing(R, {0})),
      seriesTrunc(R, f, succ(n)), seriesTrunc(R, g, succ(n))), i) =
      ringCauchyProduct(R, f, g)(i))
proof
  have polys := polynomialRing.comm_ring at R, {0} with comm
  obtain ⟨tf, af⟩ := tkJ.trunc_agree at R, f, n with comm, first
  obtain ⟨tg, ag⟩ := tkJ.trunc_agree at R, g, n with comm, second
  have mem : call2(Ring.mul(polynomialRing(R, {0})), seriesTrunc(R, f, succ(n)), seriesTrunc(R, g, succ(n))) ∈ Ring.carrier(polynomialRing(R, {0})) by typecheck
  refine ⟨mem, ?_⟩
  intros i iN le
  have iNat := nat.omega.backward with iN
  have agreeP : ∀ j ∈ ℕ, j ≤ i → polyCoeff(seriesTrunc(R, f, succ(n)), j) = f(j)
    intros j jN lj
    have jNat := nat.omega.backward with jN
    have ln : j ≤ n by arith
    exact af with j, jN, ln
  have agreeQ : ∀ j ∈ ℕ, j ≤ i → polyCoeff(seriesTrunc(R, g, succ(n)), j) = g(j)
    intros j jN lj
    have jNat := nat.omega.backward with jN
    have ln : j ≤ n by arith
    exact ag with j, jN, ln
  have c := tkJ.cauchy_poly at R, f, g, seriesTrunc(R, f, succ(n)), seriesTrunc(R, g, succ(n)), i with comm, first, second, tf, tg, agreeP, agreeQ
  rw c

-- Helpers: the Cauchy product is associative, commutative, distributive,
-- and has the constant one as unit.
theorem tkJ.cauchy_assoc (f g h : Set)
  requires first : f ∈ powerSeriesCarrier(R)
  requires second : g ∈ powerSeriesCarrier(R)
  requires third : h ∈ powerSeriesCarrier(R)
  shows ringCauchyProduct(R, ringCauchyProduct(R, f, g), h) =
    ringCauchyProduct(R, f, ringCauchyProduct(R, g, h))
proof
  have polys := polynomialRing.comm_ring at R, {0} with comm
  obtain ⟨fg, _⟩ := tkJ.cauchy_product at R, f, g with comm, first, second
  obtain ⟨gh, _⟩ := tkJ.cauchy_product at R, g, h with comm, second, third
  obtain ⟨left, _⟩ := tkJ.cauchy_product at R, ringCauchyProduct(R, f, g), h with comm, fg, third
  obtain ⟨right, _⟩ := tkJ.cauchy_product at R, f, ringCauchyProduct(R, g, h) with comm, first, gh
  have lF := tkJ.series_function at R, ringCauchyProduct(R, ringCauchyProduct(R, f, g), h) with comm, left
  have rF := tkJ.series_function at R, ringCauchyProduct(R, f, ringCauchyProduct(R, g, h)) with comm, right
  apply FunctionBetween.ext with lF, rF
  intros n nN
  have nNat := nat.omega.backward with nN
  obtain ⟨tf, af⟩ := tkJ.trunc_agree at R, f, n with comm, first
  obtain ⟨tg, ag⟩ := tkJ.trunc_agree at R, g, n with comm, second
  obtain ⟨th, ah⟩ := tkJ.trunc_agree at R, h, n with comm, third
  obtain ⟨tfg, afg⟩ := tkJ.cauchy_trunc at R, f, g, n with comm, first, second
  obtain ⟨tgh, agh⟩ := tkJ.cauchy_trunc at R, g, h, n with comm, second, third
  have l := tkJ.cauchy_poly at R, ringCauchyProduct(R, f, g), h, call2(Ring.mul(polynomialRing(R, {0})), seriesTrunc(R, f, succ(n)), seriesTrunc(R, g, succ(n))), seriesTrunc(R, h, succ(n)), n with comm, fg, third, tfg, th, afg, ah
  have r := tkJ.cauchy_poly at R, f, ringCauchyProduct(R, g, h), seriesTrunc(R, f, succ(n)), call2(Ring.mul(polynomialRing(R, {0})), seriesTrunc(R, g, succ(n)), seriesTrunc(R, h, succ(n))), n with comm, first, gh, tf, tgh, af, agh
  have assoc : call2(Ring.mul(polynomialRing(R, {0})), call2(Ring.mul(polynomialRing(R, {0})), seriesTrunc(R, f, succ(n)), seriesTrunc(R, g, succ(n))), seriesTrunc(R, h, succ(n))) = call2(Ring.mul(polynomialRing(R, {0})), seriesTrunc(R, f, succ(n)), call2(Ring.mul(polynomialRing(R, {0})), seriesTrunc(R, g, succ(n)), seriesTrunc(R, h, succ(n))))
    ring
  rw [l, r, assoc]

theorem tkJ.cauchy_comm (f g : Set)
  requires first : f ∈ powerSeriesCarrier(R)
  requires second : g ∈ powerSeriesCarrier(R)
  shows ringCauchyProduct(R, f, g) = ringCauchyProduct(R, g, f)
proof
  have polys := polynomialRing.comm_ring at R, {0} with comm
  obtain ⟨left, _⟩ := tkJ.cauchy_product at R, f, g with comm, first, second
  obtain ⟨right, _⟩ := tkJ.cauchy_product at R, g, f with comm, second, first
  have lF := tkJ.series_function at R, ringCauchyProduct(R, f, g) with comm, left
  have rF := tkJ.series_function at R, ringCauchyProduct(R, g, f) with comm, right
  apply FunctionBetween.ext with lF, rF
  intros n nN
  have nNat := nat.omega.backward with nN
  obtain ⟨tf, af⟩ := tkJ.trunc_agree at R, f, n with comm, first
  obtain ⟨tg, ag⟩ := tkJ.trunc_agree at R, g, n with comm, second
  have l := tkJ.cauchy_poly at R, f, g, seriesTrunc(R, f, succ(n)), seriesTrunc(R, g, succ(n)), n with comm, first, second, tf, tg, af, ag
  have r := tkJ.cauchy_poly at R, g, f, seriesTrunc(R, g, succ(n)), seriesTrunc(R, f, succ(n)), n with comm, second, first, tg, tf, ag, af
  have c : call2(Ring.mul(polynomialRing(R, {0})), seriesTrunc(R, f, succ(n)), seriesTrunc(R, g, succ(n))) = call2(Ring.mul(polynomialRing(R, {0})), seriesTrunc(R, g, succ(n)), seriesTrunc(R, f, succ(n)))
    ring
  rw [l, r, c]

theorem tkJ.cauchy_distrib (f g h : Set)
  requires first : f ∈ powerSeriesCarrier(R)
  requires second : g ∈ powerSeriesCarrier(R)
  requires third : h ∈ powerSeriesCarrier(R)
  shows ringCauchyProduct(R, f, seriesSum(R, g, h)) =
    seriesSum(R, ringCauchyProduct(R, f, g), ringCauchyProduct(R, f, h))
proof
  have polys := polynomialRing.comm_ring at R, {0} with comm
  obtain ⟨ghIn, ghV⟩ := tkJ.series_sum at R, g, h with comm, second, third
  obtain ⟨fg, fgV⟩ := tkJ.cauchy_product at R, f, g with comm, first, second
  obtain ⟨fh, fhV⟩ := tkJ.cauchy_product at R, f, h with comm, first, third
  obtain ⟨left, _⟩ := tkJ.cauchy_product at R, f, seriesSum(R, g, h) with comm, first, ghIn
  obtain ⟨right, rightV⟩ := tkJ.series_sum at R, ringCauchyProduct(R, f, g), ringCauchyProduct(R, f, h) with comm, fg, fh
  have lF := tkJ.series_function at R, ringCauchyProduct(R, f, seriesSum(R, g, h)) with comm, left
  have rF := tkJ.series_function at R, seriesSum(R, ringCauchyProduct(R, f, g), ringCauchyProduct(R, f, h)) with comm, right
  apply FunctionBetween.ext with lF, rF
  intros n nN
  have nNat := nat.omega.backward with nN
  obtain ⟨tf, af⟩ := tkJ.trunc_agree at R, f, n with comm, first
  obtain ⟨tg, ag⟩ := tkJ.trunc_agree at R, g, n with comm, second
  obtain ⟨th, ah⟩ := tkJ.trunc_agree at R, h, n with comm, third
  have tgh : call2(Ring.add(polynomialRing(R, {0})), seriesTrunc(R, g, succ(n)), seriesTrunc(R, h, succ(n))) ∈ Ring.carrier(polynomialRing(R, {0})) by typecheck
  have agh : ∀ i ∈ ℕ, i ≤ n → polyCoeff(call2(Ring.add(polynomialRing(R, {0})), seriesTrunc(R, g, succ(n)), seriesTrunc(R, h, succ(n))), i) = seriesSum(R, g, h)(i)
    intros i iN le
    have iNat := nat.omega.backward with iN
    rw (polyCoeff.add at R, seriesTrunc(R, g, succ(n)), seriesTrunc(R, h, succ(n)), i with comm, polys, tg, th)
    rw [(ag with i, iN, le), (ah with i, iN, le), (ghV with i, iN)]
  have l := tkJ.cauchy_poly at R, f, seriesSum(R, g, h), seriesTrunc(R, f, succ(n)), call2(Ring.add(polynomialRing(R, {0})), seriesTrunc(R, g, succ(n)), seriesTrunc(R, h, succ(n))), n with comm, first, ghIn, tf, tgh, af, agh
  have l1 := tkJ.cauchy_poly at R, f, g, seriesTrunc(R, f, succ(n)), seriesTrunc(R, g, succ(n)), n with comm, first, second, tf, tg, af, ag
  have l2 := tkJ.cauchy_poly at R, f, h, seriesTrunc(R, f, succ(n)), seriesTrunc(R, h, succ(n)), n with comm, first, third, tf, th, af, ah
  have p1 : call2(Ring.mul(polynomialRing(R, {0})), seriesTrunc(R, f, succ(n)), seriesTrunc(R, g, succ(n))) ∈ Ring.carrier(polynomialRing(R, {0})) by typecheck
  have p2 : call2(Ring.mul(polynomialRing(R, {0})), seriesTrunc(R, f, succ(n)), seriesTrunc(R, h, succ(n))) ∈ Ring.carrier(polynomialRing(R, {0})) by typecheck
  have d : call2(Ring.mul(polynomialRing(R, {0})), seriesTrunc(R, f, succ(n)), call2(Ring.add(polynomialRing(R, {0})), seriesTrunc(R, g, succ(n)), seriesTrunc(R, h, succ(n)))) = call2(Ring.add(polynomialRing(R, {0})), call2(Ring.mul(polynomialRing(R, {0})), seriesTrunc(R, f, succ(n)), seriesTrunc(R, g, succ(n))), call2(Ring.mul(polynomialRing(R, {0})), seriesTrunc(R, f, succ(n)), seriesTrunc(R, h, succ(n))))
    ring
  have sumC := polyCoeff.add at R, call2(Ring.mul(polynomialRing(R, {0})), seriesTrunc(R, f, succ(n)), seriesTrunc(R, g, succ(n))), call2(Ring.mul(polynomialRing(R, {0})), seriesTrunc(R, f, succ(n)), seriesTrunc(R, h, succ(n))), n with comm, polys, p1, p2
  rw [l, d, sumC, (rightV with n, nN), l1, l2]

theorem tkJ.cauchy_C_mul (a f : Set) (n : Nat)
  requires scalar : a ∈ R.carrier
  requires series : f ∈ powerSeriesCarrier(R)
  shows ringCauchyProduct(R, seriesConstant(R, a), f)(n) = call2(R.mul, a, f(n))
proof
  have polys := polynomialRing.comm_ring at R, {0} with comm
  obtain ⟨cIn, c0, cn⟩ := tkJ.series_constant at R, a with comm, scalar
  obtain ⟨tf, af⟩ := tkJ.trunc_agree at R, f, n with comm, series
  have pc := polyC.mem at R, a with comm, polys, scalar
  have agreeC : ∀ i ∈ ℕ, i ≤ n → polyCoeff(polyC(R, a), i) = seriesConstant(R, a)(i)
    intros i iN le
    have iNat := nat.omega.backward with iN
    obtain ⟨z, nz⟩ := polyC.coeff at R, a, i with comm, polys, scalar
    by_cases e : i = 0
    . rw [(z with e), e, c0]
    . rw [(nz with e), (cn with i, iN, e)]
  have l := tkJ.cauchy_poly at R, seriesConstant(R, a), f, polyC(R, a), seriesTrunc(R, f, succ(n)), n with comm, cIn, series, pc, tf, agreeC, af
  have nN : n ∈ ℕ by typecheck
  have le : n ≤ n by arith
  rw [l, (polyCoeff.C_mul at R, a, seriesTrunc(R, f, succ(n)), n with comm, polys, scalar, tf), (af with n, nN, le)]

-- Helpers: the operations of R[[X]] as maps on series.
theorem tkJ.series_ops
  shows (seriesAdd(R) : powerSeriesCarrier(R) × powerSeriesCarrier(R) → powerSeriesCarrier(R)) ∧
    (seriesMul(R) : powerSeriesCarrier(R) × powerSeriesCarrier(R) → powerSeriesCarrier(R)) ∧
    (seriesNegation(R) : powerSeriesCarrier(R) → powerSeriesCarrier(R)) ∧
    (∀ f ∈ powerSeriesCarrier(R), seriesNegation(R)(f) = seriesNeg(R, f))
proof
  have addF : seriesAdd(R) : powerSeriesCarrier(R) × powerSeriesCarrier(R) → powerSeriesCarrier(R)
    apply tkJ.uni_graph_function
    . intros u hu
      exact (seriesAdd.membership.forward with hu).left
    . intros x y z hy hz
      obtain ⟨_, a, aIn, b, bIn, ea⟩ := seriesAdd.membership.forward with hy
      obtain ⟨_, c, cIn, d, dIn, eb⟩ := seriesAdd.membership.forward with hz
      obtain ⟨xa, ya⟩ := orderedPair.injective with ea
      obtain ⟨xb, yb⟩ := orderedPair.injective with eb
      have same : (a, b) = (c, d) by cc
      obtain ⟨ac, bd⟩ := orderedPair.injective with same
      rw [ya, yb, ac, bd]
    . intros x hx
      obtain ⟨_, a, aIn, b, bIn, shape⟩ := product.membership.forward with hx
      obtain ⟨s, _⟩ := tkJ.series_sum at R, a, b with comm, aIn, bIn
      have pair := product.pair with aIn, bIn
      refine ⟨seriesSum(R, a, b), s, ?_⟩
      rw shape
      apply seriesAdd.membership.backward
      refine ⟨(product.pair with pair, s), a, aIn, b, bIn, rfl⟩
  have mulF : seriesMul(R) : powerSeriesCarrier(R) × powerSeriesCarrier(R) → powerSeriesCarrier(R)
    apply tkJ.uni_graph_function
    . intros u hu
      exact (seriesMul.membership.forward with hu).left
    . intros x y z hy hz
      obtain ⟨_, a, aIn, b, bIn, ea⟩ := seriesMul.membership.forward with hy
      obtain ⟨_, c, cIn, d, dIn, eb⟩ := seriesMul.membership.forward with hz
      obtain ⟨xa, ya⟩ := orderedPair.injective with ea
      obtain ⟨xb, yb⟩ := orderedPair.injective with eb
      have same : (a, b) = (c, d) by cc
      obtain ⟨ac, bd⟩ := orderedPair.injective with same
      rw [ya, yb, ac, bd]
    . intros x hx
      obtain ⟨_, a, aIn, b, bIn, shape⟩ := product.membership.forward with hx
      obtain ⟨s, _⟩ := tkJ.cauchy_product at R, a, b with comm, aIn, bIn
      have pair := product.pair with aIn, bIn
      refine ⟨ringCauchyProduct(R, a, b), s, ?_⟩
      rw shape
      apply seriesMul.membership.backward
      refine ⟨(product.pair with pair, s), a, aIn, b, bIn, rfl⟩
  have rel : ∀ f ∈ powerSeriesCarrier(R), (f, seriesNeg(R, f)) ∈ seriesNegation(R) ∧ seriesNeg(R, f) ∈ powerSeriesCarrier(R)
    intros f hf
    obtain ⟨s, _⟩ := tkJ.series_neg at R, f with comm, hf
    have m : (f, seriesNeg(R, f)) ∈ seriesNegation(R)
      apply seriesNegation.membership.backward
      refine ⟨(product.pair with hf, s), f, hf, rfl⟩
    exact ⟨m, s⟩
  have negF : seriesNegation(R) : powerSeriesCarrier(R) → powerSeriesCarrier(R)
    apply tkJ.uni_graph_function
    . intros u hu
      exact (seriesNegation.membership.forward with hu).left
    . intros x y z hy hz
      obtain ⟨_, a, aIn, ea⟩ := seriesNegation.membership.forward with hy
      obtain ⟨_, b, bIn, eb⟩ := seriesNegation.membership.forward with hz
      obtain ⟨xa, ya⟩ := orderedPair.injective with ea
      obtain ⟨xb, yb⟩ := orderedPair.injective with eb
      rw [ya, yb, ← xa, ← xb]
    . intros x hx
      obtain ⟨m, s⟩ := rel with x, hx
      exact ⟨seriesNeg(R, x), s, m⟩
  refine ⟨addF, mulF, negF, ?_⟩
  intros f hf
  obtain ⟨m, s⟩ := rel with f, hf
  exact FunctionBetween.apply_value with negF, hf, m

theorem tkJ.series_is_comm_ring
  shows IsCommRing(powerSeriesCarrier(R), seriesAdd(R), constantFunction(ℕ, R.carrier, R.zero), seriesNegation(R), seriesMul(R), seriesConstant(R, R.one))
proof
  obtain ⟨addF, mulF, negF, negV⟩ := tkJ.series_ops at R with comm
  have addOp : Ring.add(powerSeriesRing(R)) = seriesAdd(R)
    unfold powerSeriesRing
    ring_projections
  have mulOp : Ring.mul(powerSeriesRing(R)) = seriesMul(R)
    unfold powerSeriesRing
    ring_projections
  have addEq : ∀ f ∈ powerSeriesCarrier(R), ∀ g ∈ powerSeriesCarrier(R), call2(seriesAdd(R), f, g) = seriesSum(R, f, g)
    intros f hf g hg
    have e := tkJ.series_add_apply at R, f, g with comm, hf, hg
    rw addOp at e
    exact e
  have mulEq : ∀ f ∈ powerSeriesCarrier(R), ∀ g ∈ powerSeriesCarrier(R), call2(seriesMul(R), f, g) = ringCauchyProduct(R, f, g)
    intros f hf g hg
    have e := tkJ.series_mul_apply at R, f, g with comm, hf, hg
    rw mulOp at e
    exact e
  have zeroIn : R.zero ∈ R.carrier by typecheck
  have oneIn : R.one ∈ R.carrier by typecheck
  have zIn : constantFunction(ℕ, R.carrier, R.zero) ∈ powerSeriesCarrier(R)
    unfold powerSeriesCarrier
    exact functionSpace.constant with zeroIn
  have zV : ∀ n ∈ ℕ, constantFunction(ℕ, R.carrier, R.zero)(n) = R.zero
    intros n hn
    exact constantFunction.apply with hn, zeroIn
  obtain ⟨oIn, _, _⟩ := tkJ.series_constant at R, R.one with comm, oneIn
  have addAssoc : Associative(powerSeriesCarrier(R), seriesAdd(R))
    unfold Associative
    intros x hx y hy z hz
    obtain ⟨xy, xyV⟩ := tkJ.series_sum at R, x, y with comm, hx, hy
    obtain ⟨yz, yzV⟩ := tkJ.series_sum at R, y, z with comm, hy, hz
    obtain ⟨l, lV⟩ := tkJ.series_sum at R, seriesSum(R, x, y), z with comm, xy, hz
    obtain ⟨r, rV⟩ := tkJ.series_sum at R, x, seriesSum(R, y, z) with comm, hx, yz
    rw [(addEq with x, hx, y, hy), (addEq with y, hy, z, hz), (addEq with seriesSum(R, x, y), xy, z, hz), (addEq with x, hx, seriesSum(R, y, z), yz)]
    apply powerSeries.ext at R, seriesSum(R, seriesSum(R, x, y), z), seriesSum(R, x, seriesSum(R, y, z)) with comm, l, r
    intros n nN
    have nNat := nat.omega.backward with nN
    have xn := tkJ.series_coeff_mem at R, x, n with comm, hx
    have yn := tkJ.series_coeff_mem at R, y, n with comm, hy
    have zn := tkJ.series_coeff_mem at R, z, n with comm, hz
    rw [(lV with n, nN), (rV with n, nN), (xyV with n, nN), (yzV with n, nN)]
    ring
  have addComm : Commutative(powerSeriesCarrier(R), seriesAdd(R))
    unfold Commutative
    intros x hx y hy
    obtain ⟨l, lV⟩ := tkJ.series_sum at R, x, y with comm, hx, hy
    obtain ⟨r, rV⟩ := tkJ.series_sum at R, y, x with comm, hy, hx
    rw [(addEq with x, hx, y, hy), (addEq with y, hy, x, hx)]
    apply powerSeries.ext at R, seriesSum(R, x, y), seriesSum(R, y, x) with comm, l, r
    intros n nN
    have nNat := nat.omega.backward with nN
    have xn := tkJ.series_coeff_mem at R, x, n with comm, hx
    have yn := tkJ.series_coeff_mem at R, y, n with comm, hy
    rw [(lV with n, nN), (rV with n, nN)]
    ring
  have addId : Identity(powerSeriesCarrier(R), seriesAdd(R), constantFunction(ℕ, R.carrier, R.zero))
    unfold Identity
    refine ⟨zIn, ?_⟩
    intros x hx
    obtain ⟨l, lV⟩ := tkJ.series_sum at R, constantFunction(ℕ, R.carrier, R.zero), x with comm, zIn, hx
    obtain ⟨r, rV⟩ := tkJ.series_sum at R, x, constantFunction(ℕ, R.carrier, R.zero) with comm, hx, zIn
    rw [(addEq with constantFunction(ℕ, R.carrier, R.zero), zIn, x, hx), (addEq with x, hx, constantFunction(ℕ, R.carrier, R.zero), zIn)]
    constructor
    . apply powerSeries.ext at R, seriesSum(R, constantFunction(ℕ, R.carrier, R.zero), x), x with comm, l, hx
      intros n nN
      have nNat := nat.omega.backward with nN
      have xn := tkJ.series_coeff_mem at R, x, n with comm, hx
      rw [(lV with n, nN), (zV with n, nN)]
      ring
    . apply powerSeries.ext at R, seriesSum(R, x, constantFunction(ℕ, R.carrier, R.zero)), x with comm, r, hx
      intros n nN
      have nNat := nat.omega.backward with nN
      have xn := tkJ.series_coeff_mem at R, x, n with comm, hx
      rw [(rV with n, nN), (zV with n, nN)]
      ring
  have addInv : Inverse(powerSeriesCarrier(R), seriesAdd(R), constantFunction(ℕ, R.carrier, R.zero), seriesNegation(R))
    unfold Inverse
    refine ⟨negF, ?_⟩
    intros x hx
    obtain ⟨nx, nxV⟩ := tkJ.series_neg at R, x with comm, hx
    obtain ⟨l, lV⟩ := tkJ.series_sum at R, seriesNeg(R, x), x with comm, nx, hx
    obtain ⟨r, rV⟩ := tkJ.series_sum at R, x, seriesNeg(R, x) with comm, hx, nx
    rw [(negV with x, hx), (addEq with seriesNeg(R, x), nx, x, hx), (addEq with x, hx, seriesNeg(R, x), nx)]
    constructor
    . apply powerSeries.ext at R, seriesSum(R, seriesNeg(R, x), x), constantFunction(ℕ, R.carrier, R.zero) with comm, l, zIn
      intros n nN
      have nNat := nat.omega.backward with nN
      have xn := tkJ.series_coeff_mem at R, x, n with comm, hx
      rw [(lV with n, nN), (zV with n, nN), (nxV with n, nN)]
      ring
    . apply powerSeries.ext at R, seriesSum(R, x, seriesNeg(R, x)), constantFunction(ℕ, R.carrier, R.zero) with comm, r, zIn
      intros n nN
      have nNat := nat.omega.backward with nN
      have xn := tkJ.series_coeff_mem at R, x, n with comm, hx
      rw [(rV with n, nN), (zV with n, nN), (nxV with n, nN)]
      ring
  have mulAssoc : Associative(powerSeriesCarrier(R), seriesMul(R))
    unfold Associative
    intros x hx y hy z hz
    obtain ⟨xy, _⟩ := tkJ.cauchy_product at R, x, y with comm, hx, hy
    obtain ⟨yz, _⟩ := tkJ.cauchy_product at R, y, z with comm, hy, hz
    rw [(mulEq with x, hx, y, hy), (mulEq with y, hy, z, hz), (mulEq with ringCauchyProduct(R, x, y), xy, z, hz), (mulEq with x, hx, ringCauchyProduct(R, y, z), yz)]
    exact tkJ.cauchy_assoc at R, x, y, z with comm, hx, hy, hz
  have mulComm : Commutative(powerSeriesCarrier(R), seriesMul(R))
    unfold Commutative
    intros x hx y hy
    rw [(mulEq with x, hx, y, hy), (mulEq with y, hy, x, hx)]
    exact tkJ.cauchy_comm at R, x, y with comm, hx, hy
  have mulId : Identity(powerSeriesCarrier(R), seriesMul(R), seriesConstant(R, R.one))
    unfold Identity
    refine ⟨oIn, ?_⟩
    intros x hx
    obtain ⟨l, _⟩ := tkJ.cauchy_product at R, seriesConstant(R, R.one), x with comm, oIn, hx
    have left : ringCauchyProduct(R, seriesConstant(R, R.one), x) = x
      apply powerSeries.ext at R, ringCauchyProduct(R, seriesConstant(R, R.one), x), x with comm, l, hx
      intros n nN
      have nNat := nat.omega.backward with nN
      have xn := tkJ.series_coeff_mem at R, x, n with comm, hx
      rw (tkJ.cauchy_C_mul at R, R.one, x, n with comm, oneIn, hx)
      ring
    have c := tkJ.cauchy_comm at R, x, seriesConstant(R, R.one) with comm, hx, oIn
    rw [(mulEq with seriesConstant(R, R.one), oIn, x, hx), (mulEq with x, hx, seriesConstant(R, R.one), oIn), c, left]
    exact ⟨rfl, rfl⟩
  have distrib : Distributive(powerSeriesCarrier(R), seriesAdd(R), seriesMul(R))
    unfold Distributive
    intros x hx y hy z hz
    obtain ⟨yz, _⟩ := tkJ.series_sum at R, y, z with comm, hy, hz
    obtain ⟨xy, _⟩ := tkJ.series_sum at R, x, y with comm, hx, hy
    obtain ⟨xyP, _⟩ := tkJ.cauchy_product at R, x, y with comm, hx, hy
    obtain ⟨xzP, _⟩ := tkJ.cauchy_product at R, x, z with comm, hx, hz
    obtain ⟨yzP, _⟩ := tkJ.cauchy_product at R, y, z with comm, hy, hz
    obtain ⟨zxP, _⟩ := tkJ.cauchy_product at R, z, x with comm, hz, hx
    obtain ⟨zyP, _⟩ := tkJ.cauchy_product at R, z, y with comm, hz, hy
    rw [(addEq with y, hy, z, hz), (addEq with x, hx, y, hy), (mulEq with x, hx, seriesSum(R, y, z), yz), (mulEq with x, hx, y, hy), (mulEq with x, hx, z, hz), (mulEq with seriesSum(R, x, y), xy, z, hz), (mulEq with y, hy, z, hz), (addEq with ringCauchyProduct(R, x, y), xyP, ringCauchyProduct(R, x, z), xzP), (addEq with ringCauchyProduct(R, x, z), xzP, ringCauchyProduct(R, y, z), yzP)]
    constructor
    . exact tkJ.cauchy_distrib at R, x, y, z with comm, hx, hy, hz
    . have d := tkJ.cauchy_distrib at R, z, x, y with comm, hz, hx, hy
      rw [(tkJ.cauchy_comm at R, seriesSum(R, x, y), z with comm, xy, hz), d, (tkJ.cauchy_comm at R, z, x with comm, hz, hx), (tkJ.cauchy_comm at R, z, y with comm, hz, hy)]
  unfold IsCommRing
  unfold IsRing
  unfold IsAbelianGroup
  unfold IsGroup
  unfold IsMonoid
  unfold IsSemigroup
  unfold IsMagma
  exact ⟨⟨⟨⟨⟨⟨addF, addAssoc⟩, addId⟩, addInv⟩, addComm⟩, ⟨⟨⟨mulF, mulAssoc⟩, mulId⟩, distrib⟩⟩, mulComm⟩

theorem powerSeriesRing.comm_ring
  shows CommRing(powerSeriesRing(R))
proof
  have parts := tkJ.series_is_comm_ring at R with comm
  unfold powerSeriesRing
  exact CommRing.of_parts with parts

-- Helpers: the projections of R[[X]], and polynomials as sequences.
theorem tkJ.series_projections
  shows Ring.carrier(powerSeriesRing(R)) = powerSeriesCarrier(R) ∧
    Ring.add(powerSeriesRing(R)) = seriesAdd(R) ∧
    Ring.zero(powerSeriesRing(R)) = constantFunction(ℕ, R.carrier, R.zero) ∧
    Ring.neg(powerSeriesRing(R)) = seriesNegation(R) ∧
    Ring.mul(powerSeriesRing(R)) = seriesMul(R) ∧
    Ring.one(powerSeriesRing(R)) = seriesConstant(R, R.one)
proof
  unfold powerSeriesRing
  ring_projections

theorem tkJ.poly_sequence (p : Set)
  requires member : p ∈ Ring.carrier(polynomialRing(R, {0}))
  shows polySequence(R, p) ∈ powerSeriesCarrier(R) ∧
    (∀ n ∈ ℕ, polySequence(R, p)(n) = polyCoeff(p, n))
proof
  have rel : ∀ n ∈ ℕ, (n, p({(0, n)})) ∈ polySequence(R, p) ∧ p({(0, n)}) ∈ R.carrier
    intros n hn
    have nNat := nat.omega.backward with hn
    have v := uni.coeff_mem at R, p, n with comm, member
    unfold polyCoeff at v
    have m : (n, p({(0, n)})) ∈ polySequence(R, p)
      apply polySequence.membership.backward
      refine ⟨(product.pair with hn, v), n, hn, rfl⟩
    exact ⟨m, v⟩
  have fn : polySequence(R, p) : ℕ → R.carrier
    apply tkJ.uni_graph_function
    . intros u hu
      exact (polySequence.membership.forward with hu).left
    . intros x y z hy hz
      obtain ⟨_, a, aIn, ea⟩ := polySequence.membership.forward with hy
      obtain ⟨_, b, bIn, eb⟩ := polySequence.membership.forward with hz
      obtain ⟨xa, ya⟩ := orderedPair.injective with ea
      obtain ⟨xb, yb⟩ := orderedPair.injective with eb
      rw [ya, yb, ← xa, ← xb]
    . intros x hx
      obtain ⟨m, v⟩ := rel with x, hx
      exact ⟨p({(0, x)}), v, m⟩
  have mem := tkJ.series_of_function at R, polySequence(R, p) with comm, fn
  refine ⟨mem, ?_⟩
  intros n hn
  obtain ⟨m, v⟩ := rel with n, hn
  unfold polyCoeff
  exact FunctionBetween.apply_value with fn, hn, m

theorem tkJ.poly_to_series
  shows (polynomialToSeries(R) : Ring.carrier(polynomialRing(R, {0})) → powerSeriesCarrier(R)) ∧
    (∀ p ∈ Ring.carrier(polynomialRing(R, {0})), polynomialToSeries(R)(p) = polySequence(R, p))
proof
  have rel : ∀ p ∈ Ring.carrier(polynomialRing(R, {0})), (p, polySequence(R, p)) ∈ polynomialToSeries(R) ∧ polySequence(R, p) ∈ powerSeriesCarrier(R)
    intros p hp
    obtain ⟨s, _⟩ := tkJ.poly_sequence at R, p with comm, hp
    have m : (p, polySequence(R, p)) ∈ polynomialToSeries(R)
      apply polynomialToSeries.membership.backward
      refine ⟨(product.pair with hp, s), p, hp, rfl⟩
    exact ⟨m, s⟩
  have fn : polynomialToSeries(R) : Ring.carrier(polynomialRing(R, {0})) → powerSeriesCarrier(R)
    apply tkJ.uni_graph_function
    . intros u hu
      exact (polynomialToSeries.membership.forward with hu).left
    . intros x y z hy hz
      obtain ⟨_, a, aIn, ea⟩ := polynomialToSeries.membership.forward with hy
      obtain ⟨_, b, bIn, eb⟩ := polynomialToSeries.membership.forward with hz
      obtain ⟨xa, ya⟩ := orderedPair.injective with ea
      obtain ⟨xb, yb⟩ := orderedPair.injective with eb
      rw [ya, yb, ← xa, ← xb]
    . intros x hx
      obtain ⟨m, s⟩ := rel with x, hx
      exact ⟨polySequence(R, x), s, m⟩
  refine ⟨fn, ?_⟩
  intros p hp
  obtain ⟨m, s⟩ := rel with p, hp
  exact FunctionBetween.apply_value with fn, hp, m

-- Helper: the constant coefficient of a product.
theorem tkJ.cauchy_zero (f g : Set)
  requires first : f ∈ powerSeriesCarrier(R)
  requires second : g ∈ powerSeriesCarrier(R)
  shows ringCauchyProduct(R, f, g)(0) = call2(R.mul, f(0), g(0))
proof
  have polys := polynomialRing.comm_ring at R, {0} with comm
  have zN : (0:Nat) ∈ ℕ by typecheck
  have le : (0:Nat) ≤ 0 by arith
  obtain ⟨tf, af⟩ := tkJ.trunc_agree at R, f, 0 with comm, first
  obtain ⟨tg, ag⟩ := tkJ.trunc_agree at R, g, 0 with comm, second
  obtain ⟨_, c⟩ := tkJ.cauchy_trunc at R, f, g, 0 with comm, first, second
  have zeroIn : R.zero ∈ R.carrier by typecheck
  rw [← (c with 0, zN, le), ← (polyEval.zero_point at R, call2(Ring.mul(polynomialRing(R, {0})), seriesTrunc(R, f, succ(0)), seriesTrunc(R, g, succ(0))) with comm, polys)]
  rw (polyEval.mul at R, seriesTrunc(R, f, succ(0)), seriesTrunc(R, g, succ(0)), R.zero with comm, polys, tf, tg, zeroIn)
  rw [(polyEval.zero_point at R, seriesTrunc(R, f, succ(0)) with comm, polys, tf), (polyEval.zero_point at R, seriesTrunc(R, g, succ(0)) with comm, polys, tg), (af with 0, zN, le), (ag with 0, zN, le)]

-- Coefficient laws: coeff_add, coeff_mul (the Cauchy
-- product), coeff_C, coeff_X, coeff_one, coeff_X_pow, coeff_C_mul (with
-- smul_eq_C_mul, the R-action as multiplication by constants),
-- coeff_X_pow_mul'.
theorem seriesCoeff.add (f g : Set) (n : Nat)
  requires first : f ∈ powerSeriesCarrier(R)
  requires second : g ∈ powerSeriesCarrier(R)
  shows seriesCoeff(call2(Ring.add(powerSeriesRing(R)), f, g), n) =
    call2(R.add, seriesCoeff(f, n), seriesCoeff(g, n))
proof
  have nN : n ∈ ℕ by typecheck
  obtain ⟨_, values⟩ := tkJ.series_sum at R, f, g with comm, first, second
  rw (tkJ.series_add_apply at R, f, g with comm, first, second)
  unfold seriesCoeff
  exact values with n, nN

theorem seriesCoeff.mul (f g : Set) (n : Nat)
  requires first : f ∈ powerSeriesCarrier(R)
  requires second : g ∈ powerSeriesCarrier(R)
  shows seriesCoeff(call2(Ring.mul(powerSeriesRing(R)), f, g), n) =
    finiteRingSum(antidiagonal(n), R.carrier, R.add, R.zero, R.neg, R.mul,
      R.one, ringCauchyTerms(R, f, g, n))
proof
  have nN : n ∈ ℕ by typecheck
  obtain ⟨_, values⟩ := tkJ.cauchy_product at R, f, g with comm, first, second
  rw (tkJ.series_mul_apply at R, f, g with comm, first, second)
  unfold seriesCoeff
  exact values with n, nN

theorem seriesCoeff.C (a : R) (n : Nat)
  shows (n = 0 → seriesCoeff(seriesConstant(R, a), n) = a) ∧
    (n ≠ 0 → seriesCoeff(seriesConstant(R, a), n) = R[0])
proof
  have aIn : a ∈ R.carrier by typecheck
  have nN : n ∈ ℕ by typecheck
  obtain ⟨_, v0, vn⟩ := tkJ.series_constant at R, a with comm, aIn
  unfold seriesCoeff
  constructor
  . intro e
    rw e
    exact v0
  . intro ne
    exact vn with n, nN, ne

theorem seriesCoeff.C_mul (a f : Set) (n : Nat)
  requires scalar : a ∈ R.carrier
  requires series : f ∈ powerSeriesCarrier(R)
  shows seriesCoeff(call2(Ring.mul(powerSeriesRing(R)), seriesConstant(R, a), f), n) =
    call2(R.mul, a, seriesCoeff(f, n))
proof
  obtain ⟨cIn, _, _⟩ := tkJ.series_constant at R, a with comm, scalar
  rw (tkJ.series_mul_apply at R, seriesConstant(R, a), f with comm, cIn, series)
  unfold seriesCoeff
  exact tkJ.cauchy_C_mul at R, a, f, n with comm, scalar, series

-- PowerSeries.C is an injective ring homomorphism (C_injective); the
-- constant coefficient is a ring homomorphism (constantCoeff).
theorem seriesConstantMap.hom
  shows seriesConstantMap(R) : R →+* powerSeriesRing(R)
proof
  have ps := powerSeriesRing.comm_ring at R with comm
  obtain ⟨carrierEq, _, _, _, _, oneEq⟩ := tkJ.series_projections at R with comm
  have rel : ∀ a ∈ R.carrier, (a, seriesConstant(R, a)) ∈ seriesConstantMap(R) ∧ seriesConstant(R, a) ∈ powerSeriesCarrier(R)
    intros a ha
    obtain ⟨s, _, _⟩ := tkJ.series_constant at R, a with comm, ha
    have m : (a, seriesConstant(R, a)) ∈ seriesConstantMap(R)
      apply seriesConstantMap.membership.backward
      refine ⟨(product.pair with ha, s), a, ha, rfl⟩
    exact ⟨m, s⟩
  have fn : seriesConstantMap(R) : R.carrier → powerSeriesCarrier(R)
    apply tkJ.uni_graph_function
    . intros u hu
      exact (seriesConstantMap.membership.forward with hu).left
    . intros x y z hy hz
      obtain ⟨_, a, aIn, ea⟩ := seriesConstantMap.membership.forward with hy
      obtain ⟨_, b, bIn, eb⟩ := seriesConstantMap.membership.forward with hz
      obtain ⟨xa, ya⟩ := orderedPair.injective with ea
      obtain ⟨xb, yb⟩ := orderedPair.injective with eb
      rw [ya, yb, ← xa, ← xb]
    . intros x hx
      obtain ⟨m, s⟩ := rel with x, hx
      exact ⟨seriesConstant(R, x), s, m⟩
  have fv : ∀ a ∈ R.carrier, seriesConstantMap(R)(a) = seriesConstant(R, a)
    intros a ha
    obtain ⟨m, s⟩ := rel with a, ha
    exact FunctionBetween.apply_value with fn, ha, m
  have fn2 : seriesConstantMap(R) : R.carrier → Ring.carrier(powerSeriesRing(R))
    rw carrierEq
    exact fn
  apply RingHom.mk with comm, ps, fn2
  . intros x hx y hy
    have xy : call2(R.add, x, y) ∈ R.carrier by typecheck
    obtain ⟨sx, x0, xn⟩ := tkJ.series_constant at R, x with comm, hx
    obtain ⟨sy, y0, yn⟩ := tkJ.series_constant at R, y with comm, hy
    obtain ⟨sxy, xy0, xyn⟩ := tkJ.series_constant at R, call2(R.add, x, y) with comm, xy
    obtain ⟨ss, vs⟩ := tkJ.series_sum at R, seriesConstant(R, x), seriesConstant(R, y) with comm, sx, sy
    rw [(fv with x, hx), (fv with y, hy), (fv with call2(R.add, x, y), xy)]
    rw (tkJ.series_add_apply at R, seriesConstant(R, x), seriesConstant(R, y) with comm, sx, sy)
    apply powerSeries.ext at R, seriesConstant(R, call2(R.add, x, y)), seriesSum(R, seriesConstant(R, x), seriesConstant(R, y)) with comm, sxy, ss
    intros n nN
    rw (vs with n, nN)
    by_cases e : n = 0
    . rw [e, xy0, x0, y0]
    . rw [(xyn with n, nN, e), (xn with n, nN, e), (yn with n, nN, e)]
      ring
  . intros x hx y hy
    have xy : call2(R.mul, x, y) ∈ R.carrier by typecheck
    obtain ⟨sx, x0, xn⟩ := tkJ.series_constant at R, x with comm, hx
    obtain ⟨sy, y0, yn⟩ := tkJ.series_constant at R, y with comm, hy
    obtain ⟨sxy, xy0, xyn⟩ := tkJ.series_constant at R, call2(R.mul, x, y) with comm, xy
    obtain ⟨sp, _⟩ := tkJ.cauchy_product at R, seriesConstant(R, x), seriesConstant(R, y) with comm, sx, sy
    rw [(fv with x, hx), (fv with y, hy), (fv with call2(R.mul, x, y), xy)]
    rw (tkJ.series_mul_apply at R, seriesConstant(R, x), seriesConstant(R, y) with comm, sx, sy)
    apply powerSeries.ext at R, seriesConstant(R, call2(R.mul, x, y)), ringCauchyProduct(R, seriesConstant(R, x), seriesConstant(R, y)) with comm, sxy, sp
    intros n nN
    have nNat := nat.omega.backward with nN
    rw (tkJ.cauchy_C_mul at R, x, seriesConstant(R, y), n with comm, hx, sy)
    by_cases e : n = 0
    . rw [e, xy0, y0]
    . rw [(xyn with n, nN, e), (yn with n, nN, e)]
      ring
  . have oneIn : R.one ∈ R.carrier by typecheck
    rw [(fv with R.one, oneIn), oneEq]

theorem seriesConstantCoeff.hom
  shows RingHom(evaluationMap(ℕ, selfModule(R), 0), powerSeriesRing(R), R)
proof
  have ps := powerSeriesRing.comm_ring at R with comm
  obtain ⟨carrierEq, _, _, _, _, oneEq⟩ := tkJ.series_projections at R with comm
  have mc : Module.carrier(selfModule(R)) = R.carrier
    unfold selfModule
    simp [Module.mk.carrier]
  have zN : (0:Nat) ∈ ℕ by typecheck
  have values : ∀ u ∈ functionSpace(ℕ, Module.carrier(selfModule(R))), u(0) ∈ Module.carrier(selfModule(R))
    intros u hu
    rw mc at hu
    rw mc
    have uF := functionSpace.mem_iff.forward with hu
    exact FunctionBetween.apply_closed with uF, zN
  have fn := evaluationMap.graph_function at ℕ, selfModule(R), 0 with values
  have fv : ∀ u ∈ powerSeriesCarrier(R), evaluationMap(ℕ, selfModule(R), 0)(u) = u(0)
    intros u hu
    have hu2 : u ∈ functionSpace(ℕ, Module.carrier(selfModule(R)))
      rw mc
      unfold powerSeriesCarrier at hu
      exact hu
    exact evaluationMap.graph_apply at ℕ, selfModule(R), 0, u with values, hu2
  have fn2 : evaluationMap(ℕ, selfModule(R), 0) : Ring.carrier(powerSeriesRing(R)) → R.carrier
    rw [carrierEq, ← mc]
    unfold powerSeriesCarrier
    rw mc
    rw mc at fn
    exact fn
  apply RingHom.mk with ps, comm, fn2
  . intros x hx y hy
    rw carrierEq at hx
    rw carrierEq at hy
    obtain ⟨ss, vs⟩ := tkJ.series_sum at R, x, y with comm, hx, hy
    rw (tkJ.series_add_apply at R, x, y with comm, hx, hy)
    rw [(fv with seriesSum(R, x, y), ss), (fv with x, hx), (fv with y, hy)]
    exact vs with 0, zN
  . intros x hx y hy
    rw carrierEq at hx
    rw carrierEq at hy
    obtain ⟨sp, _⟩ := tkJ.cauchy_product at R, x, y with comm, hx, hy
    rw (tkJ.series_mul_apply at R, x, y with comm, hx, hy)
    rw [(fv with ringCauchyProduct(R, x, y), sp), (fv with x, hx), (fv with y, hy)]
    exact tkJ.cauchy_zero at R, x, y with comm, hx, hy
  . have oneIn : R.one ∈ R.carrier by typecheck
    obtain ⟨so, o0, _⟩ := tkJ.series_constant at R, R.one with comm, oneIn
    rw [oneEq, (fv with seriesConstant(R, R.one), so), o0]

-- Polynomials are power series: the inclusion is an injective ring
-- homomorphism preserving coefficients, X and C (Polynomial.coe_X,
-- coe_C, coeff_coe, Polynomial.coe_injective).
theorem polynomialToSeries.hom
  shows polynomialToSeries(R) : polynomialRing(R, {0}) →+* powerSeriesRing(R)
proof
  have polys := polynomialRing.comm_ring at R, {0} with comm
  have ps := powerSeriesRing.comm_ring at R with comm
  obtain ⟨carrierEq, addEq, _, _, mulEq, oneEq⟩ := tkJ.series_projections at R with comm
  obtain ⟨fn, fv⟩ := tkJ.poly_to_series at R with comm
  have fn2 : polynomialToSeries(R) : Ring.carrier(polynomialRing(R, {0})) → Ring.carrier(powerSeriesRing(R))
    rw carrierEq
    exact fn
  apply RingHom.mk with polys, ps, fn2
  . intros x hx y hy
    have xy : call2(Ring.add(polynomialRing(R, {0})), x, y) ∈ Ring.carrier(polynomialRing(R, {0})) by typecheck
    obtain ⟨sx, vx⟩ := tkJ.poly_sequence at R, x with comm, hx
    obtain ⟨sy, vy⟩ := tkJ.poly_sequence at R, y with comm, hy
    obtain ⟨sxy, vxy⟩ := tkJ.poly_sequence at R, call2(Ring.add(polynomialRing(R, {0})), x, y) with comm, xy
    obtain ⟨ss, vs⟩ := tkJ.series_sum at R, polySequence(R, x), polySequence(R, y) with comm, sx, sy
    rw [(fv with x, hx), (fv with y, hy), (fv with call2(Ring.add(polynomialRing(R, {0})), x, y), xy)]
    rw (tkJ.series_add_apply at R, polySequence(R, x), polySequence(R, y) with comm, sx, sy)
    apply powerSeries.ext at R, polySequence(R, call2(Ring.add(polynomialRing(R, {0})), x, y)), seriesSum(R, polySequence(R, x), polySequence(R, y)) with comm, sxy, ss
    intros n nN
    have nNat := nat.omega.backward with nN
    rw [(vxy with n, nN), (vs with n, nN), (vx with n, nN), (vy with n, nN)]
    exact polyCoeff.add at R, x, y, n with comm, polys, hx, hy
  . intros x hx y hy
    have xy : call2(Ring.mul(polynomialRing(R, {0})), x, y) ∈ Ring.carrier(polynomialRing(R, {0})) by typecheck
    obtain ⟨sx, vx⟩ := tkJ.poly_sequence at R, x with comm, hx
    obtain ⟨sy, vy⟩ := tkJ.poly_sequence at R, y with comm, hy
    obtain ⟨sxy, vxy⟩ := tkJ.poly_sequence at R, call2(Ring.mul(polynomialRing(R, {0})), x, y) with comm, xy
    obtain ⟨sp, _⟩ := tkJ.cauchy_product at R, polySequence(R, x), polySequence(R, y) with comm, sx, sy
    rw [(fv with x, hx), (fv with y, hy), (fv with call2(Ring.mul(polynomialRing(R, {0})), x, y), xy)]
    rw (tkJ.series_mul_apply at R, polySequence(R, x), polySequence(R, y) with comm, sx, sy)
    apply powerSeries.ext at R, polySequence(R, call2(Ring.mul(polynomialRing(R, {0})), x, y)), ringCauchyProduct(R, polySequence(R, x), polySequence(R, y)) with comm, sxy, sp
    intros n nN
    have nNat := nat.omega.backward with nN
    have ax : ∀ i ∈ ℕ, i ≤ n → polyCoeff(x, i) = polySequence(R, x)(i)
      intros i iN le
      rw (vx with i, iN)
    have ay : ∀ i ∈ ℕ, i ≤ n → polyCoeff(y, i) = polySequence(R, y)(i)
      intros i iN le
      rw (vy with i, iN)
    have c := tkJ.cauchy_poly at R, polySequence(R, x), polySequence(R, y), x, y, n with comm, sx, sy, hx, hy, ax, ay
    rw [(vxy with n, nN), c]
  . have oneIn : Ring.one(polynomialRing(R, {0})) ∈ Ring.carrier(polynomialRing(R, {0})) by typecheck
    have rOne : R.one ∈ R.carrier by typecheck
    obtain ⟨so, vo⟩ := tkJ.poly_sequence at R, Ring.one(polynomialRing(R, {0})) with comm, oneIn
    obtain ⟨cIn, c0, cn⟩ := tkJ.series_constant at R, R.one with comm, rOne
    have cHom := polyC.hom at R with comm, polys
    have cOne : polyC(R, R.one) = Ring.one(polynomialRing(R, {0}))
      unfold polyC
      exact (RingHom.map_one with cHom)
    rw [(fv with Ring.one(polynomialRing(R, {0})), oneIn), oneEq]
    apply powerSeries.ext at R, polySequence(R, Ring.one(polynomialRing(R, {0}))), seriesConstant(R, R.one) with comm, so, cIn
    intros n nN
    have nNat := nat.omega.backward with nN
    obtain ⟨z, nz⟩ := polyC.coeff at R, R.one, n with comm, polys, rOne
    rw [(vo with n, nN), ← cOne]
    by_cases e : n = 0
    . rw [(z with e), e, c0]
    . rw [(nz with e), (cn with n, nN, e)]

theorem polynomialToSeries.coeff (p : Set) (n : Nat)
  requires member : p ∈ Ring.carrier(polynomialRing(R, {0}))
  shows seriesCoeff(polynomialToSeries(R)(p), n) = polyCoeff(p, n)
proof
  obtain ⟨_, fv⟩ := tkJ.poly_to_series at R with comm
  obtain ⟨_, vs⟩ := tkJ.poly_sequence at R, p with comm, member
  have nN : n ∈ ℕ by typecheck
  rw (fv with p, member)
  unfold seriesCoeff
  exact vs with n, nN

theorem polynomialToSeries.X
  shows polynomialToSeries(R)(polyX(R)) = seriesX(R)
proof
  have polys := polynomialRing.comm_ring at R, {0} with comm
  have xIn := polyX.mem at R with comm, polys
  obtain ⟨_, fv⟩ := tkJ.poly_to_series at R with comm
  obtain ⟨sp, vs⟩ := tkJ.poly_sequence at R, polyX(R) with comm, xIn
  obtain ⟨sx, x1, xn⟩ := tkJ.series_X at R with comm
  rw (fv with polyX(R), xIn)
  apply powerSeries.ext at R, polySequence(R, polyX(R)), seriesX(R) with comm, sp, sx
  intros n nN
  have nNat := nat.omega.backward with nN
  obtain ⟨one, other⟩ := uni.X_coeff at R, n with comm, polys
  rw (vs with n, nN)
  by_cases e : n = 1
  . rw [(one with e), e, x1]
  . rw [(other with e), (xn with n, nN, e)]

theorem polynomialToSeries.injective
  shows InjectiveBetween(polynomialToSeries(R), Ring.carrier(polynomialRing(R, {0})),
    powerSeriesCarrier(R))
proof
  have polys := polynomialRing.comm_ring at R, {0} with comm
  obtain ⟨fn, fv⟩ := tkJ.poly_to_series at R with comm
  unfold InjectiveBetween
  refine ⟨fn, ?_⟩
  intros x hx y hy z hz rx ry
  have ex := FunctionBetween.apply_value with fn, hx, rx
  have ey := FunctionBetween.apply_value with fn, hy, ry
  rw (fv with x, hx) at ex
  rw (fv with y, hy) at ey
  obtain ⟨_, vx⟩ := tkJ.poly_sequence at R, x with comm, hx
  obtain ⟨_, vy⟩ := tkJ.poly_sequence at R, y with comm, hy
  apply polynomial.ext at R, x, y with comm, polys, hx, hy
  intros k kN
  have kNat := nat.omega.backward with kN
  rw [← (vx with k, kN), ← (vy with k, kN), ex, ey]

-- Helper: Xᵏ in R[[X]] is the image of the polynomial Xᵏ.
theorem tkJ.X_pow_image (k : Nat)
  shows Ring.pow(powerSeriesRing(R), seriesX(R), k) ∈ powerSeriesCarrier(R) ∧
    (∀ i ∈ ℕ, Ring.pow(powerSeriesRing(R), seriesX(R), k)(i) =
      polyCoeff(Ring.pow(polynomialRing(R, {0}), polyX(R), k), i))
proof
  have polys := polynomialRing.comm_ring at R, {0} with comm
  have ps := powerSeriesRing.comm_ring at R with comm
  have hom := polynomialToSeries.hom at R with comm
  have xIn := polyX.mem at R with comm, polys
  have pk : Ring.pow(polynomialRing(R, {0}), polyX(R), k) ∈ Ring.carrier(polynomialRing(R, {0})) by typecheck
  have mp := RingHom.map_pow at polynomialRing(R, {0}), powerSeriesRing(R), polynomialToSeries(R), polyX(R), k with polys, ps, hom, xIn
  rw (polynomialToSeries.X at R with comm) at mp
  obtain ⟨fn, fv⟩ := tkJ.poly_to_series at R with comm
  have img := FunctionBetween.apply_closed with fn, pk
  rw ← mp
  refine ⟨img, ?_⟩
  intros i iN
  have iNat := nat.omega.backward with iN
  have c := polynomialToSeries.coeff at R, Ring.pow(polynomialRing(R, {0}), polyX(R), k), i with comm, pk
  unfold seriesCoeff at c
  rw ← mp
  exact c

theorem seriesCoeff.X_pow (k n : Nat)
  shows (n = k → seriesCoeff(Ring.pow(powerSeriesRing(R), seriesX(R), k), n) = R[1]) ∧
    (n ≠ k → seriesCoeff(Ring.pow(powerSeriesRing(R), seriesX(R), k), n) = R[0])
proof
  have polys := polynomialRing.comm_ring at R, {0} with comm
  have oneIn : R.one ∈ R.carrier by typecheck
  have nN : n ∈ ℕ by typecheck
  obtain ⟨_, values⟩ := tkJ.X_pow_image at R, k with comm
  obtain ⟨same, other⟩ := uni.term_coeff at R, R.one, k, n with comm, polys, oneIn
  unfold seriesCoeff
  rw [(values with n, nN), (uni.X_pow at R, k with comm, polys)]
  exact ⟨same, other⟩

theorem seriesCoeff.X_pow_mul (f : Set) (k n : Nat)
  requires series : f ∈ powerSeriesCarrier(R)
  shows seriesCoeff(call2(Ring.mul(powerSeriesRing(R)),
      Ring.pow(powerSeriesRing(R), seriesX(R), k), f), n + k) = seriesCoeff(f, n) ∧
    (n < k → seriesCoeff(call2(Ring.mul(powerSeriesRing(R)),
      Ring.pow(powerSeriesRing(R), seriesX(R), k), f), n) = R[0])
proof
  have polys := polynomialRing.comm_ring at R, {0} with comm
  have parts := CommRing.parts with comm
  have oneIn : R.one ∈ R.carrier by typecheck
  have xIn := polyX.mem at R with comm, polys
  have pk : Ring.pow(polynomialRing(R, {0}), polyX(R), k) ∈ Ring.carrier(polynomialRing(R, {0})) by typecheck
  obtain ⟨xk, xkV⟩ := tkJ.X_pow_image at R, k with comm
  rw (tkJ.series_mul_apply at R, Ring.pow(powerSeriesRing(R), seriesX(R), k), f with comm, xk, series)
  unfold seriesCoeff
  constructor
  . obtain ⟨tf, af⟩ := tkJ.trunc_agree at R, f, n + k with comm, series
    have ap : ∀ i ∈ ℕ, i ≤ n + k → polyCoeff(Ring.pow(polynomialRing(R, {0}), polyX(R), k), i) = Ring.pow(powerSeriesRing(R), seriesX(R), k)(i)
      intros i iN le
      rw (xkV with i, iN)
    have c := tkJ.cauchy_poly at R, Ring.pow(powerSeriesRing(R), seriesX(R), k), f, Ring.pow(polynomialRing(R, {0}), polyX(R), k), seriesTrunc(R, f, succ(n + k)), n + k with comm, xk, series, pk, tf, ap, af
    have nN : n ∈ ℕ by typecheck
    have le : n ≤ n + k by arith
    rw [c, (polyCoeff.X_pow_mul at R, seriesTrunc(R, f, succ(n + k)), k, n with comm, polys, tf), (af with n, nN, le)]
  . intro lt
    have nN : n ∈ ℕ by typecheck
    obtain ⟨_, cv⟩ := tkJ.cauchy_product at R, Ring.pow(powerSeriesRing(R), seriesX(R), k), f with comm, xk, series
    obtain ⟨termsF, termsV⟩ := tkJ.cauchy_terms at R, Ring.pow(powerSeriesRing(R), seriesX(R), k), f, n with comm, xk, series
    have adFin := tkJ.antidiagonal_finite at n
    rw (cv with n, nN)
    apply finiteRingSum.zero with parts, adFin, termsF
    intros x hx
    obtain ⟨_, i, iN, j, jN, e, s⟩ := antidiagonal.membership.forward with hx
    have iNat := nat.omega.backward with iN
    have jNat := nat.omega.backward with jN
    have ne : i ≠ k by arith
    have fj := tkJ.series_coeff_mem at R, f, j with comm, series
    obtain ⟨_, other⟩ := uni.term_coeff at R, R.one, k, i with comm, polys, oneIn
    rw [e, (termsV with i, iN, j, jN, s), (xkV with i, iN), (uni.X_pow at R, k with comm, polys), (other with ne)]
    ring

-- Units: f is a unit iff its constant coefficient is
-- (PowerSeries.isUnit_iff_constantCoeff); 1 − X is a unit with inverse
-- Σ Xⁿ (PowerSeries.invUnitsSub).
theorem powerSeriesRing.unit_iff (f : Set)
  requires series : f ∈ powerSeriesCarrier(R)
  shows RingUnit(powerSeriesRing(R), f) ↔ RingUnit(R, f(0))
proof
  sorry

theorem powerSeriesRing.geometric
  shows call2(Ring.mul(powerSeriesRing(R)),
      Ring.sub(powerSeriesRing(R), seriesConstant(R, R.one), seriesX(R)),
      constantFunction(ℕ, R.carrier, R.one)) = seriesConstant(R, R.one)
proof
  have ps := powerSeriesRing.comm_ring at R with comm
  have psr := CommRing.to_ring with ps
  obtain ⟨carrierEq, addEq, _, negEq, _, oneEq⟩ := tkJ.series_projections at R with comm
  obtain ⟨_, _, negF, negV⟩ := tkJ.series_ops at R with comm
  have oneIn : R.one ∈ R.carrier by typecheck
  obtain ⟨sx, _, _⟩ := tkJ.series_X at R with comm
  have gIn : constantFunction(ℕ, R.carrier, R.one) ∈ powerSeriesCarrier(R)
    unfold powerSeriesCarrier
    exact functionSpace.constant with oneIn
  have gV : ∀ n ∈ ℕ, constantFunction(ℕ, R.carrier, R.one)(n) = R.one
    intros n hn
    exact constantFunction.apply with hn, oneIn
  obtain ⟨so, o0, on⟩ := tkJ.series_constant at R, R.one with comm, oneIn
  have xc : seriesX(R) ∈ Ring.carrier(powerSeriesRing(R))
    rw carrierEq
    exact sx
  have gc : constantFunction(ℕ, R.carrier, R.one) ∈ Ring.carrier(powerSeriesRing(R))
    rw carrierEq
    exact gIn
  have expand : call2(Ring.mul(powerSeriesRing(R)), Ring.sub(powerSeriesRing(R), Ring.one(powerSeriesRing(R)), seriesX(R)), constantFunction(ℕ, R.carrier, R.one)) = Ring.sub(powerSeriesRing(R), constantFunction(ℕ, R.carrier, R.one), call2(Ring.mul(powerSeriesRing(R)), Ring.pow(powerSeriesRing(R), seriesX(R), 1), constantFunction(ℕ, R.carrier, R.one)))
    rw (Ring.pow_one at powerSeriesRing(R), seriesX(R) with psr, xc)
    ring
  rw ← oneEq
  rw expand
  rw oneEq
  obtain ⟨x1, _⟩ := tkJ.X_pow_image at R, 1 with comm
  obtain ⟨xg, _⟩ := tkJ.cauchy_product at R, Ring.pow(powerSeriesRing(R), seriesX(R), 1), constantFunction(ℕ, R.carrier, R.one) with comm, x1, gIn
  rw (tkJ.series_mul_apply at R, Ring.pow(powerSeriesRing(R), seriesX(R), 1), constantFunction(ℕ, R.carrier, R.one) with comm, x1, gIn)
  obtain ⟨nxg, nxgV⟩ := tkJ.series_neg at R, ringCauchyProduct(R, Ring.pow(powerSeriesRing(R), seriesX(R), 1), constantFunction(ℕ, R.carrier, R.one)) with comm, xg
  obtain ⟨ss, ssV⟩ := tkJ.series_sum at R, constantFunction(ℕ, R.carrier, R.one), seriesNeg(R, ringCauchyProduct(R, Ring.pow(powerSeriesRing(R), seriesX(R), 1), constantFunction(ℕ, R.carrier, R.one))) with comm, gIn, nxg
  unfold Ring.sub
  rw [negEq, (negV with ringCauchyProduct(R, Ring.pow(powerSeriesRing(R), seriesX(R), 1), constantFunction(ℕ, R.carrier, R.one)), xg), (tkJ.series_add_apply at R, constantFunction(ℕ, R.carrier, R.one), seriesNeg(R, ringCauchyProduct(R, Ring.pow(powerSeriesRing(R), seriesX(R), 1), constantFunction(ℕ, R.carrier, R.one))) with comm, gIn, nxg)]
  apply powerSeries.ext at R, seriesSum(R, constantFunction(ℕ, R.carrier, R.one), seriesNeg(R, ringCauchyProduct(R, Ring.pow(powerSeriesRing(R), seriesX(R), 1), constantFunction(ℕ, R.carrier, R.one)))), seriesConstant(R, R.one) with comm, ss, so
  intros n nN
  have nNat := nat.omega.backward with nN
  rw [(ssV with n, nN), (nxgV with n, nN), (gV with n, nN)]
  by_cases e : n = 0
  . obtain ⟨_, low⟩ := seriesCoeff.X_pow_mul at R, constantFunction(ℕ, R.carrier, R.one), 1, 0 with comm, gIn
    have lt : (0:Nat) < 1 by arith
    have z := low with lt
    rw (tkJ.series_mul_apply at R, Ring.pow(powerSeriesRing(R), seriesX(R), 1), constantFunction(ℕ, R.carrier, R.one) with comm, x1, gIn) at z
    unfold seriesCoeff at z
    rw [e, z, o0]
    ring
  . have pos : (0:Nat) < n by arith
    obtain ⟨d, dNat, sum⟩ := pos
    have dN := nat.omega.forward with dNat
    obtain ⟨high, _⟩ := seriesCoeff.X_pow_mul at R, constantFunction(ℕ, R.carrier, R.one), 1, d with comm, gIn
    rw (tkJ.series_mul_apply at R, Ring.pow(powerSeriesRing(R), seriesX(R), 1), constantFunction(ℕ, R.carrier, R.one) with comm, x1, gIn) at high
    unfold seriesCoeff at high
    have nd : n = d + 1 by arith
    rw [(on with n, nN, e), nd, high, (gV with d, dN)]
    ring

theorem tkJ.series_shift (f : Set) (n : Nat)
  requires series : f ∈ powerSeriesCarrier(R)
  shows tkJSeriesShift(R, f, n) ∈ powerSeriesCarrier(R) ∧
    (∀ m ∈ ℕ, tkJSeriesShift(R, f, n)(m) = f(m + n))
proof
  have rel : ∀ m ∈ ℕ, (m, f(m + n)) ∈ tkJSeriesShift(R, f, n) ∧ f(m + n) ∈ R.carrier
    intros m hm
    have mNat := nat.omega.backward with hm
    have v := tkJ.series_coeff_mem at R, f, m + n with comm, series
    have mem : (m, f(m + n)) ∈ tkJSeriesShift(R, f, n)
      apply tkJSeriesShift.membership.backward
      refine ⟨(product.pair with hm, v), m, hm, rfl⟩
    exact ⟨mem, v⟩
  have fn : tkJSeriesShift(R, f, n) : ℕ → R.carrier
    apply tkJ.uni_graph_function
    . intros u hu
      exact (tkJSeriesShift.membership.forward with hu).left
    . intros x y z hy hz
      obtain ⟨_, a, aIn, ea⟩ := tkJSeriesShift.membership.forward with hy
      obtain ⟨_, b, bIn, eb⟩ := tkJSeriesShift.membership.forward with hz
      obtain ⟨xa, ya⟩ := orderedPair.injective with ea
      obtain ⟨xb, yb⟩ := orderedPair.injective with eb
      rw [ya, yb, ← xa, ← xb]
    . intros x hx
      obtain ⟨mem, v⟩ := rel with x, hx
      exact ⟨f(x + n), v, mem⟩
  have mem := tkJ.series_of_function at R, tkJSeriesShift(R, f, n) with comm, fn
  refine ⟨mem, ?_⟩
  intros m hm
  obtain ⟨r, v⟩ := rel with m, hm
  exact FunctionBetween.apply_value with fn, hm, r

-- PowerSeries.X_dvd_iff and X_pow_dvd_iff.
theorem seriesX.pow_dvd_iff (f : Set) (n : Nat)
  requires series : f ∈ powerSeriesCarrier(R)
  shows RingDvd(powerSeriesRing(R), Ring.pow(powerSeriesRing(R), seriesX(R), n), f) ↔
    (∀ k ∈ n, f(k) = R[0])
proof
  obtain ⟨carrierEq, _, _, _, _, _⟩ := tkJ.series_projections at R with comm
  obtain ⟨xn, _⟩ := tkJ.X_pow_image at R, n with comm
  constructor
  . intro dvd
    obtain ⟨_, _, c, cIn, eq⟩ := dvd
    rw carrierEq at cIn
    intros k hk
    have kNat := natural.member at n with k, hk
    have lt := Less.of_membership at k, n with hk
    obtain ⟨_, low⟩ := seriesCoeff.X_pow_mul at R, c, n, k with comm, cIn
    have z := low with lt
    unfold seriesCoeff at z
    rw ← eq at z
    exact z
  . intro vanish
    obtain ⟨sh, shV⟩ := tkJ.series_shift at R, f, n with comm, series
    obtain ⟨prod, _⟩ := tkJ.cauchy_product at R, Ring.pow(powerSeriesRing(R), seriesX(R), n), tkJSeriesShift(R, f, n) with comm, xn, sh
    have eq : f = call2(Ring.mul(powerSeriesRing(R)), Ring.pow(powerSeriesRing(R), seriesX(R), n), tkJSeriesShift(R, f, n))
      rw (tkJ.series_mul_apply at R, Ring.pow(powerSeriesRing(R), seriesX(R), n), tkJSeriesShift(R, f, n) with comm, xn, sh)
      apply powerSeries.ext at R, f, ringCauchyProduct(R, Ring.pow(powerSeriesRing(R), seriesX(R), n), tkJSeriesShift(R, f, n)) with comm, series, prod
      intros j jN
      have jNat := nat.omega.backward with jN
      obtain ⟨high, low⟩ := seriesCoeff.X_pow_mul at R, tkJSeriesShift(R, f, n), n, j with comm, sh
      rw (tkJ.series_mul_apply at R, Ring.pow(powerSeriesRing(R), seriesX(R), n), tkJSeriesShift(R, f, n) with comm, xn, sh) at high
      rw (tkJ.series_mul_apply at R, Ring.pow(powerSeriesRing(R), seriesX(R), n), tkJSeriesShift(R, f, n) with comm, xn, sh) at low
      unfold seriesCoeff at high
      unfold seriesCoeff at low
      by_cases lt : j < n
      . have jn := membership.of_Less at j, n with jNat
        have mem := jn with lt
        rw [(low with lt), (vanish with j, mem)]
      . have le := LessEqual.of_not_Less at j, n with lt
        obtain ⟨d, dNat, sum⟩ := le
        have dN := nat.omega.forward with dNat
        have shift := seriesCoeff.X_pow_mul at R, tkJSeriesShift(R, f, n), n, d with comm, sh
        obtain ⟨h2, _⟩ := shift
        rw (tkJ.series_mul_apply at R, Ring.pow(powerSeriesRing(R), seriesX(R), n), tkJSeriesShift(R, f, n) with comm, xn, sh) at h2
        unfold seriesCoeff at h2
        have jd : j = d + n by arith
        rw [jd, h2, (shV with d, dN)]
    have xc : Ring.pow(powerSeriesRing(R), seriesX(R), n) ∈ Ring.carrier(powerSeriesRing(R))
      rw carrierEq
      exact xn
    have fc : f ∈ Ring.carrier(powerSeriesRing(R))
      rw carrierEq
      exact series
    have hc : tkJSeriesShift(R, f, n) ∈ Ring.carrier(powerSeriesRing(R))
      rw carrierEq
      exact sh
    unfold RingDvd
    exact ⟨xc, fc, tkJSeriesShift(R, f, n), hc, eq⟩

theorem seriesX.dvd_iff (f : Set)
  requires series : f ∈ powerSeriesCarrier(R)
  shows RingDvd(powerSeriesRing(R), seriesX(R), f) ↔ f(0) = R[0]
proof
  have ps := powerSeriesRing.comm_ring at R with comm
  have psr := CommRing.to_ring with ps
  obtain ⟨carrierEq, _, _, _, _, _⟩ := tkJ.series_projections at R with comm
  obtain ⟨sx, _, _⟩ := tkJ.series_X at R with comm
  have xc : seriesX(R) ∈ Ring.carrier(powerSeriesRing(R))
    rw carrierEq
    exact sx
  have one := Ring.pow_one at powerSeriesRing(R), seriesX(R) with psr, xc
  have iff := seriesX.pow_dvd_iff at R, f, 1 with comm, series
  rw one at iff
  have zIn : (0:Nat) ∈ (1:Nat) by simp
  constructor
  . intro d
    have v := iff.forward with d
    exact v with 0, zIn
  . intro z
    apply iff.backward
    intros k hk
    have k0 : k = 0
      have kNat := natural.member at 1 with k, hk
      have lt := Less.of_membership at k, 1 with hk
      arith
    rw k0
    exact z

-- Helper: a nonzero series is Xⁱ times a series with nonzero constant
-- coefficient.
theorem tkJ.series_order (f : Set)
  requires series : f ∈ powerSeriesCarrier(R)
  requires nonzero : f ≠ constantFunction(ℕ, R.carrier, R.zero)
  shows ∃ i ∈ ℕ, ∃ c ∈ powerSeriesCarrier(R), c(0) ≠ R.zero ∧
    f = call2(Ring.mul(powerSeriesRing(R)), Ring.pow(powerSeriesRing(R), seriesX(R), i), c)
proof
  have zeroIn : R.zero ∈ R.carrier by typecheck
  obtain ⟨carrierEq, _, _, _, _, _⟩ := tkJ.series_projections at R with comm
  have ne : tkJSeriesSupport(R, f) ≠ ∅
    intro empty
    apply nonzero
    have zIn : constantFunction(ℕ, R.carrier, R.zero) ∈ powerSeriesCarrier(R)
      unfold powerSeriesCarrier
      exact functionSpace.constant with zeroIn
    apply powerSeries.ext at R, f, constantFunction(ℕ, R.carrier, R.zero) with comm, series, zIn
    intros n nN
    rw (constantFunction.apply at ℕ, R.carrier, n, R.zero with nN, zeroIn)
    by_contra other
    have mem : n ∈ tkJSeriesSupport(R, f)
      apply tkJSeriesSupport.membership.backward
      exact ⟨nN, other⟩
    rw empty at mem
    exact (empty.membership at n) with mem
  obtain ⟨i, iS, minimal⟩ := set.foundation at tkJSeriesSupport(R, f) with ne
  obtain ⟨iN, fi⟩ := tkJSeriesSupport.membership.forward with iS
  have iNat := nat.omega.backward with iN
  have vanish : ∀ k ∈ i, f(k) = R.zero
    intros k hk
    by_contra other
    have kNat := natural.member at i with k, hk
    have kN := nat.omega.forward with kNat
    have mem : k ∈ tkJSeriesSupport(R, f)
      apply tkJSeriesSupport.membership.backward
      exact ⟨kN, other⟩
    exact minimal with k, hk, mem
  have dvd := (seriesX.pow_dvd_iff at R, f, i with comm, series).backward with vanish
  obtain ⟨_, _, c, cIn, eq⟩ := dvd
  rw carrierEq at cIn
  obtain ⟨high, _⟩ := seriesCoeff.X_pow_mul at R, c, i, 0 with comm, cIn
  unfold seriesCoeff at high
  rw ← eq at high
  have zi : 0 + i = i by arith
  rw zi at high
  refine ⟨i, iN, c, cIn, ?_, eq⟩
  rw ← high
  exact fi

-- R[[X]] is a domain when R is (PowerSeries.instIsDomain), and local with
-- maximal ideal (m, X) when R is a field.
theorem powerSeriesRing.domain
  requires domain : IntegralDomain(R)
  shows IntegralDomain(powerSeriesRing(R))
proof
  have ps := powerSeriesRing.comm_ring at R with comm
  obtain ⟨carrierEq, _, zeroEq, _, _, oneEq⟩ := tkJ.series_projections at R with comm
  obtain ⟨_, zo, noZd⟩ := domain
  have zeroIn : R.zero ∈ R.carrier by typecheck
  have oneIn : R.one ∈ R.carrier by typecheck
  have zN : (0:Nat) ∈ ℕ by typecheck
  obtain ⟨so, o0, _⟩ := tkJ.series_constant at R, R.one with comm, oneIn
  have distinct : Ring.zero(powerSeriesRing(R)) ≠ Ring.one(powerSeriesRing(R))
    rw [zeroEq, oneEq]
    intro e
    have v := constantFunction.apply at ℕ, R.carrier, 0, R.zero with zN, zeroIn
    rw [e, o0] at v
    apply zo
    rw v
  unfold IntegralDomain
  refine ⟨ps, distinct, ?_⟩
  intros x hx y hy prod
  rw carrierEq at hx
  rw carrierEq at hy
  rw zeroEq
  rw zeroEq at prod
  by_cases x0 : x = constantFunction(ℕ, R.carrier, R.zero)
  . left
    exact x0
  . right
    by_contra y0
    obtain ⟨i, iN, c, cIn, c0, xe⟩ := tkJ.series_order at R, x with comm, hx, x0
    obtain ⟨j, jN, d, dIn, d0, ye⟩ := tkJ.series_order at R, y with comm, hy, y0
    have iNat := nat.omega.backward with iN
    have jNat := nat.omega.backward with jN
    obtain ⟨xi, _⟩ := tkJ.X_pow_image at R, i with comm
    obtain ⟨xj, _⟩ := tkJ.X_pow_image at R, j with comm
    have ci : c ∈ Ring.carrier(powerSeriesRing(R))
      rw carrierEq
      exact cIn
    have di : d ∈ Ring.carrier(powerSeriesRing(R))
      rw carrierEq
      exact dIn
    have xic : Ring.pow(powerSeriesRing(R), seriesX(R), i) ∈ Ring.carrier(powerSeriesRing(R))
      rw carrierEq
      exact xi
    have xjc : Ring.pow(powerSeriesRing(R), seriesX(R), j) ∈ Ring.carrier(powerSeriesRing(R))
      rw carrierEq
      exact xj
    have regroup : call2(Ring.mul(powerSeriesRing(R)), call2(Ring.mul(powerSeriesRing(R)), Ring.pow(powerSeriesRing(R), seriesX(R), i), c), call2(Ring.mul(powerSeriesRing(R)), Ring.pow(powerSeriesRing(R), seriesX(R), j), d)) = call2(Ring.mul(powerSeriesRing(R)), Ring.pow(powerSeriesRing(R), seriesX(R), i), call2(Ring.mul(powerSeriesRing(R)), Ring.pow(powerSeriesRing(R), seriesX(R), j), call2(Ring.mul(powerSeriesRing(R)), c, d)))
      ring
    rw [xe, ye, regroup] at prod
    have cd : call2(Ring.mul(powerSeriesRing(R)), c, d) ∈ Ring.carrier(powerSeriesRing(R)) by typecheck
    rw carrierEq at cd
    have jcd : call2(Ring.mul(powerSeriesRing(R)), Ring.pow(powerSeriesRing(R), seriesX(R), j), call2(Ring.mul(powerSeriesRing(R)), c, d)) ∈ Ring.carrier(powerSeriesRing(R)) by typecheck
    rw carrierEq at jcd
    obtain ⟨outer, _⟩ := seriesCoeff.X_pow_mul at R, call2(Ring.mul(powerSeriesRing(R)), Ring.pow(powerSeriesRing(R), seriesX(R), j), call2(Ring.mul(powerSeriesRing(R)), c, d)), i, j with comm, jcd
    obtain ⟨inner, _⟩ := seriesCoeff.X_pow_mul at R, call2(Ring.mul(powerSeriesRing(R)), c, d), j, 0 with comm, cd
    unfold seriesCoeff at outer
    unfold seriesCoeff at inner
    rw prod at outer
    have zj : 0 + j = j by arith
    rw zj at inner
    rw inner at outer
    rw (tkJ.series_mul_apply at R, c, d with comm, cIn, dIn) at outer
    rw (tkJ.cauchy_zero at R, c, d with comm, cIn, dIn) at outer
    have ij : j + i ∈ ℕ by typecheck
    rw (constantFunction.apply at ℕ, R.carrier, j + i, R.zero with ij, zeroIn) at outer
    have c0In := tkJ.series_coeff_mem at R, c, 0 with comm, cIn
    have d0In := tkJ.series_coeff_mem at R, d, 0 with comm, dIn
    have e : call2(R.mul, c(0), d(0)) = R.zero
      rw ← outer
    have z := noZd with c(0), c0In, d(0), d0In, e
    cases z with a | b
    . exact c0 with a
    . exact d0 with b

-- Helper: the coefficientwise image of a series.
theorem tkJ.series_map (S f : Set)
  requires target : CommRing(S)
  requires hom : f : R →+* S
  shows (seriesMap(R, S, f) : powerSeriesCarrier(R) → powerSeriesCarrier(S)) ∧
    (∀ g ∈ powerSeriesCarrier(R), ∀ n ∈ ℕ, seriesMap(R, S, f)(g)(n) = f(g(n)))
proof
  have hom2 := hom
  obtain ⟨_, _, fF, _⟩ := hom2
  have fS : f ∈ functionSpace(R.carrier, S.carrier) := functionSpace.mem_iff.backward with fF
  have rel : ∀ g ∈ powerSeriesCarrier(R), (g, compose(f, g, ℕ, R.carrier, S.carrier)) ∈ seriesMap(R, S, f) ∧ compose(f, g, ℕ, R.carrier, S.carrier) ∈ powerSeriesCarrier(S)
    intros g hg
    have gS := hg
    unfold powerSeriesCarrier at gS
    have c := functionSpace.compose at g, f, ℕ, R.carrier, S.carrier with gS, fS
    have cS : compose(f, g, ℕ, R.carrier, S.carrier) ∈ powerSeriesCarrier(S)
      unfold powerSeriesCarrier
      exact c
    have m : (g, compose(f, g, ℕ, R.carrier, S.carrier)) ∈ seriesMap(R, S, f)
      apply seriesMap.membership.backward
      refine ⟨(product.pair with hg, cS), g, hg, rfl⟩
    exact ⟨m, cS⟩
  have fn : seriesMap(R, S, f) : powerSeriesCarrier(R) → powerSeriesCarrier(S)
    apply tkJ.uni_graph_function
    . intros u hu
      exact (seriesMap.membership.forward with hu).left
    . intros x y z hy hz
      obtain ⟨_, a, aIn, ea⟩ := seriesMap.membership.forward with hy
      obtain ⟨_, b, bIn, eb⟩ := seriesMap.membership.forward with hz
      obtain ⟨xa, ya⟩ := orderedPair.injective with ea
      obtain ⟨xb, yb⟩ := orderedPair.injective with eb
      rw [ya, yb, ← xa, ← xb]
    . intros x hx
      obtain ⟨m, s⟩ := rel with x, hx
      exact ⟨compose(f, x, ℕ, R.carrier, S.carrier), s, m⟩
  refine ⟨fn, ?_⟩
  intros g hg n nN
  obtain ⟨m, s⟩ := rel with g, hg
  have gF := tkJ.series_function at R, g with comm, hg
  rw (FunctionBetween.apply_value with fn, hg, m)
  exact compose.apply at f, g, ℕ, R.carrier, S.carrier, n with gF, fF, nN

-- Coefficient maps (PowerSeries.map, coeff_map, map_X, map_C,
-- map_injective).
theorem seriesMap.coeff (S f g : Set) (n : Nat)
  requires target : CommRing(S)
  requires hom : f : R →+* S
  requires series : g ∈ powerSeriesCarrier(R)
  shows seriesCoeff(seriesMap(R, S, f)(g), n) = f(seriesCoeff(g, n))
proof
  obtain ⟨_, values⟩ := tkJ.series_map at R, S, f with comm, target, hom
  have nN : n ∈ ℕ by typecheck
  unfold seriesCoeff
  exact values with g, series, n, nN

theorem seriesMap.X (S f : Set)
  requires target : CommRing(S)
  requires hom : f : R →+* S
  shows seriesMap(R, S, f)(seriesX(R)) = seriesX(S)
proof
  obtain ⟨fn, values⟩ := tkJ.series_map at R, S, f with comm, target, hom
  obtain ⟨sx, x1, xn⟩ := tkJ.series_X at R with comm
  obtain ⟨sy, y1, yn⟩ := tkJ.series_X at S with target
  have img := FunctionBetween.apply_closed with fn, sx
  apply powerSeries.ext at S, seriesMap(R, S, f)(seriesX(R)), seriesX(S) with target, img, sy
  intros n nN
  rw (values with seriesX(R), sx, n, nN)
  by_cases e : n = 1
  . rw [e, x1, y1]
    exact RingHom.map_one with hom
  . rw [(xn with n, nN, e), (yn with n, nN, e)]
    exact RingHom.map_zero with hom

theorem seriesMap.injective (S f : Set)
  requires target : CommRing(S)
  requires hom : f : R →+* S
  requires injective : InjectiveBetween(f, R.carrier, S.carrier)
  shows InjectiveBetween(seriesMap(R, S, f), powerSeriesCarrier(R),
    powerSeriesCarrier(S))
proof
  obtain ⟨fn, values⟩ := tkJ.series_map at R, S, f with comm, target, hom
  have inj := injective
  obtain ⟨fF, uniq⟩ := inj
  unfold InjectiveBetween
  refine ⟨fn, ?_⟩
  intros x hx y hy z hz rx ry
  have ex := FunctionBetween.apply_value with fn, hx, rx
  have ey := FunctionBetween.apply_value with fn, hy, ry
  apply powerSeries.ext at R, x, y with comm, hx, hy
  intros n nN
  have nNat := nat.omega.backward with nN
  have xn := tkJ.series_coeff_mem at R, x, n with comm, hx
  have yn := tkJ.series_coeff_mem at R, y, n with comm, hy
  have vx := values with x, hx, n, nN
  have vy := values with y, hy, n, nN
  rw ex at vx
  rw ey at vy
  have same : f(x(n)) = f(y(n))
    rw [← vx, ← vy]
  have fxn := FunctionBetween.apply_closed with fF, xn
  have rx2 := FunctionBetween.relates_apply at f, R.carrier, S.carrier, x(n) with fF, xn
  have ry2 := FunctionBetween.relates_apply at f, R.carrier, S.carrier, y(n) with fF, yn
  rw ← same at ry2
  exact uniq with x(n), xn, y(n), yn, f(x(n)), fxn, rx2, ry2

theorem seriesMap.hom (S f : Set)
  requires target : CommRing(S)
  requires hom : f : R →+* S
  shows seriesMap(R, S, f) : powerSeriesRing(R) →+* powerSeriesRing(S)
proof
  have psR := powerSeriesRing.comm_ring at R with comm
  have psS := powerSeriesRing.comm_ring at S with target
  have polysR := polynomialRing.comm_ring at R, {0} with comm
  have polysS := polynomialRing.comm_ring at S, {0} with target
  have pm := polyMap.hom at R, S, f with comm, polysR, target, hom
  obtain ⟨carrierR, _, _, _, _, oneR⟩ := tkJ.series_projections at R with comm
  obtain ⟨carrierS, _, _, _, _, oneS⟩ := tkJ.series_projections at S with target
  obtain ⟨fn, values⟩ := tkJ.series_map at R, S, f with comm, target, hom
  have fn2 : seriesMap(R, S, f) : Ring.carrier(powerSeriesRing(R)) → Ring.carrier(powerSeriesRing(S))
    rw [carrierR, carrierS]
    exact fn
  apply RingHom.mk with psR, psS, fn2
  . intros x hx y hy
    rw carrierR at hx
    rw carrierR at hy
    obtain ⟨sxy, vxy⟩ := tkJ.series_sum at R, x, y with comm, hx, hy
    have mx := FunctionBetween.apply_closed with fn, hx
    have my := FunctionBetween.apply_closed with fn, hy
    have mxy := FunctionBetween.apply_closed with fn, sxy
    obtain ⟨ss, vs⟩ := tkJ.series_sum at S, seriesMap(R, S, f)(x), seriesMap(R, S, f)(y) with target, mx, my
    rw [(tkJ.series_add_apply at R, x, y with comm, hx, hy), (tkJ.series_add_apply at S, seriesMap(R, S, f)(x), seriesMap(R, S, f)(y) with target, mx, my)]
    apply powerSeries.ext at S, seriesMap(R, S, f)(seriesSum(R, x, y)), seriesSum(S, seriesMap(R, S, f)(x), seriesMap(R, S, f)(y)) with target, mxy, ss
    intros n nN
    have nNat := nat.omega.backward with nN
    have xn := tkJ.series_coeff_mem at R, x, n with comm, hx
    have yn := tkJ.series_coeff_mem at R, y, n with comm, hy
    rw [(values with seriesSum(R, x, y), sxy, n, nN), (vs with n, nN), (vxy with n, nN), (values with x, hx, n, nN), (values with y, hy, n, nN)]
    exact RingHom.map_add with hom, xn, yn
  . intros x hx y hy
    rw carrierR at hx
    rw carrierR at hy
    obtain ⟨sxy, _⟩ := tkJ.cauchy_product at R, x, y with comm, hx, hy
    have mx := FunctionBetween.apply_closed with fn, hx
    have my := FunctionBetween.apply_closed with fn, hy
    have mxy := FunctionBetween.apply_closed with fn, sxy
    obtain ⟨sp, _⟩ := tkJ.cauchy_product at S, seriesMap(R, S, f)(x), seriesMap(R, S, f)(y) with target, mx, my
    rw [(tkJ.series_mul_apply at R, x, y with comm, hx, hy), (tkJ.series_mul_apply at S, seriesMap(R, S, f)(x), seriesMap(R, S, f)(y) with target, mx, my)]
    apply powerSeries.ext at S, seriesMap(R, S, f)(ringCauchyProduct(R, x, y)), ringCauchyProduct(S, seriesMap(R, S, f)(x), seriesMap(R, S, f)(y)) with target, mxy, sp
    intros n nN
    have nNat := nat.omega.backward with nN
    obtain ⟨tx, ax⟩ := tkJ.trunc_agree at R, x, n with comm, hx
    obtain ⟨ty, ay⟩ := tkJ.trunc_agree at R, y, n with comm, hy
    obtain ⟨_, cxy⟩ := tkJ.cauchy_trunc at R, x, y, n with comm, hx, hy
    have le : n ≤ n by arith
    have mtx := RingHom.map_mem at polyMap(R, S, f), polynomialRing(R, {0}), polynomialRing(S, {0}), seriesTrunc(R, x, succ(n)) with pm, tx
    have mty := RingHom.map_mem at polyMap(R, S, f), polynomialRing(R, {0}), polynomialRing(S, {0}), seriesTrunc(R, y, succ(n)) with pm, ty
    have agX : ∀ i ∈ ℕ, i ≤ n → polyCoeff(polyMap(R, S, f)(seriesTrunc(R, x, succ(n))), i) = seriesMap(R, S, f)(x)(i)
      intros i iN li
      have iNat := nat.omega.backward with iN
      rw [(polyMap.coeff at R, S, f, seriesTrunc(R, x, succ(n)), i with comm, polysR, target, hom, tx), (ax with i, iN, li), (values with x, hx, i, iN)]
    have agY : ∀ i ∈ ℕ, i ≤ n → polyCoeff(polyMap(R, S, f)(seriesTrunc(R, y, succ(n))), i) = seriesMap(R, S, f)(y)(i)
      intros i iN li
      have iNat := nat.omega.backward with iN
      rw [(polyMap.coeff at R, S, f, seriesTrunc(R, y, succ(n)), i with comm, polysR, target, hom, ty), (ay with i, iN, li), (values with y, hy, i, iN)]
    have c := tkJ.cauchy_poly at S, seriesMap(R, S, f)(x), seriesMap(R, S, f)(y), polyMap(R, S, f)(seriesTrunc(R, x, succ(n))), polyMap(R, S, f)(seriesTrunc(R, y, succ(n))), n with target, mx, my, mtx, mty, agX, agY
    have mm := RingHom.map_mul at polyMap(R, S, f), polynomialRing(R, {0}), polynomialRing(S, {0}), seriesTrunc(R, x, succ(n)), seriesTrunc(R, y, succ(n)) with pm, tx, ty
    have prodIn : call2(Ring.mul(polynomialRing(R, {0})), seriesTrunc(R, x, succ(n)), seriesTrunc(R, y, succ(n))) ∈ Ring.carrier(polynomialRing(R, {0})) by typecheck
    rw [c, ← mm, (polyMap.coeff at R, S, f, call2(Ring.mul(polynomialRing(R, {0})), seriesTrunc(R, x, succ(n)), seriesTrunc(R, y, succ(n))), n with comm, polysR, target, hom, prodIn), (cxy with n, nN, le), (values with ringCauchyProduct(R, x, y), sxy, n, nN)]
  . have oneIn : R.one ∈ R.carrier by typecheck
    have oneSIn : S.one ∈ S.carrier by typecheck
    obtain ⟨so, o0, on⟩ := tkJ.series_constant at R, R.one with comm, oneIn
    obtain ⟨sp, p0, pn⟩ := tkJ.series_constant at S, S.one with target, oneSIn
    have img := FunctionBetween.apply_closed with fn, so
    rw [oneR, oneS]
    apply powerSeries.ext at S, seriesMap(R, S, f)(seriesConstant(R, R.one)), seriesConstant(S, S.one) with target, img, sp
    intros n nN
    rw (values with seriesConstant(R, R.one), so, n, nN)
    by_cases e : n = 0
    . rw [e, o0, p0]
      exact RingHom.map_one with hom
    . rw [(on with n, nN, e), (pn with n, nN, e)]
      exact RingHom.map_zero with hom

-- Helpers: the rescaled series and the map f ↦ f(a X).
theorem tkJ.series_rescale (a f : Set)
  requires scalar : a ∈ R.carrier
  requires series : f ∈ powerSeriesCarrier(R)
  shows seriesRescale(R, a, f) ∈ powerSeriesCarrier(R) ∧
    (∀ n ∈ ℕ, seriesRescale(R, a, f)(n) = call2(R.mul, Ring.pow(R, a, n), f(n)))
proof
  have ringR := CommRing.to_ring with comm
  have rel : ∀ n ∈ ℕ, (n, call2(R.mul, Ring.pow(R, a, n), f(n))) ∈ seriesRescale(R, a, f) ∧ call2(R.mul, Ring.pow(R, a, n), f(n)) ∈ R.carrier
    intros n hn
    have nNat := nat.omega.backward with hn
    have fn := tkJ.series_coeff_mem at R, f, n with comm, series
    have pn := Ring.pow_mem at R, a, n with ringR, scalar
    have v : call2(R.mul, Ring.pow(R, a, n), f(n)) ∈ R.carrier by typecheck
    have m : (n, call2(R.mul, Ring.pow(R, a, n), f(n))) ∈ seriesRescale(R, a, f)
      apply seriesRescale.membership.backward
      refine ⟨(product.pair with hn, v), n, hn, rfl⟩
    exact ⟨m, v⟩
  have fn : seriesRescale(R, a, f) : ℕ → R.carrier
    apply tkJ.uni_graph_function
    . intros u hu
      exact (seriesRescale.membership.forward with hu).left
    . intros x y z hy hz
      obtain ⟨_, b, bIn, ea⟩ := seriesRescale.membership.forward with hy
      obtain ⟨_, c, cIn, eb⟩ := seriesRescale.membership.forward with hz
      obtain ⟨xa, ya⟩ := orderedPair.injective with ea
      obtain ⟨xb, yb⟩ := orderedPair.injective with eb
      rw [ya, yb, ← xa, ← xb]
    . intros x hx
      obtain ⟨m, v⟩ := rel with x, hx
      exact ⟨call2(R.mul, Ring.pow(R, a, x), f(x)), v, m⟩
  have mem := tkJ.series_of_function at R, seriesRescale(R, a, f) with comm, fn
  refine ⟨mem, ?_⟩
  intros n hn
  obtain ⟨m, v⟩ := rel with n, hn
  exact FunctionBetween.apply_value with fn, hn, m

theorem tkJ.rescale_map (a : Set)
  requires scalar : a ∈ R.carrier
  shows (rescaleMap(R, a) : powerSeriesCarrier(R) → powerSeriesCarrier(R)) ∧
    (∀ f ∈ powerSeriesCarrier(R), rescaleMap(R, a)(f) = seriesRescale(R, a, f))
proof
  have rel : ∀ f ∈ powerSeriesCarrier(R), (f, seriesRescale(R, a, f)) ∈ rescaleMap(R, a) ∧ seriesRescale(R, a, f) ∈ powerSeriesCarrier(R)
    intros f hf
    obtain ⟨s, _⟩ := tkJ.series_rescale at R, a, f with comm, scalar, hf
    have m : (f, seriesRescale(R, a, f)) ∈ rescaleMap(R, a)
      apply rescaleMap.membership.backward
      refine ⟨(product.pair with hf, s), f, hf, rfl⟩
    exact ⟨m, s⟩
  have fn : rescaleMap(R, a) : powerSeriesCarrier(R) → powerSeriesCarrier(R)
    apply tkJ.uni_graph_function
    . intros u hu
      exact (rescaleMap.membership.forward with hu).left
    . intros x y z hy hz
      obtain ⟨_, b, bIn, ea⟩ := rescaleMap.membership.forward with hy
      obtain ⟨_, c, cIn, eb⟩ := rescaleMap.membership.forward with hz
      obtain ⟨xa, ya⟩ := orderedPair.injective with ea
      obtain ⟨xb, yb⟩ := orderedPair.injective with eb
      rw [ya, yb, ← xa, ← xb]
    . intros x hx
      obtain ⟨m, s⟩ := rel with x, hx
      exact ⟨seriesRescale(R, a, x), s, m⟩
  refine ⟨fn, ?_⟩
  intros f hf
  obtain ⟨m, s⟩ := rel with f, hf
  exact FunctionBetween.apply_value with fn, hf, m

-- Rescaling (PowerSeries.rescale): a ring homomorphism, multiplicative
-- in the scale (rescale_mul), commuting with map (rescale_map), and
-- substitution of a X (rescale_eq_subst).
theorem seriesRescale.hom (a : R)
  shows RingHom(rescaleMap(R, a), powerSeriesRing(R), powerSeriesRing(R))
proof
  have ringR := CommRing.to_ring with comm
  have parts := CommRing.parts with comm
  have aIn : a ∈ R.carrier by typecheck
  have ps := powerSeriesRing.comm_ring at R with comm
  obtain ⟨carrierEq, _, _, _, _, oneEq⟩ := tkJ.series_projections at R with comm
  obtain ⟨fn, fv⟩ := tkJ.rescale_map at R, a with comm, aIn
  have fn2 : rescaleMap(R, a) : Ring.carrier(powerSeriesRing(R)) → Ring.carrier(powerSeriesRing(R))
    rw carrierEq
    exact fn
  apply RingHom.mk with ps, ps, fn2
  . intros x hx y hy
    rw carrierEq at hx
    rw carrierEq at hy
    obtain ⟨sxy, vxy⟩ := tkJ.series_sum at R, x, y with comm, hx, hy
    obtain ⟨rx, vrx⟩ := tkJ.series_rescale at R, a, x with comm, aIn, hx
    obtain ⟨ry, vry⟩ := tkJ.series_rescale at R, a, y with comm, aIn, hy
    obtain ⟨rxy, vrxy⟩ := tkJ.series_rescale at R, a, seriesSum(R, x, y) with comm, aIn, sxy
    obtain ⟨ss, vs⟩ := tkJ.series_sum at R, seriesRescale(R, a, x), seriesRescale(R, a, y) with comm, rx, ry
    rw [(tkJ.series_add_apply at R, x, y with comm, hx, hy), (fv with seriesSum(R, x, y), sxy), (fv with x, hx), (fv with y, hy), (tkJ.series_add_apply at R, seriesRescale(R, a, x), seriesRescale(R, a, y) with comm, rx, ry)]
    apply powerSeries.ext at R, seriesRescale(R, a, seriesSum(R, x, y)), seriesSum(R, seriesRescale(R, a, x), seriesRescale(R, a, y)) with comm, rxy, ss
    intros n nN
    have nNat := nat.omega.backward with nN
    have xn := tkJ.series_coeff_mem at R, x, n with comm, hx
    have yn := tkJ.series_coeff_mem at R, y, n with comm, hy
    have pn := Ring.pow_mem at R, a, n with ringR, aIn
    rw [(vrxy with n, nN), (vs with n, nN), (vxy with n, nN), (vrx with n, nN), (vry with n, nN)]
    ring
  . intros x hx y hy
    rw carrierEq at hx
    rw carrierEq at hy
    obtain ⟨sxy, vxy⟩ := tkJ.cauchy_product at R, x, y with comm, hx, hy
    obtain ⟨rx, vrx⟩ := tkJ.series_rescale at R, a, x with comm, aIn, hx
    obtain ⟨ry, vry⟩ := tkJ.series_rescale at R, a, y with comm, aIn, hy
    obtain ⟨rxy, vrxy⟩ := tkJ.series_rescale at R, a, ringCauchyProduct(R, x, y) with comm, aIn, sxy
    obtain ⟨sp, vp⟩ := tkJ.cauchy_product at R, seriesRescale(R, a, x), seriesRescale(R, a, y) with comm, rx, ry
    rw [(tkJ.series_mul_apply at R, x, y with comm, hx, hy), (fv with ringCauchyProduct(R, x, y), sxy), (fv with x, hx), (fv with y, hy), (tkJ.series_mul_apply at R, seriesRescale(R, a, x), seriesRescale(R, a, y) with comm, rx, ry)]
    apply powerSeries.ext at R, seriesRescale(R, a, ringCauchyProduct(R, x, y)), ringCauchyProduct(R, seriesRescale(R, a, x), seriesRescale(R, a, y)) with comm, rxy, sp
    intros n nN
    have nNat := nat.omega.backward with nN
    have pn := Ring.pow_mem at R, a, n with ringR, aIn
    obtain ⟨wF, wV⟩ := tkJ.cauchy_terms at R, x, y, n with comm, hx, hy
    obtain ⟨vF, vV⟩ := tkJ.cauchy_terms at R, seriesRescale(R, a, x), seriesRescale(R, a, y), n with comm, rx, ry
    have adFin := tkJ.antidiagonal_finite at n
    have entries : ∀ t ∈ antidiagonal(n), ringCauchyTerms(R, seriesRescale(R, a, x), seriesRescale(R, a, y), n)(t) = call2(R.mul, Ring.pow(R, a, n), ringCauchyTerms(R, x, y, n)(t))
      intros t ht
      obtain ⟨_, i, iN, j, jN, e, s⟩ := antidiagonal.membership.forward with ht
      have iNat := nat.omega.backward with iN
      have jNat := nat.omega.backward with jN
      have xi := tkJ.series_coeff_mem at R, x, i with comm, hx
      have yj := tkJ.series_coeff_mem at R, y, j with comm, hy
      have pi := Ring.pow_mem at R, a, i with ringR, aIn
      have pj := Ring.pow_mem at R, a, j with ringR, aIn
      rw [e, (vV with i, iN, j, jN, s), (wV with i, iN, j, jN, s), (vrx with i, iN), (vry with j, jN), ← s, (Ring.pow_add at R, a, i, j with ringR, aIn)]
      ring
    have scaled := finiteRingSum.scale_eq at antidiagonal(n), R.carrier, R.add, R.zero, R.neg, R.mul, R.one, ringCauchyTerms(R, x, y, n), ringCauchyTerms(R, seriesRescale(R, a, x), seriesRescale(R, a, y), n), Ring.pow(R, a, n) with parts, adFin, wF, vF, pn, entries
    rw [(vrxy with n, nN), (vp with n, nN), (vxy with n, nN), scaled]
  . have oneIn : R.one ∈ R.carrier by typecheck
    obtain ⟨so, o0, on⟩ := tkJ.series_constant at R, R.one with comm, oneIn
    obtain ⟨ro, vro⟩ := tkJ.series_rescale at R, a, seriesConstant(R, R.one) with comm, aIn, so
    rw [oneEq, (fv with seriesConstant(R, R.one), so)]
    apply powerSeries.ext at R, seriesRescale(R, a, seriesConstant(R, R.one)), seriesConstant(R, R.one) with comm, ro, so
    intros n nN
    have nNat := nat.omega.backward with nN
    have pn := Ring.pow_mem at R, a, n with ringR, aIn
    rw (vro with n, nN)
    by_cases e : n = 0
    . rw [e, o0, (Ring.pow_zero at R, a with ringR, aIn)]
      ring
    . rw [(on with n, nN, e)]
      ring

theorem seriesRescale.mul (a b f : Set)
  requires first : a ∈ R.carrier
  requires second : b ∈ R.carrier
  requires series : f ∈ powerSeriesCarrier(R)
  shows seriesRescale(R, a, seriesRescale(R, b, f)) =
    seriesRescale(R, call2(R.mul, a, b), f)
proof
  have ringR := CommRing.to_ring with comm
  have ab : call2(R.mul, a, b) ∈ R.carrier by typecheck
  obtain ⟨rb, vrb⟩ := tkJ.series_rescale at R, b, f with comm, second, series
  obtain ⟨rab, vrab⟩ := tkJ.series_rescale at R, a, seriesRescale(R, b, f) with comm, first, rb
  obtain ⟨r2, vr2⟩ := tkJ.series_rescale at R, call2(R.mul, a, b), f with comm, ab, series
  apply powerSeries.ext at R, seriesRescale(R, a, seriesRescale(R, b, f)), seriesRescale(R, call2(R.mul, a, b), f) with comm, rab, r2
  intros n nN
  have nNat := nat.omega.backward with nN
  have fn := tkJ.series_coeff_mem at R, f, n with comm, series
  have pa := Ring.pow_mem at R, a, n with ringR, first
  have pb := Ring.pow_mem at R, b, n with ringR, second
  rw [(vrab with n, nN), (vrb with n, nN), (vr2 with n, nN), (Ring.mul_pow_comm at R, a, b, n with comm, first, second)]
  ring

theorem seriesRescale.map (S φ a f : Set)
  requires target : CommRing(S)
  requires hom : φ : R →+* S
  requires scalar : a ∈ R.carrier
  requires series : f ∈ powerSeriesCarrier(R)
  shows seriesMap(R, S, φ)(seriesRescale(R, a, f)) =
    seriesRescale(S, φ(a), seriesMap(R, S, φ)(f))
proof
  have ringR := CommRing.to_ring with comm
  obtain ⟨fn, values⟩ := tkJ.series_map at R, S, φ with comm, target, hom
  obtain ⟨ra, vra⟩ := tkJ.series_rescale at R, a, f with comm, scalar, series
  have pa : φ(a) ∈ S.carrier := RingHom.map_mem at φ, R, S, a with hom, scalar
  have mf := FunctionBetween.apply_closed with fn, series
  have mra := FunctionBetween.apply_closed with fn, ra
  obtain ⟨rs, vrs⟩ := tkJ.series_rescale at S, φ(a), seriesMap(R, S, φ)(f) with target, pa, mf
  apply powerSeries.ext at S, seriesMap(R, S, φ)(seriesRescale(R, a, f)), seriesRescale(S, φ(a), seriesMap(R, S, φ)(f)) with target, mra, rs
  intros n nN
  have nNat := nat.omega.backward with nN
  have fn2 := tkJ.series_coeff_mem at R, f, n with comm, series
  have pn := Ring.pow_mem at R, a, n with ringR, scalar
  rw [(values with seriesRescale(R, a, f), ra, n, nN), (vra with n, nN), (vrs with n, nN), (values with f, series, n, nN), (RingHom.map_mul at φ, R, S, Ring.pow(R, a, n), f(n) with hom, pn, fn2), (RingHom.map_pow at R, S, φ, a, n with comm, target, hom, scalar)]

theorem seriesRescale.eq_subst (a f : Set)
  requires scalar : a ∈ R.carrier
  requires series : f ∈ powerSeriesCarrier(R)
  shows seriesRescale(R, a, f) = seriesSubst(R, f,
    call2(Ring.mul(powerSeriesRing(R)), seriesConstant(R, a), seriesX(R)))
proof
  sorry

-- The derivative (PowerSeries.derivative): additive, Leibniz
-- (derivative_mul), coefficientwise (coeff_derivative), d X = 1, and
-- compatible with substitution (derivative_subst: (f ∘ g)' = (f' ∘ g) g').
theorem seriesDerivative.add (f g : Set)
  requires first : f ∈ powerSeriesCarrier(R)
  requires second : g ∈ powerSeriesCarrier(R)
  shows seriesDerivative(R, call2(Ring.add(powerSeriesRing(R)), f, g)) =
    call2(Ring.add(powerSeriesRing(R)), seriesDerivative(R, f), seriesDerivative(R, g))
proof
  sorry

theorem seriesDerivative.mul (f g : Set)
  requires first : f ∈ powerSeriesCarrier(R)
  requires second : g ∈ powerSeriesCarrier(R)
  shows seriesDerivative(R, call2(Ring.mul(powerSeriesRing(R)), f, g)) =
    call2(Ring.add(powerSeriesRing(R)),
      call2(Ring.mul(powerSeriesRing(R)), seriesDerivative(R, f), g),
      call2(Ring.mul(powerSeriesRing(R)), f, seriesDerivative(R, g)))
proof
  sorry

theorem seriesDerivative.X
  shows seriesDerivative(R, seriesX(R)) = seriesConstant(R, R.one)
proof
  sorry

theorem seriesDerivative.subst (f g : Set)
  requires series : f ∈ powerSeriesCarrier(R)
  requires substitutable : SeriesHasSubst(R, g)
  shows seriesDerivative(R, seriesSubst(R, f, g)) =
    call2(Ring.mul(powerSeriesRing(R)), seriesSubst(R, seriesDerivative(R, f), g),
      seriesDerivative(R, g))
proof
  sorry

-- Substitution (PowerSeries.subst on HasSubst): a ring homomorphism in f
-- (substAlgHom), X ↦ g (subst_X), constants fixed, composition
-- (subst_comp_subst_apply), compatible with map (map_subst), the
-- constant coefficient (constantCoeff_subst for g(0) = 0), and the
-- n-th coefficient as a finite sum (coeff_subst').
theorem seriesSubst.hom (g : Set)
  requires substitutable : SeriesHasSubst(R, g)
  shows RingHom(substMap(R, g), powerSeriesRing(R), powerSeriesRing(R))
proof
  sorry

theorem seriesSubst.X (g : Set)
  requires substitutable : SeriesHasSubst(R, g)
  shows seriesSubst(R, seriesX(R), g) = g
proof
  sorry

theorem seriesSubst.C (a g : Set)
  requires scalar : a ∈ R.carrier
  requires substitutable : SeriesHasSubst(R, g)
  shows seriesSubst(R, seriesConstant(R, a), g) = seriesConstant(R, a)
proof
  sorry

theorem seriesSubst.compose (f g h : Set)
  requires series : f ∈ powerSeriesCarrier(R)
  requires first : SeriesHasSubst(R, g)
  requires second : SeriesHasSubst(R, h)
  shows seriesSubst(R, seriesSubst(R, f, g), h) =
    seriesSubst(R, f, seriesSubst(R, g, h))
proof
  sorry

theorem seriesSubst.map (S φ f g : Set)
  requires target : CommRing(S)
  requires hom : φ : R →+* S
  requires series : f ∈ powerSeriesCarrier(R)
  requires substitutable : SeriesHasSubst(R, g)
  shows seriesMap(R, S, φ)(seriesSubst(R, f, g)) =
    seriesSubst(S, seriesMap(R, S, φ)(f), seriesMap(R, S, φ)(g))
proof
  sorry

theorem seriesSubst.constant_coeff (f g : Set)
  requires series : f ∈ powerSeriesCarrier(R)
  requires substituted : g ∈ powerSeriesCarrier(R)
  requires zero : g(0) = R[0]
  shows seriesSubst(R, f, g)(0) = f(0)
proof
  sorry

-- When g(0) = 0, only the first n + 1 terms reach the n-th coefficient.
theorem substCoeff.finite_sum (f g : Set) (n : Nat)
  requires series : f ∈ powerSeriesCarrier(R)
  requires substituted : g ∈ powerSeriesCarrier(R)
  requires zero : g(0) = R[0]
  shows substCoeff(R, f, g, n) = finiteRingSum(succ(n), R.carrier, R.add, R.zero,
    R.neg, R.mul, R.one, substTerms(R, f, g, n, succ(n)))
proof
  sorry

-- Substituting into a polynomial is evaluation (PowerSeries.subst_coe).
theorem seriesSubst.polynomial (p g : Set)
  requires member : p ∈ Ring.carrier(polynomialRing(R, {0}))
  requires substitutable : SeriesHasSubst(R, g)
  shows seriesSubst(R, polynomialToSeries(R)(p), g) =
    polyEval2(R, powerSeriesRing(R), seriesConstantMap(R), g, p)
proof
  sorry

-- The exponential: its coefficients, exp' = exp (derivative_exp), and
-- exp(a X) exp(b X) = exp((a + b) X) (PowerSeries.exp_mul_exp_eq_exp_add).
theorem seriesExp.coeff (n : Nat)
  requires factorialUnits : ∀ k ∈ ℕ, RingUnit(R, ringNat(R.add, R.zero, R.one, factorial(k)))
  shows call2(R.mul, seriesExp(R)(n), ringNat(R.add, R.zero, R.one, factorial(n))) = R[1]
proof
  sorry

theorem seriesExp.derivative
  requires factorialUnits : ∀ k ∈ ℕ, RingUnit(R, ringNat(R.add, R.zero, R.one, factorial(k)))
  shows seriesDerivative(R, seriesExp(R)) = seriesExp(R)
proof
  sorry

theorem seriesExp.mul (a b : R)
  requires factorialUnits : ∀ k ∈ ℕ, RingUnit(R, ringNat(R.add, R.zero, R.one, factorial(k)))
  shows call2(Ring.mul(powerSeriesRing(R)), seriesRescale(R, a, seriesExp(R)),
      seriesRescale(R, b, seriesExp(R))) = seriesRescale(R, a + b, seriesExp(R))
proof
  sorry

end Series

-- Section: Laws of power series in several variables
section MvSeries
variable (R I : Set)
hypothesis comm : CommRing(R)

theorem mvPowerSeriesRing.comm_ring
  shows CommRing(mvPowerSeriesRing(R, I))
proof
  sorry

-- The pairs of exponents adding to m are finitely many.
theorem monomialAntidiagonal.finite (m : Set)
  requires monomial : m ∈ monomials(I)
  shows Finite(monomialAntidiagonal(I, m))
proof
  sorry

-- MvPowerSeries.coeff_mul, coeff_C, coeff_X, coeff_monomial,
-- monomial_mul_monomial, coeff_X_pow.
theorem mvSeries.coeff_mul (f g m : Set)
  requires first : f ∈ mvSeriesCarrier(R, I)
  requires second : g ∈ mvSeriesCarrier(R, I)
  requires monomial : m ∈ monomials(I)
  shows call2(Ring.mul(mvPowerSeriesRing(R, I)), f, g)(m) =
    finiteRingSum(monomialAntidiagonal(I, m), R.carrier, R.add, R.zero, R.neg,
      R.mul, R.one, mvCauchyTerms(R, I, f, g, m))
proof
  sorry

theorem mvSeries.coeff_C (a m : Set)
  requires scalar : a ∈ R.carrier
  requires monomial : m ∈ monomials(I)
  shows (m = monomialOne(I) → mvSeriesConstant(R, I, a)(m) = a) ∧
    (m ≠ monomialOne(I) → mvSeriesConstant(R, I, a)(m) = R.zero)
proof
  sorry

theorem mvSeries.coeff_X (i m : Set)
  requires index : i ∈ I
  requires monomial : m ∈ monomials(I)
  shows (m = monomialVariable(I, i) → mvSeriesX(R, I, i)(m) = R.one) ∧
    (m ≠ monomialVariable(I, i) → mvSeriesX(R, I, i)(m) = R.zero)
proof
  sorry

-- MvPowerSeries.C is an injective homomorphism (C_injective) and the
-- constant coefficient a homomorphism; smul_eq_C_mul.
theorem mvSeriesConstant.hom
  shows RingHom(mvSeriesConstantMap(R, I), R, mvPowerSeriesRing(R, I))
proof
  sorry

theorem mvSeriesConstant.injective (a b : R)
  requires equal : mvSeriesConstant(R, I, a) = mvSeriesConstant(R, I, b)
  shows a = b
proof
  sorry

theorem mvSeriesConstantCoeff.hom
  shows RingHom(evaluationMap(monomials(I), selfModule(R), monomialOne(I)),
    mvPowerSeriesRing(R, I), R)
proof
  sorry

-- Polynomials are series: the inclusion is an injective ring
-- homomorphism (MvPolynomial.coe_mul, coe_injective, coeff_coe,
-- coe_X, coe_C).
theorem mvPolynomialToSeries.hom
  shows RingHom(mvPolynomialToSeries(R, I), polynomialRing(R, I),
    mvPowerSeriesRing(R, I))
proof
  sorry

theorem mvPolynomialToSeries.subset
  shows Ring.carrier(polynomialRing(R, I)) ⊆ mvSeriesCarrier(R, I)
proof
  sorry

theorem mvPolynomialToSeries.X (i : Set)
  requires index : i ∈ I
  shows X(R, I, i) = mvSeriesX(R, I, i)
proof
  sorry

-- Units: a series is a unit iff its constant coefficient is
-- (MvPowerSeries.isUnit_iff_constantCoeff), and a series with nilpotent
-- constant coefficient times anything has vanishing coefficients in high
-- degree (coeff_eq_zero_of_constantCoeff_nilpotent).
theorem mvPowerSeriesRing.unit_iff (f : Set)
  requires series : f ∈ mvSeriesCarrier(R, I)
  shows RingUnit(mvPowerSeriesRing(R, I), f) ↔ RingUnit(R, f(monomialOne(I)))
proof
  sorry

theorem mvSeries.coeff_pow_zero_of_nilpotent (f m : Set) (k : Nat)
  requires series : f ∈ mvSeriesCarrier(R, I)
  requires nilpotent : RingNilpotent(R, f(monomialOne(I)))
  requires monomial : m ∈ monomials(I)
  shows ∃ N ∈ ℕ, ∀ j ∈ ℕ, N ≤ j →
    Ring.pow(mvPowerSeriesRing(R, I), f, j)(m) = R.zero
proof
  sorry

-- A series with constant coefficient in nonZeroDivisors is a non-zero-
-- divisor (MvPowerSeries.mem_nonZeroDivisors_of_constantCoeff).
theorem mvSeries.non_zero_divisor (f : Set)
  requires series : f ∈ mvSeriesCarrier(R, I)
  requires constant : f(monomialOne(I)) ∈ nonZeroDivisors(R)
  shows f ∈ nonZeroDivisors(mvPowerSeriesRing(R, I))
proof
  sorry

-- Coefficient maps (MvPowerSeries.map, coeff_map).
theorem mvSeriesMap.hom (S f : Set)
  requires target : CommRing(S)
  requires hom : f : R →+* S
  shows RingHom(mvSeriesMap(R, S, I, f), mvPowerSeriesRing(R, I),
    mvPowerSeriesRing(S, I))
proof
  sorry

theorem mvSeriesMap.coeff (S f g m : Set)
  requires target : CommRing(S)
  requires hom : f : R →+* S
  requires series : g ∈ mvSeriesCarrier(R, I)
  requires monomial : m ∈ monomials(I)
  shows mvSeriesMap(R, S, I, f)(g)(m) = f(g(m))
proof
  sorry

-- Partial derivatives (MvPowerSeries.pderiv): Leibniz, ∂ᵢXⱼ = δᵢⱼ
-- (pderiv_X), and agreement with the polynomial derivative on
-- polynomials (MvPowerSeries.pderiv_coe).
theorem mvSeriesPartial.mul (i f g : Set)
  requires index : i ∈ I
  requires first : f ∈ mvSeriesCarrier(R, I)
  requires second : g ∈ mvSeriesCarrier(R, I)
  shows mvSeriesPartial(R, I, i, call2(Ring.mul(mvPowerSeriesRing(R, I)), f, g)) =
    call2(Ring.add(mvPowerSeriesRing(R, I)),
      call2(Ring.mul(mvPowerSeriesRing(R, I)), mvSeriesPartial(R, I, i, f), g),
      call2(Ring.mul(mvPowerSeriesRing(R, I)), f, mvSeriesPartial(R, I, i, g)))
proof
  sorry

theorem mvSeriesPartial.X (i j : Set)
  requires first : i ∈ I
  requires second : j ∈ I
  shows (i = j → mvSeriesPartial(R, I, i, mvSeriesX(R, I, j)) =
      mvSeriesConstant(R, I, R.one)) ∧
    (i ≠ j → mvSeriesPartial(R, I, i, mvSeriesX(R, I, j)) =
      mvSeriesConstant(R, I, R.zero))
proof
  sorry

theorem mvSeriesPartial.polynomial (i p : Set)
  requires index : i ∈ I
  requires member : p ∈ Ring.carrier(polynomialRing(R, I))
  shows mvSeriesPartial(R, I, i, p) = partialDerivative(R, I, i)(p)
proof
  sorry

-- Truncation to total degree (MvPowerSeries.truncTotal): a polynomial;
-- the coefficients below the degree of a product of truncations agree
-- with those of the product
-- (coeff_truncTotal_mul_truncTotal_eq_coeff_mul).
theorem mvSeriesTruncTotal.polynomial (f : Set) (n : Nat)
  requires series : f ∈ mvSeriesCarrier(R, I)
  shows mvSeriesTruncTotal(R, I, f, n) ∈ Ring.carrier(polynomialRing(R, I))
proof
  sorry

theorem mvSeriesTruncTotal.mul (f g m : Set) (n : Nat)
  requires first : f ∈ mvSeriesCarrier(R, I)
  requires second : g ∈ mvSeriesCarrier(R, I)
  requires monomial : m ∈ monomials(I)
  requires low : monomialDegree(I, m) < n
  shows call2(Ring.mul(polynomialRing(R, I)), mvSeriesTruncTotal(R, I, f, n),
      mvSeriesTruncTotal(R, I, g, n))(m) =
    call2(Ring.mul(mvPowerSeriesRing(R, I)), f, g)(m)
proof
  sorry

-- Renaming along an injective map: a ring homomorphism extending the
-- polynomial rename (MvPowerSeries.rename, coeff_rename, rename_X).
theorem mvSeriesRename.hom (J σ : Set)
  requires map : σ : I → J
  requires injective : InjectiveBetween(σ, I, J)
  shows RingHom(mvSeriesRenameMap(R, I, J, σ), mvPowerSeriesRing(R, I),
    mvPowerSeriesRing(R, J))
proof
  sorry

theorem mvSeriesRename.X (J σ i : Set)
  requires map : σ : I → J
  requires injective : InjectiveBetween(σ, I, J)
  requires index : i ∈ I
  shows mvSeriesRename(R, I, J, σ, mvSeriesX(R, I, i)) = mvSeriesX(R, J, σ(i))
proof
  sorry

theorem mvSeriesRename.polynomial (J σ p : Set)
  requires map : σ : I → J
  requires injective : InjectiveBetween(σ, I, J)
  requires member : p ∈ Ring.carrier(polynomialRing(R, I))
  shows mvSeriesRename(R, I, J, σ, p) = polynomialRename(R, I, J, σ)(p)
proof
  sorry

end MvSeries

-- One variable inside several: PowerSeries R is MvPowerSeries over {0}
-- (PowerSeries.toMvPowerSeries, a ring isomorphism).
theorem seriesToMv.iso (R : Set)
  requires comm : CommRing(R)
  shows RingIso(seriesToMvMap(R), powerSeriesRing(R), mvPowerSeriesRing(R, {0}))
proof
  sorry

