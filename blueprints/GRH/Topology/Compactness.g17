-- Compactness beyond Cumulus's open-cover form: compactness through
-- cluster points of filters, the cocompact filter, local compactness,
-- discrete spaces, clopen sets, locally constant maps, totally
-- disconnected and profinite spaces, and the extreme-value and
-- uniform-continuity theorems on compact spaces.
-- Part of the GRH blueprint.
-- Planned home: Topology/Compactness.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Topology.Compactness
import GRH.Topology.Filters

section Compactness
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Section: Definitions
-- The cocompact filter: the subsets of the carrier containing the
-- complement of a compact set (Mathlib's Filter.cocompact).
def cocompact (X : Set) : Set :=
  { B ∈ 𝒫(TopologicalSpace.carrier(X)) | ∃ K ∈ 𝒫(TopologicalSpace.carrier(X)),
    Compact(X, K) ∧ TopologicalSpace.carrier(X) ∖ K ⊆ B }

-- Every neighborhood of every point contains a compact neighborhood
-- (Mathlib's LocallyCompactSpace); every point has a compact neighborhood
-- (WeaklyLocallyCompactSpace).
predicate LocallyCompact (X : Set) :=
  TopologicalSpace(X) ∧
  (∀ x ∈ TopologicalSpace.carrier(X), ∀ N ∈ nhds(X, x),
    ∃ K ∈ nhds(X, x), K ⊆ N ∧ Compact(X, K))
predicate WeaklyLocallyCompact (X : Set) :=
  TopologicalSpace(X) ∧
  (∀ x ∈ TopologicalSpace.carrier(X), ∃ K ∈ nhds(X, x), Compact(X, K))

-- The discrete space on A, and the property of a space that every subset
-- of its carrier is open (Mathlib's DiscreteTopology).
def discreteSpace (A : Set) : Set := TopologicalSpace.mk(A, 𝒫(A))
predicate DiscreteTopology (X : Set) :=
  TopologicalSpace(X) ∧
  TopologicalSpace.opens(X) = 𝒫(TopologicalSpace.carrier(X))

-- A subset is discrete when every point of it is isolated in it.
predicate DiscreteSubset (X A : Set) :=
  A ⊆ TopologicalSpace.carrier(X) ∧
  (∀ a ∈ A, ∃ U ∈ TopologicalSpace.opens(X), U ∩ A = {a})

predicate Clopen (X U : Set) :=
  U ∈ TopologicalSpace.opens(X) ∧ Closed(X, U)

-- f is locally constant on X: the preimage in X of every set is open
-- (Mathlib's IsLocallyConstant); only the values on the carrier are read.
predicate IsLocallyConstant (f X : Set) :=
  TopologicalSpace(X) ∧
  (∀ B, functionPreimage(f, TopologicalSpace.carrier(X), B) ∈
    TopologicalSpace.opens(X))

-- Every connected subset has at most one point; a profinite space is
-- compact, Hausdorff, and totally disconnected.
predicate TotallyDisconnected (X : Set) :=
  TopologicalSpace(X) ∧
  (∀ A, ConnectedSubset(X, A) → ∀ a ∈ A, ∀ b ∈ A, a = b)
predicate Profinite (X : Set) :=
  TopologicalSpace(X) ∧ Compact(X) ∧ Hausdorff(X) ∧ TotallyDisconnected(X)

-- The image of a set under f, as a subset of the codomain's carrier, and
-- the naturals inside ℝ.
def imageIn (f A Y : Set) : Set := { y ∈ Y | ∃ x ∈ A, y = f(x) }
def realNaturals : Set := { realNat(n) | n ∈ ℕ }

-- Section: Compactness through filters
-- A is compact exactly when every proper filter containing A clusters at
-- a point of A. No ultrafilter, and so no choice, is involved.
theorem Compact.iff_cluster (X A : Set)
  requires space : TopologicalSpace(X)
  requires inside : A ⊆ X.carrier
  shows Compact(X, A) ↔
    (∀ F, ProperFilter(X.carrier, F) → A ∈ F → ∃ x ∈ A, ClusterPt(X, x, F))
proof
  sorry

-- Mathlib's IsCompact.elim_finite_subcover in the family form: an open
-- cover indexed by I has a finite subfamily that covers.
theorem Compact.finite_subcover (X K I U : Set)
  requires compact : Compact(X, K)
  requires open : ∀ i ∈ I, U(i) ∈ X.opens
  requires covers : ∀ x ∈ K, ∃ i ∈ I, x ∈ U(i)
  shows ∃ J ⊆ I, Finite(J) ∧ (∀ x ∈ K, ∃ i ∈ J, x ∈ U(i))
proof
  sorry

-- Mathlib's IsCompact.elim_directed_cover: a cover by an increasing
-- sequence of open sets is covered by one of them.
theorem Compact.directed_cover (X K U : Set)
  requires compact : Compact(X, K)
  requires open : ∀ n ∈ ℕ, U(n) ∈ X.opens
  requires increasing : ∀ m ∈ ℕ, ∀ n ∈ ℕ, m ≤ n → U(m) ⊆ U(n)
  requires covers : ∀ x ∈ K, ∃ n ∈ ℕ, x ∈ U(n)
  shows ∃ n ∈ ℕ, K ⊆ U(n)
proof
  sorry

-- A decreasing sequence of nonempty closed subsets of a compact set has
-- a common point (Cantor's intersection theorem).
theorem Compact.nested_closed (X K C : Set)
  requires compact : Compact(X, K)
  requires closed : ∀ n ∈ ℕ, Closed(X, C(n))
  requires inside : ∀ n ∈ ℕ, C(n) ⊆ K
  requires decreasing : ∀ m ∈ ℕ, ∀ n ∈ ℕ, m ≤ n → C(n) ⊆ C(m)
  requires nonempty : ∀ n ∈ ℕ, Nonempty(C(n))
  shows ∃ x ∈ K, ∀ n ∈ ℕ, x ∈ C(n)
proof
  sorry

-- Compact metric spaces are sequentially compact.
theorem Compact.metric_subsequence (M K u : Set)
  requires metric : MetricSpace(M)
  requires compact : Compact(metricTopology(M), K)
  requires values : u : ℕ → K
  shows ∃ x ∈ K, ∃ φ, (φ : ℕ → ℕ) ∧
    (∀ m ∈ ℕ, ∀ n ∈ ℕ, m < n → φ(m) < φ(n)) ∧
    Tendsto(compose(u, φ, ℕ, ℕ, K), ℕ, natAtTop, nhds(metricTopology(M), x))
proof
  sorry

theorem cocompact.mem_iff_on (X B : Set)
  requires space : TopologicalSpace(X)
  shows B ∈ cocompact(X) ↔
    B ⊆ X.carrier ∧ (∃ K, Compact(X, K) ∧ X.carrier ∖ K ⊆ B)
proof
  constructor
  . intro hB
    have hB2 := cocompact.membership.forward with hB
    obtain ⟨BPow, K, KPow, compact, sub⟩ := hB2
    refine ⟨(powerset.membership_iff.forward with BPow), K, compact, sub⟩
  . intro hB
    obtain ⟨Bsub, K, compact, sub⟩ := hB
    have Ksub := Compact.subset_carrier at X, K with space, compact
    apply cocompact.membership.backward
    refine ⟨(powerset.membership_iff.backward with Bsub), K, (powerset.membership_iff.backward with Ksub), compact, sub⟩

-- Section: The cocompact filter
theorem cocompact.is_filter (X : Set)
  requires space : TopologicalSpace(X)
  shows IsFilter(X.carrier, cocompact(X))
proof
  have parts := TopologicalSpace.parts with space
  obtain ⟨subsets, whole, unions, intersections⟩ := parts
  unfold IsFilter
  refine ⟨?_, ?_, ?_, ?_⟩
  . intros B hB
    exact (cocompact.membership.forward with hB).left
  . have e := Compact.empty_set at X with space
    have sub : X.carrier ∖ ∅ ⊆ X.carrier
      intros y hy
      exact (difference.membership.forward with hy).left
    have selfC : X.carrier ⊆ X.carrier by simp
    have iff := cocompact.mem_iff_on at X, X.carrier with space
    exact iff.backward with ⟨selfC, ∅, e, sub⟩
  . intros A hA B hAB hBX
    have iff := cocompact.mem_iff_on at X, A with space
    obtain ⟨Asub, K, compact, sub⟩ := iff.forward with hA
    have iff2 := cocompact.mem_iff_on at X, B with space
    exact iff2.backward with ⟨hBX, K, compact, (Subset.transitive with sub, hAB)⟩
  . intros A hA B hB
    have iffA := cocompact.mem_iff_on at X, A with space
    obtain ⟨Asub, K, compactK, subK⟩ := iffA.forward with hA
    have iffB := cocompact.mem_iff_on at X, B with space
    obtain ⟨Bsub, L, compactL, subL⟩ := iffB.forward with hB
    have cu := Compact.union at X, K, L with space, compactK, compactL
    have sub : X.carrier ∖ (K ∪ L) ⊆ A ∩ B
      intros y hy
      have hy2 := difference.membership.forward with hy
      have notK : y ∉ K
        intro yK
        exact hy2.right with (union2.left at y, K, L with yK)
      have notL : y ∉ L
        intro yL
        exact hy2.right with (union2.right at y, K, L with yL)
      have yA := subK with y, (difference.membership.backward with hy2.left, notK)
      have yB := subL with y, (difference.membership.backward with hy2.left, notL)
      exact intersection.membership.backward with yA, yB
    have ABsub : A ∩ B ⊆ X.carrier
      intros y hy
      exact Asub with y, (intersection.membership.forward with hy).left
    have iffAB := cocompact.mem_iff_on at X, A ∩ B with space
    exact iffAB.backward with ⟨ABsub, K ∪ L, cu, sub⟩

theorem cocompact.proper_iff (X : Set)
  requires space : TopologicalSpace(X)
  shows ProperFilter(X.carrier, cocompact(X)) ↔ ¬Compact(X)
proof
  sorry

theorem cocompact.mem_iff (X B : Set)
  requires space : TopologicalSpace(X)
  shows B ∈ cocompact(X) ↔
    B ⊆ X.carrier ∧ (∃ K, Compact(X, K) ∧ X.carrier ∖ K ⊆ B)
proof
  exact cocompact.mem_iff_on with space

-- On ℝ the cocompact filter is atBot ⊔ atTop.
theorem cocompact.real
  shows cocompact(realLine) = filterSup(realAtBot, realAtTop)
proof
  sorry

-- On a discrete space the cocompact filter is the cofinite one.
theorem cocompact.discrete (X : Set)
  requires discrete : DiscreteTopology(X)
  shows cocompact(X) = cofinite(X.carrier)
proof
  sorry

-- Mathlib's tendsto_cofinite_cocompact_iff: a map from a discrete space
-- tends to the cocompact filter along the cofinite filter exactly when the
-- preimage of every compact set is finite.
theorem cocompact.tendsto_cofinite_iff (f A Y : Set)
  requires space : TopologicalSpace(Y)
  requires values : f : A → Y.carrier
  shows Tendsto(f, A, cofinite(A), cocompact(Y)) ↔
    (∀ K, Compact(Y, K) → Finite(functionPreimage(f, A, K)))
proof
  sorry

-- Mathlib's Continuous.discrete_of_tendsto_cofinite_cocompact, in the
-- form the source uses: a map from a set into a Hausdorff space under
-- which the preimage of every compact set is finite has a closed discrete
-- image.
theorem cocompact.closed_discrete_image (f A Y : Set)
  requires hausdorff : Hausdorff(Y)
  requires space : TopologicalSpace(Y)
  requires values : f : A → Y.carrier
  requires proper : Tendsto(f, A, cofinite(A), cocompact(Y))
  shows Closed(Y, imageIn(f, A, Y.carrier)) ∧
    DiscreteSubset(Y, imageIn(f, A, Y.carrier))
proof
  sorry

-- Section: Local compactness
theorem LocallyCompact.weakly (X : Set)
  requires locally : LocallyCompact(X)
  shows WeaklyLocallyCompact(X)
proof
  obtain ⟨space, small⟩ := locally
  unfold WeaklyLocallyCompact
  refine ⟨space, ?_⟩
  intros x hx
  have parts := TopologicalSpace.parts with space
  obtain ⟨subsets, whole, unions, intersections⟩ := parts
  have Cn := nhds.open_mem with space, whole, hx
  obtain ⟨K, hK, KC, compact⟩ := small with x, hx, X.carrier, Cn
  refine ⟨K, hK, compact⟩

theorem LocallyCompact.of_weakly_hausdorff (X : Set)
  requires weakly : WeaklyLocallyCompact(X)
  requires hausdorff : Hausdorff(X)
  shows LocallyCompact(X)
proof
  sorry

theorem LocallyCompact.of_compact_hausdorff (X : Set)
  requires space : TopologicalSpace(X)
  requires compact : Compact(X)
  requires hausdorff : Hausdorff(X)
  shows LocallyCompact(X)
proof
  sorry

theorem LocallyCompact.real
  shows LocallyCompact(realLine)
proof
  sorry

theorem LocallyCompact.discrete (X : Set)
  requires discrete : DiscreteTopology(X)
  shows LocallyCompact(X)
proof
  have d2 := discrete
  obtain ⟨space, opensEq⟩ := d2
  unfold LocallyCompact
  refine ⟨space, ?_⟩
  intros x hx N hN
  have ssub : {x} ⊆ X.carrier
    intros y hy
    simp at hy
    rw hy
    exact hx
  have so : {x} ∈ X.opens
    rw opensEq
    exact powerset.membership_iff.backward with ssub
  have xx : x ∈ {x} by simp
  have sn := nhds.open_mem with space, so, xx
  have xN := nhds.mem_of with space, hN
  have sub : {x} ⊆ N
    intros y hy
    simp at hy
    rw hy
    exact xN
  have compact := Compact.point at X, x with space, hx
  refine ⟨{x}, sn, sub, compact⟩

theorem LocallyCompact.product (X Y : Set)
  requires locallyX : LocallyCompact(X)
  requires locallyY : LocallyCompact(Y)
  shows LocallyCompact(productSpace(X, Y))
proof
  sorry

-- A closed subspace of a locally compact space is locally compact, and
-- an open subspace of a locally compact Hausdorff space is.
theorem LocallyCompact.closed_subspace (X A : Set)
  requires locally : LocallyCompact(X)
  requires closed : Closed(X, A)
  shows LocallyCompact(subspace(X, A))
proof
  sorry

theorem LocallyCompact.open_subspace (X U : Set)
  requires locally : LocallyCompact(X)
  requires hausdorff : Hausdorff(X)
  requires open : U ∈ X.opens
  shows LocallyCompact(subspace(X, U))
proof
  sorry

-- A compact set inside an open set has a compact neighborhood inside it
-- (Mathlib's exists_compact_between, its first half).
theorem LocallyCompact.compact_between (X K U : Set)
  requires locally : LocallyCompact(X)
  requires compact : Compact(X, K)
  requires open : U ∈ X.opens
  requires inside : K ⊆ U
  shows ∃ L, Compact(X, L) ∧ L ⊆ U ∧ K ⊆ interior(X, L)
proof
  sorry

-- Section: Discrete spaces
theorem discreteSpace.space (A X : Set)
  requires discrete : X = discreteSpace(A)
  shows TopologicalSpace(X)
proof
  rw discrete
  unfold discreteSpace
  exact TopologicalSpace.of_parts with (discreteTopology at A)

theorem discreteSpace.discrete (A X : Set)
  requires discrete : X = discreteSpace(A)
  shows DiscreteTopology(X)
proof
  have space := discreteSpace.space with discrete
  unfold DiscreteTopology
  refine ⟨space, ?_⟩
  rw discrete
  unfold discreteSpace
  topology_projections

theorem discreteSpace.carrier (A : Set)
  shows TopologicalSpace.carrier(discreteSpace(A)) = A
proof
  unfold discreteSpace
  topology_projections

theorem DiscreteTopology.continuous (f X Y : Set)
  requires discrete : DiscreteTopology(X)
  requires space : TopologicalSpace(Y)
  requires function : f : X.carrier → Y.carrier
  shows f : X ⇒ Y
proof
  obtain ⟨spaceX, opensEq⟩ := discrete
  apply Continuous.mk with spaceX, space, function
  intros V hV
  have sub := functionPreimage.subset at f, X.carrier, V
  rw opensEq
  exact powerset.membership_iff.backward with sub

theorem DiscreteTopology.singleton_open (X x : Set)
  requires discrete : DiscreteTopology(X)
  requires point : x ∈ X.carrier
  shows {x} ∈ X.opens
proof
  obtain ⟨spaceX, opensEq⟩ := discrete
  have sub : {x} ⊆ X.carrier
    intros y hy
    simp at hy
    rw hy
    exact point
  rw opensEq
  exact powerset.membership_iff.backward with sub

theorem DiscreteTopology.nhds (X x : Set)
  requires discrete : DiscreteTopology(X)
  requires point : x ∈ X.carrier
  shows nhds(X, x) = principalFilter(X.carrier, {x})
proof
  have d2 := discrete
  obtain ⟨spaceX, opensEq⟩ := d2
  have single := DiscreteTopology.singleton_open at X, x with discrete, point
  ext N
  constructor
  . intro hN
    have hN2 := nhds.membership.forward with hN
    obtain ⟨NP, U, hU, xU, UN⟩ := hN2
    apply principalFilter.membership.backward
    refine ⟨NP, ?_⟩
    intros y hy
    simp at hy
    rw hy
    exact UN with x, xU
  . intro hN
    have hN2 := principalFilter.membership.forward with hN
    obtain ⟨NP, xN⟩ := hN2
    apply nhds.membership.backward
    have xx : x ∈ {x} by simp
    exact ⟨NP, {x}, single, xx, xN⟩

theorem DiscreteTopology.compact_iff_finite (X A : Set)
  requires discrete : DiscreteTopology(X)
  requires inside : A ⊆ X.carrier
  shows Compact(X, A) ↔ Finite(A)
proof
  sorry

theorem DiscreteTopology.hausdorff (X : Set)
  requires discrete : DiscreteTopology(X)
  shows Hausdorff(X)
proof
  obtain ⟨spaceX, opensEq⟩ := discrete
  unfold Hausdorff
  rw opensEq
  exact IsHausdorff.discrete at X.carrier

theorem DiscreteTopology.subspace (X A : Set)
  requires discrete : DiscreteTopology(X)
  requires inside : A ⊆ X.carrier
  shows DiscreteTopology(subspace(X, A))
proof
  have d2 := discrete
  obtain ⟨spaceX, opensEq⟩ := d2
  have sp := subspace.space at X, A with spaceX, inside
  unfold DiscreteTopology
  refine ⟨sp, ?_⟩
  rw [subspace.opens, subspace.carrier, opensEq]
  ext U
  constructor
  . intro hU
    obtain ⟨V, hV, shape⟩ := subspaceTopology.membership.forward with hU
    apply powerset.membership_iff.backward
    rw ← shape
    exact intersection.subset_right
  . intro hU
    have UA := powerset.membership_iff.forward with hU
    have UX : U ⊆ TopologicalSpace.carrier(X)
      intros x hx
      exact inside with x, (UA with x, hx)
    apply subspaceTopology.membership.backward
    refine ⟨U, (powerset.membership_iff.backward with UX), ?_⟩
    exact intersection.eq_left_of_subset with UA

theorem DiscreteTopology.product (X Y : Set)
  requires discreteX : DiscreteTopology(X)
  requires discreteY : DiscreteTopology(Y)
  shows DiscreteTopology(productSpace(X, Y))
proof
  have dX := discreteX
  obtain ⟨spaceX, opensX⟩ := dX
  have dY := discreteY
  obtain ⟨spaceY, opensY⟩ := dY
  have sp := productSpace.space with spaceX, spaceY
  unfold DiscreteTopology
  refine ⟨sp, ?_⟩
  rw [productSpace.opens, productSpace.carrier, opensX, opensY]
  ext W
  constructor
  . intro hW
    exact (productTopology.membership.forward with hW).left
  . intro hW
    have WP := powerset.membership_iff.forward with hW
    apply productTopology.membership.backward
    refine ⟨hW, ?_⟩
    intros p hp
    have pP := WP with p, hp
    obtain ⟨bound, x, hx, y, hy, pEq⟩ := product.membership.forward with pP
    have sx : {x} ⊆ TopologicalSpace.carrier(X)
      intros z hz
      simp at hz
      rw hz
      exact hx
    have sy : {y} ⊆ TopologicalSpace.carrier(Y)
      intros z hz
      simp at hz
      rw hz
      exact hy
    have xx : x ∈ {x} by simp
    have yy : y ∈ {y} by simp
    refine ⟨{x}, (powerset.membership_iff.backward with sx), {y}, (powerset.membership_iff.backward with sy), ?_, ?_⟩
    . rw pEq
      exact product.pair with xx, yy
    . intros q hq
      obtain ⟨bound2, a, ha, b, hb, qEq⟩ := product.membership.forward with hq
      simp at ha
      simp at hb
      rw [qEq, ha, hb, ← pEq]
      exact hp

-- A discrete subset that is closed meets every compact set in a finite set.
theorem DiscreteSubset.compact_inter_finite (X A K : Set)
  requires space : TopologicalSpace(X)
  requires discrete : DiscreteSubset(X, A)
  requires closed : Closed(X, A)
  requires compact : Compact(X, K)
  shows Finite(A ∩ K)
proof
  sorry

-- The naturals are a closed discrete subset of ℝ.
theorem DiscreteSubset.integers
  shows DiscreteSubset(realLine, realNaturals) ∧
    Closed(realLine, realNaturals)
proof
  sorry

-- Section: Clopen sets
theorem Clopen.whole (X : Set)
  requires space : TopologicalSpace(X)
  shows Clopen(X, X.carrier)
proof
  have parts := TopologicalSpace.parts with space
  obtain ⟨subsets, whole, unions, intersections⟩ := parts
  unfold Clopen
  exact ⟨whole, (Closed.carrier at X with space)⟩

theorem Clopen.empty (X : Set)
  requires space : TopologicalSpace(X)
  shows Clopen(X, ∅)
proof
  have o := Open.mem at X, ∅ with space, (Open.empty_set at X with space)
  unfold Clopen
  exact ⟨o, (Closed.empty_set at X with space)⟩

theorem Clopen.complement (X U : Set)
  requires space : TopologicalSpace(X)
  requires clopen : Clopen(X, U)
  shows Clopen(X, X.carrier ∖ U)
proof
  obtain ⟨openU, closedU⟩ := clopen
  have o := Closed.compl_open at X, U with space, closedU
  have c := Open.compl_closed at X, U with space, (Open.of_mem at X, U with space, openU)
  unfold complement at o
  unfold complement at c
  unfold Clopen
  exact ⟨(Open.mem at X, X.carrier ∖ U with space, o), c⟩

theorem Clopen.inter (X U V : Set)
  requires space : TopologicalSpace(X)
  requires clopenU : Clopen(X, U)
  requires clopenV : Clopen(X, V)
  shows Clopen(X, U ∩ V)
proof
  obtain ⟨openU, closedU⟩ := clopenU
  obtain ⟨openV, closedV⟩ := clopenV
  have o := Open.inter at X, U, V with space, (Open.of_mem at X, U with space, openU), (Open.of_mem at X, V with space, openV)
  have c := Closed.inter at X, U, V with space, closedU, closedV
  unfold Clopen
  exact ⟨(Open.mem at X, U ∩ V with space, o), c⟩

theorem Clopen.union (X U V : Set)
  requires space : TopologicalSpace(X)
  requires clopenU : Clopen(X, U)
  requires clopenV : Clopen(X, V)
  shows Clopen(X, U ∪ V)
proof
  obtain ⟨openU, closedU⟩ := clopenU
  obtain ⟨openV, closedV⟩ := clopenV
  have o := Open.union at X, U, V with space, (Open.of_mem at X, U with space, openU), (Open.of_mem at X, V with space, openV)
  have c := Closed.union at X, U, V with space, closedU, closedV
  unfold Clopen
  exact ⟨(Open.mem at X, U ∪ V with space, o), c⟩

-- In a connected space the only clopen sets are ∅ and the whole space.
theorem Clopen.connected (X U : Set)
  requires space : TopologicalSpace(X)
  requires connected : Connected(X)
  requires clopen : Clopen(X, U)
  shows U = ∅ ∨ U = X.carrier
proof
  obtain ⟨openU, closedU⟩ := clopen
  exact Connected.clopen_trivial at X, U with space, connected, (Open.of_mem at X, U with space, openU), closedU

-- A set containing an open neighborhood of each of its points is open.
theorem Open.of_local (X A : Set)
  requires space : TopologicalSpace(X)
  requires local : ∀ x ∈ A, ∃ U ∈ X.opens, x ∈ U ∧ U ⊆ A
  shows A ∈ X.opens
proof
  have parts := TopologicalSpace.parts with space
  have eq : interiorIn(X.opens, A) = A
    ext x
    constructor
    . intro hx
      exact (interiorIn.subset at X.opens, A) with x, hx
    . intro hx
      exact (interiorIn.membership at X.opens, A, x).backward with (local with x, hx)
  rw ← eq
  exact interiorIn.open at X.carrier, X.opens, A with parts

-- Section: Locally constant maps
theorem IsLocallyConstant.iff_nhds (f X : Set)
  requires space : TopologicalSpace(X)
  shows IsLocallyConstant(f, X) ↔
    (∀ x ∈ X.carrier, ∃ U ∈ nhds(X, x), ∀ y ∈ U, f(y) = f(x))
proof
  sorry

theorem IsLocallyConstant.iff_fibers_open (f X Y : Set)
  requires space : TopologicalSpace(X)
  requires function : f : X.carrier → Y
  shows IsLocallyConstant(f, X) ↔
    (∀ y ∈ Y, functionPreimage(f, X.carrier, {y}) ∈ X.opens)
proof
  constructor
  . intros locally y hy
    exact locally.right with {y}
  . intro fibers
    unfold IsLocallyConstant
    refine ⟨space, ?_⟩
    intro B
    apply Open.of_local with space
    intros x hx
    have hx2 := functionPreimage.membership.forward with hx
    obtain ⟨xIn, val⟩ := hx2
    have fx := FunctionBetween.apply_closed with function, xIn
    have op := fibers with f(x), fx
    have self : f(x) ∈ {f(x)} by simp
    refine ⟨functionPreimage(f, X.carrier, {f(x)}), op, (functionPreimage.of_apply with xIn, self), ?_⟩
    intros z hz
    have hz2 := functionPreimage.membership.forward with hz
    obtain ⟨zIn, zval⟩ := hz2
    simp at zval
    apply functionPreimage.of_apply with zIn
    rw zval
    exact val

theorem IsLocallyConstant.continuous (f X Y : Set)
  requires locally : IsLocallyConstant(f, X)
  requires space : TopologicalSpace(Y)
  requires function : f : X.carrier → Y.carrier
  shows f : X ⇒ Y
proof
  obtain ⟨spaceX, pre⟩ := locally
  have fn := function
  apply Continuous.mk with spaceX, space, fn
  intros V hV
  exact pre with V

theorem IsLocallyConstant.const (X c : Set)
  requires space : TopologicalSpace(X)
  shows IsLocallyConstant(X.carrier × {c}, X)
proof
  have parts := TopologicalSpace.parts with space
  obtain ⟨subsets, whole, unions, intersections⟩ := parts
  have cc : c ∈ {c} by simp
  have same : X.carrier × {c} = constantFunction(X.carrier, {c}, c)
    ext p
    constructor
    . intro hp
      obtain ⟨bound, x, hx, y, hy, pEq⟩ := product.membership.forward with hp
      simp at hy
      apply constantFunction.membership.backward
      refine ⟨hp, x, hx, ?_⟩
      rw [pEq, hy]
    . intro hp
      exact (constantFunction.membership.forward with hp).left
  unfold IsLocallyConstant
  refine ⟨space, ?_⟩
  intro B
  rw same
  by_cases cB : c ∈ B
  . have eq : functionPreimage(constantFunction(X.carrier, {c}, c), X.carrier, B) = X.carrier
      ext x
      constructor
      . intro hx
        exact (functionPreimage.membership.forward with hx).left
      . intro hx
        apply functionPreimage.of_apply with hx
        rw constantFunction.apply at X.carrier, {c}, x, c with hx, cc
        exact cB
    rw eq
    exact whole
  . have eq : functionPreimage(constantFunction(X.carrier, {c}, c), X.carrier, B) = ∅
      ext x
      constructor
      . intro hx
        have hx2 := functionPreimage.membership.forward with hx
        obtain ⟨xIn, val⟩ := hx2
        rw constantFunction.apply at X.carrier, {c}, x, c with xIn, cc at val
        exfalso
        exact cB with val
      . intro hx
        exfalso
        exact set.empty with hx
    rw eq
    exact Open.mem at X, ∅ with space, (Open.empty_set at X with space)

theorem IsLocallyConstant.discrete (f X : Set)
  requires discrete : DiscreteTopology(X)
  shows IsLocallyConstant(f, X)
proof
  have d2 := discrete
  obtain ⟨spaceX, opensEq⟩ := d2
  unfold IsLocallyConstant
  refine ⟨spaceX, ?_⟩
  intro B
  have sub := functionPreimage.subset at f, X.carrier, B
  rw opensEq
  exact powerset.membership_iff.backward with sub

-- Into a discrete space, locally constant is continuous.
theorem IsLocallyConstant.iff_continuous_discrete (f X Y : Set)
  requires space : TopologicalSpace(X)
  requires discrete : DiscreteTopology(Y)
  requires function : f : X.carrier → Y.carrier
  shows IsLocallyConstant(f, X) ↔ f : X ⇒ Y
proof
  have d2 := discrete
  obtain ⟨spaceY, opensY⟩ := d2
  constructor
  . intro locally
    exact IsLocallyConstant.continuous with locally, spaceY, function
  . intro cont
    have engine := Continuous.parts with cont
    unfold IsLocallyConstant
    refine ⟨space, ?_⟩
    intro B
    have sub : B ∩ Y.carrier ⊆ Y.carrier by exact intersection.subset_right
    have openB : B ∩ Y.carrier ∈ Y.opens
      rw opensY
      exact powerset.membership_iff.backward with sub
    have pre := ContinuousMap.preimage with engine, openB
    have eq : functionPreimage(f, X.carrier, B) = functionPreimage(f, X.carrier, B ∩ Y.carrier)
      ext x
      constructor
      . intro hx
        have hx2 := functionPreimage.membership.forward with hx
        obtain ⟨xIn, val⟩ := hx2
        apply functionPreimage.of_apply with xIn
        have fx := FunctionBetween.apply_closed with function, xIn
        exact intersection.membership.backward with ⟨val, fx⟩
      . intro hx
        have hx2 := functionPreimage.membership.forward with hx
        obtain ⟨xIn, val⟩ := hx2
        apply functionPreimage.of_apply with xIn
        exact (intersection.membership.forward with val).left
    rw eq
    exact pre

-- Composition on the left keeps local constancy.
theorem IsLocallyConstant.comp (f g h X Y : Set)
  requires locally : IsLocallyConstant(f, X)
  requires function : f : X.carrier → Y
  requires values : ∀ x ∈ X.carrier, h(x) = g(f(x))
  shows IsLocallyConstant(h, X)
proof
  obtain ⟨spaceX, pre⟩ := locally
  unfold IsLocallyConstant
  refine ⟨spaceX, ?_⟩
  intro B
  have eq : functionPreimage(h, X.carrier, B) = functionPreimage(f, X.carrier, functionPreimage(g, Y, B))
    ext x
    constructor
    . intro hx
      have hx2 := functionPreimage.membership.forward with hx
      have v := values with x, hx2.left
      have fx := FunctionBetween.apply_closed with function, hx2.left
      have gB := hx2.right
      rw v at gB
      exact functionPreimage.of_apply with hx2.left, (functionPreimage.of_apply with fx, gB)
    . intro hx
      have hx2 := functionPreimage.membership.forward with hx
      have hx3 := functionPreimage.membership.forward with hx2.right
      have v := values with x, hx2.left
      apply functionPreimage.of_apply with hx2.left
      rw v
      exact hx3.right
  rw eq
  exact pre with functionPreimage(g, Y, B)

-- Two locally constant maps combine: x ↦ (f(x), g(x)) is locally constant.
theorem IsLocallyConstant.pair (f g h X : Set)
  requires locallyF : IsLocallyConstant(f, X)
  requires locallyG : IsLocallyConstant(g, X)
  requires values : ∀ x ∈ X.carrier, h(x) = (f(x), g(x))
  shows IsLocallyConstant(h, X)
proof
  have lf := locallyF
  obtain ⟨space, preF⟩ := lf
  have lg := locallyG
  obtain ⟨space2, preG⟩ := lg
  have parts := TopologicalSpace.parts with space
  obtain ⟨subsets, whole, unions, intersections⟩ := parts
  unfold IsLocallyConstant
  refine ⟨space, ?_⟩
  intro B
  apply Open.of_local with space
  intros x hx
  have hx2 := functionPreimage.membership.forward with hx
  obtain ⟨xIn, val⟩ := hx2
  have oF := preF with {f(x)}
  have oG := preG with {g(x)}
  have oFG := intersections with functionPreimage(f, X.carrier, {f(x)}), oF, functionPreimage(g, X.carrier, {g(x)}), oG
  have s1 : f(x) ∈ {f(x)} by simp
  have s2 : g(x) ∈ {g(x)} by simp
  have xF := functionPreimage.of_apply with xIn, s1
  have xG := functionPreimage.of_apply with xIn, s2
  refine ⟨functionPreimage(f, X.carrier, {f(x)}) ∩ functionPreimage(g, X.carrier, {g(x)}), oFG, (intersection.membership.backward with ⟨xF, xG⟩), ?_⟩
  intros z hz
  have hz2 := intersection.membership.forward with hz
  have zf := functionPreimage.membership.forward with hz2.left
  have zg := functionPreimage.membership.forward with hz2.right
  obtain ⟨zIn, fz⟩ := zf
  obtain ⟨zIn2, gz⟩ := zg
  simp at fz
  simp at gz
  apply functionPreimage.of_apply with zIn
  have hzv := values with z, zIn
  have hxv := values with x, xIn
  rw [hzv, fz, gz, ← hxv]
  exact val

-- On a compact space a locally constant map takes finitely many values.
theorem IsLocallyConstant.finite_range (f X Y : Set)
  requires locally : IsLocallyConstant(f, X)
  requires compact : Compact(X)
  requires function : f : X.carrier → Y
  shows Finite(imageIn(f, X.carrier, Y))
proof
  sorry

-- On a connected space a locally constant map is constant.
theorem IsLocallyConstant.constant (f X : Set)
  requires locally : IsLocallyConstant(f, X)
  requires connected : Connected(X)
  shows ∀ x ∈ X.carrier, ∀ y ∈ X.carrier, f(x) = f(y)
proof
  sorry

-- Section: Totally disconnected and profinite spaces
theorem TotallyDisconnected.discrete (X : Set)
  requires discrete : DiscreteTopology(X)
  shows TotallyDisconnected(X)
proof
  sorry

theorem TotallyDisconnected.subspace (X A : Set)
  requires totally : TotallyDisconnected(X)
  requires inside : A ⊆ X.carrier
  shows TotallyDisconnected(subspace(X, A))
proof
  sorry

theorem TotallyDisconnected.product (X Y : Set)
  requires totallyX : TotallyDisconnected(X)
  requires totallyY : TotallyDisconnected(Y)
  shows TotallyDisconnected(productSpace(X, Y))
proof
  sorry

-- In a compact Hausdorff totally disconnected space the clopen sets form
-- a basis: every open neighborhood of a point contains a clopen one.
theorem Profinite.clopen_basis (X U x : Set)
  requires profinite : Profinite(X)
  requires open : U ∈ X.opens
  requires point : x ∈ U
  shows ∃ V, Clopen(X, V) ∧ x ∈ V ∧ V ⊆ U
proof
  sorry

-- Every clopen subset of a profinite space is compact.
theorem Profinite.clopen_compact (X U : Set)
  requires profinite : Profinite(X)
  requires clopen : Clopen(X, U)
  shows Compact(X, U)
proof
  sorry

theorem Profinite.finite_discrete (X : Set)
  requires discrete : DiscreteTopology(X)
  requires finite : Finite(X.carrier)
  shows Profinite(X)
proof
  sorry

theorem Profinite.closed_subspace (X A : Set)
  requires profinite : Profinite(X)
  requires closed : Closed(X, A)
  shows Profinite(subspace(X, A))
proof
  sorry

theorem Profinite.product (X Y : Set)
  requires profiniteX : Profinite(X)
  requires profiniteY : Profinite(Y)
  shows Profinite(productSpace(X, Y))
proof
  sorry

-- A locally constant map on a profinite space factors through a finite
-- partition into clopen sets.
theorem Profinite.locally_constant_partition (f X : Set)
  requires profinite : Profinite(X)
  requires locally : IsLocallyConstant(f, X)
  shows ∃ P, Finite(P) ∧ (∀ V ∈ P, Clopen(X, V) ∧ Nonempty(V)) ∧
    (∀ x ∈ X.carrier, ∃ V ∈ P, x ∈ V) ∧
    (∀ V ∈ P, ∀ W ∈ P, V ≠ W → Disjoint(V, W)) ∧
    (∀ V ∈ P, ∀ x ∈ V, ∀ y ∈ V, f(x) = f(y))
proof
  sorry

-- Section: Compact spaces and real-valued maps
-- The extreme value theorem: a continuous real map on a nonempty compact
-- set attains its maximum and its minimum.
theorem Compact.exists_max (f X K : Set)
  requires continuous : f : X ⇒ realLine
  requires compact : Compact(X, K)
  requires nonempty : Nonempty(K)
  shows ∃ x ∈ K, ∀ y ∈ K, f(y) ≤ f(x)
proof
  sorry

theorem Compact.exists_min (f X K : Set)
  requires continuous : f : X ⇒ realLine
  requires compact : Compact(X, K)
  requires nonempty : Nonempty(K)
  shows ∃ x ∈ K, ∀ y ∈ K, f(x) ≤ f(y)
proof
  sorry

theorem Compact.bounded (f X K : Set)
  requires continuous : f : X ⇒ realLine
  requires compact : Compact(X, K)
  shows ∃ B ∈ ℝ, ∀ y ∈ K, abs(f(y)) ≤ B
proof
  sorry

-- A positive continuous function on a compact set has a positive lower
-- bound there.
theorem Compact.positive_lower_bound (f X K : Set)
  requires continuous : f : X ⇒ realLine
  requires compact : Compact(X, K)
  requires positive : ∀ y ∈ K, realZero < f(y)
  shows ∃ c ∈ ℝ, realZero < c ∧ (∀ y ∈ K, c ≤ f(y))
proof
  sorry

-- Heine–Cantor for metric spaces: continuous maps on compact metric
-- spaces are uniformly continuous.
theorem Compact.uniformly_continuous (f M N : Set)
  requires metricM : MetricSpace(M)
  requires metricN : MetricSpace(N)
  requires compact : Compact(metricTopology(M))
  requires continuous : f : metricTopology(M) ⇒ metricTopology(N)
  shows ∀ e ∈ ℝ, realZero < e → ∃ d ∈ ℝ, realZero < d ∧
    (∀ x ∈ M.carrier, ∀ y ∈ M.carrier, M.dist(x, y) < d →
      N.dist(f(x), f(y)) < e)
proof
  sorry

-- A compact subset of a metric space is closed and bounded.
theorem Compact.metric_bounded (M K : Set)
  requires metric : MetricSpace(M)
  requires compact : Compact(metricTopology(M), K)
  shows ∀ x ∈ M.carrier, ∃ r ∈ ℝ, K ⊆ ball(M, x, r)
proof
  sorry

-- A continuous bijection from a compact space onto a Hausdorff space is a
-- homeomorphism (Cumulus's IsHomeomorphism.compact_hausdorff, bundled).
theorem Compact.homeomorphism (f X Y : Set)
  requires continuous : f : X ⇒ Y
  requires compact : Compact(X)
  requires hausdorff : Hausdorff(Y)
  requires bijective : BijectiveBetween(f, X.carrier, Y.carrier)
  shows Homeomorphism(f, X, Y)
proof
  have spaceX := Continuous.source with continuous
  have spaceY := Continuous.target with continuous
  have partsX := TopologicalSpace.parts with spaceX
  have partsY := TopologicalSpace.parts with spaceY
  have cpt := Compact.space_parts with compact
  have haus := Hausdorff.parts with hausdorff
  have engine := Continuous.parts with continuous
  have homeo := IsHomeomorphism.compact_hausdorff with partsX, partsY, cpt, haus, bijective, engine
  exact Homeomorphism.of_parts with spaceX, spaceY, homeo

end Compactness
