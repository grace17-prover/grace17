-- Authors: Grant Passmore

module GRH.Topology.Compactness
import GRH.Topology.Filters

section Compactness
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Section: Definitions
-- The cocompact filter: the subsets of the carrier containing the
-- complement of a compact set (Mathlib's Filter.cocompact).
def cocompact (X : Set) : Set :=
  { B ∈ 𝒫(TopologicalSpace.carrier(X)) | ∃ K ∈ 𝒫(TopologicalSpace.carrier(X)),
    Compact(X, K) ∧ TopologicalSpace.carrier(X) ∖ K ⊆ B }

-- Every neighborhood of every point contains a compact neighborhood
-- (Mathlib's LocallyCompactSpace); every point has a compact neighborhood
-- (WeaklyLocallyCompactSpace).
predicate LocallyCompact (X : Set) :=
  TopologicalSpace(X) ∧
  (∀ x ∈ TopologicalSpace.carrier(X), ∀ N ∈ nhds(X, x),
    ∃ K ∈ nhds(X, x), K ⊆ N ∧ Compact(X, K))
predicate WeaklyLocallyCompact (X : Set) :=
  TopologicalSpace(X) ∧
  (∀ x ∈ TopologicalSpace.carrier(X), ∃ K ∈ nhds(X, x), Compact(X, K))

-- The discrete space on A, and the property of a space that every subset
-- of its carrier is open (Mathlib's DiscreteTopology).
def discreteSpace (A : Set) : Set := TopologicalSpace.mk(A, 𝒫(A))
predicate DiscreteTopology (X : Set) :=
  TopologicalSpace(X) ∧
  TopologicalSpace.opens(X) = 𝒫(TopologicalSpace.carrier(X))

-- A subset is discrete when every point of it is isolated in it.
predicate DiscreteSubset (X A : Set) :=
  A ⊆ TopologicalSpace.carrier(X) ∧
  (∀ a ∈ A, ∃ U ∈ TopologicalSpace.opens(X), U ∩ A = {a})

predicate Clopen (X U : Set) :=
  U ∈ TopologicalSpace.opens(X) ∧ Closed(X, U)

-- f is locally constant on X: the preimage in X of every set is open
-- (Mathlib's IsLocallyConstant); only the values on the carrier are read.
predicate IsLocallyConstant (f X : Set) :=
  TopologicalSpace(X) ∧
  (∀ B, functionPreimage(f, TopologicalSpace.carrier(X), B) ∈
    TopologicalSpace.opens(X))

-- Every connected subset has at most one point; a profinite space is
-- compact, Hausdorff, and totally disconnected.
predicate TotallyDisconnected (X : Set) :=
  TopologicalSpace(X) ∧
  (∀ A, ConnectedSubset(X, A) → ∀ a ∈ A, ∀ b ∈ A, a = b)
predicate Profinite (X : Set) :=
  TopologicalSpace(X) ∧ Compact(X) ∧ Hausdorff(X) ∧ TotallyDisconnected(X)

-- The image of a set under f, as a subset of the codomain's carrier, and
-- the naturals inside ℝ.
def imageIn (f A Y : Set) : Set := { y ∈ Y | ∃ x ∈ A, y = f(x) }
def realNaturals : Set := { realNat(n) | n ∈ ℕ }

-- Helpers for Compact.iff_cluster: the open sets missing a member of F,
-- finite families of them missing one common member, and the filter of
-- the sets containing what a finite part of a cover leaves of A.
def cptMissing (X F : Set) : Set :=
  { U ∈ TopologicalSpace.opens(X) | ∃ B ∈ F, ∀ y ∈ U, y ∉ B }
def cptMissingFamilies (F G0 : Set) : Set :=
  { G ∈ 𝒫(G0) | ∃ B ∈ F, ∀ U ∈ G, ∀ y ∈ U, y ∉ B }
def cptCoverFilter (X A C : Set) : Set :=
  { B ∈ 𝒫(TopologicalSpace.carrier(X)) |
    ∃ G, G ⊆ C ∧ Finite(G) ∧ A ∖ ⋃(G) ⊆ B }

theorem cptMissing.common (S F G0 : Set)
  requires filter : IsFilter(S, F)
  requires each : ∀ U ∈ G0, ∃ B ∈ F, ∀ y ∈ U, y ∉ B
  requires finite : Finite(G0)
  shows ∃ B ∈ F, ∀ U ∈ G0, ∀ y ∈ U, y ∉ B
proof
  have base : ∅ ∈ cptMissingFamilies(F, G0)
    obtain ⟨FP, SF, up, inter⟩ := filter
    apply cptMissingFamilies.membership.backward
    refine ⟨(powerset.membership_iff.backward with (empty.subset at G0)), S, SF, ?_⟩
    intros U hU
    simp at hU
  have step : ∀ G ⊆ G0, Finite(G) → ∀ W ∈ G0, W ∉ G →
      G ∈ cptMissingFamilies(F, G0) → G ∪ {W} ∈ cptMissingFamilies(F, G0)
    intros G hG finiteG W hW fresh known
    obtain ⟨_, B, hB, missB⟩ := cptMissingFamilies.membership.forward with known
    obtain ⟨B2, hB2, missB2⟩ := each with W, hW
    obtain ⟨FP, SF, up, inter⟩ := filter
    have BB := inter with B, hB, B2, hB2
    have bound : G ∪ {W} ⊆ G0
      intros Z hZ
      cases (union2.membership.forward with hZ) with inG | isW
      . exact hG with Z, inG
      . rwa (singleton.membership.forward with isW)
    apply cptMissingFamilies.membership.backward
    refine ⟨(powerset.membership_iff.backward with bound), B ∩ B2, BB, ?_⟩
    intros U hU y hy yIn
    obtain ⟨yB, yB2⟩ := intersection.membership.forward with yIn
    cases (union2.membership.forward with hU) with inG | isW
    . exact (missB with U, inG, y, hy) with yB
    . have UW := singleton.membership.forward with isW
      rw UW at hy
      exact (missB2 with y, hy) with yB2
  have all := Finite.induction with base, step
  have member := all with G0, (Subset.reflexive at G0), finite
  obtain ⟨_, rest⟩ := cptMissingFamilies.membership.forward with member
  exact rest

theorem cptCoverFilter.proper (X A C : Set)
  requires inside : A ⊆ X.carrier
  requires noFinite : ¬(∃ G, G ⊆ C ∧ Finite(G) ∧ A ⊆ ⋃(G))
  shows ProperFilter(X.carrier, cptCoverFilter(X, A, C))
proof
  unfold ProperFilter
  refine ⟨?_, ?_⟩
  . unfold IsFilter
    refine ⟨?_, ?_, ?_, ?_⟩
    . intros B hB
      exact (cptCoverFilter.membership.forward with hB).left
    . apply cptCoverFilter.membership.backward
      refine ⟨(powerset.membership_iff.backward with (Subset.reflexive at X.carrier)), ∅, (empty.subset at C), Finite.empty, ?_⟩
      intros y hy
      exact inside with y, (difference.membership.forward with hy).left
    . intros B hB B2 sub B2X
      obtain ⟨_, G, GC, finG, AG⟩ := cptCoverFilter.membership.forward with hB
      apply cptCoverFilter.membership.backward
      refine ⟨(powerset.membership_iff.backward with B2X), G, GC, finG, (Subset.transitive with AG, sub)⟩
    . intros B hB B2 hB2
      obtain ⟨BP, G, GC, finG, AG⟩ := cptCoverFilter.membership.forward with hB
      obtain ⟨_, G2, GC2, finG2, AG2⟩ := cptCoverFilter.membership.forward with hB2
      have GG : G ∪ G2 ⊆ C
        intros Z hZ
        cases (union2.membership.forward with hZ) with inG | inG2
        . exact GC with Z, inG
        . exact GC2 with Z, inG2
      have BX := powerset.membership_iff.forward with BP
      have interX : B ∩ B2 ⊆ X.carrier
        intros y hy
        exact BX with y, (intersection.membership.forward with hy).left
      apply cptCoverFilter.membership.backward
      refine ⟨(powerset.membership_iff.backward with interX), G ∪ G2, GG, (Finite.union with finG, finG2), ?_⟩
      intros y hy
      obtain ⟨yA, yNot⟩ := difference.membership.forward with hy
      have n1 : y ∉ ⋃(G)
        intro yG
        obtain ⟨U, hU, yU⟩ := union.membership.forward with yG
        exact yNot with (union.membership.backward with ⟨U, (union2.left with hU), yU⟩)
      have n2 : y ∉ ⋃(G2)
        intro yG
        obtain ⟨U, hU, yU⟩ := union.membership.forward with yG
        exact yNot with (union.membership.backward with ⟨U, (union2.right with hU), yU⟩)
      have y1 := AG with y, (difference.membership.backward with yA, n1)
      have y2 := AG2 with y, (difference.membership.backward with yA, n2)
      exact intersection.membership.backward with y1, y2
  . intro emptyIn
    obtain ⟨_, G, GC, finG, AG⟩ := cptCoverFilter.membership.forward with emptyIn
    apply noFinite
    refine ⟨G, GC, finG, ?_⟩
    intros y yA
    by_contra notIn
    have yE := AG with y, (difference.membership.backward with yA, notIn)
    simp at yE

-- A compact set each of whose points has an open neighborhood meeting A
-- in a finite set meets A in a finite set.
def cptFiniteMeets (A F : Set) : Set := { G ∈ 𝒫(F) | Finite(A ∩ ⋃(G)) }
def cptLocallyFinite (X A : Set) : Set :=
  { U ∈ TopologicalSpace.opens(X) | Finite(U ∩ A) }

theorem cptFiniteMeets.union (A F : Set)
  requires finite : Finite(F)
  requires each : ∀ W ∈ F, Finite(W ∩ A)
  shows Finite(A ∩ ⋃(F))
proof
  have base : ∅ ∈ cptFiniteMeets(A, F)
    apply cptFiniteMeets.membership.backward
    refine ⟨(powerset.membership_iff.backward with (empty.subset at F)), ?_⟩
    have sub : A ∩ ⋃(∅) ⊆ ∅
      intros y hy
      obtain ⟨yA, yU⟩ := intersection.membership.forward with hy
      obtain ⟨U, hU, _⟩ := union.membership.forward with yU
      simp at hU
    exact Finite.subset with Finite.empty, sub
  have step : ∀ G ⊆ F, Finite(G) → ∀ W ∈ F, W ∉ G →
      G ∈ cptFiniteMeets(A, F) → G ∪ {W} ∈ cptFiniteMeets(A, F)
    intros G hG finiteG W hW fresh known
    obtain ⟨_, finG⟩ := cptFiniteMeets.membership.forward with known
    have finW := each with W, hW
    have bound : G ∪ {W} ⊆ F
      intros Z hZ
      cases (union2.membership.forward with hZ) with inG | isW
      . exact hG with Z, inG
      . rwa (singleton.membership.forward with isW)
    have sub : A ∩ ⋃(G ∪ {W}) ⊆ (A ∩ ⋃(G)) ∪ (W ∩ A)
      intros y hy
      obtain ⟨yA, yU⟩ := intersection.membership.forward with hy
      obtain ⟨U, hU, yInU⟩ := union.membership.forward with yU
      cases (union2.membership.forward with hU) with inG | isW
      . apply union2.left
        exact intersection.membership.backward with yA, (union.membership.backward with ⟨U, inG, yInU⟩)
      . apply union2.right
        rw (singleton.membership.forward with isW) at yInU
        exact intersection.membership.backward with yInU, yA
    apply cptFiniteMeets.membership.backward
    refine ⟨(powerset.membership_iff.backward with bound), ?_⟩
    exact Finite.subset with (Finite.union with finG, finW), sub
  have all := Finite.induction with base, step
  have member := all with F, (Subset.reflexive at F), finite
  exact (cptFiniteMeets.membership.forward with member).right

theorem cptCompact.finite_of_local (X K A : Set)
  requires compact : Compact(X, K)
  requires local : ∀ x ∈ K, ∃ U ∈ X.opens, x ∈ U ∧ Finite(U ∩ A)
  shows Finite(A ∩ K)
proof
  have ic := compact
  unfold Compact at ic
  have cover : OpenCover(X.opens, K, cptLocallyFinite(X, A))
    unfold OpenCover
    constructor
    . intros U hU
      exact (cptLocallyFinite.membership.forward with hU).left
    . intros x hx
      obtain ⟨U, hU, xU, finU⟩ := local with x, hx
      have mem : U ∈ cptLocallyFinite(X, A)
        apply cptLocallyFinite.membership.backward
        exact ⟨hU, finU⟩
      exact union.membership.backward with ⟨U, mem, xU⟩
  obtain ⟨G, GC, finG, KG⟩ := IsCompact.subcover with ic, cover
  have each : ∀ W ∈ G, Finite(W ∩ A)
    intros W hW
    exact (cptLocallyFinite.membership.forward with (GC with W, hW)).right
  have fin := cptFiniteMeets.union with finG, each
  have sub : A ∩ K ⊆ A ∩ ⋃(G)
    intros y hy
    obtain ⟨yA, yK⟩ := intersection.membership.forward with hy
    exact intersection.membership.backward with yA, (KG with y, yK)
  exact Finite.subset with fin, sub

-- Section: Compactness through filters
-- A is compact exactly when every proper filter containing A clusters at
-- a point of A. No ultrafilter, and so no choice, is involved.
theorem Compact.iff_cluster (X A : Set)
  requires space : TopologicalSpace(X)
  requires inside : A ⊆ X.carrier
  shows Compact(X, A) ↔
    (∀ F, ProperFilter(X.carrier, F) → A ∈ F → ∃ x ∈ A, ClusterPt(X, x, F))
proof
  constructor
  . intro compact
    intros F prop AF
    have prop2 := prop
    obtain ⟨filt, noEmpty⟩ := prop2
    by_contra none
    have each : ∀ x ∈ A, ∃ U ∈ X.opens, x ∈ U ∧ (∃ B ∈ F, ∀ y ∈ U, y ∉ B)
      intros x hx
      have xX := inside with x, hx
      by_contra noU
      apply none
      refine ⟨x, hx, ?_⟩
      unfold ClusterPt
      refine ⟨xX, ?_⟩
      have nf := nhds.is_filter at X, x with space, xX
      have nff := nf.left
      have inff := filterInf.is_filter at X.carrier, nhds(X, x), F with nff, filt
      unfold ProperFilter
      refine ⟨inff, ?_⟩
      intro emptyIn
      obtain ⟨_, N, hN, B, hB, NB⟩ := filterInf.membership.forward with emptyIn
      obtain ⟨_, U, hU, xU, UN⟩ := nhds.membership.forward with hN
      apply noU
      refine ⟨U, hU, xU, B, hB, ?_⟩
      intros y hy yB
      have yN := UN with y, hy
      have yNB := NB with y, (intersection.membership.backward with yN, yB)
      simp at yNB
    have cover : OpenCover(X.opens, A, cptMissing(X, F))
      unfold OpenCover
      constructor
      . intros U hU
        exact (cptMissing.membership.forward with hU).left
      . intros x hx
        obtain ⟨U, hU, xU, rest⟩ := each with x, hx
        have mem : U ∈ cptMissing(X, F)
          apply cptMissing.membership.backward
          exact ⟨hU, rest⟩
        exact union.membership.backward with ⟨U, mem, xU⟩
    have ic := compact
    unfold Compact at ic
    obtain ⟨G, GC, finG, AG⟩ := IsCompact.subcover with ic, cover
    have eachG : ∀ U ∈ G, ∃ B ∈ F, ∀ y ∈ U, y ∉ B
      intros U hU
      exact (cptMissing.membership.forward with (GC with U, hU)).right
    obtain ⟨B, hB, disj⟩ := cptMissing.common with filt, eachG, finG
    obtain ⟨FP, XF, up, inter⟩ := filt
    have AB := inter with A, AF, B, hB
    have sub : A ∩ B ⊆ ∅
      intros y hy
      obtain ⟨yA, yB⟩ := intersection.membership.forward with hy
      obtain ⟨U, hU, yU⟩ := union.membership.forward with (AG with y, yA)
      exfalso
      exact (disj with U, hU, y, yU) with yB
    have eIn := up with A ∩ B, AB, ∅, sub, (empty.subset at X.carrier)
    exact noEmpty with eIn
  . intro clusters
    unfold Compact
    unfold IsCompact
    refine ⟨inside, ?_⟩
    intros C cover
    by_contra noFin
    have prop := cptCoverFilter.proper at X, A, C with inside, noFin
    have AIn : A ∈ cptCoverFilter(X, A, C)
      apply cptCoverFilter.membership.backward
      refine ⟨(powerset.membership_iff.backward with inside), ∅, (empty.subset at C), Finite.empty, ?_⟩
      intros y hy
      exact (difference.membership.forward with hy).left
    obtain ⟨x, xA, cl⟩ := clusters with cptCoverFilter(X, A, C), prop, AIn
    obtain ⟨CT, AC⟩ := cover
    obtain ⟨U, UC, xU⟩ := union.membership.forward with (AC with x, xA)
    have Uopen := CT with U, UC
    obtain ⟨xX, infProp⟩ := cl
    obtain ⟨_, noE⟩ := infProp
    apply noE
    have UN := nhds.open_mem at X, x, U with space, Uopen, xU
    have compX : X.carrier ∖ U ⊆ X.carrier
      intros y hy
      exact (difference.membership.forward with hy).left
    have UsingC : {U} ⊆ C
      intros Z hZ
      rwa (singleton.membership.forward with hZ)
    have BIn : X.carrier ∖ U ∈ cptCoverFilter(X, A, C)
      apply cptCoverFilter.membership.backward
      refine ⟨(powerset.membership_iff.backward with compX), {U}, UsingC, (Finite.singleton at U), ?_⟩
      intros y hy
      obtain ⟨yA, yNot⟩ := difference.membership.forward with hy
      have yNotU : y ∉ U
        intro yU
        exact yNot with (union.membership.backward with ⟨U, (singleton.membership.backward with rfl), yU⟩)
      exact difference.membership.backward with (inside with y, yA), yNotU
    apply filterInf.membership.backward
    refine ⟨(powerset.membership_iff.backward with (empty.subset at X.carrier)), U, UN, X.carrier ∖ U, BIn, ?_⟩
    intros y hy
    obtain ⟨yU, yC⟩ := intersection.membership.forward with hy
    exfalso
    exact (difference.membership.forward with yC).right with yU

-- Helpers for the family form of the subcover property: the family of
-- the sets U(i), and finite subfamilies of it, each set named by an index.
def cptFamily (I U : Set) : Set := { U(i) | i ∈ I }
def cptNamed (I U F : Set) : Set :=
  { G ∈ 𝒫(F) | ∃ J, J ⊆ I ∧ Finite(J) ∧ (∀ V ∈ G, ∃ i ∈ J, V = U(i)) }

theorem cptFamily.finite_indices (I U F : Set)
  requires inside : F ⊆ cptFamily(I, U)
  requires finite : Finite(F)
  shows ∃ J, J ⊆ I ∧ Finite(J) ∧ (∀ V ∈ F, ∃ i ∈ J, V = U(i))
proof
  have base : ∅ ∈ cptNamed(I, U, F)
    apply cptNamed.membership.backward
    refine ⟨(powerset.membership_iff.backward with (empty.subset at F)), ∅,
      (empty.subset at I), Finite.empty, ?_⟩
    intros P hP
    simp at hP
  have step : ∀ G ⊆ F, Finite(G) → ∀ W ∈ F, W ∉ G →
      G ∈ cptNamed(I, U, F) → G ∪ {W} ∈ cptNamed(I, U, F)
    intros G hG finiteG W hW fresh known
    obtain ⟨_, J, hJ, finiteJ, found⟩ := cptNamed.membership.forward with known
    obtain ⟨k, hk, shape⟩ := cptFamily.membership.forward with (inside with W, hW)
    have bound : G ∪ {W} ⊆ F
      intros Z hZ
      cases (union2.membership.forward with hZ) with inG | isW
      . exact hG with Z, inG
      . rwa (singleton.membership.forward with isW)
    apply cptNamed.membership.backward
    refine ⟨(powerset.membership_iff.backward with bound), J ∪ {k}, ?_,
      (Finite.union with finiteJ, (Finite.singleton at k)), ?_⟩
    . intros Z hZ
      cases (union2.membership.forward with hZ) with inJ | isk
      . exact hJ with Z, inJ
      . rwa (singleton.membership.forward with isk)
    . intros P hP
      cases (union2.membership.forward with hP) with inG | isW
      . obtain ⟨i, hi, eq⟩ := found with P, inG
        exact ⟨i, (union2.left with hi), eq⟩
      . have member : k ∈ J ∪ {k} :=
          union2.right with (singleton.membership.backward with rfl)
        rw (singleton.membership.forward with isW)
        rw ← shape
        exact ⟨k, member, rfl⟩
  have all := Finite.induction with base, step
  have member := all with F, (Subset.reflexive at F), finite
  obtain ⟨_, rest⟩ := cptNamed.membership.forward with member
  exact rest

-- Mathlib's IsCompact.elim_finite_subcover in the family form: an open
-- cover indexed by I has a finite subfamily that covers.
theorem Compact.finite_subcover (X K I U : Set)
  requires compact : Compact(X, K)
  requires open : ∀ i ∈ I, U(i) ∈ X.opens
  requires covers : ∀ x ∈ K, ∃ i ∈ I, x ∈ U(i)
  shows ∃ J ⊆ I, Finite(J) ∧ (∀ x ∈ K, ∃ i ∈ J, x ∈ U(i))
proof
  have ic := compact
  unfold Compact at ic
  have cover : OpenCover(X.opens, K, cptFamily(I, U))
    unfold OpenCover
    constructor
    . intros V hV
      obtain ⟨i, hi, eq⟩ := cptFamily.membership.forward with hV
      rw ← eq
      exact open with i, hi
    . intros x hx
      obtain ⟨i, hi, xi⟩ := covers with x, hx
      have mem : U(i) ∈ cptFamily(I, U)
        apply cptFamily.membership.backward
        exact ⟨i, hi, rfl⟩
      exact union.membership.backward with ⟨U(i), mem, xi⟩
  obtain ⟨F, FC, finF, KF⟩ := IsCompact.subcover with ic, cover
  obtain ⟨J, JI, finJ, named⟩ := cptFamily.finite_indices with FC, finF
  refine ⟨J, JI, finJ, ?_⟩
  intros x hx
  obtain ⟨V, hV, xV⟩ := union.membership.forward with (KF with x, hx)
  obtain ⟨i, hi, eq⟩ := named with V, hV
  rw eq at xV
  exact ⟨i, hi, xV⟩

-- The complements of a sequence of sets, as a sequence.
defgraph cptComplements (X C : Set) (n ∈ ℕ) : 𝒫(TopologicalSpace.carrier(X)) :=
  complement(TopologicalSpace.carrier(X), C(n))
proof
  apply powerset.membership_iff.backward
  intros y hy
  exact (complement.membership.forward with hy).left

-- Mathlib's IsCompact.elim_directed_cover: a cover by an increasing
-- sequence of open sets is covered by one of them.
theorem Compact.directed_cover (X K U : Set)
  requires compact : Compact(X, K)
  requires open : ∀ n ∈ ℕ, U(n) ∈ X.opens
  requires increasing : ∀ m ∈ ℕ, ∀ n ∈ ℕ, m ≤ n → U(m) ⊆ U(n)
  requires covers : ∀ x ∈ K, ∃ n ∈ ℕ, x ∈ U(n)
  shows ∃ n ∈ ℕ, K ⊆ U(n)
proof
  obtain ⟨J, JI, finJ, cov⟩ := Compact.finite_subcover at X, K, ℕ, U with compact, open, covers
  obtain ⟨b, bNat, bound⟩ := Finite.naturals_bounded with JI, finJ
  have bIn : b ∈ ℕ by exact bNat
  refine ⟨b, bIn, ?_⟩
  intros x hx
  obtain ⟨i, hi, xi⟩ := cov with x, hx
  have isb := bound with i, hi
  have iNat := natural.member at succ(b) with isb
  have ib := LessEqual.of_membership_successor at i, b with isb
  have iIn := JI with i, hi
  exact (increasing with i, iIn, b, bIn, ib) with x, xi

-- A decreasing sequence of nonempty closed subsets of a compact set has
-- a common point (Cantor's intersection theorem).
theorem Compact.nested_closed (X K C : Set)
  requires compact : Compact(X, K)
  requires closed : ∀ n ∈ ℕ, Closed(X, C(n))
  requires inside : ∀ n ∈ ℕ, C(n) ⊆ K
  requires decreasing : ∀ m ∈ ℕ, ∀ n ∈ ℕ, m ≤ n → C(n) ⊆ C(m)
  requires nonempty : ∀ n ∈ ℕ, Nonempty(C(n))
  shows ∃ x ∈ K, ∀ n ∈ ℕ, x ∈ C(n)
proof
  by_contra bad
  have cov : ∀ x ∈ K, ∃ n ∈ ℕ, x ∈ cptComplements(X, C)(n)
    intros x hx
    by_contra none
    apply bad
    refine ⟨x, hx, ?_⟩
    intros n hn
    by_contra notIn
    apply none
    refine ⟨n, hn, ?_⟩
    rw (cptComplements.value with hn)
    obtain ⟨Csub, Copen⟩ := closed with n, hn
    have ic := compact
    unfold Compact at ic
    obtain ⟨Ksub, _⟩ := ic
    exact complement.membership.backward with ⟨(Ksub with x, hx), notIn⟩
  have opens : ∀ n ∈ ℕ, cptComplements(X, C)(n) ∈ X.opens
    intros n hn
    rw (cptComplements.value with hn)
    obtain ⟨Csub, Copen⟩ := closed with n, hn
    exact Copen
  have incr : ∀ m ∈ ℕ, ∀ n ∈ ℕ, m ≤ n →
      cptComplements(X, C)(m) ⊆ cptComplements(X, C)(n)
    intros m hm n hn mn
    rw [(cptComplements.value with hm), (cptComplements.value with hn)]
    intros y hy
    obtain ⟨yX, yNot⟩ := complement.membership.forward with hy
    have sub := decreasing with m, hm, n, hn, mn
    have yNot2 : y ∉ C(n)
      intro yn
      exact yNot with (sub with y, yn)
    exact complement.membership.backward with ⟨yX, yNot2⟩
  obtain ⟨n, hn, Kn⟩ := Compact.directed_cover at X, K, cptComplements(X, C) with compact, opens, incr, cov
  obtain ⟨y, hy⟩ := nonempty with n, hn
  have yK := inside with n, hn, y, hy
  have yc := Kn with y, yK
  rw (cptComplements.value with hn) at yc
  obtain ⟨yX, yNot⟩ := complement.membership.forward with yc
  exact yNot with hy

-- Compact metric spaces are sequentially compact.
theorem Compact.metric_subsequence (M K u : Set)
  requires metric : MetricSpace(M)
  requires compact : Compact(metricTopology(M), K)
  requires values : u : ℕ → K
  shows ∃ x ∈ K, ∃ φ, (φ : ℕ → ℕ) ∧
    (∀ m ∈ ℕ, ∀ n ∈ ℕ, m < n → φ(m) < φ(n)) ∧
    Tendsto(compose(u, φ, ℕ, ℕ, K), ℕ, natAtTop, nhds(metricTopology(M), x))
proof
  sorry

theorem cocompact.mem_iff_on (X B : Set)
  requires space : TopologicalSpace(X)
  shows B ∈ cocompact(X) ↔
    B ⊆ X.carrier ∧ (∃ K, Compact(X, K) ∧ X.carrier ∖ K ⊆ B)
proof
  constructor
  . intro hB
    have hB2 := cocompact.membership.forward with hB
    obtain ⟨BPow, K, KPow, compact, sub⟩ := hB2
    refine ⟨(powerset.membership_iff.forward with BPow), K, compact, sub⟩
  . intro hB
    obtain ⟨Bsub, K, compact, sub⟩ := hB
    have Ksub := Compact.subset_carrier at X, K with space, compact
    apply cocompact.membership.backward
    refine ⟨(powerset.membership_iff.backward with Bsub), K, (powerset.membership_iff.backward with Ksub), compact, sub⟩

-- Section: The cocompact filter
theorem cocompact.is_filter (X : Set)
  requires space : TopologicalSpace(X)
  shows IsFilter(X.carrier, cocompact(X))
proof
  have parts := TopologicalSpace.parts with space
  obtain ⟨subsets, whole, unions, intersections⟩ := parts
  unfold IsFilter
  refine ⟨?_, ?_, ?_, ?_⟩
  . intros B hB
    exact (cocompact.membership.forward with hB).left
  . have e := Compact.empty_set at X with space
    have sub : X.carrier ∖ ∅ ⊆ X.carrier
      intros y hy
      exact (difference.membership.forward with hy).left
    have selfC : X.carrier ⊆ X.carrier by simp
    have iff := cocompact.mem_iff_on at X, X.carrier with space
    exact iff.backward with ⟨selfC, ∅, e, sub⟩
  . intros A hA B hAB hBX
    have iff := cocompact.mem_iff_on at X, A with space
    obtain ⟨Asub, K, compact, sub⟩ := iff.forward with hA
    have iff2 := cocompact.mem_iff_on at X, B with space
    exact iff2.backward with ⟨hBX, K, compact, (Subset.transitive with sub, hAB)⟩
  . intros A hA B hB
    have iffA := cocompact.mem_iff_on at X, A with space
    obtain ⟨Asub, K, compactK, subK⟩ := iffA.forward with hA
    have iffB := cocompact.mem_iff_on at X, B with space
    obtain ⟨Bsub, L, compactL, subL⟩ := iffB.forward with hB
    have cu := Compact.union at X, K, L with space, compactK, compactL
    have sub : X.carrier ∖ (K ∪ L) ⊆ A ∩ B
      intros y hy
      have hy2 := difference.membership.forward with hy
      have notK : y ∉ K
        intro yK
        exact hy2.right with (union2.left at y, K, L with yK)
      have notL : y ∉ L
        intro yL
        exact hy2.right with (union2.right at y, K, L with yL)
      have yA := subK with y, (difference.membership.backward with hy2.left, notK)
      have yB := subL with y, (difference.membership.backward with hy2.left, notL)
      exact intersection.membership.backward with yA, yB
    have ABsub : A ∩ B ⊆ X.carrier
      intros y hy
      exact Asub with y, (intersection.membership.forward with hy).left
    have iffAB := cocompact.mem_iff_on at X, A ∩ B with space
    exact iffAB.backward with ⟨ABsub, K ∪ L, cu, sub⟩

theorem cocompact.proper_iff (X : Set)
  requires space : TopologicalSpace(X)
  shows ProperFilter(X.carrier, cocompact(X)) ↔ ¬Compact(X)
proof
  have filt := cocompact.is_filter at X with space
  have sp := Compact.space_iff at X with space
  constructor
  . intro prop
    intro compact
    obtain ⟨_, noE⟩ := prop
    apply noE
    have cc := sp.forward with compact
    have iff := cocompact.mem_iff_on at X, ∅ with space
    have sub : X.carrier ∖ X.carrier ⊆ ∅
      intros y hy
      obtain ⟨yX, yN⟩ := difference.membership.forward with hy
      exfalso
      exact yN with yX
    exact iff.backward with ⟨(empty.subset at X.carrier), X.carrier, cc, sub⟩
  . intro notCompact
    unfold ProperFilter
    refine ⟨filt, ?_⟩
    intro eIn
    have iff := cocompact.mem_iff_on at X, ∅ with space
    obtain ⟨_, K, compact, sub⟩ := iff.forward with eIn
    have Ksub := Compact.subset_carrier at X, K with space, compact
    have XK : X.carrier ⊆ K
      intros y hy
      by_contra yK
      have yE := sub with y, (difference.membership.backward with hy, yK)
      simp at yE
    have eq := Subset.antisymmetric with Ksub, XK
    rw eq at compact
    exact notCompact with (sp.backward with compact)

theorem cocompact.mem_iff (X B : Set)
  requires space : TopologicalSpace(X)
  shows B ∈ cocompact(X) ↔
    B ⊆ X.carrier ∧ (∃ K, Compact(X, K) ∧ X.carrier ∖ K ⊆ B)
proof
  exact cocompact.mem_iff_on with space

-- On ℝ the cocompact filter is atBot ⊔ atTop.
theorem cocompact.real
  shows cocompact(realLine) = filterSup(realAtBot, realAtTop)
proof
  sorry

theorem DiscreteTopology.compact_iff_finite (X A : Set)
  requires discrete : DiscreteTopology(X)
  requires inside : A ⊆ X.carrier
  shows Compact(X, A) ↔ Finite(A)
proof
  have d2 := discrete
  obtain ⟨space, opensEq⟩ := d2
  constructor
  . intro compact
    have local : ∀ x ∈ A, ∃ U ∈ X.opens, x ∈ U ∧ Finite(U ∩ A)
      intros x hx
      have ssub : {x} ⊆ X.carrier
        intros y hy
        simp at hy
        rw hy
        exact inside with x, hx
      have so : {x} ∈ X.opens
        rw opensEq
        exact powerset.membership_iff.backward with ssub
      have xx : x ∈ {x} by simp
      have sub : {x} ∩ A ⊆ {x}
        intros y hy
        exact (intersection.membership.forward with hy).left
      exact ⟨{x}, so, xx, (Finite.subset with (Finite.singleton at x), sub)⟩
    have fin := cptCompact.finite_of_local at X, A, A with compact, local
    have sub : A ⊆ A ∩ A
      intros y hy
      exact intersection.membership.backward with hy, hy
    exact Finite.subset with fin, sub
  . intro finite
    exact Compact.of_finite at X, A with space, finite, inside

-- On a discrete space the cocompact filter is the cofinite one.
theorem cocompact.discrete (X : Set)
  requires discrete : DiscreteTopology(X)
  shows cocompact(X) = cofinite(X.carrier)
proof
  have d2 := discrete
  obtain ⟨space, opensEq⟩ := d2
  ext B
  constructor
  . intro hB
    have iff := cocompact.mem_iff_on at X, B with space
    obtain ⟨Bsub, K, compact, sub⟩ := iff.forward with hB
    have Ksub := Compact.subset_carrier at X, K with space, compact
    have finK := (DiscreteTopology.compact_iff_finite at X, K with discrete, Ksub).forward with compact
    have sub2 : X.carrier ∖ B ⊆ K
      intros y hy
      obtain ⟨yX, yB⟩ := difference.membership.forward with hy
      by_contra yK
      exact yB with (sub with y, (difference.membership.backward with yX, yK))
    apply cofinite.membership.backward
    exact ⟨(powerset.membership_iff.backward with Bsub), (Finite.subset with finK, sub2)⟩
  . intro hB
    obtain ⟨BP, finC⟩ := cofinite.membership.forward with hB
    have Bsub := powerset.membership_iff.forward with BP
    have Csub : X.carrier ∖ B ⊆ X.carrier
      intros y hy
      exact (difference.membership.forward with hy).left
    have compact := (DiscreteTopology.compact_iff_finite at X, X.carrier ∖ B with discrete, Csub).backward with finC
    have sub : X.carrier ∖ (X.carrier ∖ B) ⊆ B
      intros y hy
      obtain ⟨yX, yN⟩ := difference.membership.forward with hy
      by_contra yB
      exact yN with (difference.membership.backward with yX, yB)
    have iff := cocompact.mem_iff_on at X, B with space
    exact iff.backward with ⟨Bsub, X.carrier ∖ B, compact, sub⟩

-- Mathlib's tendsto_cofinite_cocompact_iff: a map from a discrete space
-- tends to the cocompact filter along the cofinite filter exactly when the
-- preimage of every compact set is finite.
theorem cocompact.tendsto_cofinite_iff (f A Y : Set)
  requires space : TopologicalSpace(Y)
  requires values : f : A → Y.carrier
  shows Tendsto(f, A, cofinite(A), cocompact(Y)) ↔
    (∀ K, Compact(Y, K) → Finite(functionPreimage(f, A, K)))
proof
  constructor
  . intro tends
    intros K compact
    have Ksub := Compact.subset_carrier at Y, K with space, compact
    have sub : Y.carrier ∖ (Y.carrier ∖ K) ⊆ K
      intros y hy
      obtain ⟨yX, yN⟩ := difference.membership.forward with hy
      by_contra yK
      exact yN with (difference.membership.backward with yX, yK)
    have Csub : Y.carrier ∖ K ⊆ Y.carrier
      intros y hy
      exact (difference.membership.forward with hy).left
    have iff := cocompact.mem_iff_on at Y, Y.carrier ∖ K with space
    have BIn := iff.backward with ⟨Csub, K, compact, (Subset.reflexive at Y.carrier ∖ K)⟩
    have pre := tends with Y.carrier ∖ K, BIn
    obtain ⟨_, finC⟩ := cofinite.membership.forward with pre
    have sub2 : functionPreimage(f, A, K) ⊆ A ∖ functionPreimage(f, A, Y.carrier ∖ K)
      intros x hx
      obtain ⟨xA, fxK⟩ := functionPreimage.membership.forward with hx
      have notIn : x ∉ functionPreimage(f, A, Y.carrier ∖ K)
        intro bad
        obtain ⟨_, fxC⟩ := functionPreimage.membership.forward with bad
        exact (difference.membership.forward with fxC).right with fxK
      exact difference.membership.backward with xA, notIn
    exact Finite.subset with finC, sub2
  . intro finite
    unfold Tendsto
    intros B hB
    have iff := cocompact.mem_iff_on at Y, B with space
    obtain ⟨Bsub, K, compact, sub⟩ := iff.forward with hB
    have finK := finite with K, compact
    have preSub : functionPreimage(f, A, B) ⊆ A
      intros x hx
      exact (functionPreimage.membership.forward with hx).left
    have sub2 : A ∖ functionPreimage(f, A, B) ⊆ functionPreimage(f, A, K)
      intros x hx
      obtain ⟨xA, xN⟩ := difference.membership.forward with hx
      have fx := FunctionBetween.apply_closed with values, xA
      apply functionPreimage.membership.backward
      refine ⟨xA, ?_⟩
      by_contra fxK
      have fxB := sub with f(x), (difference.membership.backward with fx, fxK)
      exact xN with (functionPreimage.membership.backward with ⟨xA, fxB⟩)
    apply cofinite.membership.backward
    exact ⟨(powerset.membership_iff.backward with preSub), (Finite.subset with finK, sub2)⟩

-- Mathlib's Continuous.discrete_of_tendsto_cofinite_cocompact, in the
-- form the source uses: a map from a set into a Hausdorff space under
-- which the preimage of every compact set is finite has a closed discrete
-- image.
theorem cocompact.closed_discrete_image (f A Y : Set)
  requires hausdorff : Hausdorff(Y)
  requires space : TopologicalSpace(Y)
  requires values : f : A → Y.carrier
  requires proper : Tendsto(f, A, cofinite(A), cocompact(Y))
  shows Closed(Y, imageIn(f, A, Y.carrier)) ∧
    DiscreteSubset(Y, imageIn(f, A, Y.carrier))
proof
  sorry

-- Section: Local compactness
theorem LocallyCompact.weakly (X : Set)
  requires locally : LocallyCompact(X)
  shows WeaklyLocallyCompact(X)
proof
  obtain ⟨space, small⟩ := locally
  unfold WeaklyLocallyCompact
  refine ⟨space, ?_⟩
  intros x hx
  have parts := TopologicalSpace.parts with space
  obtain ⟨subsets, whole, unions, intersections⟩ := parts
  have Cn := nhds.open_mem with space, whole, hx
  obtain ⟨K, hK, KC, compact⟩ := small with x, hx, X.carrier, Cn
  refine ⟨K, hK, compact⟩

theorem LocallyCompact.of_weakly_hausdorff (X : Set)
  requires weakly : WeaklyLocallyCompact(X)
  requires hausdorff : Hausdorff(X)
  shows LocallyCompact(X)
proof
  sorry

theorem LocallyCompact.of_compact_hausdorff (X : Set)
  requires space : TopologicalSpace(X)
  requires compact : Compact(X)
  requires hausdorff : Hausdorff(X)
  shows LocallyCompact(X)
proof
  sorry

theorem LocallyCompact.real
  shows LocallyCompact(realLine)
proof
  sorry

theorem LocallyCompact.discrete (X : Set)
  requires discrete : DiscreteTopology(X)
  shows LocallyCompact(X)
proof
  have d2 := discrete
  obtain ⟨space, opensEq⟩ := d2
  unfold LocallyCompact
  refine ⟨space, ?_⟩
  intros x hx N hN
  have ssub : {x} ⊆ X.carrier
    intros y hy
    simp at hy
    rw hy
    exact hx
  have so : {x} ∈ X.opens
    rw opensEq
    exact powerset.membership_iff.backward with ssub
  have xx : x ∈ {x} by simp
  have sn := nhds.open_mem with space, so, xx
  have xN := nhds.mem_of with space, hN
  have sub : {x} ⊆ N
    intros y hy
    simp at hy
    rw hy
    exact xN
  have compact := Compact.point at X, x with space, hx
  refine ⟨{x}, sn, sub, compact⟩

theorem LocallyCompact.product (X Y : Set)
  requires locallyX : LocallyCompact(X)
  requires locallyY : LocallyCompact(Y)
  shows LocallyCompact(productSpace(X, Y))
proof
  sorry

-- A closed subspace of a locally compact space is locally compact, and
-- an open subspace of a locally compact Hausdorff space is.
theorem LocallyCompact.closed_subspace (X A : Set)
  requires locally : LocallyCompact(X)
  requires closed : Closed(X, A)
  shows LocallyCompact(subspace(X, A))
proof
  sorry

theorem LocallyCompact.open_subspace (X U : Set)
  requires locally : LocallyCompact(X)
  requires hausdorff : Hausdorff(X)
  requires open : U ∈ X.opens
  shows LocallyCompact(subspace(X, U))
proof
  sorry

-- A compact set inside an open set has a compact neighborhood inside it
-- (Mathlib's exists_compact_between, its first half).
theorem LocallyCompact.compact_between (X K U : Set)
  requires locally : LocallyCompact(X)
  requires compact : Compact(X, K)
  requires open : U ∈ X.opens
  requires inside : K ⊆ U
  shows ∃ L, Compact(X, L) ∧ L ⊆ U ∧ K ⊆ interior(X, L)
proof
  sorry

-- Section: Discrete spaces
theorem discreteSpace.space (A X : Set)
  requires discrete : X = discreteSpace(A)
  shows TopologicalSpace(X)
proof
  rw discrete
  unfold discreteSpace
  exact TopologicalSpace.of_parts with (discreteTopology at A)

theorem discreteSpace.discrete (A X : Set)
  requires discrete : X = discreteSpace(A)
  shows DiscreteTopology(X)
proof
  have space := discreteSpace.space with discrete
  unfold DiscreteTopology
  refine ⟨space, ?_⟩
  rw discrete
  unfold discreteSpace
  topology_projections

theorem discreteSpace.carrier (A : Set)
  shows TopologicalSpace.carrier(discreteSpace(A)) = A
proof
  unfold discreteSpace
  topology_projections

theorem DiscreteTopology.continuous (f X Y : Set)
  requires discrete : DiscreteTopology(X)
  requires space : TopologicalSpace(Y)
  requires function : f : X.carrier → Y.carrier
  shows f : X ⇒ Y
proof
  obtain ⟨spaceX, opensEq⟩ := discrete
  apply Continuous.mk with spaceX, space, function
  intros V hV
  have sub := functionPreimage.subset at f, X.carrier, V
  rw opensEq
  exact powerset.membership_iff.backward with sub

theorem DiscreteTopology.singleton_open (X x : Set)
  requires discrete : DiscreteTopology(X)
  requires point : x ∈ X.carrier
  shows {x} ∈ X.opens
proof
  obtain ⟨spaceX, opensEq⟩ := discrete
  have sub : {x} ⊆ X.carrier
    intros y hy
    simp at hy
    rw hy
    exact point
  rw opensEq
  exact powerset.membership_iff.backward with sub

theorem DiscreteTopology.nhds (X x : Set)
  requires discrete : DiscreteTopology(X)
  requires point : x ∈ X.carrier
  shows nhds(X, x) = principalFilter(X.carrier, {x})
proof
  have d2 := discrete
  obtain ⟨spaceX, opensEq⟩ := d2
  have single := DiscreteTopology.singleton_open at X, x with discrete, point
  ext N
  constructor
  . intro hN
    have hN2 := nhds.membership.forward with hN
    obtain ⟨NP, U, hU, xU, UN⟩ := hN2
    apply principalFilter.membership.backward
    refine ⟨NP, ?_⟩
    intros y hy
    simp at hy
    rw hy
    exact UN with x, xU
  . intro hN
    have hN2 := principalFilter.membership.forward with hN
    obtain ⟨NP, xN⟩ := hN2
    apply nhds.membership.backward
    have xx : x ∈ {x} by simp
    exact ⟨NP, {x}, single, xx, xN⟩

theorem DiscreteTopology.hausdorff (X : Set)
  requires discrete : DiscreteTopology(X)
  shows Hausdorff(X)
proof
  obtain ⟨spaceX, opensEq⟩ := discrete
  unfold Hausdorff
  rw opensEq
  exact IsHausdorff.discrete at X.carrier

theorem DiscreteTopology.subspace (X A : Set)
  requires discrete : DiscreteTopology(X)
  requires inside : A ⊆ X.carrier
  shows DiscreteTopology(subspace(X, A))
proof
  have d2 := discrete
  obtain ⟨spaceX, opensEq⟩ := d2
  have sp := subspace.space at X, A with spaceX, inside
  unfold DiscreteTopology
  refine ⟨sp, ?_⟩
  rw [subspace.opens, subspace.carrier, opensEq]
  ext U
  constructor
  . intro hU
    obtain ⟨V, hV, shape⟩ := subspaceTopology.membership.forward with hU
    apply powerset.membership_iff.backward
    rw ← shape
    exact intersection.subset_right
  . intro hU
    have UA := powerset.membership_iff.forward with hU
    have UX : U ⊆ TopologicalSpace.carrier(X)
      intros x hx
      exact inside with x, (UA with x, hx)
    apply subspaceTopology.membership.backward
    refine ⟨U, (powerset.membership_iff.backward with UX), ?_⟩
    exact intersection.eq_left_of_subset with UA

theorem DiscreteTopology.product (X Y : Set)
  requires discreteX : DiscreteTopology(X)
  requires discreteY : DiscreteTopology(Y)
  shows DiscreteTopology(productSpace(X, Y))
proof
  have dX := discreteX
  obtain ⟨spaceX, opensX⟩ := dX
  have dY := discreteY
  obtain ⟨spaceY, opensY⟩ := dY
  have sp := productSpace.space with spaceX, spaceY
  unfold DiscreteTopology
  refine ⟨sp, ?_⟩
  rw [productSpace.opens, productSpace.carrier, opensX, opensY]
  ext W
  constructor
  . intro hW
    exact (productTopology.membership.forward with hW).left
  . intro hW
    have WP := powerset.membership_iff.forward with hW
    apply productTopology.membership.backward
    refine ⟨hW, ?_⟩
    intros p hp
    have pP := WP with p, hp
    obtain ⟨bound, x, hx, y, hy, pEq⟩ := product.membership.forward with pP
    have sx : {x} ⊆ TopologicalSpace.carrier(X)
      intros z hz
      simp at hz
      rw hz
      exact hx
    have sy : {y} ⊆ TopologicalSpace.carrier(Y)
      intros z hz
      simp at hz
      rw hz
      exact hy
    have xx : x ∈ {x} by simp
    have yy : y ∈ {y} by simp
    refine ⟨{x}, (powerset.membership_iff.backward with sx), {y}, (powerset.membership_iff.backward with sy), ?_, ?_⟩
    . rw pEq
      exact product.pair with xx, yy
    . intros q hq
      obtain ⟨bound2, a, ha, b, hb, qEq⟩ := product.membership.forward with hq
      simp at ha
      simp at hb
      rw [qEq, ha, hb, ← pEq]
      exact hp

-- A discrete subset that is closed meets every compact set in a finite set.
theorem DiscreteSubset.compact_inter_finite (X A K : Set)
  requires space : TopologicalSpace(X)
  requires discrete : DiscreteSubset(X, A)
  requires closed : Closed(X, A)
  requires compact : Compact(X, K)
  shows Finite(A ∩ K)
proof
  obtain ⟨Asub, isolated⟩ := discrete
  have local : ∀ x ∈ K, ∃ U ∈ X.opens, x ∈ U ∧ Finite(U ∩ A)
    intros x hx
    by_cases xA : x ∈ A
    . obtain ⟨U, hU, UA⟩ := isolated with x, xA
      have xU : x ∈ U
        have xs : x ∈ {x} by simp
        rw ← UA at xs
        exact (intersection.membership.forward with xs).left
      have finUA : Finite(U ∩ A)
        rw UA
        exact Finite.singleton at x
      exact ⟨U, hU, xU, finUA⟩
    . obtain ⟨Asub2, Aopen⟩ := closed
      have ic := compact
      unfold Compact at ic
      obtain ⟨Ksub, _⟩ := ic
      have xc : x ∈ complement(X.carrier, A)
        exact complement.membership.backward with ⟨(Ksub with x, hx), xA⟩
      have sub : complement(X.carrier, A) ∩ A ⊆ ∅
        intros y hy
        obtain ⟨yc, yA⟩ := intersection.membership.forward with hy
        exfalso
        exact (complement.membership.forward with yc).right with yA
      exact ⟨complement(X.carrier, A), Aopen, xc, (Finite.subset with Finite.empty, sub)⟩
  exact cptCompact.finite_of_local with compact, local

-- The naturals are a closed discrete subset of ℝ.
theorem DiscreteSubset.integers
  shows DiscreteSubset(realLine, realNaturals) ∧
    Closed(realLine, realNaturals)
proof
  sorry

-- Section: Clopen sets
theorem Clopen.whole (X : Set)
  requires space : TopologicalSpace(X)
  shows Clopen(X, X.carrier)
proof
  have parts := TopologicalSpace.parts with space
  obtain ⟨subsets, whole, unions, intersections⟩ := parts
  unfold Clopen
  exact ⟨whole, (Closed.carrier at X with space)⟩

theorem Clopen.empty (X : Set)
  requires space : TopologicalSpace(X)
  shows Clopen(X, ∅)
proof
  have o := Open.mem at X, ∅ with space, (Open.empty_set at X with space)
  unfold Clopen
  exact ⟨o, (Closed.empty_set at X with space)⟩

theorem Clopen.complement (X U : Set)
  requires space : TopologicalSpace(X)
  requires clopen : Clopen(X, U)
  shows Clopen(X, X.carrier ∖ U)
proof
  obtain ⟨openU, closedU⟩ := clopen
  have o := Closed.compl_open at X, U with space, closedU
  have c := Open.compl_closed at X, U with space, (Open.of_mem at X, U with space, openU)
  unfold complement at o
  unfold complement at c
  unfold Clopen
  exact ⟨(Open.mem at X, X.carrier ∖ U with space, o), c⟩

theorem Clopen.inter (X U V : Set)
  requires space : TopologicalSpace(X)
  requires clopenU : Clopen(X, U)
  requires clopenV : Clopen(X, V)
  shows Clopen(X, U ∩ V)
proof
  obtain ⟨openU, closedU⟩ := clopenU
  obtain ⟨openV, closedV⟩ := clopenV
  have o := Open.inter at X, U, V with space, (Open.of_mem at X, U with space, openU), (Open.of_mem at X, V with space, openV)
  have c := Closed.inter at X, U, V with space, closedU, closedV
  unfold Clopen
  exact ⟨(Open.mem at X, U ∩ V with space, o), c⟩

theorem Clopen.union (X U V : Set)
  requires space : TopologicalSpace(X)
  requires clopenU : Clopen(X, U)
  requires clopenV : Clopen(X, V)
  shows Clopen(X, U ∪ V)
proof
  obtain ⟨openU, closedU⟩ := clopenU
  obtain ⟨openV, closedV⟩ := clopenV
  have o := Open.union at X, U, V with space, (Open.of_mem at X, U with space, openU), (Open.of_mem at X, V with space, openV)
  have c := Closed.union at X, U, V with space, closedU, closedV
  unfold Clopen
  exact ⟨(Open.mem at X, U ∪ V with space, o), c⟩

-- In a connected space the only clopen sets are ∅ and the whole space.
theorem Clopen.connected (X U : Set)
  requires space : TopologicalSpace(X)
  requires connected : Connected(X)
  requires clopen : Clopen(X, U)
  shows U = ∅ ∨ U = X.carrier
proof
  obtain ⟨openU, closedU⟩ := clopen
  exact Connected.clopen_trivial at X, U with space, connected, (Open.of_mem at X, U with space, openU), closedU

-- A set containing an open neighborhood of each of its points is open.
theorem Open.of_local (X A : Set)
  requires space : TopologicalSpace(X)
  requires local : ∀ x ∈ A, ∃ U ∈ X.opens, x ∈ U ∧ U ⊆ A
  shows A ∈ X.opens
proof
  have parts := TopologicalSpace.parts with space
  have eq : interiorIn(X.opens, A) = A
    ext x
    constructor
    . intro hx
      exact (interiorIn.subset at X.opens, A) with x, hx
    . intro hx
      exact (interiorIn.membership at X.opens, A, x).backward with (local with x, hx)
  rw ← eq
  exact interiorIn.open at X.carrier, X.opens, A with parts

-- Section: Locally constant maps
theorem IsLocallyConstant.iff_nhds (f X : Set)
  requires space : TopologicalSpace(X)
  shows IsLocallyConstant(f, X) ↔
    (∀ x ∈ X.carrier, ∃ U ∈ nhds(X, x), ∀ y ∈ U, f(y) = f(x))
proof
  constructor
  . intro locally
    obtain ⟨_, pre⟩ := locally
    intros x hx
    have op := pre with {f(x)}
    have self : f(x) ∈ {f(x)} by simp
    have xU := functionPreimage.of_apply with hx, self
    have nb := nhds.open_mem with space, op, xU
    refine ⟨functionPreimage(f, X.carrier, {f(x)}), nb, ?_⟩
    intros y hy
    obtain ⟨yIn, yval⟩ := functionPreimage.membership.forward with hy
    simp at yval
    exact yval
  . intro near
    unfold IsLocallyConstant
    refine ⟨space, ?_⟩
    intro B
    apply Open.of_local with space
    intros x hx
    obtain ⟨xIn, val⟩ := functionPreimage.membership.forward with hx
    obtain ⟨U, hU, const⟩ := near with x, xIn
    obtain ⟨UP, V, hV, xV, VU⟩ := nhds.membership.forward with hU
    have Usub := powerset.membership_iff.forward with UP
    refine ⟨V, hV, xV, ?_⟩
    intros z hz
    have zU := VU with z, hz
    have zIn := Usub with z, zU
    apply functionPreimage.of_apply with zIn
    rw (const with z, zU)
    exact val

theorem IsLocallyConstant.iff_fibers_open (f X Y : Set)
  requires space : TopologicalSpace(X)
  requires function : f : X.carrier → Y
  shows IsLocallyConstant(f, X) ↔
    (∀ y ∈ Y, functionPreimage(f, X.carrier, {y}) ∈ X.opens)
proof
  constructor
  . intros locally y hy
    exact locally.right with {y}
  . intro fibers
    unfold IsLocallyConstant
    refine ⟨space, ?_⟩
    intro B
    apply Open.of_local with space
    intros x hx
    have hx2 := functionPreimage.membership.forward with hx
    obtain ⟨xIn, val⟩ := hx2
    have fx := FunctionBetween.apply_closed with function, xIn
    have op := fibers with f(x), fx
    have self : f(x) ∈ {f(x)} by simp
    refine ⟨functionPreimage(f, X.carrier, {f(x)}), op, (functionPreimage.of_apply with xIn, self), ?_⟩
    intros z hz
    have hz2 := functionPreimage.membership.forward with hz
    obtain ⟨zIn, zval⟩ := hz2
    simp at zval
    apply functionPreimage.of_apply with zIn
    rw zval
    exact val

theorem IsLocallyConstant.continuous (f X Y : Set)
  requires locally : IsLocallyConstant(f, X)
  requires space : TopologicalSpace(Y)
  requires function : f : X.carrier → Y.carrier
  shows f : X ⇒ Y
proof
  obtain ⟨spaceX, pre⟩ := locally
  have fn := function
  apply Continuous.mk with spaceX, space, fn
  intros V hV
  exact pre with V

theorem IsLocallyConstant.const (X c : Set)
  requires space : TopologicalSpace(X)
  shows IsLocallyConstant(X.carrier × {c}, X)
proof
  have parts := TopologicalSpace.parts with space
  obtain ⟨subsets, whole, unions, intersections⟩ := parts
  have cc : c ∈ {c} by simp
  have same : X.carrier × {c} = constantFunction(X.carrier, {c}, c)
    ext p
    constructor
    . intro hp
      obtain ⟨bound, x, hx, y, hy, pEq⟩ := product.membership.forward with hp
      simp at hy
      apply constantFunction.membership.backward
      refine ⟨hp, x, hx, ?_⟩
      rw [pEq, hy]
    . intro hp
      exact (constantFunction.membership.forward with hp).left
  unfold IsLocallyConstant
  refine ⟨space, ?_⟩
  intro B
  rw same
  by_cases cB : c ∈ B
  . have eq : functionPreimage(constantFunction(X.carrier, {c}, c), X.carrier, B) = X.carrier
      ext x
      constructor
      . intro hx
        exact (functionPreimage.membership.forward with hx).left
      . intro hx
        apply functionPreimage.of_apply with hx
        rw constantFunction.apply at X.carrier, {c}, x, c with hx, cc
        exact cB
    rw eq
    exact whole
  . have eq : functionPreimage(constantFunction(X.carrier, {c}, c), X.carrier, B) = ∅
      ext x
      constructor
      . intro hx
        have hx2 := functionPreimage.membership.forward with hx
        obtain ⟨xIn, val⟩ := hx2
        rw constantFunction.apply at X.carrier, {c}, x, c with xIn, cc at val
        exfalso
        exact cB with val
      . intro hx
        exfalso
        exact set.empty with hx
    rw eq
    exact Open.mem at X, ∅ with space, (Open.empty_set at X with space)

theorem IsLocallyConstant.discrete (f X : Set)
  requires discrete : DiscreteTopology(X)
  shows IsLocallyConstant(f, X)
proof
  have d2 := discrete
  obtain ⟨spaceX, opensEq⟩ := d2
  unfold IsLocallyConstant
  refine ⟨spaceX, ?_⟩
  intro B
  have sub := functionPreimage.subset at f, X.carrier, B
  rw opensEq
  exact powerset.membership_iff.backward with sub

-- Into a discrete space, locally constant is continuous.
theorem IsLocallyConstant.iff_continuous_discrete (f X Y : Set)
  requires space : TopologicalSpace(X)
  requires discrete : DiscreteTopology(Y)
  requires function : f : X.carrier → Y.carrier
  shows IsLocallyConstant(f, X) ↔ f : X ⇒ Y
proof
  have d2 := discrete
  obtain ⟨spaceY, opensY⟩ := d2
  constructor
  . intro locally
    exact IsLocallyConstant.continuous with locally, spaceY, function
  . intro cont
    have engine := Continuous.parts with cont
    unfold IsLocallyConstant
    refine ⟨space, ?_⟩
    intro B
    have sub : B ∩ Y.carrier ⊆ Y.carrier by exact intersection.subset_right
    have openB : B ∩ Y.carrier ∈ Y.opens
      rw opensY
      exact powerset.membership_iff.backward with sub
    have pre := ContinuousMap.preimage with engine, openB
    have eq : functionPreimage(f, X.carrier, B) = functionPreimage(f, X.carrier, B ∩ Y.carrier)
      ext x
      constructor
      . intro hx
        have hx2 := functionPreimage.membership.forward with hx
        obtain ⟨xIn, val⟩ := hx2
        apply functionPreimage.of_apply with xIn
        have fx := FunctionBetween.apply_closed with function, xIn
        exact intersection.membership.backward with ⟨val, fx⟩
      . intro hx
        have hx2 := functionPreimage.membership.forward with hx
        obtain ⟨xIn, val⟩ := hx2
        apply functionPreimage.of_apply with xIn
        exact (intersection.membership.forward with val).left
    rw eq
    exact pre

-- Composition on the left keeps local constancy.
theorem IsLocallyConstant.comp (f g h X Y : Set)
  requires locally : IsLocallyConstant(f, X)
  requires function : f : X.carrier → Y
  requires values : ∀ x ∈ X.carrier, h(x) = g(f(x))
  shows IsLocallyConstant(h, X)
proof
  obtain ⟨spaceX, pre⟩ := locally
  unfold IsLocallyConstant
  refine ⟨spaceX, ?_⟩
  intro B
  have eq : functionPreimage(h, X.carrier, B) = functionPreimage(f, X.carrier, functionPreimage(g, Y, B))
    ext x
    constructor
    . intro hx
      have hx2 := functionPreimage.membership.forward with hx
      have v := values with x, hx2.left
      have fx := FunctionBetween.apply_closed with function, hx2.left
      have gB := hx2.right
      rw v at gB
      exact functionPreimage.of_apply with hx2.left, (functionPreimage.of_apply with fx, gB)
    . intro hx
      have hx2 := functionPreimage.membership.forward with hx
      have hx3 := functionPreimage.membership.forward with hx2.right
      have v := values with x, hx2.left
      apply functionPreimage.of_apply with hx2.left
      rw v
      exact hx3.right
  rw eq
  exact pre with functionPreimage(g, Y, B)

-- Two locally constant maps combine: x ↦ (f(x), g(x)) is locally constant.
theorem IsLocallyConstant.pair (f g h X : Set)
  requires locallyF : IsLocallyConstant(f, X)
  requires locallyG : IsLocallyConstant(g, X)
  requires values : ∀ x ∈ X.carrier, h(x) = (f(x), g(x))
  shows IsLocallyConstant(h, X)
proof
  have lf := locallyF
  obtain ⟨space, preF⟩ := lf
  have lg := locallyG
  obtain ⟨space2, preG⟩ := lg
  have parts := TopologicalSpace.parts with space
  obtain ⟨subsets, whole, unions, intersections⟩ := parts
  unfold IsLocallyConstant
  refine ⟨space, ?_⟩
  intro B
  apply Open.of_local with space
  intros x hx
  have hx2 := functionPreimage.membership.forward with hx
  obtain ⟨xIn, val⟩ := hx2
  have oF := preF with {f(x)}
  have oG := preG with {g(x)}
  have oFG := intersections with functionPreimage(f, X.carrier, {f(x)}), oF, functionPreimage(g, X.carrier, {g(x)}), oG
  have s1 : f(x) ∈ {f(x)} by simp
  have s2 : g(x) ∈ {g(x)} by simp
  have xF := functionPreimage.of_apply with xIn, s1
  have xG := functionPreimage.of_apply with xIn, s2
  refine ⟨functionPreimage(f, X.carrier, {f(x)}) ∩ functionPreimage(g, X.carrier, {g(x)}), oFG, (intersection.membership.backward with ⟨xF, xG⟩), ?_⟩
  intros z hz
  have hz2 := intersection.membership.forward with hz
  have zf := functionPreimage.membership.forward with hz2.left
  have zg := functionPreimage.membership.forward with hz2.right
  obtain ⟨zIn, fz⟩ := zf
  obtain ⟨zIn2, gz⟩ := zg
  simp at fz
  simp at gz
  apply functionPreimage.of_apply with zIn
  have hzv := values with z, zIn
  have hxv := values with x, xIn
  rw [hzv, fz, gz, ← hxv]
  exact val

-- Helpers for IsLocallyConstant.finite_range: finite unions of sets with
-- finite images have finite images.
def cptImageFamilies (f Y F : Set) : Set :=
  { G ∈ 𝒫(F) | Finite(imageIn(f, ⋃(G), Y)) }
def cptFiniteImageOpens (f X Y : Set) : Set :=
  { U ∈ TopologicalSpace.opens(X) | Finite(imageIn(f, U, Y)) }

theorem cptImage.finite_union (f Y F : Set)
  requires finite : Finite(F)
  requires each : ∀ W ∈ F, Finite(imageIn(f, W, Y))
  shows Finite(imageIn(f, ⋃(F), Y))
proof
  have base : ∅ ∈ cptImageFamilies(f, Y, F)
    apply cptImageFamilies.membership.backward
    refine ⟨(powerset.membership_iff.backward with (empty.subset at F)), ?_⟩
    have sub : imageIn(f, ⋃(∅), Y) ⊆ ∅
      intros y hy
      obtain ⟨yY, x, hx, eq⟩ := imageIn.membership.forward with hy
      obtain ⟨U, hU, _⟩ := union.membership.forward with hx
      simp at hU
    exact Finite.subset with Finite.empty, sub
  have step : ∀ G ⊆ F, Finite(G) → ∀ W ∈ F, W ∉ G →
      G ∈ cptImageFamilies(f, Y, F) → G ∪ {W} ∈ cptImageFamilies(f, Y, F)
    intros G hG finiteG W hW fresh known
    obtain ⟨_, finG⟩ := cptImageFamilies.membership.forward with known
    have finW := each with W, hW
    have bound : G ∪ {W} ⊆ F
      intros Z hZ
      cases (union2.membership.forward with hZ) with inG | isW
      . exact hG with Z, inG
      . rwa (singleton.membership.forward with isW)
    have sub : imageIn(f, ⋃(G ∪ {W}), Y) ⊆ imageIn(f, ⋃(G), Y) ∪ imageIn(f, W, Y)
      intros y hy
      obtain ⟨yY, x, hx, eq⟩ := imageIn.membership.forward with hy
      obtain ⟨U, hU, xU⟩ := union.membership.forward with hx
      cases (union2.membership.forward with hU) with inG | isW
      . apply union2.left
        apply imageIn.membership.backward
        exact ⟨yY, x, (union.membership.backward with ⟨U, inG, xU⟩), eq⟩
      . apply union2.right
        rw (singleton.membership.forward with isW) at xU
        apply imageIn.membership.backward
        exact ⟨yY, x, xU, eq⟩
    apply cptImageFamilies.membership.backward
    refine ⟨(powerset.membership_iff.backward with bound), ?_⟩
    exact Finite.subset with (Finite.union with finG, finW), sub
  have all := Finite.induction with base, step
  have member := all with F, (Subset.reflexive at F), finite
  exact (cptImageFamilies.membership.forward with member).right

-- On a compact space a locally constant map takes finitely many values.
theorem IsLocallyConstant.finite_range (f X Y : Set)
  requires locally : IsLocallyConstant(f, X)
  requires compact : Compact(X)
  requires function : f : X.carrier → Y
  shows Finite(imageIn(f, X.carrier, Y))
proof
  have l2 := locally
  obtain ⟨space, pre⟩ := l2
  have ic := Compact.space_parts at X with compact
  have cover : OpenCover(X.opens, X.carrier, cptFiniteImageOpens(f, X, Y))
    unfold OpenCover
    constructor
    . intros U hU
      exact (cptFiniteImageOpens.membership.forward with hU).left
    . intros x hx
      have fx := FunctionBetween.apply_closed with function, hx
      have op := pre with {f(x)}
      have self : f(x) ∈ {f(x)} by simp
      have xU := functionPreimage.of_apply with hx, self
      have sub : imageIn(f, functionPreimage(f, X.carrier, {f(x)}), Y) ⊆ {f(x)}
        intros y hy
        obtain ⟨yY, z, hz, eq⟩ := imageIn.membership.forward with hy
        obtain ⟨zIn, zval⟩ := functionPreimage.membership.forward with hz
        rw eq
        exact zval
      have mem : functionPreimage(f, X.carrier, {f(x)}) ∈ cptFiniteImageOpens(f, X, Y)
        apply cptFiniteImageOpens.membership.backward
        exact ⟨op, (Finite.subset with (Finite.singleton at f(x)), sub)⟩
      exact union.membership.backward with ⟨functionPreimage(f, X.carrier, {f(x)}), mem, xU⟩
  obtain ⟨G, GC, finG, XG⟩ := IsCompact.subcover with ic, cover
  have each : ∀ W ∈ G, Finite(imageIn(f, W, Y))
    intros W hW
    exact (cptFiniteImageOpens.membership.forward with (GC with W, hW)).right
  have fin := cptImage.finite_union with finG, each
  have sub : imageIn(f, X.carrier, Y) ⊆ imageIn(f, ⋃(G), Y)
    intros y hy
    obtain ⟨yY, x, hx, eq⟩ := imageIn.membership.forward with hy
    apply imageIn.membership.backward
    exact ⟨yY, x, (XG with x, hx), eq⟩
  exact Finite.subset with fin, sub

-- On a connected space a locally constant map is constant.
theorem IsLocallyConstant.constant (f X : Set)
  requires locally : IsLocallyConstant(f, X)
  requires connected : Connected(X)
  shows ∀ x ∈ X.carrier, ∀ y ∈ X.carrier, f(x) = f(y)
proof
  have lf := locally
  obtain ⟨space, pre⟩ := lf
  intros x hx y hy
  have oF := pre with {f(x)}
  have self : f(x) ∈ {f(x)} by simp
  have xF := functionPreimage.of_apply with hx, self
  have FX := functionPreimage.subset at f, X.carrier, {f(x)}
  have oC : X.carrier ∖ functionPreimage(f, X.carrier, {f(x)}) ∈ X.opens
    apply Open.of_local with space
    intros z hz
    have hz2 := difference.membership.forward with hz
    obtain ⟨zIn, zNot⟩ := hz2
    have oZ := pre with {f(z)}
    have selfZ : f(z) ∈ {f(z)} by simp
    have zZ := functionPreimage.of_apply with zIn, selfZ
    refine ⟨functionPreimage(f, X.carrier, {f(z)}), oZ, zZ, ?_⟩
    intros w hw
    have hw2 := functionPreimage.membership.forward with hw
    obtain ⟨wIn, wv⟩ := hw2
    simp at wv
    apply difference.membership.backward
    refine ⟨wIn, ?_⟩
    intro wF
    have wF2 := functionPreimage.membership.forward with wF
    obtain ⟨wIn2, wv2⟩ := wF2
    simp at wv2
    apply zNot
    apply functionPreimage.of_apply with zIn
    rw ← wv
    rw wv2
    simp
  have openC := Open.of_mem at X, X.carrier ∖ functionPreimage(f, X.carrier, {f(x)}) with space, oC
  have closed := Open.compl_closed at X, X.carrier ∖ functionPreimage(f, X.carrier, {f(x)}) with space, openC
  unfold complement at closed
  have eq : X.carrier ∖ (X.carrier ∖ functionPreimage(f, X.carrier, {f(x)})) = functionPreimage(f, X.carrier, {f(x)})
    ext w
    constructor
    . intro hw
      have hw2 := difference.membership.forward with hw
      obtain ⟨wIn, wNot⟩ := hw2
      by_contra notIn
      apply wNot
      exact difference.membership.backward with ⟨wIn, notIn⟩
    . intro hw
      apply difference.membership.backward
      refine ⟨(FX with w, hw), ?_⟩
      intro bad
      have bad2 := difference.membership.forward with bad
      exact bad2.right with hw
  rw eq at closed
  have clopen : Clopen(X, functionPreimage(f, X.carrier, {f(x)}))
    unfold Clopen
    exact ⟨oF, closed⟩
  have cases := Clopen.connected with space, connected, clopen
  cases cases with empty | whole
  . exfalso
    rw empty at xF
    exact set.empty with xF
  . rw ← whole at hy
    have hy2 := functionPreimage.membership.forward with hy
    obtain ⟨yIn, yv⟩ := hy2
    simp at yv
    rw yv

-- Section: Totally disconnected and profinite spaces
theorem TotallyDisconnected.discrete (X : Set)
  requires discrete : DiscreteTopology(X)
  shows TotallyDisconnected(X)
proof
  have d2 := discrete
  obtain ⟨spaceX, opensEq⟩ := d2
  unfold TotallyDisconnected
  refine ⟨spaceX, ?_⟩
  intros A conn a ha b hb
  unfold ConnectedSubset at conn
  obtain ⟨sub, notSep⟩ := conn
  by_contra ne
  apply notSep
  have aX := sub with a, ha
  have bX := sub with b, hb
  have sa : {a} ⊆ X.carrier
    intros z hz
    simp at hz
    rw hz
    exact aX
  have sc : X.carrier ∖ {a} ⊆ X.carrier
    intros z hz
    exact (difference.membership.forward with hz).left
  have oa : {a} ∈ X.opens
    rw opensEq
    exact powerset.membership_iff.backward with sa
  have oc : X.carrier ∖ {a} ∈ X.opens
    rw opensEq
    exact powerset.membership_iff.backward with sc
  have cover : A ⊆ {a} ∪ (X.carrier ∖ {a})
    intros z hz
    by_cases za : z = a
    . have zz : z ∈ {a} by simp [za]
      exact union2.left at z, {a}, X.carrier ∖ {a} with zz
    . have zd : z ∈ X.carrier ∖ {a}
        apply difference.membership.backward
        refine ⟨(sub with z, hz), ?_⟩
        intro bad
        simp at bad
      exact union2.right at z, {a}, X.carrier ∖ {a} with zd
  have disj : Disjoint({a} ∩ A, (X.carrier ∖ {a}) ∩ A)
    unfold Disjoint
    ext z
    constructor
    . intro hz
      have hz2 := intersection.membership.forward with hz
      have l := intersection.membership.forward with hz2.left
      have r := intersection.membership.forward with hz2.right
      have r2 := difference.membership.forward with r.left
      exfalso
      exact r2.right with l.left
    . intro hz
      exfalso
      exact set.empty with hz
  have aa : a ∈ {a} by simp
  have ne1 : Nonempty({a} ∩ A)
    unfold Nonempty
    exact ⟨a, (intersection.membership.backward with ⟨aa, ha⟩)⟩
  have bd : b ∈ X.carrier ∖ {a}
    apply difference.membership.backward
    refine ⟨bX, ?_⟩
    intro bad
    simp at bad
    have e : a = b
      rw bad
    exact ne with e
  have ne2 : Nonempty((X.carrier ∖ {a}) ∩ A)
    unfold Nonempty
    exact ⟨b, (intersection.membership.backward with ⟨bd, hb⟩)⟩
  refine ⟨{a}, X.carrier ∖ {a}, ?_⟩
  unfold OpenSeparation
  exact ⟨oa, oc, cover, disj, ne1, ne2⟩

theorem TotallyDisconnected.subspace (X A : Set)
  requires totally : TotallyDisconnected(X)
  requires inside : A ⊆ X.carrier
  shows TotallyDisconnected(subspace(X, A))
proof
  sorry

theorem TotallyDisconnected.product (X Y : Set)
  requires totallyX : TotallyDisconnected(X)
  requires totallyY : TotallyDisconnected(Y)
  shows TotallyDisconnected(productSpace(X, Y))
proof
  sorry

-- In a compact Hausdorff totally disconnected space the clopen sets form
-- a basis: every open neighborhood of a point contains a clopen one.
theorem Profinite.clopen_basis (X U x : Set)
  requires profinite : Profinite(X)
  requires open : U ∈ X.opens
  requires point : x ∈ U
  shows ∃ V, Clopen(X, V) ∧ x ∈ V ∧ V ⊆ U
proof
  sorry

-- Every clopen subset of a profinite space is compact.
theorem Profinite.clopen_compact (X U : Set)
  requires profinite : Profinite(X)
  requires clopen : Clopen(X, U)
  shows Compact(X, U)
proof
  obtain ⟨space, compact, haus, totally⟩ := profinite
  obtain ⟨op, closed⟩ := clopen
  have cc := (Compact.space_iff at X with space).forward with compact
  obtain ⟨Usub, _⟩ := closed
  exact Compact.of_closed_subset at X, X.carrier, U with space, cc, closed, Usub

theorem Profinite.finite_discrete (X : Set)
  requires discrete : DiscreteTopology(X)
  requires finite : Finite(X.carrier)
  shows Profinite(X)
proof
  have d2 := discrete
  obtain ⟨space, opensEq⟩ := d2
  unfold Profinite
  refine ⟨space, (Compact.space_of_finite at X with space, finite), (DiscreteTopology.hausdorff with discrete), (TotallyDisconnected.discrete with discrete)⟩

theorem Profinite.closed_subspace (X A : Set)
  requires profinite : Profinite(X)
  requires closed : Closed(X, A)
  shows Profinite(subspace(X, A))
proof
  sorry

theorem Profinite.product (X Y : Set)
  requires profiniteX : Profinite(X)
  requires profiniteY : Profinite(Y)
  shows Profinite(productSpace(X, Y))
proof
  sorry

-- A locally constant map on a profinite space factors through a finite
-- partition into clopen sets.
theorem Profinite.locally_constant_partition (f X : Set)
  requires profinite : Profinite(X)
  requires locally : IsLocallyConstant(f, X)
  shows ∃ P, Finite(P) ∧ (∀ V ∈ P, Clopen(X, V) ∧ Nonempty(V)) ∧
    (∀ x ∈ X.carrier, ∃ V ∈ P, x ∈ V) ∧
    (∀ V ∈ P, ∀ W ∈ P, V ≠ W → Disjoint(V, W)) ∧
    (∀ V ∈ P, ∀ x ∈ V, ∀ y ∈ V, f(x) = f(y))
proof
  sorry

-- Helpers for the extreme value theorem: open rays of ℝ, the preimages
-- of the rays below and above the values of f, and the largest and the
-- smallest value of f on a finite set.
def cptBelow (T : Set) : Set := { r ∈ ℝ | r < T }
def cptAbove (T : Set) : Set := { r ∈ ℝ | T < r }

theorem cptBelow.open (T : Set)
  requires real : T ∈ ℝ
  shows cptBelow(T) ∈ realTopology
proof
  apply realTopology.membership.backward
  have inside : cptBelow(T) ⊆ ℝ
    intros y hy
    exact (cptBelow.membership.forward with hy).left
  refine ⟨(powerset.membership_iff.backward with inside), ?_⟩
  intros x hx
  obtain ⟨realX, below⟩ := cptBelow.membership.forward with hx
  have rad : T - x ∈ ℝ by typecheck
  have positive : (0:R) < T - x by linarith
  refine ⟨T - x, rad, positive, ?_⟩
  intros y hy
  obtain ⟨realY, near⟩ := openBall.membership.forward with hy
  obtain ⟨lowerY, upperY⟩ := openBall.order_characterization.forward with hy
  apply cptBelow.membership.backward
  refine ⟨realY, ?_⟩
  linarith

theorem cptAbove.open (T : Set)
  requires real : T ∈ ℝ
  shows cptAbove(T) ∈ realTopology
proof
  apply realTopology.membership.backward
  have inside : cptAbove(T) ⊆ ℝ
    intros y hy
    exact (cptAbove.membership.forward with hy).left
  refine ⟨(powerset.membership_iff.backward with inside), ?_⟩
  intros x hx
  obtain ⟨realX, above⟩ := cptAbove.membership.forward with hx
  have rad : x - T ∈ ℝ by typecheck
  have positive : (0:R) < x - T by linarith
  refine ⟨x - T, rad, positive, ?_⟩
  intros y hy
  obtain ⟨realY, near⟩ := openBall.membership.forward with hy
  obtain ⟨lowerY, upperY⟩ := openBall.order_characterization.forward with hy
  apply cptAbove.membership.backward
  refine ⟨realY, ?_⟩
  linarith

defgraph cptBelowPre (f X : Set) (z ∈ TopologicalSpace.carrier(X)) :
    𝒫(TopologicalSpace.carrier(X)) :=
  functionPreimage(f, TopologicalSpace.carrier(X), cptBelow(f(z)))
proof
  apply powerset.membership_iff.backward
  intros y hy
  exact (functionPreimage.membership.forward with hy).left

defgraph cptAbovePre (f X : Set) (z ∈ TopologicalSpace.carrier(X)) :
    𝒫(TopologicalSpace.carrier(X)) :=
  functionPreimage(f, TopologicalSpace.carrier(X), cptAbove(f(z)))
proof
  apply powerset.membership_iff.backward
  intros y hy
  exact (functionPreimage.membership.forward with hy).left

def cptArgmaxFamilies (f J : Set) : Set :=
  { G ∈ 𝒫(J) | G = ∅ ∨ (∃ m ∈ G, ∀ z ∈ G, f(z) ≤ f(m)) }
def cptArgminFamilies (f J : Set) : Set :=
  { G ∈ 𝒫(J) | G = ∅ ∨ (∃ m ∈ G, ∀ z ∈ G, f(m) ≤ f(z)) }

theorem cptFinite.argmax (f J : Set)
  requires finite : Finite(J)
  requires nonempty : Nonempty(J)
  requires real : ∀ z ∈ J, f(z) ∈ ℝ
  shows ∃ m ∈ J, ∀ z ∈ J, f(z) ≤ f(m)
proof
  have base : ∅ ∈ cptArgmaxFamilies(f, J)
    apply cptArgmaxFamilies.membership.backward
    refine ⟨(powerset.membership_iff.backward with (empty.subset at J)), ?_⟩
    left
    rfl
  have step : ∀ G ⊆ J, Finite(G) → ∀ W ∈ J, W ∉ G →
      G ∈ cptArgmaxFamilies(f, J) → G ∪ {W} ∈ cptArgmaxFamilies(f, J)
    intros G hG finiteG W hW fresh known
    obtain ⟨_, shape⟩ := cptArgmaxFamilies.membership.forward with known
    have bound : G ∪ {W} ⊆ J
      intros Z hZ
      cases (union2.membership.forward with hZ) with inG | isW
      . exact hG with Z, inG
      . rwa (singleton.membership.forward with isW)
    have WIn : W ∈ G ∪ {W} := union2.right with (singleton.membership.backward with rfl)
    have fW := real with W, hW
    apply cptArgmaxFamilies.membership.backward
    refine ⟨(powerset.membership_iff.backward with bound), ?_⟩
    right
    cases shape with empty | found
    . refine ⟨W, WIn, ?_⟩
      intros z hz
      cases (union2.membership.forward with hz) with inG | isW
      . rw empty at inG
        simp at inG
      . rw (singleton.membership.forward with isW)
        exact realLe.reflexive
    . obtain ⟨m, hm, maxm⟩ := found
      have fm := real with m, (hG with m, hm)
      have mIn : m ∈ G ∪ {W} := union2.left with hm
      by_cases le : f(W) ≤ f(m)
      . refine ⟨m, mIn, ?_⟩
        intros z hz
        cases (union2.membership.forward with hz) with inG | isW
        . exact maxm with z, inG
        . rw (singleton.membership.forward with isW)
          exact le
      . have lt := realLess.of_not_le with le
        refine ⟨W, WIn, ?_⟩
        intros z hz
        cases (union2.membership.forward with hz) with inG | isW
        . have fz := real with z, (hG with z, inG)
          have zm := maxm with z, inG
          linarith
        . rw (singleton.membership.forward with isW)
          exact realLe.reflexive
  have all := Finite.induction with base, step
  have member := all with J, (Subset.reflexive at J), finite
  obtain ⟨_, shape⟩ := cptArgmaxFamilies.membership.forward with member
  cases shape with empty | found
  . obtain ⟨y, hy⟩ := nonempty
    rw empty at hy
    simp at hy
  . exact found

theorem cptFinite.argmin (f J : Set)
  requires finite : Finite(J)
  requires nonempty : Nonempty(J)
  requires real : ∀ z ∈ J, f(z) ∈ ℝ
  shows ∃ m ∈ J, ∀ z ∈ J, f(m) ≤ f(z)
proof
  have base : ∅ ∈ cptArgminFamilies(f, J)
    apply cptArgminFamilies.membership.backward
    refine ⟨(powerset.membership_iff.backward with (empty.subset at J)), ?_⟩
    left
    rfl
  have step : ∀ G ⊆ J, Finite(G) → ∀ W ∈ J, W ∉ G →
      G ∈ cptArgminFamilies(f, J) → G ∪ {W} ∈ cptArgminFamilies(f, J)
    intros G hG finiteG W hW fresh known
    obtain ⟨_, shape⟩ := cptArgminFamilies.membership.forward with known
    have bound : G ∪ {W} ⊆ J
      intros Z hZ
      cases (union2.membership.forward with hZ) with inG | isW
      . exact hG with Z, inG
      . rwa (singleton.membership.forward with isW)
    have WIn : W ∈ G ∪ {W} := union2.right with (singleton.membership.backward with rfl)
    have fW := real with W, hW
    apply cptArgminFamilies.membership.backward
    refine ⟨(powerset.membership_iff.backward with bound), ?_⟩
    right
    cases shape with empty | found
    . refine ⟨W, WIn, ?_⟩
      intros z hz
      cases (union2.membership.forward with hz) with inG | isW
      . rw empty at inG
        simp at inG
      . rw (singleton.membership.forward with isW)
        exact realLe.reflexive
    . obtain ⟨m, hm, minm⟩ := found
      have fm := real with m, (hG with m, hm)
      have mIn : m ∈ G ∪ {W} := union2.left with hm
      by_cases le : f(m) ≤ f(W)
      . refine ⟨m, mIn, ?_⟩
        intros z hz
        cases (union2.membership.forward with hz) with inG | isW
        . exact minm with z, inG
        . rw (singleton.membership.forward with isW)
          exact le
      . have lt := realLess.of_not_le with le
        refine ⟨W, WIn, ?_⟩
        intros z hz
        cases (union2.membership.forward with hz) with inG | isW
        . have fz := real with z, (hG with z, inG)
          have zm := minm with z, inG
          linarith
        . rw (singleton.membership.forward with isW)
          exact realLe.reflexive
  have all := Finite.induction with base, step
  have member := all with J, (Subset.reflexive at J), finite
  obtain ⟨_, shape⟩ := cptArgminFamilies.membership.forward with member
  cases shape with empty | found
  . obtain ⟨y, hy⟩ := nonempty
    rw empty at hy
    simp at hy
  . exact found

-- The balls of natural radius about x in a metric space, as a sequence.
defgraph cptBalls (M x : Set) (n ∈ ℕ) : 𝒫(MetricSpace.carrier(M)) :=
  ball(M, x, realNat(n))
requires metric : MetricSpace(M) ∧ x ∈ MetricSpace.carrier(M)
proof
  obtain ⟨space, xIn⟩ := metric
  apply powerset.membership_iff.backward
  exact ball_subset at M, x, realNat(n) with space, xIn

-- Section: Compact spaces and real-valued maps
-- The extreme value theorem: a continuous real map on a nonempty compact
-- set attains its maximum and its minimum.
theorem Compact.exists_max (f X K : Set)
  requires continuous : f : X ⇒ realLine
  requires compact : Compact(X, K)
  requires nonempty : Nonempty(K)
  shows ∃ x ∈ K, ∀ y ∈ K, f(y) ≤ f(x)
proof
  have fn := Continuous.function_between at f, X, realLine with continuous
  rw realLine.carrier at fn
  have ic := compact
  unfold Compact at ic
  obtain ⟨Ksub, _⟩ := ic
  by_contra noMax
  have above : ∀ y ∈ K, ∃ z ∈ K, y ∈ cptBelowPre(f, X)(z)
    intros y hy
    by_contra none
    apply noMax
    refine ⟨y, hy, ?_⟩
    intros z hz
    by_contra notLe
    apply none
    have yX := Ksub with y, hy
    have zX := Ksub with z, hz
    have fyR := FunctionBetween.apply_closed with fn, yX
    have fzR := FunctionBetween.apply_closed with fn, zX
    have fyT : Real(f(y)) by exact fyR
    have fzT : Real(f(z)) by exact fzR
    have lt := realLess.of_not_le with notLe
    refine ⟨z, hz, ?_⟩
    rw (cptBelowPre.value with zX)
    apply functionPreimage.membership.backward
    refine ⟨yX, ?_⟩
    apply cptBelow.membership.backward
    exact ⟨fyR, lt⟩
  have opens : ∀ z ∈ K, cptBelowPre(f, X)(z) ∈ X.opens
    intros z hz
    have zX := Ksub with z, hz
    rw (cptBelowPre.value with zX)
    have fz := FunctionBetween.apply_closed with fn, zX
    have ray := cptBelow.open at f(z) with fz
    have op : Open(realLine, cptBelow(f(z)))
      unfold Open
      rw realLine.opens
      exact ray
    have pre := Continuous.preimage_open at f, X, realLine, cptBelow(f(z)) with continuous, op
    unfold Open at pre
    exact pre
  obtain ⟨J, JK, finJ, cov⟩ := Compact.finite_subcover at X, K, K, cptBelowPre(f, X) with compact, opens, above
  obtain ⟨y0, hy0⟩ := nonempty
  obtain ⟨i0, hi0, _⟩ := cov with y0, hy0
  have neJ : Nonempty(J) by exact ⟨i0, hi0⟩
  have realJ : ∀ z ∈ J, f(z) ∈ ℝ
    intros z hz
    exact FunctionBetween.apply_closed with fn, (Ksub with z, (JK with z, hz))
  obtain ⟨m, hm, maxm⟩ := cptFinite.argmax with finJ, neJ, realJ
  have mK := JK with m, hm
  obtain ⟨i, hi, mi⟩ := cov with m, mK
  have iX := Ksub with i, (JK with i, hi)
  rw (cptBelowPre.value with iX) at mi
  obtain ⟨_, mray⟩ := functionPreimage.membership.forward with mi
  obtain ⟨fmR, lt⟩ := cptBelow.membership.forward with mray
  have le := maxm with i, hi
  have fiR := realJ with i, hi
  have fiT : Real(f(i)) by exact fiR
  have fmT : Real(f(m)) by exact fmR
  linarith

theorem Compact.exists_min (f X K : Set)
  requires continuous : f : X ⇒ realLine
  requires compact : Compact(X, K)
  requires nonempty : Nonempty(K)
  shows ∃ x ∈ K, ∀ y ∈ K, f(x) ≤ f(y)
proof
  have fn := Continuous.function_between at f, X, realLine with continuous
  rw realLine.carrier at fn
  have ic := compact
  unfold Compact at ic
  obtain ⟨Ksub, _⟩ := ic
  by_contra noMin
  have above : ∀ y ∈ K, ∃ z ∈ K, y ∈ cptAbovePre(f, X)(z)
    intros y hy
    by_contra none
    apply noMin
    refine ⟨y, hy, ?_⟩
    intros z hz
    by_contra notLe
    apply none
    have yX := Ksub with y, hy
    have zX := Ksub with z, hz
    have fyR := FunctionBetween.apply_closed with fn, yX
    have fzR := FunctionBetween.apply_closed with fn, zX
    have fyT : Real(f(y)) by exact fyR
    have fzT : Real(f(z)) by exact fzR
    have lt := realLess.of_not_le with notLe
    refine ⟨z, hz, ?_⟩
    rw (cptAbovePre.value with zX)
    apply functionPreimage.membership.backward
    refine ⟨yX, ?_⟩
    apply cptAbove.membership.backward
    exact ⟨fyR, lt⟩
  have opens : ∀ z ∈ K, cptAbovePre(f, X)(z) ∈ X.opens
    intros z hz
    have zX := Ksub with z, hz
    rw (cptAbovePre.value with zX)
    have fz := FunctionBetween.apply_closed with fn, zX
    have ray := cptAbove.open at f(z) with fz
    have op : Open(realLine, cptAbove(f(z)))
      unfold Open
      rw realLine.opens
      exact ray
    have pre := Continuous.preimage_open at f, X, realLine, cptAbove(f(z)) with continuous, op
    unfold Open at pre
    exact pre
  obtain ⟨J, JK, finJ, cov⟩ := Compact.finite_subcover at X, K, K, cptAbovePre(f, X) with compact, opens, above
  obtain ⟨y0, hy0⟩ := nonempty
  obtain ⟨i0, hi0, _⟩ := cov with y0, hy0
  have neJ : Nonempty(J) by exact ⟨i0, hi0⟩
  have realJ : ∀ z ∈ J, f(z) ∈ ℝ
    intros z hz
    exact FunctionBetween.apply_closed with fn, (Ksub with z, (JK with z, hz))
  obtain ⟨m, hm, minm⟩ := cptFinite.argmin with finJ, neJ, realJ
  have mK := JK with m, hm
  obtain ⟨i, hi, mi⟩ := cov with m, mK
  have iX := Ksub with i, (JK with i, hi)
  rw (cptAbovePre.value with iX) at mi
  obtain ⟨_, mray⟩ := functionPreimage.membership.forward with mi
  obtain ⟨fmR, lt⟩ := cptAbove.membership.forward with mray
  have le := minm with i, hi
  have fiR := realJ with i, hi
  have fiT : Real(f(i)) by exact fiR
  have fmT : Real(f(m)) by exact fmR
  linarith

theorem Compact.bounded (f X K : Set)
  requires continuous : f : X ⇒ realLine
  requires compact : Compact(X, K)
  shows ∃ B ∈ ℝ, ∀ y ∈ K, abs(f(y)) ≤ B
proof
  have fn := Continuous.function_between at f, X, realLine with continuous
  rw realLine.carrier at fn
  have ic := compact
  unfold Compact at ic
  obtain ⟨Ksub, _⟩ := ic
  by_cases ne : Nonempty(K)
  . obtain ⟨M, hM, maxM⟩ := Compact.exists_max at f, X, K with continuous, compact, ne
    obtain ⟨m, hm, minm⟩ := Compact.exists_min at f, X, K with continuous, compact, ne
    have fMR := FunctionBetween.apply_closed with fn, (Ksub with M, hM)
    have fmR := FunctionBetween.apply_closed with fn, (Ksub with m, hm)
    have fMT : Real(f(M)) by exact fMR
    have fmT : Real(f(m)) by exact fmR
    have a1 := abs.upper at f(M)
    have a2 := abs.upper_neg at f(m)
    have a3 := abs.nonnegative at f(M)
    have a4 := abs.nonnegative at f(m)
    have aM := abs.real at f(M)
    have am := abs.real at f(m)
    have BR : abs(f(M)) + abs(f(m)) ∈ ℝ by typecheck
    refine ⟨abs(f(M)) + abs(f(m)), BR, ?_⟩
    intros y hy
    have fyR := FunctionBetween.apply_closed with fn, (Ksub with y, hy)
    have fyT : Real(f(y)) by exact fyR
    have up := maxM with y, hy
    have lo := minm with y, hy
    by_cases sign : (0:R) ≤ f(y)
    . rw (abs.of_nonnegative at f(y) with sign)
      linarith
    . have neg := realLess.of_not_le with sign
      have np : f(y) ≤ (0:R) by linarith
      rw (abs.of_nonpositive at f(y) with np)
      linarith
  . have zR : realZero ∈ ℝ by typecheck
    refine ⟨realZero, zR, ?_⟩
    intros y hy
    exfalso
    exact ne with ⟨y, hy⟩

-- A positive continuous function on a compact set has a positive lower
-- bound there.
theorem Compact.positive_lower_bound (f X K : Set)
  requires continuous : f : X ⇒ realLine
  requires compact : Compact(X, K)
  requires positive : ∀ y ∈ K, realZero < f(y)
  shows ∃ c ∈ ℝ, realZero < c ∧ (∀ y ∈ K, c ≤ f(y))
proof
  have fn := Continuous.function_between at f, X, realLine with continuous
  rw realLine.carrier at fn
  have ic := compact
  unfold Compact at ic
  obtain ⟨Ksub, _⟩ := ic
  by_cases ne : Nonempty(K)
  . obtain ⟨m, hm, minm⟩ := Compact.exists_min at f, X, K with continuous, compact, ne
    have fmR := FunctionBetween.apply_closed with fn, (Ksub with m, hm)
    exact ⟨f(m), fmR, (positive with m, hm), minm⟩
  . have oR : realOne ∈ ℝ by typecheck
    have pos : realZero < realOne by typecheck
    refine ⟨realOne, oR, pos, ?_⟩
    intros y hy
    exfalso
    exact ne with ⟨y, hy⟩

-- Heine–Cantor for metric spaces: continuous maps on compact metric
-- spaces are uniformly continuous.
theorem Compact.uniformly_continuous (f M N : Set)
  requires metricM : MetricSpace(M)
  requires metricN : MetricSpace(N)
  requires compact : Compact(metricTopology(M))
  requires continuous : f : metricTopology(M) ⇒ metricTopology(N)
  shows ∀ e ∈ ℝ, realZero < e → ∃ d ∈ ℝ, realZero < d ∧
    (∀ x ∈ M.carrier, ∀ y ∈ M.carrier, M.dist(x, y) < d →
      N.dist(f(x), f(y)) < e)
proof
  sorry

-- A compact subset of a metric space is closed and bounded.
theorem Compact.metric_bounded (M K : Set)
  requires metric : MetricSpace(M)
  requires compact : Compact(metricTopology(M), K)
  shows ∀ x ∈ M.carrier, ∃ r ∈ ℝ, K ⊆ ball(M, x, r)
proof
  intros x hx
  have req : MetricSpace(M) ∧ x ∈ MetricSpace.carrier(M) by exact ⟨metric, hx⟩
  have space := MetricSpace.topological_space at M with metric
  have Ksub := Compact.subset_carrier at metricTopology(M), K with space, compact
  rw metricTopology.carrier at Ksub
  have opens : ∀ n ∈ ℕ, cptBalls(M, x)(n) ∈ TopologicalSpace.opens(metricTopology(M))
    intros n hn
    rw (cptBalls.value with req, hn)
    have o := ball_open at M, x, realNat(n) with metric, hx
    unfold Open at o
    exact o
  have incr : ∀ m ∈ ℕ, ∀ n ∈ ℕ, m ≤ n → cptBalls(M, x)(m) ⊆ cptBalls(M, x)(n)
    intros m hm n hn mn
    rw [(cptBalls.value with req, hm), (cptBalls.value with req, hn)]
    have le := realNat.le_of_natural_le at m, n with mn
    exact ball_mono at M, x, realNat(m), realNat(n) with metric, hx, le
  have covers : ∀ y ∈ K, ∃ n ∈ ℕ, y ∈ cptBalls(M, x)(n)
    intros y hy
    have yIn := Ksub with y, hy
    have dR := dist_real at M, x, y with metric, hx, yIn
    obtain ⟨n, nNat, lt⟩ := Real.below_natural at MetricSpace.dist(M)(x, y)
    have nIn : n ∈ ℕ by exact nNat
    refine ⟨n, nIn, ?_⟩
    rw (cptBalls.value with req, nIn)
    exact (mem_ball at M, x, y, realNat(n) with metric, hx, yIn).backward with lt
  obtain ⟨n, hn, Kn⟩ := Compact.directed_cover at metricTopology(M), K, cptBalls(M, x) with compact, opens, incr, covers
  rw (cptBalls.value with req, hn) at Kn
  have rR : realNat(n) ∈ ℝ by typecheck
  exact ⟨realNat(n), rR, Kn⟩

-- A continuous bijection from a compact space onto a Hausdorff space is a
-- homeomorphism (Cumulus's IsHomeomorphism.compact_hausdorff, bundled).
theorem Compact.homeomorphism (f X Y : Set)
  requires continuous : f : X ⇒ Y
  requires compact : Compact(X)
  requires hausdorff : Hausdorff(Y)
  requires bijective : BijectiveBetween(f, X.carrier, Y.carrier)
  shows Homeomorphism(f, X, Y)
proof
  have spaceX := Continuous.source with continuous
  have spaceY := Continuous.target with continuous
  have partsX := TopologicalSpace.parts with spaceX
  have partsY := TopologicalSpace.parts with spaceY
  have cpt := Compact.space_parts with compact
  have haus := Hausdorff.parts with hausdorff
  have engine := Continuous.parts with continuous
  have homeo := IsHomeomorphism.compact_hausdorff with partsX, partsY, cpt, haus, bijective, engine
  exact Homeomorphism.of_parts with spaceX, spaceY, homeo

end Compactness
