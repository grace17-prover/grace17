-- Filters on a set and limits along them: filters as families of subsets,
-- "eventually" and "frequently" as membership, principal filters, images
-- and preimages, infima and products of filters; limits along a filter;
-- the filters at infinity on ℕ and ℝ, the cofinite filter, neighborhoods
-- in a topological space and within a subset; continuity as a limit, the
-- uniqueness of limits in Hausdorff spaces, and the ε–δ and ε–N forms of
-- limits in metric spaces and on ℝ.
-- Part of the GRH blueprint.
-- Planned home: Topology/Filter.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Topology.Filters
import Grace.Cumulus.Metric.Structure
import Grace.Cumulus.Real.Analysis.Continuity

section Filters
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Section: Filters
-- A filter on X is a family of subsets of X that contains X and is closed
-- under supersets inside X and under binary intersections. It is proper
-- (Mathlib's NeBot) when it does not contain ∅. The trivial family 𝒫(X)
-- is the filter ⊥ and {X} the filter ⊤. A filter is a set of sets, so no
-- choice of representative is involved anywhere below.
predicate IsFilter (X F : Set) :=
  F ⊆ 𝒫(X) ∧ X ∈ F ∧
  (∀ A ∈ F, ∀ B, A ⊆ B → B ⊆ X → B ∈ F) ∧
  (∀ A ∈ F, ∀ B ∈ F, A ∩ B ∈ F)

predicate ProperFilter (X F : Set) := IsFilter(X, F) ∧ ∅ ∉ F

-- F ≤ G (F is finer than G): every member of G is a member of F.
predicate FilterLe (F G : Set) := G ⊆ F

-- "∀ᶠ x in F, x ∈ S": S contains a member of F. S need not lie inside X,
-- so a property of the points is written as the set it cuts out of any
-- larger set. "∃ᶠ x in F, x ∈ S": S meets every member of F.
predicate Eventually (F S : Set) := ∃ A ∈ F, A ⊆ S
predicate Frequently (F S : Set) := ∀ A ∈ F, Nonempty(A ∩ S)

-- The principal filter of A ⊆ X, the subsets of X containing A.
def principalFilter (X A : Set) : Set := { B ∈ 𝒫(X) | A ⊆ B }

-- The image of a filter F on X under f, a filter on Y; the preimage of a
-- filter G on Y under f, a filter on X; the infimum F ⊓ G of two filters
-- on X; the supremum F ⊔ G; the product F ×ˢ G on X × Y.
def filterMap (f X Y F : Set) : Set :=
  { B ∈ 𝒫(Y) | functionPreimage(f, X, B) ∈ F }
def filterComap (f X G : Set) : Set :=
  { A ∈ 𝒫(X) | ∃ B ∈ G, functionPreimage(f, X, B) ⊆ A }
def filterInf (X F G : Set) : Set :=
  { C ∈ 𝒫(X) | ∃ A ∈ F, ∃ B ∈ G, A ∩ B ⊆ C }
def filterSup (F G : Set) : Set := F ∩ G
def filterProd (X F Y G : Set) : Set :=
  { C ∈ 𝒫(X × Y) | ∃ A ∈ F, ∃ B ∈ G, A × B ⊆ C }

-- Tendsto f F G: f maps F into G, that is, the preimage in X of every
-- member of G is a member of F. Only the values of f on X are read.
predicate Tendsto (f X F G : Set) :=
  ∀ B ∈ G, functionPreimage(f, X, B) ∈ F

-- Section: Filters at infinity and the cofinite filter
-- The sets of naturals containing every n ≥ N for some N; the sets of
-- reals containing [M, ∞) for some M, and (−∞, M] for some M; the subsets
-- of X with finite complement.
def natAtTop : Set :=
  { A ∈ 𝒫(ℕ) | ∃ N ∈ ℕ, ∀ n ∈ ℕ, N ≤ n → n ∈ A }
def realAtTop : Set :=
  { A ∈ 𝒫(ℝ) | ∃ M ∈ ℝ, ∀ x ∈ ℝ, M ≤ x → x ∈ A }
def realAtBot : Set :=
  { A ∈ 𝒫(ℝ) | ∃ M ∈ ℝ, ∀ x ∈ ℝ, x ≤ M → x ∈ A }
def cofinite (X : Set) : Set := { A ∈ 𝒫(X) | Finite(X ∖ A) }

-- Section: Neighborhoods
-- The neighborhood filter of x in the space X; the neighborhoods of x
-- within S, 𝓝[S] x = 𝓝 x ⊓ 𝓟 S; the punctured neighborhoods 𝓝[≠] x.
def nhds (X x : Set) : Set :=
  { N ∈ 𝒫(TopologicalSpace.carrier(X)) |
    ∃ U ∈ TopologicalSpace.opens(X), x ∈ U ∧ U ⊆ N }
def nhdsWithin (X x S : Set) : Set :=
  filterInf(TopologicalSpace.carrier(X), nhds(X, x),
    principalFilter(TopologicalSpace.carrier(X),
      S ∩ TopologicalSpace.carrier(X)))
def nhdsPunctured (X x : Set) : Set :=
  nhdsWithin(X, x, TopologicalSpace.carrier(X) ∖ {x})

-- f is continuous at x: f(y) → f(x) as y → x. f is continuous within S
-- at x: the same along 𝓝[S] x.
predicate ContinuousAtPoint (f X Y x : Set) :=
  Tendsto(f, TopologicalSpace.carrier(X), nhds(X, x), nhds(Y, f(x)))
predicate ContinuousWithinAtPoint (f X Y S x : Set) :=
  Tendsto(f, TopologicalSpace.carrier(X), nhdsWithin(X, x, S),
    nhds(Y, f(x)))

-- x is a cluster point of the filter F on the carrier of X: every
-- neighborhood of x meets every member of F.
predicate ClusterPt (X x F : Set) :=
  x ∈ TopologicalSpace.carrier(X) ∧ ProperFilter(TopologicalSpace.carrier(X),
    filterInf(TopologicalSpace.carrier(X), nhds(X, x), F))

-- Where two maps agree on A, and where f ≤ g on A for real values.
def equalizer (f g A : Set) : Set := { x ∈ A | f(x) = g(x) }
def realLeLocus (f g A : Set) : Set := { x ∈ A | f(x) ≤ g(x) }

-- Section: Laws of filters
theorem IsFilter.subset (X F A : Set)
  requires filter : IsFilter(X, F)
  requires member : A ∈ F
  shows A ⊆ X
proof
  sorry

theorem IsFilter.whole (X F : Set)
  requires filter : IsFilter(X, F)
  shows X ∈ F
proof
  sorry

theorem IsFilter.mono (X F A B : Set)
  requires filter : IsFilter(X, F)
  requires member : A ∈ F
  requires inside : A ⊆ B
  requires within : B ⊆ X
  shows B ∈ F
proof
  sorry

theorem IsFilter.inter (X F A B : Set)
  requires filter : IsFilter(X, F)
  requires memberA : A ∈ F
  requires memberB : B ∈ F
  shows A ∩ B ∈ F
proof
  sorry

-- A finite intersection of members, indexed by n = {0, …, n − 1}.
theorem IsFilter.finite_inter (X F A : Set, n : Nat)
  requires filter : IsFilter(X, F)
  requires members : ∀ i ∈ n, A(i) ∈ F
  shows ∃ B ∈ F, ∀ x ∈ B, ∀ i ∈ n, x ∈ A(i)
proof
  sorry

theorem IsFilter.powerset (X : Set)
  shows IsFilter(X, 𝒫(X))
proof
  sorry

theorem IsFilter.top (X : Set)
  shows IsFilter(X, {X})
proof
  sorry

theorem ProperFilter.nonempty (X F A : Set)
  requires proper : ProperFilter(X, F)
  requires member : A ∈ F
  shows Nonempty(A)
proof
  sorry

theorem ProperFilter.of_nonempty (X F : Set)
  requires filter : IsFilter(X, F)
  requires nonempty : ∀ A ∈ F, Nonempty(A)
  shows ProperFilter(X, F)
proof
  sorry

theorem ProperFilter.carrier_nonempty (X F : Set)
  requires proper : ProperFilter(X, F)
  shows Nonempty(X)
proof
  sorry

theorem FilterLe.refl (F : Set)
  shows FilterLe(F, F)
proof
  sorry

theorem FilterLe.trans (F G H : Set)
  requires first : FilterLe(F, G)
  requires second : FilterLe(G, H)
  shows FilterLe(F, H)
proof
  sorry

theorem FilterLe.antisymm (F G : Set)
  requires first : FilterLe(F, G)
  requires second : FilterLe(G, F)
  shows F = G
proof
  sorry

-- Every filter on X lies below ⊤ = {X} and above ⊥ = 𝒫(X).
theorem FilterLe.top (X F : Set)
  requires filter : IsFilter(X, F)
  shows FilterLe(F, {X})
proof
  sorry

theorem FilterLe.bot (X F : Set)
  requires filter : IsFilter(X, F)
  shows FilterLe(𝒫(X), F)
proof
  sorry

-- A filter finer than a proper filter's refinement stays proper upward:
-- if F ≤ G and F is proper, then G is proper.
theorem ProperFilter.mono (X F G : Set)
  requires proper : ProperFilter(X, F)
  requires filterG : IsFilter(X, G)
  requires le : FilterLe(F, G)
  shows ProperFilter(X, G)
proof
  sorry

-- Section: Eventually and frequently
theorem Eventually.iff_mem (X F S : Set)
  requires filter : IsFilter(X, F)
  shows Eventually(F, S) ↔ X ∩ S ∈ F
proof
  sorry

theorem Eventually.of_mem (F S : Set)
  requires member : S ∈ F
  shows Eventually(F, S)
proof
  sorry

theorem Eventually.whole (X F S : Set)
  requires filter : IsFilter(X, F)
  requires inside : X ⊆ S
  shows Eventually(F, S)
proof
  sorry

theorem Eventually.mono (F S T : Set)
  requires eventually : Eventually(F, S)
  requires inside : S ⊆ T
  shows Eventually(F, T)
proof
  sorry

theorem Eventually.and (X F S T : Set)
  requires filter : IsFilter(X, F)
  requires first : Eventually(F, S)
  requires second : Eventually(F, T)
  shows Eventually(F, S ∩ T)
proof
  sorry

-- Along a proper filter an eventual property holds somewhere.
theorem Eventually.exists (X F S : Set)
  requires proper : ProperFilter(X, F)
  requires eventually : Eventually(F, S)
  shows ∃ x ∈ X, x ∈ S
proof
  sorry

theorem Eventually.frequently (X F S : Set)
  requires proper : ProperFilter(X, F)
  requires eventually : Eventually(F, S)
  shows Frequently(F, S)
proof
  sorry

theorem Frequently.not_eventually (X F S : Set)
  requires filter : IsFilter(X, F)
  shows Frequently(F, S) ↔ ¬Eventually(F, X ∖ S)
proof
  sorry

theorem Frequently.mono (F S T : Set)
  requires frequently : Frequently(F, S)
  requires inside : S ⊆ T
  shows Frequently(F, T)
proof
  sorry

theorem Frequently.and_eventually (X F S T : Set)
  requires filter : IsFilter(X, F)
  requires frequently : Frequently(F, S)
  requires eventually : Eventually(F, T)
  shows Frequently(F, S ∩ T)
proof
  sorry

-- Eventually along F ≤ G follows from eventually along G.
theorem Eventually.filter_mono (F G S : Set)
  requires le : FilterLe(F, G)
  requires eventually : Eventually(G, S)
  shows Eventually(F, S)
proof
  sorry

-- Section: Principal filters
theorem principalFilter.is_filter (X A : Set)
  requires inside : A ⊆ X
  shows IsFilter(X, principalFilter(X, A))
proof
  sorry

theorem principalFilter.mem_iff (X A B : Set)
  shows B ∈ principalFilter(X, A) ↔ B ⊆ X ∧ A ⊆ B
proof
  sorry

theorem principalFilter.proper_iff (X A : Set)
  requires inside : A ⊆ X
  shows ProperFilter(X, principalFilter(X, A)) ↔ Nonempty(A)
proof
  sorry

theorem principalFilter.le_iff (X F A : Set)
  requires filter : IsFilter(X, F)
  requires inside : A ⊆ X
  shows FilterLe(F, principalFilter(X, A)) ↔ A ∈ F
proof
  sorry

theorem principalFilter.whole (X : Set)
  shows principalFilter(X, X) = {X}
proof
  sorry

theorem principalFilter.empty (X : Set)
  shows principalFilter(X, ∅) = 𝒫(X)
proof
  sorry

-- Section: Images, preimages, infima, suprema, products
theorem filterMap.is_filter (f X Y F : Set)
  requires filter : IsFilter(X, F)
  requires function : f : X → Y
  shows IsFilter(Y, filterMap(f, X, Y, F))
proof
  sorry

theorem filterMap.proper (f X Y F : Set)
  requires proper : ProperFilter(X, F)
  requires function : f : X → Y
  shows ProperFilter(Y, filterMap(f, X, Y, F))
proof
  sorry

theorem filterMap.mem_iff (f X Y F B : Set)
  shows B ∈ filterMap(f, X, Y, F) ↔ B ⊆ Y ∧ functionPreimage(f, X, B) ∈ F
proof
  sorry

theorem filterComap.is_filter (f X Y G : Set)
  requires filter : IsFilter(Y, G)
  requires function : f : X → Y
  shows IsFilter(X, filterComap(f, X, G))
proof
  sorry

-- The preimage of a proper filter is proper when every member of G meets
-- the range of f.
theorem filterComap.proper (f X Y G : Set)
  requires filter : IsFilter(Y, G)
  requires function : f : X → Y
  requires meets : ∀ B ∈ G, ∃ x ∈ X, f(x) ∈ B
  shows ProperFilter(X, filterComap(f, X, G))
proof
  sorry

theorem filterMap.le_iff_le_comap (f X Y F G : Set)
  requires filterF : IsFilter(X, F)
  requires filterG : IsFilter(Y, G)
  requires function : f : X → Y
  shows FilterLe(filterMap(f, X, Y, F), G) ↔ FilterLe(F, filterComap(f, X, G))
proof
  sorry

theorem filterInf.is_filter (X F G : Set)
  requires filterF : IsFilter(X, F)
  requires filterG : IsFilter(X, G)
  shows IsFilter(X, filterInf(X, F, G))
proof
  sorry

theorem filterInf.le_left (X F G : Set)
  requires filterF : IsFilter(X, F)
  requires filterG : IsFilter(X, G)
  shows FilterLe(filterInf(X, F, G), F)
proof
  sorry

theorem filterInf.le_right (X F G : Set)
  requires filterF : IsFilter(X, F)
  requires filterG : IsFilter(X, G)
  shows FilterLe(filterInf(X, F, G), G)
proof
  sorry

theorem filterInf.greatest (X F G H : Set)
  requires filterH : IsFilter(X, H)
  requires leF : FilterLe(H, F)
  requires leG : FilterLe(H, G)
  shows FilterLe(H, filterInf(X, F, G))
proof
  sorry

-- F ⊓ 𝓟 A is proper exactly when A frequently holds along F.
theorem filterInf.principal_proper_iff (X F A : Set)
  requires filter : IsFilter(X, F)
  requires inside : A ⊆ X
  shows ProperFilter(X, filterInf(X, F, principalFilter(X, A))) ↔
    Frequently(F, A)
proof
  sorry

theorem filterSup.is_filter (X F G H : Set)
  requires filterF : IsFilter(X, F)
  requires filterG : IsFilter(X, G)
  requires sup : H = filterSup(F, G)
  shows IsFilter(X, H)
proof
  sorry

theorem filterProd.is_filter (X F Y G : Set)
  requires filterF : IsFilter(X, F)
  requires filterG : IsFilter(Y, G)
  shows IsFilter(X × Y, filterProd(X, F, Y, G))
proof
  sorry

theorem filterProd.proper (X F Y G : Set)
  requires properF : ProperFilter(X, F)
  requires properG : ProperFilter(Y, G)
  shows ProperFilter(X × Y, filterProd(X, F, Y, G))
proof
  sorry

theorem filterProd.mem_of (X F Y G A B : Set)
  requires filterF : IsFilter(X, F)
  requires filterG : IsFilter(Y, G)
  requires memberA : A ∈ F
  requires memberB : B ∈ G
  shows A × B ∈ filterProd(X, F, Y, G)
proof
  sorry

-- Section: Limits along filters
theorem Tendsto.mono_left (f X F F0 G : Set)
  requires tendsto : Tendsto(f, X, F, G)
  requires le : FilterLe(F0, F)
  shows Tendsto(f, X, F0, G)
proof
  sorry

theorem Tendsto.mono_right (f X F G G0 : Set)
  requires tendsto : Tendsto(f, X, F, G)
  requires le : FilterLe(G, G0)
  shows Tendsto(f, X, F, G0)
proof
  sorry

theorem Tendsto.identity (X F : Set)
  requires filter : IsFilter(X, F)
  shows Tendsto(identity(X), X, F, F)
proof
  sorry

theorem Tendsto.comp (f g X Y Z F G H : Set)
  requires function : f : X → Y
  requires functionG : g : Y → Z
  requires first : Tendsto(f, X, F, G)
  requires second : Tendsto(g, Y, G, H)
  shows Tendsto(compose(g, f, X, Y, Z), X, F, H)
proof
  sorry

-- The composite written with the values: x ↦ g(f(x)) given as any h that
-- agrees with it on X.
theorem Tendsto.comp_values (f g h X Y F G H : Set)
  requires function : f : X → Y
  requires values : ∀ x ∈ X, h(x) = g(f(x))
  requires first : Tendsto(f, X, F, G)
  requires second : Tendsto(g, Y, G, H)
  shows Tendsto(h, X, F, H)
proof
  sorry

theorem Tendsto.congr (f g X F G : Set)
  requires filter : IsFilter(X, F)
  requires agree : ∃ A ∈ F, ∀ x ∈ A, f(x) = g(x)
  requires tendsto : Tendsto(f, X, F, G)
  shows Tendsto(g, X, F, G)
proof
  sorry

theorem Tendsto.eventually (f X F G S : Set)
  requires tendsto : Tendsto(f, X, F, G)
  requires filter : IsFilter(X, F)
  requires eventually : Eventually(G, S)
  shows Eventually(F, functionPreimage(f, X, S))
proof
  sorry

theorem Tendsto.iff_map_le (f X Y F G : Set)
  requires function : f : X → Y
  requires filterG : IsFilter(Y, G)
  shows Tendsto(f, X, F, G) ↔ FilterLe(filterMap(f, X, Y, F), G)
proof
  sorry

theorem Tendsto.principal (f X Y F A : Set)
  requires function : f : X → Y
  requires filter : IsFilter(X, F)
  requires inside : A ⊆ Y
  shows Tendsto(f, X, F, principalFilter(Y, A)) ↔
    Eventually(F, functionPreimage(f, X, A))
proof
  sorry

theorem Tendsto.inf (f X Y F G H : Set)
  requires filter : IsFilter(X, F)
  requires function : f : X → Y
  requires first : Tendsto(f, X, F, G)
  requires second : Tendsto(f, X, F, H)
  shows Tendsto(f, X, F, filterInf(Y, G, H))
proof
  sorry

-- A map into a product tends to F ×ˢ G when both coordinates do.
theorem Tendsto.prod_mk (f X F Y G Z H : Set)
  requires function : f : X → Y × Z
  requires filterF : IsFilter(X, F)
  requires first : Tendsto(compose(firstProjection(Y, Z), f, X, Y × Z, Y),
    X, F, G)
  requires second : Tendsto(compose(secondProjection(Y, Z), f, X, Y × Z, Z),
    X, F, H)
  shows Tendsto(f, X, F, filterProd(Y, G, Z, H))
proof
  sorry

-- Section: Filters at infinity
theorem natAtTop.is_filter
  shows ProperFilter(ℕ, natAtTop)
proof
  sorry

theorem natAtTop.mem_iff (A : Set)
  shows A ∈ natAtTop ↔ A ⊆ ℕ ∧ (∃ N ∈ ℕ, ∀ n ∈ ℕ, N ≤ n → n ∈ A)
proof
  sorry

-- On ℕ the filter at infinity is the cofinite filter.
theorem natAtTop.eq_cofinite
  shows natAtTop = cofinite(ℕ)
proof
  sorry

theorem natAtTop.eventually_ge (N : Nat)
  shows ∃ A ∈ natAtTop, ∀ n ∈ A, N ≤ n
proof
  sorry

theorem natAtTop.shift (u : Set, k : Nat)
  requires function : u : ℕ → ℕ
  requires values : ∀ n ∈ ℕ, u(n) = add(n, k)
  shows Tendsto(u, ℕ, natAtTop, natAtTop)
proof
  sorry

theorem realAtTop.is_filter
  shows ProperFilter(ℝ, realAtTop)
proof
  sorry

theorem realAtBot.is_filter
  shows ProperFilter(ℝ, realAtBot)
proof
  sorry

theorem cofinite.is_filter (X F : Set)
  requires cofiniteF : F = cofinite(X)
  shows IsFilter(X, F)
proof
  sorry

theorem cofinite.proper_iff (X : Set)
  shows ProperFilter(X, cofinite(X)) ↔ ¬Finite(X)
proof
  sorry

-- The complement of a finite set is cofinite; in particular all but one
-- point.
theorem cofinite.compl_finite (X A : Set)
  requires finite : Finite(A)
  shows Eventually(cofinite(X), X ∖ A)
proof
  sorry

-- An injective map pulls cofinite sets back to cofinite sets.
theorem cofinite.tendsto_injective (f X Y : Set)
  requires injective : InjectiveBetween(f, X, Y)
  shows Tendsto(f, X, cofinite(X), cofinite(Y))
proof
  sorry

-- A sequence tends to infinity in ℕ along natAtTop exactly when it
-- eventually exceeds every bound.
theorem natAtTop.tendsto_iff (u X F : Set)
  requires filter : IsFilter(X, F)
  requires values : u : X → ℕ
  shows Tendsto(u, X, F, natAtTop) ↔
    (∀ N ∈ ℕ, ∃ A ∈ F, ∀ x ∈ A, N ≤ u(x))
proof
  sorry

theorem realAtTop.tendsto_iff (u X F : Set)
  requires filter : IsFilter(X, F)
  requires values : u : X → ℝ
  shows Tendsto(u, X, F, realAtTop) ↔
    (∀ M ∈ ℝ, ∃ A ∈ F, ∀ x ∈ A, M ≤ u(x))
proof
  sorry

-- n ↦ n as a real number tends to infinity.
theorem realNat.tendsto_atTop (u : Set)
  requires values : ∀ n ∈ ℕ, u(n) = realNat(n)
  shows Tendsto(u, ℕ, natAtTop, realAtTop)
proof
  sorry

-- Section: Neighborhoods
theorem nhds.is_filter (X x : Set)
  requires space : TopologicalSpace(X)
  requires point : x ∈ X.carrier
  shows ProperFilter(X.carrier, nhds(X, x))
proof
  sorry

theorem nhds.mem_iff (X x N : Set)
  requires space : TopologicalSpace(X)
  shows N ∈ nhds(X, x) ↔ Neighborhood(X, N, x)
proof
  sorry

theorem nhds.open_mem (X x U : Set)
  requires space : TopologicalSpace(X)
  requires open : U ∈ X.opens
  requires point : x ∈ U
  shows U ∈ nhds(X, x)
proof
  sorry

theorem nhds.mem_of (X x N : Set)
  requires space : TopologicalSpace(X)
  requires member : N ∈ nhds(X, x)
  shows x ∈ N
proof
  sorry

-- A set is open exactly when it is a neighborhood of each of its points.
theorem nhds.open_iff (X U : Set)
  requires space : TopologicalSpace(X)
  requires inside : U ⊆ X.carrier
  shows U ∈ X.opens ↔ (∀ x ∈ U, U ∈ nhds(X, x))
proof
  sorry

-- An eventual property near x holds at every point near x
-- (Mathlib's Filter.Eventually.eventually_nhds).
theorem nhds.eventually_eventually (X x S : Set)
  requires space : TopologicalSpace(X)
  requires eventually : Eventually(nhds(X, x), S)
  shows ∃ U ∈ nhds(X, x), ∀ y ∈ U,
    Eventually(nhds(X, y), S)
proof
  sorry

-- x is in the closure of A exactly when A frequently holds near x.
theorem nhds.closure_iff (X A x : Set)
  requires space : TopologicalSpace(X)
  requires point : x ∈ X.carrier
  requires inside : A ⊆ X.carrier
  shows x ∈ closure(X, A) ↔ Frequently(nhds(X, x), A)
proof
  sorry

theorem nhdsWithin.is_filter (X x S : Set)
  requires space : TopologicalSpace(X)
  shows IsFilter(X.carrier, nhdsWithin(X, x, S))
proof
  sorry

theorem nhdsWithin.mem_iff (X x S N : Set)
  requires space : TopologicalSpace(X)
  shows N ∈ nhdsWithin(X, x, S) ↔
    N ⊆ X.carrier ∧ (∃ U ∈ X.opens, x ∈ U ∧ U ∩ S ⊆ N)
proof
  sorry

theorem nhdsWithin.le_nhds (X x S : Set)
  requires space : TopologicalSpace(X)
  shows FilterLe(nhdsWithin(X, x, S), nhds(X, x))
proof
  sorry

theorem nhdsWithin.open_eq (X x U : Set)
  requires space : TopologicalSpace(X)
  requires open : U ∈ X.opens
  requires point : x ∈ U
  shows nhdsWithin(X, x, U) = nhds(X, x)
proof
  sorry

theorem nhdsWithin.self_mem (X x S : Set)
  requires space : TopologicalSpace(X)
  requires inside : S ⊆ X.carrier
  shows S ∈ nhdsWithin(X, x, S)
proof
  sorry

-- 𝓝[S] x is proper exactly when x lies in the closure of S.
theorem nhdsWithin.proper_iff (X x S : Set)
  requires space : TopologicalSpace(X)
  requires point : x ∈ X.carrier
  requires inside : S ⊆ X.carrier
  shows ProperFilter(X.carrier, nhdsWithin(X, x, S)) ↔ x ∈ closure(X, S)
proof
  sorry

-- The neighborhoods of a point of a product are the product filter.
theorem nhds.product (X Y x y : Set)
  requires spaceX : TopologicalSpace(X)
  requires spaceY : TopologicalSpace(Y)
  requires pointX : x ∈ X.carrier
  requires pointY : y ∈ Y.carrier
  shows nhds(productSpace(X, Y), (x, y)) =
    filterProd(X.carrier, nhds(X, x), Y.carrier, nhds(Y, y))
proof
  sorry

-- The neighborhoods of a point of a subspace are the preimages of the
-- neighborhoods in the space.
theorem nhds.subspace (X A x : Set)
  requires space : TopologicalSpace(X)
  requires inside : A ⊆ X.carrier
  requires point : x ∈ A
  shows nhds(subspace(X, A), x) = filterComap(identity(A), A, nhds(X, x))
proof
  sorry

-- Section: Continuity as a limit
theorem Continuous.iff_continuousAt (f X Y : Set)
  requires spaceX : TopologicalSpace(X)
  requires spaceY : TopologicalSpace(Y)
  requires function : f : X.carrier → Y.carrier
  shows f : X ⇒ Y ↔ (∀ x ∈ X.carrier, ContinuousAtPoint(f, X, Y, x))
proof
  sorry

theorem Continuous.tendsto (f X Y x : Set)
  requires continuous : f : X ⇒ Y
  requires point : x ∈ X.carrier
  shows Tendsto(f, X.carrier, nhds(X, x), nhds(Y, f(x)))
proof
  sorry

-- Continuous maps carry limits to limits (Mathlib's Continuous.tendsto').
theorem Continuous.tendsto_comp (f g X Y Z F x : Set)
  requires continuous : g : Y ⇒ Z
  requires function : f : X → Y.carrier
  requires point : x ∈ Y.carrier
  requires limit : Tendsto(f, X, F, nhds(Y, x))
  shows Tendsto(compose(g, f, X, Y.carrier, Z.carrier), X, F,
    nhds(Z, g(x)))
proof
  sorry

theorem ContinuousAtPoint.of_continuous (f X Y x : Set)
  requires continuous : f : X ⇒ Y
  requires point : x ∈ X.carrier
  shows ContinuousAtPoint(f, X, Y, x)
proof
  sorry

-- Mathlib's isClosed_eq: where two continuous maps into a Hausdorff space
-- agree is closed.
theorem Continuous.closed_eq (f g X Y : Set)
  requires continuousF : f : X ⇒ Y
  requires continuousG : g : X ⇒ Y
  requires hausdorff : Hausdorff(Y)
  shows Closed(X, equalizer(f, g, X.carrier))
proof
  sorry

-- Mathlib's isClosed_le on ℝ-valued maps.
theorem Continuous.closed_le (f g X : Set)
  requires continuousF : f : X ⇒ realLine
  requires continuousG : g : X ⇒ realLine
  shows Closed(X, realLeLocus(f, g, X.carrier))
proof
  sorry

-- Mathlib's IsClosed.mem_of_tendsto: a limit of points eventually in a
-- closed set lies in it.
theorem Closed.mem_of_tendsto (f X Y F C y : Set)
  requires space : TopologicalSpace(Y)
  requires proper : ProperFilter(X, F)
  requires closed : Closed(Y, C)
  requires limit : Tendsto(f, X, F, nhds(Y, y))
  requires point : y ∈ Y.carrier
  requires eventually : Eventually(F, functionPreimage(f, X, C))
  shows y ∈ C
proof
  sorry

-- Section: Uniqueness of limits
theorem Tendsto.unique (f X F Y a b : Set)
  requires space : TopologicalSpace(Y)
  requires hausdorff : Hausdorff(Y)
  requires proper : ProperFilter(X, F)
  requires pointA : a ∈ Y.carrier
  requires pointB : b ∈ Y.carrier
  requires first : Tendsto(f, X, F, nhds(Y, a))
  requires second : Tendsto(f, X, F, nhds(Y, b))
  shows a = b
proof
  sorry

-- The constant map tends to its value.
theorem Tendsto.const (X F Y c : Set)
  requires space : TopologicalSpace(Y)
  requires filter : IsFilter(X, F)
  requires point : c ∈ Y.carrier
  shows Tendsto(X × {c}, X, F, nhds(Y, c))
proof
  sorry

-- Sequences: convergence in Cumulus's sense is the limit along natAtTop.
theorem Converges.iff_tendsto (X u x : Set)
  requires space : TopologicalSpace(X)
  requires sequence : u : ℕ → X.carrier
  requires point : x ∈ X.carrier
  shows Converges(X, u, x) ↔ Tendsto(u, ℕ, natAtTop, nhds(X, x))
proof
  sorry

-- Section: Metric spaces
theorem nhds.metric_iff (M x N : Set)
  requires metric : MetricSpace(M)
  requires point : x ∈ M.carrier
  shows N ∈ nhds(metricTopology(M), x) ↔
    N ⊆ M.carrier ∧ (∃ r ∈ ℝ, realZero < r ∧ ball(M, x, r) ⊆ N)
proof
  sorry

theorem Tendsto.metric_iff (f X F M a : Set)
  requires metric : MetricSpace(M)
  requires filter : IsFilter(X, F)
  requires values : f : X → M.carrier
  requires point : a ∈ M.carrier
  shows Tendsto(f, X, F, nhds(metricTopology(M), a)) ↔
    (∀ e ∈ ℝ, realZero < e →
      ∃ A ∈ F, ∀ x ∈ A, M.dist(f(x), a) < e)
proof
  sorry

-- The ε–N form along natAtTop.
theorem Tendsto.metric_sequence_iff (u M a : Set)
  requires metric : MetricSpace(M)
  requires values : u : ℕ → M.carrier
  requires point : a ∈ M.carrier
  shows Tendsto(u, ℕ, natAtTop, nhds(metricTopology(M), a)) ↔
    (∀ e ∈ ℝ, realZero < e → ∃ N ∈ ℕ, ∀ n ∈ ℕ, N ≤ n →
      M.dist(u(n), a) < e)
proof
  sorry

-- The ε–δ form of continuity at a point between metric spaces.
theorem ContinuousAtPoint.metric_iff (f M N x : Set)
  requires metricM : MetricSpace(M)
  requires metricN : MetricSpace(N)
  requires values : f : M.carrier → N.carrier
  requires point : x ∈ M.carrier
  shows ContinuousAtPoint(f, metricTopology(M), metricTopology(N), x) ↔
    (∀ e ∈ ℝ, realZero < e → ∃ d ∈ ℝ, realZero < d ∧
      (∀ y ∈ M.carrier, M.dist(y, x) < d → N.dist(f(y), f(x)) < e))
proof
  sorry

-- Section: The real line
theorem realLine.nhds_iff (x N : Set)
  requires point : x ∈ ℝ
  shows N ∈ nhds(realLine, x) ↔
    N ⊆ ℝ ∧ (∃ r ∈ ℝ, realZero < r ∧ openBall(x, r) ⊆ N)
proof
  sorry

-- Real sequences: Cumulus's ConvergesTo is the limit along natAtTop.
theorem ConvergesTo.iff_tendsto (u L : Set)
  requires sequence : RealSequence(u)
  requires real : L ∈ ℝ
  shows ConvergesTo(u, L) ↔ Tendsto(u, ℕ, natAtTop, nhds(realLine, L))
proof
  sorry

-- Real functions: Cumulus's TendsToAt is the limit along 𝓝[≠] A.
theorem TendsToAt.iff_tendsto (f L A : Set)
  requires function : FunctionBetween(f, ℝ, ℝ)
  requires realL : L ∈ ℝ
  requires realA : A ∈ ℝ
  shows TendsToAt(f, L, A) ↔
    Tendsto(f, ℝ, nhdsPunctured(realLine, A), nhds(realLine, L))
proof
  sorry

-- Order and limits on ℝ: a limit of terms eventually ≤ B is ≤ B, and
-- limits preserve ≤.
theorem realLine.le_of_tendsto (f X F : Set, L B : Real)
  requires proper : ProperFilter(X, F)
  requires limit : Tendsto(f, X, F, nhds(realLine, L))
  requires eventually : ∃ A ∈ F, ∀ x ∈ A, f(x) ≤ B
  shows L ≤ B
proof
  sorry

theorem realLine.le_of_tendsto_tendsto (f g X F : Set, L K : Real)
  requires proper : ProperFilter(X, F)
  requires limitF : Tendsto(f, X, F, nhds(realLine, L))
  requires limitG : Tendsto(g, X, F, nhds(realLine, K))
  requires eventually : ∃ A ∈ F, ∀ x ∈ A, f(x) ≤ g(x)
  shows L ≤ K
proof
  sorry

-- The squeeze: g ≤ f ≤ h eventually, with g and h tending to L.
theorem realLine.squeeze (f g h X F L : Set)
  requires filter : IsFilter(X, F)
  requires realL : L ∈ ℝ
  requires values : f : X → ℝ
  requires limitG : Tendsto(g, X, F, nhds(realLine, L))
  requires limitH : Tendsto(h, X, F, nhds(realLine, L))
  requires lower : ∃ A ∈ F, ∀ x ∈ A, g(x) ≤ f(x)
  requires upper : ∃ A ∈ F, ∀ x ∈ A, f(x) ≤ h(x)
  shows Tendsto(f, X, F, nhds(realLine, L))
proof
  sorry

-- A limit L > B forces the terms eventually above B.
theorem realLine.eventually_gt (f X F : Set, L B : Real)
  requires limit : Tendsto(f, X, F, nhds(realLine, L))
  requires greater : B < L
  shows ∃ A ∈ F, ∀ x ∈ A, B < f(x)
proof
  sorry

-- 1/(n + 1) → 0.
theorem realLine.inverse_tendsto_zero (u : Set)
  requires values : ∀ n ∈ ℕ, u(n) = R[1 / (realNat(n) + 1)]
  shows Tendsto(u, ℕ, natAtTop, nhds(realLine, realZero))
proof
  sorry

end Filters
