-- Filters on a set and limits along them: filters as families of subsets,
-- "eventually" and "frequently" as membership, principal filters, images
-- and preimages, infima and products of filters; limits along a filter;
-- the filters at infinity on ℕ and ℝ, the cofinite filter, neighborhoods
-- in a topological space and within a subset; continuity as a limit, the
-- uniqueness of limits in Hausdorff spaces, and the ε–δ and ε–N forms of
-- limits in metric spaces and on ℝ.
-- Part of the GRH blueprint.
-- Planned home: Topology/Filter.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Topology.Filters
import Grace.Cumulus.Metric.Structure
import Grace.Cumulus.Real.Analysis.Continuity
import Grace.Cumulus.Real.HarmonicSeries
import Grace.Cumulus.Combinatorics.Pigeonhole

section Filters
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Section: Filters
-- A filter on X is a family of subsets of X that contains X and is closed
-- under supersets inside X and under binary intersections. It is proper
-- (Mathlib's NeBot) when it does not contain ∅. The trivial family 𝒫(X)
-- is the filter ⊥ and {X} the filter ⊤. A filter is a set of sets, so no
-- choice of representative is involved anywhere below.
predicate IsFilter (X F : Set) :=
  F ⊆ 𝒫(X) ∧ X ∈ F ∧
  (∀ A ∈ F, ∀ B, A ⊆ B → B ⊆ X → B ∈ F) ∧
  (∀ A ∈ F, ∀ B ∈ F, A ∩ B ∈ F)

predicate ProperFilter (X F : Set) := IsFilter(X, F) ∧ ∅ ∉ F

-- F ≤ G (F is finer than G): every member of G is a member of F.
predicate FilterLe (F G : Set) := G ⊆ F

-- "∀ᶠ x in F, x ∈ S": S contains a member of F. S need not lie inside X,
-- so a property of the points is written as the set it cuts out of any
-- larger set. "∃ᶠ x in F, x ∈ S": S meets every member of F.
predicate Eventually (F S : Set) := ∃ A ∈ F, A ⊆ S
predicate Frequently (F S : Set) := ∀ A ∈ F, Nonempty(A ∩ S)

-- The principal filter of A ⊆ X, the subsets of X containing A.
def principalFilter (X A : Set) : Set := { B ∈ 𝒫(X) | A ⊆ B }

-- The image of a filter F on X under f, a filter on Y; the preimage of a
-- filter G on Y under f, a filter on X; the infimum F ⊓ G of two filters
-- on X; the supremum F ⊔ G; the product F ×ˢ G on X × Y.
def filterMap (f X Y F : Set) : Set :=
  { B ∈ 𝒫(Y) | functionPreimage(f, X, B) ∈ F }
def filterComap (f X G : Set) : Set :=
  { A ∈ 𝒫(X) | ∃ B ∈ G, functionPreimage(f, X, B) ⊆ A }
def filterInf (X F G : Set) : Set :=
  { C ∈ 𝒫(X) | ∃ A ∈ F, ∃ B ∈ G, A ∩ B ⊆ C }
def filterSup (F G : Set) : Set := F ∩ G
def filterProd (X F Y G : Set) : Set :=
  { C ∈ 𝒫(X × Y) | ∃ A ∈ F, ∃ B ∈ G, A × B ⊆ C }

-- Tendsto f F G: f maps F into G, that is, the preimage in X of every
-- member of G is a member of F. Only the values of f on X are read.
predicate Tendsto (f X F G : Set) :=
  ∀ B ∈ G, functionPreimage(f, X, B) ∈ F

-- Section: Filters at infinity and the cofinite filter
-- The sets of naturals containing every n ≥ N for some N; the sets of
-- reals containing [M, ∞) for some M, and (−∞, M] for some M; the subsets
-- of X with finite complement.
def natAtTop : Set :=
  { A ∈ 𝒫(ℕ) | ∃ N ∈ ℕ, ∀ n ∈ ℕ, N ≤ n → n ∈ A }
def realAtTop : Set :=
  { A ∈ 𝒫(ℝ) | ∃ M ∈ ℝ, ∀ x ∈ ℝ, M ≤ x → x ∈ A }
def realAtBot : Set :=
  { A ∈ 𝒫(ℝ) | ∃ M ∈ ℝ, ∀ x ∈ ℝ, x ≤ M → x ∈ A }
def cofinite (X : Set) : Set := { A ∈ 𝒫(X) | Finite(X ∖ A) }

-- Section: Neighborhoods
-- The neighborhood filter of x in the space X; the neighborhoods of x
-- within S, 𝓝[S] x = 𝓝 x ⊓ 𝓟 S; the punctured neighborhoods 𝓝[≠] x.
def nhds (X x : Set) : Set :=
  { N ∈ 𝒫(TopologicalSpace.carrier(X)) |
    ∃ U ∈ TopologicalSpace.opens(X), x ∈ U ∧ U ⊆ N }
def nhdsWithin (X x S : Set) : Set :=
  filterInf(TopologicalSpace.carrier(X), nhds(X, x),
    principalFilter(TopologicalSpace.carrier(X),
      S ∩ TopologicalSpace.carrier(X)))
def nhdsPunctured (X x : Set) : Set :=
  nhdsWithin(X, x, TopologicalSpace.carrier(X) ∖ {x})

-- f is continuous at x: f(y) → f(x) as y → x. f is continuous within S
-- at x: the same along 𝓝[S] x.
predicate ContinuousAtPoint (f X Y x : Set) :=
  Tendsto(f, TopologicalSpace.carrier(X), nhds(X, x), nhds(Y, f(x)))
predicate ContinuousWithinAtPoint (f X Y S x : Set) :=
  Tendsto(f, TopologicalSpace.carrier(X), nhdsWithin(X, x, S),
    nhds(Y, f(x)))

-- x is a cluster point of the filter F on the carrier of X: every
-- neighborhood of x meets every member of F.
predicate ClusterPt (X x F : Set) :=
  x ∈ TopologicalSpace.carrier(X) ∧ ProperFilter(TopologicalSpace.carrier(X),
    filterInf(TopologicalSpace.carrier(X), nhds(X, x), F))

-- Where two maps agree on A, and where f ≤ g on A for real values.
def equalizer (f g A : Set) : Set := { x ∈ A | f(x) = g(x) }
def realLeLocus (f g A : Set) : Set := { x ∈ A | f(x) ≤ g(x) }

-- Section: Laws of filters
theorem IsFilter.subset (X F A : Set)
  requires filter : IsFilter(X, F)
  requires member : A ∈ F
  shows A ⊆ X
proof
  obtain ⟨sub, whole, up, inter⟩ := filter
  have inPow := sub with A, member
  simpa using inPow

theorem IsFilter.whole (X F : Set)
  requires filter : IsFilter(X, F)
  shows X ∈ F
proof
  obtain ⟨sub, whole, up, inter⟩ := filter
  exact whole

theorem IsFilter.mono (X F A B : Set)
  requires filter : IsFilter(X, F)
  requires member : A ∈ F
  requires inside : A ⊆ B
  requires within : B ⊆ X
  shows B ∈ F
proof
  obtain ⟨sub, whole, up, inter⟩ := filter
  exact up with A, member, B, inside, within

theorem IsFilter.inter (X F A B : Set)
  requires filter : IsFilter(X, F)
  requires memberA : A ∈ F
  requires memberB : B ∈ F
  shows A ∩ B ∈ F
proof
  obtain ⟨sub, whole, up, inter⟩ := filter
  exact inter with A, memberA, B, memberB

-- A finite intersection of members, indexed by n = {0, …, n − 1}.
theorem IsFilter.finite_inter (X F A : Set, n : Nat)
  requires filter : IsFilter(X, F)
  requires members : ∀ i ∈ n, A(i) ∈ F
  shows ∃ B ∈ F, ∀ x ∈ B, ∀ i ∈ n, x ∈ A(i)
proof
  induction n
  | zero =>
    intro members
    have whole := IsFilter.whole with filter
    refine ⟨X, whole, ?_⟩
    intros x hx i hi
    rw nat.zero at hi
    exfalso
    exact set.empty with hi
  | succ(m) using ih =>
    intro members
    have before : ∀ i ∈ m, A(i) ∈ F
      intros i hi
      have up : i ∈ succ(m) by simp
      exact members with i, up
    obtain ⟨B, hB, inB⟩ := ih with before
    have last := members with m, (membership.self_successor at m)
    have both := IsFilter.inter with filter, hB, last
    refine ⟨B ∩ A(m), both, ?_⟩
    intros x hx i hi
    have hx2 := intersection.membership.forward with hx
    have alt := membership.successor_forward{n := m} with hi
    cases alt with early | equal
    . exact inB with x, hx2.left, i, early
    . rw equal
      exact hx2.right

theorem IsFilter.powerset (X : Set)
  shows IsFilter(X, 𝒫(X))
proof
  unfold IsFilter
  refine ⟨?_, ?_, ?_, ?_⟩
  . simp
  . exact powerset.self at X
  . intros A hA B hAB hBX
    simp [powerset.membership_iff]
  . intros A hA B hB
    simp [powerset.membership_iff] at hA
    simp [powerset.membership_iff]

theorem IsFilter.top (X : Set)
  shows IsFilter(X, {X})
proof
  unfold IsFilter
  refine ⟨?_, ?_, ?_, ?_⟩
  . intros A hA
    simp at hA
    rw hA
    exact powerset.self at X
  . simp
  . intros A hA B hAB hBX
    simp at hA
    rw hA at hAB
    simp
    exact Subset.antisymmetric with hBX, hAB
  . intros A hA B hB
    simp at hA
    simp at hB
    rw [hA, hB]
    simp
    ext x
    simp

theorem ProperFilter.nonempty (X F A : Set)
  requires proper : ProperFilter(X, F)
  requires member : A ∈ F
  shows Nonempty(A)
proof
  obtain ⟨filt, notEmpty⟩ := proper
  apply Nonempty.of_ne_empty
  intro eq
  rw eq at member
  exact notEmpty with member

theorem ProperFilter.of_nonempty (X F : Set)
  requires filter : IsFilter(X, F)
  requires nonempty : ∀ A ∈ F, Nonempty(A)
  shows ProperFilter(X, F)
proof
  unfold ProperFilter
  refine ⟨filter, ?_⟩
  intro emptyIn
  have ne := nonempty with ∅, emptyIn
  obtain ⟨x, hx⟩ := ne
  simpa using hx

theorem ProperFilter.carrier_nonempty (X F : Set)
  requires proper : ProperFilter(X, F)
  shows Nonempty(X)
proof
  have filt := proper.left
  have whole := IsFilter.whole with filt
  exact ProperFilter.nonempty with proper, whole

theorem FilterLe.refl (F : Set)
  shows FilterLe(F, F)
proof
  unfold FilterLe
  simp

theorem FilterLe.trans (F G H : Set)
  requires first : FilterLe(F, G)
  requires second : FilterLe(G, H)
  shows FilterLe(F, H)
proof
  unfold FilterLe at first
  unfold FilterLe at second
  unfold FilterLe
  exact Subset.transitive with second, first

theorem FilterLe.antisymm (F G : Set)
  requires first : FilterLe(F, G)
  requires second : FilterLe(G, F)
  shows F = G
proof
  unfold FilterLe at first
  unfold FilterLe at second
  exact Subset.antisymmetric with second, first

-- Every filter on X lies below ⊤ = {X} and above ⊥ = 𝒫(X).
theorem FilterLe.top (X F : Set)
  requires filter : IsFilter(X, F)
  shows FilterLe(F, {X})
proof
  unfold FilterLe
  intros A hA
  simp at hA
  rw hA
  exact IsFilter.whole with filter

theorem FilterLe.bot (X F : Set)
  requires filter : IsFilter(X, F)
  shows FilterLe(𝒫(X), F)
proof
  unfold FilterLe
  obtain ⟨sub, rest⟩ := filter
  exact sub

-- A filter finer than a proper filter's refinement stays proper upward:
-- if F ≤ G and F is proper, then G is proper.
theorem ProperFilter.mono (X F G : Set)
  requires proper : ProperFilter(X, F)
  requires filterG : IsFilter(X, G)
  requires le : FilterLe(F, G)
  shows ProperFilter(X, G)
proof
  apply ProperFilter.of_nonempty
  . exact filterG
  . intros A hA
    unfold FilterLe at le
    have inF := le with A, hA
    exact ProperFilter.nonempty with proper, inF

-- Section: Eventually and frequently
theorem Eventually.iff_mem (X F S : Set)
  requires filter : IsFilter(X, F)
  shows Eventually(F, S) ↔ X ∩ S ∈ F
proof
  constructor
  . intro ev
    obtain ⟨A, hA, sub⟩ := ev
    have inX := IsFilter.subset with filter, hA
    apply IsFilter.mono with filter, hA
    . intros x hx
      simp
    . intros x hx
      simp at hx
      exact hx.left
  . intro mem
    unfold Eventually
    refine ⟨X ∩ S, mem, ?_⟩
    intros x hx
    simp at hx
    exact hx.right

theorem Eventually.of_mem (F S : Set)
  requires member : S ∈ F
  shows Eventually(F, S)
proof
  unfold Eventually
  refine ⟨S, member, ?_⟩
  simp

theorem Eventually.whole (X F S : Set)
  requires filter : IsFilter(X, F)
  requires inside : X ⊆ S
  shows Eventually(F, S)
proof
  unfold Eventually
  refine ⟨X, (IsFilter.whole with filter), inside⟩

theorem Eventually.mono (F S T : Set)
  requires eventually : Eventually(F, S)
  requires inside : S ⊆ T
  shows Eventually(F, T)
proof
  obtain ⟨A, hA, sub⟩ := eventually
  unfold Eventually
  refine ⟨A, hA, (Subset.transitive with sub, inside)⟩

theorem Eventually.and (X F S T : Set)
  requires filter : IsFilter(X, F)
  requires first : Eventually(F, S)
  requires second : Eventually(F, T)
  shows Eventually(F, S ∩ T)
proof
  obtain ⟨A, hA, subA⟩ := first
  obtain ⟨B, hB, subB⟩ := second
  unfold Eventually
  refine ⟨A ∩ B, (IsFilter.inter with filter, hA, hB), ?_⟩
  intros x hx
  simp at hx
  simp

-- Along a proper filter an eventual property holds somewhere.
theorem Eventually.exists (X F S : Set)
  requires proper : ProperFilter(X, F)
  requires eventually : Eventually(F, S)
  shows ∃ x ∈ X, x ∈ S
proof
  obtain ⟨A, hA, sub⟩ := eventually
  have ne := ProperFilter.nonempty with proper, hA
  obtain ⟨x, hx⟩ := ne
  have filt := proper.left
  have inX := IsFilter.subset with filt, hA
  refine ⟨x, (inX with x, hx), (sub with x, hx)⟩

theorem Eventually.frequently (X F S : Set)
  requires proper : ProperFilter(X, F)
  requires eventually : Eventually(F, S)
  shows Frequently(F, S)
proof
  obtain ⟨A, hA, sub⟩ := eventually
  unfold Frequently
  intros B hB
  have filt := proper.left
  have both := IsFilter.inter with filt, hA, hB
  have ne := ProperFilter.nonempty with proper, both
  obtain ⟨x, hx⟩ := ne
  simp at hx
  unfold Nonempty
  refine ⟨x, ?_⟩
  simp

theorem Frequently.not_eventually (X F S : Set)
  requires filter : IsFilter(X, F)
  shows Frequently(F, S) ↔ ¬Eventually(F, X ∖ S)
proof
  constructor
  . intro freq
    intro ev
    obtain ⟨A, hA, sub⟩ := ev
    have ne := freq with A, hA
    obtain ⟨x, hx⟩ := ne
    simp at hx
    have out := sub with x, hx.left
    simp at out
    exact out.right with hx.right
  . intro notEv
    unfold Frequently
    intros A hA
    by_contra empty
    apply notEv
    unfold Eventually
    refine ⟨A, hA, ?_⟩
    intros x hx
    have inX := IsFilter.subset with filter, hA
    have xX := inX with x, hx
    by_contra notIn
    apply empty
    unfold Nonempty
    refine ⟨x, ?_⟩
    simp at notIn
    simp

theorem Frequently.mono (F S T : Set)
  requires frequently : Frequently(F, S)
  requires inside : S ⊆ T
  shows Frequently(F, T)
proof
  unfold Frequently
  intros A hA
  have ne := frequently with A, hA
  obtain ⟨x, hx⟩ := ne
  simp at hx
  unfold Nonempty
  refine ⟨x, ?_⟩
  simp

theorem Frequently.and_eventually (X F S T : Set)
  requires filter : IsFilter(X, F)
  requires frequently : Frequently(F, S)
  requires eventually : Eventually(F, T)
  shows Frequently(F, S ∩ T)
proof
  obtain ⟨B, hB, sub⟩ := eventually
  unfold Frequently
  intros A hA
  have both := IsFilter.inter with filter, hA, hB
  have ne := frequently with A ∩ B, both
  obtain ⟨x, hx⟩ := ne
  simp at hx
  unfold Nonempty
  refine ⟨x, ?_⟩
  simp

-- Eventually along F ≤ G follows from eventually along G.
theorem Eventually.filter_mono (F G S : Set)
  requires le : FilterLe(F, G)
  requires eventually : Eventually(G, S)
  shows Eventually(F, S)
proof
  obtain ⟨A, hA, sub⟩ := eventually
  unfold FilterLe at le
  unfold Eventually
  refine ⟨A, (le with A, hA), sub⟩

-- Section: Principal filters
theorem principalFilter.is_filter (X A : Set)
  requires inside : A ⊆ X
  shows IsFilter(X, principalFilter(X, A))
proof
  unfold IsFilter
  refine ⟨?_, ?_, ?_, ?_⟩
  . intros B hB
    simp [principalFilter.membership] at hB
    exact hB.left
  . simp [principalFilter.membership, powerset.membership_iff]
  . intros B hB C hBC hCX
    simp [principalFilter.membership, powerset.membership_iff] at hB
    simp [principalFilter.membership, powerset.membership_iff]
  . intros B hB C hC
    simp [principalFilter.membership, powerset.membership_iff] at hB
    simp [principalFilter.membership, powerset.membership_iff] at hC
    simp [principalFilter.membership, powerset.membership_iff]

theorem principalFilter.mem_iff (X A B : Set)
  shows B ∈ principalFilter(X, A) ↔ B ⊆ X ∧ A ⊆ B
proof
  simp [principalFilter.membership, powerset.membership_iff]

theorem principalFilter.proper_iff (X A : Set)
  requires inside : A ⊆ X
  shows ProperFilter(X, principalFilter(X, A)) ↔ Nonempty(A)
proof
  have filt := principalFilter.is_filter with inside
  constructor
  . intro proper
    have selfIn : A ∈ principalFilter(X, A) by simp [principalFilter.membership, powerset.membership_iff]
    exact ProperFilter.nonempty with proper, selfIn
  . intro ne
    apply ProperFilter.of_nonempty with filt
    intros B hB
    simp [principalFilter.membership, powerset.membership_iff] at hB
    obtain ⟨x, hx⟩ := ne
    unfold Nonempty
    refine ⟨x, (hB.right with x, hx)⟩

theorem principalFilter.le_iff (X F A : Set)
  requires filter : IsFilter(X, F)
  requires inside : A ⊆ X
  shows FilterLe(F, principalFilter(X, A)) ↔ A ∈ F
proof
  constructor
  . intro le
    unfold FilterLe at le
    have selfIn : A ∈ principalFilter(X, A) by simp [principalFilter.membership, powerset.membership_iff]
    exact le with A, selfIn
  . intro mem
    unfold FilterLe
    intros B hB
    simp [principalFilter.membership, powerset.membership_iff] at hB
    exact IsFilter.mono with filter, mem, hB.right, hB.left

theorem principalFilter.whole (X : Set)
  shows principalFilter(X, X) = {X}
proof
  ext B
  simp [principalFilter.membership, powerset.membership_iff]
  constructor
  . intro h
    ext x
    simp
  . intro h
    rw h
    simp

theorem principalFilter.empty (X : Set)
  shows principalFilter(X, ∅) = 𝒫(X)
proof
  ext B
  simp [principalFilter.membership, powerset.membership_iff]

-- Section: Images, preimages, infima, suprema, products
theorem filterMap.is_filter (f X Y F : Set)
  requires filter : IsFilter(X, F)
  requires function : f : X → Y
  shows IsFilter(Y, filterMap(f, X, Y, F))
proof
  unfold IsFilter
  refine ⟨?_, ?_, ?_, ?_⟩
  . intros B hB
    simp [filterMap.membership] at hB
    exact hB.left
  . have whole := functionPreimage.codomain with function
    have xF := IsFilter.whole with filter
    simp [filterMap.membership, powerset.membership_iff, whole]
  . intros B hB C hBC hCY
    simp [filterMap.membership, powerset.membership_iff] at hB
    have preMono := functionPreimage.monotone at f, X, B, C with hBC
    have preSub := functionPreimage.subset at f, X, C
    have inF := IsFilter.mono with filter, hB.right, preMono, preSub
    simp [filterMap.membership, powerset.membership_iff]
  . intros B hB C hC
    simp [filterMap.membership, powerset.membership_iff] at hB
    simp [filterMap.membership, powerset.membership_iff] at hC
    have both := IsFilter.inter with filter, hB.right, hC.right
    rw ← functionPreimage.intersection at both
    simp [filterMap.membership, powerset.membership_iff]

theorem filterMap.proper (f X Y F : Set)
  requires proper : ProperFilter(X, F)
  requires function : f : X → Y
  shows ProperFilter(Y, filterMap(f, X, Y, F))
proof
  have filt := proper.left
  have mapF := filterMap.is_filter with filt, function
  apply ProperFilter.of_nonempty with mapF
  intros B hB
  simp [filterMap.membership, powerset.membership_iff] at hB
  have ne := ProperFilter.nonempty with proper, hB.right
  obtain ⟨x, hx⟩ := ne
  simp [functionPreimage.membership] at hx
  unfold Nonempty
  refine ⟨f(x), hx.right⟩

theorem filterMap.mem_iff (f X Y F B : Set)
  shows B ∈ filterMap(f, X, Y, F) ↔ B ⊆ Y ∧ functionPreimage(f, X, B) ∈ F
proof
  simp [filterMap.membership, powerset.membership_iff]

theorem filterComap.is_filter (f X Y G : Set)
  requires filter : IsFilter(Y, G)
  requires function : f : X → Y
  shows IsFilter(X, filterComap(f, X, G))
proof
  unfold IsFilter
  refine ⟨?_, ?_, ?_, ?_⟩
  . intros A hA
    simp [filterComap.membership] at hA
    exact hA.left
  . have whole := IsFilter.whole with filter
    have preSub := functionPreimage.subset at f, X, Y
    simp [filterComap.membership, powerset.membership_iff]
  . intros A hA C hAC hCX
    simp [filterComap.membership, powerset.membership_iff] at hA
    obtain ⟨_, B, hB, sub⟩ := hA
    apply filterComap.membership.backward
    refine ⟨(powerset.membership_iff.backward with hCX), B, hB, (Subset.transitive with sub, hAC)⟩
  . intros A1 hA1 A2 hA2
    simp [filterComap.membership, powerset.membership_iff] at hA1
    simp [filterComap.membership, powerset.membership_iff] at hA2
    obtain ⟨sub1, B1, hB1, pre1⟩ := hA1
    obtain ⟨sub2, B2, hB2, pre2⟩ := hA2
    have both := IsFilter.inter with filter, hB1, hB2
    have sub : functionPreimage(f, X, B1 ∩ B2) ⊆ A1 ∩ A2
      intros x hx
      simp [functionPreimage.membership] at hx
      have in1 : x ∈ functionPreimage(f, X, B1) by simp [functionPreimage.membership]
      have in2 : x ∈ functionPreimage(f, X, B2) by simp [functionPreimage.membership]
      have c1 := pre1 with x, in1
      have c2 := pre2 with x, in2
      simp
    have both12 : A1 ∩ A2 ⊆ X
      intros x hx
      simp at hx
      exact sub1 with x, hx.left
    apply filterComap.membership.backward
    refine ⟨(powerset.membership_iff.backward with both12), B1 ∩ B2, both, sub⟩

-- The preimage of a proper filter is proper when every member of G meets
-- the range of f.
theorem filterComap.proper (f X Y G : Set)
  requires filter : IsFilter(Y, G)
  requires function : f : X → Y
  requires meets : ∀ B ∈ G, ∃ x ∈ X, f(x) ∈ B
  shows ProperFilter(X, filterComap(f, X, G))
proof
  have filt := filterComap.is_filter with filter, function
  apply ProperFilter.of_nonempty with filt
  intros A hA
  simp [filterComap.membership, powerset.membership_iff] at hA
  obtain ⟨sub, B, hB, pre⟩ := hA
  obtain ⟨x, hx, fx⟩ := meets with B, hB
  have inPre : x ∈ functionPreimage(f, X, B) by simp [functionPreimage.membership]
  unfold Nonempty
  refine ⟨x, (pre with x, inPre)⟩

theorem filterMap.le_iff_le_comap (f X Y F G : Set)
  requires filterF : IsFilter(X, F)
  requires filterG : IsFilter(Y, G)
  requires function : f : X → Y
  shows FilterLe(filterMap(f, X, Y, F), G) ↔ FilterLe(F, filterComap(f, X, G))
proof
  constructor
  . intro le
    unfold FilterLe at le
    unfold FilterLe
    intros A hA
    simp [filterComap.membership, powerset.membership_iff] at hA
    obtain ⟨sub, B, hB, pre⟩ := hA
    have inMap := le with B, hB
    simp [filterMap.membership, powerset.membership_iff] at inMap
    exact IsFilter.mono with filterF, inMap.right, pre, sub
  . intro le
    unfold FilterLe at le
    unfold FilterLe
    intros B hB
    have sub := IsFilter.subset with filterG, hB
    have preSub := functionPreimage.subset at f, X, B
    have inComap : functionPreimage(f, X, B) ∈ filterComap(f, X, G) by
      simp [filterComap.membership, powerset.membership_iff]
    have inF := le with functionPreimage(f, X, B), inComap
    simp [filterMap.membership, powerset.membership_iff]

theorem filterInf.is_filter (X F G : Set)
  requires filterF : IsFilter(X, F)
  requires filterG : IsFilter(X, G)
  shows IsFilter(X, filterInf(X, F, G))
proof
  unfold IsFilter
  refine ⟨?_, ?_, ?_, ?_⟩
  . intros C hC
    simp [filterInf.membership] at hC
    exact hC.left
  . have wF := IsFilter.whole with filterF
    have wG := IsFilter.whole with filterG
    have sub : X ∩ X ⊆ X by simp
    apply filterInf.membership.backward
    refine ⟨(powerset.self at X), X, wF, X, wG, sub⟩
  . intros C hC D hCD hDX
    simp [filterInf.membership, powerset.membership_iff] at hC
    obtain ⟨_, A, hA, B, hB, sub⟩ := hC
    apply filterInf.membership.backward
    refine ⟨(powerset.membership_iff.backward with hDX), A, hA, B, hB, (Subset.transitive with sub, hCD)⟩
  . intros C1 hC1 C2 hC2
    simp [filterInf.membership, powerset.membership_iff] at hC1
    simp [filterInf.membership, powerset.membership_iff] at hC2
    obtain ⟨sub1, A1, hA1, B1, hB1, in1⟩ := hC1
    obtain ⟨sub2, A2, hA2, B2, hB2, in2⟩ := hC2
    have bothA := IsFilter.inter with filterF, hA1, hA2
    have bothB := IsFilter.inter with filterG, hB1, hB2
    have sub : (A1 ∩ A2) ∩ (B1 ∩ B2) ⊆ C1 ∩ C2
      intros x hx
      simp at hx
      have m1 : x ∈ A1 ∩ B1 by simp
      have m2 : x ∈ A2 ∩ B2 by simp
      have c1 := in1 with x, m1
      have c2 := in2 with x, m2
      simp
    have both : C1 ∩ C2 ⊆ X
      intros x hx
      simp at hx
      exact sub1 with x, hx.left
    apply filterInf.membership.backward
    refine ⟨(powerset.membership_iff.backward with both), A1 ∩ A2, bothA, B1 ∩ B2, bothB, sub⟩

theorem filterInf.le_left (X F G : Set)
  requires filterF : IsFilter(X, F)
  requires filterG : IsFilter(X, G)
  shows FilterLe(filterInf(X, F, G), F)
proof
  unfold FilterLe
  intros A hA
  have sub := IsFilter.subset with filterF, hA
  have wG := IsFilter.whole with filterG
  have inC : A ∩ X ⊆ A by simp
  apply filterInf.membership.backward
  refine ⟨(powerset.membership_iff.backward with sub), A, hA, X, wG, inC⟩

theorem filterInf.le_right (X F G : Set)
  requires filterF : IsFilter(X, F)
  requires filterG : IsFilter(X, G)
  shows FilterLe(filterInf(X, F, G), G)
proof
  unfold FilterLe
  intros B hB
  have sub := IsFilter.subset with filterG, hB
  have wF := IsFilter.whole with filterF
  have inC : X ∩ B ⊆ B by simp
  apply filterInf.membership.backward
  refine ⟨(powerset.membership_iff.backward with sub), X, wF, B, hB, inC⟩

theorem filterInf.greatest (X F G H : Set)
  requires filterH : IsFilter(X, H)
  requires leF : FilterLe(H, F)
  requires leG : FilterLe(H, G)
  shows FilterLe(H, filterInf(X, F, G))
proof
  unfold FilterLe at leF
  unfold FilterLe at leG
  unfold FilterLe
  intros C hC
  simp [filterInf.membership, powerset.membership_iff] at hC
  obtain ⟨sub, A, hA, B, hB, inC⟩ := hC
  have both := IsFilter.inter with filterH, (leF with A, hA), (leG with B, hB)
  exact IsFilter.mono with filterH, both, inC, sub

-- F ⊓ 𝓟 A is proper exactly when A frequently holds along F.
theorem filterInf.principal_proper_iff (X F A : Set)
  requires filter : IsFilter(X, F)
  requires inside : A ⊆ X
  shows ProperFilter(X, filterInf(X, F, principalFilter(X, A))) ↔
    Frequently(F, A)
proof
  have filtP := principalFilter.is_filter with inside
  have filtI := filterInf.is_filter with filter, filtP
  have selfP : A ∈ principalFilter(X, A) by simp [principalFilter.membership, powerset.membership_iff]
  constructor
  . intro proper
    unfold Frequently
    intros B hB
    have sub := IsFilter.subset with filter, hB
    have inI : B ∩ A ∈ filterInf(X, F, principalFilter(X, A)) by
      simp [filterInf.membership, powerset.membership_iff]
    exact ProperFilter.nonempty with proper, inI
  . intro freq
    apply ProperFilter.of_nonempty with filtI
    intros C hC
    simp [filterInf.membership, powerset.membership_iff] at hC
    obtain ⟨sub, A0, hA0, B, hB, inC⟩ := hC
    simp [principalFilter.membership, powerset.membership_iff] at hB
    have ne := freq with A0, hA0
    obtain ⟨x, hx⟩ := ne
    have hx2 := intersection.membership.forward with hx
    have xB := hB.right with x, hx2.right
    have xBoth := intersection.membership.backward with ⟨hx2.left, xB⟩
    unfold Nonempty
    refine ⟨x, (inC with x, xBoth)⟩

theorem filterSup.is_filter (X F G H : Set)
  requires filterF : IsFilter(X, F)
  requires filterG : IsFilter(X, G)
  requires sup : H = filterSup(F, G)
  shows IsFilter(X, H)
proof
  rw sup
  unfold filterSup
  unfold IsFilter
  refine ⟨?_, ?_, ?_, ?_⟩
  . intros A hA
    simp at hA
    have sub := IsFilter.subset with filterF, hA.left
    simp [powerset.membership_iff]
  . have wF := IsFilter.whole with filterF
    have wG := IsFilter.whole with filterG
    simp
  . intros A hA B hAB hBX
    simp at hA
    have mF := IsFilter.mono with filterF, hA.left, hAB, hBX
    have mG := IsFilter.mono with filterG, hA.right, hAB, hBX
    simp
  . intros A hA B hB
    simp at hA
    simp at hB
    have mF := IsFilter.inter with filterF, hA.left, hB.left
    have mG := IsFilter.inter with filterG, hA.right, hB.right
    simp

theorem filterProd.is_filter (X F Y G : Set)
  requires filterF : IsFilter(X, F)
  requires filterG : IsFilter(Y, G)
  shows IsFilter(X × Y, filterProd(X, F, Y, G))
proof
  unfold IsFilter
  refine ⟨?_, ?_, ?_, ?_⟩
  . intros C hC
    simp [filterProd.membership] at hC
    exact hC.left
  . have wF := IsFilter.whole with filterF
    have wG := IsFilter.whole with filterG
    simp [filterProd.membership, powerset.membership_iff]
  . intros C hC D hCD hDX
    simp [filterProd.membership, powerset.membership_iff] at hC
    obtain ⟨_, A, hA, B, hB, sub⟩ := hC
    apply filterProd.membership.backward
    refine ⟨(powerset.membership_iff.backward with hDX), A, hA, B, hB, (Subset.transitive with sub, hCD)⟩
  . intros C1 hC1 C2 hC2
    simp [filterProd.membership, powerset.membership_iff] at hC1
    simp [filterProd.membership, powerset.membership_iff] at hC2
    obtain ⟨sub1, A1, hA1, B1, hB1, in1⟩ := hC1
    obtain ⟨sub2, A2, hA2, B2, hB2, in2⟩ := hC2
    have bothA := IsFilter.inter with filterF, hA1, hA2
    have bothB := IsFilter.inter with filterG, hB1, hB2
    have sub : (A1 ∩ A2) × (B1 ∩ B2) ⊆ C1 ∩ C2
      intros p hp
      obtain ⟨bound, a, ha, b, hb, pEq⟩ := product.membership.forward with hp
      simp at ha
      simp at hb
      have p1 : p ∈ A1 × B1
        rw pEq
        exact product.pair with ha.left, hb.left
      have p2 : p ∈ A2 × B2
        rw pEq
        exact product.pair with ha.right, hb.right
      have c1 := in1 with p, p1
      have c2 := in2 with p, p2
      simp
    have both12 : C1 ∩ C2 ⊆ X × Y
      intros x hx
      simp at hx
      exact sub1 with x, hx.left
    apply filterProd.membership.backward
    refine ⟨(powerset.membership_iff.backward with both12), A1 ∩ A2, bothA, B1 ∩ B2, bothB, sub⟩

theorem filterProd.proper (X F Y G : Set)
  requires properF : ProperFilter(X, F)
  requires properG : ProperFilter(Y, G)
  shows ProperFilter(X × Y, filterProd(X, F, Y, G))
proof
  have filtF := properF.left
  have filtG := properG.left
  have filt := filterProd.is_filter with filtF, filtG
  apply ProperFilter.of_nonempty with filt
  intros C hC
  simp [filterProd.membership, powerset.membership_iff] at hC
  obtain ⟨sub, A, hA, B, hB, inC⟩ := hC
  obtain ⟨a, ha⟩ := ProperFilter.nonempty with properF, hA
  obtain ⟨b, hb⟩ := ProperFilter.nonempty with properG, hB
  have pab := product.pair with ha, hb
  unfold Nonempty
  refine ⟨(a, b), (inC with (a, b), pab)⟩

theorem filterProd.mem_of (X F Y G A B : Set)
  requires filterF : IsFilter(X, F)
  requires filterG : IsFilter(Y, G)
  requires memberA : A ∈ F
  requires memberB : B ∈ G
  shows A × B ∈ filterProd(X, F, Y, G)
proof
  have subA := IsFilter.subset with filterF, memberA
  have subB := IsFilter.subset with filterG, memberB
  have prodSub := product.monotone with subA, subB
  simp [filterProd.membership, powerset.membership_iff]

-- Section: Limits along filters
theorem Tendsto.mono_left (f X F F0 G : Set)
  requires tendsto : Tendsto(f, X, F, G)
  requires le : FilterLe(F0, F)
  shows Tendsto(f, X, F0, G)
proof
  unfold FilterLe at le
  unfold Tendsto
  intros B hB
  have inF := tendsto with B, hB
  exact le with functionPreimage(f, X, B), inF

theorem Tendsto.mono_right (f X F G G0 : Set)
  requires tendsto : Tendsto(f, X, F, G)
  requires le : FilterLe(G, G0)
  shows Tendsto(f, X, F, G0)
proof
  unfold FilterLe at le
  unfold Tendsto
  intros B hB
  exact tendsto with B, (le with B, hB)

theorem Tendsto.identity (X F : Set)
  requires filter : IsFilter(X, F)
  shows Tendsto(identity(X), X, F, F)
proof
  unfold Tendsto
  intros B hB
  have sub := IsFilter.subset with filter, hB
  have inside : B ⊆ functionPreimage(identity(X), X, B)
    intros x hx
    have xX := sub with x, hx
    have same := identity.apply with xX
    apply functionPreimage.of_apply with xX
    rw same
    exact hx
  have preSub := functionPreimage.subset at identity(X), X, B
  exact IsFilter.mono with filter, hB, inside, preSub

theorem Tendsto.comp (f g X Y Z F G H : Set)
  requires function : f : X → Y
  requires functionG : g : Y → Z
  requires first : Tendsto(f, X, F, G)
  requires second : Tendsto(g, Y, G, H)
  shows Tendsto(compose(g, f, X, Y, Z), X, F, H)
proof
  unfold Tendsto
  intros B hB
  have eq := functionPreimage.compose at g, f, X, Y, Z, B with function, functionG
  rw eq
  have inG := second with B, hB
  exact first with functionPreimage(g, Y, B), inG

-- The composite written with the values: x ↦ g(f(x)) given as any h that
-- agrees with it on X.
theorem Tendsto.comp_values (f g h X Y F G H : Set)
  requires function : f : X → Y
  requires values : ∀ x ∈ X, h(x) = g(f(x))
  requires first : Tendsto(f, X, F, G)
  requires second : Tendsto(g, Y, G, H)
  shows Tendsto(h, X, F, H)
proof
  unfold Tendsto
  intros B hB
  have eq : functionPreimage(h, X, B) = functionPreimage(f, X, functionPreimage(g, Y, B))
    ext x
    constructor
    . intro hx
      simp [functionPreimage.membership] at hx
      have fx := FunctionBetween.apply_closed with function, hx.left
      have hv := values with x, hx.left
      have gIn : g(f(x)) ∈ B
        rw ← hv
        exact hx.right
      simp [functionPreimage.membership]
    . intro hx
      simp [functionPreimage.membership] at hx
      have hv := values with x, hx.left
      simp [functionPreimage.membership, hv]
  rw eq
  have inG := second with B, hB
  exact first with functionPreimage(g, Y, B), inG

theorem Tendsto.congr (f g X F G : Set)
  requires filter : IsFilter(X, F)
  requires agree : ∃ A ∈ F, ∀ x ∈ A, f(x) = g(x)
  requires tendsto : Tendsto(f, X, F, G)
  shows Tendsto(g, X, F, G)
proof
  obtain ⟨A, hA, agreeA⟩ := agree
  unfold Tendsto
  intros B hB
  have preF := tendsto with B, hB
  have both := IsFilter.inter with filter, hA, preF
  have inside : A ∩ functionPreimage(f, X, B) ⊆ functionPreimage(g, X, B)
    intros x hx
    have hx2 := intersection.membership.forward with hx
    have xPre := functionPreimage.membership.forward with hx2.right
    have same := agreeA with x, hx2.left
    apply functionPreimage.of_apply with xPre.left
    rw ← same
    exact xPre.right
  have preSub := functionPreimage.subset at g, X, B
  exact IsFilter.mono with filter, both, inside, preSub

theorem Tendsto.eventually (f X F G S : Set)
  requires tendsto : Tendsto(f, X, F, G)
  requires filter : IsFilter(X, F)
  requires eventually : Eventually(G, S)
  shows Eventually(F, functionPreimage(f, X, S))
proof
  obtain ⟨A, hA, sub⟩ := eventually
  have inF := tendsto with A, hA
  have mono := functionPreimage.monotone at f, X, A, S with sub
  unfold Eventually
  refine ⟨functionPreimage(f, X, A), inF, mono⟩

theorem Tendsto.iff_map_le (f X Y F G : Set)
  requires function : f : X → Y
  requires filterG : IsFilter(Y, G)
  shows Tendsto(f, X, F, G) ↔ FilterLe(filterMap(f, X, Y, F), G)
proof
  constructor
  . intro tendsto
    unfold FilterLe
    intros B hB
    have sub := IsFilter.subset with filterG, hB
    have pre := tendsto with B, hB
    simp [filterMap.membership, powerset.membership_iff]
  . intro le
    unfold FilterLe at le
    unfold Tendsto
    intros B hB
    have inMap := le with B, hB
    simp [filterMap.membership, powerset.membership_iff] at inMap
    exact inMap.right

theorem Tendsto.principal (f X Y F A : Set)
  requires function : f : X → Y
  requires filter : IsFilter(X, F)
  requires inside : A ⊆ Y
  shows Tendsto(f, X, F, principalFilter(Y, A)) ↔
    Eventually(F, functionPreimage(f, X, A))
proof
  constructor
  . intro tendsto
    have selfP : A ∈ principalFilter(Y, A) by simp [principalFilter.membership, powerset.membership_iff]
    have pre := tendsto with A, selfP
    exact Eventually.of_mem with pre
  . intro ev
    obtain ⟨C, hC, sub⟩ := ev
    unfold Tendsto
    intros B hB
    simp [principalFilter.membership, powerset.membership_iff] at hB
    have mono := functionPreimage.monotone at f, X, A, B with hB.right
    have preSub := functionPreimage.subset at f, X, B
    exact IsFilter.mono with filter, hC, (Subset.transitive with sub, mono), preSub

theorem Tendsto.inf (f X Y F G H : Set)
  requires filter : IsFilter(X, F)
  requires function : f : X → Y
  requires first : Tendsto(f, X, F, G)
  requires second : Tendsto(f, X, F, H)
  shows Tendsto(f, X, F, filterInf(Y, G, H))
proof
  unfold Tendsto
  intros C hC
  simp [filterInf.membership, powerset.membership_iff] at hC
  obtain ⟨sub, A, hA, B, hB, inC⟩ := hC
  have preA := first with A, hA
  have preB := second with B, hB
  have both := IsFilter.inter with filter, preA, preB
  rw ← functionPreimage.intersection at both
  have mono := functionPreimage.monotone at f, X, A ∩ B, C with inC
  have preSub := functionPreimage.subset at f, X, C
  exact IsFilter.mono with filter, both, mono, preSub

-- A map into a product tends to F ×ˢ G when both coordinates do.
theorem Tendsto.prod_mk (f X F Y G Z H : Set)
  requires function : f : X → Y × Z
  requires filterF : IsFilter(X, F)
  requires first : Tendsto(compose(firstProjection(Y, Z), f, X, Y × Z, Y),
    X, F, G)
  requires second : Tendsto(compose(secondProjection(Y, Z), f, X, Y × Z, Z),
    X, F, H)
  shows Tendsto(f, X, F, filterProd(Y, G, Z, H))
proof
  have fstF := firstProjection.function at Y, Z
  have sndF := secondProjection.function at Y, Z
  unfold Tendsto
  intros C hC
  simp [filterProd.membership, powerset.membership_iff] at hC
  obtain ⟨sub, A, hA, B, hB, inC⟩ := hC
  have preA := first with A, hA
  have preB := second with B, hB
  have both := IsFilter.inter with filterF, preA, preB
  have inside : functionPreimage(compose(firstProjection(Y, Z), f, X, Y × Z, Y), X, A) ∩
      functionPreimage(compose(secondProjection(Y, Z), f, X, Y × Z, Z), X, B) ⊆
      functionPreimage(f, X, C)
    intros x hx
    have hx2 := intersection.membership.forward with hx
    have xa := functionPreimage.membership.forward with hx2.left
    have xb := functionPreimage.membership.forward with hx2.right
    have xX := xa.left
    have fx := FunctionBetween.apply_closed with function, xX
    obtain ⟨bound, a, ha, b, hb, pEq⟩ := product.membership.forward with fx
    have ca := compose.apply at firstProjection(Y, Z), f, X, Y × Z, Y, x with function, fstF, xX
    have cb := compose.apply at secondProjection(Y, Z), f, X, Y × Z, Z, x with function, sndF, xX
    have pa := firstProjection.pair with ha, hb
    have pb := secondProjection.pair with ha, hb
    have aA : a ∈ A
      have v := xa.right
      rw [ca, pEq, pa] at v
      exact v
    have bB : b ∈ B
      have v := xb.right
      rw [cb, pEq, pb] at v
      exact v
    have abIn := product.pair with aA, bB
    have inC2 := inC with (a, b), abIn
    apply functionPreimage.of_apply with xX
    rw pEq
    exact inC2
  have preSub := functionPreimage.subset at f, X, C
  exact IsFilter.mono with filterF, both, inside, preSub

-- Section: Filters at infinity
theorem natAtTop.is_filter
  shows ProperFilter(ℕ, natAtTop)
proof
  unfold ProperFilter
  constructor
  . unfold IsFilter
    refine ⟨?_, ?_, ?_, ?_⟩
    . intros A hA
      simp [natAtTop.membership] at hA
      exact hA.left
    . apply natAtTop.membership.backward
      refine ⟨(powerset.self at ℕ), (0:N), ?_, ?_⟩
      . typecheck
      . intros n hn le
        exact hn
    . intros A hA B hAB hBX
      simp [natAtTop.membership] at hA
      obtain ⟨_, N, hN, tail⟩ := hA
      apply natAtTop.membership.backward
      refine ⟨(powerset.membership_iff.backward with hBX), N, hN, ?_⟩
      intros n hn le
      exact hAB with n, (tail with n, hn, le)
    . intros A hA B hB
      simp [natAtTop.membership] at hA
      simp [natAtTop.membership] at hB
      obtain ⟨subA, N, hN, tailA⟩ := hA
      obtain ⟨subB, M, hM, tailB⟩ := hB
      have subA2 := powerset.membership_iff.forward with subA
      have sub : A ∩ B ⊆ ℕ
        intros x hx
        simp at hx
        exact subA2 with x, hx.left
      have NNat := omega.natural with hN
      have MNat := omega.natural with hM
      apply natAtTop.membership.backward
      refine ⟨(powerset.membership_iff.backward with sub), add(N, M), ?_, ?_⟩
      . simp
      . intros n hn le
        have nNat := omega.natural with hn
        have leN : N ≤ n by arith
        have leM : M ≤ n by arith
        have inA := tailA with n, hn, leN
        have inB := tailB with n, hn, leM
        simp
  . intro emptyIn
    simp [natAtTop.membership] at emptyIn
    obtain ⟨_, N, hN, tail⟩ := emptyIn
    have NNat := omega.natural with hN
    have le : N ≤ N by arith
    exact tail with N, hN, le

theorem natAtTop.mem_iff (A : Set)
  shows A ∈ natAtTop ↔ A ⊆ ℕ ∧ (∃ N ∈ ℕ, ∀ n ∈ ℕ, N ≤ n → n ∈ A)
proof
  simp [natAtTop.membership, powerset.membership_iff]

-- On ℕ the filter at infinity is the cofinite filter.
theorem natAtTop.eq_cofinite
  shows natAtTop = cofinite(ℕ)
proof
  ext A
  constructor
  . intro hA
    simp [natAtTop.membership, powerset.membership_iff] at hA
    obtain ⟨sub, N, hN, tail⟩ := hA
    have NNat := omega.natural with hN
    have inside : ℕ ∖ A ⊆ N
      intros n hn
      have hn2 := difference.membership.forward with hn
      have nNat := omega.natural with hn2.left
      by_contra notIn
      have notLess : ¬(n < N)
        intro less
        exact notIn with (membership.of_Less with nNat, NNat, less)
      have le : N ≤ n by arith
      exact hn2.right with (tail with n, hn2.left, le)
    have fin := Finite.subset with (Finite.natural at N), inside
    apply cofinite.membership.backward
    exact ⟨(powerset.membership_iff.backward with sub), fin⟩
  . intro hA
    have hA2 := cofinite.membership.forward with hA
    obtain ⟨inPow, fin⟩ := hA2
    have sub := powerset.membership_iff.forward with inPow
    have diffSub : ℕ ∖ A ⊆ ℕ
      intros x hx
      simp at hx
      exact hx.left
    obtain ⟨b, bNat, bounded⟩ := Finite.naturals_bounded with diffSub, fin
    have sbNat : Nat(succ(b)) by typecheck
    have sbIn : succ(b) ∈ ℕ by typecheck
    apply natAtTop.membership.backward
    refine ⟨inPow, succ(b), sbIn, ?_⟩
    intros n hn le
    have nNat := omega.natural with hn
    by_contra notIn
    have inDiff := difference.membership.backward with hn, notIn
    have small := bounded with n, inDiff
    have less := Less.of_membership at n, succ(b) with small
    exact LessEqual.not_Less with le, less

theorem natAtTop.eventually_ge (N : Nat)
  shows ∃ A ∈ natAtTop, ∀ n ∈ A, N ≤ n
proof
  have NIn : N ∈ ℕ by typecheck
  refine ⟨ℕ ∖ N, ?_, ?_⟩
  . have sub : ℕ ∖ N ⊆ ℕ
      intros x hx
      simp at hx
      exact hx.left
    apply natAtTop.membership.backward
    refine ⟨(powerset.membership_iff.backward with sub), N, NIn, ?_⟩
    intros n hn le
    have nNat := omega.natural with hn
    have notIn : n ∉ N
      intro inN
      have less := Less.of_membership at n, N with inN
      exact LessEqual.not_Less with le, less
    exact difference.membership.backward with hn, notIn
  . intros n hn
    have hn2 := difference.membership.forward with hn
    have nNat := omega.natural with hn2.left
    apply LessEqual.of_not_Less
    intro less
    have NNat : Nat(N) by typecheck
    exact hn2.right with (membership.of_Less with nNat, NNat, less)

theorem natAtTop.shift (u : Set, k : Nat)
  requires function : u : ℕ → ℕ
  requires values : ∀ n ∈ ℕ, u(n) = add(n, k)
  shows Tendsto(u, ℕ, natAtTop, natAtTop)
proof
  unfold Tendsto
  intros B hB
  simp [natAtTop.membership, powerset.membership_iff] at hB
  obtain ⟨sub, N, hN, tail⟩ := hB
  have preSub := functionPreimage.subset at u, ℕ, B
  apply natAtTop.membership.backward
  refine ⟨(powerset.membership_iff.backward with preSub), N, hN, ?_⟩
  intros n hn le
  have nNat := omega.natural with hn
  have NNat := omega.natural with hN
  have value := values with n, hn
  have le2 : N ≤ add(n, k) by arith
  have inN : add(n, k) ∈ ℕ by typecheck
  have inB := tail with add(n, k), inN, le2
  apply functionPreimage.of_apply with hn
  rw value
  exact inB

theorem realAtTop.is_filter
  shows ProperFilter(ℝ, realAtTop)
proof
  unfold ProperFilter
  constructor
  . unfold IsFilter
    refine ⟨?_, ?_, ?_, ?_⟩
    . intros A hA
      simp [realAtTop.membership] at hA
      exact hA.left
    . apply realAtTop.membership.backward
      refine ⟨(powerset.self at ℝ), (0:R), ?_, ?_⟩
      . typecheck
      . intros x hx le
        exact hx
    . intros A hA B hAB hBX
      simp [realAtTop.membership] at hA
      obtain ⟨_, M, hM, tail⟩ := hA
      apply realAtTop.membership.backward
      refine ⟨(powerset.membership_iff.backward with hBX), M, hM, ?_⟩
      intros x hx le
      exact hAB with x, (tail with x, hx, le)
    . intros A hA B hB
      simp [realAtTop.membership] at hA
      simp [realAtTop.membership] at hB
      obtain ⟨subA, M1, hM1, tailA⟩ := hA
      obtain ⟨subB, M2, hM2, tailB⟩ := hB
      have subA2 := powerset.membership_iff.forward with subA
      have sub : A ∩ B ⊆ ℝ
        intros x hx
        simp at hx
        exact subA2 with x, hx.left
      apply realAtTop.membership.backward
      by_cases order : (M1:R) ≤ (M2:R)
      . refine ⟨(powerset.membership_iff.backward with sub), M2, hM2, ?_⟩
        intros x hx le
        have le1 := realLe.transitive at M1, M2, x with order, le
        have inA := tailA with x, hx, le1
        have inB := tailB with x, hx, le
        simp
      . refine ⟨(powerset.membership_iff.backward with sub), M1, hM1, ?_⟩
        intros x hx le
        have M21 : (M2:R) ≤ (M1:R) by linarith
        have le2 := realLe.transitive at M2, M1, x with M21, le
        have inA := tailA with x, hx, le
        have inB := tailB with x, hx, le2
        simp
  . intro emptyIn
    simp [realAtTop.membership] at emptyIn
    obtain ⟨_, M, hM, tail⟩ := emptyIn
    have le := realLe.reflexive at M
    exact tail with M, hM, le

theorem realAtBot.is_filter
  shows ProperFilter(ℝ, realAtBot)
proof
  unfold ProperFilter
  constructor
  . unfold IsFilter
    refine ⟨?_, ?_, ?_, ?_⟩
    . intros A hA
      simp [realAtBot.membership] at hA
      exact hA.left
    . apply realAtBot.membership.backward
      refine ⟨(powerset.self at ℝ), (0:R), ?_, ?_⟩
      . typecheck
      . intros x hx le
        exact hx
    . intros A hA B hAB hBX
      simp [realAtBot.membership] at hA
      obtain ⟨_, M, hM, tail⟩ := hA
      apply realAtBot.membership.backward
      refine ⟨(powerset.membership_iff.backward with hBX), M, hM, ?_⟩
      intros x hx le
      exact hAB with x, (tail with x, hx, le)
    . intros A hA B hB
      simp [realAtBot.membership] at hA
      simp [realAtBot.membership] at hB
      obtain ⟨subA, M1, hM1, tailA⟩ := hA
      obtain ⟨subB, M2, hM2, tailB⟩ := hB
      have subA2 := powerset.membership_iff.forward with subA
      have sub : A ∩ B ⊆ ℝ
        intros x hx
        simp at hx
        exact subA2 with x, hx.left
      apply realAtBot.membership.backward
      by_cases order : (M1:R) ≤ (M2:R)
      . refine ⟨(powerset.membership_iff.backward with sub), M1, hM1, ?_⟩
        intros x hx le
        have le2 := realLe.transitive at x, M1, M2 with le, order
        have inA := tailA with x, hx, le
        have inB := tailB with x, hx, le2
        simp
      . refine ⟨(powerset.membership_iff.backward with sub), M2, hM2, ?_⟩
        intros x hx le
        have M21 : (M2:R) ≤ (M1:R) by linarith
        have le1 := realLe.transitive at x, M2, M1 with le, M21
        have inA := tailA with x, hx, le1
        have inB := tailB with x, hx, le
        simp
  . intro emptyIn
    simp [realAtBot.membership] at emptyIn
    obtain ⟨_, M, hM, tail⟩ := emptyIn
    have le := realLe.reflexive at M
    exact tail with M, hM, le

theorem cofinite.is_filter (X F : Set)
  requires cofiniteF : F = cofinite(X)
  shows IsFilter(X, F)
proof
  rw cofiniteF
  unfold IsFilter
  refine ⟨?_, ?_, ?_, ?_⟩
  . intros A hA
    simp [cofinite.membership] at hA
    exact hA.left
  . have empty : X ∖ X = ∅
      ext x
      simp
    have fin : Finite(X ∖ X)
      rw empty
      exact Finite.empty
    apply cofinite.membership.backward
    exact ⟨(powerset.self at X), fin⟩
  . intros A hA B hAB hBX
    have hA2 := cofinite.membership.forward with hA
    have inside : X ∖ B ⊆ X ∖ A
      intros x hx
      simp at hx
      have notA : x ∉ A
        intro xA
        exact hx.right with (hAB with x, xA)
      simp
    have fin := Finite.subset with hA2.right, inside
    apply cofinite.membership.backward
    exact ⟨(powerset.membership_iff.backward with hBX), fin⟩
  . intros A hA B hB
    have hA2 := cofinite.membership.forward with hA
    have hB2 := cofinite.membership.forward with hB
    have subA := powerset.membership_iff.forward with hA2.left
    have sub : A ∩ B ⊆ X
      intros x hx
      simp at hx
      exact subA with x, hx.left
    have inside : X ∖ (A ∩ B) ⊆ (X ∖ A) ∪ (X ∖ B)
      intros x hx
      have hx2 := difference.membership.forward with hx
      by_cases xA : x ∈ A
      . have notB : x ∉ B
          intro xB
          exact hx2.right with (intersection.membership.backward with xA, xB)
        simp
      . simp
    have fin := Finite.subset with (Finite.union with hA2.right, hB2.right), inside
    apply cofinite.membership.backward
    exact ⟨(powerset.membership_iff.backward with sub), fin⟩

theorem cofinite.proper_iff (X : Set)
  shows ProperFilter(X, cofinite(X)) ↔ ¬Finite(X)
proof
  have same : cofinite(X) = cofinite(X)
    rfl
  have filt := cofinite.is_filter with same
  constructor
  . intro proper
    intro finX
    have empty : X ∖ ∅ = X
      ext x
      simp
    have fin : Finite(X ∖ ∅)
      rw empty
      exact finX
    have emptyIn := cofinite.membership.backward with ⟨(powerset.empty_member at X), fin⟩
    exact proper.right with emptyIn
  . intro infinite
    unfold ProperFilter
    refine ⟨filt, ?_⟩
    intro emptyIn
    have e2 := cofinite.membership.forward with emptyIn
    have empty : X ∖ ∅ = X
      ext x
      simp
    have fin := e2.right
    rw empty at fin
    exact infinite with fin

-- The complement of a finite set is cofinite; in particular all but one
-- point.
theorem cofinite.compl_finite (X A : Set)
  requires finite : Finite(A)
  shows Eventually(cofinite(X), X ∖ A)
proof
  have sub : X ∖ A ⊆ X
    intros x hx
    simp at hx
    exact hx.left
  have inside : X ∖ (X ∖ A) ⊆ A
    intros x hx
    have hx2 := difference.membership.forward with hx
    by_contra notA
    exact hx2.right with (difference.membership.backward with hx2.left, notA)
  have fin := Finite.subset with finite, inside
  have member := cofinite.membership.backward with ⟨(powerset.membership_iff.backward with sub), fin⟩
  exact Eventually.of_mem with member

-- An injective map pulls cofinite sets back to cofinite sets.
theorem cofinite.tendsto_injective (f X Y : Set)
  requires injective : InjectiveBetween(f, X, Y)
  shows Tendsto(f, X, cofinite(X), cofinite(Y))
proof
  have function := injective.left
  unfold Tendsto
  intros B hB
  have hB2 := cofinite.membership.forward with hB
  have preSub := functionPreimage.subset at f, X, B
  have complement := functionPreimage.complement at f, X, Y, B with function
  have pSub := functionPreimage.subset at f, X, Y ∖ B
  have restricted := restrict.injective with injective, pSub
  have onto := Injective.corestrict with restricted
  have imageSub : functionImage(restrict(f, functionPreimage(f, X, Y ∖ B)),
      functionPreimage(f, X, Y ∖ B), Y) ⊆ Y ∖ B
    intros y hy
    simp [functionImage.membership] at hy
    obtain ⟨yY, x, hx, shape⟩ := hy
    have xPre := functionPreimage.membership.forward with hx
    have closed : ∀ z ∈ functionPreimage(f, X, Y ∖ B), f(z) ∈ Y
      intros z hz
      have zPre := functionPreimage.membership.forward with hz
      exact FunctionBetween.apply_closed with function, zPre.left
    have value := restrict.apply with function, pSub, closed, hx
    rw [shape, value]
    exact xPre.right
  have imageFinite := Finite.subset with hB2.right, imageSub
  have preFinite := Injective.finite_domain with onto, imageFinite
  rw complement at preFinite
  have done := cofinite.membership.backward with ⟨(powerset.membership_iff.backward with preSub), preFinite⟩
  exact done

-- A sequence tends to infinity in ℕ along natAtTop exactly when it
-- eventually exceeds every bound.
theorem natAtTop.tendsto_iff (u X F : Set)
  requires filter : IsFilter(X, F)
  requires values : u : X → ℕ
  shows Tendsto(u, X, F, natAtTop) ↔
    (∀ N ∈ ℕ, ∃ A ∈ F, ∀ x ∈ A, N ≤ u(x))
proof
  constructor
  . intro tendsto
    intros N hN
    have NNat := omega.natural with hN
    obtain ⟨T, hT, big⟩ := natAtTop.eventually_ge at N
    have pre := tendsto with T, hT
    refine ⟨functionPreimage(u, X, T), pre, ?_⟩
    intros x hx
    have hx2 := functionPreimage.membership.forward with hx
    exact big with u(x), hx2.right
  . intro bounds
    unfold Tendsto
    intros B hB
    simp [natAtTop.membership, powerset.membership_iff] at hB
    obtain ⟨sub, N, hN, tail⟩ := hB
    obtain ⟨A, hA, big⟩ := bounds with N, hN
    have inX := IsFilter.subset with filter, hA
    have inside : A ⊆ functionPreimage(u, X, B)
      intros x hx
      have xX := inX with x, hx
      have ux := FunctionBetween.apply_closed with values, xX
      have le := big with x, hx
      have inB := tail with u(x), ux, le
      exact functionPreimage.of_apply with xX, inB
    have preSub := functionPreimage.subset at u, X, B
    exact IsFilter.mono with filter, hA, inside, preSub

-- The upper tail [M, ∞) of ℝ, a member of the filter at infinity.
def realUpperTail (M : Set) : Set := { x ∈ ℝ | M ≤ x }

theorem realUpperTail.mem_atTop (M : Set)
  requires real : M ∈ ℝ
  shows realUpperTail(M) ∈ realAtTop
proof
  have sub : realUpperTail(M) ⊆ ℝ
    intros x hx
    simp [realUpperTail.membership] at hx
    exact hx.left
  apply realAtTop.membership.backward
  refine ⟨(powerset.membership_iff.backward with sub), M, real, ?_⟩
  intros x hx le
  simp [realUpperTail.membership]

theorem realAtTop.tendsto_iff (u X F : Set)
  requires filter : IsFilter(X, F)
  requires values : u : X → ℝ
  shows Tendsto(u, X, F, realAtTop) ↔
    (∀ M ∈ ℝ, ∃ A ∈ F, ∀ x ∈ A, M ≤ u(x))
proof
  constructor
  . intro tendsto
    intros M hM
    have tailIn := realUpperTail.mem_atTop with hM
    have pre := tendsto with realUpperTail(M), tailIn
    refine ⟨functionPreimage(u, X, realUpperTail(M)), pre, ?_⟩
    intros x hx
    have hx2 := functionPreimage.membership.forward with hx
    have inTail := realUpperTail.membership.forward with hx2.right
    exact inTail.right
  . intro bounds
    unfold Tendsto
    intros B hB
    simp [realAtTop.membership, powerset.membership_iff] at hB
    obtain ⟨sub, M, hM, tail⟩ := hB
    obtain ⟨A, hA, big⟩ := bounds with M, hM
    have inX := IsFilter.subset with filter, hA
    have inside : A ⊆ functionPreimage(u, X, B)
      intros x hx
      have xX := inX with x, hx
      have ux := FunctionBetween.apply_closed with values, xX
      have le := big with x, hx
      have inB := tail with u(x), ux, le
      exact functionPreimage.of_apply with xX, inB
    have preSub := functionPreimage.subset at u, X, B
    exact IsFilter.mono with filter, hA, inside, preSub

-- n ↦ n as a real number tends to infinity.
theorem realNat.tendsto_atTop (u : Set)
  requires values : ∀ n ∈ ℕ, u(n) = realNat(n)
  shows Tendsto(u, ℕ, natAtTop, realAtTop)
proof
  unfold Tendsto
  intros B hB
  simp [realAtTop.membership, powerset.membership_iff] at hB
  obtain ⟨sub, M, hM, tail⟩ := hB
  have MReal : Real(M) by typecheck
  obtain ⟨N, NNat, below⟩ := Real.below_natural at M
  have NIn : N ∈ ℕ by typecheck
  have preSub := functionPreimage.subset at u, ℕ, B
  apply natAtTop.membership.backward
  refine ⟨(powerset.membership_iff.backward with preSub), N, NIn, ?_⟩
  intros n hn le
  have nNat := omega.natural with hn
  have mono := realNat.le_of_natural_le at N, n with le
  have rn := realNat.real at n
  have rN := realNat.real at N
  have bound : (M:R) ≤ (realNat(n):R) by linarith
  have rnIn : realNat(n) ∈ ℝ by typecheck
  have inB := tail with realNat(n), rnIn, bound
  have value := values with n, hn
  apply functionPreimage.of_apply with hn
  rw value
  exact inB

-- Section: Neighborhoods
theorem nhds.is_filter (X x : Set)
  requires space : TopologicalSpace(X)
  requires point : x ∈ X.carrier
  shows ProperFilter(X.carrier, nhds(X, x))
proof
  have parts := TopologicalSpace.parts with space
  obtain ⟨subsets, whole, unions, intersections⟩ := parts
  unfold ProperFilter
  constructor
  . unfold IsFilter
    refine ⟨?_, ?_, ?_, ?_⟩
    . intros N hN
      simp [nhds.membership] at hN
      exact hN.left
    . have self : X.carrier ⊆ X.carrier
        simp
      apply nhds.membership.backward
      refine ⟨(powerset.self at X.carrier), X.carrier, whole, point, self⟩
    . intros N hN M hNM hMX
      simp [nhds.membership] at hN
      obtain ⟨_, U, hU, xU, UN⟩ := hN
      apply nhds.membership.backward
      refine ⟨(powerset.membership_iff.backward with hMX), U, hU, xU, (Subset.transitive with UN, hNM)⟩
    . intros N hN M hM
      simp [nhds.membership, powerset.membership_iff] at hN
      simp [nhds.membership, powerset.membership_iff] at hM
      obtain ⟨subN, U, hU, xU, UN⟩ := hN
      obtain ⟨subM, V, hV, xV, VM⟩ := hM
      have both := intersections with U, hU, V, hV
      have xUV := intersection.membership.backward with xU, xV
      have inside := intersection.monotone with UN, VM
      have sub : N ∩ M ⊆ X.carrier
        intros y hy
        simp at hy
        exact subN with y, hy.left
      apply nhds.membership.backward
      refine ⟨(powerset.membership_iff.backward with sub), U ∩ V, both, xUV, inside⟩
  . intro emptyIn
    simp [nhds.membership] at emptyIn
    obtain ⟨_, U, hU, xU, UN⟩ := emptyIn
    have bad := UN with x, xU
    exact set.empty with bad

theorem nhds.mem_iff (X x N : Set)
  requires space : TopologicalSpace(X)
  shows N ∈ nhds(X, x) ↔ Neighborhood(X, N, x)
proof
  unfold Neighborhood
  simp [nhds.membership, powerset.membership_iff]

theorem nhds.open_mem (X x U : Set)
  requires space : TopologicalSpace(X)
  requires open : U ∈ X.opens
  requires point : x ∈ U
  shows U ∈ nhds(X, x)
proof
  have parts := TopologicalSpace.parts with space
  obtain ⟨subsets, whole, unions, intersections⟩ := parts
  have inPow := subsets with U, open
  have self : U ⊆ U by simp
  apply nhds.membership.backward
  refine ⟨inPow, U, open, point, self⟩

theorem nhds.mem_of (X x N : Set)
  requires space : TopologicalSpace(X)
  requires member : N ∈ nhds(X, x)
  shows x ∈ N
proof
  simp [nhds.membership] at member
  obtain ⟨_, U, hU, xU, UN⟩ := member
  exact UN with x, xU

-- A set is open exactly when it is a neighborhood of each of its points.
theorem nhds.open_iff (X U : Set)
  requires space : TopologicalSpace(X)
  requires inside : U ⊆ X.carrier
  shows U ∈ X.opens ↔ (∀ x ∈ U, U ∈ nhds(X, x))
proof
  constructor
  . intro open
    intros x hx
    exact nhds.open_mem with space, open, hx
  . intro around
    have iff := Open.iff_neighborhoods with space, inside
    have nb : ∀ x ∈ U, Neighborhood(X, U, x)
      intros x hx
      have mem := around with x, hx
      have iff2 := nhds.mem_iff at X, x, U with space
      exact iff2.forward with mem
    have op := iff.backward with nb
    exact Open.mem with space, op

-- An eventual property near x holds at every point near x
-- (Mathlib's Filter.Eventually.eventually_nhds).
theorem nhds.eventually_eventually (X x S : Set)
  requires space : TopologicalSpace(X)
  requires eventually : Eventually(nhds(X, x), S)
  shows ∃ U ∈ nhds(X, x), ∀ y ∈ U,
    Eventually(nhds(X, y), S)
proof
  obtain ⟨A, hA, AS⟩ := eventually
  simp [nhds.membership] at hA
  obtain ⟨_, U, hU, xU, UA⟩ := hA
  have Unhds := nhds.open_mem with space, hU, xU
  refine ⟨U, Unhds, ?_⟩
  intros y hy
  have Uy := nhds.open_mem with space, hU, hy
  unfold Eventually
  refine ⟨U, Uy, (Subset.transitive with UA, AS)⟩

-- x is in the closure of A exactly when A frequently holds near x.
theorem nhds.closure_iff (X A x : Set)
  requires space : TopologicalSpace(X)
  requires point : x ∈ X.carrier
  requires inside : A ⊆ X.carrier
  shows x ∈ closure(X, A) ↔ Frequently(nhds(X, x), A)
proof
  have parts := TopologicalSpace.parts with space
  have mem := closure.membership at X.carrier, X.opens, A, x with parts, inside
  rw closure.parts
  constructor
  . intro hx
    have hx2 := mem.forward with hx
    unfold Frequently
    intros N hN
    simp [nhds.membership] at hN
    obtain ⟨_, U, hU, xU, UN⟩ := hN
    have ne := hx2.right with U, hU, xU
    obtain ⟨y, hy⟩ := ne
    simp at hy
    unfold Nonempty
    refine ⟨y, ?_⟩
    have yN := UN with y, hy.left
    simp
  . intro freq
    apply mem.backward
    refine ⟨point, ?_⟩
    intros U hU xU
    have Un := nhds.open_mem with space, hU, xU
    exact freq with U, Un

theorem nhdsWithin.is_filter (X x S : Set)
  requires space : TopologicalSpace(X)
  shows IsFilter(X.carrier, nhdsWithin(X, x, S))
proof
  sorry

theorem nhdsWithin.mem_iff (X x S N : Set)
  requires space : TopologicalSpace(X)
  shows N ∈ nhdsWithin(X, x, S) ↔
    N ⊆ X.carrier ∧ (∃ U ∈ X.opens, x ∈ U ∧ U ∩ S ⊆ N)
proof
  unfold nhdsWithin
  have parts := TopologicalSpace.parts with space
  obtain ⟨subsets, whole, unions, intersections⟩ := parts
  constructor
  . intro hN
    simp [filterInf.membership, powerset.membership_iff] at hN
    obtain ⟨sub, A, hA, B, hB, inN⟩ := hN
    simp [nhds.membership, powerset.membership_iff] at hA
    obtain ⟨Asub, U, hU, xU, UA⟩ := hA
    simp [principalFilter.membership, powerset.membership_iff] at hB
    have Usub := powerset.membership_iff.forward with (subsets with U, hU)
    have inside : U ∩ S ⊆ N
      intros y hy
      have hy2 := intersection.membership.forward with hy
      have yC := Usub with y, hy2.left
      have yA := UA with y, hy2.left
      have ySC := intersection.membership.backward with hy2.right, yC
      have yB := hB.right with y, ySC
      exact inN with y, (intersection.membership.backward with yA, yB)
    refine ⟨sub, U, hU, xU, inside⟩
  . intro hN
    obtain ⟨sub, U, hU, xU, inside⟩ := hN
    have Usub := powerset.membership_iff.forward with (subsets with U, hU)
    have self : U ⊆ U by simp
    have Unhds := nhds.membership.backward with ⟨(subsets with U, hU), U, hU, xU, self⟩
    have SCsub : S ∩ X.carrier ⊆ X.carrier
      intros y hy
      simp at hy
      exact hy.right
    have selfSC : S ∩ X.carrier ⊆ S ∩ X.carrier by simp
    have SCin := principalFilter.membership.backward with ⟨(powerset.membership_iff.backward with SCsub), selfSC⟩
    have both : U ∩ (S ∩ X.carrier) ⊆ N
      intros y hy
      have hy2 := intersection.membership.forward with hy
      have hy3 := intersection.membership.forward with hy2.right
      exact inside with y, (intersection.membership.backward with hy2.left, hy3.left)
    apply filterInf.membership.backward
    refine ⟨(powerset.membership_iff.backward with sub), U, Unhds, S ∩ X.carrier, SCin, both⟩

theorem nhdsWithin.le_nhds (X x S : Set)
  requires space : TopologicalSpace(X)
  shows FilterLe(nhdsWithin(X, x, S), nhds(X, x))
proof
  unfold FilterLe
  intros N hN
  simp [nhds.membership, powerset.membership_iff] at hN
  obtain ⟨sub, U, hU, xU, UN⟩ := hN
  have inside : U ∩ S ⊆ N
    intros y hy
    simp at hy
    exact UN with y, hy.left
  have iff := nhdsWithin.mem_iff at X, x, S, N with space
  exact iff.backward with ⟨sub, U, hU, xU, inside⟩

theorem nhdsWithin.open_eq (X x U : Set)
  requires space : TopologicalSpace(X)
  requires open : U ∈ X.opens
  requires point : x ∈ U
  shows nhdsWithin(X, x, U) = nhds(X, x)
proof
  have parts := TopologicalSpace.parts with space
  obtain ⟨subsets, whole, unions, intersections⟩ := parts
  apply FilterLe.antisymm
  . exact nhdsWithin.le_nhds with space
  . unfold FilterLe
    intros N hN
    have iff := nhdsWithin.mem_iff at X, x, U, N with space
    obtain ⟨sub, V, hV, xV, inside⟩ := iff.forward with hN
    have both := intersections with V, hV, U, open
    have xVU := intersection.membership.backward with xV, point
    exact nhds.membership.backward with ⟨(powerset.membership_iff.backward with sub), V ∩ U, both, xVU, inside⟩

theorem nhdsWithin.self_mem (X x S : Set)
  requires space : TopologicalSpace(X)
  requires inside : S ⊆ X.carrier
  shows S ∈ nhdsWithin(X, x, S)
proof
  sorry

-- 𝓝[S] x is proper exactly when x lies in the closure of S.
theorem nhdsWithin.proper_iff (X x S : Set)
  requires space : TopologicalSpace(X)
  requires point : x ∈ X.carrier
  requires inside : S ⊆ X.carrier
  shows ProperFilter(X.carrier, nhdsWithin(X, x, S)) ↔ x ∈ closure(X, S)
proof
  have filtN := (nhds.is_filter with space, point).left
  have SC : S ∩ X.carrier ⊆ X.carrier
    intros y hy
    simp at hy
    exact hy.right
  have same : S ∩ X.carrier = S
    ext y
    constructor
    . intro hy
      simp at hy
      exact hy.left
    . intro hy
      have yC := inside with y, hy
      simp
  have iff := filterInf.principal_proper_iff with filtN, SC
  unfold nhdsWithin
  rw same at iff
  rw same
  have cl := nhds.closure_iff with space, point, inside
  constructor
  . intro proper
    exact cl.backward with (iff.forward with proper)
  . intro mem
    exact iff.backward with (cl.forward with mem)

-- The neighborhoods of a point of a product are the product filter.
theorem nhds.product (X Y x y : Set)
  requires spaceX : TopologicalSpace(X)
  requires spaceY : TopologicalSpace(Y)
  requires pointX : x ∈ X.carrier
  requires pointY : y ∈ Y.carrier
  shows nhds(productSpace(X, Y), (x, y)) =
    filterProd(X.carrier, nhds(X, x), Y.carrier, nhds(Y, y))
proof
  sorry

-- The neighborhoods of a point of a subspace are the preimages of the
-- neighborhoods in the space.
theorem nhds.subspace (X A x : Set)
  requires space : TopologicalSpace(X)
  requires inside : A ⊆ X.carrier
  requires point : x ∈ A
  shows nhds(subspace(X, A), x) = filterComap(identity(A), A, nhds(X, x))
proof
  sorry

-- Section: Continuity as a limit
theorem Continuous.iff_continuousAt (f X Y : Set)
  requires spaceX : TopologicalSpace(X)
  requires spaceY : TopologicalSpace(Y)
  requires function : f : X.carrier → Y.carrier
  shows f : X ⇒ Y ↔ (∀ x ∈ X.carrier, ContinuousAtPoint(f, X, Y, x))
proof
  have parts := TopologicalSpace.parts with spaceX
  constructor
  . intro continuous
    intros x hx
    unfold ContinuousAtPoint
    unfold Tendsto
    intros V hV
    simp [nhds.membership, powerset.membership_iff] at hV
    obtain ⟨sub, U, hU, fxU, UV⟩ := hV
    have openU := Open.of_mem with spaceY, hU
    have preOpen := Continuous.preimage_open with continuous, openU
    have preMem := Open.mem with spaceX, preOpen
    have xPre := functionPreimage.of_apply with hx, fxU
    have preNhds := nhds.open_mem with spaceX, preMem, xPre
    have mono := functionPreimage.monotone at f, X.carrier, U, V with UV
    have preSub := functionPreimage.subset at f, X.carrier, V
    have filt := (nhds.is_filter with spaceX, hx).left
    exact IsFilter.mono with filt, preNhds, mono, preSub
  . intro atPoints
    apply Continuous.mk with spaceX, spaceY, function
    intros V hV
    have preSub := functionPreimage.subset at f, X.carrier, V
    have iff := nhds.open_iff with spaceX, preSub
    apply iff.backward
    intros x hx
    have hx2 := functionPreimage.membership.forward with hx
    have at := atPoints with x, hx2.left
    unfold ContinuousAtPoint at at
    have Vn := nhds.open_mem with spaceY, hV, hx2.right
    exact at with V, Vn

theorem Continuous.tendsto (f X Y x : Set)
  requires continuous : f : X ⇒ Y
  requires point : x ∈ X.carrier
  shows Tendsto(f, X.carrier, nhds(X, x), nhds(Y, f(x)))
proof
  have spaceX := Continuous.source with continuous
  have spaceY := Continuous.target with continuous
  have function := Continuous.function_between with continuous
  have iff := Continuous.iff_continuousAt with spaceX, spaceY, function
  have all := iff.forward with continuous
  have at := all with x, point
  unfold ContinuousAtPoint at at
  exact at

-- Continuous maps carry limits to limits (Mathlib's Continuous.tendsto').
theorem Continuous.tendsto_comp (f g X Y Z F x : Set)
  requires continuous : g : Y ⇒ Z
  requires function : f : X → Y.carrier
  requires point : x ∈ Y.carrier
  requires limit : Tendsto(f, X, F, nhds(Y, x))
  shows Tendsto(compose(g, f, X, Y.carrier, Z.carrier), X, F,
    nhds(Z, g(x)))
proof
  have spaceY := Continuous.source with continuous
  have functionG := Continuous.function_between with continuous
  have cont := Continuous.tendsto with continuous, point
  exact Tendsto.comp with function, functionG, limit, cont

theorem ContinuousAtPoint.of_continuous (f X Y x : Set)
  requires continuous : f : X ⇒ Y
  requires point : x ∈ X.carrier
  shows ContinuousAtPoint(f, X, Y, x)
proof
  unfold ContinuousAtPoint
  exact Continuous.tendsto with continuous, point

-- Mathlib's isClosed_eq: where two continuous maps into a Hausdorff space
-- agree is closed.
theorem Continuous.closed_eq (f g X Y : Set)
  requires continuousF : f : X ⇒ Y
  requires continuousG : g : X ⇒ Y
  requires hausdorff : Hausdorff(Y)
  shows Closed(X, equalizer(f, g, X.carrier))
proof
  sorry

-- Mathlib's isClosed_le on ℝ-valued maps.
theorem Continuous.closed_le (f g X : Set)
  requires continuousF : f : X ⇒ realLine
  requires continuousG : g : X ⇒ realLine
  shows Closed(X, realLeLocus(f, g, X.carrier))
proof
  sorry

-- Mathlib's IsClosed.mem_of_tendsto: a limit of points eventually in a
-- closed set lies in it.
theorem Closed.mem_of_tendsto (f X Y F C y : Set)
  requires space : TopologicalSpace(Y)
  requires proper : ProperFilter(X, F)
  requires closed : Closed(Y, C)
  requires limit : Tendsto(f, X, F, nhds(Y, y))
  requires point : y ∈ Y.carrier
  requires eventually : Eventually(F, functionPreimage(f, X, C))
  shows y ∈ C
proof
  have filter := proper.left
  by_contra notIn
  have closedParts := Closed.parts with space, closed
  obtain ⟨Csub, complOpen⟩ := closedParts
  have yCompl : y ∈ complement(Y.carrier, C)
    unfold complement
    exact difference.membership.backward with point, notIn
  have complNhds := nhds.open_mem with space, complOpen, yCompl
  have pre := limit with complement(Y.carrier, C), complNhds
  obtain ⟨A, hA, AC⟩ := eventually
  have both := IsFilter.inter with filter, hA, pre
  obtain ⟨x, hx⟩ := ProperFilter.nonempty with proper, both
  have hx2 := intersection.membership.forward with hx
  have inC := AC with x, hx2.left
  have inC2 := functionPreimage.membership.forward with inC
  have inCompl := functionPreimage.membership.forward with hx2.right
  have out := inCompl.right
  unfold complement at out
  have out2 := difference.membership.forward with out
  exact out2.right with inC2.right

-- Section: Uniqueness of limits
theorem Tendsto.unique (f X F Y a b : Set)
  requires space : TopologicalSpace(Y)
  requires hausdorff : Hausdorff(Y)
  requires proper : ProperFilter(X, F)
  requires pointA : a ∈ Y.carrier
  requires pointB : b ∈ Y.carrier
  requires first : Tendsto(f, X, F, nhds(Y, a))
  requires second : Tendsto(f, X, F, nhds(Y, b))
  shows a = b
proof
  have filter := proper.left
  by_contra distinct
  have parts := Hausdorff.parts with hausdorff
  obtain ⟨U, hU, V, hV, aU, bV, disjoint⟩ := parts with a, pointA, b, pointB, distinct
  have Un := nhds.open_mem with space, hU, aU
  have Vn := nhds.open_mem with space, hV, bV
  have preU := first with U, Un
  have preV := second with V, Vn
  have both := IsFilter.inter with filter, preU, preV
  obtain ⟨x, hx⟩ := ProperFilter.nonempty with proper, both
  have hx2 := intersection.membership.forward with hx
  have xU := functionPreimage.membership.forward with hx2.left
  have xV := functionPreimage.membership.forward with hx2.right
  have inter := intersection.membership.backward with xU.right, xV.right
  unfold Disjoint at disjoint
  rw disjoint at inter
  exact set.empty with inter

-- The constant map tends to its value.
theorem Tendsto.const (X F Y c : Set)
  requires space : TopologicalSpace(Y)
  requires filter : IsFilter(X, F)
  requires point : c ∈ Y.carrier
  shows Tendsto(X × {c}, X, F, nhds(Y, c))
proof
  sorry

-- Sequences: convergence in Cumulus's sense is the limit along natAtTop.
theorem Converges.iff_tendsto (X u x : Set)
  requires space : TopologicalSpace(X)
  requires sequence : u : ℕ → X.carrier
  requires point : x ∈ X.carrier
  shows Converges(X, u, x) ↔ Tendsto(u, ℕ, natAtTop, nhds(X, x))
proof
  constructor
  . intro conv
    unfold Converges at conv
    obtain ⟨seq, xIn, tails⟩ := conv
    unfold Tendsto
    intros B hB
    simp [nhds.membership, powerset.membership_iff] at hB
    obtain ⟨sub, U, hU, xU, UB⟩ := hB
    obtain ⟨N, hN, tail⟩ := tails with U, hU, xU
    have preSub := functionPreimage.subset at u, ℕ, B
    apply natAtTop.membership.backward
    refine ⟨(powerset.membership_iff.backward with preSub), N, hN, ?_⟩
    intros n hn le
    have inU := tail with n, hn, le
    exact functionPreimage.of_apply with hn, (UB with u(n), inU)
  . intro tendsto
    unfold Converges
    refine ⟨sequence, point, ?_⟩
    intros U hU xU
    have Un := nhds.open_mem with space, hU, xU
    have pre := tendsto with U, Un
    simp [natAtTop.membership, powerset.membership_iff] at pre
    obtain ⟨sub, N, hN, tail⟩ := pre
    refine ⟨N, hN, ?_⟩
    intros n hn le
    have inPre := tail with n, hn, le
    have inPre2 := functionPreimage.membership.forward with inPre
    exact inPre2.right

-- Section: Metric spaces
theorem nhds.metric_iff (M x N : Set)
  requires metric : MetricSpace(M)
  requires point : x ∈ M.carrier
  shows N ∈ nhds(metricTopology(M), x) ↔
    N ⊆ M.carrier ∧ (∃ r ∈ ℝ, realZero < r ∧ ball(M, x, r) ⊆ N)
proof
  have top := MetricSpace.topological_space with metric
  have parts := TopologicalSpace.parts with top
  obtain ⟨subsets, whole, unions, intersections⟩ := parts
  constructor
  . intro hN
    simp [nhds.membership, powerset.membership_iff] at hN
    obtain ⟨sub, U, hU, xU, UN⟩ := hN
    have Usub := powerset.membership_iff.forward with (subsets with U, hU)
    rw metricTopology.carrier at Usub
    rw metricTopology.carrier at sub
    have openU := Open.of_mem with top, hU
    have iff := Open.iff_balls at M, U with metric, Usub
    have balls := iff.forward with openU
    obtain ⟨r, hr, pos, ballU⟩ := balls with x, xU
    refine ⟨sub, r, hr, pos, (Subset.transitive with ballU, UN)⟩
  . intro hN
    obtain ⟨sub, r, hr, pos, ballN⟩ := hN
    have rReal : Real(r) by typecheck
    have openB := ball_open at M, x, r with metric
    have memB := Open.mem with top, openB
    have xB := mem_ball_self at M, x, r with metric, pos
    have subC : N ⊆ TopologicalSpace.carrier(metricTopology(M))
      rw metricTopology.carrier
      exact sub
    apply nhds.membership.backward
    refine ⟨(powerset.membership_iff.backward with subC), ball(M, x, r), memB, xB, ballN⟩

theorem Tendsto.metric_iff (f X F M a : Set)
  requires metric : MetricSpace(M)
  requires filter : IsFilter(X, F)
  requires values : f : X → M.carrier
  requires point : a ∈ M.carrier
  shows Tendsto(f, X, F, nhds(metricTopology(M), a)) ↔
    (∀ e ∈ ℝ, realZero < e →
      ∃ A ∈ F, ∀ x ∈ A, M.dist(f(x), a) < e)
proof
  constructor
  . intro tendsto
    intros e he pos
    have eReal : Real(e) by typecheck
    have ballSub := ball_subset at M, a, e with metric
    have self : ball(M, a, e) ⊆ ball(M, a, e) by simp
    have iff := nhds.metric_iff at M, a, ball(M, a, e) with metric, point
    have Bn := iff.backward with ⟨ballSub, e, he, pos, self⟩
    have pre := tendsto with ball(M, a, e), Bn
    refine ⟨functionPreimage(f, X, ball(M, a, e)), pre, ?_⟩
    intros x hx
    have hx2 := functionPreimage.membership.forward with hx
    have fx := FunctionBetween.apply_closed with values, hx2.left
    have mb := mem_ball at M, a, f(x), e with metric
    have lt := mb.forward with hx2.right
    have comm := dist_comm at M, a, f(x) with metric
    rw comm at lt
    exact lt
  . intro small
    unfold Tendsto
    intros B hB
    have iff := nhds.metric_iff at M, a, B with metric, point
    obtain ⟨sub, r, hr, pos, ballB⟩ := iff.forward with hB
    have rReal : Real(r) by typecheck
    obtain ⟨A, hA, close⟩ := small with r, hr, pos
    have inX := IsFilter.subset with filter, hA
    have inside : A ⊆ functionPreimage(f, X, B)
      intros x hx
      have xX := inX with x, hx
      have fx := FunctionBetween.apply_closed with values, xX
      have lt := close with x, hx
      have comm := dist_comm at M, a, f(x) with metric
      rw ← comm at lt
      have mb := mem_ball at M, a, f(x), r with metric
      have inBall := mb.backward with lt
      exact functionPreimage.of_apply with xX, (ballB with f(x), inBall)
    have preSub := functionPreimage.subset at f, X, B
    exact IsFilter.mono with filter, hA, inside, preSub

-- The ε–N form along natAtTop.
theorem Tendsto.metric_sequence_iff (u M a : Set)
  requires metric : MetricSpace(M)
  requires values : u : ℕ → M.carrier
  requires point : a ∈ M.carrier
  shows Tendsto(u, ℕ, natAtTop, nhds(metricTopology(M), a)) ↔
    (∀ e ∈ ℝ, realZero < e → ∃ N ∈ ℕ, ∀ n ∈ ℕ, N ≤ n →
      M.dist(u(n), a) < e)
proof
  have proper := natAtTop.is_filter
  have filt := proper.left
  have iff := Tendsto.metric_iff at u, ℕ, natAtTop, M, a with metric, filt, values, point
  rw iff
  constructor
  . intro small
    intros e he pos
    obtain ⟨A, hA, close⟩ := small with e, he, pos
    simp [natAtTop.membership, powerset.membership_iff] at hA
    obtain ⟨sub, N, hN, tail⟩ := hA
    refine ⟨N, hN, ?_⟩
    intros n hn le
    exact close with n, (tail with n, hn, le)
  . intro small
    intros e he pos
    obtain ⟨N, hN, close⟩ := small with e, he, pos
    have NNat := omega.natural with hN
    obtain ⟨T, hT, big⟩ := natAtTop.eventually_ge at N
    have Tsub := IsFilter.subset with filt, hT
    refine ⟨T, hT, ?_⟩
    intros n hn
    exact close with n, (Tsub with n, hn), (big with n, hn)

-- The ε–δ form of continuity at a point between metric spaces.
theorem ContinuousAtPoint.metric_iff (f M N x : Set)
  requires metricM : MetricSpace(M)
  requires metricN : MetricSpace(N)
  requires values : f : M.carrier → N.carrier
  requires point : x ∈ M.carrier
  shows ContinuousAtPoint(f, metricTopology(M), metricTopology(N), x) ↔
    (∀ e ∈ ℝ, realZero < e → ∃ d ∈ ℝ, realZero < d ∧
      (∀ y ∈ M.carrier, M.dist(y, x) < d → N.dist(f(y), f(x)) < e))
proof
  have topM := MetricSpace.topological_space with metricM
  have pointT : x ∈ TopologicalSpace.carrier(metricTopology(M))
    rw metricTopology.carrier
    exact point
  have filt := (nhds.is_filter with topM, pointT).left
  rw metricTopology.carrier at filt
  have fx := FunctionBetween.apply_closed with values, point
  have iff := Tendsto.metric_iff at f, M.carrier, nhds(metricTopology(M), x), N, f(x) with metricN, filt, values, fx
  unfold ContinuousAtPoint
  rw metricTopology.carrier
  rw iff
  constructor
  . intro small
    intros e he pos
    obtain ⟨A, hA, close⟩ := small with e, he, pos
    have nb := nhds.metric_iff at M, x, A with metricM, point
    obtain ⟨sub, r, hr, rpos, ballA⟩ := nb.forward with hA
    have rReal : Real(r) by typecheck
    refine ⟨r, hr, rpos, ?_⟩
    intros y hy dy
    have comm := dist_comm at M, y, x with metricM
    rw comm at dy
    have mb := mem_ball at M, x, y, r with metricM
    have inBall := mb.backward with dy
    exact close with y, (ballA with y, inBall)
  . intro small
    intros e he pos
    obtain ⟨r, hr, rpos, close⟩ := small with e, he, pos
    have rReal : Real(r) by typecheck
    have ballSub := ball_subset at M, x, r with metricM
    have self : ball(M, x, r) ⊆ ball(M, x, r) by simp
    have nb := nhds.metric_iff at M, x, ball(M, x, r) with metricM, point
    have Bn := nb.backward with ⟨ballSub, r, hr, rpos, self⟩
    refine ⟨ball(M, x, r), Bn, ?_⟩
    intros y hy
    have yC := ballSub with y, hy
    have mb := mem_ball at M, x, y, r with metricM
    have lt := mb.forward with hy
    have comm := dist_comm at M, x, y with metricM
    rw comm at lt
    exact close with y, yC, lt

-- Section: The real line
theorem realLine.nhds_iff (x N : Set)
  requires point : x ∈ ℝ
  shows N ∈ nhds(realLine, x) ↔
    N ⊆ ℝ ∧ (∃ r ∈ ℝ, realZero < r ∧ openBall(x, r) ⊆ N)
proof
  have top := realLine.space
  constructor
  . intro hN
    simp [nhds.membership, powerset.membership_iff] at hN
    obtain ⟨sub, U, hU, xU, UN⟩ := hN
    rw realLine.carrier at sub
    rw realLine.opens at hU
    have hU2 := realTopology.membership.forward with hU
    obtain ⟨E, hE, pos, ballU⟩ := hU2.right with x, xU
    refine ⟨sub, E, hE, pos, (Subset.transitive with ballU, UN)⟩
  . intro hN
    obtain ⟨sub, r, hr, pos, ballN⟩ := hN
    have xReal : Real(x) by typecheck
    have rReal : Real(r) by typecheck
    have openB := openBall.open at x, r
    have xB := openBall.center at x, r with pos
    have subC : N ⊆ TopologicalSpace.carrier(realLine)
      rw realLine.carrier
      exact sub
    have memB : openBall(x, r) ∈ TopologicalSpace.opens(realLine)
      rw realLine.opens
      exact openB
    apply nhds.membership.backward
    refine ⟨(powerset.membership_iff.backward with subC), openBall(x, r), memB, xB, ballN⟩

-- Helpers for the real line: 𝓝[S] x is a filter at a point of the space,
-- limits on ℝ by open balls, and the involution of the real inverse.
theorem nhdsWithin.is_filter_at (X x S : Set)
  requires space : TopologicalSpace(X)
  requires point : x ∈ X.carrier
  shows IsFilter(X.carrier, nhdsWithin(X, x, S))
proof
  have filtN := (nhds.is_filter with space, point).left
  have SC : S ∩ X.carrier ⊆ X.carrier
    intros y hy
    simp at hy
    exact hy.right
  have filtP := principalFilter.is_filter with SC
  unfold nhdsWithin
  exact filterInf.is_filter with filtN, filtP

theorem realLine.tendsto_ball (f X F : Set, L e : Real)
  requires limit : Tendsto(f, X, F, nhds(realLine, L))
  requires positive : 0 < e
  shows ∃ A ∈ F, ∀ x ∈ A, f(x) ∈ openBall(L, e)
proof
  have LIn : L ∈ ℝ by typecheck
  have eIn : e ∈ ℝ by typecheck
  have sub := openBall.subset_reals at L, e
  have self : openBall(L, e) ⊆ openBall(L, e) by simp
  have iff := realLine.nhds_iff at L, openBall(L, e) with LIn
  have Bn := iff.backward with ⟨sub, e, eIn, positive, self⟩
  have pre := limit with openBall(L, e), Bn
  refine ⟨functionPreimage(f, X, openBall(L, e)), pre, ?_⟩
  intros x hx
  have hx2 := functionPreimage.membership.forward with hx
  exact hx2.right

theorem realLine.tendsto_of_balls (f X F : Set, L : Real)
  requires filter : IsFilter(X, F)
  requires balls : ∀ e ∈ ℝ, 0 < e → ∃ A ∈ F, ∀ x ∈ A, f(x) ∈ openBall(L, e)
  shows Tendsto(f, X, F, nhds(realLine, L))
proof
  have LIn : L ∈ ℝ by typecheck
  unfold Tendsto
  intros B hB
  have iff := realLine.nhds_iff at L, B with LIn
  obtain ⟨sub, r, hr, pos, ballB⟩ := iff.forward with hB
  obtain ⟨A, hA, close⟩ := balls with r, hr, pos
  have inX := IsFilter.subset with filter, hA
  have inside : A ⊆ functionPreimage(f, X, B)
    intros x hx
    have xX := inX with x, hx
    exact functionPreimage.of_apply with xX, (ballB with f(x), (close with x, hx))
  have preSub := functionPreimage.subset at f, X, B
  exact IsFilter.mono with filter, hA, inside, preSub

theorem realInvValue.inv_inv_of_ne (A : Real)
  requires nonzero : A ≠ 0
  shows realInvValue(realInvValue(A)) = A
proof
  have inverseNonzero := realInvValue.nonzero with nonzero
  have law := realInvValue.mul_left with nonzero
  have equal := realInvValue.eq_of_mul_right with inverseNonzero, law
  symm at equal
  exact equal

-- Real sequences: Cumulus's ConvergesTo is the limit along natAtTop.
theorem ConvergesTo.iff_tendsto (u L : Set)
  requires sequence : RealSequence(u)
  requires real : L ∈ ℝ
  shows ConvergesTo(u, L) ↔ Tendsto(u, ℕ, natAtTop, nhds(realLine, L))
proof
  have LR : Real(L) by typecheck
  have proper := natAtTop.is_filter
  have filt := proper.left
  constructor
  . intro conv
    unfold ConvergesTo at conv
    obtain ⟨seq, close⟩ := conv
    apply realLine.tendsto_of_balls with filt
    intros e he pos
    obtain ⟨N, hN, tail⟩ := close with e, he, pos
    have NNat := omega.natural with hN
    obtain ⟨T, hT, big⟩ := natAtTop.eventually_ge at N
    have Tsub := IsFilter.subset with filt, hT
    refine ⟨T, hT, ?_⟩
    intros n hn
    exact tail with n, (Tsub with n, hn), (big with n, hn)
  . intro tendsto
    unfold ConvergesTo
    refine ⟨sequence, ?_⟩
    intros E hE pos
    have ER : Real(E) by typecheck
    obtain ⟨A, hA, close⟩ := realLine.tendsto_ball at u, ℕ, natAtTop, L, E with tendsto, pos
    simp [natAtTop.membership, powerset.membership_iff] at hA
    obtain ⟨sub, N, hN, tail⟩ := hA
    refine ⟨N, hN, ?_⟩
    intros n hn le
    exact close with n, (tail with n, hn, le)

-- Real functions: Cumulus's TendsToAt is the limit along 𝓝[≠] A.
theorem TendsToAt.iff_tendsto (f L A : Set)
  requires function : FunctionBetween(f, ℝ, ℝ)
  requires realL : L ∈ ℝ
  requires realA : A ∈ ℝ
  shows TendsToAt(f, L, A) ↔
    Tendsto(f, ℝ, nhdsPunctured(realLine, A), nhds(realLine, L))
proof
  have LR : Real(L) by typecheck
  have AR : Real(A) by typecheck
  have top := realLine.space
  have AC : A ∈ TopologicalSpace.carrier(realLine)
    rw realLine.carrier
    exact realA
  have filtW := nhdsWithin.is_filter_at at realLine, A, TopologicalSpace.carrier(realLine) ∖ {A} with top, AC
  rw realLine.carrier at filtW
  unfold nhdsPunctured
  rw realLine.carrier
  constructor
  . intro limit
    unfold TendsToAt at limit
    obtain ⟨fn, close⟩ := limit
    apply realLine.tendsto_of_balls with filtW
    intros e he pos
    obtain ⟨d, hd, dpos, inner⟩ := close with e, he, pos
    have dR : Real(d) by typecheck
    have openB := openBall.open at A, d
    have openB2 : openBall(A, d) ∈ TopologicalSpace.opens(realLine)
      rw realLine.opens
      exact openB
    have AB := openBall.center at A, d with dpos
    have sub : openBall(A, d) ∩ (ℝ ∖ {A}) ⊆ ℝ
      intros y hy
      simp at hy
      exact hy.right.left
    have self : openBall(A, d) ∩ (ℝ ∖ {A}) ⊆ openBall(A, d) ∩ (ℝ ∖ {A}) by simp
    have iff := nhdsWithin.mem_iff at realLine, A, ℝ ∖ {A}, openBall(A, d) ∩ (ℝ ∖ {A}) with top
    rw realLine.carrier at iff
    have mem := iff.backward with ⟨sub, openBall(A, d), openB2, AB, self⟩
    refine ⟨openBall(A, d) ∩ (ℝ ∖ {A}), mem, ?_⟩
    intros x hx
    have hx2 := intersection.membership.forward with hx
    have hx3 := difference.membership.forward with hx2.right
    have ne : x ≠ A
      intro eq
      apply hx3.right
      rw eq
      simp
    exact inner with x, hx3.left, ne, hx2.left
  . intro tendsto
    unfold TendsToAt
    refine ⟨function, ?_⟩
    intros e he pos
    have eR : Real(e) by typecheck
    obtain ⟨M, hM, close⟩ := realLine.tendsto_ball at f, ℝ, nhdsWithin(realLine, A, ℝ ∖ {A}), L, e with tendsto, pos
    have iff := nhdsWithin.mem_iff at realLine, A, ℝ ∖ {A}, M with top
    rw realLine.carrier at iff
    obtain ⟨sub, U, hU, AU, UM⟩ := iff.forward with hM
    rw realLine.opens at hU
    have hU2 := realTopology.membership.forward with hU
    obtain ⟨d, hd, dpos, ballU⟩ := hU2.right with A, AU
    refine ⟨d, hd, dpos, ?_⟩
    intros x hx ne inBall
    have xU := ballU with x, inBall
    have notA : x ∉ {A}
      intro xA
      simp at xA
    have xD := difference.membership.backward with hx, notA
    have xM := UM with x, (intersection.membership.backward with xU, xD)
    exact close with x, xM

-- Order and limits on ℝ: a limit of terms eventually ≤ B is ≤ B, and
-- limits preserve ≤.
theorem realLine.le_of_tendsto (f X F : Set, L B : Real)
  requires proper : ProperFilter(X, F)
  requires limit : Tendsto(f, X, F, nhds(realLine, L))
  requires eventually : ∃ A ∈ F, ∀ x ∈ A, f(x) ≤ B
  shows L ≤ B
proof
  have filter := proper.left
  by_contra notLe
  have lt : (B:R) < (L:R) by linarith
  have pos : (0:R) < (L:R) - (B:R) by linarith
  obtain ⟨A1, hA1, close⟩ := realLine.tendsto_ball at f, X, F, L, (L:R) - (B:R) with limit, pos
  obtain ⟨A2, hA2, bound⟩ := eventually
  have both := IsFilter.inter with filter, hA1, hA2
  obtain ⟨x, hx⟩ := ProperFilter.nonempty with proper, both
  have hx2 := intersection.membership.forward with hx
  have inBall := close with x, hx2.left
  have le := bound with x, hx2.right
  have fxIn := (openBall.membership.forward with inBall).left
  have fxR : Real(f(x)) by typecheck
  have bounds := (openBall.order_characterization at f(x), L, (L:R) - (B:R)).forward with inBall
  have lower := bounds.left
  linarith

theorem realLine.le_of_tendsto_tendsto (f g X F : Set, L K : Real)
  requires proper : ProperFilter(X, F)
  requires limitF : Tendsto(f, X, F, nhds(realLine, L))
  requires limitG : Tendsto(g, X, F, nhds(realLine, K))
  requires eventually : ∃ A ∈ F, ∀ x ∈ A, f(x) ≤ g(x)
  shows L ≤ K
proof
  have filter := proper.left
  by_contra notLe
  have lt : (K:R) < (L:R) by linarith
  have pos : (0:R) < (L:R) - (K:R) by linarith
  have hpos := half.positive with pos
  have hsum := half.add_self at (L:R) - (K:R)
  obtain ⟨A1, hA1, closeF⟩ := realLine.tendsto_ball at f, X, F, L, half((L:R) - (K:R)) with limitF, hpos
  obtain ⟨A2, hA2, closeG⟩ := realLine.tendsto_ball at g, X, F, K, half((L:R) - (K:R)) with limitG, hpos
  obtain ⟨A3, hA3, bound⟩ := eventually
  have both := IsFilter.inter with filter, hA1, hA2
  have all := IsFilter.inter with filter, both, hA3
  obtain ⟨x, hx⟩ := ProperFilter.nonempty with proper, all
  have hx2 := intersection.membership.forward with hx
  have hx3 := intersection.membership.forward with hx2.left
  have inF := closeF with x, hx3.left
  have inG := closeG with x, hx3.right
  have le := bound with x, hx2.right
  have fxIn := (openBall.membership.forward with inF).left
  have gxIn := (openBall.membership.forward with inG).left
  have fxR : Real(f(x)) by typecheck
  have gxR : Real(g(x)) by typecheck
  have hR := half.real at (L:R) - (K:R)
  have bF := (openBall.order_characterization at f(x), L, half((L:R) - (K:R))).forward with inF
  have bG := (openBall.order_characterization at g(x), K, half((L:R) - (K:R))).forward with inG
  have lowF := bF.left
  have highG := bG.right
  linarith

-- The squeeze: g ≤ f ≤ h eventually, with g and h tending to L.
theorem realLine.squeeze (f g h X F L : Set)
  requires filter : IsFilter(X, F)
  requires realL : L ∈ ℝ
  requires values : f : X → ℝ
  requires limitG : Tendsto(g, X, F, nhds(realLine, L))
  requires limitH : Tendsto(h, X, F, nhds(realLine, L))
  requires lower : ∃ A ∈ F, ∀ x ∈ A, g(x) ≤ f(x)
  requires upper : ∃ A ∈ F, ∀ x ∈ A, f(x) ≤ h(x)
  shows Tendsto(f, X, F, nhds(realLine, L))
proof
  have LR : Real(L) by typecheck
  apply realLine.tendsto_of_balls with filter
  intros e he pos
  have eR : Real(e) by typecheck
  obtain ⟨A1, hA1, closeG⟩ := realLine.tendsto_ball at g, X, F, L, e with limitG, pos
  obtain ⟨A2, hA2, closeH⟩ := realLine.tendsto_ball at h, X, F, L, e with limitH, pos
  obtain ⟨A3, hA3, low⟩ := lower
  obtain ⟨A4, hA4, up⟩ := upper
  have b12 := IsFilter.inter with filter, hA1, hA2
  have b34 := IsFilter.inter with filter, hA3, hA4
  have all := IsFilter.inter with filter, b12, b34
  refine ⟨(A1 ∩ A2) ∩ (A3 ∩ A4), all, ?_⟩
  intros x hx
  have hx2 := intersection.membership.forward with hx
  have h12 := intersection.membership.forward with hx2.left
  have h34 := intersection.membership.forward with hx2.right
  have inX := IsFilter.subset with filter, hA1
  have xX := inX with x, h12.left
  have fxIn := FunctionBetween.apply_closed with values, xX
  have inG := closeG with x, h12.left
  have inH := closeH with x, h12.right
  have gxIn := (openBall.membership.forward with inG).left
  have hxIn := (openBall.membership.forward with inH).left
  have fxR : Real(f(x)) by typecheck
  have gxR : Real(g(x)) by typecheck
  have hxR : Real(h(x)) by typecheck
  have gf := low with x, h34.left
  have fh := up with x, h34.right
  have bG := (openBall.order_characterization at g(x), L, e).forward with inG
  have bH := (openBall.order_characterization at h(x), L, e).forward with inH
  have lowG := bG.left
  have highH := bH.right
  have iff := openBall.order_characterization at f(x), L, e
  apply iff.backward
  constructor
  . linarith
  . linarith

-- A limit L > B forces the terms eventually above B.
theorem realLine.eventually_gt (f X F : Set, L B : Real)
  requires limit : Tendsto(f, X, F, nhds(realLine, L))
  requires greater : B < L
  shows ∃ A ∈ F, ∀ x ∈ A, B < f(x)
proof
  have pos : (0:R) < (L:R) - (B:R) by linarith
  obtain ⟨A, hA, close⟩ := realLine.tendsto_ball at f, X, F, L, (L:R) - (B:R) with limit, pos
  refine ⟨A, hA, ?_⟩
  intros x hx
  have inBall := close with x, hx
  have fxIn := (openBall.membership.forward with inBall).left
  have fxR : Real(f(x)) by typecheck
  have bounds := (openBall.order_characterization at f(x), L, (L:R) - (B:R)).forward with inBall
  have lower := bounds.left
  linarith

-- 1/(n + 1) → 0.
theorem realLine.inverse_tendsto_zero (u : Set)
  requires values : ∀ n ∈ ℕ, u(n) = R[1 / (realNat(n) + 1)]
  shows Tendsto(u, ℕ, natAtTop, nhds(realLine, realZero))
proof
  sorry

end Filters
