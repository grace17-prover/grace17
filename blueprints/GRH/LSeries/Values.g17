-- Special values of ζ and the Fourier series of the Bernoulli polynomials:
-- ζ(2) = π²/6, ζ(4) = π⁴/90 and ζ(2k) = (−1)^(k+1) 2^(2k−1) π^(2k) B_{2k}/(2k)!
-- for layer 1's ζ and Bernoulli numbers; ζ(−k) = (−1)^k B_{k+1}/(k + 1) and
-- ζ(0) = −1/2; Σ_{n≥1} cos(2πnx)/n^(2k) and Σ_{n≥1} sin(2πnx)/n^(2k+1)
-- through Bₙ(x) on [0, 1]; the constant term of ζ at 1 is Euler's γ, the
-- limit of Hₙ − log n; and the bounds 1 ≤ ζ(σ) ≤ σ/(σ − 1),
-- |ζ(σ + it)| ≤ ζ(σ) for σ > 1. This module closes the L-series bridge:
-- it imports every module of track D.
-- Part of the GRH blueprint (layer 2, track D: the L-series bridge).
-- Source: Mathlib's NumberTheory/ZetaValues,
-- NumberTheory/LSeries/{HurwitzZetaValues, RiemannZeta},
-- NumberTheory/Harmonic/{EulerMascheroni, ZetaAsymp}.
-- Planned home: NumberTheory/Zeta/Values.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.LSeries.Values
import GRH.LSeries.Completed
import GRH.LSeries.VonMangoldt
import GRH.SpecialFunctions.More

section Values
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Section: Definitions
-- The terms cos(2πnx)/n^(2k) and sin(2πnx)/n^(2k+1), n = 1, 2, …,
-- indexed from 0 as n + 1 (Mathlib's hasSum_one_div_nat_pow_mul_cos and
-- hasSum_one_div_nat_pow_mul_sin).
defgraph bernoulliCosTerms (k : Nat, X : Real) (n ∈ ℕ) : ℝ :=
  R[realCos(2 * realPi * realNat(n + 1) * X) / realNat(n + 1) ^ (2 * k)]
proof
  have nNat := nat.omega.backward with member
  typecheck

defgraph bernoulliSinTerms (k : Nat, X : Real) (n ∈ ℕ) : ℝ :=
  R[realSin(2 * realPi * realNat(n + 1) * X) / realNat(n + 1) ^ (2 * k + 1)]
proof
  have nNat := nat.omega.backward with member
  typecheck

-- The terms (e^(2πinx) + (−1)^k e^(−2πinx))/n^k, n = 1, 2, …: the sum over
-- n ∈ ℤ ∖ {0} of e^(2πinx)/n^k, folded onto n ≥ 1 (Mathlib's
-- hasSum_one_div_nat_pow_mul_fourier).
defgraph bernoulliFourierTerms (k : Nat, X : Real) (n ∈ ℕ) :
    complexCarrier :=
  ℂ[(expTwoPiI(R[realNat(n + 1) * X]) +
      complexOfReal(R[(-1) ^ k]) * expTwoPiI(R[-(realNat(n + 1) * X)])) *
    complexOfReal(realInvValue(R[realNat(n + 1) ^ k]))]
proof
  have nNat := nat.omega.backward with member
  have forward := expTwoPiI.member at R[realNat(n + 1) * X]
  have backward := expTwoPiI.member at R[-(realNat(n + 1) * X)]
  have inverse := realInvValue.real at R[realNat(n + 1) ^ k]
  have minusOne : R[-1] ∈ ℝ by typecheck
  have minusOneReal : Real(R[-1]) by typecheck
  have monoid := realMul.monoid
  have sign := monoidPow.closed at ℝ, realMul, realOne, R[-1], k with monoid,
    minusOne
  typecheck

-- Hₙ − log n.
defgraph harmonicLogDifference (n ∈ ℕ) : ℝ :=
  R[harmonicNumber(n) - realLog(realNat(n))]
proof
  have nNat := nat.omega.backward with member
  typecheck

-- Section: Even values
-- ζ(2) = π²/6 (Mathlib's riemannZeta_two, from hasSum_zeta_two).
theorem riemannZeta.two
  shows riemannZeta(ℂ[2]) = complexOfReal(R[realPi * realPi / 6])
proof
  sorry

-- ζ(4) = π⁴/90 (Mathlib's riemannZeta_four).
theorem riemannZeta.four
  shows riemannZeta(ℂ[4]) = complexOfReal(R[realPi ^ 4 / 90])
proof
  sorry

-- ζ(2k) = (−1)^(k+1) 2^(2k−1) π^(2k) B_{2k}/(2k)! for k ≥ 1, written at
-- k + 1 (Mathlib's riemannZeta_two_mul_nat).
theorem riemannZeta.two_mul_nat (k : Nat)
  shows riemannZeta(complexOfReal(realNat(2 * (k + 1)))) =
    complexOfReal(R[(-1) ^ k * 2 ^ (2 * k + 1) * realPi ^ (2 * k + 2) *
      bernoulli(2 * k + 2) / realNat((2 * k + 2)!)])
proof
  sorry

-- The value at 2 is the sum Σ 1/n² of GRH.SpecialFunctions.More (Mathlib's
-- hasSum_zeta_two, read through zeta.series).
theorem riemannZeta.two_eq_sum
  shows ComplexSumsTo(zetaSeriesTerms(ℂ[2]),
    complexOfReal(R[realPi * realPi / 6]))
proof
  sorry

-- ζ(σ) is real for real σ ≠ 1.
theorem riemannZeta.real (S : Real)
  requires notOne : S ≠ R[1]
  shows ∃ Y ∈ ℝ, riemannZeta(complexOfReal(S)) = complexOfReal(Y)
proof
  sorry

-- 1 ≤ ζ(σ) ≤ σ/(σ − 1) for σ > 1, by comparison with ∫ t^(−σ).
theorem riemannZeta.real_bounds (S : Real)
  requires halfPlane : R[1] < S
  shows realOne ≤ complexRe(riemannZeta(complexOfReal(S))) ∧
    complexRe(riemannZeta(complexOfReal(S))) ≤ R[S / (S - 1)]
proof
  sorry

-- A series dominated termwise by a convergent nonnegative real series has
-- sum of modulus at most the real sum.
theorem cldDComplexSumsTo.abs_le (u v S : Set) (A : Real)
  requires sums : ComplexSumsTo(u, S)
  requires realSums : SumsTo(v, A)
  requires nonnegative : NonnegativeTerms(v)
  requires bound : ∀ k ∈ ℕ, complexAbs(u(k)) ≤ v(k)
  shows complexAbs(S) ≤ A
proof
  have sMember := ComplexSumsTo.member with sums
  have sumsCopy := sums
  obtain ⟨sequence, converges⟩ := sumsCopy
  have vSequence := SumsTo.sequence with realSums
  have zero := complexZero.member
  have partialBound : ∀ n ∈ ℕ, (0:N) ≤ n →
      complexAbs(ℂ[complexPrefixSums(u)(n) - 0]) ≤ A
    intros n nIn atLeast
    have nNat := nat.omega.backward with nIn
    have prefixValue := complexPrefixSums.value with sequence, nIn
    have partialMember := complexPartialSum.closed at u, n with sequence
    have same : ℂ[complexPartialSum(u, n) - 0] = complexPartialSum(u, n) by
      ring
    rw [prefixValue, same]
    have termwise : ∀ k ∈ ℕ, k < n → complexAbs(u(k)) ≤ v(k)
      intros k kIn below
      exact bound with k, kIn
    have first := complexPartialSum.abs_le at u, v, n with sequence, vSequence
    have firstBound := first with termwise
    have second := SumsTo.partial_le at v, A, n with realSums, nonnegative
    have partialReal := realPartialSum.real at v, n with vSequence
    have absReal := complexAbs.real with partialMember
    linarith
  have result := ComplexConvergesTo.abs_le at complexPrefixSums(u), S, ℂ[0],
    A, (0:N) with converges, zero, partialBound
  have same : ℂ[S - 0] = S by ring
  rwa same at result

-- |ζ(s)| ≤ ζ(re s) for re s > 1.
theorem riemannZeta.abs_le_re (s : Set)
  requires hs : s ∈ ℂ
  requires halfPlane : realOne < complexRe(s)
  shows complexAbs(riemannZeta(s)) ≤
    complexRe(riemannZeta(complexOfReal(complexRe(s))))
proof
  have reS : Real(complexRe(s)) by typecheck
  have hT : complexOfReal(complexRe(s)) ∈ ℂ by typecheck
  have halfT : realOne < complexRe(complexOfReal(complexRe(s)))
    rw complexOfReal.re
    exact halfPlane
  obtain ⟨sumsS, _⟩ := zeta.series with hs, halfPlane
  obtain ⟨sumsT, _⟩ := zeta.series with hT, halfT
  have reSums := ComplexSumsTo.re with sumsT
  have termsT := zetaSeriesTerms.function with hT
  have sequenceT : ComplexSequence(zetaSeriesTerms(complexOfReal(complexRe(s))))
    by exact termsT
  have xValue : ∀ k ∈ ℕ,
      complexSequenceX(zetaSeriesTerms(complexOfReal(complexRe(s))))(k) =
        realRpow(realNat(k + 1), R[-complexRe(s)])
    intros k kIn
    have kNat := nat.omega.backward with kIn
    have term := FunctionBetween.apply_closed with termsT, kIn
    rw [(complexSequenceX.value with sequenceT, kIn), (complexRe.x with term),
      (zetaSeriesTerms.value with hT, kIn), ← complexOfReal.neg,
      realCpow.of_real, complexOfReal.re]
  have nonnegative : NonnegativeTerms(complexSequenceX(zetaSeriesTerms(
      complexOfReal(complexRe(s)))))
    intros k kIn
    have kNat := nat.omega.backward with kIn
    have positive := realRpow.positive at realNat(k + 1), R[-complexRe(s)]
    have le := realLess.implies_le with positive
    rw ← (xValue with k, kIn) at le
    have bridge := realLe.characterization at realZero,
      complexSequenceX(zetaSeriesTerms(complexOfReal(complexRe(s))))(k)
    exact bridge.forward with le
  have bound : ∀ k ∈ ℕ, complexAbs(zetaSeriesTerms(s)(k)) ≤
      complexSequenceX(zetaSeriesTerms(complexOfReal(complexRe(s))))(k)
    intros k kIn
    have kNat := nat.omega.backward with kIn
    have positive : 1 ≤ k + 1 by arith
    rw [(zetaSeriesTerms.value with hs, kIn),
      (realCpow.nat_neg_abs with positive, hs), (xValue with k, kIn)]
    have real := realRpow.real at realNat(k + 1), R[-complexRe(s)]
    linarith
  exact cldDComplexSumsTo.abs_le with sumsS, reSums, nonnegative, bound

-- Section: Values at the nonpositive integers
-- ζ(−k) = (−1)^k B_{k+1}/(k + 1), with B₁ = −1/2 (Mathlib's
-- riemannZeta_neg_nat_eq_bernoulli; layer 1's zeta.neg_nat reads B_{k+1}(1)).
theorem riemannZeta.neg_nat_eq_bernoulli (k : Nat)
  shows riemannZeta(ℂ[-complexOfReal(realNat(k))]) =
    complexOfReal(R[(-1) ^ k * bernoulli(k + 1) / realNat(k + 1)])
proof
  sorry

-- ζ(0) = −1/2 (Mathlib's riemannZeta_zero; layer 1's zeta.zero_value).
theorem riemannZeta.zero
  shows riemannZeta(ℂ[0]) = complexOfReal(R[-(1 / 2)])
proof
  exact zeta.zero_value

-- ζ(1 − 2k) = −B_{2k}/(2k) for k ≥ 1, written at k + 1.
theorem riemannZeta.one_sub_two_mul_nat (k : Nat)
  shows riemannZeta(ℂ[1 - complexOfReal(realNat(2 * (k + 1)))]) =
    complexOfReal(R[-(bernoulli(2 * k + 2) / realNat(2 * k + 2))])
proof
  sorry

-- Section: Fourier series of the Bernoulli polynomials
-- For k ≥ 2 and 0 ≤ x ≤ 1:
-- Σ_{n ∈ ℤ ∖ {0}} e^(2πinx)/n^k = −(2πi)^k Bₖ(x)/k!
-- (Mathlib's hasSum_one_div_nat_pow_mul_fourier, with Mathlib's
-- bernoulliFun k x = layer 1's bernoulliFunction(k)(x)).
theorem bernoulliFunction.fourier (k : Nat) (X : Real)
  requires two : 2 ≤ k
  requires lower : R[0] ≤ X
  requires upper : X ≤ R[1]
  shows ComplexSumsTo(bernoulliFourierTerms(k, X),
    ℂ[-((2 * complexOfReal(realPi) * complexImaginaryUnit) ^ k *
      complexOfReal(R[bernoulliFunction(k)(X) / realNat(k!)]))])
proof
  sorry

-- Σ_{n≥1} cos(2πnx)/n^(2k) = (−1)^(k+1) (2π)^(2k)/(2 (2k)!) B_{2k}(x),
-- k ≥ 1, 0 ≤ x ≤ 1 (Mathlib's hasSum_one_div_nat_pow_mul_cos).
theorem bernoulliFunction.cos_series (k : Nat) (X : Real)
  requires positive : 1 ≤ k
  requires lower : R[0] ≤ X
  requires upper : X ≤ R[1]
  shows SumsTo(bernoulliCosTerms(k, X),
    R[(-1) ^ (k + 1) * (2 * realPi) ^ (2 * k) /
      (2 * realNat((2 * k)!)) * bernoulliFunction(2 * k)(X)])
proof
  sorry

-- Σ_{n≥1} sin(2πnx)/n^(2k+1) = (−1)^(k+1) (2π)^(2k+1)/(2 (2k+1)!)
-- B_{2k+1}(x), k ≥ 1, 0 ≤ x ≤ 1 (Mathlib's hasSum_one_div_nat_pow_mul_sin).
theorem bernoulliFunction.sin_series (k : Nat) (X : Real)
  requires positive : 1 ≤ k
  requires lower : R[0] ≤ X
  requires upper : X ≤ R[1]
  shows SumsTo(bernoulliSinTerms(k, X),
    R[(-1) ^ (k + 1) * (2 * realPi) ^ (2 * k + 1) /
      (2 * realNat((2 * k + 1)!)) * bernoulliFunction(2 * k + 1)(X)])
proof
  sorry

-- |Bₖ(x)| ≤ 2 ζ(k) k!/(2π)^k on [0, 1], k ≥ 2, from the Fourier series
-- (the bound of the source's StickelbergerInteger through hasSum_zeta_two).
theorem bernoulliFunction.abs_le_zeta (k : Nat) (X : Real)
  requires two : 2 ≤ k
  requires lower : R[0] ≤ X
  requires upper : X ≤ R[1]
  shows abs(bernoulliFunction(k)(X)) ≤
    R[2 * complexRe(riemannZeta(complexOfReal(realNat(k)))) *
      realNat(k!) / (2 * realPi) ^ k]
proof
  sorry

-- Section: Euler's constant
-- Hₙ − log n converges to the constant term of ζ at 1, which is real:
-- layer 1's ζ(1) is Euler's γ (Mathlib's riemannZeta₀_one and
-- Real.tendsto_harmonic_sub_log).
theorem riemannZetaRegular.one_euler_mascheroni
  shows ConvergesTo(harmonicLogDifference,
      complexRe(riemannZetaRegular(ℂ[1]))) ∧
    complexIm(riemannZetaRegular(ℂ[1])) = R[0]
proof
  sorry

-- 1/2 < γ < 2/3 (Mathlib's Real.one_half_lt_eulerMascheroniConstant and
-- eulerMascheroniConstant_lt_two_thirds).
theorem riemannZetaRegular.one_bounds
  shows R[1 / 2] < complexRe(riemannZetaRegular(ℂ[1])) ∧
    complexRe(riemannZetaRegular(ℂ[1])) < R[2 / 3]
proof
  sorry

end Values
