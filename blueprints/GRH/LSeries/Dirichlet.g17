-- Dirichlet series Σ_{n≥1} f(n) n^(−s) of a coefficient function
-- f : ℕ → ℂ, as Mathlib's LSeries: the terms, absolute summability and
-- the sum (0 off the summable s), the abscissa of absolute convergence as
-- a predicate, comparison and linearity, Dirichlet convolution,
-- differentiation term by term, summation by parts
-- (`LSeries_eq_mul_integral`), Euler products for completely
-- multiplicative coefficients; and the bridge to layer 1: for re s > 1
-- the series of a Dirichlet character χ modulo N sums to layer 1's
-- L(s, χ), the series of 1 to layer 1's ζ(s), with their derivatives and
-- Euler products.
-- Part of the GRH blueprint (layer 2, track D: the L-series bridge).
-- Source: Mathlib's NumberTheory/LSeries/{Basic, Convergence, Deriv,
-- Linearity, Convolution, SumCoeff, Dirichlet, DirichletContinuation} and
-- NumberTheory/EulerProduct/DirichletLSeries.
-- Planned home: NumberTheory/LSeries/Basic.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.LSeries.Dirichlet
import GRH.LFunction
import GRH.Measure.Bochner
import GRH.FunctionalEquation

section LSeries
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Section: Definitions
-- Coefficients are functions f : ℕ → ℂ; as in Mathlib the value f(0) is
-- never read by a series. The terms f(n) n^(−s), n = 1, 2, …, indexed
-- from 0 as f(n + 1) (n + 1)^(−s), in the indexing of layer 1's
-- zetaSeriesTerms and dirichletSeriesTerms (Mathlib's LSeries.term, which
-- puts 0 at n = 0).
defgraph lseriesTerms (f s : Set) (n ∈ ℕ) : complexCarrier :=
  ℂ[f(n + 1) * realCpow(realNat(n + 1), ℂ[-s])]
requires values : FunctionBetween(f, ℕ, complexCarrier)
requires hs : s ∈ complexCarrier
proof
  have nNat := nat.omega.backward with member
  have index : n + 1 ∈ ℕ by typecheck
  have value := FunctionBetween.apply_closed with values, index
  have negative : ℂ[-s] ∈ ℂ by typecheck
  have power := realCpow.member at realNat(n + 1), ℂ[-s] with negative
  typecheck

-- The series converges absolutely at s (Mathlib's LSeriesSummable:
-- summability in ℂ, which is absolute summability).
predicate LSeriesSummable (f s : Set) :=
  ComplexAbsolutelySummable(lseriesTerms(f, s))

-- The series converges absolutely at s with sum a (Mathlib's
-- LSeriesHasSum).
predicate LSeriesHasSum (f s a : Set) :=
  LSeriesSummable(f, s) ∧ ComplexSumsTo(lseriesTerms(f, s), a)

-- The sum Σ_{n≥1} f(n) n^(−s) where the series converges absolutely, and 0
-- elsewhere (Mathlib's LSeries, a tsum, with its junk value 0).
def LSeries (f s : Set) : Set :=
  ⋃({ a ∈ complexCarrier |
    (LSeriesSummable(f, s) ∧ ComplexSumsTo(lseriesTerms(f, s), a)) ∨
    (¬LSeriesSummable(f, s) ∧ a = complexZero) })

-- The sum where the series converges absolutely, 0 elsewhere.
theorem LSeries.of_summable (f s : Set)
  requires summable : LSeriesSummable(f, s)
  shows ComplexSumsTo(lseriesTerms(f, s), LSeries(f, s))
proof
  have absolute := summable
  unfold LSeriesSummable at absolute
  have summ := ComplexAbsolutelySummable.summable with absolute
  obtain ⟨a, aIn, sums⟩ := summ
  have value : LSeries(f, s) = a
    unfold LSeries
    apply union.of_unique
    . simp
    . intros y hy
      obtain ⟨_, alternatives⟩ := hy
      rcases alternatives with ⟨_, ySums⟩ | ⟨notSummable, _⟩
      . exact ComplexSumsTo.unique with ySums, sums
      . exfalso
        exact notSummable with summable
  rw value
  exact sums

theorem LSeries.of_not_summable_value (f s : Set)
  requires notSummable : ¬LSeriesSummable(f, s)
  shows LSeries(f, s) = ℂ[0]
proof
  unfold LSeries
  apply union.of_unique
  . have zero := complexZero.member
    refine ⟨zero, ?_⟩
    right
    exact ⟨notSummable, rfl⟩
  . intros y hy
    obtain ⟨_, alternatives⟩ := hy
    rcases alternatives with ⟨summable, _⟩ | ⟨_, yZero⟩
    . exfalso
      exact notSummable with summable
    . exact yZero

theorem LSeries.value_member (f s : Set)
  shows LSeries(f, s) ∈ ℂ
proof
  by_cases summable : LSeriesSummable(f, s)
  . have sums := LSeries.of_summable with summable
    exact ComplexSumsTo.member with sums
  . rw (LSeries.of_not_summable_value with summable)
    exact complexZero.member

-- s ↦ LSeries(f, s) as a function on ℂ.
defgraph LSeriesMap (f : Set) (s ∈ complexCarrier) : complexCarrier :=
    LSeries(f, s)
requires values : FunctionBetween(f, ℕ, complexCarrier)
proof
  exact LSeries.value_member at f, s

-- The abscissa of absolute convergence, as Mathlib's
-- abscissaOfAbsConv f ≤ x (an extended real in Mathlib): the series
-- converges absolutely at every real y > x.
predicate AbscissaAtMost (f : Set, X : Real) :=
  ∀ Y ∈ ℝ, X < Y → LSeriesSummable(f, complexOfReal(Y))

-- abscissaOfAbsConv f < re s: the series converges absolutely at some real
-- y < re s.
predicate AbscissaBelow (f s : Set) :=
  ∃ Y ∈ ℝ, Y < complexRe(s) ∧ LSeriesSummable(f, complexOfReal(Y))

-- The coefficients n ↦ χ(n) of a function χ on ℤ, a Dirichlet character
-- (Mathlib's ↗χ, n ↦ χ (n : ZMod N)).
def characterCoefficients (χ : Set) : Set :=
  { (n, χ(integerOfNat(n))) | n ∈ ℕ }

-- The constant coefficients 1 (Mathlib's 1 : ℕ → ℂ), whose series is ζ.
def oneCoefficients : Set := ℕ × {complexOne}

-- The coefficients of a real sequence a, n ↦ a(n) in ℂ.
def realCoefficients (a : Set) : Set :=
  { (n, complexOfReal(a(n))) | n ∈ ℕ }

-- Pointwise operations on coefficients: f + g, f − g, c f, f g, and
-- n ↦ log(n) f(n) (Mathlib's LSeries.logMul; log 0 = 0 is never read).
def coefficientAdd (f g : Set) : Set := { (n, ℂ[f(n) + g(n)]) | n ∈ ℕ }
def coefficientSub (f g : Set) : Set := { (n, ℂ[f(n) - g(n)]) | n ∈ ℕ }
def coefficientScale (c f : Set) : Set := { (n, ℂ[c * f(n)]) | n ∈ ℕ }
def coefficientMul (f g : Set) : Set := { (n, ℂ[f(n) * g(n)]) | n ∈ ℕ }
def logMulCoefficients (f : Set) : Set :=
  { (n, ℂ[complexOfReal(realLog(realNat(n))) * f(n)]) | n ∈ ℕ }

-- The sum Σ_{i ∈ I} F(i) of a finite family of coefficient functions,
-- pointwise (Mathlib's ∑ i ∈ S, f i for functions ℕ → ℂ).
def familyValues (F n I : Set) : Set := { (i, F(i)(n)) | i ∈ I }
def coefficientFamilySum (F I : Set) : Set :=
  { (n, finiteRingSum(I, complexCarrier, complexAdd, complexZero,
      complexNeg, complexMul, complexOne, familyValues(F, n, I))) | n ∈ ℕ }

-- The finite family of the complex numbers a(i), i ∈ I, summed.
def complexFamilySum (a I : Set) : Set :=
  finiteRingSum(I, complexCarrier, complexAdd, complexZero, complexNeg,
    complexMul, complexOne, a)

-- A finite sum reads its weights only on the summed set: weights given on
-- a larger set D sum as their restriction.
theorem finiteRingSum.restrict_weights (V D A add zero neg mul one w : Set)
  requires subset : V ⊆ D
  requires weights : w : D → A
  shows finiteRingSum(V, A, add, zero, neg, mul, one, w) =
    finiteRingSum(V, A, add, zero, neg, mul, one, restrict(w, V))
proof
  have key : ∀ k, Nat(k) → ∀ e, BijectiveBetween(e, k, V) →
      indexedRingSum(w, e, add, zero, k) =
        indexedRingSum(restrict(w, V), e, add, zero, k)
    intros k kNat e bijective
    obtain ⟨injective, _⟩ := bijective
    have eFunction := Injective.function with injective
    apply indexedRingSum.congr at w, restrict(w, V), e, e, add, zero, k
    intros i hi
    have image := FunctionBetween.apply_closed with eFunction, hi
    have restricted := restrict.domain_apply with weights, subset, image
    rw restricted
  have same : finiteRingSum.candidates(V, A, add, zero, neg, mul, one, w) =
      finiteRingSum.candidates(V, A, add, zero, neg, mul, one, restrict(w, V))
    ext x
    constructor
    . intro hx
      obtain ⟨xA, k, kNat, e, bijective, value⟩ := hx
      refine ⟨xA, k, kNat, e, bijective, ?_⟩
      rw value
      exact key with k, kNat, e, bijective
    . intro hx
      obtain ⟨xA, k, kNat, e, bijective, value⟩ := hx
      refine ⟨xA, k, kNat, e, bijective, ?_⟩
      rw value
      have back := key with k, kNat, e, bijective
      rw back
  unfold finiteRingSum
  rw same

-- Dirichlet convolution (f ⋆ g)(n) = Σ_{d ∣ n} f(d) g(n/d) (Mathlib's
-- LSeries.convolution, ArithmeticFunction multiplication).
defgraph convolutionTerms (f g : Set, n : Nat) (d ∈ ℕ) : complexCarrier :=
  ℂ[f(d) * g(quotientNat(n, d))]
requires fValues : FunctionBetween(f, ℕ, complexCarrier)
requires gValues : FunctionBetween(g, ℕ, complexCarrier)
proof
  have nNat := nat.omega.backward with member
  have first := FunctionBetween.apply_closed with fValues, member
  have quotient := quotientNat.natural at d, n
  have quotientMember : quotientNat(n, d) ∈ ℕ by typecheck
  have second := FunctionBetween.apply_closed with gValues, quotientMember
  typecheck

-- The divisors of n as Nat.divisors gives them: none for n = 0, whose
-- set of divisors in the sense of ∣ is all of ℕ.
def dirichletDivisors (n : Set) : Set := { d ∈ divisorSet(n) | ¬(n = ∅) }

-- The divisors of n in this sense are finitely many naturals.
theorem cldDdivisors.naturals (n : Set)
  shows dirichletDivisors(n) ⊆ ℕ
proof
  intros d hd
  obtain ⟨inner, _⟩ := dirichletDivisors.membership.forward with hd
  obtain ⟨dMember, _⟩ := divisorSet.membership.forward with inner
  exact dMember

theorem cldDdivisors.finite (n : Nat)
  shows Finite(dirichletDivisors(n))
proof
  have bounded := Finite.natural at n + 1
  have included : dirichletDivisors(n) ⊆ n + 1
    intros d hd
    obtain ⟨inner, nonempty⟩ := dirichletDivisors.membership.forward with hd
    obtain ⟨dMember, divides⟩ := divisorSet.membership.forward with inner
    have dNat := nat.omega.backward with dMember
    have nonzero : n ≠ (0:N)
      intro zero
      rw nat.zero at zero
      exact nonempty with zero
    have below := divides.le with divides, nonzero
    have bound : d < n + 1 by arith
    exact membership.of_Less at d, n + 1 with *, bound
  exact Finite.subset with bounded, included

defgraph dirichletConvolution (f g : Set) (n ∈ ℕ) : complexCarrier :=
  complexFamilySum(convolutionTerms(f, g, n), dirichletDivisors(n))
requires fValues : FunctionBetween(f, ℕ, complexCarrier)
requires gValues : FunctionBetween(g, ℕ, complexCarrier)
proof
  have nNat := nat.omega.backward with member
  have ring := complexes.comm_ring
  have finite := cldDdivisors.finite at n
  have subset := cldDdivisors.naturals at n
  have terms := convolutionTerms.function at f, g, n with fValues, gValues
  have closed : ∀ x ∈ dirichletDivisors(n),
      convolutionTerms(f, g, n)(x) ∈ complexCarrier
    intros x hx
    have xIn := subset with x, hx
    exact FunctionBetween.apply_closed with terms, xIn
  have restricted := restrict.function with terms, subset, closed
  unfold complexFamilySum
  rw (finiteRingSum.restrict_weights with subset, terms)
  exact finiteRingSum.closed with ring, finite, restricted

-- A finite family sum scales: Σ a w(x) = a Σ w(x).
theorem cldDsum.scale (V w v a : Set)
  requires finite : Finite(V)
  requires weightsW : w : V → complexCarrier
  requires weightsV : v : V → complexCarrier
  requires scalar : a ∈ ℂ
  requires values : ∀ x ∈ V, v(x) = ℂ[a * w(x)]
  shows complexFamilySum(v, V) = ℂ[a * complexFamilySum(w, V)]
proof
  have ring := complexes.comm_ring
  unfold complexFamilySum
  have selected := finiteRingSum.selected at V, complexCarrier, complexAdd,
    complexZero, complexNeg, complexMul, complexOne, w with ring, finite,
    weightsW
  obtain ⟨n, natural, f, enumeration, equationW⟩ := selected.right
  have injective := Bijective.injective with enumeration
  have function := Injective.function with injective
  have valuesW := WeightedValues.of_functions with weightsW, function
  have equationV := finiteRingSum.enumeration at V, complexCarrier,
    complexAdd, complexZero, complexNeg, complexMul, complexOne, v, f, n with
    ring, weightsV, enumeration
  have equations : ∀ i ∈ n, v(f(i)) = ℂ[a * w(f(i))]
    intros i hi
    have member := FunctionBetween.apply_closed with function, hi
    exact values with f(i), member
  have distribute := indexedRingSum.scale at complexCarrier, complexAdd,
    complexZero, complexNeg, complexMul, complexOne, w, a, v, f, n with ring,
    scalar
  rw [equationV, equationW]
  exact distribute with valuesW, equations

-- The coefficients shifted down, k ↦ f(k + 1), whose partial sums are the
-- summatory function A(n) = Σ_{k=1}^{n} f(k) = complexPartialSum(·, n).
defgraph shiftedCoefficients (f : Set) (k ∈ ℕ) : complexCarrier := f(k + 1)
requires values : FunctionBetween(f, ℕ, complexCarrier)
proof
  have kNat := nat.omega.backward with member
  have index : k + 1 ∈ ℕ by typecheck
  exact FunctionBetween.apply_closed with values, index

def summatory (f : Set, n : Nat) : Set :=
  complexPartialSum(shiftedCoefficients(f), n)

-- Σ_{k=1}^{n} |f(k)|, real.
defgraph absCoefficients (f : Set) (k ∈ ℕ) : ℝ := complexAbs(f(k + 1))
requires values : FunctionBetween(f, ℕ, complexCarrier)
proof
  have kNat := nat.omega.backward with member
  have index : k + 1 ∈ ℕ by typecheck
  have value := FunctionBetween.apply_closed with values, index
  exact FunctionBetween.apply_closed with complexAbs.function, value

def summatoryAbs (f : Set, n : Nat) : Set :=
  realPartialSum(absCoefficients(f), n)

-- The integrand t ↦ A(⌊t⌋) t^(−(s+1)) of the summation by parts, on
-- ℝ (only t > 1 is read).
defgraph summatoryIntegrand (f s : Set) (X ∈ ℝ) : complexCarrier :=
  ℂ[summatory(f, realFloor(X)) * realCpow(X, ℂ[-(s + 1)])]
requires values : FunctionBetween(f, ℕ, complexCarrier)
requires hs : s ∈ complexCarrier
proof
  have xReal : Real(X) by typecheck
  have floorNat := realFloor.natural_total at X
  have shifted := shiftedCoefficients.function with values
  have sequence : ComplexSequence(shiftedCoefficients(f)) by exact shifted
  have partialSum := complexPartialSum.closed at shiftedCoefficients(f),
    realFloor(X) with sequence
  have exponent : ℂ[-(s + 1)] ∈ ℂ by typecheck
  have power := realCpow.member at X, ℂ[-(s + 1)] with exponent
  unfold summatory
  typecheck

-- f is completely multiplicative: f(1) = 1 and f(m n) = f(m) f(n).
predicate CompletelyMultiplicative (f : Set) :=
  FunctionBetween(f, ℕ, complexCarrier) ∧ f(1) = complexOne ∧
  (∀ m ∈ ℕ, ∀ n ∈ ℕ, f(m * n) = complexMul(f(m), f(n)))

-- The Euler factor (1 − f(p) p^(−s))⁻¹ at a prime p and 1 at the other
-- naturals, and the partial Euler products over the primes p < n.
def lseriesEulerFactor (f s : Set, p : Nat) : Set :=
  ⋃({ w ∈ complexCarrier |
    (Prime(p) ∧ w = complexInv(ℂ[1 - f(p) * realCpow(realNat(p), ℂ[-s])])) ∨
    (¬Prime(p) ∧ w = complexOne) })

def lseriesEulerProduct (f s : Set) (n : Nat) → Set
  | f, s, zero => complexOne
  | f, s, succ(k) => complexMul(lseriesEulerProduct(f, s, k),
      lseriesEulerFactor(f, s, k))

-- The Euler factor at a prime and elsewhere, and the partial products are
-- complex numbers.
theorem lseriesEulerFactor.prime (f s : Set) (p : Nat)
  requires values : FunctionBetween(f, ℕ, complexCarrier)
  requires hs : s ∈ ℂ
  requires prime : Prime(p)
  shows lseriesEulerFactor(f, s, p) =
    complexInv(ℂ[1 - f(p) * realCpow(realNat(p), ℂ[-s])])
proof
  have index : p ∈ ℕ by typecheck
  have value := FunctionBetween.apply_closed with values, index
  have negative : ℂ[-s] ∈ ℂ by typecheck
  have power := realCpow.member at realNat(p), ℂ[-s] with negative
  have difference : ℂ[1 - f(p) * realCpow(realNat(p), ℂ[-s])] ∈ ℂ by
    typecheck
  have inverse := complexInv.member with difference
  unfold lseriesEulerFactor
  apply union.of_unique
  . refine ⟨inverse, ?_⟩
    left
    exact ⟨prime, rfl⟩
  . intros y hy
    obtain ⟨_, alternatives⟩ := hy
    rcases alternatives with ⟨_, yValue⟩ | ⟨notPrime, _⟩
    . exact yValue
    . exfalso
      exact notPrime with prime

theorem lseriesEulerFactor.not_prime (f s : Set) (p : Nat)
  requires notPrime : ¬Prime(p)
  shows lseriesEulerFactor(f, s, p) = complexOne
proof
  have one := complexOne.member
  unfold lseriesEulerFactor
  apply union.of_unique
  . refine ⟨one, ?_⟩
    right
    exact ⟨notPrime, rfl⟩
  . intros y hy
    obtain ⟨_, alternatives⟩ := hy
    rcases alternatives with ⟨prime, _⟩ | ⟨_, yValue⟩
    . exfalso
      exact notPrime with prime
    . exact yValue

theorem lseriesEulerFactor.member (f s : Set) (p : Nat)
  requires values : FunctionBetween(f, ℕ, complexCarrier)
  requires hs : s ∈ ℂ
  shows lseriesEulerFactor(f, s, p) ∈ ℂ
proof
  by_cases prime : Prime(p)
  . have index : p ∈ ℕ by typecheck
    have value := FunctionBetween.apply_closed with values, index
    have negative : ℂ[-s] ∈ ℂ by typecheck
    have power := realCpow.member at realNat(p), ℂ[-s] with negative
    have difference : ℂ[1 - f(p) * realCpow(realNat(p), ℂ[-s])] ∈ ℂ by
      typecheck
    rw (lseriesEulerFactor.prime with values, hs, prime)
    exact complexInv.member with difference
  . rw (lseriesEulerFactor.not_prime with prime)
    exact complexOne.member

theorem lseriesEulerProduct.member (f s : Set) (n : Nat)
  requires values : FunctionBetween(f, ℕ, complexCarrier)
  requires hs : s ∈ ℂ
  shows lseriesEulerProduct(f, s, n) ∈ ℂ
proof
  induction n
  | zero =>
    rw lseriesEulerProduct
    exact complexOne.member
  | succ(k) using ih =>
    have factor := lseriesEulerFactor.member at f, s, k with values, hs
    rw lseriesEulerProduct
    typecheck

defgraph lseriesEulerProducts (f s : Set) (n ∈ ℕ) : complexCarrier :=
  lseriesEulerProduct(f, s, n)
requires values : FunctionBetween(f, ℕ, complexCarrier)
requires hs : s ∈ complexCarrier
proof
  have nNat := nat.omega.backward with member
  exact lseriesEulerProduct.member with values, hs

-- The termwise product of two complex sequences.
def productSequence (u v : Set) : Set := { (n, ℂ[u(n) * v(n)]) | n ∈ ℕ }

-- The term s ↦ f(n) n^(−s) as a function on ℂ.
defgraph lseriesTermMap (f : Set, n : Nat) (s ∈ complexCarrier) :
    complexCarrier := ℂ[f(n) * realCpow(realNat(n), ℂ[-s])]
requires values : FunctionBetween(f, ℕ, complexCarrier)
proof
  have value := FunctionBetween.apply_closed at f, ℕ, complexCarrier, n with values
  have negative : ℂ[-s] ∈ ℂ by typecheck
  have power := realCpow.member at realNat(n), ℂ[-s] with negative
  typecheck

-- Section: Graphs given by their pairs
-- A set of pairs over A that is total and single-valued on A is a function
-- from A to any B holding its values; its application reads the pairs.
theorem coefficientGraph.function (G A B : Set)
  requires shape : ∀ p ∈ G, ∃ a ∈ A, ∃ b ∈ B, p = (a, b)
  requires total : ∀ a ∈ A, ∃ b ∈ B, (a, b) ∈ G
  requires functional : ∀ a, ∀ b, ∀ c, (a, b) ∈ G → (a, c) ∈ G → b = c
  shows G : A → B
proof
  refine ⟨?_, ?_, ?_⟩
  . unfold RelationBetween
    unfold Subset
    intros p hp
    obtain ⟨a, aIn, b, bIn, eq⟩ := shape with p, hp
    rw eq
    exact product.pair with aIn, bIn
  . unfold Functional
    intros x y xy z xz
    unfold relates at xy
    unfold relates at xz
    exact functional with x, y, z, xy, xz
  . intros a aIn
    obtain ⟨b, bIn, ab⟩ := total with a, aIn
    unfold relates
    exact ⟨b, bIn, ab⟩

theorem coefficientGraph.second_in_union (G a b : Set)
  requires mapped : (a, b) ∈ G
  shows b ∈ ⋃(⋃(G))
proof
  have inner := orderedPair.second_in_union at a, b
  obtain ⟨q, qIn, bq⟩ := union.membership.forward with inner
  have qUnion : q ∈ ⋃(G)
    apply union.membership.backward
    exact ⟨(a, b), mapped, qIn⟩
  apply union.membership.backward
  exact ⟨q, qUnion, bq⟩

theorem coefficientGraph.apply (G A x y : Set)
  requires shape : ∀ p ∈ G, ∃ a ∈ A, ∃ b, p = (a, b)
  requires total : ∀ a ∈ A, ∃ b, (a, b) ∈ G
  requires functional : ∀ a, ∀ b, ∀ c, (a, b) ∈ G → (a, c) ∈ G → b = c
  requires index : x ∈ A
  requires mapped : (x, y) ∈ G
  shows G(x) = y
proof
  have shapeB : ∀ p ∈ G, ∃ a ∈ A, ∃ b ∈ ⋃(⋃(G)), p = (a, b)
    intros p hp
    obtain ⟨a, aIn, b, eq⟩ := shape with p, hp
    have abIn : (a, b) ∈ G
      rw ← eq
      exact hp
    have outer := coefficientGraph.second_in_union with abIn
    exact ⟨a, aIn, b, outer, eq⟩
  have totalB : ∀ a ∈ A, ∃ b ∈ ⋃(⋃(G)), (a, b) ∈ G
    intros a aIn
    obtain ⟨b, ab⟩ := total with a, aIn
    have outer := coefficientGraph.second_in_union with ab
    exact ⟨b, outer, ab⟩
  have function := coefficientGraph.function with shapeB, totalB, functional
  apply FunctionBetween.apply_value with function, index
  unfold relates
  exact mapped

theorem characterCoefficients.eval (χ n : Set)
  requires index : n ∈ ℕ
  shows characterCoefficients(χ)(n) = χ(integerOfNat(n))
proof
  have shape : ∀ p0 ∈ characterCoefficients(χ), ∃ a0 ∈ ℕ, ∃ b0, p0 = (a0, b0)
    intros p0 hp
    simp [characterCoefficients] at hp
    obtain ⟨m0, mIn, eq⟩ := hp
    rw ← eq
    exact ⟨m0, mIn, χ(integerOfNat(m0)), rfl⟩
  have total : ∀ a0 ∈ ℕ, ∃ b0, (a0, b0) ∈ characterCoefficients(χ)
    intros a0 aIn
    refine ⟨χ(integerOfNat(a0)), ?_⟩
    simp [characterCoefficients]
  have functional : ∀ a0, ∀ b0, ∀ c0, (a0, b0) ∈ characterCoefficients(χ) →
      (a0, c0) ∈ characterCoefficients(χ) → b0 = c0
