    rw ← eq
    exact ⟨m0, mIn, ℂ[u(m0) * v(m0)], rfl⟩
  have total : ∀ a0 ∈ ℕ, ∃ b0, (a0, b0) ∈ productSequence(u, v)
    intros a0 aIn
    refine ⟨ℂ[u(a0) * v(a0)], ?_⟩
    simp [productSequence]
  have functional : ∀ a0, ∀ b0, ∀ c0, (a0, b0) ∈ productSequence(u, v) →
      (a0, c0) ∈ productSequence(u, v) → b0 = c0
    intros a0 b0 c0 ab ac
    simp [productSequence] at ab
    simp [productSequence] at ac
    obtain ⟨m0, _, abEq⟩ := ab
    obtain ⟨k0, _, acEq⟩ := ac
    obtain ⟨ma, mb⟩ := orderedPair.injective with abEq
    obtain ⟨ka, kc⟩ := orderedPair.injective with acEq
    cc
  have mapped : (n, ℂ[u(n) * v(n)]) ∈ productSequence(u, v)
    simp [productSequence]
  exact coefficientGraph.apply with shape, total, functional, index, mapped

theorem productSequence.maps (u v B : Set)
  requires values : ∀ n ∈ ℕ, ℂ[u(n) * v(n)] ∈ B
  shows productSequence(u, v) : ℕ → B
proof
  have shape : ∀ p0 ∈ productSequence(u, v), ∃ a0 ∈ ℕ, ∃ b0 ∈ B, p0 = (a0, b0)
    intros p0 hp
    simp [productSequence] at hp
    obtain ⟨m0, mIn, eq⟩ := hp
    have value := values with m0, mIn
    rw ← eq
    exact ⟨m0, mIn, ℂ[u(m0) * v(m0)], value, rfl⟩
  have total : ∀ a0 ∈ ℕ, ∃ b0 ∈ B, (a0, b0) ∈ productSequence(u, v)
    intros a0 aIn
    have value := values with a0, aIn
    refine ⟨ℂ[u(a0) * v(a0)], value, ?_⟩
    simp [productSequence]
  have functional : ∀ a0, ∀ b0, ∀ c0, (a0, b0) ∈ productSequence(u, v) →
      (a0, c0) ∈ productSequence(u, v) → b0 = c0
    intros a0 b0 c0 ab ac
    simp [productSequence] at ab
    simp [productSequence] at ac
    obtain ⟨m0, _, abEq⟩ := ab
    obtain ⟨k0, _, acEq⟩ := ac
    obtain ⟨ma, mb⟩ := orderedPair.injective with abEq
    obtain ⟨ka, kc⟩ := orderedPair.injective with acEq
    cc
  exact coefficientGraph.function with shape, total, functional

-- Section: Comparison helpers
theorem ComplexAbsolutelySummable.of_abs_le (u w : Set)
  requires sequence : ComplexSequence(u)
  requires absolute : ComplexAbsolutelySummable(w)
  requires dominated : ∀ n ∈ ℕ, complexAbs(u(n)) ≤ complexAbs(w(n))
  shows ComplexAbsolutelySummable(u)
proof
  obtain ⟨wSequence, wSummable⟩ := absolute
  apply ComplexAbsolutelySummable.of_bound with sequence, wSummable
  intros n nIn
  have nNat := nat.omega.backward with nIn
  rw (complexAbsSequence.value with wSequence, nIn)
  exact dominated with n, nIn

theorem ComplexAbsolutelySummable.of_abs_le_scaled (u w : Set) (C : Real)
  requires sequence : ComplexSequence(u)
  requires absolute : ComplexAbsolutelySummable(w)
  requires dominated : ∀ n ∈ ℕ, complexAbs(u(n)) ≤ R[C * complexAbs(w(n))]
  shows ComplexAbsolutelySummable(u)
proof
  obtain ⟨wSequence, wSummable⟩ := absolute
  have scaled := Summable.scale at complexAbsSequence(w), C with wSummable
  have absSequence : RealSequence(complexAbsSequence(w)) by
    exact complexAbsSequence.function with wSequence
  have constant := constantSequence.sequence at C
  apply ComplexAbsolutelySummable.of_bound with sequence, scaled
  intros n nIn
  have nNat := nat.omega.backward with nIn
  have wFunction : w : ℕ → ℂ by exact wSequence
  have term := FunctionBetween.apply_closed with wFunction, nIn
  have absReal := complexAbs.real with term
  have absValue := complexAbsSequence.value with wSequence, nIn
  have valueReal : Real(complexAbsSequence(w)(n))
    rw absValue
    exact absReal
  have constantValue := constantSequence.value at C, n
  have constantReal : Real(constantSequence(C)(n))
    rw constantValue
    typecheck
  rw [(mulSequence.value with constant, absSequence, constantReal, valueReal),
    constantValue, absValue]
  exact dominated with n, nIn

theorem ComplexAbsolutelySummable.of_abs_le_add (u v w : Set)
  requires sequence : ComplexSequence(u)
  requires absoluteV : ComplexAbsolutelySummable(v)
  requires absoluteW : ComplexAbsolutelySummable(w)
  requires dominated : ∀ n ∈ ℕ,
    complexAbs(u(n)) ≤ R[complexAbs(v(n)) + complexAbs(w(n))]
  shows ComplexAbsolutelySummable(u)
proof
  obtain ⟨vSequence, vSummable⟩ := absoluteV
  obtain ⟨wSequence, wSummable⟩ := absoluteW
  have sum := Summable.add with vSummable, wSummable
  have vAbs : RealSequence(complexAbsSequence(v)) by
    exact complexAbsSequence.function with vSequence
  have wAbs : RealSequence(complexAbsSequence(w)) by
    exact complexAbsSequence.function with wSequence
  apply ComplexAbsolutelySummable.of_bound with sequence, sum
  intros n nIn
  have nNat := nat.omega.backward with nIn
  have vFunction : v : ℕ → ℂ by exact vSequence
  have wFunction : w : ℕ → ℂ by exact wSequence
  have vTerm := FunctionBetween.apply_closed with vFunction, nIn
  have wTerm := FunctionBetween.apply_closed with wFunction, nIn
  have vReal := complexAbs.real with vTerm
  have wReal := complexAbs.real with wTerm
  have vValue := complexAbsSequence.value with vSequence, nIn
  have wValue := complexAbsSequence.value with wSequence, nIn
  have vValueReal : Real(complexAbsSequence(v)(n))
    rw vValue
    exact vReal
  have wValueReal : Real(complexAbsSequence(w)(n))
    rw wValue
    exact wReal
  rw [(addSequence.value with vAbs, wAbs, vValueReal, wValueReal), vValue,
    wValue]
  exact dominated with n, nIn

-- n^S ≤ n^T for n ≥ 1 and S ≤ T.
theorem realRpow.nat_le_of_exponent (n : Nat) (S T : Real)
  requires positive : 1 ≤ n
  requires order : S ≤ T
  shows realRpow(realNat(n), S) ≤ realRpow(realNat(n), T)
proof
  have leftReal := realRpow.real at realNat(n), S
  have rightReal := realRpow.real at realNat(n), T
  by_cases one : n = (1:N)
  . rw [one, realNat.one, realRpow.one_base, realRpow.one_base]
    linarith
  . have above : (1:N) < n by arith
    have base := realNat.lt_of_lt with above
    rw realNat.one at base
    by_cases strict : S < T
    . have smaller := realRpow.lt_of_exponent with base, strict
      exact realLess.implies_le with smaller
    . have same : S = T by linarith
      rw same
      linarith

-- Terms only read the coefficients at n ≥ 1.
theorem lseriesTerms.congr (f g s : Set)
  requires fValues : FunctionBetween(f, ℕ, complexCarrier)
  requires gValues : FunctionBetween(g, ℕ, complexCarrier)
  requires hs : s ∈ ℂ
  requires same : ∀ n ∈ ℕ, n ≠ (0:N) → f(n) = g(n)
  shows lseriesTerms(f, s) = lseriesTerms(g, s)
proof
  have left := lseriesTerms.function with fValues, hs
  have right := lseriesTerms.function with gValues, hs
  apply FunctionBetween.ext with left, right
  intros n nMember
  have nNat := nat.omega.backward with nMember
  have next : n + 1 ∈ ℕ by typecheck
  have nonzero : n + 1 ≠ (0:N) by arith
  have agree := same with n + 1, next, nonzero
  rw [(lseriesTerms.value with fValues, hs, nMember),
    (lseriesTerms.value with gValues, hs, nMember), agree]

-- Section: Coefficients
theorem characterCoefficients.function (N : Nat) (χ : Set)
  requires character : DirichletCharacter(N, χ)
  shows FunctionBetween(characterCoefficients(χ), ℕ, complexCarrier)
proof
  have values := DirichletCharacter.function with character
  apply characterCoefficients.maps
  intros n nIn
  have nNat := nat.omega.backward with nIn
  have index : integerOfNat(n) ∈ ℤ by typecheck
  exact FunctionBetween.apply_closed with values, index

theorem characterCoefficients.apply (χ : Set) (n : Nat)
  shows characterCoefficients(χ)(n) = χ(integerOfNat(n))
proof
  have index : n ∈ ℕ by typecheck
  exact characterCoefficients.eval with index

theorem oneCoefficients.function
  shows FunctionBetween(oneCoefficients, ℕ, complexCarrier)
proof
  unfold oneCoefficients
  apply coefficientGraph.function
  . intros p hp
    obtain ⟨_, a, aIn, b, bIn, shape⟩ := product.membership.forward with hp
    simp at bIn
    have one := complexOne.member
    rw bIn at shape
    exact ⟨a, aIn, complexOne, one, shape⟩
  . intros a aIn
    have one : complexOne ∈ {complexOne} by simp
    have pair := product.pair with aIn, one
    exact ⟨complexOne, complexOne.member, pair⟩
  . intros a b c ab ac
    obtain ⟨_, bOne⟩ := product.pair_membership.forward with ab
    obtain ⟨_, cOne⟩ := product.pair_membership.forward with ac
    simp at bOne
    simp at cOne
    rw [bOne, cOne]

theorem oneCoefficients.apply (n : Nat)
  shows oneCoefficients(n) = complexOne
proof
  have index : n ∈ ℕ by typecheck
  have function := oneCoefficients.function
  have one : complexOne ∈ {complexOne} by simp
  have mapped : relates(oneCoefficients, n, complexOne)
    unfold relates
    unfold oneCoefficients
    exact product.pair with index, one
  exact FunctionBetween.apply_value with function, index, mapped

-- |χ(n)| ≤ 1 (Mathlib's DirichletCharacter.norm_le_one).
theorem characterCoefficients.abs_le_one (N : Nat) (χ : Set) (n : Nat)
  requires positive : 1 ≤ N
  requires character : DirichletCharacter(N, χ)
  shows complexAbs(characterCoefficients(χ)(n)) ≤ R[1]
proof
  have index : integerOfNat(n) ∈ ℤ by typecheck
  have positiveN : 0 < N by arith
  rw characterCoefficients.apply
  exact DirichletCharacter.abs_le_one with character, positiveN, index

-- A Dirichlet character is completely multiplicative on ℕ.
theorem characterCoefficients.multiplicative (N : Nat) (χ : Set)
  requires character : DirichletCharacter(N, χ)
  shows CompletelyMultiplicative(characterCoefficients(χ))
proof
  have function := characterCoefficients.function with character
  refine ⟨function, ?_, ?_⟩
  . rw [characterCoefficients.apply, integerOfNat.one]
    exact DirichletCharacter.one with character
  . intros m mIn n nIn
    have mNat := nat.omega.backward with mIn
    have nNat := nat.omega.backward with nIn
    have mInteger : integerOfNat(m) ∈ ℤ by typecheck
    have nInteger : integerOfNat(n) ∈ ℤ by typecheck
    rw [characterCoefficients.apply, characterCoefficients.apply,
      characterCoefficients.apply, integerOfNat.mul]
    exact DirichletCharacter.mul with character, mInteger, nInteger

theorem oneCoefficients.multiplicative
  shows CompletelyMultiplicative(oneCoefficients)
proof
  have function := oneCoefficients.function
  refine ⟨function, ?_, ?_⟩
  . rw oneCoefficients.apply
  . intros m mIn n nIn
    have mNat := nat.omega.backward with mIn
    have nNat := nat.omega.backward with nIn
    rw [oneCoefficients.apply, oneCoefficients.apply, oneCoefficients.apply]
    ring

-- The series of a character is layer 1's: the terms agree with
-- dirichletSeriesTerms, and the terms of 1 with zetaSeriesTerms.
theorem lseriesTerms.character (N : Nat) (χ s : Set)
  requires character : DirichletCharacter(N, χ)
  requires hs : s ∈ ℂ
  shows lseriesTerms(characterCoefficients(χ), s) =
    dirichletSeriesTerms(χ, s)
proof
  have values := DirichletCharacter.function with character
  have coefficients := characterCoefficients.function with character
  have left := lseriesTerms.function with coefficients, hs
  have right := dirichletSeriesTerms.function with values, hs
  apply FunctionBetween.ext with left, right
  intros n nMember
  have nNat := nat.omega.backward with nMember
  rw [(lseriesTerms.value with coefficients, hs, nMember),
    (dirichletSeriesTerms.value with values, hs, nMember),
    characterCoefficients.apply]

theorem lseriesTerms.one (s : Set)
  requires hs : s ∈ ℂ
  shows lseriesTerms(oneCoefficients, s) = zetaSeriesTerms(s)
proof
  have coefficients := oneCoefficients.function
  have left := lseriesTerms.function with coefficients, hs
  have right := zetaSeriesTerms.function with hs
  apply FunctionBetween.ext with left, right
  intros n nMember
  have nNat := nat.omega.backward with nMember
  have negative : ℂ[-s] ∈ ℂ by typecheck
  have power := realCpow.member at realNat(n + 1), ℂ[-s] with negative
  rw [(lseriesTerms.value with coefficients, hs, nMember),
    (zetaSeriesTerms.value with hs, nMember), oneCoefficients.apply]
  ring

-- Section: Terms
theorem lseriesTerms.apply (f s : Set) (n : Nat)
  requires values : FunctionBetween(f, ℕ, complexCarrier)
  requires hs : s ∈ ℂ
  shows lseriesTerms(f, s)(n) =
    ℂ[f(n + 1) * realCpow(realNat(n + 1), ℂ[-s])]
proof
  have index : n ∈ ℕ by typecheck
  exact lseriesTerms.value with values, hs, index

-- |f(n) n^(−s)| = |f(n)| n^(−re s) (Mathlib's LSeries.norm_term_eq).
theorem lseriesTerms.abs (f s : Set) (n : Nat)
  requires values : FunctionBetween(f, ℕ, complexCarrier)
  requires hs : s ∈ ℂ
  shows complexAbs(lseriesTerms(f, s)(n)) =
    R[complexAbs(f(n + 1)) * realRpow(realNat(n + 1), -complexRe(s))]
proof
  have index : n ∈ ℕ by typecheck
  have next : n + 1 ∈ ℕ by typecheck
  have positive : 1 ≤ n + 1 by arith
  have value := FunctionBetween.apply_closed with values, next
  have negative : ℂ[-s] ∈ ℂ by typecheck
  have power := realCpow.member at realNat(n + 1), ℂ[-s] with negative
  rw [(lseriesTerms.value with values, hs, index),
    (complexAbs.mul with value, power), (realCpow.nat_neg_abs with positive, hs)]

-- Comparison of terms (Mathlib's LSeries.norm_term_le).
theorem lseriesTerms.abs_le (f g s : Set) (n : Nat)
  requires fValues : FunctionBetween(f, ℕ, complexCarrier)
  requires gValues : FunctionBetween(g, ℕ, complexCarrier)
  requires hs : s ∈ ℂ
  requires bound : complexAbs(f(n + 1)) ≤ complexAbs(g(n + 1))
  shows complexAbs(lseriesTerms(f, s)(n)) ≤ complexAbs(lseriesTerms(g, s)(n))
proof
  have positive : 1 ≤ n + 1 by arith
  rw [(lseriesTerms.abs with fValues, hs), (lseriesTerms.abs with gValues, hs)]
  have power := realRpow.positive at realNat(n + 1), R[-complexRe(s)]
  exact realLe.mul_right_of_nonnegative with bound,
    (realLess.implies_le with power)

-- Nonnegative real coefficients at a real point give nonnegative real
-- terms (Mathlib's LSeries.term_nonneg).
theorem lseriesTerms.nonneg (a : Set, X : Real) (n : Nat)
  requires sequence : RealSequence(a)
  requires nonneg : ∀ k ∈ ℕ, R[0] ≤ a(k)
  shows ∃ Y ∈ ℝ, R[0] ≤ Y ∧
    lseriesTerms(realCoefficients(a), complexOfReal(X))(n) = complexOfReal(Y)
proof
  have nMember : n ∈ ℕ by typecheck
  have next : n + 1 ∈ ℕ by typecheck
  have coefficients : FunctionBetween(realCoefficients(a), ℕ, complexCarrier)
    apply realCoefficients.maps
    intros k kIn
    have kReal := FunctionBetween.apply_closed with sequence, kIn
    typecheck
  have hx : complexOfReal(X) ∈ ℂ by typecheck
  have aReal := FunctionBetween.apply_closed with sequence, next
  have aRealT : Real(a(n + 1)) by typecheck
  have aNonneg := nonneg with n + 1, next
  have power := realRpow.positive at realNat(n + 1), R[-X]
  have powerReal := realRpow.real at realNat(n + 1), R[-X]
  have product := realMulValue.nonnegative with aNonneg,
    (realLess.implies_le with power)
  have productIn : R[a(n + 1) * realRpow(realNat(n + 1), R[-X])] ∈ ℝ by
    typecheck
  refine ⟨R[a(n + 1) * realRpow(realNat(n + 1), R[-X])], productIn,
    product, ?_⟩
  rw [(lseriesTerms.value with coefficients, hx, nMember),
    (realCoefficients.eval with next), ← complexOfReal.neg, realCpow.of_real,
    complexOfReal.mul]

-- The derivative of a term: d/ds f(n) n^(−s) = −log(n) f(n) n^(−s)
-- (Mathlib's LSeries.hasDerivAt_term).
theorem lseriesTermMap.derivative (f : Set) (n : Nat) (s : Set)
  requires values : FunctionBetween(f, ℕ, complexCarrier)
  requires hs : s ∈ ℂ
  shows HasComplexDerivativeAt(lseriesTermMap(f, n), complexCarrier,
    ℂ[-(complexOfReal(realLog(realNat(n))) * f(n) *
      realCpow(realNat(n), ℂ[-s]))], s)
proof
  have nMember : n ∈ ℕ by typecheck
  have value := FunctionBetween.apply_closed with values, nMember
  have logMember : complexOfReal(realLog(realNat(n))) ∈ ℂ by typecheck
  have rate : ℂ[-complexOfReal(realLog(realNat(n)))] ∈ ℂ by typecheck
  have zero := complexZero.member
  have formula : ∀ x ∈ ℂ, lseriesTermMap(f, n)(x) =
      ℂ[f(n) * complexExp(-complexOfReal(realLog(realNat(n))) * x) +
        0 * complexExp(0 * x)]
    intros x hx
    rw (lseriesTermMap.value with values, hx)
    unfold realCpow
    have commuted : ℂ[-x * complexOfReal(realLog(realNat(n)))] =
        ℂ[-complexOfReal(realLog(realNat(n))) * x] by ring
    have scaled : ℂ[0 * x] ∈ ℂ by typecheck
    have expScaled := complexExp.member with scaled
    have product : ℂ[-complexOfReal(realLog(realNat(n))) * x] ∈ ℂ by
      typecheck
    have expProduct := complexExp.member with product
    rw commuted
    ring
  have derivative := HasComplexDerivativeAt.of_exp_combination with hs,
    value, zero, rate, zero, formula
  have scaled : ℂ[0 * s] ∈ ℂ by typecheck
  have expScaled := complexExp.member with scaled
  have product : ℂ[-complexOfReal(realLog(realNat(n))) * s] ∈ ℂ by typecheck
  have expProduct := complexExp.member with product
  have same : ℂ[f(n) * -complexOfReal(realLog(realNat(n))) *
      complexExp(-complexOfReal(realLog(realNat(n))) * s) +
      0 * 0 * complexExp(0 * s)] =
      ℂ[-(complexOfReal(realLog(realNat(n))) * f(n) *
        realCpow(realNat(n), ℂ[-s]))]
    unfold realCpow
    have commuted : ℂ[-s * complexOfReal(realLog(realNat(n)))] =
        ℂ[-complexOfReal(realLog(realNat(n))) * s] by ring
    rw commuted
    ring
  rwa same at derivative

-- Section: Sums
theorem LSeries.member (f s : Set)
  requires values : FunctionBetween(f, ℕ, complexCarrier)
  requires hs : s ∈ ℂ
  shows LSeries(f, s) ∈ ℂ
proof
  exact LSeries.value_member at f, s

theorem LSeriesMap.apply (f s : Set)
  requires values : FunctionBetween(f, ℕ, complexCarrier)
  requires hs : s ∈ ℂ
  shows LSeriesMap(f)(s) = LSeries(f, s)
proof
  exact LSeriesMap.value with values, hs

-- Mathlib's LSeriesHasSum_iff.
theorem LSeriesHasSum.iff (f s a : Set)
  requires values : FunctionBetween(f, ℕ, complexCarrier)
  requires hs : s ∈ ℂ
  shows LSeriesHasSum(f, s, a) ↔
    LSeriesSummable(f, s) ∧ LSeries(f, s) = a
proof
  constructor
  . intro has
    obtain ⟨summable, sums⟩ := has
    have own := LSeries.of_summable with summable
    have equal := ComplexSumsTo.unique with own, sums
    exact ⟨summable, equal⟩
  . intro both
    obtain ⟨summable, equal⟩ := both
    have own := LSeries.of_summable with summable
    rw equal at own
    exact ⟨summable, own⟩

-- Mathlib's LSeriesSummable.LSeriesHasSum.
theorem LSeriesSummable.hasSum (f s : Set)
  requires values : FunctionBetween(f, ℕ, complexCarrier)
  requires hs : s ∈ ℂ
  requires summable : LSeriesSummable(f, s)
  shows LSeriesHasSum(f, s, LSeries(f, s))
proof
  have own := LSeries.of_summable with summable
  exact ⟨summable, own⟩

-- Off the summable s the sum is 0 (Mathlib's
-- LSeries.eq_zero_of_not_LSeriesSummable).
theorem LSeries.of_not_summable (f s : Set)
  requires values : FunctionBetween(f, ℕ, complexCarrier)
  requires hs : s ∈ ℂ
  requires notSummable : ¬LSeriesSummable(f, s)
  shows LSeries(f, s) = ℂ[0]
proof
  exact LSeries.of_not_summable_value with notSummable

-- Only the values at n ≥ 1 matter (Mathlib's LSeriesSummable_congr,
-- LSeries_congr).
theorem LSeriesSummable.congr (f g s : Set)
  requires fValues : FunctionBetween(f, ℕ, complexCarrier)
  requires gValues : FunctionBetween(g, ℕ, complexCarrier)
  requires hs : s ∈ ℂ
  requires same : ∀ n ∈ ℕ, n ≠ (0:N) → f(n) = g(n)
  shows LSeriesSummable(f, s) ↔ LSeriesSummable(g, s)
proof
  have terms := lseriesTerms.congr with fValues, gValues, hs, same
  constructor
  . intro summable
    unfold LSeriesSummable
    unfold LSeriesSummable at summable
    rwa terms at summable
  . intro summable
    unfold LSeriesSummable
    unfold LSeriesSummable at summable
    rwa ← terms at summable

theorem LSeries.congr (f g s : Set)
  requires fValues : FunctionBetween(f, ℕ, complexCarrier)
  requires gValues : FunctionBetween(g, ℕ, complexCarrier)
  requires hs : s ∈ ℂ
  requires same : ∀ n ∈ ℕ, n ≠ (0:N) → f(n) = g(n)
  shows LSeries(f, s) = LSeries(g, s)
proof
  have terms := lseriesTerms.congr with fValues, gValues, hs, same
  have both := LSeriesSummable.congr with fValues, gValues, hs, same
  by_cases summable : LSeriesSummable(f, s)
  . have gSummable := both.forward with summable
    have fSums := LSeries.of_summable with summable
    have gSums := LSeries.of_summable with gSummable
    rw terms at fSums
    exact ComplexSumsTo.unique with fSums, gSums
  . have gNot : ¬LSeriesSummable(g, s)
      intro gSummable
      exact summable with (both.backward with gSummable)
    rw [(LSeries.of_not_summable_value with summable),
      (LSeries.of_not_summable_value with gNot)]

-- The comparisons in the real order of re s and re t (the statements
-- `lseriesTerms.abs_le_of_re_le` and `LSeriesSummable.of_re_le_re` read
-- complexRe(s) ≤ complexRe(t) in the natural-number order).
theorem lseriesTerms.abs_le_of_re (f s t : Set) (n : Nat)
  requires values : FunctionBetween(f, ℕ, complexCarrier)
  requires hs : s ∈ ℂ
  requires ht : t ∈ ℂ
  requires order : R[0] ≤ R[complexRe(t) - complexRe(s)]
  shows complexAbs(lseriesTerms(f, t)(n)) ≤ complexAbs(lseriesTerms(f, s)(n))
proof
  have next : n + 1 ∈ ℕ by typecheck
  have positive : 1 ≤ n + 1 by arith
  have value := FunctionBetween.apply_closed with values, next
  have valueAbs := complexAbs.nonnegative with value
  have reS : Real(complexRe(s)) by typecheck
  have reT : Real(complexRe(t)) by typecheck
  have exponents : R[-complexRe(t)] ≤ R[-complexRe(s)] by linarith
  have powers := realRpow.nat_le_of_exponent with positive, exponents
  rw [(lseriesTerms.abs with values, ht), (lseriesTerms.abs with values, hs)]
  exact realLe.mul_left_of_nonnegative with powers, valueAbs

theorem LSeriesSummable.of_re_le (f s t : Set)
  requires values : FunctionBetween(f, ℕ, complexCarrier)
  requires hs : s ∈ ℂ
  requires ht : t ∈ ℂ
  requires order : R[0] ≤ R[complexRe(t) - complexRe(s)]
  requires summable : LSeriesSummable(f, s)
  shows LSeriesSummable(f, t)
proof
  have terms := lseriesTerms.function with values, ht
  have sequence : ComplexSequence(lseriesTerms(f, t)) by exact terms
  unfold LSeriesSummable
  unfold LSeriesSummable at summable
  apply ComplexAbsolutelySummable.of_abs_le with sequence, summable
  intros n nIn
  have nNat := nat.omega.backward with nIn
  exact lseriesTerms.abs_le_of_re with values, hs, ht, order

-- A term decreases in modulus as re s grows (Mathlib's
-- LSeries.norm_term_le_of_re_le_re).
theorem lseriesTerms.abs_le_of_re_le (f s t : Set) (n : Nat)
  requires values : FunctionBetween(f, ℕ, complexCarrier)
  requires hs : s ∈ ℂ
  requires ht : t ∈ ℂ
  requires order : R[0] ≤ R[complexRe(t) - complexRe(s)]
  shows complexAbs(lseriesTerms(f, t)(n)) ≤ complexAbs(lseriesTerms(f, s)(n))
proof
  exact lseriesTerms.abs_le_of_re with values, hs, ht, order

-- Summability moves right (Mathlib's LSeriesSummable.of_re_le_re).
theorem LSeriesSummable.of_re_le_re (f s t : Set)
  requires values : FunctionBetween(f, ℕ, complexCarrier)
  requires hs : s ∈ ℂ
  requires ht : t ∈ ℂ
  requires order : R[0] ≤ R[complexRe(t) - complexRe(s)]
  requires summable : LSeriesSummable(f, s)
  shows LSeriesSummable(f, t)
proof
  exact LSeriesSummable.of_re_le with values, hs, ht, order, summable

-- Summability depends only on re s (Mathlib's LSeriesSummable_iff_of_re_eq_re).
theorem LSeriesSummable.of_re_eq (f s t : Set)
  requires values : FunctionBetween(f, ℕ, complexCarrier)
  requires hs : s ∈ ℂ
  requires ht : t ∈ ℂ
  requires same : complexRe(s) = complexRe(t)
  shows LSeriesSummable(f, s) ↔ LSeriesSummable(f, t)
proof
  have reS : Real(complexRe(s)) by typecheck
  have reT : Real(complexRe(t)) by typecheck
  have forward : R[0] ≤ R[complexRe(t) - complexRe(s)] by linarith
  have backward : R[0] ≤ R[complexRe(s) - complexRe(t)] by linarith
  constructor
  . intro summable
    exact LSeriesSummable.of_re_le with values, hs, ht, forward, summable
  . intro summable
    exact LSeriesSummable.of_re_le with values, ht, hs, backward, summable

-- Comparison: dominated coefficients (Mathlib's LSeriesSummable.of_norm_le
-- pattern, via norm_term_le).
theorem LSeriesSummable.of_abs_le (f g s : Set)
  requires fValues : FunctionBetween(f, ℕ, complexCarrier)
  requires gValues : FunctionBetween(g, ℕ, complexCarrier)
  requires hs : s ∈ ℂ
  requires bound : ∀ n ∈ ℕ, complexAbs(f(n)) ≤ complexAbs(g(n))
  requires summable : LSeriesSummable(g, s)
  shows LSeriesSummable(f, s)
proof
  have terms := lseriesTerms.function with fValues, hs
  have sequence : ComplexSequence(lseriesTerms(f, s)) by exact terms
  unfold LSeriesSummable
  unfold LSeriesSummable at summable
  apply ComplexAbsolutelySummable.of_abs_le with sequence, summable
  intros n nIn
  have nNat := nat.omega.backward with nIn
  have next : n + 1 ∈ ℕ by typecheck
  have nextBound := bound with n + 1, next
  exact lseriesTerms.abs_le with fValues, gValues, hs, nextBound

-- Bounded coefficients give absolute convergence on re s > 1 (Mathlib's
-- LSeriesSummable_of_le_const_mul_rpow with exponent 0).
theorem LSeriesSummable.of_bounded (f s : Set) (C : Real)
  requires values : FunctionBetween(f, ℕ, complexCarrier)
  requires hs : s ∈ ℂ
  requires bound : ∀ n ∈ ℕ, complexAbs(f(n)) ≤ C
  requires halfPlane : realOne < complexRe(s)
  shows LSeriesSummable(f, s)
proof
  obtain ⟨_, absoluteZeta⟩ := zeta.series with hs, halfPlane
  have terms := lseriesTerms.function with values, hs
  have sequence : ComplexSequence(lseriesTerms(f, s)) by exact terms
  have dominated : ∀ n ∈ ℕ, complexAbs(lseriesTerms(f, s)(n)) ≤
      R[C * complexAbs(zetaSeriesTerms(s)(n))]
    intros n nIn
    have nNat := nat.omega.backward with nIn
    have next : n + 1 ∈ ℕ by typecheck
    have positive : 1 ≤ n + 1 by arith
    have valueBound := bound with n + 1, next
    rw [(lseriesTerms.abs with values, hs), (zetaSeriesTerms.value with hs, nIn),
      (realCpow.nat_neg_abs with positive, hs)]
    have power := realRpow.positive at realNat(n + 1), R[-complexRe(s)]
    exact realLe.mul_right_of_nonnegative with valueBound,
      (realLess.implies_le with power)
  unfold LSeriesSummable
  exact ComplexAbsolutelySummable.of_abs_le_scaled with sequence,
    absoluteZeta, dominated

-- Coefficients O(n^x) give absolute convergence on re s > x + 1 (Mathlib's
-- LSeriesSummable_of_le_const_mul_rpow).
theorem LSeriesSummable.of_le_rpow (f s : Set) (X C : Real)
  requires values : FunctionBetween(f, ℕ, complexCarrier)
  requires hs : s ∈ ℂ
  requires bound : ∀ n ∈ ℕ, n ≠ (0:N) →
    complexAbs(f(n)) ≤ R[C * realRpow(realNat(n), X)]
  requires halfPlane : R[X + 1] < complexRe(s)
  shows LSeriesSummable(f, s)
proof
  have reS : Real(complexRe(s)) by typecheck
  have hw : complexOfReal(R[complexRe(s) - X]) ∈ ℂ by typecheck
  have reW := complexOfReal.re at R[complexRe(s) - X]
  have halfPlaneW : realOne < complexRe(complexOfReal(R[complexRe(s) - X]))
    rw reW
    linarith
  obtain ⟨_, absoluteZeta⟩ := zeta.series with hw, halfPlaneW
  have terms := lseriesTerms.function with values, hs
  have sequence : ComplexSequence(lseriesTerms(f, s)) by exact terms
  have dominated : ∀ n ∈ ℕ, complexAbs(lseriesTerms(f, s)(n)) ≤
      R[C * complexAbs(zetaSeriesTerms(complexOfReal(R[complexRe(s) - X]))(n))]
    intros n nIn
    have nNat := nat.omega.backward with nIn
    have next : n + 1 ∈ ℕ by typecheck
    have positive : 1 ≤ n + 1 by arith
    have nonzero : n + 1 ≠ (0:N) by arith
    have valueBound := bound with n + 1, next, nonzero
    have atLeast := realNat.one_le with positive
    have positiveReal : R[0] < realNat(n + 1) by linarith
    have split := realRpow.add at realNat(n + 1), X, R[-complexRe(s)] with
      positiveReal
    have exponent : R[-complexRe(complexOfReal(R[complexRe(s) - X]))] =
        R[X + -complexRe(s)]
      rw reW
      ring
    rw [(lseriesTerms.abs with values, hs),
      (zetaSeriesTerms.value with hw, nIn),
      (realCpow.nat_neg_abs with positive, hw), exponent, split]
    have power := realRpow.positive at realNat(n + 1), R[-complexRe(s)]
    have scaled := realLe.mul_right_of_nonnegative with valueBound,
      (realLess.implies_le with power)
    have powerX := realRpow.real at realNat(n + 1), X
    have powerS := realRpow.real at realNat(n + 1), R[-complexRe(s)]
    have value := FunctionBetween.apply_closed with values, next
    have absReal := complexAbs.real with value
    have regroup : R[C * realRpow(realNat(n + 1), X) *
        realRpow(realNat(n + 1), R[-complexRe(s)])] =
      R[C * (realRpow(realNat(n + 1), X) *
        realRpow(realNat(n + 1), R[-complexRe(s)]))] by ring
    linarith
  unfold LSeriesSummable
  exact ComplexAbsolutelySummable.of_abs_le_scaled with sequence,
    absoluteZeta, dominated

-- The series of 1 converges absolutely exactly on re s > 1 (Mathlib's
-- LSeriesSummable_one_iff, Real.summable_nat_rpow_inv).
theorem LSeriesSummable.one_iff (s : Set)
  requires hs : s ∈ ℂ
  shows LSeriesSummable(oneCoefficients, s) ↔ realOne < complexRe(s)
proof
  constructor
  . intro summable
    have reS : Real(complexRe(s)) by typecheck
    by_cases above : realOne < complexRe(s)
    . exact above
    . exfalso
      have atMost := realLe.of_not_less at complexRe(s), R[1] with above
      have absolute := summable
      unfold LSeriesSummable at absolute
      obtain ⟨sequence, absSummable⟩ := absolute
      have coefficients := oneCoefficients.function
      have harmonicSequence := harmonicTerms.sequence
      have nonnegative : NonnegativeTerms(harmonicTerms)
        intros n nIn
        have nNat := nat.omega.backward with nIn
        have positive := harmonicTerms.positive at n
        have le := realLess.implies_le with positive
        have bridge := realLe.characterization at realZero, harmonicTerms(n)
        exact bridge.forward with le
      have dominated : PointwiseLE(harmonicTerms,
          complexAbsSequence(lseriesTerms(oneCoefficients, s)))
        intros n nIn
        have nNat := nat.omega.backward with nIn
        have next : n + 1 ∈ ℕ by typecheck
        have positive : 1 ≤ n + 1 by arith
        have absValue := complexAbsSequence.value with sequence
        have exponents : R[-1] ≤ R[-complexRe(s)] by linarith
        have powers := realRpow.nat_le_of_exponent with positive, exponents
        have atLeast := realNat.one_le with positive
        have basePositive : R[0] < realNat(n + 1) by linarith
        have baseReal := realNat.real at n + 1
        have inverse := realRpow.neg at realNat(n + 1), R[1] with basePositive
        have one := realRpow.one at realNat(n + 1) with basePositive
        have successor : realNat(n + 1) = R[realNat(n) + 1]
          have same : n + 1 = succ(n) by arith
          rw same
          exact realNat.successor at n
        have harmonicValue := harmonicTerms.value with nIn
        have powerReal := realRpow.real at realNat(n + 1), R[-complexRe(s)]
        have inverseReal := realInvValue.real at realNat(n + 1)
        have oneOver : R[1 / realNat(n + 1)] = realInvValue(realNat(n + 1))
          rw realDiv.eq_mul_inv
          ring
        have bridge := realLe.characterization at harmonicTerms(n),
          complexAbsSequence(lseriesTerms(oneCoefficients, s))(n)
        apply bridge.forward
        rw [absValue, (lseriesTerms.abs with coefficients, hs),
          (oneCoefficients.apply), complexAbs.one, harmonicValue,
          ← successor, ← oneOver]
        rw [inverse, one] at powers
        have unit : R[1 * realRpow(realNat(n + 1), R[-complexRe(s)])] =
            realRpow(realNat(n + 1), R[-complexRe(s)]) by ring
        rw unit
        exact powers
      have harmonic := Summable.of_nonnegative_le with harmonicSequence,
        absSummable, nonnegative, dominated
      exact harmonicSeries.not_summable with harmonic
  . intro halfPlane
    obtain ⟨_, absolute⟩ := zeta.series with hs, halfPlane
    unfold LSeriesSummable
    rw (lseriesTerms.one with hs)
    exact absolute

-- A bounded multiplier keeps summability (Mathlib's
-- DirichletCharacter.LSeriesSummable_mul).
theorem LSeriesSummable.mul_bounded (f g s : Set)
  requires fValues : FunctionBetween(f, ℕ, complexCarrier)
  requires gValues : FunctionBetween(g, ℕ, complexCarrier)
  requires hs : s ∈ ℂ
  requires bound : ∀ n ∈ ℕ, complexAbs(g(n)) ≤ R[1]
  requires summable : LSeriesSummable(f, s)
  shows LSeriesSummable(coefficientMul(g, f), s)
proof
  have product : FunctionBetween(coefficientMul(g, f), ℕ, complexCarrier)
    apply coefficientMul.maps
    intros n nIn
    have gn := FunctionBetween.apply_closed with gValues, nIn
    have fn := FunctionBetween.apply_closed with fValues, nIn
    typecheck
  have dominated : ∀ n ∈ ℕ, complexAbs(coefficientMul(g, f)(n)) ≤
      complexAbs(f(n))
    intros n nIn
    have gn := FunctionBetween.apply_closed with gValues, nIn
    have fn := FunctionBetween.apply_closed with fValues, nIn
    have gAbs := complexAbs.nonnegative with gn
    have fAbs := complexAbs.nonnegative with fn
    have gReal := complexAbs.real with gn
    have fReal := complexAbs.real with fn
    have gBound := bound with n, nIn
    rw [(coefficientMul.eval with nIn), (complexAbs.mul with gn, fn)]
    have scaled := realLe.mul_right_of_nonnegative with gBound, fAbs
    have unit : R[1 * complexAbs(f(n))] = complexAbs(f(n)) by ring
    linarith
  exact LSeriesSummable.of_abs_le with product, fValues, hs, dominated,
    summable

-- Section: The abscissa
-- Mathlib's LSeriesSummable.abscissaOfAbsConv_le.
theorem LSeriesSummable.abscissa_le (f s : Set)
  requires values : FunctionBetween(f, ℕ, complexCarrier)
  requires hs : s ∈ ℂ
  requires summable : LSeriesSummable(f, s)
  shows AbscissaAtMost(f, complexRe(s))
proof
  intros Y yIn less
  have yReal : Real(Y) by typecheck
  have reS : Real(complexRe(s)) by typecheck
  have hy : complexOfReal(Y) ∈ ℂ by typecheck
  have order : R[0] ≤ R[complexRe(complexOfReal(Y)) - complexRe(s)]
    rw complexOfReal.re
    linarith
  exact LSeriesSummable.of_re_le with values, hs, hy, order, summable

-- Mathlib's LSeriesSummable_of_abscissaOfAbsConv_lt_re.
theorem AbscissaAtMost.summable (f s : Set) (X : Real)
  requires values : FunctionBetween(f, ℕ, complexCarrier)
  requires hs : s ∈ ℂ
  requires abscissa : AbscissaAtMost(f, X)
  requires halfPlane : X < complexRe(s)
  shows LSeriesSummable(f, s)
proof
  have reS : Real(complexRe(s)) by typecheck
  have twice := half.add_self at R[X + complexRe(s)]
  have middleReal : Real(half(R[X + complexRe(s)])) by typecheck
  have middleIn : half(R[X + complexRe(s)]) ∈ ℝ by typecheck
  have above : X < half(R[X + complexRe(s)]) by linarith
  have middle := abscissa with half(R[X + complexRe(s)]), middleIn, above
  have hy : complexOfReal(half(R[X + complexRe(s)])) ∈ ℂ by typecheck
  have order : R[0] ≤
      R[complexRe(s) - complexRe(complexOfReal(half(R[X + complexRe(s)])))]
    rw complexOfReal.re
    linarith
  exact LSeriesSummable.of_re_le with values, hy, hs, order, middle

theorem AbscissaBelow.summable (f s : Set)
  requires values : FunctionBetween(f, ℕ, complexCarrier)
  requires hs : s ∈ ℂ
  requires abscissa : AbscissaBelow(f, s)
  shows LSeriesSummable(f, s)
proof
  obtain ⟨Y, yIn, below, summable⟩ := abscissa
  have yReal : Real(Y) by typecheck
  have reS : Real(complexRe(s)) by typecheck
  have hy : complexOfReal(Y) ∈ ℂ by typecheck
  have order : R[0] ≤ R[complexRe(s) - complexRe(complexOfReal(Y))]
    rw complexOfReal.re
    linarith
  exact LSeriesSummable.of_re_le with values, hy, hs, order, summable

-- The series of 1 has abscissa 1 (Mathlib's abscissaOfAbsConv_one).
theorem AbscissaAtMost.one
  shows AbscissaAtMost(oneCoefficients, R[1])
proof
  intros Y yIn above
  have yReal : Real(Y) by typecheck
  have hy : complexOfReal(Y) ∈ ℂ by typecheck
  have halfPlane : realOne < complexRe(complexOfReal(Y))
    rw complexOfReal.re
    linarith
  obtain ⟨_, absolute⟩ := zeta.series with hy, halfPlane
  unfold LSeriesSummable
  rw (lseriesTerms.one with hy)
  exact absolute

-- Section: Linearity
-- Mathlib's LSeriesHasSum.add, LSeries_add.
theorem LSeriesHasSum.add (f g s a b : Set)
  requires fValues : FunctionBetween(f, ℕ, complexCarrier)
  requires gValues : FunctionBetween(g, ℕ, complexCarrier)
  requires hs : s ∈ ℂ
  requires fSum : LSeriesHasSum(f, s, a)
  requires gSum : LSeriesHasSum(g, s, b)
  shows LSeriesHasSum(coefficientAdd(f, g), s, ℂ[a + b])
proof
  obtain ⟨fSummable, fSums⟩ := fSum
  obtain ⟨gSummable, gSums⟩ := gSum
  have aIn := ComplexSumsTo.member with fSums
  have bIn := ComplexSumsTo.member with gSums
  have sumValues : FunctionBetween(coefficientAdd(f, g), ℕ, complexCarrier)
    apply coefficientAdd.maps
    intros n nIn
    have fn := FunctionBetween.apply_closed with fValues, nIn
    have gn := FunctionBetween.apply_closed with gValues, nIn
    typecheck
  have hTerms := lseriesTerms.function with sumValues, hs
  have hSequence : ComplexSequence(lseriesTerms(coefficientAdd(f, g), s)) by
    exact hTerms
  have fTerms := lseriesTerms.function with fValues, hs
  have gTerms := lseriesTerms.function with gValues, hs
  have termValues : ∀ m ∈ ℕ, lseriesTerms(coefficientAdd(f, g), s)(m) =
      ℂ[lseriesTerms(f, s)(m) + lseriesTerms(g, s)(m)]
    intros m mIn
    have mNat := nat.omega.backward with mIn
    have next : m + 1 ∈ ℕ by typecheck
    have fn := FunctionBetween.apply_closed with fValues, next
    have gn := FunctionBetween.apply_closed with gValues, next
    have negative : ℂ[-s] ∈ ℂ by typecheck
    have power := realCpow.member at realNat(m + 1), ℂ[-s] with negative
    rw [(lseriesTerms.value with sumValues, hs, mIn),
      (lseriesTerms.value with fValues, hs, mIn),
      (lseriesTerms.value with gValues, hs, mIn), (coefficientAdd.eval with next)]
    ring
  have linear : ∀ m ∈ ℕ, lseriesTerms(coefficientAdd(f, g), s)(m) =
      ℂ[1 * lseriesTerms(f, s)(m) + 1 * lseriesTerms(g, s)(m)]
    intros m mIn
    have fm := FunctionBetween.apply_closed with fTerms, mIn
    have gm := FunctionBetween.apply_closed with gTerms, mIn
    rw (termValues with m, mIn)
    ring
  have one : ℂ[1] ∈ ℂ by typecheck
  have sums := ComplexSumsTo.linear with fSums, gSums, one, one, hSequence,
    linear
  have unit : ℂ[1 * a + 1 * b] = ℂ[a + b] by ring
  rw unit at sums
  have summable : LSeriesSummable(coefficientAdd(f, g), s)
    unfold LSeriesSummable
    unfold LSeriesSummable at fSummable
    unfold LSeriesSummable at gSummable
    apply ComplexAbsolutelySummable.of_abs_le_add with hSequence, fSummable,
      gSummable
    intros m mIn
    have fm := FunctionBetween.apply_closed with fTerms, mIn
    have gm := FunctionBetween.apply_closed with gTerms, mIn
    rw (termValues with m, mIn)
    exact complexAbs.triangle with fm, gm
  exact ⟨summable, sums⟩

theorem LSeriesHasSum.sub (f g s a b : Set)
  requires fValues : FunctionBetween(f, ℕ, complexCarrier)
  requires gValues : FunctionBetween(g, ℕ, complexCarrier)
  requires hs : s ∈ ℂ
  requires fSum : LSeriesHasSum(f, s, a)
  requires gSum : LSeriesHasSum(g, s, b)
  shows LSeriesHasSum(coefficientSub(f, g), s, ℂ[a - b])
proof
  obtain ⟨fSummable, fSums⟩ := fSum
  obtain ⟨gSummable, gSums⟩ := gSum
  have aIn := ComplexSumsTo.member with fSums
  have bIn := ComplexSumsTo.member with gSums
  have subValues : FunctionBetween(coefficientSub(f, g), ℕ, complexCarrier)
    apply coefficientSub.maps
    intros n nIn
    have fn := FunctionBetween.apply_closed with fValues, nIn
    have gn := FunctionBetween.apply_closed with gValues, nIn
    have negative := FunctionBetween.apply_closed with complexNeg.function, gn
    typecheck
  have hTerms := lseriesTerms.function with subValues, hs
  have hSequence : ComplexSequence(lseriesTerms(coefficientSub(f, g), s)) by
    exact hTerms
  have fTerms := lseriesTerms.function with fValues, hs
  have gTerms := lseriesTerms.function with gValues, hs
  have termValues : ∀ m ∈ ℕ, lseriesTerms(coefficientSub(f, g), s)(m) =
      ℂ[lseriesTerms(f, s)(m) - lseriesTerms(g, s)(m)]
    intros m mIn
    have mNat := nat.omega.backward with mIn
    have next : m + 1 ∈ ℕ by typecheck
    have fn := FunctionBetween.apply_closed with fValues, next
    have gn := FunctionBetween.apply_closed with gValues, next
    have negative : ℂ[-s] ∈ ℂ by typecheck
    have power := realCpow.member at realNat(m + 1), ℂ[-s] with negative
    rw [(lseriesTerms.value with subValues, hs, mIn),
      (lseriesTerms.value with fValues, hs, mIn),
      (lseriesTerms.value with gValues, hs, mIn), (coefficientSub.eval with next)]
    ring
  have linear : ∀ m ∈ ℕ, lseriesTerms(coefficientSub(f, g), s)(m) =
      ℂ[1 * lseriesTerms(f, s)(m) + (-1) * lseriesTerms(g, s)(m)]
    intros m mIn
    have fm := FunctionBetween.apply_closed with fTerms, mIn
    have gm := FunctionBetween.apply_closed with gTerms, mIn
    rw (termValues with m, mIn)
    ring
  have one : ℂ[1] ∈ ℂ by typecheck
  have minusOne : ℂ[-1] ∈ ℂ by typecheck
  have sums := ComplexSumsTo.linear with fSums, gSums, one, minusOne,
    hSequence, linear
  have unit : ℂ[1 * a + (-1) * b] = ℂ[a - b] by ring
  rw unit at sums
  have summable : LSeriesSummable(coefficientSub(f, g), s)
    unfold LSeriesSummable
    unfold LSeriesSummable at fSummable
    unfold LSeriesSummable at gSummable
    apply ComplexAbsolutelySummable.of_abs_le_add with hSequence, fSummable,
      gSummable
    intros m mIn
    have fm := FunctionBetween.apply_closed with fTerms, mIn
    have gm := FunctionBetween.apply_closed with gTerms, mIn
    rw (termValues with m, mIn)
    exact complexAbs.sub_le with fm, gm
  exact ⟨summable, sums⟩

-- Mathlib's LSeriesHasSum.smul.
theorem LSeriesHasSum.scale (c f s a : Set)
  requires values : FunctionBetween(f, ℕ, complexCarrier)
  requires hc : c ∈ ℂ
  requires hs : s ∈ ℂ
  requires sum : LSeriesHasSum(f, s, a)
  shows LSeriesHasSum(coefficientScale(c, f), s, ℂ[c * a])
proof
  obtain ⟨fSummable, fSums⟩ := sum
  have aIn := ComplexSumsTo.member with fSums
  have scaleValues : FunctionBetween(coefficientScale(c, f), ℕ, complexCarrier)
    apply coefficientScale.maps
    intros n nIn
    have fn := FunctionBetween.apply_closed with values, nIn
    typecheck
  have hTerms := lseriesTerms.function with scaleValues, hs
  have hSequence : ComplexSequence(lseriesTerms(coefficientScale(c, f), s)) by
    exact hTerms
  have fTerms := lseriesTerms.function with values, hs
  have termValues : ∀ m ∈ ℕ, lseriesTerms(coefficientScale(c, f), s)(m) =
      ℂ[c * lseriesTerms(f, s)(m)]
    intros m mIn
    have mNat := nat.omega.backward with mIn
    have next : m + 1 ∈ ℕ by typecheck
    have fn := FunctionBetween.apply_closed with values, next
    have negative : ℂ[-s] ∈ ℂ by typecheck
    have power := realCpow.member at realNat(m + 1), ℂ[-s] with negative
    rw [(lseriesTerms.value with scaleValues, hs, mIn),
      (lseriesTerms.value with values, hs, mIn),
      (coefficientScale.eval with next)]
    ring
  have zero : ℂ[0] ∈ ℂ by typecheck
  have linear : ∀ m ∈ ℕ, lseriesTerms(coefficientScale(c, f), s)(m) =
      ℂ[c * lseriesTerms(f, s)(m) + 0 * lseriesTerms(f, s)(m)]
    intros m mIn
    have fm := FunctionBetween.apply_closed with fTerms, mIn
    rw (termValues with m, mIn)
    ring
  have sums := ComplexSumsTo.linear with fSums, fSums, hc, zero, hSequence,
    linear
  have unit : ℂ[c * a + 0 * a] = ℂ[c * a] by ring
  rw unit at sums
  have summable : LSeriesSummable(coefficientScale(c, f), s)
    unfold LSeriesSummable
    unfold LSeriesSummable at fSummable
    apply ComplexAbsolutelySummable.of_abs_le_scaled at
      lseriesTerms(coefficientScale(c, f), s), lseriesTerms(f, s), complexAbs(c)
      with hSequence, fSummable
    intros m mIn
    have fm := FunctionBetween.apply_closed with fTerms, mIn
    rw [(termValues with m, mIn), (complexAbs.mul with hc, fm)]
    have absC := complexAbs.real with hc
    have absF := complexAbs.real with fm
    linarith
  exact ⟨summable, sums⟩

-- Coefficients that agree have the same series.
theorem tkKLSeriesHasSum.congr (f g s a : Set)
  requires fValues : FunctionBetween(f, ℕ, complexCarrier)
  requires gValues : FunctionBetween(g, ℕ, complexCarrier)
  requires hs : s ∈ ℂ
  requires same : ∀ n ∈ ℕ, f(n) = g(n)
  requires fSum : LSeriesHasSum(f, s, a)
  shows LSeriesHasSum(g, s, a)
proof
  have nonzero : ∀ n ∈ ℕ, n ≠ (0:N) → f(n) = g(n)
    intros n nIn _
    exact same with n, nIn
  have terms := lseriesTerms.congr with fValues, gValues, hs, nonzero
  unfold LSeriesHasSum
  unfold LSeriesHasSum at fSum
  unfold LSeriesSummable
  unfold LSeriesSummable at fSum
  rwa terms at fSum

-- Vanishing coefficients sum to 0.
theorem tkKLSeriesHasSum.zero (g s : Set)
  requires gValues : FunctionBetween(g, ℕ, complexCarrier)
  requires hs : s ∈ ℂ
  requires vanish : ∀ n ∈ ℕ, g(n) = ℂ[0]
  shows LSeriesHasSum(g, s, ℂ[0])
proof
  have terms := lseriesTerms.function with gValues, hs
  have sequence : ComplexSequence(lseriesTerms(g, s)) by exact terms
  have termZero : ∀ m ∈ ℕ, lseriesTerms(g, s)(m) = ℂ[0]
    intros m mIn
    have mNat := nat.omega.backward with mIn
    have next : m + 1 ∈ ℕ by typecheck
    have negative : ℂ[-s] ∈ ℂ by typecheck
    have power := realCpow.member at realNat(m + 1), ℂ[-s] with negative
    rw [(lseriesTerms.value with gValues, hs, mIn), (vanish with m + 1, next)]
    ring
  have zeroSums := SumsTo.zero
  have zeroSummable := SumsTo.summable with zeroSums
  have summable : ComplexAbsolutelySummable(lseriesTerms(g, s))
    apply ComplexAbsolutelySummable.of_bound with sequence, zeroSummable
    intros n nIn
    have nNat := nat.omega.backward with nIn
    rw [(termZero with n, nIn), complexAbs.zero,
      (constantSequence.value at (0:R), n)]
    linarith
  have later : ∀ m ∈ ℕ, lseriesTerms(g, s)(succ(m)) = ℂ[0]
    intros m mIn
    have mNat := nat.omega.backward with mIn
    have next : succ(m) ∈ ℕ by typecheck
    exact termZero with succ(m), next
  have sums := ComplexSumsTo.single with sequence, later
  have zero : (0:N) ∈ ℕ by typecheck
  rw (termZero with (0:N), zero) at sums
  unfold LSeriesHasSum
  unfold LSeriesSummable
  exact ⟨summable, sums⟩

-- A complex finite sum over insert(b, V) splits off the term at b.
theorem tkKcomplexSum.insert (V D w b : Set)
  requires finite : Finite(V)
  requires function : w : D → complexCarrier
  requires subset : insert(b, V) ⊆ D
  requires fresh : ¬(b ∈ V)
  shows finiteRingSum(insert(b, V), complexCarrier, complexAdd, complexZero,
      complexNeg, complexMul, complexOne, w) =
    ℂ[finiteRingSum(V, complexCarrier, complexAdd, complexZero, complexNeg,
      complexMul, complexOne, restrict(w, V)) + w(b)]
proof
  have ring := complexes.comm_ring
  have first := finiteRingSum.restrict_weights at insert(b, V), D,
    complexCarrier, complexAdd, complexZero, complexNeg, complexMul,
    complexOne, w with subset, function
  have weights := restrict.domain_function at w, D, complexCarrier,
    insert(b, V) with function, subset
  have step := finiteRingSum.insert at V, complexCarrier, complexAdd,
    complexZero, complexNeg, complexMul, complexOne, restrict(w, insert(b, V)),
    b with ring, finite, weights, fresh
  have inner : V ⊆ insert(b, V)
    intros x hx
    exact insert.contains with hx
  have nested := restrict.nested at w, V, insert(b, V) with inner
  have self := insert.self at b, V
  have value := restrict.domain_apply at w, D, complexCarrier, insert(b, V), b
    with function, subset, self
  rw [first, step, nested, value]
  rfl

-- The summed coefficients at n.
theorem tkKcoefficientFamilySum.eval (F I n : Set)
  requires index : n ∈ ℕ
  shows coefficientFamilySum(F, I)(n) = finiteRingSum(I, complexCarrier,
    complexAdd, complexZero, complexNeg, complexMul, complexOne,
    familyValues(F, n, I))
proof
  have shape : ∀ p ∈ coefficientFamilySum(F, I), ∃ a ∈ ℕ, ∃ b, p = (a, b)
    by
    intros p hp
    simp [coefficientFamilySum] at hp
    obtain ⟨m, mIn, eq⟩ := hp
    rw ← eq
    exact ⟨m, mIn, finiteRingSum(I, complexCarrier, complexAdd, complexZero,
      complexNeg, complexMul, complexOne, familyValues(F, m, I)), rfl⟩
  have total : ∀ a ∈ ℕ, ∃ b, (a, b) ∈ coefficientFamilySum(F, I) by
    intros a aIn
    refine ⟨finiteRingSum(I, complexCarrier, complexAdd, complexZero,
      complexNeg, complexMul, complexOne, familyValues(F, a, I)), ?_⟩
    simp [coefficientFamilySum]
  have functional : ∀ a, ∀ b, ∀ c, (a, b) ∈ coefficientFamilySum(F, I) →
      (a, c) ∈ coefficientFamilySum(F, I) → b = c by
    intros a b c ab ac
    simp [coefficientFamilySum] at ab
    simp [coefficientFamilySum] at ac
    obtain ⟨m, _, abEq⟩ := ab
    obtain ⟨k, _, acEq⟩ := ac
    obtain ⟨ma, mb⟩ := orderedPair.injective with abEq
    obtain ⟨ka, kc⟩ := orderedPair.injective with acEq
    cc
  have mapped : (n, finiteRingSum(I, complexCarrier, complexAdd, complexZero,
      complexNeg, complexMul, complexOne, familyValues(F, n, I))) ∈
      coefficientFamilySum(F, I) by
    simp [coefficientFamilySum]
  exact coefficientGraph.apply with shape, total, functional, index, mapped

-- The summed coefficients of a finite family form a function.
theorem tkKcoefficientFamilySum.function (F I : Set)
  requires finite : Finite(I)
  requires values : ∀ i ∈ I, FunctionBetween(F(i), ℕ, complexCarrier)
  shows FunctionBetween(coefficientFamilySum(F, I), ℕ, complexCarrier)
proof
  have ring := complexes.comm_ring
  have closed : ∀ m ∈ ℕ, finiteRingSum(I, complexCarrier, complexAdd,
      complexZero, complexNeg, complexMul, complexOne,
      familyValues(F, m, I)) ∈ ℂ by
    intros m mIn
    have weights : familyValues(F, m, I) : I → complexCarrier by
      apply familyValues.maps
      intros i hi
      exact FunctionBetween.apply_closed with (values with i, hi), mIn
    exact finiteRingSum.closed with ring, finite, weights
  have shape : ∀ p ∈ coefficientFamilySum(F, I), ∃ a ∈ ℕ,
      ∃ b ∈ complexCarrier, p = (a, b) by
    intros p hp
    simp [coefficientFamilySum] at hp
    obtain ⟨m, mIn, eq⟩ := hp
    rw ← eq
    exact ⟨m, mIn, finiteRingSum(I, complexCarrier, complexAdd, complexZero,
      complexNeg, complexMul, complexOne, familyValues(F, m, I)),
      (closed with m, mIn), rfl⟩
  have total : ∀ a ∈ ℕ, ∃ b ∈ complexCarrier,
      (a, b) ∈ coefficientFamilySum(F, I) by
    intros a aIn
    refine ⟨finiteRingSum(I, complexCarrier, complexAdd, complexZero,
      complexNeg, complexMul, complexOne, familyValues(F, a, I)),
      (closed with a, aIn), ?_⟩
    simp [coefficientFamilySum]
  have functional : ∀ a, ∀ b, ∀ c, (a, b) ∈ coefficientFamilySum(F, I) →
      (a, c) ∈ coefficientFamilySum(F, I) → b = c by
    intros a b c ab ac
    simp [coefficientFamilySum] at ab
    simp [coefficientFamilySum] at ac
    obtain ⟨m, _, abEq⟩ := ab
    obtain ⟨k, _, acEq⟩ := ac
    obtain ⟨ma, mb⟩ := orderedPair.injective with abEq
    obtain ⟨ka, kc⟩ := orderedPair.injective with acEq
    cc
  exact coefficientGraph.function with shape, total, functional

-- The subsets J of I on which the finite family sums.
def tkKfamilyGood (F I a s : Set) : Set :=
  { J ∈ 𝒫(I) |
    LSeriesHasSum(coefficientFamilySum(F, J), s, complexFamilySum(a, J)) }

-- Mathlib's LSeriesHasSum.sum: a finite sum of series.
theorem LSeriesHasSum.family_sum (F I a s : Set)
  requires finite : Finite(I)
  requires values : ∀ i ∈ I, FunctionBetween(F(i), ℕ, complexCarrier)
  requires sums : FunctionBetween(a, I, complexCarrier)
  requires hs : s ∈ ℂ
  requires each : ∀ i ∈ I, LSeriesHasSum(F(i), s, a(i))
  shows LSeriesHasSum(coefficientFamilySum(F, I), s, complexFamilySum(a, I))
proof
  have ring := complexes.comm_ring
  have emptySub : ∅ ⊆ I
    intros x hx
    exfalso
    exact set.empty with hx
  have base : ∅ ∈ tkKfamilyGood(F, I, a, s)
    apply tkKfamilyGood.membership.backward
    refine ⟨(powerset.membership_iff.backward with emptySub), ?_⟩
    have finiteE := Finite.empty
    have valuesE : ∀ i ∈ ∅, FunctionBetween(F(i), ℕ, complexCarrier)
      intros i hi
      exfalso
      exact set.empty with hi
    have coeffs := tkKcoefficientFamilySum.function at F, ∅ with finiteE,
      valuesE
    have vanish : ∀ n ∈ ℕ, coefficientFamilySum(F, ∅)(n) = ℂ[0]
      intros n nIn
      have weights : familyValues(F, n, ∅) : ∅ → complexCarrier
        apply familyValues.maps
        intros i hi
        exfalso
        exact set.empty with hi
      rw [(tkKcoefficientFamilySum.eval with nIn),
        (finiteRingSum.empty with ring, weights)]
    have restricted := restrict.domain_function with sums, emptySub
    have sumZero : complexFamilySum(a, ∅) = ℂ[0]
      unfold complexFamilySum
      rw [(finiteRingSum.restrict_weights at ∅, I, complexCarrier, complexAdd,
        complexZero, complexNeg, complexMul, complexOne, a with emptySub, sums),
        (finiteRingSum.empty with ring, restricted)]
    rw sumZero
    exact tkKLSeriesHasSum.zero with coeffs, hs, vanish
  have step : ∀ J ⊆ I, Finite(J) → ∀ b ∈ I, b ∉ J →
      J ∈ tkKfamilyGood(F, I, a, s) → J ∪ {b} ∈ tkKfamilyGood(F, I, a, s)
    intros J sub finJ b bI bNot good
    obtain ⟨_, hasJ⟩ := tkKfamilyGood.membership.forward with good
    have kEq : J ∪ {b} = insert(b, J)
      unfold insert
      exact union2.commutative at J, {b}
    have finK := Finite.union with finJ, (Finite.singleton at b)
    rw kEq at finK
    rw kEq
    have kSub : insert(b, J) ⊆ I
      intros x hx
      cases (insert.membership.forward with hx) with isB | inJ
      . rw isB
        exact bI
      . exact sub with x, inJ
    have kSelf := Subset.reflexive at insert(b, J)
    have valuesJ : ∀ i ∈ J, FunctionBetween(F(i), ℕ, complexCarrier)
      intros i hi
      exact values with i, (sub with i, hi)
    have valuesK : ∀ i ∈ insert(b, J), FunctionBetween(F(i), ℕ, complexCarrier)
      intros i hi
      exact values with i, (kSub with i, hi)
    have fJ := tkKcoefficientFamilySum.function at F, J with finJ, valuesJ
    have fK := tkKcoefficientFamilySum.function at F, insert(b, J) with finK,
      valuesK
    have fb := values with b, bI
    have added := LSeriesHasSum.add with fJ, fb, hs, hasJ, (each with b, bI)
    have addValues : FunctionBetween(coefficientAdd(coefficientFamilySum(F, J),
        F(b)), ℕ, complexCarrier)
      apply coefficientAdd.maps
      intros n nIn
      have first := FunctionBetween.apply_closed with fJ, nIn
      have second := FunctionBetween.apply_closed with fb, nIn
      typecheck
    have same : ∀ n ∈ ℕ, coefficientAdd(coefficientFamilySum(F, J), F(b))(n) =
        coefficientFamilySum(F, insert(b, J))(n)
      intros n nIn
      have wK : familyValues(F, n, insert(b, J)) : insert(b, J) → complexCarrier
        apply familyValues.maps
        intros i hi
        exact FunctionBetween.apply_closed with (valuesK with i, hi), nIn
      have wJ : familyValues(F, n, J) : J → complexCarrier
        apply familyValues.maps
        intros i hi
        exact FunctionBetween.apply_closed with (valuesJ with i, hi), nIn
      have inner : J ⊆ insert(b, J)
        intros x hx
        exact insert.contains with hx
      have rJ := restrict.domain_function with wK, inner
      have agree : ∀ x ∈ J,
          restrict(familyValues(F, n, insert(b, J)), J)(x) =
            familyValues(F, n, J)(x)
        intros x hx
        have xK := inner with x, hx
        rw [(restrict.domain_apply with wK, inner, hx),
          (familyValues.eval with xK), (familyValues.eval with hx)]
      have congr := finiteRingSum.congr with ring, finJ, rJ, wJ, agree
      have split := tkKcomplexSum.insert with finJ, wK, kSelf, bNot
      have self := insert.self at b, J
      rw [(coefficientAdd.eval with nIn), (tkKcoefficientFamilySum.eval with nIn),
        split,
        congr, (familyValues.eval with self)]
    have moved := tkKLSeriesHasSum.congr with addValues, fK, hs, same, added
    have sumEq : complexFamilySum(a, insert(b, J)) =
        ℂ[complexFamilySum(a, J) + a(b)]
      unfold complexFamilySum
      rw [(tkKcomplexSum.insert with finJ, sums, kSub, bNot),
        (finiteRingSum.restrict_weights at J, I, complexCarrier, complexAdd,
        complexZero, complexNeg, complexMul, complexOne, a with sub, sums)]
    rw ← sumEq at moved
    apply tkKfamilyGood.membership.backward
    exact ⟨(powerset.membership_iff.backward with kSub), moved⟩
  have all := Finite.induction with base, step
  have member := all with I, (Subset.reflexive at I), finite
  obtain ⟨_, result⟩ := tkKfamilyGood.membership.forward with member
  exact result

-- Section: Convolution
-- The series of a convolution is the product of the series (Mathlib's
-- LSeriesHasSum.convolution, LSeries_convolution').
theorem LSeriesHasSum.convolution (f g s : Set)
  requires fValues : FunctionBetween(f, ℕ, complexCarrier)
  requires gValues : FunctionBetween(g, ℕ, complexCarrier)
  requires hs : s ∈ ℂ
  requires fSummable : LSeriesSummable(f, s)
  requires gSummable : LSeriesSummable(g, s)
  shows LSeriesHasSum(dirichletConvolution(f, g), s,
    ℂ[LSeries(f, s) * LSeries(g, s)])
proof
  sorry

-- Convolution with 1 sums over divisors (Mathlib's
-- ArithmeticFunction.coe_mul_zeta_apply).
theorem dirichletConvolution.one_right (f : Set) (n : Nat)
  requires values : FunctionBetween(f, ℕ, complexCarrier)
  shows dirichletConvolution(f, oneCoefficients)(n) =
    complexFamilySum(f, divisorSet(n))
proof
  sorry

-- A completely multiplicative twist distributes over convolution
-- (Mathlib's LSeries.mul_convolution_distrib).
theorem dirichletConvolution.twist (χ f g : Set) (n : Nat)
  requires multiplicative : CompletelyMultiplicative(χ)
  requires fValues : FunctionBetween(f, ℕ, complexCarrier)
  requires gValues : FunctionBetween(g, ℕ, complexCarrier)
  shows coefficientMul(χ, dirichletConvolution(f, g))(n) =
    dirichletConvolution(coefficientMul(χ, f), coefficientMul(χ, g))(n)
proof
  obtain ⟨χValues, _, χMul⟩ := multiplicative
  have nMember : n ∈ ℕ by typecheck
  have χf : FunctionBetween(coefficientMul(χ, f), ℕ, complexCarrier)
    apply coefficientMul.maps
    intros k kIn
    have first := FunctionBetween.apply_closed with χValues, kIn
    have second := FunctionBetween.apply_closed with fValues, kIn
    typecheck
  have χg : FunctionBetween(coefficientMul(χ, g), ℕ, complexCarrier)
    apply coefficientMul.maps
    intros k kIn
    have first := FunctionBetween.apply_closed with χValues, kIn
    have second := FunctionBetween.apply_closed with gValues, kIn
    typecheck
  have χn := FunctionBetween.apply_closed with χValues, nMember
  have subset := cldDdivisors.naturals at n
  have finite := cldDdivisors.finite at n
  have t1 := convolutionTerms.function at f, g, n with fValues, gValues
  have t2 := convolutionTerms.function at coefficientMul(χ, f),
    coefficientMul(χ, g), n with χf, χg
  have closed1 : ∀ x ∈ dirichletDivisors(n),
      convolutionTerms(f, g, n)(x) ∈ complexCarrier
    intros x hx
    have xIn := subset with x, hx
    exact FunctionBetween.apply_closed with t1, xIn
  have closed2 : ∀ x ∈ dirichletDivisors(n),
      convolutionTerms(coefficientMul(χ, f), coefficientMul(χ, g), n)(x) ∈
        complexCarrier
    intros x hx
    have xIn := subset with x, hx
    exact FunctionBetween.apply_closed with t2, xIn
  have r1 := restrict.function with t1, subset, closed1
  have r2 := restrict.function with t2, subset, closed2
  have same1 : complexFamilySum(convolutionTerms(f, g, n),
      dirichletDivisors(n)) = complexFamilySum(restrict(convolutionTerms(f, g,
        n), dirichletDivisors(n)), dirichletDivisors(n))
    unfold complexFamilySum
    exact finiteRingSum.restrict_weights with subset, t1
  have same2 : complexFamilySum(convolutionTerms(coefficientMul(χ, f),
      coefficientMul(χ, g), n), dirichletDivisors(n)) =
      complexFamilySum(restrict(convolutionTerms(coefficientMul(χ, f),
        coefficientMul(χ, g), n), dirichletDivisors(n)), dirichletDivisors(n))
    unfold complexFamilySum
    exact finiteRingSum.restrict_weights with subset, t2
  rw [(coefficientMul.eval with nMember),
    (dirichletConvolution.value with fValues, gValues, nMember),
    (dirichletConvolution.value with χf, χg, nMember), same1, same2]
  symm
  apply cldDsum.scale with finite, r1, r2, χn
  intros d hd
  have dIn := subset with d, hd
  have dNat := nat.omega.backward with dIn
  obtain ⟨inner, nonempty⟩ := dirichletDivisors.membership.forward with hd
  obtain ⟨_, divides⟩ := divisorSet.membership.forward with inner
  have nonzero : n ≠ (0:N)
    intro zero
    rw nat.zero at zero
    exact nonempty with zero
  have dNonzero := divides.nonzero with divides, nonzero
  have quotient := quotientNat.natural at d, n
  have qMember : quotientNat(n, d) ∈ ℕ by typecheck
  have equation := divides.quotient_equation with dNonzero, divides
  have split := χMul with d, dIn, quotientNat(n, d), qMember
  rw ← equation at split
  have χd := FunctionBetween.apply_closed with χValues, dIn
  have χq := FunctionBetween.apply_closed with χValues, qMember
  have fd := FunctionBetween.apply_closed with fValues, dIn
  have gq := FunctionBetween.apply_closed with gValues, qMember
  rw [(restrict.domain_apply with t2, subset, hd),
    (restrict.domain_apply with t1, subset, hd),
    (convolutionTerms.value at coefficientMul(χ, f), coefficientMul(χ, g), n,
      d with χf, χg, dIn),
    (convolutionTerms.value at f, g, n, d with fValues, gValues, dIn),
    (coefficientMul.eval with dIn), (coefficientMul.eval with qMember), split]
  ring

-- Section: Derivatives
-- Absolute convergence of log(n) f(n) n^(−s) left of the abscissa
-- (Mathlib's LSeriesSummable_logMul_of_lt_re).
theorem LSeriesSummable.logMul (f s : Set)
  requires values : FunctionBetween(f, ℕ, complexCarrier)
  requires hs : s ∈ ℂ
  requires abscissa : AbscissaBelow(f, s)
  shows LSeriesSummable(logMulCoefficients(f), s)
proof
  sorry

-- The sum is holomorphic right of the abscissa (Mathlib's
-- LSeries_differentiableOn).
theorem LSeriesMap.holomorphic (f : Set) (X : Real)
  requires values : FunctionBetween(f, ℕ, complexCarrier)
  requires abscissa : AbscissaAtMost(f, X)
  shows HolomorphicOn(LSeriesMap(f), rightHalfPlane(X))
proof
  sorry

-- and is differentiated term by term: the derivative is
-- −Σ log(n) f(n) n^(−s) (Mathlib's LSeries_hasDerivAt, LSeries_deriv).
theorem LSeriesMap.deriv (f s : Set) (X : Real)
  requires values : FunctionBetween(f, ℕ, complexCarrier)
  requires abscissa : AbscissaAtMost(f, X)
  requires halfPlane : X < complexRe(s)
  requires hs : s ∈ ℂ
  shows complexDeriv(LSeriesMap(f), rightHalfPlane(X))(s) =
    ℂ[-LSeries(logMulCoefficients(f), s)]
proof
  sorry

-- Section: Summation by parts
-- a^(−S) − (a + 1)^(−S) ≤ S a^(−S−1) for a > 0 and S ≥ 0.
theorem tkKrpow.step_le (A S : Real)
  requires positive : R[0] < A
  requires nonneg : R[0] ≤ S
  shows R[realRpow(A, R[-S]) - realRpow(R[A + 1], R[-S])] ≤
    R[S * realRpow(A, R[-S - 1])]
proof
  have bPositive : R[0] < R[A + 1] by linarith
  have aNonzero : A ≠ R[0] by linarith
  have invPositive := realInvValue.positive at A with positive
  have invReal := realInvValue.real at A
  have cancel := realInvValue.mul_left at A with aNonzero
  have logA := realLog.real at A
  have logB := realLog.real at R[A + 1]
  have qPositive := realMulValue.positive at R[A + 1], realInvValue(A) with
    bPositive, invPositive
  have logQ := realLog.mul at R[A + 1], realInvValue(A) with bPositive,
    invPositive
  have invShape : realInvValue(A) = R[1 / A]
    rw realDiv.eq_mul_inv
    ring
  have logInv := realLog.inv at A with positive
  rw ← invShape at logInv
  rw logInv at logQ
  have sub := realLog.le_sub_one at R[(A + 1) * realInvValue(A)] with qPositive
  rw logQ at sub
  -- D = log(A + 1) − log A ≤ 1/A
  have qShape : R[(A + 1) * realInvValue(A) - 1] = realInvValue(A) by
    linear_combination cancel
  have dBound : R[realLog(R[A + 1]) - realLog(A)] ≤ realInvValue(A) by
    linarith
  have expL := realExp.positive at R[-S * realLog(A)]
  have expLReal : realExp(R[-S * realLog(A)]) ∈ ℝ by typecheck
  have split := realExp.add at R[-S * realLog(A)],
    R[-S * (realLog(R[A + 1]) - realLog(A))]
  have sameExp : R[-S * realLog(A) + -S * (realLog(R[A + 1]) - realLog(A))] =
      R[-S * realLog(R[A + 1])] by ring
  rw sameExp at split
  have lower := realExp.one_add_le at R[-S * (realLog(R[A + 1]) - realLog(A))]
  have expD := realExp.real at R[-S * (realLog(R[A + 1]) - realLog(A))]
  have scaledD := realLe.mul_left_of_nonnegative with dBound, nonneg
  have negEq : R[-S * (realLog(R[A + 1]) - realLog(A))] =
      R[-(S * (realLog(R[A + 1]) - realLog(A)))] by ring
  have chain : R[1 - S * realInvValue(A)] ≤
      realExp(R[-S * (realLog(R[A + 1]) - realLog(A))]) by linarith
  have expLNonneg : R[0] ≤ realExp(R[-S * realLog(A)]) by linarith
  have scaled := realLe.mul_left_of_nonnegative with chain, expLNonneg
  -- e^(−log A) = 1/A
  have expNeg := realExp.add at R[-realLog(A)], realLog(A)
  have zero : R[-realLog(A) + realLog(A)] = R[0] by ring
  rw [zero, realExp.zero, (realLog.exp with positive)] at expNeg
  have expNegReal := realExp.real at R[-realLog(A)]
  have inverse : realExp(R[-realLog(A)]) = realInvValue(A) by
    linear_combination -realInvValue(A) * expNeg - realExp(R[-realLog(A)]) *
      cancel
  have splitR := realExp.add at R[-S * realLog(A)], R[-realLog(A)]
  have sameR : R[-S * realLog(A) + -realLog(A)] = R[(-S - 1) * realLog(A)] by
    ring
  rw [sameR, inverse] at splitR
  have expand : R[realExp(R[-S * realLog(A)]) * (1 - S * realInvValue(A))] =
      R[realExp(R[-S * realLog(A)]) - S * (realExp(R[-S * realLog(A)]) *
        realInvValue(A))] by ring
  unfold realRpow
  rw [splitR, split]
  linarith

-- k ↦ (k + 1)^(−S).
defgraph tkKweights (S : Real) (k ∈ ℕ) : ℝ := realRpow(realNat(k + 1), R[-S])
proof
  have kNat := nat.omega.backward with member
  exact realRpow.real at realNat(k + 1), R[-S]

-- (a + 1)^(−S) ≤ a^(−S) for a > 0 and S ≥ 0.
theorem tkKrpow.antitone (A S : Real)
  requires positive : R[0] < A
  requires nonneg : R[0] ≤ S
  shows realRpow(R[A + 1], R[-S]) ≤ realRpow(A, R[-S])
proof
  have less : A < R[A + 1] by linarith
  have logLess := realLog.strictly_increasing with positive, less
  have logA := realLog.real at A
  have logB := realLog.real at R[A + 1]
  have logLe := realLess.implies_le with logLess
  have scaled := realLe.mul_left_of_nonnegative with logLe, nonneg
  have e1 : R[-S * realLog(R[A + 1])] = R[-(S * realLog(R[A + 1]))] by ring
  have e2 : R[-S * realLog(A)] = R[-(S * realLog(A))] by ring
  have order : R[-S * realLog(R[A + 1])] ≤ R[-S * realLog(A)] by linarith
  unfold realRpow
  exact realExp.monotone with order

-- Partial sums of nonnegative terms grow with the number of terms.
theorem tkKpartial.mono (u : Set, m n : Nat)
  requires sequence : RealSequence(u)
  requires nonneg : NonnegativeTerms(u)
  requires order : m ≤ n
  shows (∑ i < m, u(i):R) ≤ (∑ i < n, u(i):R)
proof
  have increasing := prefixSums.nondecreasing with sequence, nonneg
  have mIn : m ∈ ℕ by typecheck
  have nIn : n ∈ ℕ by typecheck
  have raw := increasing with m, mIn, n, nIn, order
  rw [(prefixSums.value at u, m with mIn), (prefixSums.value at u, n with nIn)]
    at raw
  exact realLe.characterization.backward with raw

-- Nonnegative terms with bounded partial sums are summable.
theorem tkKSummable.of_partial_bound (u : Set, B : Real)
  requires sequence : RealSequence(u)
  requires nonneg : NonnegativeTerms(u)
  requires bound : ∀ n ∈ ℕ, (∑ i < n, u(i):R) ≤ B
  shows Summable(u)
proof
  have partials := prefixSums.sequence with sequence
  have increasing := prefixSums.nondecreasing with sequence, nonneg
  have bounded : BoundedAboveBy(prefixSums(u), B)
    intros n nIn
    have nNat := nat.omega.backward with nIn
    have atN := bound with n, nIn
    have partialReal := realPartialSum.real at u, n
    apply realLe.characterization.forward
    rw prefixSums.value at u, n with nIn
    linarith
  have inhabited := RealSequence.range_nonempty with partials
  have rangeUpper := BoundedAboveBy.range_upper_bound with partials, bounded
  have least := realSup.least_upper_bound with inhabited, rangeUpper
  have supUpper : RealUpperBound(range(prefixSums(u)),
      realSup(range(prefixSums(u)))) by simp [RealLeastUpperBound]
  rcases supUpper with ⟨supReal, _, _⟩
  have converges := Nondecreasing.converges_to_supremum with partials,
    increasing, bounded
  have sums := SumsTo.of_converges with sequence, converges
  exact SumsTo.summable with sums

-- Summatory functions Σ_{k≤n} |f(k)| = O(n^r), 0 ≤ r < re s, give absolute
-- convergence (Mathlib's LSeriesSummable_of_sum_norm_bigO; the O-bound at
-- infinity is written out).
theorem LSeriesSummable.of_summatory_bound (f s : Set) (X : Real)
  requires values : FunctionBetween(f, ℕ, complexCarrier)
  requires hs : s ∈ ℂ
  requires nonneg : R[0] ≤ X
  requires bound : ∃ C ∈ ℝ, ∃ M ∈ ℕ, ∀ n ∈ ℕ, M ≤ n →
    summatoryAbs(f, n) ≤ R[C * realRpow(realNat(n), X)]
  requires halfPlane : X < complexRe(s)
  shows LSeriesSummable(f, s)
proof
  obtain ⟨C, hC, M, hM, boundM⟩ := bound
  have σMember := complexRe.real with hs
  have σT : Real(complexRe(s)) by typecheck
  have σNonneg : R[0] ≤ complexRe(s) by linarith
  have cT : Real(C) by typecheck
  have mNat := nat.omega.backward with hM
  have absolute := absCoefficients.function with values
  have uSeq : RealSequence(absCoefficients(f)) by exact absolute
  have uValue : ∀ k ∈ ℕ, R[0] ≤ absCoefficients(f)(k)
    intros k kIn
    have kNat := nat.omega.backward with kIn
    have index : k + 1 ∈ ℕ by typecheck
    have value := FunctionBetween.apply_closed with values, index
    have absNonneg := complexAbs.nonnegative with value
    rw (absCoefficients.value with values, kIn)
    linarith
  have uNonneg : NonnegativeTerms(absCoefficients(f))
    intros k kIn
    have atK := uValue with k, kIn
    exact realLe.characterization.forward with atK
  have weights := tkKweights.function at complexRe(s)
  have vSeq : RealSequence(tkKweights(complexRe(s))) by exact weights
  -- K = |C| + U(M) bounds U(n) ≤ K n^X for n ≥ 1.
  have uMReal := realPartialSum.real at absCoefficients(f), M
  have zeroLe : (0:N) ≤ M by arith
  have uMNonneg := tkKpartial.mono at absCoefficients(f), (0:N), M with uSeq,
    uNonneg, zeroLe
  rw realPartialSum.zero at uMNonneg
  have absC := abs.nonnegative at C
  have upperC := abs.upper at C
  have kNonneg : R[0] ≤ R[abs(C) + ∑ i < M, absCoefficients(f)(i)] by linarith
  have uBound : ∀ n ∈ ℕ, (1:N) ≤ n → (∑ i < n, absCoefficients(f)(i):R) ≤
      R[(abs(C) + ∑ i < M, absCoefficients(f)(i)) * realRpow(realNat(n), X)]
    intros n nIn one
    have nNat := nat.omega.backward with nIn
    have powPositive := realRpow.positive at realNat(n), X
    have powReal := realRpow.real at realNat(n), X
    have powNonneg : R[0] ≤ realRpow(realNat(n), X) by linarith
    have powOne := realRpow.nat_le_of_exponent at n, R[0], X with one, nonneg
    rw realRpow.zero at powOne
    have partialReal := realPartialSum.real at absCoefficients(f), n
    have expand : R[(abs(C) + ∑ i < M, absCoefficients(f)(i)) *
        realRpow(realNat(n), X)] = R[abs(C) * realRpow(realNat(n), X) +
        (∑ i < M, absCoefficients(f)(i)) * realRpow(realNat(n), X)] by ring
    have restNonneg := realMulValue.nonnegative at ∑ i < M,
      absCoefficients(f)(i), realRpow(realNat(n), X) with uMNonneg, powNonneg
    have absNonneg := realMulValue.nonnegative at abs(C),
      realRpow(realNat(n), X) with absC, powNonneg
    by_cases large : M ≤ n
    . have atN := boundM with n, nIn, large
      unfold summatoryAbs at atN
      have absLe := realLe.mul_right_of_nonnegative with upperC, powNonneg
      linarith
    . have small : n ≤ M by arith
      have mono := tkKpartial.mono at absCoefficients(f), n, M with uSeq,
        uNonneg, small
      have scaled := realLe.mul_left_of_nonnegative with powOne, uMNonneg
      have unit : R[(∑ i < M, absCoefficients(f)(i)) * 1] =
        (∑ i < M, absCoefficients(f)(i)) by ring
      linarith
  -- The p-series Σ (k + 1)^(X − σ − 1) converges.
  have wMember : complexOfReal(R[complexRe(s) + 1 - X]) ∈ ℂ by typecheck
  have reW := complexOfReal.re at R[complexRe(s) + 1 - X]
  have wHalf : realOne < complexRe(complexOfReal(R[complexRe(s) + 1 - X]))
    rw reW
    linarith
  have oneSummable := (LSeriesSummable.one_iff with wMember).backward with
    wHalf
  unfold LSeriesSummable at oneSummable
  obtain ⟨oneSeq, pSummable⟩ := oneSummable
  have oneValues := oneCoefficients.function
  have pFunction := complexAbsSequence.function with oneSeq
  have pSeq : RealSequence(complexAbsSequence(lseriesTerms(oneCoefficients,
      complexOfReal(R[complexRe(s) + 1 - X])))) by exact pFunction
  have pValue : ∀ k ∈ ℕ, complexAbsSequence(lseriesTerms(oneCoefficients,
      complexOfReal(R[complexRe(s) + 1 - X])))(k) =
      realRpow(realNat(k + 1), R[X - complexRe(s) - 1])
    intros k kIn
    have kNat := nat.omega.backward with kIn
    have exponent : R[-R[complexRe(s) + 1 - X]] = R[X - complexRe(s) - 1] by
      ring
    rw [(complexAbsSequence.value with oneSeq, kIn),
      (lseriesTerms.abs at oneCoefficients, complexOfReal(R[complexRe(s) + 1 -
        X]), k with oneValues, wMember), oneCoefficients.apply, complexAbs.one,
      reW, exponent]
    ring
  have domSummable := Summable.scale at complexAbsSequence(lseriesTerms(
    oneCoefficients, complexOfReal(R[complexRe(s) + 1 - X]))),
    R[(abs(C) + ∑ i < M, absCoefficients(f)(i)) * complexRe(s)] with pSummable
  obtain ⟨D, dIn, dSums⟩ := domSummable
  have kExists : ∃ K ∈ ℝ, K = R[abs(C) + ∑ i < M, absCoefficients(f)(i)]
    have member : R[abs(C) + ∑ i < M, absCoefficients(f)(i)] ∈ ℝ by typecheck
    exact ⟨R[abs(C) + realPartialSum(absCoefficients(f), M)], member, rfl⟩
  obtain ⟨K, kMember, kEq⟩ := kExists
  have kT : Real(K) by typecheck
  rw ← kEq at kNonneg
  rw ← kEq at uBound
  rw ← kEq at dSums
  have pExists : ∃ P, P = complexAbsSequence(lseriesTerms(oneCoefficients,
      complexOfReal(R[complexRe(s) + 1 - X])))
    exact ⟨complexAbsSequence(lseriesTerms(oneCoefficients,
      complexOfReal(R[complexRe(s) + 1 - X]))), rfl⟩
  obtain ⟨P, pEq⟩ := pExists
  rw ← pEq at pSeq
  rw ← pEq at pValue
  rw ← pEq at dSums
  have constant := constantSequence.sequence at R[K * complexRe(s)]
  have domSeq := mulSequence.sequence with constant, pSeq
  have domValue : ∀ k ∈ ℕ, mulSequence(constantSequence(R[K * complexRe(s)]),
      P)(k) = R[K * complexRe(s) * realRpow(realNat(k + 1),
        R[X - complexRe(s) - 1])]
    intros k kIn
    have kNat := nat.omega.backward with kIn
    have cValue := constantSequence.value at R[K * complexRe(s)], k
    have cReal : Real(constantSequence(R[K * complexRe(s)])(k))
      rw cValue
      typecheck
    have pReal := RealSequence.value at P, k with pSeq
    rw [(mulSequence.value with constant, pSeq, cReal, pReal), cValue,
      (pValue with k, kIn)]
  have domNonneg : NonnegativeTerms(mulSequence(constantSequence(R[K *
      complexRe(s)]), P))
    intros k kIn
    have kNat := nat.omega.backward with kIn
    have powPositive := realRpow.positive at realNat(k + 1),
      R[X - complexRe(s) - 1]
    have powNonneg : R[0] ≤ realRpow(realNat(k + 1), R[X - complexRe(s) - 1])
      by linarith
    have kσ := realMulValue.nonnegative at K, complexRe(s) with kNonneg,
      σNonneg
    have product := realMulValue.nonnegative at R[K * complexRe(s)],
      realRpow(realNat(k + 1), R[X - complexRe(s) - 1]) with kσ, powNonneg
    apply realLe.characterization.forward
    rw (domValue with k, kIn)
    exact product
  have prefixes := prefixSums.sequence with uSeq
  have increments := forwardProductIncrements.sequence with prefixes, vSeq
  -- Each step U(k + 1)((k + 1)^(−σ) − (k + 2)^(−σ)) is dominated.
  have stepBound : ∀ k ∈ ℕ, R[0] ≤ R[forwardProductIncrements(
      prefixSums(absCoefficients(f)), tkKweights(complexRe(s)))(k) +
      mulSequence(constantSequence(R[K * complexRe(s)]), P)(k)]
    intros k kIn
    have kNat := nat.omega.backward with kIn
    have succIn : succ(k) ∈ ℕ by typecheck
    have succNat : Nat(succ(k)) by typecheck
    have next : k + 1 ∈ ℕ by typecheck
    have sameIndex : succ(k) = k + 1 by arith
    have one : (1:N) ≤ succ(k) by arith
    have atSucc := uBound with succ(k), succIn, one
    rw sameIndex at atSucc
    have aPositive := realNat.positive_succ at k
    rw sameIndex at aPositive
    have aT : Real(realNat(k + 1)) by typecheck
    have nextNat : realNat(succ(k) + 1) = R[realNat(k + 1) + 1]
      have shift : succ(k) + 1 = succ(k + 1) by arith
      rw [shift, realNat.succ]
      simp [realAddValue, call2]
    have antitone := tkKrpow.antitone at realNat(k + 1), complexRe(s) with
      aPositive, σNonneg
    have step := tkKrpow.step_le at realNat(k + 1), complexRe(s) with
      aPositive, σNonneg
    have vk := realRpow.real at realNat(k + 1), R[-complexRe(s)]
    have vk1 := realRpow.real at R[realNat(k + 1) + 1], R[-complexRe(s)]
    have aX := realRpow.real at realNat(k + 1), X
    have aXPositive := realRpow.positive at realNat(k + 1), X
    have aN := realRpow.real at realNat(k + 1), R[-complexRe(s) - 1]
    have aP := realRpow.real at realNat(k + 1), R[X - complexRe(s) - 1]
    have u1 := realPartialSum.real at absCoefficients(f), k + 1 with uSeq
    have zeroLeK : (0:N) ≤ k + 1 by arith
    have u1Nonneg := tkKpartial.mono at absCoefficients(f), (0:N), k + 1 with
      uSeq, uNonneg, zeroLeK
    rw realPartialSum.zero at u1Nonneg
    have dNonneg : R[0] ≤ R[realRpow(realNat(k + 1), R[-complexRe(s)]) -
      realRpow(R[realNat(k + 1) + 1], R[-complexRe(s)])] by linarith
    have h1 := realLe.mul_right_of_nonnegative with atSucc, dNonneg
    have kaX := realMulValue.nonnegative at K, realRpow(realNat(k + 1), X) with
      kNonneg, (realLess.implies_le with aXPositive)
    have h2 := realLe.mul_left_of_nonnegative with step, kaX
    have powerAdd := realRpow.add at realNat(k + 1), X, R[-complexRe(s) - 1]
      with aPositive
    have exponent : R[X + (-complexRe(s) - 1)] = R[X - complexRe(s) - 1] by
      ring
    rw exponent at powerAdd
    have combine : R[K * realRpow(realNat(k + 1), X) * (complexRe(s) *
        realRpow(realNat(k + 1), R[-complexRe(s) - 1]))] =
        R[K * complexRe(s) * realRpow(realNat(k + 1),
          R[X - complexRe(s) - 1])] by
      linear_combination -K * complexRe(s) * powerAdd
    have bridge : forwardProductIncrements(prefixSums(absCoefficients(f)),
        tkKweights(complexRe(s)))(k) = R[(∑ i < k + 1, absCoefficients(f)(i)) *
        (realRpow(R[realNat(k + 1) + 1], R[-complexRe(s)]) -
          realRpow(realNat(k + 1), R[-complexRe(s)]))]
      rw [(forwardProductIncrements.value at prefixSums(absCoefficients(f)),
          tkKweights(complexRe(s)), k with prefixes, vSeq, kIn),
        (prefixSums.value at absCoefficients(f), succ(k) with succIn),
        (tkKweights.value at complexRe(s), succ(k) with succIn),
        (tkKweights.value at complexRe(s), k with kIn), nextNat, sameIndex]
      simp [realMulValue, realSubValue, call2]
    rw [bridge, (domValue with k, kIn)]
    have flip : R[(∑ i < k + 1, absCoefficients(f)(i)) *
        (realRpow(R[realNat(k + 1) + 1], R[-complexRe(s)]) +
          -realRpow(realNat(k + 1), R[-complexRe(s)]))] =
        R[-((∑ i < k + 1, absCoefficients(f)(i)) *
          (realRpow(realNat(k + 1), R[-complexRe(s)]) -
            realRpow(R[realNat(k + 1) + 1], R[-complexRe(s)])))] by ring
    linarith
  have terms := lseriesTerms.function with values, hs
  have termSeq : ComplexSequence(lseriesTerms(f, s)) by exact terms
  have absTerms := complexAbsSequence.function with termSeq
  have absSeq : RealSequence(complexAbsSequence(lseriesTerms(f, s))) by
    exact absTerms
  have products := mulSequence.sequence with uSeq, vSeq
  have sameTerms : ∀ k ∈ ℕ, complexAbsSequence(lseriesTerms(f, s))(k) =
      mulSequence(absCoefficients(f), tkKweights(complexRe(s)))(k)
    intros k kIn
    have kNat := nat.omega.backward with kIn
    have uk := RealSequence.value at absCoefficients(f), k with uSeq
    have vk := RealSequence.value at tkKweights(complexRe(s)), k with vSeq
    rw [(complexAbsSequence.value with termSeq, kIn),
      (lseriesTerms.abs with values, hs),
      (mulSequence.value with uSeq, vSeq, uk, vk),
      (absCoefficients.value with values, kIn),
      (tkKweights.value at complexRe(s), k with kIn)]
  have absNonneg : NonnegativeTerms(complexAbsSequence(lseriesTerms(f, s)))
    intros k kIn
    have kNat := nat.omega.backward with kIn
    have value := FunctionBetween.apply_closed with terms, kIn
    have nonnegK := complexAbs.nonnegative with value
    apply realLe.characterization.forward
    rw (complexAbsSequence.value with termSeq, kIn)
    linarith
  have addSeq := addSequence.sequence with increments, domSeq
  have addNonneg : NonnegativeTerms(addSequence(forwardProductIncrements(
      prefixSums(absCoefficients(f)), tkKweights(complexRe(s))),
      mulSequence(constantSequence(R[K * complexRe(s)]), P)))
    intros k kIn
    have kNat := nat.omega.backward with kIn
    have r1 := RealSequence.value at forwardProductIncrements(
      prefixSums(absCoefficients(f)), tkKweights(complexRe(s))), k with
      increments
    have r2 := RealSequence.value at mulSequence(constantSequence(R[K *
      complexRe(s)]), P), k with domSeq
    apply realLe.characterization.forward
    rw (addSequence.value with increments, domSeq, r1, r2)
    exact stepBound with k, kIn
  have partialBound : ∀ n ∈ ℕ,
      (∑ i < n, complexAbsSequence(lseriesTerms(f, s))(i):R) ≤ R[K + D]
    intros n nIn
    have nNat := nat.omega.backward with nIn
    have equalPrefix : ∀ k ∈ ℕ, k < n →
        complexAbsSequence(lseriesTerms(f, s))(k) =
        mulSequence(absCoefficients(f), tkKweights(complexRe(s)))(k)
      intros k kIn _
      exact sameTerms with k, kIn
    have e1 := realPartialSum.eq_prefix with absSeq, products, equalPrefix
    have abel := realPartialSum.abel at absCoefficients(f),
      tkKweights(complexRe(s)), n with uSeq, vSeq
    have split := realPartialSum.add at forwardProductIncrements(
      prefixSums(absCoefficients(f)), tkKweights(complexRe(s))),
      mulSequence(constantSequence(R[K * complexRe(s)]), P), n with
      increments, domSeq
    have zeroLeN : (0:N) ≤ n by arith
    have mono := tkKpartial.mono at addSequence(forwardProductIncrements(
      prefixSums(absCoefficients(f)), tkKweights(complexRe(s))),
      mulSequence(constantSequence(R[K * complexRe(s)]), P)), (0:N), n with
      addSeq, addNonneg, zeroLeN
    rw realPartialSum.zero at mono
    have domBound := SumsTo.partial_le at mulSequence(constantSequence(R[K *
      complexRe(s)]), P), D, n with dSums, domNonneg
    have uN := realPartialSum.real at absCoefficients(f), n with uSeq
    have uNNonneg := tkKpartial.mono at absCoefficients(f), (0:N), n with
      uSeq, uNonneg, zeroLeN
    rw realPartialSum.zero at uNNonneg
    have vN := RealSequence.value at tkKweights(complexRe(s)), n with vSeq
    have incrementsN := realPartialSum.real at forwardProductIncrements(
      prefixSums(absCoefficients(f)), tkKweights(complexRe(s))), n with
      increments
    have domN := realPartialSum.real at mulSequence(constantSequence(R[K *
      complexRe(s)]), P), n with domSeq
    have uvBound : R[(∑ i < n, absCoefficients(f)(i)) *
        tkKweights(complexRe(s))(n)] ≤ K
      rw (tkKweights.value at complexRe(s), n with nIn)
      have vPositive := realRpow.positive at realNat(n + 1), R[-complexRe(s)]
      have vReal := realRpow.real at realNat(n + 1), R[-complexRe(s)]
      by_cases zero : n = (0:N)
      . rw [zero, realPartialSum.zero]
        have unit : R[0 * realRpow(realNat((0:N) + 1), R[-complexRe(s)])] =
          R[0] by ring
        linarith
      . have one : (1:N) ≤ n by arith
        have atN := uBound with n, nIn, one
        have nPositive := realNat.positive at n with zero
        have nextNat : realNat(n + 1) = R[realNat(n) + 1]
          have shift : n + 1 = succ(n) by arith
          rw [shift, realNat.succ]
          simp [realAddValue, call2]
        have anti := tkKrpow.antitone at realNat(n), complexRe(s) with
          nPositive, σNonneg
        rw nextNat
        rw nextNat at vPositive
        rw nextNat at vReal
        have vNonneg : R[0] ≤ realRpow(R[realNat(n) + 1], R[-complexRe(s)])
          by linarith
        have nX := realRpow.positive at realNat(n), X
        have nXReal := realRpow.real at realNat(n), X
        have nNReal := realRpow.real at realNat(n), R[-complexRe(s)]
        have knX := realMulValue.nonnegative at K, realRpow(realNat(n), X) with
          kNonneg, (realLess.implies_le with nX)
        have h1 := realLe.mul_right_of_nonnegative with atN, vNonneg
        have h2 := realLe.mul_left_of_nonnegative with anti, knX
        have powerAdd := realRpow.add at realNat(n), X, R[-complexRe(s)] with
          nPositive
        have gap : R[0] ≤ R[complexRe(s) - X] by linarith
        have le1 := realRpow.nat_neg_le_one at n, R[complexRe(s) - X] with one,
          gap
        have exponent : R[-R[complexRe(s) - X]] = R[X + -complexRe(s)] by ring
        rw exponent at le1
        have nPReal := realRpow.real at realNat(n), R[X + -complexRe(s)]
        have h3 := realLe.mul_left_of_nonnegative with le1, kNonneg
        have combine : R[K * realRpow(realNat(n), X) *
            realRpow(realNat(n), R[-complexRe(s)])] =
            R[K * realRpow(realNat(n), R[X + -complexRe(s)])] by
          linear_combination -K * powerAdd
        have unit : R[K * 1] = K by ring
        linarith
    linarith
  have summable := tkKSummable.of_partial_bound at complexAbsSequence(
    lseriesTerms(f, s)), R[K + D] with absSeq, absNonneg, partialBound
  unfold LSeriesSummable
  exact ⟨termSeq, summable⟩

-- The same for nonnegative real coefficients (Mathlib's
-- LSeriesSummable_of_sum_norm_bigO_and_nonneg).
theorem LSeriesSummable.of_summatory_bound_nonneg (a s : Set) (X : Real)
  requires sequence : RealSequence(a)
  requires hs : s ∈ ℂ
  requires nonneg : ∀ n ∈ ℕ, R[0] ≤ a(n)
  requires exponent : R[0] ≤ X
  requires bound : ∃ C ∈ ℝ, ∃ M ∈ ℕ, ∀ n ∈ ℕ, M ≤ n →
    realPartialSum(absCoefficients(realCoefficients(a)), n) ≤
      R[C * realRpow(realNat(n), X)]
  requires halfPlane : X < complexRe(s)
  shows LSeriesSummable(realCoefficients(a), s)
proof
  sorry

-- Summation by parts: if |A(n)| = O(n^r) with A(n) = Σ_{k=1}^{n} f(k),
-- 0 ≤ r < re s, and the series converges absolutely, then
-- L(f, s) = s ∫_{(1,∞)} A(⌊t⌋) t^(−(s+1)) dt (Mathlib's
-- LSeries_eq_mul_integral).
theorem LSeries.eq_mul_integral (f s : Set) (X : Real)
  requires values : FunctionBetween(f, ℕ, complexCarrier)
  requires hs : s ∈ ℂ
  requires nonneg : R[0] ≤ X
  requires halfPlane : X < complexRe(s)
  requires summable : LSeriesSummable(f, s)
  requires bound : ∃ C ∈ ℝ, ∃ M ∈ ℕ, ∀ n ∈ ℕ, M ≤ n →
    complexAbs(summatory(f, n)) ≤ R[C * realRpow(realNat(n), X)]
  shows ComplexIntegrableOn(realMeasurableSpace, realVolume,
      summatoryIntegrand(f, s), realIoi(R[1])) ∧
    LSeries(f, s) = ℂ[s * complexSetIntegral(realMeasurableSpace, realVolume,
      summatoryIntegrand(f, s), realIoi(R[1]))]
proof
  sorry

-- The same from the bound on Σ_{k≤n} |f(k)| alone (Mathlib's
-- LSeries_eq_mul_integral').
theorem LSeries.eq_mul_integral_of_abs (f s : Set) (X : Real)
  requires values : FunctionBetween(f, ℕ, complexCarrier)
  requires hs : s ∈ ℂ
  requires nonneg : R[0] ≤ X
  requires halfPlane : X < complexRe(s)
  requires bound : ∃ C ∈ ℝ, ∃ M ∈ ℕ, ∀ n ∈ ℕ, M ≤ n →
    summatoryAbs(f, n) ≤ R[C * realRpow(realNat(n), X)]
  shows LSeries(f, s) = ℂ[s * complexSetIntegral(realMeasurableSpace,
    realVolume, summatoryIntegrand(f, s), realIoi(R[1]))]
proof
  have summable := LSeriesSummable.of_summatory_bound with values, hs, nonneg,
    bound, halfPlane
  obtain ⟨C, hC, M, hM, boundM⟩ := bound
  have shifted := shiftedCoefficients.function with values
  have shiftedSequence : ComplexSequence(shiftedCoefficients(f)) by
    exact shifted
  have absolute := absCoefficients.function with values
  have absSequence : RealSequence(absCoefficients(f)) by exact absolute
  have boundAbs : ∃ C ∈ ℝ, ∃ M ∈ ℕ, ∀ n ∈ ℕ, M ≤ n →
      complexAbs(summatory(f, n)) ≤ R[C * realRpow(realNat(n), X)]
    refine ⟨C, hC, M, hM, ?_⟩
    intros n nIn le
    have nNat := nat.omega.backward with nIn
    have termwise : ∀ k ∈ ℕ, k < n → complexAbs(shiftedCoefficients(f)(k)) ≤
        (absCoefficients(f)[k]:R)
      intros k kIn _
      rw [(shiftedCoefficients.value with values, kIn),
        (absCoefficients.value with values, kIn)]
      have kNat := nat.omega.backward with kIn
      have index : k + 1 ∈ ℕ by typecheck
      have value := FunctionBetween.apply_closed with values, index
      have absReal := complexAbs.real with value
      linarith
    have triangle := complexPartialSum.abs_le at shiftedCoefficients(f),
      absCoefficients(f), n with shiftedSequence, absSequence
    have below := triangle with termwise
    have atN := boundM with n, nIn, le
    unfold summatoryAbs at atN
    unfold summatory
    have partialReal := realPartialSum.real at absCoefficients(f), n
    have cT : Real(C) by typecheck
    have powerReal := realRpow.real at realNat(n), X
    have productReal : R[C * realRpow(realNat(n), X)] ∈ ℝ by typecheck
    linarith
  have both := LSeries.eq_mul_integral with values, hs, nonneg, halfPlane,
    summable, boundAbs
  exact both.right

-- Section: Euler products
-- Absolutely summable terms are eventually below 1.
theorem ComplexAbsolutelySummable.eventually_small (t : Set)
  requires absolute : ComplexAbsolutelySummable(t)
  shows ∃ M ∈ ℕ, ∀ n ∈ ℕ, M ≤ n → complexAbs(t(n)) < R[1]
proof
  obtain ⟨sequence, summable⟩ := absolute
  obtain ⟨L, lReal, sums⟩ := summable
  have zero := SumsTo.terms_converge_zero with sums
  obtain ⟨_, close⟩ := zero
  have one : R[0] < R[1] by linarith
  have oneIn : R[1] ∈ ℝ by typecheck
  obtain ⟨M, mIn, after⟩ := close with R[1], oneIn, one
  refine ⟨M, mIn, ?_⟩
  intros n nIn later
  have ball := after with n, nIn, later
  have nNat := nat.omega.backward with nIn
  rw (complexAbsSequence.value with sequence, nIn) at ball
  obtain ⟨_, high⟩ := openBall.order_characterization.forward with ball
  linarith

-- For completely multiplicative f the terms are multiplicative in the
-- shifted indexing.
theorem lseriesTerms.multiplicative (f s : Set)
  requires multiplicative : CompletelyMultiplicative(f)
  requires hs : s ∈ ℂ
  shows ∀ r ∈ ℕ, ∀ j ∈ ℕ, lseriesTerms(f, s)((r + 1) * j + r) =
    ℂ[lseriesTerms(f, s)(r) * lseriesTerms(f, s)(j)]
proof
  obtain ⟨values, _, fMul⟩ := multiplicative
  have negative : ℂ[-s] ∈ ℂ by typecheck
  intros r rMember j jMember
  have rNat := nat.omega.backward with rMember
  have jNat := nat.omega.backward with jMember
  have position : (r + 1) * j + r ∈ ℕ by typecheck
  have index : (r + 1) * j + r + 1 = (r + 1) * (j + 1) by arith
  have positiveR : 1 ≤ r + 1 by arith
  have positiveJ : 1 ≤ j + 1 by arith
  have rNext : r + 1 ∈ ℕ by typecheck
  have jNext : j + 1 ∈ ℕ by typecheck
  have rValue := FunctionBetween.apply_closed with values, rNext
  have jValue := FunctionBetween.apply_closed with values, jNext
  have rPower := realCpow.member at realNat(r + 1), ℂ[-s] with negative
  have jPower := realCpow.member at realNat(j + 1), ℂ[-s] with negative
  rw [(lseriesTerms.value with values, hs, position),
    (lseriesTerms.value with values, hs, rMember),
    (lseriesTerms.value with values, hs, jMember), index,
    (realCpow.nat_neg_mul with positiveR, positiveJ, hs),
    (fMul with r + 1, rNext, j + 1, jNext)]
  ring

-- A term equal to 1 at a prime index propagates to arbitrarily large
-- indices.
theorem complexTerms.ones_unbounded (t : Set) (r k : Nat)
  requires positive : 1 ≤ r
  requires first : t((0:N)) = ℂ[1]
  requires multiplicative : ∀ j ∈ ℕ, t((r + 1) * j + r) = ℂ[t(r) * t(j)]
  requires isOne : t(r) = ℂ[1]
  shows ∃ j ∈ ℕ, k ≤ j ∧ t(j) = ℂ[1]
proof
  induction k
  | zero =>
    have zeroMember : (0:N) ∈ ℕ := nat.omega.forward at (0:N) with *
    have le : (0:N) ≤ (0:N) by arith
    exact ⟨(0:N), zeroMember, le, first⟩
  | succ(i) using ih =>
    obtain ⟨j, jIn, le, value⟩ := ih
    have jNat := nat.omega.backward with jIn
    have next : (r + 1) * j + r ∈ ℕ by typecheck
    have product : r * j ∈ ℕ by typecheck
    have expand : (r + 1) * j + r = r * j + j + r by ring
    have bigger : succ(i) ≤ (r + 1) * j + r
      rw expand
      arith
    have nextValue := multiplicative with j, jIn
    rw [isOne, value] at nextValue
    have unit : ℂ[1 * 1] = ℂ[1] by ring
    rw unit at nextValue
    exact ⟨(r + 1) * j + r, next, bigger, nextValue⟩

theorem lseriesTerms.prime_not_one (f s : Set) (r : Nat)
  requires multiplicative : CompletelyMultiplicative(f)
  requires hs : s ∈ ℂ
  requires summable : LSeriesSummable(f, s)
  requires prime : Prime(r + 1)
  shows lseriesTerms(f, s)(r) ≠ ℂ[1]
proof
  intro isOne
  have multiplicativeTerms := lseriesTerms.multiplicative with
    multiplicative, hs
  obtain ⟨values, fOne, _⟩ := multiplicative
  have rMember : r ∈ ℕ by typecheck
  have above := Prime.greater_than_one with prime
  have positive : 1 ≤ r by arith
  have zeroMember : (0:N) ∈ ℕ := nat.omega.forward at (0:N) with *
  have first : lseriesTerms(f, s)((0:N)) = ℂ[1]
    rw [(lseriesTerms.value with values, hs, zeroMember),
      natural.zero_add_one, (realCpow.nat_neg_one with hs), fOne]
    ring
  have along : ∀ j ∈ ℕ, lseriesTerms(f, s)((r + 1) * j + r) =
      ℂ[lseriesTerms(f, s)(r) * lseriesTerms(f, s)(j)]
    intros j jIn
    exact multiplicativeTerms with r, rMember, j, jIn
  unfold LSeriesSummable at summable
  obtain ⟨M, mIn, small⟩ := ComplexAbsolutelySummable.eventually_small with
    summable
  have mNat := nat.omega.backward with mIn
  obtain ⟨j, jIn, later, value⟩ := complexTerms.ones_unbounded at
    lseriesTerms(f, s), r, M with positive, first, along, isOne
  have below := small with j, jIn, later
  rw [value, complexAbs.one] at below
  linarith

-- The Euler product of a completely multiplicative f with absolutely
-- convergent series, through layer 1's sieve.
theorem LSeries.euler_sieve (f s : Set)
  requires multiplicative : CompletelyMultiplicative(f)
  requires hs : s ∈ ℂ
  requires summable : LSeriesSummable(f, s)
  shows ComplexConvergesTo(lseriesEulerProducts(f, s), LSeries(f, s)) ∧
    LSeries(f, s) ≠ ℂ[0]
proof
  have multiplicativeCopy := multiplicative
  have multiplicativeTerms := lseriesTerms.multiplicative with
    multiplicative, hs
  obtain ⟨values, fOne, _⟩ := multiplicativeCopy
  have sums := LSeries.of_summable with summable
  have summableCopy := summable
  unfold LSeriesSummable at summableCopy
  have products := lseriesEulerProducts.function with values, hs
  have sequenceE : ComplexSequence(lseriesEulerProducts(f, s)) by
    exact products
  have negative : ℂ[-s] ∈ ℂ by typecheck
  have zeroMember : (0:N) ∈ ℕ := nat.omega.forward at (0:N) with *
  have first : lseriesTerms(f, s)((0:N)) = ℂ[1]
    rw [(lseriesTerms.value with values, hs, zeroMember),
      natural.zero_add_one, (realCpow.nat_neg_one with hs), fOne]
    ring
  have primeMultiplicative : ∀ r ∈ ℕ, Prime(r + 1) → (∀ j ∈ ℕ,
      lseriesTerms(f, s)((r + 1) * j + r) =
        ℂ[lseriesTerms(f, s)(r) * lseriesTerms(f, s)(j)])
    intros r rMember prime
    exact multiplicativeTerms with r, rMember
  have notOne : ∀ r ∈ ℕ, Prime(r + 1) → lseriesTerms(f, s)(r) ≠ ℂ[1]
    intros r rMember prime
    have rNat := nat.omega.backward with rMember
    exact lseriesTerms.prime_not_one with multiplicative, hs, summable, prime
  have start : lseriesEulerProducts(f, s)((0:N)) = ℂ[1]
    rw [(lseriesEulerProducts.value with values, hs, zeroMember),
      lseriesEulerProduct]
  have primeStep : ∀ r ∈ ℕ, Prime(r + 1) →
      lseriesEulerProducts(f, s)(r + 1 + 1) =
        ℂ[lseriesEulerProducts(f, s)(r + 1) *
          complexInv(ℂ[1 - lseriesTerms(f, s)(r)])]
    intros r rMember prime
    have rNat := nat.omega.backward with rMember
    have here : r + 1 ∈ ℕ by typecheck
    have next : r + 1 + 1 ∈ ℕ by typecheck
    have index : r + 1 + 1 = succ(r + 1) by arith
    rw [(lseriesEulerProducts.value with values, hs, next),
      (lseriesEulerProducts.value with values, hs, here),
      (lseriesTerms.value with values, hs, rMember), index,
      lseriesEulerProduct, (lseriesEulerFactor.prime with values, hs, prime)]
  have otherStep : ∀ k ∈ ℕ, ¬Prime(k) →
      lseriesEulerProducts(f, s)(k + 1) = lseriesEulerProducts(f, s)(k)
    intros k kMember notPrime
    have kNat := nat.omega.backward with kMember
    have next : k + 1 ∈ ℕ by typecheck
    have index : k + 1 = succ(k) by arith
    have product := lseriesEulerProduct.member at f, s, k with values, hs
    rw [(lseriesEulerProducts.value with values, hs, next),
      (lseriesEulerProducts.value with values, hs, kMember), index,
      lseriesEulerProduct, (lseriesEulerFactor.not_prime with notPrime)]
    ring
  exact ComplexConvergesTo.euler_sieve with summableCopy, sums, first,
    primeMultiplicative, notOne, sequenceE, start, primeStep, otherStep

-- For f completely multiplicative with absolutely convergent series, the
-- partial Euler products converge to the sum (Mathlib's
-- eulerProduct_completely_multiplicative_hasProd, for the L-series terms).
theorem LSeries.euler_product (f s : Set)
  requires multiplicative : CompletelyMultiplicative(f)
  requires hs : s ∈ ℂ
  requires summable : LSeriesSummable(f, s)
  shows ComplexConvergesTo(lseriesEulerProducts(f, s), LSeries(f, s))
proof
  obtain ⟨converges, _⟩ := LSeries.euler_sieve with multiplicative, hs,
    summable
  exact converges

-- Mathlib's LSeries_eulerProduct_exp_log: the sum is exp of
-- Σ_p −log(1 − f(p) p^(−s)); stated as: no Euler factor vanishes and the
-- sum is nonzero.
theorem LSeries.ne_zero_of_euler (f s : Set)
  requires multiplicative : CompletelyMultiplicative(f)
  requires hs : s ∈ ℂ
  requires summable : LSeriesSummable(f, s)
  shows LSeries(f, s) ≠ ℂ[0]
proof
  obtain ⟨_, nonzero⟩ := LSeries.euler_sieve with multiplicative, hs,
    summable
  exact nonzero

-- The partial Euler products of χ and of 1 are layer 1's, factor by factor.
theorem lseriesEulerProduct.character (N : Nat) (χ s : Set) (n : Nat)
  requires character : DirichletCharacter(N, χ)
  requires hs : s ∈ ℂ
  shows lseriesEulerProduct(characterCoefficients(χ), s, n) =
    lEulerProduct(χ, s, n)
proof
  induction n
  | zero =>
    rw [lseriesEulerProduct, lEulerProduct]
  | succ(k) using ih =>
    have values := DirichletCharacter.function with character
    have coefficients := characterCoefficients.function with character
    obtain ⟨_, primeValue, otherValue⟩ := lEulerFactor.selected at χ, s, k
      with values, hs
    have factor : lseriesEulerFactor(characterCoefficients(χ), s, k) =
        lEulerFactor(χ, s, k)
      by_cases prime : Prime(k)
      . rw [(lseriesEulerFactor.prime with coefficients, hs, prime),
          (primeValue with prime), characterCoefficients.apply]
      . rw [(lseriesEulerFactor.not_prime with prime), (otherValue with prime)]
    rw [lseriesEulerProduct, lEulerProduct, ih, factor]

theorem lseriesEulerProduct.one (s : Set) (n : Nat)
  requires hs : s ∈ ℂ
  shows lseriesEulerProduct(oneCoefficients, s, n) = zetaEulerProduct(s, n)
proof
  induction n
  | zero =>
    rw [lseriesEulerProduct, zetaEulerProduct]
  | succ(k) using ih =>
    have coefficients := oneCoefficients.function
    obtain ⟨_, primeValue, otherValue⟩ := zetaEulerFactor.selected at s, k
      with hs
    have negative : ℂ[-s] ∈ ℂ by typecheck
    have power := realCpow.member at realNat(k), ℂ[-s] with negative
    have factor : lseriesEulerFactor(oneCoefficients, s, k) =
        zetaEulerFactor(s, k)
      by_cases prime : Prime(k)
      . have unit : ℂ[1 - complexOne * realCpow(realNat(k), ℂ[-s])] =
            ℂ[1 - realCpow(realNat(k), ℂ[-s])] by ring
        rw [(lseriesEulerFactor.prime with coefficients, hs, prime),
          (primeValue with prime), oneCoefficients.apply, unit]
      . rw [(lseriesEulerFactor.not_prime with prime), (otherValue with prime)]
    rw [lseriesEulerProduct, zetaEulerProduct, ih, factor]

-- The Euler factors of a character are layer 1's.
theorem lseriesEulerProducts.character (N : Nat) (χ s : Set)
  requires character : DirichletCharacter(N, χ)
  requires hs : s ∈ ℂ
  shows lseriesEulerProducts(characterCoefficients(χ), s) =
    lEulerProducts(χ, s)
proof
  have values := DirichletCharacter.function with character
  have coefficients := characterCoefficients.function with character
  have left := lseriesEulerProducts.function with coefficients, hs
  have right := lEulerProducts.function with values, hs
  apply FunctionBetween.ext with left, right
  intros n nMember
  have nNat := nat.omega.backward with nMember
  rw [(lseriesEulerProducts.value with coefficients, hs, nMember),
    (lEulerProducts.value with values, hs, nMember)]
  exact lseriesEulerProduct.character at N, χ, s, n with character, hs

theorem lseriesEulerProducts.one (s : Set)
  requires hs : s ∈ ℂ
  shows lseriesEulerProducts(oneCoefficients, s) = zetaEulerProducts(s)
proof
  have coefficients := oneCoefficients.function
  have left := lseriesEulerProducts.function with coefficients, hs
  have right := zetaEulerProducts.function with hs
  apply FunctionBetween.ext with left, right
  intros n nMember
  have nNat := nat.omega.backward with nMember
  rw [(lseriesEulerProducts.value with coefficients, hs, nMember),
    (zetaEulerProducts.value with hs, nMember)]
  exact lseriesEulerProduct.one at s, n with hs

-- Section: The bridge to layer 1
-- For re s > 1 the series of χ converges absolutely to layer 1's L(s, χ)
-- (Mathlib's DirichletCharacter.LSeriesSummable_of_one_lt_re,
-- LFunction_eq_LSeries, and LSeriesHasSum for χ).
theorem LSeriesSummable.character (N : Nat) (χ s : Set)
  requires positive : 1 ≤ N
  requires character : DirichletCharacter(N, χ)
  requires hs : s ∈ ℂ
  requires halfPlane : realOne < complexRe(s)
  shows LSeriesSummable(characterCoefficients(χ), s)
proof
  obtain ⟨_, absolute⟩ := LFunction.series with positive, character, hs,
    halfPlane
  unfold LSeriesSummable
  rw (lseriesTerms.character with character, hs)
  exact absolute

-- The series of χ converges absolutely exactly on re s > 1 (Mathlib's
-- DirichletCharacter.LSeriesSummable_iff, N ≥ 1).
theorem LSeriesSummable.character_iff (N : Nat) (χ s : Set)
  requires positive : 1 ≤ N
  requires character : DirichletCharacter(N, χ)
  requires hs : s ∈ ℂ
  shows LSeriesSummable(characterCoefficients(χ), s) ↔
    realOne < complexRe(s)
proof
  sorry

theorem LSeriesHasSum.character (N : Nat) (χ s : Set)
  requires positive : 1 ≤ N
  requires character : DirichletCharacter(N, χ)
  requires hs : s ∈ ℂ
  requires halfPlane : realOne < complexRe(s)
  shows LSeriesHasSum(characterCoefficients(χ), s, LFunction(N, χ, s))
proof
  obtain ⟨sums, _⟩ := LFunction.series with positive, character, hs,
    halfPlane
  have summable := LSeriesSummable.character with positive, character, hs,
    halfPlane
  have terms := lseriesTerms.character with character, hs
  rw ← terms at sums
  exact ⟨summable, sums⟩

-- Mathlib's DirichletCharacter.LFunction_eq_LSeries.
theorem LFunction.eq_LSeries (N : Nat) (χ s : Set)
  requires positive : 1 ≤ N
  requires character : DirichletCharacter(N, χ)
  requires hs : s ∈ ℂ
  requires halfPlane : realOne < complexRe(s)
  shows LFunction(N, χ, s) = LSeries(characterCoefficients(χ), s)
proof
  have has := LSeriesHasSum.character with positive, character, hs, halfPlane
  have coefficients := characterCoefficients.function with character
  have iff := LSeriesHasSum.iff at characterCoefficients(χ), s,
    LFunction(N, χ, s) with coefficients, hs
  obtain ⟨_, equal⟩ := iff.forward with has
  rw equal

-- Mathlib's LSeriesHasSum_one and LSeries_one_eq_riemannZeta.
theorem LSeriesHasSum.one (s : Set)
  requires hs : s ∈ ℂ
  requires halfPlane : realOne < complexRe(s)
  shows LSeriesHasSum(oneCoefficients, s, riemannZeta(s))
proof
  obtain ⟨sums, absolute⟩ := zeta.series with hs, halfPlane
  have terms := lseriesTerms.one with hs
  have summable : LSeriesSummable(oneCoefficients, s)
    unfold LSeriesSummable
    rw terms
    exact absolute
  rw ← terms at sums
  exact ⟨summable, sums⟩

theorem riemannZeta.eq_LSeries (s : Set)
  requires hs : s ∈ ℂ
  requires halfPlane : realOne < complexRe(s)
  shows riemannZeta(s) = LSeries(oneCoefficients, s)
proof
  have has := LSeriesHasSum.one with hs, halfPlane
  have coefficients := oneCoefficients.function
  have iff := LSeriesHasSum.iff at oneCoefficients, s, riemannZeta(s) with
    coefficients, hs
  obtain ⟨_, equal⟩ := iff.forward with has
  rw equal

-- The series of χ has abscissa at most 1.
theorem cldDabscissa.character (N : Nat) (χ : Set)
  requires positive : 1 ≤ N
  requires character : DirichletCharacter(N, χ)
  shows AbscissaAtMost(characterCoefficients(χ), R[1])
proof
  intros Y yIn above
  have yReal : Real(Y) by typecheck
  have hy : complexOfReal(Y) ∈ ℂ by typecheck
  have halfPlane : realOne < complexRe(complexOfReal(Y))
    rw complexOfReal.re
    linarith
  exact LSeriesSummable.character with positive, character, hy, halfPlane

-- The derivatives agree on re s > 1 (Mathlib's
-- DirichletCharacter.deriv_LFunction_eq_deriv_LSeries). Layer 1's L(·, χ)
-- is holomorphic on ℂ ∖ {1} for every χ.
theorem LFunction.deriv_eq_deriv_LSeries (N : Nat) (χ s : Set)
  requires positive : 1 ≤ N
  requires character : DirichletCharacter(N, χ)
  requires hs : s ∈ ℂ
  requires halfPlane : realOne < complexRe(s)
  shows complexDeriv(LFunctionMap(N, χ), complexCarrier ∖ {ℂ[1]})(s) =
    complexDeriv(LSeriesMap(characterCoefficients(χ)), rightHalfPlane(R[1]))(s)
proof
  have values := DirichletCharacter.function with character
  have coefficients := characterCoefficients.function with character
  have one := complexOne.member
  have halfOpen := rightHalfPlane.open at R[1]
  have halfInside : rightHalfPlane(R[1]) ⊆ complexCarrier ∖ {ℂ[1]}
    intros z hz
    obtain ⟨zIn, zRe⟩ := rightHalfPlane.membership.forward with hz
    refine ⟨zIn, ?_⟩
    intro single
    have equal := (singleton.membership at z, ℂ[1]).forward with single
    rw [equal, complexRe.one] at zRe
    linarith
  have sH : s ∈ rightHalfPlane(R[1])
    exact rightHalfPlane.membership.backward with ⟨hs, halfPlane⟩
  have sU := halfInside with s, sH
  have lHolomorphic := LFunction.holomorphic_off_one with positive, character
  have dL := complexDeriv.has_derivative with lHolomorphic, sU
  have dHalf := HasComplexDerivativeAt.mono with dL, halfOpen, halfInside, sH
  have abscissa := cldDabscissa.character with positive, character
  have sHolomorphic := LSeriesMap.holomorphic with coefficients, abscissa
  have agree : ∀ z ∈ rightHalfPlane(R[1]),
      LFunctionMap(N, χ)(z) = LSeriesMap(characterCoefficients(χ))(z)
    intros z hz
    obtain ⟨zIn, zRe⟩ := rightHalfPlane.membership.forward with hz
    rw [(LFunctionMap.apply with values, zIn),
      (LSeriesMap.apply with coefficients, zIn)]
    exact LFunction.eq_LSeries with positive, character, zIn, zRe
  have dSeries := HasComplexDerivativeAt.congr with dHalf, agree
  have dOwn := complexDeriv.has_derivative with sHolomorphic, sH
  exact HasComplexDerivativeAt.unique with dSeries, dOwn

-- and the derivative of L(·, χ) is −Σ χ(n) log(n) n^(−s) there.
theorem LFunction.deriv_series (N : Nat) (χ s : Set)
  requires positive : 1 ≤ N
  requires character : DirichletCharacter(N, χ)
  requires hs : s ∈ ℂ
  requires halfPlane : realOne < complexRe(s)
  shows complexDeriv(LFunctionMap(N, χ), complexCarrier ∖ {ℂ[1]})(s) =
    ℂ[-LSeries(logMulCoefficients(characterCoefficients(χ)), s)]
proof
  have coefficients := characterCoefficients.function with character
  have abscissa := cldDabscissa.character with positive, character
  rw (LFunction.deriv_eq_deriv_LSeries with positive, character, hs,
    halfPlane)
  exact LSeriesMap.deriv with coefficients, abscissa, halfPlane, hs

-- The Euler product of the series of χ (Mathlib's
-- DirichletCharacter.LSeries_eulerProduct_hasProd, partial products over
-- the primes p < n; layer 1's LFunction.euler_product).
theorem LSeries.euler_product_character (N : Nat) (χ s : Set)
  requires positive : 1 ≤ N
  requires character : DirichletCharacter(N, χ)
  requires hs : s ∈ ℂ
  requires halfPlane : realOne < complexRe(s)
  shows ComplexConvergesTo(lEulerProducts(χ, s),
    LSeries(characterCoefficients(χ), s))
proof
  rw ← (LFunction.eq_LSeries with positive, character, hs, halfPlane)
  exact LFunction.euler_product with positive, character, hs, halfPlane

-- Mathlib's riemannZeta_eulerProduct_hasProd, in partial products (layer
-- 1's zeta.euler_product).
theorem riemannZeta.euler_product_hasProd (s : Set)
  requires hs : s ∈ ℂ
  requires halfPlane : realOne < complexRe(s)
  shows ComplexConvergesTo(zetaEulerProducts(s), riemannZeta(s))
proof
  exact zeta.euler_product with hs, halfPlane

-- The product of two Euler products is the Euler product of the products
-- of the factors, converging to the product of the sums (the step of
-- Mathlib's HasProd.mul used for ζ(s) L(s, χ)).
theorem LSeries.euler_product_mul (N : Nat) (χ s : Set)
  requires positive : 1 ≤ N
  requires character : DirichletCharacter(N, χ)
  requires hs : s ∈ ℂ
  requires halfPlane : realOne < complexRe(s)
  shows ComplexConvergesTo(productSequence(zetaEulerProducts(s),
    lEulerProducts(χ, s)), ℂ[riemannZeta(s) * LFunction(N, χ, s)])
proof
  have values := DirichletCharacter.function with character
  have zetaConverges := zeta.euler_product with hs, halfPlane
  have lConverges := LFunction.euler_product with positive, character, hs,
    halfPlane
  have product := ComplexConvergesTo.mul with zetaConverges, lConverges
  have zetaFunction := zetaEulerProducts.function with hs
  have lFunction := lEulerProducts.function with values, hs
  have zetaSequence : ComplexSequence(zetaEulerProducts(s)) by
    exact zetaFunction
  have lSequence : ComplexSequence(lEulerProducts(χ, s)) by exact lFunction
  have left : FunctionBetween(productSequence(zetaEulerProducts(s),
      lEulerProducts(χ, s)), ℕ, complexCarrier)
    apply productSequence.maps
    intros n nIn
    have zn := FunctionBetween.apply_closed with zetaFunction, nIn
    have ln := FunctionBetween.apply_closed with lFunction, nIn
    typecheck
  have right := complexSeqMul.function with zetaSequence, lSequence
  have same : productSequence(zetaEulerProducts(s), lEulerProducts(χ, s)) =
      complexSeqMul(zetaEulerProducts(s), lEulerProducts(χ, s))
    apply FunctionBetween.ext with left, right
    intros n nIn
    rw [(productSequence.eval with nIn),
      (complexSeqMul.value with zetaSequence, lSequence, nIn)]
  rw same
  exact product

end LSeries
