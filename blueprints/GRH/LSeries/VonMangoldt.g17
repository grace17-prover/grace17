-- The von Mangoldt function and primes in arithmetic progressions: Λ(n) =
-- log p on the prime powers n = p^k and 0 elsewhere, Σ_{d ∣ n} Λ(d) =
-- log n; the series Σ χ(n) Λ(n) n^(−s) = −L′(s, χ)/L(s, χ) for re s > 1,
-- and its continuation through (s − 1) L(s, χ₀) for the principal
-- character; Λ restricted to a residue class a modulo N, expanded over the
-- characters by orthogonality, its series, and Dirichlet's theorem: the
-- primes p ≡ a (mod N) are infinitely many, Σ_{p ≡ a} log(p)/p diverging.
-- Part of the GRH blueprint (layer 2, track D: the L-series bridge).
-- Source: Mathlib's NumberTheory/ArithmeticFunction/VonMangoldt,
-- NumberTheory/LSeries/{Dirichlet, PrimesInAP}; the principal-character
-- form of −L′/L follows the source's Lib/Analytic/Landau/PolarLandau.
-- Planned home: NumberTheory/LSeries/PrimesInAP.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.LSeries.VonMangoldt
import GRH.LSeries.NonVanishing
import GRH.Calculus.Analytic

-- Section: Prime powers
-- n is a power p^k, k ≥ 1, of the prime p.
predicate PrimePowerOf (n p : Nat) :=
  Prime(p) ∧ ∃ k ∈ ℕ, 1 ≤ k ∧ n = p ^ k

predicate PrimePower (n : Nat) := ∃ p ∈ ℕ, PrimePowerOf(n, p)

section VonMangoldt
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Section: Definitions
-- Λ(n) = log p when n = p^k with p prime and k ≥ 1, and 0 otherwise
-- (Mathlib's ArithmeticFunction.vonMangoldt; Λ(0) = Λ(1) = 0).
def vonMangoldtValue (n : Nat) : Set :=
  ⋃({ w ∈ ℝ | (∃ p ∈ ℕ, PrimePowerOf(n, p) ∧ w = realLog(realNat(p))) ∨
    (¬PrimePower(n) ∧ w = realZero) })

defgraph vonMangoldt (n ∈ ℕ) : ℝ := vonMangoldtValue(n)
proof
  sorry

-- Λ as complex coefficients (Mathlib's ↗Λ), and the twist n ↦ χ(n) Λ(n)
-- (Mathlib's ↗χ * ↗Λ).
def vonMangoldtCoefficients : Set := realCoefficients(vonMangoldt)

def twistedVonMangoldt (χ : Set) : Set :=
  coefficientMul(characterCoefficients(χ), vonMangoldtCoefficients)

-- The class of n modulo N is the class of the integer a.
predicate InResidueClass (N n : Nat, a : Set) :=
  IntegerCongruent(integerOfNat(N), integerOfNat(n), a)

-- Λ on the residue class a modulo N, 0 off it (Mathlib's
-- ArithmeticFunction.vonMangoldt.residueClass a, for a : ZMod N; here a is
-- an integer representing the class).
def residueClassValue (N : Nat, a : Set, n : Nat) : Set :=
  ⋃({ w ∈ ℝ | (InResidueClass(N, n, a) ∧ w = vonMangoldt(n)) ∨
    (¬InResidueClass(N, n, a) ∧ w = realZero) })

defgraph residueClass (N : Nat, a : Set) (n ∈ ℕ) : ℝ :=
  residueClassValue(N, a, n)
proof
  sorry

-- The terms χ(a)⁻¹ χ(n) Λ(n) of the expansion over the characters, as a
-- function of χ, and the family χ ↦ χ(a)⁻¹ χ Λ of coefficient functions.
defgraph residueCharacterTerms (N : Nat, a : Set, n : Nat) (χ ∈ dirichletCharacters(N)) :
    complexCarrier :=
  ℂ[complexInv(χ(a)) * χ(integerOfNat(n)) * complexOfReal(vonMangoldt(n))]
proof
  sorry

def residueCharacterFamily (N : Nat, a : Set) : Set :=
  { (χ, coefficientScale(complexInv(χ(a)), twistedVonMangoldt(χ))) |
    χ ∈ dirichletCharacters(N) }

-- The values −L′(s, χ)/L(s, χ), χ(a)⁻¹-weighted, as a function of χ.
defgraph residueLogDerivTerms (N : Nat, a s : Set) (χ ∈ dirichletCharacters(N)) :
    complexCarrier :=
  ℂ[complexInv(χ(a)) *
    -logDeriv(LFunctionMap(N, χ), complexCarrier ∖ {ℂ[1]}, s)]
proof
  sorry

-- n ↦ Λ_a(n)/n on the primes and 0 elsewhere (the series of Mathlib's
-- not_summable_residueClass_prime_div).
def primeResidueValue (N : Nat, a : Set, n : Nat) : Set :=
  ⋃({ w ∈ ℝ | (Prime(n) ∧ w = R[residueClass(N, a)(n) / realNat(n)]) ∨
    (¬Prime(n) ∧ w = realZero) })

defgraph primeResidueTerms (N : Nat, a : Set) (n ∈ ℕ) : ℝ :=
  primeResidueValue(N, a, n)
proof
  sorry

-- The primes p ≡ a (mod N).
def primesInClass (N : Nat, a : Set) : Set :=
  { p ∈ ℕ | Prime(p) ∧ InResidueClass(N, p, a) }

-- The closed half-plane re s ≥ 1.
def closedRightHalfPlane (S : Real) : Set :=
  { z ∈ complexCarrier | S ≤ complexRe(z) }

-- Section: The von Mangoldt function
theorem vonMangoldt.real (n : Nat)
  shows vonMangoldt(n) ∈ ℝ
proof
  sorry

-- Mathlib's vonMangoldt_apply_prime.
theorem vonMangoldt.prime (p : Nat)
  requires prime : Prime(p)
  shows vonMangoldt(p) = realLog(realNat(p))
proof
  sorry

-- Λ(p^k) = log p for k ≥ 1 (Mathlib's vonMangoldt_apply_pow with Λ(p)).
theorem vonMangoldt.prime_pow (p k : Nat)
  requires prime : Prime(p)
  requires positive : 1 ≤ k
  shows vonMangoldt(pow(p, k)) = realLog(realNat(p))
proof
  sorry

-- Λ(n^k) = Λ(n) for k ≥ 1 (Mathlib's vonMangoldt_apply_pow).
theorem vonMangoldt.pow (n k : Nat)
  requires positive : 1 ≤ k
  shows vonMangoldt(pow(n, k)) = vonMangoldt(n)
proof
  sorry

theorem vonMangoldt.not_prime_power (n : Nat)
  requires notPower : ¬PrimePower(n)
  shows vonMangoldt(n) = realZero
proof
  sorry

theorem vonMangoldt.one
  shows vonMangoldt(1) = realZero
proof
  sorry

-- Mathlib's vonMangoldt_nonneg.
theorem vonMangoldt.nonneg (n : Nat)
  shows realZero ≤ vonMangoldt(n)
proof
  sorry

-- Mathlib's vonMangoldt_le_log.
theorem vonMangoldt.le_log (n : Nat)
  requires positive : 1 ≤ n
  shows vonMangoldt(n) ≤ realLog(realNat(n))
proof
  sorry

-- Σ_{d ∣ n} Λ(d) = log n for n ≥ 1 (Mathlib's vonMangoldt_sum).
theorem vonMangoldt.sum_divisors (n : Nat)
  requires positive : 1 ≤ n
  shows complexFamilySum(vonMangoldtCoefficients, divisorSet(n)) =
    complexOfReal(realLog(realNat(n)))
proof
  sorry

theorem vonMangoldtCoefficients.function
  shows FunctionBetween(vonMangoldtCoefficients, ℕ, complexCarrier)
proof
  sorry

theorem twistedVonMangoldt.function (N : Nat) (χ : Set)
  requires character : DirichletCharacter(N, χ)
  shows FunctionBetween(twistedVonMangoldt(χ), ℕ, complexCarrier)
proof
  sorry

-- Section: The logarithmic derivative
-- Mathlib's ArithmeticFunction.LSeriesSummable_vonMangoldt.
theorem LSeriesSummable.vonMangoldt (s : Set)
  requires hs : s ∈ ℂ
  requires halfPlane : realOne < complexRe(s)
  shows LSeriesSummable(vonMangoldtCoefficients, s)
proof
  sorry

-- Mathlib's DirichletCharacter.LSeriesSummable_twist_vonMangoldt.
theorem LSeriesSummable.twist_vonMangoldt (N : Nat) (χ s : Set)
  requires positive : 1 ≤ N
  requires character : DirichletCharacter(N, χ)
  requires hs : s ∈ ℂ
  requires halfPlane : realOne < complexRe(s)
  shows LSeriesSummable(twistedVonMangoldt(χ), s)
proof
  sorry

-- Σ Λ(n) n^(−s) = −ζ′(s)/ζ(s) for re s > 1 (Mathlib's
-- ArithmeticFunction.LSeries_vonMangoldt_eq_deriv_riemannZeta_div).
theorem LSeries.vonMangoldt_eq (s : Set)
  requires hs : s ∈ ℂ
  requires halfPlane : realOne < complexRe(s)
  shows LSeries(vonMangoldtCoefficients, s) =
    ℂ[-logDeriv(riemannZetaMap, complexCarrier ∖ {ℂ[1]}, s)]
proof
  sorry

-- Σ χ(n) Λ(n) n^(−s) = −L′(s, χ)/L(s, χ) for re s > 1, with the series of
-- χ (Mathlib's DirichletCharacter.LSeries_twist_vonMangoldt_eq).
theorem LSeries.twist_vonMangoldt_eq (N : Nat) (χ s : Set)
  requires positive : 1 ≤ N
  requires character : DirichletCharacter(N, χ)
  requires hs : s ∈ ℂ
  requires halfPlane : realOne < complexRe(s)
  shows LSeries(twistedVonMangoldt(χ), s) =
    ℂ[-logDeriv(LSeriesMap(characterCoefficients(χ)), rightHalfPlane(R[1]),
      s)]
proof
  sorry

-- and with layer 1's L(·, χ), holomorphic on ℂ ∖ {1}.
theorem LSeriesHasSum.twist_vonMangoldt (N : Nat) (χ s : Set)
  requires positive : 1 ≤ N
  requires character : DirichletCharacter(N, χ)
  requires hs : s ∈ ℂ
  requires halfPlane : realOne < complexRe(s)
  shows LSeriesHasSum(twistedVonMangoldt(χ), s,
    ℂ[-logDeriv(LFunctionMap(N, χ), complexCarrier ∖ {ℂ[1]}, s)])
proof
  sorry

-- For χ₀ through the entire (s − 1) L(s, χ₀): Σ χ₀(n) Λ(n) n^(−s) =
-- 1/(s − 1) − ((s − 1) L(s, χ₀))′/((s − 1) L(s, χ₀)), re s > 1 (the
-- principal case of the source's LSeriesHasSum_mul_vonMangoldt).
theorem LSeriesHasSum.principal_vonMangoldt (N : Nat) (s : Set)
  requires positive : 1 ≤ N
  requires hs : s ∈ ℂ
  requires halfPlane : realOne < complexRe(s)
  shows LSeriesHasSum(twistedVonMangoldt(principalCharacter(N)), s,
    ℂ[complexInv(ℂ[s - 1]) -
      logDeriv(principalLFunctionOneMap(N), complexCarrier, s)])
proof
  sorry

-- −L′/L is holomorphic on a neighbourhood of re s ≥ 1 for χ ≠ χ₀, and
-- −((s − 1)L(s, χ₀))′/((s − 1)L(s, χ₀)) for χ₀ (no zero on re s ≥ 1).
theorem logDeriv.holomorphic_near_one_line (N : Nat) (χ : Set)
  requires positive : 1 ≤ N
  requires character : DirichletCharacter(N, χ)
  requires nonPrincipal : χ ≠ principalCharacter(N)
  shows ∃ U, ComplexOpen(U) ∧ closedRightHalfPlane(R[1]) ⊆ U ∧
    (∀ s ∈ U, LFunction(N, χ, s) ≠ ℂ[0])
proof
  sorry

theorem logDeriv.principal_near_one_line (N : Nat)
  requires positive : 1 ≤ N
  shows ∃ U, ComplexOpen(U) ∧ closedRightHalfPlane(R[1]) ⊆ U ∧
    (∀ s ∈ U, principalLFunctionOne(N, s) ≠ ℂ[0])
proof
  sorry

-- Section: Residue classes
theorem residueClass.real (N : Nat) (a : Set) (n : Nat)
  shows residueClass(N, a)(n) ∈ ℝ
proof
  sorry

theorem residueClass.sequence (N : Nat) (a : Set)
  shows RealSequence(residueClass(N, a))
proof
  sorry

theorem residueClass.apply_mem (N : Nat) (a : Set) (n : Nat)
  requires inClass : InResidueClass(N, n, a)
  shows residueClass(N, a)(n) = vonMangoldt(n)
proof
  sorry

theorem residueClass.apply_not_mem (N : Nat) (a : Set) (n : Nat)
  requires notInClass : ¬InResidueClass(N, n, a)
  shows residueClass(N, a)(n) = realZero
proof
  sorry

-- Mathlib's vonMangoldt.residueClass_nonneg and residueClass_le.
theorem residueClass.nonneg (N : Nat) (a : Set) (n : Nat)
  shows realZero ≤ residueClass(N, a)(n)
proof
  sorry

theorem residueClass.le_vonMangoldt (N : Nat) (a : Set) (n : Nat)
  shows residueClass(N, a)(n) ≤ vonMangoldt(n)
proof
  sorry

-- Orthogonality: for a coprime to N ≥ 1,
-- Λ_a(n) = φ(N)⁻¹ Σ_χ χ(a)⁻¹ χ(n) Λ(n) (Mathlib's residueClass_apply).
theorem residueClass.apply (N : Nat) (a : Set) (n : Nat)
  requires positive : 1 ≤ N
  requires integer : a ∈ ℤ
  requires unit : IntegerCoprime(a, integerOfNat(N))
  shows complexOfReal(residueClass(N, a)(n)) =
    ℂ[complexInv(complexOfReal(realNat(totient(N)))) *
      complexFamilySum(residueCharacterTerms(N, a, n),
        dirichletCharacters(N))]
proof
  sorry

-- The same as coefficient functions (Mathlib's residueClass_eq).
theorem residueClass.eq (N : Nat) (a : Set)
  requires positive : 1 ≤ N
  requires integer : a ∈ ℤ
  requires unit : IntegerCoprime(a, integerOfNat(N))
  shows realCoefficients(residueClass(N, a)) =
    coefficientScale(complexInv(complexOfReal(realNat(totient(N)))),
      coefficientFamilySum(residueCharacterFamily(N, a),
        dirichletCharacters(N)))
proof
  sorry

-- Mathlib's vonMangoldt.LSeriesSummable_residueClass.
theorem LSeriesSummable.residueClass (N : Nat) (a s : Set)
  requires hs : s ∈ ℂ
  requires halfPlane : realOne < complexRe(s)
  shows LSeriesSummable(realCoefficients(residueClass(N, a)), s)
proof
  sorry

-- The series of Λ_a is φ(N)⁻¹ Σ_χ χ(a)⁻¹ (−L′(s, χ)/L(s, χ)) on re s > 1
-- (Mathlib's vonMangoldt.LSeries_residueClass_eq).
theorem LSeriesHasSum.residueClass (N : Nat) (a s : Set)
  requires positive : 1 ≤ N
  requires integer : a ∈ ℤ
  requires unit : IntegerCoprime(a, integerOfNat(N))
  requires hs : s ∈ ℂ
  requires halfPlane : realOne < complexRe(s)
  shows LSeriesHasSum(realCoefficients(residueClass(N, a)), s,
    ℂ[complexInv(complexOfReal(realNat(totient(N)))) *
      complexFamilySum(residueLogDerivTerms(N, a, s),
        dirichletCharacters(N))])
proof
  sorry

-- The series of Λ_a minus φ(N)⁻¹/(s − 1) extends continuously to
-- re s ≥ 1 (Mathlib's vonMangoldt.continuousOn_LFunctionResidueClassAux).
theorem LSeries.residueClass_regular (N : Nat) (a : Set)
  requires positive : 1 ≤ N
  requires integer : a ∈ ℤ
  requires unit : IntegerCoprime(a, integerOfNat(N))
  shows ∃ G, ComplexContinuousOn(G, closedRightHalfPlane(R[1])) ∧
    (∀ s ∈ ℂ, realOne < complexRe(s) →
      G(s) = ℂ[LSeries(realCoefficients(residueClass(N, a)), s) -
        complexInv(complexOfReal(realNat(totient(N)))) *
          complexInv(ℂ[s - 1])])
proof
  sorry

-- Section: Dirichlet's theorem
-- Σ_{p ≡ a} Λ(p)/p diverges (Mathlib's
-- vonMangoldt.not_summable_residueClass_prime_div).
theorem residueClass.not_summable_prime_div (N : Nat) (a : Set)
  requires positive : 1 ≤ N
  requires integer : a ∈ ℤ
  requires unit : IntegerCoprime(a, integerOfNat(N))
  shows ¬Summable(primeResidueTerms(N, a))
proof
  sorry

-- Infinitely many primes in the class: above every n there is a prime
-- p ≡ a (mod N) (Mathlib's Nat.forall_exists_prime_gt_and_eq_mod).
theorem dirichlet.exists_prime_gt (N : Nat) (a : Set) (n : Nat)
  requires positive : 1 ≤ N
  requires integer : a ∈ ℤ
  requires unit : IntegerCoprime(a, integerOfNat(N))
  shows ∃ p ∈ ℕ, n < p ∧ Prime(p) ∧ InResidueClass(N, p, a)
proof
  sorry

-- Mathlib's Nat.infinite_setOf_prime_and_eq_mod.
theorem dirichlet.primes_infinite (N : Nat) (a : Set)
  requires positive : 1 ≤ N
  requires integer : a ∈ ℤ
  requires unit : IntegerCoprime(a, integerOfNat(N))
  shows ¬Finite(primesInClass(N, a))
proof
  sorry

end VonMangoldt
