-- Nonvanishing of Dirichlet L-functions on re s ≥ 1 in the form the proof
-- uses it, and the entire functions it works with: the Möbius series and
-- L(s, χ) Σ χ(n) μ(n) n^(−s) = 1 for re s > 1; the principal L-function
-- as ζ(s) ∏_{p ∣ N} (1 − p^(−s)) and its entire multiple (s − 1) L(s, χ₀)
-- with value ∏_{p ∣ N} (1 − 1/p) at 1; ζ(s) − 1/(s − 1) and (s − 1) ζ(s)
-- as entire functions; the 3–4–1 inequality 3 + 4 cos θ + cos 2θ ≥ 0, its
-- logarithmic form, and |L(1 + x, χ₀)³ L(1 + x + iy, χ)⁴ L(1 + x + 2iy, χ²)|
-- ≥ 1; and L(1 + it, χ) ≠ 0.
-- Part of the GRH blueprint (layer 2, track D: the L-series bridge).
-- Source: Mathlib's NumberTheory/LSeries/{Nonvanishing, Dirichlet,
-- DirichletContinuation}, NumberTheory/Harmonic/ZetaAsymp and
-- NumberTheory/ArithmeticFunction/Moebius.
-- Planned home: NumberTheory/LSeries/Nonvanishing.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.LSeries.NonVanishing
import GRH.LSeries.Dirichlet
import Grace.Cumulus.Combinatorics.Moebius

section NonVanishing
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Section: Definitions
-- The Möbius coefficients n ↦ μ(n) in ℂ (Mathlib's ↗μ).
def moebiusCoefficients : Set :=
  { (n, complexOfReal(realInt(moebius(n)))) | n ∈ ℕ }

-- The coefficients δ of the unit for convolution: 1 at n = 1, 0 elsewhere
-- (Mathlib's LSeries.delta).
def deltaCoefficients : Set :=
  { (n, complexOfReal(realNat(indicator({(1:N)}, n)))) | n ∈ ℕ }

-- The principal L-function L(s, χ₀) modulo N (Mathlib's
-- LFunctionTrivChar N).
def principalLFunction (N : Nat, s : Set) : Set :=
  LFunction(N, principalCharacter(N), s)

-- ∏_{p ∣ N} (1 − p^(−s)): layer 1's levelProduct for the character 1
-- modulo 1, every prime dividing N being at most N.
def principalLevelProduct (N : Nat, s : Set) : Set :=
  levelProduct(N, principalCharacter(1), s, succ(N))

-- The entire function (s − 1) L(s, χ₀), with its value
-- ∏_{p ∣ N} (1 − 1/p) at s = 1 (Mathlib's LFunctionTrivChar₁).
def principalLFunctionOne (N : Nat, s : Set) : Set :=
  ⋃({ w ∈ complexCarrier |
    (s ≠ ℂ[1] ∧ w = ℂ[(s - 1) * LFunction(N, principalCharacter(N), s)]) ∨
    (s = ℂ[1] ∧ w = principalLevelProduct(N, ℂ[1])) })

-- ζ(s) − 1/(s − 1), entire: layer 1's regular part of ζ(s, 1), whose value
-- at 1 is layer 1's ζ(1), the constant term of the Laurent expansion
-- (Mathlib's riemannZeta₀).
def riemannZetaRegular (s : Set) : Set := hurwitzZetaRegularMap(R[1])(s)

defgraph riemannZetaRegularMap (s ∈ complexCarrier) : complexCarrier :=
    riemannZetaRegular(s)
proof
  have function := hurwitzZetaRegularMap.function at R[1]
  unfold riemannZetaRegular
  exact FunctionBetween.apply_closed with function, member

-- (s − 1) ζ(s), entire, with value 1 at s = 1 (Mathlib's riemannZeta₁).
def riemannZetaResidual (s : Set) : Set :=
  ℂ[1 + (s - 1) * riemannZetaRegular(s)]

defgraph riemannZetaResidualMap (s ∈ complexCarrier) : complexCarrier :=
    riemannZetaResidual(s)
proof
  have function := hurwitzZetaRegularMap.function at R[1]
  have regular := FunctionBetween.apply_closed with function, member
  unfold riemannZetaResidual
  unfold riemannZetaRegular
  typecheck

theorem moebiusCoefficients.eval (n : Set)
  requires index : n ∈ ℕ
  shows moebiusCoefficients(n) = complexOfReal(realInt(moebius(n)))
proof
  have shape : ∀ p0 ∈ moebiusCoefficients, ∃ a0 ∈ ℕ, ∃ b0, p0 = (a0, b0)
    intros p0 hp
    simp [moebiusCoefficients] at hp
    obtain ⟨m0, mIn, eq⟩ := hp
    rw ← eq
    exact ⟨m0, mIn, complexOfReal(realInt(moebius(m0))), rfl⟩
  have total : ∀ a0 ∈ ℕ, ∃ b0, (a0, b0) ∈ moebiusCoefficients
    intros a0 aIn
    refine ⟨complexOfReal(realInt(moebius(a0))), ?_⟩
    simp [moebiusCoefficients]
  have functional : ∀ a0, ∀ b0, ∀ c0, (a0, b0) ∈ moebiusCoefficients →
      (a0, c0) ∈ moebiusCoefficients → b0 = c0
    intros a0 b0 c0 ab ac
    simp [moebiusCoefficients] at ab
    simp [moebiusCoefficients] at ac
    obtain ⟨m0, _, abEq⟩ := ab
    obtain ⟨k0, _, acEq⟩ := ac
    obtain ⟨ma, mb⟩ := orderedPair.injective with abEq
    obtain ⟨ka, kc⟩ := orderedPair.injective with acEq
    cc
  have mapped : (n, complexOfReal(realInt(moebius(n)))) ∈ moebiusCoefficients
    simp [moebiusCoefficients]
  exact coefficientGraph.apply with shape, total, functional, index, mapped

theorem moebiusCoefficients.maps (B : Set)
  requires values : ∀ n ∈ ℕ, complexOfReal(realInt(moebius(n))) ∈ B
  shows moebiusCoefficients : ℕ → B
proof
  have shape : ∀ p0 ∈ moebiusCoefficients, ∃ a0 ∈ ℕ, ∃ b0 ∈ B, p0 = (a0, b0)
    intros p0 hp
    simp [moebiusCoefficients] at hp
    obtain ⟨m0, mIn, eq⟩ := hp
    have value := values with m0, mIn
    rw ← eq
    exact ⟨m0, mIn, complexOfReal(realInt(moebius(m0))), value, rfl⟩
  have total : ∀ a0 ∈ ℕ, ∃ b0 ∈ B, (a0, b0) ∈ moebiusCoefficients
    intros a0 aIn
    have value := values with a0, aIn
    refine ⟨complexOfReal(realInt(moebius(a0))), value, ?_⟩
    simp [moebiusCoefficients]
  have functional : ∀ a0, ∀ b0, ∀ c0, (a0, b0) ∈ moebiusCoefficients →
      (a0, c0) ∈ moebiusCoefficients → b0 = c0
    intros a0 b0 c0 ab ac
    simp [moebiusCoefficients] at ab
    simp [moebiusCoefficients] at ac
    obtain ⟨m0, _, abEq⟩ := ab
    obtain ⟨k0, _, acEq⟩ := ac
    obtain ⟨ma, mb⟩ := orderedPair.injective with abEq
    obtain ⟨ka, kc⟩ := orderedPair.injective with acEq
    cc
  exact coefficientGraph.function with shape, total, functional

theorem deltaCoefficients.eval (n : Set)
  requires index : n ∈ ℕ
  shows deltaCoefficients(n) = complexOfReal(realNat(indicator({(1:N)}, n)))
proof
  have shape : ∀ p0 ∈ deltaCoefficients, ∃ a0 ∈ ℕ, ∃ b0, p0 = (a0, b0)
    intros p0 hp
    simp [deltaCoefficients] at hp
    obtain ⟨m0, mIn, eq⟩ := hp
    rw ← eq
    exact ⟨m0, mIn, complexOfReal(realNat(indicator({(1:N)}, m0))), rfl⟩
  have total : ∀ a0 ∈ ℕ, ∃ b0, (a0, b0) ∈ deltaCoefficients
    intros a0 aIn
    refine ⟨complexOfReal(realNat(indicator({(1:N)}, a0))), ?_⟩
    simp [deltaCoefficients]
  have functional : ∀ a0, ∀ b0, ∀ c0, (a0, b0) ∈ deltaCoefficients →
      (a0, c0) ∈ deltaCoefficients → b0 = c0
    intros a0 b0 c0 ab ac
    simp [deltaCoefficients] at ab
    simp [deltaCoefficients] at ac
    obtain ⟨m0, _, abEq⟩ := ab
    obtain ⟨k0, _, acEq⟩ := ac
    obtain ⟨ma, mb⟩ := orderedPair.injective with abEq
    obtain ⟨ka, kc⟩ := orderedPair.injective with acEq
    cc
  have mapped : (n, complexOfReal(realNat(indicator({(1:N)}, n)))) ∈ deltaCoefficients
    simp [deltaCoefficients]
  exact coefficientGraph.apply with shape, total, functional, index, mapped

theorem deltaCoefficients.maps (B : Set)
  requires values : ∀ n ∈ ℕ, complexOfReal(realNat(indicator({(1:N)}, n))) ∈ B
  shows deltaCoefficients : ℕ → B
proof
  have shape : ∀ p0 ∈ deltaCoefficients, ∃ a0 ∈ ℕ, ∃ b0 ∈ B, p0 = (a0, b0)
    intros p0 hp
    simp [deltaCoefficients] at hp
    obtain ⟨m0, mIn, eq⟩ := hp
    have value := values with m0, mIn
    rw ← eq
    exact ⟨m0, mIn, complexOfReal(realNat(indicator({(1:N)}, m0))), value, rfl⟩
  have total : ∀ a0 ∈ ℕ, ∃ b0 ∈ B, (a0, b0) ∈ deltaCoefficients
    intros a0 aIn
    have value := values with a0, aIn
    refine ⟨complexOfReal(realNat(indicator({(1:N)}, a0))), value, ?_⟩
    simp [deltaCoefficients]
  have functional : ∀ a0, ∀ b0, ∀ c0, (a0, b0) ∈ deltaCoefficients →
      (a0, c0) ∈ deltaCoefficients → b0 = c0
    intros a0 b0 c0 ab ac
    simp [deltaCoefficients] at ab
    simp [deltaCoefficients] at ac
    obtain ⟨m0, _, abEq⟩ := ab
    obtain ⟨k0, _, acEq⟩ := ac
    obtain ⟨ma, mb⟩ := orderedPair.injective with abEq
    obtain ⟨ka, kc⟩ := orderedPair.injective with acEq
    cc
  exact coefficientGraph.function with shape, total, functional

-- re(1 + it) = 1.
theorem complexRe.one_add_i_mul (T : Real)
  shows complexRe(ℂ[1 + complexImaginaryUnit * complexOfReal(T)]) = R[1]
proof
  have one := complexOne.member
  have iMember := complexImaginaryUnit.member
  have castMember : complexOfReal(T) ∈ ℂ by typecheck
  have productMember : ℂ[complexImaginaryUnit * complexOfReal(T)] ∈ ℂ by
    typecheck
  have imI : complexIm(complexImaginaryUnit) = R[1]
    unfold complexImaginaryUnit
    unfold complexIm
    rw snd.pair
  have reI : complexRe(complexImaginaryUnit) = R[0]
    unfold complexImaginaryUnit
    unfold complexRe
    rw fst.pair
  rw [(complexRe.add with one, productMember), complexRe.one,
    (complexRe.mul with iMember, castMember), imI, reI, complexOfReal.re,
    complexOfReal.im]
  ring

-- im(1 + it) = t.
theorem complexIm.one_add_i_mul (T : Real)
  shows complexIm(ℂ[1 + complexImaginaryUnit * complexOfReal(T)]) = T
proof
  have one := complexOne.member
  have iMember := complexImaginaryUnit.member
  have castMember : complexOfReal(T) ∈ ℂ by typecheck
  have productMember : ℂ[complexImaginaryUnit * complexOfReal(T)] ∈ ℂ by
    typecheck
  have imI : complexIm(complexImaginaryUnit) = R[1]
    unfold complexImaginaryUnit
    unfold complexIm
    rw snd.pair
  have reI : complexRe(complexImaginaryUnit) = R[0]
    unfold complexImaginaryUnit
    unfold complexRe
    rw fst.pair
  have imOne : complexIm(ℂ[1]) = R[0]
    rw [← complexOfReal.one, complexOfReal.im]
  rw [(complexIm.add with one, productMember), imOne,
    (complexIm.mul with iMember, castMember), imI, reI, complexOfReal.re,
    complexOfReal.im]
  ring

-- No prime divides 1, so the level product modulo 1 is 1.
theorem levelProduct.level_one (ψ s : Set) (n : Nat)
  requires values : FunctionBetween(ψ, ℤ, complexCarrier)
  requires hs : s ∈ ℂ
  shows levelProduct(1, ψ, s, n) = ℂ[1]
proof
  induction n
  | zero =>
    rw levelProduct
  | succ(k) using ih =>
    obtain ⟨_, _, other⟩ := levelFactor.selected at 1, ψ, s, k with values, hs
    have notDividing : ¬(Prime(k) ∧ k ∣ 1)
      intro both
      obtain ⟨prime, divides⟩ := both
      have above := Prime.greater_than_one with prime
      have nonzero : (1:N) ≠ (0:N) by arith
      have below := divides.le with divides, nonzero
      arith
    rw [levelProduct, ih, (other with notDividing)]
    ring

-- re(z + iy) = re z.
theorem complexRe.add_i_mul (z : Set) (T : Real)
  requires hz : z ∈ ℂ
  shows complexRe(ℂ[z + complexImaginaryUnit * complexOfReal(T)]) =
    complexRe(z)
proof
  have iMember := complexImaginaryUnit.member
  have castMember : complexOfReal(T) ∈ ℂ by typecheck
  have productMember : ℂ[complexImaginaryUnit * complexOfReal(T)] ∈ ℂ by
    typecheck
  have imI : complexIm(complexImaginaryUnit) = R[1]
    unfold complexImaginaryUnit
    unfold complexIm
    rw snd.pair
  have reI : complexRe(complexImaginaryUnit) = R[0]
    unfold complexImaginaryUnit
    unfold complexRe
    rw fst.pair
  have reZ : Real(complexRe(z)) by typecheck
  rw [(complexRe.add with hz, productMember),
    (complexRe.mul with iMember, castMember), imI, reI, complexOfReal.re,
    complexOfReal.im]
  ring

-- Section: The Möbius series
theorem moebiusCoefficients.function
  shows FunctionBetween(moebiusCoefficients, ℕ, complexCarrier)
proof
  apply moebiusCoefficients.maps
  intros n nIn
  have nNat := nat.omega.backward with nIn
  have integer := moebius.integer at n
  typecheck

-- |μ(n)| ≤ 1 (Mathlib's ArithmeticFunction.abs_moebius_le_one).
theorem moebiusCoefficients.abs_le_one (n : Nat)
  shows complexAbs(moebiusCoefficients(n)) ≤ R[1]
proof
  sorry

-- μ ⋆ 1 = δ (Mathlib's ArithmeticFunction.moebius_mul_coe_zeta).
theorem moebiusCoefficients.convolution_one (n : Nat)
  requires positive : 1 ≤ n
  shows dirichletConvolution(moebiusCoefficients, oneCoefficients)(n) =
    deltaCoefficients(n)
proof
  sorry

-- The series of δ is 1 (Mathlib's LSeries_delta).
theorem LSeriesHasSum.delta (s : Set)
  requires hs : s ∈ ℂ
  shows LSeriesHasSum(deltaCoefficients, s, ℂ[1])
proof
  sorry

-- Mathlib's ArithmeticFunction.LSeriesSummable_moebius_iff.
theorem LSeriesSummable.moebius_iff (s : Set)
  requires hs : s ∈ ℂ
  shows LSeriesSummable(moebiusCoefficients, s) ↔ realOne < complexRe(s)
proof
  sorry

-- ζ(s) Σ μ(n) n^(−s) = 1 for re s > 1 (Mathlib's
-- LSeries_one_mul_Lseries_moebius).
theorem riemannZeta.mul_moebius (s : Set)
  requires hs : s ∈ ℂ
  requires halfPlane : realOne < complexRe(s)
  shows ℂ[riemannZeta(s) * LSeries(moebiusCoefficients, s)] = ℂ[1]
proof
  sorry

-- L(s, χ) Σ χ(n) μ(n) n^(−s) = 1 for re s > 1 (Mathlib's
-- DirichletCharacter.LSeries.mul_mu_eq_one), with the series of χ.
theorem LSeries.mul_mu_eq_one (N : Nat) (χ s : Set)
  requires positive : 1 ≤ N
  requires character : DirichletCharacter(N, χ)
  requires hs : s ∈ ℂ
  requires halfPlane : realOne < complexRe(s)
  shows ℂ[LSeries(characterCoefficients(χ), s) *
    LSeries(coefficientMul(characterCoefficients(χ), moebiusCoefficients),
      s)] = ℂ[1]
proof
  sorry

-- and with layer 1's L(s, χ).
theorem LFunction.mul_mu_eq_one (N : Nat) (χ s : Set)
  requires positive : 1 ≤ N
  requires character : DirichletCharacter(N, χ)
  requires hs : s ∈ ℂ
  requires halfPlane : realOne < complexRe(s)
  shows ℂ[LFunction(N, χ, s) *
    LSeries(coefficientMul(characterCoefficients(χ), moebiusCoefficients),
      s)] = ℂ[1]
proof
  sorry

-- Mathlib's DirichletCharacter.LSeries_ne_zero_of_one_lt_re.
theorem LSeries.ne_zero_of_one_lt_re (N : Nat) (χ s : Set)
  requires positive : 1 ≤ N
  requires character : DirichletCharacter(N, χ)
  requires hs : s ∈ ℂ
  requires halfPlane : realOne < complexRe(s)
  shows LSeries(characterCoefficients(χ), s) ≠ ℂ[0]
proof
  rw ← (LFunction.eq_LSeries with positive, character, hs, halfPlane)
  exact LFunction.nonzero_re_gt_one with positive, character, hs, halfPlane

-- Section: The principal L-function
-- The character 1 modulo 1 induces χ₀ modulo N.
theorem changeLevel.principal_one (N : Nat)
  requires positive : 1 ≤ N
  shows changeLevel(N, principalCharacter(1)) = principalCharacter(N)
proof
  have unit : 1 * N = N by arith
  have divides := divides.intro at 1, N, N with unit
  have character := principalCharacter.character at 1
  have iff := changeLevel.principal_iff with positive, divides, character
  exact iff.backward with rfl

theorem principalLevelProduct.member (N : Nat) (s : Set)
  requires hs : s ∈ ℂ
  shows principalLevelProduct(N, s) ∈ ℂ
proof
  have values := DirichletCharacter.function with
    (principalCharacter.character at 1)
  unfold principalLevelProduct
  exact levelProduct.member with values, hs

-- ∏_{p ∣ N} (1 − p^(−s)) vanishes only on re s = 0 (Mathlib's
-- prod_euler_factor_ne_zero pattern, for χ = 1).
theorem principalLevelProduct.ne_zero (N : Nat) (s : Set)
  requires hs : s ∈ ℂ
  requires offAxis : complexRe(s) ≠ realZero
  shows principalLevelProduct(N, s) ≠ ℂ[0]
proof
  sorry

-- L(s, χ₀) = ∏_{p ∣ N} (1 − p^(−s)) ζ(s), s ≠ 1 (Mathlib's
-- LFunctionTrivChar_eq_mul_riemannZeta).
theorem principalLFunction.eq_mul_riemannZeta (N : Nat) (s : Set)
  requires positive : 1 ≤ N
  requires hs : s ∈ ℂ
  requires notOne : s ≠ ℂ[1]
  shows principalLFunction(N, s) =
    ℂ[principalLevelProduct(N, s) * riemannZeta(s)]
proof
  have unit : 1 * N = N by arith
  have divides := divides.intro at 1, N, N with unit
  have character := principalCharacter.character at 1
  have values := DirichletCharacter.function with character
  have pole : principalCharacter(1) ≠ principalCharacter(1) ∨ s ≠ ℂ[1]
    right
    exact notOne
  have changed := LFunction.changeLevel with positive, divides, character, hs,
    pole
  rw [(changeLevel.principal_one with positive),
    (LFunction.principal_one with character, hs)] at changed
  have zeta := riemannZeta.member with hs
  have product := levelProduct.member at N, principalCharacter(1), s, succ(N)
    with values, hs
  unfold principalLFunction
  unfold principalLevelProduct
  rw changed
  ring

theorem principalLFunctionOne.of_ne_one (N : Nat) (s : Set)
  requires hs : s ∈ ℂ
  requires notOne : s ≠ ℂ[1]
  shows principalLFunctionOne(N, s) =
    ℂ[(s - 1) * LFunction(N, principalCharacter(N), s)]
proof
  have values := DirichletCharacter.function with
    (principalCharacter.character at N)
  have value := LFunction.closed at N, principalCharacter(N), s with values, hs
  have product : ℂ[(s - 1) * LFunction(N, principalCharacter(N), s)] ∈ ℂ by
    typecheck
  unfold principalLFunctionOne
  apply union.of_unique
  . refine ⟨product, ?_⟩
    left
    exact ⟨notOne, rfl⟩
  . intros y hy
    obtain ⟨_, alternatives⟩ := hy
    rcases alternatives with ⟨_, yValue⟩ | ⟨isOne, _⟩
    . exact yValue
    . exfalso
      exact notOne with isOne

theorem principalLFunctionOne.at_one (N : Nat)
  shows principalLFunctionOne(N, ℂ[1]) = principalLevelProduct(N, ℂ[1])
proof
  have one := complexOne.member
  have product := principalLevelProduct.member at N, ℂ[1] with one
  unfold principalLFunctionOne
  apply union.of_unique
  . refine ⟨product, ?_⟩
    right
    exact ⟨rfl, rfl⟩
  . intros y hy
    obtain ⟨_, alternatives⟩ := hy
    rcases alternatives with ⟨notOne, _⟩ | ⟨_, yValue⟩
    . exfalso
      exact notOne with rfl
    . exact yValue

defgraph principalLFunctionOneMap (N : Nat) (s ∈ complexCarrier) :
    complexCarrier := principalLFunctionOne(N, s)
proof
  by_cases one : s = ℂ[1]
  . rw [one, principalLFunctionOne.at_one]
    exact principalLevelProduct.member at N, ℂ[1] with complexOne.member
  . rw (principalLFunctionOne.of_ne_one with member, one)
    have values := DirichletCharacter.function with
      (principalCharacter.character at N)
    have value := LFunction.closed at N, principalCharacter(N), s with values,
      member
    typecheck

theorem principalLFunctionOneMap.apply (N : Nat) (s : Set)
  requires hs : s ∈ ℂ
  shows principalLFunctionOneMap(N)(s) = principalLFunctionOne(N, s)
proof
  exact principalLFunctionOneMap.value with hs

-- Its value at 1 is not 0 (Mathlib's LFunctionTrivChar₁_apply_one_ne_zero).
theorem principalLFunctionOne.one_ne_zero (N : Nat)
  requires positive : 1 ≤ N
  shows principalLFunctionOne(N, ℂ[1]) ≠ ℂ[0]
proof
  have character := principalCharacter.character at 1
  have one := complexOne.member
  have positiveRe : realZero < complexRe(ℂ[1])
    rw complexRe.one
    linarith
  rw principalLFunctionOne.at_one
  unfold principalLevelProduct
  exact levelProduct.nonzero with character, one, positiveRe

-- nor anywhere on re s ≥ 1 (Mathlib's
-- LFunctionTrivChar₁_ne_zero with LFunction_ne_zero_of_one_le_re).
theorem principalLFunctionOne.ne_zero_of_one_le_re (N : Nat) (s : Set)
  requires positive : 1 ≤ N
  requires hs : s ∈ ℂ
  requires halfPlane : realOne ≤ complexRe(s)
  shows principalLFunctionOne(N, s) ≠ ℂ[0]
proof
  by_cases one : s = ℂ[1]
  . rw one
    exact principalLFunctionOne.one_ne_zero with positive
  . have character := principalCharacter.character at N
    have values := DirichletCharacter.function with character
    have shifted : ℂ[s - 1] ∈ ℂ by typecheck
    have nonzero : ℂ[s - 1] ≠ ℂ[0]
      intro zero
      have back : s = ℂ[1]
        have same : s = ℂ[(s - 1) + 1] by ring
        rw [same, zero]
        ring
      exact one with back
    have pole : principalCharacter(N) ≠ principalCharacter(N) ∨ s ≠ ℂ[1]
      right
      exact one
    have lNonzero := LFunction.nonzero_re_ge_one with positive, character, hs,
      halfPlane, pole
    have value := LFunction.closed at N, principalCharacter(N), s with values,
      hs
    rw (principalLFunctionOne.of_ne_one with hs, one)
    intro product
    have zero := complexMul.zero_factor with shifted, value, nonzero, product
    exact lNonzero with zero

-- Its derivative off 1 (Mathlib's deriv_LFunctionTrivChar₁_apply_of_ne_one).
theorem principalLFunctionOneMap.deriv_of_ne_one (N : Nat) (s : Set)
  requires positive : 1 ≤ N
  requires hs : s ∈ ℂ
  requires notOne : s ≠ ℂ[1]
  shows complexDeriv(principalLFunctionOneMap(N), complexCarrier)(s) =
    ℂ[(s - 1) * complexDeriv(LFunctionMap(N, principalCharacter(N)),
      complexCarrier ∖ {ℂ[1]})(s) + LFunction(N, principalCharacter(N), s)]
proof
  sorry

-- Section: ζ as entire functions
theorem riemannZetaRegular.member (s : Set)
  requires hs : s ∈ ℂ
  shows riemannZetaRegular(s) ∈ ℂ
proof
  have function := hurwitzZetaRegularMap.function at R[1]
  unfold riemannZetaRegular
  exact FunctionBetween.apply_closed with function, hs

-- ζ(s) = 1/(s − 1) + ζ₀(s) and ζ(s) = ζ₁(s)/(s − 1) for s ≠ 1 (Mathlib's
-- riemannZeta_eq_inv_sub_add, riemannZeta_eq_inv_sub_mul).
theorem riemannZeta.eq_inv_sub_add (s : Set)
  requires hs : s ∈ ℂ
  requires notOne : s ≠ ℂ[1]
  shows riemannZeta(s) = ℂ[complexInv(ℂ[s - 1]) + riemannZetaRegular(s)]
proof
  have shifted : ℂ[s - 1] ∈ ℂ by typecheck
  have inverse := complexInv.member at ℂ[s - 1] with shifted
  have zeta := hurwitzZeta.member at s, R[1] with hs
  unfold riemannZetaRegular
  rw (hurwitzZetaRegularMap.value at R[1], s with hs)
  unfold complexDiv
  unfold riemannZeta
  ring

theorem riemannZeta.eq_inv_sub_mul (s : Set)
  requires hs : s ∈ ℂ
  requires notOne : s ≠ ℂ[1]
  shows riemannZeta(s) = ℂ[complexInv(ℂ[s - 1]) * riemannZetaResidual(s)]
proof
  have shifted : ℂ[s - 1] ∈ ℂ by typecheck
  have nonzero : ℂ[s - 1] ≠ ℂ[0]
    intro zero
    have back : s = ℂ[1]
      have same : s = ℂ[(s - 1) + 1] by ring
      rw [same, zero]
      ring
    exact notOne with back
  have inverse := complexInv.member at ℂ[s - 1] with shifted
  have cancel := complexInv.mul_cancel with shifted, nonzero
  have regular := riemannZetaRegular.member with hs
  rw (riemannZeta.eq_inv_sub_add with hs, notOne)
  unfold riemannZetaResidual
  have expand : ℂ[complexInv(ℂ[s - 1]) * (1 + (s - 1) * riemannZetaRegular(s))]
      = ℂ[complexInv(ℂ[s - 1]) + ((s - 1) * complexInv(ℂ[s - 1])) *
        riemannZetaRegular(s)] by ring
  rw [expand, cancel]
  ring

-- ζ₀(1) is layer 1's ζ(1), the constant term at the pole (Mathlib's
-- riemannZeta₀_one gives Euler's constant γ; see
-- `riemannZetaRegular.one_euler_mascheroni` in GRH.LSeries.Values).
theorem riemannZetaRegular.one
  shows riemannZetaRegular(ℂ[1]) = riemannZeta(ℂ[1])
proof
  unfold riemannZetaRegular
  unfold riemannZeta
  rw [hurwitzZetaRegularMap.at_one, hurwitzZeta.at_one]

-- Mathlib's riemannZeta₁_one.
theorem riemannZetaResidual.one
  shows riemannZetaResidual(ℂ[1]) = ℂ[1]
proof
  have regular := riemannZetaRegular.member at ℂ[1] with complexOne.member
  unfold riemannZetaResidual
  ring

-- Modulo 1 it is (s − 1) ζ(s).
theorem principalLFunctionOne.level_one (s : Set)
  requires hs : s ∈ ℂ
  shows principalLFunctionOne(1, s) = riemannZetaResidual(s)
proof
  have character := principalCharacter.character at 1
  have values := DirichletCharacter.function with character
  by_cases one : s = ℂ[1]
  . rw [one, principalLFunctionOne.at_one, riemannZetaResidual.one]
    unfold principalLevelProduct
    exact levelProduct.level_one with values, complexOne.member
  . have shifted : ℂ[s - 1] ∈ ℂ by typecheck
    have nonzero : ℂ[s - 1] ≠ ℂ[0]
      intro zero
      have back : s = ℂ[1]
        have same : s = ℂ[(s - 1) + 1] by ring
        rw [same, zero]
        ring
      exact one with back
    have cancel := complexInv.mul_cancel with shifted, nonzero
    have inverse := complexInv.member at ℂ[s - 1] with shifted
    have residual : riemannZetaResidual(s) ∈ ℂ
      have regular := riemannZetaRegular.member with hs
      unfold riemannZetaResidual
      typecheck
    rw [(principalLFunctionOne.of_ne_one with hs, one),
      (LFunction.principal_one with character, hs),
      (riemannZeta.eq_inv_sub_mul with hs, one)]
    have regroup : ℂ[(s - 1) * (complexInv(ℂ[s - 1]) *
        riemannZetaResidual(s))] = ℂ[((s - 1) * complexInv(ℂ[s - 1])) *
        riemannZetaResidual(s)] by ring
    rw [regroup, cancel]
    ring

-- Mathlib's differentiable_riemannZeta₀ and differentiable_riemannZeta₁.
theorem riemannZetaRegularMap.holomorphic
  shows HolomorphicOn(riemannZetaRegularMap, complexCarrier)
proof
  have positive : R[0] < R[1] by linarith
  have holomorphic := hurwitzZetaRegularMap.holomorphic at R[1] with positive
  have left := riemannZetaRegularMap.function
  have right := hurwitzZetaRegularMap.function at R[1]
  have same : riemannZetaRegularMap = hurwitzZetaRegularMap(R[1])
    apply FunctionBetween.ext with left, right
    intros s hs
    rw (riemannZetaRegularMap.value with hs)
    unfold riemannZetaRegular
    rfl
  rw same
  exact holomorphic

-- The maps s ↦ s, s ↦ s − 1 and s ↦ (s − 1) ζ₀(s), entire.
defgraph complexIdentityMap (s ∈ complexCarrier) : complexCarrier := s
proof
  exact member

defgraph complexShiftMap (s ∈ complexCarrier) : complexCarrier := ℂ[s - 1]
proof
  typecheck

defgraph zetaRegularProductMap (s ∈ complexCarrier) : complexCarrier :=
    ℂ[(s - 1) * riemannZetaRegular(s)]
proof
  have regular := riemannZetaRegular.member with member
  typecheck

theorem complexShiftMap.holomorphic
  shows HolomorphicOn(complexShiftMap, complexCarrier)
proof
  have whole := ComplexOpen.whole
  have identity : HolomorphicOn(complexIdentityMap, complexCarrier)
    apply HolomorphicOn.id_formula with whole
    intros z hz
    exact complexIdentityMap.value with hz
  have one : ℂ[1] ∈ ℂ by typecheck
  have minusOne : ℂ[-1] ∈ ℂ by typecheck
  apply HolomorphicOn.affine_formula with identity, one, minusOne
  intros z hz
  rw [(complexShiftMap.value with hz), (complexIdentityMap.value with hz)]
  ring

theorem zetaRegularProductMap.holomorphic
  shows HolomorphicOn(zetaRegularProductMap, complexCarrier)
proof
  have shift := complexShiftMap.holomorphic
  have regular := riemannZetaRegularMap.holomorphic
  apply HolomorphicOn.mul_formula with shift, regular
  intros z hz
  rw [(zetaRegularProductMap.value with hz), (complexShiftMap.value with hz),
    (riemannZetaRegularMap.value with hz)]

-- (s − 1) L(s, χ₀) = ∏_{p ∣ N} (1 − p^(−s)) (s − 1) ζ(s), at s = 1 too.
theorem principalLFunctionOne.eq_mul_residual (N : Nat) (s : Set)
  requires positive : 1 ≤ N
  requires hs : s ∈ ℂ
  shows principalLFunctionOne(N, s) =
    ℂ[principalLevelProduct(N, s) * riemannZetaResidual(s)]
proof
  have product := principalLevelProduct.member with hs
  by_cases one : s = ℂ[1]
  . rw [one, principalLFunctionOne.at_one, riemannZetaResidual.one]
    ring
  . have shifted : ℂ[s - 1] ∈ ℂ by typecheck
    have nonzero : ℂ[s - 1] ≠ ℂ[0]
      intro zero
      have back : s = ℂ[1]
        have same : s = ℂ[(s - 1) + 1] by ring
        rw [same, zero]
        ring
      exact one with back
    have cancel := complexInv.mul_cancel with shifted, nonzero
    have inverse := complexInv.member at ℂ[s - 1] with shifted
    have regular := riemannZetaRegular.member with hs
    have residual : riemannZetaResidual(s) ∈ ℂ
      unfold riemannZetaResidual
      typecheck
    have principal := principalLFunction.eq_mul_riemannZeta with positive, hs,
      one
    unfold principalLFunction at principal
    rw [(principalLFunctionOne.of_ne_one with hs, one), principal,
      (riemannZeta.eq_inv_sub_mul with hs, one)]
    have regroup : ℂ[(s - 1) * (principalLevelProduct(N, s) *
        (complexInv(ℂ[s - 1]) * riemannZetaResidual(s)))] =
      ℂ[((s - 1) * complexInv(ℂ[s - 1])) * (principalLevelProduct(N, s) *
        riemannZetaResidual(s))] by ring
    rw [regroup, cancel]
    ring

theorem riemannZetaResidualMap.holomorphic
  shows HolomorphicOn(riemannZetaResidualMap, complexCarrier)
proof
  have product := zetaRegularProductMap.holomorphic
  have one : ℂ[1] ∈ ℂ by typecheck
  apply HolomorphicOn.affine_formula with product, one, one
  intros z hz
  have regular := riemannZetaRegular.member with hz
  rw [(riemannZetaResidualMap.value with hz), (zetaRegularProductMap.value with hz)]
  unfold riemannZetaResidual
  ring

-- (s − 1) L(s, χ₀) is entire (Mathlib's
-- DirichletCharacter.differentiable_LFunctionTrivChar₁).
theorem principalLFunctionOneMap.holomorphic (N : Nat)
  requires positive : 1 ≤ N
  shows HolomorphicOn(principalLFunctionOneMap(N), complexCarrier)
proof
  have values := DirichletCharacter.function with
    (principalCharacter.character at 1)
  have level := levelProductMap.holomorphic at N, principalCharacter(1),
    succ(N) with values
  have residual := riemannZetaResidualMap.holomorphic
  apply HolomorphicOn.mul_formula with level, residual
  intros z hz
  rw [(principalLFunctionOneMap.value with hz),
    (principalLFunctionOne.eq_mul_residual with positive, hz),
    (levelProductMap.value with values, hz),
    (riemannZetaResidualMap.value with hz)]
  unfold principalLevelProduct
  rfl

-- ζ₁ has no zero near 1 (Mathlib's riemannZeta₁_ne_zero_of_near_one).
theorem riemannZetaResidual.ne_zero_near_one
  shows ∃ d ∈ ℝ, R[0] < d ∧ (∀ s ∈ ℂ, complexAbs(ℂ[s - 1]) < d →
    riemannZetaResidual(s) ≠ ℂ[0])
proof
  have holomorphic := riemannZetaResidualMap.holomorphic
  have one := complexOne.member
  have valueOne : riemannZetaResidualMap(ℂ[1]) ≠ ℂ[0]
    rw [(riemannZetaResidualMap.value with one), riemannZetaResidual.one]
    intro bad
    have reBad : complexRe(ℂ[1]) = complexRe(ℂ[0])
      rw bad
    rw [complexRe.one, ← complexOfReal.zero, complexOfReal.re] at reBad
    have contradiction : R[0] < R[1] by linarith
    linarith
  obtain ⟨d, dReal, dPositive, near⟩ := HolomorphicOn.nonzero_near with
    holomorphic, one, valueOne
  refine ⟨d, dReal, dPositive, ?_⟩
  intros s hs close
  have inDisk : s ∈ complexDisk(ℂ[1], d)
    unfold complexDisk
    exact ⟨hs, close⟩
  have nonzero := near with s, inDisk
  rwa (riemannZetaResidualMap.value with hs) at nonzero

-- nor on re s ≥ 1.
theorem riemannZetaResidual.ne_zero_of_one_le_re (s : Set)
  requires hs : s ∈ ℂ
  requires halfPlane : realOne ≤ complexRe(s)
  shows riemannZetaResidual(s) ≠ ℂ[0]
proof
  by_cases one : s = ℂ[1]
  . rw [one, riemannZetaResidual.one]
    intro bad
    have reBad : complexRe(ℂ[1]) = complexRe(ℂ[0])
      rw bad
    rw [complexRe.one, ← complexOfReal.zero, complexOfReal.re] at reBad
    have contradiction : R[0] < R[1] by linarith
    linarith
  . have shifted : ℂ[s - 1] ∈ ℂ by typecheck
    have nonzero : ℂ[s - 1] ≠ ℂ[0]
      intro zero
      have back : s = ℂ[1]
        have same : s = ℂ[(s - 1) + 1] by ring
        rw [same, zero]
        ring
      exact one with back
    have zeta := zeta.nonzero_re_ge_one with hs, halfPlane, one
    have zetaMember := riemannZeta.member with hs
    have regular := riemannZetaRegular.member with hs
    have inverse := complexInv.member at ℂ[s - 1] with shifted
    have cancel := complexInv.mul_cancel with shifted, nonzero
    have form := riemannZeta.eq_inv_sub_mul with hs, one
    have product : ℂ[(s - 1) * riemannZeta(s)] = riemannZetaResidual(s)
      rw form
      have regroup : ℂ[(s - 1) * (complexInv(ℂ[s - 1]) *
          riemannZetaResidual(s))] = ℂ[((s - 1) * complexInv(ℂ[s - 1])) *
          riemannZetaResidual(s)] by
        unfold riemannZetaResidual
        ring
      rw [regroup, cancel]
      unfold riemannZetaResidual
      ring
    intro residualZero
    rw residualZero at product
    have zero := complexMul.zero_factor with shifted, zetaMember, nonzero,
      product
    exact zeta with zero

-- Section: The 3–4–1 inequality
-- 3 + 4 cos θ + cos 2θ = 2 (1 + cos θ)² ≥ 0.
theorem threeFourOne.cos_nonneg (T : Real)
  shows R[0] ≤ R[3 + 4 * realCos(T) + realCos(2 * T)]
proof
  have double : R[2 * T] = R[T + T] by ring
  have pythagoras := realSin.square_add_cos_square at T
  have cosReal := realCos.real at T
  have sinReal := realSin.real at T
  rw [double, realCos.add]
  have square := realMulValue.square_nonnegative at R[1 + realCos(T)]
  have expand : R[3 + 4 * realCos(T) + (realCos(T) * realCos(T) -
      realSin(T) * realSin(T))] =
      R[2 * ((1 + realCos(T)) * (1 + realCos(T)))] by
    linear_combination (-1) * pythagoras
  have productReal : Real(R[(1 + realCos(T)) * (1 + realCos(T))]) by
    typecheck
  linarith

-- For 0 ≤ a < 1 and |z| = 1:
-- 3 re(−log(1 − a)) + 4 re(−log(1 − a z)) + re(−log(1 − a z²)) ≥ 0
-- (Mathlib's re_log_comb_nonneg').
theorem threeFourOne.log_comb_nonneg (z : Set) (A : Real)
  requires hz : z ∈ ℂ
  requires nonneg : R[0] ≤ A
  requires small : A < R[1]
  requires unit : complexAbs(z) = R[1]
  shows R[0] ≤ R[3 * complexRe(ℂ[-complexLog(ℂ[1 - complexOfReal(A)])]) +
    4 * complexRe(ℂ[-complexLog(ℂ[1 - complexOfReal(A) * z])]) +
    complexRe(ℂ[-complexLog(ℂ[1 - complexOfReal(A) * z * z])])]
proof
  sorry

-- and with layer 1's L-functions (Mathlib's
-- DirichletCharacter.norm_LFunction_product_ge_one).
theorem LFunction.norm_product_ge_one (N : Nat) (χ : Set) (X Y : Real)
  requires positive : 1 ≤ N
  requires character : DirichletCharacter(N, χ)
  requires xPositive : R[0] < X
  shows R[1] ≤ complexAbs(ℂ[
    LFunction(N, principalCharacter(N), complexOfReal(R[1 + X])) ^ 3 *
    LFunction(N, χ, ℂ[complexOfReal(R[1 + X]) +
      complexImaginaryUnit * complexOfReal(Y)]) ^ 4 *
    LFunction(N, characterSquare(χ), ℂ[complexOfReal(R[1 + X]) +
      2 * complexImaginaryUnit * complexOfReal(Y)])])
proof
  have square := characterSquare.character with character
  have principal := principalCharacter.character at N
  have values0 := DirichletCharacter.function with principal
  have values1 := DirichletCharacter.function with character
  have values2 := DirichletCharacter.function with square
  have iMember := complexImaginaryUnit.member
  have castX : complexOfReal(X) ∈ ℂ by typecheck
  have castY : complexOfReal(Y) ∈ ℂ by typecheck
  have hs : ℂ[1 + complexImaginaryUnit * complexOfReal(Y)] ∈ ℂ by typecheck
  have onLine := complexRe.one_add_i_mul at Y
  have bound := LFunction.three_four_one at N, χ,
    ℂ[1 + complexImaginaryUnit * complexOfReal(Y)], X with positive,
    character, hs, onLine, xPositive
  have shift : complexOfReal(R[1 + X]) = ℂ[1 + complexOfReal(X)]
    rw [complexOfReal.add, complexOfReal.one]
  have point1 : ℂ[1 + complexImaginaryUnit * complexOfReal(Y) +
      complexOfReal(X)] = ℂ[complexOfReal(R[1 + X]) + complexImaginaryUnit *
      complexOfReal(Y)]
    rw shift
    ring
  have point2 : ℂ[1 + complexImaginaryUnit * complexOfReal(Y) +
      (1 + complexImaginaryUnit * complexOfReal(Y)) - 1 + complexOfReal(X)] =
      ℂ[complexOfReal(R[1 + X]) + 2 * complexImaginaryUnit * complexOfReal(Y)]
    rw shift
    ring
  rw [point1, point2] at bound
  have s0 : complexOfReal(R[1 + X]) ∈ ℂ by typecheck
  have s1 : ℂ[complexOfReal(R[1 + X]) + complexImaginaryUnit *
    complexOfReal(Y)] ∈ ℂ by typecheck
  have s2 : ℂ[complexOfReal(R[1 + X]) + 2 * complexImaginaryUnit *
    complexOfReal(Y)] ∈ ℂ by typecheck
  have l0 := LFunction.closed at N, principalCharacter(N),
    complexOfReal(R[1 + X]) with values0, s0
  have l1 := LFunction.closed at N, χ, ℂ[complexOfReal(R[1 + X]) +
    complexImaginaryUnit * complexOfReal(Y)] with values1, s1
  have l2 := LFunction.closed at N, characterSquare(χ),
    ℂ[complexOfReal(R[1 + X]) + 2 * complexImaginaryUnit *
      complexOfReal(Y)] with values2, s2
  rw [← (complexAbs.square with l0), ← (complexAbs.square with l1),
    ← (complexAbs.square with l2)] at bound
  have cube : ℂ[LFunction(N, principalCharacter(N),
      complexOfReal(R[1 + X])) ^ 3] ∈ ℂ by typecheck
  have fourth : ℂ[LFunction(N, χ, ℂ[complexOfReal(R[1 + X]) +
      complexImaginaryUnit * complexOfReal(Y)]) ^ 4] ∈ ℂ by typecheck
  have firstTwo : ℂ[LFunction(N, principalCharacter(N),
      complexOfReal(R[1 + X])) ^ 3 * LFunction(N, χ, ℂ[complexOfReal(R[1 + X])
      + complexImaginaryUnit * complexOfReal(Y)]) ^ 4] ∈ ℂ by typecheck
  rw [(complexAbs.mul with firstTwo, l2), (complexAbs.mul with cube, fourth),
    (complexAbs.pow with l0), (complexAbs.pow with l1)]
  have a0 := complexAbs.nonnegative with l0
  have a1 := complexAbs.nonnegative with l1
  have a2 := complexAbs.nonnegative with l2
  have r0 := complexAbs.real with l0
  have r1 := complexAbs.real with l1
  have r2 := complexAbs.real with l2
  have a00 := realMulValue.nonnegative with a0, a0
  have a000 := realMulValue.nonnegative with a00, a0
  have a11 := realMulValue.nonnegative with a1, a1
  have a1111 := realMulValue.nonnegative with a11, a11
  have q2 := realMulValue.nonnegative with a000, a1111
  have q := realMulValue.nonnegative with q2, a2
  have goalForm : R[complexAbs(LFunction(N, principalCharacter(N), complexOfReal(R[1 + X]))) ^ 3 * complexAbs(LFunction(N, χ, ℂ[complexOfReal(R[1 + X]) + complexImaginaryUnit * complexOfReal(Y)])) ^ 4 * complexAbs(LFunction(N, characterSquare(χ), ℂ[complexOfReal(R[1 + X]) + 2 * complexImaginaryUnit * complexOfReal(Y)]))] = R[complexAbs(LFunction(N, principalCharacter(N), complexOfReal(R[1 + X]))) * complexAbs(LFunction(N, principalCharacter(N), complexOfReal(R[1 + X]))) * complexAbs(LFunction(N, principalCharacter(N), complexOfReal(R[1 + X]))) * (complexAbs(LFunction(N, χ, ℂ[complexOfReal(R[1 + X]) + complexImaginaryUnit * complexOfReal(Y)])) * complexAbs(LFunction(N, χ, ℂ[complexOfReal(R[1 + X]) + complexImaginaryUnit * complexOfReal(Y)])) * (complexAbs(LFunction(N, χ, ℂ[complexOfReal(R[1 + X]) + complexImaginaryUnit * complexOfReal(Y)])) * complexAbs(LFunction(N, χ, ℂ[complexOfReal(R[1 + X]) + complexImaginaryUnit * complexOfReal(Y)])))) * complexAbs(LFunction(N, characterSquare(χ), ℂ[complexOfReal(R[1 + X]) + 2 * complexImaginaryUnit * complexOfReal(Y)]))] by ring
  have identity : R[(complexAbs(LFunction(N, principalCharacter(N), complexOfReal(R[1 + X]))) * complexAbs(LFunction(N, principalCharacter(N), complexOfReal(R[1 + X])))) ^ 3 * (complexAbs(LFunction(N, χ, ℂ[complexOfReal(R[1 + X]) + complexImaginaryUnit * complexOfReal(Y)])) * complexAbs(LFunction(N, χ, ℂ[complexOfReal(R[1 + X]) + complexImaginaryUnit * complexOfReal(Y)]))) ^ 4 * (complexAbs(LFunction(N, characterSquare(χ), ℂ[complexOfReal(R[1 + X]) + 2 * complexImaginaryUnit * complexOfReal(Y)])) * complexAbs(LFunction(N, characterSquare(χ), ℂ[complexOfReal(R[1 + X]) + 2 * complexImaginaryUnit * complexOfReal(Y)])))] =
      R[(complexAbs(LFunction(N, principalCharacter(N), complexOfReal(R[1 + X]))) * complexAbs(LFunction(N, principalCharacter(N), complexOfReal(R[1 + X]))) * complexAbs(LFunction(N, principalCharacter(N), complexOfReal(R[1 + X]))) * (complexAbs(LFunction(N, χ, ℂ[complexOfReal(R[1 + X]) + complexImaginaryUnit * complexOfReal(Y)])) * complexAbs(LFunction(N, χ, ℂ[complexOfReal(R[1 + X]) + complexImaginaryUnit * complexOfReal(Y)])) * (complexAbs(LFunction(N, χ, ℂ[complexOfReal(R[1 + X]) + complexImaginaryUnit * complexOfReal(Y)])) * complexAbs(LFunction(N, χ, ℂ[complexOfReal(R[1 + X]) + complexImaginaryUnit * complexOfReal(Y)])))) * complexAbs(LFunction(N, characterSquare(χ), ℂ[complexOfReal(R[1 + X]) + 2 * complexImaginaryUnit * complexOfReal(Y)]))) * (complexAbs(LFunction(N, principalCharacter(N), complexOfReal(R[1 + X]))) * complexAbs(LFunction(N, principalCharacter(N), complexOfReal(R[1 + X]))) * complexAbs(LFunction(N, principalCharacter(N), complexOfReal(R[1 + X]))) * (complexAbs(LFunction(N, χ, ℂ[complexOfReal(R[1 + X]) + complexImaginaryUnit * complexOfReal(Y)])) * complexAbs(LFunction(N, χ, ℂ[complexOfReal(R[1 + X]) + complexImaginaryUnit * complexOfReal(Y)])) * (complexAbs(LFunction(N, χ, ℂ[complexOfReal(R[1 + X]) + complexImaginaryUnit * complexOfReal(Y)])) * complexAbs(LFunction(N, χ, ℂ[complexOfReal(R[1 + X]) + complexImaginaryUnit * complexOfReal(Y)])))) * complexAbs(LFunction(N, characterSquare(χ), ℂ[complexOfReal(R[1 + X]) + 2 * complexImaginaryUnit * complexOfReal(Y)])))] by ring
  rw identity at bound
  rw goalForm
  have unit : R[1 * 1] = R[1] by ring
  have squares : R[1 * 1] ≤ R[(complexAbs(LFunction(N, principalCharacter(N), complexOfReal(R[1 + X]))) * complexAbs(LFunction(N, principalCharacter(N), complexOfReal(R[1 + X]))) * complexAbs(LFunction(N, principalCharacter(N), complexOfReal(R[1 + X]))) * (complexAbs(LFunction(N, χ, ℂ[complexOfReal(R[1 + X]) + complexImaginaryUnit * complexOfReal(Y)])) * complexAbs(LFunction(N, χ, ℂ[complexOfReal(R[1 + X]) + complexImaginaryUnit * complexOfReal(Y)])) * (complexAbs(LFunction(N, χ, ℂ[complexOfReal(R[1 + X]) + complexImaginaryUnit * complexOfReal(Y)])) * complexAbs(LFunction(N, χ, ℂ[complexOfReal(R[1 + X]) + complexImaginaryUnit * complexOfReal(Y)])))) * complexAbs(LFunction(N, characterSquare(χ), ℂ[complexOfReal(R[1 + X]) + 2 * complexImaginaryUnit * complexOfReal(Y)]))) * (complexAbs(LFunction(N, principalCharacter(N), complexOfReal(R[1 + X]))) * complexAbs(LFunction(N, principalCharacter(N), complexOfReal(R[1 + X]))) * complexAbs(LFunction(N, principalCharacter(N), complexOfReal(R[1 + X]))) * (complexAbs(LFunction(N, χ, ℂ[complexOfReal(R[1 + X]) + complexImaginaryUnit * complexOfReal(Y)])) * complexAbs(LFunction(N, χ, ℂ[complexOfReal(R[1 + X]) + complexImaginaryUnit * complexOfReal(Y)])) * (complexAbs(LFunction(N, χ, ℂ[complexOfReal(R[1 + X]) + complexImaginaryUnit * complexOfReal(Y)])) * complexAbs(LFunction(N, χ, ℂ[complexOfReal(R[1 + X]) + complexImaginaryUnit * complexOfReal(Y)])))) * complexAbs(LFunction(N, characterSquare(χ), ℂ[complexOfReal(R[1 + X]) + 2 * complexImaginaryUnit * complexOfReal(Y)])))]
    rw unit
    exact bound
  have oneNonnegative : R[0] ≤ R[1] by linarith
  exact realMulValue.le_of_square_le with oneNonnegative, q, squares

-- For x > 0 and real y, with the series of χ₀, χ and χ²
-- (Mathlib's DirichletCharacter.norm_LSeries_product_ge_one):
-- |L(1 + x, χ₀)³ L(1 + x + iy, χ)⁴ L(1 + x + 2iy, χ²)| ≥ 1.
theorem LSeries.norm_product_ge_one (N : Nat) (χ : Set) (X Y : Real)
  requires positive : 1 ≤ N
  requires character : DirichletCharacter(N, χ)
  requires xPositive : R[0] < X
  shows R[1] ≤ complexAbs(ℂ[
    LSeries(characterCoefficients(principalCharacter(N)),
      complexOfReal(R[1 + X])) ^ 3 *
    LSeries(characterCoefficients(χ), ℂ[complexOfReal(R[1 + X]) +
      complexImaginaryUnit * complexOfReal(Y)]) ^ 4 *
    LSeries(characterCoefficients(characterSquare(χ)),
      ℂ[complexOfReal(R[1 + X]) + 2 * complexImaginaryUnit *
        complexOfReal(Y)])])
proof
  have square := characterSquare.character with character
  have principal := principalCharacter.character at N
  have s0 : complexOfReal(R[1 + X]) ∈ ℂ by typecheck
  have s1 : ℂ[complexOfReal(R[1 + X]) + complexImaginaryUnit *
    complexOfReal(Y)] ∈ ℂ by typecheck
  have s2 : ℂ[complexOfReal(R[1 + X]) + 2 * complexImaginaryUnit *
    complexOfReal(Y)] ∈ ℂ by typecheck
  have re0 := complexOfReal.re at R[1 + X]
  have re1 := complexRe.add_i_mul at complexOfReal(R[1 + X]), Y with s0
  have twice : ℂ[complexOfReal(R[1 + X]) + 2 * complexImaginaryUnit *
      complexOfReal(Y)] = ℂ[(complexOfReal(R[1 + X]) + complexImaginaryUnit *
      complexOfReal(Y)) + complexImaginaryUnit * complexOfReal(Y)] by ring
  have re2 := complexRe.add_i_mul at ℂ[complexOfReal(R[1 + X]) +
    complexImaginaryUnit * complexOfReal(Y)], Y with s1
  rw [← twice, re1, re0] at re2
  rw re0 at re1
  have h0 : realOne < complexRe(complexOfReal(R[1 + X]))
    rw re0
    linarith
  have h1 : realOne < complexRe(ℂ[complexOfReal(R[1 + X]) +
      complexImaginaryUnit * complexOfReal(Y)])
    rw re1
    linarith
  have h2 : realOne < complexRe(ℂ[complexOfReal(R[1 + X]) +
      2 * complexImaginaryUnit * complexOfReal(Y)])
    rw re2
    linarith
  rw [← (LFunction.eq_LSeries with positive, principal, s0, h0),
    ← (LFunction.eq_LSeries with positive, character, s1, h1),
    ← (LFunction.eq_LSeries with positive, square, s2, h2)]
  exact LFunction.norm_product_ge_one with positive, character, xPositive

-- Section: Nonvanishing on re s ≥ 1
-- Mathlib's DirichletCharacter.LFunction_ne_zero_of_one_le_re: L(s, χ) ≠ 0
-- for re s ≥ 1, unless χ = χ₀ and s = 1 (layer 1's
-- LFunction.nonzero_re_ge_one).
theorem LFunction.ne_zero_of_one_le_re (N : Nat) (χ s : Set)
  requires positive : 1 ≤ N
  requires character : DirichletCharacter(N, χ)
  requires hs : s ∈ ℂ
  requires notPole : χ ≠ principalCharacter(N) ∨ s ≠ ℂ[1]
  requires halfPlane : realOne ≤ complexRe(s)
  shows LFunction(N, χ, s) ≠ ℂ[0]
proof
  exact LFunction.nonzero_re_ge_one with positive, character, hs, halfPlane, notPole

-- L(1 + it, χ) ≠ 0 (Mathlib's DirichletCharacter.LFunction_apply_one_ne_zero
-- and the line re s = 1).
theorem LFunction.ne_zero_on_one_line (N : Nat) (χ : Set) (T : Real)
  requires positive : 1 ≤ N
  requires character : DirichletCharacter(N, χ)
  requires notPole : χ ≠ principalCharacter(N) ∨ T ≠ R[0]
  shows LFunction(N, χ, ℂ[1 + complexImaginaryUnit * complexOfReal(T)]) ≠
    ℂ[0]
proof
  have hs : ℂ[1 + complexImaginaryUnit * complexOfReal(T)] ∈ ℂ by typecheck
  have re := complexRe.one_add_i_mul at T
  have halfPlane : realOne ≤ complexRe(ℂ[1 + complexImaginaryUnit *
      complexOfReal(T)])
    rw re
    linarith
  have pole : χ ≠ principalCharacter(N) ∨
      ℂ[1 + complexImaginaryUnit * complexOfReal(T)] ≠ ℂ[1]
    rcases notPole with nonPrincipal | nonzero
    . left
      exact nonPrincipal
    . right
      intro isOne
      have im := complexIm.one_add_i_mul at T
      rw isOne at im
      have imOne : complexIm(ℂ[1]) = R[0]
        rw [← complexOfReal.one, complexOfReal.im]
      rw imOne at im
      have zero : T = R[0] by linarith
      exact nonzero with zero
  exact LFunction.nonzero_re_ge_one with positive, character, hs, halfPlane,
    pole

-- ζ(1 + it) ≠ 0 for t ≠ 0 (Mathlib's riemannZeta_ne_zero_of_one_le_re).
theorem riemannZeta.ne_zero_of_one_le_re (s : Set)
  requires hs : s ∈ ℂ
  requires notOne : s ≠ ℂ[1]
  requires halfPlane : realOne ≤ complexRe(s)
  shows riemannZeta(s) ≠ ℂ[0]
proof
  exact zeta.nonzero_re_ge_one with hs, halfPlane, notOne

-- L(·, χ) for χ ≠ χ₀ is entire (Mathlib's
-- DirichletCharacter.differentiable_LFunction; layer 1's
-- LFunction.holomorphic).
theorem LFunctionMap.holomorphic_of_ne_principal (N : Nat) (χ : Set)
  requires positive : 1 ≤ N
  requires character : DirichletCharacter(N, χ)
  requires nonPrincipal : χ ≠ principalCharacter(N)
  shows HolomorphicOn(LFunctionMap(N, χ), complexCarrier)
proof
  exact LFunction.holomorphic with positive, character, nonPrincipal

end NonVanishing
