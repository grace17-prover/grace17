-- The functional equations. The completed zeta function
-- π^(−s/2) Γ(s/2) ζ(s) is invariant under s ↦ 1 − s, equivalently
-- ζ(1 − s) = 2 (2π)^(−s) cos(πs/2) Γ(s) ζ(s); Hurwitz's formula expresses
-- ζ(1 − s, a) through the periodic zeta functions Σ e^(2πina) n^(−s); the
-- Gauss sum of a primitive character modulo N has modulus √N; and for χ
-- primitive modulo N of parity κ the completed L-function
-- Λ(s, χ) = (N/π)^((s+κ)/2) Γ((s+κ)/2) L(s, χ) satisfies
-- Λ(s, χ) = ε(χ) Λ(1 − s, χ̄) with ε(χ) = τ(χ)/(i^κ √N) of modulus 1. The
-- zeros on re s ≤ 0 are the trivial ones, and a zero in the critical strip
-- reflects to a zero at 1 − s (of ζ, and of L(·, χ̄) for χ primitive).
-- Part of the GRH blueprint.
-- Planned home: NumberTheory/Zeta/FunctionalEquation.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.FunctionalEquation
import GRH.Gamma
import GRH.LFunction

section FunctionalEquation
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Section: Definitions
-- The completed zeta function π^(−s/2) Γ(s/2) ζ(s).
def completedZeta (s : Set) : Set :=
  ℂ[realCpow(realPi, ℂ[-(s * complexOfReal(R[1 / 2]))]) *
    Gamma(ℂ[s * complexOfReal(R[1 / 2])]) * riemannZeta(s)]

-- e^(2πix) for real x.
def expTwoPiI (X : Set) : Set :=
  complexExp(ℂ[complexImaginaryUnit * complexOfReal(R[2 * realPi * X])])

-- The terms e^(2πina) n^(−s), n = 1, 2, …, of the periodic zeta function,
-- indexed from 0 as n + 1, and its sum F(a, s) = Σ_{n≥1} e^(2πina) n^(−s)
-- (convergent for re s > 1, `periodicZeta.series`).
defgraph periodicZetaTerms (a : Real, s : Set) (n ∈ ℕ) : complexCarrier :=
  ℂ[expTwoPiI(R[realNat(n + 1) * a]) * realCpow(realNat(n + 1), ℂ[-s])]
requires hs : s ∈ complexCarrier
proof
  have nNat := nat.omega.backward at n with member
  have negative : ℂ[-s] ∈ ℂ by typecheck
  have power := realCpow.member at realNat(n + 1), ℂ[-s] with negative
  unfold expTwoPiI
  typecheck

def periodicZeta (a : Real, s : Set) : Set :=
  complexSeriesSum(periodicZetaTerms(a, s))

-- The terms χ(j) e^(2πij/N), j = 0, …, N − 1, of the Gauss sum, and the
-- Gauss sum τ(χ) = Σ_{j mod N} χ(j) e^(2πij/N).
defgraph gaussTerms (N : Nat, χ : Set) (j ∈ ℕ) : complexCarrier :=
  ℂ[χ(integerOfNat(j)) * expTwoPiI(R[realNat(j) / realNat(N)])]
requires values : FunctionBetween(χ, ℤ, complexCarrier)
proof
  have jNat := nat.omega.backward at j with member
  have index : integerOfNat(j) ∈ ℤ by typecheck
  have value := FunctionBetween.apply_closed with values, index
  unfold expTwoPiI
  typecheck

def gaussSum (N : Nat, χ : Set) : Set :=
  complexPartialSum(gaussTerms(N, χ), N)

-- The conjugate character χ̄: a ↦ the complex conjugate of χ(a).
def conjCharacter (χ : Set) : Set :=
  { p ∈ ℤ × complexCarrier | ∃ a ∈ ℤ, p = (a, complexConj(χ(a))) }

-- χ has parity κ: κ = 0 and χ(−1) = 1 (χ even), or κ = 1 and χ(−1) = −1
-- (χ odd).
predicate HasParity (χ : Set, κ : Nat) :=
  (κ = (0:N) ∧ χ(integerNegValue(integerOne)) = complexOne) ∨
  (κ = (1:N) ∧ χ(integerNegValue(integerOne)) = ℂ[-1])

-- The argument (s + κ)/2 of the Gamma factor.
def lGammaArgument (κ : Nat, s : Set) : Set :=
  ℂ[(s + complexOfReal(realNat(κ))) * complexOfReal(R[1 / 2])]

-- The completed L-function Λ(s, χ) = (N/π)^((s+κ)/2) Γ((s+κ)/2) L(s, χ).
def completedL (N : Nat, χ : Set, κ : Nat, s : Set) : Set :=
  ℂ[realCpow(R[realNat(N) / realPi], lGammaArgument(κ, s)) *
    Gamma(lGammaArgument(κ, s)) * LFunction(N, χ, s)]

-- The root number ε(χ) = τ(χ)/(i^κ √N).
def rootNumber (N : Nat, χ : Set, κ : Nat) : Set :=
  complexDiv(gaussSum(N, χ),
    ℂ[complexImaginaryUnit ^ κ * complexOfReal(realSqrt(realNat(N)))])

-- Section: Complex arithmetic
-- A product with a nonzero left factor vanishes only with its right one.
theorem complexMul.zero_factor (x y : Set)
  requires hx : x ∈ ℂ
  requires hy : y ∈ ℂ
  requires nonzero : x ≠ ℂ[0]
  requires product : ℂ[x * y] = ℂ[0]
  shows y = ℂ[0]
proof
  have cancel := complexInv.mul_cancel with hx, nonzero
  have inverse := complexInv.member with hx
  linear_combination complexInv(x) * product - y * cancel

theorem complexRe.one
  shows complexRe(ℂ[1]) = R[1]
proof
  have one := complexOfReal.one
  rw [← one, complexOfReal.re]

-- re(1 − s) = 1 − re s.
theorem complexRe.one_sub (s : Set)
  requires hs : s ∈ ℂ
  shows complexRe(ℂ[1 - s]) = R[1 - complexRe(s)]
proof
  have one := complexOne.member
  rw [(complexRe.sub with one, hs), complexRe.one]

theorem complexTwo.nonzero
  shows ℂ[2] ≠ ℂ[0]
proof
  intro twoVanish
  have re := complexOfReal.re at R[2]
  rw [complexOfReal.two, twoVanish, ← complexOfReal.zero, complexOfReal.re]
    at re
  linarith

-- A point with re s < 1 is not 1.
theorem complex.ne_one_of_re_lt (s : Set)
  requires below : complexRe(s) < realOne
  shows s ≠ ℂ[1]
proof
  intro same
  rw [same, complexRe.one] at below
  linarith

-- A point with re s > 1 is not 1.
theorem complex.ne_one_of_re_gt (s : Set)
  requires above : realOne < complexRe(s)
  shows s ≠ ℂ[1]
proof
  intro same
  rw [same, complexRe.one] at above
  linarith

-- A point with re s > 0 is not 0.
theorem complex.ne_zero_of_re_pos (s : Set)
  requires above : realZero < complexRe(s)
  shows s ≠ ℂ[0]
proof
  intro same
  have zero := complexOfReal.zero
  rw [same, ← zero, complexOfReal.re] at above
  linarith

-- For re s > 0, (s + κ)/2 is not a pole of Γ.
theorem lGammaArgument.domain (κ : Nat) (s : Set)
  requires hs : s ∈ ℂ
  requires positive : realZero < complexRe(s)
  shows lGammaArgument(κ, s) ∈ gammaDomain
proof
  have cast : complexOfReal(realNat(κ)) ∈ ℂ by typecheck
  have half : complexOfReal(R[1 / 2]) ∈ ℂ by typecheck
  have shifted : ℂ[s + complexOfReal(realNat(κ))] ∈ ℂ by typecheck
  have argument : lGammaArgument(κ, s) ∈ ℂ
    unfold lGammaArgument
    typecheck
  have re : complexRe(lGammaArgument(κ, s)) =
      R[(complexRe(s) + realNat(κ)) * (1 / 2)]
    unfold lGammaArgument
    rw [(complexRe.mul with shifted, half), (complexRe.add with hs, cast),
      complexOfReal.re, complexOfReal.re, complexOfReal.im]
    ring
  have nonnegative := realNat.nonnegative at κ
  have reReal := complexRe.real with hs
  have sumPositive : R[0] < R[complexRe(s) + realNat(κ)] by linarith
  have halves := realHalf.add_self
  have halfPositive : R[0] < R[1 / 2] by linarith
  have product := realLess.mul_right_of_positive with sumPositive,
    halfPositive
  have zeroProduct : R[0 * (1 / 2)] = R[0] by ring
  have positiveArgument : realZero < complexRe(lGammaArgument(κ, s))
    rw re
    linarith
  exact gammaDomain.of_re_positive with argument, positiveArgument

-- Section: Characters
theorem complexOne.nonzero
  shows ℂ[1] ≠ ℂ[0]
proof
  intro vanish
  have size := complexAbs.one
  rw [vanish, complexAbs.zero] at size
  linarith

-- A prime is not coprime to 0.
theorem IntegerCoprime.prime_zero (p : Nat)
  requires prime : Prime(p)
  shows ¬IntegerCoprime(integerOfNat(p), integerOfNat(0))
proof
  intro coprime
  unfold IntegerCoprime at coprime
  rw [integerGCD.ofNat, gcd.zero_right] at coprime
  have greater := Prime.greater_than_one with prime
  arith

-- A level factor does not vanish on re s > 0.
theorem levelFactor.nonzero (N d : Nat) (ψ s : Set) (p : Nat)
  requires character : DirichletCharacter(d, ψ)
  requires hs : s ∈ ℂ
  requires positive : realZero < complexRe(s)
  shows levelFactor(N, ψ, s, p) ≠ ℂ[0]
proof
  have values := DirichletCharacter.function with character
  obtain ⟨factor, yes, no⟩ := levelFactor.selected at N, ψ, s, p with
    values, hs
  by_cases dividing : Prime(p) ∧ p ∣ N
  . rw (yes with dividing)
    intro vanishing
    have index : integerOfNat(p) ∈ ℤ by typecheck
    have value := FunctionBetween.apply_closed with values, index
    have negative : ℂ[-s] ∈ ℂ by typecheck
    have power := realCpow.member at realNat(p), ℂ[-s] with negative
    have unit : ℂ[ψ(integerOfNat(p)) * realCpow(realNat(p), ℂ[-s])] = ℂ[1]
      by linear_combination -vanishing
    have prime := dividing.left
    by_cases zeroLevel : d = (0:N)
    . have notCoprime := IntegerCoprime.prime_zero with prime
      rw ← zeroLevel at notCoprime
      have vanishes := DirichletCharacter.not_coprime with character, index,
        notCoprime
      rw vanishes at unit
      have collapse : ℂ[0 * realCpow(realNat(p), ℂ[-s])] = ℂ[0] by ring
      rw collapse at unit
      have one := complexOne.nonzero
      symm at unit
      exact one with unit
    . have levelPositive : 0 < d by arith
      have absolute := complexAbs.mul with value, power
      rw [unit, complexAbs.one] at absolute
      have valueBound := DirichletCharacter.abs_le_one with character,
        levelPositive, index
      have greater := Prime.greater_than_one with prime
      have atLeast : 1 ≤ p by arith
      have powerAbs := realCpow.nat_neg_abs with atLeast, hs
      have baseLess := realNat.lt_of_lt at 1, p with greater
      rw realNat.one at baseLess
      have exponentLess : R[-complexRe(s)] < R[0] by linarith
      have smaller := realRpow.lt_of_exponent with baseLess, exponentLess
      rw realRpow.zero at smaller
      have powerNonnegative := complexAbs.nonnegative with power
      have scaled := realLe.mul_right_of_nonnegative with valueBound,
        powerNonnegative
      have unitScale : R[1 * complexAbs(realCpow(realNat(p), ℂ[-s]))] =
        complexAbs(realCpow(realNat(p), ℂ[-s])) by ring
      linarith
  . rw (no with dividing)
    exact complexOne.nonzero

-- The level factors ∏_{p ∣ N} (1 − ψ(p) p^(−s)) do not vanish on
-- re s > 0, where |ψ(p) p^(−s)| ≤ p^(−re s) < 1.
theorem levelProduct.nonzero (N d : Nat) (ψ s : Set) (n : Nat)
  requires character : DirichletCharacter(d, ψ)
  requires hs : s ∈ ℂ
  requires positive : realZero < complexRe(s)
  shows levelProduct(N, ψ, s, n) ≠ ℂ[0]
proof
  have values := DirichletCharacter.function with character
  induction n
  | zero =>
    rw levelProduct
    exact complexOne.nonzero
  | succ(k) using ih =>
    have previous := levelProduct.member at N, ψ, s, k with values, hs
    obtain ⟨factor, _⟩ := levelFactor.selected at N, ψ, s, k with values, hs
    have factorNonzero := levelFactor.nonzero at N, d, ψ, s, k with
      character, hs, positive
    rw levelProduct
    intro vanishing
    have zero := complexMul.zero_factor with previous, factor, ih, vanishing
    exact factorNonzero with zero

-- The conjugate character.
theorem conjCharacter.pair (χ x y : Set)
  requires member : (x, y) ∈ conjCharacter(χ)
  shows x ∈ ℤ ∧ y = complexConj(χ(x))
proof
  unfold conjCharacter at member
  obtain ⟨bound, a, aInteger, shape⟩ := member
  obtain ⟨first, second⟩ := orderedPair.injective with shape
  rw [first, second]
  exact ⟨aInteger, rfl⟩

theorem conjCharacter.functional (χ : Set)
  shows Functional(conjCharacter(χ))
proof
  intros x y first z second
  obtain ⟨_, firstValue⟩ := conjCharacter.pair with first
  obtain ⟨_, secondValue⟩ := conjCharacter.pair with second
  rw [firstValue, secondValue]

theorem conjCharacter.bounded (χ : Set)
  shows conjCharacter(χ) ⊆ ℤ × complexCarrier
proof
  intros p member
  unfold conjCharacter at member
  exact member.left

theorem conjCharacter.apply (χ a : Set)
  requires values : FunctionBetween(χ, ℤ, complexCarrier)
  requires integer : a ∈ ℤ
  shows conjCharacter(χ)(a) = complexConj(χ(a))
proof
  have value := FunctionBetween.apply_closed with values, integer
  have conjugate := complexConj.member with value
  have member : (a, complexConj(χ(a))) ∈ conjCharacter(χ)
    unfold conjCharacter
    have pair := product.pair with integer, conjugate
    exact ⟨pair, a, integer, rfl⟩
  exact graph.apply with (conjCharacter.bounded at χ),
    (conjCharacter.functional at χ), member

theorem conjCharacter.function (χ : Set)
  requires values : FunctionBetween(χ, ℤ, complexCarrier)
  shows FunctionBetween(conjCharacter(χ), ℤ, complexCarrier)
proof
  refine ⟨(conjCharacter.bounded at χ), (conjCharacter.functional at χ), ?_⟩
  intros a integer
  have value := FunctionBetween.apply_closed with values, integer
  have conjugate := complexConj.member with value
  refine ⟨complexConj(χ(a)), conjugate, ?_⟩
  unfold relates
  unfold conjCharacter
  have pair := product.pair with integer, conjugate
  exact ⟨pair, a, integer, rfl⟩

theorem conjCharacter.character (N : Nat) (χ : Set)
  requires character : DirichletCharacter(N, χ)
  shows DirichletCharacter(N, conjCharacter(χ))
proof
  have values := DirichletCharacter.function with character
  have function := conjCharacter.function with values
  refine ⟨function, ?_, ?_, ?_, ?_⟩
  . intros a integer
    have shifted : integerAddValue(a, integerOfNat(N)) ∈ ℤ by typecheck
    have periodic := DirichletCharacter.periodic with character, integer
    rw [(conjCharacter.apply with values, shifted),
      (conjCharacter.apply with values, integer), periodic]
  . have one : integerOne ∈ ℤ by typecheck
    rw [(conjCharacter.apply with values, one),
      (DirichletCharacter.one with character)]
    exact complexConj.one
  . intros a aInteger b bInteger
    have product : integerMulValue(a, b) ∈ ℤ by typecheck
    have aValue := FunctionBetween.apply_closed with values, aInteger
    have bValue := FunctionBetween.apply_closed with values, bInteger
    rw [(conjCharacter.apply with values, product),
      (conjCharacter.apply with values, aInteger),
      (conjCharacter.apply with values, bInteger),
      (DirichletCharacter.mul with character, aInteger, bInteger)]
    exact complexConj.mul with aValue, bValue
  . intros a integer notCoprime
    rw [(conjCharacter.apply with values, integer),
      (DirichletCharacter.not_coprime with character, integer, notCoprime)]
    exact complexConj.zero

-- χ factors through d exactly when χ̄ does.
theorem FactorsThrough.conj (N : Nat) (χ : Set) (d : Nat)
  requires values : FunctionBetween(χ, ℤ, complexCarrier)
  requires factors : FactorsThrough(N, χ, d)
  shows FactorsThrough(N, conjCharacter(χ), d)
proof
  obtain ⟨divides, ψ, character, agree⟩ := factors
  have conjugate := conjCharacter.character with character
  have ψValues := DirichletCharacter.function with character
  refine ⟨divides, conjCharacter(ψ), conjugate, ?_⟩
  intros a integer coprime
  rw [(conjCharacter.apply with values, integer),
    (conjCharacter.apply with ψValues, integer),
    (agree with a, integer, coprime)]

theorem FactorsThrough.of_conj (N : Nat) (χ : Set) (d : Nat)
  requires values : FunctionBetween(χ, ℤ, complexCarrier)
  requires factors : FactorsThrough(N, conjCharacter(χ), d)
  shows FactorsThrough(N, χ, d)
proof
  obtain ⟨divides, ψ, character, agree⟩ := factors
  have conjugate := conjCharacter.character with character
  have ψValues := DirichletCharacter.function with character
  refine ⟨divides, conjCharacter(ψ), conjugate, ?_⟩
  intros a integer coprime
  have same := agree with a, integer, coprime
  rw (conjCharacter.apply with values, integer) at same
  have value := FunctionBetween.apply_closed with values, integer
  rw [(conjCharacter.apply with ψValues, integer), ← same,
    (complexConj.involutive with value)]

theorem conjCharacter.primitive (N : Nat) (χ : Set)
  requires character : DirichletCharacter(N, χ)
  requires primitive : PrimitiveCharacter(N, χ)
  shows PrimitiveCharacter(N, conjCharacter(χ))
proof
  have values := DirichletCharacter.function with character
  have conjugate := conjCharacter.character with character
  have conductorNat := conductor.natural with conjugate
  have factors := conductor.factors with conjugate
  have back := FactorsThrough.of_conj with values, factors
  have lower := conductor.least with character, back
  have self := FactorsThrough.self with conjugate
  have upper := conductor.least with conjugate, self
  unfold PrimitiveCharacter at primitive
  unfold PrimitiveCharacter
  rw primitive at lower
  arith

theorem conjCharacter.parity (N : Nat) (χ : Set) (κ : Nat)
  requires character : DirichletCharacter(N, χ)
  requires parity : HasParity(χ, κ)
  shows HasParity(conjCharacter(χ), κ)
proof
  have values := DirichletCharacter.function with character
  have minus : integerNegValue(integerOne) ∈ ℤ by typecheck
  have value := conjCharacter.apply with values, minus
  unfold HasParity at parity
  unfold HasParity
  cases parity with even | odd
  . left
    refine ⟨even.left, ?_⟩
    rw [value, even.right]
    exact complexConj.one
  . right
    refine ⟨odd.left, ?_⟩
    have one := complexOne.member
    rw [value, odd.right, (complexConj.neg with one),
      complexConj.one]

-- Every character is even or odd.
theorem DirichletCharacter.parity (N : Nat) (χ : Set)
  requires character : DirichletCharacter(N, χ)
  shows ∃ κ ∈ ℕ, HasParity(χ, κ)
proof
  have values := DirichletCharacter.neg_one with character
  cases values with even | odd
  . have zeroNat : (0:N) ∈ ℕ by typecheck
    refine ⟨(0:N), zeroNat, ?_⟩
    unfold HasParity
    left
    exact ⟨rfl, even⟩
  . have oneNat : (1:N) ∈ ℕ by typecheck
    refine ⟨(1:N), oneNat, ?_⟩
    unfold HasParity
    right
    exact ⟨rfl, odd⟩

-- Section: The exponentials e(x) = e^(2πix)
theorem expTwoPiI.member (X : Real)
  shows expTwoPiI(X) ∈ ℂ
proof
  unfold expTwoPiI
  typecheck

-- e(x + y) = e(x) e(y).
theorem expTwoPiI.add (X Y : Real)
  shows expTwoPiI(R[X + Y]) = ℂ[expTwoPiI(X) * expTwoPiI(Y)]
proof
  have iMember := complexImaginaryUnit.member
  have xMember : complexOfReal(R[2 * realPi * X]) ∈ ℂ by typecheck
  have yMember : complexOfReal(R[2 * realPi * Y]) ∈ ℂ by typecheck
  have first : ℂ[complexImaginaryUnit * complexOfReal(R[2 * realPi * X])] ∈ ℂ
    by typecheck
  have second : ℂ[complexImaginaryUnit *
    complexOfReal(R[2 * realPi * Y])] ∈ ℂ by typecheck
  have sum := complexExp.add with first, second
  have split : R[2 * realPi * (X + Y)] = R[2 * realPi * X + 2 * realPi * Y]
    by ring
  have argument : ℂ[complexImaginaryUnit *
      complexOfReal(R[2 * realPi * (X + Y)])] =
      ℂ[complexImaginaryUnit * complexOfReal(R[2 * realPi * X]) +
        complexImaginaryUnit * complexOfReal(R[2 * realPi * Y])]
    rw [split, complexOfReal.add]
    ring
  unfold expTwoPiI
  rw [argument, sum]

-- The conjugate of e(x) is e(−x).
theorem expTwoPiI.conj (X : Real)
  shows complexConj(expTwoPiI(X)) = expTwoPiI(R[-X])
proof
  have iMember := complexImaginaryUnit.member
  have xMember : complexOfReal(R[2 * realPi * X]) ∈ ℂ by typecheck
  have negated : R[2 * realPi * -X] = R[-(2 * realPi * X)] by ring
  have argument : ℂ[complexImaginaryUnit *
      complexOfReal(R[2 * realPi * -X])] =
      ℂ[-(complexImaginaryUnit * complexOfReal(R[2 * realPi * X]))]
    rw [negated, complexOfReal.neg]
    ring
  unfold expTwoPiI
  rw argument
  exact complexExp.conj_i_real at R[2 * realPi * X]

theorem expTwoPiI.abs (X : Real)
  shows complexAbs(expTwoPiI(X)) = R[1]
proof
  unfold expTwoPiI
  exact complexExp.abs_i_mul at R[2 * realPi * X]

-- e(k) = 1 for an integer k.
theorem expTwoPiI.integer (k : Integer)
  shows expTwoPiI(realInt(k)) = ℂ[1]
proof
  have iMember := complexImaginaryUnit.member
  have argument : ℂ[complexImaginaryUnit *
      complexOfReal(R[2 * realPi * realInt(k)])] ∈ ℂ by typecheck
  have kMember : k ∈ ℤ by typecheck
  have iff := complexExp.eq_one_iff with argument
  unfold expTwoPiI
  apply iff.backward
  refine ⟨k, kMember, ?_⟩
  ring

theorem expTwoPiI.nat (n : Nat)
  shows expTwoPiI(realNat(n)) = ℂ[1]
proof
  rw ← realInt.nat
  exact expTwoPiI.integer at integerOfNat(n)

theorem expTwoPiI.zero
  shows expTwoPiI(R[0]) = ℂ[1]
proof
  have zero := expTwoPiI.nat at 0
  rw realNat.zero at zero
  exact zero

-- e(x) ≠ 1 for x strictly between consecutive integers.
theorem expTwoPiI.ne_one (k : Integer) (X : Real)
  requires lower : realInt(k) < X
  requires upper : X < R[realInt(k) + 1]
  shows expTwoPiI(X) ≠ ℂ[1]
proof
  intro one
  have iMember := complexImaginaryUnit.member
  have argument : ℂ[complexImaginaryUnit *
      complexOfReal(R[2 * realPi * X])] ∈ ℂ by typecheck
  have iff := complexExp.eq_one_iff with argument
  unfold expTwoPiI at one
  obtain ⟨j, jMember, same⟩ := iff.forward with one
  have left : complexOfReal(R[2 * realPi * X]) ∈ ℂ by typecheck
  have right : complexOfReal(R[2 * realPi * realInt(j)]) ∈ ℂ by typecheck
  have square := complexImaginaryUnit.square
  have equal : complexOfReal(R[2 * realPi * X]) =
      complexOfReal(R[2 * realPi * realInt(j)])
    linear_combination (-complexImaginaryUnit) * same +
      (complexOfReal(R[2 * realPi * X]) -
        complexOfReal(R[2 * realPi * realInt(j)])) * square
  have reals := complexOfReal.injective with equal
  have piPositive := realPi.positive
  have twoPi : R[2 * realPi] ≠ R[0]
    intro vanish
    linarith
  have inverse := realInvValue.mul_right with twoPi
  have recovered : X = realInt(j)
    linear_combination realInvValue(R[2 * realPi]) * reals -
      (X - realInt(j)) * inverse
  have outside := realInt.not_between with lower, upper
  exact outside with j, jMember, recovered

-- Section: Integrals over (0, ∞)
-- g has the integral I over (0, ∞): for every small A > 0 the improper
-- integral of g over [A, ∞) exists, and it tends to I as A → 0⁺.
predicate HasSingularIntegral (g I : Set) :=
  I ∈ complexCarrier ∧
  (∀ e ∈ ℝ, R[0] < e → ∃ d ∈ ℝ, R[0] < d ∧
    (∀ A ∈ ℝ, R[0] < A → A < d → ∃ J ∈ complexCarrier,
      HasComplexImproperIntegral(g, A, J) ∧ complexAbs(ℂ[J - I]) < e))

theorem HasSingularIntegral.unique (g I J : Set)
  requires first : HasSingularIntegral(g, I)
  requires second : HasSingularIntegral(g, J)
  shows I = J
proof
  obtain ⟨iMember, nearI⟩ := first
  obtain ⟨jMember, nearJ⟩ := second
  apply complex.eq_of_common_near with iMember, jMember
  intros e eReal ePositive
  obtain ⟨d1, d1Real, d1Positive, closeI⟩ := nearI with e, eReal, ePositive
  obtain ⟨d2, d2Real, d2Positive, closeJ⟩ := nearJ with e, eReal, ePositive
  obtain ⟨d, dReal, dPositive, below1, below2⟩ := realPositive.common_lower
    with d1Positive, d2Positive
  have halfPositive := half.positive with dPositive
  have halves := half.add_self at d
  have halfReal : half(d) ∈ ℝ by typecheck
  have less1 : half(d) < d1 by linarith
  have less2 : half(d) < d2 by linarith
  obtain ⟨K, kMember, integralI, closeK⟩ := closeI with half(d), halfReal,
    halfPositive, less1
  obtain ⟨L, lMember, integralJ, closeL⟩ := closeJ with half(d), halfReal,
    halfPositive, less2
  have same := HasComplexImproperIntegral.unique with integralI, integralJ
  rw ← same at closeL
  exact ⟨K, kMember, closeK, closeL⟩

-- Section: The Mellin integral of e^(iβy) − 1
-- The function (e^(iβz) − 1) z^(v−1) = (e^(iβz) − 1) exp((v − 1) log z),
-- holomorphic on the slit plane.
defgraph mellinContour (β v : Real) (z ∈ complexCarrier) : complexCarrier :=
  ℂ[(complexExp(complexImaginaryUnit * complexOfReal(β) * z) - 1) *
    complexExp(complexOfReal(R[v - 1]) * complexLog(z))]
proof
  have iMember := complexImaginaryUnit.member
  have logarithm := complexLog.member with member
  have first : ℂ[complexImaginaryUnit * complexOfReal(β) * z] ∈ ℂ by typecheck
  have second : ℂ[complexOfReal(R[v - 1]) * complexLog(z)] ∈ ℂ by typecheck
  have firstExp := complexExp.member with first
  have secondExp := complexExp.member with second
  typecheck

-- The integrand (e^(iβy) − 1) y^(v−1) on the real axis.
defgraph mellinExpIntegrand (β v : Real) (Y ∈ ℝ) : complexCarrier :=
  ℂ[(complexExp(complexImaginaryUnit * complexOfReal(R[β * Y])) - 1) *
    complexOfReal(realRpow(Y, R[v - 1]))]
proof
  have iMember := complexImaginaryUnit.member
  have argument : ℂ[complexImaginaryUnit * complexOfReal(R[β * Y])] ∈ ℂ
    by typecheck
  have exponential := complexExp.member with argument
  typecheck

-- The integrand (e^(−βy) − 1) y^(v−1) on the imaginary axis.
defgraph mellinEulerIntegrand (β v : Real) (Y ∈ ℝ) : complexCarrier :=
  complexOfReal(R[(realExp(R[-(β * Y)]) - 1) * realRpow(Y, R[v - 1])])
proof
  typecheck

-- Holomorphy of z ↦ exp(f(z)), of z ↦ c z + d, and of z ↦ c f(z) + d.
theorem HolomorphicOn.exp_formula (f h U : Set)
  requires holomorphicF : HolomorphicOn(f, U)
  requires formula : ∀ z ∈ U, h(z) = complexExp(f(z))
  shows HolomorphicOn(h, U)
proof
  obtain ⟨_, valuesF, _⟩ := holomorphicF
  have maps : ∀ z ∈ U, f(z) ∈ complexCarrier
    intros z hz
    exact valuesF with z, hz
  have composed := HolomorphicOn.comp with holomorphicF,
    complexExp.holomorphic, maps
  have values : ∀ z ∈ U, complexExp(f(z)) ∈ complexCarrier
    intros z hz
    have image := maps with z, hz
    exact complexExp.member with image
  apply HolomorphicOn.congr with composed
  intros z hz
  rw [(complexFunctionComp.value with values, hz), (formula with z, hz)]

theorem HolomorphicOn.affine_formula (f h U c d : Set)
  requires holomorphicF : HolomorphicOn(f, U)
  requires hc : c ∈ ℂ
  requires hd : d ∈ ℂ
  requires formula : ∀ z ∈ U, h(z) = ℂ[c * f(z) + d]
  shows HolomorphicOn(h, U)
proof
  have isOpen := holomorphicF.left
  have scale := HolomorphicOn.const with isOpen, hc
  have shift := HolomorphicOn.const with isOpen, hd
  have product := HolomorphicOn.mul with scale, holomorphicF
  obtain ⟨_, scaleValues, _⟩ := scale
  obtain ⟨_, valuesF, _⟩ := holomorphicF
  apply HolomorphicOn.add_formula with product, shift
  intros z hz
  rw [(complexFunctionMul.value with scaleValues, valuesF, hz),
    (complexFunctionConst.value with hc, hz),
    (complexFunctionConst.value with hd, hz), (formula with z, hz)]

-- The maps z ↦ exp(c z) and z ↦ exp(p log z).
defgraph expLinearMap (c : Set) (z ∈ complexCarrier) : complexCarrier :=
  complexExp(ℂ[c * z])
requires hc : c ∈ complexCarrier
proof
  have argument : ℂ[c * z] ∈ ℂ by typecheck
  exact complexExp.member with argument

defgraph powerLogMap (p : Set) (z ∈ complexCarrier) : complexCarrier :=
  complexExp(ℂ[p * complexLog(z)])
requires hp : p ∈ complexCarrier
proof
  have logarithm := complexLog.member with member
  have argument : ℂ[p * complexLog(z)] ∈ ℂ by typecheck
  exact complexExp.member with argument

theorem expLinearMap.holomorphic (c U : Set)
  requires hc : c ∈ ℂ
  requires isOpen : ComplexOpen(U)
  shows HolomorphicOn(expLinearMap(c), U)
proof
  have inside := ComplexOpen.subset with isOpen
  have constant := HolomorphicOn.const with isOpen, hc
  have identity := HolomorphicOn.id with isOpen
  have linear := HolomorphicOn.mul with constant, identity
  obtain ⟨_, constantValues, _⟩ := constant
  obtain ⟨_, identityValues, _⟩ := identity
  apply HolomorphicOn.exp_formula with linear
  intros z hz
  have zMember := inside with z, hz
  rw [(expLinearMap.value with hc, zMember),
    (complexFunctionMul.value with constantValues, identityValues, hz),
    (complexFunctionConst.value with hc, hz),
    (complexFunctionId.value with inside, hz)]

theorem powerLogMap.holomorphic (p : Set)
  requires hp : p ∈ ℂ
  shows HolomorphicOn(powerLogMap(p), slitPlane)
proof
  have isOpen := slitPlane.open
  have inside := ComplexOpen.subset with isOpen
  have constant := HolomorphicOn.const with isOpen, hp
  have logarithm := complexLog.holomorphic
  have product := HolomorphicOn.mul with constant, logarithm
  obtain ⟨_, constantValues, _⟩ := constant
  obtain ⟨_, logValues, _⟩ := logarithm
  apply HolomorphicOn.exp_formula with product
  intros z hz
  have zMember := inside with z, hz
  rw [(powerLogMap.value with hp, zMember),
    (complexFunctionMul.value with constantValues, logValues, hz),
    (complexFunctionConst.value with hp, hz)]

theorem mellinContour.holomorphic (β v : Real)
  shows HolomorphicOn(mellinContour(β, v), slitPlane)
proof
  have isOpen := slitPlane.open
  have inside := ComplexOpen.subset with isOpen
  have iMember := complexImaginaryUnit.member
  have scale : ℂ[complexImaginaryUnit * complexOfReal(β)] ∈ ℂ by typecheck
  have one : ℂ[1] ∈ ℂ by typecheck
  have minusOne : ℂ[-1] ∈ ℂ by typecheck
  have exponent : complexOfReal(R[v - 1]) ∈ ℂ by typecheck
  have wave := expLinearMap.holomorphic with scale, isOpen
  have power := powerLogMap.holomorphic with exponent
  have constant := HolomorphicOn.const with isOpen, minusOne
  have shifted := HolomorphicOn.add with wave, constant
  obtain ⟨_, waveValues, _⟩ := wave
  obtain ⟨_, constantValues, _⟩ := constant
  apply HolomorphicOn.mul_formula with shifted, power
  intros z hz
  have zMember := inside with z, hz
  rw [(mellinContour.value with zMember),
    (complexFunctionAdd.value with waveValues, constantValues, hz),
    (expLinearMap.value with scale, zMember),
    (complexFunctionConst.value with minusOne, hz),
    (powerLogMap.value with exponent, zMember)]
  ring

-- The real and imaginary parts of a + ib.
theorem complex.re_form (X Y : Real)
  shows complexRe(ℂ[complexOfReal(X) + complexImaginaryUnit *
    complexOfReal(Y)]) = X
proof
  rw ← complexPoint.eq
  exact complexPoint.re at X, Y

theorem complex.im_form (X Y : Real)
  shows complexIm(ℂ[complexOfReal(X) + complexImaginaryUnit *
    complexOfReal(Y)]) = Y
proof
  rw ← complexPoint.eq
  exact complexPoint.im at X, Y

-- re(iβz) = −β im z and |exp(P log z)| = |z|^P for real β, P.
theorem complexRe.i_real_mul (B : Real) (z : Set)
  requires hz : z ∈ ℂ
  shows complexRe(ℂ[complexImaginaryUnit * complexOfReal(B) * z]) =
    R[-(B * complexIm(z))]
proof
  obtain ⟨X, xReal, Y, yReal, shape⟩ := complexCarrier.cases with hz
  have square := complexImaginaryUnit.square
  have iMember := complexImaginaryUnit.member
  have form : ℂ[complexImaginaryUnit * complexOfReal(B) * z] =
      ℂ[complexOfReal(R[-(B * Y)]) + complexImaginaryUnit *
        complexOfReal(R[B * X])]
    rw [shape, complexPoint.eq, complexOfReal.neg, complexOfReal.mul,
      complexOfReal.mul]
    linear_combination complexOfReal(B) * complexOfReal(Y) * square
  rw [form, complex.re_form, shape, complexPoint.im]

theorem powerLog.abs (P : Real) (z : Set)
  requires hz : z ∈ ℂ
  shows complexAbs(complexExp(ℂ[complexOfReal(P) * complexLog(z)])) =
    realRpow(complexAbs(z), P)
proof
  have logarithm := complexLog.member with hz
  have argument : ℂ[complexOfReal(P) * complexLog(z)] ∈ ℂ by typecheck
  have pMember : complexOfReal(P) ∈ ℂ by typecheck
  rw [(complexExp.abs with argument), (complexRe.mul with pMember, logarithm),
    complexOfReal.re, complexOfReal.im, (complexLog.re with hz)]
  unfold realRpow
  have logReal := realLog.real at complexAbs(z)
  have imReal := complexIm.real with logarithm
  have same : R[P * realLog(complexAbs(z)) - 0 * complexIm(complexLog(z))] =
    R[P * realLog(complexAbs(z))] by ring
  rw same

-- Products of nonnegative bounds.
theorem real.mul_le_mul (A B C D : Real)
  requires nonnegativeA : R[0] ≤ A
  requires ab : A ≤ B
  requires nonnegativeC : R[0] ≤ C
  requires cd : C ≤ D
  shows R[A * C] ≤ R[B * D]
proof
  have first := realLe.mul_right_of_nonnegative with ab, nonnegativeC
  have nonnegativeB : R[0] ≤ B by linarith
  have second := realLe.mul_left_of_nonnegative with cd, nonnegativeB
  linarith

-- |z|^P ≤ R^P for 0 < R ≤ |z| and P < 0.
theorem realRpow.le_of_base_neg (X Y S : Real)
  requires positive : R[0] < X
  requires below : X ≤ Y
  requires exponent : S < R[0]
  shows realRpow(Y, S) ≤ realRpow(X, S)
proof
  by_cases same : X = Y
  . rw same
    linarith
  . have less : X < Y
      by_contra notLess
      apply same
      linarith
    have smaller := realRpow.lt_of_base_neg with positive, less, exponent
    linarith

-- On the closed upper half plane, |e^(iβz)| ≤ 1 for β ≥ 0.
theorem expLinear.abs_upper (B : Real) (z : Set)
  requires hz : z ∈ ℂ
  requires nonnegativeB : R[0] ≤ B
  requires upper : realZero ≤ complexIm(z)
  shows complexAbs(complexExp(ℂ[complexImaginaryUnit * complexOfReal(B) *
    z])) ≤ R[1]
proof
  have iMember := complexImaginaryUnit.member
  have argument : ℂ[complexImaginaryUnit * complexOfReal(B) * z] ∈ ℂ
    by typecheck
  rw [(complexExp.abs with argument), (complexRe.i_real_mul with hz)]
  have imReal := complexIm.real with hz
  have product := realLe.mul_left_of_nonnegative with upper, nonnegativeB
  have zero : R[B * 0] = R[0] by ring
  have nonpositive : R[-(B * complexIm(z))] ≤ R[0] by linarith
  have monotone := realExp.monotone with nonpositive
  rw realExp.zero at monotone
  exact monotone

-- Far from 0 in the upper half plane, |(e^(iβz) − 1) z^(v−1)| ≤ 2 ρ^(v−1)
-- for |z| ≥ ρ > 0 and v < 1.
theorem mellinContour.far_bound (B v ρ : Real) (z : Set)
  requires hz : z ∈ ℂ
  requires nonnegativeB : R[0] ≤ B
  requires upper : realZero ≤ complexIm(z)
  requires positive : R[0] < ρ
  requires far : ρ ≤ complexAbs(z)
  requires exponent : v < R[1]
  shows complexAbs(mellinContour(B, v)(z)) ≤ R[2 * realRpow(ρ, R[v - 1])]
proof
  have iMember := complexImaginaryUnit.member
  have argument : ℂ[complexImaginaryUnit * complexOfReal(B) * z] ∈ ℂ
    by typecheck
  have wave := complexExp.member with argument
  have logarithm := complexLog.member with hz
  have powerArgument : ℂ[complexOfReal(R[v - 1]) * complexLog(z)] ∈ ℂ
    by typecheck
  have power := complexExp.member with powerArgument
  have one : ℂ[1] ∈ ℂ by typecheck
  have difference : ℂ[complexExp(complexImaginaryUnit * complexOfReal(B) *
    z) - 1] ∈ ℂ by typecheck
  rw [(mellinContour.value with hz), (complexAbs.mul with difference, power),
    (powerLog.abs with hz)]
  have waveBound := expLinear.abs_upper with hz, nonnegativeB, upper
  have triangle := complexAbs.sub_le with wave, one
  rw complexAbs.one at triangle
  have differenceBound : complexAbs(ℂ[complexExp(complexImaginaryUnit *
    complexOfReal(B) * z) - 1]) ≤ R[2] by linarith
  have negative : R[v - 1] < R[0] by linarith
  have powerBound := realRpow.le_of_base_neg with positive, far, negative
  have nonnegativeD := complexAbs.nonnegative with difference
  have nonnegativeP := realLess.implies_le with (realRpow.positive at
    complexAbs(z), R[v - 1])
  exact real.mul_le_mul with nonnegativeD, differenceBound, nonnegativeP,
    powerBound

-- Near 0, |(e^(iβz) − 1) z^(v−1)| ≤ 2β ρ^v for ρ ≤ |z| ≤ 2ρ, 2βρ ≤ 1, v < 0.
theorem mellinContour.near_bound (B v ρ : Real) (z : Set)
  requires hz : z ∈ ℂ
  requires positiveB : R[0] < B
  requires positive : R[0] < ρ
  requires far : ρ ≤ complexAbs(z)
  requires near : complexAbs(z) ≤ R[2 * ρ]
  requires small : R[2 * B * ρ] ≤ R[1]
  requires exponent : v < R[0]
  shows complexAbs(mellinContour(B, v)(z)) ≤ R[2 * B * realRpow(ρ, v)]
proof
  have iMember := complexImaginaryUnit.member
  have argument : ℂ[complexImaginaryUnit * complexOfReal(B) * z] ∈ ℂ
    by typecheck
  have wave := complexExp.member with argument
  have logarithm := complexLog.member with hz
  have powerArgument : ℂ[complexOfReal(R[v - 1]) * complexLog(z)] ∈ ℂ
    by typecheck
  have power := complexExp.member with powerArgument
  have difference : ℂ[complexExp(complexImaginaryUnit * complexOfReal(B) *
    z) - 1] ∈ ℂ by typecheck
  rw [(mellinContour.value with hz), (complexAbs.mul with difference, power),
    (powerLog.abs with hz)]
  have bMember : complexOfReal(B) ∈ ℂ by typecheck
  have iB : ℂ[complexImaginaryUnit * complexOfReal(B)] ∈ ℂ by typecheck
  have absArgument : complexAbs(ℂ[complexImaginaryUnit * complexOfReal(B) *
      z]) = R[B * complexAbs(z)]
    rw [(complexAbs.mul with iB, hz), (complexAbs.mul with iMember, bMember),
      (complexAbs.of_real at B)]
    rw complexAbs.imaginary
    have absB : abs(B) = B := abs.of_nonnegative with
      (realLess.implies_le with positiveB)
    rw absB
    ring
  have zAbs := complexAbs.nonnegative at z
  have scaled := realLe.mul_left_of_nonnegative with near,
    (realLess.implies_le with positiveB)
  have rearranged : R[B * (2 * ρ)] = R[2 * B * ρ] by ring
  have unit : complexAbs(ℂ[complexImaginaryUnit * complexOfReal(B) * z]) ≤
    R[1] by linarith
  have quadratic := complexExp.quadratic_estimate with argument, unit
  have remainder : ℂ[complexExp(complexImaginaryUnit * complexOfReal(B) * z) -
    1 - complexImaginaryUnit * complexOfReal(B) * z] ∈ ℂ by typecheck
  have triangle := complexAbs.triangle with remainder, argument
  have recombine : ℂ[complexExp(complexImaginaryUnit * complexOfReal(B) * z) -
      1 - complexImaginaryUnit * complexOfReal(B) * z +
      complexImaginaryUnit * complexOfReal(B) * z] =
    ℂ[complexExp(complexImaginaryUnit * complexOfReal(B) * z) - 1] by ring
  rw recombine at triangle
  have argumentNonnegative := complexAbs.nonnegative with argument
  have square := realLe.mul_left_of_nonnegative with unit, argumentNonnegative
  have differenceBound : complexAbs(ℂ[complexExp(complexImaginaryUnit *
      complexOfReal(B) * z) - 1]) ≤ R[2 * (B * complexAbs(z))]
    have argumentReal := complexAbs.real with argument
    have timesOne : R[complexAbs(ℂ[complexImaginaryUnit * complexOfReal(B) *
      z]) * 1] = complexAbs(ℂ[complexImaginaryUnit * complexOfReal(B) * z])
      by ring
    linarith
  have zPositive : R[0] < complexAbs(z) by linarith
  have split := realRpow.add at complexAbs(z), R[1], R[v - 1] with zPositive
  have exponentSum : R[1 + (v - 1)] = v by ring
  rw [exponentSum, (realRpow.one with zPositive)] at split
  have powerBound := realRpow.le_of_base_neg with positive, far, exponent
  have nonnegativeD := complexAbs.nonnegative with difference
  have nonnegativeP := realLess.implies_le with (realRpow.positive at
    complexAbs(z), R[v - 1])
  have product := realLe.mul_right_of_nonnegative with differenceBound,
    nonnegativeP
  have rewritten : R[2 * (B * complexAbs(z)) * realRpow(complexAbs(z),
      R[v - 1])] = R[2 * B * realRpow(complexAbs(z), v)]
    rw split
    ring
  have twoB : R[0] ≤ R[2 * B] by linarith
  have scaledPower := realLe.mul_left_of_nonnegative with powerBound, twoB
  linarith

-- Points of the plane with a positive real or imaginary part are in the
-- slit plane.
theorem slitPlane.of_re_positive (X Y : Real)
  requires positive : R[0] < X
  shows (X, Y) ∈ slitPlane
proof
  have member := complexCarrier.pair at X, Y
  apply slitPlane.membership.backward
  refine ⟨member, ?_⟩
  intro onSlit
  obtain ⟨_, nonpositive⟩ := onSlit
  rw complexPoint.re at nonpositive
  linarith

theorem slitPlane.of_im_positive (X Y : Real)
  requires positive : R[0] < Y
  shows (X, Y) ∈ slitPlane
proof
  have member := complexCarrier.pair at X, Y
  apply slitPlane.membership.backward
  refine ⟨member, ?_⟩
  intro onSlit
  obtain ⟨zero, _⟩ := onSlit
  rw complexPoint.im at zero
  linarith

-- Cauchy's theorem for a rectangle inside the slit plane.
theorem rectIntegral.zero_slit (f : Set) (X0 X1 Y0 Y1 : Real)
  requires values : ComplexValuedOn(f, complexCarrier)
  requires holomorphic : HolomorphicOn(f, slitPlane)
  requires inside : RectInside(slitPlane, X0, X1, Y0, Y1)
  requires horizontal : X0 ≤ X1
  requires vertical : Y0 ≤ Y1
  shows rectIntegral(f, X0, X1, Y0, Y1) = ℂ[0]
proof
  have continuous := HolomorphicOn.continuous with holomorphic
  apply rectIntegral.goursat with values, continuous, inside, horizontal,
    vertical
  intros X hX Y hY
  exact HolomorphicOn.differentiable with holomorphic, (inside with X, hX,
    Y, hY)

theorem mellinContour.values (β v : Real)
  shows ComplexValuedOn(mellinContour(β, v), complexCarrier)
proof
  intros z hz
  exact FunctionBetween.apply_closed with (mellinContour.function at β, v), hz

-- Cauchy's theorem on [A, ρ] × [0, A] and [0, ρ] × [A, ρ], joined along
-- y = A: the integral along [A, ρ] equals the integral up the imaginary
-- axis from iA to iρ, up to four short or far edges.
theorem mellinContour.edges (β v A ρ : Real)
  requires positive : R[0] < A
  requires ordered : A ≤ ρ
  shows ℂ[horizontalIntegral(mellinContour(β, v), A, ρ, R[0]) -
      verticalIntegral(mellinContour(β, v), R[0], A, ρ)] =
    ℂ[horizontalIntegral(mellinContour(β, v), R[0], ρ, ρ) -
      verticalIntegral(mellinContour(β, v), ρ, R[0], A) -
      verticalIntegral(mellinContour(β, v), ρ, A, ρ) +
      verticalIntegral(mellinContour(β, v), A, R[0], A) -
      horizontalIntegral(mellinContour(β, v), R[0], A, A)]
proof
  have values := mellinContour.values at β, v
  have holomorphic := mellinContour.holomorphic at β, v
  have continuous := HolomorphicOn.continuous with holomorphic
  have zeroLe : R[0] ≤ A by linarith
  have insideFirst : RectInside(slitPlane, A, ρ, R[0], A)
    intros X hX Y hY
    obtain ⟨xReal, xLow, _⟩ := closedInterval.membership.forward with hX
    have typedX : Real(X) by exact xReal
    have xPositive : R[0] < X by linarith
    have typedY : Real(Y) by exact (closedInterval.membership.forward with
      hY).left
    exact slitPlane.of_re_positive at X, Y with xPositive
  have insideSecond : RectInside(slitPlane, R[0], ρ, A, ρ)
    intros X hX Y hY
    obtain ⟨yReal, yLow, _⟩ := closedInterval.membership.forward with hY
    have typedY : Real(Y) by exact yReal
    have yPositive : R[0] < Y by linarith
    have typedX : Real(X) by exact (closedInterval.membership.forward with
      hX).left
    exact slitPlane.of_im_positive at X, Y with yPositive
  have first := rectIntegral.zero_slit with values, holomorphic, insideFirst,
    ordered, zeroLe
  have zeroRho : R[0] ≤ ρ by linarith
  have second := rectIntegral.zero_slit with values, holomorphic,
    insideSecond, zeroRho, ordered
  have segment : ∀ X ∈ closedInterval(R[0], ρ), (X, A) ∈ slitPlane
    intros X hX
    obtain ⟨xReal, _, _⟩ := closedInterval.membership.forward with hX
    have typedX : Real(X) by exact xReal
    exact slitPlane.of_im_positive at X, A with positive
  have pathContinuous := horizontalIntegrand.continuous with values,
    continuous, segment
  have joined := pathIntegral.add_interval with zeroLe, ordered,
    pathContinuous
  unfold rectIntegral at first
  unfold rectIntegral at second
  unfold horizontalIntegral at first
  unfold horizontalIntegral at second
  unfold horizontalIntegral
  have m1 := pathIntegral.member at horizontalIntegrand(mellinContour(β, v),
    R[0]), A, ρ
  have m2 := pathIntegral.member at horizontalIntegrand(mellinContour(β, v),
    A), A, ρ
  have m3 := pathIntegral.member at horizontalIntegrand(mellinContour(β, v),
    A), R[0], ρ
  have m4 := pathIntegral.member at horizontalIntegrand(mellinContour(β, v),
    ρ), R[0], ρ
  have m5 := pathIntegral.member at horizontalIntegrand(mellinContour(β, v),
    A), R[0], A
  have v1 := verticalIntegral.member at mellinContour(β, v), ρ, R[0], A
  have v2 := verticalIntegral.member at mellinContour(β, v), A, R[0], A
  have v3 := verticalIntegral.member at mellinContour(β, v), ρ, A, ρ
  have v4 := verticalIntegral.member at mellinContour(β, v), R[0], A, ρ
  linear_combination first + second + joined

-- The pointwise bounds at the points (X, Y) of the edges.
theorem mellinContour.far_point (β v ρ X Y : Real)
  requires nonnegativeB : R[0] ≤ β
  requires positive : R[0] < ρ
  requires exponent : v < R[1]
  requires upper : R[0] ≤ Y
  requires far : ρ ≤ X ∨ ρ ≤ Y
  shows complexAbs(mellinContour(β, v)((X, Y))) ≤
    R[2 * realRpow(ρ, R[v - 1])]
proof
  have member := complexCarrier.pair at X, Y
  have imaginary : realZero ≤ complexIm((X, Y))
    rw complexPoint.im
    exact upper
  have reBound := complexAbs.re_le with member
  have imBound := complexAbs.im_le with member
  rw complexPoint.re at reBound
  rw complexPoint.im at imBound
  have upperX := abs.upper at X
  have upperY := abs.upper at Y
  have farAbs : ρ ≤ complexAbs((X, Y))
    cases far with farX | farY
    . linarith
    . linarith
  exact mellinContour.far_bound with member, nonnegativeB, imaginary, positive,
    farAbs, exponent

theorem mellinContour.near_point (β v A X Y : Real)
  requires positiveB : R[0] < β
  requires positive : R[0] < A
  requires small : R[2 * β * A] ≤ R[1]
  requires exponent : v < R[0]
  requires lowerX : R[0] ≤ X
  requires upperX : X ≤ A
  requires lowerY : R[0] ≤ Y
  requires upperY : Y ≤ A
  requires far : A ≤ X ∨ A ≤ Y
  shows complexAbs(mellinContour(β, v)((X, Y))) ≤
    R[2 * β * realRpow(A, v)]
proof
  have member := complexCarrier.pair at X, Y
  have reBound := complexAbs.re_le with member
  have imBound := complexAbs.im_le with member
  have parts := complexAbs.le_parts with member
  rw [complexPoint.re, complexPoint.im] at parts
  rw complexPoint.re at reBound
  rw complexPoint.im at imBound
  have absX := abs.of_nonnegative with lowerX
  have absY := abs.of_nonnegative with lowerY
  have farAbs : A ≤ complexAbs((X, Y))
    cases far with farX | farY
    . linarith
    . linarith
  have nearAbs : complexAbs((X, Y)) ≤ R[2 * A] by linarith
  exact mellinContour.near_bound with member, positiveB, positive, farAbs,
    nearAbs, small, exponent

-- The four edges together are at most 8 ρ^v + 8β A^(v+1).
theorem mellinContour.edges_bound (β v A ρ : Real)
  requires positiveB : R[0] < β
  requires positive : R[0] < A
  requires ordered : A ≤ ρ
  requires small : R[2 * β * A] ≤ R[1]
  requires exponent : v < R[0]
  shows complexAbs(ℂ[horizontalIntegral(mellinContour(β, v), R[0], ρ, ρ) -
      verticalIntegral(mellinContour(β, v), ρ, R[0], A) -
      verticalIntegral(mellinContour(β, v), ρ, A, ρ) +
      verticalIntegral(mellinContour(β, v), A, R[0], A) -
      horizontalIntegral(mellinContour(β, v), R[0], A, A)]) ≤
    R[8 * realRpow(ρ, v) + 8 * β * realRpow(A, R[v + 1])]
proof
  have values := mellinContour.values at β, v
  have holomorphic := mellinContour.holomorphic at β, v
  have continuous := HolomorphicOn.continuous with holomorphic
  have nonnegativeB : R[0] ≤ β by linarith
  have rhoPositive : R[0] < ρ by linarith
  have exponentOne : v < R[1] by linarith
  have zeroA : R[0] ≤ A by linarith
  have zeroRho : R[0] ≤ ρ by linarith
  -- The top edge y = ρ, 0 ≤ x ≤ ρ.
  have topInside : ∀ X ∈ closedInterval(R[0], ρ), (X, ρ) ∈ slitPlane
    intros X hX
    have typedX : Real(X) by exact (closedInterval.membership.forward with
      hX).left
    exact slitPlane.of_im_positive at X, ρ with rhoPositive
  have topBound : ∀ X ∈ closedInterval(R[0], ρ),
      complexAbs(mellinContour(β, v)((X, ρ))) ≤ R[2 * realRpow(ρ, R[v - 1])]
    intros X hX
    have typedX : Real(X) by exact (closedInterval.membership.forward with
      hX).left
    have far : ρ ≤ X ∨ ρ ≤ ρ
      right
      linarith
    exact mellinContour.far_point with nonnegativeB, rhoPositive, exponentOne,
      zeroRho, far
  have top := horizontalIntegral.abs_le with values, continuous, topInside,
    zeroRho, topBound
  -- The right edge x = ρ, 0 ≤ y ≤ A and A ≤ y ≤ ρ.
  have rightBound : ∀ Y0 ∈ ℝ, ∀ Y1 ∈ ℝ, R[0] ≤ Y0 →
      (∀ Y ∈ closedInterval(Y0, Y1), (ρ, Y) ∈ slitPlane) ∧
      (∀ Y ∈ closedInterval(Y0, Y1), complexAbs(mellinContour(β, v)((ρ, Y)))
        ≤ R[2 * realRpow(ρ, R[v - 1])])
    intros Y0 y0Member Y1 y1Member lower
    refine ⟨?_, ?_⟩
    . intros Y hY
      have typedY : Real(Y) by exact (closedInterval.membership.forward with
        hY).left
      exact slitPlane.of_re_positive at ρ, Y with rhoPositive
    . intros Y hY
      obtain ⟨yReal, yLow, _⟩ := closedInterval.membership.forward with hY
      have typedY : Real(Y) by exact yReal
      have upper : R[0] ≤ Y by linarith
      have far : ρ ≤ ρ ∨ ρ ≤ Y
        left
        linarith
      exact mellinContour.far_point with nonnegativeB, rhoPositive,
        exponentOne, upper, far
  have zeroZero : R[0] ≤ R[0] by linarith
  have zeroMember : R[0] ∈ ℝ by typecheck
  have aMember : A ∈ ℝ by typecheck
  have rhoMember : ρ ∈ ℝ by typecheck
  obtain ⟨rightInside1, rightBound1⟩ := rightBound with R[0], zeroMember, A,
    aMember, zeroZero
  obtain ⟨rightInside2, rightBound2⟩ := rightBound with A, aMember, ρ,
    rhoMember, zeroA
  have right1 := verticalIntegral.abs_le with values, continuous, rightInside1,
    zeroA, rightBound1
  have right2 := verticalIntegral.abs_le with values, continuous, rightInside2,
    ordered, rightBound2
  -- The short edges x = A and y = A near 0.
  have shortInsideV : ∀ Y ∈ closedInterval(R[0], A), (A, Y) ∈ slitPlane
    intros Y hY
    have typedY : Real(Y) by exact (closedInterval.membership.forward with
      hY).left
    exact slitPlane.of_re_positive at A, Y with positive
  have shortBoundV : ∀ Y ∈ closedInterval(R[0], A),
      complexAbs(mellinContour(β, v)((A, Y))) ≤ R[2 * β * realRpow(A, v)]
    intros Y hY
    obtain ⟨yReal, yLow, yHigh⟩ := closedInterval.membership.forward with hY
    have typedY : Real(Y) by exact yReal
    have selfLe : A ≤ A by linarith
    have far : A ≤ A ∨ A ≤ Y
      left
      exact selfLe
    exact mellinContour.near_point with positiveB, positive, small, exponent,
      zeroA, selfLe, yLow, yHigh, far
  have shortV := verticalIntegral.abs_le with values, continuous,
    shortInsideV, zeroA, shortBoundV
  have shortInsideH : ∀ X ∈ closedInterval(R[0], A), (X, A) ∈ slitPlane
    intros X hX
    have typedX : Real(X) by exact (closedInterval.membership.forward with
      hX).left
    exact slitPlane.of_im_positive at X, A with positive
  have shortBoundH : ∀ X ∈ closedInterval(R[0], A),
      complexAbs(mellinContour(β, v)((X, A))) ≤ R[2 * β * realRpow(A, v)]
    intros X hX
    obtain ⟨xReal, xLow, xHigh⟩ := closedInterval.membership.forward with hX
    have typedX : Real(X) by exact xReal
    have selfLe : A ≤ A by linarith
    have far : A ≤ X ∨ A ≤ A
      right
      exact selfLe
    exact mellinContour.near_point with positiveB, positive, small, exponent,
      xLow, xHigh, zeroA, selfLe, far
  have shortH := horizontalIntegral.abs_le with values, continuous,
    shortInsideH, zeroA, shortBoundH
  -- Collect.
  have t := horizontalIntegral.member at mellinContour(β, v), R[0], ρ, ρ
  have r1 := verticalIntegral.member at mellinContour(β, v), ρ, R[0], A
  have r2 := verticalIntegral.member at mellinContour(β, v), ρ, A, ρ
  have sv := verticalIntegral.member at mellinContour(β, v), A, R[0], A
  have sh := horizontalIntegral.member at mellinContour(β, v), R[0], A, A
  have a1 : ℂ[horizontalIntegral(mellinContour(β, v), R[0], ρ, ρ) -
    verticalIntegral(mellinContour(β, v), ρ, R[0], A)] ∈ ℂ by typecheck
  have a2 : ℂ[horizontalIntegral(mellinContour(β, v), R[0], ρ, ρ) -
    verticalIntegral(mellinContour(β, v), ρ, R[0], A) -
    verticalIntegral(mellinContour(β, v), ρ, A, ρ)] ∈ ℂ by typecheck
  have a3 : ℂ[horizontalIntegral(mellinContour(β, v), R[0], ρ, ρ) -
    verticalIntegral(mellinContour(β, v), ρ, R[0], A) -
    verticalIntegral(mellinContour(β, v), ρ, A, ρ) +
    verticalIntegral(mellinContour(β, v), A, R[0], A)] ∈ ℂ by typecheck
  have triangle1 := complexAbs.sub_le with t, r1
  have triangle2 := complexAbs.sub_le with a1, r2
  have triangle3 := complexAbs.triangle with a2, sv
  have triangle4 := complexAbs.sub_le with a3, sh
  have split := realRpow.add at ρ, R[v - 1], R[1] with rhoPositive
  have exponentSum : R[v - 1 + 1] = v by ring
  rw [exponentSum, (realRpow.one with rhoPositive)] at split
  have splitA := realRpow.add at A, v, R[1] with positive
  rw (realRpow.one with positive) at splitA
  have rhoPower := realRpow.real at ρ, R[v - 1]
  have aPower := realRpow.real at A, v
  have expand1 : R[2 * (2 * realRpow(ρ, R[v - 1]) * (ρ - 0))] =
    R[4 * realRpow(ρ, v)]
    rw split
    ring
  have expand2 : R[2 * (2 * realRpow(ρ, R[v - 1]) * (A - 0))] +
      R[2 * (2 * realRpow(ρ, R[v - 1]) * (ρ - A))] = R[4 * realRpow(ρ, v)]
    rw split
    ring
  have expand3 : R[2 * (2 * β * realRpow(A, v) * (A - 0))] =
    R[4 * β * realRpow(A, R[v + 1])]
    rw splitA
    ring
  have total : R[8 * realRpow(ρ, v) + 8 * β * realRpow(A, R[v + 1])] =
    R[4 * realRpow(ρ, v) + 4 * realRpow(ρ, v) + 4 * β * realRpow(A, R[v + 1]) +
      4 * β * realRpow(A, R[v + 1])] by ring
  rw total
  linarith

-- Integrals along paths are the complex integrals of Integral.
theorem pathIntegral.complex (g : Set) (A B : Real)
  requires ordered : A ≤ B
  requires continuous : PathContinuousOn(g, A, B)
  shows ComplexRiemannIntegrable(g, A, B) ∧
    pathIntegral(g, A, B) = complexIntegral(g, A, B)
proof
  have values := continuous.left
  have functionPathRe := pathRe.function with values
  have functionPathIm := pathIm.function with values
  have functionRe := complexFunctionRe.function with values
  have functionIm := complexFunctionIm.function with values
  have sameRe : pathRe(g) = complexFunctionRe(g)
    apply FunctionBetween.ext with functionPathRe, functionRe
    intros X xMember
    have typedX : Real(X) by exact xMember
    rw [(pathRe.apply with values), (complexFunctionRe.apply with values)]
  have sameIm : pathIm(g) = complexFunctionIm(g)
    apply FunctionBetween.ext with functionPathIm, functionIm
    intros X xMember
    have typedX : Real(X) by exact xMember
    rw [(pathIm.apply with values), (complexFunctionIm.apply with values)]
  obtain ⟨_, member, integralRe, integralIm⟩ := pathIntegral.spec with
    ordered, continuous
  rw sameRe at integralRe
  rw sameIm at integralIm
  have reReal := complexRe.real with member
  have imReal := complexIm.real with member
  refine ⟨⟨values, ⟨complexRe(pathIntegral(g, A, B)), reReal, integralRe⟩,
    ⟨complexIm(pathIntegral(g, A, B)), imReal, integralIm⟩⟩, ?_⟩
  unfold pathIntegral
  unfold complexIntegral
  rw [sameRe, sameIm]

-- On the positive real axis the contour function is the integrand
-- (e^(iβx) − 1) x^(v−1).
theorem mellinContour.real_axis (β v X : Real)
  requires positive : R[0] < X
  shows horizontalIntegrand(mellinContour(β, v), R[0])(X) =
    mellinExpIntegrand(β, v)(X)
proof
  have values := mellinContour.values at β, v
  have xMember : X ∈ ℝ by typecheck
  have point : (X, R[0]) = complexOfReal(X)
    rw [complexPoint.eq, complexOfReal.zero]
    ring
  have member := complexCarrier.pair at X, R[0]
  rw [(horizontalIntegrand.value at mellinContour(β, v), R[0], X with values,
    xMember), (mellinContour.value with member), point,
    (complexLog.of_real with positive), (mellinExpIntegrand.value at β, v, X
    with xMember)]
  have power : complexExp(ℂ[complexOfReal(R[v - 1]) *
      complexOfReal(realLog(X))]) = complexOfReal(realRpow(X, R[v - 1]))
    rw [← complexOfReal.mul, complexExp.of_real]
    unfold realRpow
    rfl
  have wave : ℂ[complexImaginaryUnit * complexOfReal(β) * complexOfReal(X)] =
      ℂ[complexImaginaryUnit * complexOfReal(R[β * X])]
    rw complexOfReal.mul
    ring
  rw [power, wave]

-- e^(iθ) at θ = π/2 is i, and the argument of iy is π/2 for y > 0.
theorem complexExp.i_half_pi
  shows complexExp(ℂ[complexImaginaryUnit * complexOfReal(realHalfPi)]) =
    complexImaginaryUnit
proof
  rw [complexExp.euler, realHalfPi.cos, realSin.half_pi]
  unfold complexImaginaryUnit
  rfl

theorem complexLog.imaginary (Y : Real)
  requires positive : R[0] < Y
  shows complexLog((R[0], Y)) = ℂ[complexOfReal(realLog(Y)) +
    complexImaginaryUnit * complexOfReal(realHalfPi)]
proof
  have member := complexCarrier.pair at R[0], Y
  have iMember := complexImaginaryUnit.member
  have point : (R[0], Y) = ℂ[complexOfReal(Y) * complexImaginaryUnit]
    rw [complexPoint.eq, complexOfReal.zero]
    ring
  have yMember : complexOfReal(Y) ∈ ℂ by typecheck
  have absolute : complexAbs((R[0], Y)) = Y
    rw [point, (complexAbs.mul with yMember, iMember),
      complexAbs.of_real, complexAbs.imaginary,
      (abs.of_nonnegative with (realLess.implies_le with positive))]
    ring
  have halfPositive := realHalfPi.positive
  have piBounds := realPi.bounds
  have lower : R[-realPi] < realHalfPi
    unfold realPi
    linarith
  have upper : realHalfPi ≤ realPi
    unfold realPi
    linarith
  have polar : (R[0], Y) = ℂ[complexOfReal(Y) *
      complexExp(complexImaginaryUnit * complexOfReal(realHalfPi))]
    rw [complexExp.i_half_pi, point]
  have argument := complexArg.unique with positive, lower, upper, polar
  rw [(complexLog.value with member), absolute, argument, ← complexPoint.eq]

-- On the positive imaginary axis, i (e^(iβz) − 1) z^(v−1) at z = iy is
-- e^(iπv/2) (e^(−βy) − 1) y^(v−1).
theorem mellinContour.imaginary_axis (β v Y : Real)
  requires positive : R[0] < Y
  shows verticalIntegrand(mellinContour(β, v), R[0])(Y) =
    ℂ[complexExp(complexImaginaryUnit * complexOfReal(R[v * realHalfPi])) *
      mellinEulerIntegrand(β, v)(Y)]
proof
  have values := mellinContour.values at β, v
  have yMember : Y ∈ ℝ by typecheck
  have member := complexCarrier.pair at R[0], Y
  have iMember := complexImaginaryUnit.member
  have square := complexImaginaryUnit.square
  rw [(verticalIntegrand.value at mellinContour(β, v), R[0], Y with values,
    yMember), (mellinContour.value with member),
    (complexLog.imaginary with positive),
    (mellinEulerIntegrand.value at β, v, Y with yMember)]
  have point : (R[0], Y) = ℂ[complexOfReal(Y) * complexImaginaryUnit]
    rw [complexPoint.eq, complexOfReal.zero]
    ring
  have wave : complexExp(ℂ[complexImaginaryUnit * complexOfReal(β) *
      (R[0], Y)]) = complexOfReal(realExp(R[-(β * Y)]))
    rw [point, ← complexExp.of_real, complexOfReal.neg, complexOfReal.mul]
    have same : ℂ[complexImaginaryUnit * complexOfReal(β) * (complexOfReal(Y) *
        complexImaginaryUnit)] = ℂ[-(complexOfReal(β) * complexOfReal(Y))]
      linear_combination complexOfReal(β) * complexOfReal(Y) * square
    rw same
  have logPart : complexOfReal(R[(v - 1) * realLog(Y)]) ∈ ℂ by typecheck
  have anglePart : ℂ[complexImaginaryUnit *
    complexOfReal(R[(v - 1) * realHalfPi])] ∈ ℂ by typecheck
  have split := complexExp.add with logPart, anglePart
  have exponent : ℂ[complexOfReal(R[v - 1]) * (complexOfReal(realLog(Y)) +
      complexImaginaryUnit * complexOfReal(realHalfPi))] =
      ℂ[complexOfReal(R[(v - 1) * realLog(Y)]) + complexImaginaryUnit *
        complexOfReal(R[(v - 1) * realHalfPi])]
    rw [complexOfReal.mul, complexOfReal.mul]
    ring
  have power : complexExp(complexOfReal(R[(v - 1) * realLog(Y)])) =
      complexOfReal(realRpow(Y, R[v - 1]))
    rw complexExp.of_real
    unfold realRpow
    rfl
  have halfAngle : ℂ[complexImaginaryUnit * complexOfReal(realHalfPi)] ∈ ℂ
    by typecheck
  have turn := complexExp.add with halfAngle, anglePart
  rw complexExp.i_half_pi at turn
  have angles : ℂ[complexImaginaryUnit * complexOfReal(realHalfPi) +
      complexImaginaryUnit * complexOfReal(R[(v - 1) * realHalfPi])] =
      ℂ[complexImaginaryUnit * complexOfReal(R[v * realHalfPi])]
    rw [complexOfReal.mul, complexOfReal.mul, complexOfReal.sub,
      complexOfReal.one]
    ring
  rw angles at turn
  rw [wave, exponent, split, power, turn]
  have phase := complexExp.member with anglePart
  have expReal := realExp.real at R[-(β * Y)]
  have powerReal := realRpow.real at Y, R[v - 1]
  rw [(complexOfReal.mul at R[realExp(R[-(β * Y)]) - 1],
    realRpow(Y, R[v - 1])), (complexOfReal.sub at realExp(R[-(β * Y)]),
    R[1]), complexOfReal.one]
  ring

-- The two axis integrals are the edge integrals of the contour function.
theorem mellin.axes (β v A ρ : Real)
  requires positive : R[0] < A
  requires ordered : A ≤ ρ
  shows ComplexRiemannIntegrable(mellinExpIntegrand(β, v), A, ρ) ∧
    ComplexRiemannIntegrable(mellinEulerIntegrand(β, v), A, ρ) ∧
    horizontalIntegral(mellinContour(β, v), A, ρ, R[0]) =
      complexIntegral(mellinExpIntegrand(β, v), A, ρ) ∧
    verticalIntegral(mellinContour(β, v), R[0], A, ρ) =
      ℂ[complexExp(complexImaginaryUnit * complexOfReal(R[v * realHalfPi])) *
        complexIntegral(mellinEulerIntegrand(β, v), A, ρ)]
proof
  have values := mellinContour.values at β, v
  have holomorphic := mellinContour.holomorphic at β, v
  have continuous := HolomorphicOn.continuous with holomorphic
  have iMember := complexImaginaryUnit.member
  have expFunction := mellinExpIntegrand.function at β, v
  have expValues : ComplexValuedOn(mellinExpIntegrand(β, v), ℝ)
    intros X hX
    exact FunctionBetween.apply_closed with expFunction, hX
  have eulerFunction := mellinEulerIntegrand.function at β, v
  have eulerValues : ComplexValuedOn(mellinEulerIntegrand(β, v), ℝ)
    intros X hX
    exact FunctionBetween.apply_closed with eulerFunction, hX
  -- The real axis.
  have realInside : ∀ X ∈ closedInterval(A, ρ), (X, R[0]) ∈ slitPlane
    intros X hX
    obtain ⟨xReal, xLow, _⟩ := closedInterval.membership.forward with hX
    have typedX : Real(X) by exact xReal
    have xPositive : R[0] < X by linarith
    exact slitPlane.of_re_positive at X, R[0] with xPositive
  have realPath := horizontalIntegrand.continuous with values, continuous,
    realInside
  obtain ⟨realIntegrable, realSame⟩ := pathIntegral.complex with ordered,
    realPath
  have realAgree : ∀ X ∈ ℝ, A < X → X < ρ → mellinExpIntegrand(β, v)(X) =
      horizontalIntegrand(mellinContour(β, v), R[0])(X)
    intros X xMember low high
    have typedX : Real(X) by exact xMember
    have xPositive : R[0] < X by linarith
    rw (mellinContour.real_axis with xPositive)
  obtain ⟨expIntegrable, expSame⟩ := complexIntegral.congr_interior with
    realIntegrable, expValues, realAgree
  -- The imaginary axis.
  have imaginaryInside : ∀ Y ∈ closedInterval(A, ρ), (R[0], Y) ∈ slitPlane
    intros Y hY
    obtain ⟨yReal, yLow, _⟩ := closedInterval.membership.forward with hY
    have typedY : Real(Y) by exact yReal
    have yPositive : R[0] < Y by linarith
    exact slitPlane.of_im_positive at R[0], Y with yPositive
  have imaginaryPath := verticalIntegrand.continuous with values, continuous,
    imaginaryInside
  obtain ⟨imaginaryIntegrable, imaginarySame⟩ := pathIntegral.complex with
    ordered, imaginaryPath
  have angle : ℂ[complexImaginaryUnit * complexOfReal(R[v * realHalfPi])] ∈ ℂ
    by typecheck
  have phase := complexExp.member with angle
  have phaseNonzero := complexExp.nonzero with angle
  have constantValues : ComplexValuedOn(complexFunctionConst(complexExp(
      ℂ[complexImaginaryUnit * complexOfReal(R[v * realHalfPi])]), ℝ), ℝ)
    intros X hX
    rw (complexFunctionConst.value with phase, hX)
    exact phase
  have scaledValues : ComplexValuedOn(complexFunctionMul(complexFunctionConst(
      complexExp(ℂ[complexImaginaryUnit * complexOfReal(R[v * realHalfPi])]),
      ℝ), mellinEulerIntegrand(β, v), ℝ), ℝ)
    intros X hX
    rw [(complexFunctionMul.value with constantValues, eulerValues, hX),
      (complexFunctionConst.value with phase, hX)]
    have value := eulerValues with X, hX
    typecheck
  have imaginaryAgree : ∀ Y ∈ ℝ, A < Y → Y < ρ →
      complexFunctionMul(complexFunctionConst(complexExp(
      ℂ[complexImaginaryUnit * complexOfReal(R[v * realHalfPi])]), ℝ),
      mellinEulerIntegrand(β, v), ℝ)(Y) =
      verticalIntegrand(mellinContour(β, v), R[0])(Y)
    intros Y yMember low high
    have typedY : Real(Y) by exact yMember
    have yPositive : R[0] < Y by linarith
    rw [(mellinContour.imaginary_axis with yPositive),
      (complexFunctionMul.value with constantValues, eulerValues, yMember),
      (complexFunctionConst.value with phase, yMember)]
  obtain ⟨scaledIntegrable, scaledSame⟩ := complexIntegral.congr_interior with
    imaginaryIntegrable, scaledValues, imaginaryAgree
  -- Undo the phase to see that the Euler integrand is integrable.
  have inverse := complexInv.member with phase
  have undone := complexIntegral.const_mul with inverse, ordered,
    scaledIntegrable
  obtain ⟨undoneIntegrable, undoneValue⟩ := undone
  have inverseValues : ComplexValuedOn(complexFunctionConst(complexInv(
      complexExp(ℂ[complexImaginaryUnit * complexOfReal(R[v * realHalfPi])])),
      ℝ), ℝ)
    intros X hX
    rw (complexFunctionConst.value with inverse, hX)
    exact inverse
  have cancel := complexInv.mul_cancel with phase, phaseNonzero
  have eulerAgree : ∀ Y ∈ ℝ, A < Y → Y < ρ → mellinEulerIntegrand(β, v)(Y) =
      complexFunctionMul(complexFunctionConst(complexInv(complexExp(
      ℂ[complexImaginaryUnit * complexOfReal(R[v * realHalfPi])])), ℝ),
      complexFunctionMul(complexFunctionConst(complexExp(
      ℂ[complexImaginaryUnit * complexOfReal(R[v * realHalfPi])]), ℝ),
      mellinEulerIntegrand(β, v), ℝ), ℝ)(Y)
    intros Y yMember low high
    have value := eulerValues with Y, yMember
    rw [(complexFunctionMul.value with inverseValues, scaledValues, yMember),
      (complexFunctionMul.value with constantValues, eulerValues, yMember),
      (complexFunctionConst.value with phase, yMember),
      (complexFunctionConst.value with inverse, yMember)]
    linear_combination (-mellinEulerIntegrand(β, v)(Y)) * cancel
  obtain ⟨eulerIntegrable, _⟩ := complexIntegral.congr_interior with
    undoneIntegrable, eulerValues, eulerAgree
  obtain ⟨_, scaledValue⟩ := complexIntegral.const_mul with phase, ordered,
    eulerIntegrable
  refine ⟨expIntegrable, eulerIntegrable, ?_, ?_⟩
  . unfold horizontalIntegral
    rw [realSame, expSame]
  . unfold verticalIntegral
    rw [imaginarySame, ← scaledSame, scaledValue]

-- Section: Affine substitution in Riemann integrals
-- The image c pₙ + d of a sequence, and x ↦ f(c x + d).
defgraph affineSequence (p : Set, c d : Real) (n ∈ ℕ) : ℝ := R[c * p[n] + d]
requires points : RealSequence(p)
proof
  have value := RealSequence.value with points
  typecheck

defgraph affineCompose (f : Set, c d : Real) (X ∈ ℝ) : ℝ := f(R[c * X + d])
requires function : FunctionBetween(f, ℝ, ℝ)
proof
  have argument : R[c * X + d] ∈ ℝ by typecheck
  exact FunctionBetween.apply_closed with function, argument

-- ∫_A^B f(c x + d) dx = (1/c) ∫_{cA+d}^{cB+d} f for c > 0, through the
-- Riemann sums: a δ-fine tagged partition of [A, B] maps to a cδ-fine one
-- of [cA + d, cB + d], and the sums scale by c.
theorem HasRiemannIntegral.affine (f : Set) (c d A B I : Real)
  requires positive : R[0] < c
  requires ordered : A ≤ B
  requires integral : HasRiemannIntegral(f, R[c * A + d], R[c * B + d], I)
  shows HasRiemannIntegral(affineCompose(f, c, d), A, B,
    R[realInvValue(c) * I])
proof
  obtain ⟨fFunction, _, approximate⟩ := integral
  have gFunction := affineCompose.function at f, c, d with fFunction
  have nonzero : c ≠ R[0] by linarith
  have inverse := realInvValue.mul_right with nonzero
  have inversePositive := realInvValue.positive with positive
  refine ⟨gFunction, ordered, ?_⟩
  intros E eReal ePositive
  have scaledReal : R[c * E] ∈ ℝ by typecheck
  have scaledPositive := realLess.mul_left_of_positive with ePositive, positive
  have zeroProduct : R[c * 0] = R[0] by ring
  rw zeroProduct at scaledPositive
  obtain ⟨D, dReal, dPositive, close⟩ := approximate with R[c * E],
    scaledReal, scaledPositive
  have typedD : Real(D) by exact dReal
  witness R[realInvValue(c) * D]
  have fineReal : R[realInvValue(c) * D] ∈ ℝ by typecheck
  have finePositive := realLess.mul_left_of_positive with dPositive,
    inversePositive
  have zeroInverse : R[realInvValue(c) * 0] = R[0] by ring
  rw zeroInverse at finePositive
  refine ⟨fineReal, finePositive, ?_⟩
  intros p t N nMember tagged fine
  have typedN := nat.omega.backward with nMember
  obtain ⟨partition, tags, cells⟩ := tagged
  obtain ⟨points, start, finish, steps⟩ := partition
  obtain ⟨_, _, widths⟩ := fine
  have mappedPoints := affineSequence.function at p, c, d with points
  have mappedTags := affineSequence.function at t, c, d with tags
  have pointsSequence : RealSequence(affineSequence(p, c, d)) by
    exact mappedPoints
  have tagsSequence : RealSequence(affineSequence(t, c, d)) by
    exact mappedTags
  have pointValue : ∀ i ∈ ℕ, affineSequence(p, c, d)[i] = R[c * p[i] + d]
    intros i iMember
    exact affineSequence.value with points, iMember
  have tagValue : ∀ i ∈ ℕ, affineSequence(t, c, d)[i] = R[c * t[i] + d]
    intros i iMember
    exact affineSequence.value with tags, iMember
  have zeroMember : (0:N) ∈ ℕ by typecheck
  have mappedPartition : IntervalPartition(affineSequence(p, c, d),
      R[c * A + d], R[c * B + d], N)
    refine ⟨pointsSequence, ?_, ?_, ?_⟩
    . rw [(pointValue with (0:N), zeroMember), start]
    . rw [(pointValue with N, nMember), finish]
    . intros i iMember below
      have nextMember : succ(i) ∈ ℕ by typecheck
      have step := steps with i, iMember, below
      have pi := RealSequence.value at p, i with points
      have pNext := RealSequence.value at p, succ(i) with points
      rw [(pointValue with i, iMember), (pointValue with succ(i), nextMember)]
      have scaled := realLess.mul_left_of_positive with step, positive
      linarith
  have mappedTagged : TaggedPartition(affineSequence(p, c, d),
      affineSequence(t, c, d), R[c * A + d], R[c * B + d], N)
    refine ⟨mappedPartition, tagsSequence, ?_⟩
    intros i iMember below
    have nextMember : succ(i) ∈ ℕ by typecheck
    obtain ⟨tagReal, tagLow, tagHigh⟩ := closedInterval.membership.forward
      with (cells with i, iMember, below)
    have pi := RealSequence.value at p, i with points
    have pNext := RealSequence.value at p, succ(i) with points
    have ti := RealSequence.value at t, i with tags
    rw [(pointValue with i, iMember), (pointValue with succ(i), nextMember),
      (tagValue with i, iMember)]
    have low := realLe.mul_left_of_nonnegative with tagLow,
      (realLess.implies_le with positive)
    have high := realLe.mul_left_of_nonnegative with tagHigh,
      (realLess.implies_le with positive)
    apply closedInterval.membership.backward
    refine ⟨?_, ?_, ?_⟩
    . typecheck
    . linarith
    . linarith
  have mappedFine : FinePartition(affineSequence(p, c, d), R[c * A + d],
      R[c * B + d], N, D)
    refine ⟨mappedPartition, dPositive, ?_⟩
    intros i iMember below
    have nextMember : succ(i) ∈ ℕ by typecheck
    have width := widths with i, iMember, below
    have pi := RealSequence.value at p, i with points
    have pNext := RealSequence.value at p, succ(i) with points
    rw [(pointValue with i, iMember), (pointValue with succ(i), nextMember)]
    have width2 : R[p[succ(i)] - p[i]] < R[realInvValue(c) * D] by linarith
    have scaled := realLess.mul_left_of_positive with width2, positive
    have cancel : R[c * (realInvValue(c) * D)] = D
      linear_combination D * inverse
    have expand : R[c * (p[succ(i)] - p[i])] =
      R[c * p[succ(i)] + d - (c * p[i] + d)] by ring
    linarith
  have closeSum := close with affineSequence(p, c, d),
    affineSequence(t, c, d), N, nMember, mappedTagged, mappedFine
  have termsG := riemannTerms.function at affineCompose(f, c, d), p, t with
    gFunction, points, tags
  have termsF := riemannTerms.function at f, affineSequence(p, c, d),
    affineSequence(t, c, d) with fFunction, pointsSequence, tagsSequence
  have sequenceG : RealSequence(riemannTerms(affineCompose(f, c, d), p, t))
    by exact termsG
  have sequenceF : RealSequence(riemannTerms(f, affineSequence(p, c, d),
    affineSequence(t, c, d))) by exact termsF
  have multiple : ∀ k ∈ ℕ, k < N → riemannTerms(f, affineSequence(p, c, d),
      affineSequence(t, c, d))(k) =
      c * riemannTerms(affineCompose(f, c, d), p, t)(k)
    intros k kMember below
    have nextMember : succ(k) ∈ ℕ by typecheck
    have pk := RealSequence.value at p, k with points
    have pNext := RealSequence.value at p, succ(k) with points
    have tk := RealSequence.value at t, k with tags
    have tkMember : t[k] ∈ ℝ by typecheck
    have argument : R[c * t[k] + d] ∈ ℝ by typecheck
    have value := FunctionBetween.apply_closed with fFunction, argument
    have valueReal : Real(f(R[c * t[k] + d])) by exact value
    rw [(riemannTerms.value at f, affineSequence(p, c, d),
      affineSequence(t, c, d), k with fFunction, pointsSequence, tagsSequence,
      kMember), (riemannTerms.value at affineCompose(f, c, d), p, t, k with
      gFunction, points, tags, kMember), (tagValue with k, kMember),
      (pointValue with k, kMember), (pointValue with succ(k), nextMember),
      (affineCompose.value at f, c, d, t[k] with fFunction, tkMember)]
    unfold realSubValue
    rw [realMulValue.eq_mul, realMulValue.eq_mul]
    ring
  have scaledSum := realPartialSum.scaled with sequenceG, sequenceF, multiple
  have sumF : riemannSum(f, affineSequence(p, c, d), affineSequence(t, c, d),
      N) = R[c * riemannSum(affineCompose(f, c, d), p, t, N)]
    unfold riemannSum
    exact scaledSum
  rw sumF at closeSum
  have sumReal := riemannSum.real at affineCompose(f, c, d), p, t, N with
    gFunction, points, tags
  rw dist.eq_abs_sub at closeSum
  rw dist.eq_abs_sub
  have factor : R[riemannSum(affineCompose(f, c, d), p, t, N) -
      realInvValue(c) * I] = R[realInvValue(c) *
      (c * riemannSum(affineCompose(f, c, d), p, t, N) - I)]
    linear_combination (-riemannSum(affineCompose(f, c, d), p, t, N)) *
      inverse
  rw [factor, abs.mul, (abs.of_nonnegative with (realLess.implies_le with
    inversePositive))]
  have bounded := realLess.mul_left_of_positive with closeSum, inversePositive
  have cancel : R[realInvValue(c) * (c * E)] = E
    linear_combination E * inverse
  linarith

-- Section: Derivatives of real functions of a scaled argument
-- If g(y) = F(K y) and F has derivative D at K x, then g has derivative
-- D K at x.
theorem HasDerivativeAt.scaled_argument (F g : Set) (K X D : Real)
  requires functionF : F : ℝ → ℝ
  requires functionG : g : ℝ → ℝ
  requires formula : ∀ Y ∈ ℝ, g(Y) = F(R[K * Y])
  requires derivative : HasDerivativeAt(F, D, R[K * X])
  shows HasDerivativeAt(g, R[D * K], X)
proof
  have constant := constantRealFunction.function at K
  have identityFunction := identity.function at ℝ
  have inner := pointwiseMul.function with constant, identityFunction
  have innerValue : ∀ Y ∈ ℝ,
      pointwiseMul(constantRealFunction(K), identity(ℝ))(Y) = R[K * Y]
    intros Y yMember
    have typedY : Real(Y) by exact yMember
    have constantValue := constantRealFunction.value at K, Y
    have identityValue := identity.apply with yMember
    have constantReal : Real(constantRealFunction(K)(Y))
      rw constantValue
      typecheck
    have identityReal : Real(identity(ℝ)(Y))
      rw identityValue
      typecheck
    rw [(pointwiseMul.value at constantRealFunction(K), identity(ℝ), Y with
      constant, identityFunction, constantReal, identityReal), constantValue,
      identityValue]
  have composite := compose.function with inner, functionF
  have same : g = compose(F, pointwiseMul(constantRealFunction(K),
      identity(ℝ)), ℝ, ℝ, ℝ)
    apply FunctionBetween.ext with functionG, composite
    intros Y yMember
    rw [(compose.apply with inner, functionF, yMember),
      (innerValue with Y, yMember), (formula with Y, yMember)]
  have xMember : X ∈ ℝ by typecheck
  have innerDerivative := HasDerivativeAt.scale at identity(ℝ), K, realOne,
    X with (identity.has_derivative_at at X)
  rw ← (innerValue with X, xMember) at derivative
  have chain := HasDerivativeAt.comp with innerDerivative, derivative
  rw same
  apply HasDerivativeAt.congr_value with chain
  ring

-- y ↦ e^(−βy).
defgraph expDecay (β : Real) (Y ∈ ℝ) : ℝ := realExp(R[-(β * Y)])
proof
  typecheck

theorem expDecay.has_derivative (β X : Real)
  shows HasDerivativeAt(expDecay(β), R[-(β * expDecay(β)(X))], X)
proof
  have functionG := expDecay.function at β
  have formula : ∀ Y ∈ ℝ, expDecay(β)(Y) = realExp(R[-β * Y])
    intros Y yMember
    have typedY : Real(Y) by exact yMember
    rw expDecay.value
    have same : R[-(β * Y)] = R[-β * Y] by ring
    rw same
  have outer := realExp.derivative at R[-β * X]
  have scaled := HasDerivativeAt.scaled_argument with realExp.function,
    functionG, formula, outer
  apply HasDerivativeAt.congr_value with scaled
  rw expDecay.value
  have same : R[-(β * X)] = R[-β * X] by ring
  rw same
  ring

-- If g = c f and f has derivative D at x, then g has derivative c D.
theorem HasDerivativeAt.scaled_value (f g : Set) (c X D : Real)
  requires functionF : f : ℝ → ℝ
  requires functionG : g : ℝ → ℝ
  requires formula : ∀ Y ∈ ℝ, g(Y) = R[c * f(Y)]
  requires derivative : HasDerivativeAt(f, D, X)
  shows HasDerivativeAt(g, R[c * D], X)
proof
  have constant := constantRealFunction.function at c
  have product := pointwiseMul.function with constant, functionF
  have same : g = pointwiseMul(constantRealFunction(c), f)
    apply FunctionBetween.ext with functionG, product
    intros Y yMember
    have typedY : Real(Y) by exact yMember
    have value := FunctionBetween.apply_closed with functionF, yMember
    have valueReal : Real(f(Y)) by exact value
    have constantValue := constantRealFunction.value at c, Y
    have constantReal : Real(constantRealFunction(c)(Y))
      rw constantValue
      typecheck
    rw [(pointwiseMul.value at constantRealFunction(c), f, Y with constant,
      functionF, constantReal, valueReal), constantValue,
      (formula with Y, yMember)]
  rw same
  exact HasDerivativeAt.scale with derivative

-- y ↦ y^v / v and y ↦ −β e^(−βy), the factors of the integration by
-- parts for ∫ (e^(−βy) − 1) y^(v−1).
defgraph powerOver (v : Real) (Y ∈ ℝ) : ℝ := R[realRpow(Y, v) * realInvValue(v)]
proof
  typecheck

defgraph decaySlope (β : Real) (Y ∈ ℝ) : ℝ := R[-β * realExp(R[-(β * Y)])]
proof
  typecheck

theorem powerOver.has_derivative (v X : Real)
  requires positive : R[0] < X
  requires nonzero : v ≠ R[0]
  shows HasDerivativeAt(powerOver(v), rpowFunction(R[v - 1])(X), X)
proof
  have functionF := rpowFunction.function at v
  have functionG := powerOver.function at v
  have formula : ∀ Y ∈ ℝ, powerOver(v)(Y) = R[realInvValue(v) *
      rpowFunction(v)(Y)]
    intros Y yMember
    have typedY : Real(Y) by exact yMember
    rw [powerOver.value, rpowFunction.value]
    ring
  have scaled := HasDerivativeAt.scaled_value with functionF, functionG,
    formula, (rpowFunction.has_derivative with positive)
  apply HasDerivativeAt.congr_value with scaled
  rw rpowFunction.value
  have split := realRpow.add at X, v, R[-1] with positive
  have inverse := realRpow.neg at X, R[1] with positive
  rw (realRpow.one with positive) at inverse
  rw inverse at split
  rw split
  have cancel := realInvValue.mul_right with nonzero
  linear_combination (realRpow(X, v) * (1 / X)) * cancel

theorem expDecay.continuous_on (β : Real) (S : Set)
  requires subset : S ⊆ ℝ
  shows ContinuousOn(expDecay(β), S)
proof
  have function := expDecay.function at β
  apply ContinuousOn.of_differentiable with function, subset
  intros X xMember
  have typedX : Real(X) by exact (subset with X, xMember)
  exact HasDerivativeAt.differentiable_at with
    (expDecay.has_derivative at β, X)

theorem decaySlope.continuous_on (β : Real) (S : Set)
  requires subset : S ⊆ ℝ
  shows ContinuousOn(decaySlope(β), S)
proof
  have functionF := expDecay.function at β
  have functionG := decaySlope.function at β
  have formula : ∀ Y ∈ ℝ, decaySlope(β)(Y) = R[-β * expDecay(β)(Y)]
    intros Y yMember
    have typedY : Real(Y) by exact yMember
    rw [decaySlope.value, expDecay.value]
  apply ContinuousOn.of_differentiable with functionG, subset
  intros X xMember
  have typedX : Real(X) by exact (subset with X, xMember)
  exact HasDerivativeAt.differentiable_at with
    (HasDerivativeAt.scaled_value with functionF, functionG, formula,
      (expDecay.has_derivative at β, X))

theorem rpowFunction.continuous_on (S A B : Real)
  requires positive : R[0] < A
  shows ContinuousOn(rpowFunction(S), closedInterval(A, B))
proof
  have function := rpowFunction.function at S
  have subset : closedInterval(A, B) ⊆ ℝ
    intros X xMember
    exact (closedInterval.membership.forward with xMember).left
  apply ContinuousOn.of_differentiable with function, subset
  intros X xMember
  obtain ⟨xReal, low, _⟩ := closedInterval.membership.forward with xMember
  have typedX : Real(X) by exact xReal
  have xPositive : R[0] < X by linarith
  exact HasDerivativeAt.differentiable_at with
    (rpowFunction.has_derivative with xPositive)

theorem powerOver.continuous_on (v A B : Real)
  requires positive : R[0] < A
  requires nonzero : v ≠ R[0]
  shows ContinuousOn(powerOver(v), closedInterval(A, B))
proof
  have function := powerOver.function at v
  have subset : closedInterval(A, B) ⊆ ℝ
    intros X xMember
    exact (closedInterval.membership.forward with xMember).left
  apply ContinuousOn.of_differentiable with function, subset
  intros X xMember
  obtain ⟨xReal, low, _⟩ := closedInterval.membership.forward with xMember
  have typedX : Real(X) by exact xReal
  have xPositive : R[0] < X by linarith
  exact HasDerivativeAt.differentiable_at at powerOver(v),
    rpowFunction(R[v - 1])(X), X with
    (powerOver.has_derivative with xPositive, nonzero)

-- Integration by parts for ∫_A^T e^(−βy) y^(v−1) dy against y^v / v.
theorem expDecay.parts (β v A T : Real)
  requires positive : R[0] < A
  requires ordered : A ≤ T
  requires nonzero : v ≠ R[0]
  shows RiemannIntegrable(pointwiseMul(decaySlope(β), powerOver(v)), A, T) ∧
    RiemannIntegrable(pointwiseMul(expDecay(β), rpowFunction(R[v - 1])), A,
      T) ∧
    R[riemannIntegral(pointwiseMul(decaySlope(β), powerOver(v)), A, T) +
      riemannIntegral(pointwiseMul(expDecay(β), rpowFunction(R[v - 1])), A,
        T)] =
    R[expDecay(β)(T) * powerOver(v)(T) - expDecay(β)(A) * powerOver(v)(A)]
proof
  have subset : closedInterval(A, T) ⊆ ℝ
    intros X xMember
    exact (closedInterval.membership.forward with xMember).left
  have continuousU := expDecay.continuous_on at β, closedInterval(A, T) with
    subset
  have continuousDU := decaySlope.continuous_on at β, closedInterval(A, T)
    with subset
  have continuousV := powerOver.continuous_on at v, A, T with positive, nonzero
  have continuousDV := rpowFunction.continuous_on at R[v - 1], A, T with
    positive
  have functionDU := decaySlope.function at β
  have functionDV := rpowFunction.function at R[v - 1]
  have derivativeU : ∀ X ∈ ℝ, A < X → X < T →
      HasDerivativeAt(expDecay(β), decaySlope(β)(X), X)
    intros X xMember low high
    have typedX : Real(X) by exact xMember
    apply HasDerivativeAt.congr_value with (expDecay.has_derivative at β, X)
    rw [expDecay.value, decaySlope.value]
    ring
  have derivativeV : ∀ X ∈ ℝ, A < X → X < T →
      HasDerivativeAt(powerOver(v), rpowFunction(R[v - 1])(X), X)
    intros X xMember low high
    have typedX : Real(X) by exact xMember
    have xPositive : R[0] < X by linarith
    exact powerOver.has_derivative with xPositive, nonzero
  have first := ContinuousOn.integrable_interval with ordered,
    (ContinuousOn.mul with continuousDU, continuousV)
  have second := ContinuousOn.integrable_interval with ordered,
    (ContinuousOn.mul with continuousU, continuousDV)
  have parts := riemannIntegral.by_parts with ordered, functionDU, functionDV,
    continuousU, continuousV, derivativeU, derivativeV, first, second
  exact ⟨first, second, parts⟩

-- A complex function with real values integrates as its real part.
theorem ComplexRiemannIntegrable.of_real (g G : Set) (A B : Real)
  requires values : ComplexValuedOn(g, ℝ)
  requires function : FunctionBetween(G, ℝ, ℝ)
  requires real : ∀ X ∈ ℝ, g(X) = complexOfReal(G(X))
  requires ordered : A ≤ B
  requires integrable : RiemannIntegrable(G, A, B)
  shows ComplexRiemannIntegrable(g, A, B)
proof
  have functionRe := complexFunctionRe.function with values
  have functionIm := complexFunctionIm.function with values
  have zeroFunction := constantRealFunction.function at R[0]
  have reParts : complexFunctionRe(g) = G
    apply FunctionBetween.ext with functionRe, function
    intros X xMember
    have xReal : Real(X) by exact xMember
    have valueG := FunctionBetween.apply_closed with function, xMember
    have gReal : Real(G(X)) by exact valueG
    have valueX := real with X, xMember
    rw [(complexFunctionRe.apply with values), valueX, complexOfReal.re]
  have imParts : complexFunctionIm(g) = constantRealFunction(R[0])
    apply FunctionBetween.ext with functionIm, zeroFunction
    intros X xMember
    have valueG := FunctionBetween.apply_closed with function, xMember
    have valueX := real with X, xMember
    rw [(complexFunctionIm.apply with values), valueX, complexOfReal.im,
      constantRealFunction.value]
  have zeroIntegrable : RiemannIntegrable(constantRealFunction(R[0]), A, B)
    unfold constantRealFunction
    exact RiemannIntegrable.constant at A, B, R[0] with ordered
  refine ⟨values, ?_, ?_⟩
  . rw reParts
    exact integrable
  . rw imParts
    exact zeroIntegrable

-- The real Euler integrand t^v e^(−t), and (e^(−βy) − 1) y^(v−1).
def eulerReal (v : Real) : Set := pointwiseMul(rpowFunction(v), expDecay(R[1]))

defgraph eulerDifferenceReal (β v : Real) (Y ∈ ℝ) : ℝ :=
  R[(realExp(R[-(β * Y)]) - 1) * realRpow(Y, R[v - 1])]
proof
  typecheck

-- pointwiseMul(f, g)(x) = f(x) g(x) for real functions.
theorem pointwiseMul.apply (f g : Set) (X : Real)
  requires fFunction : f : ℝ → ℝ
  requires gFunction : g : ℝ → ℝ
  shows pointwiseMul(f, g)(X) = R[f(X) * g(X)]
proof
  have xMember : X ∈ ℝ by typecheck
  have fValue := FunctionBetween.apply_closed with fFunction, xMember
  have gValue := FunctionBetween.apply_closed with gFunction, xMember
  have fReal : Real(f(X)) by exact fValue
  have gReal : Real(g(X)) by exact gValue
  exact pointwiseMul.value with fFunction, gFunction, fReal, gReal

-- ∫_A^T (e^(−βy) − 1) y^(v−1) dy
--   = [(e^(−βy) − 1) y^v / v]_A^T + β^(−v)/v ∫_{βA}^{βT} t^v e^(−t) dt.
theorem mellinEuler.finite (β v A T : Real)
  requires positiveB : R[0] < β
  requires positive : R[0] < A
  requires ordered : A ≤ T
  requires nonzero : v ≠ R[0]
  shows ComplexRiemannIntegrable(mellinEulerIntegrand(β, v), A, T) ∧
    complexIntegral(mellinEulerIntegrand(β, v), A, T) = complexOfReal(
      R[(realExp(R[-(β * T)]) - 1) * realRpow(T, v) * realInvValue(v) -
        (realExp(R[-(β * A)]) - 1) * realRpow(A, v) * realInvValue(v) +
        realRpow(β, R[-v]) * realInvValue(v) *
          riemannIntegral(eulerReal(v), R[β * A], R[β * T])])
proof
  obtain ⟨firstIntegrable, secondIntegrable, parts⟩ := expDecay.parts at
    β, v, A, T with positive, ordered, nonzero
  -- The Euler integrand on [βA, βT].
  have scaledPositive := realLess.mul_left_of_positive with positive,
    positiveB
  have zeroProduct : R[β * 0] = R[0] by ring
  rw zeroProduct at scaledPositive
  have scaledOrdered := realLe.mul_left_of_nonnegative with ordered,
    (realLess.implies_le with positiveB)
  have subset : closedInterval(R[β * A], R[β * T]) ⊆ ℝ
    intros X xMember
    exact (closedInterval.membership.forward with xMember).left
  have eulerContinuous : ContinuousOn(eulerReal(v),
      closedInterval(R[β * A], R[β * T]))
    unfold eulerReal
    exact ContinuousOn.mul with (rpowFunction.continuous_on at v, R[β * A],
      R[β * T] with scaledPositive), (expDecay.continuous_on at R[1],
      closedInterval(R[β * A], R[β * T]) with subset)
  have eulerIntegrable := ContinuousOn.integrable_interval with scaledOrdered,
    eulerContinuous
  have eulerIntegral := riemannIntegral.integral with eulerIntegrable
  have shiftA : R[β * A + 0] = R[β * A] by ring
  have shiftT : R[β * T + 0] = R[β * T] by ring
  rw [← shiftA, ← shiftT] at eulerIntegral
  have substituted := HasRiemannIntegral.affine with positiveB, ordered,
    eulerIntegral
  rw [shiftA, shiftT] at substituted
  -- The first integral of the integration by parts, through t = βy.
  have eulerFunction : eulerReal(v) : ℝ → ℝ
    unfold eulerReal
    exact pointwiseMul.function with (rpowFunction.function at v),
      (expDecay.function at R[1])
  have affineFunction := affineCompose.function at eulerReal(v), β, R[0] with
    eulerFunction
  have slopeFunction := decaySlope.function at β
  have overFunction := powerOver.function at v
  have decayFunction := expDecay.function at β
  have rpowFunctionV := rpowFunction.function at R[v - 1]
  have firstFunction := pointwiseMul.function with slopeFunction, overFunction
  have betaPower := realRpow.real at β, R[-v]
  have inverseV := realInvValue.real at v
  have scaleReal : R[-β * realRpow(β, R[-v]) * realInvValue(v)] ∈ ℝ
    by typecheck
  have constantFunction := constantRealFunction.function at
    R[-β * realRpow(β, R[-v]) * realInvValue(v)]
  have scaledFunction := pointwiseMul.function with constantFunction,
    affineFunction
  have scaledValues : ∀ X ∈ ℝ, pointwiseMul(constantRealFunction(
      R[-β * realRpow(β, R[-v]) * realInvValue(v)]),
      affineCompose(eulerReal(v), β, R[0]))(X) =
      R[R[-β * realRpow(β, R[-v]) * realInvValue(v)] *
        affineCompose(eulerReal(v), β, R[0])(X) +
        0 * affineCompose(eulerReal(v), β, R[0])(X)]
    intros X xMember
    have typedX : Real(X) by exact xMember
    have value := FunctionBetween.apply_closed with affineFunction, xMember
    have valueReal : Real(affineCompose(eulerReal(v), β, R[0])(X))
      by exact value
    rw [(pointwiseMul.apply with constantFunction, affineFunction),
      constantRealFunction.value]
    ring
  have scaledIntegral := HasRiemannIntegral.linear with substituted,
    substituted, scaledFunction, scaledValues
  have firstAgree : ∀ X ∈ ℝ, A < X → X < T →
      pointwiseMul(decaySlope(β), powerOver(v))(X) =
      pointwiseMul(constantRealFunction(R[-β * realRpow(β, R[-v]) *
        realInvValue(v)]), affineCompose(eulerReal(v), β, R[0]))(X)
    intros X xMember low high
    have typedX : Real(X) by exact xMember
    have xPositive : R[0] < X by linarith
    have argument : R[β * X + 0] ∈ ℝ by typecheck
    have same : R[β * X + 0] = R[β * X] by ring
    rw [(pointwiseMul.apply with slopeFunction, overFunction),
      (pointwiseMul.apply with constantFunction, affineFunction),
      constantRealFunction.value, (affineCompose.value at eulerReal(v), β,
      R[0], X with eulerFunction, xMember), same, decaySlope.value,
      powerOver.value]
    unfold eulerReal
    rw [(pointwiseMul.apply with (rpowFunction.function at v),
      (expDecay.function at R[1])), rpowFunction.value, expDecay.value,
      (realRpow.mul_base with positiveB, xPositive)]
    have cancel := realRpow.add at β, R[-v], v with positiveB
    have exponent : R[-v + v] = R[0] by ring
    rw [exponent, realRpow.zero] at cancel
    have power := realRpow.real at X, v
    have powerB := realRpow.real at β, v
    have exponential : R[-(R[1] * (β * X))] = R[-(β * X)] by ring
    rw exponential
    linear_combination (-β * realRpow(X, v) * realExp(R[-(β * X)]) *
      realInvValue(v)) * cancel
  have firstIntegral := HasRiemannIntegral.congr_interior with scaledIntegral,
    firstFunction, firstAgree
  have firstValue := riemannIntegral.eq_of_integral with firstIntegral
  -- ∫_A^T y^(v−1) = (T^v − A^v)/v.
  have exponentNonzero : R[1 - R[1 - v]] ≠ R[0]
    intro zero
    apply nonzero
    linarith
  have rpowIntegral := rpowFunction.has_integral at A, T, R[1 - v] with
    positive, ordered, exponentNonzero
  have negated : R[-R[1 - v]] = R[v - 1] by ring
  have simplified : R[1 + R[v - 1]] = v by ring
  rw [negated, simplified] at rpowIntegral
  have rpowValue := riemannIntegral.eq_of_integral with rpowIntegral
  have rpowIntegrable : RiemannIntegrable(rpowFunction(R[v - 1]), A, T)
    have valueReal : R[realInvValue(v) * realRpow(T, v) -
      realInvValue(v) * realRpow(A, v)] ∈ ℝ by typecheck
    exact ⟨R[realInvValue(v) * realRpow(T, v) -
      realInvValue(v) * realRpow(A, v)], valueReal, rpowIntegral⟩
  -- The integrand (e^(−βy) − 1) y^(v−1) as a combination.
  have secondFunction := pointwiseMul.function with decayFunction,
    rpowFunctionV
  have differenceFunction := eulerDifferenceReal.function at β, v
  have differenceValues : ∀ X ∈ ℝ, eulerDifferenceReal(β, v)(X) =
      R[1 * pointwiseMul(expDecay(β), rpowFunction(R[v - 1]))(X) +
        -1 * rpowFunction(R[v - 1])(X)]
    intros X xMember
    have typedX : Real(X) by exact xMember
    rw [eulerDifferenceReal.value, (pointwiseMul.apply with decayFunction,
      rpowFunctionV), expDecay.value, rpowFunction.value]
    ring
  obtain ⟨differenceIntegrable, differenceValue⟩ := riemannIntegral.linear
    with secondIntegrable, rpowIntegrable, differenceFunction,
    differenceValues
  have eulerValues : ComplexValuedOn(mellinEulerIntegrand(β, v), ℝ)
    intros X hX
    exact FunctionBetween.apply_closed with (mellinEulerIntegrand.function at
      β, v), hX
  have real : ∀ X ∈ ℝ, mellinEulerIntegrand(β, v)(X) =
      complexOfReal(eulerDifferenceReal(β, v)(X))
    intros X xMember
    rw [(mellinEulerIntegrand.value at β, v, X with xMember),
      (eulerDifferenceReal.value at β, v, X with xMember)]
  have complexIntegrable := ComplexRiemannIntegrable.of_real with eulerValues,
    differenceFunction, real, ordered, differenceIntegrable
  have complexValue := complexIntegral.of_real at mellinEulerIntegrand(β, v),
    eulerDifferenceReal(β, v), A, T with eulerValues, differenceFunction, real
  refine ⟨complexIntegrable, ?_⟩
  rw [complexValue, differenceValue]
  have betaNonzero : β ≠ R[0] by linarith
  have betaInverse := realInvValue.mul_right with betaNonzero
  obtain ⟨i1, _⟩ := riemannIntegral.selected at pointwiseMul(decaySlope(β),
    powerOver(v)), A, T
  obtain ⟨i2, _⟩ := riemannIntegral.selected at pointwiseMul(expDecay(β),
    rpowFunction(R[v - 1])), A, T
  obtain ⟨i3, _⟩ := riemannIntegral.selected at rpowFunction(R[v - 1]), A, T
  obtain ⟨i4, _⟩ := riemannIntegral.selected at eulerReal(v), R[β * A],
    R[β * T]
  rw [expDecay.value, expDecay.value, powerOver.value, powerOver.value] at
    parts
  have powerT := realRpow.real at T, v
  have powerA := realRpow.real at A, v
  have expT := realExp.real at R[-(β * T)]
  have expA := realExp.real at R[-(β * A)]
  have equal : R[1 * riemannIntegral(pointwiseMul(expDecay(β),
      rpowFunction(R[v - 1])), A, T) + -1 * riemannIntegral(rpowFunction(
      R[v - 1]), A, T)] =
      R[(realExp(R[-(β * T)]) - 1) * realRpow(T, v) * realInvValue(v) -
        (realExp(R[-(β * A)]) - 1) * realRpow(A, v) * realInvValue(v) +
        realRpow(β, R[-v]) * realInvValue(v) *
          riemannIntegral(eulerReal(v), R[β * A], R[β * T])]
    linear_combination parts - firstValue - rpowValue +
      (realRpow(β, R[-v]) * realInvValue(v) *
        riemannIntegral(eulerReal(v), R[β * A], R[β * T])) * betaInverse
  rw equal

-- Small positive bases give small positive powers.
theorem realRpow.small_base (P E : Real)
  requires positiveP : R[0] < P
  requires positiveE : R[0] < E
  shows ∃ d ∈ ℝ, R[0] < d ∧ ∀ A ∈ ℝ, R[0] < A → A < d → realRpow(A, P) < E
proof
  have inverse := realInvValue.positive with positiveP
  have nonzero : P ≠ R[0] by linarith
  have cancel := realInvValue.mul_right with nonzero
  witness realRpow(E, realInvValue(P))
  have dReal := realRpow.real at E, realInvValue(P)
  have dPositive := realRpow.positive at E, realInvValue(P)
  refine ⟨dReal, dPositive, ?_⟩
  intros A aMember positive below
  have typedA : Real(A) by exact aMember
  have smaller := realRpow.lt_of_base with positive, below, positiveP
  rw (realRpow.mul_exponent with positiveE) at smaller
  have exponent : R[realInvValue(P) * P] = R[1]
    linear_combination cancel
  rw [exponent, (realRpow.one with positiveE)] at smaller
  exact smaller

-- A real v with −1 < v < 0 is not a pole of Γ.
theorem gammaDomain.of_real_between (v : Real)
  requires lower : R[-1] < v
  requires upper : v < R[0]
  shows complexOfReal(v) ∈ gammaDomain
proof
  have member : complexOfReal(v) ∈ ℂ by typecheck
  unfold gammaDomain
  apply difference.membership.backward
  refine ⟨member, ?_⟩
  intro pole
  unfold gammaPoles at pole
  obtain ⟨_, n, nMember, same⟩ := pole
  have typedN := nat.omega.backward with nMember
  rw ← complexOfReal.neg at same
  have equal := complexOfReal.injective with same
  have nonnegative := realNat.nonnegative at n
  by_cases zero : n = (0:N)
  . rw [zero, realNat.zero] at equal
    linarith
  . have positiveN : 1 ≤ n by arith
    have large := realNat.one_le with positiveN
    linarith

-- |e^(−x) − 1| ≤ x for x ≥ 0, and ≤ 1.
theorem expDecay.difference_bounds (X : Real)
  requires nonnegative : R[0] ≤ X
  shows abs(R[realExp(R[-X]) - 1]) ≤ X ∧ abs(R[realExp(R[-X]) - 1]) ≤ R[1]
proof
  have lower := realExp.one_add_le at R[-X]
  have nonpositive : R[-X] ≤ R[0] by linarith
  have upper := realExp.monotone with nonpositive
  rw realExp.zero at upper
  have positive := realExp.positive at R[-X]
  have negative : R[realExp(R[-X]) - 1] ≤ R[0] by linarith
  have absolute := abs.of_nonpositive with negative
  rw absolute
  refine ⟨?_, ?_⟩
  . linarith
  . linarith

-- At real s = v + 1 the Euler integrand is t^v e^(−t).
theorem eulerIntegrand.real (v X : Real)
  shows eulerIntegrand(complexOfReal(R[v + 1]))(X) =
    complexOfReal(eulerReal(v)(X))
proof
  have member : complexOfReal(R[v + 1]) ∈ ℂ by typecheck
  have xMember : X ∈ ℝ by typecheck
  have exponent : ℂ[complexOfReal(R[v + 1]) - 1] = complexOfReal(v)
    rw [complexOfReal.add, complexOfReal.one]
    ring
  unfold eulerReal
  rw [(eulerIntegrand.value with member, xMember), exponent,
    realCpow.of_real, (pointwiseMul.apply with (rpowFunction.function at v),
    (expDecay.function at R[1])), rpowFunction.value, expDecay.value,
    complexOfReal.mul]
  have same : R[-X] = R[-(1 * X)] by ring
  rw same

theorem eulerIntegrand.values (s : Set)
  requires hs : s ∈ ℂ
  shows ComplexValuedOn(eulerIntegrand(s), ℝ)
proof
  intros X hX
  exact FunctionBetween.apply_closed with (eulerIntegrand.function with hs),
    hX

-- The improper integral of (e^(−βy) − 1) y^(v−1) over [A, ∞), from the
-- improper Euler integral over [βA, ∞).
theorem mellinEuler.improper (β v A : Real) (I : Set)
  requires positiveB : R[0] < β
  requires positive : R[0] < A
  requires upper : v < R[0]
  requires integral : HasComplexImproperIntegral(
    eulerIntegrand(complexOfReal(R[v + 1])), R[β * A], I)
  shows HasComplexImproperIntegral(mellinEulerIntegrand(β, v), A,
    ℂ[complexOfReal(R[-((realExp(R[-(β * A)]) - 1) * realRpow(A, v) *
      realInvValue(v))]) +
      complexOfReal(R[realRpow(β, R[-v]) * realInvValue(v)]) * I])
proof
  obtain ⟨eulerValues, iMember, _, eulerLimit⟩ := integral
  have nonzero : v ≠ R[0] by linarith
  have values : ComplexValuedOn(mellinEulerIntegrand(β, v), ℝ)
    intros X hX
    exact FunctionBetween.apply_closed with (mellinEulerIntegrand.function at
      β, v), hX
  have jMember : ℂ[complexOfReal(R[-((realExp(R[-(β * A)]) - 1) *
      realRpow(A, v) * realInvValue(v))]) +
      complexOfReal(R[realRpow(β, R[-v]) * realInvValue(v)]) * I] ∈ ℂ
    by typecheck
  refine ⟨values, jMember, ?_, ?_⟩
  . intros T tMember later
    have typedT : Real(T) by exact tMember
    exact (mellinEuler.finite with positiveB, positive, later, nonzero).left
  intros e eReal ePositive
  have halfPositive := half.positive with ePositive
  have halves := half.add_self at e
  have inverseV := realInvValue.mul_right with nonzero
  have inverseNegative : R[0] < R[-realInvValue(v)]
    by_contra notNegative
    have nonnegative : R[0] ≤ realInvValue(v) by linarith
    have vNonpositive : v ≤ R[0] by linarith
    have product := realLe.mul_right_of_nonnegative with vNonpositive,
      nonnegative
    have zeroProduct : R[0 * realInvValue(v)] = R[0] by ring
    linarith
  have betaPower := realRpow.positive at β, R[-v]
  have kPositive := realLess.mul_left_of_positive with inverseNegative,
    betaPower
  have zeroK : R[realRpow(β, R[-v]) * 0] = R[0] by ring
  rw zeroK at kPositive
  have kNonzero : R[realRpow(β, R[-v]) * -realInvValue(v)] ≠ R[0] by linarith
  have kInverse := realInvValue.mul_right with kNonzero
  have kInversePositive := realInvValue.positive with kPositive
  -- T^v is eventually below e/2 · (−v).
  have negativeV : R[0] < R[-v] by linarith
  have smallReal : R[half(e) * -v] ∈ ℝ by typecheck
  have smallPositive := realLess.mul_left_of_positive with negativeV,
    halfPositive
  have zeroHalf : R[half(e) * 0] = R[0] by ring
  rw zeroHalf at smallPositive
  obtain ⟨M, mReal, _, powerSmall⟩ := realRpow.eventually_small with
    negativeV, smallPositive
  -- The Euler integral is eventually within e/(2K) of I.
  have e2Real : R[half(e) * realInvValue(R[realRpow(β, R[-v]) *
    -realInvValue(v)])] ∈ ℝ by typecheck
  have e2Positive := realLess.mul_left_of_positive with kInversePositive,
    halfPositive
  rw zeroHalf at e2Positive
  obtain ⟨T1, t1Real, eulerClose⟩ := eulerLimit with R[half(e) *
    realInvValue(R[realRpow(β, R[-v]) * -realInvValue(v)])], e2Real,
    e2Positive
  have typedT1 : Real(T1) by exact t1Real
  obtain ⟨T0, t0Real, aboveM, aboveT1⟩ := realBound.common_upper at M,
    R[T1 * realInvValue(β)]
  witness T0
  refine ⟨t0Real, ?_⟩
  intros T tReal later laterA
  have typedT : Real(T) by exact tReal
  have betaNonzero : β ≠ R[0] by linarith
  have betaInverse := realInvValue.mul_right with betaNonzero
  have nonnegativeB : R[0] ≤ β by linarith
  have t1Le : R[T1 * realInvValue(β)] ≤ T by linarith
  have scaledLater := realLe.mul_left_of_nonnegative with t1Le, nonnegativeB
  have scaledLaterA := realLe.mul_left_of_nonnegative with laterA,
    nonnegativeB
  have betaT1 : R[β * (T1 * realInvValue(β))] = T1
    linear_combination T1 * betaInverse
  have eulerLater : T1 ≤ R[β * T] by linarith
  have betaTReal : R[β * T] ∈ ℝ by typecheck
  have eulerNear := eulerClose with R[β * T], betaTReal, eulerLater,
    scaledLaterA
  obtain ⟨_, finiteValue⟩ := mellinEuler.finite with positiveB, positive,
    laterA, nonzero
  have eulerFunction : eulerReal(v) : ℝ → ℝ
    unfold eulerReal
    exact pointwiseMul.function with (rpowFunction.function at v),
      (expDecay.function at R[1])
  have eulerReals : ∀ X ∈ ℝ, eulerIntegrand(complexOfReal(R[v + 1]))(X) =
      complexOfReal(eulerReal(v)(X))
    intros X xMember
    have typedX : Real(X) by exact xMember
    exact eulerIntegrand.real at v, X
  have eulerOfReal := complexIntegral.of_real at
    eulerIntegrand(complexOfReal(R[v + 1])), eulerReal(v), R[β * A],
    R[β * T] with eulerValues, eulerFunction, eulerReals
  obtain ⟨rMember, _⟩ := riemannIntegral.selected at eulerReal(v), R[β * A],
    R[β * T]
  have expT := realExp.real at R[-(β * T)]
  have expA := realExp.real at R[-(β * A)]
  have powerT := realRpow.real at T, v
  have powerA := realRpow.real at A, v
  have inverseReal := realInvValue.real at v
  rw [finiteValue, (complexOfReal.add at R[(realExp(R[-(β * T)]) - 1) *
    realRpow(T, v) * realInvValue(v) - (realExp(R[-(β * A)]) - 1) *
    realRpow(A, v) * realInvValue(v)], R[realRpow(β, R[-v]) *
    realInvValue(v) * riemannIntegral(eulerReal(v), R[β * A], R[β * T])]),
    (complexOfReal.sub at R[(realExp(R[-(β * T)]) - 1) * realRpow(T, v) *
    realInvValue(v)], R[(realExp(R[-(β * A)]) - 1) * realRpow(A, v) *
    realInvValue(v)]), (complexOfReal.mul at R[realRpow(β, R[-v]) *
    realInvValue(v)], riemannIntegral(eulerReal(v), R[β * A], R[β * T])),
    (complexOfReal.neg at R[(realExp(R[-(β * A)]) - 1) * realRpow(A, v) *
    realInvValue(v)]), ← eulerOfReal]
  have tPart : complexOfReal(R[(realExp(R[-(β * T)]) - 1) * realRpow(T, v) *
    realInvValue(v)]) ∈ ℂ by typecheck
  have kPart : complexOfReal(R[realRpow(β, R[-v]) * realInvValue(v)]) ∈ ℂ
    by typecheck
  have eulerMember := complexIntegral.member at
    eulerIntegrand(complexOfReal(R[v + 1])), R[β * A], R[β * T]
  have aPart : complexOfReal(R[(realExp(R[-(β * A)]) - 1) * realRpow(A, v) *
    realInvValue(v)]) ∈ ℂ by typecheck
  have gap : ℂ[complexIntegral(eulerIntegrand(complexOfReal(R[v + 1])),
    R[β * A], R[β * T]) - I] ∈ ℂ by typecheck
  have regroup : ℂ[complexOfReal(R[(realExp(R[-(β * T)]) - 1) *
      realRpow(T, v) * realInvValue(v)]) - complexOfReal(R[(realExp(
      R[-(β * A)]) - 1) * realRpow(A, v) * realInvValue(v)]) +
      complexOfReal(R[realRpow(β, R[-v]) * realInvValue(v)]) *
      complexIntegral(eulerIntegrand(complexOfReal(R[v + 1])), R[β * A],
      R[β * T]) - (-complexOfReal(R[(realExp(R[-(β * A)]) - 1) *
      realRpow(A, v) * realInvValue(v)]) + complexOfReal(R[realRpow(β, R[-v]) *
      realInvValue(v)]) * I)] =
      ℂ[complexOfReal(R[(realExp(R[-(β * T)]) - 1) * realRpow(T, v) *
        realInvValue(v)]) + complexOfReal(R[realRpow(β, R[-v]) *
        realInvValue(v)]) * (complexIntegral(eulerIntegrand(complexOfReal(
        R[v + 1])), R[β * A], R[β * T]) - I)] by ring
  rw regroup
  have scaledGap : ℂ[complexOfReal(R[realRpow(β, R[-v]) * realInvValue(v)]) *
    (complexIntegral(eulerIntegrand(complexOfReal(R[v + 1])), R[β * A],
    R[β * T]) - I)] ∈ ℂ by typecheck
  have triangle := complexAbs.triangle with tPart, scaledGap
  -- The boundary term at T.
  have betaAPositive := realLess.mul_left_of_positive with positive, positiveB
  have zeroBA : R[β * 0] = R[0] by ring
  have betaTNonnegative : R[0] ≤ R[β * T] by linarith
  obtain ⟨_, expBound⟩ := expDecay.difference_bounds with betaTNonnegative
  have powerPositive := realRpow.positive at T, v
  have inverseNonpositive : realInvValue(v) ≤ R[0] by linarith
  rw [complexAbs.of_real, abs.mul, abs.mul, (abs.of_nonnegative with
    (realLess.implies_le with powerPositive)), (abs.of_nonpositive with
    inverseNonpositive)] at triangle
  have mLe : M ≤ T by linarith
  have small := powerSmall with T, tReal, mLe
  have doubleNeg : R[-R[-v]] = v by ring
  rw doubleNeg at small
  have scaledSmall := realLess.mul_left_of_positive with small, inverseNegative
  have collapse : R[-realInvValue(v) * (half(e) * -v)] = half(e)
    linear_combination half(e) * inverseV
  have absNonnegative := abs.nonnegative at R[realExp(R[-(β * T)]) - 1]
  have productNonnegative : R[0] ≤ R[realRpow(T, v) * -realInvValue(v)]
    have p := realLe.mul_right_of_nonnegative with (realLess.implies_le with
      powerPositive), (realLess.implies_le with inverseNegative)
    have zeroP : R[0 * -realInvValue(v)] = R[0] by ring
    linarith
  have firstBound := realLe.mul_right_of_nonnegative with expBound,
    productNonnegative
  have reshape : R[abs(R[realExp(R[-(β * T)]) - 1]) * realRpow(T, v) *
      -realInvValue(v)] = R[abs(R[realExp(R[-(β * T)]) - 1]) *
      (realRpow(T, v) * -realInvValue(v))] by ring
  have reshape2 : R[1 * (realRpow(T, v) * -realInvValue(v))] =
    R[-realInvValue(v) * realRpow(T, v)] by ring
  -- The Euler term.
  rw [(complexAbs.mul with kPart, gap), complexAbs.of_real, abs.mul,
    (abs.of_nonnegative with (realLess.implies_le with betaPower)),
    (abs.of_nonpositive with inverseNonpositive)] at triangle
  have gapBound := realLess.mul_left_of_positive with eulerNear, kPositive
  have collapseK : R[R[realRpow(β, R[-v]) * -realInvValue(v)] * (half(e) *
      realInvValue(R[realRpow(β, R[-v]) * -realInvValue(v)]))] = half(e)
    linear_combination half(e) * kInverse
  linarith

theorem realInvValue.negative (V : Real)
  requires negative : V < R[0]
  shows realInvValue(V) < R[0]
proof
  have nonzero : V ≠ R[0] by linarith
  have inverse := realInvValue.mul_right with nonzero
  by_contra notNegative
  have nonnegative : R[0] ≤ realInvValue(V) by linarith
  have vNonpositive : V ≤ R[0] by linarith
  have product := realLe.mul_right_of_nonnegative with vNonpositive,
    nonnegative
  have zeroProduct : R[0 * realInvValue(V)] = R[0] by ring
  linarith

-- Cauchy–Saalschütz: for −1 < v < 0 and β > 0,
-- ∫_0^∞ (e^(−βy) − 1) y^(v−1) dy = β^(−v) Γ(v).
theorem mellinEuler.singular (β v : Real)
  requires positiveB : R[0] < β
  requires lower : R[-1] < v
  requires upper : v < R[0]
  shows HasSingularIntegral(mellinEulerIntegrand(β, v),
    ℂ[complexOfReal(realRpow(β, R[-v])) * Gamma(complexOfReal(v))])
proof
  have hs : complexOfReal(R[v + 1]) ∈ ℂ by typecheck
  have positiveRe : realZero < complexRe(complexOfReal(R[v + 1]))
    rw complexOfReal.re
    linarith
  have euler := Gamma.euler_integral with hs, positiveRe
  have domain := gammaDomain.of_real_between with lower, upper
  have succ := Gamma.succ with domain
  have shift : ℂ[complexOfReal(v) + 1] = complexOfReal(R[v + 1])
    rw [complexOfReal.add, complexOfReal.one]
  rw shift at succ
  have gammaMember := Gamma.member at complexOfReal(v)
  have targetMember : ℂ[complexOfReal(realRpow(β, R[-v])) *
    Gamma(complexOfReal(v))] ∈ ℂ by typecheck
  refine ⟨targetMember, ?_⟩
  intros e eReal ePositive
  have halfPositive := half.positive with ePositive
  have halves := half.add_self at e
  have zeroHalf : R[half(e) * 0] = R[0] by ring
  have nonzero : v ≠ R[0] by linarith
  have inverseV := realInvValue.mul_right with nonzero
  have inverseNegative := realInvValue.negative with upper
  have minusInverse : R[0] < R[-realInvValue(v)] by linarith
  have betaPower := realRpow.positive at β, R[-v]
  have kPositive := realLess.mul_left_of_positive with minusInverse, betaPower
  have zeroK : R[realRpow(β, R[-v]) * 0] = R[0] by ring
  rw zeroK at kPositive
  have kNonzero : R[realRpow(β, R[-v]) * -realInvValue(v)] ≠ R[0] by linarith
  have kInverse := realInvValue.mul_right with kNonzero
  have kInversePositive := realInvValue.positive with kPositive
  -- The Euler integral within e/(2K) of Γ(v + 1).
  have e1Real : R[half(e) * realInvValue(R[realRpow(β, R[-v]) *
    -realInvValue(v)])] ∈ ℝ by typecheck
  have e1Positive := realLess.mul_left_of_positive with kInversePositive,
    halfPositive
  rw zeroHalf at e1Positive
  obtain ⟨d1, d1Real, d1Positive, eulerNear⟩ := euler with R[half(e) *
    realInvValue(R[realRpow(β, R[-v]) * -realInvValue(v)])], e1Real,
    e1Positive
  -- A^(v+1) below e/(2β(−1/v)).
  have lPositive := realLess.mul_left_of_positive with minusInverse,
    positiveB
  have zeroL : R[β * 0] = R[0] by ring
  rw zeroL at lPositive
  have lNonzero : R[β * -realInvValue(v)] ≠ R[0] by linarith
  have lInverse := realInvValue.mul_right with lNonzero
  have lInversePositive := realInvValue.positive with lPositive
  have e3Positive := realLess.mul_left_of_positive with lInversePositive,
    halfPositive
  rw zeroHalf at e3Positive
  have exponentPositive : R[0] < R[v + 1] by linarith
  obtain ⟨d2, d2Real, d2Positive, powerSmall⟩ := realRpow.small_base with
    exponentPositive, e3Positive
  have betaNonzero : β ≠ R[0] by linarith
  have betaInverse := realInvValue.mul_right with betaNonzero
  have betaInversePositive := realInvValue.positive with positiveB
  have d1Scaled := realLess.mul_left_of_positive with d1Positive,
    betaInversePositive
  have zeroB : R[realInvValue(β) * 0] = R[0] by ring
  rw zeroB at d1Scaled
  obtain ⟨d, dReal, dPositive, below1, below2⟩ := realPositive.common_lower
    with d1Scaled, d2Positive
  witness d
  refine ⟨dReal, dPositive, ?_⟩
  intros A aReal positive below
  have typedA : Real(A) by exact aReal
  have belowD1 : A < R[realInvValue(β) * d1] by linarith
  have scaledBelow := realLess.mul_left_of_positive with belowD1, positiveB
  have cancelD : R[β * (realInvValue(β) * d1)] = d1
    linear_combination d1 * betaInverse
  have betaAReal : R[β * A] ∈ ℝ by typecheck
  have betaAPositive := realLess.mul_left_of_positive with positive, positiveB
  rw zeroL at betaAPositive
  have betaABelow : R[β * A] < d1 by linarith
  obtain ⟨I, iMember, integralI, closeI⟩ := eulerNear with R[β * A],
    betaAReal, betaAPositive, betaABelow
  have improper := mellinEuler.improper with positiveB, positive, upper,
    integralI
  have jMember : ℂ[complexOfReal(R[-((realExp(R[-(β * A)]) - 1) *
      realRpow(A, v) * realInvValue(v))]) +
      complexOfReal(R[realRpow(β, R[-v]) * realInvValue(v)]) * I] ∈ ℂ
    by typecheck
  refine ⟨ℂ[complexOfReal(R[-((realExp(R[-(β * A)]) - 1) *
      realRpow(A, v) * realInvValue(v))]) +
      complexOfReal(R[realRpow(β, R[-v]) * realInvValue(v)]) * I], jMember,
    improper, ?_⟩
  -- J − β^(−v) Γ(v) = −X_A + K' (I − Γ(v + 1)).
  have powerA := realRpow.real at A, v
  have expA := realExp.real at R[-(β * A)]
  have inverseReal := realInvValue.real at v
  have betaPowerReal := realRpow.real at β, R[-v]
  have gammaS := Gamma.member at complexOfReal(R[v + 1])
  have kv : ℂ[complexOfReal(R[realRpow(β, R[-v]) * realInvValue(v)]) *
      complexOfReal(v)] = complexOfReal(realRpow(β, R[-v]))
    rw ← complexOfReal.mul
    have same : R[realRpow(β, R[-v]) * realInvValue(v) * v] =
        realRpow(β, R[-v])
      linear_combination realRpow(β, R[-v]) * inverseV
    rw same
  have xPart : complexOfReal(R[-((realExp(R[-(β * A)]) - 1) *
    realRpow(A, v) * realInvValue(v))]) ∈ ℂ by typecheck
  have kPart : complexOfReal(R[realRpow(β, R[-v]) * realInvValue(v)]) ∈ ℂ
    by typecheck
  have vPart : complexOfReal(v) ∈ ℂ by typecheck
  have gap : ℂ[I - Gamma(complexOfReal(R[v + 1]))] ∈ ℂ by typecheck
  have regroup : ℂ[complexOfReal(R[-((realExp(R[-(β * A)]) - 1) *
      realRpow(A, v) * realInvValue(v))]) +
      complexOfReal(R[realRpow(β, R[-v]) * realInvValue(v)]) * I -
      complexOfReal(realRpow(β, R[-v])) * Gamma(complexOfReal(v))] =
      ℂ[complexOfReal(R[-((realExp(R[-(β * A)]) - 1) *
      realRpow(A, v) * realInvValue(v))]) +
      complexOfReal(R[realRpow(β, R[-v]) * realInvValue(v)]) *
        (I - Gamma(complexOfReal(R[v + 1])))]
    rw succ
    linear_combination Gamma(complexOfReal(v)) * kv
  rw regroup
  have scaledGap : ℂ[complexOfReal(R[realRpow(β, R[-v]) * realInvValue(v)]) *
    (I - Gamma(complexOfReal(R[v + 1])))] ∈ ℂ by typecheck
  have triangle := complexAbs.triangle with xPart, scaledGap
  have inverseNonpositive : realInvValue(v) ≤ R[0] by linarith
  rw [(complexAbs.mul with kPart, gap), complexAbs.of_real, abs.neg, abs.mul,
    abs.mul, (abs.of_nonnegative with (realLess.implies_le with
    (realRpow.positive at A, v))), (abs.of_nonpositive with
    inverseNonpositive)] at triangle
  rw [complexAbs.of_real, abs.mul, (abs.of_nonnegative with
    (realLess.implies_le with betaPower)), (abs.of_nonpositive with
    inverseNonpositive)] at triangle
  -- The boundary term at A: |e^(−βA) − 1| ≤ βA.
  have betaANonnegative : R[0] ≤ R[β * A] by linarith
  obtain ⟨expBound, _⟩ := expDecay.difference_bounds with betaANonnegative
  have productNonnegative : R[0] ≤ R[realRpow(A, v) * -realInvValue(v)]
    have p := realLe.mul_right_of_nonnegative with (realLess.implies_le with
      (realRpow.positive at A, v)), (realLess.implies_le with minusInverse)
    have zeroP : R[0 * -realInvValue(v)] = R[0] by ring
    linarith
  have firstBound := realLe.mul_right_of_nonnegative with expBound,
    productNonnegative
  have split := realRpow.add at A, v, R[1] with positive
  rw (realRpow.one with positive) at split
  have belowD2 : A < d2 by linarith
  have small := powerSmall with A, aReal, positive, belowD2
  rw split at small
  have scaledSmall := realLess.mul_left_of_positive with small, lPositive
  have collapseL : R[R[β * -realInvValue(v)] * (half(e) *
      realInvValue(R[β * -realInvValue(v)]))] = half(e)
    linear_combination half(e) * lInverse
  have reshape : R[R[β * A] * (realRpow(A, v) * -realInvValue(v))] =
    R[R[β * -realInvValue(v)] * (realRpow(A, v) * A)] by ring
  have gapBound := realLess.mul_left_of_positive with closeI, kPositive
  have collapseK : R[R[realRpow(β, R[-v]) * -realInvValue(v)] * (half(e) *
      realInvValue(R[realRpow(β, R[-v]) * -realInvValue(v)]))] = half(e)
    linear_combination half(e) * kInverse
  have reshapeX : R[abs(R[realExp(R[-(β * A)]) - 1]) * realRpow(A, v) *
      -realInvValue(v)] = R[abs(R[realExp(R[-(β * A)]) - 1]) *
      (realRpow(A, v) * -realInvValue(v))] by ring
  linarith

-- |(e^(iβx) − 1) x^(v−1)| ≤ 2 x^(v−1) for x > 0.
theorem mellinExpIntegrand.abs_le (β v X : Real)
  requires positive : R[0] < X
  shows complexAbs(mellinExpIntegrand(β, v)(X)) ≤
    R[2 * realRpow(X, R[v - 1])]
proof
  have xMember : X ∈ ℝ by typecheck
  have iMember := complexImaginaryUnit.member
  have argument : ℂ[complexImaginaryUnit * complexOfReal(R[β * X])] ∈ ℂ
    by typecheck
  have wave := complexExp.member with argument
  have one : ℂ[1] ∈ ℂ by typecheck
  have difference : ℂ[complexExp(complexImaginaryUnit *
    complexOfReal(R[β * X])) - 1] ∈ ℂ by typecheck
  have power : complexOfReal(realRpow(X, R[v - 1])) ∈ ℂ by typecheck
  rw [(mellinExpIntegrand.value at β, v, X with xMember),
    (complexAbs.mul with difference, power), complexAbs.of_real,
    (abs.of_nonnegative with (realLess.implies_le with
    (realRpow.positive at X, R[v - 1])))]
  have triangle := complexAbs.sub_le with wave, one
  rw [complexExp.abs_i_mul, complexAbs.one] at triangle
  have nonnegative := complexAbs.nonnegative with difference
  have bound := realLe.mul_right_of_nonnegative with triangle,
    (realLess.implies_le with (realRpow.positive at X, R[v - 1]))
  have two : R[R[1 + 1] * realRpow(X, R[v - 1])] =
    R[2 * realRpow(X, R[v - 1])] by ring
  linarith

-- The improper integral of (e^(iβx) − 1) x^(v−1) over [A, ∞) exists for
-- A > 0 and v < 0.
theorem mellinExpIntegrand.improper (β v A : Real)
  requires positive : R[0] < A
  requires upper : v < R[0]
  shows ComplexImproperIntegrable(mellinExpIntegrand(β, v), A)
proof
  have exponent : R[1] < R[1 - v] by linarith
  have local : ∀ T ∈ ℝ, A ≤ T →
      ComplexRiemannIntegrable(mellinExpIntegrand(β, v), A, T)
    intros T tMember later
    have typedT : Real(T) by exact tMember
    exact (mellin.axes at β, v, A, T with positive, later).left
  have bound : ∀ X ∈ ℝ, A ≤ X → complexAbs(mellinExpIntegrand(β, v)(X)) ≤
      R[2 * realRpow(X, R[-R[1 - v]])]
    intros X xMember later
    have typedX : Real(X) by exact xMember
    have xPositive : R[0] < X by linarith
    have same : R[-R[1 - v]] = R[v - 1] by ring
    rw same
    exact mellinExpIntegrand.abs_le with xPositive
  exact (ComplexImproperIntegrable.of_rpow_bound with positive, exponent,
    local, bound).left

-- For −1 < v < 0 and β > 0, ∫_0^∞ (e^(iβx) − 1) x^(v−1) dx
-- = e^(iπv/2) β^(−v) Γ(v): Cauchy's theorem moves the integral to the
-- imaginary axis, where it is the Cauchy–Saalschütz integral.
theorem mellin.exp (β v : Real)
  requires positiveB : R[0] < β
  requires lower : R[-1] < v
  requires upper : v < R[0]
  shows HasSingularIntegral(mellinExpIntegrand(β, v),
    ℂ[complexExp(complexImaginaryUnit * complexOfReal(R[v * realHalfPi])) *
      (complexOfReal(realRpow(β, R[-v])) * Gamma(complexOfReal(v)))])
proof
  obtain ⟨eulerMember, eulerNear⟩ := mellinEuler.singular with positiveB,
    lower, upper
  have angle : ℂ[complexImaginaryUnit * complexOfReal(R[v * realHalfPi])] ∈ ℂ
    by typecheck
  have phase := complexExp.member with angle
  have phaseAbs := complexExp.abs_i_mul at R[v * realHalfPi]
  have targetMember : ℂ[complexExp(complexImaginaryUnit *
      complexOfReal(R[v * realHalfPi])) * (complexOfReal(realRpow(β, R[-v])) *
      Gamma(complexOfReal(v)))] ∈ ℂ by typecheck
  refine ⟨targetMember, ?_⟩
  intros e eReal ePositive
  have e2Positive := half.positive with ePositive
  have e4Positive := half.positive with e2Positive
  have e8Positive := half.positive with e4Positive
  have halves2 := half.add_self at e
  have halves4 := half.add_self at half(e)
  have halves8 := half.add_self at half(half(e))
  have e8Real : half(half(half(e))) ∈ ℝ by typecheck
  obtain ⟨d1, d1Real, d1Positive, eulerClose⟩ := eulerNear with
    half(half(half(e))), e8Real, e8Positive
  -- 8βA^(v+1) < e/8 for small A.
  have eightB : R[0] < R[8 * β] by linarith
  have eightBInverse := realInvValue.positive with eightB
  have eightBNonzero : R[8 * β] ≠ R[0] by linarith
  have eightBCancel := realInvValue.mul_right with eightBNonzero
  have smallPositive := realLess.mul_left_of_positive with eightBInverse,
    e8Positive
  have zeroE8 : R[half(half(half(e))) * 0] = R[0] by ring
  rw zeroE8 at smallPositive
  have exponentPositive : R[0] < R[v + 1] by linarith
  obtain ⟨d2, d2Real, d2Positive, powerSmall⟩ := realRpow.small_base with
    exponentPositive, smallPositive
  -- 2βA ≤ 1 for A ≤ 1/(2β).
  have twoB : R[0] < R[2 * β] by linarith
  have twoBInverse := realInvValue.positive with twoB
  have twoBNonzero : R[2 * β] ≠ R[0] by linarith
  have twoBCancel := realInvValue.mul_right with twoBNonzero
  obtain ⟨d, dReal, dPositive, below1, below2, below3⟩ :=
    positiveMesh.common_three with d1Positive, d2Positive, twoBInverse
  witness d
  refine ⟨dReal, dPositive, ?_⟩
  intros A aReal positive below
  have typedA : Real(A) by exact aReal
  have belowD1 : A < d1 by linarith
  have belowD2 : A < d2 by linarith
  obtain ⟨K, kMember, kIntegral, kClose⟩ := eulerClose with A, aReal,
    positive, belowD1
  have integrable := mellinExpIntegrand.improper at β, v, A with positive,
    upper
  have jIntegral := complexImproperIntegral.spec with integrable
  have jMember := complexImproperIntegral.member at mellinExpIntegrand(β, v),
    A
  refine ⟨complexImproperIntegral(mellinExpIntegrand(β, v), A), jMember,
    jIntegral, ?_⟩
  -- Choose ρ far out.
  obtain ⟨_, _, _, jLimit⟩ := jIntegral
  obtain ⟨_, _, _, kLimit⟩ := kIntegral
  obtain ⟨R1, r1Real, jNear⟩ := jLimit with half(half(half(e))), e8Real,
    e8Positive
  obtain ⟨R2, r2Real, kNear⟩ := kLimit with half(half(half(e))), e8Real,
    e8Positive
  have eightPositive : R[0] < R[8] by linarith
  have eightInverse := realInvValue.positive with eightPositive
  have eightNonzero : R[8] ≠ R[0] by linarith
  have eightCancel := realInvValue.mul_right with eightNonzero
  have farPositive := realLess.mul_left_of_positive with eightInverse,
    e8Positive
  rw zeroE8 at farPositive
  have negativeV : R[0] < R[-v] by linarith
  obtain ⟨R3, r3Real, _, farSmall⟩ := realRpow.eventually_small with
    negativeV, farPositive
  have typedR1 : Real(R1) by exact r1Real
  have typedR2 : Real(R2) by exact r2Real
  have typedR3 : Real(R3) by exact r3Real
  obtain ⟨Q1, q1Real, q1a, q1b⟩ := realBound.common_upper at R1, R2
  have typedQ1 : Real(Q1) by exact q1Real
  obtain ⟨Q2, q2Real, q2a, q2b⟩ := realBound.common_upper at R3, A
  have typedQ2 : Real(Q2) by exact q2Real
  obtain ⟨ρ, rhoReal, rho1, rho2⟩ := realBound.common_upper at Q1, Q2
  have typedRho : Real(ρ) by exact rhoReal
  have ordered : A ≤ ρ by linarith
  have later1 : R1 ≤ ρ by linarith
  have later2 : R2 ≤ ρ by linarith
  have later3 : R3 ≤ ρ by linarith
  have jClose := jNear with ρ, rhoReal, later1, ordered
  have kClose2 := kNear with ρ, rhoReal, later2, ordered
  have rhoSmall := farSmall with ρ, rhoReal, later3
  have doubleNeg : R[-R[-v]] = v by ring
  rw doubleNeg at rhoSmall
  -- The contour estimate on [A, ρ].
  have small : R[2 * β * A] ≤ R[1]
    have belowD3 : A < realInvValue(R[2 * β]) by linarith
    have scaled := realLess.mul_left_of_positive with belowD3, twoB
    linarith
  have edges := mellinContour.edges at β, v, A, ρ with positive, ordered
  have bound := mellinContour.edges_bound with positiveB, positive, ordered,
    small, upper
  obtain ⟨_, _, realAxis, imaginaryAxis⟩ := mellin.axes at β, v, A, ρ with
    positive, ordered
  rw ← edges at bound
  rw [realAxis, imaginaryAxis] at bound
  -- 8βA^(v+1) < e/8 and 8ρ^v < e/8.
  have aSmall := powerSmall with A, aReal, positive, belowD2
  have aScaled := realLess.mul_left_of_positive with aSmall, eightB
  have aCollapse : R[R[8 * β] * (half(half(half(e))) *
      realInvValue(R[8 * β]))] = half(half(half(e)))
    linear_combination half(half(half(e))) * eightBCancel
  have rhoScaled := realLess.mul_left_of_positive with rhoSmall, eightPositive
  have rhoCollapse : R[8 * (half(half(half(e))) * realInvValue(R[8]))] =
      half(half(half(e)))
    linear_combination half(half(half(e))) * eightCancel
  have aReshape : R[8 * β * realRpow(A, R[v + 1])] =
    R[R[8 * β] * realRpow(A, R[v + 1])] by ring
  -- Collect the four errors.
  have expIntegral := complexIntegral.member at mellinExpIntegrand(β, v), A, ρ
  have eulerIntegral := complexIntegral.member at mellinEulerIntegrand(β, v),
    A, ρ
  have targetE : ℂ[complexOfReal(realRpow(β, R[-v])) *
    Gamma(complexOfReal(v))] ∈ ℂ by typecheck
  have p1 : ℂ[complexImproperIntegral(mellinExpIntegrand(β, v), A) -
    complexIntegral(mellinExpIntegrand(β, v), A, ρ)] ∈ ℂ by typecheck
  have p2 : ℂ[complexIntegral(mellinExpIntegrand(β, v), A, ρ) -
    complexExp(complexImaginaryUnit * complexOfReal(R[v * realHalfPi])) *
    complexIntegral(mellinEulerIntegrand(β, v), A, ρ)] ∈ ℂ by typecheck
  have p3 : ℂ[complexIntegral(mellinEulerIntegrand(β, v), A, ρ) - K] ∈ ℂ
    by typecheck
  have p4 : ℂ[K - complexOfReal(realRpow(β, R[-v])) *
    Gamma(complexOfReal(v))] ∈ ℂ by typecheck
  have split : ℂ[complexImproperIntegral(mellinExpIntegrand(β, v), A) -
      complexExp(complexImaginaryUnit * complexOfReal(R[v * realHalfPi])) *
      (complexOfReal(realRpow(β, R[-v])) * Gamma(complexOfReal(v)))] =
      ℂ[(complexImproperIntegral(mellinExpIntegrand(β, v), A) -
        complexIntegral(mellinExpIntegrand(β, v), A, ρ)) +
        (complexIntegral(mellinExpIntegrand(β, v), A, ρ) -
        complexExp(complexImaginaryUnit * complexOfReal(R[v * realHalfPi])) *
        complexIntegral(mellinEulerIntegrand(β, v), A, ρ)) +
        complexExp(complexImaginaryUnit * complexOfReal(R[v * realHalfPi])) *
        ((complexIntegral(mellinEulerIntegrand(β, v), A, ρ) - K) +
        (K - complexOfReal(realRpow(β, R[-v])) * Gamma(complexOfReal(v))))]
    by ring
  rw split
  have p34 : ℂ[(complexIntegral(mellinEulerIntegrand(β, v), A, ρ) - K) +
    (K - complexOfReal(realRpow(β, R[-v])) * Gamma(complexOfReal(v)))] ∈ ℂ
    by typecheck
  have p12 : ℂ[(complexImproperIntegral(mellinExpIntegrand(β, v), A) -
    complexIntegral(mellinExpIntegrand(β, v), A, ρ)) +
    (complexIntegral(mellinExpIntegrand(β, v), A, ρ) -
    complexExp(complexImaginaryUnit * complexOfReal(R[v * realHalfPi])) *
    complexIntegral(mellinEulerIntegrand(β, v), A, ρ))] ∈ ℂ by typecheck
  have p5 : ℂ[complexExp(complexImaginaryUnit *
    complexOfReal(R[v * realHalfPi])) * ((complexIntegral(
    mellinEulerIntegrand(β, v), A, ρ) - K) + (K - complexOfReal(realRpow(β,
    R[-v])) * Gamma(complexOfReal(v))))] ∈ ℂ by typecheck
  have t1 := complexAbs.triangle with p12, p5
  have t2 := complexAbs.triangle with p1, p2
  have t3 := complexAbs.triangle with p3, p4
  rw [(complexAbs.mul with phase, p34), phaseAbs] at t1
  have swap1 : complexAbs(ℂ[complexImproperIntegral(mellinExpIntegrand(β, v),
      A) - complexIntegral(mellinExpIntegrand(β, v), A, ρ)]) =
      complexAbs(ℂ[complexIntegral(mellinExpIntegrand(β, v), A, ρ) -
        complexImproperIntegral(mellinExpIntegrand(β, v), A)])
    have flip : ℂ[complexImproperIntegral(mellinExpIntegrand(β, v), A) -
        complexIntegral(mellinExpIntegrand(β, v), A, ρ)] =
        ℂ[-(complexIntegral(mellinExpIntegrand(β, v), A, ρ) -
        complexImproperIntegral(mellinExpIntegrand(β, v), A))] by ring
    rw [flip, complexAbs.neg]
  have p34Abs := complexAbs.nonnegative with p34
  have unit : R[1 * complexAbs(ℂ[(complexIntegral(mellinEulerIntegrand(β, v),
      A, ρ) - K) + (K - complexOfReal(realRpow(β, R[-v])) *
      Gamma(complexOfReal(v)))])] = complexAbs(ℂ[(complexIntegral(
      mellinEulerIntegrand(β, v), A, ρ) - K) + (K - complexOfReal(realRpow(β,
      R[-v])) * Gamma(complexOfReal(v)))]) by ring
  linarith

-- Section: Translation of complex integrals
-- A real integral is unchanged by the translation x ↦ x − a.
theorem HasRiemannIntegral.translate (f h : Set) (A B a I : Real)
  requires integral : HasRiemannIntegral(f, A, B, I)
  requires functionH : h : ℝ → ℝ
  requires formula : ∀ Y ∈ ℝ, h(Y) = f(R[Y - a])
  shows HasRiemannIntegral(h, R[A + a], R[B + a], I)
proof
  obtain ⟨functionF, ordered, _⟩ := integral
  have shiftA : R[1 * (A + a) + -a] = A by ring
  have shiftB : R[1 * (B + a) + -a] = B by ring
  rw [← shiftA, ← shiftB] at integral
  have one : R[0] < R[1] by linarith
  have orderedShift : R[A + a] ≤ R[B + a] by linarith
  have moved := HasRiemannIntegral.affine with one, orderedShift, integral
  have unit : R[1] ≠ R[0] by linarith
  have inverse := realInvValue.mul_right with unit
  have inverseOne : realInvValue(R[1]) = R[1]
    linear_combination inverse
  rw [inverseOne] at moved
  have affineFunction := affineCompose.function at f, R[1], R[-a] with
    functionF
  have same : affineCompose(f, R[1], R[-a]) = h
    apply FunctionBetween.ext with affineFunction, functionH
    intros Y yMember
    have typedY : Real(Y) by exact yMember
    have argument : R[1 * Y + -a] = R[Y - a] by ring
    rw [(affineCompose.value at f, R[1], R[-a], Y with functionF, yMember),
      argument, (formula with Y, yMember)]
  rw same at moved
  have value : R[1 * I] = I by ring
  rw value at moved
  exact moved

theorem complexIntegral.translate (g h : Set) (A B a : Real)
  requires integrable : ComplexRiemannIntegrable(g, A, B)
  requires ordered : A ≤ B
  requires valuesH : ComplexValuedOn(h, ℝ)
  requires formula : ∀ Y ∈ ℝ, h(Y) = g(R[Y - a])
  shows ComplexRiemannIntegrable(h, R[A + a], R[B + a]) ∧
    complexIntegral(h, R[A + a], R[B + a]) = complexIntegral(g, A, B)
proof
  obtain ⟨valuesG, integrableRe, integrableIm⟩ := integrable
  have reIntegral := riemannIntegral.integral with integrableRe
  have imIntegral := riemannIntegral.integral with integrableIm
  have functionRe := complexFunctionRe.function with valuesH
  have functionIm := complexFunctionIm.function with valuesH
  have formulaRe : ∀ Y ∈ ℝ, complexFunctionRe(h)(Y) =
      complexFunctionRe(g)(R[Y - a])
    intros Y yMember
    have typedY : Real(Y) by exact yMember
    rw [(complexFunctionRe.apply with valuesH), (complexFunctionRe.apply with
      valuesG), (formula with Y, yMember)]
  have formulaIm : ∀ Y ∈ ℝ, complexFunctionIm(h)(Y) =
      complexFunctionIm(g)(R[Y - a])
    intros Y yMember
    have typedY : Real(Y) by exact yMember
    rw [(complexFunctionIm.apply with valuesH), (complexFunctionIm.apply with
      valuesG), (formula with Y, yMember)]
  have movedRe := HasRiemannIntegral.translate with reIntegral, functionRe,
    formulaRe
  have movedIm := HasRiemannIntegral.translate with imIntegral, functionIm,
    formulaIm
  obtain ⟨reMember, _⟩ := riemannIntegral.selected at complexFunctionRe(g), A,
    B
  obtain ⟨imMember, _⟩ := riemannIntegral.selected at complexFunctionIm(g), A,
    B
  refine ⟨⟨valuesH, ⟨riemannIntegral(complexFunctionRe(g), A, B), reMember,
    movedRe⟩, ⟨riemannIntegral(complexFunctionIm(g), A, B), imMember,
    movedIm⟩⟩, ?_⟩
  unfold complexIntegral
  rw [(riemannIntegral.eq_of_integral with movedRe),
    (riemannIntegral.eq_of_integral with movedIm)]

theorem HasComplexImproperIntegral.translate (g h : Set) (A a : Real)
    (I : Set)
  requires integral : HasComplexImproperIntegral(g, A, I)
  requires valuesH : ComplexValuedOn(h, ℝ)
  requires formula : ∀ Y ∈ ℝ, h(Y) = g(R[Y - a])
  shows HasComplexImproperIntegral(h, R[A + a], I)
proof
  obtain ⟨_, iMember, local, limit⟩ := integral
  have shifted : ∀ T ∈ ℝ, R[A + a] ≤ T →
      ComplexRiemannIntegrable(h, R[A + a], T) ∧
      complexIntegral(h, R[A + a], T) = complexIntegral(g, A, R[T - a])
    intros T tMember later
    have typedT : Real(T) by exact tMember
    have ordered : A ≤ R[T - a] by linarith
    have tMinus : R[T - a] ∈ ℝ by typecheck
    have moved := complexIntegral.translate with (local with R[T - a], tMinus,
      ordered), ordered, valuesH, formula
    have back : R[T - a + a] = T by ring
    rw back at moved
    exact moved
  refine ⟨valuesH, iMember, ?_, ?_⟩
  . intros T tMember later
    exact (shifted with T, tMember, later).left
  . intros e eReal ePositive
    obtain ⟨T0, t0Real, close⟩ := limit with e, eReal, ePositive
    have typedT0 : Real(T0) by exact t0Real
    witness R[T0 + a]
    have t0Shift : R[T0 + a] ∈ ℝ by typecheck
    refine ⟨t0Shift, ?_⟩
    intros T tMember later laterA
    have typedT : Real(T) by exact tMember
    obtain ⟨_, moved⟩ := shifted with T, tMember, laterA
    rw moved
    have tMinus : R[T - a] ∈ ℝ by typecheck
    have later1 : T0 ≤ R[T - a] by linarith
    have later2 : A ≤ R[T - a] by linarith
    exact close with R[T - a], tMinus, later1, later2

-- Section: The integral representation on −1 < re w < 0
-- P̃₂(x) = x² + x + 1/6 on [−1, 0).
theorem periodicBernoulli.two_left (X : Real)
  requires lower : R[-1] ≤ X
  requires upper : X < R[0]
  shows periodicBernoulli(2)(X) = R[X * X + X + 1 / 6]
proof
  have minusOne : realInt(integerNegValue(integerOfNat(1))) = R[-1]
    rw [realInt.neg, realInt.nat, realNat.one]
  have low : realInt(integerNegValue(integerOfNat(1))) ≤ X
    rw minusOne
    exact lower
  have high : X < R[realInt(integerNegValue(integerOfNat(1))) + 1]
    rw minusOne
    linarith
  rw [(periodicBernoulli.on_cell with low, high), minusOne,
    bernoulliPolynomial.two_index]
  ring

-- The integrand (P̃₂(y − a) − P̃₂(−a)) y^(v−1) of the representation.
defgraph bernoulliMellinIntegrand (a v : Real) (Y ∈ ℝ) : complexCarrier :=
  complexOfReal(R[(periodicBernoulli(2)(R[Y - a]) -
    periodicBernoulli(2)(R[-a])) * realRpow(Y, R[v - 1])])
proof
  have function := periodicBernoulli.function at 2
  have argument : R[Y - a] ∈ ℝ by typecheck
  have shifted : R[-a] ∈ ℝ by typecheck
  have first := FunctionBetween.apply_closed with function, argument
  have second := FunctionBetween.apply_closed with function, shifted
  have firstReal : Real(periodicBernoulli(2)(R[Y - a])) by exact first
  have secondReal : Real(periodicBernoulli(2)(R[-a])) by exact second
  typecheck

-- y^(v+1) + (1 − 2a) y^v, the integrand on (0, a).
defgraph bernoulliCellReal (a v : Real) (Y ∈ ℝ) : ℝ :=
  R[realRpow(Y, R[v + 1]) + (1 - 2 * a) * realRpow(Y, v)]
proof
  typecheck

theorem bernoulliMellinIntegrand.on_cell (a v Y : Real)
  requires positive : R[0] < Y
  requires below : Y < a
  requires atMostOne : a ≤ R[1]
  shows bernoulliMellinIntegrand(a, v)(Y) =
    complexOfReal(bernoulliCellReal(a, v)(Y))
proof
  have yMember : Y ∈ ℝ by typecheck
  have positiveA : R[0] < a by linarith
  have lowerY : R[-1] ≤ R[Y - a] by linarith
  have upperY : R[Y - a] < R[0] by linarith
  have lowerA : R[-1] ≤ R[-a] by linarith
  have upperA : R[-a] < R[0] by linarith
  rw [(bernoulliMellinIntegrand.value at a, v, Y with yMember),
    (bernoulliCellReal.value at a, v, Y with yMember),
    (periodicBernoulli.two_left with lowerY, upperY),
    (periodicBernoulli.two_left with lowerA, upperA)]
  have split := realRpow.add at Y, R[v - 1], R[2] with positive
  have splitOne := realRpow.add at Y, R[v - 1], R[1] with positive
  have two := realRpow.add at Y, R[1], R[1] with positive
  rw (realRpow.one with positive) at two
  rw (realRpow.one with positive) at splitOne
  have e1 : R[v - 1 + 2] = R[v + 1] by ring
  have e2 : R[v - 1 + 1] = v by ring
  have e3 : R[1 + 1] = R[2] by ring
  rw e1 at split
  rw e2 at splitOne
  rw e3 at two
  rw [split, two, splitOne]
  have power := realRpow.real at Y, R[v - 1]
  have inner : R[(R[Y - a] * R[Y - a] + R[Y - a] + 1 / 6 -
      (R[-a] * R[-a] + R[-a] + 1 / 6)) * realRpow(Y, R[v - 1])] =
      R[realRpow(Y, R[v - 1]) * (Y * Y) + (1 - 2 * a) *
        (realRpow(Y, R[v - 1]) * Y)] by ring
  rw inner

-- A real function seen as a complex one.
defgraph complexLift (G : Set) (X ∈ ℝ) : complexCarrier := complexOfReal(G(X))
requires function : FunctionBetween(G, ℝ, ℝ)
proof
  have value := FunctionBetween.apply_closed with function, member
  have valueReal : Real(G(X)) by exact value
  typecheck

theorem complexLift.integral (G : Set) (A B I : Real)
  requires integral : HasRiemannIntegral(G, A, B, I)
  shows ComplexRiemannIntegrable(complexLift(G), A, B) ∧
    complexIntegral(complexLift(G), A, B) = complexOfReal(I)
proof
  obtain ⟨function, ordered, _⟩ := integral
  have values : ComplexValuedOn(complexLift(G), ℝ)
    intros X hX
    exact FunctionBetween.apply_closed with (complexLift.function with
      function), hX
  have real : ∀ X ∈ ℝ, complexLift(G)(X) = complexOfReal(G(X))
    intros X xMember
    exact complexLift.value with function, xMember
  have iReal : I ∈ ℝ by typecheck
  have integrable := ComplexRiemannIntegrable.of_real with values, function,
    real, ordered, ⟨I, iReal, integral⟩
  refine ⟨integrable, ?_⟩
  rw [(complexIntegral.of_real with values, function, real),
    (riemannIntegral.eq_of_integral with integral)]

-- ∫_A^a (y^(v+1) + (1 − 2a) y^v) dy, for 0 < A ≤ a and v > −1.
theorem bernoulliMellin.cell (a v A : Real)
  requires positive : R[0] < A
  requires ordered : A ≤ a
  requires atMostOne : a ≤ R[1]
  requires lower : R[-1] < v
  shows ComplexRiemannIntegrable(bernoulliMellinIntegrand(a, v), A, a) ∧
    complexIntegral(bernoulliMellinIntegrand(a, v), A, a) =
      complexOfReal(R[(realRpow(a, R[v + 2]) - realRpow(A, R[v + 2])) *
        realInvValue(R[v + 2]) + (1 - 2 * a) * (realRpow(a, R[v + 1]) -
        realRpow(A, R[v + 1])) * realInvValue(R[v + 1])])
proof
  have exponent1 : R[1 - R[-(v + 1)]] ≠ R[0]
    intro zero
    linarith
  have exponent2 : R[1 - R[-v]] ≠ R[0]
    intro zero
    linarith
  have first := rpowFunction.has_integral at A, a, R[-(v + 1)] with positive,
    ordered, exponent1
  have second := rpowFunction.has_integral at A, a, R[-v] with positive,
    ordered, exponent2
  have n1 : R[-R[-(v + 1)]] = R[v + 1] by ring
  have m1 : R[1 + R[v + 1]] = R[v + 2] by ring
  have n2 : R[-R[-v]] = v by ring
  have m2 : R[1 + v] = R[v + 1] by ring
  rw [n1, m1] at first
  rw [n2, m2] at second
  have cellFunction := bernoulliCellReal.function at a, v
  have values : ∀ X ∈ ℝ, bernoulliCellReal(a, v)(X) =
      R[1 * rpowFunction(R[v + 1])(X) + (1 - 2 * a) * rpowFunction(v)(X)]
    intros X xMember
    have typedX : Real(X) by exact xMember
    rw [bernoulliCellReal.value, rpowFunction.value, rpowFunction.value]
    ring
  have combined := HasRiemannIntegral.linear with first, second, cellFunction,
    values
  obtain ⟨liftIntegrable, liftValue⟩ := complexLift.integral with combined
  have bValues : ComplexValuedOn(bernoulliMellinIntegrand(a, v), ℝ)
    intros X hX
    exact FunctionBetween.apply_closed with
      (bernoulliMellinIntegrand.function at a, v), hX
  have agree : ∀ X ∈ ℝ, A < X → X < a →
      bernoulliMellinIntegrand(a, v)(X) =
        complexLift(bernoulliCellReal(a, v))(X)
    intros X xMember low high
    have typedX : Real(X) by exact xMember
    have xPositive : R[0] < X by linarith
    rw [(bernoulliMellinIntegrand.on_cell with xPositive, high, atMostOne),
      (complexLift.value with cellFunction, xMember)]
  obtain ⟨integrable, same⟩ := complexIntegral.congr_interior with
    liftIntegrable, bValues, agree
  refine ⟨integrable, ?_⟩
  rw [same, liftValue]
  have i1 := realInvValue.real at R[v + 2]
  have i2 := realInvValue.real at R[v + 1]
  have p1 := realRpow.real at a, R[v + 2]
  have p2 := realRpow.real at A, R[v + 2]
  have p3 := realRpow.real at a, R[v + 1]
  have p4 := realRpow.real at A, R[v + 1]
  have inner : R[1 * (realInvValue(R[v + 2]) * realRpow(a, R[v + 2]) -
      realInvValue(R[v + 2]) * realRpow(A, R[v + 2])) + (1 - 2 * a) *
      (realInvValue(R[v + 1]) * realRpow(a, R[v + 1]) -
      realInvValue(R[v + 1]) * realRpow(A, R[v + 1]))] =
      R[(realRpow(a, R[v + 2]) - realRpow(A, R[v + 2])) *
        realInvValue(R[v + 2]) + (1 - 2 * a) * (realRpow(a, R[v + 1]) -
        realRpow(A, R[v + 1])) * realInvValue(R[v + 1])] by ring
  rw inner

-- y ↦ P̃₂(y − a) y^(v−1).
defgraph shiftedBernoulliReal (a v : Real) (Y ∈ ℝ) : ℝ :=
  R[periodicBernoulli(2)(R[Y - a]) * realRpow(Y, R[v - 1])]
proof
  have function := periodicBernoulli.function at 2
  have argument : R[Y - a] ∈ ℝ by typecheck
  have value := FunctionBetween.apply_closed with function, argument
  have valueReal : Real(periodicBernoulli(2)(R[Y - a])) by exact value
  typecheck

-- Over [a, ∞) the integral of (P̃₂(y − a) − P̃₂(−a)) y^(v−1) is the
-- Euler–Maclaurin remainder integral ∫_0^∞ P̃₂(x)(x + a)^(v−1) dx plus
-- P̃₂(−a) a^v / v.
theorem bernoulliMellin.tail (a v : Real)
  requires positive : R[0] < a
  requires upper : v < R[0]
  shows HasComplexImproperIntegral(bernoulliMellinIntegrand(a, v), a,
    ℂ[complexImproperIntegral(hurwitzIntegrand(2, a,
      complexOfReal(R[-1 - v])), R[0]) +
      complexOfReal(R[periodicBernoulli(2)(R[-a]) * realRpow(a, v) *
        realInvValue(v)])])
proof
  have wMember : complexOfReal(R[-1 - v]) ∈ ℂ by typecheck
  have halfPlane : R[1 - realNat(2)] < complexRe(complexOfReal(R[-1 - v]))
    rw [complexOfReal.re, realNat.two]
    linarith
  have remainder := complexImproperIntegral.spec with
    (hurwitzIntegrand.integrable with positive, wMember, halfPlane)
  have shiftedFunction := shiftedBernoulliReal.function at a, v
  have liftValues : ComplexValuedOn(complexLift(shiftedBernoulliReal(a, v)), ℝ)
    intros X hX
    exact FunctionBetween.apply_closed with (complexLift.function with
      shiftedFunction), hX
  have formula : ∀ Y ∈ ℝ, complexLift(shiftedBernoulliReal(a, v))(Y) =
      hurwitzIntegrand(2, a, complexOfReal(R[-1 - v]))(R[Y - a])
    intros Y yMember
    have typedY : Real(Y) by exact yMember
    have argument : R[Y - a] ∈ ℝ by typecheck
    have back : R[Y - a + a] = Y by ring
    have value := FunctionBetween.apply_closed with (periodicBernoulli.function
      at 2), argument
    have valueReal : Real(periodicBernoulli(2)(R[Y - a])) by exact value
    have exponent : ℂ[-complexOfReal(R[-1 - v]) -
        complexOfReal(realNat(2))] = complexOfReal(R[v - 1])
      rw [realNat.two, ← complexOfReal.neg, ← complexOfReal.sub]
      have same : R[-R[-1 - v] - 2] = R[v - 1] by ring
      rw same
    rw [(complexLift.value with shiftedFunction, yMember),
      (shiftedBernoulliReal.value at a, v, Y with yMember),
      (hurwitzIntegrand.value at 2, a, complexOfReal(R[-1 - v]), R[Y - a] with
        wMember, argument), back, exponent, realCpow.of_real,
      complexOfReal.mul]
  have translated := HasComplexImproperIntegral.translate with remainder,
    liftValues, formula
  have zeroA : R[0 + a] = a by ring
  rw zeroA at translated
  -- The power y^(v−1) over [a, ∞).
  have one : ℂ[1] ∈ ℂ by typecheck
  have powerExponent : complexOfReal(R[v - 1]) ∈ ℂ by typecheck
  have reExponent : R[complexRe(complexOfReal(R[v - 1])) + 1] < R[0]
    rw complexOfReal.re
    linarith
  have aPositive : R[0] < R[a + 0] by linarith
  have power := scaledPower.improper with one, powerExponent, reExponent,
    aPositive
  have minusA : R[-a] ∈ ℝ by typecheck
  have bernoulliValue := FunctionBetween.apply_closed with
    (periodicBernoulli.function at 2), minusA
  have bernoulliReal : Real(periodicBernoulli(2)(R[-a])) by exact bernoulliValue
  have minusC : ℂ[-complexOfReal(periodicBernoulli(2)(R[-a]))] ∈ ℂ
    by typecheck
  have integrable1 : ComplexImproperIntegrable(
      complexLift(shiftedBernoulliReal(a, v)), a)
    have member := complexImproperIntegral.member at hurwitzIntegrand(2, a,
      complexOfReal(R[-1 - v])), R[0]
    exact ⟨complexImproperIntegral(hurwitzIntegrand(2, a,
      complexOfReal(R[-1 - v])), R[0]), member, translated⟩
  have shiftedExponent : ℂ[complexOfReal(R[v - 1]) + 1] =
      complexOfReal(v)
    rw [← complexOfReal.one, ← complexOfReal.add]
    have same : R[v - 1 + 1] = v by ring
    rw same
  rw shiftedExponent at power
  have vMember : complexOfReal(v) ∈ ℂ by typecheck
  have nonzero : v ≠ R[0] by linarith
  rw ← (complexOfReal.inv with nonzero) at power
  have scale : ℂ[1 * complexOfReal(realInvValue(v))] ∈ ℂ by typecheck
  have aMember : a ∈ ℝ by typecheck
  have powerValue := scaledPower.value at ℂ[1 * complexOfReal(realInvValue(v))],
    R[0], complexOfReal(v), a with scale, vMember, aMember
  have aZero : R[a + 0] = a by ring
  rw [powerValue, aZero, realCpow.of_real] at power
  have powerMember : ℂ[-(ℂ[1 * complexOfReal(realInvValue(v))] *
    complexOfReal(realRpow(a, v)))] ∈ ℂ by typecheck
  have integrable2 : ComplexImproperIntegrable(scaledPower(ℂ[1], R[0],
      complexOfReal(R[v - 1])), a)
    exact ⟨ℂ[-(ℂ[1 * complexOfReal(realInvValue(v))] *
      complexOfReal(realRpow(a, v)))], powerMember, power⟩
  obtain ⟨combinationIntegrable, combinationValue⟩ :=
    complexCombination.improper with one, minusC, integrable1, integrable2
  have combinationSpec := complexImproperIntegral.spec with
    combinationIntegrable
  rw [combinationValue, (complexImproperIntegral.eq with translated),
    (complexImproperIntegral.eq with power)] at combinationSpec
  have bValues : ComplexValuedOn(bernoulliMellinIntegrand(a, v), ℝ)
    intros X hX
    exact FunctionBetween.apply_closed with
      (bernoulliMellinIntegrand.function at a, v), hX
  have powerValues : ComplexValuedOn(scaledPower(ℂ[1], R[0],
      complexOfReal(R[v - 1])), ℝ)
    intros X hX
    exact FunctionBetween.apply_closed with (scaledPower.function at ℂ[1],
      R[0], complexOfReal(R[v - 1]) with one, powerExponent), hX
  have agree : ∀ X ∈ ℝ, complexCombination(ℂ[1],
      complexLift(shiftedBernoulliReal(a, v)),
      ℂ[-complexOfReal(periodicBernoulli(2)(R[-a]))], scaledPower(ℂ[1], R[0],
      complexOfReal(R[v - 1])))(X) = bernoulliMellinIntegrand(a, v)(X)
    intros X xMember
    have typedX : Real(X) by exact xMember
    have argument : R[X - a] ∈ ℝ by typecheck
    have value := FunctionBetween.apply_closed with (periodicBernoulli.function
      at 2), argument
    have valueReal : Real(periodicBernoulli(2)(R[X - a])) by exact value
    have xZero : R[X + 0] = X by ring
    have rpowReal := realRpow.real at X, R[v - 1]
    rw [(complexCombination.value with one, minusC, liftValues, powerValues,
      xMember), (complexLift.value with shiftedFunction, xMember),
      (shiftedBernoulliReal.value at a, v, X with xMember),
      (scaledPower.value at ℂ[1], R[0], complexOfReal(R[v - 1]), X with one,
      powerExponent, xMember), xZero, realCpow.of_real,
      (bernoulliMellinIntegrand.value at a, v, X with xMember),
      complexOfReal.mul, complexOfReal.mul, complexOfReal.sub]
    ring
  have moved := HasComplexImproperIntegral.congr with combinationSpec, bValues,
    agree
  have remainderMember := complexImproperIntegral.member at
    hurwitzIntegrand(2, a, complexOfReal(R[-1 - v])), R[0]
  have value : ℂ[1 * complexImproperIntegral(hurwitzIntegrand(2, a,
      complexOfReal(R[-1 - v])), R[0]) + -complexOfReal(periodicBernoulli(2)(
      R[-a])) * -(ℂ[1 * complexOfReal(realInvValue(v))] *
      complexOfReal(realRpow(a, v)))] =
      ℂ[complexImproperIntegral(hurwitzIntegrand(2, a,
      complexOfReal(R[-1 - v])), R[0]) + complexOfReal(R[periodicBernoulli(2)(
      R[-a]) * realRpow(a, v) * realInvValue(v)])]
    have inverseReal := realInvValue.real at v
    have rpowA := realRpow.real at a, v
    rw [complexOfReal.mul, complexOfReal.mul]
    ring
  rw value at moved
  exact moved

-- The Euler–Maclaurin expression of order 2, written out.
theorem hurwitzEulerMaclaurin.one (s : Set) (a : Real)
  requires hs : s ∈ ℂ
  shows hurwitzEulerMaclaurin(1, s, a) =
    ℂ[realCpow(a, ℂ[1 - s]) * complexInv(ℂ[s - 1]) +
      realCpow(a, ℂ[-s]) * complexInv(ℂ[2]) +
      complexOfReal(R[1 / 12]) * s * realCpow(a, ℂ[-s - 1]) -
      complexInv(ℂ[2]) * (s * (s + 1)) *
        complexImproperIntegral(hurwitzIntegrand(2, a, s), R[0])]
proof
  have halfValue := complexOfReal.half
  have bernoulliConstant : complexOfReal(R[bernoulli(2) / realNat(2!)]) =
      complexOfReal(R[1 / 12])
    rw [natural.factorial_two, realNat.two, bernoulli.two]
    have value : R[1 / 6 / 2] = R[1 / 12] by linarith
    rw value
  have remainderConstant : complexOfReal(R[1 / realNat(2!)]) = complexInv(ℂ[2])
    rw [natural.factorial_two, realNat.two, halfValue]
  have risingOne : risingFactorial(s, 1) = s
    rw [natural.one_succ, risingFactorial.succ, risingFactorial.zero,
      realNat.zero, complexOfReal.zero]
    ring
  have risingTwo : risingFactorial(s, 2) = ℂ[s * (s + 1)]
    rw [natural.two_succ, risingFactorial.succ, risingOne, realNat.one,
      complexOfReal.one]
  have correction := hurwitzCorrectionTerms.function at s, a with hs
  unfold hurwitzEulerMaclaurin
  unfold hurwitzRemainder
  rw [natural.one_succ, complexPartialSum.succ, complexPartialSum.zero,
    (hurwitzCorrectionTerms.value at s, a, 0 with hs)]
  rw [← natural.one_succ, natural.double_zero_two, natural.double_zero_succ,
    natural.double_one, risingOne, risingTwo, realNat.one, complexOfReal.one,
    remainderConstant, bernoulliConstant]
  unfold complexDiv
  have one : ℂ[1] ∈ ℂ by typecheck
  have raised : ℂ[1 - s] ∈ ℂ by typecheck
  have negative : ℂ[-s] ∈ ℂ by typecheck
  have lowered : ℂ[-s - 1] ∈ ℂ by typecheck
  have shifted : ℂ[s - 1] ∈ ℂ by typecheck
  have two : ℂ[2] ∈ ℂ by typecheck
  have p1 := realCpow.member at a, ℂ[1 - s] with raised
  have p2 := realCpow.member at a, ℂ[-s] with negative
  have p3 := realCpow.member at a, ℂ[-s - 1] with lowered
  have i1 := complexInv.member with shifted
  have i2 := complexInv.member with two
  have c := complexOfReal.mem at R[1 / 12]
  have improper := complexImproperIntegral.member at hurwitzIntegrand(2, a, s),
    R[0]
  ring

-- For 0 < a ≤ 1 and −1 < v < 0 the integral of (P̃₂(y − a) − P̃₂(−a))
-- y^(v−1) over (0, ∞) is a^(v+2)/(v+2) + (1 − 2a) a^(v+1)/(v+1)
-- + P̃₂(−a) a^v/v + ∫_0^∞ P̃₂(x)(x + a)^(v−1) dx.
theorem bernoulliMellin.singular (a v : Real)
  requires positive : R[0] < a
  requires atMostOne : a ≤ R[1]
  requires lower : R[-1] < v
  requires upper : v < R[0]
  shows HasSingularIntegral(bernoulliMellinIntegrand(a, v),
    ℂ[complexOfReal(R[realRpow(a, R[v + 2]) * realInvValue(R[v + 2]) +
      (1 - 2 * a) * realRpow(a, R[v + 1]) * realInvValue(R[v + 1]) +
      periodicBernoulli(2)(R[-a]) * realRpow(a, v) * realInvValue(v)]) +
      complexImproperIntegral(hurwitzIntegrand(2, a,
        complexOfReal(R[-1 - v])), R[0])])
proof
  have tail := bernoulliMellin.tail with positive, upper
  have minusA : R[-a] ∈ ℝ by typecheck
  have bernoulliValue := FunctionBetween.apply_closed with
    (periodicBernoulli.function at 2), minusA
  have bernoulliReal : Real(periodicBernoulli(2)(R[-a])) by exact bernoulliValue
  have i0 := realInvValue.real at v
  have i1 := realInvValue.real at R[v + 1]
  have i2 := realInvValue.real at R[v + 2]
  have pa0 := realRpow.real at a, v
  have pa1 := realRpow.real at a, R[v + 1]
  have pa2 := realRpow.real at a, R[v + 2]
  have remainderMember := complexImproperIntegral.member at
    hurwitzIntegrand(2, a, complexOfReal(R[-1 - v])), R[0]
  have targetMember : ℂ[complexOfReal(R[realRpow(a, R[v + 2]) *
    realInvValue(R[v + 2]) + (1 - 2 * a) * realRpow(a, R[v + 1]) *
    realInvValue(R[v + 1]) + periodicBernoulli(2)(R[-a]) * realRpow(a, v) *
    realInvValue(v)]) + complexImproperIntegral(hurwitzIntegrand(2, a,
    complexOfReal(R[-1 - v])), R[0])] ∈ ℂ by typecheck
  refine ⟨targetMember, ?_⟩
  intros e eReal ePositive
  have positive1 : R[0] < R[v + 1] by linarith
  have positive2 : R[0] < R[v + 2] by linarith
  have inverse1 := realInvValue.positive with positive1
  have inverse2 := realInvValue.positive with positive2
  have kPositive : R[0] < R[realInvValue(R[v + 2]) + realInvValue(R[v + 1])]
    by linarith
  have kNonzero : R[realInvValue(R[v + 2]) + realInvValue(R[v + 1])] ≠ R[0]
    by linarith
  have kInverse := realInvValue.mul_right with kNonzero
  have kInversePositive := realInvValue.positive with kPositive
  have tolerance := realLess.mul_left_of_positive with kInversePositive,
    ePositive
  have zeroE : R[e * 0] = R[0] by ring
  rw zeroE at tolerance
  obtain ⟨d0, d0Real, d0Positive, powerSmall⟩ := realRpow.small_base with
    positive1, tolerance
  obtain ⟨d, dReal, dPositive, below0, belowA⟩ := realPositive.common_lower
    with d0Positive, positive
  witness d
  refine ⟨dReal, dPositive, ?_⟩
  intros A aReal aPositive below
  have typedA : Real(A) by exact aReal
  have ordered : A ≤ a by linarith
  obtain ⟨cellIntegrable, cellValue⟩ := bernoulliMellin.cell with aPositive,
    ordered, atMostOne, lower
  have earlier := HasComplexImproperIntegral.earlier with tail, ordered,
    cellIntegrable
  rw cellValue at earlier
  have jMember := earlier.right.left
  refine ⟨ℂ[complexOfReal(R[(realRpow(a, R[v + 2]) - realRpow(A, R[v + 2])) *
    realInvValue(R[v + 2]) + (1 - 2 * a) * (realRpow(a, R[v + 1]) -
    realRpow(A, R[v + 1])) * realInvValue(R[v + 1])]) +
    ℂ[complexImproperIntegral(hurwitzIntegrand(2, a,
      complexOfReal(R[-1 - v])), R[0]) + complexOfReal(R[periodicBernoulli(2)(
      R[-a]) * realRpow(a, v) * realInvValue(v)])]], jMember, earlier, ?_⟩
  have pA1 := realRpow.real at A, R[v + 1]
  have pA2 := realRpow.real at A, R[v + 2]
  have difference : ℂ[complexOfReal(R[(realRpow(a, R[v + 2]) -
      realRpow(A, R[v + 2])) * realInvValue(R[v + 2]) + (1 - 2 * a) *
      (realRpow(a, R[v + 1]) - realRpow(A, R[v + 1])) *
      realInvValue(R[v + 1])]) + ℂ[complexImproperIntegral(hurwitzIntegrand(2,
      a, complexOfReal(R[-1 - v])), R[0]) +
      complexOfReal(R[periodicBernoulli(2)(
      R[-a]) * realRpow(a, v) * realInvValue(v)])] -
      ℂ[complexOfReal(R[realRpow(a, R[v + 2]) * realInvValue(R[v + 2]) +
      (1 - 2 * a) * realRpow(a, R[v + 1]) * realInvValue(R[v + 1]) +
      periodicBernoulli(2)(R[-a]) * realRpow(a, v) * realInvValue(v)]) +
      complexImproperIntegral(hurwitzIntegrand(2, a,
        complexOfReal(R[-1 - v])), R[0])]] =
      complexOfReal(R[-(realRpow(A, R[v + 2]) * realInvValue(R[v + 2]) +
        (1 - 2 * a) * realRpow(A, R[v + 1]) * realInvValue(R[v + 1]))])
    have first := complexOfReal.mem at R[(realRpow(a, R[v + 2]) -
      realRpow(A, R[v + 2])) * realInvValue(R[v + 2]) + (1 - 2 * a) *
      (realRpow(a, R[v + 1]) - realRpow(A, R[v + 1])) *
      realInvValue(R[v + 1])]
    have second := complexOfReal.mem at R[periodicBernoulli(2)(R[-a]) *
      realRpow(a, v) * realInvValue(v)]
    have third := complexOfReal.mem at R[realRpow(a, R[v + 2]) *
      realInvValue(R[v + 2]) + (1 - 2 * a) * realRpow(a, R[v + 1]) *
      realInvValue(R[v + 1]) + periodicBernoulli(2)(R[-a]) * realRpow(a, v) *
      realInvValue(v)]
    have combine : ℂ[complexOfReal(R[(realRpow(a, R[v + 2]) -
        realRpow(A, R[v + 2])) * realInvValue(R[v + 2]) + (1 - 2 * a) *
        (realRpow(a, R[v + 1]) - realRpow(A, R[v + 1])) *
        realInvValue(R[v + 1])]) + complexOfReal(R[periodicBernoulli(2)(
        R[-a]) * realRpow(a, v) * realInvValue(v)]) -
        complexOfReal(R[realRpow(a, R[v + 2]) * realInvValue(R[v + 2]) +
        (1 - 2 * a) * realRpow(a, R[v + 1]) * realInvValue(R[v + 1]) +
        periodicBernoulli(2)(R[-a]) * realRpow(a, v) * realInvValue(v)])] =
        complexOfReal(R[-(realRpow(A, R[v + 2]) * realInvValue(R[v + 2]) +
        (1 - 2 * a) * realRpow(A, R[v + 1]) * realInvValue(R[v + 1]))])
      rw [← complexOfReal.add, ← complexOfReal.sub]
      have inner : R[(realRpow(a, R[v + 2]) - realRpow(A, R[v + 2])) *
          realInvValue(R[v + 2]) + (1 - 2 * a) * (realRpow(a, R[v + 1]) -
          realRpow(A, R[v + 1])) * realInvValue(R[v + 1]) +
          periodicBernoulli(2)(R[-a]) * realRpow(a, v) * realInvValue(v) -
          (realRpow(a, R[v + 2]) * realInvValue(R[v + 2]) + (1 - 2 * a) *
          realRpow(a, R[v + 1]) * realInvValue(R[v + 1]) +
          periodicBernoulli(2)(R[-a]) * realRpow(a, v) * realInvValue(v))] =
          R[-(realRpow(A, R[v + 2]) * realInvValue(R[v + 2]) +
          (1 - 2 * a) * realRpow(A, R[v + 1]) * realInvValue(R[v + 1]))]
        by ring
      rw inner
    linear_combination combine
  rw [difference, complexAbs.of_real, abs.neg]
  have split := realRpow.add at A, R[v + 1], R[1] with aPositive
  rw (realRpow.one with aPositive) at split
  have exponent : R[v + 1 + 1] = R[v + 2] by ring
  rw exponent at split
  have p1Positive := realRpow.positive at A, R[v + 1]
  have aAtMostOne : A ≤ R[1] by linarith
  have shrink := realLe.mul_left_of_nonnegative with aAtMostOne,
    (realLess.implies_le with p1Positive)
  have oneTimes : R[realRpow(A, R[v + 1]) * 1] = realRpow(A, R[v + 1])
    by ring
  have p2Le : realRpow(A, R[v + 2]) ≤ realRpow(A, R[v + 1]) by linarith
  have q2Le := realLe.mul_right_of_nonnegative with p2Le,
    (realLess.implies_le with inverse2)
  have q2Nonnegative := realLe.mul_right_of_nonnegative with
    (realLess.implies_le with (realRpow.positive at A, R[v + 2])),
    (realLess.implies_le with inverse2)
  have q1Nonnegative := realLe.mul_right_of_nonnegative with
    (realLess.implies_le with p1Positive), (realLess.implies_le with inverse1)
  have zero1 : R[0 * realInvValue(R[v + 1])] = R[0] by ring
  have zero2 : R[0 * realInvValue(R[v + 2])] = R[0] by ring
  have coefficientUpper : R[1 - 2 * a] ≤ R[1] by linarith
  have coefficientLower : R[-1] ≤ R[1 - 2 * a] by linarith
  have q1Real : R[realRpow(A, R[v + 1]) * realInvValue(R[v + 1])] ∈ ℝ
    by typecheck
  have q1NonnegativeR : R[0] ≤ R[realRpow(A, R[v + 1]) *
    realInvValue(R[v + 1])] by linarith
  have upperTerm := realLe.mul_right_of_nonnegative with coefficientUpper,
    q1NonnegativeR
  have lowerTerm := realLe.mul_right_of_nonnegative with coefficientLower,
    q1NonnegativeR
  have reshape : R[(1 - 2 * a) * realRpow(A, R[v + 1]) *
      realInvValue(R[v + 1])] = R[(1 - 2 * a) * (realRpow(A, R[v + 1]) *
      realInvValue(R[v + 1]))] by ring
  have lowerBound : R[-(realRpow(A, R[v + 1]) * (realInvValue(R[v + 2]) +
      realInvValue(R[v + 1])))] ≤ R[realRpow(A, R[v + 2]) *
      realInvValue(R[v + 2]) + (1 - 2 * a) * realRpow(A, R[v + 1]) *
      realInvValue(R[v + 1])]
    have expand : R[-(realRpow(A, R[v + 1]) * (realInvValue(R[v + 2]) +
        realInvValue(R[v + 1])))] = R[-(realRpow(A, R[v + 1]) *
        realInvValue(R[v + 2])) + -1 * (realRpow(A, R[v + 1]) *
        realInvValue(R[v + 1]))] by ring
    have p1i2 := realLe.mul_right_of_nonnegative with
      (realLess.implies_le with p1Positive), (realLess.implies_le with inverse2)
    linarith
  have upperBound : R[realRpow(A, R[v + 2]) * realInvValue(R[v + 2]) +
      (1 - 2 * a) * realRpow(A, R[v + 1]) * realInvValue(R[v + 1])] ≤
      R[realRpow(A, R[v + 1]) * (realInvValue(R[v + 2]) +
      realInvValue(R[v + 1]))]
    have expand : R[realRpow(A, R[v + 1]) * (realInvValue(R[v + 2]) +
        realInvValue(R[v + 1]))] = R[realRpow(A, R[v + 1]) *
        realInvValue(R[v + 2]) + 1 * (realRpow(A, R[v + 1]) *
        realInvValue(R[v + 1]))] by ring
    linarith
  have bound := abs.le_of_two_sided with lowerBound, upperBound
  have belowD0 : A < d0 by linarith
  have small := powerSmall with A, aReal, aPositive, belowD0
  have scaled := realLess.mul_left_of_positive with small, kPositive
  have collapse : R[R[realInvValue(R[v + 2]) + realInvValue(R[v + 1])] *
      (e * realInvValue(R[realInvValue(R[v + 2]) + realInvValue(R[v + 1])]))] =
      e
    linear_combination e * kInverse
  have swap : R[realRpow(A, R[v + 1]) * (realInvValue(R[v + 2]) +
      realInvValue(R[v + 1]))] = R[R[realInvValue(R[v + 2]) +
      realInvValue(R[v + 1])] * realRpow(A, R[v + 1])] by ring
  linarith

-- The rational identity behind the representation: with j = 1/(−2 − v),
-- iₖ = 1/(v + k), hf = 1/2, tw = 1/12, sx = 1/6, A₂ = p a², A₁ = p a and
-- P = a² − a + 1/6 (p standing for a^v).
theorem hurwitzZeta.bernoulli_identity (a v p A1 A2 P i0 i1 i2 j hf tw sx :
    Real)
  requires h2 : R[(v + 2) * i2] = R[1]
  requires h1 : R[(v + 1) * i1] = R[1]
  requires h0 : R[v * i0] = R[1]
  requires hj : R[(-2 - v) * j] = R[1]
  requires f2 : R[2 * hf] = R[1]
  requires f12 : R[12 * tw] = R[1]
  requires f6 : R[6 * sx] = R[1]
  requires power2 : A2 = R[p * a * a]
  requires power1 : A1 = R[p * a]
  requires bernoulliValue : P = R[a * a - a + sx]
  shows R[A2 * j + A1 * hf + tw * (-1 - v) * p] =
    R[-(v * (v + 1)) * hf * (A2 * i2 + (1 - 2 * a) * A1 * i1 + P * p * i0)]
proof
  have jValue : j = R[-i2]
    linear_combination (-j) * h2 + (-i2) * hj
  rw [jValue, power2, power1, bernoulliValue]
  linear_combination (p * a * a * hf * (v - 1)) * h2 +
    (v * hf * (1 - 2 * a) * p * a) * h1 +
    ((v + 1) * hf * (a * a - a + sx) * p) * h0 +
    (p * a * a * i2 + 6 * p * (v + 1) * tw * sx) * f2 +
    (-(p * (v + 1) * hf * sx)) * f12 + (p * (v + 1) * tw) * f6

-- For −1 < v < 0: ζ(−1 − v, a) = −v(v + 1)/2 · M with M the integral of
-- bernoulliMellin.singular.
theorem hurwitzZeta.bernoulli_form (a v : Real)
  requires positive : R[0] < a
  requires atMostOne : a ≤ R[1]
  requires lower : R[-1] < v
  requires upper : v < R[0]
  shows hurwitzZeta(complexOfReal(R[-1 - v]), a) =
    ℂ[complexOfReal(R[-(v * (v + 1))]) * complexOfReal(R[1 / 2]) *
      (complexOfReal(R[realRpow(a, R[v + 2]) * realInvValue(R[v + 2]) +
        (1 - 2 * a) * realRpow(a, R[v + 1]) * realInvValue(R[v + 1]) +
        periodicBernoulli(2)(R[-a]) * realRpow(a, v) * realInvValue(v)]) +
      complexImproperIntegral(hurwitzIntegrand(2, a,
        complexOfReal(R[-1 - v])), R[0]))]
proof
  have wMember : complexOfReal(R[-1 - v]) ∈ ℂ by typecheck
  have notOne : complexOfReal(R[-1 - v]) ≠ ℂ[1]
    intro one
    rw ← complexOfReal.one at one
    have reals := complexOfReal.injective with one
    linarith
  have orderOne : (1:N) ≤ (1:N) by arith
  have halfPlane : R[1 - 2 * realNat(1)] < complexRe(complexOfReal(R[-1 - v]))
    rw [complexOfReal.re, realNat.one]
    linarith
  rw [(hurwitzZeta.eq_euler_maclaurin with positive, wMember, notOne,
    orderOne, halfPlane), (hurwitzEulerMaclaurin.one with wMember)]
  have e1 : ℂ[1 - complexOfReal(R[-1 - v])] = complexOfReal(R[v + 2])
    rw [← complexOfReal.one, ← complexOfReal.sub]
    have same : R[1 - R[-1 - v]] = R[v + 2] by ring
    rw same
  have e2 : ℂ[-complexOfReal(R[-1 - v])] = complexOfReal(R[v + 1])
    rw ← complexOfReal.neg
    have same : R[-R[-1 - v]] = R[v + 1] by ring
    rw same
  have e3 : ℂ[-complexOfReal(R[-1 - v]) - 1] = complexOfReal(v)
    rw [← complexOfReal.one, ← complexOfReal.neg, ← complexOfReal.sub]
    have same : R[-R[-1 - v] - 1] = v by ring
    rw same
  have e4 : ℂ[complexOfReal(R[-1 - v]) - 1] = complexOfReal(R[-2 - v])
    rw [← complexOfReal.one, ← complexOfReal.sub]
    have same : R[R[-1 - v] - 1] = R[-2 - v] by ring
    rw same
  have nonzeroJ : R[-2 - v] ≠ R[0] by linarith
  rw [e1, e3, e2, e4, realCpow.of_real, realCpow.of_real, realCpow.of_real,
    ← (complexOfReal.inv with nonzeroJ), ← complexOfReal.half]
  have nonzero0 : v ≠ R[0] by linarith
  have nonzero1 : R[v + 1] ≠ R[0] by linarith
  have nonzero2 : R[v + 2] ≠ R[0] by linarith
  have h0 := realInvValue.mul_right with nonzero0
  have h1 := realInvValue.mul_right with nonzero1
  have h2 := realInvValue.mul_right with nonzero2
  have hj := realInvValue.mul_right with nonzeroJ
  have f2 : R[2 * R[1 / 2]] = R[1] by linarith
  have f12 : R[12 * R[1 / 12]] = R[1] by linarith
  have f6 : R[6 * R[1 / 6]] = R[1] by linarith
  have split1 := realRpow.add at a, v, R[1] with positive
  have split2 := realRpow.add at a, R[v + 1], R[1] with positive
  rw (realRpow.one with positive) at split1
  rw (realRpow.one with positive) at split2
  have exponent2 : R[v + 1 + 1] = R[v + 2] by ring
  rw exponent2 at split2
  have power1 : realRpow(a, R[v + 1]) = R[realRpow(a, v) * a] := split1
  have power2 : realRpow(a, R[v + 2]) = R[realRpow(a, v) * a * a]
    rw [split2, split1]
  have lowerA : R[-1] ≤ R[-a] by linarith
  have upperA : R[-a] < R[0] by linarith
  have bernoulliValue : periodicBernoulli(2)(R[-a]) = R[a * a - a + 1 / 6]
    rw (periodicBernoulli.two_left with lowerA, upperA)
    ring
  have minusA : R[-a] ∈ ℝ by typecheck
  have bernoulliMember := FunctionBetween.apply_closed with
    (periodicBernoulli.function at 2), minusA
  have bernoulliReal : Real(periodicBernoulli(2)(R[-a])) by
    exact bernoulliMember
  have identity := hurwitzZeta.bernoulli_identity with h2, h1, h0, hj, f2,
    f12, f6, power2, power1, bernoulliValue
  have lifted : complexOfReal(R[realRpow(a, R[v + 2]) *
      realInvValue(R[-2 - v]) + realRpow(a, R[v + 1]) * R[1 / 2] +
      R[1 / 12] * (-1 - v) * realRpow(a, v)]) =
      complexOfReal(R[-(v * (v + 1)) * R[1 / 2] * (realRpow(a, R[v + 2]) *
      realInvValue(R[v + 2]) + (1 - 2 * a) * realRpow(a, R[v + 1]) *
      realInvValue(R[v + 1]) + periodicBernoulli(2)(R[-a]) * realRpow(a, v) *
      realInvValue(v))])
    rw identity
  have pReal := realRpow.real at a, v
  have p1Real := realRpow.real at a, R[v + 1]
  have p2Real := realRpow.real at a, R[v + 2]
  have i0Real := realInvValue.real at v
  have i1Real := realInvValue.real at R[v + 1]
  have i2Real := realInvValue.real at R[v + 2]
  have jReal := realInvValue.real at R[-2 - v]
  simp [complexOfReal.add, complexOfReal.mul, complexOfReal.sub,
    complexOfReal.neg, complexOfReal.one, power1, power2, bernoulliValue] at
    lifted
  simp [complexOfReal.add, complexOfReal.mul, complexOfReal.sub,
    complexOfReal.neg, complexOfReal.one, power1, power2, bernoulliValue]
  have aMember : complexOfReal(a) ∈ ℂ by typecheck
  have vMember : complexOfReal(v) ∈ ℂ by typecheck
  have pMember : complexOfReal(realRpow(a, v)) ∈ ℂ by typecheck
  have halfMember : complexOfReal(R[1 / 2]) ∈ ℂ by typecheck
  have twelfth : complexOfReal(R[1 / 12]) ∈ ℂ by typecheck
  have sixth : complexOfReal(R[1 / 6]) ∈ ℂ by typecheck
  have m0 : complexOfReal(realInvValue(v)) ∈ ℂ by typecheck
  have m1 : complexOfReal(realInvValue(R[v + 1])) ∈ ℂ by typecheck
  have m2 : complexOfReal(realInvValue(R[v + 2])) ∈ ℂ by typecheck
  have mj : complexOfReal(realInvValue(R[-2 - v])) ∈ ℂ by typecheck
  have remainder := complexImproperIntegral.member at hurwitzIntegrand(2, a,
    ℂ[-1 - complexOfReal(v)]), R[0]
  ring

theorem realNat.plus_one (n : Nat)
  shows realNat(n + 1) = R[realNat(n) + 1]
proof
  rw [realNat.add, realNat.one]

theorem realNat.plus_one_positive (n : Nat)
  shows R[0] < realNat(n + 1)
proof
  rw realNat.plus_one
  have nonnegative := realNat.nonnegative at n
  linarith

-- Section: Linearity of integrals over (0, ∞)
theorem HasSingularIntegral.combination (c1 g1 c2 g2 h I1 I2 : Set)
  requires hc1 : c1 ∈ ℂ
  requires hc2 : c2 ∈ ℂ
  requires first : HasSingularIntegral(g1, I1)
  requires second : HasSingularIntegral(g2, I2)
  requires valuesH : ComplexValuedOn(h, ℝ)
  requires formula : ∀ X ∈ ℝ, h(X) = ℂ[c1 * g1(X) + c2 * g2(X)]
  shows HasSingularIntegral(h, ℂ[c1 * I1 + c2 * I2])
proof
  obtain ⟨i1Member, near1⟩ := first
  obtain ⟨i2Member, near2⟩ := second
  have targetMember : ℂ[c1 * I1 + c2 * I2] ∈ ℂ by typecheck
  refine ⟨targetMember, ?_⟩
  intros e eReal ePositive
  have abs1 := complexAbs.nonnegative with hc1
  have abs2 := complexAbs.nonnegative with hc2
  have kPositive : R[0] < R[complexAbs(c1) + complexAbs(c2) + 1] by linarith
  have kNonzero : R[complexAbs(c1) + complexAbs(c2) + 1] ≠ R[0] by linarith
  have kInverse := realInvValue.mul_right with kNonzero
  have kInversePositive := realInvValue.positive with kPositive
  have toleranceReal : R[e * realInvValue(R[complexAbs(c1) + complexAbs(c2) +
    1])] ∈ ℝ by typecheck
  have tolerance := realLess.mul_left_of_positive with kInversePositive,
    ePositive
  have zeroE : R[e * 0] = R[0] by ring
  rw zeroE at tolerance
  obtain ⟨d1, d1Real, d1Positive, close1⟩ := near1 with R[e *
    realInvValue(R[complexAbs(c1) + complexAbs(c2) + 1])], toleranceReal,
    tolerance
  obtain ⟨d2, d2Real, d2Positive, close2⟩ := near2 with R[e *
    realInvValue(R[complexAbs(c1) + complexAbs(c2) + 1])], toleranceReal,
    tolerance
  obtain ⟨d, dReal, dPositive, below1, below2⟩ := realPositive.common_lower
    with d1Positive, d2Positive
  witness d
  refine ⟨dReal, dPositive, ?_⟩
  intros A aReal positive below
  have typedA : Real(A) by exact aReal
  have less1 : A < d1 by linarith
  have less2 : A < d2 by linarith
  obtain ⟨J1, j1Member, integral1, gap1⟩ := close1 with A, aReal, positive,
    less1
  obtain ⟨J2, j2Member, integral2, gap2⟩ := close2 with A, aReal, positive,
    less2
  have integrable1 : ComplexImproperIntegrable(g1, A)
    exact ⟨J1, j1Member, integral1⟩
  have integrable2 : ComplexImproperIntegrable(g2, A)
    exact ⟨J2, j2Member, integral2⟩
  obtain ⟨combined, combinedValue⟩ := complexCombination.improper at c1, g1,
    c2, g2, A with hc1, hc2, integrable1, integrable2
  have spec := complexImproperIntegral.spec with combined
  rw [combinedValue, (complexImproperIntegral.eq with integral1),
    (complexImproperIntegral.eq with integral2)] at spec
  have values1 := integral1.left
  have values2 := integral2.left
  have agree : ∀ X ∈ ℝ, complexCombination(c1, g1, c2, g2)(X) = h(X)
    intros X xMember
    rw [(complexCombination.value with hc1, hc2, values1, values2, xMember),
      (formula with X, xMember)]
  have moved := HasComplexImproperIntegral.congr with spec, valuesH, agree
  have resultMember : ℂ[c1 * J1 + c2 * J2] ∈ ℂ by typecheck
  refine ⟨ℂ[c1 * J1 + c2 * J2], resultMember, moved, ?_⟩
  have gapMember1 : ℂ[J1 - I1] ∈ ℂ by typecheck
  have gapMember2 : ℂ[J2 - I2] ∈ ℂ by typecheck
  have p1 : ℂ[c1 * (J1 - I1)] ∈ ℂ by typecheck
  have p2 : ℂ[c2 * (J2 - I2)] ∈ ℂ by typecheck
  have regroup : ℂ[c1 * J1 + c2 * J2 - (c1 * I1 + c2 * I2)] =
    ℂ[c1 * (J1 - I1) + c2 * (J2 - I2)] by ring
  rw regroup
  have triangle := complexAbs.triangle with p1, p2
  rw [(complexAbs.mul with hc1, gapMember1), (complexAbs.mul with hc2,
    gapMember2)] at triangle
  have bound1 := realLe.mul_left_of_nonnegative with
    (realLess.implies_le with gap1), abs1
  have bound2 := realLe.mul_left_of_nonnegative with
    (realLess.implies_le with gap2), abs2
  have collapse : R[R[complexAbs(c1) + complexAbs(c2) + 1] * (e *
      realInvValue(R[complexAbs(c1) + complexAbs(c2) + 1]))] = e
    linear_combination e * kInverse
  have expand : R[R[complexAbs(c1) + complexAbs(c2) + 1] * (e *
      realInvValue(R[complexAbs(c1) + complexAbs(c2) + 1]))] =
      R[complexAbs(c1) * (e * realInvValue(R[complexAbs(c1) +
      complexAbs(c2) + 1])) + complexAbs(c2) * (e * realInvValue(
      R[complexAbs(c1) + complexAbs(c2) + 1])) + e * realInvValue(
      R[complexAbs(c1) + complexAbs(c2) + 1])] by ring
  linarith

theorem HasSingularIntegral.conj (g h I : Set)
  requires integral : HasSingularIntegral(g, I)
  requires valuesH : ComplexValuedOn(h, ℝ)
  requires conjugate : ∀ X ∈ ℝ, h(X) = complexConj(g(X))
  shows HasSingularIntegral(h, complexConj(I))
proof
  obtain ⟨iMember, near⟩ := integral
  have conjMember := complexConj.member with iMember
  refine ⟨conjMember, ?_⟩
  intros e eReal ePositive
  obtain ⟨d, dReal, dPositive, close⟩ := near with e, eReal, ePositive
  witness d
  refine ⟨dReal, dPositive, ?_⟩
  intros A aReal positive below
  obtain ⟨J, jMember, integralJ, gap⟩ := close with A, aReal, positive, below
  have moved := HasComplexImproperIntegral.conj with integralJ, valuesH,
    conjugate
  have conjJ := complexConj.member with jMember
  refine ⟨complexConj(J), conjJ, moved, ?_⟩
  have difference : ℂ[J - I] ∈ ℂ by typecheck
  have same : ℂ[complexConj(J) - complexConj(I)] = complexConj(ℂ[J - I])
    have negI : ℂ[-I] ∈ ℂ by typecheck
    rw [(complexConj.add with jMember, negI), (complexConj.neg with
      iMember)]
    ring
  rw [same, (complexAbs.conj with difference)]
  exact gap

-- 2 cos θ = e^(iθ) + e^(−iθ).
theorem realCos.exp_form (θ : Real)
  shows ℂ[2 * complexOfReal(realCos(θ))] =
    ℂ[complexExp(complexImaginaryUnit * complexOfReal(θ)) +
      complexExp(-(complexImaginaryUnit * complexOfReal(θ)))]
proof
  have negated : ℂ[-(complexImaginaryUnit * complexOfReal(θ))] =
      ℂ[complexImaginaryUnit * complexOfReal(R[-θ])]
    rw complexOfReal.neg
    ring
  rw [negated, complexExp.euler, complexExp.euler, realCos.neg, realSin.neg,
    complexPoint.eq, complexPoint.eq, complexOfReal.neg]
  have iMember := complexImaginaryUnit.member
  have c := complexOfReal.mem at realCos(θ)
  have s := complexOfReal.mem at realSin(θ)
  ring

-- Γ(v) is real for −1 < v < 0.
theorem Gamma.conj_between (v : Real)
  requires lower : R[-1] < v
  requires upper : v < R[0]
  shows complexConj(Gamma(complexOfReal(v))) = Gamma(complexOfReal(v))
proof
  have one : R[0] < R[1] by linarith
  have euler := mellinEuler.singular with one, lower, upper
  have values : ComplexValuedOn(mellinEulerIntegrand(R[1], v), ℝ)
    intros X hX
    exact FunctionBetween.apply_closed with (mellinEulerIntegrand.function at
      R[1], v), hX
  have conjugate : ∀ X ∈ ℝ, mellinEulerIntegrand(R[1], v)(X) =
      complexConj(mellinEulerIntegrand(R[1], v)(X))
    intros X xMember
    have typedX : Real(X) by exact xMember
    rw [(mellinEulerIntegrand.value at R[1], v, X with xMember),
      complexConj.of_real]
  have conjugated := HasSingularIntegral.conj with euler, values, conjugate
  have same := HasSingularIntegral.unique with euler, conjugated
  have gamma := Gamma.member at complexOfReal(v)
  have power := complexOfReal.mem at realRpow(R[1], R[-v])
  rw [(complexConj.mul with power, gamma), complexConj.of_real,
    realRpow.one_base, complexOfReal.one] at same
  linear_combination -same

-- Section: The Fourier terms of P̃₂ against y^(v−1)
-- (cos(2πnx) − cos(2πnx₀))/(π²n²) for n = 1, 2, …, indexed from 0.
defgraph fourierDifferenceTerms (X X0 : Real) (n ∈ ℕ) : ℝ :=
  R[(realCos(R[2 * realPi * realNat(n + 1) * X]) -
    realCos(R[2 * realPi * realNat(n + 1) * X0])) *
    realInvValue(R[realPi * realPi * realNat(n + 1) * realNat(n + 1)])]
proof
  have typedN := nat.omega.backward with member
  typecheck

defgraph fourierMellinTerm (a v : Real, n : Nat) (Y ∈ ℝ) : complexCarrier :=
  complexOfReal(R[fourierDifferenceTerms(R[Y - a], R[-a])(n) *
    realRpow(Y, R[v - 1])])
proof
  have nMember : n ∈ ℕ := nat.omega.forward at n with *
  have term := FunctionBetween.apply_closed with
    (fourierDifferenceTerms.function at R[Y - a], R[-a]), nMember
  have termReal : Real(fourierDifferenceTerms(R[Y - a], R[-a])(n)) by
    exact term
  typecheck

defgraph mellinConjIntegrand (β v : Real) (Y ∈ ℝ) : complexCarrier :=
  complexConj(mellinExpIntegrand(β, v)(Y))
proof
  have value := FunctionBetween.apply_closed with
    (mellinExpIntegrand.function at β, v), member
  exact complexConj.member with value

-- The term as a combination of (e^(iβy) − 1) y^(v−1) and its conjugate,
-- β = 2π(n + 1).
theorem fourierMellinTerm.combination (a v : Real) (n : Nat) (Y : Real)
  shows fourierMellinTerm(a, v, n)(Y) =
    ℂ[complexOfReal(R[realInvValue(R[realPi * realPi * realNat(n + 1) *
        realNat(n + 1)]) * (1 / 2)]) * expTwoPiI(R[realNat(n + 1) * -a]) *
        mellinExpIntegrand(R[2 * realPi * realNat(n + 1)], v)(Y) +
      complexOfReal(R[realInvValue(R[realPi * realPi * realNat(n + 1) *
        realNat(n + 1)]) * (1 / 2)]) * expTwoPiI(R[realNat(n + 1) * a]) *
        mellinConjIntegrand(R[2 * realPi * realNat(n + 1)], v)(Y)]
proof
  have yMember : Y ∈ ℝ by typecheck
  have nMember : n ∈ ℕ by typecheck
  have iMember := complexImaginaryUnit.member
  rw [(fourierMellinTerm.value at a, v, n, Y with yMember),
    (fourierDifferenceTerms.value at R[Y - a], R[-a], n with nMember),
    (mellinConjIntegrand.value at R[2 * realPi * realNat(n + 1)], v, Y with
      yMember),
    (mellinExpIntegrand.value at R[2 * realPi * realNat(n + 1)], v, Y with
      yMember)]
  have angle : ℂ[complexImaginaryUnit * complexOfReal(R[R[2 * realPi *
    realNat(n + 1)] * Y])] ∈ ℂ by typecheck
  have wave := complexExp.member with angle
  have one : ℂ[1] ∈ ℂ by typecheck
  have shifted : ℂ[complexExp(complexImaginaryUnit * complexOfReal(R[R[2 *
    realPi * realNat(n + 1)] * Y])) - 1] ∈ ℂ by typecheck
  have power := complexOfReal.mem at realRpow(Y, R[v - 1])
  rw [(complexConj.mul with shifted, power), complexConj.of_real]
  have negOne : ℂ[-1] ∈ ℂ by typecheck
  rw [(complexConj.add with wave, negOne), complexExp.conj_i_real,
    (complexConj.neg with one), complexConj.one]
  -- The phases: e^(−iβa) e^(iβy) = e^(iβ(y−a)).
  have phaseMinus : expTwoPiI(R[realNat(n + 1) * -a]) =
      complexExp(ℂ[-(complexImaginaryUnit * complexOfReal(R[R[2 * realPi *
        realNat(n + 1)] * a]))])
    unfold expTwoPiI
    have same : ℂ[complexImaginaryUnit * complexOfReal(R[2 * realPi *
        R[realNat(n + 1) * -a]])] = ℂ[-(complexImaginaryUnit *
        complexOfReal(R[R[2 * realPi * realNat(n + 1)] * a]))]
      have inner : R[2 * realPi * R[realNat(n + 1) * -a]] =
        R[-R[R[2 * realPi * realNat(n + 1)] * a]] by ring
      rw [inner, complexOfReal.neg]
      ring
    rw same
  have phasePlus : expTwoPiI(R[realNat(n + 1) * a]) =
      complexExp(ℂ[complexImaginaryUnit * complexOfReal(R[R[2 * realPi *
        realNat(n + 1)] * a])])
    unfold expTwoPiI
    have inner : R[2 * realPi * R[realNat(n + 1) * a]] =
      R[R[2 * realPi * realNat(n + 1)] * a] by ring
    rw inner
  rw [phaseMinus, phasePlus]
  have negAngle : R[R[2 * realPi * realNat(n + 1)] * R[-a]] =
    R[-R[R[2 * realPi * realNat(n + 1)] * a]] by ring
  rw [negAngle, realCos.neg]
  have aAngle : ℂ[complexImaginaryUnit * complexOfReal(R[R[2 * realPi *
    realNat(n + 1)] * a])] ∈ ℂ by typecheck
  have minusAAngle : ℂ[-(complexImaginaryUnit * complexOfReal(R[R[2 * realPi *
    realNat(n + 1)] * a]))] ∈ ℂ by typecheck
  have minusYAngle : ℂ[-(complexImaginaryUnit * complexOfReal(R[R[2 * realPi *
    realNat(n + 1)] * Y]))] ∈ ℂ by typecheck
  have e1 := complexExp.add with angle, minusAAngle
  have e2 := complexExp.add with minusYAngle, aAngle
  have sum1 : ℂ[complexImaginaryUnit * complexOfReal(R[R[2 * realPi *
      realNat(n + 1)] * Y]) + -(complexImaginaryUnit * complexOfReal(R[R[2 *
      realPi * realNat(n + 1)] * a]))] = ℂ[complexImaginaryUnit *
      complexOfReal(R[R[2 * realPi * realNat(n + 1)] * R[Y - a]])]
    have inner : R[R[2 * realPi * realNat(n + 1)] * R[Y - a]] =
      R[R[2 * realPi * realNat(n + 1)] * Y - R[2 * realPi * realNat(n + 1)] *
        a] by ring
    rw [inner, complexOfReal.sub]
    ring
  have sum2 : ℂ[-(complexImaginaryUnit * complexOfReal(R[R[2 * realPi *
      realNat(n + 1)] * Y])) + complexImaginaryUnit * complexOfReal(R[R[2 *
      realPi * realNat(n + 1)] * a])] = ℂ[-(complexImaginaryUnit *
      complexOfReal(R[R[2 * realPi * realNat(n + 1)] * R[Y - a]]))]
    have inner : R[R[2 * realPi * realNat(n + 1)] * R[Y - a]] =
      R[R[2 * realPi * realNat(n + 1)] * Y - R[2 * realPi * realNat(n + 1)] *
        a] by ring
    rw [inner, complexOfReal.sub]
    ring
  rw sum1 at e1
  rw sum2 at e2
  have c1 := realCos.exp_form at R[R[2 * realPi * realNat(n + 1)] * R[Y - a]]
  have c2 := realCos.exp_form at R[R[2 * realPi * realNat(n + 1)] * a]
  have halfFact : ℂ[2 * complexOfReal(R[1 / 2])] = ℂ[1]
    have twoMember : ℂ[2] ∈ ℂ by typecheck
    rw complexOfReal.half
    exact complexInv.mul_cancel with twoMember, complexTwo.nonzero
  have cos1 := realCos.real at R[R[2 * realPi * realNat(n + 1)] * R[Y - a]]
  have cos2 := realCos.real at R[R[2 * realPi * realNat(n + 1)] * a]
  have inverseReal := realInvValue.real at R[realPi * realPi * realNat(n + 1) *
    realNat(n + 1)]
  have powerReal := realRpow.real at Y, R[v - 1]
  rw [complexOfReal.mul, complexOfReal.mul, complexOfReal.sub,
    complexOfReal.mul]
  have k := complexOfReal.mem at R[1 / 2]
  have m1 := complexOfReal.mem at realInvValue(R[realPi * realPi *
    realNat(n + 1) * realNat(n + 1)])
  have m2 := complexOfReal.mem at realRpow(Y, R[v - 1])
  have m3 := complexOfReal.mem at realCos(R[R[2 * realPi * realNat(n + 1)] *
    R[Y - a]])
  have m4 := complexOfReal.mem at realCos(R[R[2 * realPi * realNat(n + 1)] *
    a])
  have x1 := complexExp.member with aAngle
  have x2 := complexExp.member with minusAAngle
  have x3 := complexExp.member with minusYAngle
  linear_combination (complexOfReal(realInvValue(R[realPi * realPi *
    realNat(n + 1) * realNat(n + 1)])) * complexOfReal(R[1 / 2]) *
    complexOfReal(realRpow(Y, R[v - 1]))) * e1 +
    (complexOfReal(realInvValue(R[realPi * realPi * realNat(n + 1) *
    realNat(n + 1)])) * complexOfReal(R[1 / 2]) *
    complexOfReal(realRpow(Y, R[v - 1]))) * e2 +
    (complexOfReal(realInvValue(R[realPi * realPi * realNat(n + 1) *
    realNat(n + 1)])) * complexOfReal(R[1 / 2]) *
    complexOfReal(realRpow(Y, R[v - 1]))) * c1 +
    (-(complexOfReal(realInvValue(R[realPi * realPi * realNat(n + 1) *
    realNat(n + 1)])) * complexOfReal(R[1 / 2]) *
    complexOfReal(realRpow(Y, R[v - 1])))) * c2 +
    (-(complexOfReal(realInvValue(R[realPi * realPi * realNat(n + 1) *
    realNat(n + 1)])) * complexOfReal(realRpow(Y, R[v - 1])) *
    (complexOfReal(realCos(R[R[2 * realPi * realNat(n + 1)] * R[Y - a]])) -
    complexOfReal(realCos(R[R[2 * realPi * realNat(n + 1)] * a]))))) *
    halfFact

-- The integral over (0, ∞) of the n-th term: with s = v + 2,
-- C = (2π)^(−v)/(2π²) Γ(v) and ε = e^(iπv/2),
-- C (ε e^(−2πi(n+1)a) (n + 1)^(−s) + ε̄ e^(2πi(n+1)a) (n + 1)^(−s)).
theorem fourierMellinTerm.singular (a v : Real) (n : Nat)
  requires lower : R[-1] < v
  requires upper : v < R[0]
  shows HasSingularIntegral(fourierMellinTerm(a, v, n),
    ℂ[complexOfReal(R[realRpow(R[2 * realPi], R[-v]) *
        realInvValue(R[realPi * realPi]) * (1 / 2)]) *
      Gamma(complexOfReal(v)) *
      (complexExp(complexImaginaryUnit * complexOfReal(R[v * realHalfPi])) *
          periodicZetaTerms(R[-a], complexOfReal(R[v + 2]))(n) +
        complexExp(-(complexImaginaryUnit *
          complexOfReal(R[v * realHalfPi]))) *
          periodicZetaTerms(a, complexOfReal(R[v + 2]))(n))])
proof
  have nMember : n ∈ ℕ by typecheck
  have piPositive := realPi.positive
  have nPositive := realNat.plus_one_positive at n
  have betaPositive : R[0] < R[2 * realPi * realNat(n + 1)]
    have twoPi : R[0] < R[2 * realPi] by linarith
    have product := realLess.mul_left_of_positive with nPositive, twoPi
    have zero : R[R[2 * realPi] * 0] = R[0] by ring
    linarith
  have exponential := mellin.exp with betaPositive, lower, upper
  have expValues : ComplexValuedOn(mellinExpIntegrand(R[2 * realPi *
      realNat(n + 1)], v), ℝ)
    intros X hX
    exact FunctionBetween.apply_closed with (mellinExpIntegrand.function at
      R[2 * realPi * realNat(n + 1)], v), hX
  have conjValues : ComplexValuedOn(mellinConjIntegrand(R[2 * realPi *
      realNat(n + 1)], v), ℝ)
    intros X hX
    exact FunctionBetween.apply_closed with (mellinConjIntegrand.function at
      R[2 * realPi * realNat(n + 1)], v), hX
  have conjugate : ∀ X ∈ ℝ, mellinConjIntegrand(R[2 * realPi *
      realNat(n + 1)], v)(X) = complexConj(mellinExpIntegrand(R[2 * realPi *
      realNat(n + 1)], v)(X))
    intros X xMember
    exact mellinConjIntegrand.value with xMember
  have conjugated := HasSingularIntegral.conj with exponential, conjValues,
    conjugate
  have termValues : ComplexValuedOn(fourierMellinTerm(a, v, n), ℝ)
    intros X hX
    exact FunctionBetween.apply_closed with (fourierMellinTerm.function at a, v,
      n), hX
  have k := complexOfReal.mem at R[realInvValue(R[realPi * realPi *
    realNat(n + 1) * realNat(n + 1)]) * (1 / 2)]
  have phaseMinus := expTwoPiI.member at R[realNat(n + 1) * -a]
  have phasePlus := expTwoPiI.member at R[realNat(n + 1) * a]
  have c1 : ℂ[complexOfReal(R[realInvValue(R[realPi * realPi * realNat(n + 1) *
    realNat(n + 1)]) * (1 / 2)]) * expTwoPiI(R[realNat(n + 1) * -a])] ∈ ℂ
    by typecheck
  have c2 : ℂ[complexOfReal(R[realInvValue(R[realPi * realPi * realNat(n + 1) *
    realNat(n + 1)]) * (1 / 2)]) * expTwoPiI(R[realNat(n + 1) * a])] ∈ ℂ
    by typecheck
  have formula : ∀ X ∈ ℝ, fourierMellinTerm(a, v, n)(X) =
      ℂ[complexOfReal(R[realInvValue(R[realPi * realPi * realNat(n + 1) *
        realNat(n + 1)]) * (1 / 2)]) * expTwoPiI(R[realNat(n + 1) * -a]) *
        mellinExpIntegrand(R[2 * realPi * realNat(n + 1)], v)(X) +
      complexOfReal(R[realInvValue(R[realPi * realPi * realNat(n + 1) *
        realNat(n + 1)]) * (1 / 2)]) * expTwoPiI(R[realNat(n + 1) * a]) *
        mellinConjIntegrand(R[2 * realPi * realNat(n + 1)], v)(X)]
    intros X xMember
    have typedX : Real(X) by exact xMember
    exact fourierMellinTerm.combination at a, v, n, X
  have combined := HasSingularIntegral.combination with c1, c2, exponential,
    conjugated, termValues, formula
  -- Simplify the value.
  have angle : ℂ[complexImaginaryUnit * complexOfReal(R[v * realHalfPi])] ∈ ℂ
    by typecheck
  have phase := complexExp.member with angle
  have gamma := Gamma.member at complexOfReal(v)
  have betaPower := complexOfReal.mem at realRpow(R[2 * realPi *
    realNat(n + 1)], R[-v])
  have powerGamma : ℂ[complexOfReal(realRpow(R[2 * realPi * realNat(n + 1)],
    R[-v])) * Gamma(complexOfReal(v))] ∈ ℂ by typecheck
  rw [(complexConj.mul with phase, powerGamma), complexExp.conj_i_real,
    (complexConj.mul with betaPower, gamma), complexConj.of_real,
    (Gamma.conj_between with lower, upper)] at combined
  have sMember : complexOfReal(R[v + 2]) ∈ ℂ by typecheck
  have minusA : R[-a] ∈ ℝ by typecheck
  have negS : ℂ[-complexOfReal(R[v + 2])] = complexOfReal(R[-(v + 2)])
    rw complexOfReal.neg
  rw [(periodicZetaTerms.value at R[-a], complexOfReal(R[v + 2]), n with
    sMember, nMember), (periodicZetaTerms.value at a, complexOfReal(R[v + 2]),
    n with sMember, nMember), negS, realCpow.of_real]
  -- The real constants: β^(−v)/(2π²(n+1)²) = (2π)^(−v)/(2π²) (n+1)^(−v−2).
  have twoPiPositive : R[0] < R[2 * realPi] by linarith
  have split := realRpow.mul_base at R[2 * realPi], realNat(n + 1), R[-v] with
    twoPiPositive, nPositive
  have nSquare := realRpow.add at realNat(n + 1), R[-(v + 2)], R[2] with
    nPositive
  have twoExponent := realRpow.add at realNat(n + 1), R[1], R[1] with
    nPositive
  rw [(realRpow.one with nPositive)] at twoExponent
  have e1 : R[-(v + 2) + 2] = R[-v] by ring
  have e2 : R[1 + 1] = R[2] by ring
  rw e1 at nSquare
  rw e2 at twoExponent
  rw twoExponent at nSquare
  have piNonzero : R[realPi * realPi] ≠ R[0]
    have square := realLess.mul_left_of_positive with piPositive, piPositive
    have zero : R[realPi * 0] = R[0] by ring
    linarith
  have nNonzero : R[realNat(n + 1) * realNat(n + 1)] ≠ R[0]
    have square := realLess.mul_left_of_positive with nPositive, nPositive
    have zero : R[realNat(n + 1) * 0] = R[0] by ring
    linarith
  have nInverse := realInvValue.mul_right with nNonzero
  have inverseSplit := realInvValue.mul at R[realPi * realPi],
    R[realNat(n + 1) * realNat(n + 1)] with piNonzero, nNonzero
  have reshape : R[realPi * realPi * realNat(n + 1) * realNat(n + 1)] =
    R[R[realPi * realPi] * R[realNat(n + 1) * realNat(n + 1)]] by ring
  have real : R[realInvValue(R[realPi * realPi * realNat(n + 1) *
      realNat(n + 1)]) * (1 / 2) * realRpow(R[2 * realPi * realNat(n + 1)],
      R[-v])] = R[realRpow(R[2 * realPi], R[-v]) *
      realInvValue(R[realPi * realPi]) * (1 / 2) *
      realRpow(realNat(n + 1), R[-(v + 2)])]
    rw [reshape, inverseSplit, split, nSquare]
    have p1 := realRpow.real at R[2 * realPi], R[-v]
    have p2 := realRpow.real at realNat(n + 1), R[-(v + 2)]
    have i1 := realInvValue.real at R[realPi * realPi]
    have i2 := realInvValue.real at R[realNat(n + 1) * realNat(n + 1)]
    linear_combination (realRpow(R[2 * realPi], R[-v]) *
      realInvValue(R[realPi * realPi]) * (1 / 2) *
      realRpow(realNat(n + 1), R[-(v + 2)])) * nInverse
  have lifted : ℂ[complexOfReal(R[realInvValue(R[realPi * realPi *
      realNat(n + 1) * realNat(n + 1)]) * (1 / 2)]) *
      complexOfReal(realRpow(R[2 * realPi * realNat(n + 1)], R[-v]))] =
      ℂ[complexOfReal(R[realRpow(R[2 * realPi], R[-v]) *
      realInvValue(R[realPi * realPi]) * (1 / 2)]) *
      complexOfReal(realRpow(realNat(n + 1), R[-(v + 2)]))]
    rw [← complexOfReal.mul, ← complexOfReal.mul, real]
  have conjAngle : ℂ[-(complexImaginaryUnit * complexOfReal(R[v *
    realHalfPi]))] ∈ ℂ by typecheck
  have conjPhase := complexExp.member with conjAngle
  have q := complexOfReal.mem at realRpow(realNat(n + 1), R[-(v + 2)])
  have t := complexOfReal.mem at R[realRpow(R[2 * realPi], R[-v]) *
    realInvValue(R[realPi * realPi]) * (1 / 2)]
  have same : ℂ[complexOfReal(R[realInvValue(R[realPi * realPi *
      realNat(n + 1) * realNat(n + 1)]) * (1 / 2)]) *
      expTwoPiI(R[realNat(n + 1) * -a]) *
      (complexExp(complexImaginaryUnit * complexOfReal(R[v * realHalfPi])) *
      (complexOfReal(realRpow(R[2 * realPi * realNat(n + 1)], R[-v])) *
      Gamma(complexOfReal(v)))) + complexOfReal(R[realInvValue(R[realPi *
      realPi * realNat(n + 1) * realNat(n + 1)]) * (1 / 2)]) *
      expTwoPiI(R[realNat(n + 1) * a]) * (complexExp(-(complexImaginaryUnit *
      complexOfReal(R[v * realHalfPi]))) * (complexOfReal(realRpow(R[2 *
      realPi * realNat(n + 1)], R[-v])) * Gamma(complexOfReal(v))))] =
      ℂ[complexOfReal(R[realRpow(R[2 * realPi], R[-v]) *
      realInvValue(R[realPi * realPi]) * (1 / 2)]) *
      Gamma(complexOfReal(v)) * (complexExp(complexImaginaryUnit *
      complexOfReal(R[v * realHalfPi])) * (expTwoPiI(R[realNat(n + 1) * -a]) *
      complexOfReal(realRpow(realNat(n + 1), R[-(v + 2)]))) +
      complexExp(-(complexImaginaryUnit * complexOfReal(R[v * realHalfPi]))) *
      (expTwoPiI(R[realNat(n + 1) * a]) *
      complexOfReal(realRpow(realNat(n + 1), R[-(v + 2)]))))]
    linear_combination (Gamma(complexOfReal(v)) *
      (expTwoPiI(R[realNat(n + 1) * -a]) * complexExp(complexImaginaryUnit *
      complexOfReal(R[v * realHalfPi])) + expTwoPiI(R[realNat(n + 1) * a]) *
      complexExp(-(complexImaginaryUnit * complexOfReal(R[v * realHalfPi])))))
      * lifted
  rw same at combined
  exact combined

-- Section: Bounds for the Fourier terms
-- |cos U − cos W| ≤ |U − W|, by the mean value theorem.
theorem realCos.lipschitz (U W : Real)
  shows abs(R[realCos(U) - realCos(W)]) ≤ abs(R[U - W])
proof
  have cosFunction := realCos.function
  have differentiable : ∀ X ∈ ℝ, DifferentiableAt(realCos, X)
    intros X xMember
    have typedX : Real(X) by exact xMember
    exact HasDerivativeAt.differentiable_at with (realCos.derivative at X)
  have ordered : ∀ P ∈ ℝ, ∀ Q ∈ ℝ, P < Q →
      abs(R[realCos(Q) - realCos(P)]) ≤ R[Q - P]
    intros P pMember Q qMember less
    have typedP : Real(P) by exact pMember
    have typedQ : Real(Q) by exact qMember
    have onInterval : ∀ X ∈ closedInterval(P, Q), DifferentiableAt(realCos, X)
      intros X xMember
      exact differentiable with X, (closedInterval.membership.forward with
        xMember).left
    obtain ⟨C, cReal, _, _, mean⟩ := Taylor.mean_value at realCos, P, Q with
      less, onInterval
    have typedC : Real(C) by exact cReal
    have slope := derivative.of_has_derivative with (realCos.derivative at C)
    rw slope at mean
    have sinBound := realSin.abs_le_one at C
    have sinReal := realSin.real at C
    have difference : R[realCos(Q) - realCos(P)] = R[-realSin(C) * (Q - P)]
      rw mean
      ring
    rw [difference, abs.mul, abs.neg]
    have positive : R[0] ≤ R[Q - P] by linarith
    rw (abs.of_nonnegative with positive)
    have scaled := realLe.mul_right_of_nonnegative with sinBound, positive
    have one : R[1 * (Q - P)] = R[Q - P] by ring
    linarith
  have uReal : U ∈ ℝ by typecheck
  have wReal : W ∈ ℝ by typecheck
  by_cases same : U = W
  . rw same
    have zero : R[realCos(W) - realCos(W)] = R[0] by ring
    have zeroW : R[W - W] = R[0] by ring
    rw [zero, zeroW, abs.zero]
    linarith
  . by_cases less : U < W
    . have bound := ordered with U, uReal, W, wReal, less
      have flip : R[realCos(U) - realCos(W)] = R[-(realCos(W) - realCos(U))]
        by ring
      have flipArg : R[U - W] = R[-(W - U)] by ring
      rw [flip, flipArg, abs.neg, abs.neg]
      have positive : R[0] ≤ R[W - U] by linarith
      rw (abs.of_nonnegative with positive)
      exact bound
    . have greater : W < U
        by_contra notGreater
        apply same
        linarith
      have bound := ordered with W, wReal, U, uReal, greater
      have positive : R[0] ≤ R[U - W] by linarith
      rw (abs.of_nonnegative with positive)
      exact bound

-- min(2, x) ≤ (2x)^(1/2) for x ≥ 0, in the form needed for cosines.
theorem realCos.difference_sqrt (U W : Real)
  shows abs(R[realCos(U) - realCos(W)]) ≤
    realRpow(R[2 * abs(R[U - W])], R[1 / 2])
proof
  have lipschitz := realCos.lipschitz at U, W
  have boundU := realCos.abs_le_one at U
  have boundW := realCos.abs_le_one at W
  have cosU := realCos.real at U
  have cosW := realCos.real at W
  have triangle := abs.triangle at realCos(U), R[-realCos(W)]
  rw abs.neg at triangle
  have two : abs(R[realCos(U) - realCos(W)]) ≤ R[2] by linarith
  have nonnegative := abs.nonnegative at R[realCos(U) - realCos(W)]
  have xNonnegative := abs.nonnegative at R[U - W]
  by_cases zero : abs(R[realCos(U) - realCos(W)]) = R[0]
  . rw zero
    exact realLess.implies_le with (realRpow.positive at R[2 * abs(R[U - W])],
      R[1 / 2])
  . have positive : R[0] < abs(R[realCos(U) - realCos(W)])
      by_contra notPositive
      apply zero
      linarith
    -- d = d² ^ (1/2) and d² ≤ 2|U − W|.
    have square := realRpow.mul_exponent at abs(R[realCos(U) -
      realCos(W)]), R[2], R[1 / 2] with positive
    have exponent : R[2 * (1 / 2)] = R[1] by linarith
    rw [exponent, (realRpow.one with positive)] at square
    have squareValue := realRpow.add at abs(R[realCos(U) - realCos(W)]), R[1],
      R[1] with positive
    rw (realRpow.one with positive) at squareValue
    have sum : R[1 + 1] = R[2] by ring
    rw sum at squareValue
    rw squareValue at square
    have first := realLe.mul_left_of_nonnegative with two,
      (realLess.implies_le with positive)
    have second := realLe.mul_left_of_nonnegative with lipschitz,
      (realLess.implies_le with positive)
    have productBound : R[abs(R[realCos(U) - realCos(W)]) *
        abs(R[realCos(U) - realCos(W)])] ≤ R[2 * abs(R[U - W])]
      have chain := realLe.mul_right_of_nonnegative with two, xNonnegative
      have swap : R[abs(R[realCos(U) - realCos(W)]) * abs(R[U - W])] =
        R[abs(R[U - W]) * abs(R[realCos(U) - realCos(W)])] by ring
      have twoSwap : R[2 * abs(R[U - W])] = R[R[2] * abs(R[U - W])] by ring
      linarith
    have productPositive := realLess.mul_left_of_positive with positive,
      positive
    have zeroP : R[abs(R[realCos(U) - realCos(W)]) * 0] = R[0] by ring
    rw zeroP at productPositive
    have half : R[0] < R[1 / 2] by linarith
    by_cases equal : R[abs(R[realCos(U) - realCos(W)]) *
        abs(R[realCos(U) - realCos(W)])] = R[2 * abs(R[U - W])]
    . rw ← equal
      rw square
      linarith
    . have strict : R[abs(R[realCos(U) - realCos(W)]) *
          abs(R[realCos(U) - realCos(W)])] < R[2 * abs(R[U - W])]
        by_contra notLess
        apply equal
        linarith
      have monotone := realRpow.lt_of_base with productPositive, strict, half
      rw square at monotone
      linarith

-- 1/(x·x) = x^(−2) for x > 0.
theorem realRpow.inverse_square (X : Real)
  requires positive : R[0] < X
  shows realInvValue(R[X * X]) = realRpow(X, R[-2])
proof
  rw (realRpow.neg at X, R[2] with positive)
  have square := realRpow.add at X, R[1], R[1] with positive
  rw (realRpow.one with positive) at square
  have sum : R[1 + 1] = R[2] by ring
  rw sum at square
  rw [square, realDiv.eq_mul_inv]
  ring

-- The bounds K y^(1/2) (n + 1)^(−3/2) and (2/π²)(n + 1)^(−2) for the n-th
-- term (cos 2π(n+1)(y − a) − cos 2π(n+1)a)/(π²(n + 1)²), y > 0.
theorem fourierDifferenceTerms.bounds (a Y : Real) (n : Nat)
  requires positive : R[0] < Y
  shows abs(fourierDifferenceTerms(R[Y - a], R[-a])(n)) ≤
      R[realRpow(R[4 * realPi], R[1 / 2]) * realInvValue(R[realPi * realPi]) *
        realRpow(Y, R[1 / 2]) * realRpow(realNat(n + 1), R[-3 / 2])] ∧
    abs(fourierDifferenceTerms(R[Y - a], R[-a])(n)) ≤
      R[2 * realInvValue(R[realPi * realPi]) *
        realRpow(realNat(n + 1), R[-2])]
proof
  have nMember : n ∈ ℕ by typecheck
  have piPositive := realPi.positive
  have nPositive := realNat.plus_one_positive at n
  rw (fourierDifferenceTerms.value at R[Y - a], R[-a], n with nMember)
  have piSquare := realLess.mul_left_of_positive with piPositive, piPositive
  have zeroPi : R[realPi * 0] = R[0] by ring
  rw zeroPi at piSquare
  have nSquare := realLess.mul_left_of_positive with nPositive, nPositive
  have zeroN : R[realNat(n + 1) * 0] = R[0] by ring
  rw zeroN at nSquare
  have piNonzero : R[realPi * realPi] ≠ R[0] by linarith
  have nNonzero : R[realNat(n + 1) * realNat(n + 1)] ≠ R[0] by linarith
  have split := realInvValue.mul at R[realPi * realPi],
    R[realNat(n + 1) * realNat(n + 1)] with piNonzero, nNonzero
  have reshape : R[realPi * realPi * realNat(n + 1) * realNat(n + 1)] =
    R[R[realPi * realPi] * R[realNat(n + 1) * realNat(n + 1)]] by ring
  rw [reshape, split, (realRpow.inverse_square with nPositive)]
  have piInverse := realInvValue.positive with piSquare
  have nPower := realRpow.positive at realNat(n + 1), R[-2]
  have factorPositive := realLess.mul_left_of_positive with nPower, piInverse
  have zeroF : R[realInvValue(R[realPi * realPi]) * 0] = R[0] by ring
  rw zeroF at factorPositive
  have cosA := realCos.real at R[2 * realPi * realNat(n + 1) * R[Y - a]]
  have cosB := realCos.real at R[2 * realPi * realNat(n + 1) * R[-a]]
  rw [abs.mul, (abs.of_nonnegative with (realLess.implies_le with
    factorPositive))]
  have difference := realCos.difference_sqrt at R[2 * realPi *
    realNat(n + 1) * R[Y - a]], R[2 * realPi * realNat(n + 1) * R[-a]]
  have argument : R[2 * realPi * realNat(n + 1) * R[Y - a] - 2 * realPi *
    realNat(n + 1) * R[-a]] = R[2 * realPi * realNat(n + 1) * Y] by ring
  rw argument at difference
  have twoPi : R[0] < R[2 * realPi] by linarith
  have bn := realLess.mul_left_of_positive with nPositive, twoPi
  have zero2 : R[R[2 * realPi] * 0] = R[0] by ring
  rw zero2 at bn
  have bnY := realLess.mul_left_of_positive with positive, bn
  have zero3 : R[R[R[2 * realPi] * realNat(n + 1)] * 0] = R[0] by ring
  rw zero3 at bnY
  have absArg : abs(R[2 * realPi * realNat(n + 1) * Y]) =
      R[2 * realPi * realNat(n + 1) * Y]
    exact abs.of_nonnegative with (realLess.implies_le with bnY)
  rw absArg at difference
  have fourPi : R[0] < R[4 * realPi] by linarith
  have regroup : R[2 * R[2 * realPi * realNat(n + 1) * Y]] =
    R[R[R[4 * realPi] * realNat(n + 1)] * Y] by ring
  rw regroup at difference
  have product1 := realLess.mul_left_of_positive with nPositive, fourPi
  have zero4 : R[R[4 * realPi] * 0] = R[0] by ring
  rw zero4 at product1
  rw [(realRpow.mul_base with product1, positive), (realRpow.mul_base with
    fourPi, nPositive)] at difference
  have combine := realRpow.add at realNat(n + 1), R[1 / 2], R[-2] with
    nPositive
  have exponent : R[1 / 2 + -2] = R[-3 / 2] by linarith
  rw exponent at combine
  have p1 := realRpow.real at R[4 * realPi], R[1 / 2]
  have p2 := realRpow.real at realNat(n + 1), R[1 / 2]
  have p3 := realRpow.real at Y, R[1 / 2]
  have p4 := realRpow.real at realNat(n + 1), R[-2]
  have i1 := realInvValue.real at R[realPi * realPi]
  have nonnegativeFactor : R[0] ≤ R[realInvValue(R[realPi * realPi]) *
    realRpow(realNat(n + 1), R[-2])] by linarith
  have scaled := realLe.mul_right_of_nonnegative with difference,
    nonnegativeFactor
  have cosBoundA := realCos.abs_le_one at R[2 * realPi * realNat(n + 1) *
    R[Y - a]]
  have cosBoundB := realCos.abs_le_one at R[2 * realPi * realNat(n + 1) *
    R[-a]]
  have triangle := abs.triangle at realCos(R[2 * realPi * realNat(n + 1) *
    R[Y - a]]), R[-realCos(R[2 * realPi * realNat(n + 1) * R[-a]])]
  rw abs.neg at triangle
  have two : abs(R[realCos(R[2 * realPi * realNat(n + 1) * R[Y - a]]) -
    realCos(R[2 * realPi * realNat(n + 1) * R[-a]])]) ≤ R[2] by linarith
  have scaledTwo := realLe.mul_right_of_nonnegative with two,
    nonnegativeFactor
  refine ⟨?_, ?_⟩
  . have shape : R[realRpow(R[4 * realPi], R[1 / 2]) *
        realRpow(realNat(n + 1), R[1 / 2]) * realRpow(Y, R[1 / 2]) *
        (realInvValue(R[realPi * realPi]) * realRpow(realNat(n + 1), R[-2]))] =
        R[realRpow(R[4 * realPi], R[1 / 2]) * realInvValue(R[realPi * realPi]) *
        realRpow(Y, R[1 / 2]) * realRpow(realNat(n + 1), R[-3 / 2])]
      rw combine
      ring
    linarith
  . have shape : R[2 * (realInvValue(R[realPi * realPi]) *
        realRpow(realNat(n + 1), R[-2]))] = R[2 * realInvValue(R[realPi *
        realPi]) * realRpow(realNat(n + 1), R[-2])] by ring
    linarith

-- The remainder of a series dominated termwise: |S − Σ_{n<N} cₙ| is at
-- most B − Σ_{n<N} bₙ when |cₙ| ≤ bₙ and Σ bₙ = B.
theorem SumsTo.remainder_bound (c b : Set) (S B : Real) (N : Nat)
  requires sumsC : SumsTo(c, S)
  requires sumsB : SumsTo(b, B)
  requires dominated : ∀ n ∈ ℕ, abs(c(n)) ≤ b(n)
  shows abs(R[S - realPartialSum(c, N)]) ≤ R[B - realPartialSum(b, N)]
proof
  have sequenceC := SumsTo.sequence with sumsC
  have sequenceB := SumsTo.sequence with sumsB
  have difference := SumsTo.sub with sumsB, sumsC
  have total := SumsTo.add with sumsB, sumsC
  have nonnegativeDifference : NonnegativeTerms(subSequence(b, c))
    intros n nMember
    have typedN := nat.omega.backward with nMember
    have bReal := RealSequence.value at b, n with sequenceB
    have cReal := RealSequence.value at c, n with sequenceC
    rw (subSequence.value at b, c, n with sequenceB, sequenceC, bReal, cReal)
    have bound := dominated with n, nMember
    have upper := abs.upper at c(n)
    apply realLe.characterization.forward
    linarith
  have nonnegativeTotal : NonnegativeTerms(addSequence(b, c))
    intros n nMember
    have typedN := nat.omega.backward with nMember
    have bReal := RealSequence.value at b, n with sequenceB
    have cReal := RealSequence.value at c, n with sequenceC
    rw (addSequence.value at b, c, n with sequenceB, sequenceC, bReal, cReal)
    have bound := dominated with n, nMember
    have upper := abs.upper at R[-c(n)]
    rw abs.neg at upper
    apply realLe.characterization.forward
    linarith
  have partialDifference := SumsTo.partial_le at subSequence(b, c),
    realSubValue(B, S), N with difference, nonnegativeDifference
  have partialTotal := SumsTo.partial_le at addSequence(b, c),
    R[B + S], N with total, nonnegativeTotal
  unfold realSubValue at partialDifference
  rw (realPartialSum.sub with sequenceB, sequenceC) at partialDifference
  rw (realPartialSum.add with sequenceB, sequenceC) at partialTotal
  apply abs.le_of_two_sided
  . linarith
  . linarith

-- Section: The series of the Fourier terms
-- The integrals of the terms, and the partial sums of the terms.
defgraph fourierMellinValues (a v : Real) (n ∈ ℕ) : complexCarrier :=
  ℂ[complexOfReal(R[realRpow(R[2 * realPi], R[-v]) *
      realInvValue(R[realPi * realPi]) * (1 / 2)]) *
    Gamma(complexOfReal(v)) *
    (complexExp(complexImaginaryUnit * complexOfReal(R[v * realHalfPi])) *
        periodicZetaTerms(R[-a], complexOfReal(R[v + 2]))(n) +
      complexExp(-(complexImaginaryUnit * complexOfReal(R[v * realHalfPi]))) *
        periodicZetaTerms(a, complexOfReal(R[v + 2]))(n))]
proof
  have sMember : complexOfReal(R[v + 2]) ∈ ℂ by typecheck
  have first := FunctionBetween.apply_closed with (periodicZetaTerms.function
    at R[-a], complexOfReal(R[v + 2]) with sMember), member
  have second := FunctionBetween.apply_closed with (periodicZetaTerms.function
    at a, complexOfReal(R[v + 2]) with sMember), member
  have gamma := Gamma.member at complexOfReal(v)
  have angle : ℂ[complexImaginaryUnit * complexOfReal(R[v * realHalfPi])] ∈ ℂ
    by typecheck
  have conjAngle : ℂ[-(complexImaginaryUnit * complexOfReal(R[v *
    realHalfPi]))] ∈ ℂ by typecheck
  have phase := complexExp.member with angle
  have conjPhase := complexExp.member with conjAngle
  typecheck

defgraph fourierMellinPartial (a v : Real, N : Nat) (Y ∈ ℝ) :
    complexCarrier :=
  complexOfReal(R[realPartialSum(fourierDifferenceTerms(R[Y - a], R[-a]), N) *
    realRpow(Y, R[v - 1])])
proof
  have terms := fourierDifferenceTerms.function at R[Y - a], R[-a]
  have sequence : RealSequence(fourierDifferenceTerms(R[Y - a], R[-a])) by
    exact terms
  have sum := realPartialSum.real at fourierDifferenceTerms(R[Y - a], R[-a]),
    N with sequence
  typecheck

theorem fourierMellinPartial.singular (a v : Real) (N : Nat)
  requires lower : R[-1] < v
  requires upper : v < R[0]
  shows HasSingularIntegral(fourierMellinPartial(a, v, N),
    complexPartialSum(fourierMellinValues(a, v), N))
proof
  induction N
  | zero =>
    have first := fourierMellinTerm.singular at a, v, 0 with lower, upper
    have zero : ℂ[0] ∈ ℂ by typecheck
    have values : ComplexValuedOn(fourierMellinPartial(a, v, 0), ℝ)
      intros X hX
      exact FunctionBetween.apply_closed with (fourierMellinPartial.function at
        a, v, 0), hX
    have formula : ∀ X ∈ ℝ, fourierMellinPartial(a, v, 0)(X) =
        ℂ[0 * fourierMellinTerm(a, v, 0)(X) + 0 * fourierMellinTerm(a, v, 0)(X)]
      intros X xMember
      have typedX : Real(X) by exact xMember
      have term := FunctionBetween.apply_closed with (fourierMellinTerm.function
        at a, v, 0), xMember
      rw [(fourierMellinPartial.value at a, v, 0, X with xMember),
        realPartialSum.zero]
      have zeroProduct : R[0 * realRpow(X, R[v - 1])] = R[0] by ring
      rw [zeroProduct, complexOfReal.zero]
      ring
    have combined := HasSingularIntegral.combination with zero, zero, first,
      first, values, formula
    have zeroMember : (0:N) ∈ ℕ by typecheck
    rw ← (fourierMellinValues.value at a, v, 0 with zeroMember) at combined
    have member := FunctionBetween.apply_closed with
      (fourierMellinValues.function at a, v), zeroMember
    have vanish : ℂ[0 * fourierMellinValues(a, v)((0:N)) +
        0 * fourierMellinValues(a, v)((0:N))] = ℂ[0] by ring
    rw vanish at combined
    rw complexPartialSum.zero
    exact combined
  | succ(k) using ih =>
    have kMember : k ∈ ℕ by typecheck
    have term := fourierMellinTerm.singular at a, v, k with lower, upper
    have one : ℂ[1] ∈ ℂ by typecheck
    have values : ComplexValuedOn(fourierMellinPartial(a, v, succ(k)), ℝ)
      intros X hX
      exact FunctionBetween.apply_closed with (fourierMellinPartial.function at
        a, v, succ(k)), hX
    have formula : ∀ X ∈ ℝ, fourierMellinPartial(a, v, succ(k))(X) =
        ℂ[1 * fourierMellinPartial(a, v, k)(X) +
          1 * fourierMellinTerm(a, v, k)(X)]
      intros X xMember
      have typedX : Real(X) by exact xMember
      have terms := fourierDifferenceTerms.function at R[X - a], R[-a]
      have sequence : RealSequence(fourierDifferenceTerms(R[X - a], R[-a])) by
        exact terms
      have sumReal := realPartialSum.real at fourierDifferenceTerms(R[X - a],
        R[-a]), k with sequence
      have termReal := FunctionBetween.apply_closed with terms, kMember
      have termTyped : Real(fourierDifferenceTerms(R[X - a], R[-a])(k)) by
        exact termReal
      have powerReal := realRpow.real at X, R[v - 1]
      rw [(fourierMellinPartial.value at a, v, succ(k), X with xMember),
        (fourierMellinPartial.value at a, v, k, X with xMember),
        (fourierMellinTerm.value at a, v, k, X with xMember),
        realPartialSum.succ, realAddValue.eq_add]
      rw [complexOfReal.mul, complexOfReal.mul, complexOfReal.mul,
        complexOfReal.add]
      ring
    have combined := HasSingularIntegral.combination with one, one, ih, term,
      values, formula
    rw ← (fourierMellinValues.value at a, v, k with kMember) at combined
    have sequence := fourierMellinValues.function at a, v
    have member := FunctionBetween.apply_closed with sequence, kMember
    have sumMember := complexPartialSum.member at fourierMellinValues(a, v), k
      with sequence
    have unit : ℂ[1 * complexPartialSum(fourierMellinValues(a, v), k) +
        1 * fourierMellinValues(a, v)(k)] = ℂ[complexPartialSum(
        fourierMellinValues(a, v), k) + fourierMellinValues(a, v)(k)] by ring
    rw unit at combined
    rw complexPartialSum.succ
    exact combined

theorem SumsTo.remainder_bound_scaled (c b : Set) (S B C : Real) (N : Nat)
  requires sumsC : SumsTo(c, S)
  requires sumsB : SumsTo(b, B)
  requires dominated : ∀ n ∈ ℕ, abs(c(n)) ≤ R[C * b(n)]
  shows abs(R[S - realPartialSum(c, N)]) ≤
    R[C * (B - realPartialSum(b, N))]
proof
  have sequenceB := SumsTo.sequence with sumsB
  have scaled := SumsTo.scale at b, B, C with sumsB
  have constant := constantSequence.sequence at C
  have dominatedScaled : ∀ n ∈ ℕ, abs(c(n)) ≤
      mulSequence(constantSequence(C), b)(n)
    intros n nMember
    have typedN := nat.omega.backward with nMember
    have bReal := RealSequence.value at b, n with sequenceB
    have constantReal : Real(constantSequence(C)(n))
      rw constantSequence.value
      typecheck
    rw [(mulSequence.value at constantSequence(C), b, n with constant,
      sequenceB, constantReal, bReal), constantSequence.value]
    exact dominated with n, nMember
  have bound := SumsTo.remainder_bound with sumsC, scaled, dominatedScaled
  rw (realPartialSum.scale with sequenceB) at bound
  have bSum := realPartialSum.real at b, N with sequenceB
  have reshape : R[C * B - C * realPartialSum(b, N)] =
    R[C * (B - realPartialSum(b, N))] by ring
  rw reshape at bound
  exact bound

-- The powers (n + 1)^S, summable for S < −1.
defgraph naturalPowers (S : Real) (n ∈ ℕ) : ℝ := realRpow(realNat(n + 1), S)
proof
  typecheck

theorem naturalPowers.summable (S : Real)
  requires below : S < R[-1]
  shows ∃ Z ∈ ℝ, SumsTo(naturalPowers(S), Z)
proof
  have sMember : complexOfReal(R[-S]) ∈ ℂ by typecheck
  have large : realOne < complexRe(complexOfReal(R[-S]))
    rw complexOfReal.re
    linarith
  obtain ⟨_, absolute⟩ := zeta.series with sMember, large
  obtain ⟨sequence, summable⟩ := absolute
  have same : complexAbsSequence(zetaSeriesTerms(complexOfReal(R[-S]))) =
      naturalPowers(S)
    apply FunctionBetween.ext with (complexAbsSequence.function with sequence),
      (naturalPowers.function at S)
    intros n nMember
    have typedN := nat.omega.backward with nMember
    have negative : ℂ[-complexOfReal(R[-S])] ∈ ℂ by typecheck
    rw [(complexAbsSequence.value with sequence, nMember),
      (zetaSeriesTerms.value with sMember, nMember),
      (realCpow.abs with (realNat.plus_one_positive at n), negative),
      (complexRe.neg with sMember), complexOfReal.re, naturalPowers.value]
    have same : R[-R[-S]] = S by ring
    rw same
  rw same at summable
  exact summable

-- Section: The Fourier series of P̃₂
-- Product and sum rules for functions given by formulas.
theorem HasDerivativeAt.mul_formula (f g h : Set) (D E X : Real)
  requires functionH : h : ℝ → ℝ
  requires formula : ∀ Y ∈ ℝ, h(Y) = R[f(Y) * g(Y)]
  requires derivativeF : HasDerivativeAt(f, D, X)
  requires derivativeG : HasDerivativeAt(g, E, X)
  shows HasDerivativeAt(h, R[D * g(X) + f(X) * E], X)
proof
  have functionF := derivativeF.left
  have functionG := derivativeG.left
  have product := pointwiseMul.function with functionF, functionG
  have same : h = pointwiseMul(f, g)
    apply FunctionBetween.ext with functionH, product
    intros Y yMember
    have typedY : Real(Y) by exact yMember
    rw [(formula with Y, yMember), (pointwiseMul.apply with functionF,
      functionG)]
  rw same
  have rule := HasDerivativeAt.mul with derivativeF, derivativeG
  have xMember : X ∈ ℝ by typecheck
  have fx := FunctionBetween.apply_closed with functionF, xMember
  have gx := FunctionBetween.apply_closed with functionG, xMember
  have fReal : Real(f(X)) by exact fx
  have gReal : Real(g(X)) by exact gx
  rw [realMulValue.eq_mul, realMulValue.eq_mul, realAddValue.eq_add] at rule
  exact rule

theorem HasDerivativeAt.add_formula (f g h : Set) (D E X : Real)
  requires functionH : h : ℝ → ℝ
  requires formula : ∀ Y ∈ ℝ, h(Y) = R[f(Y) + g(Y)]
  requires derivativeF : HasDerivativeAt(f, D, X)
  requires derivativeG : HasDerivativeAt(g, E, X)
  shows HasDerivativeAt(h, R[D + E], X)
proof
  have functionF := derivativeF.left
  have functionG := derivativeG.left
  have sum := pointwiseAdd.function with functionF, functionG
  have same : h = pointwiseAdd(f, g)
    apply FunctionBetween.ext with functionH, sum
    intros Y yMember
    have typedY : Real(Y) by exact yMember
    have fy := FunctionBetween.apply_closed with functionF, yMember
    have gy := FunctionBetween.apply_closed with functionG, yMember
    have fReal : Real(f(Y)) by exact fy
    have gReal : Real(g(Y)) by exact gy
    rw [(formula with Y, yMember), (pointwiseAdd.value at f, g, Y with
      functionF, functionG, fReal, gReal)]
  rw same
  exact HasDerivativeAt.add with derivativeF, derivativeG

-- y ↦ sin(By), y ↦ cos(By), y ↦ y − x.
defgraph sinScaled (B : Real) (Y ∈ ℝ) : ℝ := realSin(R[B * Y])
proof
  typecheck

defgraph cosScaled (B : Real) (Y ∈ ℝ) : ℝ := realCos(R[B * Y])
proof
  typecheck

defgraph shiftLinear (x : Real) (Y ∈ ℝ) : ℝ := R[Y - x]
proof
  typecheck

theorem sinScaled.has_derivative (B X : Real)
  shows HasDerivativeAt(sinScaled(B), R[B * realCos(R[B * X])], X)
proof
  have formula : ∀ Y ∈ ℝ, sinScaled(B)(Y) = realSin(R[B * Y])
    intros Y yMember
    exact sinScaled.value with yMember
  have scaled := HasDerivativeAt.scaled_argument with realSin.function,
    (sinScaled.function at B), formula, (realSin.derivative at R[B * X])
  apply HasDerivativeAt.congr_value with scaled
  have c := realCos.real at R[B * X]
  ring

theorem cosScaled.has_derivative (B X : Real)
  shows HasDerivativeAt(cosScaled(B), R[-(B * realSin(R[B * X]))], X)
proof
  have formula : ∀ Y ∈ ℝ, cosScaled(B)(Y) = realCos(R[B * Y])
    intros Y yMember
    exact cosScaled.value with yMember
  have scaled := HasDerivativeAt.scaled_argument with realCos.function,
    (cosScaled.function at B), formula, (realCos.derivative at R[B * X])
  apply HasDerivativeAt.congr_value with scaled
  have s := realSin.real at R[B * X]
  ring

theorem shiftLinear.has_derivative (x X : Real)
  shows HasDerivativeAt(shiftLinear(x), R[1], X)
proof
  have identityFunction := identity.function at ℝ
  have constant := constantRealFunction.function at R[-x]
  have formula : ∀ Y ∈ ℝ, shiftLinear(x)(Y) =
      R[identity(ℝ)(Y) + constantRealFunction(R[-x])(Y)]
    intros Y yMember
    have typedY : Real(Y) by exact yMember
    rw [shiftLinear.value, (identity.apply with yMember),
      constantRealFunction.value]
    ring
  have rule := HasDerivativeAt.add_formula with (shiftLinear.function at x),
    formula, (identity.has_derivative_at at X),
    (constantRealFunction.has_derivative_at at R[-x], X)
  apply HasDerivativeAt.congr_value with rule
  ring

-- (τ − x) cos(Bτ) and its primitive (τ − x) sin(Bτ)/B + cos(Bτ)/B².
defgraph cosWeighted (x B : Real) (Y ∈ ℝ) : ℝ := R[(Y - x) * realCos(R[B * Y])]
proof
  typecheck

defgraph cosPrimitive (x B : Real) (Y ∈ ℝ) : ℝ :=
  R[(Y - x) * realSin(R[B * Y]) * realInvValue(B) +
    realCos(R[B * Y]) * realInvValue(R[B * B])]
proof
  typecheck

theorem cosPrimitive.has_derivative (x B X : Real)
  requires nonzero : B ≠ R[0]
  shows HasDerivativeAt(cosPrimitive(x, B), cosWeighted(x, B)(X), X)
proof
  have shift := shiftLinear.function at x
  have sinF := sinScaled.function at B
  have cosF := cosScaled.function at B
  have product := pointwiseMul.function with shift, sinF
  have productDerivative := HasDerivativeAt.mul with
    (shiftLinear.has_derivative at x, X), (sinScaled.has_derivative at B, X)
  have first := HasDerivativeAt.scale at pointwiseMul(shiftLinear(x),
    sinScaled(B)), realInvValue(B) with productDerivative
  have second := HasDerivativeAt.scale at cosScaled(B),
    realInvValue(R[B * B]) with (cosScaled.has_derivative at B, X)
  have constant1 := constantRealFunction.function at realInvValue(B)
  have constant2 := constantRealFunction.function at realInvValue(R[B * B])
  have scaled1 := pointwiseMul.function with constant1, product
  have scaled2 := pointwiseMul.function with constant2, cosF
  have formula : ∀ Y ∈ ℝ, cosPrimitive(x, B)(Y) =
      R[pointwiseMul(constantRealFunction(realInvValue(B)),
        pointwiseMul(shiftLinear(x), sinScaled(B)))(Y) +
      pointwiseMul(constantRealFunction(realInvValue(R[B * B])),
        cosScaled(B))(Y)]
    intros Y yMember
    have typedY : Real(Y) by exact yMember
    rw [cosPrimitive.value, (pointwiseMul.apply with constant1, product),
      (pointwiseMul.apply with shift, sinF), (pointwiseMul.apply with
      constant2, cosF), constantRealFunction.value,
      constantRealFunction.value, shiftLinear.value, sinScaled.value,
      cosScaled.value]
    ring
  have rule := HasDerivativeAt.add_formula with
    (cosPrimitive.function at x, B), formula, first, second
  apply HasDerivativeAt.congr_value with rule
  have xMember : X ∈ ℝ by typecheck
  rw [shiftLinear.value, sinScaled.value, cosWeighted.value]
  have inverse := realInvValue.mul_right with nonzero
  rw (realInvValue.mul with nonzero, nonzero)
  have s := realSin.real at R[B * X]
  have c := realCos.real at R[B * X]
  have i := realInvValue.real at B
  rw [realMulValue.eq_mul, realMulValue.eq_mul, realAddValue.eq_add]
  linear_combination ((X - x) * realCos(R[B * X]) - realInvValue(B) *
    realSin(R[B * X])) * inverse

theorem cosWeighted.integral (x B P Q : Real)
  requires nonzero : B ≠ R[0]
  requires ordered : P ≤ Q
  shows HasRiemannIntegral(cosWeighted(x, B), P, Q,
    R[cosPrimitive(x, B)(Q) - cosPrimitive(x, B)(P)])
proof
  have subset : closedInterval(P, Q) ⊆ ℝ
    intros X xMember
    exact (closedInterval.membership.forward with xMember).left
  have functionF := cosPrimitive.function at x, B
  have functionf := cosWeighted.function at x, B
  have continuousF : ContinuousOn(cosPrimitive(x, B), closedInterval(P, Q))
    apply ContinuousOn.of_differentiable with functionF, subset
    intros X xMember
    have typedX : Real(X) by exact (subset with X, xMember)
    exact HasDerivativeAt.differentiable_at with
      (cosPrimitive.has_derivative at x, B, X with nonzero)
  have shift := shiftLinear.function at x
  have cosF := cosScaled.function at B
  have formula : ∀ Y ∈ ℝ, cosWeighted(x, B)(Y) =
      R[shiftLinear(x)(Y) * cosScaled(B)(Y)]
    intros Y yMember
    have typedY : Real(Y) by exact yMember
    rw [cosWeighted.value, shiftLinear.value, cosScaled.value]
  have continuousf : ContinuousOn(cosWeighted(x, B), closedInterval(P, Q))
    apply ContinuousOn.of_differentiable with functionf, subset
    intros X xMember
    have typedX : Real(X) by exact (subset with X, xMember)
    exact HasDerivativeAt.differentiable_at with
      (HasDerivativeAt.mul_formula with functionf, formula,
        (shiftLinear.has_derivative at x, X),
        (cosScaled.has_derivative at B, X))
  have derivative : ∀ X ∈ ℝ, P < X → X < Q →
      HasDerivativeAt(cosPrimitive(x, B), cosWeighted(x, B)(X), X)
    intros X xMember low high
    have typedX : Real(X) by exact xMember
    exact cosPrimitive.has_derivative with nonzero
  have result := FTC.continuous_derivative at cosWeighted(x, B),
    cosPrimitive(x, B), P, Q with ordered, continuousF, derivative,
    continuousf
  have qMember : Q ∈ ℝ by typecheck
  have pMember : P ∈ ℝ by typecheck
  have fq := FunctionBetween.apply_closed with functionF, qMember
  have fp := FunctionBetween.apply_closed with functionF, pMember
  have fqReal : Real(cosPrimitive(x, B)(Q)) by exact fq
  have fpReal : Real(cosPrimitive(x, B)(P)) by exact fp
  unfold realSubValue at result
  exact result

-- (τ − x) Σ_{k<N} cos(2π(k + 1)τ).
defgraph cosSumTerms (Y : Real) (k ∈ ℕ) : ℝ :=
  realCos(R[2 * realPi * realNat(k + 1) * Y])
proof
  have typedK := nat.omega.backward with member
  typecheck

defgraph cosSumWeighted (x : Real, N : Nat) (Y ∈ ℝ) : ℝ :=
  R[(Y - x) * realPartialSum(cosSumTerms(Y), N)]
proof
  have sequence : RealSequence(cosSumTerms(Y)) by
    exact cosSumTerms.function at Y
  have sum := realPartialSum.real at cosSumTerms(Y), N with sequence
  typecheck

-- ∫_x^{1/2} (τ − x) cos(Bτ) dτ = −(1/4) of the n-th Fourier difference term,
-- B = 2π(n + 1).
theorem cosWeighted.integral_half (x : Real) (n : Nat)
  requires ordered : x ≤ R[1 / 2]
  shows HasRiemannIntegral(cosWeighted(x, R[2 * realPi * realNat(n + 1)]), x,
    R[1 / 2], R[-(1 / 4) * fourierDifferenceTerms(x, R[1 / 2])(n)])
proof
  have nMember : n ∈ ℕ by typecheck
  have piPositive := realPi.positive
  have nPositive := realNat.plus_one_positive at n
  have twoPi : R[0] < R[2 * realPi] by linarith
  have bPositive := realLess.mul_left_of_positive with nPositive, twoPi
  have zero2 : R[R[2 * realPi] * 0] = R[0] by ring
  rw zero2 at bPositive
  have bNonzero : R[2 * realPi * realNat(n + 1)] ≠ R[0] by linarith
  have integral := cosWeighted.integral at x, R[2 * realPi * realNat(n + 1)],
    x, R[1 / 2] with bNonzero, ordered
  have xMember : x ∈ ℝ by typecheck
  have halfMember : R[1 / 2] ∈ ℝ by typecheck
  rw [(cosPrimitive.value at x, R[2 * realPi * realNat(n + 1)], R[1 / 2] with
    halfMember), (cosPrimitive.value at x, R[2 * realPi * realNat(n + 1)], x
    with xMember)] at integral
  have sineHalf : realSin(R[R[2 * realPi * realNat(n + 1)] * R[1 / 2]]) = R[0]
    have same : R[R[2 * realPi * realNat(n + 1)] * R[1 / 2]] =
      R[realNat(n + 1) * realPi] by ring
    rw [same, realSin.nat_pi]
  rw sineHalf at integral
  have piSquare := realLess.mul_left_of_positive with piPositive, piPositive
  have zeroPi : R[realPi * 0] = R[0] by ring
  rw zeroPi at piSquare
  have nSquare := realLess.mul_left_of_positive with nPositive, nPositive
  have zeroN : R[realNat(n + 1) * 0] = R[0] by ring
  rw zeroN at nSquare
  have productPositive := realLess.mul_left_of_positive with nSquare, piSquare
  have zeroP : R[R[realPi * realPi] * 0] = R[0] by ring
  rw zeroP at productPositive
  have productNonzero : R[R[realPi * realPi] * R[realNat(n + 1) *
    realNat(n + 1)]] ≠ R[0] by linarith
  have fourNonzero : R[4] ≠ R[0] by linarith
  have square : R[R[2 * realPi * realNat(n + 1)] * R[2 * realPi *
      realNat(n + 1)]] = R[4 * R[R[realPi * realPi] * R[realNat(n + 1) *
      realNat(n + 1)]]] by ring
  have productShape : R[realPi * realPi * realNat(n + 1) * realNat(n + 1)] =
      R[R[realPi * realPi] * R[realNat(n + 1) * realNat(n + 1)]] by ring
  have inverseSplit := realInvValue.mul at R[4], R[R[realPi * realPi] *
    R[realNat(n + 1) * realNat(n + 1)]] with fourNonzero, productNonzero
  have fourInverse : realInvValue(R[4]) = R[1 / 4]
    have cancel := realInvValue.mul_right with fourNonzero
    linarith
  rw (fourierDifferenceTerms.value at x, R[1 / 2], n with nMember)
  rw [square, inverseSplit, fourInverse] at integral
  rw productShape
  have value : R[(R[1 / 2] - x) * 0 * realInvValue(R[2 * realPi *
      realNat(n + 1)]) + realCos(R[R[2 * realPi * realNat(n + 1)] * R[1 / 2]]) *
      (1 / 4 * realInvValue(R[R[realPi * realPi] * R[realNat(n + 1) *
      realNat(n + 1)]])) - ((x - x) * realSin(R[R[2 * realPi *
      realNat(n + 1)] * x]) * realInvValue(R[2 * realPi * realNat(n + 1)]) +
      realCos(R[R[2 * realPi * realNat(n + 1)] * x]) * (1 / 4 *
      realInvValue(R[R[realPi * realPi] * R[realNat(n + 1) *
      realNat(n + 1)]])))] = R[-(1 / 4) * ((realCos(R[2 * realPi *
      realNat(n + 1) * x]) - realCos(R[2 * realPi * realNat(n + 1) *
      R[1 / 2]])) * realInvValue(R[R[realPi * realPi] * R[realNat(n + 1) *
      realNat(n + 1)]]))]
    have s1 := realSin.real at R[R[2 * realPi * realNat(n + 1)] * x]
    have c1 := realCos.real at R[R[2 * realPi * realNat(n + 1)] * x]
    have c2 := realCos.real at R[R[2 * realPi * realNat(n + 1)] * R[1 / 2]]
    have i1 := realInvValue.real at R[2 * realPi * realNat(n + 1)]
    have i2 := realInvValue.real at R[R[realPi * realPi] * R[realNat(n + 1) *
      realNat(n + 1)]]
    ring
  rw value at integral
  exact integral

theorem cosSumWeighted.integral (x : Real) (N : Nat)
  requires ordered : x ≤ R[1 / 2]
  shows HasRiemannIntegral(cosSumWeighted(x, N), x, R[1 / 2],
    R[-(1 / 4) * realPartialSum(fourierDifferenceTerms(x, R[1 / 2]), N)])
proof
  induction N
  | zero =>
    have termsSequence : RealSequence(fourierDifferenceTerms(x, R[1 / 2])) by
      exact fourierDifferenceTerms.function at x, R[1 / 2]
    have first := cosWeighted.integral_half at x, 0 with ordered
    have values : ∀ X ∈ ℝ, cosSumWeighted(x, 0)(X) =
        R[0 * cosWeighted(x, R[2 * realPi * realNat(0 + 1)])(X) +
          0 * cosWeighted(x, R[2 * realPi * realNat(0 + 1)])(X)]
      intros X xMember
      have typedX : Real(X) by exact xMember
      rw [cosSumWeighted.value, realPartialSum.zero, cosWeighted.value]
      have c := realCos.real at R[R[2 * realPi * realNat(0 + 1)] * X]
      ring
    have combined := HasRiemannIntegral.linear with first, first,
      (cosSumWeighted.function at x, 0), values
    rw realPartialSum.zero
    have zeroMember : (0:N) ∈ ℕ by typecheck
    have term := FunctionBetween.apply_closed with termsSequence, zeroMember
    have termReal : Real(fourierDifferenceTerms(x, R[1 / 2])((0:N))) by
      exact term
    have same : R[0 * R[-(1 / 4) * fourierDifferenceTerms(x, R[1 / 2])((0:N))] +
      0 * R[-(1 / 4) * fourierDifferenceTerms(x, R[1 / 2])((0:N))]] =
      R[-(1 / 4) * 0] by ring
    rw same at combined
    exact combined
  | succ(k) using ih =>
    have termsSequence : RealSequence(fourierDifferenceTerms(x, R[1 / 2])) by
      exact fourierDifferenceTerms.function at x, R[1 / 2]
    have kMember : k ∈ ℕ by typecheck
    have term := cosWeighted.integral_half at x, k with ordered
    have sequence : RealSequence(cosSumTerms(x)) by
      exact cosSumTerms.function at x
    have values : ∀ X ∈ ℝ, cosSumWeighted(x, succ(k))(X) =
        R[1 * cosSumWeighted(x, k)(X) +
          1 * cosWeighted(x, R[2 * realPi * realNat(k + 1)])(X)]
      intros X xMember
      have typedX : Real(X) by exact xMember
      have sequenceX : RealSequence(cosSumTerms(X)) by
        exact cosSumTerms.function at X
      have sum := realPartialSum.real at cosSumTerms(X), k with sequenceX
      rw [cosSumWeighted.value, cosSumWeighted.value, realPartialSum.succ,
        realAddValue.eq_add, (cosSumTerms.value at X, k with kMember),
        cosWeighted.value]
      have c := realCos.real at R[2 * realPi * realNat(k + 1) * X]
      ring
    have combined := HasRiemannIntegral.linear with ih, term,
      (cosSumWeighted.function at x, succ(k)), values
    have termValue := FunctionBetween.apply_closed with termsSequence, kMember
    have termReal : Real(fourierDifferenceTerms(x, R[1 / 2])(k)) by
      exact termValue
    have sum := realPartialSum.real at fourierDifferenceTerms(x, R[1 / 2]), k
      with termsSequence
    rw [realPartialSum.succ, realAddValue.eq_add]
    have same : R[1 * R[-(1 / 4) * realPartialSum(fourierDifferenceTerms(x,
        R[1 / 2]), k)] + 1 * R[-(1 / 4) * fourierDifferenceTerms(x,
        R[1 / 2])(k)]] = R[-(1 / 4) * (realPartialSum(fourierDifferenceTerms(x,
        R[1 / 2]), k) + fourierDifferenceTerms(x, R[1 / 2])(k))] by ring
    rw same at combined
    exact combined

-- 2 sin b cos a = sin(a + b) − sin(a − b).
theorem realSin.product_cos (A B : Real)
  shows R[2 * realSin(B) * realCos(A)] =
    R[realSin(R[A + B]) - realSin(R[A - B])]
proof
  rw [realSin.add, realSin.add, realCos.neg, realSin.neg]
  have s1 := realSin.real at A
  have s2 := realSin.real at B
  have c1 := realCos.real at A
  have c2 := realCos.real at B
  ring

-- The Dirichlet kernel: 2 sin(πτ) Σ_{k<N} cos(2π(k+1)τ)
-- = sin((2N + 1)πτ) − sin(πτ).
theorem cosSumTerms.dirichlet (Y : Real) (N : Nat)
  shows R[2 * realSin(R[realPi * Y]) * realPartialSum(cosSumTerms(Y), N)] =
    R[realSin(R[(2 * realNat(N) + 1) * realPi * Y]) - realSin(R[realPi * Y])]
proof
  induction N
  | zero =>
    rw [realPartialSum.zero, realNat.zero]
    have same : R[(2 * 0 + 1) * realPi * Y] = R[realPi * Y] by ring
    rw same
    ring
  | succ(k) using ih =>
    have kMember : k ∈ ℕ by typecheck
    have sequence : RealSequence(cosSumTerms(Y)) by
      exact cosSumTerms.function at Y
    have sum := realPartialSum.real at cosSumTerms(Y), k with sequence
    rw [realPartialSum.succ, realAddValue.eq_add,
      (cosSumTerms.value at Y, k with kMember)]
    have product := realSin.product_cos at R[2 * realPi * realNat(k + 1) * Y],
      R[realPi * Y]
    have plus : R[2 * realPi * realNat(k + 1) * Y + realPi * Y] =
        R[(2 * realNat(succ(k)) + 1) * realPi * Y]
      rw [realNat.succ, realAddValue.eq_add, realNat.plus_one]
      ring
    have minus : R[2 * realPi * realNat(k + 1) * Y - realPi * Y] =
        R[(2 * realNat(k) + 1) * realPi * Y]
      rw realNat.plus_one
      ring
    rw [plus, minus] at product
    have s := realSin.real at R[realPi * Y]
    have c := realCos.real at R[2 * realPi * realNat(k + 1) * Y]
    linear_combination ih + product

-- The weight ω(τ) = (τ − x)/sin(πτ) and its derivative, on (0, 1).
defgraph fourierWeight (x : Real) (Y ∈ ℝ) : ℝ :=
  R[(Y - x) * realRpow(realSin(R[realPi * Y]), R[-1])]
proof
  typecheck

defgraph fourierWeightSlope (x : Real) (Y ∈ ℝ) : ℝ :=
  R[realRpow(realSin(R[realPi * Y]), R[-1]) + (Y - x) *
    (-(realRpow(realSin(R[realPi * Y]), R[-1]) *
      realInvValue(realSin(R[realPi * Y]))) *
      (realPi * realCos(R[realPi * Y])))]
proof
  typecheck

-- sin(πτ) ↦ sin(πτ)^(−1) composed, continuous and differentiable where
-- sin(πτ) > 0.
theorem sinInverse.derivative (X : Real)
  requires positive : R[0] < realSin(R[realPi * X])
  shows HasDerivativeAt(compose(rpowFunction(R[-1]), sinScaled(realPi), ℝ, ℝ,
    ℝ), R[-(realRpow(realSin(R[realPi * X]), R[-1]) *
      realInvValue(realSin(R[realPi * X]))) * (realPi *
      realCos(R[realPi * X]))], X)
proof
  have inner := sinScaled.has_derivative at realPi, X
  have xMember : X ∈ ℝ by typecheck
  have value : sinScaled(realPi)(X) = realSin(R[realPi * X])
    exact sinScaled.value with xMember
  have outer := rpowFunction.has_derivative at R[-1], realSin(R[realPi * X])
    with positive
  rw ← value at outer
  have chain := HasDerivativeAt.comp with inner, outer
  apply HasDerivativeAt.congr_value with chain
  rw [value, realDiv.eq_mul_inv]
  have p := realRpow.real at realSin(R[realPi * X]), R[-1]
  have i := realInvValue.real at realSin(R[realPi * X])
  have c := realCos.real at R[realPi * X]
  ring

theorem fourierWeight.has_derivative (x X : Real)
  requires positive : R[0] < realSin(R[realPi * X])
  shows HasDerivativeAt(fourierWeight(x), fourierWeightSlope(x)(X), X)
proof
  have xMember : X ∈ ℝ by typecheck
  have rpowF := rpowFunction.function at R[-1]
  have sinF := sinScaled.function at realPi
  have composite := compose.function with sinF, rpowF
  have formula : ∀ Y ∈ ℝ, fourierWeight(x)(Y) = R[shiftLinear(x)(Y) *
      compose(rpowFunction(R[-1]), sinScaled(realPi), ℝ, ℝ, ℝ)(Y)]
    intros Y yMember
    have typedY : Real(Y) by exact yMember
    rw [fourierWeight.value, shiftLinear.value, (compose.apply with sinF,
      rpowF, yMember), sinScaled.value, rpowFunction.value]
  have rule := HasDerivativeAt.mul_formula with (fourierWeight.function at x),
    formula, (shiftLinear.has_derivative at x, X),
    (sinInverse.derivative with positive)
  apply HasDerivativeAt.congr_value with rule
  rw [shiftLinear.value, (compose.apply with sinF, rpowF, xMember),
    sinScaled.value, rpowFunction.value, fourierWeightSlope.value]
  ring

theorem fourierWeightSlope.continuous_at (x X : Real)
  requires positive : R[0] < realSin(R[realPi * X])
  shows ContinuousAt(fourierWeightSlope(x), X)
proof
  have xMember : X ∈ ℝ by typecheck
  have sinF := sinScaled.function at realPi
  have cosF := cosScaled.function at realPi
  have shiftF := shiftLinear.function at x
  have rpowF := rpowFunction.function at R[-1]
  have composite := compose.function with sinF, rpowF
  have inverseF : pointwiseInv(sinScaled(realPi)) : ℝ → ℝ
    unfold pointwiseInv
    exact compose.function with sinF, realInv.function
  have piF := constantRealFunction.function at realPi
  have minusF := constantRealFunction.function at R[-1]
  have sinValue : sinScaled(realPi)(X) = realSin(R[realPi * X])
    exact sinScaled.value with xMember
  have continuousS := HasDerivativeAt.continuous_at with
    (sinScaled.has_derivative at realPi, X)
  have continuousC := HasDerivativeAt.continuous_at with
    (cosScaled.has_derivative at realPi, X)
  have continuousL := HasDerivativeAt.continuous_at with
    (shiftLinear.has_derivative at x, X)
  have continuousQ := HasDerivativeAt.continuous_at with
    (sinInverse.derivative with positive)
  have nonzero : Nonzero(sinScaled(realPi)(X))
    rw sinValue
    unfold Nonzero
    intro zero
    linarith
  have continuousI := ContinuousAt.inv with continuousS, nonzero
  have continuousPi := constantRealFunction.continuous_at at realPi, X
  have continuousMinus := constantRealFunction.continuous_at at R[-1], X
  have p1 := ContinuousAt.mul with continuousQ, continuousI
  have p2 := ContinuousAt.mul with continuousPi, continuousC
  have p3 := ContinuousAt.mul with p1, p2
  have p4 := ContinuousAt.mul with continuousMinus, p3
  have p5 := ContinuousAt.mul with continuousL, p4
  have total := ContinuousAt.add with continuousQ, p5
  apply ContinuousAt.congr with total, (fourierWeightSlope.function at x)
  intros Y yMember
  have typedY : Real(Y) by exact yMember
  have f1 := pointwiseMul.function with composite, inverseF
  have f2 := pointwiseMul.function with piF, cosF
  have f3 := pointwiseMul.function with f1, f2
  have f4 := pointwiseMul.function with minusF, f3
  have f5 := pointwiseMul.function with shiftF, f4
  have qValue := FunctionBetween.apply_closed with composite, yMember
  have qReal : Real(compose(rpowFunction(R[-1]), sinScaled(realPi), ℝ, ℝ,
    ℝ)(Y)) by exact qValue
  have fiveValue := FunctionBetween.apply_closed with f5, yMember
  have fiveReal : Real(pointwiseMul(shiftLinear(x), pointwiseMul(
    constantRealFunction(R[-1]), pointwiseMul(pointwiseMul(compose(
    rpowFunction(R[-1]), sinScaled(realPi), ℝ, ℝ, ℝ),
    pointwiseInv(sinScaled(realPi))), pointwiseMul(constantRealFunction(realPi),
    cosScaled(realPi)))))(Y)) by exact fiveValue
  have sinYValue := FunctionBetween.apply_closed with sinF, yMember
  have sinYReal : Real(sinScaled(realPi)(Y)) by exact sinYValue
  rw [(pointwiseAdd.value at compose(rpowFunction(R[-1]), sinScaled(realPi), ℝ,
    ℝ, ℝ), pointwiseMul(shiftLinear(x), pointwiseMul(
    constantRealFunction(R[-1]), pointwiseMul(pointwiseMul(compose(
    rpowFunction(R[-1]), sinScaled(realPi), ℝ, ℝ, ℝ),
    pointwiseInv(sinScaled(realPi))), pointwiseMul(constantRealFunction(realPi),
    cosScaled(realPi))))), Y with composite, f5, qReal, fiveReal),
    (pointwiseMul.apply with shiftF, f4), (pointwiseMul.apply with minusF, f3),
    (pointwiseMul.apply with f1, f2), (pointwiseMul.apply with composite,
    inverseF), (pointwiseMul.apply with piF, cosF),
    (pointwiseInv.value at sinScaled(realPi), Y with sinF, sinYReal),
    (compose.apply with sinF, rpowF, yMember), constantRealFunction.value,
    constantRealFunction.value, sinScaled.value, cosScaled.value,
    shiftLinear.value, rpowFunction.value, fourierWeightSlope.value]
  ring

-- y ↦ −cos(Ky)/K.
defgraph cosAntiderivative (K : Real) (Y ∈ ℝ) : ℝ :=
  R[-realInvValue(K) * realCos(R[K * Y])]
proof
  typecheck

-- sin(πτ) > 0 for 0 < τ < 1.
theorem realSin.pi_positive (Y : Real)
  requires lower : R[0] < Y
  requires upper : Y < R[1]
  shows R[0] < realSin(R[realPi * Y])
proof
  have piPositive := realPi.positive
  have low := realLess.mul_left_of_positive with lower, piPositive
  have high := realLess.mul_left_of_positive with upper, piPositive
  have zero : R[realPi * 0] = R[0] by ring
  have one : R[realPi * 1] = realPi by ring
  rw zero at low
  rw one at high
  exact realSin.positive with low, high

-- Riemann–Lebesgue for the weight: ∫_x^{1/2} ω(τ) sin(Kτ) dτ = O(1/K).
theorem fourierWeight.oscillation (x : Real)
  requires positive : R[0] < x
  requires atMostHalf : x ≤ R[1 / 2]
  shows ∃ C ∈ ℝ, ∀ K ∈ ℝ, R[0] < K →
    abs(riemannIntegral(pointwiseMul(fourierWeight(x), sinScaled(K)), x,
      R[1 / 2])) ≤ R[C * realInvValue(K)]
proof
  have subset : closedInterval(x, R[1 / 2]) ⊆ ℝ
    intros X xMember
    exact (closedInterval.membership.forward with xMember).left
  have sinePositive : ∀ X ∈ closedInterval(x, R[1 / 2]),
      R[0] < realSin(R[realPi * X])
    intros X xMember
    obtain ⟨xReal, low, high⟩ := closedInterval.membership.forward with
      xMember
    have typedX : Real(X) by exact xReal
    have lower : R[0] < X by linarith
    have upper : X < R[1] by linarith
    exact realSin.pi_positive with lower, upper
  have weightF := fourierWeight.function at x
  have slopeF := fourierWeightSlope.function at x
  have continuousU : ContinuousOn(fourierWeight(x), closedInterval(x,
      R[1 / 2]))
    apply ContinuousOn.of_differentiable with weightF, subset
    intros X xMember
    have typedX : Real(X) by exact (subset with X, xMember)
    exact HasDerivativeAt.differentiable_at with
      (fourierWeight.has_derivative with (sinePositive with X, xMember))
  have continuousSlope : ContinuousOn(fourierWeightSlope(x),
      closedInterval(x, R[1 / 2]))
    refine ⟨slopeF, subset, ?_⟩
    intros X xMember
    have typedX : Real(X) by exact (subset with X, xMember)
    exact ContinuousAt.continuous_within_at with
      (fourierWeightSlope.continuous_at with (sinePositive with X, xMember)),
      subset
  obtain ⟨L, lReal, U, uReal, slopeBounds⟩ :=
    ContinuousOn.closed_interval_value_bounds with atMostHalf, continuousSlope
  have typedL : Real(L) by exact lReal
  have typedU : Real(U) by exact uReal
  have halfMember : R[1 / 2] ∈ ℝ by typecheck
  have weightHalf := FunctionBetween.apply_closed with weightF, halfMember
  have weightHalfReal : Real(fourierWeight(x)(R[1 / 2])) by exact weightHalf
  witness R[abs(fourierWeight(x)(R[1 / 2])) + (abs(L) + abs(U)) *
    (R[1 / 2] - x)]
  have cReal : R[abs(fourierWeight(x)(R[1 / 2])) + (abs(L) + abs(U)) *
    (R[1 / 2] - x)] ∈ ℝ by typecheck
  refine ⟨cReal, ?_⟩
  intros K kReal kPositive
  have typedK : Real(K) by exact kReal
  have kNonzero : K ≠ R[0] by linarith
  have kInverse := realInvValue.mul_right with kNonzero
  have kInversePositive := realInvValue.positive with kPositive
  have antiF := cosAntiderivative.function at K
  have sinF := sinScaled.function at K
  have cosF := cosScaled.function at K
  have antiFormula : ∀ Y ∈ ℝ, cosAntiderivative(K)(Y) =
      R[-realInvValue(K) * cosScaled(K)(Y)]
    intros Y yMember
    have typedY : Real(Y) by exact yMember
    rw [cosAntiderivative.value, cosScaled.value]
  have derivativeV : ∀ X ∈ ℝ, x < X → X < R[1 / 2] →
      HasDerivativeAt(cosAntiderivative(K), sinScaled(K)(X), X)
    intros X xMember low high
    have typedX : Real(X) by exact xMember
    have rule := HasDerivativeAt.scaled_value with cosF, antiF, antiFormula,
      (cosScaled.has_derivative at K, X)
    apply HasDerivativeAt.congr_value with rule
    rw sinScaled.value
    have s := realSin.real at R[K * X]
    linear_combination realSin(R[K * X]) * kInverse
  have continuousV : ContinuousOn(cosAntiderivative(K), closedInterval(x,
      R[1 / 2]))
    apply ContinuousOn.of_differentiable with antiF, subset
    intros X xMember
    have typedX : Real(X) by exact (subset with X, xMember)
    exact HasDerivativeAt.differentiable_at with
      (HasDerivativeAt.scaled_value with cosF, antiF, antiFormula,
        (cosScaled.has_derivative at K, X))
  have continuousSin : ContinuousOn(sinScaled(K), closedInterval(x, R[1 / 2]))
    apply ContinuousOn.of_differentiable with sinF, subset
    intros X xMember
    have typedX : Real(X) by exact (subset with X, xMember)
    exact HasDerivativeAt.differentiable_at with
      (sinScaled.has_derivative at K, X)
  have derivativeU : ∀ X ∈ ℝ, x < X → X < R[1 / 2] →
      HasDerivativeAt(fourierWeight(x), fourierWeightSlope(x)(X), X)
    intros X xMember low high
    have typedX : Real(X) by exact xMember
    have inside : X ∈ closedInterval(x, R[1 / 2])
      apply closedInterval.membership.backward
      refine ⟨xMember, ?_, ?_⟩
      . linarith
      . linarith
    exact fourierWeight.has_derivative with (sinePositive with X, inside)
  have first := ContinuousOn.integrable_interval with atMostHalf,
    (ContinuousOn.mul with continuousSlope, continuousV)
  have second := ContinuousOn.integrable_interval with atMostHalf,
    (ContinuousOn.mul with continuousU, continuousSin)
  have parts := riemannIntegral.by_parts with atMostHalf, slopeF, sinF,
    continuousU, continuousV, derivativeU, derivativeV, first, second
  have xMember : x ∈ ℝ by typecheck
  have weightAtX : fourierWeight(x)(x) = R[0]
    rw (fourierWeight.value at x, x with xMember)
    have r := realRpow.real at realSin(R[realPi * x]), R[-1]
    ring
  rw weightAtX at parts
  -- |∫ ω′ V| ≤ (|L| + |U|)/K · (1/2 − x).
  have boundFunction := constantRealFunction.function at R[(abs(L) + abs(U)) *
    realInvValue(K)]
  have boundIntegrable : RiemannIntegrable(constantRealFunction(R[(abs(L) +
      abs(U)) * realInvValue(K)]), x, R[1 / 2])
    unfold constantRealFunction
    exact RiemannIntegrable.constant at x, R[1 / 2], R[(abs(L) + abs(U)) *
      realInvValue(K)] with atMostHalf
  have slopeAntiF := pointwiseMul.function with slopeF, antiF
  have pointBound : ∀ X ∈ closedInterval(x, R[1 / 2]),
      abs(pointwiseMul(fourierWeightSlope(x), cosAntiderivative(K))(X)) ≤
      constantRealFunction(R[(abs(L) + abs(U)) * realInvValue(K)])(X)
    intros X inInterval
    have typedX : Real(X) by exact (subset with X, inInterval)
    obtain ⟨low, high⟩ := slopeBounds with X, inInterval
    have slopeReal := FunctionBetween.apply_closed with slopeF,
      (subset with X, inInterval)
    have slopeTyped : Real(fourierWeightSlope(x)(X)) by exact slopeReal
    rw [(pointwiseMul.apply with slopeF, antiF), constantRealFunction.value,
      cosAntiderivative.value, abs.mul, abs.mul, abs.neg,
      (abs.of_nonnegative with (realLess.implies_le with kInversePositive))]
    have cosBound := realCos.abs_le_one at R[K * X]
    have slopeAbs : abs(fourierWeightSlope(x)(X)) ≤ R[abs(L) + abs(U)]
      have lAbs := abs.upper at R[-L]
      rw abs.neg at lAbs
      have uAbs := abs.upper at U
      have lNon := abs.nonnegative at L
      have uNon := abs.nonnegative at U
      apply abs.le_of_two_sided
      . linarith
      . linarith
    have slopeNonnegative := abs.nonnegative at fourierWeightSlope(x)(X)
    have cosNonnegative := abs.nonnegative at realCos(R[K * X])
    have step1 := realLe.mul_right_of_nonnegative with slopeAbs,
      (realLess.implies_le with kInversePositive)
    have skRaw := realLe.mul_right_of_nonnegative with slopeNonnegative,
      (realLess.implies_le with kInversePositive)
    have zeroK : R[0 * realInvValue(K)] = R[0] by ring
    have sk : R[0] ≤ R[abs(fourierWeightSlope(x)(X)) * realInvValue(K)]
      by linarith
    have product := realLe.mul_left_of_nonnegative with cosBound, sk
    have reshape : R[abs(fourierWeightSlope(x)(X)) * (realInvValue(K) *
        abs(realCos(R[K * X])))] = R[R[abs(fourierWeightSlope(x)(X)) *
        realInvValue(K)] * abs(realCos(R[K * X]))] by ring
    have one : R[R[abs(fourierWeightSlope(x)(X)) * realInvValue(K)] * 1] =
      R[abs(fourierWeightSlope(x)(X)) * realInvValue(K)] by ring
    linarith
  have integralBound := riemannIntegral.abs_le with first, boundIntegrable,
    pointBound
  rw (riemannIntegral.constant with atMostHalf) at integralBound
  unfold realSubValue at integralBound
  have antiHalf : cosAntiderivative(K)(R[1 / 2]) =
      R[-realInvValue(K) * realCos(R[K * R[1 / 2]])]
    exact cosAntiderivative.value with halfMember
  have antiX := FunctionBetween.apply_closed with antiF, xMember
  have antiXReal : Real(cosAntiderivative(K)(x)) by exact antiX
  rw antiHalf at parts
  have cosHalf := realCos.abs_le_one at R[K * R[1 / 2]]
  have cosReal := realCos.real at R[K * R[1 / 2]]
  have boundary : abs(R[fourierWeight(x)(R[1 / 2]) * R[-realInvValue(K) *
      realCos(R[K * R[1 / 2]])]]) ≤ R[abs(fourierWeight(x)(R[1 / 2])) *
      realInvValue(K)]
    rw [abs.mul, abs.mul, abs.neg, (abs.of_nonnegative with
      (realLess.implies_le with kInversePositive))]
    have wNon := abs.nonnegative at fourierWeight(x)(R[1 / 2])
    have wk := realLe.mul_right_of_nonnegative with wNon,
      (realLess.implies_le with kInversePositive)
    have zeroK : R[0 * realInvValue(K)] = R[0] by ring
    have wkNon : R[0] ≤ R[abs(fourierWeight(x)(R[1 / 2])) * realInvValue(K)]
      by linarith
    have product := realLe.mul_left_of_nonnegative with cosHalf, wkNon
    have reshape : R[abs(fourierWeight(x)(R[1 / 2])) * R[realInvValue(K) *
        abs(realCos(R[K * R[1 / 2]]))]] = R[R[abs(fourierWeight(x)(R[1 / 2])) *
        realInvValue(K)] * abs(realCos(R[K * R[1 / 2]]))] by ring
    have one : R[R[abs(fourierWeight(x)(R[1 / 2])) * realInvValue(K)] * 1] =
      R[abs(fourierWeight(x)(R[1 / 2])) * realInvValue(K)] by ring
    linarith
  obtain ⟨m1, _⟩ := riemannIntegral.selected at pointwiseMul(
    fourierWeightSlope(x), cosAntiderivative(K)), x, R[1 / 2]
  obtain ⟨m2, _⟩ := riemannIntegral.selected at pointwiseMul(fourierWeight(x),
    sinScaled(K)), x, R[1 / 2]
  have solved : riemannIntegral(pointwiseMul(fourierWeight(x), sinScaled(K)), x,
      R[1 / 2]) = R[fourierWeight(x)(R[1 / 2]) * R[-realInvValue(K) *
      realCos(R[K * R[1 / 2]])] - riemannIntegral(pointwiseMul(
      fourierWeightSlope(x), cosAntiderivative(K)), x, R[1 / 2])]
    linear_combination parts
  rw solved
  have triangle := abs.triangle at R[fourierWeight(x)(R[1 / 2]) *
    R[-realInvValue(K) * realCos(R[K * R[1 / 2]])]], R[-riemannIntegral(
    pointwiseMul(fourierWeightSlope(x), cosAntiderivative(K)), x, R[1 / 2])]
  rw abs.neg at triangle
  have expand : R[R[abs(fourierWeight(x)(R[1 / 2])) + (abs(L) + abs(U)) *
      (R[1 / 2] - x)] * realInvValue(K)] = R[abs(fourierWeight(x)(R[1 / 2])) *
      realInvValue(K) + R[(abs(L) + abs(U)) * realInvValue(K)] *
      (R[1 / 2] - x)] by ring
  linarith

-- ∫_P^Q (τ − x) dτ through the primitive (τ − x)²/2.
defgraph halfSquare (x : Real) (Y ∈ ℝ) : ℝ := R[(Y - x) * (Y - x) * (1 / 2)]
proof
  typecheck

theorem shiftLinear.integral (x P Q : Real)
  requires ordered : P ≤ Q
  shows HasRiemannIntegral(shiftLinear(x), P, Q,
    R[halfSquare(x)(Q) - halfSquare(x)(P)])
proof
  have shiftF := shiftLinear.function at x
  have squareF := halfSquare.function at x
  have subset : closedInterval(P, Q) ⊆ ℝ
    intros X xMember
    exact (closedInterval.membership.forward with xMember).left
  have formula : ∀ Y ∈ ℝ, halfSquare(x)(Y) =
      R[shiftLinear(x)(Y) * pointwiseMul(constantRealFunction(R[1 / 2]),
        shiftLinear(x))(Y)]
    intros Y yMember
    have typedY : Real(Y) by exact yMember
    rw [halfSquare.value, (pointwiseMul.apply with
      (constantRealFunction.function
      at R[1 / 2]), shiftF), constantRealFunction.value, shiftLinear.value]
    ring
  have derivative : ∀ X ∈ ℝ, HasDerivativeAt(halfSquare(x),
      shiftLinear(x)(X), X)
    intros X xMember
    have typedX : Real(X) by exact xMember
    have scaled := HasDerivativeAt.scale at shiftLinear(x), R[1 / 2], R[1], X
      with (shiftLinear.has_derivative at x, X)
    have rule := HasDerivativeAt.mul_formula with squareF, formula,
      (shiftLinear.has_derivative at x, X), scaled
    apply HasDerivativeAt.congr_value with rule
    rw [(pointwiseMul.apply with (constantRealFunction.function at R[1 / 2]),
      shiftF), constantRealFunction.value, shiftLinear.value]
    ring
  have continuousF : ContinuousOn(halfSquare(x), closedInterval(P, Q))
    apply ContinuousOn.of_differentiable with squareF, subset
    intros X xMember
    have typedX : Real(X) by exact (subset with X, xMember)
    exact HasDerivativeAt.differentiable_at with (derivative with X,
      (subset with X, xMember))
  have continuousf : ContinuousOn(shiftLinear(x), closedInterval(P, Q))
    apply ContinuousOn.of_differentiable with shiftF, subset
    intros X xMember
    have typedX : Real(X) by exact (subset with X, xMember)
    exact HasDerivativeAt.differentiable_at with
      (shiftLinear.has_derivative at x, X)
  have interior : ∀ X ∈ ℝ, P < X → X < Q →
      HasDerivativeAt(halfSquare(x), shiftLinear(x)(X), X)
    intros X xMember low high
    exact derivative with X, xMember
  have result := FTC.continuous_derivative at shiftLinear(x), halfSquare(x), P,
    Q with ordered, continuousF, interior, continuousf
  have qMember : Q ∈ ℝ by typecheck
  have pMember : P ∈ ℝ by typecheck
  have fq := FunctionBetween.apply_closed with squareF, qMember
  have fp := FunctionBetween.apply_closed with squareF, pMember
  have fqReal : Real(halfSquare(x)(Q)) by exact fq
  have fpReal : Real(halfSquare(x)(P)) by exact fp
  unfold realSubValue at result
  exact result

-- (1/2) ω(τ) sin(Kτ) − (1/2)(τ − x).
defgraph dirichletForm (x K : Real) (Y ∈ ℝ) : ℝ :=
  R[1 / 2 * pointwiseMul(fourierWeight(x), sinScaled(K))(Y) +
    -(1 / 2) * shiftLinear(x)(Y)]
proof
  have product := pointwiseMul.function with (fourierWeight.function at x),
    (sinScaled.function at K)
  have value := FunctionBetween.apply_closed with product, member
  have valueReal : Real(pointwiseMul(fourierWeight(x), sinScaled(K))(Y)) by
    exact value
  have shift := FunctionBetween.apply_closed with
    (shiftLinear.function at x), member
  have shiftReal : Real(shiftLinear(x)(Y)) by exact shift
  typecheck

-- The partial sums: Σ_{k<N} (cos 2π(k+1)x − cos π(k+1))/(π²(k+1)²)
-- = (1/2 − x)² − 2 ∫_x^{1/2} ω(τ) sin((2N + 1)πτ) dτ.
theorem fourierSeries.partial (x : Real) (N : Nat)
  requires positive : R[0] < x
  requires atMostHalf : x ≤ R[1 / 2]
  shows realPartialSum(fourierDifferenceTerms(x, R[1 / 2]), N) =
    R[(R[1 / 2] - x) * (R[1 / 2] - x) - 2 *
      riemannIntegral(pointwiseMul(fourierWeight(x),
        sinScaled(R[(2 * realNat(N) + 1) * realPi])), x, R[1 / 2])]
proof
  have subset : closedInterval(x, R[1 / 2]) ⊆ ℝ
    intros X xMember
    exact (closedInterval.membership.forward with xMember).left
  have weightF := fourierWeight.function at x
  have sinF := sinScaled.function at R[(2 * realNat(N) + 1) * realPi]
  have continuousW : ContinuousOn(fourierWeight(x), closedInterval(x,
      R[1 / 2]))
    apply ContinuousOn.of_differentiable with weightF, subset
    intros X xMember
    obtain ⟨xReal, low, high⟩ := closedInterval.membership.forward with
      xMember
    have typedX : Real(X) by exact xReal
    have lower : R[0] < X by linarith
    have upper : X < R[1] by linarith
    exact HasDerivativeAt.differentiable_at with
      (fourierWeight.has_derivative with (realSin.pi_positive with lower,
        upper))
  have continuousS : ContinuousOn(sinScaled(R[(2 * realNat(N) + 1) *
      realPi]), closedInterval(x, R[1 / 2]))
    apply ContinuousOn.of_differentiable with sinF, subset
    intros X xMember
    have typedX : Real(X) by exact (subset with X, xMember)
    exact HasDerivativeAt.differentiable_at with
      (sinScaled.has_derivative at R[(2 * realNat(N) + 1) * realPi], X)
  have weightIntegral := riemannIntegral.integral with
    (ContinuousOn.integrable_interval with atMostHalf,
      (ContinuousOn.mul with continuousW, continuousS))
  have shiftIntegral := shiftLinear.integral at x, x, R[1 / 2] with
    atMostHalf
  have formFunction := dirichletForm.function at x,
    R[(2 * realNat(N) + 1) * realPi]
  have formValues : ∀ X ∈ ℝ, dirichletForm(x, R[(2 * realNat(N) + 1) *
      realPi])(X) = R[1 / 2 * pointwiseMul(fourierWeight(x), sinScaled(
      R[(2 * realNat(N) + 1) * realPi]))(X) + -(1 / 2) * shiftLinear(x)(X)]
    intros X xMember
    exact dirichletForm.value with xMember
  have combined := HasRiemannIntegral.linear with weightIntegral,
    shiftIntegral, formFunction, formValues
  have sums := cosSumWeighted.integral at x, N with atMostHalf
  have agree : ∀ X ∈ ℝ, x < X → X < R[1 / 2] →
      cosSumWeighted(x, N)(X) = dirichletForm(x, R[(2 * realNat(N) + 1) *
      realPi])(X)
    intros X xMember low high
    have typedX : Real(X) by exact xMember
    have lower : R[0] < X by linarith
    have upper : X < R[1] by linarith
    have sinePositive := realSin.pi_positive with lower, upper
    have dirichlet := cosSumTerms.dirichlet at X, N
    have sequence : RealSequence(cosSumTerms(X)) by
      exact cosSumTerms.function at X
    have sum := realPartialSum.real at cosSumTerms(X), N with sequence
    have inverse := realRpow.neg at realSin(R[realPi * X]), R[1] with
      sinePositive
    rw (realRpow.one with sinePositive) at inverse
    have sineNonzero : realSin(R[realPi * X]) ≠ R[0] by linarith
    have cancel := realInvValue.mul_right with sineNonzero
    rw realDiv.eq_mul_inv at inverse
    rw [cosSumWeighted.value, (dirichletForm.value at x, R[(2 * realNat(N) +
      1) * realPi], X with xMember), (pointwiseMul.apply with weightF, sinF),
      fourierWeight.value, sinScaled.value, shiftLinear.value, inverse]
    have s := realSin.real at R[(2 * realNat(N) + 1) * realPi * X]
    have i := realInvValue.real at realSin(R[realPi * X])
    linear_combination ((X - x) * realInvValue(realSin(R[realPi * X])) *
      (1 / 2)) * dirichlet - ((X - x) * realPartialSum(cosSumTerms(X), N) +
      (X - x) * (1 / 2)) * cancel
  have moved := HasRiemannIntegral.congr_interior with combined,
    (cosSumWeighted.function at x, N), agree
  have same := HasRiemannIntegral.unique with sums, moved
  have xMember : x ∈ ℝ by typecheck
  have halfMember : R[1 / 2] ∈ ℝ by typecheck
  rw [(halfSquare.value at x, R[1 / 2] with halfMember), (halfSquare.value at
    x, x with xMember)] at same
  have f4 : R[4 * R[1 / 4]] = R[1] by linarith
  have f2 : R[2 * R[1 / 2]] = R[1] by linarith
  have termsSequence : RealSequence(fourierDifferenceTerms(x, R[1 / 2])) by
    exact fourierDifferenceTerms.function at x, R[1 / 2]
  have sum := realPartialSum.real at fourierDifferenceTerms(x, R[1 / 2]), N
    with termsSequence
  obtain ⟨psi, _⟩ := riemannIntegral.selected at pointwiseMul(fourierWeight(x),
    sinScaled(R[(2 * realNat(N) + 1) * realPi])), x, R[1 / 2]
  linear_combination (-4) * same + (-realPartialSum(fourierDifferenceTerms(x,
    R[1 / 2]), N)) * f4 + (-2 * riemannIntegral(pointwiseMul(fourierWeight(x),
    sinScaled(R[(2 * realNat(N) + 1) * realPi])), x, R[1 / 2]) +
    (R[1 / 2] - x) * (R[1 / 2] - x) * (2 * R[1 / 2] + 1)) * f2

-- For 0 < x ≤ 1/2: Σ (cos 2πnx − cos πn)/(π²n²) = (1/2 − x)².
theorem fourierSeries.left_half (x : Real)
  requires positive : R[0] < x
  requires atMostHalf : x ≤ R[1 / 2]
  shows SumsTo(fourierDifferenceTerms(x, R[1 / 2]),
    R[(R[1 / 2] - x) * (R[1 / 2] - x)])
proof
  have termsSequence : RealSequence(fourierDifferenceTerms(x, R[1 / 2])) by
    exact fourierDifferenceTerms.function at x, R[1 / 2]
  apply SumsTo.of_converges with termsSequence
  refine ⟨(prefixSums.sequence with termsSequence), ?_⟩
  intros E eReal ePositive
  have typedE : Real(E) by exact eReal
  obtain ⟨C, cReal, oscillation⟩ := fourierWeight.oscillation with positive,
    atMostHalf
  have typedC : Real(C) by exact cReal
  have absC := abs.nonnegative at C
  have upperC := abs.upper at C
  have kPositive : R[0] < R[2 * abs(C) + 1] by linarith
  have kNonzero : R[2 * abs(C) + 1] ≠ R[0] by linarith
  have kInverse := realInvValue.mul_right with kNonzero
  have kInversePositive := realInvValue.positive with kPositive
  have toleranceReal : R[E * realInvValue(R[2 * abs(C) + 1])] ∈ ℝ by typecheck
  have tolerance := realLess.mul_left_of_positive with kInversePositive,
    ePositive
  have zeroE : R[E * 0] = R[0] by ring
  rw zeroE at tolerance
  obtain ⟨_, harmonic⟩ := harmonicTerms.converges_zero
  obtain ⟨N0, n0Member, small⟩ := harmonic with R[E * realInvValue(R[2 *
    abs(C) + 1])], toleranceReal, tolerance
  refine ⟨N0, n0Member, ?_⟩
  intros n nMember later
  have typedN := nat.omega.backward with nMember
  rw (prefixSums.value at fourierDifferenceTerms(x, R[1 / 2]), n with
    termsSequence, nMember)
  apply openBall.of_abs
  rw (fourierSeries.partial at x, n with positive, atMostHalf)
  have piPositive := realPi.positive
  have nNonnegative := realNat.nonnegative at n
  have kn : R[0] < R[(2 * realNat(n) + 1) * realPi]
    have base : R[0] < R[2 * realNat(n) + 1] by linarith
    have product := realLess.mul_left_of_positive with piPositive, base
    have zero : R[R[2 * realNat(n) + 1] * 0] = R[0] by ring
    linarith
  have knReal : R[(2 * realNat(n) + 1) * realPi] ∈ ℝ by typecheck
  have bound := oscillation with R[(2 * realNat(n) + 1) * realPi], knReal, kn
  have harmonicValue := small with n, nMember, later
  have harmonicAbs := openBall.abs with harmonicValue
  rw (harmonicTerms.value with nMember) at harmonicAbs
  have nPlus : R[0] < R[realNat(n) + 1] by linarith
  have i1 := realInvValue.positive with nPlus
  have iK := realInvValue.positive with kn
  have nNonzero : R[realNat(n) + 1] ≠ R[0] by linarith
  have knNonzero : R[(2 * realNat(n) + 1) * realPi] ≠ R[0] by linarith
  have c1 := realInvValue.mul_right with nNonzero
  have cK := realInvValue.mul_right with knNonzero
  obtain ⟨piThree, _⟩ := realPi.bounds
  have growth : R[realNat(n) + 1] ≤ R[(2 * realNat(n) + 1) * realPi]
    have base : R[0] ≤ R[2 * realNat(n) + 1] by linarith
    have piLarge : R[1] ≤ realPi by linarith
    have scaled := realLe.mul_left_of_nonnegative with piLarge, base
    have one : R[R[2 * realNat(n) + 1] * 1] = R[2 * realNat(n) + 1] by ring
    linarith
  -- 1/K ≤ 1/(n + 1).
  have step := realLe.mul_right_of_nonnegative with growth,
    (realLess.implies_le with i1)
  have step2 := realLe.mul_right_of_nonnegative with step,
    (realLess.implies_le with iK)
  have inverseOrder : realInvValue(R[(2 * realNat(n) + 1) * realPi]) ≤
      realInvValue(R[realNat(n) + 1])
    have left : R[R[R[realNat(n) + 1] * realInvValue(R[realNat(n) + 1])] *
        realInvValue(R[(2 * realNat(n) + 1) * realPi])] =
        realInvValue(R[(2 * realNat(n) + 1) * realPi])
      rw c1
      ring
    have right : R[R[R[(2 * realNat(n) + 1) * realPi] *
        realInvValue(R[realNat(n) + 1])] *
        realInvValue(R[(2 * realNat(n) + 1) * realPi])] =
        realInvValue(R[realNat(n) + 1])
      have reshape : R[R[R[(2 * realNat(n) + 1) * realPi] *
          realInvValue(R[realNat(n) + 1])] *
          realInvValue(R[(2 * realNat(n) + 1) * realPi])] =
          R[R[R[(2 * realNat(n) + 1) * realPi] *
          realInvValue(R[(2 * realNat(n) + 1) * realPi])] *
          realInvValue(R[realNat(n) + 1])] by ring
      rw [reshape, cK]
      ring
    linarith
  -- |−2Ψ| ≤ 2|C|/K < E.
  obtain ⟨psi, _⟩ := riemannIntegral.selected at pointwiseMul(fourierWeight(x),
    sinScaled(R[(2 * realNat(n) + 1) * realPi])), x, R[1 / 2]
  have simplify : R[(R[1 / 2] - x) * (R[1 / 2] - x) - 2 *
      riemannIntegral(pointwiseMul(fourierWeight(x), sinScaled(R[(2 *
      realNat(n) + 1) * realPi])), x, R[1 / 2]) - (R[1 / 2] - x) *
      (R[1 / 2] - x)] = R[-(2 * riemannIntegral(pointwiseMul(fourierWeight(x),
      sinScaled(R[(2 * realNat(n) + 1) * realPi])), x, R[1 / 2]))] by ring
  rw [simplify, abs.neg, abs.mul]
  have twoNonnegative : R[0] ≤ R[2] by linarith
  rw (abs.of_nonnegative with twoNonnegative)
  have cBound : R[C * realInvValue(R[(2 * realNat(n) + 1) * realPi])] ≤
      R[abs(C) * realInvValue(R[realNat(n) + 1])]
    have s1 := realLe.mul_right_of_nonnegative with upperC,
      (realLess.implies_le with iK)
    have s2 := realLe.mul_left_of_nonnegative with inverseOrder, absC
    linarith
  have harmonicBound : realInvValue(R[realNat(n) + 1]) <
      R[E * realInvValue(R[2 * abs(C) + 1])]
    have nonneg : R[0] ≤ R[realInvValue(R[realNat(n) + 1]) - 0] by linarith
    rw (abs.of_nonnegative with nonneg) at harmonicAbs
    linarith
  have s3 := realLe.mul_left_of_nonnegative with (realLess.implies_le with
    harmonicBound), absC
  have tPositive := realLess.mul_left_of_positive with kInversePositive,
    ePositive
  rw zeroE at tPositive
  have collapse : R[R[2 * abs(C) + 1] * (E * realInvValue(R[2 * abs(C) +
      1]))] = E
    linear_combination E * kInverse
  have expand : R[R[2 * abs(C) + 1] * (E * realInvValue(R[2 * abs(C) + 1]))] =
      R[2 * (abs(C) * (E * realInvValue(R[2 * abs(C) + 1]))) +
      E * realInvValue(R[2 * abs(C) + 1])] by ring
  linarith

-- cos(θ + 2πk) = cos θ for an integer k, and cos(θ + 2πNk) = cos θ.
theorem realCos.integer_turn (θ : Real) (k : Integer)
  shows realCos(R[θ + 2 * realPi * realInt(k)]) = realCos(θ)
proof
  have turn := expTwoPiI.integer at k
  unfold expTwoPiI at turn
  rw complexExp.euler at turn
  have re := complexPoint.re at realCos(R[2 * realPi * realInt(k)]),
    realSin(R[2 * realPi * realInt(k)])
  have im := complexPoint.im at realCos(R[2 * realPi * realInt(k)]),
    realSin(R[2 * realPi * realInt(k)])
  rw turn at re
  rw turn at im
  rw [← complexOfReal.one, complexOfReal.re] at re
  rw [← complexOfReal.one, complexOfReal.im] at im
  rw [realCos.add, ← re, ← im]
  have c := realCos.real at θ
  have s := realSin.real at θ
  ring

theorem realCos.integer_turns (θ : Real) (N : Nat) (k : Integer)
  shows realCos(R[θ + 2 * realPi * realNat(N) * realInt(k)]) = realCos(θ)
proof
  induction N
  | zero =>
    rw realNat.zero
    have same : R[θ + 2 * realPi * 0 * realInt(k)] = θ by ring
    rw same
  | succ(m) using ih =>
    rw [realNat.succ, realAddValue.eq_add]
    have same : R[θ + 2 * realPi * (realNat(m) + realOne) * realInt(k)] =
      R[R[θ + 2 * realPi * realNat(m) * realInt(k)] + 2 * realPi *
        realInt(k)] by ring
    rw [same, realCos.integer_turn, ih]

-- The Fourier difference terms are 1-periodic in x and even about 1/2.
theorem fourierDifferenceTerms.periodic (X X0 : Real) (k : Integer)
  shows fourierDifferenceTerms(R[X + realInt(k)], X0) =
    fourierDifferenceTerms(X, X0)
proof
  apply FunctionBetween.ext with (fourierDifferenceTerms.function at
    R[X + realInt(k)], X0), (fourierDifferenceTerms.function at X, X0)
  intros n nMember
  have typedN := nat.omega.backward with nMember
  rw [(fourierDifferenceTerms.value at R[X + realInt(k)], X0, n with nMember),
    (fourierDifferenceTerms.value at X, X0, n with nMember)]
  have shape : R[2 * realPi * realNat(n + 1) * R[X + realInt(k)]] =
    R[R[2 * realPi * realNat(n + 1) * X] + 2 * realPi * realNat(n + 1) *
      realInt(k)] by ring
  rw [shape, realCos.integer_turns]

theorem fourierDifferenceTerms.reflect (X X0 : Real)
  shows fourierDifferenceTerms(R[1 - X], X0) = fourierDifferenceTerms(X, X0)
proof
  apply FunctionBetween.ext with (fourierDifferenceTerms.function at
    R[1 - X], X0), (fourierDifferenceTerms.function at X, X0)
  intros n nMember
  have typedN := nat.omega.backward with nMember
  rw [(fourierDifferenceTerms.value at R[1 - X], X0, n with nMember),
    (fourierDifferenceTerms.value at X, X0, n with nMember)]
  have oneTurn := realInt.one
  have shape : R[2 * realPi * realNat(n + 1) * R[1 - X]] =
    R[R[-(2 * realPi * realNat(n + 1) * X)] + 2 * realPi * realNat(n + 1) *
      realInt(integerOne)] by
    rw oneTurn
    ring
  rw [shape, realCos.integer_turns, realCos.neg]

-- |Σ_{n<N} wₙ| ≤ C Z when |wₙ| ≤ C bₙ, bₙ ≥ 0 and Σ bₙ = Z.
theorem realPartialSum.abs_bound (w b : Set) (C Z : Real) (N : Nat)
  requires sequenceW : RealSequence(w)
  requires sums : SumsTo(b, Z)
  requires nonnegative : NonnegativeTerms(b)
  requires nonnegativeC : R[0] ≤ C
  requires dominated : ∀ n ∈ ℕ, abs(w(n)) ≤ R[C * b(n)]
  shows abs(realPartialSum(w, N)) ≤ R[C * Z]
proof
  have sequenceB := SumsTo.sequence with sums
  have constant := constantSequence.sequence at C
  have scaled := mulSequence.sequence with constant, sequenceB
  have negated := negSequence.sequence with sequenceW
  have scaledValue : ∀ k ∈ ℕ, mulSequence(constantSequence(C), b)(k) =
      R[C * b(k)]
    intros k kMember
    have typedK := nat.omega.backward with kMember
    have bReal := RealSequence.value at b, k with sequenceB
    have constantReal : Real(constantSequence(C)(k))
      rw constantSequence.value
      typecheck
    rw [(mulSequence.value at constantSequence(C), b, k with constant,
      sequenceB, constantReal, bReal), constantSequence.value]
  have upper : ∀ k ∈ ℕ, (w[k]:R) ≤ (mulSequence(constantSequence(C), b)[k]:R)
    intros k kMember
    have typedK := nat.omega.backward with kMember
    have wReal := RealSequence.value at w, k with sequenceW
    rw (scaledValue with k, kMember)
    have bound := dominated with k, kMember
    have above := abs.upper at w(k)
    linarith
  have lower : ∀ k ∈ ℕ, (negSequence(w)[k]:R) ≤
      (mulSequence(constantSequence(C), b)[k]:R)
    intros k kMember
    have typedK := nat.omega.backward with kMember
    have wReal := RealSequence.value at w, k with sequenceW
    rw [(negSequence.value at w, k with sequenceW, wReal),
      (scaledValue with k, kMember)]
    have bound := dominated with k, kMember
    have above := abs.upper at R[-w(k)]
    rw abs.neg at above
    linarith
  have first := realPartialSum.monotone with sequenceW, scaled, upper
  have second := realPartialSum.monotone with negated, scaled, lower
  rw (realPartialSum.neg with sequenceW) at second
  rw (realPartialSum.scale with sequenceB) at first
  rw (realPartialSum.scale with sequenceB) at second
  have partial := SumsTo.partial_le at b, Z, N with sums, nonnegative
  have scaledPartial := realLe.mul_left_of_nonnegative with partial,
    nonnegativeC
  apply abs.le_of_two_sided
  . linarith
  . linarith

-- At x = 0, by continuity from (0, 1/2].
theorem fourierSeries.at_zero
  shows SumsTo(fourierDifferenceTerms(R[0], R[1 / 2]), R[1 / 4])
proof
  have termsSequence : RealSequence(fourierDifferenceTerms(R[0], R[1 / 2])) by
    exact fourierDifferenceTerms.function at R[0], R[1 / 2]
  apply SumsTo.of_converges with termsSequence
  refine ⟨(prefixSums.sequence with termsSequence), ?_⟩
  intros E eReal ePositive
  have typedE : Real(E) by exact eReal
  have below : R[-3 / 2] < R[-1] by linarith
  obtain ⟨Z1, z1Real, sum1⟩ := naturalPowers.summable with below
  have typedZ1 : Real(Z1) by exact z1Real
  have nonnegative1 : NonnegativeTerms(naturalPowers(R[-3 / 2]))
    intros n nMember
    have typedN := nat.omega.backward with nMember
    apply realLe.characterization.forward
    rw naturalPowers.value
    exact realLess.implies_le with (realRpow.positive at realNat(n + 1),
      R[-3 / 2])
  have zeroPartial := SumsTo.partial_le at naturalPowers(R[-3 / 2]), Z1, 0
    with sum1, nonnegative1
  rw realPartialSum.zero at zeroPartial
  have piPositive := realPi.positive
  have piSquare := realLess.mul_left_of_positive with piPositive, piPositive
  have zeroPi : R[realPi * 0] = R[0] by ring
  rw zeroPi at piSquare
  have piInverse := realInvValue.positive with piSquare
  have root := realRpow.positive at R[4 * realPi], R[1 / 2]
  have kPositive := realLess.mul_left_of_positive with piInverse, root
  have zeroRoot : R[realRpow(R[4 * realPi], R[1 / 2]) * 0] = R[0] by ring
  rw zeroRoot at kPositive
  have kz := realLe.mul_left_of_nonnegative with zeroPartial,
    (realLess.implies_le with kPositive)
  have kzZero : R[R[realRpow(R[4 * realPi], R[1 / 2]) *
    realInvValue(R[realPi * realPi])] * 0] = R[0] by ring
  have mPositive : R[0] < R[realRpow(R[4 * realPi], R[1 / 2]) *
    realInvValue(R[realPi * realPi]) * Z1 + 1] by linarith
  have mNonzero : R[realRpow(R[4 * realPi], R[1 / 2]) *
    realInvValue(R[realPi * realPi]) * Z1 + 1] ≠ R[0] by linarith
  have mInverse := realInvValue.mul_right with mNonzero
  have mInversePositive := realInvValue.positive with mPositive
  have e3 : R[0] < R[E / 3] by linarith
  have rootTolerance := realLess.mul_left_of_positive with mInversePositive,
    e3
  have zeroE3 : R[R[E / 3] * 0] = R[0] by ring
  rw zeroE3 at rootTolerance
  have halfExponent : R[0] < R[1 / 2] by linarith
  obtain ⟨d1, d1Real, d1Positive, rootSmall⟩ := realRpow.small_base with
    halfExponent, rootTolerance
  obtain ⟨d2, d2Real, d2Positive, below1, below2, below3⟩ :=
    positiveMesh.common_three with d1Positive, e3, halfExponent
  have xPositive := half.positive with d2Positive
  have halves := half.add_self at d2
  have typedD2 : Real(d2) by exact d2Real
  have xReal : half(d2) ∈ ℝ by typecheck
  have xBelowD1 : half(d2) < d1 by linarith
  have xAtMostHalf : half(d2) ≤ R[1 / 2] by linarith
  have rootX := rootSmall with half(d2), xReal, xPositive, xBelowD1
  have sumsX := fourierSeries.left_half with xPositive, xAtMostHalf
  have convergesX := SumsTo.converges with sumsX
  obtain ⟨_, limitX⟩ := convergesX
  have e3Real : R[E / 3] ∈ ℝ by typecheck
  obtain ⟨N0, n0Member, closeX⟩ := limitX with R[E / 3], e3Real, e3
  refine ⟨N0, n0Member, ?_⟩
  intros N nMember later
  have typedN := nat.omega.backward with nMember
  have ballX := closeX with N, nMember, later
  have sequenceX : RealSequence(fourierDifferenceTerms(half(d2), R[1 / 2])) by
    exact fourierDifferenceTerms.function at half(d2), R[1 / 2]
  rw (prefixSums.value at fourierDifferenceTerms(half(d2), R[1 / 2]), N with
    sequenceX, nMember) at ballX
  have sumXReal := realPartialSum.real at fourierDifferenceTerms(half(d2),
    R[1 / 2]), N with sequenceX
  have nearX := openBall.abs with ballX
  rw (prefixSums.value at fourierDifferenceTerms(R[0], R[1 / 2]), N with
    termsSequence, nMember)
  apply openBall.of_abs
  have sum0Real := realPartialSum.real at fourierDifferenceTerms(R[0],
    R[1 / 2]), N with termsSequence
  -- The difference of the two partial sums.
  have difference := subSequence.sequence with termsSequence, sequenceX
  have dominated : ∀ n ∈ ℕ, abs(subSequence(fourierDifferenceTerms(R[0],
      R[1 / 2]), fourierDifferenceTerms(half(d2), R[1 / 2]))(n)) ≤
      R[R[realRpow(R[4 * realPi], R[1 / 2]) * realInvValue(R[realPi *
      realPi]) * realRpow(half(d2), R[1 / 2])] * naturalPowers(R[-3 / 2])(n)]
    intros n nMember2
    have typedN2 := nat.omega.backward with nMember2
    have t0 := RealSequence.value at fourierDifferenceTerms(R[0], R[1 / 2]), n
      with termsSequence
    have tx := RealSequence.value at fourierDifferenceTerms(half(d2),
      R[1 / 2]), n with sequenceX
    rw [(subSequence.value at fourierDifferenceTerms(R[0], R[1 / 2]),
      fourierDifferenceTerms(half(d2), R[1 / 2]), n with termsSequence,
      sequenceX, t0, tx), (naturalPowers.value at R[-3 / 2], n with nMember2)]
    obtain ⟨bound, _⟩ := fourierDifferenceTerms.bounds at R[0], half(d2), n
      with xPositive
    rw [(fourierDifferenceTerms.value at R[half(d2) - 0], R[-0], n with
      nMember2)] at bound
    rw [(fourierDifferenceTerms.value at R[0], R[1 / 2], n with nMember2),
      (fourierDifferenceTerms.value at half(d2), R[1 / 2], n with nMember2)]
    have e1 : R[2 * realPi * realNat(n + 1) * R[half(d2) - 0]] =
      R[2 * realPi * realNat(n + 1) * half(d2)] by ring
    have e2 : R[2 * realPi * realNat(n + 1) * R[-0]] =
      R[2 * realPi * realNat(n + 1) * R[0]] by ring
    rw [e1, e2] at bound
    have c0 := realCos.real at R[2 * realPi * realNat(n + 1) * R[0]]
    have cx := realCos.real at R[2 * realPi * realNat(n + 1) * half(d2)]
    have ch := realCos.real at R[2 * realPi * realNat(n + 1) * R[1 / 2]]
    have i := realInvValue.real at R[realPi * realPi * realNat(n + 1) *
      realNat(n + 1)]
    have shape : R[(realCos(R[2 * realPi * realNat(n + 1) * R[0]]) -
        realCos(R[2 * realPi * realNat(n + 1) * R[1 / 2]])) *
        realInvValue(R[realPi * realPi * realNat(n + 1) * realNat(n + 1)]) -
        (realCos(R[2 * realPi * realNat(n + 1) * half(d2)]) -
        realCos(R[2 * realPi * realNat(n + 1) * R[1 / 2]])) *
        realInvValue(R[realPi * realPi * realNat(n + 1) * realNat(n + 1)])] =
        R[-((realCos(R[2 * realPi * realNat(n + 1) * half(d2)]) -
        realCos(R[2 * realPi * realNat(n + 1) * R[0]])) *
        realInvValue(R[realPi * realPi * realNat(n + 1) * realNat(n + 1)]))]
      by ring
    unfold realSubValue
    rw [shape, abs.neg]
    have reshape : R[realRpow(R[4 * realPi], R[1 / 2]) * realInvValue(R[realPi *
        realPi]) * realRpow(half(d2), R[1 / 2]) *
        realRpow(realNat(n + 1), R[-3 / 2])] = R[R[realRpow(R[4 * realPi],
        R[1 / 2]) * realInvValue(R[realPi * realPi]) *
        realRpow(half(d2), R[1 / 2])] * realRpow(realNat(n + 1), R[-3 / 2])]
      by ring
    exact bound
  have rootPositive := realRpow.positive at half(d2), R[1 / 2]
  have cNonnegative := realLess.mul_left_of_positive with rootPositive,
    kPositive
  have zeroC : R[R[realRpow(R[4 * realPi], R[1 / 2]) *
    realInvValue(R[realPi * realPi])] * 0] = R[0] by ring
  rw zeroC at cNonnegative
  have cNonneg : R[0] ≤ R[realRpow(R[4 * realPi], R[1 / 2]) *
    realInvValue(R[realPi * realPi]) * realRpow(half(d2), R[1 / 2])] by linarith
  have bound := realPartialSum.abs_bound with difference, sum1, nonnegative1,
    cNonneg, dominated
  rw (realPartialSum.sub with termsSequence, sequenceX) at bound
  unfold realSubValue at bound
  -- Collect: |Σ₀ − 1/4| ≤ |Σ₀ − Σₓ| + |Σₓ − (1/2 − x)²| + |(1/2 − x)² − 1/4|.
  have t1 := abs.triangle at R[realPartialSum(fourierDifferenceTerms(R[0],
    R[1 / 2]), N) - realPartialSum(fourierDifferenceTerms(half(d2), R[1 / 2]),
    N)], R[realPartialSum(fourierDifferenceTerms(half(d2), R[1 / 2]), N) -
    R[1 / 4]]
  have t2 := abs.triangle at R[realPartialSum(fourierDifferenceTerms(half(d2),
    R[1 / 2]), N) - (R[1 / 2] - half(d2)) * (R[1 / 2] - half(d2))],
    R[(R[1 / 2] - half(d2)) * (R[1 / 2] - half(d2)) - R[1 / 4]]
  have split1 : R[R[realPartialSum(fourierDifferenceTerms(R[0], R[1 / 2]), N) -
      realPartialSum(fourierDifferenceTerms(half(d2), R[1 / 2]), N)] +
      R[realPartialSum(fourierDifferenceTerms(half(d2), R[1 / 2]), N) -
      R[1 / 4]]] = R[realPartialSum(fourierDifferenceTerms(R[0], R[1 / 2]), N) -
      R[1 / 4]] by ring
  have split2 : R[R[realPartialSum(fourierDifferenceTerms(half(d2), R[1 / 2]),
      N) - (R[1 / 2] - half(d2)) * (R[1 / 2] - half(d2))] +
      R[(R[1 / 2] - half(d2)) * (R[1 / 2] - half(d2)) - R[1 / 4]]] =
      R[realPartialSum(fourierDifferenceTerms(half(d2), R[1 / 2]), N) -
      R[1 / 4]] by ring
  rw split1 at t1
  rw split2 at t2
  have third : abs(R[(R[1 / 2] - half(d2)) * (R[1 / 2] - half(d2)) -
      R[1 / 4]]) ≤ half(d2)
    have xLeOne : half(d2) ≤ R[1] by linarith
    have square := realLe.mul_left_of_nonnegative with xLeOne,
      (realLess.implies_le with xPositive)
    have one : R[half(d2) * 1] = half(d2) by ring
    apply abs.le_of_two_sided
    . have expand : R[(R[1 / 2] - half(d2)) * (R[1 / 2] - half(d2)) -
        R[1 / 4]] = R[half(d2) * half(d2) - half(d2)] by ring
      have sq := realLe.mul_left_of_nonnegative with
        (realLess.implies_le with xPositive), (realLess.implies_le with
        xPositive)
      have zero : R[half(d2) * 0] = R[0] by ring
      linarith
    . have expand : R[(R[1 / 2] - half(d2)) * (R[1 / 2] - half(d2)) -
        R[1 / 4]] = R[half(d2) * half(d2) - half(d2)] by ring
      linarith
  have rootBound := realLess.mul_left_of_positive with rootX, mPositive
  have collapse : R[R[realRpow(R[4 * realPi], R[1 / 2]) *
      realInvValue(R[realPi * realPi]) * Z1 + 1] * (R[E / 3] *
      realInvValue(R[realRpow(R[4 * realPi], R[1 / 2]) *
      realInvValue(R[realPi * realPi]) * Z1 + 1]))] = R[E / 3]
    linear_combination R[E / 3] * mInverse
  have cz : R[R[realRpow(R[4 * realPi], R[1 / 2]) * realInvValue(R[realPi *
      realPi]) * realRpow(half(d2), R[1 / 2])] * Z1] ≤
      R[R[realRpow(R[4 * realPi], R[1 / 2]) * realInvValue(R[realPi * realPi]) *
      Z1 + 1] * realRpow(half(d2), R[1 / 2])]
    have expand : R[R[realRpow(R[4 * realPi], R[1 / 2]) *
        realInvValue(R[realPi * realPi]) * Z1 + 1] *
        realRpow(half(d2), R[1 / 2])] = R[R[realRpow(R[4 * realPi], R[1 / 2]) *
        realInvValue(R[realPi * realPi]) * realRpow(half(d2), R[1 / 2])] * Z1 +
        realRpow(half(d2), R[1 / 2])] by ring
    linarith
  have xSmall : half(d2) < R[E / 3] by linarith
  linarith

-- P̃₂(x) = x² − x + 1/6 on [0, 1).
theorem periodicBernoulli.two_cell (X : Real)
  requires lower : R[0] ≤ X
  requires upper : X < R[1]
  shows periodicBernoulli(2)(X) = R[X * X - X + 1 / 6]
proof
  have zero := realInt.zero
  have low : realInt(integerZero) ≤ X
    rw zero
    exact lower
  have high : X < R[realInt(integerZero) + 1]
    rw zero
    linarith
  rw [(periodicBernoulli.on_cell with low, high), zero,
    bernoulliPolynomial.two_index]
  ring

theorem periodicBernoulli.fourier_half (X : Real)
  shows SumsTo(fourierDifferenceTerms(X, R[1 / 2]),
    R[periodicBernoulli(2)(X) - periodicBernoulli(2)(R[1 / 2])])
proof
  have decomposition := fractionalPart.decomposition at X
  have fracReal := fractionalPart.real at X
  have nonnegative := fractionalPart.nonnegative at X
  have belowOne := fractionalPart.lt_one at X
  have floorMember := integerFloor.integer at X
  have floorReal := realInt.real at integerFloor(X)
  have shape : X = R[fractionalPart(X) + realInt(integerFloor(X))]
    by linarith
  have halfLower : R[0] ≤ R[1 / 2] by linarith
  have halfUpper : R[1 / 2] < R[1] by linarith
  have halfValue := periodicBernoulli.two_cell with halfLower, halfUpper
  rw [shape, (fourierDifferenceTerms.periodic at fractionalPart(X),
    R[1 / 2], integerFloor(X)), periodicBernoulli.periodic, halfValue,
    (periodicBernoulli.two_cell with nonnegative, belowOne)]
  have target : R[fractionalPart(X) * fractionalPart(X) - fractionalPart(X) +
      1 / 6 - (R[1 / 2] * R[1 / 2] - R[1 / 2] + 1 / 6)] =
      R[(R[1 / 2] - fractionalPart(X)) * (R[1 / 2] - fractionalPart(X))]
    by ring
  rw target
  by_cases zero : fractionalPart(X) = R[0]
  . rw zero
    have quarter : R[(R[1 / 2] - R[0]) * (R[1 / 2] - R[0])] = R[1 / 4] by ring
    rw quarter
    exact fourierSeries.at_zero
  . have positive : R[0] < fractionalPart(X)
      by_contra notPositive
      apply zero
      linarith
    by_cases small : fractionalPart(X) ≤ R[1 / 2]
    . exact fourierSeries.left_half with positive, small
    . have reflectedPositive : R[0] < R[1 - fractionalPart(X)] by linarith
      have reflectedSmall : R[1 - fractionalPart(X)] ≤ R[1 / 2] by linarith
      have sums := fourierSeries.left_half with reflectedPositive,
        reflectedSmall
      rw fourierDifferenceTerms.reflect at sums
      have value : R[(R[1 / 2] - R[1 - fractionalPart(X)]) *
          (R[1 / 2] - R[1 - fractionalPart(X)])] =
          R[(R[1 / 2] - fractionalPart(X)) * (R[1 / 2] - fractionalPart(X))]
        by ring
      rw value at sums
      exact sums

-- The Fourier series of P̃₂ up to a constant:
-- Σ_{n≥1} (cos 2πnx − cos 2πnx₀)/(π²n²) = P̃₂(x) − P̃₂(x₀).
theorem periodicBernoulli.fourier_difference (X X0 : Real)
  shows SumsTo(fourierDifferenceTerms(X, X0),
    R[periodicBernoulli(2)(X) - periodicBernoulli(2)(X0)])
proof
  have bernoulliF := periodicBernoulli.function at 2
  have xMember : X ∈ ℝ by typecheck
  have x0Member : X0 ∈ ℝ by typecheck
  have halfMember : R[1 / 2] ∈ ℝ by typecheck
  have v1 := FunctionBetween.apply_closed with bernoulliF, xMember
  have v2 := FunctionBetween.apply_closed with bernoulliF, x0Member
  have v3 := FunctionBetween.apply_closed with bernoulliF, halfMember
  have r1 : Real(periodicBernoulli(2)(X)) by exact v1
  have r2 : Real(periodicBernoulli(2)(X0)) by exact v2
  have r3 : Real(periodicBernoulli(2)(R[1 / 2])) by exact v3
  have first := periodicBernoulli.fourier_half at X
  have second := periodicBernoulli.fourier_half at X0
  have difference := SumsTo.sub with first, second
  have sequence1 : RealSequence(fourierDifferenceTerms(X, R[1 / 2])) by
    exact fourierDifferenceTerms.function at X, R[1 / 2]
  have sequence2 : RealSequence(fourierDifferenceTerms(X0, R[1 / 2])) by
    exact fourierDifferenceTerms.function at X0, R[1 / 2]
  have same : subSequence(fourierDifferenceTerms(X, R[1 / 2]),
      fourierDifferenceTerms(X0, R[1 / 2])) = fourierDifferenceTerms(X, X0)
    apply FunctionBetween.ext with (subSequence.sequence with sequence1,
      sequence2), (fourierDifferenceTerms.function at X, X0)
    intros n nMember
    have typedN := nat.omega.backward with nMember
    have t1 := RealSequence.value at fourierDifferenceTerms(X, R[1 / 2]), n
      with sequence1
    have t2 := RealSequence.value at fourierDifferenceTerms(X0, R[1 / 2]), n
      with sequence2
    rw [(subSequence.value at fourierDifferenceTerms(X, R[1 / 2]),
      fourierDifferenceTerms(X0, R[1 / 2]), n with sequence1, sequence2, t1,
      t2), (fourierDifferenceTerms.value at X, R[1 / 2], n with nMember),
      (fourierDifferenceTerms.value at X0, R[1 / 2], n with nMember),
      (fourierDifferenceTerms.value at X, X0, n with nMember)]
    unfold realSubValue
    ring
  rw same at difference
  unfold realSubValue at difference
  have value : R[R[periodicBernoulli(2)(X) - periodicBernoulli(2)(R[1 / 2])] -
      R[periodicBernoulli(2)(X0) - periodicBernoulli(2)(R[1 / 2])]] =
      R[periodicBernoulli(2)(X) - periodicBernoulli(2)(X0)] by ring
  rw value at difference
  exact difference

-- The remainder of the Fourier series against y^(v−1), y > 0.
theorem bernoulliMellin.remainder (a v Y Z1 Z2 : Real) (N : Nat)
  requires positive : R[0] < Y
  requires sum1 : SumsTo(naturalPowers(R[-3 / 2]), Z1)
  requires sum2 : SumsTo(naturalPowers(R[-2]), Z2)
  shows complexAbs(ℂ[bernoulliMellinIntegrand(a, v)(Y) -
      fourierMellinPartial(a, v, N)(Y)]) ≤
      R[realRpow(R[4 * realPi], R[1 / 2]) * realInvValue(R[realPi * realPi]) *
        (Z1 - realPartialSum(naturalPowers(R[-3 / 2]), N)) *
        realRpow(Y, R[v - 1 / 2])] ∧
    complexAbs(ℂ[bernoulliMellinIntegrand(a, v)(Y) -
      fourierMellinPartial(a, v, N)(Y)]) ≤
      R[2 * realInvValue(R[realPi * realPi]) *
        (Z2 - realPartialSum(naturalPowers(R[-2]), N)) *
        realRpow(Y, R[v - 1])]
proof
  have yMember : Y ∈ ℝ by typecheck
  have shifted : R[Y - a] ∈ ℝ by typecheck
  have minusA : R[-a] ∈ ℝ by typecheck
  have bernoulli1 := FunctionBetween.apply_closed with
    (periodicBernoulli.function at 2), shifted
  have bernoulli2 := FunctionBetween.apply_closed with
    (periodicBernoulli.function at 2), minusA
  have bernoulliReal1 : Real(periodicBernoulli(2)(R[Y - a])) by
    exact bernoulli1
  have bernoulliReal2 : Real(periodicBernoulli(2)(R[-a])) by exact bernoulli2
  have fourier := periodicBernoulli.fourier_difference at R[Y - a], R[-a]
  have terms := fourierDifferenceTerms.function at R[Y - a], R[-a]
  have sequence : RealSequence(fourierDifferenceTerms(R[Y - a], R[-a])) by
    exact terms
  have bound1 : ∀ n ∈ ℕ, abs(fourierDifferenceTerms(R[Y - a], R[-a])(n)) ≤
      R[R[realRpow(R[4 * realPi], R[1 / 2]) * realInvValue(R[realPi *
      realPi]) * realRpow(Y, R[1 / 2])] * naturalPowers(R[-3 / 2])(n)]
    intros n nMember
    have typedN := nat.omega.backward with nMember
    obtain ⟨first, _⟩ := fourierDifferenceTerms.bounds at a, Y, n with
      positive
    rw (naturalPowers.value at R[-3 / 2], n with nMember)
    exact first
  have bound2 : ∀ n ∈ ℕ, abs(fourierDifferenceTerms(R[Y - a], R[-a])(n)) ≤
      R[R[2 * realInvValue(R[realPi * realPi])] * naturalPowers(R[-2])(n)]
    intros n nMember
    have typedN := nat.omega.backward with nMember
    obtain ⟨_, second⟩ := fourierDifferenceTerms.bounds at a, Y, n with
      positive
    rw (naturalPowers.value at R[-2], n with nMember)
    exact second
  have remainder1 := SumsTo.remainder_bound_scaled with fourier, sum1, bound1
  have remainder2 := SumsTo.remainder_bound_scaled with fourier, sum2, bound2
  have partialReal := realPartialSum.real at fourierDifferenceTerms(R[Y - a],
    R[-a]), N with sequence
  have powerPositive := realRpow.positive at Y, R[v - 1]
  rw [(bernoulliMellinIntegrand.value at a, v, Y with yMember),
    (fourierMellinPartial.value at a, v, N, Y with yMember),
    ← complexOfReal.sub, complexAbs.of_real]
  have factor : R[(periodicBernoulli(2)(R[Y - a]) -
      periodicBernoulli(2)(R[-a])) * realRpow(Y, R[v - 1]) -
      realPartialSum(fourierDifferenceTerms(R[Y - a], R[-a]), N) *
      realRpow(Y, R[v - 1])] = R[(periodicBernoulli(2)(R[Y - a]) -
      periodicBernoulli(2)(R[-a]) - realPartialSum(fourierDifferenceTerms(
      R[Y - a], R[-a]), N)) * realRpow(Y, R[v - 1])] by ring
  rw [factor, abs.mul, (abs.of_nonnegative with (realLess.implies_le with
    powerPositive))]
  have scaled1 := realLe.mul_right_of_nonnegative with remainder1,
    (realLess.implies_le with powerPositive)
  have scaled2 := realLe.mul_right_of_nonnegative with remainder2,
    (realLess.implies_le with powerPositive)
  have split := realRpow.add at Y, R[1 / 2], R[v - 1] with positive
  have exponent : R[1 / 2 + (v - 1)] = R[v - 1 / 2] by linarith
  rw exponent at split
  have p1 := realRpow.real at Y, R[1 / 2]
  have z1 := realPartialSum.real at naturalPowers(R[-3 / 2]), N with
    (naturalPowers.function at R[-3 / 2])
  have z2 := realPartialSum.real at naturalPowers(R[-2]), N with
    (naturalPowers.function at R[-2])
  have k1 := realRpow.real at R[4 * realPi], R[1 / 2]
  have k2 := realInvValue.real at R[realPi * realPi]
  refine ⟨?_, ?_⟩
  . have shape : R[R[realRpow(R[4 * realPi], R[1 / 2]) *
        realInvValue(R[realPi * realPi]) * realRpow(Y, R[1 / 2])] *
        (Z1 - realPartialSum(naturalPowers(R[-3 / 2]), N)) *
        realRpow(Y, R[v - 1])] = R[realRpow(R[4 * realPi], R[1 / 2]) *
        realInvValue(R[realPi * realPi]) *
        (Z1 - realPartialSum(naturalPowers(R[-3 / 2]), N)) *
        realRpow(Y, R[v - 1 / 2])]
      rw split
      ring
    rw shape at scaled1
    exact scaled1
  . exact scaled2

theorem complexCombination.integral (c1 f c2 g : Set) (A B : Real)
  requires hc1 : c1 ∈ ℂ
  requires hc2 : c2 ∈ ℂ
  requires ordered : A ≤ B
  requires integrableF : ComplexRiemannIntegrable(f, A, B)
  requires integrableG : ComplexRiemannIntegrable(g, A, B)
  shows complexIntegral(complexCombination(c1, f, c2, g), A, B) =
    ℂ[c1 * complexIntegral(f, A, B) + c2 * complexIntegral(g, A, B)]
proof
  have valuesF := integrableF.left
  have valuesG := integrableG.left
  obtain ⟨first, firstValue⟩ := complexIntegral.const_mul with hc1, ordered,
    integrableF
  obtain ⟨second, secondValue⟩ := complexIntegral.const_mul with hc2, ordered,
    integrableG
  obtain ⟨sum, sumValue⟩ := complexIntegral.add with ordered, first, second
  have combination := complexCombination.function at c1, f, c2, g with hc1,
    hc2, valuesF, valuesG
  have valuesH : ComplexValuedOn(complexCombination(c1, f, c2, g), ℝ)
    intros X xMember
    exact FunctionBetween.apply_closed with combination, xMember
  have constant1 := complexFunctionConst.function at c1, ℝ with hc1
  have constant2 := complexFunctionConst.function at c2, ℝ with hc2
  have valuesC1 : ComplexValuedOn(complexFunctionConst(c1, ℝ), ℝ)
    intros X xMember
    exact FunctionBetween.apply_closed with constant1, xMember
  have valuesC2 : ComplexValuedOn(complexFunctionConst(c2, ℝ), ℝ)
    intros X xMember
    exact FunctionBetween.apply_closed with constant2, xMember
  have product1 := complexFunctionMul.function with valuesC1, valuesF
  have product2 := complexFunctionMul.function with valuesC2, valuesG
  have valuesP1 : ComplexValuedOn(
      complexFunctionMul(complexFunctionConst(c1, ℝ), f, ℝ), ℝ)
    intros X xMember
    exact FunctionBetween.apply_closed with product1, xMember
  have valuesP2 : ComplexValuedOn(
      complexFunctionMul(complexFunctionConst(c2, ℝ), g, ℝ), ℝ)
    intros X xMember
    exact FunctionBetween.apply_closed with product2, xMember
  have agree : ∀ X ∈ ℝ, complexFunctionAdd(
      complexFunctionMul(complexFunctionConst(c1, ℝ), f, ℝ),
      complexFunctionMul(complexFunctionConst(c2, ℝ), g, ℝ), ℝ)(X) =
      complexCombination(c1, f, c2, g)(X)
    intros X xMember
    rw [(complexFunctionAdd.value with valuesP1, valuesP2, xMember),
      (complexFunctionMul.value with valuesC1, valuesF, xMember),
      (complexFunctionMul.value with valuesC2, valuesG, xMember),
      (complexFunctionConst.value with hc1, xMember),
      (complexFunctionConst.value with hc2, xMember),
      (complexCombination.value with hc1, hc2, valuesF, valuesG, xMember)]
  obtain ⟨_, value⟩ := ComplexRiemannIntegrable.congr with sum, valuesH,
    agree
  rw [value, sumValue, firstValue, secondValue]

-- ∫_A^B K x^S dx for 0 < A ≤ B and S ≠ −1.
theorem scaledRpow.integral (K S A B : Real)
  requires positive : R[0] < A
  requires ordered : A ≤ B
  requires exponent : R[S + 1] ≠ R[0]
  shows RiemannIntegrable(pointwiseMul(constantRealFunction(K),
      rpowFunction(S)), A, B) ∧
    riemannIntegral(pointwiseMul(constantRealFunction(K), rpowFunction(S)),
      A, B) = R[K * (realInvValue(R[S + 1]) * realRpow(B, R[S + 1]) -
        realInvValue(R[S + 1]) * realRpow(A, R[S + 1]))]
proof
  have shifted : R[1 - R[-S]] ≠ R[0]
    intro zero
    apply exponent
    linarith
  have integral := rpowFunction.has_integral at A, B, R[-S] with positive,
    ordered, shifted
  have negneg : R[-R[-S]] = S by ring
  have plus : R[1 + S] = R[S + 1] by ring
  rw [negneg, plus] at integral
  have constant := constantRealFunction.function at K
  have power := rpowFunction.function at S
  have product := pointwiseMul.function with constant, power
  have values : ∀ X ∈ ℝ, pointwiseMul(constantRealFunction(K),
      rpowFunction(S))(X) = R[K * rpowFunction(S)(X) +
      0 * rpowFunction(S)(X)]
    intros X xMember
    have typedX : Real(X) by exact xMember
    rw [(pointwiseMul.apply with constant, power), constantRealFunction.value,
      rpowFunction.value]
    ring
  have combined := HasRiemannIntegral.linear with integral, integral, product,
    values
  have valueReal : R[K * (realInvValue(R[S + 1]) * realRpow(B, R[S + 1]) -
    realInvValue(R[S + 1]) * realRpow(A, R[S + 1])) + 0 *
    (realInvValue(R[S + 1]) * realRpow(B, R[S + 1]) -
    realInvValue(R[S + 1]) * realRpow(A, R[S + 1]))] ∈ ℝ by typecheck
  refine ⟨⟨R[K * (realInvValue(R[S + 1]) * realRpow(B, R[S + 1]) -
    realInvValue(R[S + 1]) * realRpow(A, R[S + 1])) + 0 *
    (realInvValue(R[S + 1]) * realRpow(B, R[S + 1]) -
    realInvValue(R[S + 1]) * realRpow(A, R[S + 1]))], valueReal, combined⟩,
    ?_⟩
  rw (riemannIntegral.eq_of_integral with combined)
  ring

-- |∫_A^T (g − Φ_N)| ≤ ε_N for 0 < A ≤ 1 ≤ T, uniformly in A and T.
theorem bernoulliMellin.integral_remainder (a v A T Z1 Z2 : Real) (N : Nat)
  requires positive : R[0] < A
  requires belowOne : A ≤ R[1]
  requires laterOne : R[1] ≤ T
  requires lower : R[-1 / 2] < v
  requires upper : v < R[0]
  requires sum1 : SumsTo(naturalPowers(R[-3 / 2]), Z1)
  requires sum2 : SumsTo(naturalPowers(R[-2]), Z2)
  requires integrableB : ComplexRiemannIntegrable(bernoulliMellinIntegrand(a,
    v), A, T)
  requires integrableP : ComplexRiemannIntegrable(fourierMellinPartial(a, v,
    N), A, T)
  shows complexAbs(ℂ[complexIntegral(bernoulliMellinIntegrand(a, v), A, T) -
      complexIntegral(fourierMellinPartial(a, v, N), A, T)]) ≤
    R[realRpow(R[4 * realPi], R[1 / 2]) * realInvValue(R[realPi * realPi]) *
        (Z1 - realPartialSum(naturalPowers(R[-3 / 2]), N)) *
        realInvValue(R[v + 1 / 2]) +
      2 * realInvValue(R[realPi * realPi]) *
        (Z2 - realPartialSum(naturalPowers(R[-2]), N)) *
        -realInvValue(v)]
proof
  have one : ℂ[1] ∈ ℂ by typecheck
  have minusOne : ℂ[-1] ∈ ℂ by typecheck
  have ordered : A ≤ T by linarith
  have combinationIntegrable := complexCombination.integrable with one,
    minusOne, ordered, integrableB, integrableP
  have combinationValue := complexCombination.integral with one, minusOne,
    ordered, integrableB, integrableP
  have bMember := complexIntegral.member at bernoulliMellinIntegrand(a, v), A,
    T
  have pMember := complexIntegral.member at fourierMellinPartial(a, v, N), A, T
  have difference : ℂ[complexIntegral(bernoulliMellinIntegrand(a, v), A, T) -
      complexIntegral(fourierMellinPartial(a, v, N), A, T)] =
      complexIntegral(complexCombination(ℂ[1], bernoulliMellinIntegrand(a, v),
        ℂ[-1], fourierMellinPartial(a, v, N)), A, T)
    rw combinationValue
    ring
  rw difference
  obtain ⟨first, second, split⟩ := complexIntegral.add_interval with
    belowOne, laterOne, combinationIntegrable
  rw ← split
  have valuesB := integrableB.left
  have valuesP := integrableP.left
  have pointwise : ∀ X ∈ ℝ, complexCombination(ℂ[1], bernoulliMellinIntegrand(a,
      v), ℂ[-1], fourierMellinPartial(a, v, N))(X) =
      ℂ[bernoulliMellinIntegrand(a, v)(X) - fourierMellinPartial(a, v, N)(X)]
    intros X xMember
    have b := valuesB with X, xMember
    have p := valuesP with X, xMember
    rw (complexCombination.value with one, minusOne, valuesB, valuesP, xMember)
    ring
  -- The two constants are nonnegative.
  have nonnegative1 : NonnegativeTerms(naturalPowers(R[-3 / 2]))
    intros n nMember
    have typedN := nat.omega.backward with nMember
    apply realLe.characterization.forward
    rw naturalPowers.value
    exact realLess.implies_le with (realRpow.positive at realNat(n + 1),
      R[-3 / 2])
  have nonnegative2 : NonnegativeTerms(naturalPowers(R[-2]))
    intros n nMember
    have typedN := nat.omega.backward with nMember
    apply realLe.characterization.forward
    rw naturalPowers.value
    exact realLess.implies_le with (realRpow.positive at realNat(n + 1),
      R[-2])
  have partial1 := SumsTo.partial_le at naturalPowers(R[-3 / 2]), Z1, N with
    sum1, nonnegative1
  have partial2 := SumsTo.partial_le at naturalPowers(R[-2]), Z2, N with sum2,
    nonnegative2
  have piPositive := realPi.positive
  have piSquare := realLess.mul_left_of_positive with piPositive, piPositive
  have zeroPi : R[realPi * 0] = R[0] by ring
  rw zeroPi at piSquare
  have piInverse := realInvValue.positive with piSquare
  have fourPi : R[0] < R[4 * realPi] by linarith
  have rootPositive := realRpow.positive at R[4 * realPi], R[1 / 2]
  have s1 := realPartialSum.real at naturalPowers(R[-3 / 2]), N with
    (naturalPowers.function at R[-3 / 2])
  have s2 := realPartialSum.real at naturalPowers(R[-2]), N with
    (naturalPowers.function at R[-2])
  have gap1 : R[0] ≤ R[Z1 - realPartialSum(naturalPowers(R[-3 / 2]), N)]
    by linarith
  have gap2 : R[0] ≤ R[Z2 - realPartialSum(naturalPowers(R[-2]), N)]
    by linarith
  have k1a := realLe.mul_left_of_nonnegative with gap1,
    (realLess.implies_le with piInverse)
  have k1b := realLe.mul_left_of_nonnegative with k1a,
    (realLess.implies_le with rootPositive)
  have zeros : R[realRpow(R[4 * realPi], R[1 / 2]) * (realInvValue(R[realPi *
    realPi]) * 0)] = R[0] by ring
  have k1 : R[0] ≤ R[realRpow(R[4 * realPi], R[1 / 2]) *
      realInvValue(R[realPi * realPi]) *
      (Z1 - realPartialSum(naturalPowers(R[-3 / 2]), N))]
    have shape : R[realRpow(R[4 * realPi], R[1 / 2]) * (realInvValue(R[realPi *
        realPi]) * (Z1 - realPartialSum(naturalPowers(R[-3 / 2]), N)))] =
        R[realRpow(R[4 * realPi], R[1 / 2]) * realInvValue(R[realPi * realPi]) *
        (Z1 - realPartialSum(naturalPowers(R[-3 / 2]), N))] by ring
    linarith
  have twoInverse : R[0] < R[2 * realInvValue(R[realPi * realPi])] by linarith
  have k2a := realLe.mul_left_of_nonnegative with gap2,
    (realLess.implies_le with twoInverse)
  have zero2 : R[R[2 * realInvValue(R[realPi * realPi])] * 0] = R[0] by ring
  have k2 : R[0] ≤ R[2 * realInvValue(R[realPi * realPi]) *
      (Z2 - realPartialSum(naturalPowers(R[-2]), N))] by linarith
  -- On [A, 1], against K₁ x^(v−1/2).
  have exponent1 : R[R[v - 1 / 2] + 1] ≠ R[0]
    intro zero
    linarith
  obtain ⟨g1Integrable, g1Value⟩ := scaledRpow.integral at R[realRpow(R[4 *
    realPi], R[1 / 2]) * realInvValue(R[realPi * realPi]) *
    (Z1 - realPartialSum(naturalPowers(R[-3 / 2]), N))], R[v - 1 / 2], A, R[1]
    with positive, belowOne, exponent1
  have bound1 : ∀ X ∈ closedInterval(A, R[1]), complexAbs(complexCombination(
      ℂ[1], bernoulliMellinIntegrand(a, v), ℂ[-1],
      fourierMellinPartial(a, v, N))(X)) ≤ pointwiseMul(constantRealFunction(
      R[realRpow(R[4 * realPi], R[1 / 2]) * realInvValue(R[realPi * realPi]) *
      (Z1 - realPartialSum(naturalPowers(R[-3 / 2]), N))]),
      rpowFunction(R[v - 1 / 2]))(X)
    intros X xMember
    obtain ⟨xReal, low, _⟩ := closedInterval.membership.forward with xMember
    have typedX : Real(X) by exact xReal
    have xPositive : R[0] < X by linarith
    obtain ⟨estimate, _⟩ := bernoulliMellin.remainder at a, v, X, Z1, Z2, N
      with xPositive, sum1, sum2
    rw [(pointwise with X, xReal), (pointwiseMul.apply with
      (constantRealFunction.function at R[realRpow(R[4 * realPi], R[1 / 2]) *
      realInvValue(R[realPi * realPi]) * (Z1 - realPartialSum(naturalPowers(
      R[-3 / 2]), N))]), (rpowFunction.function at R[v - 1 / 2])),
      constantRealFunction.value, rpowFunction.value]
    exact estimate
  have one1 : R[0] < R[1] by linarith
  have firstBound := complexIntegral.abs_le with belowOne, first, g1Integrable,
    bound1
  rw [g1Value, realRpow.one_base] at firstBound
  -- On [1, T], against K₂ x^(v−1).
  have exponent2 : R[R[v - 1] + 1] ≠ R[0]
    intro zero
    linarith
  obtain ⟨g2Integrable, g2Value⟩ := scaledRpow.integral at R[2 *
    realInvValue(R[realPi * realPi]) * (Z2 - realPartialSum(naturalPowers(
    R[-2]), N))], R[v - 1], R[1], T with one1, laterOne, exponent2
  have bound2 : ∀ X ∈ closedInterval(R[1], T), complexAbs(complexCombination(
      ℂ[1], bernoulliMellinIntegrand(a, v), ℂ[-1],
      fourierMellinPartial(a, v, N))(X)) ≤ pointwiseMul(constantRealFunction(
      R[2 * realInvValue(R[realPi * realPi]) * (Z2 - realPartialSum(
      naturalPowers(R[-2]), N))]), rpowFunction(R[v - 1]))(X)
    intros X xMember
    obtain ⟨xReal, low, _⟩ := closedInterval.membership.forward with xMember
    have typedX : Real(X) by exact xReal
    have xPositive : R[0] < X by linarith
    obtain ⟨_, estimate⟩ := bernoulliMellin.remainder at a, v, X, Z1, Z2, N
      with xPositive, sum1, sum2
    rw [(pointwise with X, xReal), (pointwiseMul.apply with
      (constantRealFunction.function at R[2 * realInvValue(R[realPi *
      realPi]) * (Z2 - realPartialSum(naturalPowers(R[-2]), N))]),
      (rpowFunction.function at R[v - 1])), constantRealFunction.value,
      rpowFunction.value]
    exact estimate
  have secondBound := complexIntegral.abs_le with laterOne, second,
    g2Integrable, bound2
  rw [g2Value, realRpow.one_base] at secondBound
  have e1 : R[R[v - 1 / 2] + 1] = R[v + 1 / 2] by linarith
  have e2 : R[R[v - 1] + 1] = v by ring
  rw e1 at firstBound
  rw e2 at secondBound
  have m1 := complexIntegral.member at complexCombination(ℂ[1],
    bernoulliMellinIntegrand(a, v), ℂ[-1], fourierMellinPartial(a, v, N)), A,
    R[1]
  have m2 := complexIntegral.member at complexCombination(ℂ[1],
    bernoulliMellinIntegrand(a, v), ℂ[-1], fourierMellinPartial(a, v, N)),
    R[1], T
  have triangle := complexAbs.triangle with m1, m2
  have halfPositive : R[0] < R[v + 1 / 2] by linarith
  have i1 := realInvValue.positive with halfPositive
  have i2 := realInvValue.negative with upper
  have pA := realRpow.positive at A, R[v + 1 / 2]
  have pT := realRpow.positive at T, v
  have prod1 := realLess.mul_left_of_positive with pA, i1
  have zeroI : R[realInvValue(R[v + 1 / 2]) * 0] = R[0] by ring
  rw zeroI at prod1
  have prod1K := realLe.mul_left_of_nonnegative with
    (realLess.implies_le with prod1), k1
  have prod2 := realLe.mul_right_of_nonnegative with
    (realLess.implies_le with i2), (realLess.implies_le with pT)
  have zeroT : R[0 * realRpow(T, v)] = R[0] by ring
  rw zeroT at prod2
  have prod2K := realLe.mul_left_of_nonnegative with prod2, k2
  have kz1 : R[R[realRpow(R[4 * realPi], R[1 / 2]) * realInvValue(R[realPi *
    realPi]) * (Z1 - realPartialSum(naturalPowers(R[-3 / 2]), N))] * 0] =
    R[0] by ring
  have kz2 : R[R[2 * realInvValue(R[realPi * realPi]) * (Z2 -
    realPartialSum(naturalPowers(R[-2]), N))] * 0] = R[0] by ring
  have expand1 : R[R[realRpow(R[4 * realPi], R[1 / 2]) *
      realInvValue(R[realPi * realPi]) * (Z1 - realPartialSum(naturalPowers(
      R[-3 / 2]), N))] * (realInvValue(R[v + 1 / 2]) * 1 -
      realInvValue(R[v + 1 / 2]) * realRpow(A, R[v + 1 / 2]))] =
      R[realRpow(R[4 * realPi], R[1 / 2]) * realInvValue(R[realPi * realPi]) *
      (Z1 - realPartialSum(naturalPowers(R[-3 / 2]), N)) *
      realInvValue(R[v + 1 / 2]) - R[realRpow(R[4 * realPi], R[1 / 2]) *
      realInvValue(R[realPi * realPi]) * (Z1 - realPartialSum(naturalPowers(
      R[-3 / 2]), N))] * (realInvValue(R[v + 1 / 2]) *
      realRpow(A, R[v + 1 / 2]))] by ring
  have expand2 : R[R[2 * realInvValue(R[realPi * realPi]) * (Z2 -
      realPartialSum(naturalPowers(R[-2]), N))] * (realInvValue(v) *
      realRpow(T, v) - realInvValue(v) * 1)] =
      R[R[2 * realInvValue(R[realPi * realPi]) * (Z2 -
      realPartialSum(naturalPowers(R[-2]), N))] * (realInvValue(v) *
      realRpow(T, v)) + 2 * realInvValue(R[realPi * realPi]) *
      (Z2 - realPartialSum(naturalPowers(R[-2]), N)) * -realInvValue(v)]
    by ring
  linarith

-- Partial sums of a convergent series of nonnegative terms approach the sum
-- from below.
theorem SumsTo.eventually_close (u : Set) (Z E : Real)
  requires sums : SumsTo(u, Z)
  requires positive : R[0] < E
  shows ∃ N0 ∈ ℕ, ∀ N ∈ ℕ, N0 ≤ N → R[Z - realPartialSum(u, N)] < E
proof
  have converges := SumsTo.converges with sums
  obtain ⟨_, limit⟩ := converges
  have eReal : E ∈ ℝ by typecheck
  obtain ⟨N0, n0Member, close⟩ := limit with E, eReal, positive
  refine ⟨N0, n0Member, ?_⟩
  intros N nMember later
  have typedN := nat.omega.backward with nMember
  have ball := close with N, nMember, later
  have uSequence := SumsTo.sequence with sums
  rw (prefixSums.value at u, N with uSequence, nMember) at ball
  have sumReal := realPartialSum.real at u, N with uSequence
  have distance := openBall.abs with ball
  have upper := abs.upper at R[realPartialSum(u, N) - Z]
  have flipped := abs.upper at R[-(realPartialSum(u, N) - Z)]
  rw abs.neg at flipped
  linarith

-- The Fourier series may be integrated termwise against y^(v−1).
theorem bernoulliMellin.fourier_series (a v : Real) (J : Set)
  requires positive : R[0] < a
  requires atMostOne : a ≤ R[1]
  requires lower : R[-1 / 2] < v
  requires upper : v < R[0]
  requires sums : ComplexSumsTo(fourierMellinValues(a, v), J)
  shows HasSingularIntegral(bernoulliMellinIntegrand(a, v), J)
proof
  have lowerOne : R[-1] < v by linarith
  have jMember := ComplexSumsTo.member with sums
  have valuesSequence := fourierMellinValues.function at a, v
  have sequence : ComplexSequence(fourierMellinValues(a, v)) by
    exact valuesSequence
  have partialLimit := (ComplexSumsTo.iff_partial with sequence,
    jMember).forward with sums
  obtain ⟨_, bernoulliNear⟩ := bernoulliMellin.singular with positive,
    atMostOne, lowerOne, upper
  have below1 : R[-3 / 2] < R[-1] by linarith
  have below2 : R[-2] < R[-1] by linarith
  obtain ⟨Z1, z1Real, sum1⟩ := naturalPowers.summable with below1
  obtain ⟨Z2, z2Real, sum2⟩ := naturalPowers.summable with below2
  have typedZ1 : Real(Z1) by exact z1Real
  have typedZ2 : Real(Z2) by exact z2Real
  refine ⟨jMember, ?_⟩
  intros e eReal ePositive
  have e2 := half.positive with ePositive
  have e4 := half.positive with e2
  have e8 := half.positive with e4
  have h2 := half.add_self at e
  have h4 := half.add_self at half(e)
  have h8 := half.add_self at half(half(e))
  -- The constants of the remainder bound.
  have piPositive := realPi.positive
  have piSquare := realLess.mul_left_of_positive with piPositive, piPositive
  have zeroPi : R[realPi * 0] = R[0] by ring
  rw zeroPi at piSquare
  have piInverse := realInvValue.positive with piSquare
  have fourPi : R[0] < R[4 * realPi] by linarith
  have root := realRpow.positive at R[4 * realPi], R[1 / 2]
  have halfShift : R[0] < R[v + 1 / 2] by linarith
  have shiftInverse := realInvValue.positive with halfShift
  have vInverse := realInvValue.negative with upper
  have minusInverse : R[0] < R[-realInvValue(v)] by linarith
  have c1a := realLess.mul_left_of_positive with piInverse, root
  have zeroRoot : R[realRpow(R[4 * realPi], R[1 / 2]) * 0] = R[0] by ring
  rw zeroRoot at c1a
  have c1 := realLess.mul_left_of_positive with shiftInverse, c1a
  have zeroC1 : R[R[realRpow(R[4 * realPi], R[1 / 2]) *
    realInvValue(R[realPi * realPi])] * 0] = R[0] by ring
  rw zeroC1 at c1
  have twoInverse : R[0] < R[2 * realInvValue(R[realPi * realPi])] by linarith
  have c2 := realLess.mul_left_of_positive with minusInverse, twoInverse
  have zeroC2 : R[R[2 * realInvValue(R[realPi * realPi])] * 0] = R[0] by ring
  rw zeroC2 at c2
  have c1Nonzero : R[R[realRpow(R[4 * realPi], R[1 / 2]) *
    realInvValue(R[realPi * realPi])] * realInvValue(R[v + 1 / 2])] ≠ R[0]
    by linarith
  have c2Nonzero : R[R[2 * realInvValue(R[realPi * realPi])] *
    -realInvValue(v)] ≠ R[0] by linarith
  have c1Inverse := realInvValue.mul_right with c1Nonzero
  have c2Inverse := realInvValue.mul_right with c2Nonzero
  have c1InversePositive := realInvValue.positive with c1
  have c2InversePositive := realInvValue.positive with c2
  have eta1 := realLess.mul_left_of_positive with c1InversePositive, e8
  have eta2 := realLess.mul_left_of_positive with c2InversePositive, e8
  have zeroE8 : R[half(half(half(e))) * 0] = R[0] by ring
  rw zeroE8 at eta1
  rw zeroE8 at eta2
  obtain ⟨N1, n1Member, close1⟩ := SumsTo.eventually_close with sum1, eta1
  obtain ⟨N2, n2Member, close2⟩ := SumsTo.eventually_close with sum2, eta2
  have e4Real : half(half(e)) ∈ ℝ by typecheck
  obtain ⟨N3, n3Member, close3⟩ := partialLimit with half(half(e)), e4Real,
    e4
  have typedN1 := nat.omega.backward with n1Member
  have typedN2 := nat.omega.backward with n2Member
  have typedN3 := nat.omega.backward with n3Member
  obtain ⟨M, mMember, m1, m2⟩ := nat.common_upper at N1, N2
  have typedM := nat.omega.backward with mMember
  obtain ⟨N, nMember, n1, n2⟩ := nat.common_upper at M, N3
  have typedN := nat.omega.backward with nMember
  have later1 : N1 ≤ N by arith
  have later2 : N2 ≤ N by arith
  have gap1 := close1 with N, nMember, later1
  have gap2 := close2 with N, nMember, later2
  have gap3 := close3 with N, nMember, n2
  obtain ⟨_, partialNear⟩ := fourierMellinPartial.singular at a, v, N with
    lowerOne, upper
  have oneReal : R[1] ∈ ℝ by typecheck
  have onePositive : R[0] < R[1] by linarith
  obtain ⟨dB, dBReal, dBPositive, bernoulliClose⟩ := bernoulliNear with R[1],
    oneReal, onePositive
  obtain ⟨dN, dNReal, dNPositive, partialClose⟩ := partialNear with
    half(half(e)), e4Real, e4
  obtain ⟨d, dReal, dPositive, belowB, belowN, belowOne⟩ :=
    positiveMesh.common_three with dBPositive, dNPositive, onePositive
  witness d
  refine ⟨dReal, dPositive, ?_⟩
  intros A aReal aPositive below
  have typedA : Real(A) by exact aReal
  have lessB : A < dB by linarith
  have lessN : A < dN by linarith
  have aAtMostOne : A ≤ R[1] by linarith
  obtain ⟨JB, jbMember, integralB, _⟩ := bernoulliClose with A, aReal,
    aPositive, lessB
  obtain ⟨JN, jnMember, integralN, closeN⟩ := partialClose with A, aReal,
    aPositive, lessN
  refine ⟨JB, jbMember, integralB, ?_⟩
  -- |JB − JN| ≤ ε_N.
  have bound : complexAbs(ℂ[JB - JN]) ≤
      R[realRpow(R[4 * realPi], R[1 / 2]) * realInvValue(R[realPi * realPi]) *
        (Z1 - realPartialSum(naturalPowers(R[-3 / 2]), N)) *
        realInvValue(R[v + 1 / 2]) +
      2 * realInvValue(R[realPi * realPi]) *
        (Z2 - realPartialSum(naturalPowers(R[-2]), N)) * -realInvValue(v)]
    apply real.le_of_forall_lt
    intros η ηReal ηPositive
    have η2 := half.positive with ηPositive
    have ηHalves := half.add_self at η
    have η2Real : half(η) ∈ ℝ by typecheck
    obtain ⟨_, _, localB, limitB⟩ := integralB
    obtain ⟨_, _, localN, limitN⟩ := integralN
    obtain ⟨TB, tbReal, nearB⟩ := limitB with half(η), η2Real, η2
    obtain ⟨TN, tnReal, nearN⟩ := limitN with half(η), η2Real, η2
    have typedTB : Real(TB) by exact tbReal
    have typedTN : Real(TN) by exact tnReal
    obtain ⟨T1, t1Real, t1a, t1b⟩ := realBound.common_upper at TB, TN
    have typedT1 : Real(T1) by exact t1Real
    obtain ⟨T, tReal, ta, tb⟩ := realBound.common_upper at T1, R[1]
    have typedT : Real(T) by exact tReal
    have laterB : TB ≤ T by linarith
    have laterN : TN ≤ T by linarith
    have laterA : A ≤ T by linarith
    have finiteB := nearB with T, tReal, laterB, laterA
    have finiteN := nearN with T, tReal, laterN, laterA
    have remainder := bernoulliMellin.integral_remainder at a, v, A, T, Z1, Z2,
      N with aPositive, aAtMostOne, tb, lower, upper, sum1, sum2,
      (localB with T, tReal, laterA), (localN with T, tReal, laterA)
    have mB := complexIntegral.member at bernoulliMellinIntegrand(a, v), A, T
    have mN := complexIntegral.member at fourierMellinPartial(a, v, N), A, T
    have p1 : ℂ[JB - complexIntegral(bernoulliMellinIntegrand(a, v), A, T)] ∈ ℂ
      by typecheck
    have p2 : ℂ[complexIntegral(bernoulliMellinIntegrand(a, v), A, T) -
      complexIntegral(fourierMellinPartial(a, v, N), A, T)] ∈ ℂ by typecheck
    have p3 : ℂ[complexIntegral(fourierMellinPartial(a, v, N), A, T) - JN] ∈ ℂ
      by typecheck
    have p12 : ℂ[(JB - complexIntegral(bernoulliMellinIntegrand(a, v), A, T)) +
      (complexIntegral(bernoulliMellinIntegrand(a, v), A, T) -
      complexIntegral(fourierMellinPartial(a, v, N), A, T))] ∈ ℂ by typecheck
    have regroup : ℂ[JB - JN] = ℂ[(JB - complexIntegral(
        bernoulliMellinIntegrand(a, v), A, T)) + (complexIntegral(
        bernoulliMellinIntegrand(a, v), A, T) - complexIntegral(
        fourierMellinPartial(a, v, N), A, T)) + (complexIntegral(
        fourierMellinPartial(a, v, N), A, T) - JN)] by ring
    rw regroup
    have t1 := complexAbs.triangle with p12, p3
    have t2 := complexAbs.triangle with p1, p2
    have flipAbs : complexAbs(ℂ[JB - complexIntegral(bernoulliMellinIntegrand(
        a, v), A, T)]) = complexAbs(ℂ[complexIntegral(bernoulliMellinIntegrand(
        a, v), A, T) - JB])
      have flip : ℂ[JB - complexIntegral(bernoulliMellinIntegrand(a, v), A,
          T)] = ℂ[-(complexIntegral(bernoulliMellinIntegrand(a, v), A, T) -
          JB)] by ring
      rw [flip, complexAbs.neg]
    linarith
  have scaled1 := realLess.mul_left_of_positive with gap1, c1
  have scaled2 := realLess.mul_left_of_positive with gap2, c2
  have collapse1 : R[R[R[realRpow(R[4 * realPi], R[1 / 2]) *
      realInvValue(R[realPi * realPi])] * realInvValue(R[v + 1 / 2])] *
      (half(half(half(e))) * realInvValue(R[R[realRpow(R[4 * realPi],
      R[1 / 2]) * realInvValue(R[realPi * realPi])] *
      realInvValue(R[v + 1 / 2])]))] = half(half(half(e)))
    linear_combination half(half(half(e))) * c1Inverse
  have collapse2 : R[R[R[2 * realInvValue(R[realPi * realPi])] *
      -realInvValue(v)] * (half(half(half(e))) * realInvValue(R[R[2 *
      realInvValue(R[realPi * realPi])] * -realInvValue(v)]))] =
      half(half(half(e)))
    linear_combination half(half(half(e))) * c2Inverse
  have reshape : R[realRpow(R[4 * realPi], R[1 / 2]) *
      realInvValue(R[realPi * realPi]) *
      (Z1 - realPartialSum(naturalPowers(R[-3 / 2]), N)) *
      realInvValue(R[v + 1 / 2]) + 2 * realInvValue(R[realPi * realPi]) *
      (Z2 - realPartialSum(naturalPowers(R[-2]), N)) * -realInvValue(v)] =
      R[R[R[realRpow(R[4 * realPi], R[1 / 2]) * realInvValue(R[realPi *
      realPi])] * realInvValue(R[v + 1 / 2])] * (Z1 -
      realPartialSum(naturalPowers(R[-3 / 2]), N)) + R[R[2 *
      realInvValue(R[realPi * realPi])] * -realInvValue(v)] * (Z2 -
      realPartialSum(naturalPowers(R[-2]), N))] by ring
  have sumMember := complexPartialSum.member at fourierMellinValues(a, v), N
    with sequence
  have p1 : ℂ[JB - JN] ∈ ℂ by typecheck
  have p2 : ℂ[JN - complexPartialSum(fourierMellinValues(a, v), N)] ∈ ℂ
    by typecheck
  have p3 : ℂ[complexPartialSum(fourierMellinValues(a, v), N) - J] ∈ ℂ
    by typecheck
  have p12 : ℂ[(JB - JN) + (JN - complexPartialSum(fourierMellinValues(a, v),
    N))] ∈ ℂ by typecheck
  have regroup : ℂ[JB - J] = ℂ[(JB - JN) + (JN -
      complexPartialSum(fourierMellinValues(a, v), N)) +
      (complexPartialSum(fourierMellinValues(a, v), N) - J)] by ring
  rw regroup
  have t1 := complexAbs.triangle with p12, p3
  have t2 := complexAbs.triangle with p1, p2
  linarith

-- Section: Hurwitz's formula on the segment
theorem complexPartialSum.linear (u w h c1 c2 : Set) (n : Nat)
  requires sequenceU : ComplexSequence(u)
  requires sequenceW : ComplexSequence(w)
  requires hc1 : c1 ∈ ℂ
  requires hc2 : c2 ∈ ℂ
  requires terms : ∀ m ∈ ℕ, h(m) = ℂ[c1 * u(m) + c2 * w(m)]
  shows complexPartialSum(h, n) =
    ℂ[c1 * complexPartialSum(u, n) + c2 * complexPartialSum(w, n)]
proof
  induction n
  | zero =>
    rw [complexPartialSum.zero, complexPartialSum.zero,
      complexPartialSum.zero]
    ring
  | succ(k) using ih =>
    have kMember : k ∈ ℕ by typecheck
    have pu := complexPartialSum.member at u, k with sequenceU
    have pw := complexPartialSum.member at w, k with sequenceW
    have uk := FunctionBetween.apply_closed with sequenceU, kMember
    have wk := FunctionBetween.apply_closed with sequenceW, kMember
    rw [complexPartialSum.succ, complexPartialSum.succ, complexPartialSum.succ,
      ih, (terms with k, kMember)]
    ring

theorem ComplexSumsTo.linear (u w h c1 c2 S W : Set)
  requires sumsU : ComplexSumsTo(u, S)
  requires sumsW : ComplexSumsTo(w, W)
  requires hc1 : c1 ∈ ℂ
  requires hc2 : c2 ∈ ℂ
  requires sequenceH : ComplexSequence(h)
  requires terms : ∀ m ∈ ℕ, h(m) = ℂ[c1 * u(m) + c2 * w(m)]
  shows ComplexSumsTo(h, ℂ[c1 * S + c2 * W])
proof
  have zero : ℂ[0] ∈ ℂ by typecheck
  have sequenceU := sumsU.left
  have sequenceW := sumsW.left
  have hS := ComplexSumsTo.member with sumsU
  have hW := ComplexSumsTo.member with sumsW
  have tailU := (ComplexSumsTo.iff_partial with sequenceU, hS).forward with
    sumsU
  have tailW := (ComplexSumsTo.iff_partial with sequenceW, hW).forward with
    sumsW
  have target : ℂ[c1 * S + c2 * W] ∈ ℂ by typecheck
  apply (ComplexSumsTo.iff_partial with sequenceH, target).backward
  intros e eReal ePositive
  have abs1 := complexAbs.nonnegative with hc1
  have abs2 := complexAbs.nonnegative with hc2
  have kPositive : R[0] < R[complexAbs(c1) + complexAbs(c2) + 1] by linarith
  have kNonzero : R[complexAbs(c1) + complexAbs(c2) + 1] ≠ R[0] by linarith
  have kInverse := realInvValue.mul_right with kNonzero
  have kInversePositive := realInvValue.positive with kPositive
  have toleranceReal : R[e * realInvValue(R[complexAbs(c1) + complexAbs(c2) +
    1])] ∈ ℝ by typecheck
  have tolerance := realLess.mul_left_of_positive with kInversePositive,
    ePositive
  have zeroE : R[e * 0] = R[0] by ring
  rw zeroE at tolerance
  obtain ⟨N1, n1Member, near1⟩ := tailU with R[e * realInvValue(
    R[complexAbs(c1) + complexAbs(c2) + 1])], toleranceReal, tolerance
  obtain ⟨N2, n2Member, near2⟩ := tailW with R[e * realInvValue(
    R[complexAbs(c1) + complexAbs(c2) + 1])], toleranceReal, tolerance
  have typedN1 := nat.omega.backward with n1Member
  have typedN2 := nat.omega.backward with n2Member
  obtain ⟨N, nMember, above1, above2⟩ := nat.common_upper at N1, N2
  refine ⟨N, nMember, ?_⟩
  intros n hn later
  have typedN := nat.omega.backward with hn
  have typedNN := nat.omega.backward with nMember
  have later1 : N1 ≤ n by arith
  have later2 : N2 ≤ n by arith
  have close1 := near1 with n, hn, later1
  have close2 := near2 with n, hn, later2
  rw (complexPartialSum.linear with sequenceU, sequenceW, hc1, hc2, terms)
  have pu := complexPartialSum.member at u, n with sequenceU
  have pw := complexPartialSum.member at w, n with sequenceW
  have g1 : ℂ[complexPartialSum(u, n) - S] ∈ ℂ by typecheck
  have g2 : ℂ[complexPartialSum(w, n) - W] ∈ ℂ by typecheck
  have p1 : ℂ[c1 * (complexPartialSum(u, n) - S)] ∈ ℂ by typecheck
  have p2 : ℂ[c2 * (complexPartialSum(w, n) - W)] ∈ ℂ by typecheck
  have regroup : ℂ[c1 * complexPartialSum(u, n) + c2 * complexPartialSum(w, n) -
      (c1 * S + c2 * W)] = ℂ[c1 * (complexPartialSum(u, n) - S) +
      c2 * (complexPartialSum(w, n) - W)] by ring
  rw regroup
  have triangle := complexAbs.triangle with p1, p2
  rw [(complexAbs.mul with hc1, g1), (complexAbs.mul with hc2, g2)] at triangle
  have bound1 := realLe.mul_left_of_nonnegative with
    (realLess.implies_le with close1), abs1
  have bound2 := realLe.mul_left_of_nonnegative with
    (realLess.implies_le with close2), abs2
  have collapse : R[R[complexAbs(c1) + complexAbs(c2) + 1] * (e *
      realInvValue(R[complexAbs(c1) + complexAbs(c2) + 1]))] = e
    linear_combination e * kInverse
  have expand : R[R[complexAbs(c1) + complexAbs(c2) + 1] * (e *
      realInvValue(R[complexAbs(c1) + complexAbs(c2) + 1]))] =
      R[complexAbs(c1) * (e * realInvValue(R[complexAbs(c1) +
      complexAbs(c2) + 1])) + complexAbs(c2) * (e * realInvValue(
      R[complexAbs(c1) + complexAbs(c2) + 1])) + e * realInvValue(
      R[complexAbs(c1) + complexAbs(c2) + 1])] by ring
  linarith

-- Section: Hurwitz's formula
-- For re s > 1 the periodic zeta series converges absolutely.
theorem periodicZeta.series (a : Real) (s : Set)
  requires hs : s ∈ ℂ
  requires halfPlane : realOne < complexRe(s)
  shows ComplexSumsTo(periodicZetaTerms(a, s), periodicZeta(a, s)) ∧
    ComplexAbsolutelySummable(periodicZetaTerms(a, s))
proof
  have terms := periodicZetaTerms.function at a, s with hs
  have sequence : ComplexSequence(periodicZetaTerms(a, s)) by exact terms
  -- Absolute convergence, against Σ n^(−σ).
  obtain ⟨_, absoluteZeta⟩ := zeta.series with hs, halfPlane
  obtain ⟨zetaSequence, zetaSummable⟩ := absoluteZeta
  have negative : ℂ[-s] ∈ ℂ by typecheck
  have bound : ∀ k ∈ ℕ, complexAbs(periodicZetaTerms(a, s)(k)) ≤
      complexAbsSequence(zetaSeriesTerms(s))(k)
    intros k kMember
    have kNat := nat.omega.backward with kMember
    have power := realCpow.member at realNat(k + 1), ℂ[-s] with negative
    have phase : expTwoPiI(R[realNat(k + 1) * a]) ∈ ℂ
      unfold expTwoPiI
      typecheck
    have unit : complexAbs(expTwoPiI(R[realNat(k + 1) * a])) = R[1]
      unfold expTwoPiI
      exact complexExp.abs_i_mul at R[2 * realPi * (realNat(k + 1) * a)]
    rw [(periodicZetaTerms.value at a, s, k with hs),
      (complexAbsSequence.value with zetaSequence),
      (zetaSeriesTerms.value with hs, kMember),
      (complexAbs.mul with phase, power), unit]
    have powerAbs := complexAbs.real with power
    have same : R[1 * complexAbs(realCpow(realNat(k + 1), ℂ[-s]))] =
      complexAbs(realCpow(realNat(k + 1), ℂ[-s])) by ring
    linarith
  have absolute := ComplexAbsolutelySummable.of_bound with sequence,
    zetaSummable, bound
  have summable := ComplexAbsolutelySummable.summable with absolute
  obtain ⟨_, sums⟩ := complexSeriesSum.selected with summable
  unfold periodicZeta
  exact ⟨sums, absolute⟩

-- Section: Holomorphy of the periodic zeta function
-- The terms s ↦ e^(2πi(n+1)a) (n + 1)^(−s), as a family of entire functions.
defgraph periodicTermMap (a : Real, n : Nat) (s ∈ complexCarrier) :
    complexCarrier := periodicZetaTerms(a, s)(n)
proof
  have nMember : n ∈ ℕ := nat.omega.forward at n with *
  exact FunctionBetween.apply_closed with (periodicZetaTerms.function at a,
    s with member), nMember

defgraph periodicTermFamily (a : Real) (n ∈ ℕ) :
    functionSpace(complexCarrier, complexCarrier) := periodicTermMap(a, n)
proof
  have typedN := nat.omega.backward with member
  have function := periodicTermMap.function at a, n
  exact functionSpace.mem_iff.backward with function

-- s ↦ F(a, s) on re s > 1.
defgraph periodicZetaMap (a : Real) (s ∈ rightHalfPlane(R[1])) :
    complexCarrier := periodicZeta(a, s)
proof
  obtain ⟨hs, halfPlane⟩ := rightHalfPlane.membership.forward with member
  have large : realOne < complexRe(s) by linarith
  obtain ⟨sums, _⟩ := periodicZeta.series at a, s with hs, large
  exact ComplexSumsTo.member with sums

theorem periodicTermMap.holomorphic (a : Real) (n : Nat) (U : Set)
  requires isOpen : ComplexOpen(U)
  shows HolomorphicOn(periodicTermMap(a, n), U)
proof
  have inside := ComplexOpen.subset with isOpen
  have zero : ℂ[0] ∈ ℂ by typecheck
  have minusOne : ℂ[-1] ∈ ℂ by typecheck
  have power := affinePower.holomorphic at realNat(n + 1), ℂ[0], ℂ[-1], U
    with zero, minusOne, isOpen, inside
  have phase := expTwoPiI.member at R[realNat(n + 1) * a]
  have constant := HolomorphicOn.const with isOpen, phase
  obtain ⟨_, constantValues, _⟩ := constant
  obtain ⟨_, powerValues, _⟩ := power
  apply HolomorphicOn.mul_formula with constant, power
  intros s hs
  have sMember := inside with s, hs
  have nMember : n ∈ ℕ by typecheck
  have exponent : ℂ[0 + -1 * s] = ℂ[-s] by ring
  rw [(periodicTermMap.value at a, n, s with sMember),
    (periodicZetaTerms.value at a, s, n with sMember, nMember),
    (complexFunctionConst.value with phase, hs),
    (affinePower.value at realNat(n + 1), ℂ[0], ℂ[-1], s with zero, minusOne,
      sMember), exponent]

-- |e^(2πi(n+1)a) (n + 1)^(−s)| = (n + 1)^(−re s).
theorem periodicZetaTerms.abs (a : Real) (s : Set) (n : Nat)
  requires hs : s ∈ ℂ
  shows complexAbs(periodicZetaTerms(a, s)(n)) =
    realRpow(realNat(n + 1), R[-complexRe(s)])
proof
  have nMember : n ∈ ℕ by typecheck
  have negative : ℂ[-s] ∈ ℂ by typecheck
  have positive := realNat.plus_one_positive at n
  have power := realCpow.member at realNat(n + 1), ℂ[-s] with negative
  have phase := expTwoPiI.member at R[realNat(n + 1) * a]
  rw [(periodicZetaTerms.value at a, s, n with hs, nMember),
    (complexAbs.mul with phase, power), expTwoPiI.abs,
    (realCpow.abs with positive, negative), (complexRe.neg with hs)]
  ring

-- (n + 1)^(−t) ≤ (n + 1)^(−σ) for σ ≤ t.
theorem realNat.rpow_antitone (n : Nat) (S T : Real)
  requires ordered : S ≤ T
  shows realRpow(realNat(n + 1), R[-T]) ≤ realRpow(realNat(n + 1), R[-S])
proof
  by_cases zero : n = (0:N)
  . have one : realNat(n + 1) = R[1]
      rw [realNat.plus_one, zero, realNat.zero]
      ring
    rw [one, realRpow.one_base, realRpow.one_base]
    linarith
  . have positiveN : (1:N) ≤ n by arith
    have large := realNat.one_le at n with positiveN
    have succ := realNat.plus_one at n
    have base : R[1] < realNat(n + 1) by linarith
    by_cases same : S = T
    . rw same
      linarith
    . have less : R[-T] < R[-S]
        by_contra notLess
        apply same
        linarith
      have strict := realRpow.lt_of_exponent with base, less
      linarith

-- F(a, ·) is holomorphic on re s > 1: the terms are entire and dominated by
-- (n + 1)^(−σ) on each compact subset of the half plane, for some σ > 1.
theorem periodicZetaMap.holomorphic (a : Real)
  shows HolomorphicOn(periodicZetaMap(a), rightHalfPlane(R[1]))
proof
  have isOpen := rightHalfPlane.open at R[1]
  have inside := ComplexOpen.subset with isOpen
  have holomorphic : ∀ n ∈ ℕ,
      HolomorphicOn(periodicTermFamily(a)(n), rightHalfPlane(R[1]))
    intros n nMember
    have typedN := nat.omega.backward with nMember
    rw (periodicTermFamily.value at a, n with nMember)
    exact periodicTermMap.holomorphic with isOpen
  have dominated : ∀ K, K ⊆ rightHalfPlane(R[1]) → ComplexCompact(K) →
      (∃ M, Summable(M) ∧ (∀ n ∈ ℕ, ∀ z ∈ K,
        complexAbs(periodicTermFamily(a)(n)(z)) ≤ M(n)))
    intros K subset compact
    obtain ⟨r, rReal, rPositive, margin⟩ := ComplexCompact.margin with
      compact, isOpen, subset
    have typedR : Real(r) by exact rReal
    have halfPositive := half.positive with rPositive
    have halves := half.add_self at r
    have sigma : complexOfReal(R[1 + half(r)]) ∈ ℂ by typecheck
    have sigmaLarge : realOne < complexRe(complexOfReal(R[1 + half(r)]))
      rw complexOfReal.re
      linarith
    obtain ⟨_, absolute⟩ := zeta.series with sigma, sigmaLarge
    obtain ⟨zetaSequence, summable⟩ := absolute
    refine ⟨complexAbsSequence(zetaSeriesTerms(complexOfReal(R[1 +
      half(r)]))), summable, ?_⟩
    intros n nMember z zK
    have typedN := nat.omega.backward with nMember
    have zU := subset with z, zK
    obtain ⟨zMember, zLarge⟩ := rightHalfPlane.membership.forward with zU
    -- re z > 1 + r/2: the point z − r/2 lies in the disk about z.
    have shifted : ℂ[z - complexOfReal(half(r))] ∈ ℂ by typecheck
    have inDisk : ℂ[z - complexOfReal(half(r))] ∈ complexDisk(z, r)
      apply complexDisk.membership.backward
      refine ⟨shifted, ?_⟩
      have same : ℂ[z - complexOfReal(half(r)) - z] =
        ℂ[-complexOfReal(half(r))] by ring
      rw [same, complexAbs.neg, complexAbs.of_real,
        (abs.of_nonnegative with (realLess.implies_le with halfPositive))]
      linarith
    have shiftedU := (margin with z, zK) with ℂ[z - complexOfReal(half(r))],
      inDisk
    obtain ⟨_, shiftedLarge⟩ := rightHalfPlane.membership.forward with
      shiftedU
    have halfMember : complexOfReal(half(r)) ∈ ℂ by typecheck
    rw [(complexRe.sub with zMember, halfMember), complexOfReal.re] at
      shiftedLarge
    have reReal := complexRe.real with zMember
    have ordered : R[1 + half(r)] ≤ complexRe(z) by linarith
    rw [(periodicTermFamily.value at a, n with nMember),
      (periodicTermMap.value at a, n, z with zMember),
      (periodicZetaTerms.abs with zMember),
      (complexAbsSequence.value with zetaSequence, nMember),
      (zetaSeriesTerms.value with sigma, nMember)]
    have negative : ℂ[-complexOfReal(R[1 + half(r)])] ∈ ℂ by typecheck
    rw [(realCpow.abs with (realNat.plus_one_positive at n), negative),
      (complexRe.neg with sigma), complexOfReal.re]
    exact realNat.rpow_antitone with ordered
  obtain ⟨summable, series⟩ := HolomorphicOn.series with holomorphic,
    dominated
  apply HolomorphicOn.congr with series
  intros s hs
  have sMember := inside with s, hs
  have values : ∀ n ∈ ℕ, periodicTermFamily(a)(n)(s) ∈ complexCarrier
    intros n nMember
    have typedN := nat.omega.backward with nMember
    rw [(periodicTermFamily.value at a, n with nMember),
      (periodicTermMap.value at a, n, s with sMember)]
    exact FunctionBetween.apply_closed with (periodicZetaTerms.function at a,
      s with sMember), nMember
  have sameSequence : complexValueSequence(periodicTermFamily(a), s) =
      periodicZetaTerms(a, s)
    apply FunctionBetween.ext with (complexValueSequence.function with values),
      (periodicZetaTerms.function at a, s with sMember)
    intros n nMember
    have typedN := nat.omega.backward with nMember
    rw [(complexValueSequence.value with values, nMember),
      (periodicTermFamily.value at a, n with nMember),
      (periodicTermMap.value at a, n, s with sMember)]
  rw [(complexFunctionSeries.value with summable, hs), sameSequence,
    (periodicZetaMap.value with hs)]
  unfold periodicZeta
  rfl

-- The reflection s ↦ 1 − s.
defgraph reflectMap (s ∈ complexCarrier) : complexCarrier := ℂ[1 - s]
proof
  typecheck

theorem reflectMap.holomorphic
  shows HolomorphicOn(reflectMap, complexCarrier)
proof
  have whole := ComplexOpen.whole
  have inside := ComplexOpen.subset with whole
  have identity := HolomorphicOn.id with whole
  have one : ℂ[1] ∈ ℂ by typecheck
  have minusOne : ℂ[-1] ∈ ℂ by typecheck
  have constant := HolomorphicOn.const with whole, one
  have negative := HolomorphicOn.const with whole, minusOne
  have negated := HolomorphicOn.mul with negative, identity
  obtain ⟨_, negativeValues, _⟩ := negative
  obtain ⟨_, identityValues, _⟩ := identity
  apply HolomorphicOn.add_formula with constant, negated
  intros z hz
  rw [(reflectMap.value with hz), (complexFunctionConst.value with one, hz),
    (complexFunctionMul.value with negativeValues, identityValues, hz),
    (complexFunctionConst.value with minusOne, hz),
    (complexFunctionId.value with inside, hz)]
  ring

-- Section: The two sides of Hurwitz's formula on re s > 1
defgraph hurwitzLeftMap (a : Real) (s ∈ rightHalfPlane(R[1])) :
    complexCarrier := hurwitzZeta(ℂ[1 - s], a)
proof
  obtain ⟨hs, _⟩ := rightHalfPlane.membership.forward with member
  have reflected : ℂ[1 - s] ∈ ℂ by typecheck
  exact (hurwitzZeta.selected at ℂ[1 - s], a with reflected).left

defgraph hurwitzRightMap (a : Real) (s ∈ rightHalfPlane(R[1])) :
    complexCarrier :=
  ℂ[Gamma(s) * realCpow(R[2 * realPi], ℂ[-s]) *
    (complexExp(ℂ[-(complexImaginaryUnit * complexOfReal(realPi) * s *
        complexOfReal(R[1 / 2]))]) * periodicZeta(a, s) +
      complexExp(ℂ[complexImaginaryUnit * complexOfReal(realPi) * s *
        complexOfReal(R[1 / 2])]) * periodicZeta(R[-a], s))]
proof
  obtain ⟨hs, _⟩ := rightHalfPlane.membership.forward with member
  have gamma := Gamma.member at s
  have negative : ℂ[-s] ∈ ℂ by typecheck
  have power := realCpow.member at R[2 * realPi], ℂ[-s] with negative
  have iMember := complexImaginaryUnit.member
  have plusArgument : ℂ[complexImaginaryUnit * complexOfReal(realPi) * s *
    complexOfReal(R[1 / 2])] ∈ ℂ by typecheck
  have minusArgument : ℂ[-(complexImaginaryUnit * complexOfReal(realPi) * s *
    complexOfReal(R[1 / 2]))] ∈ ℂ by typecheck
  have plusExp := complexExp.member with plusArgument
  have minusExp := complexExp.member with minusArgument
  have first := FunctionBetween.apply_closed with (periodicZetaMap.function at
    a), member
  have second := FunctionBetween.apply_closed with (periodicZetaMap.function at
    R[-a]), member
  rw (periodicZetaMap.value with member) at first
  rw (periodicZetaMap.value with member) at second
  typecheck

theorem hurwitzLeftMap.holomorphic (a : Real)
  requires positive : R[0] < a
  shows HolomorphicOn(hurwitzLeftMap(a), rightHalfPlane(R[1]))
proof
  have isOpen := rightHalfPlane.open at R[1]
  have inside := ComplexOpen.subset with isOpen
  have reflect := HolomorphicOn.mono with reflectMap.holomorphic, isOpen,
    inside
  have zeta := hurwitzZeta.holomorphic with positive
  have maps : ∀ z ∈ rightHalfPlane(R[1]),
      reflectMap(z) ∈ complexCarrier ∖ {ℂ[1]}
    intros z hz
    obtain ⟨zMember, large⟩ := rightHalfPlane.membership.forward with hz
    rw (reflectMap.value with zMember)
    have reflected : ℂ[1 - z] ∈ ℂ by typecheck
    refine ⟨reflected, ?_⟩
    intro single
    have same := (singleton.membership at ℂ[1 - z], ℂ[1]).forward with single
    have zero : z = ℂ[0] by linear_combination -same
    rw [zero, ← complexOfReal.zero, complexOfReal.re] at large
    linarith
  have composed := HolomorphicOn.comp with reflect, zeta, maps
  have values : ∀ z ∈ rightHalfPlane(R[1]),
      hurwitzZetaMap(a)(reflectMap(z)) ∈ complexCarrier
    intros z hz
    have image := maps with z, hz
    obtain ⟨imageMember, _⟩ := difference.membership.forward with image
    exact FunctionBetween.apply_closed with (hurwitzZetaMap.function at a),
      imageMember
  apply HolomorphicOn.congr with composed
  intros z hz
  have zMember := inside with z, hz
  have reflected : ℂ[1 - z] ∈ ℂ by typecheck
  rw [(complexFunctionComp.value with values, hz),
    (reflectMap.value with zMember), (hurwitzZetaMap.apply with reflected),
    (hurwitzLeftMap.value with hz)]

theorem hurwitzRightMap.holomorphic (a : Real)
  shows HolomorphicOn(hurwitzRightMap(a), rightHalfPlane(R[1]))
proof
  have isOpen := rightHalfPlane.open at R[1]
  have inside := ComplexOpen.subset with isOpen
  have inGamma : rightHalfPlane(R[1]) ⊆ gammaDomain
    intros z hz
    obtain ⟨zMember, large⟩ := rightHalfPlane.membership.forward with hz
    have positive : realZero < complexRe(z) by linarith
    exact gammaDomain.of_re_positive with zMember, positive
  have gamma := HolomorphicOn.mono with Gamma.holomorphic, isOpen, inGamma
  have zero : ℂ[0] ∈ ℂ by typecheck
  have minusOne : ℂ[-1] ∈ ℂ by typecheck
  have power := affinePower.holomorphic at R[2 * realPi], ℂ[0], ℂ[-1],
    rightHalfPlane(R[1]) with zero, minusOne, isOpen, inside
  have iMember := complexImaginaryUnit.member
  have plusScale : ℂ[complexImaginaryUnit * complexOfReal(realPi) *
    complexOfReal(R[1 / 2])] ∈ ℂ by typecheck
  have minusScale : ℂ[-(complexImaginaryUnit * complexOfReal(realPi) *
    complexOfReal(R[1 / 2]))] ∈ ℂ by typecheck
  have plusWave := expLinearMap.holomorphic with plusScale, isOpen
  have minusWave := expLinearMap.holomorphic with minusScale, isOpen
  have plusZeta := periodicZetaMap.holomorphic at a
  have minusZeta := periodicZetaMap.holomorphic at R[-a]
  have first := HolomorphicOn.mul with minusWave, plusZeta
  have second := HolomorphicOn.mul with plusWave, minusZeta
  have bracket := HolomorphicOn.add with first, second
  have factor := HolomorphicOn.mul with gamma, power
  obtain ⟨_, gammaValues, _⟩ := gamma
  obtain ⟨_, powerValues, _⟩ := power
  obtain ⟨_, plusWaveValues, _⟩ := plusWave
  obtain ⟨_, minusWaveValues, _⟩ := minusWave
  obtain ⟨_, plusZetaValues, _⟩ := plusZeta
  obtain ⟨_, minusZetaValues, _⟩ := minusZeta
  obtain ⟨_, firstValues, _⟩ := first
  obtain ⟨_, secondValues, _⟩ := second
  apply HolomorphicOn.mul_formula with factor, bracket
  intros z hz
  have zMember := inside with z, hz
  have zGamma := inGamma with z, hz
  have exponent : ℂ[0 + -1 * z] = ℂ[-z] by ring
  have plusArgument : ℂ[complexImaginaryUnit * complexOfReal(realPi) *
      complexOfReal(R[1 / 2]) * z] = ℂ[complexImaginaryUnit *
      complexOfReal(realPi) * z * complexOfReal(R[1 / 2])] by ring
  have minusArgument : ℂ[-(complexImaginaryUnit * complexOfReal(realPi) *
      complexOfReal(R[1 / 2])) * z] = ℂ[-(complexImaginaryUnit *
      complexOfReal(realPi) * z * complexOfReal(R[1 / 2]))] by ring
  rw [(hurwitzRightMap.value with hz),
    (complexFunctionMul.value with gammaValues, powerValues, hz),
    (complexFunctionAdd.value with firstValues, secondValues, hz),
    (complexFunctionMul.value with minusWaveValues, plusZetaValues, hz),
    (complexFunctionMul.value with plusWaveValues, minusZetaValues, hz),
    (GammaMap.value with zGamma),
    (affinePower.value at R[2 * realPi], ℂ[0], ℂ[-1], z with zero, minusOne,
      zMember), exponent,
    (expLinearMap.value with plusScale, zMember),
    (expLinearMap.value with minusScale, zMember), plusArgument,
    minusArgument, (periodicZetaMap.value with hz),
    (periodicZetaMap.value with hz)]

-- Section: Hurwitz's formula on the strip 3/2 < s < 2
theorem hurwitzZeta.functional_equation_strip (a v : Real)
  requires positive : R[0] < a
  requires atMostOne : a ≤ R[1]
  requires lower : R[-1 / 2] < v
  requires upper : v < R[0]
  shows hurwitzLeftMap(a)(complexOfReal(R[v + 2])) =
    hurwitzRightMap(a)(complexOfReal(R[v + 2]))
proof
  have lowerOne : R[-1] < v by linarith
  have sMember : complexOfReal(R[v + 2]) ∈ ℂ by typecheck
  have sLarge : realOne < complexRe(complexOfReal(R[v + 2]))
    rw complexOfReal.re
    linarith
  have sU : complexOfReal(R[v + 2]) ∈ rightHalfPlane(R[1])
    apply rightHalfPlane.membership.backward
    refine ⟨sMember, ?_⟩
    rw complexOfReal.re
    linarith
  obtain ⟨sumsMinus, _⟩ := periodicZeta.series at R[-a],
    complexOfReal(R[v + 2]) with sMember, sLarge
  obtain ⟨sumsPlus, _⟩ := periodicZeta.series at a, complexOfReal(R[v + 2])
    with sMember, sLarge
  -- The series of the term integrals.
  have angle : ℂ[complexImaginaryUnit * complexOfReal(R[v * realHalfPi])] ∈ ℂ
    by typecheck
  have conjAngle : ℂ[-(complexImaginaryUnit * complexOfReal(R[v *
    realHalfPi]))] ∈ ℂ by typecheck
  have phase := complexExp.member with angle
  have conjPhase := complexExp.member with conjAngle
  have gamma := Gamma.member at complexOfReal(v)
  have constant := complexOfReal.mem at R[realRpow(R[2 * realPi], R[-v]) *
    realInvValue(R[realPi * realPi]) * (1 / 2)]
  have c1 : ℂ[complexOfReal(R[realRpow(R[2 * realPi], R[-v]) *
    realInvValue(R[realPi * realPi]) * (1 / 2)]) * Gamma(complexOfReal(v)) *
    complexExp(complexImaginaryUnit * complexOfReal(R[v * realHalfPi]))] ∈ ℂ
    by typecheck
  have c2 : ℂ[complexOfReal(R[realRpow(R[2 * realPi], R[-v]) *
    realInvValue(R[realPi * realPi]) * (1 / 2)]) * Gamma(complexOfReal(v)) *
    complexExp(-(complexImaginaryUnit * complexOfReal(R[v * realHalfPi])))] ∈ ℂ
    by typecheck
  have valuesSequence := fourierMellinValues.function at a, v
  have sequence : ComplexSequence(fourierMellinValues(a, v)) by
    exact valuesSequence
  have terms : ∀ m ∈ ℕ, fourierMellinValues(a, v)(m) =
      ℂ[ℂ[complexOfReal(R[realRpow(R[2 * realPi], R[-v]) *
      realInvValue(R[realPi * realPi]) * (1 / 2)]) * Gamma(complexOfReal(v)) *
      complexExp(complexImaginaryUnit * complexOfReal(R[v * realHalfPi]))] *
      periodicZetaTerms(R[-a], complexOfReal(R[v + 2]))(m) +
      ℂ[complexOfReal(R[realRpow(R[2 * realPi], R[-v]) *
      realInvValue(R[realPi * realPi]) * (1 / 2)]) * Gamma(complexOfReal(v)) *
      complexExp(-(complexImaginaryUnit * complexOfReal(R[v * realHalfPi])))] *
      periodicZetaTerms(a, complexOfReal(R[v + 2]))(m)]
    intros m mMember
    have typedM := nat.omega.backward with mMember
    have t1 := FunctionBetween.apply_closed with (periodicZetaTerms.function
      at R[-a], complexOfReal(R[v + 2]) with sMember), mMember
    have t2 := FunctionBetween.apply_closed with (periodicZetaTerms.function
      at a, complexOfReal(R[v + 2]) with sMember), mMember
    rw (fourierMellinValues.value at a, v, m with mMember)
    ring
  have series := ComplexSumsTo.linear with sumsMinus, sumsPlus, c1, c2,
    sequence, terms
  have viaFourier := bernoulliMellin.fourier_series with positive, atMostOne,
    lower, upper, series
  obtain ⟨_, _⟩ := bernoulliMellin.singular with positive, atMostOne,
    lowerOne, upper
  have viaBernoulli := bernoulliMellin.singular with positive, atMostOne,
    lowerOne, upper
  have same := HasSingularIntegral.unique with viaBernoulli, viaFourier
  have form := hurwitzZeta.bernoulli_form with positive, atMostOne, lowerOne,
    upper
  rw same at form
  rw [(hurwitzLeftMap.value with sU), (hurwitzRightMap.value with sU)]
  have reflected : ℂ[1 - complexOfReal(R[v + 2])] = complexOfReal(R[-1 - v])
    rw [← complexOfReal.one, ← complexOfReal.sub]
    have inner : R[1 - R[v + 2]] = R[-1 - v] by ring
    rw inner
  rw [reflected, form]
  -- Γ(v + 2) = (v + 1) v Γ(v).
  have domainV := gammaDomain.of_real_between with lowerOne, upper
  have succV := Gamma.succ with domainV
  have positiveRe : realZero < complexRe(complexOfReal(R[v + 1]))
    rw complexOfReal.re
    linarith
  have vPlusOne : complexOfReal(R[v + 1]) ∈ ℂ by typecheck
  have domainV1 := gammaDomain.of_re_positive with vPlusOne, positiveRe
  have succV1 := Gamma.succ with domainV1
  have shift1 : ℂ[complexOfReal(v) + 1] = complexOfReal(R[v + 1])
    rw [complexOfReal.add, complexOfReal.one]
  have shift2 : ℂ[complexOfReal(R[v + 1]) + 1] = complexOfReal(R[v + 2])
    rw [← complexOfReal.one, ← complexOfReal.add]
    have inner : R[v + 1 + 1] = R[v + 2] by ring
    rw inner
  rw shift1 at succV
  rw shift2 at succV1
  rw succV at succV1
  rw succV1
  -- (2π)^(−s) and the phases e^(±iπs/2) = −e^(±iπv/2).
  have negS : ℂ[-complexOfReal(R[v + 2])] = complexOfReal(R[-(v + 2)])
    rw complexOfReal.neg
  rw [negS, realCpow.of_real]
  have halfPi := realHalfPi.positive
  have angleShift : ℂ[complexImaginaryUnit * complexOfReal(realPi) *
      complexOfReal(R[v + 2]) * complexOfReal(R[1 / 2])] =
      ℂ[complexImaginaryUnit * complexOfReal(R[v * realHalfPi]) +
        complexImaginaryUnit * complexOfReal(realPi)]
    have inner : R[realPi * R[v + 2] * (1 / 2)] =
        R[R[v * realHalfPi] + realPi]
      unfold realPi
      ring
    have lifted : complexOfReal(R[realPi * R[v + 2] * (1 / 2)]) =
        complexOfReal(R[R[v * realHalfPi] + realPi])
      rw inner
    rw [(complexOfReal.mul at R[realPi * R[v + 2]], R[1 / 2]),
      (complexOfReal.mul at realPi, R[v + 2]), (complexOfReal.add at
      R[v * realHalfPi], realPi)] at lifted
    have p1 := complexOfReal.mem at realPi
    have p2 := complexOfReal.mem at R[v + 2]
    have p3 := complexOfReal.mem at R[1 / 2]
    have p4 := complexOfReal.mem at R[v * realHalfPi]
    linear_combination complexImaginaryUnit * lifted
  have iMember := complexImaginaryUnit.member
  have piAngle : ℂ[complexImaginaryUnit * complexOfReal(realPi)] ∈ ℂ
    by typecheck
  have plusSplit := complexExp.add with angle, piAngle
  rw complexExp.i_pi at plusSplit
  have minusAngle : ℂ[-(complexImaginaryUnit * complexOfReal(realPi))] ∈ ℂ
    by typecheck
  have minusSplit := complexExp.add with conjAngle, minusAngle
  have minusPi : complexExp(ℂ[-(complexImaginaryUnit *
      complexOfReal(realPi))]) = ℂ[-1]
    rw [(complexExp.inv with piAngle), complexExp.i_pi]
    have minusOneMember : ℂ[-1] ∈ ℂ by typecheck
    apply complexInv.unique with minusOneMember, minusOneMember
    ring
  have negSplit : ℂ[-(complexImaginaryUnit * complexOfReal(R[v * realHalfPi]) +
      complexImaginaryUnit * complexOfReal(realPi))] =
      ℂ[-(complexImaginaryUnit * complexOfReal(R[v * realHalfPi])) +
        -(complexImaginaryUnit * complexOfReal(realPi))] by ring
  rw [angleShift, negSplit, plusSplit, minusSplit, minusPi]
  -- (2π)^(−v)/(2π²) = 2 (2π)^(−v−2).
  have piPositive := realPi.positive
  have twoPiPositive : R[0] < R[2 * realPi] by linarith
  have split := realRpow.add at R[2 * realPi], R[-(v + 2)], R[2] with
    twoPiPositive
  have square := realRpow.add at R[2 * realPi], R[1], R[1] with twoPiPositive
  rw (realRpow.one with twoPiPositive) at square
  have e1 : R[-(v + 2) + 2] = R[-v] by ring
  have e2 : R[1 + 1] = R[2] by ring
  rw e1 at split
  rw e2 at square
  rw square at split
  have piSquare := realLess.mul_left_of_positive with piPositive, piPositive
  have zeroPi : R[realPi * 0] = R[0] by ring
  rw zeroPi at piSquare
  have piNonzero : R[realPi * realPi] ≠ R[0] by linarith
  have piInverse := realInvValue.mul_right with piNonzero
  have realT : R[realRpow(R[2 * realPi], R[-v]) * realInvValue(R[realPi *
      realPi]) * (1 / 2)] = R[2 * realRpow(R[2 * realPi], R[-(v + 2)])]
    rw split
    have p := realRpow.real at R[2 * realPi], R[-(v + 2)]
    have i := realInvValue.real at R[realPi * realPi]
    have reshape : R[realRpow(R[2 * realPi], R[-(v + 2)]) * (R[2 * realPi] *
        R[2 * realPi]) * realInvValue(R[realPi * realPi]) * (1 / 2)] =
        R[2 * realRpow(R[2 * realPi], R[-(v + 2)]) * (realPi * realPi *
        realInvValue(R[realPi * realPi]))] by ring
    rw [reshape, piInverse]
    ring
  have liftT : complexOfReal(R[realRpow(R[2 * realPi], R[-v]) *
      realInvValue(R[realPi * realPi]) * (1 / 2)]) =
      complexOfReal(R[2 * realRpow(R[2 * realPi], R[-(v + 2)])])
    rw realT
  have halfFact : ℂ[2 * complexOfReal(R[1 / 2])] = ℂ[1]
    have twoMember : ℂ[2] ∈ ℂ by typecheck
    rw complexOfReal.half
    exact complexInv.mul_cancel with twoMember, complexTwo.nonzero
  rw [(complexOfReal.mul at R[2], realRpow(R[2 * realPi], R[-(v + 2)])),
    complexOfReal.two] at liftT
  rw liftT
  have negV : complexOfReal(R[-(v * (v + 1))]) =
      ℂ[-(complexOfReal(v) * (complexOfReal(v) + 1))]
    rw [complexOfReal.neg, complexOfReal.mul, complexOfReal.add,
      complexOfReal.one]
  have plusV : complexOfReal(R[v + 1]) = ℂ[complexOfReal(v) + 1]
    rw [complexOfReal.add, complexOfReal.one]
  rw [negV, plusV]
  have cv := complexOfReal.mem at v
  have pc := complexOfReal.mem at realRpow(R[2 * realPi], R[-(v + 2)])
  have hc := complexOfReal.mem at R[1 / 2]
  have fMinus := periodicZeta.series at R[-a], complexOfReal(R[v + 2]) with
    sMember, sLarge
  have fMinusMember := ComplexSumsTo.member with fMinus.left
  have fPlus := periodicZeta.series at a, complexOfReal(R[v + 2]) with
    sMember, sLarge
  have fPlusMember := ComplexSumsTo.member with fPlus.left
  linear_combination (-(complexOfReal(v) * (complexOfReal(v) + 1)) *
    complexOfReal(realRpow(R[2 * realPi], R[-(v + 2)])) *
    Gamma(complexOfReal(v)) * (complexExp(complexImaginaryUnit *
    complexOfReal(R[v * realHalfPi])) * periodicZeta(R[-a],
    complexOfReal(R[v + 2])) + complexExp(-(complexImaginaryUnit *
    complexOfReal(R[v * realHalfPi]))) * periodicZeta(a,
    complexOfReal(R[v + 2])))) * halfFact

-- The real segment 3/2 < s < 2.
def hurwitzSegment : Set :=
  { z ∈ complexCarrier | ∃ v ∈ ℝ, R[-1 / 2] < v ∧ v < R[0] ∧
    z = complexOfReal(R[v + 2]) }

-- Hurwitz's formula: for 0 < a ≤ 1 and re s > 1,
-- ζ(1 − s, a) = Γ(s) (2π)^(−s) (e^(−πis/2) F(a, s) + e^(πis/2) F(−a, s)).
-- Both sides are holomorphic on re s > 1, and they agree on the real
-- segment 3/2 < s < 2, which accumulates at 7/4.
theorem hurwitzZeta.functional_equation (a : Real) (s : Set)
  requires positive : R[0] < a
  requires atMostOne : a ≤ R[1]
  requires hs : s ∈ ℂ
  requires halfPlane : realOne < complexRe(s)
  shows hurwitzZeta(ℂ[1 - s], a) =
    ℂ[Gamma(s) * realCpow(R[2 * realPi], ℂ[-s]) *
      (complexExp(ℂ[-(complexImaginaryUnit * complexOfReal(realPi) * s *
          complexOfReal(R[1 / 2]))]) * periodicZeta(a, s) +
        complexExp(ℂ[complexImaginaryUnit * complexOfReal(realPi) * s *
          complexOfReal(R[1 / 2])]) * periodicZeta(R[-a], s))]
proof
  have connected := rightHalfPlane.connected at R[1]
  have segment : hurwitzSegment ⊆ rightHalfPlane(R[1])
    intros z hz
    obtain ⟨zMember, v, vReal, low, high, same⟩ :=
      hurwitzSegment.membership.forward with hz
    have typedV : Real(v) by exact vReal
    apply rightHalfPlane.membership.backward
    refine ⟨zMember, ?_⟩
    rw [same, complexOfReal.re]
    linarith
  have center : complexOfReal(R[7 / 4]) ∈ rightHalfPlane(R[1])
    have member : complexOfReal(R[7 / 4]) ∈ ℂ by typecheck
    apply rightHalfPlane.membership.backward
    refine ⟨member, ?_⟩
    rw complexOfReal.re
    linarith
  have accumulates : ∀ r ∈ ℝ, R[0] < r → (∃ z ∈ hurwitzSegment,
      z ≠ complexOfReal(R[7 / 4]) ∧
      complexAbs(ℂ[z - complexOfReal(R[7 / 4])]) < r)
    intros r rReal rPositive
    have eighth : R[0] < R[1 / 8] by linarith
    obtain ⟨t, tReal, tPositive, tBelowR, tSmall⟩ := realPositive.common_lower
      with rPositive, eighth
    have typedT : Real(t) by exact tReal
    have halfT := half.positive with tPositive
    have halves := half.add_self at t
    have zMember : complexOfReal(R[7 / 4 + half(t)]) ∈ ℂ by typecheck
    have vReal : R[-1 / 4 + half(t)] ∈ ℝ by typecheck
    have low : R[-1 / 2] < R[-1 / 4 + half(t)] by linarith
    have high : R[-1 / 4 + half(t)] < R[0] by linarith
    have same : complexOfReal(R[7 / 4 + half(t)]) =
        complexOfReal(R[R[-1 / 4 + half(t)] + 2])
      have shape : R[7 / 4 + half(t)] = R[R[-1 / 4 + half(t)] + 2] by ring
      rw shape
    have inS : complexOfReal(R[7 / 4 + half(t)]) ∈ hurwitzSegment
      apply hurwitzSegment.membership.backward
      exact ⟨zMember, R[-1 / 4 + half(t)], vReal, low, high, same⟩
    have difference : ℂ[complexOfReal(R[7 / 4 + half(t)]) -
        complexOfReal(R[7 / 4])] = complexOfReal(half(t))
      rw ← complexOfReal.sub
      have shape : R[7 / 4 + half(t) - 7 / 4] = half(t) by ring
      rw shape
    refine ⟨complexOfReal(R[7 / 4 + half(t)]), inS, ?_, ?_⟩
    . intro equal
      have reals := complexOfReal.injective with equal
      linarith
    . rw [difference, complexAbs.of_real, (abs.of_nonnegative with
        (realLess.implies_le with halfT))]
      linarith
  have agree : ∀ z ∈ hurwitzSegment,
      hurwitzLeftMap(a)(z) = hurwitzRightMap(a)(z)
    intros z hz
    obtain ⟨_, v, vReal, low, high, same⟩ :=
      hurwitzSegment.membership.forward with hz
    have typedV : Real(v) by exact vReal
    rw same
    exact hurwitzZeta.functional_equation_strip with positive, atMostOne, low,
      high
  have identity := holomorphic.identity_accumulation with
    (hurwitzLeftMap.holomorphic with positive),
    (hurwitzRightMap.holomorphic at a), connected, segment, center,
    accumulates, agree
  have sU : s ∈ rightHalfPlane(R[1])
    apply rightHalfPlane.membership.backward
    refine ⟨hs, ?_⟩
    linarith
  have equal := identity with s, sU
  rw [(hurwitzLeftMap.value with sU), (hurwitzRightMap.value with sU)] at equal
  exact equal

-- F(1, s) = F(−1, s) = ζ(s) for re s > 1.
theorem periodicZeta.unit (a : Real) (s : Set)
  requires hs : s ∈ ℂ
  requires halfPlane : realOne < complexRe(s)
  requires unit : a = R[1] ∨ a = R[-1]
  shows periodicZeta(a, s) = riemannZeta(s)
proof
  obtain ⟨sums, _⟩ := periodicZeta.series at a, s with hs, halfPlane
  obtain ⟨zetaSums, _⟩ := zeta.series with hs, halfPlane
  have first := periodicZetaTerms.function at a, s with hs
  have second := zetaSeriesTerms.function at s with hs
  have same : periodicZetaTerms(a, s) = zetaSeriesTerms(s)
    apply FunctionBetween.ext at periodicZetaTerms(a, s), zetaSeriesTerms(s),
      ℕ, complexCarrier with first, second
    intros n nMember
    have nNat := nat.omega.backward at n with nMember
    have negative : ℂ[-s] ∈ ℂ by typecheck
    have power := realCpow.member at realNat(n + 1), ℂ[-s] with negative
    have phase : expTwoPiI(R[realNat(n + 1) * a]) = ℂ[1]
      cases unit with plus | minus
      . have product : R[realNat(n + 1) * a] = realNat(n + 1)
          rw plus
          ring
        rw product
        exact expTwoPiI.nat at n + 1
      . have negated := realInt.neg at integerOfNat(n + 1)
        rw realInt.nat at negated
        have product : R[realNat(n + 1) * a] =
            realInt(integerNegValue(integerOfNat(n + 1)))
          rw [minus, negated]
          ring
        rw product
        exact expTwoPiI.integer at integerNegValue(integerOfNat(n + 1))
    rw [(periodicZetaTerms.value at a, s, n with hs, nMember),
      (zetaSeriesTerms.value at s, n with hs, nMember), phase]
    ring
  rw same at sums
  exact ComplexSumsTo.unique with sums, zetaSums

-- The asymmetric functional equation for re s > 1, from Hurwitz's formula
-- at a = 1: e^(−πis/2) + e^(πis/2) = 2 cos(πs/2).
theorem zeta.functional_equation_asymm_right (s : Set)
  requires hs : s ∈ ℂ
  requires halfPlane : realOne < complexRe(s)
  shows riemannZeta(ℂ[1 - s]) =
    ℂ[2 * realCpow(R[2 * realPi], ℂ[-s]) *
      complexCos(ℂ[complexOfReal(realPi) * s * complexOfReal(R[1 / 2])]) *
      Gamma(s) * riemannZeta(s)]
proof
  have positive : R[0] < R[1] by linarith
  have atMostOne : R[1] ≤ R[1] by linarith
  have hurwitz := hurwitzZeta.functional_equation at R[1], s with positive,
    atMostOne, hs, halfPlane
  have plusOne : R[1] = R[1] ∨ R[1] = R[-1]
    left
    rfl
  have minusOne : R[-1] = R[1] ∨ R[-1] = R[-1]
    right
    rfl
  have plus := periodicZeta.unit at R[1], s with hs, halfPlane, plusOne
  have minus := periodicZeta.unit at R[-1], s with hs, halfPlane, minusOne
  have left : riemannZeta(ℂ[1 - s]) = hurwitzZeta(ℂ[1 - s], R[1])
    unfold riemannZeta
    rfl
  rw [left, hurwitz, plus, minus]
  have iMember := complexImaginaryUnit.member
  have piMember : complexOfReal(realPi) ∈ ℂ by typecheck
  have halfMember : complexOfReal(R[1 / 2]) ∈ ℂ by typecheck
  have argument : ℂ[complexOfReal(realPi) * s * complexOfReal(R[1 / 2])] ∈ ℂ
    by typecheck
  rw (complexCos.formula with argument)
  have inner : ℂ[complexImaginaryUnit * (complexOfReal(realPi) * s *
      complexOfReal(R[1 / 2]))] = ℂ[complexImaginaryUnit *
      complexOfReal(realPi) * s * complexOfReal(R[1 / 2])] by ring
  rw inner
  have twoMember : ℂ[2] ∈ ℂ by typecheck
  have twoNonzero := complexTwo.nonzero
  have two := complexInv.mul_cancel with twoMember, twoNonzero
  have inverse := complexInv.member with twoMember
  have negative : ℂ[-s] ∈ ℂ by typecheck
  have power := realCpow.member at R[2 * realPi], ℂ[-s] with negative
  have gamma := Gamma.member at s
  have zeta := riemannZeta.member with hs
  have plusArgument : ℂ[complexImaginaryUnit * complexOfReal(realPi) * s *
    complexOfReal(R[1 / 2])] ∈ ℂ by typecheck
  have minusArgument : ℂ[-(complexImaginaryUnit * complexOfReal(realPi) * s *
    complexOfReal(R[1 / 2]))] ∈ ℂ by typecheck
  have plusExp := complexExp.member with plusArgument
  have minusExp := complexExp.member with minusArgument
  linear_combination (-(realCpow(R[2 * realPi], ℂ[-s]) * Gamma(s) *
    riemannZeta(s) * (complexExp(ℂ[complexImaginaryUnit *
      complexOfReal(realPi) * s * complexOfReal(R[1 / 2])]) +
      complexExp(ℂ[-(complexImaginaryUnit * complexOfReal(realPi) * s *
        complexOfReal(R[1 / 2]))])))) * two

-- Section: Continuation of the asymmetric functional equation
theorem complexCos.holomorphic
  shows HolomorphicOn(complexCos, complexCarrier)
proof
  have values : ComplexValuedOn(complexCos, complexCarrier)
    intros z hz
    exact complexCos.member with hz
  refine ⟨ComplexOpen.whole, values, ?_⟩
  intros a ha
  have sine := complexSin.member with ha
  have derivative : ℂ[-complexSin(a)] ∈ ℂ by typecheck
  exact ⟨ℂ[-complexSin(a)], derivative,
    (complexCos.has_derivative with ha)⟩

-- The entire functions s ↦ s − 1, s ↦ cos(πs/2), and
-- s ↦ (s − 1)(ζ(s) − 1/(s − 1)) + 1, which is (s − 1) ζ(s) off s = 1.
defgraph shiftDownMap (s ∈ complexCarrier) : complexCarrier := ℂ[s - 1]
proof
  typecheck

defgraph cosHalfMap (s ∈ complexCarrier) : complexCarrier :=
  complexCos(ℂ[complexOfReal(realPi) * s * complexOfReal(R[1 / 2])])
proof
  have argument : ℂ[complexOfReal(realPi) * s * complexOfReal(R[1 / 2])] ∈ ℂ
    by typecheck
  exact complexCos.member with argument

defgraph zetaPolarMap (s ∈ complexCarrier) : complexCarrier :=
  ℂ[(s - 1) * hurwitzZetaRegularMap(R[1])(s) + 1]
proof
  have regular := hurwitzZetaRegularMap.function at R[1]
  have value := FunctionBetween.apply_closed with regular, member
  typecheck

theorem shiftDownMap.holomorphic
  shows HolomorphicOn(shiftDownMap, complexCarrier)
proof
  have whole := ComplexOpen.whole
  have inside := ComplexOpen.subset with whole
  have identity := HolomorphicOn.id with whole
  have minusOne : ℂ[-1] ∈ ℂ by typecheck
  have constant := HolomorphicOn.const with whole, minusOne
  apply HolomorphicOn.add_formula with identity, constant
  intros z hz
  rw [(shiftDownMap.value with hz), (complexFunctionId.value with inside, hz),
    (complexFunctionConst.value with minusOne, hz)]
  ring

theorem cosHalfMap.holomorphic
  shows HolomorphicOn(cosHalfMap, complexCarrier)
proof
  have whole := ComplexOpen.whole
  have inside := ComplexOpen.subset with whole
  have identity := HolomorphicOn.id with whole
  have scale : ℂ[complexOfReal(realPi) * complexOfReal(R[1 / 2])] ∈ ℂ
    by typecheck
  have constant := HolomorphicOn.const with whole, scale
  have linear := HolomorphicOn.mul with constant, identity
  obtain ⟨_, constantValues, _⟩ := constant
  obtain ⟨_, identityValues, _⟩ := identity
  have maps : ∀ z ∈ complexCarrier, complexFunctionMul(complexFunctionConst(
      ℂ[complexOfReal(realPi) * complexOfReal(R[1 / 2])], complexCarrier),
      complexFunctionId(complexCarrier), complexCarrier)(z) ∈ complexCarrier
    intros z hz
    rw [(complexFunctionMul.value with constantValues, identityValues, hz),
      (complexFunctionConst.value with scale, hz),
      (complexFunctionId.value with inside, hz)]
    typecheck
  have composed := HolomorphicOn.comp with linear, complexCos.holomorphic,
    maps
  apply HolomorphicOn.congr with composed
  intros z hz
  have values : ∀ w ∈ complexCarrier, complexCos(complexFunctionMul(
      complexFunctionConst(ℂ[complexOfReal(realPi) * complexOfReal(R[1 / 2])],
      complexCarrier), complexFunctionId(complexCarrier),
      complexCarrier)(w)) ∈ complexCarrier
    intros w hw
    have image := maps with w, hw
    exact complexCos.member with image
  rw [(complexFunctionComp.value with values, hz),
    (complexFunctionMul.value with constantValues, identityValues, hz),
    (complexFunctionConst.value with scale, hz),
    (complexFunctionId.value with inside, hz), (cosHalfMap.value with hz)]
  have same : ℂ[complexOfReal(realPi) * complexOfReal(R[1 / 2]) * z] =
    ℂ[complexOfReal(realPi) * z * complexOfReal(R[1 / 2])] by ring
  rw same

theorem zetaPolarMap.holomorphic
  shows HolomorphicOn(zetaPolarMap, complexCarrier)
proof
  have whole := ComplexOpen.whole
  have positive : R[0] < R[1] by linarith
  have regular := hurwitzZetaRegularMap.holomorphic at R[1] with positive
  have shift := shiftDownMap.holomorphic
  have product := HolomorphicOn.mul with shift, regular
  have one : ℂ[1] ∈ ℂ by typecheck
  have constant := HolomorphicOn.const with whole, one
  obtain ⟨_, shiftValues, _⟩ := shift
  obtain ⟨_, regularValues, _⟩ := regular
  apply HolomorphicOn.add_formula with product, constant
  intros z hz
  rw [(zetaPolarMap.value with hz),
    (complexFunctionMul.value with shiftValues, regularValues, hz),
    (complexFunctionConst.value with one, hz), (shiftDownMap.value with hz)]

-- Off s = 1 the polar map is (s − 1) ζ(s).
theorem zetaPolarMap.off_one (s : Set)
  requires hs : s ∈ ℂ
  requires notOne : s ≠ ℂ[1]
  shows zetaPolarMap(s) = ℂ[(s - 1) * riemannZeta(s)]
proof
  have shifted : ℂ[s - 1] ∈ ℂ by typecheck
  have nonzero : ℂ[s - 1] ≠ ℂ[0]
    intro vanish
    apply notOne
    linear_combination vanish
  have cancel := complexInv.mul_cancel with shifted, nonzero
  have zeta := riemannZeta.member with hs
  have inverse := complexInv.member with shifted
  rw [(zetaPolarMap.value with hs), (hurwitzZetaRegularMap.value at R[1], s
    with hs)]
  unfold complexDiv
  unfold riemannZeta
  linear_combination -cancel

-- The two sides of (s − 1) ζ(1 − s) = 2 (2π)^(−s) cos(πs/2) Γ(s) (s − 1) ζ(s)
-- on the domain of Γ.
defgraph asymmLeftMap (s ∈ gammaDomain) : complexCarrier :=
  ℂ[(s - 1) * riemannZeta(1 - s)]
proof
  have hs := gammaDomain.subset with s, member
  have reflected : ℂ[1 - s] ∈ ℂ by typecheck
  have zeta := riemannZeta.member with reflected
  typecheck

defgraph asymmRightMap (s ∈ gammaDomain) : complexCarrier :=
  ℂ[2 * realCpow(R[2 * realPi], ℂ[-s]) * cosHalfMap(s) * Gamma(s) *
    zetaPolarMap(s)]
proof
  have hs := gammaDomain.subset with s, member
  have negative : ℂ[-s] ∈ ℂ by typecheck
  have power := realCpow.member at R[2 * realPi], ℂ[-s] with negative
  have cosine := FunctionBetween.apply_closed with cosHalfMap.function, hs
  have gamma := Gamma.member at s
  have polar := FunctionBetween.apply_closed with zetaPolarMap.function, hs
  typecheck

theorem asymmLeftMap.holomorphic
  shows HolomorphicOn(asymmLeftMap, gammaDomain)
proof
  have isOpen := gammaDomain.open
  have inside := gammaDomain.subset
  have shift := HolomorphicOn.mono with shiftDownMap.holomorphic, isOpen,
    inside
  have reflect := HolomorphicOn.mono with reflectMap.holomorphic, isOpen,
    inside
  have one := complexOne.member
  have zetaHolomorphic := zeta.holomorphic
  have maps : ∀ z ∈ gammaDomain, reflectMap(z) ∈ complexCarrier ∖ {ℂ[1]}
    intros z hz
    have zMember := inside with z, hz
    rw (reflectMap.value with zMember)
    have reflected : ℂ[1 - z] ∈ ℂ by typecheck
    refine ⟨reflected, ?_⟩
    intro single
    have same := (singleton.membership at ℂ[1 - z], ℂ[1]).forward with single
    have zero : z = ℂ[0] by linear_combination -same
    unfold gammaDomain at hz
    obtain ⟨_, notPole⟩ := difference.membership.forward with hz
    apply notPole
    have zeroNat : (0:N) ∈ ℕ by typecheck
    refine ⟨zMember, (0:N), zeroNat, ?_⟩
    rw [zero, realNat.zero, complexOfReal.zero]
    ring
  have composed := HolomorphicOn.comp with reflect, zetaHolomorphic, maps
  have values : ∀ z ∈ gammaDomain, riemannZetaMap(reflectMap(z)) ∈
      complexCarrier
    intros z hz
    have zMember := inside with z, hz
    rw (reflectMap.value with zMember)
    have reflected : ℂ[1 - z] ∈ ℂ by typecheck
    rw (riemannZetaMap.apply with reflected)
    exact riemannZeta.member with reflected
  obtain ⟨_, shiftValues, _⟩ := shift
  apply HolomorphicOn.mul_formula with shift, composed
  intros z hz
  have zMember := inside with z, hz
  have reflected : ℂ[1 - z] ∈ ℂ by typecheck
  rw [(asymmLeftMap.value with hz), (shiftDownMap.value with zMember),
    (complexFunctionComp.value with values, hz),
    (reflectMap.value with zMember), (riemannZetaMap.apply with reflected)]

theorem asymmRightMap.holomorphic
  shows HolomorphicOn(asymmRightMap, gammaDomain)
proof
  have isOpen := gammaDomain.open
  have inside := gammaDomain.subset
  have zero : ℂ[0] ∈ ℂ by typecheck
  have minusOne : ℂ[-1] ∈ ℂ by typecheck
  have power := affinePower.holomorphic at R[2 * realPi], ℂ[0], ℂ[-1],
    gammaDomain with zero, minusOne, isOpen, inside
  have cosine := HolomorphicOn.mono with cosHalfMap.holomorphic, isOpen,
    inside
  have gamma := Gamma.holomorphic
  have polar := HolomorphicOn.mono with zetaPolarMap.holomorphic, isOpen,
    inside
  have first := HolomorphicOn.mul with power, cosine
  have second := HolomorphicOn.mul with first, gamma
  have third := HolomorphicOn.mul with second, polar
  have two : ℂ[2] ∈ ℂ by typecheck
  have constant := HolomorphicOn.const with isOpen, two
  obtain ⟨_, powerValues, _⟩ := power
  obtain ⟨_, cosineValues, _⟩ := cosine
  obtain ⟨_, gammaValues, _⟩ := gamma
  obtain ⟨_, polarValues, _⟩ := polar
  obtain ⟨_, firstValues, _⟩ := first
  obtain ⟨_, secondValues, _⟩ := second
  apply HolomorphicOn.mul_formula with constant, third
  intros z hz
  have zMember := inside with z, hz
  have exponent : ℂ[0 + -1 * z] = ℂ[-z] by ring
  rw [(asymmRightMap.value with hz), (complexFunctionConst.value with two, hz),
    (complexFunctionMul.value with secondValues, polarValues, hz),
    (complexFunctionMul.value with firstValues, gammaValues, hz),
    (complexFunctionMul.value with powerValues, cosineValues, hz),
    (affinePower.value at R[2 * realPi], ℂ[0], ℂ[-1], z with zero, minusOne,
      zMember), exponent, (GammaMap.value with hz)]
  ring

-- The asymmetric functional equation on the whole domain, by the identity
-- theorem from re s > 1.
theorem asymmMaps.agree (s : Set)
  requires hs : s ∈ gammaDomain
  shows asymmLeftMap(s) = asymmRightMap(s)
proof
  have halfPlane := rightHalfPlane.open at R[1]
  have two : ℂ[2] ∈ ℂ by typecheck
  have nonempty : ∃ v, v ∈ rightHalfPlane(R[1])
    have twoRe : complexRe(ℂ[2]) = R[2]
      rw ← complexOfReal.two
      exact complexOfReal.re at R[2]
    have reReal := complexRe.real with two
    have large : R[1] < complexRe(ℂ[2]) by linarith
    exact ⟨ℂ[2], (rightHalfPlane.membership.backward with ⟨two, large⟩)⟩
  have inside : rightHalfPlane(R[1]) ⊆ gammaDomain
    intros z hz
    obtain ⟨zMember, large⟩ := rightHalfPlane.membership.forward with hz
    have positive : realZero < complexRe(z) by linarith
    exact gammaDomain.of_re_positive with zMember, positive
  have agree : ∀ z ∈ rightHalfPlane(R[1]), asymmLeftMap(z) = asymmRightMap(z)
    intros z hz
    obtain ⟨zMember, large⟩ := rightHalfPlane.membership.forward with hz
    have domain := inside with z, hz
    have notOne := complex.ne_one_of_re_gt with large
    have equation := zeta.functional_equation_asymm_right with zMember, large
    rw [(asymmLeftMap.value with domain), (asymmRightMap.value with domain),
      (cosHalfMap.value with zMember), (zetaPolarMap.off_one with zMember,
      notOne), equation]
    ring
  have identity := holomorphic.identity with asymmLeftMap.holomorphic,
    asymmRightMap.holomorphic, gammaDomain.connected, halfPlane, nonempty,
    inside, agree
  exact identity with s, hs

-- The asymmetric form ζ(1 − s) = 2 (2π)^(−s) cos(πs/2) Γ(s) ζ(s), s ≠ 1
-- and s not a pole of Γ.
theorem zeta.functional_equation_asymm (s : Set)
  requires hs : s ∈ gammaDomain
  requires notOne : s ≠ ℂ[1]
  shows riemannZeta(ℂ[1 - s]) =
    ℂ[2 * realCpow(R[2 * realPi], ℂ[-s]) *
      complexCos(ℂ[complexOfReal(realPi) * s * complexOfReal(R[1 / 2])]) *
      Gamma(s) * riemannZeta(s)]
proof
  have member := gammaDomain.subset with s, hs
  have agree := asymmMaps.agree with hs
  rw [(asymmLeftMap.value with hs), (asymmRightMap.value with hs),
    (cosHalfMap.value with member), (zetaPolarMap.off_one with member,
    notOne)] at agree
  have shifted : ℂ[s - 1] ∈ ℂ by typecheck
  have nonzero : ℂ[s - 1] ≠ ℂ[0]
    intro vanish
    apply notOne
    linear_combination vanish
  have cancel := complexInv.mul_cancel with shifted, nonzero
  have inverse := complexInv.member with shifted
  have reflected : ℂ[1 - s] ∈ ℂ by typecheck
  have reflectedZeta := riemannZeta.member with reflected
  have zeta := riemannZeta.member with member
  have negative : ℂ[-s] ∈ ℂ by typecheck
  have power := realCpow.member at R[2 * realPi], ℂ[-s] with negative
  have argument : ℂ[complexOfReal(realPi) * s * complexOfReal(R[1 / 2])] ∈ ℂ
    by typecheck
  have cosine := complexCos.member with argument
  have gamma := Gamma.member at s
  linear_combination complexInv(ℂ[s - 1]) * agree -
    (riemannZeta(ℂ[1 - s]) - 2 * realCpow(R[2 * realPi], ℂ[-s]) *
      complexCos(ℂ[complexOfReal(realPi) * s * complexOfReal(R[1 / 2])]) *
      Gamma(s) * riemannZeta(s)) * cancel

-- A zero of ζ in the critical strip reflects to a zero at 1 − s.
theorem zeta.zero_reflect (s : Set)
  requires hs : s ∈ ℂ
  requires lower : realZero < complexRe(s)
  requires upper : complexRe(s) < realOne
  requires zero : riemannZeta(s) = ℂ[0]
  shows riemannZeta(ℂ[1 - s]) = ℂ[0]
proof
  have domain := gammaDomain.of_re_positive with hs, lower
  have notOne := complex.ne_one_of_re_lt with upper
  have equation := zeta.functional_equation_asymm with domain, notOne
  rw [equation, zero]
  ring

-- Section: The symmetric functional equation
-- cos z = 0 only for z = πk − π/2: there e^(2iz) = −1, so e^(2iz + iπ) = 1.
theorem complexCos.eq_zero (z : Set)
  requires hz : z ∈ ℂ
  requires zero : complexCos(z) = ℂ[0]
  shows ∃ k ∈ ℤ, ℂ[2 * z + complexOfReal(realPi)] =
    complexOfReal(R[2 * realPi * realInt(k)])
proof
  have iMember := complexImaginaryUnit.member
  have piMember : complexOfReal(realPi) ∈ ℂ by typecheck
  have forward : ℂ[complexImaginaryUnit * z] ∈ ℂ by typecheck
  have backward : ℂ[-(complexImaginaryUnit * z)] ∈ ℂ by typecheck
  have forwardExp := complexExp.member with forward
  have backwardExp := complexExp.member with backward
  rw (complexCos.formula with hz) at zero
  have two : ℂ[2] ∈ ℂ by typecheck
  have half := complexInv.member with two
  have cancel := complexInv.mul_cancel with two, complexTwo.nonzero
  have sum : ℂ[complexExp(complexImaginaryUnit * z) +
      complexExp(-(complexImaginaryUnit * z))] = ℂ[0]
    linear_combination 2 * zero - (complexExp(complexImaginaryUnit * z) +
      complexExp(-(complexImaginaryUnit * z))) * cancel
  have opposite := complexExp.add with forward, backward
  have cancelled : ℂ[complexImaginaryUnit * z + -(complexImaginaryUnit * z)] =
      ℂ[0] by ring
  rw [cancelled, complexExp.zero] at opposite
  have doubled := complexExp.add with forward, forward
  have doubleMember : ℂ[complexImaginaryUnit * z + complexImaginaryUnit * z] ∈ ℂ
    by typecheck
  have piAngle : ℂ[complexImaginaryUnit * complexOfReal(realPi)] ∈ ℂ
    by typecheck
  have total := complexExp.add with doubleMember, piAngle
  rw complexExp.i_pi at total
  have one : complexExp(ℂ[complexImaginaryUnit * z + complexImaginaryUnit * z +
      complexImaginaryUnit * complexOfReal(realPi)])
      = ℂ[1]
    rw [total, doubled]
    linear_combination (-complexExp(complexImaginaryUnit * z)) * sum - opposite
  have angle : ℂ[complexImaginaryUnit * z + complexImaginaryUnit * z +
      complexImaginaryUnit * complexOfReal(realPi)] ∈ ℂ
    by typecheck
  have iff := complexExp.eq_one_iff with angle
  obtain ⟨k, kMember, shape⟩ := iff.forward with one
  refine ⟨k, kMember, ?_⟩
  have square := complexImaginaryUnit.square
  have multiple : complexOfReal(R[2 * realPi * realInt(k)]) ∈ ℂ by typecheck
  linear_combination (-complexImaginaryUnit) * shape + (2 * z +
    complexOfReal(realPi) -
    complexOfReal(R[2 * realPi * realInt(k)])) * square

theorem complexSin.add_half_pi (z : Set)
  requires hz : z ∈ ℂ
  shows complexSin(ℂ[z + complexOfReal(realPi) * complexOfReal(R[1 / 2])]) =
    complexCos(z)
proof
  have twoNonzero : R[2] ≠ R[0] by linarith
  have inverse := realInvValue.mul_right with twoNonzero
  have halfPi : R[realPi * (1 / 2)] = realHalfPi
    unfold realPi
    rw realDiv.eq_mul_inv
    linear_combination realHalfPi * inverse
  have quarter : ℂ[complexOfReal(realPi) * complexOfReal(R[1 / 2])] =
      complexOfReal(realHalfPi)
    rw [← complexOfReal.mul, halfPi]
  have halfMember : complexOfReal(realHalfPi) ∈ ℂ by typecheck
  have sine := complexSin.member with hz
  have cosine := complexCos.member with hz
  rw [quarter, (complexSin.add with hz, halfMember), realSin.of_real,
    realCos.of_real, realHalfPi.cos, realSin.half_pi, complexOfReal.zero,
    complexOfReal.one]
  ring

-- √π = π^(1/2).
theorem realCpow.sqrt_pi
  shows complexOfReal(realSqrt(realPi)) =
    realCpow(realPi, complexOfReal(R[1 / 2]))
proof
  have piPositive := realPi.positive
  have rootPositive := realRpow.positive at realPi, R[1 / 2]
  have nonnegative : R[0] ≤ realRpow(realPi, R[1 / 2]) by linarith
  have halves : R[1 / 2 + 1 / 2] = R[1] by linarith
  have sum := realRpow.add at realPi, R[1 / 2], R[1 / 2] with piPositive
  rw [halves, (realRpow.one with piPositive)] at sum
  symm at sum
  have root := realSqrt.eq_of_square with nonnegative, sum
  rw [root, realCpow.of_real]

theorem gammaDomain.zero_not
  shows ℂ[0] ∉ gammaDomain
proof
  intro inside
  unfold gammaDomain at inside
  obtain ⟨zero, notPole⟩ := difference.membership.forward with inside
  apply notPole
  have zeroNat : (0:N) ∈ ℕ by typecheck
  refine ⟨zero, (0:N), zeroNat, ?_⟩
  rw [realNat.zero, complexOfReal.zero]
  ring

-- re(s/2 + 1/2) = re(s)/2 + 1/2.
theorem complexRe.half_shift (s : Set)
  requires hs : s ∈ ℂ
  shows complexRe(ℂ[s * complexOfReal(R[1 / 2]) + complexOfReal(R[1 / 2])]) =
      R[complexRe(s) * (1 / 2) + 1 / 2]
proof
  have halfMember : complexOfReal(R[1 / 2]) ∈ ℂ by typecheck
  have product : ℂ[s * complexOfReal(R[1 / 2])] ∈ ℂ by typecheck
  rw [(complexRe.add with product, halfMember), (complexRe.mul with hs,
    halfMember), complexOfReal.re, complexOfReal.im]
  ring

-- The symmetric equation at t, where Γ(t) is expanded by duplication and
-- Γ((1 + t)/2) Γ((1 − t)/2) = π / cos(πt/2) by reflection.
theorem completedZeta.reflect (t : Set)
  requires hs : t ∈ gammaDomain
  requires notOne : t ≠ ℂ[1]
  requires shifted : ℂ[t * complexOfReal(R[1 / 2]) + complexOfReal(R[1 / 2])]
    ∈ gammaDomain
  requires reflected : ℂ[(1 - t) * complexOfReal(R[1 / 2])] ∈ gammaDomain
  shows completedZeta(ℂ[1 - t]) = completedZeta(t)
proof
  have tMember := gammaDomain.subset with t, hs
  have half := complexHalf.double
  have halfMember : complexOfReal(R[1 / 2]) ∈ ℂ by typecheck
  have piMember : complexOfReal(realPi) ∈ ℂ by typecheck
  have asymm := zeta.functional_equation_asymm with hs, notOne
  -- Duplication at t/2.
  have double : ℂ[2 * (t * complexOfReal(R[1 / 2]))] = t
    linear_combination t * half
  have doubleDomain : ℂ[2 * (t * complexOfReal(R[1 / 2]))] ∈ gammaDomain
    rw double
    exact hs
  have halfTMember : ℂ[t * complexOfReal(R[1 / 2])] ∈ ℂ by typecheck
  have duplication := Gamma.duplication at ℂ[t * complexOfReal(R[1 / 2])]
    with halfTMember, doubleDomain
  rw double at duplication
  -- Reflection at (1 + t)/2.
  have oneMinus : ℂ[1 - (t * complexOfReal(R[1 / 2]) +
      complexOfReal(R[1 / 2]))] = ℂ[(1 - t) * complexOfReal(R[1 / 2])]
    linear_combination -half
  have reflectedDomain : ℂ[1 - (t * complexOfReal(R[1 / 2]) +
      complexOfReal(R[1 / 2]))] ∈ gammaDomain
    rw oneMinus
    exact reflected
  have reflection := Gamma.reflection at ℂ[t * complexOfReal(R[1 / 2]) +
    complexOfReal(R[1 / 2])] with shifted, reflectedDomain
  rw oneMinus at reflection
  have argument : ℂ[complexOfReal(realPi) * (t * complexOfReal(R[1 / 2]) +
      complexOfReal(R[1 / 2]))] = ℂ[complexOfReal(realPi) * t *
      complexOfReal(R[1 / 2]) + complexOfReal(realPi) *
      complexOfReal(R[1 / 2])] by ring
  have angle : ℂ[complexOfReal(realPi) * t * complexOfReal(R[1 / 2])] ∈ ℂ
    by typecheck
  rw [argument, (complexSin.add_half_pi with angle)] at reflection
  -- cos(πt/2) ≠ 0, as Γ((1 + t)/2) Γ((1 − t)/2) ≠ 0.
  have shiftedGamma := Gamma.member at ℂ[t * complexOfReal(R[1 / 2]) +
    complexOfReal(R[1 / 2])]
  have shiftedNonzero := Gamma.nonzero with shifted
  have reflectedGamma := Gamma.member at ℂ[(1 - t) * complexOfReal(R[1 / 2])]
  have reflectedNonzero := Gamma.nonzero with reflected
  have angleMember : ℂ[complexOfReal(realPi) * t * complexOfReal(R[1 / 2])] ∈ ℂ
    by typecheck
  have cosine := complexCos.member with angleMember
  have cosNonzero : complexCos(ℂ[complexOfReal(realPi) * t *
      complexOfReal(R[1 / 2])]) ≠ ℂ[0]
    intro vanish
    rw [vanish, complexDiv, complexInv.zero] at reflection
    have product : ℂ[Gamma(ℂ[t * complexOfReal(R[1 / 2]) +
        complexOfReal(R[1 / 2])]) * Gamma(ℂ[(1 - t) *
        complexOfReal(R[1 / 2])])] = ℂ[0]
      rw reflection
      ring
    have zero := complexMul.zero_factor with shiftedGamma, reflectedGamma,
      shiftedNonzero, product
    exact reflectedNonzero with zero
  have cosInverse := complexInv.mul_cancel with cosine, cosNonzero
  unfold complexDiv at reflection
  -- The powers of 2 and π.
  have twoPositive : R[0] < R[2] by linarith
  have piPositive := realPi.positive
  have negative : ℂ[-t] ∈ ℂ by typecheck
  have one : ℂ[1] ∈ ℂ by typecheck
  have powerSplit := realCpow.mul_base at R[2], realPi, ℂ[-t] with
    twoPositive, piPositive, negative
  have twoSplit := realCpow.add at R[2], ℂ[1], ℂ[-t] with one, negative
  rw [(realCpow.one at R[2] with twoPositive),
    complexOfReal.two] at twoSplit
  have root := realCpow.sqrt_pi
  have piOne := realCpow.one at realPi with piPositive
  have exponentA : ℂ[-(ℂ[1 - t] * complexOfReal(R[1 / 2]))] ∈ ℂ by typecheck
  have exponentB : ℂ[-(t * complexOfReal(R[1 / 2]))] ∈ ℂ by typecheck
  have first := realCpow.add at realPi, ℂ[-(ℂ[1 - t] *
    complexOfReal(R[1 / 2]))], ℂ[-t] with
    exponentA, negative
  have sumA : ℂ[-(ℂ[1 - t] * complexOfReal(R[1 / 2])) + -t] ∈ ℂ by typecheck
  have second := realCpow.add at realPi, ℂ[-(ℂ[1 - t] *
    complexOfReal(R[1 / 2])) + -t], ℂ[1]
    with sumA, one
  have third := realCpow.add at realPi, ℂ[-(t * complexOfReal(R[1 / 2]))],
    complexOfReal(R[1 / 2]) with exponentB,
    halfMember
  have exponents : ℂ[-(ℂ[1 - t] * complexOfReal(R[1 / 2])) + -t + 1] =
      ℂ[-(t * complexOfReal(R[1 / 2])) + complexOfReal(R[1 / 2])]
    linear_combination (t - 1) * half
  rw [exponents, third, first] at second
  -- Combine.
  have zeta := riemannZeta.member with tMember
  have reflectedMember : ℂ[1 - t] ∈ ℂ by typecheck
  have zetaReflected := riemannZeta.member with reflectedMember
  have gamma := Gamma.member at t
  have gammaHalf := Gamma.member at ℂ[t * complexOfReal(R[1 / 2])]
  have powerA := realCpow.member at realPi, ℂ[-(ℂ[1 - t] *
    complexOfReal(R[1 / 2]))] with
    exponentA
  have powerB := realCpow.member at realPi, ℂ[-(t *
    complexOfReal(R[1 / 2]))] with exponentB
  have powerTwo := realCpow.member at R[2 * realPi], ℂ[-t] with negative
  have powerTwoNeg := realCpow.member at R[2], ℂ[-t] with negative
  have powerPiNeg := realCpow.member at realPi, ℂ[-t] with negative
  have powerHalf := realCpow.member at realPi,
    complexOfReal(R[1 / 2]) with halfMember
  have powerOneMinus := realCpow.member at R[2], ℂ[1 - t] with
    reflectedMember
  have rootMember : complexOfReal(realSqrt(realPi)) ∈ ℂ by typecheck
  have cosInverseMember := complexInv.member with cosine
  have scale : ℂ[realCpow(R[2], ℂ[1 - t]) * complexOfReal(realSqrt(realPi))] ∈ ℂ
    by typecheck
  have scaleNonzero : ℂ[realCpow(R[2], ℂ[1 - t]) *
      complexOfReal(realSqrt(realPi))] ≠ ℂ[0]
    rw [twoSplit, root]
    intro vanish
    have twoNonzero := complexTwo.nonzero
    have powerNonzero := realCpow.nonzero at R[2], ℂ[-t] with negative
    have halfNonzero := realCpow.nonzero at realPi,
      complexOfReal(R[1 / 2]) with halfMember
    have twoMember : ℂ[2] ∈ ℂ by typecheck
    have inner : ℂ[realCpow(R[2], ℂ[-t]) * realCpow(realPi,
        complexOfReal(R[1 / 2]))] ∈ ℂ by typecheck
    have regroup : ℂ[2 * (realCpow(R[2], ℂ[-t]) * realCpow(realPi,
        complexOfReal(R[1 / 2])))] = ℂ[0]
      linear_combination vanish
    have rest := complexMul.zero_factor with twoMember, inner, twoNonzero,
      regroup
    have last := complexMul.zero_factor with powerTwoNeg, powerHalf,
      powerNonzero, rest
    exact halfNonzero with last
  have difference : ℂ[realCpow(R[2], ℂ[1 - t]) *
      complexOfReal(realSqrt(realPi)) * (realCpow(realPi, ℂ[-(ℂ[1 - t] *
      complexOfReal(R[1 / 2]))]) * Gamma(ℂ[(1 - t) * complexOfReal(R[1 / 2])]) *
      riemannZeta(ℂ[1 - t]) - realCpow(realPi, ℂ[-(t *
        complexOfReal(R[1 / 2]))]) * Gamma(ℂ[t * complexOfReal(R[1 / 2])]) *
        riemannZeta(t))] = ℂ[0]
    linear_combination (realCpow(R[2], ℂ[1 -
      t])*complexOfReal(realSqrt(realPi))*realCpow(realPi, ℂ[-(ℂ[1 - t] *
      complexOfReal(R[1 / 2]))])*Gamma(ℂ[(1 - t) * complexOfReal(R[1 / 2])])) *
      asymm -
      (2*realCpow(R[2 * realPi], ℂ[-t])*complexCos(ℂ[complexOfReal(realPi) * t *
        complexOfReal(R[1 / 2])])*riemannZeta(t)*realCpow(realPi, ℂ[-(ℂ[1 - t] *
        complexOfReal(R[1 / 2]))])*Gamma(ℂ[(1 - t) *
        complexOfReal(R[1 / 2])])) * duplication +
      (2*realCpow(R[2 * realPi], ℂ[-t])*complexCos(ℂ[complexOfReal(realPi) * t *
        complexOfReal(R[1 / 2])])*riemannZeta(t)*realCpow(realPi, ℂ[-(ℂ[1 - t] *
        complexOfReal(R[1 / 2]))])*Gamma(ℂ[t * complexOfReal(R[1 / 2])])) *
        reflection +
      (2*realCpow(R[2 * realPi], ℂ[-t])*riemannZeta(t)*realCpow(realPi,
        ℂ[-(ℂ[1 - t] * complexOfReal(R[1 / 2]))])*Gamma(ℂ[t *
        complexOfReal(R[1 / 2])])*complexOfReal(realPi)) * cosInverse +
      (2*riemannZeta(t)*Gamma(ℂ[t * complexOfReal(R[1 / 2])])*realCpow(realPi,
        ℂ[-(ℂ[1 - t] * complexOfReal(R[1 / 2]))])*complexOfReal(realPi)) *
        powerSplit -
      (2*riemannZeta(t)*Gamma(ℂ[t * complexOfReal(R[1 / 2])])*realCpow(realPi,
        ℂ[-(ℂ[1 - t] * complexOfReal(R[1 / 2]))])*realCpow(R[2],
        ℂ[-t])*realCpow(realPi, ℂ[-t])) * piOne -
      (2*riemannZeta(t)*Gamma(ℂ[t * complexOfReal(R[1 / 2])])*realCpow(R[2],
        ℂ[-t])) * second -
      (complexOfReal(realSqrt(realPi))*realCpow(realPi, ℂ[-(t *
        complexOfReal(R[1 / 2]))])*Gamma(ℂ[t *
        complexOfReal(R[1 / 2])])*riemannZeta(t)) * twoSplit -
      (2*realCpow(R[2], ℂ[-t])*realCpow(realPi, ℂ[-(t *
        complexOfReal(R[1 / 2]))])*Gamma(ℂ[t *
        complexOfReal(R[1 / 2])])*riemannZeta(t)) * root
  have inner : ℂ[realCpow(realPi, ℂ[-(ℂ[1 - t] * complexOfReal(R[1 / 2]))]) *
      Gamma(ℂ[(1 - t) * complexOfReal(R[1 / 2])]) * riemannZeta(ℂ[1 - t]) -
      realCpow(realPi, ℂ[-(t * complexOfReal(R[1 / 2]))]) *
    Gamma(ℂ[t * complexOfReal(R[1 / 2])]) * riemannZeta(t)] ∈ ℂ by typecheck
  have zero := complexMul.zero_factor with scale, inner, scaleNonzero,
    difference
  unfold completedZeta
  linear_combination zero

-- Section: The Riemann zeta function
-- The functional equation ξ(s) = ξ(1 − s) of the completed zeta function,
-- s ∉ {1, 0, −2, −4, …} (s/2 and (1 − s)/2 not poles of Γ).
theorem zeta.functional_equation (s : Set)
  requires hs : s ∈ ℂ
  requires halfDomain : ℂ[s * complexOfReal(R[1 / 2])] ∈ gammaDomain
  requires reflectedDomain :
    ℂ[(1 - s) * complexOfReal(R[1 / 2])] ∈ gammaDomain
  shows completedZeta(s) = completedZeta(ℂ[1 - s])
proof
  have halfMember : complexOfReal(R[1 / 2]) ∈ ℂ by typecheck
  by_cases right : realZero < complexRe(s)
  . have domain := gammaDomain.of_re_positive with hs, right
    have notOne : s ≠ ℂ[1]
      intro same
      rw same at reflectedDomain
      have zero : ℂ[(1 - 1) * complexOfReal(R[1 / 2])] = ℂ[0] by ring
      rw zero at reflectedDomain
      exact gammaDomain.zero_not with reflectedDomain
    have shiftedMember : ℂ[s * complexOfReal(R[1 / 2]) +
        complexOfReal(R[1 / 2])] ∈ ℂ by typecheck
    have shiftedRe := complexRe.half_shift with hs
    have reReal := complexRe.real with hs
    have shiftedPositive : realZero < complexRe(ℂ[s * complexOfReal(R[1 / 2]) +
        complexOfReal(R[1 / 2])])
      have halves := realHalf.add_self
      have halfPositive : R[0] < R[1 / 2] by linarith
      have scaled := realLess.mul_right_of_positive with right, halfPositive
      have zeroProduct : R[0 * (1 / 2)] = R[0] by ring
      rw shiftedRe
      linarith
    have shifted := gammaDomain.of_re_positive with shiftedMember,
      shiftedPositive
    have equation := completedZeta.reflect with domain, notOne, shifted,
      reflectedDomain
    symm
    exact equation
  . have reflected : ℂ[1 - s] ∈ ℂ by typecheck
    have reflectedRe := complexRe.one_sub with hs
    have reReal := complexRe.real with hs
    have positive : realZero < complexRe(ℂ[1 - s])
      rw reflectedRe
      linarith
    have domain := gammaDomain.of_re_positive with reflected, positive
    have notOne : ℂ[1 - s] ≠ ℂ[1]
      intro same
      have zero : s = ℂ[0] by linear_combination -same
      rw zero at halfDomain
      have product : ℂ[0 * complexOfReal(R[1 / 2])] = ℂ[0] by ring
      rw product at halfDomain
      exact gammaDomain.zero_not with halfDomain
    have shiftedMember : ℂ[ℂ[1 - s] * complexOfReal(R[1 / 2]) +
        complexOfReal(R[1 / 2])] ∈ ℂ by typecheck
    have shiftedRe := complexRe.half_shift with reflected
    have shiftedPositive : realZero < complexRe(ℂ[ℂ[1 - s] *
        complexOfReal(R[1 / 2]) + complexOfReal(R[1 / 2])])
      have halves := realHalf.add_self
      have halfPositive : R[0] < R[1 / 2] by linarith
      have scaled := realLess.mul_right_of_positive with positive,
        halfPositive
      have zeroProduct : R[0 * (1 / 2)] = R[0] by ring
      rw shiftedRe
      linarith
    have shifted := gammaDomain.of_re_positive with shiftedMember,
      shiftedPositive
    have back : ℂ[(1 - ℂ[1 - s]) * complexOfReal(R[1 / 2])] = ℂ[s *
        complexOfReal(R[1 / 2])] by ring
    have backDomain : ℂ[(1 - ℂ[1 - s]) * complexOfReal(R[1 / 2])] ∈ gammaDomain
      rw back
      exact halfDomain
    have equation := completedZeta.reflect with domain, notOne, shifted,
      backDomain
    have twice : ℂ[1 - ℂ[1 - s]] = s by ring
    rw twice at equation
    exact equation

-- The only zeros of ζ on re s ≤ 0 are the trivial zeros −2, −4, ….
theorem zeta.zeros_left (s : Set)
  requires hs : s ∈ ℂ
  requires left : complexRe(s) ≤ realZero
  requires zero : riemannZeta(s) = ℂ[0]
  shows ∃ n ∈ ℕ, s = ℂ[-2 * (complexOfReal(realNat(n)) + 1)]
proof
  have reReal := complexRe.real with hs
  have notZero : s ≠ ℂ[0]
    intro same
    rw [same, zeta.zero_value] at zero
    have re := complexOfReal.re at R[-(1 / 2)]
    rw [zero, ← complexOfReal.zero, complexOfReal.re] at re
    have halves := realHalf.add_self
    linarith
  have reflected : ℂ[1 - s] ∈ ℂ by typecheck
  have reflectedRe := complexRe.one_sub with hs
  have atLeastOne : realOne ≤ complexRe(ℂ[1 - s])
    rw reflectedRe
    linarith
  have positive : realZero < complexRe(ℂ[1 - s]) by linarith
  have domain := gammaDomain.of_re_positive with reflected, positive
  have notOne : ℂ[1 - s] ≠ ℂ[1]
    intro same
    apply notZero
    linear_combination -same
  have asymm := zeta.functional_equation_asymm with domain, notOne
  have back : ℂ[1 - ℂ[1 - s]] = s by ring
  rw [back, zero] at asymm
  -- The cosine factor vanishes.
  have zetaNonzero := zeta.nonzero_re_ge_one with reflected, atLeastOne,
    notOne
  have gammaNonzero := Gamma.nonzero with domain
  have negative : ℂ[-ℂ[1 - s]] ∈ ℂ by typecheck
  have powerNonzero := realCpow.nonzero at R[2 * realPi], ℂ[-ℂ[1 - s]] with
    negative
  have power := realCpow.member at R[2 * realPi], ℂ[-ℂ[1 - s]] with negative
  have gamma := Gamma.member at ℂ[1 - s]
  have zetaMember := riemannZeta.member with reflected
  have angle : ℂ[complexOfReal(realPi) * ℂ[1 - s] * complexOfReal(R[1 / 2])] ∈ ℂ
    by typecheck
  have cosine := complexCos.member with angle
  have two : ℂ[2] ∈ ℂ by typecheck
  have twoPower : ℂ[2 * realCpow(R[2 * realPi], ℂ[-ℂ[1 - s]])] ∈ ℂ
    by typecheck
  have twoPowerNonzero : ℂ[2 * realCpow(R[2 * realPi], ℂ[-ℂ[1 - s]])] ≠ ℂ[0]
    intro vanish
    have rest := complexMul.zero_factor with two, power, complexTwo.nonzero,
      vanish
    exact powerNonzero with rest
  have withGamma : ℂ[2 * realCpow(R[2 * realPi], ℂ[-ℂ[1 - s]]) *
      Gamma(ℂ[1 - s])] ∈ ℂ by typecheck
  have withGammaNonzero : ℂ[2 * realCpow(R[2 * realPi], ℂ[-ℂ[1 - s]]) *
      Gamma(ℂ[1 - s])] ≠ ℂ[0]
    intro vanish
    have rest := complexMul.zero_factor with twoPower, gamma,
      twoPowerNonzero, vanish
    exact gammaNonzero with rest
  have scale : ℂ[2 * realCpow(R[2 * realPi], ℂ[-ℂ[1 - s]]) *
      Gamma(ℂ[1 - s]) * riemannZeta(ℂ[1 - s])] ∈ ℂ by typecheck
  have scaleNonzero : ℂ[2 * realCpow(R[2 * realPi], ℂ[-ℂ[1 - s]]) *
      Gamma(ℂ[1 - s]) * riemannZeta(ℂ[1 - s])] ≠ ℂ[0]
    intro vanish
    have rest := complexMul.zero_factor with withGamma, zetaMember,
      withGammaNonzero, vanish
    exact zetaNonzero with rest
  have regrouped : ℂ[2 * realCpow(R[2 * realPi], ℂ[-ℂ[1 - s]]) *
      Gamma(ℂ[1 - s]) * riemannZeta(ℂ[1 - s]) *
      complexCos(ℂ[complexOfReal(realPi) * ℂ[1 - s] *
        complexOfReal(R[1 / 2])])] = ℂ[0]
    linear_combination -asymm
  have cosZero := complexMul.zero_factor with scale, cosine, scaleNonzero,
    regrouped
  obtain ⟨k, kMember, shape⟩ := complexCos.eq_zero with angle, cosZero
  have kInteger : Integer(k) by typecheck
  -- So s = 2 − 2k.
  have half := complexHalf.double
  have piMember : complexOfReal(realPi) ∈ ℂ by typecheck
  have kComplex : complexOfReal(realInt(k)) ∈ ℂ by typecheck
  rw [complexOfReal.mul, complexOfReal.mul, complexOfReal.two] at shape
  have factored : ℂ[complexOfReal(realPi) *
      (2 - s - 2 * complexOfReal(realInt(k)))] = ℂ[0]
    linear_combination shape - (complexOfReal(realPi) * ℂ[1 - s]) * half
  have piNonzero : complexOfReal(realPi) ≠ ℂ[0]
    intro vanish
    have re := complexOfReal.re at realPi
    rw [vanish, ← complexOfReal.zero, complexOfReal.re] at re
    have piPositive := realPi.positive
    linarith
  have rest : ℂ[2 - s - 2 * complexOfReal(realInt(k))] ∈ ℂ by typecheck
  have value := complexMul.zero_factor with piMember, rest, piNonzero,
    factored
  have sValue : s = complexOfReal(R[2 - 2 * realInt(k)])
    rw [complexOfReal.sub, complexOfReal.mul, complexOfReal.two]
    linear_combination -value
  have kReal := realInt.real at k
  have sRe : complexRe(s) = R[2 - 2 * realInt(k)]
    rw sValue
    exact complexOfReal.re at R[2 - 2 * realInt(k)]
  have kLower : R[1] ≤ realInt(k) by linarith
  have kNotOne : realInt(k) ≠ R[1]
    intro unit
    apply notZero
    rw [sValue, unit]
    have collapse : R[2 - 2 * 1] = R[0] by ring
    rw [collapse, complexOfReal.zero]
  obtain ⟨m, mNat, signs⟩ := Integer.signed_natural at k
  cases signs with natural | negative
  . rw [natural, realInt.nat] at kLower
    rw [natural, realInt.nat] at kNotOne
    rw [natural, realInt.nat] at sValue
    have oneLess : R[1] < realNat(m)
      have different : realNat(m) ≠ R[1] by exact kNotOne
      by_contra notLess
      apply different
      linarith
    rw ← realNat.one at oneLess
    have greater := realNat.lt_of_real_lt with oneLess
    have atLeastTwo : 2 ≤ m by arith
    obtain ⟨n, nNat, split⟩ := atLeastTwo
    have nMember : n ∈ ℕ by typecheck
    refine ⟨n, nMember, ?_⟩
    rw [sValue, ← split, realNat.add, realNat.two, complexOfReal.sub,
      complexOfReal.mul, complexOfReal.add, complexOfReal.two]
    ring
  . rw [negative, integerNegativeOfNat.eq_neg, realInt.neg, realInt.nat]
      at kLower
    have nonnegative := realNat.nonnegative at m
    exfalso
    linarith

-- Section: Gauss sums
-- The terms e(l x), l = 0, 1, 2, ….
defgraph additiveTerms (X : Real) (l ∈ ℕ) : complexCarrier :=
  expTwoPiI(R[realNat(l) * X])
proof
  have lNat := nat.omega.backward at l with member
  exact expTwoPiI.member at R[realNat(l) * X]

-- (e(x) − 1) Σ_{l<n} e(l x) = e(n x) − 1.
theorem additiveTerms.telescope (X : Real) (n : Nat)
  shows ℂ[(expTwoPiI(X) - 1) * complexPartialSum(additiveTerms(X), n)] =
    ℂ[expTwoPiI(R[realNat(n) * X]) - 1]
proof
  induction n
  | zero =>
    have zeroProduct : R[realNat(0) * X] = R[0]
      rw realNat.zero
      ring
    have base := expTwoPiI.member at X
    rw [complexPartialSum.zero, zeroProduct, expTwoPiI.zero]
    ring
  | succ(k) using ih =>
    have base := expTwoPiI.member at X
    have terms := additiveTerms.function at X
    have sequence : ComplexSequence(additiveTerms(X)) by exact terms
    have previous := complexPartialSum.member at additiveTerms(X), k with
      sequence
    have kMember : k ∈ ℕ by typecheck
    have term := additiveTerms.value at X, k with kMember
    have power := expTwoPiI.member at R[realNat(k) * X]
    have shift : R[realNat(succ(k)) * X] = R[realNat(k) * X + X]
      rw realNat.succ
      ring
    have split := expTwoPiI.add at R[realNat(k) * X], X
    rw [complexPartialSum.succ, term, shift, split]
    linear_combination ih

-- Σ_{l<n} e(l x) = 0 when e(x) ≠ 1 and e(n x) = 1.
theorem additiveTerms.sum_zero (X : Real) (n : Nat)
  requires nontrivial : expTwoPiI(X) ≠ ℂ[1]
  requires period : expTwoPiI(R[realNat(n) * X]) = ℂ[1]
  shows complexPartialSum(additiveTerms(X), n) = ℂ[0]
proof
  have telescope := additiveTerms.telescope at X, n
  rw period at telescope
  have base := expTwoPiI.member at X
  have difference : ℂ[expTwoPiI(X) - 1] ∈ ℂ by typecheck
  have nonzero : ℂ[expTwoPiI(X) - 1] ≠ ℂ[0]
    intro vanish
    apply nontrivial
    linear_combination vanish
  have terms := additiveTerms.function at X
  have sequence : ComplexSequence(additiveTerms(X)) by exact terms
  have sum := complexPartialSum.member at additiveTerms(X), n with sequence
  have product : ℂ[(expTwoPiI(X) - 1) *
      complexPartialSum(additiveTerms(X), n)] = ℂ[0]
    rw telescope
    ring
  exact complexMul.zero_factor with difference, sum, nonzero, product

-- Σ_{l<n} e(0) = n.
theorem additiveTerms.sum_trivial (n : Nat)
  shows complexPartialSum(additiveTerms(R[0]), n) = complexOfReal(realNat(n))
proof
  induction n
  | zero =>
    rw [complexPartialSum.zero, realNat.zero, complexOfReal.zero]
  | succ(k) using ih =>
    have kMember : k ∈ ℕ by typecheck
    have term := additiveTerms.value at R[0], k with kMember
    have zeroProduct : R[realNat(k) * 0] = R[0] by ring
    have next : realNat(succ(k)) = R[realNat(k) + 1]
      rw realNat.succ
      ring
    rw [complexPartialSum.succ, term, zeroProduct, expTwoPiI.zero, ih,
      next, complexOfReal.add, complexOfReal.one]

-- A sum of zeros vanishes.
theorem complexPartialSum.zeros (u : Set) (n : Nat)
  requires vanishing : ∀ k ∈ ℕ, u(k) = ℂ[0]
  shows complexPartialSum(u, n) = ℂ[0]
proof
  induction n
  | zero =>
    rw complexPartialSum.zero
  | succ(k) using ih =>
    have kMember : k ∈ ℕ by typecheck
    rw [complexPartialSum.succ, ih, (vanishing with k, kMember)]
    ring

-- The conjugate of a sum is the sum of the conjugates.
theorem complexPartialSum.conj_terms (u v : Set) (n : Nat)
  requires sequence : ComplexSequence(u)
  requires conjugates : ∀ k ∈ ℕ, v(k) = complexConj(u(k))
  shows complexConj(complexPartialSum(u, n)) = complexPartialSum(v, n)
proof
  induction n
  | zero =>
    rw [complexPartialSum.zero, complexPartialSum.zero]
    exact GRH.Exp.complexConj.zero
  | succ(k) using ih =>
    have kMember : k ∈ ℕ by typecheck
    have previous := complexPartialSum.member at u, k with sequence
    have term := FunctionBetween.apply_closed with sequence, kMember
    rw [complexPartialSum.succ, complexPartialSum.succ,
      (complexConj.add with previous, term), ih,
      (conjugates with k, kMember)]

-- A sum whose terms below n ≥ 2 vanish except at index 1.
theorem complexPartialSum.only_one (u : Set) (n : Nat)
  requires sequence : ComplexSequence(u)
  requires two : 2 ≤ n
  requires vanishing : ∀ k ∈ ℕ, k < n → k ≠ (1:N) → u(k) = ℂ[0]
  shows complexPartialSum(u, n) = u((1:N))
proof
  induction n
  | zero =>
    intros two vanishing
    exfalso
    arith
  | succ(k) using ih =>
    intros two vanishing
    have kMember : k ∈ ℕ by typecheck
    have term := FunctionBetween.apply_closed with sequence, kMember
    by_cases small : k < 2
    . have one : k = (1:N) by arith
      have zeroMember : (0:N) ∈ ℕ by typecheck
      have zeroBelow : (0:N) < succ(k) by arith
      have zeroOther : (0:N) ≠ (1:N) by arith
      have zeroVanish := vanishing with (0:N), zeroMember, zeroBelow,
        zeroOther
      rw [complexPartialSum.succ, one, complexPartialSum.succ,
        complexPartialSum.zero, zeroVanish]
      ring
    . have atLeast : 2 ≤ k by arith
      have restricted : ∀ j ∈ ℕ, j < k → j ≠ (1:N) → u(j) = ℂ[0]
        intros j jMember below other
        have larger : j < succ(k) by arith
        exact vanishing with j, jMember, larger, other
      have previous := ih with atLeast, restricted
      have below : k < succ(k) by arith
      have other : k ≠ (1:N) by arith
      have last := vanishing with k, kMember, below, other
      rw [complexPartialSum.succ, previous, last]
      ring

-- A grid of complex numbers F(j, l), its rows l and columns j, and their
-- sums.
defgraph gridRow (F : Set, l : Nat) (j ∈ ℕ) : complexCarrier := F((j, l))
requires grid : FunctionBetween(F, ℕ × ℕ, complexCarrier)
proof
  have lMember : l ∈ ℕ by typecheck
  have pair := product.pair with member, lMember
  exact FunctionBetween.apply_closed with grid, pair

defgraph gridColumn (F : Set, j : Nat) (l ∈ ℕ) : complexCarrier := F((j, l))
requires grid : FunctionBetween(F, ℕ × ℕ, complexCarrier)
proof
  have jMember : j ∈ ℕ by typecheck
  have pair := product.pair with jMember, member
  exact FunctionBetween.apply_closed with grid, pair

defgraph gridRowSums (F : Set, J : Nat) (l ∈ ℕ) : complexCarrier :=
  complexPartialSum(gridRow(F, l), J)
requires grid : FunctionBetween(F, ℕ × ℕ, complexCarrier)
proof
  have lNat := nat.omega.backward at l with member
  have row := gridRow.function at F, l with grid
  have sequence : ComplexSequence(gridRow(F, l)) by exact row
  exact complexPartialSum.member with sequence

defgraph gridColumnSums (F : Set, L : Nat) (j ∈ ℕ) : complexCarrier :=
  complexPartialSum(gridColumn(F, j), L)
requires grid : FunctionBetween(F, ℕ × ℕ, complexCarrier)
proof
  have jNat := nat.omega.backward at j with member
  have column := gridColumn.function at F, j with grid
  have sequence : ComplexSequence(gridColumn(F, j)) by exact column
  exact complexPartialSum.member with sequence

-- Summing a grid by rows or by columns gives the same total.
theorem gridRowSums.swap (F : Set) (J L : Nat)
  requires grid : FunctionBetween(F, ℕ × ℕ, complexCarrier)
  shows complexPartialSum(gridRowSums(F, J), L) =
    complexPartialSum(gridColumnSums(F, L), J)
proof
  induction L
  | zero =>
    have zeros : ∀ j ∈ ℕ, gridColumnSums(F, 0)(j) = ℂ[0]
      intros j jMember
      have jNat := nat.omega.backward at j with jMember
      rw [(gridColumnSums.value at F, 0, j with grid), complexPartialSum.zero]
    rw [complexPartialSum.zero, (complexPartialSum.zeros with zeros)]
  | succ(k) using ih =>
    have kMember : k ∈ ℕ by typecheck
    have columns := gridColumnSums.function at F, k with grid
    have columnSequence : ComplexSequence(gridColumnSums(F, k)) by
      exact columns
    have row := gridRow.function at F, k with grid
    have rowSequence : ComplexSequence(gridRow(F, k)) by exact row
    have add := complexPartialSum.add_terms at gridColumnSums(F, k),
      gridRow(F, k), gridColumnSums(F, succ(k)), J with columnSequence,
      rowSequence
    have termwise : ∀ j ∈ ℕ, j < J → gridColumnSums(F, succ(k))(j) =
        ℂ[gridColumnSums(F, k)(j) + gridRow(F, k)(j)]
      intros j jMember below
      have jNat := nat.omega.backward at j with jMember
      rw [(gridColumnSums.value at F, succ(k), j with grid),
        (gridColumnSums.value at F, k, j with grid),
        (gridRow.value at F, k, j with grid), complexPartialSum.succ,
        (gridColumn.value at F, j, k with grid)]
    have combined := add with termwise
    rw [complexPartialSum.succ, ih, combined,
      (gridRowSums.value at F, J, k with grid)]

-- e(a/N) = e(b/N) for a ≡ b modulo N.
theorem expTwoPiI.congruent (N a b : Nat)
  requires positive : 0 < N
  requires congruent : IntegerCongruent(integerOfNat(N), integerOfNat(a),
    integerOfNat(b))
  shows expTwoPiI(R[realNat(a) * realInvValue(realNat(N))]) =
    expTwoPiI(R[realNat(b) * realInvValue(realNat(N))])
proof
  obtain ⟨q, qInteger, multiple⟩ := congruent
  have same := realInt.mul at integerOfNat(N), q
  rw [multiple, realInt.sub, realInt.nat, realInt.nat, realInt.nat] at same
  have nonzero : N ≠ (0:N) by arith
  have nonzeroReal := realNat.ne_zero with nonzero
  have inverse := realInvValue.mul_right with nonzeroReal
  have shift : R[realNat(a) * realInvValue(realNat(N))] =
      R[realNat(b) * realInvValue(realNat(N)) + realInt(q)]
    linear_combination realInvValue(realNat(N)) * same +
      realInt(q) * inverse
  have phase := expTwoPiI.member at R[realNat(b) * realInvValue(realNat(N))]
  rw [shift, expTwoPiI.add, expTwoPiI.integer]
  ring

theorem complexMul.distribute_three (c x y z : Set)
  requires hc : c ∈ ℂ
  requires hx : x ∈ ℂ
  requires hy : y ∈ ℂ
  requires hz : z ∈ ℂ
  shows ℂ[c * x + (c * y) * z] = ℂ[c * (x + y * z)]
proof
  ring

-- The terms χ(j) e(jk/N) of the twisted Gauss sum
-- G(k) = Σ_{j<N} χ(j) e(jk/N); G(1) = τ(χ).
defgraph gaussTwist (N : Nat, χ : Set, k : Nat) (j ∈ ℕ) : complexCarrier :=
  ℂ[χ(integerOfNat(j)) *
    expTwoPiI(R[realNat(j * k) * realInvValue(realNat(N))])]
requires values : FunctionBetween(χ, ℤ, complexCarrier)
proof
  have jNat := nat.omega.backward at j with member
  have index : integerOfNat(j) ∈ ℤ by typecheck
  have value := FunctionBetween.apply_closed with values, index
  have phase := expTwoPiI.member at
    R[realNat(j * k) * realInvValue(realNat(N))]
  typecheck

-- G(k) depends on k modulo N.
theorem gaussTwist.congruent (N : Nat) (χ : Set, k l : Nat)
  requires values : FunctionBetween(χ, ℤ, complexCarrier)
  requires positive : 0 < N
  requires congruent : IntegerCongruent(integerOfNat(N), integerOfNat(k),
    integerOfNat(l))
  shows complexPartialSum(gaussTwist(N, χ, k), N) =
    complexPartialSum(gaussTwist(N, χ, l), N)
proof
  have termwise : ∀ j ∈ ℕ, j < N →
      gaussTwist(N, χ, k)(j) = gaussTwist(N, χ, l)(j)
    intros j jMember below
    have jNat := nat.omega.backward at j with jMember
    have scaled := IntegerCongruent.mul_left at integerOfNat(N),
      integerOfNat(k), integerOfNat(l), integerOfNat(j) with congruent
    rw [← integerOfNat.mul, ← integerOfNat.mul] at scaled
    have phase := expTwoPiI.congruent with positive, scaled
    rw [(gaussTwist.value at N, χ, k, j with values, jMember),
      (gaussTwist.value at N, χ, l, j with values, jMember), phase]
  have congr := complexPartialSum.congr at gaussTwist(N, χ, k),
    gaussTwist(N, χ, l), N
  exact congr with termwise

-- The terms of G(k) on the residues modulo N.
defgraph twistResidues (N : Nat, χ : Set, k : Nat) (j ∈ N) : complexCarrier :=
  gaussTwist(N, χ, k)(j)
requires values : FunctionBetween(χ, ℤ, complexCarrier)
proof
  have naturals := natural.member at N
  have jMember := naturals with j, member
  have terms := gaussTwist.function at N, χ, k with values
  exact FunctionBetween.apply_closed with terms, jMember

theorem twistResidues.sum_identity (N : Nat) (χ : Set, k m : Nat)
  requires values : FunctionBetween(χ, ℤ, complexCarrier)
  requires bound : m ≤ N
  shows indexedRingSum(twistResidues(N, χ, k), identity(N), complexAdd,
    complexZero, m) = complexPartialSum(gaussTwist(N, χ, k), m)
proof
  induction m
  | zero =>
    intro bound
    rw [indexedRingSum, complexPartialSum.zero]
  | succ(i) using ih =>
    intro bound
    have smaller : i ≤ N by arith
    have below : i < N by arith
    have iMember := membership.of_Less at i, N with below
    have previous := ih with smaller
    have position := identity.apply at i, N with iMember
    have value := twistResidues.value at N, χ, k, i with values, iMember
    rw [indexedRingSum, previous, position, value, complexPartialSum.succ]
    unfold call2
    rfl

theorem twistResidues.sum_scaled (N t : Nat) (χ : Set, k m : Nat)
  requires character : DirichletCharacter(N, χ)
  requires positive : 0 < N
  requires bound : m ≤ N
  shows indexedRingSum(twistResidues(N, χ, k), residueScale(N, t),
    complexAdd, complexZero, m) =
    ℂ[χ(integerOfNat(t)) * complexPartialSum(gaussTwist(N, χ, t * k), m)]
proof
  induction m
  | zero =>
    intro bound
    have scalar : integerOfNat(t) ∈ ℤ by typecheck
    have value := DirichletCharacter.value with character, scalar
    rw [indexedRingSum, complexPartialSum.zero]
    ring
  | succ(i) using ih =>
    intro bound
    have values := DirichletCharacter.function with character
    have smaller : i ≤ N by arith
    have below : i < N by arith
    have iMember := membership.of_Less at i, N with below
    have iNat : i ∈ ℕ by typecheck
    have previous := ih with smaller
    have nonzero : N ≠ (0:N) by arith
    have imageBelow := mod.less at t * i, N with nonzero
    have imageMember := membership.of_Less at (t * i) % N, N with imageBelow
    have imageNat : (t * i) % N ∈ ℕ by typecheck
    have position := residueScale.value at N, t, i with positive, iMember
    have value := twistResidues.value at N, χ, k, (t * i) % N with values,
      imageMember
    have twist := gaussTwist.value at N, χ, k, (t * i) % N with values,
      imageNat
    have iTwist := gaussTwist.value at N, χ, t * k, i with values, iNat
    -- χ((t i) mod N) = χ(t) χ(i).
    have reduction := CongruentMod.mod_right at t * i, N
    have lifted := IntegerCongruent.ofNat_iff.backward at N, t * i,
      (t * i) % N with reduction
    have productInteger : integerOfNat(t * i) ∈ ℤ by typecheck
    have reducedInteger : integerOfNat((t * i) % N) ∈ ℤ by typecheck
    have same := DirichletCharacter.congruent with character, productInteger,
      reducedInteger, lifted
    have scalar : integerOfNat(t) ∈ ℤ by typecheck
    have iInteger : integerOfNat(i) ∈ ℤ by typecheck
    have multiplicative := DirichletCharacter.mul with character, scalar,
      iInteger
    rw ← integerOfNat.mul at multiplicative
    -- e(((t i) mod N) k / N) = e(i (t k) / N).
    have reverse := IntegerCongruent.symmetric with lifted
    have scaled := IntegerCongruent.mul_right at integerOfNat(N),
      integerOfNat((t * i) % N), integerOfNat(t * i), integerOfNat(k) with
      reverse
    rw [← integerOfNat.mul, ← integerOfNat.mul] at scaled
    have regroup : (t * i) * k = i * (t * k) by ring
    rw regroup at scaled
    have phase := expTwoPiI.congruent with positive, scaled
    have scalarValue := DirichletCharacter.value with character, scalar
    have iValue := DirichletCharacter.value with character, iInteger
    have sum := complexPartialSum.member at gaussTwist(N, χ, t * k), i with
      (gaussTwist.function at N, χ, t * k with values)
    have iPhase := expTwoPiI.member at
      R[realNat(i * (t * k)) * realInvValue(realNat(N))]
    rw [indexedRingSum, previous, position, value, twist, ← same,
      multiplicative, phase, complexPartialSum.succ, iTwist]
    exact complexMul.distribute_three with scalarValue, sum, iValue, iPhase

-- For t coprime to N, χ(t) G(t k) = G(k).
theorem gaussTwist.scale (N t : Nat) (χ : Set, k : Nat)
  requires character : DirichletCharacter(N, χ)
  requires positive : 0 < N
  requires coprime : gcd(t, N) = (1:N)
  shows ℂ[χ(integerOfNat(t)) * complexPartialSum(gaussTwist(N, χ, t * k), N)]
    = complexPartialSum(gaussTwist(N, χ, k), N)
proof
  have values := DirichletCharacter.function with character
  have permutation := residueScale.bijective at N, t with positive, coprime
  have order := identity.bijective at N
  have weights := twistResidues.function at N, χ, k with values
  have ring := complexes.comm_ring
  have reindexed := indexedRingSum.reindex at complexCarrier, complexAdd,
    complexZero, complexNeg, complexMul, complexOne, twistResidues(N, χ, k),
    N, identity(N), residueScale(N, t), N, N
    with ring, weights, order, permutation
  have full : N ≤ N by arith
  have identitySum := twistResidues.sum_identity at N, χ, k, N with values,
    full
  have scaledSum := twistResidues.sum_scaled at N, t, χ, k, N with
    character, positive, full
  rw [identitySum, scaledSum] at reindexed
  symm at reindexed
  exact reindexed

theorem liftedCharacter.functional_of_agree (N : Nat) (χ : Set) (M : Nat)
  requires character : DirichletCharacter(N, χ)
  requires positive : 0 < N
  requires agree : ∀ x ∈ ℤ, ∀ y ∈ ℤ, IntegerCoprime(x, integerOfNat(N)) →
    IntegerCoprime(y, integerOfNat(N)) → IntegerCongruent(integerOfNat(M), x, y)
    → χ(x) = χ(y)
  shows Functional(liftedCharacter(N, M, χ))
proof
  intros a y yMember z zMember
  obtain ⟨aInteger, yBranches⟩ := liftedCharacter.pair with yMember
  obtain ⟨_, zBranches⟩ := liftedCharacter.pair with zMember
  cases yBranches with yUnit | yOther
  . cases zBranches with zUnit | zOther
    . obtain ⟨_, x, xInteger, xCongruent, xCoprime, yValue⟩ := yUnit
      obtain ⟨_, w, wInteger, wCongruent, wCoprime, zValue⟩ := zUnit
      have reverse := IntegerCongruent.symmetric with wCongruent
      have between := IntegerCongruent.transitive with xCongruent, reverse
      have same := agree with x, xInteger, w, wInteger, xCoprime, wCoprime,
        between
      rw [yValue, zValue, same]
    . exfalso
      exact zOther.left with yUnit.left
  . cases zBranches with zUnit | zOther
    . exfalso
      exact yOther.left with zUnit.left
    . rw [yOther.right, zOther.right]

theorem liftedCharacter.unit_of_agree (N : Nat) (χ : Set) (M : Nat) (a x : Set)
  requires character : DirichletCharacter(N, χ)
  requires positive : 0 < N
  requires agree : ∀ x ∈ ℤ, ∀ y ∈ ℤ, IntegerCoprime(x, integerOfNat(N)) →
    IntegerCoprime(y, integerOfNat(N)) → IntegerCongruent(integerOfNat(M), x, y)
    → χ(x) = χ(y)
  requires aInteger : a ∈ ℤ
  requires coprime : IntegerCoprime(a, integerOfNat(M))
  requires xInteger : x ∈ ℤ
  requires congruent : IntegerCongruent(integerOfNat(M), x, a)
  requires xCoprime : IntegerCoprime(x, integerOfNat(N))
  shows liftedCharacter(N, M, χ)(a) = χ(x)
proof
  have value := DirichletCharacter.value with character, xInteger
  have member : (a, χ(x)) ∈ liftedCharacter(N, M, χ)
    unfold liftedCharacter
    have pair := product.pair with aInteger, value
    refine ⟨pair, a, aInteger, ?_⟩
    left
    exact ⟨coprime, x, xInteger, congruent, xCoprime, rfl⟩
  have functional := liftedCharacter.functional_of_agree with character,
    positive,
    agree
  exact graph.apply with (liftedCharacter.bounded at N, M, χ), functional,
    member

theorem liftedCharacter.other_of_agree (N : Nat) (χ : Set) (M : Nat) (a : Set)
  requires character : DirichletCharacter(N, χ)
  requires positive : 0 < N
  requires agree : ∀ x ∈ ℤ, ∀ y ∈ ℤ, IntegerCoprime(x, integerOfNat(N)) →
    IntegerCoprime(y, integerOfNat(N)) → IntegerCongruent(integerOfNat(M), x, y)
    → χ(x) = χ(y)
  requires aInteger : a ∈ ℤ
  requires notCoprime : ¬IntegerCoprime(a, integerOfNat(M))
  shows liftedCharacter(N, M, χ)(a) =
    complexZero
proof
  have member : (a, complexZero) ∈ liftedCharacter(N, M, χ)
    unfold liftedCharacter
    have pair := product.pair with aInteger, complexZero.member
    refine ⟨pair, a, aInteger, ?_⟩
    right
    exact ⟨notCoprime, rfl⟩
  have functional := liftedCharacter.functional_of_agree with character,
    positive,
    agree
  exact graph.apply with (liftedCharacter.bounded at N, M, χ), functional,
    member

-- If χ agrees on units congruent modulo a divisor M of N, it factors
-- through M.
theorem FactorsThrough.of_agree (N : Nat) (χ : Set) (M : Nat)
  requires character : DirichletCharacter(N, χ)
  requires positive : 0 < N
  requires agree : ∀ x ∈ ℤ, ∀ y ∈ ℤ, IntegerCoprime(x, integerOfNat(N)) →
    IntegerCoprime(y, integerOfNat(N)) → IntegerCongruent(integerOfNat(M), x, y)
    → χ(x) = χ(y)
  requires levelDivides : M ∣ N
  shows FactorsThrough(N, χ, M)
proof
  have functional := liftedCharacter.functional_of_agree with character,
    positive,
    agree
  have modulus : integerOfNat(N) ∈ ℤ by typecheck
  have level : integerOfNat(M) ∈ ℤ by typecheck
  have levelIntegerDivides := IntegerDivides.of_natural with levelDivides
  have function : liftedCharacter(N, M, χ) : ℤ → complexCarrier
    refine ⟨(liftedCharacter.bounded at N, M, χ), functional, ?_⟩
    intros a aInteger
    by_cases coprime : IntegerCoprime(a, integerOfNat(M))
    . obtain ⟨x, xMember, congruent, xCoprime⟩ := IntegerCoprime.lift
        at M, N, a with aInteger, coprime, positive
      have xInteger : x ∈ ℤ by exact xMember
      have value := DirichletCharacter.value with character, xInteger
      refine ⟨χ(x), value, ?_⟩
      unfold relates
      unfold liftedCharacter
      have pair := product.pair with aInteger, value
      refine ⟨pair, a, aInteger, ?_⟩
      left
      exact ⟨coprime, x, xInteger, congruent, xCoprime, rfl⟩
    . refine ⟨complexZero, complexZero.member, ?_⟩
      unfold relates
      unfold liftedCharacter
      have pair := product.pair with aInteger, complexZero.member
      refine ⟨pair, a, aInteger, ?_⟩
      right
      exact ⟨coprime, rfl⟩
  have lowered : DirichletCharacter(M, liftedCharacter(N, M, χ))
    refine ⟨function, ?_, ?_, ?_, ?_⟩
    . intros a aInteger
      have shifted : integerAddValue(a, integerOfNat(M)) ∈ ℤ
        by typecheck
      have congruent : IntegerCongruent(integerOfNat(M),
          integerAddValue(a, integerOfNat(M)), a)
        witness integerOne
        ring
      have reverse := IntegerCongruent.symmetric with congruent
      by_cases coprime : IntegerCoprime(a, integerOfNat(M))
      . obtain ⟨x, xMember, xCongruent, xCoprime⟩ := IntegerCoprime.lift
          at M, N, a with aInteger, coprime, positive
        have xInteger : x ∈ ℤ by exact xMember
        have shiftedCoprime := IntegerCoprime.of_congruent with aInteger,
          shifted, level, reverse, coprime
        have shiftedCongruent := IntegerCongruent.transitive with xCongruent,
          reverse
        have left := liftedCharacter.unit_of_agree with character, positive,
          agree, shifted, shiftedCoprime, xInteger, shiftedCongruent, xCoprime
        have right := liftedCharacter.unit_of_agree with character, positive,
          agree, aInteger, coprime, xInteger, xCongruent, xCoprime
        rw [left, right]
      . have shiftedOther : ¬IntegerCoprime(integerAddValue(a,
            integerOfNat(M)), integerOfNat(M))
          intro shiftedCoprime
          have back := IntegerCoprime.of_congruent with shifted, aInteger,
            level, congruent, shiftedCoprime
          exact coprime with back
        have left := liftedCharacter.other_of_agree with character, positive,
          agree, shifted, shiftedOther
        have right := liftedCharacter.other_of_agree with character, positive,
          agree, aInteger, coprime
        rw [left, right]
    . have one : integerOne ∈ ℤ by typecheck
      have levelCoprime := IntegerCoprime.one_left with level
      have unitCoprime := IntegerCoprime.one_left with modulus
      have reflexive := IntegerCongruent.reflexive
        at integerOfNat(M), integerOne
      have value := liftedCharacter.unit_of_agree with character, positive,
        agree,
        one, levelCoprime, one, reflexive, unitCoprime
      rw [value, DirichletCharacter.one with character]
    . intros a aInteger b bInteger
      have product : integerMulValue(a, b) ∈ ℤ by typecheck
      have aValue := FunctionBetween.apply_closed with function, aInteger
      have bValue := FunctionBetween.apply_closed with function, bInteger
      by_cases aCoprime : IntegerCoprime(a, integerOfNat(M))
      . by_cases bCoprime : IntegerCoprime(b, integerOfNat(M))
        . obtain ⟨x, xMember, xCongruent, xCoprime⟩ := IntegerCoprime.lift
            at M, N, a with aInteger, aCoprime, positive
          obtain ⟨y, yMember, yCongruent, yCoprime⟩ := IntegerCoprime.lift
            at M, N, b with bInteger, bCoprime, positive
          have xInteger : x ∈ ℤ by exact xMember
          have yInteger : y ∈ ℤ by exact yMember
          have both := IntegerCoprime.mul with aInteger, bInteger, level,
            aCoprime, bCoprime
          have xyInteger : integerMulValue(x, y) ∈ ℤ by typecheck
          have xyCoprime := IntegerCoprime.mul with xInteger, yInteger,
            modulus, xCoprime, yCoprime
          have xyCongruent := IntegerCongruent.mul with xCongruent, yCongruent
          have productValue := liftedCharacter.unit_of_agree with character,
            positive,
            agree, product, both, xyInteger, xyCongruent, xyCoprime
          have aLifted := liftedCharacter.unit_of_agree with character,
            positive, agree, aInteger, aCoprime, xInteger, xCongruent, xCoprime
          have bLifted := liftedCharacter.unit_of_agree with character,
            positive, agree, bInteger, bCoprime, yInteger, yCongruent, yCoprime
          have multiplicative := DirichletCharacter.mul with character,
            xInteger, yInteger
          rw [productValue, aLifted, bLifted, multiplicative]
        . have notBoth : ¬IntegerCoprime(integerMulValue(a, b),
              integerOfNat(M))
            intro both
            have right := IntegerCoprime.of_mul_right with aInteger, bInteger,
              level, both
            exact bCoprime with right
          have productValue := liftedCharacter.other_of_agree with character,
            positive,
            agree, product, notBoth
          have bZero := liftedCharacter.other_of_agree with character, positive,
            agree, bInteger, bCoprime
          have absorb := complexMul.zero_right with aValue
          rw [productValue, bZero, absorb]
      . have notBoth : ¬IntegerCoprime(integerMulValue(a, b),
            integerOfNat(M))
          intro both
          have left := IntegerCoprime.of_mul_left with aInteger, bInteger,
            level, both
          exact aCoprime with left
        have productValue := liftedCharacter.other_of_agree with character,
          positive,
          agree, product, notBoth
        have aZero := liftedCharacter.other_of_agree with character, positive,
          agree, aInteger, aCoprime
        have absorb := complexMul.zero_left with bValue
        rw [productValue, aZero, absorb]
    . intros a aInteger notCoprime
      exact liftedCharacter.other_of_agree with character, positive, agree,
        aInteger, notCoprime
  refine ⟨levelDivides, liftedCharacter(N, M, χ), lowered, ?_⟩
  intros a aInteger coprime
  have levelCoprime := IntegerCoprime.of_divides with aInteger, modulus,
    level, levelIntegerDivides, coprime
  have reflexive := IntegerCongruent.reflexive at integerOfNat(M), a
  have value := liftedCharacter.unit_of_agree with character, positive, agree,
    aInteger, levelCoprime, aInteger, reflexive, coprime
  rw value

-- A unit modulo N has a residue t < N coprime to N with the same value.
theorem DirichletCharacter.unit_residue (N : Nat) (χ x : Set)
  requires character : DirichletCharacter(N, χ)
  requires positive : 0 < N
  requires integer : x ∈ ℤ
  requires coprime : IntegerCoprime(x, integerOfNat(N))
  shows ∃ t ∈ ℕ, gcd(t, N) = (1:N) ∧
    IntegerCongruent(integerOfNat(N), x, integerOfNat(t)) ∧
    χ(x) = χ(integerOfNat(t))
proof
  have tNat := integerMod.natural at x, N with positive
  have residue := DirichletCharacter.residue with character, integer,
    positive
  have congruent := integerMod.congruent at x, N with positive
  have modulus : integerOfNat(N) ∈ ℤ by typecheck
  have tInteger : integerOfNat(integerMod(x, N)) ∈ ℤ by typecheck
  have tCoprime := IntegerCoprime.of_congruent with integer, tInteger,
    modulus, congruent, coprime
  unfold IntegerCoprime at tCoprime
  rw integerGCD.ofNat at tCoprime
  have tMember : integerMod(x, N) ∈ ℕ by typecheck
  exact ⟨integerMod(x, N), tMember, tCoprime, congruent, residue⟩

-- G(a l) = G(b l) when a ≡ b modulo M, N = g M and g ∣ l.
theorem gaussTwist.congruent_level (N g M : Nat) (χ : Set, a b l : Nat)
  requires values : FunctionBetween(χ, ℤ, complexCarrier)
  requires positive : 0 < N
  requires level : g * M = N
  requires dividing : g ∣ l
  requires congruent : IntegerCongruent(integerOfNat(M), integerOfNat(a),
    integerOfNat(b))
  shows complexPartialSum(gaussTwist(N, χ, a * l), N) =
    complexPartialSum(gaussTwist(N, χ, b * l), N)
proof
  obtain ⟨r, rNat, shapeL⟩ := dividing
  obtain ⟨q, qInteger, multiple⟩ := congruent
  have same := realInt.mul at integerOfNat(M), q
  rw [multiple, realInt.sub, realInt.nat, realInt.nat, realInt.nat] at same
  have levelReal : realNat(N) = R[realNat(g) * realNat(M)]
    rw [← level, realNat.mul]
  have lReal : realNat(l) = R[realNat(g) * realNat(r)]
    rw [← shapeL, realNat.mul]
  have nonzero : N ≠ (0:N) by arith
  have nonzeroReal := realNat.ne_zero with nonzero
  have inverse := realInvValue.mul_right with nonzeroReal
  have termwise : ∀ j ∈ ℕ, j < N →
      gaussTwist(N, χ, a * l)(j) = gaussTwist(N, χ, b * l)(j)
    intros j jMember below
    have jNat := nat.omega.backward at j with jMember
    have shift : R[realNat(j * (a * l)) * realInvValue(realNat(N))] =
        R[realNat(j * (b * l)) * realInvValue(realNat(N)) +
          realInt(integerOfNat(j * r)) * realInt(q)]
      rw [realInt.nat, realNat.mul, realNat.mul, realNat.mul, realNat.mul,
        realNat.mul]
      linear_combination (realNat(j) * realNat(l) *
          realInvValue(realNat(N))) * same +
        (realNat(j) * realInvValue(realNat(N)) * realNat(M) * realInt(q)) *
          lReal -
        (realNat(j) * realNat(r) * realInt(q) * realInvValue(realNat(N))) *
          levelReal +
        (realNat(j) * realNat(r) * realInt(q)) * inverse
    have phase := expTwoPiI.member at
      R[realNat(j * (b * l)) * realInvValue(realNat(N))]
    have index : integerOfNat(j) ∈ ℤ by typecheck
    have value := FunctionBetween.apply_closed with values, index
    rw [(gaussTwist.value at N, χ, a * l, j with values, jMember),
      (gaussTwist.value at N, χ, b * l, j with values, jMember), shift,
      expTwoPiI.add, ← realInt.mul, expTwoPiI.integer]
    ring
  have congr := complexPartialSum.congr at gaussTwist(N, χ, a * l),
    gaussTwist(N, χ, b * l), N
  exact congr with termwise

-- For χ primitive modulo N and gcd(l, N) > 1, G(l) = 0: χ takes different
-- values at two units x ≡ y modulo N / gcd(l, N), and G(l) is both
-- χ(x) G(x l) and χ(y) G(y l), with G(x l) = G(y l).
theorem gaussTwist.vanishing (N : Nat) (χ : Set, l : Nat)
  requires character : DirichletCharacter(N, χ)
  requires positive : 0 < N
  requires primitive : PrimitiveCharacter(N, χ)
  requires notCoprime : gcd(l, N) ≠ (1:N)
  shows complexPartialSum(gaussTwist(N, χ, l), N) = ℂ[0]
proof
  have values := DirichletCharacter.function with character
  have gDividesN := gcd.divides_right at l, N
  have gDividesL := gcd.divides_left at l, N
  obtain ⟨M, MNat, level⟩ := gDividesN
  have MDividesN : M ∣ N
    witness gcd(l, N)
    rw ← level
    arith
  have MNonzero : M ≠ (0:N)
    intro zero
    rw zero at level
    arith
  have gNonzero : gcd(l, N) ≠ (0:N)
    intro zero
    rw zero at level
    arith
  have gLarge : (1:N) < gcd(l, N) by arith
  have scaled := Less.mul_right at (1:N), gcd(l, N), M with MNonzero, gLarge
  have MLess : M < N by arith
  -- χ does not factor through M.
  have notFactor : ¬FactorsThrough(N, χ, M)
    intro factors
    have least := conductor.least with character, factors
    unfold PrimitiveCharacter at primitive
    rw primitive at least
    arith
  have exists : ∃ x ∈ ℤ, ∃ y ∈ ℤ, IntegerCoprime(x, integerOfNat(N)) ∧
      IntegerCoprime(y, integerOfNat(N)) ∧
      IntegerCongruent(integerOfNat(M), x, y) ∧ χ(x) ≠ χ(y)
    by_contra none
    apply notFactor
    have agree : ∀ x ∈ ℤ, ∀ y ∈ ℤ, IntegerCoprime(x, integerOfNat(N)) →
        IntegerCoprime(y, integerOfNat(N)) →
        IntegerCongruent(integerOfNat(M), x, y) → χ(x) = χ(y)
      intros x xInteger y yInteger xCoprime yCoprime congruent
      by_contra different
      apply none
      exact ⟨x, xInteger, y, yInteger, xCoprime, yCoprime, congruent,
        different⟩
    exact FactorsThrough.of_agree with character, positive, agree, MDividesN
  obtain ⟨x, xInteger, y, yInteger, xCoprime, yCoprime, congruent,
    different⟩ := exists
  obtain ⟨tx, txMember, txCoprime, txCongruent, txValue⟩ :=
    DirichletCharacter.unit_residue with character, positive, xInteger,
    xCoprime
  obtain ⟨ty, tyMember, tyCoprime, tyCongruent, tyValue⟩ :=
    DirichletCharacter.unit_residue with character, positive, yInteger,
    yCoprime
  have txNat := nat.omega.backward at tx with txMember
  have tyNat := nat.omega.backward at ty with tyMember
  -- tx ≡ ty modulo M.
  have levelDivides := IntegerDivides.of_natural with MDividesN
  have xM := IntegerCongruent.divides_modulus with levelDivides, txCongruent
  have yM := IntegerCongruent.divides_modulus with levelDivides, tyCongruent
  have xBack := IntegerCongruent.symmetric with xM
  have toY := IntegerCongruent.transitive with xBack, congruent
  have residues := IntegerCongruent.transitive with toY, yM
  have sameH := gaussTwist.congruent_level with values, positive, level,
    gDividesL, residues
  have scaleX := gaussTwist.scale at N, tx, χ, l with character, positive,
    txCoprime
  have scaleY := gaussTwist.scale at N, ty, χ, l with character, positive,
    tyCoprime
  rw [sameH, ← txValue] at scaleX
  rw ← tyValue at scaleY
  have xValue := DirichletCharacter.value with character, xInteger
  have yValue := DirichletCharacter.value with character, yInteger
  have terms := gaussTwist.function at N, χ, ty * l with values
  have sequence : ComplexSequence(gaussTwist(N, χ, ty * l)) by exact terms
  have H := complexPartialSum.member at gaussTwist(N, χ, ty * l), N with
    sequence
  have gap : ℂ[χ(x) - χ(y)] ∈ ℂ by typecheck
  have nonzero : ℂ[χ(x) - χ(y)] ≠ ℂ[0]
    intro vanish
    apply different
    linear_combination vanish
  have difference : ℂ[(χ(x) - χ(y)) *
      complexPartialSum(gaussTwist(N, χ, ty * l), N)] = ℂ[0]
    linear_combination scaleX - scaleY
  have zero := complexMul.zero_factor with gap, H, nonzero, difference
  rw [← scaleY, zero]
  ring

theorem gaussSum.member (N : Nat) (χ : Set)
  requires values : FunctionBetween(χ, ℤ, complexCarrier)
  shows gaussSum(N, χ) ∈ ℂ
proof
  have terms := gaussTerms.function at N, χ with values
  have sequence : ComplexSequence(gaussTerms(N, χ)) by exact terms
  unfold gaussSum
  exact complexPartialSum.member with sequence

-- τ(χ) = G(1).
theorem gaussSum.twist_one (N : Nat) (χ : Set)
  requires values : FunctionBetween(χ, ℤ, complexCarrier)
  shows gaussSum(N, χ) = complexPartialSum(gaussTwist(N, χ, 1), N)
proof
  have termwise : ∀ j ∈ ℕ, j < N → gaussTerms(N, χ)(j) =
      gaussTwist(N, χ, 1)(j)
    intros j jMember below
    have jNat := nat.omega.backward at j with jMember
    have unit : j * 1 = j by arith
    rw [(gaussTerms.value at N, χ, j with values, jMember),
      (gaussTwist.value at N, χ, 1, j with values, jMember), unit,
      realDiv.eq_mul_inv]
  have congr := complexPartialSum.congr at gaussTerms(N, χ),
    gaussTwist(N, χ, 1), N
  unfold gaussSum
  exact congr with termwise

-- For χ primitive, G(l) = χ̄(l) τ(χ) for every l.
theorem gaussTwist.conj_gauss (N : Nat) (χ : Set, l : Nat)
  requires character : DirichletCharacter(N, χ)
  requires positive : 0 < N
  requires primitive : PrimitiveCharacter(N, χ)
  shows complexPartialSum(gaussTwist(N, χ, l), N) =
    ℂ[complexConj(χ(integerOfNat(l))) * gaussSum(N, χ)]
proof
  have values := DirichletCharacter.function with character
  have index : integerOfNat(l) ∈ ℤ by typecheck
  have value := DirichletCharacter.value with character, index
  have gaussOne := gaussSum.twist_one at N, χ with values
  have tau := gaussSum.member at N, χ with values
  by_cases coprime : gcd(l, N) = (1:N)
  . have scale := gaussTwist.scale at N, l, χ, (1:N) with character,
      positive, coprime
    have unit : l * 1 = l by arith
    rw [unit, ← gaussOne] at scale
    have integerCoprime : IntegerCoprime(integerOfNat(l), integerOfNat(N))
      unfold IntegerCoprime
      rw integerGCD.ofNat
      exact coprime
    have norm := DirichletCharacter.norm_coprime with character, positive,
      index, integerCoprime
    have square := GRH.Exp.complexConj.mul_self with value
    rw [norm, complexOfReal.one] at square
    have conjugate := complexConj.member with value
    have terms := gaussTwist.function at N, χ, l with values
    have sequence : ComplexSequence(gaussTwist(N, χ, l)) by exact terms
    have G := complexPartialSum.member at gaussTwist(N, χ, l), N with sequence
    rw ← scale
    linear_combination (-complexPartialSum(gaussTwist(N, χ, l), N)) * square
  . have zero := gaussTwist.vanishing with character, positive, primitive,
      coprime
    have notCoprime : ¬IntegerCoprime(integerOfNat(l), integerOfNat(N))
      intro integerCoprime
      unfold IntegerCoprime at integerCoprime
      rw integerGCD.ofNat at integerCoprime
      exact coprime with integerCoprime
    have vanishing := DirichletCharacter.not_coprime with character, index,
      notCoprime
    rw [zero, vanishing, GRH.Exp.complexConj.zero]
    ring

-- The terms χ̄(l) e(−l/N) of the conjugate of τ(χ).
defgraph conjGaussTerms (N : Nat, χ : Set) (l ∈ ℕ) : complexCarrier :=
  ℂ[complexConj(χ(integerOfNat(l))) *
    expTwoPiI(R[-(realNat(l) * realInvValue(realNat(N)))])]
requires values : FunctionBetween(χ, ℤ, complexCarrier)
proof
  have lNat := nat.omega.backward at l with member
  have index : integerOfNat(l) ∈ ℤ by typecheck
  have value := FunctionBetween.apply_closed with values, index
  have conjugate := complexConj.member with value
  have phase := expTwoPiI.member at
    R[-(realNat(l) * realInvValue(realNat(N)))]
  typecheck

-- The grid e(−l/N) χ(j) e(jl/N) whose total is τ(χ) times its conjugate.
defgraph gaussGrid (N : Nat, χ : Set) (p ∈ ℕ × ℕ) : complexCarrier :=
  ℂ[expTwoPiI(R[-(realNat(snd(p)) * realInvValue(realNat(N)))]) *
    (χ(integerOfNat(fst(p))) * expTwoPiI(R[realNat(fst(p)) *
      realNat(snd(p)) * realInvValue(realNat(N))]))]
requires values : FunctionBetween(χ, ℤ, complexCarrier)
proof
  obtain ⟨_, u, uMember, v, vMember, shape⟩ := product.membership.forward
    with member
  rw [shape, fst.pair, snd.pair]
  have uNat := nat.omega.backward at u with uMember
  have vNat := nat.omega.backward at v with vMember
  have index : integerOfNat(u) ∈ ℤ by typecheck
  have value := FunctionBetween.apply_closed with values, index
  have first := expTwoPiI.member at
    R[-(realNat(v) * realInvValue(realNat(N)))]
  have second := expTwoPiI.member at
    R[realNat(u) * realNat(v) * realInvValue(realNat(N))]
  typecheck

-- e(N x) = 1 for x = (j − 1)/N.
theorem expTwoPiI.shifted_period (N j : Nat)
  requires positive : 0 < N
  shows expTwoPiI(R[realNat(N) * ((realNat(j) - 1) *
    realInvValue(realNat(N)))]) = ℂ[1]
proof
  have nonzero : N ≠ (0:N) by arith
  have nonzeroReal := realNat.ne_zero with nonzero
  have inverse := realInvValue.mul_right with nonzeroReal
  have minusOne := realInt.neg at integerOne
  rw realInt.one at minusOne
  have shape : R[realNat(N) * ((realNat(j) - 1) *
      realInvValue(realNat(N)))] =
      R[realNat(j) + realInt(integerNegValue(integerOne))]
    linear_combination (realNat(j) - 1) * inverse - minusOne
  rw [shape, expTwoPiI.add, expTwoPiI.nat, expTwoPiI.integer]
  ring

-- e((j − 1)/N) ≠ 1 for j < N, j ≠ 1.
theorem expTwoPiI.shifted_nontrivial (N j : Nat)
  requires two : 2 ≤ N
  requires below : j < N
  requires other : j ≠ (1:N)
  shows expTwoPiI(R[(realNat(j) - 1) * realInvValue(realNat(N))]) ≠ ℂ[1]
proof
  have nonzero : N ≠ (0:N) by arith
  have nonzeroReal := realNat.ne_zero with nonzero
  have inverse := realInvValue.mul_right with nonzeroReal
  have positiveN : (0:N) < N by arith
  have positiveReal := realNat.positive with nonzero
  have inversePositive := realInvValue.positive with positiveReal
  by_cases zero : j = (0:N)
  . rw [zero, realNat.zero]
    have minusOne := realInt.neg at integerOne
    rw realInt.one at minusOne
    have oneLess : (1:N) < N by arith
    have oneLessReal := realNat.lt_of_lt at 1, N with oneLess
    rw realNat.one at oneLessReal
    have scaled := realLess.mul_right_of_positive with oneLessReal,
      inversePositive
    have unit : R[1 * realInvValue(realNat(N))] = realInvValue(realNat(N))
      by ring
    have negated : R[(0 - 1) * realInvValue(realNat(N))] =
      R[-realInvValue(realNat(N))] by ring
    have lower : realInt(integerNegValue(integerOne)) <
        R[(0 - 1) * realInvValue(realNat(N))]
      rw minusOne
      linarith
    have upper : R[(0 - 1) * realInvValue(realNat(N))] <
        R[realInt(integerNegValue(integerOne)) + 1]
      rw minusOne
      linarith
    exact expTwoPiI.ne_one with lower, upper
  . have large : 2 ≤ j by arith
    have largeReal := realNat.le_of_natural_le at 2, j with large
    rw realNat.two at largeReal
    have belowReal := realNat.lt_of_lt at j, N with below
    have gapPositive : R[0] < R[realNat(j) - 1] by linarith
    have gapBelow : R[realNat(j) - 1] < realNat(N) by linarith
    have productPositive := realMulValue.positive with gapPositive,
      inversePositive
    have scaled := realLess.mul_right_of_positive with gapBelow,
      inversePositive
    have lower : realInt(integerZero) <
        R[(realNat(j) - 1) * realInvValue(realNat(N))]
      rw realInt.zero
      linarith
    have upper : R[(realNat(j) - 1) * realInvValue(realNat(N))] <
        R[realInt(integerZero) + 1]
      rw realInt.zero
      linarith
    exact expTwoPiI.ne_one with lower, upper

-- τ(χ) times its conjugate is N, for χ primitive modulo N ≥ 2: expand
-- τ · Σ_l χ̄(l) e(−l/N) = Σ_l G(l) e(−l/N) as a double sum and sum over l
-- first.
theorem gaussSum.mul_conj_large (N : Nat) (χ : Set)
  requires two : 2 ≤ N
  requires character : DirichletCharacter(N, χ)
  requires primitive : PrimitiveCharacter(N, χ)
  shows ℂ[gaussSum(N, χ) * complexConj(gaussSum(N, χ))] =
    complexOfReal(realNat(N))
proof
  have positive : 0 < N by arith
  have values := DirichletCharacter.function with character
  have tau := gaussSum.member at N, χ with values
  -- The conjugate of τ(χ).
  have gaussFunction := gaussTerms.function at N, χ with values
  have gaussSequence : ComplexSequence(gaussTerms(N, χ)) by
    exact gaussFunction
  have conjFunction := conjGaussTerms.function at N, χ with values
  have conjSequence : ComplexSequence(conjGaussTerms(N, χ)) by
    exact conjFunction
  have conjugates : ∀ k ∈ ℕ,
      conjGaussTerms(N, χ)(k) = complexConj(gaussTerms(N, χ)(k))
    intros k kMember
    have kNat := nat.omega.backward at k with kMember
    have index : integerOfNat(k) ∈ ℤ by typecheck
    have value := FunctionBetween.apply_closed with values, index
    have phase := expTwoPiI.member at
      R[realNat(k) * realInvValue(realNat(N))]
    rw [(conjGaussTerms.value at N, χ, k with values, kMember),
      (gaussTerms.value at N, χ, k with values, kMember),
      realDiv.eq_mul_inv, (complexConj.mul with value, phase),
      expTwoPiI.conj]
  have conjSum := complexPartialSum.conj_terms with gaussSequence,
    conjugates
  -- Rows: Σ_j e(−l/N) χ(j) e(jl/N) = e(−l/N) G(l) = τ χ̄(l) e(−l/N).
  have grid := gaussGrid.function at N, χ with values
  have rows : ∀ l ∈ ℕ, l < N → gridRowSums(gaussGrid(N, χ), N)(l) =
      ℂ[gaussSum(N, χ) * conjGaussTerms(N, χ)(l)]
    intros l lMember below
    have lNat := nat.omega.backward at l with lMember
    have phase := expTwoPiI.member at
      R[-(realNat(l) * realInvValue(realNat(N)))]
    have twistFunction := gaussTwist.function at N, χ, l with values
    have twistSequence : ComplexSequence(gaussTwist(N, χ, l)) by
      exact twistFunction
    have rowTerms : ∀ j ∈ ℕ, j < N → gridRow(gaussGrid(N, χ), l)(j) =
        ℂ[expTwoPiI(R[-(realNat(l) * realInvValue(realNat(N)))]) *
          gaussTwist(N, χ, l)(j)]
      intros j jMember jBelow
      have jNat := nat.omega.backward at j with jMember
      have pair := product.pair with jMember, lMember
      rw [(gridRow.value at gaussGrid(N, χ), l, j with grid, jMember),
        (gaussGrid.value at N, χ, (j, l) with values, pair), fst.pair,
        snd.pair, (gaussTwist.value at N, χ, l, j with values, jMember),
        realNat.mul]
    have scale := complexPartialSum.scale_terms at
      expTwoPiI(R[-(realNat(l) * realInvValue(realNat(N)))]),
      gaussTwist(N, χ, l), gridRow(gaussGrid(N, χ), l), N with phase,
      twistSequence
    have rowSum := scale with rowTerms
    have conjG := gaussTwist.conj_gauss at N, χ, l with character, positive,
      primitive
    have index : integerOfNat(l) ∈ ℤ by typecheck
    have value := FunctionBetween.apply_closed with values, index
    have conjugate := complexConj.member with value
    rw [(gridRowSums.value at gaussGrid(N, χ), N, l with grid, lMember),
      rowSum, conjG, (conjGaussTerms.value at N, χ, l with values, lMember)]
    ring
  have scaleRows := complexPartialSum.scale_terms at gaussSum(N, χ),
    conjGaussTerms(N, χ), gridRowSums(gaussGrid(N, χ), N), N with tau,
    conjSequence
  have total := scaleRows with rows
  -- Columns: Σ_l e(−l/N) χ(j) e(jl/N) = χ(j) Σ_l e(l (j − 1)/N).
  have columns : ∀ j ∈ ℕ, j < N →
      gridColumnSums(gaussGrid(N, χ), N)(j) = ℂ[χ(integerOfNat(j)) *
        complexPartialSum(additiveTerms(R[(realNat(j) - 1) *
          realInvValue(realNat(N))]), N)]
    intros j jMember below
    have jNat := nat.omega.backward at j with jMember
    have index : integerOfNat(j) ∈ ℤ by typecheck
    have value := FunctionBetween.apply_closed with values, index
    have additiveFunction := additiveTerms.function at
      R[(realNat(j) - 1) * realInvValue(realNat(N))]
    have additiveSequence : ComplexSequence(additiveTerms(R[(realNat(j) - 1)
      * realInvValue(realNat(N))])) by exact additiveFunction
    have columnTerms : ∀ l ∈ ℕ, l < N →
        gridColumn(gaussGrid(N, χ), j)(l) = ℂ[χ(integerOfNat(j)) *
          additiveTerms(R[(realNat(j) - 1) * realInvValue(realNat(N))])(l)]
      intros l lMember lBelow
      have lNat := nat.omega.backward at l with lMember
      have pair := product.pair with jMember, lMember
      have combine : R[-(realNat(l) * realInvValue(realNat(N))) +
          realNat(j) * realNat(l) * realInvValue(realNat(N))] =
          R[realNat(l) * ((realNat(j) - 1) * realInvValue(realNat(N)))]
        by ring
      have sum := expTwoPiI.add at
        R[-(realNat(l) * realInvValue(realNat(N)))],
        R[realNat(j) * realNat(l) * realInvValue(realNat(N))]
      rw combine at sum
      have first := expTwoPiI.member at
        R[-(realNat(l) * realInvValue(realNat(N)))]
      have second := expTwoPiI.member at
        R[realNat(j) * realNat(l) * realInvValue(realNat(N))]
      rw [(gridColumn.value at gaussGrid(N, χ), j, l with grid, lMember),
        (gaussGrid.value at N, χ, (j, l) with values, pair), fst.pair,
        snd.pair, (additiveTerms.value at R[(realNat(j) - 1) *
          realInvValue(realNat(N))], l with lMember), sum]
      ring
    have scale := complexPartialSum.scale_terms at χ(integerOfNat(j)),
      additiveTerms(R[(realNat(j) - 1) * realInvValue(realNat(N))]),
      gridColumn(gaussGrid(N, χ), j), N with value, additiveSequence
    have columnSum := scale with columnTerms
    rw [(gridColumnSums.value at gaussGrid(N, χ), N, j with grid, jMember),
      columnSum]
  -- The column sums vanish except at j = 1, where it is N.
  have vanishing : ∀ j ∈ ℕ, j < N → j ≠ (1:N) →
      gridColumnSums(gaussGrid(N, χ), N)(j) = ℂ[0]
    intros j jMember below other
    have jNat := nat.omega.backward at j with jMember
    have index : integerOfNat(j) ∈ ℤ by typecheck
    have value := FunctionBetween.apply_closed with values, index
    have nontrivial := expTwoPiI.shifted_nontrivial with two, below, other
    have period := expTwoPiI.shifted_period at N, j with positive
    have orthogonal := additiveTerms.sum_zero with nontrivial, period
    rw [(columns with j, jMember, below), orthogonal]
    ring
  have columnFunction := gridColumnSums.function at gaussGrid(N, χ), N with
    grid
  have columnSequence : ComplexSequence(gridColumnSums(gaussGrid(N, χ), N))
    by exact columnFunction
  have only := complexPartialSum.only_one with columnSequence, two,
    vanishing
  have oneMember : (1:N) ∈ ℕ by typecheck
  have oneBelow : (1:N) < N by arith
  have oneColumn := columns with (1:N), oneMember, oneBelow
  have trivialShift : R[(realNat(1) - 1) * realInvValue(realNat(N))] = R[0]
    rw realNat.one
    ring
  rw [trivialShift, additiveTerms.sum_trivial, integerOfNat.one,
    (DirichletCharacter.one with character)] at oneColumn
  have swap := gridRowSums.swap at gaussGrid(N, χ), N, N with grid
  have conjTau : complexConj(gaussSum(N, χ)) =
      complexPartialSum(conjGaussTerms(N, χ), N)
    unfold gaussSum
    exact conjSum
  rw [conjTau, ← total, swap, only, oneColumn]
  ring

theorem realOne.pow (n : Nat)
  shows R[1 ^ n] = R[1]
proof
  induction n
  | zero =>
    ring
  | succ(k) using ih =>
    rw [monoidPow.succ, ih]
    ring

-- For N = 1, τ(χ) = χ(0) = 1.
theorem gaussSum.mul_conj_one (χ : Set)
  requires character : DirichletCharacter(1, χ)
  shows ℂ[gaussSum(1, χ) * complexConj(gaussSum(1, χ))] =
    complexOfReal(realNat(1))
proof
  have values := DirichletCharacter.function with character
  have zeroMember : (0:N) ∈ ℕ by typecheck
  have zeroInteger : integerOfNat(0) ∈ ℤ by typecheck
  have periodic := DirichletCharacter.periodic with character, zeroInteger
  have shift : integerAddValue(integerOfNat(0), integerOfNat(1)) = integerOne
    have sum : (0:N) + (1:N) = (1:N) by arith
    rw [← integerOfNat.add, sum, integerOfNat.one]
  rw [shift, (DirichletCharacter.one with character)] at periodic
  have phase : R[realNat(0) / realNat(1)] = R[0]
    rw [realNat.zero, realDiv.eq_mul_inv]
    ring
  have tauOne : gaussSum(1, χ) = ℂ[1]
    unfold gaussSum
    rw [complexPartialSum.succ, complexPartialSum.zero,
      (gaussTerms.value at 1, χ, 0 with values, zeroMember), phase,
      expTwoPiI.zero, ← periodic]
    ring
  rw [tauOne, complexConj.one, realNat.one, complexOfReal.one]
  ring

-- Section: Dirichlet L-functions
-- |τ(χ)|² = N for χ primitive modulo N.
theorem gaussSum.abs_square (N : Nat) (χ : Set)
  requires positive : 1 ≤ N
  requires character : DirichletCharacter(N, χ)
  requires primitive : PrimitiveCharacter(N, χ)
  shows R[complexAbs(gaussSum(N, χ)) * complexAbs(gaussSum(N, χ))] =
    realNat(N)
proof
  have values := DirichletCharacter.function with character
  have tau := gaussSum.member at N, χ with values
  have product : ℂ[gaussSum(N, χ) * complexConj(gaussSum(N, χ))] =
      complexOfReal(realNat(N))
    by_cases one : N = (1:N)
    . rw one
      rw one at character
      exact gaussSum.mul_conj_one with character
    . have two : 2 ≤ N by arith
      exact gaussSum.mul_conj_large with two, character, primitive
  have square := GRH.Exp.complexConj.mul_self with tau
  rw product at square
  have norms := complexOfReal.injective with square
  rw [(complexAbs.square with tau), norms]

-- |ε(χ)| = 1 for χ primitive.
theorem rootNumber.abs (N : Nat) (χ : Set) (κ : Nat)
  requires positive : 1 ≤ N
  requires character : DirichletCharacter(N, χ)
  requires primitive : PrimitiveCharacter(N, χ)
  requires parity : HasParity(χ, κ)
  shows complexAbs(rootNumber(N, χ, κ)) = R[1]
proof
  have values := DirichletCharacter.function with character
  have tau := gaussSum.member at N, χ with values
  have tauSquare := gaussSum.abs_square with positive, character, primitive
  have tauNonnegative := complexAbs.nonnegative with tau
  have root := realSqrt.eq_of_square with tauNonnegative, tauSquare
  have atLeast := realNat.one_le with positive
  have tauPositive : R[0] < complexAbs(gaussSum(N, χ))
    by_contra notPositive
    have zero : complexAbs(gaussSum(N, χ)) = R[0] by linarith
    rw zero at tauSquare
    have collapse : R[0 * 0] = R[0] by ring
    linarith
  have iMember := complexImaginaryUnit.member
  have iPower := complexPow.member at complexImaginaryUnit, κ with iMember
  have nonnegativeN : R[0] ≤ realNat(N) by linarith
  have sqrtReal := realSqrt.real with nonnegativeN
  have sqrtNonnegative := realSqrt.nonneg with nonnegativeN
  have sqrtMember : complexOfReal(realSqrt(realNat(N))) ∈ ℂ by typecheck
  have scale : ℂ[complexImaginaryUnit ^ κ *
      complexOfReal(realSqrt(realNat(N)))] ∈ ℂ by typecheck
  have unitPower := realOne.pow at κ
  have scaleAbs : complexAbs(ℂ[complexImaginaryUnit ^ κ *
      complexOfReal(realSqrt(realNat(N)))]) = complexAbs(gaussSum(N, χ))
    rw [(complexAbs.mul with iPower, sqrtMember),
      (complexAbs.pow with iMember), complexAbs.imaginary, unitPower,
      complexAbs.of_real, (abs.of_nonnegative with sqrtNonnegative), root]
    ring
  have scaleNonzero : ℂ[complexImaginaryUnit ^ κ *
      complexOfReal(realSqrt(realNat(N)))] ≠ ℂ[0]
    intro vanish
    rw [vanish, complexAbs.zero] at scaleAbs
    linarith
  have cancel := complexInv.mul_cancel with scale, scaleNonzero
  have inverse := complexInv.member with scale
  have rootMember : rootNumber(N, χ, κ) ∈ ℂ
    unfold rootNumber
    unfold complexDiv
    typecheck
  have product : ℂ[rootNumber(N, χ, κ) * ℂ[complexImaginaryUnit ^ κ *
      complexOfReal(realSqrt(realNat(N)))]] = gaussSum(N, χ)
    unfold rootNumber
    unfold complexDiv
    linear_combination gaussSum(N, χ) * cancel
  have absolute := complexAbs.mul with rootMember, scale
  rw [product, scaleAbs] at absolute
  have tauNonzero : complexAbs(gaussSum(N, χ)) ≠ R[0]
    intro vanish
    linarith
  have tauInverse := realInvValue.mul_right with tauNonzero
  linear_combination (-realInvValue(complexAbs(gaussSum(N, χ)))) * absolute
    + (1 - complexAbs(rootNumber(N, χ, κ))) * tauInverse

-- Section: The functional equation of Dirichlet L-functions
-- The row sums of a grid whose columns are convergent series sum to the
-- sum of the column sums.
theorem gridRowSums.sums (F S : Set) (J : Nat)
  requires grid : FunctionBetween(F, ℕ × ℕ, complexCarrier)
  requires sequence : ComplexSequence(S)
  requires columns : ∀ j ∈ ℕ, j < J → ComplexSumsTo(gridColumn(F, j), S(j))
  shows ComplexSumsTo(gridRowSums(F, J), complexPartialSum(S, J))
proof
  induction J
  | zero =>
    intro columns
    have rows := gridRowSums.function at F, 0 with grid
    have rowSequence : ComplexSequence(gridRowSums(F, 0)) by exact rows
    have later : ∀ m ∈ ℕ, gridRowSums(F, 0)(succ(m)) = ℂ[0]
      intros m mMember
      have succMember : succ(m) ∈ ℕ by typecheck
      have mNat := nat.omega.backward at m with mMember
      rw [(gridRowSums.value at F, 0, succ(m) with grid),
        complexPartialSum.zero]
    have single := ComplexSumsTo.single with rowSequence, later
    have zeroMember : (0:N) ∈ ℕ by typecheck
    rw [(gridRowSums.value at F, 0, (0:N) with grid), complexPartialSum.zero]
      at single
    rw complexPartialSum.zero
    exact single
  | succ(k) using ih =>
    intro columns
    have kMember : k ∈ ℕ by typecheck
    have restricted : ∀ j ∈ ℕ, j < k → ComplexSumsTo(gridColumn(F, j), S(j))
      intros j jMember below
      have larger : j < succ(k) by arith
      exact columns with j, jMember, larger
    have previous := ih with restricted
    have kBelow : k < succ(k) by arith
    have last := columns with k, kMember, kBelow
    have one : ℂ[1] ∈ ℂ by typecheck
    have rows := gridRowSums.function at F, succ(k) with grid
    have rowSequence : ComplexSequence(gridRowSums(F, succ(k))) by exact rows
    have terms : ∀ m ∈ ℕ, gridRowSums(F, succ(k))(m) =
        ℂ[1 * gridRowSums(F, k)(m) + 1 * gridColumn(F, k)(m)]
      intros m mMember
      have mNat := nat.omega.backward at m with mMember
      have row := gridRow.function at F, m with grid
      have rowTerms : ComplexSequence(gridRow(F, m)) by exact row
      have partial := complexPartialSum.member at gridRow(F, m), k with
        rowTerms
      have entry := FunctionBetween.apply_closed with row, kMember
      rw [(gridRowSums.value at F, succ(k), m with grid),
        (gridRowSums.value at F, k, m with grid), complexPartialSum.succ,
        (gridColumn.value at F, k, m with grid),
        ← (gridRow.value at F, m, k with grid)]
      ring
    have combined := ComplexSumsTo.linear with previous, last, one, one,
      rowSequence, terms
    have partialS := complexPartialSum.member at S, k with sequence
    have value := FunctionBetween.apply_closed with sequence, kMember
    have same : ℂ[1 * complexPartialSum(S, k) + 1 * S(k)] =
        complexPartialSum(S, succ(k))
      rw complexPartialSum.succ
      ring
    rw same at combined
    exact combined

-- The terms χ(j + 1) e((j + 1) k/N) of G(k), shifted by one.
defgraph gaussTwistShift (N : Nat, χ : Set, k : Nat) (j ∈ ℕ) : complexCarrier :=
  gaussTwist(N, χ, k)(succ(j))
requires values : FunctionBetween(χ, ℤ, complexCarrier)
proof
  have jNat := nat.omega.backward at j with member
  have succMember : succ(j) ∈ ℕ by typecheck
  have terms := gaussTwist.function at N, χ, k with values
  exact FunctionBetween.apply_closed with terms, succMember

-- Σ_{j<N} χ(j + 1) e((j + 1) k/N) = G(k).
theorem gaussTwistShift.sum (N : Nat) (χ : Set, k : Nat)
  requires character : DirichletCharacter(N, χ)
  requires positive : 0 < N
  shows complexPartialSum(gaussTwistShift(N, χ, k), N) =
    complexPartialSum(gaussTwist(N, χ, k), N)
proof
  have values := DirichletCharacter.function with character
  have terms := gaussTwist.function at N, χ, k with values
  have sequence : ComplexSequence(gaussTwist(N, χ, k)) by exact terms
  have shiftedTerms := gaussTwistShift.function at N, χ, k with values
  have shifted : ComplexSequence(gaussTwistShift(N, χ, k)) by
    exact shiftedTerms
  have split := complexPartialSum.shift_first at gaussTwist(N, χ, k),
    gaussTwistShift(N, χ, k), N with sequence, shifted
  have agree : ∀ j ∈ ℕ, j < N →
      gaussTwistShift(N, χ, k)(j) = gaussTwist(N, χ, k)(succ(j))
    intros j jMember below
    exact gaussTwistShift.value at N, χ, k, j with values, jMember
  have first := split with agree
  -- The term at N equals the term at 0.
  have zeroMember : (0:N) ∈ ℕ by typecheck
  have nMember : N ∈ ℕ by typecheck
  have zeroIndex : integerOfNat(0) ∈ ℤ by typecheck
  have periodic := DirichletCharacter.periodic with character, zeroIndex
  have zeroSum := integerOfNat.add at 0, N
  have same : 0 + N = N by arith
  rw same at zeroSum
  rw ← zeroSum at periodic
  have nonzero : N ≠ (0:N) by arith
  have nonzeroReal := realNat.ne_zero with nonzero
  have inverse := realInvValue.mul_right with nonzeroReal
  have full : R[realNat(N * k) * realInvValue(realNat(N))] = realNat(k)
    rw realNat.mul
    linear_combination realNat(k) * inverse
  have empty : R[realNat(0 * k) * realInvValue(realNat(N))] = R[0]
    have zeroProduct : 0 * k = (0:N) by arith
    rw [zeroProduct, realNat.zero]
    ring
  have lastTerm : gaussTwist(N, χ, k)(N) = gaussTwist(N, χ, k)((0:N))
    rw [(gaussTwist.value at N, χ, k, N with values, nMember),
      (gaussTwist.value at N, χ, k, (0:N) with values, zeroMember), full,
      empty, expTwoPiI.nat, expTwoPiI.zero, periodic]
  have partial := complexPartialSum.member at gaussTwist(N, χ, k), N with
    sequence
  have shiftedPartial := complexPartialSum.member at
    gaussTwistShift(N, χ, k), N with shifted
  have zeroTerm := FunctionBetween.apply_closed with terms, zeroMember
  rw [complexPartialSum.succ, lastTerm] at first
  linear_combination -first

-- χ(N − 1) = χ(−1).
theorem DirichletCharacter.pred_modulus (N M : Nat) (χ : Set)
  requires character : DirichletCharacter(N, χ)
  requires level : M + 1 = N
  shows χ(integerOfNat(M)) = χ(integerNegValue(integerOne))
proof
  have mInteger : integerOfNat(M) ∈ ℤ by typecheck
  have minus : integerNegValue(integerOne) ∈ ℤ by typecheck
  apply DirichletCharacter.congruent with character, mInteger, minus
  unfold IntegerCongruent
  witness integerOne
  have sum := integerOfNat.add at M, 1
  rw [level, integerOfNat.one] at sum
  rw sum
  ring

-- The factors Γ(s) (2π)^(−s) e^(∓πis/2) of Hurwitz's formula, and the
-- terms of its right side as one series.
def hurwitzMinusFactor (s : Set) : Set :=
  ℂ[Gamma(s) * realCpow(R[2 * realPi], ℂ[-s]) *
    complexExp(ℂ[-(complexImaginaryUnit * complexOfReal(realPi) * s *
      complexOfReal(R[1 / 2]))])]

def hurwitzPlusFactor (s : Set) : Set :=
  ℂ[Gamma(s) * realCpow(R[2 * realPi], ℂ[-s]) *
    complexExp(ℂ[complexImaginaryUnit * complexOfReal(realPi) * s *
      complexOfReal(R[1 / 2])])]

theorem hurwitzFactors.member (s : Set)
  requires hs : s ∈ ℂ
  shows hurwitzMinusFactor(s) ∈ ℂ ∧ hurwitzPlusFactor(s) ∈ ℂ
proof
  have gamma := Gamma.member at s
  have negative : ℂ[-s] ∈ ℂ by typecheck
  have power := realCpow.member at R[2 * realPi], ℂ[-s] with negative
  have iMember := complexImaginaryUnit.member
  have plusArgument : ℂ[complexImaginaryUnit * complexOfReal(realPi) * s *
    complexOfReal(R[1 / 2])] ∈ ℂ by typecheck
  have minusArgument : ℂ[-(complexImaginaryUnit * complexOfReal(realPi) * s *
    complexOfReal(R[1 / 2]))] ∈ ℂ by typecheck
  have plusExp := complexExp.member with plusArgument
  have minusExp := complexExp.member with minusArgument
  have first : hurwitzMinusFactor(s) ∈ ℂ
    unfold hurwitzMinusFactor
    typecheck
  have second : hurwitzPlusFactor(s) ∈ ℂ
    unfold hurwitzPlusFactor
    typecheck
  exact ⟨first, second⟩

defgraph hurwitzFormulaTerms (a : Real, s : Set) (n ∈ ℕ) : complexCarrier :=
  ℂ[hurwitzMinusFactor(s) * periodicZetaTerms(a, s)(n) +
    hurwitzPlusFactor(s) * periodicZetaTerms(R[-a], s)(n)]
requires hs : s ∈ complexCarrier
proof
  obtain ⟨minus, plus⟩ := hurwitzFactors.member with hs
  have first := FunctionBetween.apply_closed with (periodicZetaTerms.function
    at a, s with hs), member
  have second := FunctionBetween.apply_closed with
    (periodicZetaTerms.function at R[-a], s with hs), member
  typecheck

-- Hurwitz's formula as the sum of one series, for re s > 1.
theorem hurwitzFormulaTerms.sums (a : Real) (s : Set)
  requires positive : R[0] < a
  requires atMostOne : a ≤ R[1]
  requires hs : s ∈ ℂ
  requires halfPlane : realOne < complexRe(s)
  shows ComplexSumsTo(hurwitzFormulaTerms(a, s), hurwitzZeta(ℂ[1 - s], a))
proof
  obtain ⟨minus, plus⟩ := hurwitzFactors.member with hs
  obtain ⟨sumsPlus, _⟩ := periodicZeta.series at a, s with hs, halfPlane
  obtain ⟨sumsMinus, _⟩ := periodicZeta.series at R[-a], s with hs,
    halfPlane
  have terms := hurwitzFormulaTerms.function at a, s with hs
  have sequence : ComplexSequence(hurwitzFormulaTerms(a, s)) by exact terms
  have values : ∀ m ∈ ℕ, hurwitzFormulaTerms(a, s)(m) =
      ℂ[hurwitzMinusFactor(s) * periodicZetaTerms(a, s)(m) +
        hurwitzPlusFactor(s) * periodicZetaTerms(R[-a], s)(m)]
    intros m mMember
    exact hurwitzFormulaTerms.value at a, s, m with hs, mMember
  have combined := ComplexSumsTo.linear with sumsPlus, sumsMinus, minus,
    plus, sequence, values
  have formula := hurwitzZeta.functional_equation with positive, atMostOne,
    hs, halfPlane
  have plusValue := ComplexSumsTo.member with sumsPlus
  have minusValue := ComplexSumsTo.member with sumsMinus
  have gamma := Gamma.member at s
  have negative : ℂ[-s] ∈ ℂ by typecheck
  have power := realCpow.member at R[2 * realPi], ℂ[-s] with negative
  have iMember := complexImaginaryUnit.member
  have plusArgument : ℂ[complexImaginaryUnit * complexOfReal(realPi) * s *
    complexOfReal(R[1 / 2])] ∈ ℂ by typecheck
  have minusArgument : ℂ[-(complexImaginaryUnit * complexOfReal(realPi) * s *
    complexOfReal(R[1 / 2]))] ∈ ℂ by typecheck
  have plusExp := complexExp.member with plusArgument
  have minusExp := complexExp.member with minusArgument
  have same : hurwitzZeta(ℂ[1 - s], a) = ℂ[hurwitzMinusFactor(s) *
      periodicZeta(a, s) + hurwitzPlusFactor(s) * periodicZeta(R[-a], s)]
    rw formula
    unfold hurwitzMinusFactor
    unfold hurwitzPlusFactor
    ring
  rw same
  exact combined

-- The grid χ(j + 1) (Hurwitz's series for ζ(1 − s, (j + 1)/N))ₙ: its
-- columns sum to the terms of L(1 − s, χ).
defgraph lHurwitzGrid (N : Nat, χ s : Set) (p ∈ ℕ × ℕ) : complexCarrier :=
  ℂ[χ(integerOfNat(succ(fst(p)))) *
    hurwitzFormulaTerms(R[realNat(succ(fst(p))) / realNat(N)], s)(snd(p))]
requires values : FunctionBetween(χ, ℤ, complexCarrier)
requires hs : s ∈ complexCarrier
proof
  obtain ⟨_, u, uMember, v, vMember, shape⟩ := product.membership.forward
    with member
  rw [shape, fst.pair, snd.pair]
  have uNat := nat.omega.backward at u with uMember
  have index : integerOfNat(succ(u)) ∈ ℤ by typecheck
  have value := FunctionBetween.apply_closed with values, index
  have term := FunctionBetween.apply_closed with (hurwitzFormulaTerms.function
    at R[realNat(succ(u)) / realNat(N)], s with hs), vMember
  typecheck

theorem lHurwitzGrid.columns (N : Nat) (χ s : Set)
  requires values : FunctionBetween(χ, ℤ, complexCarrier)
  requires hs : s ∈ ℂ
  requires halfPlane : realOne < complexRe(s)
  shows ∀ j ∈ ℕ, j < N → ComplexSumsTo(gridColumn(lHurwitzGrid(N, χ, s), j),
    lFunctionTerms(N, χ, ℂ[1 - s])(j))
proof
  intros j jMember below
  have jNat := nat.omega.backward at j with jMember
  have grid := lHurwitzGrid.function at N, χ, s with values, hs
  -- 0 < (j + 1)/N ≤ 1.
  have nonzeroJ : j + 1 ≠ (0:N) by arith
  have nonzeroN : N ≠ (0:N) by arith
  have positiveJ := realNat.positive with nonzeroJ
  have positiveN := realNat.positive with nonzeroN
  have atMost : j + 1 ≤ N by arith
  have atMostReal := realNat.le_of_natural_le with atMost
  have positive := real.div_positive with positiveJ, positiveN
  have atMostOne := real.div_le_one with positiveN, atMostReal
  have sums := hurwitzFormulaTerms.sums with positive, atMostOne, hs,
    halfPlane
  have reflected : ℂ[1 - s] ∈ ℂ by typecheck
  have zeta := hurwitzZeta.member at ℂ[1 - s], R[realNat(j + 1) /
    realNat(N)] with reflected
  have index : integerOfNat(j + 1) ∈ ℤ by typecheck
  have value := FunctionBetween.apply_closed with values, index
  have column := gridColumn.function at lHurwitzGrid(N, χ, s), j with grid
  have sequence : ComplexSequence(gridColumn(lHurwitzGrid(N, χ, s), j)) by
    exact column
  have terms : ∀ m ∈ ℕ, gridColumn(lHurwitzGrid(N, χ, s), j)(m) =
      ℂ[χ(integerOfNat(j + 1)) * hurwitzFormulaTerms(R[realNat(j + 1) /
        realNat(N)], s)(m)]
    intros m mMember
    have pair := product.pair with jMember, mMember
    have one : j + 1 = succ(j) := add.right_one with *
    rw [(gridColumn.value at lHurwitzGrid(N, χ, s), j, m with grid),
      (lHurwitzGrid.value at N, χ, s, (j, m) with values, hs, pair),
      fst.pair, snd.pair, one]
  have scaled := ComplexSumsTo.scale with sums, zeta, value, sequence, terms
  rw (lFunctionTerms.value at N, χ, ℂ[1 - s], j with values, reflected,
    jMember)
  exact scaled

-- The row n of the grid: (n + 1)^(−s) times twisted Gauss sums, the second
-- at (n + 1)(N − 1) ≡ −(n + 1).
theorem lHurwitzGrid.rows (N M : Nat) (χ s : Set) (n : Nat)
  requires values : FunctionBetween(χ, ℤ, complexCarrier)
  requires hs : s ∈ ℂ
  requires level : M + 1 = N
  shows gridRowSums(lHurwitzGrid(N, χ, s), N)(n) =
    ℂ[realCpow(realNat(n + 1), ℂ[-s]) * (hurwitzMinusFactor(s) *
      complexPartialSum(gaussTwistShift(N, χ, n + 1), N) +
      hurwitzPlusFactor(s) *
      complexPartialSum(gaussTwistShift(N, χ, (n + 1) * M), N))]
proof
  have nMember : n ∈ ℕ by typecheck
  have grid := lHurwitzGrid.function at N, χ, s with values, hs
  obtain ⟨minus, plus⟩ := hurwitzFactors.member with hs
  have negative : ℂ[-s] ∈ ℂ by typecheck
  have power := realCpow.member at realNat(n + 1), ℂ[-s] with negative
  have c1 : ℂ[realCpow(realNat(n + 1), ℂ[-s]) * hurwitzMinusFactor(s)] ∈ ℂ
    by typecheck
  have c2 : ℂ[realCpow(realNat(n + 1), ℂ[-s]) * hurwitzPlusFactor(s)] ∈ ℂ
    by typecheck
  have uTerms := gaussTwistShift.function at N, χ, n + 1 with values
  have uSequence : ComplexSequence(gaussTwistShift(N, χ, n + 1)) by
    exact uTerms
  have wTerms := gaussTwistShift.function at N, χ, (n + 1) * M with values
  have wSequence : ComplexSequence(gaussTwistShift(N, χ, (n + 1) * M)) by
    exact wTerms
  have nonzeroN : N ≠ (0:N) by arith
  have nonzeroReal := realNat.ne_zero with nonzeroN
  have inverse := realInvValue.mul_right with nonzeroReal
  have levelReal : realNat(N) = R[realNat(M) + 1]
    rw [← level, realNat.add, realNat.one]
  have terms : ∀ m ∈ ℕ, gridRow(lHurwitzGrid(N, χ, s), n)(m) =
      ℂ[ℂ[realCpow(realNat(n + 1), ℂ[-s]) * hurwitzMinusFactor(s)] *
        gaussTwistShift(N, χ, n + 1)(m) +
        ℂ[realCpow(realNat(n + 1), ℂ[-s]) * hurwitzPlusFactor(s)] *
        gaussTwistShift(N, χ, (n + 1) * M)(m)]
    intros m mMember
    have mNat := nat.omega.backward at m with mMember
    have succMember : succ(m) ∈ ℕ by typecheck
    have pair := product.pair with mMember, nMember
    have index : integerOfNat(succ(m)) ∈ ℤ by typecheck
    have value := FunctionBetween.apply_closed with values, index
    have phase1 : R[realNat(n + 1) * R[realNat(succ(m)) / realNat(N)]] =
        R[realNat(succ(m) * (n + 1)) * realInvValue(realNat(N))]
      rw [realDiv.eq_mul_inv, realNat.mul]
      ring
    have shape : R[realNat(succ(m) * ((n + 1) * M)) *
        realInvValue(realNat(N))] = R[R[realNat(n + 1) *
        R[-R[realNat(succ(m)) / realNat(N)]]] + realNat(succ(m) * (n + 1))]
      rw [realDiv.eq_mul_inv, realNat.mul, realNat.mul, realNat.mul]
      linear_combination (realNat(succ(m)) * realNat(n + 1)) * inverse -
        (realNat(succ(m)) * realNat(n + 1) * realInvValue(realNat(N))) *
        levelReal
    have firstPhase := expTwoPiI.member at R[realNat(n + 1) *
      R[-R[realNat(succ(m)) / realNat(N)]]]
    have phase2 : expTwoPiI(R[realNat(succ(m) * ((n + 1) * M)) *
        realInvValue(realNat(N))]) = expTwoPiI(R[realNat(n + 1) *
        R[-R[realNat(succ(m)) / realNat(N)]]])
      rw [shape, expTwoPiI.add, expTwoPiI.nat]
      ring
    have e1 := expTwoPiI.member at R[realNat(succ(m) * (n + 1)) *
      realInvValue(realNat(N))]
    rw [(gridRow.value at lHurwitzGrid(N, χ, s), n, m with grid),
      (lHurwitzGrid.value at N, χ, s, (m, n) with values, hs, pair),
      fst.pair, snd.pair,
      (hurwitzFormulaTerms.value at R[realNat(succ(m)) / realNat(N)], s, n
        with hs, nMember),
      (periodicZetaTerms.value at R[realNat(succ(m)) / realNat(N)], s, n
        with hs, nMember),
      (periodicZetaTerms.value at R[-R[realNat(succ(m)) / realNat(N)]], s, n
        with hs, nMember),
      (gaussTwistShift.value at N, χ, n + 1, m with values, mMember),
      (gaussTwistShift.value at N, χ, (n + 1) * M, m with values, mMember),
      (gaussTwist.value at N, χ, n + 1, succ(m) with values, succMember),
      (gaussTwist.value at N, χ, (n + 1) * M, succ(m) with values,
        succMember), phase1, phase2]
    ring
  have linear := complexPartialSum.linear at gaussTwistShift(N, χ, n + 1),
    gaussTwistShift(N, χ, (n + 1) * M), gridRow(lHurwitzGrid(N, χ, s), n),
    ℂ[realCpow(realNat(n + 1), ℂ[-s]) * hurwitzMinusFactor(s)],
    ℂ[realCpow(realNat(n + 1), ℂ[-s]) * hurwitzPlusFactor(s)], N with
    uSequence, wSequence, c1, c2, terms
  rw [(gridRowSums.value at lHurwitzGrid(N, χ, s), N, n with grid), linear]
  have uSum := complexPartialSum.member at gaussTwistShift(N, χ, n + 1), N
    with uSequence
  have wSum := complexPartialSum.member at gaussTwistShift(N, χ,
    (n + 1) * M), N with wSequence
  ring

-- For re s > 1: L(1 − s, χ̄) = N^(s−1) Γ(s) (2π)^(−s)
-- (e^(−πis/2) + χ(−1) e^(πis/2)) τ(χ̄) L(s, χ), from Hurwitz's formula at
-- a = j/N and G(k) = χ(k) τ(χ̄) for the twisted Gauss sums of χ̄.
theorem LFunction.conj_reflect_right (N : Nat) (χ s : Set)
  requires positive : 1 ≤ N
  requires character : DirichletCharacter(N, χ)
  requires primitive : PrimitiveCharacter(N, χ)
  requires hs : s ∈ ℂ
  requires halfPlane : realOne < complexRe(s)
  shows LFunction(N, conjCharacter(χ), ℂ[1 - s]) =
    ℂ[realCpow(realNat(N), ℂ[-(1 - s)]) * (hurwitzMinusFactor(s) +
      χ(integerNegValue(integerOne)) * hurwitzPlusFactor(s)) *
      gaussSum(N, conjCharacter(χ)) * LFunction(N, χ, s)]
proof
  have positiveN : 0 < N by arith
  obtain ⟨M, MNat, split⟩ := positive
  have level : M + 1 = N by arith
  have atLeastOne : 1 ≤ N by arith
  have values := DirichletCharacter.function with character
  have conjugate := conjCharacter.character with character
  have conjugatePrimitive := conjCharacter.primitive with character, primitive
  have conjugateValues := DirichletCharacter.function with conjugate
  have reflected : ℂ[1 - s] ∈ ℂ by typecheck
  obtain ⟨minus, plus⟩ := hurwitzFactors.member with hs
  have tau := gaussSum.member at N, conjCharacter(χ) with conjugateValues
  have minusOne : integerNegValue(integerOne) ∈ ℤ by typecheck
  have sign := DirichletCharacter.value with character, minusOne
  have predecessor := DirichletCharacter.pred_modulus with character, level
  -- The grid sums by columns to Σ_j χ̄(j + 1) ζ(1 − s, (j + 1)/N).
  have grid := lHurwitzGrid.function at N, conjCharacter(χ), s with
    conjugateValues, hs
  have columns := lHurwitzGrid.columns at N, conjCharacter(χ), s with
    conjugateValues, hs, halfPlane
  have lTerms := lFunctionTerms.function at N, conjCharacter(χ), ℂ[1 - s]
    with conjugateValues, reflected
  have lSequence : ComplexSequence(lFunctionTerms(N, conjCharacter(χ),
    ℂ[1 - s])) by exact lTerms
  have byColumns := gridRowSums.sums with grid, lSequence, columns
  -- Its rows are the Dirichlet series of χ, scaled.
  have constant : ℂ[(hurwitzMinusFactor(s) + χ(integerNegValue(integerOne)) *
    hurwitzPlusFactor(s)) * gaussSum(N, conjCharacter(χ))] ∈ ℂ by typecheck
  have rows : ∀ n ∈ ℕ, gridRowSums(lHurwitzGrid(N, conjCharacter(χ), s),
      N)(n) = ℂ[ℂ[(hurwitzMinusFactor(s) + χ(integerNegValue(integerOne)) *
      hurwitzPlusFactor(s)) * gaussSum(N, conjCharacter(χ))] *
      dirichletSeriesTerms(χ, s)(n)]
    intros n nMember
    have nNat := nat.omega.backward at n with nMember
    have row := lHurwitzGrid.rows at N, M, conjCharacter(χ), s, n with
      conjugateValues, hs, level
    have first := gaussTwist.conj_gauss at N, conjCharacter(χ), n + 1 with
      conjugate, positiveN, conjugatePrimitive
    have second := gaussTwist.conj_gauss at N, conjCharacter(χ),
      (n + 1) * M with conjugate, positiveN, conjugatePrimitive
    have index : integerOfNat(n + 1) ∈ ℤ by typecheck
    have mIndex : integerOfNat(M) ∈ ℤ by typecheck
    have productIndex : integerOfNat((n + 1) * M) ∈ ℤ by typecheck
    have value := DirichletCharacter.value with character, index
    have mValue := DirichletCharacter.value with character, mIndex
    have productValue := DirichletCharacter.value with character,
      productIndex
    have multiplicative := DirichletCharacter.mul with character, index,
      mIndex
    rw [← integerOfNat.mul, predecessor] at multiplicative
    rw [(conjCharacter.apply with values, index),
      (complexConj.involutive with value)] at first
    rw [(conjCharacter.apply with values, productIndex),
      (complexConj.involutive with productValue), multiplicative] at second
    have negative : ℂ[-s] ∈ ℂ by typecheck
    have power := realCpow.member at realNat(n + 1), ℂ[-s] with negative
    rw [row, (gaussTwistShift.sum with conjugate, positiveN), first, second,
      (dirichletSeriesTerms.value at χ, s, n with values, hs, nMember)]
    ring
  have rowFunction := gridRowSums.function at lHurwitzGrid(N,
    conjCharacter(χ), s), N with grid
  have rowSequence : ComplexSequence(gridRowSums(lHurwitzGrid(N,
    conjCharacter(χ), s), N)) by exact rowFunction
  obtain ⟨series, _⟩ := LFunction.series with atLeastOne, character, hs,
    halfPlane
  have lValue := LFunction.closed at N, χ, s with values, hs
  have byRows := ComplexSumsTo.scale with series, lValue, constant,
    rowSequence, rows
  have same := ComplexSumsTo.unique with byColumns, byRows
  have definition : LFunction(N, conjCharacter(χ), ℂ[1 - s]) =
      ℂ[realCpow(realNat(N), ℂ[-(1 - s)]) * complexPartialSum(lFunctionTerms(
      N, conjCharacter(χ), ℂ[1 - s]), N)]
    unfold LFunction
    rfl
  have exponent : ℂ[-(1 - s)] ∈ ℂ by typecheck
  have nPower := realCpow.member at realNat(N), ℂ[-(1 - s)] with exponent
  rw [definition, same]
  ring

-- χ(−1)² = 1.
theorem DirichletCharacter.neg_one_square (N : Nat) (χ : Set)
  requires character : DirichletCharacter(N, χ)
  shows ℂ[χ(integerNegValue(integerOne)) * χ(integerNegValue(integerOne))] =
    ℂ[1]
proof
  cases DirichletCharacter.neg_one with character with plus | minus
  . rw plus
    ring
  . rw minus
    ring

-- The conjugate of τ(χ) is χ(−1) τ(χ̄), for χ primitive.
theorem gaussSum.conj (N : Nat) (χ : Set)
  requires positive : 1 ≤ N
  requires character : DirichletCharacter(N, χ)
  requires primitive : PrimitiveCharacter(N, χ)
  shows complexConj(gaussSum(N, χ)) =
    ℂ[χ(integerNegValue(integerOne)) * gaussSum(N, conjCharacter(χ))]
proof
  have positiveN : 0 < N by arith
  obtain ⟨M, MNat, split⟩ := positive
  have level : M + 1 = N by arith
  have values := DirichletCharacter.function with character
  have conjugate := conjCharacter.character with character
  have conjugatePrimitive := conjCharacter.primitive with character, primitive
  have conjugateValues := DirichletCharacter.function with conjugate
  -- conj τ(χ) = Σ_l χ̄(l) e(−l/N).
  have gaussFunction := gaussTerms.function at N, χ with values
  have gaussSequence : ComplexSequence(gaussTerms(N, χ)) by
    exact gaussFunction
  have conjugates : ∀ k ∈ ℕ,
      conjGaussTerms(N, χ)(k) = complexConj(gaussTerms(N, χ)(k))
    intros k kMember
    have kNat := nat.omega.backward at k with kMember
    have index : integerOfNat(k) ∈ ℤ by typecheck
    have value := FunctionBetween.apply_closed with values, index
    have phase := expTwoPiI.member at
      R[realNat(k) * realInvValue(realNat(N))]
    rw [(conjGaussTerms.value at N, χ, k with values, kMember),
      (gaussTerms.value at N, χ, k with values, kMember),
      realDiv.eq_mul_inv, (complexConj.mul with value, phase),
      expTwoPiI.conj]
  have conjSum := complexPartialSum.conj_terms at gaussTerms(N, χ),
    conjGaussTerms(N, χ), N with gaussSequence, conjugates
  -- e(−l/N) = e(l (N − 1)/N).
  have nonzeroN : N ≠ (0:N) by arith
  have nonzeroReal := realNat.ne_zero with nonzeroN
  have inverse := realInvValue.mul_right with nonzeroReal
  have levelReal : realNat(N) = R[realNat(M) + 1]
    rw [← level, realNat.add, realNat.one]
  have termwise : ∀ l ∈ ℕ, l < N →
      conjGaussTerms(N, χ)(l) = gaussTwist(N, conjCharacter(χ), M)(l)
    intros l lMember below
    have lNat := nat.omega.backward at l with lMember
    have index : integerOfNat(l) ∈ ℤ by typecheck
    have shape : R[realNat(l * M) * realInvValue(realNat(N))] =
        R[-(realNat(l) * realInvValue(realNat(N))) + realNat(l)]
      rw realNat.mul
      linear_combination realNat(l) * inverse -
        (realNat(l) * realInvValue(realNat(N))) * levelReal
    have phase := expTwoPiI.member at
      R[-(realNat(l) * realInvValue(realNat(N)))]
    rw [(conjGaussTerms.value at N, χ, l with values, lMember),
      (gaussTwist.value at N, conjCharacter(χ), M, l with conjugateValues,
        lMember), (conjCharacter.apply with values, index), shape,
      expTwoPiI.add, expTwoPiI.nat]
    have value := FunctionBetween.apply_closed with values, index
    have conjValue := complexConj.member with value
    ring
  have congr := complexPartialSum.congr at conjGaussTerms(N, χ),
    gaussTwist(N, conjCharacter(χ), M), N
  have reindexed := congr with termwise
  have twisted := gaussTwist.conj_gauss at N, conjCharacter(χ), M with
    conjugate, positiveN, conjugatePrimitive
  have mIndex : integerOfNat(M) ∈ ℤ by typecheck
  have mValue := DirichletCharacter.value with character, mIndex
  rw [(conjCharacter.apply with values, mIndex),
    (complexConj.involutive with mValue),
    (DirichletCharacter.pred_modulus with character, level)] at twisted
  rw [← conjSum, twisted] at reindexed
  have definition : gaussSum(N, χ) = complexPartialSum(gaussTerms(N, χ), N)
    unfold gaussSum
    rfl
  rw definition
  exact reindexed

-- τ(χ) τ(χ̄) = χ(−1) N for χ primitive.
theorem gaussSum.mul_conj_character (N : Nat) (χ : Set)
  requires positive : 1 ≤ N
  requires character : DirichletCharacter(N, χ)
  requires primitive : PrimitiveCharacter(N, χ)
  shows ℂ[gaussSum(N, χ) * gaussSum(N, conjCharacter(χ))] =
    ℂ[χ(integerNegValue(integerOne)) * complexOfReal(realNat(N))]
proof
  have values := DirichletCharacter.function with character
  have tau := gaussSum.member at N, χ with values
  have conjugate := conjCharacter.character with character
  have conjugateValues := DirichletCharacter.function with conjugate
  have tauConj := gaussSum.member at N, conjCharacter(χ) with
    conjugateValues
  have product : ℂ[gaussSum(N, χ) * complexConj(gaussSum(N, χ))] =
      complexOfReal(realNat(N))
    by_cases one : N = (1:N)
    . rw one
      rw one at character
      exact gaussSum.mul_conj_one with character
    . have two : 2 ≤ N by arith
      exact gaussSum.mul_conj_large with two, character, primitive
  have conj := gaussSum.conj with positive, character, primitive
  have square := DirichletCharacter.neg_one_square with character
  have minusOne : integerNegValue(integerOne) ∈ ℤ by typecheck
  have sign := DirichletCharacter.value with character, minusOne
  have conjTau := complexConj.member with tau
  linear_combination (-(χ(integerNegValue(integerOne)) * gaussSum(N, χ))) *
    conj + χ(integerNegValue(integerOne)) * product -
    (gaussSum(N, χ) * gaussSum(N, conjCharacter(χ))) * square

-- The Gamma factors of the even functional equation:
-- π^(−t/2) Γ(t/2) = π^(−(1−t)/2) Γ((1 − t)/2) 2 (2π)^(−t) cos(πt/2) Γ(t),
-- by duplication at t/2 and reflection at (1 + t)/2.
theorem gammaFactor.even_cos (t : Set)
  requires hs : t ∈ gammaDomain
  requires shifted : ℂ[t * complexOfReal(R[1 / 2]) + complexOfReal(R[1 / 2])]
    ∈ gammaDomain
  requires reflected : ℂ[(1 - t) * complexOfReal(R[1 / 2])] ∈ gammaDomain
  shows ℂ[realCpow(realPi, ℂ[-(t * complexOfReal(R[1 / 2]))]) *
      Gamma(ℂ[t * complexOfReal(R[1 / 2])])] =
    ℂ[realCpow(realPi, ℂ[-(ℂ[1 - t] * complexOfReal(R[1 / 2]))]) *
      Gamma(ℂ[(1 - t) * complexOfReal(R[1 / 2])]) *
      (2 * realCpow(R[2 * realPi], ℂ[-t]) *
      complexCos(ℂ[complexOfReal(realPi) * t *
      complexOfReal(R[1 / 2])]) * Gamma(t))]
proof
  have tMember := gammaDomain.subset with t, hs
  have half := complexHalf.double
  have halfMember : complexOfReal(R[1 / 2]) ∈ ℂ by typecheck
  have piMember : complexOfReal(realPi) ∈ ℂ by typecheck
  -- Duplication at t/2.
  have double : ℂ[2 * (t * complexOfReal(R[1 / 2]))] = t
    linear_combination t * half
  have doubleDomain : ℂ[2 * (t * complexOfReal(R[1 / 2]))] ∈ gammaDomain
    rw double
    exact hs
  have halfTMember : ℂ[t * complexOfReal(R[1 / 2])] ∈ ℂ by typecheck
  have duplication := Gamma.duplication at ℂ[t * complexOfReal(R[1 / 2])]
    with halfTMember, doubleDomain
  rw double at duplication
  -- Reflection at (1 + t)/2.
  have oneMinus : ℂ[1 - (t * complexOfReal(R[1 / 2]) +
      complexOfReal(R[1 / 2]))] = ℂ[(1 - t) * complexOfReal(R[1 / 2])]
    linear_combination -half
  have reflectedDomain : ℂ[1 - (t * complexOfReal(R[1 / 2]) +
      complexOfReal(R[1 / 2]))] ∈ gammaDomain
    rw oneMinus
    exact reflected
  have reflection := Gamma.reflection at ℂ[t * complexOfReal(R[1 / 2]) +
    complexOfReal(R[1 / 2])] with shifted, reflectedDomain
  rw oneMinus at reflection
  have argument : ℂ[complexOfReal(realPi) * (t * complexOfReal(R[1 / 2]) +
      complexOfReal(R[1 / 2]))] = ℂ[complexOfReal(realPi) * t *
      complexOfReal(R[1 / 2]) + complexOfReal(realPi) *
      complexOfReal(R[1 / 2])] by ring
  have angle : ℂ[complexOfReal(realPi) * t * complexOfReal(R[1 / 2])] ∈ ℂ
    by typecheck
  rw [argument, (complexSin.add_half_pi with angle)] at reflection
  -- cos(πt/2) ≠ 0, as Γ((1 + t)/2) Γ((1 − t)/2) ≠ 0.
  have shiftedGamma := Gamma.member at ℂ[t * complexOfReal(R[1 / 2]) +
    complexOfReal(R[1 / 2])]
  have shiftedNonzero := Gamma.nonzero with shifted
  have reflectedGamma := Gamma.member at ℂ[(1 - t) * complexOfReal(R[1 / 2])]
  have reflectedNonzero := Gamma.nonzero with reflected
  have angleMember : ℂ[complexOfReal(realPi) * t * complexOfReal(R[1 / 2])] ∈ ℂ
    by typecheck
  have cosine := complexCos.member with angleMember
  have cosNonzero : complexCos(ℂ[complexOfReal(realPi) * t *
      complexOfReal(R[1 / 2])]) ≠ ℂ[0]
    intro vanish
    rw [vanish, complexDiv, complexInv.zero] at reflection
    have product : ℂ[Gamma(ℂ[t * complexOfReal(R[1 / 2]) +
        complexOfReal(R[1 / 2])]) * Gamma(ℂ[(1 - t) *
        complexOfReal(R[1 / 2])])] = ℂ[0]
      rw reflection
      ring
    have zero := complexMul.zero_factor with shiftedGamma, reflectedGamma,
      shiftedNonzero, product
    exact reflectedNonzero with zero
  have cosInverse := complexInv.mul_cancel with cosine, cosNonzero
  unfold complexDiv at reflection
  -- The powers of 2 and π.
  have twoPositive : R[0] < R[2] by linarith
  have piPositive := realPi.positive
  have negative : ℂ[-t] ∈ ℂ by typecheck
  have one : ℂ[1] ∈ ℂ by typecheck
  have powerSplit := realCpow.mul_base at R[2], realPi, ℂ[-t] with
    twoPositive, piPositive, negative
  have twoSplit := realCpow.add at R[2], ℂ[1], ℂ[-t] with one, negative
  rw [(realCpow.one at R[2] with twoPositive),
    complexOfReal.two] at twoSplit
  have root := realCpow.sqrt_pi
  have piOne := realCpow.one at realPi with piPositive
  have exponentA : ℂ[-(ℂ[1 - t] * complexOfReal(R[1 / 2]))] ∈ ℂ by typecheck
  have exponentB : ℂ[-(t * complexOfReal(R[1 / 2]))] ∈ ℂ by typecheck
  have first := realCpow.add at realPi, ℂ[-(ℂ[1 - t] *
    complexOfReal(R[1 / 2]))], ℂ[-t] with
    exponentA, negative
  have sumA : ℂ[-(ℂ[1 - t] * complexOfReal(R[1 / 2])) + -t] ∈ ℂ by typecheck
  have second := realCpow.add at realPi, ℂ[-(ℂ[1 - t] *
    complexOfReal(R[1 / 2])) + -t], ℂ[1]
    with sumA, one
  have third := realCpow.add at realPi, ℂ[-(t * complexOfReal(R[1 / 2]))],
    complexOfReal(R[1 / 2]) with exponentB,
    halfMember
  have exponents : ℂ[-(ℂ[1 - t] * complexOfReal(R[1 / 2])) + -t + 1] =
      ℂ[-(t * complexOfReal(R[1 / 2])) + complexOfReal(R[1 / 2])]
    linear_combination (t - 1) * half
  rw [exponents, third, first] at second
  -- Combine.
  have reflectedMember : ℂ[1 - t] ∈ ℂ by typecheck
  have gamma := Gamma.member at t
  have gammaHalf := Gamma.member at ℂ[t * complexOfReal(R[1 / 2])]
  have powerA := realCpow.member at realPi, ℂ[-(ℂ[1 - t] *
    complexOfReal(R[1 / 2]))] with
    exponentA
  have powerB := realCpow.member at realPi, ℂ[-(t *
    complexOfReal(R[1 / 2]))] with exponentB
  have powerTwo := realCpow.member at R[2 * realPi], ℂ[-t] with negative
  have powerTwoNeg := realCpow.member at R[2], ℂ[-t] with negative
  have powerPiNeg := realCpow.member at realPi, ℂ[-t] with negative
  have powerHalf := realCpow.member at realPi,
    complexOfReal(R[1 / 2]) with halfMember
  have powerOneMinus := realCpow.member at R[2], ℂ[1 - t] with
    reflectedMember
  have rootMember : complexOfReal(realSqrt(realPi)) ∈ ℂ by typecheck
  have cosInverseMember := complexInv.member with cosine
  have scale : ℂ[realCpow(R[2], ℂ[1 - t]) * complexOfReal(realSqrt(realPi))] ∈ ℂ
    by typecheck
  have scaleNonzero : ℂ[realCpow(R[2], ℂ[1 - t]) *
      complexOfReal(realSqrt(realPi))] ≠ ℂ[0]
    rw [twoSplit, root]
    intro vanish
    have twoNonzero := complexTwo.nonzero
    have powerNonzero := realCpow.nonzero at R[2], ℂ[-t] with negative
    have halfNonzero := realCpow.nonzero at realPi,
      complexOfReal(R[1 / 2]) with halfMember
    have twoMember : ℂ[2] ∈ ℂ by typecheck
    have inner : ℂ[realCpow(R[2], ℂ[-t]) * realCpow(realPi,
        complexOfReal(R[1 / 2]))] ∈ ℂ by typecheck
    have regroup : ℂ[2 * (realCpow(R[2], ℂ[-t]) * realCpow(realPi,
        complexOfReal(R[1 / 2])))] = ℂ[0]
      linear_combination vanish
    have rest := complexMul.zero_factor with twoMember, inner, twoNonzero,
      regroup
    have last := complexMul.zero_factor with powerTwoNeg, powerHalf,
      powerNonzero, rest
    exact halfNonzero with last
  have difference : ℂ[realCpow(R[2], ℂ[1 - t]) *
      complexOfReal(realSqrt(realPi)) * (realCpow(realPi, ℂ[-(ℂ[1 - t] *
      complexOfReal(R[1 / 2]))]) * Gamma(ℂ[(1 - t) * complexOfReal(R[1 / 2])]) *
      (2 * realCpow(R[2 * realPi], ℂ[-t]) *
      complexCos(ℂ[complexOfReal(realPi) * t * complexOfReal(R[1 / 2])]) *
      Gamma(t)) - realCpow(realPi, ℂ[-(t *
        complexOfReal(R[1 / 2]))]) *
        Gamma(ℂ[t * complexOfReal(R[1 / 2])]))] = ℂ[0]
    linear_combination -(2*realCpow(R[2 * realPi],
      ℂ[-t])*complexCos(ℂ[complexOfReal(realPi) * t *
        complexOfReal(R[1 / 2])])*realCpow(realPi, ℂ[-(ℂ[1 - t] *
        complexOfReal(R[1 / 2]))])*Gamma(ℂ[(1 - t) *
        complexOfReal(R[1 / 2])])) * duplication +
      (2*realCpow(R[2 * realPi], ℂ[-t])*complexCos(ℂ[complexOfReal(realPi) * t *
        complexOfReal(R[1 / 2])])*realCpow(realPi, ℂ[-(ℂ[1 - t] *
        complexOfReal(R[1 / 2]))])*Gamma(ℂ[t * complexOfReal(R[1 / 2])])) *
        reflection +
      (2*realCpow(R[2 * realPi], ℂ[-t])*realCpow(realPi,
        ℂ[-(ℂ[1 - t] * complexOfReal(R[1 / 2]))])*Gamma(ℂ[t *
        complexOfReal(R[1 / 2])])*complexOfReal(realPi)) * cosInverse +
      (2*Gamma(ℂ[t * complexOfReal(R[1 / 2])])*realCpow(realPi,
        ℂ[-(ℂ[1 - t] * complexOfReal(R[1 / 2]))])*complexOfReal(realPi)) *
        powerSplit -
      (2*Gamma(ℂ[t * complexOfReal(R[1 / 2])])*realCpow(realPi,
        ℂ[-(ℂ[1 - t] * complexOfReal(R[1 / 2]))])*realCpow(R[2],
        ℂ[-t])*realCpow(realPi, ℂ[-t])) * piOne -
      (2*Gamma(ℂ[t * complexOfReal(R[1 / 2])])*realCpow(R[2],
        ℂ[-t])) * second -
      (complexOfReal(realSqrt(realPi))*realCpow(realPi, ℂ[-(t *
        complexOfReal(R[1 / 2]))])*Gamma(ℂ[t *
        complexOfReal(R[1 / 2])])) * twoSplit -
      (2*realCpow(R[2], ℂ[-t])*realCpow(realPi, ℂ[-(t *
        complexOfReal(R[1 / 2]))])*Gamma(ℂ[t *
        complexOfReal(R[1 / 2])])) * root
  have inner : ℂ[realCpow(realPi, ℂ[-(ℂ[1 - t] * complexOfReal(R[1 / 2]))]) *
      Gamma(ℂ[(1 - t) * complexOfReal(R[1 / 2])]) *
      (2 * realCpow(R[2 * realPi], ℂ[-t]) *
      complexCos(ℂ[complexOfReal(realPi) * t * complexOfReal(R[1 / 2])]) *
      Gamma(t)) -
      realCpow(realPi, ℂ[-(t * complexOfReal(R[1 / 2]))]) *
      Gamma(ℂ[t * complexOfReal(R[1 / 2])])] ∈ ℂ by typecheck
  have zero := complexMul.zero_factor with scale, inner, scaleNonzero,
    difference
  linear_combination -zero

-- The Gamma factors of the odd functional equation:
-- π^(−(s+1)/2) Γ((s + 1)/2) = 2 sin(πs/2) π^(−(1−s/2)) Γ(1 − s/2)
-- (2π)^(−s) Γ(s), by duplication and reflection at s/2.
theorem gammaFactor.odd_sin (s : Set)
  requires hs : s ∈ gammaDomain
  requires halfDomain : ℂ[s * complexOfReal(R[1 / 2])] ∈ gammaDomain
  requires reflected : ℂ[1 - s * complexOfReal(R[1 / 2])] ∈ gammaDomain
  shows ℂ[realCpow(realPi,
    ℂ[-(s * complexOfReal(R[1 / 2]) + complexOfReal(R[1 / 2]))]) *
      Gamma(ℂ[s * complexOfReal(R[1 / 2]) + complexOfReal(R[1 / 2])])] =
    ℂ[2 * complexSin(ℂ[complexOfReal(realPi) * s * complexOfReal(R[1 / 2])]) *
      realCpow(realPi, ℂ[-(1 - s * complexOfReal(R[1 / 2]))]) *
      Gamma(ℂ[1 - s * complexOfReal(R[1 / 2])]) *
      realCpow(R[2 * realPi], ℂ[-s]) *
      Gamma(s)]
proof
  have sMember := gammaDomain.subset with s, hs
  have half := complexHalf.double
  have halfMember : complexOfReal(R[1 / 2]) ∈ ℂ by typecheck
  have piMember : complexOfReal(realPi) ∈ ℂ by typecheck
  have hMember : ℂ[s * complexOfReal(R[1 / 2])] ∈ ℂ by typecheck
  -- Duplication at s/2.
  have double : ℂ[2 * (s * complexOfReal(R[1 / 2]))] = s
    linear_combination s * half
  have doubleDomain : ℂ[2 * (s * complexOfReal(R[1 / 2]))] ∈ gammaDomain
    rw double
    exact hs
  have duplication := Gamma.duplication at ℂ[s * complexOfReal(R[1 / 2])]
    with hMember, doubleDomain
  rw double at duplication
  -- Reflection at s/2.
  have reflection := Gamma.reflection at ℂ[s * complexOfReal(R[1 / 2])]
    with halfDomain, reflected
  have argument : ℂ[complexOfReal(realPi) * (s * complexOfReal(R[1 / 2]))] =
      ℂ[complexOfReal(realPi) * s * complexOfReal(R[1 / 2])] by ring
  rw argument at reflection
  have angle : ℂ[complexOfReal(realPi) * s * complexOfReal(R[1 / 2])] ∈ ℂ
    by typecheck
  have sine := complexSin.member with angle
  have halfGamma := Gamma.member at ℂ[s * complexOfReal(R[1 / 2])]
  have halfNonzero := Gamma.nonzero with halfDomain
  have reflectedGamma := Gamma.member at ℂ[1 - s * complexOfReal(R[1 / 2])]
  have reflectedNonzero := Gamma.nonzero with reflected
  have sinNonzero :
      complexSin(ℂ[complexOfReal(realPi) * s * complexOfReal(R[1 / 2])]) ≠ ℂ[0]
    intro vanish
    rw [vanish, complexDiv, complexInv.zero] at reflection
    have product : ℂ[Gamma(ℂ[s * complexOfReal(R[1 / 2])]) *
        Gamma(ℂ[1 - s * complexOfReal(R[1 / 2])])] = ℂ[0]
      rw reflection
      ring
    have zero := complexMul.zero_factor with halfGamma, reflectedGamma,
      halfNonzero, product
    exact reflectedNonzero with zero
  have sinCancel := complexInv.mul_cancel with sine, sinNonzero
  unfold complexDiv at reflection
  -- The powers of 2 and π.
  have twoPositive : R[0] < R[2] by linarith
  have piPositive := realPi.positive
  have negative : ℂ[-s] ∈ ℂ by typecheck
  have one : ℂ[1] ∈ ℂ by typecheck
  have powerSplit := realCpow.mul_base at R[2], realPi, ℂ[-s] with
    twoPositive, piPositive, negative
  have twoSplit := realCpow.add at R[2], ℂ[1], ℂ[-s] with one, negative
  rw [(realCpow.one at R[2] with twoPositive),
    complexOfReal.two] at twoSplit
  have root := realCpow.sqrt_pi
  have piOne := realCpow.one at realPi with piPositive
  have exponentB : ℂ[-(1 - s * complexOfReal(R[1 / 2]))] ∈ ℂ by typecheck
  have exponentA : ℂ[-(s * complexOfReal(R[1 / 2]) +
    complexOfReal(R[1 / 2]))] ∈ ℂ by typecheck
  have first := realCpow.add at realPi,
    ℂ[-(1 - s * complexOfReal(R[1 / 2]))], ℂ[-s] with
    exponentB, negative
  have sumB : ℂ[-(1 - s * complexOfReal(R[1 / 2])) + -s] ∈ ℂ by typecheck
  have second := realCpow.add at realPi,
    ℂ[-(1 - s * complexOfReal(R[1 / 2])) + -s], ℂ[1]
    with sumB, one
  have third := realCpow.add at realPi,
    ℂ[-(s * complexOfReal(R[1 / 2]) + complexOfReal(R[1 / 2]))],
    complexOfReal(R[1 / 2]) with
    exponentA, halfMember
  have exponents : ℂ[-(1 - s * complexOfReal(R[1 / 2])) + -s + 1] =
      ℂ[-(s * complexOfReal(R[1 / 2]) + complexOfReal(R[1 / 2])) +
      complexOfReal(R[1 / 2])]
    linear_combination s * half
  rw [exponents, third, first] at second
  -- Combine, after multiplying by Γ(s/2).
  have gamma := Gamma.member at s
  have shiftedGamma := Gamma.member at ℂ[s * complexOfReal(R[1 / 2]) +
    complexOfReal(R[1 / 2])]
  have powerA := realCpow.member at realPi,
    ℂ[-(s * complexOfReal(R[1 / 2]) + complexOfReal(R[1 / 2]))] with
    exponentA
  have powerB := realCpow.member at realPi,
    ℂ[-(1 - s * complexOfReal(R[1 / 2]))] with
    exponentB
  have powerTwo := realCpow.member at R[2 * realPi], ℂ[-s] with negative
  have powerTwoNeg := realCpow.member at R[2], ℂ[-s] with negative
  have powerPiNeg := realCpow.member at realPi, ℂ[-s] with negative
  have powerHalf := realCpow.member at realPi,
    complexOfReal(R[1 / 2]) with halfMember
  have rootMember : complexOfReal(realSqrt(realPi)) ∈ ℂ by typecheck
  have sinInverse := complexInv.member with sine
  have difference : ℂ[Gamma(ℂ[s * complexOfReal(R[1 / 2])]) * (realCpow(realPi,
      ℂ[-(s * complexOfReal(R[1 / 2]) + complexOfReal(R[1 / 2]))]) *
      Gamma(ℂ[s * complexOfReal(R[1 / 2]) + complexOfReal(R[1 / 2])]) -
      2 * complexSin(ℂ[complexOfReal(realPi) * s * complexOfReal(R[1 / 2])]) *
      realCpow(realPi, ℂ[-(1 - s * complexOfReal(R[1 / 2]))]) *
      Gamma(ℂ[1 - s * complexOfReal(R[1 / 2])]) *
      realCpow(R[2 * realPi], ℂ[-s]) *
      Gamma(s))] = ℂ[0]
    linear_combination realCpow(realPi,
      ℂ[-(s * complexOfReal(R[1 / 2]) + complexOfReal(R[1 / 2]))]) *
      duplication -
      (2 * complexSin(ℂ[complexOfReal(realPi) * s * complexOfReal(R[1 / 2])]) *
      realCpow(realPi, ℂ[-(1 - s * complexOfReal(R[1 / 2]))]) *
      realCpow(R[2 * realPi], ℂ[-s]) * Gamma(s)) * reflection +
      (realCpow(realPi,
      ℂ[-(s * complexOfReal(R[1 / 2]) + complexOfReal(R[1 / 2]))]) * Gamma(s) *
      complexOfReal(realSqrt(realPi))) * twoSplit +
      (2 * realCpow(R[2], ℂ[-s]) *
      realCpow(realPi, ℂ[-(s * complexOfReal(R[1 / 2]) +
      complexOfReal(R[1 / 2]))]) * Gamma(s)) * root -
      (2 * complexSin(ℂ[complexOfReal(realPi) * s * complexOfReal(R[1 / 2])]) *
      complexInv(complexSin(ℂ[complexOfReal(realPi) * s *
      complexOfReal(R[1 / 2])])) *
      realCpow(realPi, ℂ[-(1 - s * complexOfReal(R[1 / 2]))]) *
      complexOfReal(realPi) *
      Gamma(s)) * powerSplit -
      (2 * realCpow(realPi, ℂ[-(1 - s * complexOfReal(R[1 / 2]))]) *
      complexOfReal(realPi) *
      realCpow(R[2], ℂ[-s]) * realCpow(realPi, ℂ[-s]) * Gamma(s)) *
      sinCancel +
      (2 * realCpow(R[2], ℂ[-s]) * Gamma(s)) * second +
      (2 * realCpow(R[2], ℂ[-s]) * Gamma(s) * realCpow(realPi,
      ℂ[-(1 - s * complexOfReal(R[1 / 2]))]) * realCpow(realPi, ℂ[-s])) * piOne
  have inner :
      ℂ[realCpow(realPi,
      ℂ[-(s * complexOfReal(R[1 / 2]) + complexOfReal(R[1 / 2]))]) *
      Gamma(ℂ[s * complexOfReal(R[1 / 2]) + complexOfReal(R[1 / 2])]) -
      2 * complexSin(ℂ[complexOfReal(realPi) * s * complexOfReal(R[1 / 2])]) *
      realCpow(realPi, ℂ[-(1 - s * complexOfReal(R[1 / 2]))]) *
      Gamma(ℂ[1 - s * complexOfReal(R[1 / 2])]) *
      realCpow(R[2 * realPi], ℂ[-s]) *
      Gamma(s)] ∈ ℂ by typecheck
  have zero := complexMul.zero_factor with halfGamma, inner, halfNonzero,
    difference
  linear_combination zero

-- The Gamma factors of Λ(s, χ), against those of Hurwitz's formula:
-- i^κ π^(−(s+κ)/2) Γ((s + κ)/2) = χ(−1) π^(−(1−s+κ)/2) Γ((1 − s + κ)/2)
-- Γ(s) (2π)^(−s) (e^(−πis/2) + χ(−1) e^(πis/2)) for re s > 0.
theorem lGammaFactor.reflect (χ : Set) (κ : Nat) (s : Set)
  requires parity : HasParity(χ, κ)
  requires hs : s ∈ ℂ
  requires positive : realZero < complexRe(s)
  requires reflectedDomain : lGammaArgument(κ, ℂ[1 - s]) ∈ gammaDomain
  shows ℂ[complexImaginaryUnit ^ κ *
      realCpow(realPi, ℂ[-lGammaArgument(κ, s)]) *
      Gamma(lGammaArgument(κ, s))] =
    ℂ[χ(integerNegValue(integerOne)) *
      realCpow(realPi, ℂ[-lGammaArgument(κ, ℂ[1 - s])]) *
      Gamma(lGammaArgument(κ, ℂ[1 - s])) * (hurwitzMinusFactor(s) +
      χ(integerNegValue(integerOne)) * hurwitzPlusFactor(s))]
proof
  have domain := gammaDomain.of_re_positive with hs, positive
  have half := complexHalf.double
  have halfMember : complexOfReal(R[1 / 2]) ∈ ℂ by typecheck
  have piMember : complexOfReal(realPi) ∈ ℂ by typecheck
  have iMember := complexImaginaryUnit.member
  have argument0 : lGammaArgument(0, s) = ℂ[s * complexOfReal(R[1 / 2])]
    unfold lGammaArgument
    rw [realNat.zero, complexOfReal.zero]
    ring
  have argument1 : lGammaArgument(1, s) = ℂ[s * complexOfReal(R[1 / 2]) +
      complexOfReal(R[1 / 2])]
    unfold lGammaArgument
    rw [realNat.one, complexOfReal.one]
    ring
  have halfDomain := lGammaArgument.domain at 0, s with hs, positive
  rw argument0 at halfDomain
  have shifted := lGammaArgument.domain at 1, s with hs, positive
  rw argument1 at shifted
  -- e^(±iπs/2) and the cosine and sine of πs/2.
  have angle : ℂ[complexOfReal(realPi) * s * complexOfReal(R[1 / 2])] ∈ ℂ
    by typecheck
  have inner : ℂ[complexImaginaryUnit * (complexOfReal(realPi) * s *
      complexOfReal(R[1 / 2]))] =
      ℂ[complexImaginaryUnit * complexOfReal(realPi) * s *
      complexOfReal(R[1 / 2])] by ring
  have cosine := complexCos.formula with angle
  have sine := complexSin.formula with angle
  rw inner at cosine
  rw inner at sine
  have plusArgument : ℂ[complexImaginaryUnit * complexOfReal(realPi) * s *
    complexOfReal(R[1 / 2])] ∈ ℂ by typecheck
  have minusArgument : ℂ[-(complexImaginaryUnit * complexOfReal(realPi) * s *
    complexOfReal(R[1 / 2]))] ∈ ℂ by typecheck
  have plusExp := complexExp.member with plusArgument
  have minusExp := complexExp.member with minusArgument
  have twoMember : ℂ[2] ∈ ℂ by typecheck
  have two := complexInv.mul_cancel with twoMember, complexTwo.nonzero
  have inverse := complexInv.member with twoMember
  have gamma := Gamma.member at s
  have negative : ℂ[-s] ∈ ℂ by typecheck
  have power := realCpow.member at R[2 * realPi], ℂ[-s] with negative
  have cosMember := complexCos.member with angle
  have sinMember := complexSin.member with angle
  unfold hurwitzMinusFactor
  unfold hurwitzPlusFactor
  unfold HasParity at parity
  cases parity with even | odd
  . obtain ⟨kappa, sign⟩ := even
    rw [kappa, sign]
    rw kappa at reflectedDomain
    have reflectedArgument : lGammaArgument(0, ℂ[1 - s]) =
        ℂ[(1 - s) * complexOfReal(R[1 / 2])]
      unfold lGammaArgument
      rw [realNat.zero, complexOfReal.zero]
      ring
    rw reflectedArgument at reflectedDomain
    rw [argument0, reflectedArgument]
    have equation := gammaFactor.even_cos with domain, shifted,
      reflectedDomain
    have reflectedGamma := Gamma.member at ℂ[(1 - s) * complexOfReal(R[1 / 2])]
    have exponent : ℂ[-(ℂ[1 - s] * complexOfReal(R[1 / 2]))] ∈ ℂ by typecheck
    have reflectedPower := realCpow.member at realPi,
      ℂ[-(ℂ[1 - s] * complexOfReal(R[1 / 2]))]
      with exponent
    linear_combination equation + (2 * realCpow(realPi, ℂ[-(ℂ[1 - s] *
      complexOfReal(R[1 / 2]))]) * Gamma(ℂ[(1 - s) * complexOfReal(R[1 / 2])]) *
      realCpow(R[2 * realPi], ℂ[-s]) *
      Gamma(s)) * cosine +
      (realCpow(realPi, ℂ[-(ℂ[1 - s] * complexOfReal(R[1 / 2]))]) *
      Gamma(ℂ[(1 - s) * complexOfReal(R[1 / 2])]) *
      realCpow(R[2 * realPi], ℂ[-s]) * Gamma(s) *
      (complexExp(ℂ[-(complexImaginaryUnit * complexOfReal(realPi) * s *
      complexOfReal(R[1 / 2]))]) +
      complexExp(ℂ[complexImaginaryUnit * complexOfReal(realPi) * s *
      complexOfReal(R[1 / 2])]))) * two
  . obtain ⟨kappa, sign⟩ := odd
    rw [kappa, sign]
    rw kappa at reflectedDomain
    have reflectedArgument : lGammaArgument(1, ℂ[1 - s]) =
        ℂ[1 - s * complexOfReal(R[1 / 2])]
      unfold lGammaArgument
      rw [realNat.one, complexOfReal.one]
      linear_combination half
    rw reflectedArgument at reflectedDomain
    rw [argument1, reflectedArgument]
    have equation := gammaFactor.odd_sin with domain, halfDomain,
      reflectedDomain
    have square := complexImaginaryUnit.square
    have reflectedGamma := Gamma.member at ℂ[1 - s * complexOfReal(R[1 / 2])]
    have exponent : ℂ[-(1 - s * complexOfReal(R[1 / 2]))] ∈ ℂ by typecheck
    have reflectedPower := realCpow.member at realPi,
      ℂ[-(1 - s * complexOfReal(R[1 / 2]))]
      with exponent
    linear_combination complexImaginaryUnit * equation +
      (2 * complexImaginaryUnit *
      realCpow(realPi, ℂ[-(1 - s * complexOfReal(R[1 / 2]))]) *
      Gamma(ℂ[1 - s * complexOfReal(R[1 / 2])]) *
      realCpow(R[2 * realPi], ℂ[-s]) * Gamma(s)) *
      sine -
      (2 * complexInv(ℂ[2]) *
      realCpow(realPi, ℂ[-(1 - s * complexOfReal(R[1 / 2]))]) *
      Gamma(ℂ[1 - s * complexOfReal(R[1 / 2])]) *
      realCpow(R[2 * realPi], ℂ[-s]) * Gamma(s) *
      (complexExp(ℂ[complexImaginaryUnit * complexOfReal(realPi) * s *
      complexOfReal(R[1 / 2])]) -
      complexExp(ℂ[-(complexImaginaryUnit * complexOfReal(realPi) *
      s * complexOfReal(R[1 / 2]))]))) * square -
      (realCpow(realPi, ℂ[-(1 - s * complexOfReal(R[1 / 2]))]) *
      Gamma(ℂ[1 - s * complexOfReal(R[1 / 2])]) *
      realCpow(R[2 * realPi], ℂ[-s]) * Gamma(s) *
      (complexExp(ℂ[-(complexImaginaryUnit * complexOfReal(realPi) * s *
      complexOfReal(R[1 / 2]))]) -
      complexExp(ℂ[complexImaginaryUnit * complexOfReal(realPi) * s *
      complexOfReal(R[1 / 2])]))) * two

-- i^κ √N ≠ 0 for N ≥ 1.
theorem rootScale.nonzero (N κ : Nat)
  requires positive : 1 ≤ N
  shows ℂ[complexImaginaryUnit ^ κ * complexOfReal(realSqrt(realNat(N)))] ≠ ℂ[0]
proof
  have atLeast := realNat.one_le with positive
  have nonnegative : R[0] ≤ realNat(N) by linarith
  have sqrtReal := realSqrt.real with nonnegative
  have sqrtNonnegative := realSqrt.nonneg with nonnegative
  have square := realSqrt.square with nonnegative
  have iMember := complexImaginaryUnit.member
  have iPower := complexPow.member at complexImaginaryUnit, κ with iMember
  have sqrtMember : complexOfReal(realSqrt(realNat(N))) ∈ ℂ by typecheck
  have unitPower := realOne.pow at κ
  intro vanish
  have absolute := complexAbs.mul with iPower, sqrtMember
  rw [vanish, complexAbs.zero, (complexAbs.pow with iMember),
    complexAbs.imaginary, unitPower, complexAbs.of_real,
    (abs.of_nonnegative with sqrtNonnegative)] at absolute
  have zero : realSqrt(realNat(N)) = R[0] by linear_combination -absolute
  rw zero at square
  have collapse : R[0 * 0] = R[0] by ring
  linarith

-- √x = x^(1/2) for x > 0.
theorem realCpow.sqrt (X : Real)
  requires positive : R[0] < X
  shows complexOfReal(realSqrt(X)) = realCpow(X, complexOfReal(R[1 / 2]))
proof
  have rootPositive := realRpow.positive at X, R[1 / 2]
  have nonnegative : R[0] ≤ realRpow(X, R[1 / 2]) by linarith
  have halves : R[1 / 2 + 1 / 2] = R[1] by linarith
  have sum := realRpow.add at X, R[1 / 2], R[1 / 2] with positive
  rw [halves, (realRpow.one with positive)] at sum
  symm at sum
  have root := realSqrt.eq_of_square with nonnegative, sum
  rw [root, realCpow.of_real]

-- The functional equation for re s > 1.
theorem LFunction.functional_equation_right (N : Nat) (χ : Set) (κ : Nat)
    (s : Set)
  requires positive : 1 ≤ N
  requires character : DirichletCharacter(N, χ)
  requires primitive : PrimitiveCharacter(N, χ)
  requires parity : HasParity(χ, κ)
  requires hs : s ∈ ℂ
  requires halfPlane : realOne < complexRe(s)
  requires reflectedDomain : lGammaArgument(κ, ℂ[1 - s]) ∈ gammaDomain
  shows completedL(N, χ, κ, s) =
    ℂ[rootNumber(N, χ, κ) * completedL(N, conjCharacter(χ), κ, ℂ[1 - s])]
proof
  have sPositive : realZero < complexRe(s) by linarith
  have values := DirichletCharacter.function with character
  have conjugate := conjCharacter.character with character
  have conjugateValues := DirichletCharacter.function with conjugate
  have reflected : ℂ[1 - s] ∈ ℂ by typecheck
  have half := complexHalf.double
  have halfMember : complexOfReal(R[1 / 2]) ∈ ℂ by typecheck
  -- The three ingredients.
  have mirror := LFunction.conj_reflect_right with positive, character,
    primitive, hs, halfPlane
  have gauss := gaussSum.mul_conj_character with positive, character,
    primitive
  have gamma := lGammaFactor.reflect with parity, hs, sPositive,
    reflectedDomain
  -- (N/π)^w = N^w π^(−w).
  have domainA := lGammaArgument.domain at κ, s with hs, sPositive
  have argumentA := gammaDomain.subset with domainA
  have argumentB := gammaDomain.subset with reflectedDomain
  have negativeA : ℂ[-lGammaArgument(κ, s)] ∈ ℂ by typecheck
  have negativeB : ℂ[-lGammaArgument(κ, ℂ[1 - s])] ∈ ℂ by typecheck
  have piPositive := realPi.positive
  have atLeast := realNat.one_le with positive
  have nPositive : R[0] < realNat(N) by linarith
  have quotientPositive := real.div_positive with nPositive, piPositive
  have piNonzero : realPi ≠ R[0] by linarith
  have base : R[R[realNat(N) / realPi] * realPi] = realNat(N)
    exact realDiv.mul_right with piNonzero
  have splitA := realCpow.mul_base at R[realNat(N) / realPi], realPi,
    lGammaArgument(κ, s) with quotientPositive, piPositive, argumentA
  have splitB := realCpow.mul_base at R[realNat(N) / realPi], realPi,
    lGammaArgument(κ, ℂ[1 - s]) with quotientPositive, piPositive, argumentB
  rw base at splitA
  rw base at splitB
  have inverseA := realCpow.add at realPi, lGammaArgument(κ, s),
    ℂ[-lGammaArgument(κ, s)] with argumentA, negativeA
  have inverseB := realCpow.add at realPi, lGammaArgument(κ, ℂ[1 - s]),
    ℂ[-lGammaArgument(κ, ℂ[1 - s])] with argumentB, negativeB
  have cancelA : ℂ[lGammaArgument(κ, s) + -lGammaArgument(κ, s)] = ℂ[0]
    by ring
  have cancelB : ℂ[lGammaArgument(κ, ℂ[1 - s]) +
    -lGammaArgument(κ, ℂ[1 - s])] = ℂ[0] by ring
  rw [cancelA, realCpow.zero] at inverseA
  rw [cancelB, realCpow.zero] at inverseB
  have powerA := realCpow.member at R[realNat(N) / realPi],
    lGammaArgument(κ, s) with argumentA
  have powerB := realCpow.member at R[realNat(N) / realPi],
    lGammaArgument(κ, ℂ[1 - s]) with argumentB
  have piA := realCpow.member at realPi, lGammaArgument(κ, s) with argumentA
  have piB := realCpow.member at realPi, lGammaArgument(κ, ℂ[1 - s]) with
    argumentB
  have piNegA := realCpow.member at realPi, ℂ[-lGammaArgument(κ, s)] with
    negativeA
  have piNegB := realCpow.member at realPi, ℂ[-lGammaArgument(κ, ℂ[1 - s])]
    with negativeB
  have nA := realCpow.member at realNat(N), lGammaArgument(κ, s) with
    argumentA
  have nB := realCpow.member at realNat(N), lGammaArgument(κ, ℂ[1 - s]) with
    argumentB
  have formA : realCpow(R[realNat(N) / realPi], lGammaArgument(κ, s)) =
      ℂ[realCpow(realNat(N), lGammaArgument(κ, s)) *
      realCpow(realPi, ℂ[-lGammaArgument(κ, s)])]
    linear_combination realCpow(R[realNat(N) / realPi],
      lGammaArgument(κ, s)) * inverseA - realCpow(realPi,
      ℂ[-lGammaArgument(κ, s)]) * splitA
  have formB : realCpow(R[realNat(N) / realPi], lGammaArgument(κ,
      ℂ[1 - s])) = ℂ[realCpow(realNat(N), lGammaArgument(κ, ℂ[1 - s])) *
      realCpow(realPi, ℂ[-lGammaArgument(κ, ℂ[1 - s])])]
    linear_combination realCpow(R[realNat(N) / realPi],
      lGammaArgument(κ, ℂ[1 - s])) * inverseB - realCpow(realPi,
      ℂ[-lGammaArgument(κ, ℂ[1 - s])]) * splitB
  -- N^((s+κ)/2) = N^((1−s+κ)/2) N^(s−1) N^(1/2), and √N = N^(1/2).
  have exponent : lGammaArgument(κ, s) =
      ℂ[lGammaArgument(κ, ℂ[1 - s]) + -(1 - s) + complexOfReal(R[1 / 2])]
    unfold lGammaArgument
    have kappa : complexOfReal(realNat(κ)) ∈ ℂ by typecheck
    linear_combination (s - 1) * half
  have shift : ℂ[-(1 - s)] ∈ ℂ by typecheck
  have sumMember : ℂ[lGammaArgument(κ, ℂ[1 - s]) + -(1 - s)] ∈ ℂ by typecheck
  have first := realCpow.add at realNat(N), lGammaArgument(κ, ℂ[1 - s]),
    ℂ[-(1 - s)] with argumentB, shift
  have second := realCpow.add at realNat(N), ℂ[lGammaArgument(κ, ℂ[1 - s]) +
    -(1 - s)], complexOfReal(R[1 / 2]) with sumMember, halfMember
  rw [← exponent, first] at second
  have root := realCpow.sqrt at realNat(N) with nPositive
  have halves := realCpow.add at realNat(N), complexOfReal(R[1 / 2]),
    complexOfReal(R[1 / 2]) with halfMember,
    halfMember
  have halfSum : ℂ[complexOfReal(R[1 / 2]) + complexOfReal(R[1 / 2])] = ℂ[1]
    linear_combination half
  rw [halfSum, (realCpow.one at realNat(N) with nPositive)] at halves
  -- i^κ √N is invertible.
  have scaleNonzero := rootScale.nonzero at N, κ with positive
  have iMember := complexImaginaryUnit.member
  have iPower := complexPow.member at complexImaginaryUnit, κ with iMember
  have nonnegativeN : R[0] ≤ realNat(N) by linarith
  have sqrtReal := realSqrt.real with nonnegativeN
  have scale : ℂ[complexImaginaryUnit ^ κ *
      complexOfReal(realSqrt(realNat(N)))] ∈ ℂ by typecheck
  have scaleCancel := complexInv.mul_cancel with scale, scaleNonzero
  have scaleInverse := complexInv.member with scale
  -- Combine.
  have tau := gaussSum.member at N, χ with values
  have tauConj := gaussSum.member at N, conjCharacter(χ) with
    conjugateValues
  have lValue := LFunction.closed at N, χ, s with values, hs
  have gammaA := Gamma.member at lGammaArgument(κ, s)
  have gammaB := Gamma.member at lGammaArgument(κ, ℂ[1 - s])
  obtain ⟨minus, plus⟩ := hurwitzFactors.member with hs
  have minusOne : integerNegValue(integerOne) ∈ ℤ by typecheck
  have sign := DirichletCharacter.value with character, minusOne
  have nShift := realCpow.member at realNat(N), ℂ[-(1 - s)] with shift
  have nHalf := realCpow.member at realNat(N),
    complexOfReal(R[1 / 2]) with halfMember
  unfold completedL
  unfold rootNumber
  unfold complexDiv
  rw [mirror, formA, formB]
  linear_combination (realCpow(realPi, ℂ[-lGammaArgument(κ, s)]) *
      Gamma(lGammaArgument(κ, s)) * LFunction(N, χ, s)) * second -
    (realCpow(realNat(N), lGammaArgument(κ, ℂ[1 - s])) *
      realCpow(realNat(N), ℂ[-(1 - s)]) * LFunction(N, χ, s) *
      realCpow(realPi, ℂ[-lGammaArgument(κ, s)]) *
      Gamma(lGammaArgument(κ, s)) *
      realCpow(realNat(N), complexOfReal(R[1 / 2]))) *
      scaleCancel +
    (realCpow(realNat(N), lGammaArgument(κ, ℂ[1 - s])) *
      realCpow(realNat(N), ℂ[-(1 - s)]) * LFunction(N, χ, s) *
      realCpow(realPi, ℂ[-lGammaArgument(κ, s)]) *
      Gamma(lGammaArgument(κ, s)) *
      realCpow(realNat(N), complexOfReal(R[1 / 2])) *
      complexInv(ℂ[complexImaginaryUnit ^ κ *
      complexOfReal(realSqrt(realNat(N)))]) * complexImaginaryUnit ^ κ) * root -
    (realCpow(realNat(N), lGammaArgument(κ, ℂ[1 - s])) *
      realCpow(realNat(N), ℂ[-(1 - s)]) * LFunction(N, χ, s) *
      realCpow(realPi, ℂ[-lGammaArgument(κ, s)]) *
      Gamma(lGammaArgument(κ, s)) *
      complexInv(ℂ[complexImaginaryUnit ^ κ *
      complexOfReal(realSqrt(realNat(N)))]) *
      complexImaginaryUnit ^ κ) * halves +
    (complexOfReal(realNat(N)) *
    complexInv(ℂ[complexImaginaryUnit ^ κ *
    complexOfReal(realSqrt(realNat(N)))]) *
      realCpow(realNat(N), lGammaArgument(κ, ℂ[1 - s])) *
      realCpow(realNat(N), ℂ[-(1 - s)]) * LFunction(N, χ, s)) * gamma -
    (complexInv(ℂ[complexImaginaryUnit ^ κ *
    complexOfReal(realSqrt(realNat(N)))]) *
    realCpow(realNat(N), lGammaArgument(κ, ℂ[1 - s])) *
      realCpow(realPi, ℂ[-lGammaArgument(κ, ℂ[1 - s])]) *
      Gamma(lGammaArgument(κ, ℂ[1 - s])) * realCpow(realNat(N),
      ℂ[-(1 - s)]) * (hurwitzMinusFactor(s) +
      χ(integerNegValue(integerOne)) * hurwitzPlusFactor(s)) *
      LFunction(N, χ, s)) * gauss

-- Section: Continuation of the functional equation
-- The entire functions s ↦ (s + κ)/2, s ↦ 1/Γ((s + κ)/2), and, for χ not
-- principal, s ↦ (N/π)^((s+κ)/2) L(s, χ).
defgraph lArgumentMap (κ : Nat) (s ∈ complexCarrier) : complexCarrier :=
  lGammaArgument(κ, s)
proof
  unfold lGammaArgument
  typecheck

defgraph lReciprocalMap (κ : Nat) (s ∈ complexCarrier) : complexCarrier :=
  reciprocalGamma(lGammaArgument(κ, s))
proof
  exact reciprocalGamma.member at lGammaArgument(κ, s)

defgraph lHalfMap (N : Nat, χ : Set, κ : Nat) (s ∈ complexCarrier) :
    complexCarrier :=
  ℂ[realCpow(R[realNat(N) / realPi], lGammaArgument(κ, s)) *
    LFunction(N, χ, s)]
requires values : FunctionBetween(χ, ℤ, complexCarrier)
proof
  have argument : lGammaArgument(κ, s) ∈ ℂ
    unfold lGammaArgument
    typecheck
  have power := realCpow.member at R[realNat(N) / realPi],
    lGammaArgument(κ, s) with argument
  have value := LFunction.closed at N, χ, s with values, member
  typecheck

theorem lArgumentMap.holomorphic (κ : Nat)
  shows HolomorphicOn(lArgumentMap(κ), complexCarrier)
proof
  have whole := ComplexOpen.whole
  have inside := ComplexOpen.subset with whole
  have identity := HolomorphicOn.id with whole
  have kappa : complexOfReal(realNat(κ)) ∈ ℂ by typecheck
  have halfMember : complexOfReal(R[1 / 2]) ∈ ℂ by typecheck
  have shift := HolomorphicOn.const with whole, kappa
  have scale := HolomorphicOn.const with whole, halfMember
  have sum := HolomorphicOn.add with identity, shift
  obtain ⟨_, identityValues, _⟩ := identity
  obtain ⟨_, shiftValues, _⟩ := shift
  obtain ⟨_, sumValues, _⟩ := sum
  obtain ⟨_, scaleValues, _⟩ := scale
  apply HolomorphicOn.mul_formula with sum, scale
  intros z hz
  rw [(lArgumentMap.value with hz),
    (complexFunctionAdd.value with identityValues, shiftValues, hz),
    (complexFunctionId.value with inside, hz),
    (complexFunctionConst.value with kappa, hz),
    (complexFunctionConst.value with halfMember, hz)]
  unfold lGammaArgument
  rfl

theorem lReciprocalMap.holomorphic (κ : Nat)
  shows HolomorphicOn(lReciprocalMap(κ), complexCarrier)
proof
  have maps : ∀ z ∈ complexCarrier, lArgumentMap(κ)(z) ∈ complexCarrier
    intros z hz
    exact FunctionBetween.apply_closed with (lArgumentMap.function at κ), hz
  have composed := HolomorphicOn.comp with (lArgumentMap.holomorphic at κ),
    reciprocalGamma.holomorphic, maps
  have values : ∀ z ∈ complexCarrier,
      reciprocalGammaMap(lArgumentMap(κ)(z)) ∈ complexCarrier
    intros z hz
    have image := maps with z, hz
    exact FunctionBetween.apply_closed with reciprocalGammaMap.function, image
  apply HolomorphicOn.congr with composed
  intros z hz
  have image := maps with z, hz
  rw [(complexFunctionComp.value with values, hz),
    (reciprocalGammaMap.value with image), (lArgumentMap.value with hz),
    (lReciprocalMap.value with hz)]

theorem lHalfMap.holomorphic (N : Nat) (χ : Set) (κ : Nat)
  requires positive : 1 ≤ N
  requires character : DirichletCharacter(N, χ)
  requires nonPrincipal : χ ≠ principalCharacter(N)
  shows HolomorphicOn(lHalfMap(N, χ, κ), complexCarrier)
proof
  have values := DirichletCharacter.function with character
  have whole := ComplexOpen.whole
  have inside := ComplexOpen.subset with whole
  have halfMember : complexOfReal(R[1 / 2]) ∈ ℂ by typecheck
  have kappa : complexOfReal(realNat(κ)) ∈ ℂ by typecheck
  have shift : ℂ[complexOfReal(realNat(κ)) * complexOfReal(R[1 / 2])] ∈ ℂ
    by typecheck
  have power := affinePower.holomorphic at R[realNat(N) / realPi],
    ℂ[complexOfReal(realNat(κ)) * complexOfReal(R[1 / 2])],
    complexOfReal(R[1 / 2]), complexCarrier with shift,
    halfMember, whole, inside
  have series := LFunction.holomorphic with positive, character,
    nonPrincipal
  apply HolomorphicOn.mul_formula with power, series
  intros z hz
  have argument : ℂ[complexOfReal(realNat(κ)) * complexOfReal(R[1 / 2]) +
      complexOfReal(R[1 / 2]) * z] =
      lGammaArgument(κ, z)
    unfold lGammaArgument
    ring
  rw [(lHalfMap.value with values, hz), (affinePower.value with shift,
    halfMember, hz), argument, (LFunctionMap.apply with values, hz)]

-- s ↦ f(1 − s) is entire with f.
theorem HolomorphicOn.reflect (f : Set)
  requires holomorphic : HolomorphicOn(f, complexCarrier)
  shows HolomorphicOn(complexFunctionComp(f, reflectMap, complexCarrier),
    complexCarrier) ∧ (∀ z ∈ complexCarrier,
    complexFunctionComp(f, reflectMap, complexCarrier)(z) = f(ℂ[1 - z]))
proof
  have maps : ∀ z ∈ complexCarrier, reflectMap(z) ∈ complexCarrier
    intros z hz
    exact FunctionBetween.apply_closed with reflectMap.function, hz
  have composed := HolomorphicOn.comp with reflectMap.holomorphic,
    holomorphic, maps
  obtain ⟨_, fValues, _⟩ := holomorphic
  have values : ∀ z ∈ complexCarrier, f(reflectMap(z)) ∈ complexCarrier
    intros z hz
    have image := maps with z, hz
    exact fValues with reflectMap(z), image
  refine ⟨composed, ?_⟩
  intros z hz
  rw [(complexFunctionComp.value with values, hz), (reflectMap.value with hz)]

-- re((s + κ)/2) = (re s + κ)/2.
theorem lGammaArgument.re (κ : Nat) (s : Set)
  requires hs : s ∈ ℂ
  shows complexRe(lGammaArgument(κ, s)) =
    R[(complexRe(s) + realNat(κ)) * (1 / 2)]
proof
  have kappa : complexOfReal(realNat(κ)) ∈ ℂ by typecheck
  have halfMember : complexOfReal(R[1 / 2]) ∈ ℂ by typecheck
  have sum : ℂ[s + complexOfReal(realNat(κ))] ∈ ℂ by typecheck
  unfold lGammaArgument
  rw [(complexRe.mul with sum, halfMember), (complexRe.add with hs, kappa),
    complexOfReal.re, complexOfReal.im, complexOfReal.re]
  ring

-- For 1 < re s < 2, (1 − s + κ)/2 is not a pole of Γ.
theorem lGammaArgument.reflected_strip (κ : Nat) (s : Set)
  requires kappa : κ = (0:N) ∨ κ = (1:N)
  requires hs : s ∈ ℂ
  requires lower : realOne < complexRe(s)
  requires upper : complexRe(s) < (2:R)
  shows lGammaArgument(κ, ℂ[1 - s]) ∈ gammaDomain
proof
  have reflected : ℂ[1 - s] ∈ ℂ by typecheck
  have argument : lGammaArgument(κ, ℂ[1 - s]) ∈ ℂ
    unfold lGammaArgument
    typecheck
  have half := lGammaArgument.re at κ, ℂ[1 - s] with reflected
  rw (complexRe.one_sub with hs) at half
  have reReal := complexRe.real with hs
  have halves := realHalf.add_self
  have argumentReal := complexRe.real with argument
  have re : R[2 * complexRe(lGammaArgument(κ, ℂ[1 - s]))] =
      R[1 - complexRe(s) + realNat(κ)]
    linear_combination 2 * half + (1 - complexRe(s) + realNat(κ)) * halves
  cases kappa with even | odd
  . rw [even, realNat.zero] at re
    rw even
    rw even at argument
    unfold gammaDomain
    apply difference.membership.backward
    refine ⟨argument, ?_⟩
    intro pole
    obtain ⟨_, n, nMember, shape⟩ := gammaPoles.membership.forward with pole
    have nNat := nat.omega.backward at n with nMember
    rw [shape, (complexRe.neg with (complexOfReal.mem at realNat(n))),
      complexOfReal.re] at re
    have nonnegative := realNat.nonnegative at n
    by_cases zero : n = (0:N)
    . rw [zero, realNat.zero] at re
      linarith
    . have atLeast : 1 ≤ n by arith
      have one := realNat.one_le with atLeast
      linarith
  . rw [odd, realNat.one] at re
    rw odd
    rw odd at argument
    have positive : realZero < complexRe(lGammaArgument(1, ℂ[1 - s]))
      by linarith
    exact gammaDomain.of_re_positive with argument, positive

theorem rootNumber.member (N : Nat) (χ : Set) (κ : Nat)
  requires values : FunctionBetween(χ, ℤ, complexCarrier)
  shows rootNumber(N, χ, κ) ∈ ℂ
proof
  have tau := gaussSum.member at N, χ with values
  have iMember := complexImaginaryUnit.member
  have iPower := complexPow.member at complexImaginaryUnit, κ with iMember
  have scale : ℂ[complexImaginaryUnit ^ κ *
      complexOfReal(realSqrt(realNat(N)))] ∈ ℂ by typecheck
  have scaleInverse := complexInv.member with scale
  unfold rootNumber
  unfold complexDiv
  typecheck

-- The two sides of Λ(s, χ) = ε(χ) Λ(1 − s, χ̄), each divided by
-- Γ((s + κ)/2) Γ((1 − s + κ)/2), as entire functions for χ not principal.
defgraph lLeftMap (N : Nat, χ : Set, κ : Nat) (s ∈ complexCarrier) :
    complexCarrier :=
  ℂ[lHalfMap(N, χ, κ)(s) * lReciprocalMap(κ)(ℂ[1 - s])]
requires values : FunctionBetween(χ, ℤ, complexCarrier)
proof
  have reflected : ℂ[1 - s] ∈ ℂ by typecheck
  have half := FunctionBetween.apply_closed with (lHalfMap.function at N, χ,
    κ with values), member
  have reciprocal := FunctionBetween.apply_closed with
    (lReciprocalMap.function at κ), reflected
  typecheck

defgraph lRightMap (N : Nat, χ : Set, κ : Nat) (s ∈ complexCarrier) :
    complexCarrier :=
  ℂ[rootNumber(N, χ, κ) * lHalfMap(N, conjCharacter(χ), κ)(ℂ[1 - s]) *
    lReciprocalMap(κ)(s)]
requires values : FunctionBetween(χ, ℤ, complexCarrier)
proof
  have reflected : ℂ[1 - s] ∈ ℂ by typecheck
  have conjugateValues := conjCharacter.function with values
  have root := rootNumber.member at N, χ, κ with values
  have half := FunctionBetween.apply_closed with (lHalfMap.function at N,
    conjCharacter(χ), κ with conjugateValues), reflected
  have reciprocal := FunctionBetween.apply_closed with
    (lReciprocalMap.function at κ), member
  typecheck

theorem lLeftMap.holomorphic (N : Nat) (χ : Set) (κ : Nat)
  requires positive : 1 ≤ N
  requires character : DirichletCharacter(N, χ)
  requires nonPrincipal : χ ≠ principalCharacter(N)
  shows HolomorphicOn(lLeftMap(N, χ, κ), complexCarrier)
proof
  have values := DirichletCharacter.function with character
  have half := lHalfMap.holomorphic at N, χ, κ with positive, character,
    nonPrincipal
  obtain ⟨reciprocal, reciprocalValue⟩ := HolomorphicOn.reflect with
    (lReciprocalMap.holomorphic at κ)
  apply HolomorphicOn.mul_formula with half, reciprocal
  intros z hz
  rw [(lLeftMap.value with values, hz), (reciprocalValue with z, hz)]

theorem lRightMap.holomorphic (N : Nat) (χ : Set) (κ : Nat)
  requires positive : 1 ≤ N
  requires character : DirichletCharacter(N, χ)
  requires nonPrincipal : conjCharacter(χ) ≠ principalCharacter(N)
  shows HolomorphicOn(lRightMap(N, χ, κ), complexCarrier)
proof
  have values := DirichletCharacter.function with character
  have conjugate := conjCharacter.character with character
  have whole := ComplexOpen.whole
  have root := rootNumber.member at N, χ, κ with values
  have constant := HolomorphicOn.const with whole, root
  have half := lHalfMap.holomorphic at N, conjCharacter(χ), κ with positive,
    conjugate, nonPrincipal
  obtain ⟨reflected, reflectedValue⟩ := HolomorphicOn.reflect with half
  have product := HolomorphicOn.mul with constant, reflected
  obtain ⟨_, constantValues, _⟩ := constant
  obtain ⟨_, reflectedValues, _⟩ := reflected
  apply HolomorphicOn.mul_formula with product, (lReciprocalMap.holomorphic
    at κ)
  intros z hz
  rw [(lRightMap.value with values, hz),
    (complexFunctionMul.value with constantValues, reflectedValues, hz),
    (complexFunctionConst.value with root, hz), (reflectedValue with z, hz)]

-- On the disk |s − 3/2| < 1/2 the two sides agree, by the functional
-- equation for re s > 1.
theorem lMaps.agree_disk (N : Nat) (χ : Set) (κ : Nat) (z : Set)
  requires positive : 1 ≤ N
  requires character : DirichletCharacter(N, χ)
  requires primitive : PrimitiveCharacter(N, χ)
  requires parity : HasParity(χ, κ)
  requires inDisk : z ∈ complexDisk(complexOfReal(R[3 / 2]), R[1 / 2])
  shows lLeftMap(N, χ, κ)(z) = lRightMap(N, χ, κ)(z)
proof
  have values := DirichletCharacter.function with character
  have conjugateValues := conjCharacter.function with values
  have kappa : κ = (0:N) ∨ κ = (1:N)
    have cases := parity
    unfold HasParity at cases
    cases cases with even | odd
    . left
      exact even.left
    . right
      exact odd.left
  obtain ⟨zMember, near⟩ := complexDisk.membership.forward with inDisk
  have center := complexOfReal.mem at R[3 / 2]
  have offset : ℂ[z - complexOfReal(R[3 / 2])] ∈ ℂ by typecheck
  have bound := complexAbs.re_le with offset
  rw [(complexRe.sub with zMember, center), complexOfReal.re] at bound
  have reReal := complexRe.real with zMember
  have above := abs.upper at R[complexRe(z) - 3 / 2]
  have below := abs.upper_neg at R[complexRe(z) - 3 / 2]
  have halfPlane : realOne < complexRe(z) by linarith
  have upper : complexRe(z) < (2:R) by linarith
  have sPositive : realZero < complexRe(z) by linarith
  have reflectedDomain := lGammaArgument.reflected_strip with kappa,
    zMember, halfPlane, upper
  have equation := LFunction.functional_equation_right with positive,
    character, primitive, parity, zMember, halfPlane, reflectedDomain
  have domain := lGammaArgument.domain at κ, z with zMember, sPositive
  have reciprocalA := Gamma.mul_reciprocal with domain
  have reciprocalB := Gamma.mul_reciprocal with reflectedDomain
  have reflected : ℂ[1 - z] ∈ ℂ by typecheck
  have argumentA := gammaDomain.subset with domain
  have argumentB := gammaDomain.subset with reflectedDomain
  have powerA := realCpow.member at R[realNat(N) / realPi],
    lGammaArgument(κ, z) with argumentA
  have powerB := realCpow.member at R[realNat(N) / realPi],
    lGammaArgument(κ, ℂ[1 - z]) with argumentB
  have lValue := LFunction.closed at N, χ, z with values, zMember
  have lConj := LFunction.closed at N, conjCharacter(χ), ℂ[1 - z] with
    conjugateValues, reflected
  have root := rootNumber.member at N, χ, κ with values
  have gammaA := Gamma.member at lGammaArgument(κ, z)
  have gammaB := Gamma.member at lGammaArgument(κ, ℂ[1 - z])
  have recipA := reciprocalGamma.member at lGammaArgument(κ, z)
  have recipB := reciprocalGamma.member at lGammaArgument(κ, ℂ[1 - z])
  unfold completedL at equation
  rw [(lLeftMap.value with values, zMember), (lRightMap.value with values,
    zMember), (lHalfMap.value with values, zMember),
    (lHalfMap.value with conjugateValues, reflected),
    (lReciprocalMap.value with reflected), (lReciprocalMap.value with
    zMember)]
  linear_combination (reciprocalGamma(lGammaArgument(κ, z)) *
      reciprocalGamma(lGammaArgument(κ, ℂ[1 - z]))) * equation -
    (realCpow(R[realNat(N) / realPi], lGammaArgument(κ, z)) *
      LFunction(N, χ, z) * reciprocalGamma(lGammaArgument(κ, ℂ[1 - z]))) *
      reciprocalA +
    (rootNumber(N, χ, κ) * realCpow(R[realNat(N) / realPi],
      lGammaArgument(κ, ℂ[1 - z])) * LFunction(N, conjCharacter(χ),
      ℂ[1 - z]) * reciprocalGamma(lGammaArgument(κ, z))) * reciprocalB

-- The functional equation for N ≥ 2, where L(·, χ) and L(·, χ̄) are
-- entire: the two sides divided by the Gamma factors agree on ℂ.
theorem LFunction.functional_equation_entire (N : Nat) (χ : Set) (κ : Nat)
    (s : Set)
  requires two : 2 ≤ N
  requires character : DirichletCharacter(N, χ)
  requires primitive : PrimitiveCharacter(N, χ)
  requires parity : HasParity(χ, κ)
  requires hs : s ∈ ℂ
  requires domain : lGammaArgument(κ, s) ∈ gammaDomain
  requires reflectedDomain : lGammaArgument(κ, ℂ[1 - s]) ∈ gammaDomain
  shows completedL(N, χ, κ, s) =
    ℂ[rootNumber(N, χ, κ) * completedL(N, conjCharacter(χ), κ, ℂ[1 - s])]
proof
  have positive : 1 ≤ N by arith
  have positiveN : 0 < N by arith
  have values := DirichletCharacter.function with character
  have conjugate := conjCharacter.character with character
  have conjugateValues := DirichletCharacter.function with conjugate
  have conjugatePrimitive := conjCharacter.primitive with character, primitive
  have iff := PrimitiveCharacter.principal_iff with positiveN
  have nonPrincipal : χ ≠ principalCharacter(N)
    intro principal
    rw principal at primitive
    have one := iff.forward with primitive
    arith
  have conjNonPrincipal : conjCharacter(χ) ≠ principalCharacter(N)
    intro principal
    rw principal at conjugatePrimitive
    have one := iff.forward with conjugatePrimitive
    arith
  -- The identity theorem from the disk |s − 3/2| < 1/2.
  have centerMember := complexOfReal.mem at R[3 / 2]
  have radius : R[1 / 2] ∈ ℝ by typecheck
  have isOpen := complexDisk.open with centerMember, radius
  have inside := ComplexOpen.subset with isOpen
  have nonempty : ∃ v, v ∈ complexDisk(complexOfReal(R[3 / 2]), R[1 / 2])
    have zero : ℂ[complexOfReal(R[3 / 2]) - complexOfReal(R[3 / 2])] = ℂ[0]
      by ring
    have small : complexAbs(ℂ[complexOfReal(R[3 / 2]) -
        complexOfReal(R[3 / 2])]) < R[1 / 2]
      rw [zero, complexAbs.zero]
      linarith
    exact ⟨complexOfReal(R[3 / 2]), (complexDisk.membership.backward with
      ⟨centerMember, small⟩)⟩
  have agree : ∀ z ∈ complexDisk(complexOfReal(R[3 / 2]), R[1 / 2]),
      lLeftMap(N, χ, κ)(z) = lRightMap(N, χ, κ)(z)
    intros z hz
    exact lMaps.agree_disk with positive, character, primitive, parity, hz
  have identity := holomorphic.identity with (lLeftMap.holomorphic at N, χ,
    κ with positive, character, nonPrincipal), (lRightMap.holomorphic at N,
    χ, κ with positive, character, conjNonPrincipal),
    ComplexConnected.whole, isOpen, nonempty, inside, agree
  have equal := identity with s, hs
  -- Multiply back by Γ((s + κ)/2) Γ((1 − s + κ)/2).
  have reflected : ℂ[1 - s] ∈ ℂ by typecheck
  rw [(lLeftMap.value with values, hs), (lRightMap.value with values, hs),
    (lHalfMap.value with values, hs),
    (lHalfMap.value with conjugateValues, reflected),
    (lReciprocalMap.value with reflected), (lReciprocalMap.value with hs)]
    at equal
  have reciprocalA := Gamma.mul_reciprocal with domain
  have reciprocalB := Gamma.mul_reciprocal with reflectedDomain
  have argumentA := gammaDomain.subset with domain
  have argumentB := gammaDomain.subset with reflectedDomain
  have powerA := realCpow.member at R[realNat(N) / realPi],
    lGammaArgument(κ, s) with argumentA
  have powerB := realCpow.member at R[realNat(N) / realPi],
    lGammaArgument(κ, ℂ[1 - s]) with argumentB
  have lValue := LFunction.closed at N, χ, s with values, hs
  have lConj := LFunction.closed at N, conjCharacter(χ), ℂ[1 - s] with
    conjugateValues, reflected
  have root := rootNumber.member at N, χ, κ with values
  have gammaA := Gamma.member at lGammaArgument(κ, s)
  have gammaB := Gamma.member at lGammaArgument(κ, ℂ[1 - s])
  have recipA := reciprocalGamma.member at lGammaArgument(κ, s)
  have recipB := reciprocalGamma.member at lGammaArgument(κ, ℂ[1 - s])
  unfold completedL
  linear_combination (Gamma(lGammaArgument(κ, s)) *
      Gamma(lGammaArgument(κ, ℂ[1 - s]))) * equal -
    (realCpow(R[realNat(N) / realPi], lGammaArgument(κ, s)) *
      Gamma(lGammaArgument(κ, s)) * LFunction(N, χ, s)) * reciprocalB +
    (rootNumber(N, χ, κ) * realCpow(R[realNat(N) / realPi],
      lGammaArgument(κ, ℂ[1 - s])) * Gamma(lGammaArgument(κ, ℂ[1 - s])) *
      LFunction(N, conjCharacter(χ), ℂ[1 - s])) * reciprocalA

-- (1/π)^w = π^(−w).
theorem realCpow.inverse_pi (w : Set)
  requires hw : w ∈ ℂ
  shows realCpow(R[realNat(1) / realPi], w) = realCpow(realPi, ℂ[-w])
proof
  have piPositive := realPi.positive
  have onePositive : R[0] < realNat(1)
    rw realNat.one
    linarith
  have quotientPositive := real.div_positive with onePositive, piPositive
  have piNonzero : realPi ≠ R[0] by linarith
  have base : R[R[realNat(1) / realPi] * realPi] = R[1]
    rw ← realNat.one
    exact realDiv.mul_right with piNonzero
  have split := realCpow.mul_base at R[realNat(1) / realPi], realPi, w with
    quotientPositive, piPositive, hw
  rw [base, (realCpow.one_base with hw)] at split
  have negative : ℂ[-w] ∈ ℂ by typecheck
  have inverse := realCpow.add at realPi, w, ℂ[-w] with hw, negative
  have cancel : ℂ[w + -w] = ℂ[0] by ring
  rw [cancel, realCpow.zero] at inverse
  have power := realCpow.member at R[realNat(1) / realPi], w with hw
  have piW := realCpow.member at realPi, w with hw
  have piNegW := realCpow.member at realPi, ℂ[-w] with negative
  linear_combination realCpow(R[realNat(1) / realPi], w) * inverse -
    realCpow(realPi, ℂ[-w]) * split

-- The functional equation for N = 1, where it is that of ζ.
theorem LFunction.functional_equation_one (χ : Set) (κ : Nat) (s : Set)
  requires character : DirichletCharacter(1, χ)
  requires parity : HasParity(χ, κ)
  requires hs : s ∈ ℂ
  requires domain : lGammaArgument(κ, s) ∈ gammaDomain
  requires reflectedDomain : lGammaArgument(κ, ℂ[1 - s]) ∈ gammaDomain
  shows completedL(1, χ, κ, s) =
    ℂ[rootNumber(1, χ, κ) * completedL(1, conjCharacter(χ), κ, ℂ[1 - s])]
proof
  have values := DirichletCharacter.function with character
  have conjugate := conjCharacter.character with character
  have reflected : ℂ[1 - s] ∈ ℂ by typecheck
  -- χ is even.
  have minusOne : integerNegValue(integerOne) ∈ ℤ by typecheck
  have unit := DirichletCharacter.modulus_one with character, minusOne
  have kappa : κ = (0:N)
    unfold HasParity at parity
    cases parity with even | odd
    . exact even.left
    . exfalso
      obtain ⟨_, sign⟩ := odd
      have bad : ℂ[2] = ℂ[0] by linear_combination sign - unit
      exact complexTwo.nonzero with bad
  rw kappa
  rw kappa at domain
  rw kappa at reflectedDomain
  have argument : lGammaArgument(0, s) = ℂ[s * complexOfReal(R[1 / 2])]
    unfold lGammaArgument
    rw [realNat.zero, complexOfReal.zero]
    ring
  have reflectedArgument : lGammaArgument(0, ℂ[1 - s]) =
      ℂ[(1 - s) * complexOfReal(R[1 / 2])]
    unfold lGammaArgument
    rw [realNat.zero, complexOfReal.zero]
    ring
  rw argument at domain
  rw reflectedArgument at reflectedDomain
  have equation := zeta.functional_equation with hs, domain, reflectedDomain
  -- τ(χ) = 1, so ε(χ) = 1.
  have zeroMember : (0:N) ∈ ℕ by typecheck
  have zeroInteger : integerOfNat(0) ∈ ℤ by typecheck
  have zeroUnit := DirichletCharacter.modulus_one with character, zeroInteger
  have phase : R[realNat(0) / realNat(1)] = R[0]
    rw [realNat.zero, realDiv.eq_mul_inv]
    ring
  have tauOne : gaussSum(1, χ) = ℂ[1]
    unfold gaussSum
    rw [complexPartialSum.succ, complexPartialSum.zero,
      (gaussTerms.value at 1, χ, 0 with values, zeroMember), phase,
      expTwoPiI.zero, zeroUnit]
    ring
  have oneNonnegative : R[0] ≤ R[1] by linarith
  have oneSquare : R[1 * 1] = realNat(1)
    rw realNat.one
    ring
  have rootOne := realSqrt.eq_of_square with oneNonnegative, oneSquare
  have scale : ℂ[complexImaginaryUnit ^ 0 *
      complexOfReal(realSqrt(realNat(1)))] ∈ ℂ by typecheck
  have oneLe : 1 ≤ (1:N) by arith
  have scaleNonzero := rootScale.nonzero at 1, 0 with oneLe
  have cancel := complexInv.mul_cancel with scale, scaleNonzero
  rw [rootOne, complexOfReal.one] at cancel
  have rootNumberOne : rootNumber(1, χ, 0) = ℂ[1]
    unfold rootNumber
    unfold complexDiv
    rw [tauOne, rootOne, complexOfReal.one]
    linear_combination cancel
  -- (1/π)^w = π^(−w), and L(·, χ) = ζ for N = 1.
  have argumentMember : ℂ[s * complexOfReal(R[1 / 2])] ∈ ℂ by typecheck
  have reflectedMember : ℂ[(1 - s) * complexOfReal(R[1 / 2])] ∈ ℂ by typecheck
  unfold completedL
  unfold completedZeta at equation
  rw [argument, reflectedArgument, rootNumberOne,
    (LFunction.principal_one with character, hs),
    (LFunction.principal_one with conjugate, reflected),
    (realCpow.inverse_pi with argumentMember),
    (realCpow.inverse_pi with reflectedMember)]
  linear_combination equation

-- The functional equation Λ(s, χ) = ε(χ) Λ(1 − s, χ̄) for χ primitive
-- modulo N of parity κ, (s + κ)/2 and (1 − s + κ)/2 not poles of Γ.
theorem LFunction.functional_equation (N : Nat) (χ : Set) (κ : Nat) (s : Set)
  requires positive : 1 ≤ N
  requires character : DirichletCharacter(N, χ)
  requires primitive : PrimitiveCharacter(N, χ)
  requires parity : HasParity(χ, κ)
  requires hs : s ∈ ℂ
  requires domain : lGammaArgument(κ, s) ∈ gammaDomain
  requires reflectedDomain : lGammaArgument(κ, ℂ[1 - s]) ∈ gammaDomain
  shows completedL(N, χ, κ, s) =
    ℂ[rootNumber(N, χ, κ) * completedL(N, conjCharacter(χ), κ, ℂ[1 - s])]
proof
  by_cases one : N = (1:N)
  . rw one
    rw one at character
    exact LFunction.functional_equation_one with character, parity, hs,
      domain, reflectedDomain
  . have two : 2 ≤ N by arith
    exact LFunction.functional_equation_entire with two, character,
      primitive, parity, hs, domain, reflectedDomain

-- The zeros of L(·, χ), χ primitive of parity κ, on re s ≤ 0 are trivial:
-- s = −κ − 2n.
theorem LFunction.zeros_left (N : Nat) (χ : Set) (κ : Nat) (s : Set)
  requires positive : 1 ≤ N
  requires character : DirichletCharacter(N, χ)
  requires primitive : PrimitiveCharacter(N, χ)
  requires parity : HasParity(χ, κ)
  requires hs : s ∈ ℂ
  requires left : complexRe(s) ≤ realZero
  requires zero : LFunction(N, χ, s) = ℂ[0]
  shows ∃ n ∈ ℕ,
    s = ℂ[-(complexOfReal(realNat(κ)) + 2 * complexOfReal(realNat(n)))]
proof
  have values := DirichletCharacter.function with character
  have argument : lGammaArgument(κ, s) ∈ ℂ
    unfold lGammaArgument
    typecheck
  by_cases poleFree : lGammaArgument(κ, s) ∈ gammaDomain
  . exfalso
    have reReal := complexRe.real with hs
    have reflected : ℂ[1 - s] ∈ ℂ by typecheck
    have reflectedRe := complexRe.one_sub with hs
    have atLeastOne : realOne ≤ complexRe(ℂ[1 - s])
      rw reflectedRe
      linarith
    have reflectedPositive : realZero < complexRe(ℂ[1 - s]) by linarith
    have reflectedDomain := lGammaArgument.domain at κ, ℂ[1 - s] with
      reflected, reflectedPositive
    have equation := LFunction.functional_equation with positive, character,
      primitive, parity, hs, poleFree, reflectedDomain
    -- The left side vanishes with L(s, χ).
    have leftArgument := gammaDomain.subset with poleFree
    have leftPower := realCpow.member at R[realNat(N) / realPi],
      lGammaArgument(κ, s) with leftArgument
    have leftGamma := Gamma.member at lGammaArgument(κ, s)
    have vanishing : completedL(N, χ, κ, s) = ℂ[0]
      unfold completedL
      rw zero
      ring
    -- Every factor of the right side is nonzero.
    have tau := gaussSum.member at N, χ with values
    have iMember := complexImaginaryUnit.member
    have iPower := complexPow.member at complexImaginaryUnit, κ with iMember
    have scale : ℂ[complexImaginaryUnit ^ κ *
        complexOfReal(realSqrt(realNat(N)))] ∈ ℂ by typecheck
    have scaleInverse := complexInv.member with scale
    have root : rootNumber(N, χ, κ) ∈ ℂ
      unfold rootNumber
      unfold complexDiv
      typecheck
    have modulus := rootNumber.abs with positive, character, primitive,
      parity
    have rootNonzero : rootNumber(N, χ, κ) ≠ ℂ[0]
      intro rootZero
      rw [rootZero, complexAbs.zero] at modulus
      have one : R[0] < R[1] by typecheck
      linarith
    have conjugate := conjCharacter.character with character
    have conjugateValues := DirichletCharacter.function with conjugate
    have notPole : conjCharacter(χ) ≠ principalCharacter(N) ∨
        ℂ[1 - s] ≠ ℂ[1]
      by_cases sZero : s = ℂ[0]
      . left
        intro principal
        have conjugatePrimitive := conjCharacter.primitive with character,
          primitive
        rw principal at conjugatePrimitive
        have positiveN : 0 < N by arith
        have iff := PrimitiveCharacter.principal_iff with positiveN
        have one := iff.forward with conjugatePrimitive
        rw one at character
        rw [one, sZero] at zero
        have zeroMember : ℂ[0] ∈ ℂ by typecheck
        rw [(LFunction.principal_one with character, zeroMember),
          zeta.zero_value] at zero
        have re := complexOfReal.re at R[-(1 / 2)]
        rw [zero, ← complexOfReal.zero, complexOfReal.re] at re
        have halves := realHalf.add_self
        linarith
      . right
        intro same
        apply sZero
        linear_combination -same
    have lNonzero := LFunction.nonzero_re_ge_one with positive, conjugate,
      reflected, atLeastOne, notPole
    have reflectedArgument := gammaDomain.subset with reflectedDomain
    have power := realCpow.member at R[realNat(N) / realPi],
      lGammaArgument(κ, ℂ[1 - s]) with reflectedArgument
    have powerNonzero := realCpow.nonzero at R[realNat(N) / realPi],
      lGammaArgument(κ, ℂ[1 - s]) with reflectedArgument
    have gamma := Gamma.member at lGammaArgument(κ, ℂ[1 - s])
    have gammaNonzero := Gamma.nonzero with reflectedDomain
    have value := LFunction.closed at N, conjCharacter(χ), ℂ[1 - s] with
      conjugateValues, reflected
    have completed : completedL(N, conjCharacter(χ), κ, ℂ[1 - s]) ∈ ℂ
      unfold completedL
      typecheck
    have product : ℂ[rootNumber(N, χ, κ) *
        completedL(N, conjCharacter(χ), κ, ℂ[1 - s])] = ℂ[0]
      rw [← equation, vanishing]
    have reflectedZero := complexMul.zero_factor with root, completed,
      rootNonzero, product
    unfold completedL at reflectedZero
    have regrouped : ℂ[realCpow(R[realNat(N) / realPi],
        lGammaArgument(κ, ℂ[1 - s])) * ℂ[Gamma(lGammaArgument(κ, ℂ[1 - s])) *
        LFunction(N, conjCharacter(χ), ℂ[1 - s])]] = ℂ[0]
      linear_combination reflectedZero
    have tail : ℂ[Gamma(lGammaArgument(κ, ℂ[1 - s])) *
        LFunction(N, conjCharacter(χ), ℂ[1 - s])] ∈ ℂ by typecheck
    have gammaTimesL := complexMul.zero_factor with power, tail,
      powerNonzero, regrouped
    have lZero := complexMul.zero_factor with gamma, value, gammaNonzero,
      gammaTimesL
    exact lNonzero with lZero
  . -- (s + κ)/2 is a pole −n of Γ, so s = −κ − 2n.
    have pole : lGammaArgument(κ, s) ∈ gammaPoles
      by_contra notPole
      apply poleFree
      unfold gammaDomain
      exact difference.membership.backward with ⟨argument, notPole⟩
    unfold gammaPoles at pole
    obtain ⟨_, n, nMember, shape⟩ := pole
    refine ⟨n, nMember, ?_⟩
    unfold lGammaArgument at shape
    have half := complexHalf.double
    have kappa : complexOfReal(realNat(κ)) ∈ ℂ by typecheck
    have nComplex : complexOfReal(realNat(n)) ∈ ℂ by typecheck
    have halfMember : complexOfReal(R[1 / 2]) ∈ ℂ by typecheck
    linear_combination 2 * shape - (s + complexOfReal(realNat(κ))) * half

-- A zero of L(·, χ), χ primitive, in the critical strip reflects to a zero
-- of L(·, χ̄) at 1 − s.
theorem LFunction.zero_reflect (N : Nat) (χ s : Set)
  requires positive : 1 ≤ N
  requires character : DirichletCharacter(N, χ)
  requires primitive : PrimitiveCharacter(N, χ)
  requires hs : s ∈ ℂ
  requires lower : realZero < complexRe(s)
  requires upper : complexRe(s) < realOne
  requires zero : LFunction(N, χ, s) = ℂ[0]
  shows LFunction(N, conjCharacter(χ), ℂ[1 - s]) = ℂ[0]
proof
  obtain ⟨κ, hκ, parity⟩ := DirichletCharacter.parity with character
  have κNat := nat.omega.backward at κ with hκ
  have domain := lGammaArgument.domain at κ, s with hs, lower
  have reflected : ℂ[1 - s] ∈ ℂ by typecheck
  have reflectedRe := complexRe.one_sub with hs
  have reflectedPositive : realZero < complexRe(ℂ[1 - s])
    rw reflectedRe
    linarith
  have reflectedDomain := lGammaArgument.domain at κ, ℂ[1 - s] with
    reflected, reflectedPositive
  have equation := LFunction.functional_equation with positive, character,
    primitive, parity, hs, domain, reflectedDomain
  -- The left side vanishes with L(s, χ).
  have leftArgument := gammaDomain.subset with domain
  have leftPower := realCpow.member at R[realNat(N) / realPi],
    lGammaArgument(κ, s) with leftArgument
  have leftGamma := Gamma.member at lGammaArgument(κ, s)
  have vanishing : completedL(N, χ, κ, s) = ℂ[0]
    unfold completedL
    rw zero
    ring
  -- The root number has modulus 1, so it is not 0.
  have values := DirichletCharacter.function with character
  have terms := gaussTerms.function at N, χ with values
  have sequence : ComplexSequence(gaussTerms(N, χ)) by exact terms
  have gauss := complexPartialSum.member at gaussTerms(N, χ), N with sequence
  have iMember := complexImaginaryUnit.member
  have iPower := complexPow.member at complexImaginaryUnit, κ with iMember
  have scale : ℂ[complexImaginaryUnit ^ κ *
      complexOfReal(realSqrt(realNat(N)))] ∈ ℂ by typecheck
  have scaleInverse := complexInv.member with scale
  have root : rootNumber(N, χ, κ) ∈ ℂ
    unfold rootNumber
    unfold complexDiv
    unfold gaussSum
    typecheck
  have modulus := rootNumber.abs with positive, character, primitive, parity
  have rootNonzero : rootNumber(N, χ, κ) ≠ ℂ[0]
    intro rootZero
    rw [rootZero, complexAbs.zero] at modulus
    have one : R[0] < R[1] by typecheck
    linarith
  -- The factors of the right side other than L(1 − s, χ̄) do not vanish.
  have conjugate := conjCharacter.character with character
  have conjugateValues := DirichletCharacter.function with conjugate
  have argument := gammaDomain.subset with reflectedDomain
  have power := realCpow.member at R[realNat(N) / realPi],
    lGammaArgument(κ, ℂ[1 - s]) with argument
  have powerNonzero := realCpow.nonzero at R[realNat(N) / realPi],
    lGammaArgument(κ, ℂ[1 - s]) with argument
  have gamma := Gamma.member at lGammaArgument(κ, ℂ[1 - s])
  have gammaNonzero := Gamma.nonzero with reflectedDomain
  have value := LFunction.closed at N, conjCharacter(χ), ℂ[1 - s] with
    conjugateValues, reflected
  have completed : completedL(N, conjCharacter(χ), κ, ℂ[1 - s]) ∈ ℂ
    unfold completedL
    typecheck
  have product : ℂ[rootNumber(N, χ, κ) *
      completedL(N, conjCharacter(χ), κ, ℂ[1 - s])] = ℂ[0]
    rw [← equation, vanishing]
  have reflectedZero := complexMul.zero_factor with root, completed,
    rootNonzero, product
  unfold completedL at reflectedZero
  have regrouped : ℂ[realCpow(R[realNat(N) / realPi],
      lGammaArgument(κ, ℂ[1 - s])) * ℂ[Gamma(lGammaArgument(κ, ℂ[1 - s])) *
      LFunction(N, conjCharacter(χ), ℂ[1 - s])]] = ℂ[0]
    linear_combination reflectedZero
  have tail : ℂ[Gamma(lGammaArgument(κ, ℂ[1 - s])) *
      LFunction(N, conjCharacter(χ), ℂ[1 - s])] ∈ ℂ by typecheck
  have gammaTimesL := complexMul.zero_factor with power, tail, powerNonzero,
    regrouped
  exact complexMul.zero_factor with gamma, value, gammaNonzero, gammaTimesL

end FunctionalEquation
