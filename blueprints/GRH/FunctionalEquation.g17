-- The functional equations. The completed zeta function
-- π^(−s/2) Γ(s/2) ζ(s) is invariant under s ↦ 1 − s, equivalently
-- ζ(1 − s) = 2 (2π)^(−s) cos(πs/2) Γ(s) ζ(s); Hurwitz's formula expresses
-- ζ(1 − s, a) through the periodic zeta functions Σ e^(2πina) n^(−s); the
-- Gauss sum of a primitive character modulo N has modulus √N; and for χ
-- primitive modulo N of parity κ the completed L-function
-- Λ(s, χ) = (N/π)^((s+κ)/2) Γ((s+κ)/2) L(s, χ) satisfies
-- Λ(s, χ) = ε(χ) Λ(1 − s, χ̄) with ε(χ) = τ(χ)/(i^κ √N) of modulus 1. The
-- zeros on re s ≤ 0 are the trivial ones, and a zero in the critical strip
-- reflects to a zero at 1 − s (of ζ, and of L(·, χ̄) for χ primitive).
-- Part of the GRH blueprint.
-- Planned home: NumberTheory/Zeta/FunctionalEquation.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.FunctionalEquation
import GRH.Gamma
import GRH.LFunction

section FunctionalEquation
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Section: Definitions
-- The completed zeta function π^(−s/2) Γ(s/2) ζ(s).
def completedZeta (s : Set) : Set :=
  ℂ[realCpow(realPi, ℂ[-(s * complexOfReal(R[1 / 2]))]) *
    Gamma(ℂ[s * complexOfReal(R[1 / 2])]) * riemannZeta(s)]

-- e^(2πix) for real x.
def expTwoPiI (X : Set) : Set :=
  complexExp(ℂ[complexImaginaryUnit * complexOfReal(R[2 * realPi * X])])

-- The terms e^(2πina) n^(−s), n = 1, 2, …, of the periodic zeta function,
-- indexed from 0 as n + 1, and its sum F(a, s) = Σ_{n≥1} e^(2πina) n^(−s)
-- (convergent for re s > 1, `periodicZeta.series`).
defgraph periodicZetaTerms (a : Real, s : Set) (n ∈ ℕ) : complexCarrier :=
  ℂ[expTwoPiI(R[realNat(n + 1) * a]) * realCpow(realNat(n + 1), ℂ[-s])]
requires hs : s ∈ complexCarrier
proof
  have nNat := nat.omega.backward at n with member
  have negative : ℂ[-s] ∈ ℂ by typecheck
  have power := realCpow.member at realNat(n + 1), ℂ[-s] with negative
  unfold expTwoPiI
  typecheck

def periodicZeta (a : Real, s : Set) : Set :=
  complexSeriesSum(periodicZetaTerms(a, s))

-- The terms χ(j) e^(2πij/N), j = 0, …, N − 1, of the Gauss sum, and the
-- Gauss sum τ(χ) = Σ_{j mod N} χ(j) e^(2πij/N).
defgraph gaussTerms (N : Nat, χ : Set) (j ∈ ℕ) : complexCarrier :=
  ℂ[χ(integerOfNat(j)) * expTwoPiI(R[realNat(j) / realNat(N)])]
requires values : FunctionBetween(χ, ℤ, complexCarrier)
proof
  have jNat := nat.omega.backward at j with member
  have index : integerOfNat(j) ∈ ℤ by typecheck
  have value := FunctionBetween.apply_closed with values, index
  unfold expTwoPiI
  typecheck

def gaussSum (N : Nat, χ : Set) : Set :=
  complexPartialSum(gaussTerms(N, χ), N)

-- The conjugate character χ̄: a ↦ the complex conjugate of χ(a).
def conjCharacter (χ : Set) : Set :=
  { p ∈ ℤ × complexCarrier | ∃ a ∈ ℤ, p = (a, complexConj(χ(a))) }

-- χ has parity κ: κ = 0 and χ(−1) = 1 (χ even), or κ = 1 and χ(−1) = −1
-- (χ odd).
predicate HasParity (χ : Set, κ : Nat) :=
  (κ = (0:N) ∧ χ(integerNegValue(integerOne)) = complexOne) ∨
  (κ = (1:N) ∧ χ(integerNegValue(integerOne)) = ℂ[-1])

-- The argument (s + κ)/2 of the Gamma factor.
def lGammaArgument (κ : Nat, s : Set) : Set :=
  ℂ[(s + complexOfReal(realNat(κ))) * complexOfReal(R[1 / 2])]

-- The completed L-function Λ(s, χ) = (N/π)^((s+κ)/2) Γ((s+κ)/2) L(s, χ).
def completedL (N : Nat, χ : Set, κ : Nat, s : Set) : Set :=
  ℂ[realCpow(R[realNat(N) / realPi], lGammaArgument(κ, s)) *
    Gamma(lGammaArgument(κ, s)) * LFunction(N, χ, s)]

-- The root number ε(χ) = τ(χ)/(i^κ √N).
def rootNumber (N : Nat, χ : Set, κ : Nat) : Set :=
  complexDiv(gaussSum(N, χ),
    ℂ[complexImaginaryUnit ^ κ * complexOfReal(realSqrt(realNat(N)))])

-- Section: Complex arithmetic
-- A product with a nonzero left factor vanishes only with its right one.
theorem complexMul.zero_factor (x y : Set)
  requires hx : x ∈ ℂ
  requires hy : y ∈ ℂ
  requires nonzero : x ≠ ℂ[0]
  requires product : ℂ[x * y] = ℂ[0]
  shows y = ℂ[0]
proof
  have cancel := complexInv.mul_cancel with hx, nonzero
  have inverse := complexInv.member with hx
  linear_combination complexInv(x) * product - y * cancel

theorem complexRe.one
  shows complexRe(ℂ[1]) = R[1]
proof
  have one := complexOfReal.one
  rw [← one, complexOfReal.re]

-- re(1 − s) = 1 − re s.
theorem complexRe.one_sub (s : Set)
  requires hs : s ∈ ℂ
  shows complexRe(ℂ[1 - s]) = R[1 - complexRe(s)]
proof
  have one := complexOne.member
  rw [(complexRe.sub with one, hs), complexRe.one]

-- A point with re s < 1 is not 1.
theorem complex.ne_one_of_re_lt (s : Set)
  requires below : complexRe(s) < realOne
  shows s ≠ ℂ[1]
proof
  intro same
  rw [same, complexRe.one] at below
  linarith

-- A point with re s > 0 is not 0.
theorem complex.ne_zero_of_re_pos (s : Set)
  requires above : realZero < complexRe(s)
  shows s ≠ ℂ[0]
proof
  intro same
  have zero := complexOfReal.zero
  rw [same, ← zero, complexOfReal.re] at above
  linarith

-- For re s > 0, (s + κ)/2 is not a pole of Γ.
theorem lGammaArgument.domain (κ : Nat) (s : Set)
  requires hs : s ∈ ℂ
  requires positive : realZero < complexRe(s)
  shows lGammaArgument(κ, s) ∈ gammaDomain
proof
  have cast : complexOfReal(realNat(κ)) ∈ ℂ by typecheck
  have half : complexOfReal(R[1 / 2]) ∈ ℂ by typecheck
  have shifted : ℂ[s + complexOfReal(realNat(κ))] ∈ ℂ by typecheck
  have argument : lGammaArgument(κ, s) ∈ ℂ
    unfold lGammaArgument
    typecheck
  have re : complexRe(lGammaArgument(κ, s)) =
      R[(complexRe(s) + realNat(κ)) * (1 / 2)]
    unfold lGammaArgument
    rw [(complexRe.mul with shifted, half), (complexRe.add with hs, cast),
      complexOfReal.re, complexOfReal.re, complexOfReal.im]
    ring
  have nonnegative := realNat.nonnegative at κ
  have reReal := complexRe.real with hs
  have sumPositive : R[0] < R[complexRe(s) + realNat(κ)] by linarith
  have halves := realHalf.add_self
  have halfPositive : R[0] < R[1 / 2] by linarith
  have product := realLess.mul_right_of_positive with sumPositive,
    halfPositive
  have zeroProduct : R[0 * (1 / 2)] = R[0] by ring
  have positiveArgument : realZero < complexRe(lGammaArgument(κ, s))
    rw re
    linarith
  exact gammaDomain.of_re_positive with argument, positiveArgument

-- Section: Characters
theorem complexOne.nonzero
  shows ℂ[1] ≠ ℂ[0]
proof
  intro vanish
  have size := complexAbs.one
  rw [vanish, complexAbs.zero] at size
  linarith

-- A prime is not coprime to 0.
theorem IntegerCoprime.prime_zero (p : Nat)
  requires prime : Prime(p)
  shows ¬IntegerCoprime(integerOfNat(p), integerOfNat(0))
proof
  intro coprime
  unfold IntegerCoprime at coprime
  rw [integerGCD.ofNat, gcd.zero_right] at coprime
  have greater := Prime.greater_than_one with prime
  arith

-- For N > 0 every value of a character has absolute value at most 1.
theorem DirichletCharacter.abs_le_one (d : Nat) (ψ a : Set)
  requires character : DirichletCharacter(d, ψ)
  requires positive : 0 < d
  requires integer : a ∈ ℤ
  shows complexAbs(ψ(a)) ≤ R[1]
proof
  have value := DirichletCharacter.value with character, integer
  have nonnegative := complexAbs.nonnegative with value
  have square := complexAbs.square with value
  have bound := DirichletCharacter.norm_le_one with character, positive,
    integer
  by_contra large
  have above : R[1] < complexAbs(ψ(a)) by linarith
  have absPositive : R[0] < complexAbs(ψ(a)) by linarith
  have product := realLess.mul_right_of_positive with above, absPositive
  have unit : R[1 * complexAbs(ψ(a))] = complexAbs(ψ(a)) by ring
  linarith

-- A level factor does not vanish on re s > 0.
theorem levelFactor.nonzero (N d : Nat) (ψ s : Set) (p : Nat)
  requires character : DirichletCharacter(d, ψ)
  requires hs : s ∈ ℂ
  requires positive : realZero < complexRe(s)
  shows levelFactor(N, ψ, s, p) ≠ ℂ[0]
proof
  have values := DirichletCharacter.function with character
  obtain ⟨factor, yes, no⟩ := levelFactor.selected at N, ψ, s, p with
    values, hs
  by_cases dividing : Prime(p) ∧ p ∣ N
  . rw (yes with dividing)
    intro vanishing
    have index : integerOfNat(p) ∈ ℤ by typecheck
    have value := FunctionBetween.apply_closed with values, index
    have negative : ℂ[-s] ∈ ℂ by typecheck
    have power := realCpow.member at realNat(p), ℂ[-s] with negative
    have unit : ℂ[ψ(integerOfNat(p)) * realCpow(realNat(p), ℂ[-s])] = ℂ[1]
      by linear_combination -vanishing
    have prime := dividing.left
    by_cases zeroLevel : d = (0:N)
    . have notCoprime := IntegerCoprime.prime_zero with prime
      rw ← zeroLevel at notCoprime
      have vanishes := DirichletCharacter.not_coprime with character, index,
        notCoprime
      rw vanishes at unit
      have collapse : ℂ[0 * realCpow(realNat(p), ℂ[-s])] = ℂ[0] by ring
      rw collapse at unit
      have one := complexOne.nonzero
      symm at unit
      exact one with unit
    . have levelPositive : 0 < d by arith
      have absolute := complexAbs.mul with value, power
      rw [unit, complexAbs.one] at absolute
      have valueBound := DirichletCharacter.abs_le_one with character,
        levelPositive, index
      have greater := Prime.greater_than_one with prime
      have atLeast : 1 ≤ p by arith
      have powerAbs := realCpow.nat_neg_abs with atLeast, hs
      have baseLess := realNat.lt_of_lt at 1, p with greater
      rw realNat.one at baseLess
      have exponentLess : R[-complexRe(s)] < R[0] by linarith
      have smaller := realRpow.lt_of_exponent with baseLess, exponentLess
      rw realRpow.zero at smaller
      have powerNonnegative := complexAbs.nonnegative with power
      have scaled := realLe.mul_right_of_nonnegative with valueBound,
        powerNonnegative
      have unitScale : R[1 * complexAbs(realCpow(realNat(p), ℂ[-s]))] =
        complexAbs(realCpow(realNat(p), ℂ[-s])) by ring
      linarith
  . rw (no with dividing)
    exact complexOne.nonzero

-- The level factors ∏_{p ∣ N} (1 − ψ(p) p^(−s)) do not vanish on
-- re s > 0, where |ψ(p) p^(−s)| ≤ p^(−re s) < 1.
theorem levelProduct.nonzero (N d : Nat) (ψ s : Set) (n : Nat)
  requires character : DirichletCharacter(d, ψ)
  requires hs : s ∈ ℂ
  requires positive : realZero < complexRe(s)
  shows levelProduct(N, ψ, s, n) ≠ ℂ[0]
proof
  have values := DirichletCharacter.function with character
  induction n
  | zero =>
    rw levelProduct
    exact complexOne.nonzero
  | succ(k) using ih =>
    have previous := levelProduct.member at N, ψ, s, k with values, hs
    obtain ⟨factor, _⟩ := levelFactor.selected at N, ψ, s, k with values, hs
    have factorNonzero := levelFactor.nonzero at N, d, ψ, s, k with
      character, hs, positive
    rw levelProduct
    intro vanishing
    have zero := complexMul.zero_factor with previous, factor, ih, vanishing
    exact factorNonzero with zero

-- The conjugate character.
theorem conjCharacter.pair (χ x y : Set)
  requires member : (x, y) ∈ conjCharacter(χ)
  shows x ∈ ℤ ∧ y = complexConj(χ(x))
proof
  unfold conjCharacter at member
  obtain ⟨bound, a, aInteger, shape⟩ := member
  obtain ⟨first, second⟩ := orderedPair.injective with shape
  rw [first, second]
  exact ⟨aInteger, rfl⟩

theorem conjCharacter.functional (χ : Set)
  shows Functional(conjCharacter(χ))
proof
  intros x y first z second
  obtain ⟨_, firstValue⟩ := conjCharacter.pair with first
  obtain ⟨_, secondValue⟩ := conjCharacter.pair with second
  rw [firstValue, secondValue]

theorem conjCharacter.bounded (χ : Set)
  shows conjCharacter(χ) ⊆ ℤ × complexCarrier
proof
  intros p member
  unfold conjCharacter at member
  exact member.left

theorem conjCharacter.apply (χ a : Set)
  requires values : FunctionBetween(χ, ℤ, complexCarrier)
  requires integer : a ∈ ℤ
  shows conjCharacter(χ)(a) = complexConj(χ(a))
proof
  have value := FunctionBetween.apply_closed with values, integer
  have conjugate := complexConj.member with value
  have member : (a, complexConj(χ(a))) ∈ conjCharacter(χ)
    unfold conjCharacter
    have pair := product.pair with integer, conjugate
    exact ⟨pair, a, integer, rfl⟩
  exact graph.apply with (conjCharacter.bounded at χ),
    (conjCharacter.functional at χ), member

theorem conjCharacter.function (χ : Set)
  requires values : FunctionBetween(χ, ℤ, complexCarrier)
  shows FunctionBetween(conjCharacter(χ), ℤ, complexCarrier)
proof
  refine ⟨(conjCharacter.bounded at χ), (conjCharacter.functional at χ), ?_⟩
  intros a integer
  have value := FunctionBetween.apply_closed with values, integer
  have conjugate := complexConj.member with value
  refine ⟨complexConj(χ(a)), conjugate, ?_⟩
  unfold relates
  unfold conjCharacter
  have pair := product.pair with integer, conjugate
  exact ⟨pair, a, integer, rfl⟩

theorem conjCharacter.character (N : Nat) (χ : Set)
  requires character : DirichletCharacter(N, χ)
  shows DirichletCharacter(N, conjCharacter(χ))
proof
  have values := DirichletCharacter.function with character
  have function := conjCharacter.function with values
  refine ⟨function, ?_, ?_, ?_, ?_⟩
  . intros a integer
    have shifted : integerAddValue(a, integerOfNat(N)) ∈ ℤ by typecheck
    have periodic := DirichletCharacter.periodic with character, integer
    rw [(conjCharacter.apply with values, shifted),
      (conjCharacter.apply with values, integer), periodic]
  . have one : integerOne ∈ ℤ by typecheck
    rw [(conjCharacter.apply with values, one),
      (DirichletCharacter.one with character)]
    exact GRH.Exp.complexConj.one
  . intros a aInteger b bInteger
    have product : integerMulValue(a, b) ∈ ℤ by typecheck
    have aValue := FunctionBetween.apply_closed with values, aInteger
    have bValue := FunctionBetween.apply_closed with values, bInteger
    rw [(conjCharacter.apply with values, product),
      (conjCharacter.apply with values, aInteger),
      (conjCharacter.apply with values, bInteger),
      (DirichletCharacter.mul with character, aInteger, bInteger)]
    exact complexConj.mul with aValue, bValue
  . intros a integer notCoprime
    rw [(conjCharacter.apply with values, integer),
      (DirichletCharacter.not_coprime with character, integer, notCoprime)]
    exact complexConj.zero

-- χ factors through d exactly when χ̄ does.
theorem FactorsThrough.conj (N : Nat) (χ : Set) (d : Nat)
  requires values : FunctionBetween(χ, ℤ, complexCarrier)
  requires factors : FactorsThrough(N, χ, d)
  shows FactorsThrough(N, conjCharacter(χ), d)
proof
  obtain ⟨divides, ψ, character, agree⟩ := factors
  have conjugate := conjCharacter.character with character
  have ψValues := DirichletCharacter.function with character
  refine ⟨divides, conjCharacter(ψ), conjugate, ?_⟩
  intros a integer coprime
  rw [(conjCharacter.apply with values, integer),
    (conjCharacter.apply with ψValues, integer),
    (agree with a, integer, coprime)]

theorem FactorsThrough.of_conj (N : Nat) (χ : Set) (d : Nat)
  requires values : FunctionBetween(χ, ℤ, complexCarrier)
  requires factors : FactorsThrough(N, conjCharacter(χ), d)
  shows FactorsThrough(N, χ, d)
proof
  obtain ⟨divides, ψ, character, agree⟩ := factors
  have conjugate := conjCharacter.character with character
  have ψValues := DirichletCharacter.function with character
  refine ⟨divides, conjCharacter(ψ), conjugate, ?_⟩
  intros a integer coprime
  have same := agree with a, integer, coprime
  rw (conjCharacter.apply with values, integer) at same
  have value := FunctionBetween.apply_closed with values, integer
  rw [(conjCharacter.apply with ψValues, integer), ← same,
    (complexConj.involutive with value)]

theorem conjCharacter.primitive (N : Nat) (χ : Set)
  requires character : DirichletCharacter(N, χ)
  requires primitive : PrimitiveCharacter(N, χ)
  shows PrimitiveCharacter(N, conjCharacter(χ))
proof
  have values := DirichletCharacter.function with character
  have conjugate := conjCharacter.character with character
  have conductorNat := conductor.natural with conjugate
  have factors := conductor.factors with conjugate
  have back := FactorsThrough.of_conj with values, factors
  have lower := conductor.least with character, back
  have self := FactorsThrough.self with conjugate
  have upper := conductor.least with conjugate, self
  unfold PrimitiveCharacter at primitive
  unfold PrimitiveCharacter
  rw primitive at lower
  arith

theorem conjCharacter.parity (N : Nat) (χ : Set) (κ : Nat)
  requires character : DirichletCharacter(N, χ)
  requires parity : HasParity(χ, κ)
  shows HasParity(conjCharacter(χ), κ)
proof
  have values := DirichletCharacter.function with character
  have minus : integerNegValue(integerOne) ∈ ℤ by typecheck
  have value := conjCharacter.apply with values, minus
  unfold HasParity at parity
  unfold HasParity
  cases parity with even | odd
  . left
    refine ⟨even.left, ?_⟩
    rw [value, even.right]
    exact GRH.Exp.complexConj.one
  . right
    refine ⟨odd.left, ?_⟩
    have one := complexOne.member
    rw [value, odd.right, (GRH.Exp.complexConj.neg with one), GRH.Exp.complexConj.one]

-- Every character is even or odd.
theorem DirichletCharacter.parity (N : Nat) (χ : Set)
  requires character : DirichletCharacter(N, χ)
  shows ∃ κ ∈ ℕ, HasParity(χ, κ)
proof
  have values := DirichletCharacter.neg_one with character
  cases values with even | odd
  . have zeroNat : (0:N) ∈ ℕ by typecheck
    refine ⟨(0:N), zeroNat, ?_⟩
    unfold HasParity
    left
    exact ⟨rfl, even⟩
  . have oneNat : (1:N) ∈ ℕ by typecheck
    refine ⟨(1:N), oneNat, ?_⟩
    unfold HasParity
    right
    exact ⟨rfl, odd⟩

-- Section: The Riemann zeta function
-- The functional equation ξ(s) = ξ(1 − s) of the completed zeta function,
-- s ∉ {1, 0, −2, −4, …} (s/2 and (1 − s)/2 not poles of Γ).
theorem zeta.functional_equation (s : Set)
  requires hs : s ∈ ℂ
  requires halfDomain : ℂ[s * complexOfReal(R[1 / 2])] ∈ gammaDomain
  requires reflectedDomain :
    ℂ[(1 - s) * complexOfReal(R[1 / 2])] ∈ gammaDomain
  shows completedZeta(s) = completedZeta(ℂ[1 - s])
proof
  sorry

-- The asymmetric form ζ(1 − s) = 2 (2π)^(−s) cos(πs/2) Γ(s) ζ(s), s ≠ 1
-- and s not a pole of Γ.
theorem zeta.functional_equation_asymm (s : Set)
  requires hs : s ∈ gammaDomain
  requires notOne : s ≠ ℂ[1]
  shows riemannZeta(ℂ[1 - s]) =
    ℂ[2 * realCpow(R[2 * realPi], ℂ[-s]) *
      complexCos(ℂ[complexOfReal(realPi) * s * complexOfReal(R[1 / 2])]) *
      Gamma(s) * riemannZeta(s)]
proof
  sorry

-- The only zeros of ζ on re s ≤ 0 are the trivial zeros −2, −4, ….
theorem zeta.zeros_left (s : Set)
  requires hs : s ∈ ℂ
  requires left : complexRe(s) ≤ realZero
  requires zero : riemannZeta(s) = ℂ[0]
  shows ∃ n ∈ ℕ, s = ℂ[-2 * (complexOfReal(realNat(n)) + 1)]
proof
  sorry

-- A zero of ζ in the critical strip reflects to a zero at 1 − s.
theorem zeta.zero_reflect (s : Set)
  requires hs : s ∈ ℂ
  requires lower : realZero < complexRe(s)
  requires upper : complexRe(s) < realOne
  requires zero : riemannZeta(s) = ℂ[0]
  shows riemannZeta(ℂ[1 - s]) = ℂ[0]
proof
  have domain := gammaDomain.of_re_positive with hs, lower
  have notOne := complex.ne_one_of_re_lt with upper
  have equation := zeta.functional_equation_asymm with domain, notOne
  rw [equation, zero]
  ring

-- Section: Hurwitz's formula
-- For re s > 1 the periodic zeta series converges absolutely.
theorem periodicZeta.series (a : Real) (s : Set)
  requires hs : s ∈ ℂ
  requires halfPlane : realOne < complexRe(s)
  shows ComplexSumsTo(periodicZetaTerms(a, s), periodicZeta(a, s)) ∧
    ComplexAbsolutelySummable(periodicZetaTerms(a, s))
proof
  have terms := periodicZetaTerms.function at a, s with hs
  have sequence : ComplexSequence(periodicZetaTerms(a, s)) by exact terms
  -- Absolute convergence, against Σ n^(−σ).
  obtain ⟨_, absoluteZeta⟩ := zeta.series with hs, halfPlane
  obtain ⟨zetaSequence, zetaSummable⟩ := absoluteZeta
  have negative : ℂ[-s] ∈ ℂ by typecheck
  have bound : ∀ k ∈ ℕ, complexAbs(periodicZetaTerms(a, s)(k)) ≤
      complexAbsSequence(zetaSeriesTerms(s))(k)
    intros k kMember
    have kNat := nat.omega.backward with kMember
    have power := realCpow.member at realNat(k + 1), ℂ[-s] with negative
    have phase : expTwoPiI(R[realNat(k + 1) * a]) ∈ ℂ
      unfold expTwoPiI
      typecheck
    have unit : complexAbs(expTwoPiI(R[realNat(k + 1) * a])) = R[1]
      unfold expTwoPiI
      exact complexExp.abs_i_mul at R[2 * realPi * (realNat(k + 1) * a)]
    rw [(periodicZetaTerms.value at a, s, k with hs),
      (complexAbsSequence.value with zetaSequence),
      (zetaSeriesTerms.value with hs, kMember),
      (complexAbs.mul with phase, power), unit]
    have powerAbs := complexAbs.real with power
    have same : R[1 * complexAbs(realCpow(realNat(k + 1), ℂ[-s]))] =
      complexAbs(realCpow(realNat(k + 1), ℂ[-s])) by ring
    linarith
  have absolute := ComplexAbsolutelySummable.of_bound with sequence,
    zetaSummable, bound
  have summable := ComplexAbsolutelySummable.summable with absolute
  obtain ⟨_, sums⟩ := complexSeriesSum.selected with summable
  unfold periodicZeta
  exact ⟨sums, absolute⟩

-- Hurwitz's formula: for 0 < a ≤ 1 and re s > 1,
-- ζ(1 − s, a) = Γ(s) (2π)^(−s) (e^(−πis/2) F(a, s) + e^(πis/2) F(−a, s)).
theorem hurwitzZeta.functional_equation (a : Real) (s : Set)
  requires positive : R[0] < a
  requires atMostOne : a ≤ R[1]
  requires hs : s ∈ ℂ
  requires halfPlane : realOne < complexRe(s)
  shows hurwitzZeta(ℂ[1 - s], a) =
    ℂ[Gamma(s) * realCpow(R[2 * realPi], ℂ[-s]) *
      (complexExp(ℂ[-(complexImaginaryUnit * complexOfReal(realPi) * s *
          complexOfReal(R[1 / 2]))]) * periodicZeta(a, s) +
        complexExp(ℂ[complexImaginaryUnit * complexOfReal(realPi) * s *
          complexOfReal(R[1 / 2])]) * periodicZeta(R[-a], s))]
proof
  sorry

-- Section: Gauss sums
theorem expTwoPiI.member (X : Real)
  shows expTwoPiI(X) ∈ ℂ
proof
  unfold expTwoPiI
  typecheck

-- e(x + y) = e(x) e(y).
theorem expTwoPiI.add (X Y : Real)
  shows expTwoPiI(R[X + Y]) = ℂ[expTwoPiI(X) * expTwoPiI(Y)]
proof
  have iMember := complexImaginaryUnit.member
  have xMember : complexOfReal(R[2 * realPi * X]) ∈ ℂ by typecheck
  have yMember : complexOfReal(R[2 * realPi * Y]) ∈ ℂ by typecheck
  have first : ℂ[complexImaginaryUnit * complexOfReal(R[2 * realPi * X])] ∈ ℂ
    by typecheck
  have second : ℂ[complexImaginaryUnit *
    complexOfReal(R[2 * realPi * Y])] ∈ ℂ by typecheck
  have sum := complexExp.add with first, second
  have split : R[2 * realPi * (X + Y)] = R[2 * realPi * X + 2 * realPi * Y]
    by ring
  have argument : ℂ[complexImaginaryUnit *
      complexOfReal(R[2 * realPi * (X + Y)])] =
      ℂ[complexImaginaryUnit * complexOfReal(R[2 * realPi * X]) +
        complexImaginaryUnit * complexOfReal(R[2 * realPi * Y])]
    rw [split, complexOfReal.add]
    ring
  unfold expTwoPiI
  rw [argument, sum]

-- The conjugate of e(x) is e(−x).
theorem expTwoPiI.conj (X : Real)
  shows complexConj(expTwoPiI(X)) = expTwoPiI(R[-X])
proof
  have iMember := complexImaginaryUnit.member
  have xMember : complexOfReal(R[2 * realPi * X]) ∈ ℂ by typecheck
  have negated : R[2 * realPi * -X] = R[-(2 * realPi * X)] by ring
  have argument : ℂ[complexImaginaryUnit *
      complexOfReal(R[2 * realPi * -X])] =
      ℂ[-(complexImaginaryUnit * complexOfReal(R[2 * realPi * X]))]
    rw [negated, complexOfReal.neg]
    ring
  unfold expTwoPiI
  rw argument
  exact complexExp.conj_i_real at R[2 * realPi * X]

theorem expTwoPiI.abs (X : Real)
  shows complexAbs(expTwoPiI(X)) = R[1]
proof
  unfold expTwoPiI
  exact complexExp.abs_i_mul at R[2 * realPi * X]

-- e(k) = 1 for an integer k.
theorem expTwoPiI.integer (k : Integer)
  shows expTwoPiI(realInt(k)) = ℂ[1]
proof
  have iMember := complexImaginaryUnit.member
  have argument : ℂ[complexImaginaryUnit *
      complexOfReal(R[2 * realPi * realInt(k)])] ∈ ℂ by typecheck
  have kMember : k ∈ ℤ by typecheck
  have iff := complexExp.eq_one_iff with argument
  unfold expTwoPiI
  apply iff.backward
  refine ⟨k, kMember, ?_⟩
  ring

theorem expTwoPiI.nat (n : Nat)
  shows expTwoPiI(realNat(n)) = ℂ[1]
proof
  rw ← realInt.nat
  exact expTwoPiI.integer at integerOfNat(n)

theorem expTwoPiI.zero
  shows expTwoPiI(R[0]) = ℂ[1]
proof
  have zero := expTwoPiI.nat at 0
  rw realNat.zero at zero
  exact zero

-- e(x) ≠ 1 for x strictly between consecutive integers.
theorem expTwoPiI.ne_one (k : Integer) (X : Real)
  requires lower : realInt(k) < X
  requires upper : X < R[realInt(k) + 1]
  shows expTwoPiI(X) ≠ ℂ[1]
proof
  intro one
  have iMember := complexImaginaryUnit.member
  have argument : ℂ[complexImaginaryUnit *
      complexOfReal(R[2 * realPi * X])] ∈ ℂ by typecheck
  have iff := complexExp.eq_one_iff with argument
  unfold expTwoPiI at one
  obtain ⟨j, jMember, same⟩ := iff.forward with one
  have left : complexOfReal(R[2 * realPi * X]) ∈ ℂ by typecheck
  have right : complexOfReal(R[2 * realPi * realInt(j)]) ∈ ℂ by typecheck
  have square := complexImaginaryUnit.square
  have equal : complexOfReal(R[2 * realPi * X]) =
      complexOfReal(R[2 * realPi * realInt(j)])
    linear_combination (-complexImaginaryUnit) * same +
      (complexOfReal(R[2 * realPi * X]) -
        complexOfReal(R[2 * realPi * realInt(j)])) * square
  have reals := complexOfReal.injective with equal
  have piPositive := realPi.positive
  have twoPi : R[2 * realPi] ≠ R[0]
    intro vanish
    linarith
  have inverse := realInvValue.mul_right with twoPi
  have recovered : X = realInt(j)
    linear_combination realInvValue(R[2 * realPi]) * reals -
      (X - realInt(j)) * inverse
  have outside := realInt.not_between with lower, upper
  exact outside with j, jMember, recovered

-- The terms e(l x), l = 0, 1, 2, ….
defgraph additiveTerms (X : Real) (l ∈ ℕ) : complexCarrier :=
  expTwoPiI(R[realNat(l) * X])
proof
  have lNat := nat.omega.backward at l with member
  exact expTwoPiI.member at R[realNat(l) * X]

-- (e(x) − 1) Σ_{l<n} e(l x) = e(n x) − 1.
theorem additiveTerms.telescope (X : Real) (n : Nat)
  shows ℂ[(expTwoPiI(X) - 1) * complexPartialSum(additiveTerms(X), n)] =
    ℂ[expTwoPiI(R[realNat(n) * X]) - 1]
proof
  induction n
  | zero =>
    have zeroProduct : R[realNat(0) * X] = R[0]
      rw realNat.zero
      ring
    have base := expTwoPiI.member at X
    rw [complexPartialSum.zero, zeroProduct, expTwoPiI.zero]
    ring
  | succ(k) using ih =>
    have base := expTwoPiI.member at X
    have terms := additiveTerms.function at X
    have sequence : ComplexSequence(additiveTerms(X)) by exact terms
    have previous := complexPartialSum.member at additiveTerms(X), k with
      sequence
    have kMember : k ∈ ℕ by typecheck
    have term := additiveTerms.value at X, k with kMember
    have power := expTwoPiI.member at R[realNat(k) * X]
    have shift : R[realNat(succ(k)) * X] = R[realNat(k) * X + X]
      rw realNat.succ
      ring
    have split := expTwoPiI.add at R[realNat(k) * X], X
    rw [complexPartialSum.succ, term, shift, split]
    linear_combination ih

-- Σ_{l<n} e(l x) = 0 when e(x) ≠ 1 and e(n x) = 1.
theorem additiveTerms.sum_zero (X : Real) (n : Nat)
  requires nontrivial : expTwoPiI(X) ≠ ℂ[1]
  requires period : expTwoPiI(R[realNat(n) * X]) = ℂ[1]
  shows complexPartialSum(additiveTerms(X), n) = ℂ[0]
proof
  have telescope := additiveTerms.telescope at X, n
  rw period at telescope
  have base := expTwoPiI.member at X
  have difference : ℂ[expTwoPiI(X) - 1] ∈ ℂ by typecheck
  have nonzero : ℂ[expTwoPiI(X) - 1] ≠ ℂ[0]
    intro vanish
    apply nontrivial
    linear_combination vanish
  have terms := additiveTerms.function at X
  have sequence : ComplexSequence(additiveTerms(X)) by exact terms
  have sum := complexPartialSum.member at additiveTerms(X), n with sequence
  have product : ℂ[(expTwoPiI(X) - 1) *
      complexPartialSum(additiveTerms(X), n)] = ℂ[0]
    rw telescope
    ring
  exact complexMul.zero_factor with difference, sum, nonzero, product

-- Σ_{l<n} e(0) = n.
theorem additiveTerms.sum_trivial (n : Nat)
  shows complexPartialSum(additiveTerms(R[0]), n) = complexOfReal(realNat(n))
proof
  induction n
  | zero =>
    rw [complexPartialSum.zero, realNat.zero, complexOfReal.zero]
  | succ(k) using ih =>
    have kMember : k ∈ ℕ by typecheck
    have term := additiveTerms.value at R[0], k with kMember
    have zeroProduct : R[realNat(k) * 0] = R[0] by ring
    have next : realNat(succ(k)) = R[realNat(k) + 1]
      rw realNat.succ
      ring
    rw [complexPartialSum.succ, term, zeroProduct, expTwoPiI.zero, ih,
      next, complexOfReal.add, complexOfReal.one]

-- A sum of zeros vanishes.
theorem complexPartialSum.zeros (u : Set) (n : Nat)
  requires vanishing : ∀ k ∈ ℕ, u(k) = ℂ[0]
  shows complexPartialSum(u, n) = ℂ[0]
proof
  induction n
  | zero =>
    rw complexPartialSum.zero
  | succ(k) using ih =>
    have kMember : k ∈ ℕ by typecheck
    rw [complexPartialSum.succ, ih, (vanishing with k, kMember)]
    ring

-- The conjugate of a sum is the sum of the conjugates.
theorem complexPartialSum.conj_terms (u v : Set) (n : Nat)
  requires sequence : ComplexSequence(u)
  requires conjugates : ∀ k ∈ ℕ, v(k) = complexConj(u(k))
  shows complexConj(complexPartialSum(u, n)) = complexPartialSum(v, n)
proof
  induction n
  | zero =>
    rw [complexPartialSum.zero, complexPartialSum.zero]
    exact GRH.Exp.complexConj.zero
  | succ(k) using ih =>
    have kMember : k ∈ ℕ by typecheck
    have previous := complexPartialSum.member at u, k with sequence
    have term := FunctionBetween.apply_closed with sequence, kMember
    rw [complexPartialSum.succ, complexPartialSum.succ,
      (complexConj.add with previous, term), ih,
      (conjugates with k, kMember)]

-- A sum whose terms below n ≥ 2 vanish except at index 1.
theorem complexPartialSum.only_one (u : Set) (n : Nat)
  requires sequence : ComplexSequence(u)
  requires two : 2 ≤ n
  requires vanishing : ∀ k ∈ ℕ, k < n → k ≠ (1:N) → u(k) = ℂ[0]
  shows complexPartialSum(u, n) = u((1:N))
proof
  induction n
  | zero =>
    intros two vanishing
    exfalso
    arith
  | succ(k) using ih =>
    intros two vanishing
    have kMember : k ∈ ℕ by typecheck
    have term := FunctionBetween.apply_closed with sequence, kMember
    by_cases small : k < 2
    . have one : k = (1:N) by arith
      have zeroMember : (0:N) ∈ ℕ by typecheck
      have zeroBelow : (0:N) < succ(k) by arith
      have zeroOther : (0:N) ≠ (1:N) by arith
      have zeroVanish := vanishing with (0:N), zeroMember, zeroBelow,
        zeroOther
      rw [complexPartialSum.succ, one, complexPartialSum.succ,
        complexPartialSum.zero, zeroVanish]
      ring
    . have atLeast : 2 ≤ k by arith
      have restricted : ∀ j ∈ ℕ, j < k → j ≠ (1:N) → u(j) = ℂ[0]
        intros j jMember below other
        have larger : j < succ(k) by arith
        exact vanishing with j, jMember, larger, other
      have previous := ih with atLeast, restricted
      have below : k < succ(k) by arith
      have other : k ≠ (1:N) by arith
      have last := vanishing with k, kMember, below, other
      rw [complexPartialSum.succ, previous, last]
      ring

-- A grid of complex numbers F(j, l), its rows l and columns j, and their
-- sums.
defgraph gridRow (F : Set, l : Nat) (j ∈ ℕ) : complexCarrier := F((j, l))
requires grid : FunctionBetween(F, ℕ × ℕ, complexCarrier)
proof
  have lMember : l ∈ ℕ by typecheck
  have pair := product.pair with member, lMember
  exact FunctionBetween.apply_closed with grid, pair

defgraph gridColumn (F : Set, j : Nat) (l ∈ ℕ) : complexCarrier := F((j, l))
requires grid : FunctionBetween(F, ℕ × ℕ, complexCarrier)
proof
  have jMember : j ∈ ℕ by typecheck
  have pair := product.pair with jMember, member
  exact FunctionBetween.apply_closed with grid, pair

defgraph gridRowSums (F : Set, J : Nat) (l ∈ ℕ) : complexCarrier :=
  complexPartialSum(gridRow(F, l), J)
requires grid : FunctionBetween(F, ℕ × ℕ, complexCarrier)
proof
  have lNat := nat.omega.backward at l with member
  have row := gridRow.function at F, l with grid
  have sequence : ComplexSequence(gridRow(F, l)) by exact row
  exact complexPartialSum.member with sequence

defgraph gridColumnSums (F : Set, L : Nat) (j ∈ ℕ) : complexCarrier :=
  complexPartialSum(gridColumn(F, j), L)
requires grid : FunctionBetween(F, ℕ × ℕ, complexCarrier)
proof
  have jNat := nat.omega.backward at j with member
  have column := gridColumn.function at F, j with grid
  have sequence : ComplexSequence(gridColumn(F, j)) by exact column
  exact complexPartialSum.member with sequence

-- Summing a grid by rows or by columns gives the same total.
theorem gridRowSums.swap (F : Set) (J L : Nat)
  requires grid : FunctionBetween(F, ℕ × ℕ, complexCarrier)
  shows complexPartialSum(gridRowSums(F, J), L) =
    complexPartialSum(gridColumnSums(F, L), J)
proof
  induction L
  | zero =>
    have zeros : ∀ j ∈ ℕ, gridColumnSums(F, 0)(j) = ℂ[0]
      intros j jMember
      have jNat := nat.omega.backward at j with jMember
      rw [(gridColumnSums.value at F, 0, j with grid), complexPartialSum.zero]
    rw [complexPartialSum.zero, (complexPartialSum.zeros with zeros)]
  | succ(k) using ih =>
    have kMember : k ∈ ℕ by typecheck
    have columns := gridColumnSums.function at F, k with grid
    have columnSequence : ComplexSequence(gridColumnSums(F, k)) by
      exact columns
    have row := gridRow.function at F, k with grid
    have rowSequence : ComplexSequence(gridRow(F, k)) by exact row
    have add := complexPartialSum.add_terms at gridColumnSums(F, k),
      gridRow(F, k), gridColumnSums(F, succ(k)), J with columnSequence,
      rowSequence
    have termwise : ∀ j ∈ ℕ, j < J → gridColumnSums(F, succ(k))(j) =
        ℂ[gridColumnSums(F, k)(j) + gridRow(F, k)(j)]
      intros j jMember below
      have jNat := nat.omega.backward at j with jMember
      rw [(gridColumnSums.value at F, succ(k), j with grid),
        (gridColumnSums.value at F, k, j with grid),
        (gridRow.value at F, k, j with grid), complexPartialSum.succ,
        (gridColumn.value at F, j, k with grid)]
    have combined := add with termwise
    rw [complexPartialSum.succ, ih, combined,
      (gridRowSums.value at F, J, k with grid)]

-- e(a/N) = e(b/N) for a ≡ b modulo N.
theorem expTwoPiI.congruent (N a b : Nat)
  requires positive : 0 < N
  requires congruent : IntegerCongruent(integerOfNat(N), integerOfNat(a),
    integerOfNat(b))
  shows expTwoPiI(R[realNat(a) * realInvValue(realNat(N))]) =
    expTwoPiI(R[realNat(b) * realInvValue(realNat(N))])
proof
  obtain ⟨q, qInteger, multiple⟩ := congruent
  have same := realInt.mul at integerOfNat(N), q
  rw [multiple, realInt.sub, realInt.nat, realInt.nat, realInt.nat] at same
  have nonzero : N ≠ (0:N) by arith
  have nonzeroReal := realNat.ne_zero with nonzero
  have inverse := realInvValue.mul_right with nonzeroReal
  have shift : R[realNat(a) * realInvValue(realNat(N))] =
      R[realNat(b) * realInvValue(realNat(N)) + realInt(q)]
    linear_combination realInvValue(realNat(N)) * same +
      realInt(q) * inverse
  have phase := expTwoPiI.member at R[realNat(b) * realInvValue(realNat(N))]
  rw [shift, expTwoPiI.add, expTwoPiI.integer]
  ring

theorem complexMul.distribute_three (c x y z : Set)
  requires hc : c ∈ ℂ
  requires hx : x ∈ ℂ
  requires hy : y ∈ ℂ
  requires hz : z ∈ ℂ
  shows ℂ[c * x + (c * y) * z] = ℂ[c * (x + y * z)]
proof
  ring

-- The terms χ(j) e(jk/N) of the twisted Gauss sum
-- G(k) = Σ_{j<N} χ(j) e(jk/N); G(1) = τ(χ).
defgraph gaussTwist (N : Nat, χ : Set, k : Nat) (j ∈ ℕ) : complexCarrier :=
  ℂ[χ(integerOfNat(j)) *
    expTwoPiI(R[realNat(j * k) * realInvValue(realNat(N))])]
requires values : FunctionBetween(χ, ℤ, complexCarrier)
proof
  have jNat := nat.omega.backward at j with member
  have index : integerOfNat(j) ∈ ℤ by typecheck
  have value := FunctionBetween.apply_closed with values, index
  have phase := expTwoPiI.member at
    R[realNat(j * k) * realInvValue(realNat(N))]
  typecheck

-- G(k) depends on k modulo N.
theorem gaussTwist.congruent (N : Nat) (χ : Set, k l : Nat)
  requires values : FunctionBetween(χ, ℤ, complexCarrier)
  requires positive : 0 < N
  requires congruent : IntegerCongruent(integerOfNat(N), integerOfNat(k),
    integerOfNat(l))
  shows complexPartialSum(gaussTwist(N, χ, k), N) =
    complexPartialSum(gaussTwist(N, χ, l), N)
proof
  have termwise : ∀ j ∈ ℕ, j < N →
      gaussTwist(N, χ, k)(j) = gaussTwist(N, χ, l)(j)
    intros j jMember below
    have jNat := nat.omega.backward at j with jMember
    have scaled := IntegerCongruent.mul_left at integerOfNat(N),
      integerOfNat(k), integerOfNat(l), integerOfNat(j) with congruent
    rw [← integerOfNat.mul, ← integerOfNat.mul] at scaled
    have phase := expTwoPiI.congruent with positive, scaled
    rw [(gaussTwist.value at N, χ, k, j with values, jMember),
      (gaussTwist.value at N, χ, l, j with values, jMember), phase]
  have congr := complexPartialSum.congr at gaussTwist(N, χ, k),
    gaussTwist(N, χ, l), N
  exact congr with termwise

-- The terms of G(k) on the residues modulo N.
defgraph twistResidues (N : Nat, χ : Set, k : Nat) (j ∈ N) : complexCarrier :=
  gaussTwist(N, χ, k)(j)
requires values : FunctionBetween(χ, ℤ, complexCarrier)
proof
  have naturals := natural.member at N
  have jMember := naturals with j, member
  have terms := gaussTwist.function at N, χ, k with values
  exact FunctionBetween.apply_closed with terms, jMember

theorem twistResidues.sum_identity (N : Nat) (χ : Set, k m : Nat)
  requires values : FunctionBetween(χ, ℤ, complexCarrier)
  requires bound : m ≤ N
  shows indexedRingSum(twistResidues(N, χ, k), identity(N), complexAdd,
    complexZero, m) = complexPartialSum(gaussTwist(N, χ, k), m)
proof
  induction m
  | zero =>
    intro bound
    rw [indexedRingSum, complexPartialSum.zero]
  | succ(i) using ih =>
    intro bound
    have smaller : i ≤ N by arith
    have below : i < N by arith
    have iMember := membership.of_Less at i, N with below
    have previous := ih with smaller
    have position := identity.apply at i, N with iMember
    have value := twistResidues.value at N, χ, k, i with values, iMember
    rw [indexedRingSum, previous, position, value, complexPartialSum.succ]
    unfold call2
    rfl

theorem twistResidues.sum_scaled (N t : Nat) (χ : Set, k m : Nat)
  requires character : DirichletCharacter(N, χ)
  requires positive : 0 < N
  requires bound : m ≤ N
  shows indexedRingSum(twistResidues(N, χ, k), residueScale(N, t),
    complexAdd, complexZero, m) =
    ℂ[χ(integerOfNat(t)) * complexPartialSum(gaussTwist(N, χ, t * k), m)]
proof
  induction m
  | zero =>
    intro bound
    have scalar : integerOfNat(t) ∈ ℤ by typecheck
    have value := DirichletCharacter.value with character, scalar
    rw [indexedRingSum, complexPartialSum.zero]
    ring
  | succ(i) using ih =>
    intro bound
    have values := DirichletCharacter.function with character
    have smaller : i ≤ N by arith
    have below : i < N by arith
    have iMember := membership.of_Less at i, N with below
    have iNat : i ∈ ℕ by typecheck
    have previous := ih with smaller
    have nonzero : N ≠ (0:N) by arith
    have imageBelow := mod.less at t * i, N with nonzero
    have imageMember := membership.of_Less at (t * i) % N, N with imageBelow
    have imageNat : (t * i) % N ∈ ℕ by typecheck
    have position := residueScale.value at N, t, i with positive, iMember
    have value := twistResidues.value at N, χ, k, (t * i) % N with values,
      imageMember
    have twist := gaussTwist.value at N, χ, k, (t * i) % N with values,
      imageNat
    have iTwist := gaussTwist.value at N, χ, t * k, i with values, iNat
    -- χ((t i) mod N) = χ(t) χ(i).
    have reduction := CongruentMod.mod_right at t * i, N
    have lifted := IntegerCongruent.ofNat_iff.backward at N, t * i,
      (t * i) % N with reduction
    have productInteger : integerOfNat(t * i) ∈ ℤ by typecheck
    have reducedInteger : integerOfNat((t * i) % N) ∈ ℤ by typecheck
    have same := DirichletCharacter.congruent with character, productInteger,
      reducedInteger, lifted
    have scalar : integerOfNat(t) ∈ ℤ by typecheck
    have iInteger : integerOfNat(i) ∈ ℤ by typecheck
    have multiplicative := DirichletCharacter.mul with character, scalar,
      iInteger
    rw ← integerOfNat.mul at multiplicative
    -- e(((t i) mod N) k / N) = e(i (t k) / N).
    have reverse := IntegerCongruent.symmetric with lifted
    have scaled := IntegerCongruent.mul_right at integerOfNat(N),
      integerOfNat((t * i) % N), integerOfNat(t * i), integerOfNat(k) with
      reverse
    rw [← integerOfNat.mul, ← integerOfNat.mul] at scaled
    have regroup : (t * i) * k = i * (t * k) by ring
    rw regroup at scaled
    have phase := expTwoPiI.congruent with positive, scaled
    have scalarValue := DirichletCharacter.value with character, scalar
    have iValue := DirichletCharacter.value with character, iInteger
    have sum := complexPartialSum.member at gaussTwist(N, χ, t * k), i with
      (gaussTwist.function at N, χ, t * k with values)
    have iPhase := expTwoPiI.member at
      R[realNat(i * (t * k)) * realInvValue(realNat(N))]
    rw [indexedRingSum, previous, position, value, twist, ← same,
      multiplicative, phase, complexPartialSum.succ, iTwist]
    exact complexMul.distribute_three with scalarValue, sum, iValue, iPhase

-- For t coprime to N, χ(t) G(t k) = G(k).
theorem gaussTwist.scale (N t : Nat) (χ : Set, k : Nat)
  requires character : DirichletCharacter(N, χ)
  requires positive : 0 < N
  requires coprime : gcd(t, N) = (1:N)
  shows ℂ[χ(integerOfNat(t)) * complexPartialSum(gaussTwist(N, χ, t * k), N)]
    = complexPartialSum(gaussTwist(N, χ, k), N)
proof
  have values := DirichletCharacter.function with character
  have permutation := residueScale.bijective at N, t with positive, coprime
  have order := identity.bijective at N
  have weights := twistResidues.function at N, χ, k with values
  have ring := complexes.comm_ring
  have reindexed := indexedRingSum.reindex at complexCarrier, complexAdd,
    complexZero, complexNeg, complexMul, complexOne, twistResidues(N, χ, k),
    N, identity(N), residueScale(N, t), N, N
    with ring, weights, order, permutation
  have full : N ≤ N by arith
  have identitySum := twistResidues.sum_identity at N, χ, k, N with values,
    full
  have scaledSum := twistResidues.sum_scaled at N, t, χ, k, N with
    character, positive, full
  rw [identitySum, scaledSum] at reindexed
  symm at reindexed
  exact reindexed

theorem liftedCharacter.functional_of_agree (N : Nat) (χ : Set) (M : Nat)
  requires character : DirichletCharacter(N, χ)
  requires positive : 0 < N
  requires agree : ∀ x ∈ ℤ, ∀ y ∈ ℤ, IntegerCoprime(x, integerOfNat(N)) →
    IntegerCoprime(y, integerOfNat(N)) → IntegerCongruent(integerOfNat(M), x, y)
    → χ(x) = χ(y)
  shows Functional(liftedCharacter(N, M, χ))
proof
  intros a y yMember z zMember
  obtain ⟨aInteger, yBranches⟩ := liftedCharacter.pair with yMember
  obtain ⟨_, zBranches⟩ := liftedCharacter.pair with zMember
  cases yBranches with yUnit | yOther
  . cases zBranches with zUnit | zOther
    . obtain ⟨_, x, xInteger, xCongruent, xCoprime, yValue⟩ := yUnit
      obtain ⟨_, w, wInteger, wCongruent, wCoprime, zValue⟩ := zUnit
      have reverse := IntegerCongruent.symmetric with wCongruent
      have between := IntegerCongruent.transitive with xCongruent, reverse
      have same := agree with x, xInteger, w, wInteger, xCoprime, wCoprime,
        between
      rw [yValue, zValue, same]
    . exfalso
      exact zOther.left with yUnit.left
  . cases zBranches with zUnit | zOther
    . exfalso
      exact yOther.left with zUnit.left
    . rw [yOther.right, zOther.right]

theorem liftedCharacter.unit_of_agree (N : Nat) (χ : Set) (M : Nat) (a x : Set)
  requires character : DirichletCharacter(N, χ)
  requires positive : 0 < N
  requires agree : ∀ x ∈ ℤ, ∀ y ∈ ℤ, IntegerCoprime(x, integerOfNat(N)) →
    IntegerCoprime(y, integerOfNat(N)) → IntegerCongruent(integerOfNat(M), x, y)
    → χ(x) = χ(y)
  requires aInteger : a ∈ ℤ
  requires coprime : IntegerCoprime(a, integerOfNat(M))
  requires xInteger : x ∈ ℤ
  requires congruent : IntegerCongruent(integerOfNat(M), x, a)
  requires xCoprime : IntegerCoprime(x, integerOfNat(N))
  shows liftedCharacter(N, M, χ)(a) = χ(x)
proof
  have value := DirichletCharacter.value with character, xInteger
  have member : (a, χ(x)) ∈ liftedCharacter(N, M, χ)
    unfold liftedCharacter
    have pair := product.pair with aInteger, value
    refine ⟨pair, a, aInteger, ?_⟩
    left
    exact ⟨coprime, x, xInteger, congruent, xCoprime, rfl⟩
  have functional := liftedCharacter.functional_of_agree with character, positive,
    agree
  exact graph.apply with (liftedCharacter.bounded at N, M, χ), functional, member

theorem liftedCharacter.other_of_agree (N : Nat) (χ : Set) (M : Nat) (a : Set)
  requires character : DirichletCharacter(N, χ)
  requires positive : 0 < N
  requires agree : ∀ x ∈ ℤ, ∀ y ∈ ℤ, IntegerCoprime(x, integerOfNat(N)) →
    IntegerCoprime(y, integerOfNat(N)) → IntegerCongruent(integerOfNat(M), x, y)
    → χ(x) = χ(y)
  requires aInteger : a ∈ ℤ
  requires notCoprime : ¬IntegerCoprime(a, integerOfNat(M))
  shows liftedCharacter(N, M, χ)(a) =
    complexZero
proof
  have member : (a, complexZero) ∈ liftedCharacter(N, M, χ)
    unfold liftedCharacter
    have pair := product.pair with aInteger, complexZero.member
    refine ⟨pair, a, aInteger, ?_⟩
    right
    exact ⟨notCoprime, rfl⟩
  have functional := liftedCharacter.functional_of_agree with character, positive,
    agree
  exact graph.apply with (liftedCharacter.bounded at N, M, χ), functional, member

-- If χ agrees on units congruent modulo a divisor M of N, it factors
-- through M.
theorem FactorsThrough.of_agree (N : Nat) (χ : Set) (M : Nat)
  requires character : DirichletCharacter(N, χ)
  requires positive : 0 < N
  requires agree : ∀ x ∈ ℤ, ∀ y ∈ ℤ, IntegerCoprime(x, integerOfNat(N)) →
    IntegerCoprime(y, integerOfNat(N)) → IntegerCongruent(integerOfNat(M), x, y)
    → χ(x) = χ(y)
  requires levelDivides : M ∣ N
  shows FactorsThrough(N, χ, M)
proof
  have functional := liftedCharacter.functional_of_agree with character, positive,
    agree
  have modulus : integerOfNat(N) ∈ ℤ by typecheck
  have level : integerOfNat(M) ∈ ℤ by typecheck
  have levelIntegerDivides := IntegerDivides.of_natural with levelDivides
  have function : liftedCharacter(N, M, χ) : ℤ → complexCarrier
    refine ⟨(liftedCharacter.bounded at N, M, χ), functional, ?_⟩
    intros a aInteger
    by_cases coprime : IntegerCoprime(a, integerOfNat(M))
    . obtain ⟨x, xMember, congruent, xCoprime⟩ := IntegerCoprime.lift
        at M, N, a with aInteger, coprime, positive
      have xInteger : x ∈ ℤ by exact xMember
      have value := DirichletCharacter.value with character, xInteger
      refine ⟨χ(x), value, ?_⟩
      unfold relates
      unfold liftedCharacter
      have pair := product.pair with aInteger, value
      refine ⟨pair, a, aInteger, ?_⟩
      left
      exact ⟨coprime, x, xInteger, congruent, xCoprime, rfl⟩
    . refine ⟨complexZero, complexZero.member, ?_⟩
      unfold relates
      unfold liftedCharacter
      have pair := product.pair with aInteger, complexZero.member
      refine ⟨pair, a, aInteger, ?_⟩
      right
      exact ⟨coprime, rfl⟩
  have lowered : DirichletCharacter(M, liftedCharacter(N, M, χ))
    refine ⟨function, ?_, ?_, ?_, ?_⟩
    . intros a aInteger
      have shifted : integerAddValue(a, integerOfNat(M)) ∈ ℤ
        by typecheck
      have congruent : IntegerCongruent(integerOfNat(M),
          integerAddValue(a, integerOfNat(M)), a)
        witness integerOne
        ring
      have reverse := IntegerCongruent.symmetric with congruent
      by_cases coprime : IntegerCoprime(a, integerOfNat(M))
      . obtain ⟨x, xMember, xCongruent, xCoprime⟩ := IntegerCoprime.lift
          at M, N, a with aInteger, coprime, positive
        have xInteger : x ∈ ℤ by exact xMember
        have shiftedCoprime := IntegerCoprime.of_congruent with aInteger,
          shifted, level, reverse, coprime
        have shiftedCongruent := IntegerCongruent.transitive with xCongruent,
          reverse
        have left := liftedCharacter.unit_of_agree with character, positive, agree, shifted, shiftedCoprime, xInteger, shiftedCongruent, xCoprime
        have right := liftedCharacter.unit_of_agree with character, positive, agree, aInteger, coprime, xInteger, xCongruent, xCoprime
        rw [left, right]
      . have shiftedOther : ¬IntegerCoprime(integerAddValue(a,
            integerOfNat(M)), integerOfNat(M))
          intro shiftedCoprime
          have back := IntegerCoprime.of_congruent with shifted, aInteger,
            level, congruent, shiftedCoprime
          exact coprime with back
        have left := liftedCharacter.other_of_agree with character, positive, agree, shifted, shiftedOther
        have right := liftedCharacter.other_of_agree with character, positive, agree, aInteger, coprime
        rw [left, right]
    . have one : integerOne ∈ ℤ by typecheck
      have levelCoprime := IntegerCoprime.one_left with level
      have unitCoprime := IntegerCoprime.one_left with modulus
      have reflexive := IntegerCongruent.reflexive
        at integerOfNat(M), integerOne
      have value := liftedCharacter.unit_of_agree with character, positive, agree,
        one, levelCoprime, one, reflexive, unitCoprime
      rw [value, DirichletCharacter.one with character]
    . intros a aInteger b bInteger
      have product : integerMulValue(a, b) ∈ ℤ by typecheck
      have aValue := FunctionBetween.apply_closed with function, aInteger
      have bValue := FunctionBetween.apply_closed with function, bInteger
      by_cases aCoprime : IntegerCoprime(a, integerOfNat(M))
      . by_cases bCoprime : IntegerCoprime(b, integerOfNat(M))
        . obtain ⟨x, xMember, xCongruent, xCoprime⟩ := IntegerCoprime.lift
            at M, N, a with aInteger, aCoprime, positive
          obtain ⟨y, yMember, yCongruent, yCoprime⟩ := IntegerCoprime.lift
            at M, N, b with bInteger, bCoprime, positive
          have xInteger : x ∈ ℤ by exact xMember
          have yInteger : y ∈ ℤ by exact yMember
          have both := IntegerCoprime.mul with aInteger, bInteger, level,
            aCoprime, bCoprime
          have xyInteger : integerMulValue(x, y) ∈ ℤ by typecheck
          have xyCoprime := IntegerCoprime.mul with xInteger, yInteger,
            modulus, xCoprime, yCoprime
          have xyCongruent := IntegerCongruent.mul with xCongruent, yCongruent
          have productValue := liftedCharacter.unit_of_agree with character, positive,
            agree, product, both, xyInteger, xyCongruent, xyCoprime
          have aLifted := liftedCharacter.unit_of_agree with character, positive, agree, aInteger, aCoprime, xInteger, xCongruent, xCoprime
          have bLifted := liftedCharacter.unit_of_agree with character, positive, agree, bInteger, bCoprime, yInteger, yCongruent, yCoprime
          have multiplicative := DirichletCharacter.mul with character,
            xInteger, yInteger
          rw [productValue, aLifted, bLifted, multiplicative]
        . have notBoth : ¬IntegerCoprime(integerMulValue(a, b),
              integerOfNat(M))
            intro both
            have right := IntegerCoprime.of_mul_right with aInteger, bInteger,
              level, both
            exact bCoprime with right
          have productValue := liftedCharacter.other_of_agree with character, positive,
            agree, product, notBoth
          have bZero := liftedCharacter.other_of_agree with character, positive, agree, bInteger, bCoprime
          have absorb := complexMul.zero_right with aValue
          rw [productValue, bZero, absorb]
      . have notBoth : ¬IntegerCoprime(integerMulValue(a, b),
            integerOfNat(M))
          intro both
          have left := IntegerCoprime.of_mul_left with aInteger, bInteger,
            level, both
          exact aCoprime with left
        have productValue := liftedCharacter.other_of_agree with character, positive,
          agree, product, notBoth
        have aZero := liftedCharacter.other_of_agree with character, positive, agree, aInteger, aCoprime
        have absorb := complexMul.zero_left with bValue
        rw [productValue, aZero, absorb]
    . intros a aInteger notCoprime
      exact liftedCharacter.other_of_agree with character, positive, agree,
        aInteger, notCoprime
  refine ⟨levelDivides, liftedCharacter(N, M, χ), lowered, ?_⟩
  intros a aInteger coprime
  have levelCoprime := IntegerCoprime.of_divides with aInteger, modulus,
    level, levelIntegerDivides, coprime
  have reflexive := IntegerCongruent.reflexive at integerOfNat(M), a
  have value := liftedCharacter.unit_of_agree with character, positive, agree,
    aInteger, levelCoprime, aInteger, reflexive, coprime
  rw value


-- A unit modulo N has a residue t < N coprime to N with the same value.
theorem DirichletCharacter.unit_residue (N : Nat) (χ x : Set)
  requires character : DirichletCharacter(N, χ)
  requires positive : 0 < N
  requires integer : x ∈ ℤ
  requires coprime : IntegerCoprime(x, integerOfNat(N))
  shows ∃ t ∈ ℕ, gcd(t, N) = (1:N) ∧
    IntegerCongruent(integerOfNat(N), x, integerOfNat(t)) ∧
    χ(x) = χ(integerOfNat(t))
proof
  have tNat := integerMod.natural at x, N with positive
  have residue := DirichletCharacter.residue with character, integer,
    positive
  have congruent := integerMod.congruent at x, N with positive
  have modulus : integerOfNat(N) ∈ ℤ by typecheck
  have tInteger : integerOfNat(integerMod(x, N)) ∈ ℤ by typecheck
  have tCoprime := IntegerCoprime.of_congruent with integer, tInteger,
    modulus, congruent, coprime
  unfold IntegerCoprime at tCoprime
  rw integerGCD.ofNat at tCoprime
  have tMember : integerMod(x, N) ∈ ℕ by typecheck
  exact ⟨integerMod(x, N), tMember, tCoprime, congruent, residue⟩

-- G(a l) = G(b l) when a ≡ b modulo M, N = g M and g ∣ l.
theorem gaussTwist.congruent_level (N g M : Nat) (χ : Set, a b l : Nat)
  requires values : FunctionBetween(χ, ℤ, complexCarrier)
  requires positive : 0 < N
  requires level : g * M = N
  requires dividing : g ∣ l
  requires congruent : IntegerCongruent(integerOfNat(M), integerOfNat(a),
    integerOfNat(b))
  shows complexPartialSum(gaussTwist(N, χ, a * l), N) =
    complexPartialSum(gaussTwist(N, χ, b * l), N)
proof
  obtain ⟨r, rNat, shapeL⟩ := dividing
  obtain ⟨q, qInteger, multiple⟩ := congruent
  have same := realInt.mul at integerOfNat(M), q
  rw [multiple, realInt.sub, realInt.nat, realInt.nat, realInt.nat] at same
  have levelReal : realNat(N) = R[realNat(g) * realNat(M)]
    rw [← level, realNat.mul]
  have lReal : realNat(l) = R[realNat(g) * realNat(r)]
    rw [← shapeL, realNat.mul]
  have nonzero : N ≠ (0:N) by arith
  have nonzeroReal := realNat.ne_zero with nonzero
  have inverse := realInvValue.mul_right with nonzeroReal
  have termwise : ∀ j ∈ ℕ, j < N →
      gaussTwist(N, χ, a * l)(j) = gaussTwist(N, χ, b * l)(j)
    intros j jMember below
    have jNat := nat.omega.backward at j with jMember
    have shift : R[realNat(j * (a * l)) * realInvValue(realNat(N))] =
        R[realNat(j * (b * l)) * realInvValue(realNat(N)) +
          realInt(integerOfNat(j * r)) * realInt(q)]
      rw [realInt.nat, realNat.mul, realNat.mul, realNat.mul, realNat.mul,
        realNat.mul]
      linear_combination (realNat(j) * realNat(l) *
          realInvValue(realNat(N))) * same +
        (realNat(j) * realInvValue(realNat(N)) * realNat(M) * realInt(q)) *
          lReal -
        (realNat(j) * realNat(r) * realInt(q) * realInvValue(realNat(N))) *
          levelReal +
        (realNat(j) * realNat(r) * realInt(q)) * inverse
    have phase := expTwoPiI.member at
      R[realNat(j * (b * l)) * realInvValue(realNat(N))]
    have index : integerOfNat(j) ∈ ℤ by typecheck
    have value := FunctionBetween.apply_closed with values, index
    rw [(gaussTwist.value at N, χ, a * l, j with values, jMember),
      (gaussTwist.value at N, χ, b * l, j with values, jMember), shift,
      expTwoPiI.add, ← realInt.mul, expTwoPiI.integer]
    ring
  have congr := complexPartialSum.congr at gaussTwist(N, χ, a * l),
    gaussTwist(N, χ, b * l), N
  exact congr with termwise

-- For χ primitive modulo N and gcd(l, N) > 1, G(l) = 0: χ takes different
-- values at two units x ≡ y modulo N / gcd(l, N), and G(l) is both
-- χ(x) G(x l) and χ(y) G(y l), with G(x l) = G(y l).
theorem gaussTwist.vanishing (N : Nat) (χ : Set, l : Nat)
  requires character : DirichletCharacter(N, χ)
  requires positive : 0 < N
  requires primitive : PrimitiveCharacter(N, χ)
  requires notCoprime : gcd(l, N) ≠ (1:N)
  shows complexPartialSum(gaussTwist(N, χ, l), N) = ℂ[0]
proof
  have values := DirichletCharacter.function with character
  have gDividesN := gcd.divides_right at l, N
  have gDividesL := gcd.divides_left at l, N
  obtain ⟨M, MNat, level⟩ := gDividesN
  have MDividesN : M ∣ N
    witness gcd(l, N)
    rw ← level
    arith
  have MNonzero : M ≠ (0:N)
    intro zero
    rw zero at level
    arith
  have gNonzero : gcd(l, N) ≠ (0:N)
    intro zero
    rw zero at level
    arith
  have gLarge : (1:N) < gcd(l, N) by arith
  have scaled := Less.mul_right at (1:N), gcd(l, N), M with MNonzero, gLarge
  have MLess : M < N by arith
  -- χ does not factor through M.
  have notFactor : ¬FactorsThrough(N, χ, M)
    intro factors
    have least := conductor.least with character, factors
    unfold PrimitiveCharacter at primitive
    rw primitive at least
    arith
  have exists : ∃ x ∈ ℤ, ∃ y ∈ ℤ, IntegerCoprime(x, integerOfNat(N)) ∧
      IntegerCoprime(y, integerOfNat(N)) ∧
      IntegerCongruent(integerOfNat(M), x, y) ∧ χ(x) ≠ χ(y)
    by_contra none
    apply notFactor
    have agree : ∀ x ∈ ℤ, ∀ y ∈ ℤ, IntegerCoprime(x, integerOfNat(N)) →
        IntegerCoprime(y, integerOfNat(N)) →
        IntegerCongruent(integerOfNat(M), x, y) → χ(x) = χ(y)
      intros x xInteger y yInteger xCoprime yCoprime congruent
      by_contra different
      apply none
      exact ⟨x, xInteger, y, yInteger, xCoprime, yCoprime, congruent,
        different⟩
    exact FactorsThrough.of_agree with character, positive, agree, MDividesN
  obtain ⟨x, xInteger, y, yInteger, xCoprime, yCoprime, congruent,
    different⟩ := exists
  obtain ⟨tx, txMember, txCoprime, txCongruent, txValue⟩ :=
    DirichletCharacter.unit_residue with character, positive, xInteger,
    xCoprime
  obtain ⟨ty, tyMember, tyCoprime, tyCongruent, tyValue⟩ :=
    DirichletCharacter.unit_residue with character, positive, yInteger,
    yCoprime
  have txNat := nat.omega.backward at tx with txMember
  have tyNat := nat.omega.backward at ty with tyMember
  -- tx ≡ ty modulo M.
  have levelDivides := IntegerDivides.of_natural with MDividesN
  have xM := IntegerCongruent.divides_modulus with levelDivides, txCongruent
  have yM := IntegerCongruent.divides_modulus with levelDivides, tyCongruent
  have xBack := IntegerCongruent.symmetric with xM
  have toY := IntegerCongruent.transitive with xBack, congruent
  have residues := IntegerCongruent.transitive with toY, yM
  have sameH := gaussTwist.congruent_level with values, positive, level,
    gDividesL, residues
  have scaleX := gaussTwist.scale at N, tx, χ, l with character, positive,
    txCoprime
  have scaleY := gaussTwist.scale at N, ty, χ, l with character, positive,
    tyCoprime
  rw [sameH, ← txValue] at scaleX
  rw ← tyValue at scaleY
  have xValue := DirichletCharacter.value with character, xInteger
  have yValue := DirichletCharacter.value with character, yInteger
  have terms := gaussTwist.function at N, χ, ty * l with values
  have sequence : ComplexSequence(gaussTwist(N, χ, ty * l)) by exact terms
  have H := complexPartialSum.member at gaussTwist(N, χ, ty * l), N with
    sequence
  have gap : ℂ[χ(x) - χ(y)] ∈ ℂ by typecheck
  have nonzero : ℂ[χ(x) - χ(y)] ≠ ℂ[0]
    intro vanish
    apply different
    linear_combination vanish
  have difference : ℂ[(χ(x) - χ(y)) *
      complexPartialSum(gaussTwist(N, χ, ty * l), N)] = ℂ[0]
    linear_combination scaleX - scaleY
  have zero := complexMul.zero_factor with gap, H, nonzero, difference
  rw [← scaleY, zero]
  ring

theorem gaussSum.member (N : Nat) (χ : Set)
  requires values : FunctionBetween(χ, ℤ, complexCarrier)
  shows gaussSum(N, χ) ∈ ℂ
proof
  have terms := gaussTerms.function at N, χ with values
  have sequence : ComplexSequence(gaussTerms(N, χ)) by exact terms
  unfold gaussSum
  exact complexPartialSum.member with sequence

-- τ(χ) = G(1).
theorem gaussSum.twist_one (N : Nat) (χ : Set)
  requires values : FunctionBetween(χ, ℤ, complexCarrier)
  shows gaussSum(N, χ) = complexPartialSum(gaussTwist(N, χ, 1), N)
proof
  have termwise : ∀ j ∈ ℕ, j < N → gaussTerms(N, χ)(j) =
      gaussTwist(N, χ, 1)(j)
    intros j jMember below
    have jNat := nat.omega.backward at j with jMember
    have unit : j * 1 = j by arith
    rw [(gaussTerms.value at N, χ, j with values, jMember),
      (gaussTwist.value at N, χ, 1, j with values, jMember), unit,
      realDiv.eq_mul_inv]
  have congr := complexPartialSum.congr at gaussTerms(N, χ),
    gaussTwist(N, χ, 1), N
  unfold gaussSum
  exact congr with termwise

-- For χ primitive, G(l) = χ̄(l) τ(χ) for every l.
theorem gaussTwist.conj_gauss (N : Nat) (χ : Set, l : Nat)
  requires character : DirichletCharacter(N, χ)
  requires positive : 0 < N
  requires primitive : PrimitiveCharacter(N, χ)
  shows complexPartialSum(gaussTwist(N, χ, l), N) =
    ℂ[complexConj(χ(integerOfNat(l))) * gaussSum(N, χ)]
proof
  have values := DirichletCharacter.function with character
  have index : integerOfNat(l) ∈ ℤ by typecheck
  have value := DirichletCharacter.value with character, index
  have gaussOne := gaussSum.twist_one at N, χ with values
  have tau := gaussSum.member at N, χ with values
  by_cases coprime : gcd(l, N) = (1:N)
  . have scale := gaussTwist.scale at N, l, χ, (1:N) with character,
      positive, coprime
    have unit : l * 1 = l by arith
    rw [unit, ← gaussOne] at scale
    have integerCoprime : IntegerCoprime(integerOfNat(l), integerOfNat(N))
      unfold IntegerCoprime
      rw integerGCD.ofNat
      exact coprime
    have norm := DirichletCharacter.norm_coprime with character, positive,
      index, integerCoprime
    have square := GRH.Exp.complexConj.mul_self with value
    rw [norm, complexOfReal.one] at square
    have conjugate := complexConj.member with value
    have terms := gaussTwist.function at N, χ, l with values
    have sequence : ComplexSequence(gaussTwist(N, χ, l)) by exact terms
    have G := complexPartialSum.member at gaussTwist(N, χ, l), N with sequence
    rw ← scale
    linear_combination (-complexPartialSum(gaussTwist(N, χ, l), N)) * square
  . have zero := gaussTwist.vanishing with character, positive, primitive,
      coprime
    have notCoprime : ¬IntegerCoprime(integerOfNat(l), integerOfNat(N))
      intro integerCoprime
      unfold IntegerCoprime at integerCoprime
      rw integerGCD.ofNat at integerCoprime
      exact coprime with integerCoprime
    have vanishing := DirichletCharacter.not_coprime with character, index,
      notCoprime
    rw [zero, vanishing, GRH.Exp.complexConj.zero]
    ring

-- Section: Dirichlet L-functions
-- |τ(χ)|² = N for χ primitive modulo N.
theorem gaussSum.abs_square (N : Nat) (χ : Set)
  requires positive : 1 ≤ N
  requires character : DirichletCharacter(N, χ)
  requires primitive : PrimitiveCharacter(N, χ)
  shows R[complexAbs(gaussSum(N, χ)) * complexAbs(gaussSum(N, χ))] =
    realNat(N)
proof
  sorry

-- |ε(χ)| = 1 for χ primitive.
theorem rootNumber.abs (N : Nat) (χ : Set) (κ : Nat)
  requires positive : 1 ≤ N
  requires character : DirichletCharacter(N, χ)
  requires primitive : PrimitiveCharacter(N, χ)
  requires parity : HasParity(χ, κ)
  shows complexAbs(rootNumber(N, χ, κ)) = R[1]
proof
  sorry

-- The functional equation Λ(s, χ) = ε(χ) Λ(1 − s, χ̄) for χ primitive
-- modulo N of parity κ, (s + κ)/2 and (1 − s + κ)/2 not poles of Γ.
theorem LFunction.functional_equation (N : Nat) (χ : Set) (κ : Nat) (s : Set)
  requires positive : 1 ≤ N
  requires character : DirichletCharacter(N, χ)
  requires primitive : PrimitiveCharacter(N, χ)
  requires parity : HasParity(χ, κ)
  requires hs : s ∈ ℂ
  requires domain : lGammaArgument(κ, s) ∈ gammaDomain
  requires reflectedDomain : lGammaArgument(κ, ℂ[1 - s]) ∈ gammaDomain
  shows completedL(N, χ, κ, s) =
    ℂ[rootNumber(N, χ, κ) * completedL(N, conjCharacter(χ), κ, ℂ[1 - s])]
proof
  sorry

-- The zeros of L(·, χ), χ primitive of parity κ, on re s ≤ 0 are trivial:
-- s = −κ − 2n.
theorem LFunction.zeros_left (N : Nat) (χ : Set) (κ : Nat) (s : Set)
  requires positive : 1 ≤ N
  requires character : DirichletCharacter(N, χ)
  requires primitive : PrimitiveCharacter(N, χ)
  requires parity : HasParity(χ, κ)
  requires hs : s ∈ ℂ
  requires left : complexRe(s) ≤ realZero
  requires zero : LFunction(N, χ, s) = ℂ[0]
  shows ∃ n ∈ ℕ,
    s = ℂ[-(complexOfReal(realNat(κ)) + 2 * complexOfReal(realNat(n)))]
proof
  sorry

-- A zero of L(·, χ), χ primitive, in the critical strip reflects to a zero
-- of L(·, χ̄) at 1 − s.
theorem LFunction.zero_reflect (N : Nat) (χ s : Set)
  requires positive : 1 ≤ N
  requires character : DirichletCharacter(N, χ)
  requires primitive : PrimitiveCharacter(N, χ)
  requires hs : s ∈ ℂ
  requires lower : realZero < complexRe(s)
  requires upper : complexRe(s) < realOne
  requires zero : LFunction(N, χ, s) = ℂ[0]
  shows LFunction(N, conjCharacter(χ), ℂ[1 - s]) = ℂ[0]
proof
  obtain ⟨κ, hκ, parity⟩ := DirichletCharacter.parity with character
  have κNat := nat.omega.backward at κ with hκ
  have domain := lGammaArgument.domain at κ, s with hs, lower
  have reflected : ℂ[1 - s] ∈ ℂ by typecheck
  have reflectedRe := complexRe.one_sub with hs
  have reflectedPositive : realZero < complexRe(ℂ[1 - s])
    rw reflectedRe
    linarith
  have reflectedDomain := lGammaArgument.domain at κ, ℂ[1 - s] with
    reflected, reflectedPositive
  have equation := LFunction.functional_equation with positive, character,
    primitive, parity, hs, domain, reflectedDomain
  -- The left side vanishes with L(s, χ).
  have leftArgument := gammaDomain.subset with domain
  have leftPower := realCpow.member at R[realNat(N) / realPi],
    lGammaArgument(κ, s) with leftArgument
  have leftGamma := Gamma.member at lGammaArgument(κ, s)
  have vanishing : completedL(N, χ, κ, s) = ℂ[0]
    unfold completedL
    rw zero
    ring
  -- The root number has modulus 1, so it is not 0.
  have values := DirichletCharacter.function with character
  have terms := gaussTerms.function at N, χ with values
  have sequence : ComplexSequence(gaussTerms(N, χ)) by exact terms
  have gauss := complexPartialSum.member at gaussTerms(N, χ), N with sequence
  have iMember := complexImaginaryUnit.member
  have iPower := complexPow.member at complexImaginaryUnit, κ with iMember
  have scale : ℂ[complexImaginaryUnit ^ κ *
      complexOfReal(realSqrt(realNat(N)))] ∈ ℂ by typecheck
  have scaleInverse := complexInv.member with scale
  have root : rootNumber(N, χ, κ) ∈ ℂ
    unfold rootNumber
    unfold complexDiv
    unfold gaussSum
    typecheck
  have modulus := rootNumber.abs with positive, character, primitive, parity
  have rootNonzero : rootNumber(N, χ, κ) ≠ ℂ[0]
    intro rootZero
    rw [rootZero, complexAbs.zero] at modulus
    have one : R[0] < R[1] by typecheck
    linarith
  -- The factors of the right side other than L(1 − s, χ̄) do not vanish.
  have conjugate := conjCharacter.character with character
  have conjugateValues := DirichletCharacter.function with conjugate
  have argument := gammaDomain.subset with reflectedDomain
  have power := realCpow.member at R[realNat(N) / realPi],
    lGammaArgument(κ, ℂ[1 - s]) with argument
  have powerNonzero := realCpow.nonzero at R[realNat(N) / realPi],
    lGammaArgument(κ, ℂ[1 - s]) with argument
  have gamma := Gamma.member at lGammaArgument(κ, ℂ[1 - s])
  have gammaNonzero := Gamma.nonzero with reflectedDomain
  have value := LFunction.closed at N, conjCharacter(χ), ℂ[1 - s] with
    conjugateValues, reflected
  have completed : completedL(N, conjCharacter(χ), κ, ℂ[1 - s]) ∈ ℂ
    unfold completedL
    typecheck
  have product : ℂ[rootNumber(N, χ, κ) *
      completedL(N, conjCharacter(χ), κ, ℂ[1 - s])] = ℂ[0]
    rw [← equation, vanishing]
  have reflectedZero := complexMul.zero_factor with root, completed,
    rootNonzero, product
  unfold completedL at reflectedZero
  have regrouped : ℂ[realCpow(R[realNat(N) / realPi],
      lGammaArgument(κ, ℂ[1 - s])) * ℂ[Gamma(lGammaArgument(κ, ℂ[1 - s])) *
      LFunction(N, conjCharacter(χ), ℂ[1 - s])]] = ℂ[0]
    linear_combination reflectedZero
  have tail : ℂ[Gamma(lGammaArgument(κ, ℂ[1 - s])) *
      LFunction(N, conjCharacter(χ), ℂ[1 - s])] ∈ ℂ by typecheck
  have gammaTimesL := complexMul.zero_factor with power, tail, powerNonzero,
    regrouped
  exact complexMul.zero_factor with gamma, value, gammaNonzero, gammaTimesL

end FunctionalEquation
