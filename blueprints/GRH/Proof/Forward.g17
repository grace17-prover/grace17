-- Forward declarations for layer 5 of the GRH port: the objects of the
-- source's src/Lib that the statements of GRH.Proof.* mention and that no
-- module of layers 1-3 defines yet. Each is marked FORWARD with the source
-- definition it stands for; layer 4 replaces each under the same name,
-- with the same meaning, and proves the facts layer 5 states about it.
-- Those with real bodies (the quadratic character, the quadratic twist,
-- the entire L-function L̃ and its logarithmic derivative, the
-- Chowla-Selberg constant) are final; layer 4 moves them to their homes.
-- Source: grh-compact/src/Lib/General/NumberTheory/QuadField.lean (chiK,
-- quadTwist, entireL, chowlaSelbergConst, PrimeSevenModEight),
-- Lib/Analytic/Landau/PolarLandau.lean (IsPolar).
-- Part of the GRH blueprint (layer 5, the argument).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Proof.Forward
import GRH.LSeries.Values
import Grace.Cumulus.Real.Floor

section Forward
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Section: The quadratic character and the quadratic twist
-- FORWARD (real body). The Legendre symbol (n/d) of an integer n modulo
-- the prime d, as a real number: 0 if d divides n, 1 if n is a nonzero
-- square modulo d, −1 otherwise (Mathlib's legendreSym; the source's
-- chiK d, QuadField.lean, whose values are (n/d) by chiK_eq_legendreSym).
def legendreSign (d : Nat, n : Set) : Set :=
  ⋃({ w ∈ ℝ |
    (IntegerCongruent(integerOfNat(d), n, integerZero) ∧ w = realZero) ∨
    (¬IntegerCongruent(integerOfNat(d), n, integerZero) ∧
      (∃ x ∈ ℤ, IntegerCongruent(integerOfNat(d), integerMulValue(x, x), n)) ∧
      w = realOne) ∨
    (¬IntegerCongruent(integerOfNat(d), n, integerZero) ∧
      ¬(∃ x ∈ ℤ, IntegerCongruent(integerOfNat(d), integerMulValue(x, x), n)) ∧
      w = R[-1]) })

-- FORWARD (real body). QuadField.lean, chiK: the Legendre symbol (·/d) as
-- a Dirichlet character modulo d with values in ℂ, a function on ℤ as
-- layer 1's characters are.
def legendreCharacter (d : Nat) : Set :=
  { (n, complexOfReal(legendreSign(d, n))) | n ∈ ℤ }

-- The pointwise product n ↦ ξ(n) (n/d) on ℤ.
def legendreTwistValues (ξ : Set, d : Nat) : Set :=
  { (n, ℂ[ξ(n) * complexOfReal(legendreSign(d, n))]) | n ∈ ℤ }

-- FORWARD (real body). QuadField.lean, quadTwist: for ξ modulo N and the
-- prime d, the character ξ·(·/d) modulo N d, the product of the two
-- characters changed to level N d: ξ(n)(n/d) on the integers prime to
-- N d, and 0 on the others.
def quadTwist (N : Nat, ξ : Set, d : Nat) : Set :=
  changeLevel(N * d, legendreTwistValues(ξ, d))

-- Section: The entire L-function
-- FORWARD (real body). QuadField.lean, entireL: L(s, χ) for χ not
-- principal, and the entire continuation of (s − 1) L(s, χ) for χ the
-- principal character (Mathlib's LFunctionTrivChar₁, track D's
-- principalLFunctionOne).
def entireL (N : Nat, χ s : Set) : Set :=
  ⋃({ w ∈ complexCarrier |
    (χ = principalCharacter(N) ∧ w = principalLFunctionOne(N, s)) ∨
    (χ ≠ principalCharacter(N) ∧ w = LFunction(N, χ, s)) })

-- s ↦ L̃(s, χ) as a function on ℂ.
def entireLMap (N : Nat, χ : Set) : Set :=
  { (s, entireL(N, χ, s)) | s ∈ complexCarrier }

-- Mathlib's logDeriv (entireL χ) s = deriv (entireL χ) s / entireL χ s
-- (0 at a zero, as complexDiv divides by 0 to 0).
def logDerivEntireL (N : Nat, χ s : Set) : Set :=
  complexDiv(complexDeriv(entireLMap(N, χ), complexCarrier)(s),
    entireL(N, χ, s))

-- FORWARD (real body). QuadField.lean, chowlaSelbergConst: for the prime
-- d, γ − Re L̃′/L̃(1, (·/d)), with γ Euler's constant (track D: the real
-- part of layer 1's ζ(1), the constant term of ζ at 1) and (·/d) the
-- source's quadTwist of the character 1 modulo 1, a character modulo
-- 1·d.
def chowlaSelbergConst (d : Nat) : Set :=
  R[complexRe(riemannZetaRegular(ℂ[1])) -
    complexRe(logDerivEntireL(1 * d,
      quadTwist(1, principalCharacter(1), d), ℂ[1]))]

-- FORWARD (real body). QuadField.lean, PrimeSevenModEight d: d is a prime
-- congruent to 7 modulo 8.
predicate PrimeSevenModEight (d : Nat) := Prime(d) ∧ d % 8 = (7:N)

-- Section: The two cases of L̃
-- For s ≠ 1, L̃(s, χ₀) = (s − 1) L(s, χ₀).
theorem entireL.of_principal (N : Nat) (s : Set)
  requires hs : s ∈ complexCarrier
  requires notOne : s ≠ ℂ[1]
  shows entireL(N, principalCharacter(N), s) =
    ℂ[(s - 1) * LFunction(N, principalCharacter(N), s)]
proof
  have values := DirichletCharacter.function with
    (principalCharacter.character at N)
  have lValue := LFunction.closed with values, hs
  have value : ℂ[(s - 1) * LFunction(N, principalCharacter(N), s)] ∈
    complexCarrier by typecheck
  have same := principalLFunctionOne.of_ne_one with hs, notOne
  unfold entireL
  apply union.of_unique
  . refine ⟨value, ?_⟩
    left
    refine ⟨rfl, ?_⟩
    rw same
  . intros y hy
    obtain ⟨_, alternatives⟩ := hy
    rcases alternatives with ⟨_, yValue⟩ | ⟨notPrincipal, _⟩
    . rw [yValue, same]
    . exfalso
      exact notPrincipal with rfl

-- For χ not principal, L̃(s, χ) = L(s, χ).
theorem entireL.of_not_principal (N : Nat) (χ s : Set)
  requires values : FunctionBetween(χ, ℤ, complexCarrier)
  requires hs : s ∈ complexCarrier
  requires notPrincipal : χ ≠ principalCharacter(N)
  shows entireL(N, χ, s) = LFunction(N, χ, s)
proof
  have value := LFunction.closed with values, hs
  unfold entireL
  apply union.of_unique
  . refine ⟨value, ?_⟩
    right
    exact ⟨notPrincipal, rfl⟩
  . intros y hy
    obtain ⟨_, alternatives⟩ := hy
    rcases alternatives with ⟨principal, _⟩ | ⟨_, yValue⟩
    . exfalso
      exact notPrincipal with principal
    . exact yValue

end Forward
