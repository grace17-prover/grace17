-- The inequality (⋆), the one-sided bound for the remainder, and GRH: no
-- Dirichlet L-function vanishes in re s > 1/2 (the pole at s = 1 of the
-- principal character excepted); with the functional equations of layer
-- 1 this gives the five theorems of GRH.Statements.
-- Source: grh-compact/src/New/Main.lean. "The inequality (⋆), an upper
-- bound for weighted non-split primes. [...] No Dirichlet L-function
-- vanishes in Re s > 1/2." Prime sums bounded by size against
-- divisibility are known (Chebyshev-order bounds, conditional CM heights,
-- curves over F_q). Related work: Pritsker, The Gelfond-Schnirelman
-- method in prime number theory, 2005; Granville-Stark, ABC implies no
-- Siegel zeros, 2000; Bombieri, Counting points on curves over finite
-- fields, Sém. Bourbaki 430, 1973; van Frankenhuijsen, The Riemann
-- hypothesis for function fields over a finite field, 2008; Weil, Sur les
-- courbes algébriques, 1948.
-- The source's New.grh is stated for Mathlib's DirichletCharacter.LFunction.
-- In the port that function is layer 1's LFunction: track D
-- (GRH.LSeries.*) proves for it the facts Mathlib's satisfies (the series
-- for re s > 1, LFunction.eq_LSeries; holomorphy; change of level), which
-- determine it, and the source's Statements.lean predicates are layer 1's.
-- So New.grh below is literally layer 1's DirichletLNonvanishingRightOfHalf.
-- Part of the GRH blueprint (layer 5, the argument).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Proof.Main
import GRH.Statements
import GRH.Proof.Data.DataExist
import GRH.Proof.Endgame.LongForms

section Main
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Section: The inequality (⋆) and the one-sided bound
-- Main.lean, star_inequality: for admissible data,
-- m rem ≤ (log b)² 𝓑, rem = remainder and 𝓑 = f a (log b)³ = budget.
theorem star_inequality (P D : Set)
  requires data : Data(P, D)
  shows R[realNat(D.m) * remainder(P, D)] ≤ R[D.logB ^ 2 * budget(P, D)]
proof
  sorry

-- Main.lean, eventually_primeError_le_rpow: for 0 < ε < 1/100 the
-- remainder R_{N₀}(x) is at most x^(8ε + 1/2 − 1) for all large x.
theorem eventually_primeError_le_rpow (P : Set, E : Real)
  requires parameters : Parameters(P)
  requires positive : (0:R) < R[E / 6]
  requires small : E < R[1 / 100]
  shows PrimeErrorEventuallyLe(Parameters.d(P), Parameters.N0(P),
    R[8 * E + 1 / 2])
proof
  sorry

-- Section: GRH
-- The exponent of New.grh: for re s > 1/2 some ε has 0 < ε < 1/100 and
-- 8ε + 1/2 < re s (the source takes ε = (min(re s, 1) − 1/2)/51).
theorem grh.exists_exponent (s : Set)
  requires hs : s ∈ complexCarrier
  requires above : R[1 / 2] < complexRe(s)
  shows ∃ E, E ∈ ℝ ∧ (0:R) < E ∧ (0:R) < R[E / 6] ∧ E < R[1 / 100] ∧
    R[8 * E + 1 / 2] < complexRe(s)
proof
  have reReal : complexRe(s) ∈ ℝ by typecheck
  have twoNonzero : R[2] ≠ (0:R) by linarith
  have sixNonzero : R[6] ≠ (0:R) by linarith
  have hundredNonzero : R[100] ≠ (0:R) by linarith
  have half := realDiv.mul_left at R[1], R[2] with twoNonzero
  have hundredth := realDiv.mul_left at R[1], R[100] with hundredNonzero
  have halfReal : R[1 / 2] ∈ ℝ by typecheck
  have hundredthReal : R[1 / 100] ∈ ℝ by typecheck
  by_cases low : complexRe(s) ≤ (1:R)
  . have nonzero : R[51] ≠ (0:R) by linarith
    have scaled := realDiv.mul_left at R[complexRe(s) - 1 / 2], R[51] with
      nonzero
    have eReal : R[(complexRe(s) - 1 / 2) / 51] ∈ ℝ by typecheck
    have sixth := realDiv.mul_left at R[(complexRe(s) - 1 / 2) / 51], R[6]
      with sixNonzero
    have ePositive : (0:R) < R[(complexRe(s) - 1 / 2) / 51] by linarith
    witness R[(complexRe(s) - 1 / 2) / 51]
    have halfBound : R[51 * ((complexRe(s) - 1 / 2) / 51)] ≤ R[1 / 2] by
      linarith
    refine ⟨eReal, ePositive, ?_, ?_, ?_⟩
    . linarith
    . linarith
    . linarith
  . have nonzero : R[200] ≠ (0:R) by linarith
    have scaled := realDiv.mul_left at R[1], R[200] with nonzero
    have eReal : R[1 / 200] ∈ ℝ by typecheck
    have sixth := realDiv.mul_left at R[1 / 200], R[6] with sixNonzero
    have ePositive : (0:R) < R[1 / 200] by linarith
    witness R[1 / 200]
    refine ⟨eReal, ePositive, ?_, ?_, ?_⟩
    . linarith
    . linarith
    . linarith

-- 1 ≤ N gives N = m + 1 for a natural m.
theorem grh.pred_split (N : Nat)
  requires positive : 1 ≤ N
  shows ∃ m ∈ ℕ, N = m + 1
proof
  have cancel := sub.add_cancel at N, 1 with positive
  have mNat : N - 1 ∈ ℕ by typecheck
  witness N - 1
  refine ⟨mNat, ?_⟩
  symm
  exact cancel

-- x + 1 ≠ 0 for a natural x.
theorem grh.add_one_ne_zero (x : Nat)
  shows x + 1 ≠ (0:N)
proof
  have below := Less.add_one at x
  have zero := Grace.Cumulus.Nat.Order.LessEqual.zero at x
  have positive := LessEqual.transitive_Less with zero, below
  exact Less.ne_reverse with positive

-- The class a = 9240 N − 1 = N₀/2 − 1 modulo N₀ = 18480 N is a unit.
theorem grh.class_unit (N : Nat)
  requires positive : 1 ≤ N
  shows gcd(9240 * N - 1, 18480 * N) = (1:N)
proof
  obtain ⟨m, mNat, split⟩ := grh.pred_split with positive
  rw split
  have top : 9240 * (m + 1) = (9239 + 9240 * m) + 1 by ring
  rw top
  rw (sub.add_right at 9239 + 9240 * m, 1)
  have big : 18480 * (m + 1) = 2 + 2 * (9239 + 9240 * m) by ring
  rw big
  rw (gcd.add_mul_right at 9239 + 9240 * m, 2, 2)
  have odd : 9239 + 9240 * m = 1 + (4619 + 4620 * m) * 2 by ring
  rw odd
  rw (gcd.add_mul_left at 1, 2, 4619 + 4620 * m)
  exact gcd.one_left at 2

-- A prime d ≡ N₀/2 − 1 modulo N₀ = 18480 N gives parameters (N₀, d), is
-- ≡ 7 mod 8 and is prime to N₀ (New.grh in Main.lean, the instance
-- `P.instHeegD` and `P.coprime_N₁_d 0`).
theorem grh.class_facts (N d : Nat)
  requires positive : 1 ≤ N
  requires prime : Prime(d)
  requires inClass : CongruentMod(d, 9240 * N - 1, 18480 * N)
  shows Parameters(Parameters.mk(18480 * N, d)) ∧ d % 8 = (7:N) ∧
    gcd(18480 * N, d) = (1:N)
proof
  have unit := grh.class_unit with positive
  obtain ⟨m, mNat, split⟩ := grh.pred_split with positive
  have top : 9240 * (m + 1) = (9239 + 9240 * m) + 1 by ring
  have cValue : 9240 * (m + 1) - 1 = 9239 + 9240 * m
    rw top
    exact sub.add_right at 9239 + 9240 * m, 1
  rw [split, cValue] at unit
  rw [split, cValue] at inClass
  rw split
  have nonzero := grh.add_one_ne_zero at 18479 + 18480 * m
  have mShape : (18479 + 18480 * m) + 1 = 18480 * (m + 1) by ring
  rw mShape at nonzero
  have gapNonzero := grh.add_one_ne_zero at 9240 + 9240 * m
  have below := Less.add_positive at 9239 + 9240 * m, (9240 + 9240 * m) + 1
    with gapNonzero
  have bShape : (9239 + 9240 * m) + ((9240 + 9240 * m) + 1) =
    18480 * (m + 1) by ring
  rw bShape at below
  have cMod := mod.of_less with below
  unfold CongruentMod at inClass
  rw cMod at inClass
  obtain ⟨q, qNat, dEq⟩ := mod.equation at d, 18480 * (m + 1) with nonzero
  rw inClass at dEq
  refine ⟨?_, ?_, ?_⟩
  . have dividesN0 : 18480 ∣ 18480 * (m + 1)
      witness m + 1
      rfl
    have dividesDouble : 18480 * (m + 1) ∣ 2 * (d + 1)
      witness 2 * q + 1
      rw dEq
      ring
    have notDivides : ¬(18480 * (m + 1) ∣ d + 1)
      intro divides
      have shape : d + 1 = 18480 * (m + 1) * q + 9240 * (m + 1)
        rw dEq
        ring
      rw shape at divides
      have multiple : 18480 * (m + 1) ∣ 18480 * (m + 1) * q
        witness q
        rfl
      have rest := divides.add_cancel_left with multiple, divides
      have restNonzero := grh.add_one_ne_zero at 9239 + 9240 * m
      have rShape : (9239 + 9240 * m) + 1 = 9240 * (m + 1) by ring
      rw rShape at restNonzero
      have small := divides.le with rest, restNonzero
      have larger := Less.add_positive at 9240 * (m + 1), 9240 * (m + 1)
        with restNonzero
      have lShape : 9240 * (m + 1) + 9240 * (m + 1) = 18480 * (m + 1) by ring
      rw lShape at larger
      have notSmall := Less.not_LessEqual with larger
      exact notSmall with small
    exact Parameters.intro with dividesN0, prime, ⟨dividesDouble, notDivides⟩
  . have shape : d = 7 + 8 * (2310 * (m + 1) * q + 1154 + 1155 * m)
      rw dEq
      ring
    have eightNonzero : (8:N) ≠ (0:N) by arith
    rw shape
    rw (mod.add_multiple at 8, 7, 2310 * (m + 1) * q + 1154 + 1155 * m with
      eightNonzero)
    have sevenBelow : (7:N) < (8:N) by arith
    exact mod.of_less with sevenBelow
  . have shape : d = (9239 + 9240 * m) + q * (18480 * (m + 1))
      rw dEq
      ring
    rw shape
    rw (gcd.add_mul_right at 18480 * (m + 1), 9239 + 9240 * m, q)
    rw (gcd.commutative at 18480 * (m + 1), 9239 + 9240 * m)
    exact unit

-- Main.lean, New.grh: for every N ≥ 1 and every Dirichlet character χ
-- modulo N, L(s, χ) ≠ 0 when re s > 1/2, the pole s = 1 of the principal
-- character excepted.
theorem New.grh
  shows DirichletLNonvanishingRightOfHalf()
proof
  unfold DirichletLNonvanishingRightOfHalf
  intros N hN positive χ character s hs above notPole zero
  -- s ≠ 1: at s = 1 the character is not principal, and L(1, χ) ≠ 0
  have notOne : s ≠ ℂ[1]
    intro one
    have reOne : realOne ≤ complexRe(s)
      rw [one, complexRe.one]
      have oneReal : realOne ∈ ℝ by typecheck
      linarith
    have nonzero := LFunction.ne_zero_of_one_le_re with positive, character,
      hs, notPole, reOne
    exact nonzero with zero
  -- pass to the modulus M = 18480 N, where L̃(s, χ) vanishes too
  have divides : N ∣ 18480 * N
    witness (18480:N)
    ring
  have bigPositive : (1:N) ≤ (18480:N) by arith
  have mPositive := LessEqual.one_le_mul at (18480:N), N with bigPositive,
    positive
  have induced := changeLevel.character with divides, character
  have values := DirichletCharacter.function with character
  have inducedValues := DirichletCharacter.function with induced
  have change := LFunction.changeLevel with mPositive, divides, character,
    hs, notPole
  have factor := levelProduct.member at 18480 * N, χ, s, succ(18480 * N)
    with values, hs
  have vanish : LFunction(18480 * N, changeLevel(18480 * N, χ), s) = ℂ[0]
    rw [change, zero]
    ring
  have entireZero : entireL(18480 * N, changeLevel(18480 * N, χ), s) = ℂ[0]
    by_cases principal : changeLevel(18480 * N, χ) =
        principalCharacter(18480 * N)
    . rw [principal, (entireL.of_principal with hs, notOne)]
      rw principal at vanish
      rw vanish
      ring
    . rw (entireL.of_not_principal with inducedValues, hs, principal)
      exact vanish
  -- the exponent: 0 < ε < 1/100 and 8ε + 1/2 < re s
  obtain ⟨E, eReal, ePositive, eSixth, eSmall, eBelow⟩ :=
    grh.exists_exponent with hs, above
  have half : R[1 / 2] < R[8 * E + 1 / 2] by linarith
  have unit := grh.class_unit with positive
  have bound : ∀ d ∈ ℕ, Prime(d) → CongruentMod(d, 9240 * N - 1, 18480 * N) →
      (d % 8 = (7:N) ∧ gcd(18480 * N, d) = (1:N)) ∧
      PrimeErrorEventuallyLe(d, 18480 * N, R[8 * E + 1 / 2])
    intros d dNat prime inClass
    obtain ⟨parameters, eight, coprime⟩ :=
      grh.class_facts with positive, prime, inClass
    have eventually := eventually_primeError_le_rpow with parameters,
      eSixth, eSmall
    rw [Parameters.mk.d, Parameters.mk.N0] at eventually
    exact ⟨⟨eight, coprime⟩, eventually⟩
  have nonzero := entireL.ne_zero_of_primeError_le at 18480 * N,
    9240 * N - 1, R[8 * E + 1 / 2], s, changeLevel(18480 * N, χ) with
    mPositive, half, unit, bound, hs, eBelow, induced
  exact nonzero with entireZero

-- Main.lean, New.zeros_on_line: zeros in the critical strip lie on the
-- line (layer 1's deduction through the functional equation of L).
theorem New.zeros_on_line
  shows DirichletLZerosOnLine()
proof
  have grh := New.grh
  exact LFunction.zeros_on_line.of_grh with grh

-- Main.lean, New.zeta_zeros_on_line: the Riemann hypothesis (layer 1's
-- deduction through ξ(s) = ξ(1 − s)).
theorem New.zeta_zeros_on_line
  shows RiemannZetaZerosOnLine()
proof
  have grh := New.grh
  exact riemannHypothesis.of_grh with grh

-- Section: The bridge to layer 1
-- Layer 1's admitted LFunction.nonzero_right_of_half (GRH.Statements),
-- the same formula, from New.grh. Replacing that admission by this proof
-- discharges the five theorems of GRH.Statements.
theorem LFunction.nonzero_right_of_half.of_proof
  shows DirichletLNonvanishingRightOfHalf()
proof
  exact New.grh

-- Main.lean / Statements.lean, RiemannHypothesis (Mathlib's).
theorem riemannHypothesis.of_proof
  shows RiemannHypothesis()
proof
  have zeros := New.zeta_zeros_on_line
  unfold RiemannHypothesis
  unfold RiemannZetaZerosOnLine at zeros
  exact zeros

-- Statements.lean, PrimitiveDirichletLZerosOnLine.
theorem LFunction.zeros_on_line_primitive.of_proof
  shows PrimitiveDirichletLZerosOnLine()
proof
  have zeros := New.zeros_on_line
  unfold DirichletLZerosOnLine at zeros
  unfold PrimitiveDirichletLZerosOnLine
  intros N hN positive χ character primitive s hs lower upper zero
  have atLevel := zeros with hN, positive
  have atCharacter := atLevel at χ with character
  exact atCharacter with hs, lower, upper, zero

end Main
