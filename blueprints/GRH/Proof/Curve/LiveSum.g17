-- Names for the divisibility the chain of lifts is asked at a prime p:
-- the ask, the forced part F(p), the gain, short and served primes, the
-- allowed loss; the coupling count of the jet divisibility theorem; the
-- column counts κ of the weights, the determinant exponents and the kept
-- columns; the sum of p^{−e} over e ≥ 1 odd (or p = d).
-- Source: grh-compact/src/New/Curve/LiveSum.lean. "Part of: Divisibility
-- of the chain of theta lifts at each prime (see
-- New.Columns.LocalStatement). This file: Names for asked divisibility,
-- gain, loss, short and served primes. Coupling count and exponent of the
-- jet divisibility theorem; weights of the data. The sum of p^{−e} over
-- e ≥ 1, e odd or p = d, is (1/(p−1) − ρ_p)/ω_p for non-split p,
-- ω_p = (1 − (p/d))/2, ρ_p = nonsplitWeight." With
-- Lib/General/NumberTheory/QuadFieldSplitting.lean (primeNorm,
-- nonsplitWeight) and New/Data/AdmissibleData.lean (reducedHalfGap,
-- posRank).
-- Encoding. χ_K(p) = (p/d) is the real number legendreSign(d, p). A place
-- is a unit residue modulo N₁ (GRH.Proof.Data.Different), so the place
-- named by −p^e is placeOfNegNat(P, s, p^e), and the order of a class
-- modulo N₀ is the least o ≥ 1 with σ^o ≡ 1. A family κ : Φ → ℕ → ℕ is a
-- function on Φ × ℕ. Sums over e ∈ ℕ are realTsum (Mathlib's tsum).
-- Part of the GRH blueprint (layer 5, the argument).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Proof.Curve.LiveSum
import GRH.Proof.Data.Magnitudes

section LiveSum
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Section: Splitting of p in K
-- QuadField.lean, chiK d p: (p/d), as a real number.
def quadCharAt (d p : Nat) : Set := legendreSign(d, integerOfNat(p))

-- QuadFieldSplitting.lean, primeNorm d p: p² if (p/d) = −1, p otherwise.
def primeNormAt (d p : Nat) : Set :=
  ⋃({ q ∈ ℕ | (quadCharAt(d, p) = R[-1] ∧ q = p * p) ∨
    (quadCharAt(d, p) ≠ R[-1] ∧ q = p) })

-- QuadFieldSplitting.lean, nonsplitWeight d p: ρ_p =
-- (1 + (p/d)²)/2/(q − 1), q = primeNorm: 1/(p² − 1) for p inert,
-- 1/(2(p − 1)) for p = d, 1/(p − 1) for p split.
def nonsplitWeight (d p : Nat) : Set :=
  R[(1 + quadCharAt(d, p) * quadCharAt(d, p)) / 2 /
    (realNat(primeNormAt(d, p)) - 1)]

-- Section: The ask and the forced part
-- e ≥ 1 with e odd or p = d: the exponents of the partner places −p^e σ.
predicate LiveExponent (P p e : Set) := (0:N) < e ∧ (Odd(e) ∨ p = Parameters.d(P))

-- The terms (y/p^e − w(−p^e σ))⁺ for live e, 0 otherwise.
def localAskValue (P D p Y σ e : Set) : Set :=
  ⋃({ v ∈ ℝ |
    (LiveExponent(P, p, e) ∧
      v = posPart(R[Y / realNat(pow(p, e)) - nominalWeight(P, D,
        placeMul(P, D.s, placeOfNegNat(P, D.s, pow(p, e)), σ))])) ∨
    (¬LiveExponent(P, p, e) ∧ v = realZero) })

def localAskTerms (P D p Y σ : Set) : Set :=
  { (e, localAskValue(P, D, p, Y, σ, e)) | e ∈ ℕ }

-- LiveSum.lean, Data.localAsk: ((1 − (p/d))/2) Σ_e (y/p^e − w(−p^e σ))⁺
-- over live e, w = nominalWeight.
def localAsk (P D p Y σ : Set) : Set :=
  R[(1 - quadCharAt(Parameters.d(P), p)) / 2 *
    realTsum(localAskTerms(P, D, p, Y, σ), ℕ)]

def forcedTerms (P D p : Set) : Set :=
  { (σ, localAsk(P, D, p, nominalWeight(P, D, σ), σ)) | σ ∈ dataPlaces(P, D) }

-- LiveSum.lean, Data.forcedPart: F(p) = Σ_σ ask_p(w(σ), σ).
def forcedPart (P D p : Set) : Set :=
  realFiniteSum(forcedTerms(P, D, p), dataPlaces(P, D))

def gainTerms (P D p : Set) : Set :=
  { (τ, localAsk(P, D, p, realNat(dataA(P, D)), τ)) | τ ∈ tops(P, D) }

-- LiveSum.lean, Data.gain (liftGain): m(Σ_{τ top} ask_p(a, τ) + k F(p)).
def liftGain (P D p : Set) : Set :=
  R[realNat(D.m) * (realFiniteSum(gainTerms(P, D, p), tops(P, D)) +
    realNat(dataK(D)) * forcedPart(P, D, p))]

-- Section: Short, served and small primes
-- LiveSum.lean, Data.IsSmallNonsplit: p < x₁ and (p/d) ≠ 1.
predicate IsSmallNonsplit (P D p : Set) :=
  R[realNat(p)] < dataX1(D) ∧ quadCharAt(Parameters.d(P), p) ≠ realOne

-- LiveSum.lean, Data.IsShortPrime: m ∣ p − 1 or m ∣ p + 1 (p − 1
-- truncated).
predicate IsShortPrime (D p : Set) := D.m ∣ sub(p, 1) ∨ D.m ∣ add(p, 1)

def shortFactor (D p : Set) : Set :=
  ⋃({ v ∈ ℝ | (IsShortPrime(D, p) ∧ v = realNat(D.m)) ∨
    (¬IsShortPrime(D, p) ∧ v = realOne) })

-- LiveSum.lean, Data.loss: f a (log b)²/p, times m if p is short.
def loss (P D p : Set) : Set :=
  R[realNat(dataF(P, D)) * D.logB ^ 2 *
    (realNat(dataA(P, D)) / realNat(p) * shortFactor(D, p))]

-- LiveSum.lean, Data.ceilLogM: Nat.clog p m, the least 𝔯 with m ≤ p^𝔯
-- (for p > 1).
def ceilLogCandidates (D p : Set) : Set := { k ∈ ℕ | D.m ≤ pow(p, k) }
def ceilLogM (D p : Set) : Set := leastNatural(ceilLogCandidates(D, p))

-- LiveSum.lean, Data.deltaP: δ_p = 𝔯 f (n_m + 𝔯).
def deltaP (P D p : Set) : Set :=
  mul(mul(ceilLogM(D, p), dataF(P, D)), add(dataRank(D, D.m), ceilLogM(D, p)))

-- LiveSum.lean, Data.jetCeil: ⌈2mfa/p⌉₊.
def jetCeilCandidates (P D p : Set) : Set :=
  { k ∈ ℕ | R[realNat(D.m) * (2 * realNat(dataF(P, D)) *
      realNat(dataA(P, D)) / realNat(p))] ≤ realNat(k) }
def jetCeil (P D p : Set) : Set := leastNatural(jetCeilCandidates(P, D, p))

-- The order of the class of the unit residue σ modulo M: the least o ≥ 1
-- with σ^o ≡ 1 mod M.
def classOrderCandidates (σ M : Set) : Set :=
  { o ∈ ℕ | (0:N) < o ∧ CongruentMod(pow(σ, o), (1:N), M) }
def classOrder (σ M : Set) : Set := leastNatural(classOrderCandidates(σ, M))

-- LiveSum.lean, Data.o₀: the order of the class modulo N₀ of the place
-- named by −p.
def placeOrderZero (P D p : Set) : Set :=
  classOrder(placeOfNegNat(P, D.s, p), Parameters.N0(P))

-- LiveSum.lean, Data.IsServed: (p/d) = −1, p is not short, o₀ is odd and
-- o₀ ≤ 𝔯.
predicate IsServed (P D p : Set) :=
  quadCharAt(Parameters.d(P), p) = R[-1] ∧ ¬IsShortPrime(D, p) ∧
  Odd(placeOrderZero(P, D, p)) ∧ placeOrderZero(P, D, p) ≤ ceilLogM(D, p)

-- Section: Collisions and couplings
-- LiveSum.lean, Data.IsCollision: e is live and τ and the place −p^e τ
-- are tops outside ev.
predicate IsCollision (P D p ev τ e : Set) :=
  LiveExponent(P, p, e) ∧ τ ∈ tops(P, D) ∖ ev ∧
  placeMul(P, D.s, placeOfNegNat(P, D.s, pow(p, e)), τ) ∈ tops(P, D) ∖ ev

def collisionValue (P D p ev τ e : Set) : Set :=
  ⋃({ v ∈ ℝ |
    (IsCollision(P, D, p, ev, τ, e) ∧
      v = R[realNat(dataA(P, D)) / realNat(pow(p, e))]) ∨
    (¬IsCollision(P, D, p, ev, τ, e) ∧ v = realZero) })

def collisionValues (P D p ev τ : Set) : Set :=
  { (e, collisionValue(P, D, p, ev, τ, e)) | e ∈ ℕ }

def collisionTerms (P D p ev : Set) : Set :=
  { (τ, realTsum(collisionValues(P, D, p, ev, τ), ℕ)) | τ ∈ dataPlaces(P, D) }

-- LiveSum.lean, Data.collisionSum: Σ a/p^e over collisions (τ, e)
-- outside ev.
def collisionSum (P D p ev : Set) : Set :=
  realFiniteSum(collisionTerms(P, D, p, ev), dataPlaces(P, D))

-- The parts t_σ, r_σ, B_σ of couplingCount: over heights h < n′, the
-- columns of height one (0 on ev), the other columns, and their boxes.
def oneColumns (κ ev σ : Set) : Set :=
  ⋃({ k ∈ ℕ | (σ ∉ ev ∧ k = κ((σ, 1))) ∨ (σ ∈ ev ∧ k = (0:N)) })

def tallCount (κ σ h : Set) : Set :=
  ⋃({ k ∈ ℕ | (h = (1:N) ∧ k = (0:N)) ∨ (h ≠ (1:N) ∧ k = κ((σ, h))) })

def couplingOne (κ n ev σ : Set) : Set :=
  ⋃({ v ∈ ℝ | ((1:N) < n ∧ v = realNat(oneColumns(κ, ev, σ))) ∨
    (¬((1:N) < n) ∧ v = realZero) })

def tallRealTerms (κ σ : Set) : Set := { (h, realNat(tallCount(κ, σ, h))) | h ∈ ℕ }

def tallBoxRealTerms (κ σ : Set) : Set :=
  { (h, realNat(mul(h, tallCount(κ, σ, h)))) | h ∈ ℕ }

def couplingTall (κ n σ : Set) : Set := realPartialSum(tallRealTerms(κ, σ), n)

def couplingBoxes (κ n σ : Set) : Set := realPartialSum(tallBoxRealTerms(κ, σ), n)

-- min(A, B) of two reals.
def liveMin (A B : Set) : Set := R[(A + B - abs(R[A - B])) / 2]

-- LiveSum.lean, couplingCount p κ n′ ev σ σ′ e:
-- min(t_σ/p^e, r_σ′ + t_σ′) + r_σ/p^e + min(B_σ/p^e, B_σ′).
def couplingCount (p κ n ev σ τ e : Set) : Set :=
  R[liveMin(R[couplingOne(κ, n, ev, σ) / realNat(pow(p, e))],
      R[couplingTall(κ, n, τ) + couplingOne(κ, n, ev, τ)]) +
    couplingTall(κ, n, σ) / realNat(pow(p, e)) +
    liveMin(R[couplingBoxes(κ, n, σ) / realNat(pow(p, e))],
      couplingBoxes(κ, n, τ))]

-- Section: The weights of the columns
-- AdmissibleData.lean, Data.reducedHalfGap: h₂ − ⌊(t + 1)/2⌋.
def reducedHalfGap (D : Set) : Set := sub(dataH2(D), quotientNat(add(dataT(D), 1), 2))

-- AdmissibleData.lean, Data.posRank j: k + j − 1.
def posRank (D j : Set) : Set := sub(add(dataK(D), j), 1)

-- LiveSum.lean, Data.κ τ h: the number of columns of height h at τ: a at
-- tops for h = 1; w₁(τ) − ⌊(k + t + 1)/2⌋ for h = k; 𝗁 − (t + 1) for
-- h > k with h ≡ k mod t + 1; 0 otherwise.
def columnCount (P D τ h : Set) : Set :=
  ⋃({ c ∈ ℕ |
    (h = (1:N) ∧ τ ∈ tops(P, D) ∧ c = dataA(P, D)) ∨
    (h = (1:N) ∧ τ ∉ tops(P, D) ∧ c = 0) ∨
    (h ≠ (1:N) ∧ h = dataK(D) ∧
      c = sub(weight(P, D, 1, τ),
        quotientNat(add(add(dataK(D), dataT(D)), 1), 2))) ∨
    (h ≠ (1:N) ∧ h ≠ dataK(D) ∧ dataK(D) < h ∧ add(dataT(D), 1) ∣ sub(h, dataK(D)) ∧
      c = sub(dataH(D), add(dataT(D), 1))) ∨
    (h ≠ (1:N) ∧ h ≠ dataK(D) ∧ ¬(dataK(D) < h ∧ add(dataT(D), 1) ∣ sub(h, dataK(D))) ∧
      c = 0) })

-- The family κ as a function on Φ × ℕ.
def columnCounts (P D : Set) : Set :=
  { (q, columnCount(P, D, fst(q), snd(q))) | q ∈ dataPlaces(P, D) × ℕ }

-- LiveSum.lean, Data.lastEntry j τ: 0 for j = 0, else ⌊n_{j−1}/2⌋ − w_j(τ)
-- (an integer).
def lastEntry (P D j τ : Set) : Set :=
  ⋃({ z ∈ ℤ | (j = (0:N) ∧ z = integerZero) ∨
    (j ≠ (0:N) ∧ z = integerSubValue(integerOfNat(quotientNat(dataRank(D, sub(j, 1)), 2)),
      integerOfNat(weight(P, D, j, τ)))) })

-- The family τ ↦ lastEntry j τ on the places.
def lastEntries (P D j : Set) : Set :=
  { (τ, lastEntry(P, D, j, τ)) | τ ∈ dataPlaces(P, D) }

-- LiveSum.lean, Data.keptColumns h: h₂ − ⌊(t + 1)/2⌋ if h ≥ k and
-- h ≡ k mod t + 1, else 0.
def keptColumns (D h : Set) : Set :=
  ⋃({ c ∈ ℕ |
    ((dataK(D) ≤ h ∧ add(dataT(D), 1) ∣ sub(h, dataK(D))) ∧ c = reducedHalfGap(D)) ∨
    (¬(dataK(D) ≤ h ∧ add(dataT(D), 1) ∣ sub(h, dataK(D))) ∧ c = 0) })

-- LiveSum.lean, Data.columnsY τ h: c(h) + (κ_τ(h + 1) − c(h + 1)),
-- c = keptColumns, the columns of height h of the weight on Y_m.
def columnsY (P D τ h : Set) : Set :=
  add(keptColumns(D, h), sub(columnCount(P, D, τ, succ(h)), keptColumns(D, succ(h))))

def columnsYCounts (P D : Set) : Set :=
  { (q, columnsY(P, D, fst(q), snd(q))) | q ∈ dataPlaces(P, D) × ℕ }

-- Section: The sum over live exponents
def liveInvPowValue (d p c e : Set) : Set :=
  ⋃({ v ∈ ℝ |
    (((0:N) < e ∧ (Odd(e) ∨ p = d)) ∧ v = R[c / realNat(pow(p, e))]) ∨
    (¬((0:N) < e ∧ (Odd(e) ∨ p = d)) ∧ v = realZero) })

def liveInvPowTerms (d p c : Set) : Set :=
  { (e, liveInvPowValue(d, p, c, e)) | e ∈ ℕ }

-- LiveSum.lean, hasSum_live_inv_pow: for primes d, p with (p/d) ≠ 1,
-- Σ_{e live} c/p^e = 2/(1 − (p/d)) · c · (1/(p − 1) − ρ_p).
theorem liveInvPow.hasSum (d p : Nat, c : Real)
  requires dPrime : Prime(d)
  requires pPrime : Prime(p)
  requires nonsplit : quadCharAt(d, p) ≠ realOne
  shows RealHasSum(liveInvPowTerms(d, p, c), ℕ,
    R[2 / (1 - quadCharAt(d, p)) * c *
      (1 / (realNat(p) - 1) - nonsplitWeight(d, p))])
proof
  sorry

end LiveSum
