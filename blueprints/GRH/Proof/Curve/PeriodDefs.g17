-- Authors: Grant Passmore

module GRH.Proof.Curve.PeriodDefs
import GRH.Proof.Data.Different
import GRH.Weil.Operators

section PeriodDefs
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Section: The integers of K inside ℂ
-- CurveTheta.lean, quadGen: ω = (1 + i√d)/2.
def quadGen (d : Nat) : Set := complexDiv(ℂ[1 + sqrtNegD(d)], ℂ[2])

-- The integer a as a complex number.
def intComplex (a : Set) : Set := complexOfReal(realInt(a))

-- CurveTheta.lean, quadInt d: the image of 𝓞_K in ℂ, 𝓞_K = ℤ[ω] since
-- d ≡ 3 mod 4.
def quadIntegers (d : Nat) : Set :=
  { z ∈ complexCarrier | ∃ a ∈ ℤ, ∃ b ∈ ℤ,
    z = ℂ[intComplex(a) + intComplex(b) * quadGen(d)] }

-- QuadField.scaledIdeal d (Ω, 1): the 𝓞_K-module Ω𝓞_K ⊂ ℂ.
def scaledIntegers (d : Nat, Ω : Set) : Set :=
  { z ∈ complexCarrier | ∃ a ∈ quadIntegers(d), z = ℂ[Ω * a] }

-- Section: Period lattices
-- PeriodPair: the lattice ℤω₁ + ℤω₂ of two ℝ-independent complex numbers
-- (Im(ω̄₁ω₂) ≠ 0).
predicate PeriodPairOf (ω1 ω2 : Set) :=
  ω1 ∈ complexCarrier ∧ ω2 ∈ complexCarrier ∧
  complexIm(ℂ[complexConj(ω1) * ω2]) ≠ realZero

def periodLattice (ω1 ω2 : Set) : Set :=
  { z ∈ complexCarrier | ∃ a ∈ ℤ, ∃ b ∈ ℤ,
    z = ℂ[intComplex(a) * ω1 + intComplex(b) * ω2] }

-- SigmaFunction.lean, PeriodPair.area: |Im(ω̄₁ω₂)|.
def periodArea (ω1 ω2 : Set) : Set := abs(complexIm(ℂ[complexConj(ω1) * ω2]))

-- The Weierstrass function ℘_Λ(z) = 1/z² + Σ'_{l ∈ Λ∖0} (1/(z − l)² − 1/l²)
-- (Mathlib's PeriodPair.weierstrassP, an unconditional sum), and the
-- invariant g₂ = 60 Σ'_{l ≠ 0} l⁻⁴ (PeriodPair.g₂).
def weierstrassTerms (Λ z : Set) : Set :=
  { (l, ℂ[complexInv(ℂ[(z - l) * (z - l)]) - complexInv(ℂ[l * l])]) |
    l ∈ Λ ∖ {complexZero} }

def weierstrassValue (Λ z : Set) : Set :=
  ℂ[complexInv(ℂ[z * z]) + complexTsum(weierstrassTerms(Λ, z), Λ ∖ {complexZero})]

def eisensteinFourTerms (Λ : Set) : Set :=
  { (l, complexInv(ℂ[l * l * l * l])) | l ∈ Λ ∖ {complexZero} }

def weierstrassG2 (Λ : Set) : Set :=
  ℂ[60 * complexTsum(eisensteinFourTerms(Λ), Λ ∖ {complexZero})]

-- Section: CM data
-- CurveTheta.lean, CMLattice d: a period pair (ω₁, ω₂), a point t and a₁.
structure CMCurve
  | omega1 omega2 t a1 : Set

-- The lattice Λ of the datum (CMLattice.Λ, and CMLattice.latticeModule as a
-- set).
def cmLattice (C : Set) : Set := periodLattice(C.omega1, C.omega2)

-- CurveTheta.lean, CMLattice d: g₂ = 12℘(t)² − 4, 𝓞_K Λ ⊂ Λ, t + t ∈ Λ,
-- t ∉ Λ, ωt ∉ Λ and ω̄t ∉ Λ, and a₁² = 12℘(t).
predicate IsCMLattice (d : Nat, C : Set) :=
  CMCurve.Data(C) ∧ PeriodPairOf(C.omega1, C.omega2) ∧
  C.t ∈ complexCarrier ∧ C.a1 ∈ complexCarrier ∧
  weierstrassG2(cmLattice(C)) =
    ℂ[12 * (weierstrassValue(cmLattice(C), C.t) *
      weierstrassValue(cmLattice(C), C.t)) - 4] ∧
  (∀ a ∈ quadIntegers(d), ∀ x ∈ cmLattice(C), ℂ[a * x] ∈ cmLattice(C)) ∧
  ℂ[C.t + C.t] ∈ cmLattice(C) ∧ C.t ∉ cmLattice(C) ∧
  ℂ[quadGen(d) * C.t] ∉ cmLattice(C) ∧
  ℂ[complexConj(quadGen(d)) * C.t] ∉ cmLattice(C) ∧
  ℂ[C.a1 * C.a1] = ℂ[12 * weierstrassValue(cmLattice(C), C.t)]

-- The area of the lattice of a CM datum.
def cmArea (C : Set) : Set := periodArea(C.omega1, C.omega2)

-- ConjugateCurve.lean, exists_galConjugate and galConjugate: a conjugate
-- of C under σ ∈ Aut(ℂ/K) is a CM datum C′ for d with a₁(C′) = σ(a₁(C)).
predicate IsGalConjugate (d : Nat, σ C Cσ : Set) :=
  IsCMLattice(d, Cσ) ∧ Cσ.a1 = σ(C.a1)

-- FormalHeight.lean, CMLattice.chowla_selberg: u is a unit at every
-- p-adic place, and area(C^σ)|σu|² = π e^{γ − Re L′/L(1, χ_K)} 2π/√d for
-- every σ ∈ Aut(ℂ/K) and conjugate C^σ.
predicate ChowlaSelbergUnit (d : Nat, C u : Set) :=
  u ∈ complexCarrier ∧
  (∀ p ∈ ℕ, Prime(p) → ∀ ι ∈ padicPlaces(p),
    padicPlaceNorm(p, ι, u) = realOne) ∧
  (∀ σ ∈ galoisOverK(d), ∀ Cσ, IsGalConjugate(d, σ, C, Cσ) →
    R[cmArea(Cσ) * complexAbs(σ(u)) ^ 2] =
      R[realPi * realExp(chowlaSelbergConst(d)) *
        (2 * realPi / realSqrt(realNat(d)))])

-- Section: The choices
-- The source's choices for the parameters: the splitting characters υ_s
-- of the Weil data of E = K(ζ_{N₁}) (one for each s), the curve 𝓔, the
-- period Ω₀ and the Chowla–Selberg unit u₀ of 𝓔.
structure PeriodChoice
  | upsilon curve omega0 unit : Set

-- PeriodDefs.lean, Parameters.cmCurve and Parameters.Ω₀ (from
-- QuadField.exists_latticeModule_eq_scaledIdeal: Λ_𝓔 = Ω₀𝓞_K, Ω₀ ≠ 0),
-- the unit of CMLattice.chowla_selberg for 𝓔 (Parameters.periodFactor),
-- and WeilDataOfE.lean, instWeilDataE (υ a splitting character).
predicate PeriodChoiceOf (P Z : Set) :=
  Parameters(P) ∧ PeriodChoice.Data(Z) ∧
  (∀ s ∈ ℕ, SplittingChar(weilDataE(P, s), Z.upsilon(s))) ∧
  IsCMLattice(Parameters.d(P), Z.curve) ∧
  Z.omega0 ∈ complexCarrier ∧ Z.omega0 ≠ complexZero ∧
  cmLattice(Z.curve) = scaledIntegers(Parameters.d(P), Z.omega0) ∧
  ChowlaSelbergUnit(Parameters.d(P), Z.curve, Z.unit)

-- Section: The scale of derivatives
-- FiniteMultiplier.lean, chiFin x = υ(x)|x|^{−1/2} for a finite idele x
-- (extended by 1 at infinity).
def chiFinOf (W υ x : Set) : Set :=
  ℂ[υ(finIdele(W, x)) * complexOfReal(realInv(realSqrt(finIdeleNorm(W, x))))]

-- PeriodDefs.lean, Parameters.vacuumRoot: s₀ = (χ_f(α)⁻¹)^{1/f}, the
-- principal power (exp of 1/f times the principal logarithm), f the
-- number of infinite places of E.
def vacuumRoot (P Z s : Set) : Set :=
  complexExp(ℂ[complexOfReal(realInv(realNat(cardinality(places(P, s))))) *
    complexLog(complexInv(chiFinOf(weilDataE(P, s), Z.upsilon(s),
      alphaE(P, s))))])

-- PeriodDefs.lean, Parameters.areaScale: (2π/√d)^{1/2}.
def areaScale (P : Set) : Set :=
  complexOfReal(realSqrt(R[2 * realPi / realSqrt(realNat(Parameters.d(P)))]))

-- PeriodDefs.lean, Parameters.periodFactor: s₁ = s₀/u₀.
def periodFactor (P Z s : Set) : Set := complexDiv(vacuumRoot(P, Z, s), Z.unit)

-- PeriodDefs.lean, Parameters.jetScale: per = s₁(2π/√d)^{1/2}/Ω₀, the
-- scale at which Taylor series of theta functions are taken.
def jetScale (P Z s : Set) : Set :=
  complexDiv(ℂ[periodFactor(P, Z, s) * areaScale(P)], Z.omega0)

-- Section: Facts
-- The choices exist: QuadField.exists_latticeModule_eq_scaledIdeal (a CM
-- datum with lattice Ω₀𝓞_K), CMLattice.chowla_selberg, and the splitting
-- characters of WeilDataOfE.lean.
theorem PeriodChoiceOf.exists (P : Set)
  requires parameters : Parameters(P)
  shows ∃ Z, PeriodChoiceOf(P, Z)
proof
  sorry

-- PeriodDefs.lean, Parameters.norm_gal_vacuumRoot: every σ ∈ Aut(ℂ/K)
-- has |σ(s₀)|² = rd_E/√d.
theorem vacuumRoot.norm_gal (P Z σ : Set, s : Nat)
  requires choice : PeriodChoiceOf(P, Z)
  requires hσ : σ ∈ galoisOverK(Parameters.d(P))
  shows R[complexAbs(σ(vacuumRoot(P, Z, s))) ^ 2] =
    R[rootDiscE(P, s) / realSqrt(realNat(Parameters.d(P)))]
proof
  sorry

end PeriodDefs
