module GRH.Proof.Curve.KatzDivisibility
import GRH.Proof.Curve.FormalParameter

section KatzDivisibility
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- KatzDivisibility.lean, CMLattice.katz_divisibility_limit: for d a prime
-- ≡ 7 mod 8, every prime p, p-adic place ι and n, some f ∈ 𝔬[[φ]] has
-- |n! f_n|_p ≥ p^{(ρ_p − 1/(p−1)) n}.
theorem phiSeriesRing.katz_limit (d : Nat, C p ι : Set, n : Nat)
  requires sevenMod : PrimeSevenModEight(d)
  requires lattice : IsCMLattice(d, C)
  requires prime : Prime(p)
  requires place : ι ∈ padicPlaces(p)
  shows ∃ f ∈ phiSeriesRing(p, ι, C),
    RealLe(R[realRpow(realNat(p), R[nonsplitWeight(d, p) - 1 / (realNat(p) - 1)]) ^ n],
      placeCpNorm(p, ι)(call2(Ring.mul(placeCp(p, ι)), cpNatValue(p, ι, n !), f(n))))
proof
  sorry

end KatzDivisibility
