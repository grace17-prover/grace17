-- Authors: Grant Passmore

module GRH.Proof.Curve.TightFrameExists
import GRH.Proof.Curve.ConjugateGenerator

section TightFrameExists
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- x ↦ τ(x̄) on E (with ιₚ, the source's weightEmbedding ιₚ τ).
def conjEmbedding (P s τ : Set) : Set :=
  { (x, placeEmbeddingE(P, s, τ)(complexConj(x))) | x ∈ carrierE(P, s) }

-- y ∈ E with α⁻¹y ∈ Ô (finiteImage id y ∈ Ô).
predicate IntegralAfterAlpha (P s y : Set) :=
  y ∈ carrierE(P, s) ∧
  finMul(fieldE(P, s), finInv(fieldE(P, s), alphaE(P, s)), finOf(fieldE(P, s), y)) ∈
    finInt(fieldE(P, s))

-- |ι(s₁)| at the place τ: |ι(τ(P′(ζ)‾))| if the place induced by
-- x ↦ ιₚ(τ(x̄)) contains (1 + √−d)/2, and 1 otherwise.
def alphaNormAt (P s p ι τ : Set) : Set :=
  ⋃({ r ∈ ℝ |
    (c0E(P, s) ∈ inducedPlace(fieldE(P, s), p, ι, conjEmbedding(P, s, τ)) ∧
      r = padicPlaceNorm(p, ι, conjEmbedding(P, s, τ)(relDifferentGenE(P, s)))) ∨
    (c0E(P, s) ∉ inducedPlace(fieldE(P, s), p, ι, conjEmbedding(P, s, τ)) ∧
      r = realOne) })

-- The constant multiplicity k on a set I.
def constMultiplicity (I k : Set) : Set := { (i, k) | i ∈ I }

-- The powers ζ^i, 0 ≤ i < N₁.
def zetaPowers (P s : Set) : Set :=
  { (i, rootOfUnity(levelN1(P, s), i)) | i ∈ levelN1(P, s) }

-- Section: Facts
-- TightFrameExists.lean, Parameters.norm_iota_periodFactor with
-- adeleExtension_alpha: |ι(s₁)| is the inverse of the norm of the
-- component of α along x ↦ ιₚ(τ(x̄)), for every place τ.
theorem periodFactor.norm_iota (P Z p ι τ : Set, s : Nat)
  requires choice : PeriodChoiceOf(P, Z)
  requires prime : Prime(p)
  requires place : ι ∈ padicPlaces(p)
  requires hτ : τ ∈ places(P, s)
  shows padicPlaceNorm(p, ι, periodFactor(P, Z, s)) = alphaNormAt(P, s, p, ι, τ)
proof
  sorry

-- TightFrameExists.lean, Parameters.norm_periodFactor_mul_conj_le_one:
-- |ι(s₁ τ(ȳ))| ≤ 1 for α⁻¹y integral.
theorem periodFactor.mul_conj_integral (P Z p ι τ y : Set, s : Nat)
  requires choice : PeriodChoiceOf(P, Z)
  requires prime : Prime(p)
  requires place : ι ∈ padicPlaces(p)
  requires hτ : τ ∈ places(P, s)
  requires hy : IntegralAfterAlpha(P, s, y)
  shows RealLe(padicPlaceNorm(p, ι, ℂ[periodFactor(P, Z, s) *
    complexConj(placeEmbeddingE(P, s, τ)(y))]), realOne)
proof
  sorry

-- TightFrameExists.lean, Parameters.norm_iota_periodFactor_eq_one: s₁ is a
-- p-adic unit for p ∤ N₁.
theorem periodFactor.norm_iota_eq_one (P Z p ι : Set, s : Nat)
  requires choice : PeriodChoiceOf(P, Z)
  requires prime : Prime(p)
  requires place : ι ∈ padicPlaces(p)
  requires coprime : ¬(p ∣ levelN1(P, s))
  shows padicPlaceNorm(p, ι, periodFactor(P, Z, s)) = realOne
proof
  sorry

-- TightFrameExists.lean, Parameters.isTightFrame_zeta_pow: the ζ^i,
-- 0 ≤ i < N₁, each taken k times, form a tight frame of length k N₁.
theorem zetaPowers.tight_frame (P : Set, s k : Nat)
  requires parameters : Parameters(P)
  shows IsTightFrame(weilDataE(P, s), levelN1(P, s), zetaPowers(P, s),
    constMultiplicity(levelN1(P, s), k), mul(k, levelN1(P, s)))
proof
  sorry

-- TightFrameExists.lean, Parameters.exists_isTightFrame: for
-- m ≥ (d N₁)⁶ (R + 1) and every p-adic place ι there is a tight frame (v_i)
-- of length m with multiplicities c_i ≥ R in which, for some i,
-- ι(s₁ τ(v̄_i)) is a p-adic unit at every place τ.
theorem tightFrame.exists (P Z p ι : Set, s m Rk : Nat)
  requires choice : PeriodChoiceOf(P, Z)
  requires prime : Prime(p)
  requires place : ι ∈ padicPlaces(p)
  requires large : pow(mul(Parameters.d(P), levelN1(P, s)), 6) * (Rk + 1) ≤ m
  shows ∃ I, ∃ v, ∃ c, IsTightFrame(weilDataE(P, s), I, v, c, m) ∧
    (∀ i ∈ I, Rk ≤ c(i)) ∧
    (∃ i ∈ I, ∀ τ ∈ places(P, s),
      padicPlaceNorm(p, ι, ℂ[periodFactor(P, Z, s) *
        complexConj(placeEmbeddingE(P, s, τ)(v(i)))]) = realOne)
proof
  sorry

end TightFrameExists
