-- Divisibility of matrix jets at non-split primes: a lower bound for the
-- valuations of Schur jets of series that are integral on the null cone of
-- the Frobenius couplings.
-- Source: grh-compact/src/New/Curve/JetDivisibility.lean ("This file:
-- Tilting matrices that kill Frobenius pairings at controlled determinant
-- cost. Lower bound for valuations of Schur jets when Frobenius couplings
-- are silenced."; norm_schurJet_le), with
-- Lib/General/Algebra/ZerosCostDegree.lean (FitsRanks, boxes).
-- Encoding. The rows n, n′ have the same size at every place, so FitsRanks
-- reads |n| ≤ |n′| and κ_τ(h) = 0 for |n| < h < |n′|. A family κ : Φ → ℕ → ℕ
-- is a function on Φ × ℕ, and the charge g : Φ → ℕ → B → ℕ one on
-- (Φ × ℕ) × B. The Schur jet, the Weyl indices and the row charges are
-- FORWARD (GRH.Proof.Forward.Theta). ⌊log_p B⌋ is the least j with
-- B < p^{j+1}. Not stated here: exists_null_coupling_frames, the tilting
-- matrices used inside the proof.
-- Part of the GRH blueprint (layer 5, the argument).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Proof.Curve.JetDivisibility
import GRH.Proof.Curve.FormalParameter
import GRH.Proof.Columns.JetExponentBound

section JetDivisibility
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- ZerosCostDegree.lean, FitsRanks n n′ κ (rows of the same size at every
-- place): |n| ≤ |n′| and κ_τ(h) = 0 for |n| < h < |n′|.
predicate FitsRanks (Φ n n2 κ : Set) :=
  cardinality(n) ≤ cardinality(n2) ∧
  ∀ τ ∈ Φ, ∀ h ∈ ℕ, cardinality(n) < h → h < cardinality(n2) → κ((τ, h)) = (0:N)

-- Σ_{e ∈ S} Σ_σ couplingCount p κ N ev σ (pr_e σ) e.
def couplingTotalTerms (Φ p κ N ev pr : Set) : Set :=
  { (q, couplingCount(p, κ, N, ev, snd(q), pr(fst(q))(snd(q)), fst(q))) | q ∈ ℕ × Φ }

def couplingTotal (Φ p κ N ev pr S : Set) : Set :=
  realFiniteSum(couplingTotalTerms(Φ, p, κ, N, ev, pr), S × Φ)

-- ⌊log_p B⌋ for a real B ≥ 0.
def natLogCandidates (p B : Set) : Set := { j ∈ ℕ | (B:R) < realNat(pow(p, succ(j))) }
def natLogFloor (p B : Set) : Set := leastNatural(natLogCandidates(p, B))

-- JetDivisibility.lean, norm_schurJet_le (divisibility of Schur jets): let
-- κ fit the ranks, with B boxes below N = |n′|, |ϖ| = p^{−ρ}, |θ| = p^ω, and
-- let the charges g be nonzero at one end of each coupling exempted by the
-- places ev. If Θ is integral on the null cone up to degree B, every entry
-- of its jet matrix along S_κ has valuation at least
-- (1/(p−1) − ρ)B + ω Σ couplingCount − |Φ| N³ (⌊log_p B⌋ + 1) − m, m the
-- charge of the boxes of its row.
theorem schurJet.norm_le (p ι Φ n n2 κ pr S ρ ω ϖ θ Θ ev g Bset i2 i : Set)
  requires prime : Prime(p)
  requires place : ι ∈ padicPlaces(p)
  requires finiteΦ : Finite(Φ)
  requires finiteN : Finite(n)
  requires finiteN2 : Finite(n2)
  requires counts : (κ : Φ × ℕ → ℕ)
  requires fits : FitsRanks(Φ, n, n2, κ)
  requires partner : (pr : ℕ → functionSpace(Φ, Φ))
  requires finiteS : Finite(S)
  requires subS : S ⊆ ℕ
  requires hρ : ρ ∈ ℝ
  requires hω : ω ∈ ℝ
  requires hϖ : placeCpNorm(p, ι)(ϖ) = realRpow(realNat(p), R[-ρ])
  requires hθ : θ ∈ placeCpIntegers(p, ι)
  requires normθ : placeCpNorm(p, ι)(θ) = realRpow(realNat(p), ω)
  requires charges : (g : (Φ × ℕ) × Bset → ℕ)
  requires exempt : ∀ e ∈ S, ∀ σ ∈ Φ, ∀ h ∈ ℕ, ∀ b ∈ Bset,
    (σ ∈ ev ∨ (h = (1:N) ∧ pr(e)(σ) ∈ ev)) →
      g(((σ, (1:N)), b)) ≠ (0:N) ∨ g(((pr(e)(σ), h), b)) ≠ (0:N)
  requires hi2 : i2 ∈ weylIndexSet(Φ, n2, κ)
  requires hi : i ∈ weylIndexSet(Φ, n, κ)
  requires null : IsIntegralOnNullCone(p, ι, Φ, n2 × n, pr, S, ϖ, θ,
    boxesOver(Φ, κ, cardinality(n2)), Θ)
  shows RealLe(placeCpNorm(p, ι)(schurJetEntry(placeCp(p, ι), Φ, n, n2, κ, Θ, i2, i)),
    realRpow(realNat(p),
      R[realNat(rowCharge(Φ, cardinality(n2), g, i2)) -
        ((1 / (realNat(p) - 1) - ρ) * boxesOver(Φ, κ, cardinality(n2)) +
          ω * couplingTotal(Φ, p, κ, cardinality(n2), ev, pr, S) -
          realNat(cardinality(Φ)) * realNat(cardinality(n2)) ^ 3 *
            (realNat(natLogFloor(p, boxesOver(Φ, κ, cardinality(n2)))) + 1))]))
proof
  sorry

end JetDivisibility
