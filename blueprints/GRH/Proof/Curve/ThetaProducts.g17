-- Theta products along tight frames: the series Π ι(U_{y_{j,k}}θ)(ι(b w̄_j)z_k)
-- over ℂ_p, and their normal form at non-split primes: integral on the
-- null cone of the Frobenius couplings up to one exponential coupling
-- partner places.
-- Source: grh-compact/src/New/Curve/ThetaProducts.lean ("This file: Theta
-- products along tight frames: integral up to one exponential coupling
-- partner places."; Parameters.thetaProducts, thetaProducts_normal_form).
-- Encoding. The CM curve 𝓔 is the field curve of the period choice Z
-- (GRH.Proof.Curve.PeriodDefs); the variables (τ, k) range over the CM
-- type of E (the embeddings placeEmbeddingE(P, s, v) of the places v, as
-- the variables of jet series do) times c. The partner −p^j v of the
-- place v is placeMul(P, s, placeOfNegNat(P, s, p^j), v), and j ≤ log_p B
-- is j = 0 or p^j ≤ B. A coefficient of Ψ mod 𝔪 is nonzero exactly when
-- it has norm 1. Not stated here: the characteristic-p lemmas
-- sum_pow_eq_zero_of_null, coeff_sum_frob_ne_zero_iff and
-- exists_frame_rows_frob used inside the proof of the normal form.
-- Part of the GRH blueprint (layer 5, the argument).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Proof.Curve.ThetaProducts
import GRH.Proof.Curve.FormalParameter

section ThetaProducts
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Section: Theta products
-- The coefficients (τ, k) ↦ b · conj τ(w_j) if k = k₀, 0 otherwise, of the
-- linear form of the factor (j, k₀).
def frameCoeff (b w i x : Set) : Set :=
  ⋃({ z ∈ complexCarrier |
    (snd(x) = snd(i) ∧ z = ℂ[b * complexConj(fst(x)(w(fst(i))))]) ∨
    (snd(x) ≠ snd(i) ∧ z = complexZero) })

def frameCoeffs (P s c b w i : Set) : Set :=
  { (x, frameCoeff(b, w, i, x)) | x ∈ cmTypeE(P, s) × c }

def frameCoeffFamily (P s c b w J : Set) : Set :=
  { (i, frameCoeffs(P, s, c, b, w, i)) | i ∈ J × c }

-- The multiplicity 1 of every frame vector.
def unitMultiplicity (J : Set) : Set := { (j, (1:N)) | j ∈ J }

-- ThetaProducts.lean, Parameters.thetaProducts δ r c: the series
-- Π_{(j,k)} ι(U_{y_{j,k}}θ)(ι(b w̄_j)z_k) over ℂ_p, for (w_j) a tight frame
-- of length M, |ι b| = r, n δ y_{j,k} ∈ Λ and p prime to M n; U_y is the
-- twisted translation, θ and Λ those of 𝓔.
def thetaProducts (P Z s p ι δ r c : Set) : Set :=
  { Θ ∈ mvSeriesCarrier(placeCp(p, ι), cmTypeE(P, s) × c) |
    ∃ J, ∃ w, ∃ M ∈ ℕ, ∃ n ∈ ℕ, ∃ b ∈ complexCarrier, ∃ y,
      IsTightFrame(weilDataE(P, s), J, w, unitMultiplicity(J), M) ∧
      (y : J × c → complexCarrier) ∧
      Θ = thetaProduct(p, ι, PeriodChoice.curve(Z), J × c, cmTypeE(P, s) × c, y,
        frameCoeffFamily(P, s, c, b, w, J)) ∧
      gcd(p, M) = (1:N) ∧ gcd(p, n) = (1:N) ∧ padicPlaceNorm(p, ι, b) = r ∧
      (∀ i ∈ J × c, ℂ[complexOfReal(realNat(n)) * δ * y(i)] ∈
        cmLattice(PeriodChoice.curve(Z))) }

-- Section: The normal form
-- The partner map pr_j v = −p^j v on the places.
def partnerAt (P s p j : Set) : Set :=
  { (placeEmbeddingE(P, s, v),
      placeEmbeddingE(P, s, placeMul(P, s, placeOfNegNat(P, s, pow(p, j)), v))) |
    v ∈ places(P, s) }

def partnerMap (P s p : Set) : Set := { (j, partnerAt(P, s, p, j)) | j ∈ ℕ }

-- The exponents j ≤ log_p B with j odd or p = d.
def nullCouplings (P p B : Set) : Set :=
  { j ∈ ℕ | (j = (0:N) ∨ pow(p, j) ≤ B) ∧ (Odd(j) ∨ p = Parameters.d(P)) }

-- Θ(ϖz): the coefficient at z^m is ϖ^{|m|} Θ_m.
def mvRescale (p ι I ϖ Θ : Set) : Set :=
  { (m, call2(Ring.mul(placeCp(p, ι)), Ring.pow(placeCp(p, ι), ϖ, monomialDegree(I, m)),
      Θ(m))) | m ∈ monomials(I) }

-- κ Ψ, coefficientwise.
def mvScale (p ι I κ Ψ : Set) : Set :=
  { (m, call2(Ring.mul(placeCp(p, ι)), κ, Ψ(m))) | m ∈ monomials(I) }

-- The x-th partial derivative's coefficient at z^e, (e_x + 1) Ψ_{e + 1_x}.
def bumpEntry (x e i : Set) : Set :=
  ⋃({ k ∈ ℕ | (i = x ∧ k = succ(e(i))) ∨ (i ≠ x ∧ k = e(i)) })

def monomialBump (I x e : Set) : Set := { (i, bumpEntry(x, e, i)) | i ∈ I }

def partialCoeff (p ι I x Ψ e : Set) : Set :=
  call2(Ring.mul(placeCp(p, ι)), cpNatValue(p, ι, succ(e(x))), Ψ(monomialBump(I, x, e)))

-- The monomial z_y^k.
def singleEntry (y k i : Set) : Set := ⋃({ a ∈ ℕ | (i = y ∧ a = k) ∨ (i ≠ y ∧ a = (0:N)) })

def singleMonomial (I y k : Set) : Set := { (i, singleEntry(y, k, i)) | i ∈ I }

-- The second part of thetaProducts_normal_form at Θ: Θ(ϖz) = exp(κΨ)V with
-- |κ| = p^{1 − 1/(p−1)}, Ψ, V over 𝔬, Ψ(0) = 0, and ∂_xΨ has unit
-- coefficients exactly at the z_y^{p^j} with j odd and −p^j y = x.
predicate ExponentialNormalForm (P s p ι c ϖ Θ : Set) :=
  ∃ κ ∈ Ring.carrier(placeCp(p, ι)),
    ∃ Ψ ∈ integralMvSeries(p, ι, cmTypeE(P, s) × c),
      ∃ V ∈ integralMvSeries(p, ι, cmTypeE(P, s) × c),
        placeCpNorm(p, ι)(κ) = realRpow(realNat(p), R[1 - 1 / (realNat(p) - 1)]) ∧
        mvSeriesConstantCoeff(cmTypeE(P, s) × c, Ψ) = Ring.zero(placeCp(p, ι)) ∧
        mvRescale(p, ι, cmTypeE(P, s) × c, ϖ, Θ) =
          call2(Ring.mul(mvPowerSeriesRing(placeCp(p, ι), cmTypeE(P, s) × c)),
            mvExpSubst(placeCp(p, ι), cmTypeE(P, s) × c,
              mvScale(p, ι, cmTypeE(P, s) × c, κ, Ψ)), V) ∧
        (∀ x ∈ cmTypeE(P, s) × c, ∀ e ∈ monomials(cmTypeE(P, s) × c),
          (placeCpNorm(p, ι)(partialCoeff(p, ι, cmTypeE(P, s) × c, x, Ψ, e)) = realOne ↔
            (∃ j ∈ ℕ, ∃ y ∈ cmTypeE(P, s) × c, Odd(j) ∧
              (partnerMap(P, s, p)(j)(fst(y)), snd(y)) = x ∧
              e = singleMonomial(cmTypeE(P, s) × c, y, pow(p, j)))))

-- ThetaProducts.lean, thetaProducts_normal_form: for (p/d) ≠ 1 some ϖ, π
-- with |ϖ| = p^{−ρ_p}, |π| = p^{((p/d)−1)/2} serve every r ≤ 1 and every Θ
-- in the theta products (δ = 1): IsIntegralOnNullCone for each B, with the
-- couplings j ≤ log_p B, j odd or p = d; and if (p/d) = −1 and r = 1,
-- the exponential normal form.
theorem thetaProducts.normal_form (P Z p ι : Set, s : Nat)
  requires choice : PeriodChoiceOf(P, Z)
  requires prime : Prime(p)
  requires place : ι ∈ padicPlaces(p)
  requires nonsplit : quadCharAt(Parameters.d(P), p) ≠ realOne
  shows ∃ ϖ ∈ Ring.carrier(placeCp(p, ι)), ∃ π ∈ placeCpIntegers(p, ι),
    placeCpNorm(p, ι)(ϖ) =
      realRpow(realNat(p), R[-nonsplitWeight(Parameters.d(P), p)]) ∧
    placeCpNorm(p, ι)(π) =
      realRpow(realNat(p), R[(quadCharAt(Parameters.d(P), p) - 1) / 2]) ∧
    ∀ c, Finite(c) → ∀ r ∈ ℝ, RealLe(r, realOne) →
      ∀ Θ ∈ thetaProducts(P, Z, s, p, ι, complexOne, r, c),
        (∀ B ∈ ℕ, IsIntegralOnNullCone(p, ι, cmTypeE(P, s), c, partnerMap(P, s, p),
          nullCouplings(P, p, B), ϖ, π, realNat(B), Θ)) ∧
        (quadCharAt(Parameters.d(P), p) = R[-1] → r = realOne →
          ExponentialNormalForm(P, s, p, ι, c, ϖ, Θ))
proof
  sorry

end ThetaProducts
