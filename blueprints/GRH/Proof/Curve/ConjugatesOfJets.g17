-- Authors: Grant Passmore

module GRH.Proof.Curve.ConjugatesOfJets
import GRH.Proof.Curve.IntegralVacuum
import GRH.Proof.Curve.ThetaProducts

section ConjugatesOfJets
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- The ℂ-module of power series in the variables of V.
def seriesModuleOf (V : Set) : Set :=
  coordinateModule(complexRing, monomials(spaceFockIndex(V)))

-- The image ιₚ(Θ) of a complex series.
def seriesVia (p ι I Θ : Set) : Set :=
  mvSeriesMap(complexRing, placeCp(p, ι), I, placeHom(ι))(Θ)

-- The number Σ_τ Σ_{h<N} h κ_τ(h) of boxes, as a natural number.
def boxTermsNat (κ : Set) : Set := { (q, mul(snd(q), κ(q))) | q ∈ domain(κ) }

def natBoxes (Φ κ N : Set) : Set := natSum(Φ × N, boxTermsNat(κ))

-- M f in 𝒮(V) for a natural M.
def natSmulForm (V M f : Set) : Set :=
  Module.smul(weilForms(V))(complexOfReal(realNat(M)), f)

-- Section: Facts
-- ConjugatesOfJets.lean, finHeisOp_mem_standardData: standard data are
-- stable under ϱ(αx) for x with δx integral above p.
theorem standardData.translate (P V p ι δ k x f : Set)
  requires prime : Prime(p)
  requires place : ι ∈ padicPlaces(p)
  requires space : IsThetaSpace(V)
  requires hx : x ∈ integralAfter(P, V, δ, placesAbove(WeilDatum.field(ThetaSpace.weil(V)), p))
  requires hf : f ∈ standardData(P, V, p, ι, δ, k)
  shows weilAction(V, x, f) ∈ standardData(P, V, p, ι, δ, k)
proof
  sorry

-- ConjugatesOfJets.lean, norm_jetSeries_le: let V be standard, f standard
-- data for ι and δ, and L a ℂ-linear form on power series. If |ι L(Θ)| ≤ r
-- whenever ιΘ is a theta product of scale |ι(c s₁)|, then
-- |ι L(T_{c·per} f)| ≤ r.
theorem jetSeries.norm_le (P Z C k p ι V δ f c L r : Set, s : Nat)
  requires bound : JetConjugateBound(P, Z, C)
  requires scale : VacuumScaleOf(P, C, s, k)
  requires std : V ∈ stdSpaces(P, s)
  requires prime : Prime(p)
  requires place : ι ∈ padicPlaces(p)
  requires hδ : δ ∈ quadIntegers(Parameters.d(P))
  requires hf : f ∈ standardData(P, V, p, ι, δ, k)
  requires hc : c ∈ complexCarrier
  requires linear : LinearMap(L, seriesModuleOf(V), complexRing, selfModule(complexRing))
  requires hr : r ∈ ℝ
  requires products : ∀ Θ ∈ mvSeriesCarrier(complexRing, spaceFockIndex(V)),
    seriesVia(p, ι, spaceFockIndex(V), Θ) ∈ thetaProducts(P, Z, s, p, ι, δ,
      padicPlaceNorm(p, ι, ℂ[c * periodFactor(P, Z, s)]), ThetaSpace.rank(V)) →
    RealLe(padicPlaceNorm(p, ι, L(Θ)), r)
  shows RealLe(padicPlaceNorm(p, ι, L(jetSeries(V, ℂ[c * jetScale(P, Z, s)], f))), r)
proof
  sorry

-- ConjugatesOfJets.lean, norm_jet_jetSeries_le_one (integrality of jets):
-- for V standard, 0 ≠ δ ∈ 𝓞_K, f standard data for δ and Q a polynomial
-- with coefficients in ι⁻¹𝔬, the jet along Q of T_{δ̄ d per} f has
-- |ι(·)| ≤ 1.
theorem jetSeries.jet_integral (P Z C k p ι V δ f Q : Set, s : Nat)
  requires bound : JetConjugateBound(P, Z, C)
  requires scale : VacuumScaleOf(P, C, s, k)
  requires std : V ∈ stdSpaces(P, s)
  requires prime : Prime(p)
  requires place : ι ∈ padicPlaces(p)
  requires hδ : δ ∈ quadIntegers(Parameters.d(P))
  requires nonzero : δ ≠ complexZero
  requires hf : f ∈ standardData(P, V, p, ι, δ, k)
  requires hQ : Q ∈ Ring.carrier(polynomialRing(complexRing, spaceFockIndex(V)))
  requires integralQ : ∀ m ∈ monomials(spaceFockIndex(V)), Q(m) ∈ embValRing(p, ι)
  shows RealLe(padicPlaceNorm(p, ι, polyJet(complexRing, spaceFockIndex(V), Q,
    jetSeries(V, ℂ[complexConj(δ) * complexOfReal(realNat(Parameters.d(P))) *
      jetScale(P, Z, s)], f))), realOne)
proof
  sorry

-- ConjugatesOfJets.lean, mem_raises_of_dvd: if d·f is standard data for
-- δ = N, |ι(c)| ≤ 1 and d (N d_K)^L divides M, L = boxes κ |n′|, then the
-- theta kernel of scale c·per with datum M·f does not raise the p-adic
-- gauges.
theorem thetaKernel.raises_of_dvd (P Z C k p ι V n n2 κ e a b K c f : Set,
    s N dd M : Nat)
  requires bound : JetConjugateBound(P, Z, C)
  requires scale : VacuumScaleOf(P, C, s, k)
  requires std : V ∈ stdSpaces(P, s)
  requires prime : Prime(p)
  requires place : ι ∈ padicPlaces(p)
  requires nonzero : N ≠ (0:N)
  requires hf : natSmulForm(V, dd, f) ∈
    standardData(P, V, p, ι, complexOfReal(realNat(N)), k)
  requires hc : c ∈ complexCarrier
  requires small : RealLe(padicPlaceNorm(p, ι, c), realOne)
  requires divides : mul(dd, pow(mul(N, Parameters.d(P)),
    natBoxes(cmTypeE(P, s), κ, cardinality(n2)))) ∣ M
  shows ThetaKernelRaises(weilDataE(P, s), n, n2, κ, e, a, b, K,
    ℂ[c * jetScale(P, Z, s)], p, ι, natSmulForm(V, M, f), realOne)
proof
  sorry

end ConjugatesOfJets
