-- Authors: Grant Passmore

module GRH.Proof.Curve.FrameSections
import GRH.Proof.Curve.TightFrameExists
import GRH.Proof.Curve.FormalParameter

section FrameSections
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Section: Vacuum expansions
-- The finite vector −x.
def negVector (V x : Set) : Set :=
  { (i, finNeg(WeilDatum.field(ThetaSpace.weil(V)), x(i))) | i ∈ ThetaSpace.rank(V) }

def vacuumExpansionTerms (V m ℓ F shift : Set) : Set :=
  { (j, Module.smul(weilForms(V))(
      ℂ[complexOfReal(realNat(m)) * ℓ(weilAction(V, shift(j), spaceVacuum(V)))],
      weilAction(V, negVector(V, shift(j)), F))) | j ∈ domain(shift) }

-- ConjugateJetDefs.lean, Space.VacuumExpansion δ N F: N^{2fn} finite vectors
-- x_j (f infinite places, n the rank) with δx_j integral, and m ∈ ℕ with
-- Σ_j m ℓ(ϱ(αx_j)vac) ϱ(−αx_j)F = N^{2fn} ℓ(F) vac for every linear form ℓ.
predicate VacuumExpansionOf (V δ N F : Set) :=
  ∃ J, ∃ shift, ∃ m ∈ ℕ,
    Finite(J) ∧ J ≠ ∅ ∧ (shift : J → spacePoints(V)) ∧
    (∀ j ∈ J, ∀ i ∈ ThetaSpace.rank(V),
      finMul(WeilDatum.field(ThetaSpace.weil(V)),
        finOf(WeilDatum.field(ThetaSpace.weil(V)), δ), shift(j)(i)) ∈
        finInt(WeilDatum.field(ThetaSpace.weil(V)))) ∧
    cardinality(J) =
      pow(N, mul(2, cardinality(WeilDatum.cmType(ThetaSpace.weil(V)) × ThetaSpace.rank(V)))) ∧
    ∀ ℓ, LinearMap(ℓ, weilForms(V), complexRing, selfModule(complexRing)) →
      groupFiniteSum(Module.additive(weilForms(V)), J, vacuumExpansionTerms(V, m, ℓ, F, shift)) =
        Module.smul(weilForms(V))(ℂ[complexOfReal(realNat(cardinality(J))) * ℓ(F)],
          spaceVacuum(V))

-- Section: Products along tight frames
-- The point of the twisted translate of the factor i = (j, k):
-- (a/δ̄)(−Σ_τ τ(γ_k) conj τ(w_j)).
def framePointTerms (V w γ i : Set) : Set :=
  { (τ, ℂ[τ(γ(snd(i))) * complexConj(τ(w(fst(i))))]) |
    τ ∈ WeilDatum.cmType(ThetaSpace.weil(V)) }

def framePoint (V w γ a δ i : Set) : Set :=
  ℂ[complexDiv(a, complexConj(δ)) *
    -groupFiniteSum(complexAdditiveGroup, WeilDatum.cmType(ThetaSpace.weil(V)),
      framePointTerms(V, w, γ, i))]

-- G_i = U^{m_j}_{y_i}(θ^a σ^{2b} G^c) for x_i = (a, b, c).
def frameFactor (V C w m x γ a δ i : Set) : Set :=
  twistedTranslate(C, m(fst(i)), framePoint(V, w, γ, a, δ, i), monomialSection(C, x(i)))

def frameValues (V C w m x γ a δ I : Set) : Set :=
  { (i, frameFactor(V, C, w, m, x, γ, a, δ, i)(complexZero)) | i ∈ I × ThetaSpace.rank(V) }

-- The linear form of the factor i at scale c:
-- (τ, k) ↦ a/δ̄/(2π/√d)^{1/2} · c · conj τ(w_j) if k = k_i, 0 otherwise.
def frameLinearCoeff (P w a δ c i y : Set) : Set :=
  ⋃({ z ∈ complexCarrier |
    (snd(y) = snd(i) ∧ z = ℂ[complexDiv(complexDiv(a, complexConj(δ)), areaScale(P)) * c *
      complexConj(fst(y)(w(fst(i))))]) ∨
    (snd(y) ≠ snd(i) ∧ z = complexZero) })

def frameLinear (P V w a δ c i : Set) : Set :=
  { (y, frameLinearCoeff(P, w, a, δ, c, i, y)) | y ∈ spaceFockIndex(V) }

def frameSeriesFactors (P V C w m x γ a δ c I : Set) : Set :=
  { (i, linearSubst(complexRing, spaceFockIndex(V),
      taylorAtZero(frameFactor(V, C, w, m, x, γ, a, δ, i)), frameLinear(P, V, w, a, δ, c, i))) |
    i ∈ I × ThetaSpace.rank(V) }

-- The translate ϱ(γ)F = ϱ(finVec(α⁻¹γ))F.
def frameTranslate (V γ F : Set) : Set :=
  weilAction(V, finiteImage(ThetaSpace.weil(V), ThetaSpace.rank(V), γ), F)

-- Section: Facts
-- FrameSections.lean, Parameters.omega₀_mem_cmCurve_lattice: Ω₀ ∈ Λ_𝓔.
theorem omega0.mem_lattice (P Z : Set)
  requires choice : PeriodChoiceOf(P, Z)
  shows PeriodChoice.omega0(Z) ∈ cmLattice(PeriodChoice.curve(Z))
proof
  sorry

-- FrameSections.lean, Space.eq_zero_of_jetSeries_eq_zero: for all signs +,
-- f ∈ 𝒲_f and a ≠ 0, T_a f = 0 forces f = 0.
theorem jetSeries.eq_zero (V f a : Set)
  requires space : IsThetaSpace(V)
  requires positive : ThetaSpace.signs(V) = unitSigns(ThetaSpace.rank(V))
  requires hf : f ∈ finitePart(V)
  requires ha : a ∈ complexCarrier
  requires nonzero : a ≠ complexZero
  requires vanish : jetSeries(V, a, f) =
    Ring.zero(mvPowerSeriesRing(complexRing, spaceFockIndex(V)))
  shows f = Module.zero(weilForms(V))
proof
  sorry

-- FrameSections.lean, Parameters.exists_finitePart_of_isTightFrame: for V
-- standard, (w, m) a tight frame of length M, δδ̄ = N ≠ 0, a ∈ Λ and
-- area(C) = |a|² M √d/(2N), a product of the monomial sections of degree
-- m_j at (a/δ̄)w̄_j z_k comes from some F ∈ 𝒲_f, compatibly with rational
-- translations (theta values and Taylor series), integral-valued, with a
-- vacuum expansion.
theorem frameSection.exists (P V C I w m M x δ a : Set, s N : Nat)
  requires parameters : Parameters(P)
  requires std : V ∈ stdSpaces(P, s)
  requires hδ : δ ∈ quadIntegers(Parameters.d(P))
  requires nonzero : N ≠ (0:N)
  requires hN : ℂ[δ * complexConj(δ)] = complexOfReal(realNat(N))
  requires frame : IsTightFrame(weilDataE(P, s), I, w, m, M)
  requires hx : (x : I × ThetaSpace.rank(V) → ℕ × (ℕ × ℕ))
  requires degrees : ∀ i ∈ I × ThetaSpace.rank(V), cmMonomialDeg(x(i)) = m(fst(i))
  requires lattice : IsCMLattice(Parameters.d(P), C)
  requires ha : a ∈ cmLattice(C)
  requires area : cmArea(C) =
    R[complexAbs(a) ^ 2 / realNat(N) * realNat(M) * realSqrt(realNat(Parameters.d(P))) / 2]
  shows ∃ F ∈ finitePart(V),
    (∀ γ, (γ : ThetaSpace.rank(V) → carrierE(P, s)) →
      thetaValue(V, frameTranslate(V, γ, F)) =
        finiteRingProduct(I × ThetaSpace.rank(V), complexCarrier, complexAdd, complexZero,
          complexNeg, complexMul, complexOne, frameValues(V, C, w, m, x, γ, a, δ, I)) ∧
      ∀ c ∈ complexCarrier,
        jetSeries(V, c, frameTranslate(V, γ, F)) =
          seriesRingProduct(mvPowerSeriesRing(complexRing, spaceFockIndex(V)),
            I × ThetaSpace.rank(V), frameSeriesFactors(P, V, C, w, m, x, γ, a, δ, c, I))) ∧
    (∀ p ∈ ℕ, Prime(p) → ∀ ι ∈ padicPlaces(p), ∀ y ∈ spacePoints(V),
      RealLe(padicPlaceNorm(p, ι, thetaValue(V, weilAction(V, y, F))), realOne)) ∧
    VacuumExpansionOf(V, δ, N, F)
proof
  sorry

end FrameSections
