module GRH.Proof.Curve.IntegralVacuum
import GRH.Proof.Curve.ConjugateGenerator

section IntegralVacuum
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Section: The scale κ₀
-- IntegralVacuum.lean, Parameters.vacuumScale: κ₀ ≠ 0 with the vacuum bound
-- of exists_isJetConjugate_generator at the standard spaces of rank one.
predicate VacuumScaleOf (P C s k : Set) :=
  k ∈ complexCarrier ∧ k ≠ complexZero ∧
  ∀ V ∈ stdSpaces(P, s), spaceRank(V) = (1:N) → VacuumScaleAt(P, C, s, V, k)

-- IntegralVacuum.lean, Parameters.intVacuum: θ° = κ₀ⁿ vac, n the rank of V,
-- and its value θ°(finVec x) = κ₀ⁿ vac(x).
def intVacuum (V k : Set) : Set :=
  Module.smul(weilForms(V))(ℂ[k ^ spaceRank(V)], spaceVacuum(V))

def intVacuumValue (V k x : Set) : Set := ℂ[k ^ spaceRank(V) * vacValue(V, x)]

-- Section: Standard data
-- The finite adele a is integral at the place w (its component lies in
-- the integers of E_w).
predicate FinIntegralAt (E w a : Set) :=
  ∃ b ∈ Ring.carrier(adicCompletionIntegers(E, w)), adicCompletionInclusion(E, w)(b) = a(w)

-- IntegralVacuum.lean, Parameters.integralAfter δ S: the finite adelic
-- vectors x of V with δ x_i integral at every place w in S.
def integralAfter (P V δ S : Set) : Set :=
  { x ∈ spacePoints(V) | ∀ i ∈ ThetaSpace.rank(V), ∀ w ∈ S,
    FinIntegralAt(WeilDatum.field(ThetaSpace.weil(V)), w,
      finMul(WeilDatum.field(ThetaSpace.weil(V)),
        finOf(WeilDatum.field(ThetaSpace.weil(V)), δ), x(i))) }

-- The places of E above p.
def natComplexValue (p : Set) : Set := complexOfReal(realNat(p))

def placesAbove (E p : Set) : Set := { w ∈ finPlaces(E) | natComplexValue(p) ∈ w }

-- A subset M of 𝒮(V) is an ι⁻¹𝔬-submodule containing θ° and stable under
-- ϱ(αx) for x with δx integral above p.
predicate StandardClosed (P V p ι δ k M : Set) :=
  M ⊆ Module.carrier(weilForms(V)) ∧ intVacuum(V, k) ∈ M ∧
  (∀ f ∈ M, ∀ g ∈ M, call2(Module.add(weilForms(V)), f, g) ∈ M) ∧
  (∀ c ∈ embValRing(p, ι), ∀ f ∈ M, Module.smul(weilForms(V))(c, f) ∈ M) ∧
  (∀ x ∈ integralAfter(P, V, δ,
      placesAbove(WeilDatum.field(ThetaSpace.weil(V)), p)),
    ∀ f ∈ M, weilAction(V, x, f) ∈ M)

-- IntegralVacuum.lean, Parameters.standardData δ: the least such submodule.
def standardData (P V p ι δ k : Set) : Set :=
  { f ∈ Module.carrier(weilForms(V)) |
    ∀ M ∈ 𝒫(Module.carrier(weilForms(V))), StandardClosed(P, V, p, ι, δ, k, M) → f ∈ M }

-- Section: Facts
-- κ₀ exists (the vacuum part of exists_isJetConjugate_generator at rank one).
theorem VacuumScaleOf.exists (P Z C : Set, s : Nat)
  requires bound : JetConjugateBound(P, Z, C)
  shows ∃ k, VacuumScaleOf(P, C, s, k)
proof
  sorry

-- IntegralVacuum.lean, Parameters.norm_intVacuum_le: for V standard of
-- rank n and σ ∈ Aut(ℂ/K), |σ(θ°(finVec x))| ≤ exp(C N₁²)ⁿ.
theorem intVacuumValue.norm_le (P Z C k σ V x : Set, s : Nat)
  requires bound : JetConjugateBound(P, Z, C)
  requires scale : VacuumScaleOf(P, C, s, k)
  requires std : V ∈ stdSpaces(P, s)
  requires hσ : σ ∈ galoisOverK(Parameters.d(P))
  requires hx : x ∈ spacePoints(V)
  shows complexAbs(σ(intVacuumValue(V, k, x))) ≤
    R[realExp(R[realNat(C) * realNat(levelN1(P, s)) ^ 2]) ^ spaceRank(V)]
proof
  sorry

-- IntegralVacuum.lean, Parameters.norm_intVacuum_le_one: |ι(θ°(finVec x))| ≤ 1
-- at every p-adic place.
theorem intVacuumValue.integral (P Z C k p ι V x : Set, s : Nat)
  requires bound : JetConjugateBound(P, Z, C)
  requires scale : VacuumScaleOf(P, C, s, k)
  requires std : V ∈ stdSpaces(P, s)
  requires prime : Prime(p)
  requires place : ι ∈ padicPlaces(p)
  requires hx : x ∈ spacePoints(V)
  shows RealLe(padicPlaceNorm(p, ι, intVacuumValue(V, k, x)), realOne)
proof
  sorry

-- IntegralVacuum.lean, Parameters.exists_intVacuum_ne_zero.
theorem intVacuumValue.exists_ne_zero (P C k V : Set, s : Nat)
  requires parameters : Parameters(P)
  requires scale : VacuumScaleOf(P, C, s, k)
  requires std : V ∈ stdSpaces(P, s)
  shows ∃ x ∈ spacePoints(V), intVacuumValue(V, k, x) ≠ complexZero
proof
  sorry

end IntegralVacuum
