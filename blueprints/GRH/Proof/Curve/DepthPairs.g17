-- Admissible pairings of places for the depth bound at a non-split prime
-- p (IsFrobPacking), the loss factor ∏_{i=1}^{c}(l + i)², and the
-- numerical choice of pairs against the predicted valuation F(p).
-- Source: grh-compact/src/New/Curve/DepthPairs.lean. "Part of: Some jet
-- is no more divisible than predicted (see New.Rows.GluedFormTheta). This
-- file: Choice of admissible pairs and numerical bound against the
-- predicted valuation F(p). Pairs construction: Frobenius couplings force a
-- large coefficient on six copies." (IsFrobPacking,
-- Data.ne_d_of_placeClass_eq, Data.summable_localAsk, Data.depthLossInt,
-- Data.exists_isFrobPacking.)
-- Encoding. Families n, i, y : Φ → ℕ are functions on the places (unit
-- residues modulo N₁); the partner of σ at j is −p^j σ, the place
-- placeMul(placeOfNegNat(p^j), σ); the class of a place modulo N₀ is its
-- residue modulo N₀. The last lemma of the file
-- (exists_hasLargeSplit_of_pairs) is about the theta products of
-- New/Curve/ThetaProducts over ℂ_p and is not stated here (the p-adic
-- places of GRH.Adelic.CuspForms record only absolute values).
-- Part of the GRH blueprint (layer 5, the argument).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Proof.Curve.DepthPairs
import GRH.Proof.Curve.LiveSum

section DepthPairs
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- The partner −p^j σ of the place σ.
def partnerPlace (P D p j σ : Set) : Set :=
  placeMul(P, D.s, placeOfNegNat(P, D.s, pow(p, j)), σ)

-- The places σ whose partner −p^{i_σ} σ is t, and Σ y_σ over them.
def packedInto (P D p i t : Set) : Set :=
  { σ ∈ dataPlaces(P, D) | partnerPlace(P, D, p, i(σ), σ) = t }

def packedTerms (P D p i y t : Set) : Set :=
  { (σ, realNat(y(σ))) | σ ∈ packedInto(P, D, p, i, t) }

def packedSum (P D p i y t : Set) : Set :=
  realFiniteSum(packedTerms(P, D, p, i, y, t), packedInto(P, D, p, i, t))

-- DepthPairs.lean, IsFrobPacking p n i y, with σ* = −p^{i_σ} σ: y_σ ≠ 0
-- forces i_σ odd and (p/d) = −1; if y_σ, y_t ≠ 0 and j < i_σ is odd, then
-- −p^j t ≠ σ*; and p^{i_t} y_t + Σ_{σ* = t} y_σ ≤ n_t.
predicate IsFrobPacking (P D p n i y : Set) :=
  (n : dataPlaces(P, D) → ℕ) ∧ (i : dataPlaces(P, D) → ℕ) ∧
  (y : dataPlaces(P, D) → ℕ) ∧
  (∀ σ ∈ dataPlaces(P, D), y(σ) ≠ (0:N) →
    Odd(i(σ)) ∧ quadCharAt(Parameters.d(P), p) = R[-1]) ∧
  (∀ σ ∈ dataPlaces(P, D), ∀ t ∈ dataPlaces(P, D), ∀ j ∈ ℕ, j < i(σ) →
    y(σ) ≠ (0:N) → y(t) ≠ (0:N) → Odd(j) →
      partnerPlace(P, D, p, j, t) ≠ partnerPlace(P, D, p, i(σ), σ)) ∧
  (∀ t ∈ dataPlaces(P, D),
    R[realNat(mul(pow(p, i(t)), y(t))) + packedSum(P, D, p, i, y, t)] ≤
      R[realNat(n(t))])

-- DepthPairs.lean, Data.depthLossInt n: (∏_{i=1}^{c} (l + i))², with
-- c = ⌈60b/k⌉₊ and l = n − c (truncated).
def depthLossCandidates (D : Set) : Set :=
  { c ∈ ℕ | R[60 * dataB(D) / realNat(dataK(D))] ≤ R[realNat(c)] }

def depthLossCount (D : Set) : Set := leastNatural(depthLossCandidates(D))

def depthLossInt (D n : Set) : Set :=
  pow(quotientNat((add(sub(n, depthLossCount(D)), depthLossCount(D))) !,
    (sub(n, depthLossCount(D))) !), 2)

-- DepthPairs.lean, Data.ne_d_of_placeClass_eq: if −p^e σ ≡ σ modulo N₀,
-- then p ≠ d.
theorem partnerPlace.ne_d (P D p e σ : Set)
  requires data : Data(P, D)
  requires hp : p ∈ ℕ
  requires he : e ∈ ℕ
  requires hσ : σ ∈ dataPlaces(P, D)
  requires same : CongruentMod(partnerPlace(P, D, p, e, σ), σ, Parameters.N0(P))
  shows p ≠ Parameters.d(P)
proof
  sorry

-- DepthPairs.lean, Data.summable_localAsk: for (p/d) ≠ 1 the terms of
-- ask_p(y, σ) are summable.
theorem localAskTerms.summable (P D p Y σ : Set)
  requires data : Data(P, D)
  requires prime : p ∈ ℕ ∧ Prime(p)
  requires nonsplit : quadCharAt(Parameters.d(P), p) ≠ realOne
  requires hY : Y ∈ ℝ
  requires hσ : σ ∈ dataPlaces(P, D)
  shows RealSummable(localAskTerms(P, D, p, Y, σ), ℕ)
proof
  sorry

-- The terms v_p(depthLossInt(n_σ)), v_p(n_σ!) − y_σ and
-- (1/(p − 1) − ρ_p) n_σ + 4 b₂ − y_σ over the places.
def depthLossValTerms (P D p n : Set) : Set :=
  { (σ, realNat(padicValNat(p, depthLossInt(D, n(σ))))) | σ ∈ dataPlaces(P, D) }

def factorialValTerms (P D p n y : Set) : Set :=
  { (σ, R[realNat(padicValNat(p, (n(σ)) !)) - realNat(y(σ))]) |
    σ ∈ dataPlaces(P, D) }

def slopeTerms (P D p n y : Set) : Set :=
  { (σ, R[(1 / (realNat(p) - 1) - nonsplitWeight(Parameters.d(P), p)) *
      realNat(n(σ)) + realNat(dataB2(P, D)) * 4 - realNat(y(σ))]) |
    σ ∈ dataPlaces(P, D) }

-- L = F(p) + Σ_σ v_p(depthLossInt(n_σ)).
def depthBudget (P D p n : Set) : Set :=
  R[forcedPart(P, D, p) + realFiniteSum(depthLossValTerms(P, D, p, n), dataPlaces(P, D))]

-- The constant family 1 on the places.
def placeOnes (P D : Set) : Set := { (σ, 1) | σ ∈ dataPlaces(P, D) }

-- n_σ within [w(σ), w(σ) + x^42] at every place, w = nominalWeight.
predicate NearNominal (P D n : Set) :=
  (n : dataPlaces(P, D) → ℕ) ∧
  ∀ σ ∈ dataPlaces(P, D), nominalWeight(P, D, σ) ≤ R[realNat(n(σ))] ∧
    R[realNat(n(σ))] ≤ R[nominalWeight(P, D, σ) + dataX(D) ^ 42]

-- DepthPairs.lean, Data.exists_isFrobPacking: for such n, a prime p with
-- (p/d) ≠ 1 has an admissible packing (i, y) with either (p/d) = −1,
-- i = 1 and Σ_σ (v_p(n_σ!) − y_σ) ≤ L, or
-- Σ_σ ((1/(p − 1) − ρ_p) n_σ + 4 b₂ − y_σ) ≤ L.
theorem Data.exists_isFrobPacking (P D p n : Set)
  requires data : Data(P, D)
  requires near : NearNominal(P, D, n)
  requires prime : p ∈ ℕ ∧ Prime(p)
  requires nonsplit : quadCharAt(Parameters.d(P), p) ≠ realOne
  shows ∃ i, ∃ y, IsFrobPacking(P, D, p, n, i, y) ∧
    ((quadCharAt(Parameters.d(P), p) = R[-1] ∧ i = placeOnes(P, D) ∧
        realFiniteSum(factorialValTerms(P, D, p, n, y), dataPlaces(P, D)) ≤
          (depthBudget(P, D, p, n):R)) ∨
      realFiniteSum(slopeTerms(P, D, p, n, y), dataPlaces(P, D)) ≤
        (depthBudget(P, D, p, n):R))
proof
  sorry

end DepthPairs
