-- Normal form of theta series at non-split primes: jets of products of
-- torsion translates of θ are integral after scaling; series integral on
-- the substitutions that kill the Frobenius couplings (IsIntegralOnNullCone);
-- the good formal parameter and the three-term normal form of log θ at
-- non-split primes.
-- Source: grh-compact/src/New/Curve/FormalParameter.lean ("This file:
-- Jets of products of torsion translates of theta are integral after
-- scaling. Valuations of coefficients of log theta: only two degrees keep
-- a denominator. Property: series integral on substitutions killing the
-- Frobenius couplings. Good formal parameter and three-term normal form of
-- log theta at non-split primes."; CMLattice.jet_theta_prod_integral,
-- IsIntegralOnNullCone, CMLattice.exists_formal_parameter), with
-- Lib/General/Algebra/ZerosCostDegree.lean (jet).
-- Encoding. A p-adic place ι is a pair (Ω, ιₚ) (GRH.General.PadicPlace);
-- series over 𝔬 are series over ℂ_p with integral coefficients
-- (GRH.Proof.Forward.Theta). In IsIntegralOnNullCone the source asks the
-- couplings to vanish under every ring map φ from 𝔬[[τ]] to a ring of
-- characteristic p with φ(θ) = 0; that is, to lie in the ideal (p, θ) of
-- 𝔬[[τ]] (take φ the quotient map), which is how it is stated here. The
-- source's implicit variable type τ of the substituted series is any set.
-- Not stated here: the technical lemmas exists_norm_eq_inv_pow_bounds,
-- norm_coeff_le_of_deriv and coeff_subst_tangent used inside the proof of
-- exists_formal_parameter.
-- Part of the GRH blueprint (layer 5, the argument).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Proof.Curve.FormalParameter
import GRH.Proof.Forward.Theta
import GRH.Proof.Curve.LiveSum

section FormalParameter
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Section: Jets and substitutions
-- ZerosCostDegree.lean, jet Q F = Σ_m m! Q_m F_m (Q(∂)F at 0) over a ring R.
-- m! = Π_i m_i! as an element of R.
def natFactorialOf (k : Nat) : Nat := k !

def ringFactorials (R I m : Set) : Set :=
  { (i, ringNat(Ring.add(R), Ring.zero(R), Ring.one(R), natFactorialOf(m(i)))) | i ∈ I }

def ringMonomialFactorial (R I m : Set) : Set :=
  finiteRingProduct(functionSupport(m, I, 0), Ring.carrier(R), Ring.add(R), Ring.zero(R),
    Ring.neg(R), Ring.mul(R), Ring.one(R), ringFactorials(R, I, m))

def polyJetTerms (R I Q F : Set) : Set :=
  { (m, call2(Ring.mul(R), ringMonomialFactorial(R, I, m),
      call2(Ring.mul(R), Q(m), F(m)))) | m ∈ mvSupport(R, I, Q) }

def polyJet (R I Q F : Set) : Set :=
  groupFiniteSum(Ring.additive(R), mvSupport(R, I, Q), polyJetTerms(R, I, Q, F))

-- The polynomial ιₚ(Q), coefficientwise.
def polyVia (ι J Q : Set) : Set := { (m, placeHom(ι)(Q(m))) | m ∈ monomials(J) }

-- The monomials of degree at most d.
def lowMonomials (I d : Set) : Set := { n ∈ monomials(I) | monomialDegree(I, n) ≤ d }

-- MvPowerSeries.subst Z Θ for Z : I → R[[J]] without constant terms (I
-- finite): the coefficient at z^m is Σ_{|n| ≤ |m|} Θ_n (Π_x Z_x^{n_x})_m.
def mvSubstTerms (R I J Θ Z m : Set) : Set :=
  { (n, call2(Ring.mul(R), Θ(n),
      evaluationAt(mvPowerSeriesRing(R, J), I, Z)(
        mvMonomial(mvPowerSeriesRing(R, J), I, n, Ring.one(mvPowerSeriesRing(R, J))))(m))) |
    n ∈ lowMonomials(I, monomialDegree(J, m)) }

def mvSubstitute (R I J Θ Z : Set) : Set :=
  { (m, groupFiniteSum(Ring.additive(R), lowMonomials(I, monomialDegree(J, m)),
      mvSubstTerms(R, I, J, Θ, Z, m))) | m ∈ monomials(J) }

-- The ring 𝔬[[τ]] of series over 𝔬 in the variables τ.
def integralSeriesRing (p ι τ : Set) : Set :=
  subringRing(mvPowerSeriesRing(placeCp(p, ι), τ), integralMvSeries(p, ι, τ))

-- Section: Integrality on the null cone
-- ϖ · Z_x for each x.
def scaledSeries (p ι ϖ τ F : Set) : Set :=
  { (m, call2(Ring.mul(placeCp(p, ι)), ϖ, F(m))) | m ∈ monomials(τ) }

def scaledFamily (p ι ϖ I τ Z : Set) : Set := { (x, scaledSeries(p, ι, ϖ, τ, Z(x))) | x ∈ I }

-- The coupling Σ_x Z_x^{p^j} Z_{(pr_j σ, c)} for x = (σ, c), in 𝔬[[τ]].
def couplingSeriesTerms (p ι Φ c τ pr Z j : Set) : Set :=
  { (x, call2(Ring.mul(integralSeriesRing(p, ι, τ)),
      Ring.pow(integralSeriesRing(p, ι, τ), Z(x), pow(p, j)),
      Z((pr(j)(fst(x)), snd(x))))) | x ∈ Φ × c }

def couplingSeries (p ι Φ c τ pr Z j : Set) : Set :=
  groupFiniteSum(Ring.additive(integralSeriesRing(p, ι, τ)), Φ × c,
    couplingSeriesTerms(p, ι, Φ, c, τ, pr, Z, j))

-- p as an element of ℂ_p (and any natural number).
def cpNatValue (p ι k : Set) : Set :=
  ringNat(Ring.add(placeCp(p, ι)), Ring.zero(placeCp(p, ι)), Ring.one(placeCp(p, ι)), k)

-- The ideal (p, θ) of 𝔬[[τ]] for θ ∈ 𝔬.
def primeThetaIdeal (p ι τ θ : Set) : Set :=
  generatedIdeal(integralSeriesRing(p, ι, τ),
    { mvSeriesConstant(placeCp(p, ι), τ, cpNatValue(p, ι, p)),
      mvSeriesConstant(placeCp(p, ι), τ, θ) })

-- FormalParameter.lean, IsIntegralOnNullCone pr S ϖ θ B Θ: for every
-- family Z of series over 𝔬 without constant term whose couplings
-- Σ_x Z_x^{p^j} Z_{(pr_j σ, c)}, j ∈ S, lie in (p, θ), the coefficients of
-- Θ(ϖZ) of degree at most B (a real) have norm at most 1.
predicate IsIntegralOnNullCone (p ι Φ c pr S ϖ θ B Θ : Set) :=
  ∀ τ, ∀ Z, (Z : Φ × c → integralMvSeries(p, ι, τ)) →
    (∀ x ∈ Φ × c, mvSeriesConstantCoeff(τ, Z(x)) = Ring.zero(placeCp(p, ι))) →
    (∀ j ∈ S, couplingSeries(p, ι, Φ, c, τ, pr, Z, j) ∈ primeThetaIdeal(p, ι, τ, θ)) →
    ∀ m ∈ monomials(τ), RealLe(realNat(monomialDegree(τ, m)), B) →
      RealLe(placeCpNorm(p, ι)(mvSubstitute(placeCp(p, ι), Φ × c, τ, Θ,
        scaledFamily(p, ι, ϖ, Φ × c, τ, Z))(m)), realOne)

-- Section: Jets of theta products
-- The factor (taylorVia ιₚ (U_{y_i}θ)).subst (linearSeries (ιₚ ∘ c_i)) in
-- the variables J, and the product over i ∈ I.
def placeValues (p ι J c : Set) : Set := { (x, placeHom(ι)(c(x))) | x ∈ J }

def thetaFactor (p ι C J y c : Set) : Set :=
  linearSubst(placeCp(p, ι), J,
    taylorVia(p, ι, twistedTranslate(C, (1:N), y, cmTheta(C))), placeValues(p, ι, J, c))

def thetaFactors (p ι C I J y c : Set) : Set :=
  { (i, thetaFactor(p, ι, C, J, y(i), c(i))) | i ∈ I }

def seriesRingProduct (R I f : Set) : Set :=
  finiteRingProduct(I, Ring.carrier(R), Ring.add(R), Ring.zero(R), Ring.neg(R),
    Ring.mul(R), Ring.one(R), f)

def thetaProduct (p ι C I J y c : Set) : Set :=
  seriesRingProduct(mvPowerSeriesRing(placeCp(p, ι), J), I, thetaFactors(p, ι, C, I, J, y, c))

-- FormalParameter.lean, CMLattice.jet_theta_prod_integral: let 0 ≠ δ ∈ 𝓞_K,
-- δ y_i ∈ Λ, and |ι(δ̄)⁻¹ c_{i,x}/d| ≤ 1. Then for every polynomial Q
-- with coefficients in ι⁻¹𝔬, the jet of Π_i (U_{y_i}θ)(Σ_x c_{i,x} z_x),
-- read in ℂ_p, lies in 𝔬.
theorem jetThetaProduct.integral (d : Nat, C p ι I J c δ y Q : Set)
  requires sevenMod : PrimeSevenModEight(d)
  requires lattice : IsCMLattice(d, C)
  requires prime : Prime(p)
  requires place : ι ∈ padicPlaces(p)
  requires finiteI : Finite(I)
  requires finiteJ : Finite(J)
  requires hc : (c : I → functionSpace(J, complexCarrier))
  requires small : ∀ i ∈ I, ∀ x ∈ J,
    RealLe(padicPlaceNorm(p, ι, complexDiv(c(i)(x),
      ℂ[complexConj(δ) * complexOfReal(realNat(d))])), realOne)
  requires hδ : δ ∈ quadIntegers(d)
  requires nonzero : δ ≠ complexZero
  requires hy : (y : I → complexCarrier)
  requires torsion : ∀ i ∈ I, ℂ[δ * y(i)] ∈ cmLattice(C)
  requires hQ : Q ∈ Ring.carrier(polynomialRing(complexRing, J))
  requires integralQ : ∀ m ∈ monomials(J), Q(m) ∈ embValRing(p, ι)
  shows polyJet(placeCp(p, ι), J, polyVia(ι, J, Q),
      thetaProduct(p, ι, C, I, J, y, c)) ∈ placeCpIntegers(p, ι)
proof
  sorry

-- Section: The formal parameter
-- The sums S^k in 𝔬[[X]] and the relation S − S^{p^e} = X + πE.
def seriesPow (p ι S k : Set) : Set := Ring.pow(powerSeriesRing(placeCp(p, ι)), S, k)

def seriesScale (p ι a S : Set) : Set :=
  { (n, call2(Ring.mul(placeCp(p, ι)), a, S(n))) | n ∈ ℕ }

def seriesAddCp (p ι S T : Set) : Set := call2(Ring.add(powerSeriesRing(placeCp(p, ι))), S, T)

def seriesSubCp (p ι S T : Set) : Set :=
  seriesAddCp(p, ι, S, apply(Ring.neg(powerSeriesRing(placeCp(p, ι))), T))

-- The first part of exists_formal_parameter: e ≥ 1, |ϖ| = p^{−ρ_p},
-- 1/p ≤ |π| < 1, S, E over 𝔬 with S(0) = 0 and S − S^{p^e} = X + πE, and
-- T ∈ 𝔬[[φ]] with T(ϖX) = ϖS.
predicate FormalParameterAt (d : Nat, C p ι e ϖ π S E : Set) :=
  e ∈ ℕ ∧ e ≠ (0:N) ∧ ϖ ∈ Ring.carrier(placeCp(p, ι)) ∧
  placeCpNorm(p, ι)(ϖ) = realRpow(realNat(p), R[-nonsplitWeight(d, p)]) ∧
  π ∈ placeCpIntegers(p, ι) ∧
  RealLe(realInv(realNat(p)), placeCpNorm(p, ι)(π)) ∧
  placeCpNorm(p, ι)(π) < realOne ∧
  S ∈ integralSeries(p, ι) ∧ E ∈ integralSeries(p, ι) ∧
  S((0:N)) = Ring.zero(placeCp(p, ι)) ∧
  seriesSubCp(p, ι, S, seriesPow(p, ι, S, pow(p, e))) =
    seriesAddCp(p, ι, seriesX(placeCp(p, ι)), seriesScale(p, ι, π, E)) ∧
  (∃ T ∈ phiSeriesRing(p, ι, C),
    seriesRescale(placeCp(p, ι), ϖ, T) = seriesScale(p, ι, ϖ, S))

-- The second part, for (p/d) ≠ 1 and p ≥ 13: |π| = p^{((p/d) − 1)/2},
-- e = 1 and p = d, or e = 2, u₀ = 0 and |u₁| = 1; ψ = u₀X² + u₁S^{p+1} +
-- u₂S^{p+p^e} + πR with ψ(0) = 0; and for n prime to p a unit N and κ with
-- |κ| = p^{(1−(p/d))/2 − 1/(p−1)} such that (U_yθ)(ϖX) ∈ exp(κψ)𝔬[[X]] at
-- NX whenever n y ∈ Λ.
predicate NormalFormAt (d : Nat, C p ι e ϖ π S : Set) :=
  ∃ u0 ∈ placeCpIntegers(p, ι), ∃ u1 ∈ placeCpIntegers(p, ι),
    ∃ u2 ∈ placeCpIntegers(p, ι), ∃ Rs ∈ integralSeries(p, ι), ∃ ψ,
      placeCpNorm(p, ι)(π) =
        realRpow(realNat(p), R[(quadCharAt(d, p) - 1) / 2]) ∧
      ((e = (1:N) ∧ p = d) ∨
        (e = (2:N) ∧ u0 = Ring.zero(placeCp(p, ι)) ∧ placeCpNorm(p, ι)(u1) = realOne)) ∧
      ψ = seriesAddCp(p, ι, seriesAddCp(p, ι,
          seriesScale(p, ι, u0, seriesPow(p, ι, seriesX(placeCp(p, ι)), (2:N))),
          seriesScale(p, ι, u1, seriesPow(p, ι, S, add(p, 1)))),
        seriesAddCp(p, ι, seriesScale(p, ι, u2, seriesPow(p, ι, S, add(p, pow(p, e)))),
          seriesScale(p, ι, π, Rs))) ∧
      ψ((0:N)) = Ring.zero(placeCp(p, ι)) ∧
      ∀ n ∈ ℕ, gcd(p, n) = (1:N) →
        ∃ N ∈ Ring.carrier(placeCp(p, ι)), ∃ κ ∈ Ring.carrier(placeCp(p, ι)),
          placeCpNorm(p, ι)(N) = realOne ∧
          placeCpNorm(p, ι)(κ) = realRpow(realNat(p),
            R[(1 - quadCharAt(d, p)) / 2 - 1 / (realNat(p) - 1)]) ∧
          ∀ y ∈ complexCarrier, ℂ[complexOfReal(realNat(n)) * y] ∈ cmLattice(C) →
            ∃ V ∈ integralSeries(p, ι),
              seriesRescale(placeCp(p, ι), ϖ,
                taylorVia(p, ι, twistedTranslate(C, (1:N), y, cmTheta(C)))) =
              seriesRescale(placeCp(p, ι), N,
                call2(Ring.mul(powerSeriesRing(placeCp(p, ι))),
                  seriesSubst(placeCp(p, ι), seriesExp(placeCp(p, ι)),
                    seriesScale(p, ι, κ, ψ)), V))

-- FormalParameter.lean, CMLattice.exists_formal_parameter (normal form of
-- theta series at non-split primes).
theorem FormalParameterAt.exists (d : Nat, C p ι : Set)
  requires sevenMod : PrimeSevenModEight(d)
  requires lattice : IsCMLattice(d, C)
  requires prime : Prime(p)
  requires place : ι ∈ padicPlaces(p)
  shows ∃ e, ∃ ϖ, ∃ π, ∃ S, ∃ E, FormalParameterAt(d, C, p, ι, e, ϖ, π, S, E) ∧
    (quadCharAt(d, p) ≠ realOne → (13:N) ≤ p → NormalFormAt(d, C, p, ι, e, ϖ, π, S))
proof
  sorry

end FormalParameter
