-- The generator of the vacuum theta function: the relation IsJetConjugate
-- at the scale per of the period choice, the vacuum bound and the
-- generator property at one standard space, and the constant C that serves
-- every s (the source's Parameters.c chooses it).
-- Source: grh-compact/src/New/Curve/ConjugateGenerator.lean ("Known
-- results stated on this proof's data: Galois action on CM theta
-- functions and on the finite Weil representation (known result; see
-- Lib.CM.Reciprocity.SemilinearWeilLaw). This file: Galois action on
-- translates of a theta product; integral bounded scaled vacuum values.";
-- bigOmega_pos, jetScale_ne_zero, exists_isJetConjugate_generator), with
-- Lib/Weil/Construction/ConjugateJetDefs.lean (Space.IsJetConjugate).
-- Encoding. The scale per is jetScale(P, Z, s) for the record Z of the
-- choices of the curve (GRH.Proof.Curve.PeriodDefs); the source's
-- permutation placePerm s σ of the places is the renaming of
-- JetConjugateAt (GRH.Weil.RealData). The source's c chooses C by
-- exists_isJetConjugate_generator; here C is the field Data.jetConst
-- bound by JetConjugateBound.
-- Part of the GRH blueprint (layer 5, the argument).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Proof.Curve.ConjugateGenerator
import GRH.Proof.Curve.PeriodDefs

section JetGenerator
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- ConjugateJetDefs.lean, Space.IsJetConjugate σ (placePerm s σ)
-- (P.jetScale s) t F F′ for the space V: the jet series T_per F
-- (DataProduct.lean, Space.jetSeries; its coefficient at z^m is
-- per^{|m|}/m! θ(v_m ⊗ F), v_m the Fock vector of z^m) at the scale
-- per = jetScale(P, Z, s), with σ applied to its coefficients, is the jet
-- series T_t F′ with the variables (φ, i) renamed to
-- ((placePerm s σ)⁻¹ φ, i) = (σ⁻¹ ∘ φ, i) (GRH.Weil.RealData,
-- JetConjugateAt).
predicate IsJetConjugate (P Z s V σ t F G : Set) :=
  σ ∈ complexAutomorphisms ∧ JetConjugateAt(V, σ, jetScale(P, Z, s), t, F, G)

-- The vacuum part of exists_isJetConjugate_generator at one standard V:
-- some c ≠ 0 makes the values c·vac integral at every p-adic place and of
-- size at most e^{C N₁² n} at every σ ∈ Gal(ℂ/K), n the rank of V.
predicate VacuumIntegralBound (P C s V : Set) :=
  ∃ c ∈ complexCarrier, c ≠ ℂ[0] ∧
    (∀ p ∈ ℕ, Prime(p) → ∀ ι ∈ padicPlaces(p), ∀ x ∈ spacePoints(V),
      RealLe(padicPlaceNorm(p, ι, ℂ[c * vacValue(V, x)]), realOne)) ∧
    (∀ σ ∈ galoisOverK(Parameters.d(P)), ∀ x ∈ spacePoints(V),
      complexAbs(σ(ℂ[c * vacValue(V, x)])) ≤
        R[realExp(R[realNat(C) * realNat(levelN1(P, s)) ^ 2]) ^
          spaceRank(V)])

-- The generator part at V: some F ∈ 𝒲_f with θF = 1 whose translates span
-- 𝒲_f, and for each σ ∈ Gal(ℂ/K) some t with |t|² = 1/Ω and F′ ∈ 𝒲_f with
-- σ T_per ϱ(x)F = T_t ϱ(B_σ x)F′ (IsJetConjugate) for every x.
predicate JetGenerator (P Z s B V : Set) :=
  ∃ F ∈ finitePart(V), thetaValue(V, F) = ℂ[1] ∧
    finitePart(V) ⊆ moduleSpan(weilForms(V), complexRing, weilOrbit(V, F)) ∧
    (∀ σ ∈ galoisOverK(Parameters.d(P)), ∃ t ∈ complexCarrier,
      ∃ G ∈ finitePart(V),
        R[complexAbs(t) ^ 2] = R[1 / bigOmega(P, s)] ∧
        (∀ x ∈ spacePoints(V),
          IsJetConjugate(P, Z, s, V, σ, t, weilAction(V, x, F),
            weilAction(V, ideleAct(V, B(σ), x), G))))

-- ConjugateGenerator.lean, Parameters.exists_isJetConjugate_generator: C
-- serves every s: for each s some B : Gal(ℂ/K) → 𝔸f(E) makes every
-- standard V satisfy the vacuum bound and the generator property. The
-- source's c chooses C by this property (Parameters.c); here C is the
-- field Data.jetConst bound by it, at the period choice Data.period.
predicate JetConjugateBound (P Z C : Set) :=
  C ∈ ℕ ∧ ∀ s ∈ ℕ, ∃ B,
    (B : galoisOverK(Parameters.d(P)) → finiteIdeles(P, s)) ∧
    ∀ V ∈ stdSpaces(P, s),
      VacuumIntegralBound(P, C, s, V) ∧ JetGenerator(P, Z, s, B, V)

-- Section: Facts
-- ConjugateGenerator.lean, Parameters.bigOmega_pos: Ω > 0.
theorem bigOmega.pos (P : Set, s : Nat)
  requires parameters : Parameters(P)
  shows (0:R) < (bigOmega(P, s):R)
proof
  sorry

-- ConjugateGenerator.lean, Parameters.jetScale_ne_zero: per ≠ 0.
theorem jetScale.ne_zero (P Z : Set, s : Nat)
  requires choice : PeriodChoiceOf(P, Z)
  shows jetScale(P, Z, s) ∈ complexCarrier ∧ jetScale(P, Z, s) ≠ complexZero
proof
  sorry

-- ConjugateGenerator.lean, Parameters.exists_isJetConjugate_generator:
-- some C serves every s (for the source's choices of the curve; the proof
-- uses only the properties PeriodChoiceOf states).
theorem JetConjugateBound.exists (P Z : Set)
  requires choice : PeriodChoiceOf(P, Z)
  shows ∃ C, JetConjugateBound(P, Z, C)
proof
  sorry

end JetGenerator
