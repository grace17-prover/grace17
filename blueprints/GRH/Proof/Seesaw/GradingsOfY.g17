-- The level of the lifted forms on Y_m: the index sets of the spaces Y_j
-- and their blocks, the places of the level (the chosen places and those of
-- the twist), the level group of ∏ GL(Y_m mod w) (1 at the chosen places,
-- block upper triangular at Q), its character κ ↦ ∏ μ_{l,w}(det κ_ll),
-- and the level setting of the codomain of Data.iotaAtLevel ϑ.
-- Source: grh-compact/src/New/Seesaw/GradingsOfY.lean ("Set-up for this
-- proof: records of the data and parameters of this proof, names for its
-- objects. [...] This file: Levels, finite data, Weil actions and tame
-- characters of the row lifts. Defines the indefinite chain of theta
-- lifts, its levels, character and equivariance law. Gradings of the
-- spaces Y_k and evaluated finite data for each pair."; blockNumber,
-- Data.lastResLevel, Data.lastLevelChar, the codomain of
-- Data.iotaAtLevel), with New/Seesaw/IndexTypes.lean (BlockIndex, Data.Y)
-- and New/Trace/GoodIdempotent.lean (Data.levelPlaces).
-- Encoding. The index set Y_j = BlockIndex RowIndex (Fin t) j of the
-- source is the natural number r + j t, the block R being {0, …, r − 1}
-- and the l-th copy of Fin t the indices r + (l − 1)t, …, r + l t − 1 (a
-- bijection the source leaves to `BlockIndex.equivSum`). The places of the
-- level are indexed by the pairs (0, x), x a chosen place (i, w), and
-- (1, w), w ∈ Q (the source's ChosenIndex ⊕ TwistIndex). The lift chain
-- itself (Data.liftY, Data.ι, Data.iotaAtLevel) needs the theta lifts of
-- Lib/Weil and is GRH.Proof.Forward.Automorphic's liftTheta.
-- Part of the GRH blueprint (layer 5, the argument).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Proof.Seesaw.GradingsOfY
import GRH.Proof.Seesaw.IndexTypes
import GRH.Proof.Curve.LiveSum
import GRH.Matrix.Determinant

section GradingsOfY
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)

-- Section: Index sets and blocks
-- IndexTypes.lean, Data.Y j = BlockIndex RowIndex (Fin t) j, with
-- r + j t elements (BlockIndex.card).
def yRank (D j : Set) : Set := add(D.r, mul(j, dataT(D)))

-- GradingsOfY.lean, blockNumber j: 0 on R and l on the l-th copy of
-- Fin t.
def blockNumber (D i : Set) : Set :=
  ⋃({ b ∈ ℕ | (i < (D.r:N) ∧ b = (0:N)) ∨
    (¬(i < (D.r:N)) ∧ b = succ(quotientNat(sub(i, D.r), dataT(D)))) })

-- The l-th diagonal block (l ≥ 1) of a matrix g on Y_j, a t × t matrix.
def blockEntry (D l a : Set) : Set := add(D.r, add(mul(sub(l, 1), dataT(D)), a))

def diagonalBlock (D g l : Set) : Set :=
  { (q, g((blockEntry(D, l, fst(q)), blockEntry(D, l, snd(q))))) |
    q ∈ dataT(D) × dataT(D) }

-- Section: The places of the level
-- GoodIdempotent.lean, Data.levelPlaces ϑ: the chosen places above g₀,
-- g₁ and the places of the set Q of ϑ, as a family of finite places.
def levelIndexSet (P D ϑ : Set) : Set := ({(0:N)} × chosenIndex(P, D)) ∪ ({(1:N)} × ϑ.Q)

def chosenLevelPlaces (P D : Set) : Set :=
  { (((0:N), x), chosenPlace(x)) | x ∈ chosenIndex(P, D) }

def twistLevelPlaces (ϑ : Set) : Set := { (((1:N), w), w) | w ∈ ϑ.Q }

def levelPlaceFamily (P D ϑ : Set) : Set := chosenLevelPlaces(P, D) ∪ twistLevelPlaces(ϑ)

-- The groups GL(Y_m mod w) at the places of the level.
def lastGLFamily (P D ϑ : Set) : Set :=
  { (y, generalLinearGroup(resField(dataE(P, D), levelPlaceFamily(P, D, ϑ)(y)),
      yRank(D, D.m))) | y ∈ levelIndexSet(P, D, ϑ) }

-- Section: The level group and its character
-- GradingsOfY.lean, Data.lastResLevel ϑ: the elements of ∏_y GL(Y_m mod w_y)
-- equal to 1 at the chosen places and block upper triangular (the
-- parabolic of blockNumber) at the places of Q.
def lastResLevel (P D ϑ : Set) : Set :=
  { g ∈ familyCarrier(levelIndexSet(P, D, ϑ), lastGLFamily(P, D, ϑ)) |
    (∀ x ∈ chosenIndex(P, D),
      g(((0:N), x)) = matOne(resField(dataE(P, D), chosenPlace(x)), yRank(D, D.m))) ∧
    (∀ w ∈ ϑ.Q, ∀ a ∈ yRank(D, D.m), ∀ b ∈ yRank(D, D.m),
      (blockNumber(D, b):N) < blockNumber(D, a) →
        g(((1:N), w))((a, b)) = Ring.zero(resField(dataE(P, D), w))) }

-- The blocks l = 1, …, m of Y_m beyond the first.
def liftBlocks (D : Set) : Set := { l ∈ ℕ | (1:N) ≤ l ∧ l ≤ D.m }

-- The factor μ_{l,w}(det g_ll) at the place w_y and the block l, μ_{l,w}
-- the tame part ω^l ψ^l of μ⁰_l ϑ^l at w_y (GradingsOfY.lean,
-- Data.liftTame), for the residue characters ω.
def lastLevelFactors (P D ω ϑ g : Set) : Set :=
  { (z, liftTamePart(P, D, ω, ϑ, snd(z))(levelPlaceFamily(P, D, ϑ)(fst(z)))(
      matDet(resField(dataE(P, D), levelPlaceFamily(P, D, ϑ)(fst(z))), dataT(D),
        diagonalBlock(D, g(fst(z)), snd(z))))) |
    z ∈ levelIndexSet(P, D, ϑ) × liftBlocks(D) }

-- GradingsOfY.lean, Data.lastLevelChar ϑ: κ ↦ ∏_y ∏_{l=1}^{m}
-- μ_{l,w_y}(det κ_ll), a homomorphism from the level group to ℂ.
def lastLevelChar (P D L ϑ : Set) : Set :=
  { (g, charProduct(levelIndexSet(P, D, ϑ) × liftBlocks(D),
      lastLevelFactors(P, D, AutoChoices.omega(LiftChoices.choices(L)), ϑ, g))) |
    g ∈ lastResLevel(P, D, ϑ) }

-- Section: The weight on Y_m
-- LiveSum.lean, Data.columnsY and Data.lastEntry m, read on the CM type
-- Φ through the dictionary of places.
def columnsYOnPhi (P D : Set) : Set :=
  { ((placeEmbeddingE(P, D.s, fst(q)), snd(q)), columnsY(P, D, fst(q), snd(q))) |
    q ∈ dataPlaces(P, D) × ℕ }

def lastEntryOnPhi (P D j : Set) : Set := weightOnPhi(P, D, lastEntries(P, D, j))

-- The level setting of the codomain LevelForm (D.levelPlaces ϑ)
-- (lastResLevel ϑ) (lastLevelChar ϑ) D.columnsY (D.lastEntry D.m) of
-- GradingsOfY.lean, Data.iotaAtLevel ϑ: the field E, its CM type, the rank
-- Y_m, the places of the level, the level group, its character and the
-- weight datum of (columnsY, lastEntry m).
def liftLevelSetting (P D L ϑ : Set) : Set :=
  LevelSetting.mk(dataE(P, D), dataPhi(P, D), yRank(D, D.m),
    levelPlaceFamily(P, D, ϑ), lastResLevel(P, D, ϑ), lastLevelChar(P, D, L, ϑ),
    schurWeightDatum(dataE(P, D), dataPhi(P, D), yRank(D, D.m),
      columnsYOnPhi(P, D), lastEntryOnPhi(P, D, D.m)))

end GradingsOfY
