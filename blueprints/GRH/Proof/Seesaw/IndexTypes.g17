-- The level prime of the data: the target λ for log N and the property
-- the source's choice Data.N has (a prime N ≡ 1 mod M_ω² with
-- λ ≤ log N ≤ λ + √(log b)).
-- Source: grh-compact/src/New/Seesaw/IndexTypes.lean ("Different
-- generator and root discriminant lie between x^10 and x^12. Chosen places
-- above g, tame characters there, base characters and pairs for the data.
-- Row parameter, level prime N and its size, tame twists, characters of
-- the lifts. Index types, signs, parameters, level group and good
-- idempotent for the proof's spaces."). Set-up for this proof: records of
-- the data and parameters of this proof, names for its objects.
-- Encoding. The source chooses N from Data.exists_prime_window, and π,
-- the residue characters ω, μ♭, χ and the spaces Y_j; here they are the
-- fields of a record of choices L (`LiftChoices`, with the record
-- `AutoChoices` of the last five), bound by LevelPrime below and by
-- AutomorphicChoices (GRH.Proof.Forward.Automorphic), exactly the
-- properties of those choices. E is the field fieldE(P, s) of
-- GRH.Proof.Data.Different, inside ℂ, so π_G, π and the finite places of E
-- are read in ℂ; a chosen place is a pair (i, w) with i ∈ {0, 1} (the
-- source's Σ i, ChosenPlace i). The row index set RowIndex is the natural
-- number r (it has r elements, Data.card_rowIndex; the source's chosen
-- numbering basisNumber is the identity). A tame character is a record
-- (μ, Q, ψ) (TameCharRecord). The objects that need the theta lifts (the
-- spaces Y_j, e₀) stay forward declarations of
-- GRH.Proof.Forward.Automorphic.
-- Part of the GRH blueprint (layer 5, the argument).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Proof.Seesaw.IndexTypes
import GRH.Proof.Data.Magnitudes
import GRH.Proof.Forward.Characters

section IndexTypes
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- AdmissibleData.lean, Data.rootDisc: the root discriminant rd_E of E
-- (GRH.Proof.Data.Different's rootDiscE at the exponent s of D).
def dataRootDisc (P D : Set) : Set := rootDiscE(P, D.s)

-- The terms log w(τ) over the places τ (w = nominalWeight).
def logWeightTerms (P D : Set) : Set :=
  { (τ, realLog(nominalWeight(P, D, τ))) | τ ∈ dataPlaces(P, D) }

-- IndexTypes.lean, Data.logLevelTarget: λ = m (Σ_v log w(v))/f +
-- (m − 1) log(g rd_E/2π) − (15/2) log b, w = nominalWeight, g = g₀g₁.
def logLevelTarget (P D : Set) : Set :=
  R[realNat(D.m) * (realFiniteSum(logWeightTerms(P, D), dataPlaces(P, D)) /
      realNat(dataF(P, D))) +
    (realNat(D.m) - 1) *
      realLog(R[realNat(gProd(D)) * dataRootDisc(P, D) / (2 * realPi)]) -
    15 / 2 * D.logB]

-- IndexTypes.lean, Data.N: the level, a prime N ≡ 1 mod M_ω² with
-- λ ≤ log N ≤ λ + √(log b), λ = logLevelTarget (the conclusion of
-- Data.exists_prime_window at U = λ, which Data.N chooses).
predicate LevelPrime (P D N : Set) :=
  N ∈ ℕ ∧ Prime(N) ∧
  CongruentMod(N, (1:N), pow(levelMomega(P, D.s), 2)) ∧
  logLevelTarget(P, D) ≤ realLog(realNat(N)) ∧
  realLog(realNat(N)) ≤ R[logLevelTarget(P, D) + realSqrt(D.logB)]

-- IndexTypes.lean, Data.logLevelTarget_mem_Icc: m log b ≤ λ ≤ 29 m log b.
theorem logLevelTarget.mem_Icc (P D : Set)
  requires data : Data(P, D)
  shows R[realNat(D.m) * D.logB] ≤ (logLevelTarget(P, D):R) ∧
    (logLevelTarget(P, D):R) ≤ R[29 * realNat(D.m) * D.logB]
proof
  sorry

-- IndexTypes.lean, the definition of Data.N (Data.exists_prime_window at
-- U = λ): a level prime exists.
theorem LevelPrime.exists (P D : Set)
  requires data : Data(P, D)
  shows ∃ N, LevelPrime(P, D, N)
proof
  sorry

-- IndexTypes.lean, Data.log_N_mem_Icc: m log b ≤ log N ≤ 30 m log b.
theorem LevelPrime.log_mem_Icc (P D N : Set)
  requires data : Data(P, D)
  requires level : LevelPrime(P, D, N)
  shows R[realNat(D.m) * D.logB] ≤ realLog(realNat(N)) ∧
    realLog(realNat(N)) ≤ R[30 * realNat(D.m) * D.logB]
proof
  sorry

-- Section: The choices
-- The choices the source makes from D: N = Data.N (the level prime),
-- seesawConst = the unit c of Data.seesaw (in Data.scaledInclusion), and
-- choices = the record of the remaining choices (AutoChoices).
structure LiftChoices
  | N seesawConst choices : Set

-- IndexTypes.lean, Data.π (exists_pi_mul_star), Data.ω
-- (exists_residue_char_of_order), Data.muFlat and Data.χ
-- (exists_char_hasWeight), GoodIdempotent.lean, Data.spaceY
-- (exists_spaceY), and ChainValuation.lean, Data.centralGen
-- (exists_centralGen, one for each prime w dividing π).
structure AutoChoices
  | pi omega muFlat chi spaceY centralGen : Set

-- Section: The field E of the data
-- AdmissibleData.lean, Data.E with its CM type.
def dataE (P D : Set) : Set := fieldE(P, D.s)
def dataPhi (P D : Set) : Set := cmTypeE(P, D.s)

-- AdmissibleData.lean, Data.piG = A + B(1 + √−d)/2 ∈ 𝓞_K, and
-- IndexTypes.lean, Data.piGBar: its complex conjugate, an integer of E.
def piGComplex (P D : Set) : Set :=
  ℂ[intComplex(D.piA) + intComplex(D.piB) * quadGen(Parameters.d(P))]

def piGBar (P D : Set) : Set := complexConj(piGComplex(P, D))

-- Data.g i for i ∈ {0, 1}, as a complex number.
def dataGAt (D i : Set) : Set :=
  ⋃({ g ∈ ℕ | (i = (0:N) ∧ g = D.g0) ∨ (i ≠ (0:N) ∧ g = D.g1) })

def natComplex (n : Set) : Set := complexOfReal(realNat(n))

-- IndexTypes.lean, Data.IsChosen w: the finite place w of E divides π̄_G.
predicate IsChosen (P D w : Set) := w ∈ finPlaces(dataE(P, D)) ∧ piGBar(P, D) ∈ w

-- IndexTypes.lean, Data.ChosenPlace i: the chosen places above g_i.
def chosenPlacesAt (P D i : Set) : Set :=
  { w ∈ finPlaces(dataE(P, D)) | piGBar(P, D) ∈ w ∧ natComplex(dataGAt(D, i)) ∈ w }

-- Σ i, ChosenPlace i, as the pairs (i, w), and Data.chosen (i, w) = w.
def chosenIndex (P D : Set) : Set :=
  { x ∈ (2:N) × finPlaces(dataE(P, D)) | snd(x) ∈ chosenPlacesAt(P, D, fst(x)) }

def chosenPlace (x : Set) : Set := snd(x)

-- Section: The group 𝖦
-- IndexTypes.lean, Data.G: 𝖦 = ∏_x GL_RowIndex(𝔽_{w_x}) over the chosen
-- places, RowIndex read as r = {0, …, r − 1}.
def rowGLFamily (P D : Set) : Set :=
  { (x, generalLinearGroup(resField(dataE(P, D), chosenPlace(x)), D.r)) |
    x ∈ chosenIndex(P, D) }

def dataGroupStructure (P D : Set) : Set :=
  familyGroup(chosenIndex(P, D), rowGLFamily(P, D))

-- Section: The chosen residue characters and characters of U(1)
-- The defining property of IndexTypes.lean, Data.ω: at a chosen place w,
-- ω_w = T^{M_ω} for a residue character T of order M_ω²
-- (exists_residue_char_of_order); ω_w = 1 at the other places.
predicate ResidueOmega (P D ω : Set) :=
  ω ∈ residueFamilies(dataE(P, D)) ∧
  ∀ w ∈ finPlaces(dataE(P, D)),
    (IsChosen(P, D, w) → ∃ T ∈ residueChars(dataE(P, D), w),
      residueCharOrder(dataE(P, D), w, T) = pow(levelMomega(P, D.s), 2) ∧
      ω(w) = mulCharPow(resField(dataE(P, D), w), complexRing, T, levelMomega(P, D.s))) ∧
    (¬IsChosen(P, D, w) → ω(w) = trivialResidueChar(dataE(P, D), w))

-- A weight on the places a (unit residues modulo N₁) read on the CM type
-- Φ through the dictionary a ↦ placeEmbeddingE(a) (Different.lean).
def weightOnPhi (P D f : Set) : Set :=
  { (placeEmbeddingE(P, D.s, a), f(a)) | a ∈ dataPlaces(P, D) }

-- τ ↦ −w₀(τ) and τ ↦ 0, as integers on the places.
def negWeightZero (P D : Set) : Set :=
  { (a, integerNegValue(integerOfNat(weight(P, D, 0, a)))) | a ∈ dataPlaces(P, D) }

def zeroWeight (P D : Set) : Set := { (a, integerZero) | a ∈ dataPlaces(P, D) }

-- IndexTypes.lean, Data.muFlat_hasWeight and Data.chi_hasWeight: μ♭ has
-- weight −w₀ and trivial tame part, χ has weight 0 and tame part ω.
predicate MuFlatChar (P D μ : Set) :=
  HasWeight(dataE(P, D), dataPhi(P, D), μ, weightOnPhi(P, D, negWeightZero(P, D)),
    trivialResidueFamily(dataE(P, D)))

predicate ChiChar (P D ω χ : Set) :=
  HasWeight(dataE(P, D), dataPhi(P, D), χ, weightOnPhi(P, D, zeroWeight(P, D)), ω)

-- IndexTypes.lean, Data.π_mul_star: π ∈ 𝓞_E with π π̄ = N.
predicate LevelPi (P D N π : Set) :=
  π ∈ ringOfIntegers(dataE(P, D)) ∧ ℂ[π * complexConj(π)] = natComplex(N)

-- Section: Tame characters and twists
-- IndexTypes.lean, Data.TameChar: a character ϑ of U(1)(𝔸) with a finite
-- set Q of places and its tame part ψ.
structure TameCharRecord
  | aut Q psi : Set

-- The number ∏_{w ∈ Q} q_w (TameChar.levelNorm), the number of elements
-- of ∏_{w ∈ Q} 𝔽_w.
def residueCarriers (E Q : Set) : Set := { Ring.carrier(resField(E, w)) | w ∈ Q }

def residueProductSet (E Q : Set) : Set :=
  { u ∈ functionSpace(Q, ⋃(residueCarriers(E, Q))) |
    ∀ w ∈ Q, u(w) ∈ Ring.carrier(resField(E, w)) }

def placeNormProduct (E Q : Set) : Set := cardinality(residueProductSet(E, Q))

-- IndexTypes.lean, Data.TameChar for the level prime N: weight 0 and tame
-- part ψ, ψ_w = 1 off Q, Q disjoint from its conjugate, and ∏_{w ∈ Q} q_w
-- prime to gN.
predicate IsTameChar (P D N ϑ : Set) :=
  TameCharRecord.Data(ϑ) ∧ ϑ.Q ⊆ finPlaces(dataE(P, D)) ∧ Finite(ϑ.Q) ∧
  HasWeight(dataE(P, D), dataPhi(P, D), ϑ.aut, weightOnPhi(P, D, zeroWeight(P, D)),
    ϑ.psi) ∧
  (∀ w ∈ finPlaces(dataE(P, D)) ∖ ϑ.Q, ϑ.psi(w) = trivialResidueChar(dataE(P, D), w)) ∧
  (∀ w ∈ ϑ.Q, conjugatePlace(dataE(P, D), w) ∉ ϑ.Q) ∧
  gcd(mul(gProd(D), N), placeNormProduct(dataE(P, D), ϑ.Q)) = (1:N)

-- IndexTypes.lean, Data.Twist: ψ_w ≠ 1 at every w ∈ Q.
predicate IsTwist (P D N ϑ : Set) :=
  IsTameChar(P, D, N, ϑ) ∧
  ∀ w ∈ ϑ.Q, ϑ.psi(w) ≠ trivialResidueChar(dataE(P, D), w)

-- LValueRatio.lean, Data.MFoldTwist: also ψ_w^n ≠ 1 for 1 ≤ n ≤ m.
predicate IsMFoldTwist (P D N ϑ : Set) :=
  IsTwist(P, D, N, ϑ) ∧
  ∀ n ∈ ℕ, (1:N) ≤ n → n ≤ D.m → ∀ w ∈ ϑ.Q,
    mulCharPow(resField(dataE(P, D), w), complexRing, ϑ.psi(w), n) ≠
      trivialResidueChar(dataE(P, D), w)

-- The records (μ, Q, ψ) with μ a character of U(1)(𝔸), Q a set of finite
-- places and ψ a family of residue characters.
def tameCharSpace (P D : Set) : Set :=
  { TameCharRecord.mk(fst(fst(q)), snd(fst(q)), snd(q)) |
    q ∈ (autChars(dataE(P, D), dataPhi(P, D)) × 𝒫(finPlaces(dataE(P, D)))) ×
      residueFamilies(dataE(P, D)) }

-- The m-fold twists for the level prime N, and the twist 1
-- (LValueRatio.lean, Data.instOneTws: μ = 1, Q = ∅, ψ = 1).
def mfoldTwistsAt (P D N : Set) : Set :=
  { ϑ ∈ tameCharSpace(P, D) | IsMFoldTwist(P, D, N, ϑ) }

def trivialTwist (P D : Set) : Set :=
  TameCharRecord.mk(trivialAutChar(dataE(P, D), dataPhi(P, D)), ∅,
    trivialResidueFamily(dataE(P, D)))

-- IndexTypes.lean, Data.liftTamePart (ϑ^j) j: the tame part ω^j ψ^j of
-- μ⁰_j ϑ^j, for the residue characters ω.
def liftTamePart (P D ω ϑ : Set, j : Nat) : Set :=
  residueFamilyMul(dataE(P, D), residueFamilyPow(dataE(P, D), ω, j),
    residueFamilyPow(dataE(P, D), ϑ.psi, j))

-- Section: The choices exist
-- IndexTypes.lean, Data.finite_isChosen: finitely many places are chosen.
theorem chosenIndex.finite (P D : Set)
  requires data : Data(P, D)
  shows Finite(chosenIndex(P, D))
proof
  sorry

-- IndexTypes.lean, Data.exists_residue_char_of_order with the definition
-- of Data.ω: the residue characters ω exist.
theorem ResidueOmega.exists (P D : Set)
  requires data : Data(P, D)
  shows ∃ ω, ResidueOmega(P, D, ω)
proof
  sorry

-- IndexTypes.lean, Data.exists_char_hasWeight at (1, 0) and (0, 1), the
-- definitions of Data.muFlat and Data.χ.
theorem MuFlatChar.exists (P D : Set)
  requires data : Data(P, D)
  shows ∃ μ, MuFlatChar(P, D, μ)
proof
  sorry

theorem ChiChar.exists (P D ω : Set)
  requires data : Data(P, D)
  requires omega : ResidueOmega(P, D, ω)
  shows ∃ χ, ChiChar(P, D, ω, χ)
proof
  sorry

-- IndexTypes.lean, Data.exists_pi_mul_star: some π ∈ 𝓞_E has π π̄ = N.
theorem LevelPi.exists (P D N : Set)
  requires data : Data(P, D)
  requires level : LevelPrime(P, D, N)
  shows ∃ π, LevelPi(P, D, N, π)
proof
  sorry

end IndexTypes
