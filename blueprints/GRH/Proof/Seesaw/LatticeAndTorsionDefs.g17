-- Integrality away from n, admissible coefficient families with
-- controlled denominators and size, translations integral away from q,
-- and split squarefree finite ideles.
-- Source: grh-compact/src/New/Seesaw/LatticeAndTorsionDefs.lean. "Set-up
-- for this proof: records of the data and parameters of this proof, names
-- for its objects. Part of: Seesaw identity for a chain of theta lifts
-- (see New.Seesaw.SeesawTheorem). This file: Lattice basis
-- gradedLatticeBasis, admissible combinations of translates with
-- controlled denominators and size." (integralAway, IsAdmissibleCoeffs,
-- weightedTranslations, translations, IsSplitSquarefree.)
-- Encoding. A ring map ι : ℂ → ℂ_l enters only through ‖ι z‖, so
-- integralAway reads the p-adic places of GRH.Adelic.CuspForms. A finitely
-- supported r : X →₀ ℂ is a function on X with finite support. The
-- source's proposition p switching the size condition on is a flag: the
-- condition is required when withSize = 1. Integrality of a component of a
-- finite adele at w is membership in the image of 𝓞_w. Not stated here:
-- gradedLatticeBasis and Grading.SpansLattice, which belong to the graded
-- spaces Y_j (GRH.Proof.Forward.Automorphic, SpacesYOf).
-- Part of the GRH blueprint (layer 5, the argument).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Proof.Seesaw.LatticeAndTorsionDefs
import GRH.Proof.Seesaw.IndexTypes

section LatticeAndTorsionDefs
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- LatticeAndTorsionDefs.lean, integralAway n: the complex numbers z with
-- ‖ι(z)‖ ≤ 1 for every ι : ℂ → ℂ_l, l a prime prime to n.
def integralAway (n : Set) : Set :=
  { z ∈ complexCarrier | ∀ l ∈ ℕ, Prime(l) → gcd(l, n) = (1:N) →
    ∀ ι ∈ padicPlaces(l), RealLe(padicPlaceNorm(l, ι, z), realOne) }

-- The support of a complex family r on X.
def complexSupport (X r : Set) : Set := { a ∈ X | r(a) ≠ complexZero }

def conjugateSizeTerms (X r σ : Set) : Set :=
  { (a, complexAbs(σ(r(a)))) | a ∈ complexSupport(X, r) }

-- LatticeAndTorsionDefs.lean, IsAdmissibleCoeffs A n d p B r: r : X →₀ ℂ
-- is supported in A, each d r(x) is integral away from n, and (when the
-- flag is on) Σ_x |σ r(x)| ≤ B for every automorphism σ of ℂ.
predicate IsAdmissibleCoeffs (X A n d withSize B r : Set) :=
  FunctionBetween(r, X, complexCarrier) ∧ Finite(complexSupport(X, r)) ∧
  complexSupport(X, r) ⊆ A ∧
  (∀ a ∈ X, ℂ[natComplex(d) * r(a)] ∈ integralAway(n)) ∧
  (withSize = (1:N) → ∀ σ ∈ complexAutomorphisms,
    realFiniteSum(conjugateSizeTerms(X, r, σ), complexSupport(X, r)) ≤ (B:R))

-- The component a of a finite adele at w lies in 𝓞_w.
predicate IntegralAt (E w a : Set) :=
  ∃ b ∈ Ring.carrier(adicCompletionIntegers(E, w)), adicCompletionInclusion(E, w)(b) = a

-- LatticeAndTorsionDefs.lean, weightedTranslations q d: the vectors
-- x ∈ 𝔸fᴵ with d_i x_i integral at every place w not dividing q.
def weightedTranslations (E I q d : Set) : Set :=
  { u ∈ functionSpace(I, finAdeles(E)) | ∀ i ∈ I, ∀ w ∈ finPlaces(E),
    natComplex(q) ∉ w → IntegralAt(E, w, finMul(E, d(i), u(i))(w)) }

-- LatticeAndTorsionDefs.lean, translations I q d: the same with all d_i
-- equal to d.
def constantFamily (I d : Set) : Set := { (i, d) | i ∈ I }

def translations (E I q d : Set) : Set := weightedTranslations(E, I, q, constantFamily(I, d))

-- v(a) = e^{−1} at w: a is the image of a nonunit b of 𝓞_w dividing every
-- nonunit (b generates the maximal ideal); v(a) = 1: a is the image of a
-- unit of 𝓞_w.
predicate IsUniformizerAt (E w a : Set) :=
  ∃ b ∈ Ring.carrier(adicCompletionIntegers(E, w)),
    adicCompletionInclusion(E, w)(b) = a ∧
    ¬RingUnit(adicCompletionIntegers(E, w), b) ∧
    ∀ c ∈ Ring.carrier(adicCompletionIntegers(E, w)),
      ¬RingUnit(adicCompletionIntegers(E, w), c) →
        ∃ e ∈ Ring.carrier(adicCompletionIntegers(E, w)),
          c = call2(Ring.mul(adicCompletionIntegers(E, w)), b, e)

predicate IsUnitAt (E w a : Set) :=
  ∃ b ∈ Ring.carrier(adicCompletionIntegers(E, w)),
    adicCompletionInclusion(E, w)(b) = a ∧ RingUnit(adicCompletionIntegers(E, w), b)

-- LatticeAndTorsionDefs.lean, IsSplitSquarefree P N π for a finite set Ψ
-- of places and N ∈ E: N = π π̄, v(π_w) = e^{−1} on Ψ and 1 off Ψ, and Ψ
-- is disjoint from its conjugate.
predicate IsSplitSquarefree (E Ψ N π : Set) :=
  π ∈ finAdeles(E) ∧ Ψ ⊆ finPlaces(E) ∧
  finOf(E, N) = finMul(E, π, finStar(E)(π)) ∧
  (∀ w ∈ finPlaces(E), (w ∈ Ψ → IsUniformizerAt(E, w, π(w))) ∧
    (w ∉ Ψ → IsUnitAt(E, w, π(w)))) ∧
  (∀ w ∈ Ψ, conjugatePlace(E, w) ∉ Ψ)

end LatticeAndTorsionDefs
