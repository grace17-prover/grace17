-- Local forms for the polarity of the prime error: a function agreeing off
-- a with a function holomorphic on a disk about a, of value c at a. Local
-- forms add, multiply by holomorphic functions, sum over finite families,
-- give punctured limits and meromorphy, and (z − a) L̃′/L̃(z, χ) has one
-- of value ord_a L̃(·, χ) at a.
-- Part of: One-sided bound for non-split primes gives a zero-free
-- half-plane (GRH.Proof.Endgame.OneSidedCriterion).
-- Part of the GRH blueprint (layer 5, the argument).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Proof.Endgame.PolarLocal
import GRH.Analytic.Landau

section PolarLocal
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Section: Local forms
-- F agrees off a with a function H holomorphic on a disk about a, and
-- H(a) = c.
predicate pipLocal (F a c : Set) :=
  ∃ t ∈ ℝ, (0:R) < t ∧ ∃ H, HolomorphicOn(H, complexDisk(a, t)) ∧
    H(a) = c ∧ (∀ z ∈ complexDisk(a, t), z ≠ a → F(z) = H(z))

-- A function holomorphic on a disk about a is its own local form.
theorem pipLocal.of_holomorphic (Q a : Set, r : Real)
  requires ha : a ∈ ℂ
  requires positive : (0:R) < r
  requires holomorphic : HolomorphicOn(Q, complexDisk(a, r))
  shows pipLocal(Q, a, Q(a))
proof
  have hr : r ∈ ℝ by typecheck
  refine ⟨r, hr, positive, Q, holomorphic, rfl, ?_⟩
  intros z hz distinct
  rfl

-- A local form shrinks to every smaller positive radius.
theorem pipLocal.shrink (F a c : Set, r : Real)
  requires ha : a ∈ ℂ
  requires local : pipLocal(F, a, c)
  requires positive : (0:R) < r
  shows ∃ t ∈ ℝ, (0:R) < t ∧ t ≤ r ∧ ∃ H,
    HolomorphicOn(H, complexDisk(a, t)) ∧ H(a) = c ∧
    (∀ z ∈ complexDisk(a, t), z ≠ a → F(z) = H(z))
proof
  obtain ⟨s, hs, sPositive, H, holomorphic, center, agree⟩ := local
  have hr : r ∈ ℝ by typecheck
  obtain ⟨t, ht, tPositive, tr, tsLe⟩ := realRadius.common with hr, hs,
    positive, sPositive
  have into := complexDisk.mono at a, t, s with ha, ht, hs, tsLe
  have openT := complexDisk.open with ha, ht
  have holomorphicT := HolomorphicOn.mono with holomorphic, openT, into
  refine ⟨t, ht, tPositive, tr, H, holomorphicT, center, ?_⟩
  intros z hz distinct
  exact agree with z, (into with z, hz), distinct

-- Sums of local forms.
theorem pipLocal.add (F G S a c e : Set)
  requires ha : a ∈ ℂ
  requires localF : pipLocal(F, a, c)
  requires localG : pipLocal(G, a, e)
  requires sum : ∀ z ∈ ℂ, z ≠ a → S(z) = ℂ[F(z) + G(z)]
  shows pipLocal(S, a, ℂ[c + e])
proof
  obtain ⟨s, hs, sPositive, H1, holo1, center1, agree1⟩ := localF
  have sT : Real(s) by typecheck
  obtain ⟨t, ht, tPositive, ts, H2, holo2, center2, agree2⟩ :=
    pipLocal.shrink at G, a, e, s with ha, localG, sPositive
  have into := complexDisk.mono at a, t, s with ha, ht, hs, ts
  have openT := complexDisk.open with ha, ht
  have holo1T := HolomorphicOn.mono with holo1, openT, into
  have sumH := HolomorphicOn.add with holo1T, holo2
  have values1 := holo1T.right.left
  have values2 := holo2.right.left
  have centerT := complexDisk.center with ha, ht, tPositive
  refine ⟨t, ht, tPositive, complexFunctionAdd(H1, H2, complexDisk(a, t)),
    sumH, ?_, ?_⟩
  . rw [(complexFunctionAdd.value with values1, values2, centerT), center1,
      center2]
  . intros z hz distinct
    have zC := (complexDisk.membership.forward with hz).left
    rw [(complexFunctionAdd.value with values1, values2, hz), (sum with zC,
      distinct), (agree1 with z, (into with z, hz), distinct),
      (agree2 with z, hz, distinct)]

-- Products of a local form with a holomorphic function.
theorem pipLocal.mul (F Q S a c : Set, r : Real)
  requires ha : a ∈ ℂ
  requires localF : pipLocal(F, a, c)
  requires positive : (0:R) < r
  requires holomorphic : HolomorphicOn(Q, complexDisk(a, r))
  requires product : ∀ z ∈ ℂ, z ≠ a → S(z) = ℂ[F(z) * Q(z)]
  shows pipLocal(S, a, ℂ[c * Q(a)])
proof
  have hr : r ∈ ℝ by typecheck
  obtain ⟨t, ht, tPositive, tr, H, holo, center, agree⟩ :=
    pipLocal.shrink at F, a, c, r with ha, localF, positive
  have into := complexDisk.mono at a, t, r with ha, ht, hr, tr
  have openT := complexDisk.open with ha, ht
  have holoQ := HolomorphicOn.mono with holomorphic, openT, into
  have productH := HolomorphicOn.mul with holo, holoQ
  have valuesH := holo.right.left
  have valuesQ := holoQ.right.left
  have centerT := complexDisk.center with ha, ht, tPositive
  refine ⟨t, ht, tPositive, complexFunctionMul(H, Q, complexDisk(a, t)),
    productH, ?_, ?_⟩
  . rw [(complexFunctionMul.value with valuesH, valuesQ, centerT), center]
  . intros z hz distinct
    have zC := (complexDisk.membership.forward with hz).left
    rw [(complexFunctionMul.value with valuesH, valuesQ, hz), (product with zC,
      distinct), (agree with z, hz, distinct)]

-- A local form gives the punctured limit F(z) → c.
theorem pipLocal.limit (F a c : Set)
  requires ha : a ∈ ℂ
  requires local : pipLocal(F, a, c)
  requires values : ∀ z ∈ ℂ, F(z) ∈ ℂ
  shows HasPuncturedLimit(F, a, c)
proof
  obtain ⟨t, ht, tPositive, H, holo, center, agree⟩ := local
  have centerT := complexDisk.center with ha, ht, tPositive
  have cIn : c ∈ ℂ by
    rw ← center
    exact holo.right.left with a, centerT
  have continuous := HolomorphicOn.continuous with holo
  have sub : ℂ ⊆ ℂ by
    intros z hz
    exact hz
  unfold HasPuncturedLimit
  apply cxaTendsto.punctured with sub, values, ha, cIn
  intros e he ePositive
  obtain ⟨d, hd, dPositive, near⟩ := continuous.right.right with a, centerT,
    e, he, ePositive
  obtain ⟨s, hs, sPositive, sd, st⟩ := realRadius.common with hd, ht,
    dPositive, tPositive
  have into := complexDisk.mono at a, s, t with ha, hs, ht, st
  have diskSub := complexDisk.subset at a, s
  refine ⟨s, hs, sPositive, diskSub, ?_⟩
  intros z hz distinct
  have zT := into with z, hz
  obtain ⟨zC, close⟩ := complexDisk.membership.forward with hz
  have closeD : complexAbs(ℂ[z - a]) < d by linarith
  have small := near with z, zT, closeD
  rw [(agree with z, zT, distinct), ← center]
  exact small

-- A local form of (z − a)ⁿ Φ(z) makes Φ meromorphic at a.
theorem pipLocal.meromorphic (F Φ a c : Set, n : Nat)
  requires ha : a ∈ ℂ
  requires local : pipLocal(F, a, c)
  requires factor : ∀ z ∈ ℂ, z ≠ a → F(z) = ℂ[(z - a) ^ n * Φ(z)]
  shows MeromorphicAt(Φ, a)
proof
  obtain ⟨t, ht, tPositive, H, holo, center, agree⟩ := local
  have centerT := complexDisk.center with ha, ht, tPositive
  have analytic := ComplexAnalyticAt.of_holomorphic with holo, centerT
  have nIn : n ∈ ℕ by typecheck
  refine ⟨ha, n, nIn, H, t, ht, tPositive, analytic, ?_⟩
  intros z hz distinct
  have zC := (complexDisk.membership.forward with hz).left
  rw [← (factor with zC, distinct), (agree with z, hz, distinct)]

-- A local form of F with F(a) = c makes F holomorphic near a.
theorem pipLocal.holomorphic (F a c : Set)
  requires ha : a ∈ ℂ
  requires local : pipLocal(F, a, c)
  requires value : F(a) = c
  shows ∃ t ∈ ℝ, (0:R) < t ∧ HolomorphicOn(F, complexDisk(a, t))
proof
  obtain ⟨t, ht, tPositive, H, holo, center, agree⟩ := local
  have everywhere : ∀ z ∈ complexDisk(a, t), H(z) = F(z) by
    intros z hz
    by_cases same : z = a
    . rw [same, center, value]
    . rw (agree with z, hz, same)
  have holoF := HolomorphicOn.congr with holo, everywhere
  exact ⟨t, ht, tPositive, holoF⟩

-- Section: Logarithmic derivatives
-- Near a point s where f is holomorphic and not locally 0,
-- (z − s) f′(z)/f(z) has a local form of value ord_s f at s
-- (the construction in logDeriv.residue).
theorem pipLogDeriv.local (f U s h : Set)
  requires holomorphic : HolomorphicOn(f, U)
  requires member : s ∈ U
  requires nonzero : ¬EventuallyZeroAt(f, s)
  requires values : ∀ z ∈ U, h(z) = ℂ[(z - s) * logDeriv(f, U, z)]
  shows pipLocal(h, s, complexOfReal(realNat(analyticOrderNat(f, s))))
proof
  have isOpen := holomorphic.left
  have sub := ComplexOpen.subset with isOpen
  have sMember := sub with s, member
  have valuesF := holomorphic.right.left
  have analytic := ComplexAnalyticAt.of_holomorphic with holomorphic, member
  obtain ⟨g, r, hr, positiveR, analyticG, nonzeroG, factor⟩ :=
    analyticOrderNat.factor with analytic, nonzero
  have orderIn := (analyticOrderNat.selected with analytic).left
  have orderNat := nat.omega.backward at analyticOrderNat(f, s) with orderIn
  obtain ⟨_, c, rg, hrg, positiveG, radius, sums⟩ := analyticG
  -- g is holomorphic on a disk about s.
  have series := powerSeriesSum.holomorphic with radius, sMember
  have agreeG : ∀ w ∈ complexDisk(s, rg), powerSeriesSum(c, s, rg)(w) = g(w)
    intros w hw
    exact ComplexSumsTo.unique with
      (powerSeriesSum.sums with radius, sMember, hw), (sums with w, hw)
  have holomorphicG := HolomorphicOn.congr with series, agreeG
  have continuousG := HolomorphicOn.continuous with holomorphicG
  have centerG := complexDisk.center with sMember, hrg, positiveG
  have gs := holomorphicG.right.left with s, centerG
  have gsAbs := complexAbs.positive with gs, nonzeroG
  have gsReal : complexAbs(g(s)) ∈ ℝ by typecheck
  obtain ⟨δ, hδ, positiveδ, nearG⟩ := continuousG.right.right with s, centerG,
    complexAbs(g(s)), gsReal, gsAbs
  obtain ⟨ru, hru, positiveU, diskU⟩ := ComplexOpen.disk with isOpen, member
  obtain ⟨t1, ht1, positive1, le1r, le1g⟩ := realRadius.common with hr, hrg,
    positiveR, positiveG
  obtain ⟨t2, ht2, positive2, le2u, le2δ⟩ := realRadius.common with hru, hδ,
    positiveU, positiveδ
  obtain ⟨ρ, hρ, positiveρ, le1, le2⟩ := realRadius.common with ht1, ht2,
    positive1, positive2
  have ρr : (ρ:R) ≤ r by linarith
  have ρg : (ρ:R) ≤ rg by linarith
  have ρu : (ρ:R) ≤ ru by linarith
  have ρδ : (ρ:R) ≤ δ by linarith
  have intoR := complexDisk.mono at s, ρ, r with sMember, hρ, hr, ρr
  have intoG := complexDisk.mono at s, ρ, rg with sMember, hρ, hrg, ρg
  have intoU := complexDisk.mono at s, ρ, ru with sMember, hρ, hru, ρu
  have insideU : complexDisk(s, ρ) ⊆ U
    intros w hw
    exact diskU with w, (intoU with w, hw)
  have openD := complexDisk.open with sMember, hρ
  have centerD := complexDisk.center with sMember, hρ, positiveρ
  have holomorphicD := HolomorphicOn.mono with holomorphicG, openD, intoG
  have nonvanishing : ∀ w ∈ complexDisk(s, ρ), g(w) ≠ ℂ[0]
    intros w hw
    obtain ⟨wMember, close⟩ := complexDisk.membership.forward with hw
    have closeδ : complexAbs(ℂ[w - s]) < δ by linarith
    have small := nearG with w, (intoG with w, hw), closeδ
    intro vanish
    rw vanish at small
    have zero : ℂ[0 - g(s)] = ℂ[-g(s)] by ring
    rw [zero, (complexAbs.neg with gs)] at small
    linarith
  -- The quotient q = g′/g and k(z) = (z − s) q(z) are continuous on D.
  have derivG := HolomorphicOn.deriv with holomorphicD
  have valuesDG := derivG.right.left
  have valuesGD := holomorphicD.right.left
  have quotient := HolomorphicOn.div with derivG, holomorphicD, nonvanishing
  have contQ := HolomorphicOn.continuous with quotient
  have linearC := cxaPowerMap.continuous at s, (1:N) with sMember
  have subD := complexDisk.subset at s, ρ
  have contL := ComplexContinuousOn.mono with linearC, subD
  have valuesL := contL.right.left
  have valuesQ := contQ.right.left
  have formulaK : ∀ w ∈ complexDisk(s, ρ), complexFunctionMul(cxaPowerMap(s, (1:N)), complexFunctionDiv(complexDeriv(g, complexDisk(s, ρ)), g, complexDisk(s, ρ)), complexDisk(s, ρ))(w) = ℂ[cxaPowerMap(s, (1:N))(w) * complexFunctionDiv(complexDeriv(g, complexDisk(s, ρ)), g, complexDisk(s, ρ))(w)]
    intros w hw
    exact complexFunctionMul.value with valuesL, valuesQ, hw
  have contK := ComplexContinuousOn.mul with contL, contQ, formulaK
  have kValue : ∀ w ∈ complexDisk(s, ρ), complexFunctionMul(cxaPowerMap(s, (1:N)), complexFunctionDiv(complexDeriv(g, complexDisk(s, ρ)), g, complexDisk(s, ρ)), complexDisk(s, ρ))(w) =
      ℂ[(w - s) * complexDiv(complexDeriv(g, complexDisk(s, ρ))(w), g(w))]
    intros w hw
    obtain ⟨wMember, _⟩ := complexDisk.membership.forward with hw
    have gw := valuesGD with w, hw
    have dgw := valuesDG with w, hw
    have quotientMember : complexDiv(complexDeriv(g, complexDisk(s, ρ))(w), g(w)) ∈ ℂ
      unfold complexDiv
      have inverse := complexInv.member with gw
      typecheck
    rw [(formulaK with w, hw), (cxaPowerMap.value at s, (1:N), w with sMember,
      wMember), (complexFunctionDiv.value with valuesDG, valuesGD, hw),
      monoidPow.succ, monoidPow.zero]
    ring
  have kCenter : complexFunctionMul(cxaPowerMap(s, (1:N)), complexFunctionDiv(complexDeriv(g, complexDisk(s, ρ)), g, complexDisk(s, ρ)), complexDisk(s, ρ))(s) = ℂ[0]
    rw (kValue with s, centerD)
    have quotientMember : complexDiv(complexDeriv(g, complexDisk(s, ρ))(s), g(s)) ∈ ℂ
      unfold complexDiv
      have inverse := complexInv.member with gs
      have dgs := valuesDG with s, centerD
      typecheck
    ring
  -- Off s, (z − s) f′(z)/f(z) = n + (z − s) g′(z)/g(z).
  have identity : ∀ z ∈ complexDisk(s, ρ), z ≠ s → h(z) = ℂ[complexOfReal(realNat(analyticOrderNat(f, s))) +
      (z - s) * complexDiv(complexDeriv(g, complexDisk(s, ρ))(z), g(z))]
    intros z hz distinct
    obtain ⟨zMember, _⟩ := complexDisk.membership.forward with hz
    have zU := insideU with z, hz
    obtain ⟨DP, hDP, derivP, relation⟩ := cxaPowerMap.derivative at s, complexDisk(s, ρ), z,
      analyticOrderNat(f, s) with sMember, openD, hz
    have derivGz := complexDeriv.has_derivative with holomorphicD, hz
    have product := HasComplexDerivativeAt.mul with derivP, derivGz
    have valuesP := derivP.right.right.right.left
    have agreeF : ∀ w ∈ complexDisk(s, ρ), complexFunctionMul(cxaPowerMap(s,
        analyticOrderNat(f, s)), g, complexDisk(s, ρ))(w) = f(w)
      intros w hw
      obtain ⟨wMember, _⟩ := complexDisk.membership.forward with hw
      rw [(complexFunctionMul.value with valuesP, valuesGD, hw),
        (cxaPowerMap.value at s, analyticOrderNat(f, s), w with sMember,
          wMember), (factor with w, (intoR with w, hw))]
    have derivD := HasComplexDerivativeAt.congr with product, agreeF
    have derivU := HasComplexDerivativeAt.of_local with derivD, isOpen,
      insideU, valuesF
    have same := HasComplexDerivativeAt.unique with
      (complexDeriv.has_derivative with holomorphic, zU), derivU
    have difference : ℂ[z - s] ∈ ℂ by typecheck
    have nonzeroD : ℂ[z - s] ≠ ℂ[0]
      intro vanish
      apply distinct
      have shape : z = ℂ[(z - s) + s] by ring
      rw [shape, vanish]
      ring
    have power := complexPow.member at ℂ[z - s], analyticOrderNat(f, s) with
      difference
    have powerNonzero := cxaPow.nonzero at ℂ[z - s], analyticOrderNat(f, s)
      with difference, nonzeroD
    have gz := valuesGD with z, hz
    have dgz := valuesDG with z, hz
    have gzNonzero := nonvanishing with z, hz
    have fzNonzero : ℂ[(z - s) ^ analyticOrderNat(f, s) * g(z)] ≠ ℂ[0]
      intro vanish
      exact gzNonzero with (complexMul.eq_zero_cancel_left with power, gz,
        powerNonzero, vanish)
    have fz : ℂ[(z - s) ^ analyticOrderNat(f, s) * g(z)] ∈ ℂ by typecheck
    have cancelF := complexInv.mul_cancel with fz, fzNonzero
    have cancelG := complexInv.mul_cancel with gz, gzNonzero
    have inverseF := complexInv.member with fz
    have inverseG := complexInv.member with gz
    have nIn : complexOfReal(realNat(analyticOrderNat(f, s))) ∈ ℂ by typecheck
    rw (values with z, zU)
    unfold logDeriv
    unfold complexDiv
    rw [same, (cxaPowerMap.value at s, analyticOrderNat(f, s), z with sMember,
      zMember), (factor with z, (intoR with z, hz))]
    linear_combination (g(z) * complexInv(ℂ[(z - s) ^ analyticOrderNat(f, s) *
      g(z)])) * relation + complexOfReal(realNat(analyticOrderNat(f, s))) * cancelF + ((z - s) *
      complexDeriv(g, complexDisk(s, ρ))(z) * complexInv(g(z))) * cancelF - ((z - s) *
      complexDeriv(g, complexDisk(s, ρ))(z) * (z - s) ^ analyticOrderNat(f, s) *
      complexInv(ℂ[(z - s) ^ analyticOrderNat(f, s) * g(z)])) * cancelG
  -- The local form n + k(z).
  have nMember : complexOfReal(realNat(analyticOrderNat(f, s))) ∈ ℂ by
    typecheck
  have holoConst := HolomorphicOn.const with openD, nMember
  have holoLinear := lndPowerMap.holomorphic at s, complexDisk(s, ρ), (1:N)
    with sMember, openD
  have holoK := HolomorphicOn.mul with holoLinear, quotient
  have holoH := HolomorphicOn.add with holoConst, holoK
  have valuesC := holoConst.right.left
  have valuesK := holoK.right.left
  refine ⟨ρ, hρ, positiveρ, complexFunctionAdd(complexFunctionConst(
    complexOfReal(realNat(analyticOrderNat(f, s))), complexDisk(s, ρ)),
    complexFunctionMul(cxaPowerMap(s, (1:N)), complexFunctionDiv(
    complexDeriv(g, complexDisk(s, ρ)), g, complexDisk(s, ρ)),
    complexDisk(s, ρ)), complexDisk(s, ρ)), holoH, ?_, ?_⟩
  . rw [(complexFunctionAdd.value with valuesC, valuesK, centerD),
      (complexFunctionConst.value with nMember, centerD), kCenter]
    ring
  . intros z hz distinct
    rw [(complexFunctionAdd.value with valuesC, valuesK, hz),
      (complexFunctionConst.value with nMember, hz), (kValue with z, hz),
      (identity with z, hz, distinct)]

-- Local forms are determined off a.
theorem pipLocal.congr (F G a c : Set)
  requires local : pipLocal(F, a, c)
  requires agree : ∀ z ∈ ℂ, z ≠ a → G(z) = F(z)
  shows pipLocal(G, a, c)
proof
  obtain ⟨t, ht, tPositive, H, holo, center, agreeH⟩ := local
  refine ⟨t, ht, tPositive, H, holo, center, ?_⟩
  intros z hz distinct
  have zC := (complexDisk.membership.forward with hz).left
  rw [(agree with zC, distinct), (agreeH with z, hz, distinct)]

-- Section: Finite families
-- The values T(ξ)(z), ξ ∈ I, and their sum over S ⊆ I, as a function of z.
defgraph pipFamilyAt (T I z : Set) (ξ ∈ I) : complexCarrier := T(ξ)(z)
requires values : ∀ i ∈ I, T(i)(z) ∈ complexCarrier
proof
  exact values with member

defgraph pipFamilySum (T I S : Set) (z ∈ complexCarrier) : complexCarrier :=
    groupFiniteSum(complexAdditiveGroup, S, pipFamilyAt(T, I, z))
requires values : ∀ i ∈ I, ∀ w ∈ complexCarrier, T(i)(w) ∈ complexCarrier
requires finite : Finite(S)
requires inside : S ⊆ I
proof
  have ngC := complexAdditiveGroup.normed
  obtain ⟨c, m⟩ := complexAdditiveGroup.parts
  have atZ : ∀ i ∈ I, T(i)(z) ∈ complexCarrier by
    intros i hi
    exact values with i, hi, z, member
  have terms : ∀ i ∈ S, pipFamilyAt(T, I, z)(i) ∈
      Group.carrier(complexAdditiveGroup) by
    intros i hi
    have iI := inside with i, hi
    rw [c, (pipFamilyAt.value with atZ, iI)]
    exact atZ with i, iI
  have sum := groupFiniteSum.member with ngC.left, finite, terms
  rwa c at sum

-- The families whose sums have a local form at a of value Σ c.
def pipFamilyLocal (T c I a : Set) : Set :=
  { S ∈ 𝒫(I) | Finite(S) → pipLocal(pipFamilySum(T, I, S), a,
      groupFiniteSum(complexAdditiveGroup, S, c)) }

-- A finite sum of local forms is a local form.
theorem pipLocal.family (T c I S a : Set)
  requires ha : a ∈ ℂ
  requires values : ∀ i ∈ I, ∀ w ∈ complexCarrier, T(i)(w) ∈ complexCarrier
  requires cValues : ∀ i ∈ I, c(i) ∈ complexCarrier
  requires locals : ∀ i ∈ I, pipLocal(T(i), a, c(i))
  requires inside : S ⊆ I
  requires finite : Finite(S)
  shows pipLocal(pipFamilySum(T, I, S), a,
    groupFiniteSum(complexAdditiveGroup, S, c))
proof
  have ngC := complexAdditiveGroup.normed
  have abelian := ngC.left
  obtain ⟨gc, gm⟩ := complexAdditiveGroup.parts
  have go : Group.one(complexAdditiveGroup) = complexZero by
    unfold complexAdditiveGroup
    group_projections
  have atZ : ∀ z ∈ complexCarrier, ∀ i ∈ I, T(i)(z) ∈ complexCarrier by
    intros z hz i hi
    exact values with i, hi, z, hz
  have base : ∅ ∈ pipFamilyLocal(T, c, I, a) by
    apply pipFamilyLocal.membership.backward
    have emptyI := empty.subset at I
    refine ⟨(powerset.membership_iff.backward with emptyI), ?_⟩
    intro finiteEmpty
    rw [(groupFiniteSum.empty with abelian), go]
    have one : R[1] ∈ ℝ by typecheck
    have onePositive : (0:R) < R[1] by linarith
    have openD := complexDisk.open with ha, one
    have whole := ComplexOpen.whole
    have zeroC : ℂ[0] ∈ ℂ by typecheck
    have holoWhole := HolomorphicOn.const with whole, zeroC
    have diskSub := complexDisk.subset at a, R[1]
    have holo := HolomorphicOn.mono with holoWhole, openD, diskSub
    have local := pipLocal.of_holomorphic with ha, onePositive, holo
    rw (complexFunctionConst.value with zeroC, ha) at local
    apply pipLocal.congr with local
    intros z hz distinct
    rw [(pipFamilySum.value with values, finiteEmpty, emptyI, hz),
      (groupFiniteSum.empty with abelian), go,
      (complexFunctionConst.value with zeroC, hz)]
  have step : ∀ F ⊆ I, Finite(F) → ∀ i ∈ I, i ∉ F →
      F ∈ pipFamilyLocal(T, c, I, a) →
      F ∪ {i} ∈ pipFamilyLocal(T, c, I, a) by
    intros F hF finiteF i hi fresh member
    have memberF := pipFamilyLocal.membership.forward with member
    have localF := memberF.right with finiteF
    have localI := locals with i, hi
    have finiteU := Finite.union with finiteF, (Finite.singleton at i)
    have insideU : F ∪ {i} ⊆ I by
      intros x hx
      simp at hx
      rcases hx with xF | same
      . exact hF with x, xF
      . rw same
        exact hi
    have sum : ∀ z ∈ ℂ, z ≠ a → pipFamilySum(T, I, F ∪ {i})(z) =
        ℂ[pipFamilySum(T, I, F)(z) + T(i)(z)] by
      intros z hz distinct
      have atz := atZ with z, hz
      have termsF : ∀ j ∈ F, pipFamilyAt(T, I, z)(j) ∈
          Group.carrier(complexAdditiveGroup) by
        intros j hj
        have jI := hF with j, hj
        rw [gc, (pipFamilyAt.value with atz, jI)]
        exact atz with j, jI
      have termI : pipFamilyAt(T, I, z)(i) ∈
          Group.carrier(complexAdditiveGroup) by
        rw [gc, (pipFamilyAt.value with atz, hi)]
        exact atz with i, hi
      rw [(pipFamilySum.value with values, finiteU, insideU, hz),
        (pipFamilySum.value with values, finiteF, hF, hz),
        (groupFiniteSum.insert with abelian, finiteF, termsF, termI, fresh),
        gm, (pipFamilyAt.value with atz, hi)]
    have added := pipLocal.add with ha, localF, localI, sum
    have cF : ∀ j ∈ F, c(j) ∈ Group.carrier(complexAdditiveGroup) by
      intros j hj
      rw gc
      exact cValues with j, (hF with j, hj)
    have cI : c(i) ∈ Group.carrier(complexAdditiveGroup) by
      rw gc
      exact cValues with i, hi
    have constant := groupFiniteSum.insert with abelian, finiteF, cF, cI, fresh
    rw gm at constant
    apply pipFamilyLocal.membership.backward
    refine ⟨(powerset.membership_iff.backward with insideU), ?_⟩
    intro finiteAgain
    rw constant
    exact added
  have all := Finite.induction with base, step
  have member := all with S, inside, finite
  have memberS := pipFamilyLocal.membership.forward with member
  exact memberS.right with finite

end PolarLocal
