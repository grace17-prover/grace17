module GRH.Proof.Endgame.LongForms
import GRH.Proof.Endgame.ShortAndEnough

section LongForms
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- The hypotheses of Theorem C on a family y : n → rows: linearly
-- independent, n ≥ (1 − 4/b²) D, index at most δ, and squared covolume of
-- the untwisted lifts at most e^V at every σ.
predicate AlmostSpanningFamily (P D L n y Δ V : Set) :=
  LinearIndependent(L.rows, complexRing, n, y) ∧
  R[(1 - 4 / dataB(D) ^ 2) * realNat(rowDim(L))] ≤ R[realNat(n)] ∧
  ((n, y), Δ) ∈ L.indexLe ∧
  (∀ σ ∈ L.automorphisms, L.covolumeSq(((n, y), σ)) ≤ realExp(V))

-- LongForms.lean, Data.integral_forms_long (Theorem C): for such a
-- family, D (h_main − 3 f a log⁴ b) ≤ V + 2δ, D = dim(rows).
theorem Data.integral_forms_long (P D L n y Δ V : Set)
  requires lifts : LiftSystemOf(P, D, L)
  requires nNat : n ∈ ℕ
  requires reals : Δ ∈ ℝ ∧ V ∈ ℝ
  requires family : AlmostSpanningFamily(P, D, L, n, y, Δ, V)
  shows R[realNat(rowDim(L)) *
      (mainHeight(P, D) - 3 * (D.logB * budget(P, D)))] ≤ R[V + 2 * Δ]
proof
  sorry

-- LongForms.lean, Data.exists_family_covolumeSq_le: there are
-- n ≥ (1 − 4/b²) D independent rows of index at most
-- 5 D log(1 + b²) 𝓑 whose untwisted lifts have squared covolume at most
-- exp(n (h_main − m rem + f a log⁴ b)) at every σ.
theorem Data.exists_family_covolumeSq_le (P D L : Set)
  requires lifts : LiftSystemOf(P, D, L)
  shows ∃ n ∈ ℕ, ∃ y, ∃ Δ ∈ ℝ,
    Δ ≤ R[5 * realNat(rowDim(L)) * realLog(R[1 + dataB(D) ^ 2]) *
      budget(P, D)] ∧
    AlmostSpanningFamily(P, D, L, n, y, Δ,
      R[realNat(n) * (mainHeight(P, D) - realNat(D.m) * remainder(P, D) +
        D.logB * budget(P, D))])
proof
  sorry

end LongForms
