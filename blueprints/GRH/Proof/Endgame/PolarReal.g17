-- Reality of Σ_ξ (L̃′/L̃(σ, ξ(·/d)) − L̃′/L̃(σ, ξ)) for real σ > 1: the
-- sum is an L-series with real coefficients (character orthogonality)
-- plus real polar parts.
-- Source: grh-compact/src/New/Endgame/PrimeError.lean (isPolar_primeError).
-- Part of: One-sided bound for non-split primes gives a zero-free
-- half-plane (GRH.Proof.Endgame.OneSidedCriterion).
-- Part of the GRH blueprint (layer 5, the argument).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Proof.Endgame.PolarReal
import GRH.Proof.Endgame.PrimeError
import GRH.Analytic.Landau
import GRH.Proof.Endgame.PolarMeasure

section PolarReal
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Section: The terms of logDerivMean
-- The terms of logDerivMean at ξ.
theorem pipLogDerivMeanTerms.apply (d M : Nat, s ξ : Set)
  requires hξ : ξ ∈ dirichletCharacters(M)
  shows logDerivMeanTerms(d, M, s)(ξ) =
    ℂ[logDerivEntireL(M * d, quadTwist(M, ξ, d), s) -
      logDerivEntireL(M, ξ, s)]
proof
  have shape : ∀ p ∈ logDerivMeanTerms(d, M, s),
      ∃ a ∈ dirichletCharacters(M), ∃ b, p = (a, b) by
    intros p hp
    simp [logDerivMeanTerms] at hp
    obtain ⟨z, zIn, eq⟩ := hp
    rw ← eq
    exact ⟨z, zIn, ℂ[logDerivEntireL(M * d, quadTwist(M, z, d), s) -
      logDerivEntireL(M, z, s)], rfl⟩
  have total : ∀ a ∈ dirichletCharacters(M),
      ∃ b, (a, b) ∈ logDerivMeanTerms(d, M, s) by
    intros a aIn
    refine ⟨ℂ[logDerivEntireL(M * d, quadTwist(M, a, d), s) -
      logDerivEntireL(M, a, s)], ?_⟩
    simp [logDerivMeanTerms]
  have functional : ∀ a, ∀ b, ∀ c, (a, b) ∈ logDerivMeanTerms(d, M, s) →
      (a, c) ∈ logDerivMeanTerms(d, M, s) → b = c by
    intros a b c ab ac
    simp [logDerivMeanTerms] at ab
    simp [logDerivMeanTerms] at ac
    obtain ⟨z, _, abEq⟩ := ab
    obtain ⟨w, _, acEq⟩ := ac
    obtain ⟨za, zb⟩ := orderedPair.injective with abEq
    obtain ⟨wa, wc⟩ := orderedPair.injective with acEq
    cc
  have mapped : (ξ, ℂ[logDerivEntireL(M * d, quadTwist(M, ξ, d), s) -
      logDerivEntireL(M, ξ, s)]) ∈ logDerivMeanTerms(d, M, s) by
    simp [logDerivMeanTerms]
  exact coefficientGraph.apply with shape, total, functional, hξ, mapped

-- L̃′/L̃(s, χ) is a complex number.
theorem pipLogDerivEntireL.member (N : Nat, χ s : Set)
  requires positive : (1:N) ≤ N
  requires character : DirichletCharacter(N, χ)
  requires hs : s ∈ complexCarrier
  shows logDerivEntireL(N, χ, s) ∈ complexCarrier
proof
  exact logDerivEntireLMap.closed with positive, character, hs

-- The terms of logDerivMean are complex numbers.
theorem pipLogDerivMeanTerms.member (d M : Nat, s ξ : Set)
  requires prime : Prime(d)
  requires positive : (1:N) ≤ M
  requires hs : s ∈ complexCarrier
  requires hξ : ξ ∈ dirichletCharacters(M)
  shows logDerivMeanTerms(d, M, s)(ξ) ∈ complexCarrier
proof
  have character := dirichletCharacters.membership.forward with hξ
  have twistCharacter := quadTwist.character at M, d, ξ with prime, character
  have dLarge := Prime.two_le with prime
  have dPositive : (1:N) ≤ d by arith
  have levelPositive := LessEqual.one_le_mul with positive, dPositive
  have first := pipLogDerivEntireL.member with levelPositive, twistCharacter,
    hs
  have second := pipLogDerivEntireL.member with positive, character, hs
  rw (pipLogDerivMeanTerms.apply with hξ)
  typecheck

-- Section: Real complex numbers
-- A complex number with imaginary part 0 is real.
theorem pip2Complex.of_im_zero (z : Set)
  requires hz : z ∈ complexCarrier
  requires im : complexIm(z) = (0:R)
  shows z = complexOfReal(complexRe(z))
proof
  have parts := complex.re_add_im with hz
  have reReal := complexRe.real with hz
  rw [im, complexOfReal.zero] at parts
  have unit : complexImaginaryUnit ∈ ℂ by typecheck
  have reC : complexOfReal(complexRe(z)) ∈ ℂ by typecheck
  have step : ℂ[complexOfReal(complexRe(z)) + complexImaginaryUnit * 0] =
      complexOfReal(complexRe(z)) by ring
  rw step at parts
  exact parts

-- A series of real terms sums to a real number.
theorem pip2SumsTo.im_zero (u S : Set)
  requires sums : ComplexSumsTo(u, S)
  requires real : ∀ n ∈ ℕ, complexIm(u(n)) = (0:R)
  shows complexIm(S) = (0:R)
proof
  have member := ComplexSumsTo.member with sums
  have reReal := complexRe.real with member
  have horizontal := ComplexSumsTo.re with sums
  have sums2 := sums
  obtain ⟨sequence, _⟩ := sums2
  have ySequence := complexSequenceY.function with sequence
  have constant := constantSequence.sequence at (0:R)
  have same : complexSequenceY(u) = constantSequence((0:R)) by
    apply FunctionBetween.ext with ySequence, constant
    intros n hn
    have nNat := nat.omega.backward with hn
    have term : u(n) ∈ ℂ by
      exact FunctionBetween.apply_closed with sequence, hn
    rw [(complexSequenceY.value with sequence, hn), (complexIm.y with term),
      (constantSequence.value at (0:R), n)]
    exact real with n, hn
  have vertical := SumsTo.zero
  rw ← same at vertical
  have parts := ComplexSumsTo.of_parts at u, complexRe(S), (0:R) with
    sequence, horizontal, vertical
  have equal := ComplexSumsTo.unique with sums, parts
  rw equal
  exact complexPoint.im at complexRe(S), (0:R)

-- An L-series with real coefficients has a real sum at a real point.
theorem pip2LSeries.im_zero (f a : Set, X : Real)
  requires values : FunctionBetween(f, ℕ, complexCarrier)
  requires real : ∀ n ∈ ℕ, complexIm(f(n)) = (0:R)
  requires has : LSeriesHasSum(f, complexOfReal(X), a)
  shows complexIm(a) = (0:R)
proof
  obtain ⟨_, sums⟩ := has
  have hs : complexOfReal(X) ∈ ℂ by typecheck
  apply pip2SumsTo.im_zero with sums
  intros n hn
  have nNat := nat.omega.backward with hn
  have index : n + 1 ∈ ℕ by typecheck
  have coefficient := FunctionBetween.apply_closed with values, index
  have coefficientReal := pip2Complex.of_im_zero with coefficient,
    (real with n + 1, index)
  have coefficientRe := complexRe.real with coefficient
  rw [(lseriesTerms.value with values, hs, hn), coefficientReal,
    ← complexOfReal.neg, realCpow.of_real, ← complexOfReal.mul,
    complexOfReal.im]

-- Section: Finite sums
-- The finite sums of the additive group of ℂ are the ring sums.
theorem pip2GroupSum.ring (V w : Set)
  requires finite : Finite(V)
  requires weights : FunctionBetween(w, V, complexCarrier)
  shows groupFiniteSum(complexAdditiveGroup, V, w) = complexFamilySum(w, V)
proof
  have ngC := complexAdditiveGroup.normed
  obtain ⟨c, m⟩ := complexAdditiveGroup.parts
  have o : Group.one(complexAdditiveGroup) = complexZero by
    unfold complexAdditiveGroup
    group_projections
  obtain ⟨n, cardinality⟩ := finite
  obtain ⟨natural, equipotent⟩ := cardinality
  obtain ⟨g, bijective⟩ := equipotent
  have enumeration := converse.bijective with bijective
  have ring := complexes.comm_ring
  have values : ∀ i ∈ V, w(i) ∈ Group.carrier(complexAdditiveGroup) by
    intros i hi
    rw c
    exact FunctionBetween.apply_closed with weights, hi
  have groupSum := groupFiniteSum.enumeration with ngC.left, values,
    enumeration
  have ringSum := finiteRingSum.enumeration at V, complexCarrier, complexAdd,
    complexZero, complexNeg, complexMul, complexOne, w, converse(g, V, n), n
    with ring, weights, enumeration
  unfold complexFamilySum
  rw [groupSum, ringSum, m, o]

defgraph pip2ZeroFamily (V : Set) (i ∈ V) : ℝ := realZero
proof
  typecheck

-- A finite sum of real complex numbers is real.
theorem pip2FiniteSum.im_zero (V w : Set)
  requires finite : Finite(V)
  requires values : ∀ i ∈ V, w(i) ∈ complexCarrier
  requires real : ∀ i ∈ V, complexIm(w(i)) = (0:R)
  shows complexIm(groupFiniteSum(complexAdditiveGroup, V, w)) = (0:R)
proof
  have ngC := complexAdditiveGroup.normed
  obtain ⟨c, m⟩ := complexAdditiveGroup.parts
  have abelianC := ngC.left
  have groupC := AbelianGroup.to_group with abelianC
  have abelianR := realAdditiveGroup.abelian
  have groupR := AbelianGroup.to_group with abelianR
  obtain ⟨abR, cR, mR, oR⟩ := realAdditiveGroup.parts
  have fn : secondProjection(ℝ, ℝ) : Group.carrier(complexAdditiveGroup) →
      Group.carrier(realAdditiveGroup) by
    rw [c, cR]
    unfold complexCarrier
    exact secondProjection.function at ℝ, ℝ
  have hom : secondProjection(ℝ, ℝ) : complexAdditiveGroup →*
      realAdditiveGroup by
    apply GroupHom.mk with groupC, groupR, fn
    intros x hx y hy
    rw c at hx
    rw c at hy
    rw [m, mR]
    have xy := FunctionBetween.apply_closed with complexAdd.function,
      (product.pair with hx, hy)
    have e1 := complexIm.projection with xy
    have e2 := complexIm.projection with hx
    have e3 := complexIm.projection with hy
    have ad := complexIm.add with hx, hy
    rw [e2, e3]
    have same : complexAdd(x, y) = complexAdd((x, y)) by
      unfold Algebra.call2
      rfl
    rw ← same at e1
    rw [e1, ad]
  have valuesC : ∀ i ∈ V, w(i) ∈ Group.carrier(complexAdditiveGroup) by
    intros i hi
    rw c
    exact values with i, hi
  have composite : ∀ i ∈ V,
      pip2ZeroFamily(V)(i) = secondProjection(ℝ, ℝ)(w(i)) by
    intros i hi
    have wi := values with i, hi
    rw [(pip2ZeroFamily.value with hi), (complexIm.projection with wi)]
    symm
    exact real with i, hi
  have mapped := groupFiniteSum.hom with abelianC, abelianR, hom, finite,
    valuesC, composite
  have zeros : ∀ i ∈ V, pip2ZeroFamily(V)(i) = Group.one(realAdditiveGroup)
    by
    intros i hi
    rw [(pip2ZeroFamily.value with hi), oR]
  have zero := groupFiniteSum.zero with abelianR, finite, zeros
  have sumC := groupFiniteSum.member with abelianC, finite, valuesC
  rw c at sumC
  rw [← (complexIm.projection with sumC), mapped, zero, oR]

-- Section: The principal indicator
-- The principal indicator is a real number in ℂ.
theorem pip2PrincipalIndicator.real (N : Nat, χ : Set)
  shows ∃ r ∈ ℝ, principalIndicator(N, χ) = complexOfReal(r)
proof
  by_cases principal : χ = principalCharacter(N)
  . have value : principalIndicator(N, χ) = ℂ[1] by
      unfold principalIndicator
      apply union.of_unique
      . have oneC : ℂ[1] ∈ ℂ by typecheck
        refine ⟨oneC, ?_⟩
        left
        exact ⟨principal, rfl⟩
      . intros y hy
        obtain ⟨_, alternatives⟩ := hy
        rcases alternatives with ⟨_, yValue⟩ | ⟨other, _⟩
        . exact yValue
        . contradiction
    have oneR : R[1] ∈ ℝ by typecheck
    rw [value, ← complexOfReal.one]
    exact ⟨R[1], oneR, rfl⟩
  . have value : principalIndicator(N, χ) = ℂ[0] by
      unfold principalIndicator
      apply union.of_unique
      . have zeroC : ℂ[0] ∈ ℂ by typecheck
        refine ⟨zeroC, ?_⟩
        right
        exact ⟨principal, rfl⟩
      . intros y hy
        obtain ⟨_, alternatives⟩ := hy
        rcases alternatives with ⟨same, _⟩ | ⟨_, yValue⟩
        . contradiction
        . exact yValue
    have zeroR : R[0] ∈ ℝ by typecheck
    rw [value, ← complexOfReal.zero]
    exact ⟨R[0], zeroR, rfl⟩

-- Section: The coefficient family
-- The coefficients Λ(n)(ξ(n)(n/d) − ξ(n)) of the series of
-- L̃′/L̃(s, ξ) − L̃′/L̃(s, ξ(·/d)), as a function of ξ.
def pip2CoeffValue (d M : Nat, ξ : Set) : Set :=
  coefficientSub(twistedVonMangoldt(quadTwist(M, ξ, d)), twistedVonMangoldt(ξ))

def pip2CoeffValues (d M : Nat) : Set :=
  { pip2CoeffValue(d, M, ξ) | ξ ∈ dirichletCharacters(M) }

defgraph pip2Coeffs (d M : Nat) (ξ ∈ dirichletCharacters(M)) :
    pip2CoeffValues(d, M) := pip2CoeffValue(d, M, ξ)
proof
  unfold pip2CoeffValues
  simp

-- The sums of those series: p/(s − 1) − L̃′/L̃(s, χ), p the principal
-- indicator, differenced over χ = ξ(·/d), ξ.
def pip2PolarValue (N : Nat, χ s : Set) : Set :=
  ℂ[complexDiv(principalIndicator(N, χ), ℂ[s - 1]) -
    logDerivEntireL(N, χ, s)]

defgraph pip2SumTerms (d M : Nat, s : Set) (ξ ∈ dirichletCharacters(M)) :
    complexCarrier :=
    ℂ[pip2PolarValue(M * d, quadTwist(M, ξ, d), s) - pip2PolarValue(M, ξ, s)]
requires prime : Prime(d)
requires positive : (1:N) ≤ M
requires hs : s ∈ complexCarrier
proof
  have character := dirichletCharacters.membership.forward with member
  have twistCharacter := quadTwist.character at M, d, ξ with prime, character
  have dLarge := Prime.two_le with prime
  have dPositive : (1:N) ≤ d by arith
  have levelPositive := LessEqual.one_le_mul with positive, dPositive
  have first := logDerivEntireLMap.closed with levelPositive, twistCharacter,
    hs
  have second := logDerivEntireLMap.closed with positive, character, hs
  obtain ⟨r1, r1Real, p1⟩ := pip2PrincipalIndicator.real at M * d,
    quadTwist(M, ξ, d)
  obtain ⟨r2, r2Real, p2⟩ := pip2PrincipalIndicator.real at M, ξ
  have shift : ℂ[s - 1] ∈ ℂ by typecheck
  have inverse := complexInv.member with shift
  unfold pip2PolarValue
  unfold complexDiv
  rw [p1, p2]
  typecheck

-- The polar parts alone.
defgraph pip2PoleTerms (d M : Nat, s : Set) (ξ ∈ dirichletCharacters(M)) :
    complexCarrier :=
    ℂ[complexDiv(principalIndicator(M * d, quadTwist(M, ξ, d)), ℂ[s - 1]) -
      complexDiv(principalIndicator(M, ξ), ℂ[s - 1])]
requires hs : s ∈ complexCarrier
proof
  obtain ⟨r1, r1Real, p1⟩ := pip2PrincipalIndicator.real at M * d,
    quadTwist(M, ξ, d)
  obtain ⟨r2, r2Real, p2⟩ := pip2PrincipalIndicator.real at M, ξ
  have shift : ℂ[s - 1] ∈ ℂ by typecheck
  have inverse := complexInv.member with shift
  unfold complexDiv
  rw [p1, p2]
  typecheck

-- The coefficients of a finite family of series, summed.
theorem pip2CoefficientFamilySum.eval (F I n : Set)
  requires index : n ∈ ℕ
  shows coefficientFamilySum(F, I)(n) = finiteRingSum(I, complexCarrier,
    complexAdd, complexZero, complexNeg, complexMul, complexOne,
    familyValues(F, n, I))
proof
  have shape : ∀ p ∈ coefficientFamilySum(F, I), ∃ a ∈ ℕ, ∃ b, p = (a, b)
    by
    intros p hp
    simp [coefficientFamilySum] at hp
    obtain ⟨m, mIn, eq⟩ := hp
    rw ← eq
    exact ⟨m, mIn, finiteRingSum(I, complexCarrier, complexAdd, complexZero,
      complexNeg, complexMul, complexOne, familyValues(F, m, I)), rfl⟩
  have total : ∀ a ∈ ℕ, ∃ b, (a, b) ∈ coefficientFamilySum(F, I) by
    intros a aIn
    refine ⟨finiteRingSum(I, complexCarrier, complexAdd, complexZero,
      complexNeg, complexMul, complexOne, familyValues(F, a, I)), ?_⟩
    simp [coefficientFamilySum]
  have functional : ∀ a, ∀ b, ∀ c, (a, b) ∈ coefficientFamilySum(F, I) →
      (a, c) ∈ coefficientFamilySum(F, I) → b = c by
    intros a b c ab ac
    simp [coefficientFamilySum] at ab
    simp [coefficientFamilySum] at ac
    obtain ⟨m, _, abEq⟩ := ab
    obtain ⟨k, _, acEq⟩ := ac
    obtain ⟨ma, mb⟩ := orderedPair.injective with abEq
    obtain ⟨ka, kc⟩ := orderedPair.injective with acEq
    cc
  have mapped : (n, finiteRingSum(I, complexCarrier, complexAdd, complexZero,
      complexNeg, complexMul, complexOne, familyValues(F, n, I))) ∈
      coefficientFamilySum(F, I) by
    simp [coefficientFamilySum]
  exact coefficientGraph.apply with shape, total, functional, index, mapped

-- The summed coefficients of a finite family of series form a function.
theorem pip2CoefficientFamilySum.function (F I : Set)
  requires finite : Finite(I)
  requires values : ∀ i ∈ I, FunctionBetween(F(i), ℕ, complexCarrier)
  shows FunctionBetween(coefficientFamilySum(F, I), ℕ, complexCarrier)
proof
  have ring := complexes.comm_ring
  have closed : ∀ m ∈ ℕ, finiteRingSum(I, complexCarrier, complexAdd,
      complexZero, complexNeg, complexMul, complexOne,
      familyValues(F, m, I)) ∈ ℂ by
    intros m mIn
    have weights : familyValues(F, m, I) : I → complexCarrier by
      apply familyValues.maps
      intros i hi
      exact FunctionBetween.apply_closed with (values with i, hi), mIn
    exact finiteRingSum.closed with ring, finite, weights
  have shape : ∀ p ∈ coefficientFamilySum(F, I), ∃ a ∈ ℕ,
      ∃ b ∈ complexCarrier, p = (a, b) by
    intros p hp
    simp [coefficientFamilySum] at hp
    obtain ⟨m, mIn, eq⟩ := hp
    rw ← eq
    exact ⟨m, mIn, finiteRingSum(I, complexCarrier, complexAdd, complexZero,
      complexNeg, complexMul, complexOne, familyValues(F, m, I)),
      (closed with m, mIn), rfl⟩
  have total : ∀ a ∈ ℕ, ∃ b ∈ complexCarrier,
      (a, b) ∈ coefficientFamilySum(F, I) by
    intros a aIn
    refine ⟨finiteRingSum(I, complexCarrier, complexAdd, complexZero,
      complexNeg, complexMul, complexOne, familyValues(F, a, I)),
      (closed with a, aIn), ?_⟩
    simp [coefficientFamilySum]
  have functional : ∀ a, ∀ b, ∀ c, (a, b) ∈ coefficientFamilySum(F, I) →
      (a, c) ∈ coefficientFamilySum(F, I) → b = c by
    intros a b c ab ac
    simp [coefficientFamilySum] at ab
    simp [coefficientFamilySum] at ac
    obtain ⟨m, _, abEq⟩ := ab
    obtain ⟨k, _, acEq⟩ := ac
    obtain ⟨ma, mb⟩ := orderedPair.injective with abEq
    obtain ⟨ka, kc⟩ := orderedPair.injective with acEq
    cc
  exact coefficientGraph.function with shape, total, functional

-- Σ_ξ Λ(n)(ξ(n)(n/d) − ξ(n)) = Λ(n)((n/d) − 1) Σ_ξ ξ(n) is real.
theorem pip2Coeffs.sum_real (d M n : Nat)
  requires prime : Prime(d)
  requires positive : (1:N) ≤ M
  shows complexIm(coefficientFamilySum(pip2Coeffs(d, M),
    dirichletCharacters(M))(n)) = (0:R)
proof
  have index : n ∈ ℕ by typecheck
  have mPositive : 0 < M by arith
  have finite := dirichletCharacters.finite with mPositive
  have ring := complexes.comm_ring
  have integer : integerOfNat(n) ∈ ℤ by typecheck
  have legendre := legendreSign.real at d, integerOfNat(n)
  have lambda := vonMangoldt.real at n
  have cC : ℂ[complexOfReal(legendreSign(d, integerOfNat(n))) *
      complexOfReal(vonMangoldt(n)) - complexOfReal(vonMangoldt(n))] ∈ ℂ by
    typecheck
  have cReal : ℂ[complexOfReal(legendreSign(d, integerOfNat(n))) *
      complexOfReal(vonMangoldt(n)) - complexOfReal(vonMangoldt(n))] =
      complexOfReal(R[legendreSign(d, integerOfNat(n)) * vonMangoldt(n) -
        vonMangoldt(n)]) by
    rw [complexOfReal.sub, complexOfReal.mul]
  have weightsW := characterEvaluation.function at M, integerOfNat(n) with
    integer
  have entries : ∀ ξ ∈ dirichletCharacters(M),
      familyValues(pip2Coeffs(d, M), n, dirichletCharacters(M))(ξ) =
        ℂ[ℂ[complexOfReal(legendreSign(d, integerOfNat(n))) *
          complexOfReal(vonMangoldt(n)) - complexOfReal(vonMangoldt(n))] *
          characterEvaluation(M, integerOfNat(n))(ξ)] by
    intros ξ hξ
    have character := dirichletCharacters.membership.forward with hξ
    have value := DirichletCharacter.value with character, integer
    rw [(familyValues.eval with hξ), (pip2Coeffs.value with hξ),
      (characterEvaluation.value with integer, hξ)]
    unfold pip2CoeffValue
    unfold twistedVonMangoldt
    unfold vonMangoldtCoefficients
    rw [(coefficientSub.eval with index),
      (coefficientMul.eval at characterCoefficients(quadTwist(M, ξ, d)),
        realCoefficients(vonMangoldt), n with index),
      (coefficientMul.eval at characterCoefficients(ξ),
        realCoefficients(vonMangoldt), n with index),
      (characterCoefficients.eval at quadTwist(M, ξ, d), n with index),
      (characterCoefficients.eval at ξ, n with index),
      (realCoefficients.eval at vonMangoldt, n with index),
      (quadTwist.apply with prime, character, integer)]
    ring
  have weightsV : familyValues(pip2Coeffs(d, M), n, dirichletCharacters(M)) :
      dirichletCharacters(M) → complexCarrier by
    apply familyValues.maps
    intros ξ hξ
    rw ← (familyValues.eval at pip2Coeffs(d, M), n, dirichletCharacters(M), ξ
      with hξ)
    rw (entries with ξ, hξ)
    have term := FunctionBetween.apply_closed with weightsW, hξ
    typecheck
  have scaled := finiteRingSum.scale_eq with ring, finite, weightsW, weightsV,
    cC, entries
  have sumReal : ∃ r ∈ ℝ, finiteRingSum(dirichletCharacters(M),
      complexCarrier, complexAdd, complexZero, complexNeg, complexMul,
      complexOne, characterEvaluation(M, integerOfNat(n))) =
      complexOfReal(r) by
    by_cases congruent : IntegerCongruent(integerOfNat(M), integerOfNat(n),
        integerOne)
    . have one := dirichletCharacters.sum_one with mPositive, integer,
        congruent
      rw [one, ← complexOfReal.nat]
      have real : realNat(totient(M)) ∈ ℝ by typecheck
      exact ⟨realNat(totient(M)), real, rfl⟩
    . have other := dirichletCharacters.sum_other with mPositive, integer,
        congruent
      have zeroR : R[0] ∈ ℝ by typecheck
      rw [other, ← complexOfReal.zero]
      exact ⟨R[0], zeroR, rfl⟩
  obtain ⟨r, rReal, sumValue⟩ := sumReal
  rw [(pip2CoefficientFamilySum.eval with index), scaled, sumValue, cReal,
    ← complexOfReal.mul, complexOfReal.im]

-- Section: Reality of the sum
-- For real σ > 1, Σ_ξ (L̃′/L̃(σ, ξ(·/d)) − L̃′/L̃(σ, ξ)) is real.
theorem pip2LogDerivSum.im_zero (d M : Nat, X : Real)
  requires prime : Prime(d)
  requires positive : (1:N) ≤ M
  requires above : (1:R) < X
  shows complexIm(groupFiniteSum(complexAdditiveGroup, dirichletCharacters(M),
    logDerivMeanTerms(d, M, complexOfReal(X)))) = (0:R)
proof
  have hs : complexOfReal(X) ∈ ℂ by typecheck
  have halfPlane : (1:R) < complexRe(complexOfReal(X)) by
    rw complexOfReal.re
    exact above
  have mPositive : 0 < M by arith
  have finite := dirichletCharacters.finite with mPositive
  have dLarge := Prime.two_le with prime
  have dPositive : (1:N) ≤ d by arith
  have levelPositive := LessEqual.one_le_mul with positive, dPositive
  have coefficients : ∀ ξ ∈ dirichletCharacters(M),
      FunctionBetween(pip2Coeffs(d, M)(ξ), ℕ, complexCarrier) by
    intros ξ hξ
    have character := dirichletCharacters.membership.forward with hξ
    have twistCharacter := quadTwist.character at M, d, ξ with prime,
      character
    have f1 := twistedVonMangoldt.function with twistCharacter
    have f2 := twistedVonMangoldt.function with character
    rw (pip2Coeffs.value with hξ)
    unfold pip2CoeffValue
    apply coefficientSub.maps
    intros m mIn
    have a1 := FunctionBetween.apply_closed with f1, mIn
    have a2 := FunctionBetween.apply_closed with f2, mIn
    typecheck
  have each : ∀ ξ ∈ dirichletCharacters(M), LSeriesHasSum(pip2Coeffs(d, M)(ξ),
      complexOfReal(X), pip2SumTerms(d, M, complexOfReal(X))(ξ)) by
    intros ξ hξ
    have character := dirichletCharacters.membership.forward with hξ
    have twistCharacter := quadTwist.character at M, d, ξ with prime,
      character
    have f1 := twistedVonMangoldt.function with twistCharacter
    have f2 := twistedVonMangoldt.function with character
    have s1 := LSeriesHasSum.twist_vonMangoldt_entireL with levelPositive,
      twistCharacter, hs, halfPlane
    have s2 := LSeriesHasSum.twist_vonMangoldt_entireL with positive,
      character, hs, halfPlane
    rw [(pip2Coeffs.value with hξ),
      (pip2SumTerms.value with prime, positive, hs, hξ)]
    unfold pip2CoeffValue
    unfold pip2PolarValue
    exact LSeriesHasSum.sub with f1, f2, hs, s1, s2
  have sums := pip2SumTerms.function with prime, positive, hs
  have family := LSeriesHasSum.family_sum with finite, coefficients, sums, hs,
    each
  have familyFunction := pip2CoefficientFamilySum.function with finite,
    coefficients
  have real : ∀ n ∈ ℕ, complexIm(coefficientFamilySum(pip2Coeffs(d, M),
      dirichletCharacters(M))(n)) = (0:R) by
    intros n hn
    have nNat := nat.omega.backward with hn
    exact pip2Coeffs.sum_real with prime, positive
  have imA := pip2LSeries.im_zero with familyFunction, real, family
  rw ← (pip2GroupSum.ring with finite, sums) at imA
  have valuesA : ∀ ξ ∈ dirichletCharacters(M),
      pip2SumTerms(d, M, complexOfReal(X))(ξ) ∈ ℂ by
    intros ξ hξ
    exact FunctionBetween.apply_closed with sums, hξ
  have valuesT : ∀ ξ ∈ dirichletCharacters(M),
      logDerivMeanTerms(d, M, complexOfReal(X))(ξ) ∈ ℂ by
    intros ξ hξ
    exact pipLogDerivMeanTerms.member with prime, positive, hs, hξ
  have valuesP : ∀ ξ ∈ dirichletCharacters(M),
      pip2PoleTerms(d, M, complexOfReal(X))(ξ) ∈ ℂ by
    intros ξ hξ
    rw (pip2PoleTerms.value with hs, hξ)
    exact pip2PoleTerms.closed with hs, hξ
  have poleReal : ∀ ξ ∈ dirichletCharacters(M),
      complexIm(pip2PoleTerms(d, M, complexOfReal(X))(ξ)) = (0:R) by
    intros ξ hξ
    obtain ⟨r1, r1Real, p1⟩ := pip2PrincipalIndicator.real at M * d,
      quadTwist(M, ξ, d)
    obtain ⟨r2, r2Real, p2⟩ := pip2PrincipalIndicator.real at M, ξ
    have nonzero : R[X - 1] ≠ R[0] by
      intro equal
      linarith
    have shift : ℂ[complexOfReal(X) - 1] = complexOfReal(R[X - 1]) by
      rw [complexOfReal.sub, complexOfReal.one]
    rw (pip2PoleTerms.value with hs, hξ)
    unfold complexDiv
    rw [p1, p2, shift, ← (complexOfReal.inv with nonzero),
      ← complexOfReal.mul, ← complexOfReal.mul, ← complexOfReal.sub,
      complexOfReal.im]
  have imP := pip2FiniteSum.im_zero with finite, valuesP, poleReal
  have ngC := complexAdditiveGroup.normed
  obtain ⟨c, m⟩ := complexAdditiveGroup.parts
  have valuesAG : ∀ ξ ∈ dirichletCharacters(M),
      pip2SumTerms(d, M, complexOfReal(X))(ξ) ∈
        Group.carrier(complexAdditiveGroup) by
    rw c
    exact valuesA
  have valuesTG : ∀ ξ ∈ dirichletCharacters(M),
      logDerivMeanTerms(d, M, complexOfReal(X))(ξ) ∈
        Group.carrier(complexAdditiveGroup) by
    rw c
    exact valuesT
  have split : ∀ ξ ∈ dirichletCharacters(M),
      pip2PoleTerms(d, M, complexOfReal(X))(ξ) =
        Group.mul(complexAdditiveGroup)(
          pip2SumTerms(d, M, complexOfReal(X))(ξ),
          logDerivMeanTerms(d, M, complexOfReal(X))(ξ)) by
    intros ξ hξ
    have character := dirichletCharacters.membership.forward with hξ
    have twistCharacter := quadTwist.character at M, d, ξ with prime,
      character
    have l1 := logDerivEntireLMap.closed with levelPositive, twistCharacter,
      hs
    have l2 := logDerivEntireLMap.closed with positive, character, hs
    have valueP := valuesP with ξ, hξ
    rw (pip2PoleTerms.value with hs, hξ) at valueP
    rw [m, (pip2PoleTerms.value with hs, hξ),
      (pip2SumTerms.value with prime, positive, hs, hξ),
      (pipLogDerivMeanTerms.apply with hξ)]
    unfold pip2PolarValue
    obtain ⟨r1, r1Real, p1⟩ := pip2PrincipalIndicator.real at M * d,
      quadTwist(M, ξ, d)
    obtain ⟨r2, r2Real, p2⟩ := pip2PrincipalIndicator.real at M, ξ
    have shift : ℂ[complexOfReal(X) - 1] ∈ ℂ by typecheck
    have inverse := complexInv.member with shift
    unfold complexDiv
    rw [p1, p2]
    ring
  have added := groupFiniteSum.add with ngC.left, finite, valuesAG, valuesTG,
    split
  have sumA := groupFiniteSum.member with ngC.left, finite, valuesAG
  have sumT := groupFiniteSum.member with ngC.left, finite, valuesTG
  rw c at sumA
  rw c at sumT
  rw m at added
  have imSum : complexIm(groupFiniteSum(complexAdditiveGroup,
      dirichletCharacters(M), pip2PoleTerms(d, M, complexOfReal(X)))) =
      R[complexIm(groupFiniteSum(complexAdditiveGroup, dirichletCharacters(M),
        pip2SumTerms(d, M, complexOfReal(X)))) +
      complexIm(groupFiniteSum(complexAdditiveGroup, dirichletCharacters(M),
        logDerivMeanTerms(d, M, complexOfReal(X))))] by
    rw added
    exact complexIm.add with sumA, sumT
  have r1 := complexIm.real with sumA
  have r2 := complexIm.real with sumT
  have rT : Real(complexIm(groupFiniteSum(complexAdditiveGroup,
      dirichletCharacters(M), logDerivMeanTerms(d, M, complexOfReal(X)))))
    by exact r2
  rw [imP, imA] at imSum
  linarith

-- Section: Continuity at 1
-- A function holomorphic on a disk about 1 and real at the real points
-- σ > 1 of the disk is real at 1.
theorem pip2Holomorphic.im_zero_at_one (H : Set, t : Real)
  requires positive : (0:R) < t
  requires holomorphic : HolomorphicOn(H, complexDisk(ℂ[1], t))
  requires real : ∀ X ∈ ℝ, (1:R) < X →
    complexAbs(ℂ[complexOfReal(X) - 1]) < t →
    complexIm(H(complexOfReal(X))) = (0:R)
  shows complexIm(H(ℂ[1])) = (0:R)
proof
  have continuous := HolomorphicOn.continuous with holomorphic
  obtain ⟨_, valuesH, close⟩ := continuous
  have oneC : ℂ[1] ∈ ℂ by typecheck
  have center : ℂ[1] ∈ complexDisk(ℂ[1], t) by
    unfold complexDisk
    have zero : ℂ[1 - 1] = complexOfReal(R[0]) by
      rw complexOfReal.zero
      ring
    have zeroR : R[0] ∈ ℝ by typecheck
    have le : (0:R) ≤ R[0] by linarith
    rw [zero, complexAbs.of_real, (abs.of_nonnegative with le)]
    exact ⟨oneC, positive⟩
  have h1 := valuesH with ℂ[1], center
  have im1 := complexIm.real with h1
  have near : ∀ e ∈ ℝ, (0:R) < e → ∃ X ∈ ℝ, H(complexOfReal(X)) ∈ ℂ ∧
      complexIm(H(complexOfReal(X))) = (0:R) ∧ complexAbs(ℂ[H(complexOfReal(X)) - H(ℂ[1])]) < e by
    intros e eReal ePositive
    obtain ⟨δ, δReal, δPositive, closeδ⟩ := close with ℂ[1], center, e,
      eReal, ePositive
    have tReal : t ∈ ℝ by typecheck
    obtain ⟨ρ, ρReal, ρPositive, ρδ, ρt⟩ := realRadius.common with δReal,
      tReal, δPositive, positive
    have xReal : R[1 + ρ / 2] ∈ ℝ by typecheck
    have above : (1:R) < R[1 + ρ / 2] by linarith
    have shift : ℂ[complexOfReal(R[1 + ρ / 2]) - 1] = complexOfReal(R[ρ / 2])
      by
      rw [← complexOfReal.one, ← complexOfReal.sub]
      have same : R[R[1 + ρ / 2] - 1] = R[ρ / 2] by ring
      rw same
    have halfNonneg : (0:R) ≤ R[ρ / 2] by linarith
    have distance : complexAbs(ℂ[complexOfReal(R[1 + ρ / 2]) - 1]) =
        R[ρ / 2] by
      rw [shift, complexAbs.of_real, (abs.of_nonnegative with halfNonneg)]
    have small : complexAbs(ℂ[complexOfReal(R[1 + ρ / 2]) - 1]) < t by
      rw distance
      linarith
    have smallδ : complexAbs(ℂ[complexOfReal(R[1 + ρ / 2]) - ℂ[1]]) < δ by
      rw distance
      linarith
    have xC : complexOfReal(R[1 + ρ / 2]) ∈ ℂ by typecheck
    have inDisk : complexOfReal(R[1 + ρ / 2]) ∈ complexDisk(ℂ[1], t) by
      unfold complexDisk
      exact ⟨xC, small⟩
    have bound := closeδ with complexOfReal(R[1 + ρ / 2]), inDisk, smallδ
    have value := valuesH with complexOfReal(R[1 + ρ / 2]), inDisk
    exact ⟨R[1 + ρ / 2], xReal, value, (real with R[1 + ρ / 2], xReal, above, small),
      bound⟩
  rcases realLess.trichotomy at complexIm(H(ℂ[1])), (0:R) with
    negative | zero | positiveIm
  . exfalso
    have eReal : R[-complexIm(H(ℂ[1]))] ∈ ℝ by typecheck
    have ePositive : (0:R) < R[-complexIm(H(ℂ[1]))] by linarith
    obtain ⟨X, xReal, hX, imX, bound⟩ := near with R[-complexIm(H(ℂ[1]))],
      eReal, ePositive
    have below := complexIm.sub_bound with hX, h1
    linarith
  . exact zero
  . exfalso
    have ePositive : (0:R) < complexIm(H(ℂ[1])) by linarith
    obtain ⟨X, xReal, hX, imX, bound⟩ := near with complexIm(H(ℂ[1])), im1,
      ePositive
    have below := complexIm.sub_bound with h1, hX
    have flip : ℂ[H(ℂ[1]) - H(complexOfReal(X))] =
        ℂ[-(H(complexOfReal(X)) - H(ℂ[1]))] by ring
    have difference : ℂ[H(complexOfReal(X)) - H(ℂ[1])] ∈ ℂ by typecheck
    rw [flip, (complexAbs.neg with difference)] at below
    linarith

end PolarReal
