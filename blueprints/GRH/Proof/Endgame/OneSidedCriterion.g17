-- One-sided bound for non-split primes gives a zero-free half-plane: if
-- β > 1/2 and, for every prime d of a unit class a modulo M forcing
-- d ≡ 7 mod 8, the remainder R_M(x) is eventually at most x^(β−1), then
-- L̃(s, χ) has no zero in re s > β for any χ modulo M.
-- Source: grh-compact/src/New/Endgame/OneSidedCriterion.lean. "One-sided
-- bound gives a zero-free half-plane; small value in every long window."
-- It is known that a one-sided bound for a weighted sum over primes 1 mod
-- q gives a zero-free half-plane if there are no real zeros. Related
-- work: M. Suzuki, On variants of Chebyshev's conjecture, arXiv
-- 2411.07436, 2024; Montgomery-Vaughan, Multiplicative Number Theory I,
-- §15.1-15.2, 2007; Landau, Über einen Satz von Tschebyschef, 1905;
-- Pintz, On the sign changes of π(x) − li(x), 1976-78; Kaczorowski, On
-- sign-changes in the remainder-term of the prime-number formula, 1984.
-- Part of the GRH blueprint (layer 5, the argument).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Proof.Endgame.OneSidedCriterion
import GRH.Proof.Endgame.PrimeError
import GRH.Proof.Endgame.CriterionTools

section OneSidedCriterion
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- ∀ᶠ x in atTop, R_M(x) ≤ x^(β−1) (`primeError`; x^(β−1) is Mathlib's
-- rpow, which for x > 0 is layer 1's realRpow).
predicate PrimeErrorEventuallyLe (d M : Nat, B : Real) :=
  ∃ X ∈ ℝ, ∀ Y ∈ ℝ, X ≤ Y →
    primeError(d, M, Y) ≤ realRpow(Y, R[B - 1])

-- OneSidedCriterion.lean, entireL_ne_zero_of_primeError_le. The class a
-- of ZMod M is represented by a natural number; "a is a unit" is
-- gcd(a, M) = 1, and the prime d lies in the class when d ≡ a (mod M).
theorem entireL.ne_zero_of_primeError_le (M a : Nat, B : Real, ρ χ : Set)
  requires positive : (1:N) ≤ M
  requires half : R[1 / 2] < B
  requires unit : gcd(a, M) = (1:N)
  requires bound : ∀ d ∈ ℕ, Prime(d) → CongruentMod(d, a, M) →
    (d % 8 = (7:N) ∧ gcd(M, d) = (1:N)) ∧ PrimeErrorEventuallyLe(d, M, B)
  requires hρ : ρ ∈ complexCarrier
  requires right : B < complexRe(ρ)
  requires character : DirichletCharacter(M, χ)
  shows entireL(M, χ, ρ) ≠ ℂ[0]
proof
  -- A prime d ≡ a whose twists have no zero on re s ≥ B, |im s| ≤ |im ρ|.
  have halfPositive : R[0] < R[1 / 2] by linarith
  have bPositive : R[0] < B by linarith
  have classPrimes : ∀ d ∈ ℕ, Prime(d) → CongruentMod(d, a, M) →
      d % 8 = (7:N) ∧ gcd(M, d) = (1:N) by
    intros d hd dPrime dClass
    have facts := bound with hd, dPrime, dClass
    exact facts.left
  obtain ⟨d, hd, dPrime, dClass, zeroFree⟩ :=
    entireL.exists_quadTwist_ne_zero at M, a, B, abs(complexIm(ρ)) with
      positive, half, unit, classPrimes
  have facts := bound with hd, dPrime, dClass
  obtain ⟨⟨seven, coprime⟩, eventually⟩ := facts
  have eventuallyLe : ∃ X ∈ ℝ, ∀ Y ∈ ℝ, X ≤ Y →
      primeError(d, M, Y) ≤ realRpow(Y, R[B - 1]) by
    unfold PrimeErrorEventuallyLe at eventually
    exact eventually
  -- No twist vanishes at a real point right of B.
  have realTwists : ∀ ξ ∈ dirichletCharacters(M), ∀ X ∈ ℝ, B < X →
      entireL(M * d, quadTwist(M, ξ, d), complexOfReal(X)) ≠ ℂ[0] by
    intros ξ hξ X hX lt
    have point : complexOfReal(X) ∈ complexCarrier by typecheck
    have reX := complexOfReal.re at X
    have imX := complexOfReal.im at X
    have reLe : B ≤ complexRe(complexOfReal(X)) by
      rw reX
      linarith
    have absZero := abs.zero
    have imLe : abs(complexIm(complexOfReal(X))) ≤ abs(complexIm(ρ)) by
      rw [imX, absZero]
      exact abs.nonnegative at complexIm(ρ)
    have atξ := zeroFree with hξ
    exact atξ with point, reLe, imLe
  -- Nor at ρ.
  have twistsAtρ : ∀ ξ ∈ dirichletCharacters(M),
      entireL(M * d, quadTwist(M, ξ, d), ρ) ≠ ℂ[0] by
    intros ξ hξ
    have reLe : B ≤ complexRe(ρ) by linarith
    have imLe : abs(complexIm(ρ)) ≤ abs(complexIm(ρ)) :=
      realLe.reflexive at abs(complexIm(ρ))
    have atξ := zeroFree with hξ
    exact atξ with hρ, reLe, imLe
  exact primeError.landau at d, M, B, ρ, χ with dPrime, seven, coprime,
    positive, bPositive, eventuallyLe, realTwists, hρ, right, twistsAtρ,
    character

end OneSidedCriterion
