-- The Laplace transform of v ↦ R_M(e^v): the sums Σ_{ν ≤ e^v} as the
-- L-series of λ through the substitution x = e^v, the polynomial parts as
-- ∫ t^k e^(−s t) dt, and Σ_ξ L̃′/L̃ as the L-series of −φ(M) λ.
-- Source: grh-compact/src/New/Endgame/PrimeError.lean (isPolar_primeError).
-- Part of: One-sided bound for non-split primes gives a zero-free
-- half-plane (GRH.Proof.Endgame.OneSidedCriterion).
-- Part of the GRH blueprint (layer 5, the argument).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Proof.Endgame.PolarLaplace
import GRH.Proof.Endgame.PolarReal
import GRH.Measure.ChangeOfVariables

section PolarLaplace
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Section: Graph values
theorem pip2LaplaceIntegrand.apply (E s T : Set)
  requires hT : T ∈ ℝ
  shows laplaceIntegrand(E, s)(T) =
    ℂ[complexOfReal(E(T)) * complexExp(ℂ[(1 - s) * complexOfReal(T)])]
proof
  have shape : ∀ p ∈ laplaceIntegrand(E, s), ∃ a ∈ ℝ, ∃ b, p = (a, b) by
    intros p hp
    simp [laplaceIntegrand] at hp
    obtain ⟨m, mIn, eq⟩ := hp
    rw ← eq
    exact ⟨m, mIn, ℂ[complexOfReal(E(m)) *
      complexExp(ℂ[(1 - s) * complexOfReal(m)])], rfl⟩
  have total : ∀ a ∈ ℝ, ∃ b, (a, b) ∈ laplaceIntegrand(E, s) by
    intros a aIn
    refine ⟨ℂ[complexOfReal(E(a)) * complexExp(ℂ[(1 - s) *
      complexOfReal(a)])], ?_⟩
    simp [laplaceIntegrand]
  have functional : ∀ a, ∀ b, ∀ c, (a, b) ∈ laplaceIntegrand(E, s) →
      (a, c) ∈ laplaceIntegrand(E, s) → b = c by
    intros a b c ab ac
    simp [laplaceIntegrand] at ab
    simp [laplaceIntegrand] at ac
    obtain ⟨m, _, abEq⟩ := ab
    obtain ⟨k, _, acEq⟩ := ac
    obtain ⟨ma, mb⟩ := orderedPair.injective with abEq
    obtain ⟨ka, kc⟩ := orderedPair.injective with acEq
    cc
  have mapped : (T, ℂ[complexOfReal(E(T)) * complexExp(ℂ[(1 - s) *
      complexOfReal(T)])]) ∈ laplaceIntegrand(E, s) by
    simp [laplaceIntegrand]
  exact coefficientGraph.apply with shape, total, functional, hT, mapped

theorem pip2DerivativeIntegrand.apply (g f e U T : Set)
  requires hT : T ∈ U
  shows derivativeIntegrand(g, f, e, U)(T) =
    ℂ[complexOfReal(abs(e(T))) * g(f(T))]
proof
  have shape : ∀ p ∈ derivativeIntegrand(g, f, e, U), ∃ a ∈ U, ∃ b,
      p = (a, b) by
    intros p hp
    simp [derivativeIntegrand] at hp
    obtain ⟨m, mIn, eq⟩ := hp
    rw ← eq
    exact ⟨m, mIn, ℂ[complexOfReal(abs(e(m))) * g(f(m))], rfl⟩
  have total : ∀ a ∈ U, ∃ b, (a, b) ∈ derivativeIntegrand(g, f, e, U) by
    intros a aIn
    refine ⟨ℂ[complexOfReal(abs(e(a))) * g(f(a))], ?_⟩
    simp [derivativeIntegrand]
  have functional : ∀ a, ∀ b, ∀ c, (a, b) ∈ derivativeIntegrand(g, f, e, U) →
      (a, c) ∈ derivativeIntegrand(g, f, e, U) → b = c by
    intros a b c ab ac
    simp [derivativeIntegrand] at ab
    simp [derivativeIntegrand] at ac
    obtain ⟨m, _, abEq⟩ := ab
    obtain ⟨k, _, acEq⟩ := ac
    obtain ⟨ma, mb⟩ := orderedPair.injective with abEq
    obtain ⟨ka, kc⟩ := orderedPair.injective with acEq
    cc
  have mapped : (T, ℂ[complexOfReal(abs(e(T))) * g(f(T))]) ∈
      derivativeIntegrand(g, f, e, U) by
    simp [derivativeIntegrand]
  exact coefficientGraph.apply with shape, total, functional, hT, mapped

-- Section: The substitution x = e^v
-- For g vanishing on x ≤ 1: ∫_{(0,∞)} L = ∫_{(1,∞)} g when
-- L(v) = e^v g(e^v).
theorem pip2Integral.exp_chain (g L : Set)
  requires vanish : ∀ X ∈ ℝ, X ≤ (1:R) → g(X) = ℂ[0]
  requires agree : ∀ T ∈ ℝ,
    L(T) = ℂ[complexOfReal(realExp(T)) * g(realExp(T))]
  shows complexSetIntegral(realMeasurableSpace, realVolume, L,
      realIoi(realZero)) =
    complexSetIntegral(realMeasurableSpace, realVolume, g, realIoi(R[1]))
proof
  have measure := realVolume.measure
  have zeroR : R[0] ∈ ℝ by typecheck
  have oneR : R[1] ∈ ℝ by typecheck
  have setZero := (MeasurableSet.real_intervals at R[0], R[0]).left
  have setOne := (MeasurableSet.real_intervals at R[1], R[1]).left
  have offOne : ∀ x ∈ MeasurableSpace.carrier(realMeasurableSpace) ∖
      realIoi(R[1]), g(x) = complexZero by
    intros x hx
    rw realMeasurableSpace.carrier at hx
    simp [realIoi] at hx
    obtain ⟨xIn, notAbove⟩ := hx
    have xReal : Real(x) by typecheck
    have below : x ≤ (1:R) by
      by_contra above
      have lt := realLess.of_not_le with above
      apply notAbove
      exact ⟨xIn, lt⟩
    exact vanish with x, xIn, below
  have offZero : ∀ x ∈ MeasurableSpace.carrier(realMeasurableSpace) ∖
      realIoi(R[0]), g(x) = complexZero by
    intros x hx
    rw realMeasurableSpace.carrier at hx
    simp [realIoi] at hx
    obtain ⟨xIn, notAbove⟩ := hx
    have xReal : Real(x) by typecheck
    have below : x ≤ (1:R) by
      by_contra above
      have lt := realLess.of_not_le with above
      have pos : R[0] < x by linarith
      apply notAbove
      exact ⟨xIn, pos⟩
    exact vanish with x, xIn, below
  have dVanish : ∀ x ∈ MeasurableSpace.carrier(realMeasurableSpace) ∖
      realIoi(R[0]), derivativeIntegrand(g, realExp, realExp, ℝ)(x) =
        complexZero by
    intros x hx
    rw realMeasurableSpace.carrier at hx
    simp [realIoi] at hx
    obtain ⟨xIn, notAbove⟩ := hx
    have xReal : Real(x) by typecheck
    have below : x ≤ R[0] by
      by_contra above
      have lt := realLess.of_not_le with above
      apply notAbove
      exact ⟨xIn, lt⟩
    have expLe := (realExp.le_iff at x, R[0]).backward with below
    rw realExp.zero at expLe
    have expIn : realExp(x) ∈ ℝ by typecheck
    have zero := vanish with realExp(x), expIn, expLe
    rw [(pip2DerivativeIntegrand.apply at g, realExp, realExp, ℝ, x with xIn),
      zero]
    have absC : complexOfReal(abs(realExp(x))) ∈ ℂ by typecheck
    ring
  have e1 := complexSetIntegral.eq_of_vanishing with measure, setOne, offOne
  have e2 := complexSetIntegral.eq_of_vanishing with measure, setZero, offZero
  have e3 := complexSetIntegral.exp_substitution at g
  have e4 := complexSetIntegral.eq_of_vanishing with measure, setZero, dVanish
  have same : ∀ x ∈ MeasurableSpace.carrier(realMeasurableSpace),
      L(x) = derivativeIntegrand(g, realExp, realExp, ℝ)(x) by
    intros x hx
    rw realMeasurableSpace.carrier at hx
    have xReal : Real(x) by typecheck
    have positive := realExp.positive at x
    have nonneg : (0:R) ≤ realExp(x) by linarith
    rw [(agree with x, hx),
      (pip2DerivativeIntegrand.apply at g, realExp, realExp, ℝ, x with hx),
      (abs.of_nonnegative with nonneg)]
  have e5 := complexMeasureIntegral.congr at realMeasurableSpace,
    restrictMeasure(realMeasurableSpace, realVolume, realIoi(R[0])), L,
    derivativeIntegrand(g, realExp, realExp, ℝ) with same
  unfold complexSetIntegral at e1
  unfold complexSetIntegral at e2
  unfold complexSetIntegral at e3
  unfold complexSetIntegral at e4
  unfold complexSetIntegral
  rw [e5, e4, ← e3, e2, ← e1]

-- Section: The coefficients λ(n) and λ(n)/n
defgraph pip2Lambda (d M : Nat) (n ∈ ℕ) : ℝ := lambdaClass(d, M, n)
proof
  have nNat := nat.omega.backward with member
  exact pipLambdaClass.real at d, M, n

defgraph pip2LambdaOver (d M : Nat) (n ∈ ℕ) : ℝ :=
    R[lambdaClass(d, M, n) / realNat(n)]
proof
  have nNat := nat.omega.backward with member
  have lambda := pipLambdaClass.real at d, M, n
  have lambdaT : Real(lambdaClass(d, M, n)) by typecheck
  exact realDiv.real at lambdaClass(d, M, n), realNat(n)

-- λ(1) = 0.
theorem pip2LambdaClass.one (d M : Nat)
  shows lambdaClass(d, M, (1:N)) = (0:R)
proof
  have index : (1:N) ∈ ℕ by typecheck
  have legendre := legendreSign.real at d, integerOfNat((1:N))
  have legendreT : Real(legendreSign(d, integerOfNat((1:N)))) by typecheck
  have zero : residueClass(M, integerOne)((1:N)) = (0:R) by
    rw (residueClass.value at M, integerOne, (1:N) with index)
    by_cases inClass : InResidueClass(M, (1:N), integerOne)
    . rw [(residueClassValue.in_class with inClass), vonMangoldt.one]
    . rw (residueClassValue.not_in_class with inClass)
  unfold lambdaClass
  rw zero
  ring

-- The partial sums of real coefficients, read in ℂ.
theorem pip2Summatory.of_real (a b : Set, N : Nat)
  requires real : ∀ n ∈ ℕ, a(n) ∈ ℝ
  requires sequence : RealSequence(b)
  requires shift : ∀ k ∈ ℕ, a(k + 1) = b(k)
  shows summatory(realCoefficients(a), N) =
    complexOfReal(realPartialSum(b, N))
proof
  induction N
  | zero =>
    unfold summatory
    rw [complexPartialSum.zero, realPartialSum.zero, complexOfReal.zero]
  | succ(k) using ih =>
    have values : FunctionBetween(realCoefficients(a), ℕ, complexCarrier) by
      apply realCoefficients.maps
      intros n hn
      have an := real with n, hn
      typecheck
    have kIn : k ∈ ℕ by typecheck
    have index : k + 1 ∈ ℕ by typecheck
    have term := real with k + 1, index
    have partial := realPartialSum.real at b, k with sequence
    have bk := shift with k, kIn
    unfold summatory at ih
    unfold summatory
    rw [complexPartialSum.succ, ih, (shiftedCoefficients.value with values, kIn),
      (realCoefficients.eval with index), bk, realPartialSum.succ]
    have bReal : b(k) ∈ ℝ by
      rw ← bk
      exact term
    have bT : Real(b(k)) by typecheck
    have pT : Real(realPartialSum(b, k)) by typecheck
    have same : realAddValue(realPartialSum(b, k), b(k)) =
        R[realPartialSum(b, k) + b(k)] by linarith
    rw [same, complexOfReal.add]

-- ⌊x⌋ = 0 for x < 1.
theorem pip2RealFloor.below_one (X : Real)
  requires below : X < (1:R)
  shows realFloor(X) = (0:N)
proof
  by_cases nonneg : (0:R) ≤ X
  . have lower : realNat((0:N)) ≤ X by
      rw realNat.zero
      exact nonneg
    have upper : X < R[realNat((0:N)) + 1] by
      rw realNat.zero
      linarith
    exact realFloor.eq_of_bounds with nonneg, lower, upper
  . have negative := realLess.of_not_le with nonneg
    have empty : realFloor.candidates(X) = ∅ by
      ext n
      constructor
      . intro member
        obtain ⟨nMember, lower, upper⟩ := member
        have zeroLe := realNat.zero_le at n with *
        exfalso
        linarith
      . intro member
        exfalso
        exact set.empty with member
    unfold realFloor
    rw [empty, union.empty, ← nat.zero]

-- The summation integrand of real coefficients with a(1) = 0 vanishes on
-- x ≤ 1.
theorem pip2SummatoryIntegrand.vanish (a s X : Set)
  requires real : ∀ n ∈ ℕ, a(n) ∈ ℝ
  requires one : a((1:N)) = (0:R)
  requires hs : s ∈ complexCarrier
  requires hX : X ∈ ℝ
  requires below : X ≤ (1:R)
  shows summatoryIntegrand(realCoefficients(a), s)(X) = ℂ[0]
proof
  have values : FunctionBetween(realCoefficients(a), ℕ, complexCarrier) by
    apply realCoefficients.maps
    intros n hn
    have an := real with n, hn
    typecheck
  have xReal : Real(X) by typecheck
  have zeroSum : summatory(realCoefficients(a), realFloor(X)) = ℂ[0] by
    by_cases lt : X < (1:R)
    . rw (pip2RealFloor.below_one with lt)
      unfold summatory
      rw complexPartialSum.zero
    . have equal : X = (1:R) by
        rcases realLess.trichotomy at X, (1:R) with less | same | greater
        . contradiction
        . exact same
        . exfalso
          linarith
      have floor := realFloor.of_natural at (1:N)
      rw realNat.one at floor
      rw [equal, floor]
      unfold summatory
      have zeroIn : (0:N) ∈ ℕ by typecheck
      have oneIndex : (1:N) ∈ ℕ by typecheck
      have first := complexPartialSum.succ at
        shiftedCoefficients(realCoefficients(a)), (0:N)
      rw [first, complexPartialSum.zero,
        (shiftedCoefficients.value with values, zeroIn)]
      have sum : (0:N) + (1:N) = (1:N) by arith
      rw [sum, (realCoefficients.eval with oneIndex), one, complexOfReal.zero]
      ring
  have negative : ℂ[-(s + 1)] ∈ ℂ by typecheck
  have power := realCpow.member at X, ℂ[-(s + 1)] with negative
  rw [(summatoryIntegrand.value with values, hs, hX), zeroSum]
  ring

-- Section: The shifts of the coefficients
theorem pip2LambdaOver.shift (d M : Nat)
  shows ∀ k ∈ ℕ, pip2LambdaOver(d, M)(k + 1) = lambdaSumTerms(d, M, (0:N))(k)
proof
  intros k hk
  have kNat := nat.omega.backward with hk
  have index : k + 1 ∈ ℕ by typecheck
  have same : k + 1 = succ(k) by arith
  have lambda := pipLambdaClass.real at d, M, succ(k)
  have lambdaT : Real(lambdaClass(d, M, succ(k))) by typecheck
  have quotient := realDiv.real at lambdaClass(d, M, succ(k)), realNat(succ(k))
  rw [(pip2LambdaOver.value with index), (pip2LambdaSumTerms.apply at d, M,
    (0:N), k), same, monoidPow.zero]
  ring

theorem pip2Lambda.shift (d M : Nat)
  shows ∀ k ∈ ℕ, pip2Lambda(d, M)(k + 1) = lambdaSumTerms(d, M, (1:N))(k)
proof
  intros k hk
  have kNat := nat.omega.backward with hk
  have index : k + 1 ∈ ℕ by typecheck
  have same : k + 1 = succ(k) by arith
  have lambda := pipLambdaClass.real at d, M, succ(k)
  have lambdaT : Real(lambdaClass(d, M, succ(k))) by typecheck
  have positive := realNat.positive_succ at k
  have nonzero : realNat(succ(k)) ≠ 0 by
    intro equal
    linarith
  have cancel := realInvValue.mul_left at realNat(succ(k)) with nonzero
  have inverseT : Real(realInvValue(realNat(succ(k)))) by typecheck
  rw [(pip2Lambda.value with index), (pip2LambdaSumTerms.apply at d, M,
    (1:N), k), same, realDiv.eq_mul_inv, monoidPow.succ, monoidPow.zero]
  have rearranged : R[R[lambdaClass(d, M, succ(k)) *
      realInvValue(realNat(succ(k)))] * R[realNat(succ(k)) * 1]] =
      R[lambdaClass(d, M, succ(k)) * R[realInvValue(realNat(succ(k))) *
        realNat(succ(k))]] by ring
  rw [rearranged, cancel]
  ring

theorem pip2LambdaOver.real (d M : Nat)
  shows ∀ n ∈ ℕ, pip2LambdaOver(d, M)(n) ∈ ℝ
proof
  intros n hn
  rw (pip2LambdaOver.value with hn)
  exact pip2LambdaOver.closed at d, M, n with hn

theorem pip2Lambda.real (d M : Nat)
  shows ∀ n ∈ ℕ, pip2Lambda(d, M)(n) ∈ ℝ
proof
  intros n hn
  rw (pip2Lambda.value with hn)
  exact pip2Lambda.closed at d, M, n with hn

-- Σ_{k<n} |a(k + 1)| ≤ B n when the shifted coefficients lie in [0, B].
theorem pip2SummatoryAbs.bound (a b : Set, B : Real, n : Nat)
  requires real : ∀ m ∈ ℕ, a(m) ∈ ℝ
  requires sequence : RealSequence(b)
  requires shift : ∀ k ∈ ℕ, a(k + 1) = b(k)
  requires bounds : ∀ k ∈ ℕ, k < n → (0:R) ≤ b(k) ∧ b(k) ≤ B
  shows summatoryAbs(realCoefficients(a), n) ≤ R[B * realNat(n)]
proof
  have values : FunctionBetween(realCoefficients(a), ℕ, complexCarrier) by
    apply realCoefficients.maps
    intros m hm
    have am := real with m, hm
    typecheck
  have absSequence : RealSequence(absCoefficients(realCoefficients(a))) by
    unfold RealSequence
    exact absCoefficients.function with values
  have ones := constantSequence.sequence at (1:R)
  have scaled := (realPartialSum.le_scaled at
    absCoefficients(realCoefficients(a)), constantSequence((1:R)), B, n with
    absSequence, ones)
  have upper : realPartialSum(absCoefficients(realCoefficients(a)), n) ≤
      R[B * realPartialSum(constantSequence((1:R)), n)] by
    apply scaled
    intros k hk below
    have kNat := nat.omega.backward with hk
    have index : k + 1 ∈ ℕ by typecheck
    obtain ⟨nonneg, le⟩ := bounds with k, hk, below
    have bk := shift with k, hk
    have ak := real with k + 1, index
    have bReal : b(k) ∈ ℝ by
      rw ← bk
      exact ak
    have bT : Real(b(k)) by typecheck
    rw [(absCoefficients.value with values, hk), (realCoefficients.eval with
      index), bk, complexAbs.of_real, (abs.of_nonnegative with nonneg),
      (constantSequence.value at (1:R), k)]
    have e : R[B * 1] = B by ring
    rw e
    exact le
  rw (realPartialSum.constant at (1:R), n) at upper
  have nT : Real(realNat(n)) by typecheck
  have e : R[B * R[realNat(n) * 1]] = R[B * realNat(n)] by ring
  rw e at upper
  unfold summatoryAbs
  exact upper

end PolarLaplace
