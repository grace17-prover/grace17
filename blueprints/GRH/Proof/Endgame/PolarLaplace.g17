-- The Laplace transform of v ↦ R_M(e^v): the sums Σ_{ν ≤ e^v} as the
-- L-series of λ through the substitution x = e^v, the polynomial parts as
-- ∫ t^k e^(−s t) dt, and Σ_ξ L̃′/L̃ as the L-series of −φ(M) λ.
-- Source: grh-compact/src/New/Endgame/PrimeError.lean (isPolar_primeError).
-- Part of: One-sided bound for non-split primes gives a zero-free
-- half-plane (GRH.Proof.Endgame.OneSidedCriterion).
-- Part of the GRH blueprint (layer 5, the argument).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Proof.Endgame.PolarLaplace
import GRH.Proof.Endgame.PolarReal
import GRH.Measure.ChangeOfVariables

section PolarLaplace
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Section: Graph values
theorem pip2LaplaceIntegrand.apply (E s T : Set)
  requires hT : T ∈ ℝ
  shows laplaceIntegrand(E, s)(T) =
    ℂ[complexOfReal(E(T)) * complexExp(ℂ[(1 - s) * complexOfReal(T)])]
proof
  have shape : ∀ p ∈ laplaceIntegrand(E, s), ∃ a ∈ ℝ, ∃ b, p = (a, b) by
    intros p hp
    simp [laplaceIntegrand] at hp
    obtain ⟨m, mIn, eq⟩ := hp
    rw ← eq
    exact ⟨m, mIn, ℂ[complexOfReal(E(m)) *
      complexExp(ℂ[(1 - s) * complexOfReal(m)])], rfl⟩
  have total : ∀ a ∈ ℝ, ∃ b, (a, b) ∈ laplaceIntegrand(E, s) by
    intros a aIn
    refine ⟨ℂ[complexOfReal(E(a)) * complexExp(ℂ[(1 - s) *
      complexOfReal(a)])], ?_⟩
    simp [laplaceIntegrand]
  have functional : ∀ a, ∀ b, ∀ c, (a, b) ∈ laplaceIntegrand(E, s) →
      (a, c) ∈ laplaceIntegrand(E, s) → b = c by
    intros a b c ab ac
    simp [laplaceIntegrand] at ab
    simp [laplaceIntegrand] at ac
    obtain ⟨m, _, abEq⟩ := ab
    obtain ⟨k, _, acEq⟩ := ac
    obtain ⟨ma, mb⟩ := orderedPair.injective with abEq
    obtain ⟨ka, kc⟩ := orderedPair.injective with acEq
    cc
  have mapped : (T, ℂ[complexOfReal(E(T)) * complexExp(ℂ[(1 - s) *
      complexOfReal(T)])]) ∈ laplaceIntegrand(E, s) by
    simp [laplaceIntegrand]
  exact coefficientGraph.apply with shape, total, functional, hT, mapped

theorem pip2DerivativeIntegrand.apply (g f e U T : Set)
  requires hT : T ∈ U
  shows derivativeIntegrand(g, f, e, U)(T) =
    ℂ[complexOfReal(abs(e(T))) * g(f(T))]
proof
  have shape : ∀ p ∈ derivativeIntegrand(g, f, e, U), ∃ a ∈ U, ∃ b,
      p = (a, b) by
    intros p hp
    simp [derivativeIntegrand] at hp
    obtain ⟨m, mIn, eq⟩ := hp
    rw ← eq
    exact ⟨m, mIn, ℂ[complexOfReal(abs(e(m))) * g(f(m))], rfl⟩
  have total : ∀ a ∈ U, ∃ b, (a, b) ∈ derivativeIntegrand(g, f, e, U) by
    intros a aIn
    refine ⟨ℂ[complexOfReal(abs(e(a))) * g(f(a))], ?_⟩
    simp [derivativeIntegrand]
  have functional : ∀ a, ∀ b, ∀ c, (a, b) ∈ derivativeIntegrand(g, f, e, U) →
      (a, c) ∈ derivativeIntegrand(g, f, e, U) → b = c by
    intros a b c ab ac
    simp [derivativeIntegrand] at ab
    simp [derivativeIntegrand] at ac
    obtain ⟨m, _, abEq⟩ := ab
    obtain ⟨k, _, acEq⟩ := ac
    obtain ⟨ma, mb⟩ := orderedPair.injective with abEq
    obtain ⟨ka, kc⟩ := orderedPair.injective with acEq
    cc
  have mapped : (T, ℂ[complexOfReal(abs(e(T))) * g(f(T))]) ∈
      derivativeIntegrand(g, f, e, U) by
    simp [derivativeIntegrand]
  exact coefficientGraph.apply with shape, total, functional, hT, mapped

-- Section: The substitution x = e^v
-- For g vanishing on x ≤ 1: ∫_{(0,∞)} L = ∫_{(1,∞)} g when
-- L(v) = e^v g(e^v).
theorem pip2Integral.exp_chain (g L : Set)
  requires vanish : ∀ X ∈ ℝ, X ≤ (1:R) → g(X) = ℂ[0]
  requires agree : ∀ T ∈ ℝ,
    L(T) = ℂ[complexOfReal(realExp(T)) * g(realExp(T))]
  shows complexSetIntegral(realMeasurableSpace, realVolume, L,
      realIoi(realZero)) =
    complexSetIntegral(realMeasurableSpace, realVolume, g, realIoi(R[1]))
proof
  have measure := realVolume.measure
  have zeroR : R[0] ∈ ℝ by typecheck
  have oneR : R[1] ∈ ℝ by typecheck
  have setZero := (MeasurableSet.real_intervals at R[0], R[0]).left
  have setOne := (MeasurableSet.real_intervals at R[1], R[1]).left
  have offOne : ∀ x ∈ MeasurableSpace.carrier(realMeasurableSpace) ∖
      realIoi(R[1]), g(x) = complexZero by
    intros x hx
    rw realMeasurableSpace.carrier at hx
    simp [realIoi] at hx
    obtain ⟨xIn, notAbove⟩ := hx
    have xReal : Real(x) by typecheck
    have below : x ≤ (1:R) by
      by_contra above
      have lt := realLess.of_not_le with above
      apply notAbove
      exact ⟨xIn, lt⟩
    exact vanish with x, xIn, below
  have offZero : ∀ x ∈ MeasurableSpace.carrier(realMeasurableSpace) ∖
      realIoi(R[0]), g(x) = complexZero by
    intros x hx
    rw realMeasurableSpace.carrier at hx
    simp [realIoi] at hx
    obtain ⟨xIn, notAbove⟩ := hx
    have xReal : Real(x) by typecheck
    have below : x ≤ (1:R) by
      by_contra above
      have lt := realLess.of_not_le with above
      have pos : R[0] < x by linarith
      apply notAbove
      exact ⟨xIn, pos⟩
    exact vanish with x, xIn, below
  have dVanish : ∀ x ∈ MeasurableSpace.carrier(realMeasurableSpace) ∖
      realIoi(R[0]), derivativeIntegrand(g, realExp, realExp, ℝ)(x) =
        complexZero by
    intros x hx
    rw realMeasurableSpace.carrier at hx
    simp [realIoi] at hx
    obtain ⟨xIn, notAbove⟩ := hx
    have xReal : Real(x) by typecheck
    have below : x ≤ R[0] by
      by_contra above
      have lt := realLess.of_not_le with above
      apply notAbove
      exact ⟨xIn, lt⟩
    have expLe := (realExp.le_iff at x, R[0]).backward with below
    rw realExp.zero at expLe
    have expIn : realExp(x) ∈ ℝ by typecheck
    have zero := vanish with realExp(x), expIn, expLe
    rw [(pip2DerivativeIntegrand.apply at g, realExp, realExp, ℝ, x with xIn),
      zero]
    have absC : complexOfReal(abs(realExp(x))) ∈ ℂ by typecheck
    ring
  have e1 := complexSetIntegral.eq_of_vanishing with measure, setOne, offOne
  have e2 := complexSetIntegral.eq_of_vanishing with measure, setZero, offZero
  have e3 := complexSetIntegral.exp_substitution at g
  have e4 := complexSetIntegral.eq_of_vanishing with measure, setZero, dVanish
  have same : ∀ x ∈ MeasurableSpace.carrier(realMeasurableSpace),
      L(x) = derivativeIntegrand(g, realExp, realExp, ℝ)(x) by
    intros x hx
    rw realMeasurableSpace.carrier at hx
    have xReal : Real(x) by typecheck
    have positive := realExp.positive at x
    have nonneg : (0:R) ≤ realExp(x) by linarith
    rw [(agree with x, hx),
      (pip2DerivativeIntegrand.apply at g, realExp, realExp, ℝ, x with hx),
      (abs.of_nonnegative with nonneg)]
  have e5 := complexMeasureIntegral.congr at realMeasurableSpace,
    restrictMeasure(realMeasurableSpace, realVolume, realIoi(R[0])), L,
    derivativeIntegrand(g, realExp, realExp, ℝ) with same
  unfold complexSetIntegral at e1
  unfold complexSetIntegral at e2
  unfold complexSetIntegral at e3
  unfold complexSetIntegral at e4
  unfold complexSetIntegral
  rw [e5, e4, ← e3, e2, ← e1]

-- Section: The coefficients λ(n) and λ(n)/n
defgraph pip2Lambda (d M : Nat) (n ∈ ℕ) : ℝ := lambdaClass(d, M, n)
proof
  have nNat := nat.omega.backward with member
  exact pipLambdaClass.real at d, M, n

defgraph pip2LambdaOver (d M : Nat) (n ∈ ℕ) : ℝ :=
    R[lambdaClass(d, M, n) / realNat(n)]
proof
  have nNat := nat.omega.backward with member
  have lambda := pipLambdaClass.real at d, M, n
  have lambdaT : Real(lambdaClass(d, M, n)) by typecheck
  exact realDiv.real at lambdaClass(d, M, n), realNat(n)

-- λ(1) = 0.
theorem pip2LambdaClass.one (d M : Nat)
  shows lambdaClass(d, M, (1:N)) = (0:R)
proof
  have index : (1:N) ∈ ℕ by typecheck
  have legendre := legendreSign.real at d, integerOfNat((1:N))
  have legendreT : Real(legendreSign(d, integerOfNat((1:N)))) by typecheck
  have zero : residueClass(M, integerOne)((1:N)) = (0:R) by
    rw (residueClass.value at M, integerOne, (1:N) with index)
    by_cases inClass : InResidueClass(M, (1:N), integerOne)
    . rw [(residueClassValue.in_class with inClass), vonMangoldt.one]
    . rw (residueClassValue.not_in_class with inClass)
  unfold lambdaClass
  rw zero
  ring

-- The partial sums of real coefficients, read in ℂ.
theorem pip2Summatory.of_real (a b : Set, N : Nat)
  requires real : ∀ n ∈ ℕ, a(n) ∈ ℝ
  requires sequence : RealSequence(b)
  requires shift : ∀ k ∈ ℕ, a(k + 1) = b(k)
  shows summatory(realCoefficients(a), N) =
    complexOfReal(realPartialSum(b, N))
proof
  induction N
  | zero =>
    unfold summatory
    rw [complexPartialSum.zero, realPartialSum.zero, complexOfReal.zero]
  | succ(k) using ih =>
    have values : FunctionBetween(realCoefficients(a), ℕ, complexCarrier) by
      apply realCoefficients.maps
      intros n hn
      have an := real with n, hn
      typecheck
    have kIn : k ∈ ℕ by typecheck
    have index : k + 1 ∈ ℕ by typecheck
    have term := real with k + 1, index
    have partial := realPartialSum.real at b, k with sequence
    have bk := shift with k, kIn
    unfold summatory at ih
    unfold summatory
    rw [complexPartialSum.succ, ih, (shiftedCoefficients.value with values, kIn),
      (realCoefficients.eval with index), bk, realPartialSum.succ]
    have bReal : b(k) ∈ ℝ by
      rw ← bk
      exact term
    have bT : Real(b(k)) by typecheck
    have pT : Real(realPartialSum(b, k)) by typecheck
    have same : realAddValue(realPartialSum(b, k), b(k)) =
        R[realPartialSum(b, k) + b(k)] by linarith
    rw [same, complexOfReal.add]

-- ⌊x⌋ = 0 for x < 1.
theorem pip2RealFloor.below_one (X : Real)
  requires below : X < (1:R)
  shows realFloor(X) = (0:N)
proof
  by_cases nonneg : (0:R) ≤ X
  . have lower : realNat((0:N)) ≤ X by
      rw realNat.zero
      exact nonneg
    have upper : X < R[realNat((0:N)) + 1] by
      rw realNat.zero
      linarith
    exact realFloor.eq_of_bounds with nonneg, lower, upper
  . have negative := realLess.of_not_le with nonneg
    have empty : realFloor.candidates(X) = ∅ by
      ext n
      constructor
      . intro member
        obtain ⟨nMember, lower, upper⟩ := member
        have zeroLe := realNat.zero_le at n with *
        exfalso
        linarith
      . intro member
        exfalso
        exact set.empty with member
    unfold realFloor
    rw [empty, union.empty, ← nat.zero]

-- The summation integrand of real coefficients with a(1) = 0 vanishes on
-- x ≤ 1.
theorem pip2SummatoryIntegrand.vanish (a s X : Set)
  requires real : ∀ n ∈ ℕ, a(n) ∈ ℝ
  requires one : a((1:N)) = (0:R)
  requires hs : s ∈ complexCarrier
  requires hX : X ∈ ℝ
  requires below : X ≤ (1:R)
  shows summatoryIntegrand(realCoefficients(a), s)(X) = ℂ[0]
proof
  have values : FunctionBetween(realCoefficients(a), ℕ, complexCarrier) by
    apply realCoefficients.maps
    intros n hn
    have an := real with n, hn
    typecheck
  have xReal : Real(X) by typecheck
  have zeroSum : summatory(realCoefficients(a), realFloor(X)) = ℂ[0] by
    by_cases lt : X < (1:R)
    . rw (pip2RealFloor.below_one with lt)
      unfold summatory
      rw complexPartialSum.zero
    . have equal : X = (1:R) by
        rcases realLess.trichotomy at X, (1:R) with less | same | greater
        . contradiction
        . exact same
        . exfalso
          linarith
      have floor := realFloor.of_natural at (1:N)
      rw realNat.one at floor
      rw [equal, floor]
      unfold summatory
      have zeroIn : (0:N) ∈ ℕ by typecheck
      have oneIndex : (1:N) ∈ ℕ by typecheck
      have first := complexPartialSum.succ at
        shiftedCoefficients(realCoefficients(a)), (0:N)
      rw [first, complexPartialSum.zero,
        (shiftedCoefficients.value with values, zeroIn)]
      have sum : (0:N) + (1:N) = (1:N) by arith
      rw [sum, (realCoefficients.eval with oneIndex), one, complexOfReal.zero]
      ring
  have negative : ℂ[-(s + 1)] ∈ ℂ by typecheck
  have power := realCpow.member at X, ℂ[-(s + 1)] with negative
  rw [(summatoryIntegrand.value with values, hs, hX), zeroSum]
  ring

-- Section: The shifts of the coefficients
theorem pip2LambdaOver.shift (d M : Nat)
  shows ∀ k ∈ ℕ, pip2LambdaOver(d, M)(k + 1) = lambdaSumTerms(d, M, (0:N))(k)
proof
  intros k hk
  have kNat := nat.omega.backward with hk
  have index : k + 1 ∈ ℕ by typecheck
  have same : k + 1 = succ(k) by arith
  have lambda := pipLambdaClass.real at d, M, succ(k)
  have lambdaT : Real(lambdaClass(d, M, succ(k))) by typecheck
  have quotient := realDiv.real at lambdaClass(d, M, succ(k)), realNat(succ(k))
  rw [(pip2LambdaOver.value with index), (pip2LambdaSumTerms.apply at d, M,
    (0:N), k), same, monoidPow.zero]
  ring

theorem pip2Lambda.shift (d M : Nat)
  shows ∀ k ∈ ℕ, pip2Lambda(d, M)(k + 1) = lambdaSumTerms(d, M, (1:N))(k)
proof
  intros k hk
  have kNat := nat.omega.backward with hk
  have index : k + 1 ∈ ℕ by typecheck
  have same : k + 1 = succ(k) by arith
  have lambda := pipLambdaClass.real at d, M, succ(k)
  have lambdaT : Real(lambdaClass(d, M, succ(k))) by typecheck
  have positive := realNat.positive_succ at k
  have nonzero : realNat(succ(k)) ≠ 0 by
    intro equal
    linarith
  have cancel := realInvValue.mul_left at realNat(succ(k)) with nonzero
  have inverseT : Real(realInvValue(realNat(succ(k)))) by typecheck
  rw [(pip2Lambda.value with index), (pip2LambdaSumTerms.apply at d, M,
    (1:N), k), same, realDiv.eq_mul_inv, monoidPow.succ, monoidPow.zero]
  have rearranged : R[R[lambdaClass(d, M, succ(k)) *
      realInvValue(realNat(succ(k)))] * R[realNat(succ(k)) * 1]] =
      R[lambdaClass(d, M, succ(k)) * R[realInvValue(realNat(succ(k))) *
        realNat(succ(k))]] by ring
  rw [rearranged, cancel]
  ring

theorem pip2LambdaOver.real (d M : Nat)
  shows ∀ n ∈ ℕ, pip2LambdaOver(d, M)(n) ∈ ℝ
proof
  intros n hn
  rw (pip2LambdaOver.value with hn)
  exact pip2LambdaOver.closed at d, M, n with hn

theorem pip2Lambda.real (d M : Nat)
  shows ∀ n ∈ ℕ, pip2Lambda(d, M)(n) ∈ ℝ
proof
  intros n hn
  rw (pip2Lambda.value with hn)
  exact pip2Lambda.closed at d, M, n with hn

-- Σ_{k<n} |a(k + 1)| ≤ B n when the shifted coefficients lie in [0, B].
theorem pip2SummatoryAbs.bound (a b : Set, B : Real, n : Nat)
  requires real : ∀ m ∈ ℕ, a(m) ∈ ℝ
  requires sequence : RealSequence(b)
  requires shift : ∀ k ∈ ℕ, a(k + 1) = b(k)
  requires bounds : ∀ k ∈ ℕ, k < n → (0:R) ≤ b(k) ∧ b(k) ≤ B
  shows summatoryAbs(realCoefficients(a), n) ≤ R[B * realNat(n)]
proof
  have values : FunctionBetween(realCoefficients(a), ℕ, complexCarrier) by
    apply realCoefficients.maps
    intros m hm
    have am := real with m, hm
    typecheck
  have absSequence : RealSequence(absCoefficients(realCoefficients(a))) by
    unfold RealSequence
    exact absCoefficients.function with values
  have ones := constantSequence.sequence at (1:R)
  have scaled := (realPartialSum.le_scaled at
    absCoefficients(realCoefficients(a)), constantSequence((1:R)), B, n with
    absSequence, ones)
  have upper : realPartialSum(absCoefficients(realCoefficients(a)), n) ≤
      R[B * realPartialSum(constantSequence((1:R)), n)] by
    apply scaled
    intros k hk below
    have kNat := nat.omega.backward with hk
    have index : k + 1 ∈ ℕ by typecheck
    obtain ⟨nonneg, le⟩ := bounds with k, hk, below
    have bk := shift with k, hk
    have ak := real with k + 1, index
    have bReal : b(k) ∈ ℝ by
      rw ← bk
      exact ak
    have bT : Real(b(k)) by typecheck
    rw [(absCoefficients.value with values, hk), (realCoefficients.eval with
      index), bk, complexAbs.of_real, (abs.of_nonnegative with nonneg),
      (constantSequence.value at (1:R), k)]
    have e : R[B * 1] = B by ring
    rw e
    exact le
  rw (realPartialSum.constant at (1:R), n) at upper
  have nT : Real(realNat(n)) by typecheck
  have e : R[B * R[realNat(n) * 1]] = R[B * realNat(n)] by ring
  rw e at upper
  unfold summatoryAbs
  exact upper

-- Section: The step parts as substituted summation integrands
-- ⌊e^t⌋₊ = ⌊e^t⌋.
theorem pip2NatFloor.exp (T : Real)
  shows natFloor(realExp(T)) = realFloor(realExp(T))
proof
  have positive := realExp.positive at T
  rcases pipNatFloor.value at realExp(T) with ⟨_, equal⟩ | ⟨negative, _⟩
  . exact equal
  . exfalso
    linarith

-- e^(w log e^t) = e^(w t).
theorem pip2RealCpow.exp (T w : Set)
  requires hT : T ∈ ℝ
  shows realCpow(realExp(T), w) = complexExp(ℂ[w * complexOfReal(T)])
proof
  have tReal : Real(T) by typecheck
  unfold realCpow
  rw realLog.of_exp

theorem pip2Step.agree (d M : Nat, s T : Set)
  requires hs : s ∈ complexCarrier
  requires hT : T ∈ ℝ
  shows laplaceIntegrand(pip2Step(d, M, (0:N)), s)(T) =
    ℂ[complexOfReal(realExp(T)) * summatoryIntegrand(realCoefficients(
      pip2LambdaOver(d, M)), ℂ[s - 1])(realExp(T))]
proof
  have tReal : Real(T) by typecheck
  have real := pip2LambdaOver.real at d, M
  have values : FunctionBetween(realCoefficients(pip2LambdaOver(d, M)), ℕ,
      complexCarrier) by
    apply realCoefficients.maps
    intros m hm
    have am := real with m, hm
    typecheck
  have hs1 : ℂ[s - 1] ∈ ℂ by typecheck
  have expIn : realExp(T) ∈ ℝ by typecheck
  have floorNatural := realFloor.natural_total at realExp(T)
  have sequence := pipLambdaSumTerms.sequence at d, M, (0:N)
  have shift := pip2LambdaOver.shift at d, M
  have sumEq := pip2Summatory.of_real at pip2LambdaOver(d, M),
    lambdaSumTerms(d, M, (0:N)), realFloor(realExp(T)) with real, sequence,
    shift
  have partial := realPartialSum.real at lambdaSumTerms(d, M, (0:N)),
    realFloor(realExp(T)) with sequence
  rw [(pip2LaplaceIntegrand.apply with hT), (pip2Step.value with hT),
    pip2NatFloor.exp, (summatoryIntegrand.value with values, hs1, expIn),
    sumEq, (pip2RealCpow.exp with hT), ← complexExp.of_real]
  have tC : complexOfReal(T) ∈ ℂ by typecheck
  have exponent : ℂ[ℂ[-(ℂ[s - 1] + 1)] * complexOfReal(T)] ∈ ℂ by typecheck
  have added := complexExp.add with tC, exponent
  have argument : ℂ[complexOfReal(T) + ℂ[-(ℂ[s - 1] + 1)] *
      complexOfReal(T)] = ℂ[(1 - s) * complexOfReal(T)] by ring
  rw argument at added
  rw added
  have pC : complexOfReal(realPartialSum(lambdaSumTerms(d, M, (0:N)),
    realFloor(realExp(T)))) ∈ ℂ by typecheck
  have e1 := complexExp.member with tC
  have e2 := complexExp.member with exponent
  ring

theorem pip2Product.agree (d M : Nat, s T : Set)
  requires hs : s ∈ complexCarrier
  requires hT : T ∈ ℝ
  shows laplaceIntegrand(pip2Product(d, M), s)(T) =
    ℂ[complexOfReal(realExp(T)) * summatoryIntegrand(realCoefficients(
      pip2Lambda(d, M)), s)(realExp(T))]
proof
  have tReal : Real(T) by typecheck
  have real := pip2Lambda.real at d, M
  have values : FunctionBetween(realCoefficients(pip2Lambda(d, M)), ℕ,
      complexCarrier) by
    apply realCoefficients.maps
    intros m hm
    have am := real with m, hm
    typecheck
  have expIn : realExp(T) ∈ ℝ by typecheck
  have floorNatural := realFloor.natural_total at realExp(T)
  have sequence := pipLambdaSumTerms.sequence at d, M, (1:N)
  have shift := pip2Lambda.shift at d, M
  have sumEq := pip2Summatory.of_real at pip2Lambda(d, M),
    lambdaSumTerms(d, M, (1:N)), realFloor(realExp(T)) with real, sequence,
    shift
  have partial := realPartialSum.real at lambdaSumTerms(d, M, (1:N)),
    realFloor(realExp(T)) with sequence
  have partialT : Real(realPartialSum(lambdaSumTerms(d, M, (1:N)),
    realFloor(realExp(T)))) by typecheck
  have inverseExp : realInvValue(realExp(T)) = realExp(R[-T]) by
    rw [realExp.neg, realDiv.eq_mul_inv]
    have inverseT : Real(realInvValue(realExp(T))) by typecheck
    ring
  rw [(pip2LaplaceIntegrand.apply with hT), (pip2Product.value with hT),
    (pip2Step.value with hT), (pip2InvExp.value with hT), pip2NatFloor.exp,
    (summatoryIntegrand.value with values, hs, expIn), sumEq,
    (pip2RealCpow.exp with hT), inverseExp, complexOfReal.mul,
    ← complexExp.of_real, ← complexExp.of_real, complexOfReal.neg]
  have tC : complexOfReal(T) ∈ ℂ by typecheck
  have negT : ℂ[-complexOfReal(T)] ∈ ℂ by typecheck
  have first : ℂ[(1 - s) * complexOfReal(T)] ∈ ℂ by typecheck
  have second : ℂ[ℂ[-(s + 1)] * complexOfReal(T)] ∈ ℂ by typecheck
  have h1 := complexExp.add with negT, first
  have h2 := complexExp.add with tC, second
  have argument : ℂ[complexOfReal(T) + ℂ[-(s + 1)] * complexOfReal(T)] =
      ℂ[-complexOfReal(T) + (1 - s) * complexOfReal(T)] by ring
  rw argument at h2
  have pC : complexOfReal(realPartialSum(lambdaSumTerms(d, M, (1:N)),
    realFloor(realExp(T)))) ∈ ℂ by typecheck
  have e1 := complexExp.member with negT
  have e2 := complexExp.member with first
  have e3 := complexExp.member with tC
  have e4 := complexExp.member with second
  linear_combination complexOfReal(realPartialSum(lambdaSumTerms(d, M, (1:N)),
    realFloor(realExp(T)))) * h2 - complexOfReal(realPartialSum(
    lambdaSumTerms(d, M, (1:N)), realFloor(realExp(T)))) * h1

-- Section: The Laplace transforms of the step parts
-- re(s − 1) = re s − 1.
theorem pip2ComplexRe.sub_one (s : Set)
  requires hs : s ∈ complexCarrier
  shows complexRe(ℂ[s - 1]) = R[complexRe(s) - 1]
proof
  have minusOne : R[-1] ∈ ℝ by typecheck
  have minusOneC : complexOfReal(R[-1]) ∈ ℂ by typecheck
  have same : ℂ[s - 1] = ℂ[s + complexOfReal(R[-1])] by
    rw [complexOfReal.neg, complexOfReal.one]
    ring
  rw [same, (complexRe.add with hs, minusOneC), complexOfReal.re]
  have reT := complexRe.real with hs
  have reR : Real(complexRe(s)) by typecheck
  ring

-- ∫₀^∞ (Σ_{ν ≤ e^v} λ(ν)/ν) e^((1−s)v) dv = L(λ/n, s − 1)/(s − 1).
theorem pip2Step.laplace (d M : Nat, s : Set)
  requires prime : Prime(d)
  requires hs : s ∈ complexCarrier
  requires right : (2:R) < complexRe(s)
  shows laplaceTransform(pip2Step(d, M, (0:N)), s) =
    complexDiv(LSeries(realCoefficients(pip2LambdaOver(d, M)), ℂ[s - 1]),
      ℂ[s - 1])
proof
  have real := pip2LambdaOver.real at d, M
  have values : FunctionBetween(realCoefficients(pip2LambdaOver(d, M)), ℕ,
      complexCarrier) by
    apply realCoefficients.maps
    intros m hm
    have am := real with m, hm
    typecheck
  have hs1 : ℂ[s - 1] ∈ ℂ by typecheck
  have oneIndex : (1:N) ∈ ℕ by typecheck
  have one : pip2LambdaOver(d, M)((1:N)) = (0:R) by
    rw [(pip2LambdaOver.value with oneIndex), pip2LambdaClass.one,
      realDiv.eq_mul_inv]
    have inverseT : Real(realInvValue(realNat((1:N)))) by typecheck
    ring
  have vanish : ∀ X ∈ ℝ, X ≤ (1:R) → summatoryIntegrand(realCoefficients(
      pip2LambdaOver(d, M)), ℂ[s - 1])(X) = ℂ[0] by
    intros X hX below
    exact pip2SummatoryIntegrand.vanish with real, one, hs1, hX, below
  have agree : ∀ T ∈ ℝ, laplaceIntegrand(pip2Step(d, M, (0:N)), s)(T) =
      ℂ[complexOfReal(realExp(T)) * summatoryIntegrand(realCoefficients(
        pip2LambdaOver(d, M)), ℂ[s - 1])(realExp(T))] by
    intros T hT
    exact pip2Step.agree with hs, hT
  have chain := pip2Integral.exp_chain with vanish, agree
  have reShift := pip2ComplexRe.sub_one with hs
  have halfPlane : R[1] < complexRe(ℂ[s - 1]) by
    rw reShift
    linarith
  have nonneg : R[0] ≤ R[1] by linarith
  have sequence := pipLambdaSumTerms.sequence at d, M, (0:N)
  have shift := pip2LambdaOver.shift at d, M
  have twoR : R[2] ∈ ℝ by typecheck
  have oneN : (1:N) ∈ ℕ by typecheck
  have bound : ∃ C ∈ ℝ, ∃ K ∈ ℕ, ∀ n ∈ ℕ, K ≤ n →
      summatoryAbs(realCoefficients(pip2LambdaOver(d, M)), n) ≤
        R[C * realRpow(realNat(n), R[1])] by
    refine ⟨R[2], twoR, (1:N), oneN, ?_⟩
    intros n hn large
    have nNat := nat.omega.backward with hn
    have positiveN : R[0] < realNat(n) by
      have le := realNat.le_of_natural_le with large
      rw realNat.one at le
      linarith
    rw (realRpow.one with positiveN)
    apply pip2SummatoryAbs.bound with real, sequence, shift
    intros k hk below
    have kNat := nat.omega.backward with hk
    have self : realNat(succ(k)) ≤ realNat(succ(k)) by linarith
    have bounds := pip2LambdaSumTerms.bound at d, M, (0:N), k,
      realNat(succ(k)) with prime, self
    rw monoidPow.zero at bounds
    obtain ⟨low, high⟩ := bounds
    refine ⟨low, ?_⟩
    have termT : Real(lambdaSumTerms(d, M, (0:N))(k)) by
      exact RealSequence.value at lambdaSumTerms(d, M, (0:N)), k with sequence
    linarith
  have formula := LSeries.eq_mul_integral_of_abs at realCoefficients(
    pip2LambdaOver(d, M)), ℂ[s - 1], R[1] with values, hs1, nonneg, halfPlane,
    bound
  have nonzero : ℂ[s - 1] ≠ ℂ[0] by
    intro equal
    rw equal at halfPlane
    rw [← complexOfReal.zero, complexOfReal.re] at halfPlane
    linarith
  have cancel := complexInv.mul_cancel with hs1, nonzero
  have integral := complexMeasureIntegral.member at realMeasurableSpace,
    restrictMeasure(realMeasurableSpace, realVolume, realIoi(R[1])),
    summatoryIntegrand(realCoefficients(pip2LambdaOver(d, M)), ℂ[s - 1])
  unfold complexSetIntegral at formula
  unfold complexSetIntegral at chain
  unfold laplaceTransform
  unfold complexSetIntegral
  rw [chain, formula]
  unfold complexDiv
  have inverse := complexInv.member with hs1
  symm
  linear_combination (complexMeasureIntegral(realMeasurableSpace,
    restrictMeasure(realMeasurableSpace, realVolume, realIoi(R[1])),
    summatoryIntegrand(realCoefficients(pip2LambdaOver(d, M)), ℂ[s - 1]))) *
    cancel

-- ∫₀^∞ (e^(−v) Σ_{ν ≤ e^v} λ(ν)) e^((1−s)v) dv = L(λ, s)/s.
theorem pip2Product.laplace (d M : Nat, s : Set)
  requires prime : Prime(d)
  requires hs : s ∈ complexCarrier
  requires right : (2:R) < complexRe(s)
  shows laplaceTransform(pip2Product(d, M), s) =
    complexDiv(LSeries(realCoefficients(pip2Lambda(d, M)), s), s)
proof
  have real := pip2Lambda.real at d, M
  have values : FunctionBetween(realCoefficients(pip2Lambda(d, M)), ℕ,
      complexCarrier) by
    apply realCoefficients.maps
    intros m hm
    have am := real with m, hm
    typecheck
  have oneIndex : (1:N) ∈ ℕ by typecheck
  have one : pip2Lambda(d, M)((1:N)) = (0:R) by
    rw [(pip2Lambda.value with oneIndex), pip2LambdaClass.one]
  have vanish : ∀ X ∈ ℝ, X ≤ (1:R) → summatoryIntegrand(realCoefficients(
      pip2Lambda(d, M)), s)(X) = ℂ[0] by
    intros X hX below
    exact pip2SummatoryIntegrand.vanish with real, one, hs, hX, below
  have agree : ∀ T ∈ ℝ, laplaceIntegrand(pip2Product(d, M), s)(T) =
      ℂ[complexOfReal(realExp(T)) * summatoryIntegrand(realCoefficients(
        pip2Lambda(d, M)), s)(realExp(T))] by
    intros T hT
    exact pip2Product.agree with hs, hT
  have chain := pip2Integral.exp_chain with vanish, agree
  have halfPlane := right
  have nonneg : (0:R) ≤ (2:R) by linarith
  have sequence := pipLambdaSumTerms.sequence at d, M, (1:N)
  have shift := pip2Lambda.shift at d, M
  have twoR : R[2] ∈ ℝ by typecheck
  have oneN : (1:N) ∈ ℕ by typecheck
  have bound : ∃ C ∈ ℝ, ∃ K ∈ ℕ, ∀ n ∈ ℕ, K ≤ n →
      summatoryAbs(realCoefficients(pip2Lambda(d, M)), n) ≤
        R[C * realRpow(realNat(n), R[2])] by
    refine ⟨R[2], twoR, (1:N), oneN, ?_⟩
    intros n hn large
    have nNat := nat.omega.backward with hn
    have positiveN : R[0] < realNat(n) by
      have le := realNat.le_of_natural_le with large
      rw realNat.one at le
      linarith
    have nT : Real(realNat(n)) by typecheck
    have square := realRpow.nat at realNat(n), (2:N) with positiveN
    rw realNat.two at square
    rw [square, monoidPow.succ, monoidPow.succ, monoidPow.zero]
    have bounded := pip2SummatoryAbs.bound at pip2Lambda(d, M),
      lambdaSumTerms(d, M, (1:N)), R[2 * realNat(n)], n with real, sequence,
      shift
    have result : summatoryAbs(realCoefficients(pip2Lambda(d, M)), n) ≤
        R[R[2 * realNat(n)] * realNat(n)] by
      apply bounded
      intros k hk below
      have kNat := nat.omega.backward with hk
      have succLe : succ(k) ≤ n by arith
      have le := realNat.le_of_natural_le with succLe
      have bounds := pip2LambdaSumTerms.bound at d, M, (1:N), k, realNat(n)
        with prime, le
      rw [monoidPow.succ, monoidPow.zero] at bounds
      obtain ⟨low, high⟩ := bounds
      refine ⟨low, ?_⟩
      have termT : Real(lambdaSumTerms(d, M, (1:N))(k)) by
        exact RealSequence.value at lambdaSumTerms(d, M, (1:N)), k with
          sequence
      have e : R[2 * R[realNat(n) * R[1]]] = R[2 * realNat(n)] by ring
      rw e at high
      exact high
    have e : R[R[2 * realNat(n)] * realNat(n)] =
        R[2 * R[realNat(n) * R[realNat(n) * 1]]] by ring
    rw e at result
    exact result
  have formula := LSeries.eq_mul_integral_of_abs at realCoefficients(
    pip2Lambda(d, M)), s, R[2] with values, hs, nonneg, halfPlane, bound
  have nonzero : s ≠ ℂ[0] by
    intro equal
    rw equal at halfPlane
    rw [← complexOfReal.zero, complexOfReal.re] at halfPlane
    linarith
  have cancel := complexInv.mul_cancel with hs, nonzero
  have integral := complexMeasureIntegral.member at realMeasurableSpace,
    restrictMeasure(realMeasurableSpace, realVolume, realIoi(R[1])),
    summatoryIntegrand(realCoefficients(pip2Lambda(d, M)), s)
  unfold complexSetIntegral at formula
  unfold complexSetIntegral at chain
  unfold laplaceTransform
  unfold complexSetIntegral
  rw [chain, formula]
  unfold complexDiv
  have inverse := complexInv.member with hs
  symm
  linear_combination (complexMeasureIntegral(realMeasurableSpace,
    restrictMeasure(realMeasurableSpace, realVolume, realIoi(R[1])),
    summatoryIntegrand(realCoefficients(pip2Lambda(d, M)), s))) * cancel

-- Section: The polynomial part
theorem pip2PowExpIntegrand.apply (k : Nat, s T : Set)
  requires hT : T ∈ ℝ
  shows powExpIntegrand(k, s)(T) =
    ℂ[complexOfReal(T) ^ k * complexExp(ℂ[-(s * complexOfReal(T))])]
proof
  have shape : ∀ p ∈ powExpIntegrand(k, s), ∃ a ∈ ℝ, ∃ b, p = (a, b) by
    intros p hp
    simp [powExpIntegrand] at hp
    obtain ⟨m, mIn, eq⟩ := hp
    rw ← eq
    exact ⟨m, mIn, ℂ[complexOfReal(m) ^ k *
      complexExp(ℂ[-(s * complexOfReal(m))])], rfl⟩
  have total : ∀ a ∈ ℝ, ∃ b, (a, b) ∈ powExpIntegrand(k, s) by
    intros a aIn
    refine ⟨ℂ[complexOfReal(a) ^ k * complexExp(ℂ[-(s *
      complexOfReal(a))])], ?_⟩
    simp [powExpIntegrand]
  have functional : ∀ a, ∀ b, ∀ c, (a, b) ∈ powExpIntegrand(k, s) →
      (a, c) ∈ powExpIntegrand(k, s) → b = c by
    intros a b c ab ac
    simp [powExpIntegrand] at ab
    simp [powExpIntegrand] at ac
    obtain ⟨m, _, abEq⟩ := ab
    obtain ⟨j, _, acEq⟩ := ac
    obtain ⟨ma, mb⟩ := orderedPair.injective with abEq
    obtain ⟨ja, jc⟩ := orderedPair.injective with acEq
    cc
  have mapped : (T, ℂ[complexOfReal(T) ^ k * complexExp(ℂ[-(s *
      complexOfReal(T))])]) ∈ powExpIntegrand(k, s) by
    simp [powExpIntegrand]
  exact coefficientGraph.apply with shape, total, functional, hT, mapped

-- ∫₀^∞ (a + b v) e^((1−s)v) dv = a/(s − 1) + b/(s − 1)² for re s > 1.
theorem pip2Affine.laplace (a b : Real, s : Set)
  requires hs : s ∈ complexCarrier
  requires right : (1:R) < complexRe(s)
  shows laplaceTransform(pip2Affine(a, b), s) =
    ℂ[complexOfReal(a) * complexInv(ℂ[s - 1]) +
      complexOfReal(b) * complexInv(ℂ[(s - 1) * (s - 1)])]
proof
  have hs1 : ℂ[s - 1] ∈ ℂ by typecheck
  have reShift := pip2ComplexRe.sub_one with hs
  have positive : (0:R) < complexRe(ℂ[s - 1]) by
    rw reShift
    linarith
  have nonzero : ℂ[s - 1] ≠ ℂ[0] by
    intro equal
    rw equal at positive
    rw [← complexOfReal.zero, complexOfReal.re] at positive
    linarith
  have zeroN := add.right_one at (0:N)
  have oneN := add.right_one at (1:N)
  have f0 : (0:N)! = (1:N) by compute
  have f1 : (1:N)! = (1:N) by compute
  have i0 := powExpIntegrand.integral_Ioi at (0:N), ℂ[s - 1] with hs1, positive
  have i1 := powExpIntegrand.integral_Ioi at (1:N), ℂ[s - 1] with hs1, positive
  rw [f0, zeroN, monoidPow.succ, monoidPow.zero, realNat.one,
    complexOfReal.one] at i0
  rw [f1, oneN, monoidPow.succ, monoidPow.succ, monoidPow.zero, realNat.one,
    complexOfReal.one] at i1
  have inverse := complexInv.member with hs1
  have square : ℂ[(s - 1) * (s - 1)] ∈ ℂ by typecheck
  have inverseSquare := complexInv.member with square
  have one0 : ℂ[ℂ[s - 1] * 1] = ℂ[s - 1] by ring
  have one1 : ℂ[ℂ[s - 1] * ℂ[ℂ[s - 1] * 1]] = ℂ[(s - 1) * (s - 1)] by ring
  rw one0 at i0
  rw one1 at i1
  unfold complexDiv at i0
  unfold complexDiv at i1
  have v0 : ℂ[1 * complexInv(ℂ[s - 1])] = complexInv(ℂ[s - 1]) by ring
  have v1 : ℂ[1 * complexInv(ℂ[(s - 1) * (s - 1)])] =
      complexInv(ℂ[(s - 1) * (s - 1)]) by ring
  rw v0 at i0
  rw v1 at i1
  unfold complexSetIntegral at i0
  unfold complexSetIntegral at i1
  have cancel := complexInv.mul_cancel with hs1, nonzero
  have squareNonzero : ℂ[(s - 1) * (s - 1)] ≠ ℂ[0] by
    intro equal
    apply nonzero
    linear_combination complexInv(ℂ[s - 1]) * equal - (s - 1) * cancel
  have n0 := complexInv.nonzero with hs1, nonzero
  have n1 := complexInv.nonzero with square, squareNonzero
  rw ← i0 at n0
  rw ← i1 at n1
  have int0 := (complexMeasureIntegral.ne_zero with n0).left
  have int1 := (complexMeasureIntegral.ne_zero with n1).left
  have aC : complexOfReal(a) ∈ ℂ by typecheck
  have bC : complexOfReal(b) ∈ ℂ by typecheck
  have scaled0 := (ComplexIntegrable.const_mul with aC, int0).left
  have scaled1 := (ComplexIntegrable.const_mul with bC, int1).left
  have sum := complexMeasureIntegral.add with scaled0, scaled1
  have values0 : ∀ x ∈ MeasurableSpace.carrier(realMeasurableSpace),
      powExpIntegrand((0:N), ℂ[s - 1])(x) ∈ ℂ by
    intros x hx
    rw realMeasurableSpace.carrier at hx
    rw (pip2PowExpIntegrand.apply with hx)
    have xC : complexOfReal(x) ∈ ℂ by typecheck
    have argument : ℂ[-(ℂ[s - 1] * complexOfReal(x))] ∈ ℂ by typecheck
    have e := complexExp.member with argument
    have p := complexPow.member at complexOfReal(x), (0:N) with xC
    typecheck
  have values1 : ∀ x ∈ MeasurableSpace.carrier(realMeasurableSpace),
      powExpIntegrand((1:N), ℂ[s - 1])(x) ∈ ℂ by
    intros x hx
    rw realMeasurableSpace.carrier at hx
    rw (pip2PowExpIntegrand.apply with hx)
    have xC : complexOfReal(x) ∈ ℂ by typecheck
    have argument : ℂ[-(ℂ[s - 1] * complexOfReal(x))] ∈ ℂ by typecheck
    have e := complexExp.member with argument
    have p := complexPow.member at complexOfReal(x), (1:N) with xC
    typecheck
  have c0 := complexMeasureIntegral.const_mul at realMeasurableSpace,
    restrictMeasure(realMeasurableSpace, realVolume, realIoi(R[0])),
    complexOfReal(a), powExpIntegrand((0:N), ℂ[s - 1]) with aC, values0
  have c1 := complexMeasureIntegral.const_mul at realMeasurableSpace,
    restrictMeasure(realMeasurableSpace, realVolume, realIoi(R[0])),
    complexOfReal(b), powExpIntegrand((1:N), ℂ[s - 1]) with bC, values1
  have agree : ∀ x ∈ MeasurableSpace.carrier(realMeasurableSpace),
      laplaceIntegrand(pip2Affine(a, b), s)(x) = complexAddOn(
        complexConstMulOn(complexOfReal(a), powExpIntegrand((0:N), ℂ[s - 1]),
          MeasurableSpace.carrier(realMeasurableSpace)),
        complexConstMulOn(complexOfReal(b), powExpIntegrand((1:N), ℂ[s - 1]),
          MeasurableSpace.carrier(realMeasurableSpace)),
        MeasurableSpace.carrier(realMeasurableSpace))(x) by
    intros x hx
    rw [(complexAddOn.boch_apply with hx), (complexConstMulOn.boch_apply with
      hx)]
    rw realMeasurableSpace.carrier at hx
    have xReal : Real(x) by typecheck
    rw [(pip2LaplaceIntegrand.apply with hx), (pip2Affine.value with hx),
      (pip2Scale.value with hx), (pip2PowExpIntegrand.apply with hx),
      monoidPow.succ, monoidPow.zero, complexOfReal.add, complexOfReal.mul]
    have argument : ℂ[-(ℂ[s - 1] * complexOfReal(x))] =
        ℂ[(1 - s) * complexOfReal(x)] by ring
    rw argument
    have xC : complexOfReal(x) ∈ ℂ by typecheck
    have argumentC : ℂ[(1 - s) * complexOfReal(x)] ∈ ℂ by typecheck
    have e := complexExp.member with argumentC
    ring
  have congruent := complexMeasureIntegral.congr at realMeasurableSpace,
    restrictMeasure(realMeasurableSpace, realVolume, realIoi(R[0])),
    laplaceIntegrand(pip2Affine(a, b), s), complexAddOn(
        complexConstMulOn(complexOfReal(a), powExpIntegrand((0:N), ℂ[s - 1]),
          MeasurableSpace.carrier(realMeasurableSpace)),
        complexConstMulOn(complexOfReal(b), powExpIntegrand((1:N), ℂ[s - 1]),
          MeasurableSpace.carrier(realMeasurableSpace)),
        MeasurableSpace.carrier(realMeasurableSpace)) with agree
  unfold laplaceTransform
  unfold complexSetIntegral
  rw [congruent, sum, c0, c1, i0, i1]

-- Section: Splitting the transform of R_M
theorem pip2Step.lambdaSum (d M : Nat, V : Real)
  shows pip2Step(d, M, (0:N))(V) = lambdaSum(d, M, (0:N), realExp(V))
proof
  have vIn : V ∈ ℝ by typecheck
  have sequence := pipLambdaSumTerms.sequence at d, M, (0:N)
  have natural := pipNatFloor.natural at realExp(V)
  have partial := realPartialSum.real at lambdaSumTerms(d, M, (0:N)),
    natFloor(realExp(V)) with sequence
  have partialT : Real(realPartialSum(lambdaSumTerms(d, M, (0:N)),
    natFloor(realExp(V)))) by typecheck
  have oneNonzero : (1:R) ≠ 0 by
    intro equal
    linarith
  have inverseOne := realInvValue.mul_left at (1:R) with oneNonzero
  have invOneT : Real(realInvValue((1:R))) by typecheck
  have times : R[realInvValue((1:R)) * 1] = realInvValue((1:R)) by ring
  rw times at inverseOne
  rw (pip2Step.value with vIn)
  unfold lambdaSum
  rw [monoidPow.zero, realDiv.eq_mul_inv, inverseOne]
  ring

theorem pip2Product.lambdaSum (d M : Nat, V : Real)
  shows pip2Product(d, M)(V) = lambdaSum(d, M, (1:N), realExp(V))
proof
  have vIn : V ∈ ℝ by typecheck
  have sequence := pipLambdaSumTerms.sequence at d, M, (1:N)
  have natural := pipNatFloor.natural at realExp(V)
  have partial := realPartialSum.real at lambdaSumTerms(d, M, (1:N)),
    natFloor(realExp(V)) with sequence
  have partialT : Real(realPartialSum(lambdaSumTerms(d, M, (1:N)),
    natFloor(realExp(V)))) by typecheck
  have expT : Real(realExp(V)) by typecheck
  have power : R[realExp(V) ^ (1:N)] = realExp(V) by
    rw [monoidPow.succ, monoidPow.zero]
    ring
  rw [(pip2Product.value with vIn), (pip2Step.value with vIn),
    (pip2InvExp.value with vIn)]
  unfold lambdaSum
  rw [power, realDiv.eq_mul_inv]

theorem pip2Step.bound (d M : Nat)
  requires prime : Prime(d)
  shows ∀ V ∈ ℝ, (0:R) ≤ V →
    abs(pip2Step(d, M, (0:N))(V)) ≤ R[2 * realExp(V)]
proof
  intros V hV nonneg
  have vReal : Real(V) by typecheck
  rw pip2Step.lambdaSum
  exact lambdaSum.abs_exp_le with prime

theorem pip2Product.bound (d M : Nat)
  requires prime : Prime(d)
  shows ∀ V ∈ ℝ, (0:R) ≤ V →
    abs(pip2Product(d, M)(V)) ≤ R[2 * realExp(V)]
proof
  intros V hV nonneg
  have vReal : Real(V) by typecheck
  rw pip2Product.lambdaSum
  exact lambdaSum.abs_exp_le with prime

theorem pip2Head.bound (d M : Nat)
  requires prime : Prime(d)
  shows ∀ V ∈ ℝ, (0:R) ≤ V →
    abs(pip2Head(d, M)(V)) ≤ R[4 * realExp(V)]
proof
  intros V hV nonneg
  have vReal : Real(V) by typecheck
  have step := pip2Step.bound at d, M with prime
  have product := pip2Product.bound at d, M with prime
  have b0 := step with V, hV, nonneg
  have b1 := product with V, hV, nonneg
  have s0 := pip2Step.closed at d, M, (0:N), V with hV
  have p0 := pip2Product.closed at d, M, V with hV
  have s0T : Real(pip2Step(d, M, (0:N))(V)) by typecheck
  have p0T : Real(pip2Product(d, M)(V)) by typecheck
  have triangle := abs.triangle at pip2Step(d, M, (0:N))(V),
    R[-pip2Product(d, M)(V)]
  rw abs.neg at triangle
  rw [(pip2Head.value with hV), (pip2Tail.value with hV)]
  linarith

theorem pip2Affine.bound (a b : Real)
  shows ∀ V ∈ ℝ, (0:R) ≤ V →
    abs(pip2Affine(a, b)(V)) ≤ R[R[abs(a) + abs(b)] * realExp(V)]
proof
  intros V hV nonneg
  have vReal : Real(V) by typecheck
  have growth := realExp.one_add_le at V
  have absA := abs.nonnegative at a
  have absB := abs.nonnegative at b
  have triangle := abs.triangle at a, R[b * V]
  have product := abs.mul at b, V
  rw (abs.of_nonnegative with nonneg) at product
  have expT : Real(realExp(V)) by typecheck
  have absAT : Real(abs(a)) by typecheck
  have absBT : Real(abs(b)) by typecheck
  have oneLe : (1:R) ≤ realExp(V) by linarith
  have vLe : V ≤ realExp(V) by linarith
  have first := realLe.mul_left_of_nonnegative with oneLe, absA
  have second := realLe.mul_left_of_nonnegative with vLe, absB
  rw [(pip2Affine.value with hV), (pip2Scale.value with hV)]
  have e : R[abs(a) * 1] = abs(a) by ring
  rw e at first
  have distribute : R[R[abs(a) + abs(b)] * realExp(V)] =
      R[R[abs(a) * realExp(V)] + R[abs(b) * realExp(V)]] by ring
  rw product at triangle
  rw distribute
  linarith

-- ∫ (R_M-type) = ∫ (step) − ∫ (product) + ∫ (affine), each integrable.
theorem pip2Laplace.split (d M : Nat, a b : Real, E s : Set)
  requires prime : Prime(d)
  requires function : FunctionBetween(E, ℝ, ℝ)
  requires decomposition : ∀ V ∈ ℝ,
    E(V) = R[pip2Head(d, M)(V) + pip2Affine(a, b)(V)]
  requires hs : s ∈ complexCarrier
  requires right : (2:R) < complexRe(s)
  shows laplaceTransform(E, s) =
    ℂ[ℂ[laplaceTransform(pip2Step(d, M, (0:N)), s) -
      laplaceTransform(pip2Product(d, M), s)] +
      laplaceTransform(pip2Affine(a, b), s)]
proof
  have fStep := pip2Step.function at d, M, (0:N)
  have fProduct := pip2Product.function at d, M
  have fHead := pip2Head.function at d, M
  have fAffine := pip2Affine.function at a, b
  have mStep := pip2Step.measurable at d, M, (0:N)
  have mHead := pip2Head.measurable at d, M
  have mAffine := pip2Affine.measurable at a, b
  have mProduct : Measurable(pip2Product(d, M), realMeasurableSpace,
      realMeasurableSpace) by
    have step1 := pip2Step.measurable at d, M, (1:N)
    have inverse := pip2InvExp.measurable
    apply Measurable.real_mul with step1, inverse
    intros x hx
    rw realMeasurableSpace.carrier at hx
    exact pip2Product.value with hx
  have bStep := pip2Step.bound at d, M with prime
  have bProduct := pip2Product.bound at d, M with prime
  have bHead := pip2Head.bound at d, M with prime
  have bAffine := pip2Affine.bound at a, b
  have iStep := laplaceIntegrand.integrable_of_abs_le with fStep, mStep, bStep,
    hs, right
  have iProduct := laplaceIntegrand.integrable_of_abs_le with fProduct,
    mProduct, bProduct, hs, right
  have iHead := laplaceIntegrand.integrable_of_abs_le with fHead, mHead, bHead,
    hs, right
  have iAffine := laplaceIntegrand.integrable_of_abs_le with fAffine, mAffine,
    bAffine, hs, right
  unfold ComplexIntegrableOn at iStep
  unfold ComplexIntegrableOn at iProduct
  unfold ComplexIntegrableOn at iHead
  unfold ComplexIntegrableOn at iAffine
  have added := complexMeasureIntegral.add with iHead, iAffine
  have subtracted := complexMeasureIntegral.sub with iStep, iProduct
  have one : (1:R) ∈ ℝ by typecheck
  have agreeE : ∀ x ∈ MeasurableSpace.carrier(realMeasurableSpace),
      laplaceIntegrand(E, s)(x) = complexAddOn(laplaceIntegrand(pip2Head(d,
        M), s), laplaceIntegrand(pip2Affine(a, b), s),
        MeasurableSpace.carrier(realMeasurableSpace))(x) by
    intros x hx
    rw (complexAddOn.boch_apply with hx)
    rw realMeasurableSpace.carrier at hx
    have xReal : Real(x) by typecheck
    have h0 := pip2Head.closed at d, M, x with hx
    have a0 := pip2Affine.closed at a, b, x with hx
    have hT : Real(pip2Head(d, M)(x)) by typecheck
    have aT : Real(pip2Affine(a, b)(x)) by typecheck
    rw [(pip2LaplaceIntegrand.apply with hx), (decomposition with x, hx),
      complexOfReal.add]
    have argument : ℂ[(1 - s) * complexOfReal(x)] ∈ ℂ by typecheck
    have e := complexExp.member with argument
    ring
  have agreeH : ∀ x ∈ MeasurableSpace.carrier(realMeasurableSpace),
      laplaceIntegrand(pip2Head(d, M), s)(x) = complexSubOn(laplaceIntegrand(
        pip2Step(d, M, (0:N)), s), laplaceIntegrand(pip2Product(d, M), s),
        MeasurableSpace.carrier(realMeasurableSpace))(x) by
    intros x hx
    rw (complexSubOn.boch_apply with hx)
    rw realMeasurableSpace.carrier at hx
    have xReal : Real(x) by typecheck
    have s0 := pip2Step.closed at d, M, (0:N), x with hx
    have p0 := pip2Product.closed at d, M, x with hx
    have sT : Real(pip2Step(d, M, (0:N))(x)) by typecheck
    have pT : Real(pip2Product(d, M)(x)) by typecheck
    rw [(pip2LaplaceIntegrand.apply with hx), (pip2Head.value with hx),
      (pip2Tail.value with hx), complexOfReal.add, complexOfReal.neg]
    have argument : ℂ[(1 - s) * complexOfReal(x)] ∈ ℂ by typecheck
    have e := complexExp.member with argument
    ring
  have congruentE := complexMeasureIntegral.congr at realMeasurableSpace,
    restrictMeasure(realMeasurableSpace, realVolume, realIoi(realZero)),
    laplaceIntegrand(E, s), complexAddOn(laplaceIntegrand(pip2Head(d, M), s),
    laplaceIntegrand(pip2Affine(a, b), s),
    MeasurableSpace.carrier(realMeasurableSpace)) with agreeE
  have congruentH := complexMeasureIntegral.congr at realMeasurableSpace,
    restrictMeasure(realMeasurableSpace, realVolume, realIoi(realZero)),
    laplaceIntegrand(pip2Head(d, M), s), complexSubOn(laplaceIntegrand(
    pip2Step(d, M, (0:N)), s), laplaceIntegrand(pip2Product(d, M), s),
    MeasurableSpace.carrier(realMeasurableSpace)) with agreeH
  unfold laplaceTransform
  unfold complexSetIntegral
  rw [congruentE, added, congruentH, subtracted]

-- Section: Σ_ξ L̃′/L̃ as the L-series of −φ(M) λ
-- Σ_ξ Λ(n)(ξ(n)(n/d) − ξ(n)) = −φ(M) λ(n).
theorem pip2Coeffs.sum_value (d M n : Nat)
  requires prime : Prime(d)
  requires positive : (1:N) ≤ M
  shows coefficientFamilySum(pip2Coeffs(d, M), dirichletCharacters(M))(n) =
    complexOfReal(R[-(realNat(totient(M)) * lambdaClass(d, M, n))])
proof
  have index : n ∈ ℕ by typecheck
  have mPositive : 0 < M by arith
  have finite := dirichletCharacters.finite with mPositive
  have ring := complexes.comm_ring
  have integer : integerOfNat(n) ∈ ℤ by typecheck
  have legendre := legendreSign.real at d, integerOfNat(n)
  have lambda := vonMangoldt.real at n
  have l1 : complexOfReal(legendreSign(d, integerOfNat(n))) ∈ ℂ by typecheck
  have l2 : complexOfReal(vonMangoldt(n)) ∈ ℂ by typecheck
  have l3 : ℂ[complexOfReal(legendreSign(d, integerOfNat(n))) *
      complexOfReal(vonMangoldt(n))] ∈ ℂ by typecheck
  have l4 := FunctionBetween.apply_closed with complexNeg.function, l2
  have cC : ℂ[complexOfReal(legendreSign(d, integerOfNat(n))) *
      complexOfReal(vonMangoldt(n)) - complexOfReal(vonMangoldt(n))] ∈ ℂ by
    typecheck
  have cReal : ℂ[complexOfReal(legendreSign(d, integerOfNat(n))) *
      complexOfReal(vonMangoldt(n)) - complexOfReal(vonMangoldt(n))] =
      complexOfReal(R[legendreSign(d, integerOfNat(n)) * vonMangoldt(n) -
        vonMangoldt(n)]) by
    rw [complexOfReal.sub, complexOfReal.mul]
  have weightsW := characterEvaluation.function at M, integerOfNat(n) with
    integer
  have entries : ∀ ξ ∈ dirichletCharacters(M),
      familyValues(pip2Coeffs(d, M), n, dirichletCharacters(M))(ξ) =
        ℂ[ℂ[complexOfReal(legendreSign(d, integerOfNat(n))) *
          complexOfReal(vonMangoldt(n)) - complexOfReal(vonMangoldt(n))] *
          characterEvaluation(M, integerOfNat(n))(ξ)] by
    intros ξ hξ
    have character := dirichletCharacters.membership.forward with hξ
    have value := DirichletCharacter.value with character, integer
    rw [(familyValues.eval with hξ), (pip2Coeffs.value with hξ),
      (characterEvaluation.value with integer, hξ)]
    unfold pip2CoeffValue
    unfold twistedVonMangoldt
    unfold vonMangoldtCoefficients
    rw [(coefficientSub.eval with index),
      (coefficientMul.eval at characterCoefficients(quadTwist(M, ξ, d)),
        realCoefficients(vonMangoldt), n with index),
      (coefficientMul.eval at characterCoefficients(ξ),
        realCoefficients(vonMangoldt), n with index),
      (characterCoefficients.eval at quadTwist(M, ξ, d), n with index),
      (characterCoefficients.eval at ξ, n with index),
      (realCoefficients.eval at vonMangoldt, n with index),
      (quadTwist.apply with prime, character, integer)]
    ring
  have weightsV : familyValues(pip2Coeffs(d, M), n, dirichletCharacters(M)) :
      dirichletCharacters(M) → complexCarrier by
    apply familyValues.maps
    intros ξ hξ
    rw ← (familyValues.eval at pip2Coeffs(d, M), n, dirichletCharacters(M), ξ
      with hξ)
    rw (entries with ξ, hξ)
    have term := FunctionBetween.apply_closed with weightsW, hξ
    typecheck
  have scaled := finiteRingSum.scale_eq with ring, finite, weightsW, weightsV,
    cC, entries
  have residueT := residueClass.closed at M, integerOne, n with index
  have phiT : Real(realNat(totient(M))) by typecheck
  have legendreT : Real(legendreSign(d, integerOfNat(n))) by typecheck
  have lambdaT : Real(vonMangoldt(n)) by typecheck
  by_cases congruent : IntegerCongruent(integerOfNat(M), integerOfNat(n),
      integerOne)
  . have one := dirichletCharacters.sum_one with mPositive, integer,
      congruent
    have inClass : InResidueClass(M, n, integerOne) by
      unfold InResidueClass
      exact congruent
    have lam : lambdaClass(d, M, n) =
        R[vonMangoldt(n) * (1 - legendreSign(d, integerOfNat(n)))] by
      unfold lambdaClass
      rw [(residueClass.value at M, integerOne, n with index),
        (residueClassValue.in_class with inClass)]
    rw [(pip2CoefficientFamilySum.eval with index), scaled, one,
      ← complexOfReal.nat, cReal, ← complexOfReal.mul, lam]
    have e : R[R[legendreSign(d, integerOfNat(n)) * vonMangoldt(n) -
        vonMangoldt(n)] * realNat(totient(M))] = R[-(realNat(totient(M)) *
        R[vonMangoldt(n) * (1 - legendreSign(d, integerOfNat(n)))])] by ring
    rw e
  . have other := dirichletCharacters.sum_other with mPositive, integer,
      congruent
    have notInClass : ¬InResidueClass(M, n, integerOne) by
      intro inClass
      unfold InResidueClass at inClass
      obtain ⟨_, _, inside⟩ := inClass
      contradiction
    have lam : lambdaClass(d, M, n) =
        R[realZero * (1 - legendreSign(d, integerOfNat(n)))] by
      unfold lambdaClass
      rw [(residueClass.value at M, integerOne, n with index),
        (residueClassValue.not_in_class with notInClass)]
    rw [(pip2CoefficientFamilySum.eval with index), scaled, other,
      ← complexOfReal.zero, cReal, ← complexOfReal.mul, lam]
    have e : R[R[legendreSign(d, integerOfNat(n)) * vonMangoldt(n) -
        vonMangoldt(n)] * 0] = R[-(realNat(totient(M)) *
        R[realZero * (1 - legendreSign(d, integerOfNat(n)))])] by ring
    rw e

theorem pip2PrincipalIndicator.principal (N : Nat)
  shows principalIndicator(N, principalCharacter(N)) = ℂ[1]
proof
  unfold principalIndicator
  apply union.of_unique
  . have oneC : ℂ[1] ∈ ℂ by typecheck
    refine ⟨oneC, ?_⟩
    left
    exact ⟨rfl, rfl⟩
  . intros y hy
    obtain ⟨_, alternatives⟩ := hy
    rcases alternatives with ⟨_, yValue⟩ | ⟨other, _⟩
    . exact yValue
    . exfalso
      apply other
      rfl

theorem pip2PrincipalIndicator.other (N : Nat, χ : Set)
  requires other : χ ≠ principalCharacter(N)
  shows principalIndicator(N, χ) = ℂ[0]
proof
  unfold principalIndicator
  apply union.of_unique
  . have zeroC : ℂ[0] ∈ ℂ by typecheck
    refine ⟨zeroC, ?_⟩
    right
    exact ⟨other, rfl⟩
  . intros y hy
    obtain ⟨_, alternatives⟩ := hy
    rcases alternatives with ⟨same, _⟩ | ⟨_, yValue⟩
    . contradiction
    . exact yValue

-- Σ_ξ (p(ξ(·/d)) − p(ξ))/(s − 1) = −1/(s − 1): only ξ principal counts.
theorem pip2PoleTerms.sum (d M : Nat, s : Set)
  requires prime : Prime(d)
  requires odd : d ≠ (2:N)
  requires coprime : gcd(M, d) = (1:N)
  requires positive : (1:N) ≤ M
  requires hs : s ∈ complexCarrier
  shows groupFiniteSum(complexAdditiveGroup, dirichletCharacters(M),
    pip2PoleTerms(d, M, s)) = ℂ[-complexInv(ℂ[s - 1])]
proof
  have ngC := complexAdditiveGroup.normed
  obtain ⟨c, m⟩ := complexAdditiveGroup.parts
  have o : Group.one(complexAdditiveGroup) = complexZero by
    unfold complexAdditiveGroup
    group_projections
  have mPositive : 0 < M by arith
  have finite := dirichletCharacters.finite with mPositive
  have principal := principalCharacter.character at M
  have index := dirichletCharacters.membership.backward with principal
  have shift : ℂ[s - 1] ∈ ℂ by typecheck
  have inverse := complexInv.member with shift
  have twistZero : ∀ ξ ∈ dirichletCharacters(M),
      principalIndicator(M * d, quadTwist(M, ξ, d)) = ℂ[0] by
    intros ξ hξ
    have character := dirichletCharacters.membership.forward with hξ
    have notPrincipal := quadTwist.ne_principal with prime, odd, coprime,
      character
    exact pip2PrincipalIndicator.other with notPrincipal
  have value : pip2PoleTerms(d, M, s)(principalCharacter(M)) =
      ℂ[-complexInv(ℂ[s - 1])] by
    rw [(pip2PoleTerms.value with hs, index), (twistZero with
      principalCharacter(M), index), pip2PrincipalIndicator.principal]
    unfold complexDiv
    ring
  have valueC : pip2PoleTerms(d, M, s)(principalCharacter(M)) ∈
      Group.carrier(complexAdditiveGroup) by
    rw [c, value]
    typecheck
  have vanish : ∀ ξ ∈ dirichletCharacters(M), ξ ≠ principalCharacter(M) →
      pip2PoleTerms(d, M, s)(ξ) = Group.one(complexAdditiveGroup) by
    intros ξ hξ other
    rw [o, (pip2PoleTerms.value with hs, hξ), (twistZero with ξ, hξ),
      (pip2PrincipalIndicator.other with other)]
    unfold complexDiv
    ring
  have single := groupFiniteSum.single_support with ngC.left, finite, index,
    valueC, vanish
  rw [single, value]

-- The family of series Σ_ξ (L-series of Λ ξ(·/d) − Λ ξ) for re s > 1.
theorem pip2Family.hasSum (d M : Nat, s : Set)
  requires prime : Prime(d)
  requires positive : (1:N) ≤ M
  requires hs : s ∈ complexCarrier
  requires halfPlane : (1:R) < complexRe(s)
  shows LSeriesHasSum(coefficientFamilySum(pip2Coeffs(d, M),
    dirichletCharacters(M)), s, complexFamilySum(pip2SumTerms(d, M, s),
    dirichletCharacters(M)))
proof
  have mPositive : 0 < M by arith
  have finite := dirichletCharacters.finite with mPositive
  have dLarge := Prime.two_le with prime
  have dPositive : (1:N) ≤ d by arith
  have levelPositive := LessEqual.one_le_mul with positive, dPositive
  have coefficients : ∀ ξ ∈ dirichletCharacters(M),
      FunctionBetween(pip2Coeffs(d, M)(ξ), ℕ, complexCarrier) by
    intros ξ hξ
    have character := dirichletCharacters.membership.forward with hξ
    have twistCharacter := quadTwist.character at M, d, ξ with prime,
      character
    have f1 := twistedVonMangoldt.function with twistCharacter
    have f2 := twistedVonMangoldt.function with character
    rw (pip2Coeffs.value with hξ)
    unfold pip2CoeffValue
    apply coefficientSub.maps
    intros m mIn
    have a1 := FunctionBetween.apply_closed with f1, mIn
    have a2 := FunctionBetween.apply_closed with f2, mIn
    have n2 := FunctionBetween.apply_closed with complexNeg.function, a2
    typecheck
  have each : ∀ ξ ∈ dirichletCharacters(M), LSeriesHasSum(pip2Coeffs(d, M)(ξ),
      s, pip2SumTerms(d, M, s)(ξ)) by
    intros ξ hξ
    have character := dirichletCharacters.membership.forward with hξ
    have twistCharacter := quadTwist.character at M, d, ξ with prime,
      character
    have f1 := twistedVonMangoldt.function with twistCharacter
    have f2 := twistedVonMangoldt.function with character
    have s1 := LSeriesHasSum.twist_vonMangoldt_entireL with levelPositive,
      twistCharacter, hs, halfPlane
    have s2 := LSeriesHasSum.twist_vonMangoldt_entireL with positive,
      character, hs, halfPlane
    rw [(pip2Coeffs.value with hξ),
      (pip2SumTerms.value with prime, positive, hs, hξ)]
    unfold pip2CoeffValue
    unfold pip2PolarValue
    exact LSeriesHasSum.sub with f1, f2, hs, s1, s2
  have sums := pip2SumTerms.function with prime, positive, hs
  exact LSeriesHasSum.family_sum with finite, coefficients, sums, hs, each

theorem pip2Coeffs.function (d M : Nat)
  requires prime : Prime(d)
  shows ∀ ξ ∈ dirichletCharacters(M),
    FunctionBetween(pip2Coeffs(d, M)(ξ), ℕ, complexCarrier)
proof
  intros ξ hξ
  have character := dirichletCharacters.membership.forward with hξ
  have twistCharacter := quadTwist.character at M, d, ξ with prime, character
  have f1 := twistedVonMangoldt.function with twistCharacter
  have f2 := twistedVonMangoldt.function with character
  rw (pip2Coeffs.value with hξ)
  unfold pip2CoeffValue
  apply coefficientSub.maps
  intros m mIn
  have a1 := FunctionBetween.apply_closed with f1, mIn
  have a2 := FunctionBetween.apply_closed with f2, mIn
  have n2 := FunctionBetween.apply_closed with complexNeg.function, a2
  typecheck

-- K(s) = Σ_ξ (L̃′/L̃(s, ξ(·/d)) − L̃′/L̃(s, ξ)) = φ(M) L(λ, s) − 1/(s − 1)
-- for re s > 1.
theorem pip2LogDerivSum.lseries (d M : Nat, s : Set)
  requires prime : Prime(d)
  requires odd : d ≠ (2:N)
  requires coprime : gcd(M, d) = (1:N)
  requires positive : (1:N) ≤ M
  requires hs : s ∈ complexCarrier
  requires halfPlane : (1:R) < complexRe(s)
  shows groupFiniteSum(complexAdditiveGroup, dirichletCharacters(M),
    logDerivMeanTerms(d, M, s)) =
    ℂ[complexOfReal(realNat(totient(M))) *
      LSeries(realCoefficients(pip2Lambda(d, M)), s) -
      complexInv(ℂ[s - 1])]
proof
  have mPositive : 0 < M by arith
  have finite := dirichletCharacters.finite with mPositive
  have dLarge := Prime.two_le with prime
  have dPositive : (1:N) ≤ d by arith
  have levelPositive := LessEqual.one_le_mul with positive, dPositive
  have ngC := complexAdditiveGroup.normed
  obtain ⟨c, m⟩ := complexAdditiveGroup.parts
  have family := pip2Family.hasSum with prime, positive, hs, halfPlane
  have coefficients := pip2Coeffs.function at d, M with prime
  have familyFunction := pip2CoefficientFamilySum.function with finite,
    coefficients
  have phiPositive : (0:R) < realNat(totient(M)) by
    have totientPositive := totient.positive with mPositive
    have totientNonzero : totient(M) ≠ (0:N) by arith
    exact realNat.positive at totient(M) with totientNonzero
  have phiNonzero : realNat(totient(M)) ≠ 0 by
    intro equal
    linarith
  have phiT : Real(realNat(totient(M))) by typecheck
  have inverseT : Real(realInvValue(realNat(totient(M)))) by typecheck
  have cancel := realInvValue.mul_left at realNat(totient(M)) with phiNonzero
  have kcC : complexOfReal(R[-realInvValue(realNat(totient(M)))]) ∈ ℂ by
    typecheck
  have scaled := LSeriesHasSum.scale with familyFunction, kcC, hs, family
  have lambdaReal := pip2Lambda.real at d, M
  have lambdaValues : FunctionBetween(realCoefficients(pip2Lambda(d, M)), ℕ,
      complexCarrier) by
    apply realCoefficients.maps
    intros n hn
    have an := lambdaReal with n, hn
    typecheck
  have scaledValues : FunctionBetween(coefficientScale(complexOfReal(R[
      -realInvValue(realNat(totient(M)))]), coefficientFamilySum(pip2Coeffs(d,
      M), dirichletCharacters(M))), ℕ, complexCarrier) by
    apply coefficientScale.maps
    intros n hn
    have value := FunctionBetween.apply_closed with familyFunction, hn
    typecheck
  have sameCoefficients : coefficientScale(complexOfReal(R[
      -realInvValue(realNat(totient(M)))]), coefficientFamilySum(pip2Coeffs(d,
      M), dirichletCharacters(M))) = realCoefficients(pip2Lambda(d, M)) by
    apply FunctionBetween.ext with scaledValues, lambdaValues
    intros n hn
    have nNat := nat.omega.backward with hn
    have lambda := pipLambdaClass.real at d, M, n
    have lambdaT : Real(lambdaClass(d, M, n)) by typecheck
    rw [(coefficientScale.eval with hn), (pip2Coeffs.sum_value with prime,
      positive), ← complexOfReal.mul, (realCoefficients.eval with hn),
      (pip2Lambda.value with hn)]
    have e : R[R[-realInvValue(realNat(totient(M)))] * R[-(realNat(totient(M))
        * lambdaClass(d, M, n))]] = R[lambdaClass(d, M, n) *
        R[realInvValue(realNat(totient(M))) * realNat(totient(M))]] by ring
    rw [e, cancel]
    have one : R[lambdaClass(d, M, n) * 1] = lambdaClass(d, M, n) by ring
    rw one
  rw sameCoefficients at scaled
  have iff := LSeriesHasSum.iff at realCoefficients(pip2Lambda(d, M)), s,
    ℂ[complexOfReal(R[-realInvValue(realNat(totient(M)))]) *
    complexFamilySum(pip2SumTerms(d, M, s), dirichletCharacters(M))] with
    lambdaValues, hs
  have both := iff.forward with scaled
  have lsEq := both.right
  have sums := pip2SumTerms.function with prime, positive, hs
  have bridge := pip2GroupSum.ring with finite, sums
  rw ← bridge at lsEq
  have poles := pip2PoleTerms.sum with prime, odd, coprime, positive, hs
  have valuesA : ∀ ξ ∈ dirichletCharacters(M),
      pip2SumTerms(d, M, s)(ξ) ∈ Group.carrier(complexAdditiveGroup) by
    intros ξ hξ
    rw c
    exact FunctionBetween.apply_closed with sums, hξ
  have valuesT : ∀ ξ ∈ dirichletCharacters(M),
      logDerivMeanTerms(d, M, s)(ξ) ∈ Group.carrier(complexAdditiveGroup) by
    intros ξ hξ
    rw c
    exact pipLogDerivMeanTerms.member with prime, positive, hs, hξ
  have split : ∀ ξ ∈ dirichletCharacters(M),
      pip2PoleTerms(d, M, s)(ξ) = Group.mul(complexAdditiveGroup)(
        pip2SumTerms(d, M, s)(ξ), logDerivMeanTerms(d, M, s)(ξ)) by
    intros ξ hξ
    have character := dirichletCharacters.membership.forward with hξ
    have twistCharacter := quadTwist.character at M, d, ξ with prime,
      character
    have l1 := logDerivEntireLMap.closed with levelPositive, twistCharacter,
      hs
    have l2 := logDerivEntireLMap.closed with positive, character, hs
    rw [m, (pip2PoleTerms.value with hs, hξ),
      (pip2SumTerms.value with prime, positive, hs, hξ),
      (pipLogDerivMeanTerms.apply with hξ)]
    unfold pip2PolarValue
    obtain ⟨r1, r1Real, p1⟩ := pip2PrincipalIndicator.real at M * d,
      quadTwist(M, ξ, d)
    obtain ⟨r2, r2Real, p2⟩ := pip2PrincipalIndicator.real at M, ξ
    have shift : ℂ[s - 1] ∈ ℂ by typecheck
    have inverse := complexInv.member with shift
    unfold complexDiv
    rw [p1, p2]
    ring
  have added := groupFiniteSum.add with ngC.left, finite, valuesA, valuesT,
    split
  rw m at added
  have unit : ℂ[complexOfReal(realNat(totient(M))) *
      complexOfReal(R[-realInvValue(realNat(totient(M)))])] = ℂ[-1] by
    rw ← complexOfReal.mul
    have e : R[realNat(totient(M)) * R[-realInvValue(realNat(totient(M)))]] =
        R[-R[realInvValue(realNat(totient(M))) * realNat(totient(M))]] by ring
    rw [e, cancel, complexOfReal.neg, complexOfReal.one]
  have sumA := groupFiniteSum.member with ngC.left, finite, valuesA
  have sumT := groupFiniteSum.member with ngC.left, finite, valuesT
  rw c at sumA
  rw c at sumT
  have shift : ℂ[s - 1] ∈ ℂ by typecheck
  have inverse := complexInv.member with shift
  have lsC : LSeries(realCoefficients(pip2Lambda(d, M)), s) ∈ ℂ by
    rw lsEq
    typecheck
  have sumP : groupFiniteSum(complexAdditiveGroup, dirichletCharacters(M),
      pip2PoleTerms(d, M, s)) ∈ ℂ by
    rw poles
    typecheck
  linear_combination poles - added - complexOfReal(realNat(totient(M))) *
    lsEq - groupFiniteSum(complexAdditiveGroup, dirichletCharacters(M),
    pip2SumTerms(d, M, s)) * unit

end PolarLaplace
