-- The two analytic inputs of the one-sided criterion: a prime of a given
-- class whose quadratic twists have no zero on a half-strip (Jutila's
-- zero-density bound), and Landau's lemma applied to the Mellin transform
-- of the prime error R_M(e^v), whose poles in re s > 0 are the zeros of
-- the L-functions L̃(s, ξ) and L̃(s, ξ(·/d)).
-- Source: grh-compact/src/Lib/Analytic/QuadraticTwist/ZeroFreeTwist.lean
-- (exists_entireL_quadTwist_ne_zero), src/New/Endgame/PrimeError.lean
-- (isPolar_primeError), src/Lib/Analytic/Landau/PolarLandau.lean
-- (IsPolar.landau, tendsto_sub_mul_logDeriv_entireL, entireL_ne_zero).
-- Related work: Jutila, On mean values of Dirichlet polynomials with real
-- characters, Acta Arith. 27 (1975); Montgomery-Vaughan, Multiplicative
-- Number Theory I, Lemma 15.1, 2007; Landau, Über einen Satz von
-- Tschebyschef, 1905.
-- Part of: One-sided bound for non-split primes gives a zero-free
-- half-plane (GRH.Proof.Endgame.OneSidedCriterion).
-- Part of the GRH blueprint (layer 5, the argument).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Proof.Endgame.CriterionTools
import GRH.Proof.Endgame.PrimeError

section CriterionTools
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- ZeroFreeTwist.lean, exists_entireL_quadTwist_ne_zero: let B > 1/2, Y
-- real, and a a unit modulo M whose primes are all ≡ 7 mod 8 and prime to
-- M. Some prime d ≡ a (mod M) has no L̃(s, ξ(·/d)), ξ modulo M, vanishing
-- on re s ≥ B, |im s| ≤ Y. (Zero density for quadratic twists by mean
-- values over real characters, with Dirichlet's theorem on primes in the
-- class of a.)
theorem entireL.exists_quadTwist_ne_zero (M a : Nat, B Y : Real)
  requires positive : (1:N) ≤ M
  requires half : R[1 / 2] < B
  requires unit : gcd(a, M) = (1:N)
  requires classPrimes : ∀ d ∈ ℕ, Prime(d) → CongruentMod(d, a, M) →
    d % 8 = (7:N) ∧ gcd(M, d) = (1:N)
  shows ∃ d ∈ ℕ, Prime(d) ∧ CongruentMod(d, a, M) ∧
    (∀ ξ ∈ dirichletCharacters(M), ∀ s ∈ complexCarrier,
      B ≤ complexRe(s) → abs(complexIm(s)) ≤ Y →
      entireL(M * d, quadTwist(M, ξ, d), s) ≠ ℂ[0])
proof
  sorry

-- Landau's lemma for the prime error. For d ≡ 7 mod 8 a prime to M,
-- v ↦ R_M(e^v) is polar (isPolar_primeError): its transform
-- ∫₀^∞ R_M(e^v) e^((1−s)v) dv continues meromorphically to re s > 0 with
-- at most simple poles, of residue
-- r(s) = Σ_ξ (ord_s L̃(ξ) − ord_s L̃(ξ(·/d))) / (φ(M) s (1 − s)).
-- If R_M(x) ≤ x^(B−1) for large x, B > 0, and re r(x) ≥ 0 for real
-- x > B, Landau's lemma (IsPolar.landau) gives r(ρ) = 0 for re ρ > B.
-- When no twist vanishes at a real x > B, re r(x) ≥ 0 there (the orders
-- of L̃(ξ) are ≥ 0, x(1 − x) > 0 for x < 1, and L̃ has no zero on
-- re s ≥ 1); when moreover no twist vanishes at ρ, r(ρ) = 0 makes the
-- nonnegative orders ord_ρ L̃(ξ) sum to 0, so L̃(ρ, χ) ≠ 0.
theorem primeError.landau (d M : Nat, B : Real, ρ χ : Set)
  requires prime : Prime(d)
  requires sevenModEight : d % 8 = (7:N)
  requires coprime : gcd(M, d) = (1:N)
  requires positive : (1:N) ≤ M
  requires bPositive : (0:R) < B
  requires bound : ∃ X ∈ ℝ, ∀ Y ∈ ℝ, X ≤ Y →
    primeError(d, M, Y) ≤ realRpow(Y, R[B - 1])
  requires realTwists : ∀ ξ ∈ dirichletCharacters(M), ∀ X ∈ ℝ, B < X →
    entireL(M * d, quadTwist(M, ξ, d), complexOfReal(X)) ≠ ℂ[0]
  requires hρ : ρ ∈ complexCarrier
  requires right : B < complexRe(ρ)
  requires twistsAtρ : ∀ ξ ∈ dirichletCharacters(M),
    entireL(M * d, quadTwist(M, ξ, d), ρ) ≠ ℂ[0]
  requires character : DirichletCharacter(M, χ)
  shows entireL(M, χ, ρ) ≠ ℂ[0]
proof
  sorry

end CriterionTools
