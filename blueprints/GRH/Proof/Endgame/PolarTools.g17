-- Tools for the polarity of the prime error (isPolar_primeError): the
-- meromorphic function Φ(s) = (logDerivMean(s)/s − κ)/(s − 1), κ the real
-- part of logDerivMean(1), its local form near every point (the orders of
-- the L-functions L̃(s, ξ) and L̃(s, ξ(·/d)) as residues), its
-- analyticity at re s ≥ 1, and its agreement with the Laplace transform of
-- v ↦ R_M(e^v) for re s > 2.
-- Source: grh-compact/src/New/Endgame/PrimeError.lean (isPolar_primeError).
-- Part of: One-sided bound for non-split primes gives a zero-free
-- half-plane (GRH.Proof.Endgame.OneSidedCriterion).
-- Part of the GRH blueprint (layer 5, the argument).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Proof.Endgame.PolarTools
import GRH.Proof.Endgame.PrimeError
import GRH.Proof.Endgame.PolarLocal

section PolarTools
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Section: Definitions
-- κ = re logDerivMean(1), the constant in R_M.
def pipKappa (d M : Nat) : Set := complexRe(logDerivMean(d, M, ℂ[1]))

-- ord_s L̃(ξ) − ord_s L̃(ξ(·/d)) in ℂ, as a function of ξ, and its sum
-- over the characters modulo M.
def pipOrderValue (d M : Nat, s ξ : Set) : Set :=
  complexOfReal(R[realNat(analyticOrderNat(entireLMap(M, ξ), s)) -
    realNat(analyticOrderNat(entireLMap(M * d, quadTwist(M, ξ, d)), s))])

def pipOrderValues (d M : Nat, s : Set) : Set :=
  { pipOrderValue(d, M, s, ξ) | ξ ∈ dirichletCharacters(M) }

defgraph pipOrderTerms (d M : Nat, s : Set) (ξ ∈ dirichletCharacters(M)) :
    pipOrderValues(d, M, s) := pipOrderValue(d, M, s, ξ)
proof
  unfold pipOrderValues
  simp

def pipOrderSum (d M : Nat, s : Set) : Set :=
  groupFiniteSum(complexAdditiveGroup, dirichletCharacters(M),
    pipOrderTerms(d, M, s))

-- Section: The prime error
-- ⌊y⌋₊ is ⌊y⌋ for y ≥ 0 and 0 for y < 0.
theorem pipNatFloor.value (Y : Real)
  shows ((0:R) ≤ Y ∧ natFloor(Y) = realFloor(Y)) ∨
    (Y < (0:R) ∧ natFloor(Y) = ∅)
proof
  by_cases nonneg : (0:R) ≤ Y
  . left
    have natural := realFloor.natural with nonneg
    have member := nat.omega.forward with natural
    refine ⟨nonneg, ?_⟩
    unfold natFloor
    apply union.of_unique
    . refine ⟨member, ?_⟩
      left
      exact ⟨nonneg, rfl⟩
    . intros y hy
      obtain ⟨_, alternatives⟩ := hy
      rcases alternatives with ⟨_, yValue⟩ | ⟨negative, _⟩
      . exact yValue
      . exfalso
        linarith
  . right
    have negative := realLess.of_not_le with nonneg
    have member : ∅ ∈ ℕ by typecheck
    refine ⟨negative, ?_⟩
    unfold natFloor
    apply union.of_unique
    . refine ⟨member, ?_⟩
      right
      exact ⟨negative, rfl⟩
    . intros y hy
      obtain ⟨_, alternatives⟩ := hy
      rcases alternatives with ⟨nonneg2, _⟩ | ⟨_, yValue⟩
      . exfalso
        linarith
      . exact yValue

theorem pipNatFloor.natural (Y : Real)
  shows Nat(natFloor(Y))
proof
  rcases pipNatFloor.value at Y with ⟨nonneg, equal⟩ | ⟨_, equal⟩
  . rw equal
    exact realFloor.natural with nonneg
  . rw equal
    typecheck

-- λ(ν) is real.
theorem pipLambdaClass.real (d M ν : Nat)
  shows lambdaClass(d, M, ν) ∈ ℝ
proof
  have function := residueClass.function at M, integerOne
  have legendre := legendreSign.real at d, integerOfNat(ν)
  unfold lambdaClass
  typecheck

-- The terms λ(ν)/ν · ν^r form a real sequence.
theorem pipLambdaSumTerms.sequence (d M r : Nat)
  shows RealSequence(lambdaSumTerms(d, M, r))
proof
  unfold RealSequence
  apply coefficientGraph.function
  . intros p hp
    simp [lambdaSumTerms] at hp
    obtain ⟨j, jIn, eq⟩ := hp
    have jNat := nat.omega.backward with jIn
    have lambda := pipLambdaClass.real at d, M, succ(j)
    rw ← eq
    refine ⟨j, jIn, R[lambdaClass(d, M, succ(j)) / realNat(succ(j)) *
      realNat(succ(j)) ^ r], ?_, rfl⟩
    typecheck
  . intros a aIn
    have aNat := nat.omega.backward with aIn
    have lambda := pipLambdaClass.real at d, M, succ(a)
    refine ⟨R[lambdaClass(d, M, succ(a)) / realNat(succ(a)) *
      realNat(succ(a)) ^ r], ?_, ?_⟩
    . typecheck
    . simp [lambdaSumTerms]
  . intros a b c ab ac
    simp [lambdaSumTerms] at ab
    simp [lambdaSumTerms] at ac
    obtain ⟨z, _, abEq⟩ := ab
    obtain ⟨w, _, acEq⟩ := ac
    obtain ⟨za, zb⟩ := orderedPair.injective with abEq
    obtain ⟨wa, wc⟩ := orderedPair.injective with acEq
    cc

-- y^(−r) Σ_{ν ≤ y} λ(ν) ν^(r−1) is real.
theorem pipLambdaSum.real (d M r : Nat, Y : Real)
  shows lambdaSum(d, M, r, Y) ∈ ℝ
proof
  have sequence := pipLambdaSumTerms.sequence at d, M, r
  have natural := pipNatFloor.natural at Y
  have partial := realPartialSum.real at lambdaSumTerms(d, M, r),
    natFloor(Y) with sequence
  unfold lambdaSum
  typecheck

-- Section: logDerivMean
-- The terms of logDerivMean at ξ.
theorem pipLogDerivMeanTerms.apply (d M : Nat, s ξ : Set)
  requires hξ : ξ ∈ dirichletCharacters(M)
  shows logDerivMeanTerms(d, M, s)(ξ) =
    ℂ[logDerivEntireL(M * d, quadTwist(M, ξ, d), s) -
      logDerivEntireL(M, ξ, s)]
proof
  have shape : ∀ p ∈ logDerivMeanTerms(d, M, s),
      ∃ a ∈ dirichletCharacters(M), ∃ b, p = (a, b) by
    intros p hp
    simp [logDerivMeanTerms] at hp
    obtain ⟨z, zIn, eq⟩ := hp
    rw ← eq
    exact ⟨z, zIn, ℂ[logDerivEntireL(M * d, quadTwist(M, z, d), s) -
      logDerivEntireL(M, z, s)], rfl⟩
  have total : ∀ a ∈ dirichletCharacters(M),
      ∃ b, (a, b) ∈ logDerivMeanTerms(d, M, s) by
    intros a aIn
    refine ⟨ℂ[logDerivEntireL(M * d, quadTwist(M, a, d), s) -
      logDerivEntireL(M, a, s)], ?_⟩
    simp [logDerivMeanTerms]
  have functional : ∀ a, ∀ b, ∀ c, (a, b) ∈ logDerivMeanTerms(d, M, s) →
      (a, c) ∈ logDerivMeanTerms(d, M, s) → b = c by
    intros a b c ab ac
    simp [logDerivMeanTerms] at ab
    simp [logDerivMeanTerms] at ac
    obtain ⟨z, _, abEq⟩ := ab
    obtain ⟨w, _, acEq⟩ := ac
    obtain ⟨za, zb⟩ := orderedPair.injective with abEq
    obtain ⟨wa, wc⟩ := orderedPair.injective with acEq
    cc
  have mapped : (ξ, ℂ[logDerivEntireL(M * d, quadTwist(M, ξ, d), s) -
      logDerivEntireL(M, ξ, s)]) ∈ logDerivMeanTerms(d, M, s) by
    simp [logDerivMeanTerms]
  exact coefficientGraph.apply with shape, total, functional, hξ, mapped

-- L̃′/L̃(s, χ) is a complex number.
theorem pipLogDerivEntireL.member (N : Nat, χ s : Set)
  requires positive : (1:N) ≤ N
  requires character : DirichletCharacter(N, χ)
  requires hs : s ∈ complexCarrier
  shows logDerivEntireL(N, χ, s) ∈ complexCarrier
proof
  exact logDerivEntireLMap.closed with positive, character, hs

-- The terms of logDerivMean are complex numbers.
theorem pipLogDerivMeanTerms.member (d M : Nat, s ξ : Set)
  requires prime : Prime(d)
  requires positive : (1:N) ≤ M
  requires hs : s ∈ complexCarrier
  requires hξ : ξ ∈ dirichletCharacters(M)
  shows logDerivMeanTerms(d, M, s)(ξ) ∈ complexCarrier
proof
  have character := dirichletCharacters.membership.forward with hξ
  have twistCharacter := quadTwist.character at M, d, ξ with prime, character
  have dLarge := Prime.two_le with prime
  have dPositive : (1:N) ≤ d by arith
  have levelPositive := LessEqual.one_le_mul with positive, dPositive
  have first := pipLogDerivEntireL.member with levelPositive, twistCharacter,
    hs
  have second := pipLogDerivEntireL.member with positive, character, hs
  rw (pipLogDerivMeanTerms.apply with hξ)
  typecheck

-- Σ_ξ (L̃′/L̃(s, ξ(·/d)) − L̃′/L̃(s, ξ)) is a complex number.
theorem pipLogDerivSum.member (d M : Nat, s : Set)
  requires prime : Prime(d)
  requires positive : (1:N) ≤ M
  requires hs : s ∈ complexCarrier
  shows groupFiniteSum(complexAdditiveGroup, dirichletCharacters(M),
    logDerivMeanTerms(d, M, s)) ∈ complexCarrier
proof
  have ngC := complexAdditiveGroup.normed
  obtain ⟨c, m⟩ := complexAdditiveGroup.parts
  have mPositive : 0 < M by arith
  have finite := dirichletCharacters.finite with mPositive
  have values : ∀ ξ ∈ dirichletCharacters(M),
      logDerivMeanTerms(d, M, s)(ξ) ∈ Group.carrier(complexAdditiveGroup) by
    intros ξ hξ
    rw c
    exact pipLogDerivMeanTerms.member with prime, positive, hs, hξ
  have member := groupFiniteSum.member with ngC.left, finite, values
  rwa c at member

-- logDerivMean(s) is a complex number.
theorem pipLogDerivMean.member (d M : Nat, s : Set)
  requires prime : Prime(d)
  requires positive : (1:N) ≤ M
  requires hs : s ∈ complexCarrier
  shows logDerivMean(d, M, s) ∈ complexCarrier
proof
  have sum := pipLogDerivSum.member with prime, positive, hs
  unfold logDerivMean
  unfold complexDiv
  have totientC : complexOfReal(realNat(totient(M))) ∈ ℂ by typecheck
  have inverse := complexInv.member with totientC
  typecheck

-- Φ(s) = (logDerivMean(s)/s − κ)/(s − 1) on ℂ.
defgraph pipPhi (d M : Nat) (s ∈ complexCarrier) : complexCarrier :=
    complexDiv(ℂ[complexDiv(logDerivMean(d, M, s), s) -
      complexOfReal(pipKappa(d, M))], ℂ[s - 1])
requires prime : Prime(d)
requires positive : (1:N) ≤ M
proof
  have mean := pipLogDerivMean.member with prime, positive, member
  unfold pipKappa
  have oneC : ℂ[1] ∈ ℂ by typecheck
  have meanOne := pipLogDerivMean.member with prime, positive, oneC
  have meanDiv : complexDiv(logDerivMean(d, M, s), s) ∈ ℂ by
    unfold complexDiv
    have inverse := complexInv.member with member
    typecheck
  have shift : ℂ[s - 1] ∈ ℂ by typecheck
  have inverse := complexInv.member with shift
  unfold complexDiv
  typecheck

-- Section: Local forms of Σ_ξ L̃′/L̃ terms
-- K(z) = Σ_ξ (L̃′/L̃(z, ξ(·/d)) − L̃′/L̃(z, ξ)).
def pipK (d M : Nat, z : Set) : Set :=
  groupFiniteSum(complexAdditiveGroup, dirichletCharacters(M),
    logDerivMeanTerms(d, M, z))

-- z ↦ (z − a)^m (L̃′/L̃(z, ξ(·/d)) − L̃′/L̃(z, ξ)), and the family of these
-- over ξ.
defgraph pipTermMap (d M : Nat, a : Set, m : Nat, ξ : Set)
    (z ∈ complexCarrier) : complexCarrier :=
    ℂ[(z - a) ^ m * logDerivMeanTerms(d, M, z)(ξ)]
requires prime : Prime(d)
requires positive : (1:N) ≤ M
requires ha : a ∈ complexCarrier
requires hξ : ξ ∈ dirichletCharacters(M)
proof
  have term := pipLogDerivMeanTerms.member with prime, positive, member, hξ
  have difference : ℂ[z - a] ∈ ℂ by typecheck
  have power := complexPow.member at ℂ[z - a], m with difference
  typecheck

def pipTermValues (d M : Nat, a : Set, m : Nat) : Set :=
  { pipTermMap(d, M, a, m, ξ) | ξ ∈ dirichletCharacters(M) }

defgraph pipTermFamily (d M : Nat, a : Set, m : Nat)
    (ξ ∈ dirichletCharacters(M)) : pipTermValues(d, M, a, m) :=
    pipTermMap(d, M, a, m, ξ)
proof
  unfold pipTermValues
  simp

-- z ↦ (z − a)^m K(z).
defgraph pipKPow (d M : Nat, a : Set, m : Nat) (z ∈ complexCarrier) :
    complexCarrier := ℂ[(z - a) ^ m * pipK(d, M, z)]
requires prime : Prime(d)
requires positive : (1:N) ≤ M
requires ha : a ∈ complexCarrier
proof
  have sum := pipLogDerivSum.member with prime, positive, member
  have difference : ℂ[z - a] ∈ ℂ by typecheck
  have power := complexPow.member at ℂ[z - a], m with difference
  unfold pipK
  typecheck

-- Local forms of the terms give one of (z − a)^m K(z).
theorem pipKPow.local_of (d M : Nat, a : Set, m : Nat, c : Set)
  requires prime : Prime(d)
  requires positive : (1:N) ≤ M
  requires ha : a ∈ complexCarrier
  requires cValues : ∀ ξ ∈ dirichletCharacters(M), c(ξ) ∈ complexCarrier
  requires locals : ∀ ξ ∈ dirichletCharacters(M),
    pipLocal(pipTermMap(d, M, a, m, ξ), a, c(ξ))
  shows pipLocal(pipKPow(d, M, a, m), a,
    groupFiniteSum(complexAdditiveGroup, dirichletCharacters(M), c))
proof
  have mPositive : 0 < M by arith
  have finite := dirichletCharacters.finite with mPositive
  have values : ∀ i ∈ dirichletCharacters(M), ∀ w ∈ complexCarrier,
      pipTermFamily(d, M, a, m)(i)(w) ∈ complexCarrier by
    intros i hi w hw
    rw [(pipTermFamily.value at d, M, a, m, i with hi),
      (pipTermMap.value with prime, positive, ha, hi, hw)]
    exact pipTermMap.closed with prime, positive, ha, hi, hw
  have localsT : ∀ i ∈ dirichletCharacters(M),
      pipLocal(pipTermFamily(d, M, a, m)(i), a, c(i)) by
    intros i hi
    rw (pipTermFamily.value at d, M, a, m, i with hi)
    exact locals with i, hi
  have reflexive := Subset.reflexive at dirichletCharacters(M)
  have family := pipLocal.family with ha, values, cValues, localsT,
    reflexive, finite
  apply pipLocal.congr with family
  intros z hz distinct
  have atz : ∀ i ∈ dirichletCharacters(M),
      pipTermFamily(d, M, a, m)(i)(z) ∈ complexCarrier by
    intros i hi
    exact values with i, hi, z, hz
  have carrier := complexRing.carrierOf
  have mulOf := complexRing.mulOf
  have additive := complexAdditiveGroup.ring_additive
  have commutative := complexRing.comm_ring
  have difference : ℂ[z - a] ∈ ℂ by typecheck
  have power := complexPow.member at ℂ[z - a], m with difference
  have powerK : ℂ[(z - a) ^ m] ∈ Ring.carrier(complexRing) by
    rw carrier
    exact power
  have termValues : ∀ i ∈ dirichletCharacters(M),
      logDerivMeanTerms(d, M, z)(i) ∈ Ring.carrier(complexRing) by
    intros i hi
    rw carrier
    exact pipLogDerivMeanTerms.member with prime, positive, hz, hi
  have product : ∀ i ∈ dirichletCharacters(M),
      pipFamilyAt(pipTermFamily(d, M, a, m), dirichletCharacters(M), z)(i) =
        Ring.mul(complexRing)(ℂ[(z - a) ^ m], logDerivMeanTerms(d, M, z)(i)) by
    intros i hi
    rw [(pipFamilyAt.value with atz, hi), (pipTermFamily.value at d, M, a, m,
      i with hi), (pipTermMap.value with prime, positive, ha, hi, hz), mulOf]
  have split := groupFiniteSum.ring_mul_left with commutative, finite,
    powerK, termValues, product
  rw [← additive, mulOf] at split
  rw [(pipKPow.value with prime, positive, ha, hz),
    (pipFamilySum.value with values, finite, reflexive, hz), split]
  unfold pipK
  rfl

-- ord_a L̃(ξ(·/d)) − ord_a L̃(ξ), as ord + ord · (−1).
def pipTwistOrderValue (d M : Nat, s ξ : Set) : Set :=
  ℂ[complexOfReal(realNat(analyticOrderNat(entireLMap(M * d,
      quadTwist(M, ξ, d)), s))) +
    complexOfReal(realNat(analyticOrderNat(entireLMap(M, ξ), s))) * -1]

-- (z − a)(L̃′/L̃(z, ξ(·/d)) − L̃′/L̃(z, ξ)) has a local form at a of value
-- ord_a L̃(ξ(·/d)) − ord_a L̃(ξ).
theorem pipTermMap.local_pole (d M : Nat, a ξ : Set)
  requires prime : Prime(d)
  requires positive : (1:N) ≤ M
  requires ha : a ∈ complexCarrier
  requires hξ : ξ ∈ dirichletCharacters(M)
  shows pipLocal(pipTermMap(d, M, a, (1:N), ξ), a,
    pipTwistOrderValue(d, M, a, ξ))
proof
  have character := dirichletCharacters.membership.forward with hξ
  have twistCharacter := quadTwist.character at M, d, ξ with prime, character
  have dLarge := Prime.two_le with prime
  have dPositive : (1:N) ≤ d by arith
  have levelPositive := LessEqual.one_le_mul with positive, dPositive
  have values1 : ∀ z ∈ complexCarrier,
      logDerivEntireLMap(M, ξ)(z) ∈ complexCarrier by
    intros z hz
    rw (logDerivEntireLMap.value with positive, character, hz)
    exact logDerivEntireLMap.closed with positive, character, hz
  have values2 : ∀ z ∈ complexCarrier,
      logDerivEntireLMap(M * d, quadTwist(M, ξ, d))(z) ∈ complexCarrier by
    intros z hz
    rw (logDerivEntireLMap.value with levelPositive, twistCharacter, hz)
    exact logDerivEntireLMap.closed with levelPositive, twistCharacter, hz
  have whole := ComplexOpen.whole
  have minusOne : ℂ[-1] ∈ ℂ by typecheck
  have holoWhole := HolomorphicOn.const with whole, minusOne
  have one : R[1] ∈ ℝ by typecheck
  have onePositive : (0:R) < R[1] by linarith
  have openD := complexDisk.open with ha, one
  have diskSub := complexDisk.subset at a, R[1]
  have holoQ := HolomorphicOn.mono with holoWhole, openD, diskSub
  have valuesQ := holoWhole.right.left
  have local2 := pipLogDerivEntireL.local with levelPositive, twistCharacter,
    ha
  have local1 := pipLogDerivEntireL.local with positive, character, ha
  have valuesS1 : ComplexValuedOn(subMulMap(logDerivEntireLMap(M, ξ), a),
      complexCarrier) by
    intros z hz
    rw (subMulMap.value with values1, ha, hz)
    exact subMulMap.closed with values1, ha, hz
  have product : ∀ z ∈ complexCarrier, z ≠ a →
      complexFunctionMul(subMulMap(logDerivEntireLMap(M, ξ), a),
        complexFunctionConst(ℂ[-1], complexCarrier), complexCarrier)(z) =
      ℂ[subMulMap(logDerivEntireLMap(M, ξ), a)(z) *
        complexFunctionConst(ℂ[-1], complexCarrier)(z)] by
    intros z hz distinct
    exact complexFunctionMul.value with valuesS1, valuesQ, hz
  have negative := pipLocal.mul with ha, local1, onePositive, holoQ, product
  have sum : ∀ z ∈ complexCarrier, z ≠ a →
      pipTermMap(d, M, a, (1:N), ξ)(z) =
      ℂ[subMulMap(logDerivEntireLMap(M * d, quadTwist(M, ξ, d)), a)(z) +
        complexFunctionMul(subMulMap(logDerivEntireLMap(M, ξ), a),
          complexFunctionConst(ℂ[-1], complexCarrier), complexCarrier)(z)] by
    intros z hz distinct
    have v1 := values1 with z, hz
    have v2 := values2 with z, hz
    rw [(pipTermMap.value with prime, positive, ha, hξ, hz),
      (pipLogDerivMeanTerms.apply with hξ),
      (complexFunctionMul.value with valuesS1, valuesQ, hz),
      (subMulMap.value with values1, ha, hz),
      (subMulMap.value with values2, ha, hz),
      (complexFunctionConst.value with minusOne, hz),
      (logDerivEntireLMap.value with positive, character, hz),
      (logDerivEntireLMap.value with levelPositive, twistCharacter, hz)]
    rw [← (logDerivEntireLMap.value with positive, character, hz),
      ← (logDerivEntireLMap.value with levelPositive, twistCharacter, hz)]
    rw [monoidPow.succ, monoidPow.zero]
    ring
  have added := pipLocal.add with ha, local2, negative, sum
  rw (complexFunctionConst.value with minusOne, ha) at added
  unfold pipTwistOrderValue
  exact added

-- Where neither L̃(ξ(·/d)) nor L̃(ξ) vanishes at a, the term
-- L̃′/L̃(z, ξ(·/d)) − L̃′/L̃(z, ξ) has a local form of its value at a.
theorem pipTermMap.local_regular (d M : Nat, a ξ : Set)
  requires prime : Prime(d)
  requires positive : (1:N) ≤ M
  requires ha : a ∈ complexCarrier
  requires hξ : ξ ∈ dirichletCharacters(M)
  requires nonzero1 : entireL(M, ξ, a) ≠ ℂ[0]
  requires nonzero2 : entireL(M * d, quadTwist(M, ξ, d), a) ≠ ℂ[0]
  shows pipLocal(pipTermMap(d, M, a, (0:N), ξ), a,
    logDerivMeanTerms(d, M, a)(ξ))
proof
  have character := dirichletCharacters.membership.forward with hξ
  have twistCharacter := quadTwist.character at M, d, ξ with prime, character
  have dLarge := Prime.two_le with prime
  have dPositive : (1:N) ≤ d by arith
  have levelPositive := LessEqual.one_le_mul with positive, dPositive
  have values1 : ∀ z ∈ complexCarrier,
      logDerivEntireLMap(M, ξ)(z) ∈ complexCarrier by
    intros z hz
    rw (logDerivEntireLMap.value with positive, character, hz)
    exact logDerivEntireLMap.closed with positive, character, hz
  have values2 : ∀ z ∈ complexCarrier,
      logDerivEntireLMap(M * d, quadTwist(M, ξ, d))(z) ∈ complexCarrier by
    intros z hz
    rw (logDerivEntireLMap.value with levelPositive, twistCharacter, hz)
    exact logDerivEntireLMap.closed with levelPositive, twistCharacter, hz
  have whole := ComplexOpen.whole
  have minusOne : ℂ[-1] ∈ ℂ by typecheck
  have holoWhole := HolomorphicOn.const with whole, minusOne
  have one : R[1] ∈ ℝ by typecheck
  have onePositive : (0:R) < R[1] by linarith
  have openD := complexDisk.open with ha, one
  have diskSub := complexDisk.subset at a, R[1]
  have holoQ := HolomorphicOn.mono with holoWhole, openD, diskSub
  have valuesQ := holoWhole.right.left
  have local2 := pipLogDerivEntireL.local_regular with levelPositive,
    twistCharacter, ha, nonzero2
  have local1 := pipLogDerivEntireL.local_regular with positive, character,
    ha, nonzero1
  have product : ∀ z ∈ complexCarrier, z ≠ a →
      complexFunctionMul(logDerivEntireLMap(M, ξ),
        complexFunctionConst(ℂ[-1], complexCarrier), complexCarrier)(z) =
      ℂ[logDerivEntireLMap(M, ξ)(z) *
        complexFunctionConst(ℂ[-1], complexCarrier)(z)] by
    intros z hz distinct
    have valuesL1 : ComplexValuedOn(logDerivEntireLMap(M, ξ),
        complexCarrier) by
      intros w hw
      exact values1 with w, hw
    exact complexFunctionMul.value with valuesL1, valuesQ, hz
  have negative := pipLocal.mul with ha, local1, onePositive, holoQ, product
  have sum : ∀ z ∈ complexCarrier, z ≠ a →
      pipTermMap(d, M, a, (0:N), ξ)(z) =
      ℂ[logDerivEntireLMap(M * d, quadTwist(M, ξ, d))(z) +
        complexFunctionMul(logDerivEntireLMap(M, ξ),
          complexFunctionConst(ℂ[-1], complexCarrier), complexCarrier)(z)] by
    intros z hz distinct
    have v1 := values1 with z, hz
    have v2 := values2 with z, hz
    have valuesL1 : ComplexValuedOn(logDerivEntireLMap(M, ξ),
        complexCarrier) by
      intros w hw
      exact values1 with w, hw
    rw [(pipTermMap.value with prime, positive, ha, hξ, hz),
      (pipLogDerivMeanTerms.apply with hξ),
      (complexFunctionMul.value with valuesL1, valuesQ, hz),
      (complexFunctionConst.value with minusOne, hz),
      (logDerivEntireLMap.value with positive, character, hz),
      (logDerivEntireLMap.value with levelPositive, twistCharacter, hz)]
    rw [← (logDerivEntireLMap.value with positive, character, hz),
      ← (logDerivEntireLMap.value with levelPositive, twistCharacter, hz)]
    rw monoidPow.zero
    ring
  have added := pipLocal.add with ha, local2, negative, sum
  rw (complexFunctionConst.value with minusOne, ha) at added
  have l1 := pipLogDerivEntireL.member with positive, character, ha
  have l2 := pipLogDerivEntireL.member with levelPositive, twistCharacter, ha
  have value : ℂ[logDerivEntireL(M * d, quadTwist(M, ξ, d), a) +
      logDerivEntireL(M, ξ, a) * -1] = logDerivMeanTerms(d, M, a)(ξ) by
    rw (pipLogDerivMeanTerms.apply with hξ)
    ring
  rw value at added
  exact added

-- R_M(x) is real.
theorem pipPrimeError.real (d M : Nat, X : Real)
  requires prime : Prime(d)
  requires positive : (1:N) ≤ M
  shows primeError(d, M, X) ∈ ℝ
proof
  have zero := pipLambdaSum.real at d, M, (0:N), X
  have one := pipLambdaSum.real at d, M, (1:N), X
  have oneC : ℂ[1] ∈ ℂ by typecheck
  have mean := pipLogDerivMean.member with prime, positive, oneC
  unfold primeError
  typecheck

-- v ↦ R_M(e^v) is measurable.
theorem pipPrimeErrorExp.measurable (d M : Nat, E : Set)
  requires prime : Prime(d)
  requires positive : (1:N) ≤ M
  requires function : FunctionBetween(E, ℝ, ℝ)
  requires values : ∀ V ∈ ℝ, E(V) = primeError(d, M, realExp(V))
  shows Measurable(E, realMeasurableSpace, realMeasurableSpace)
proof
  sorry

-- |R_M(e^v)| ≤ (|κ| + 5) e^v for v ≥ 0.
theorem pipPrimeErrorExp.bound (d M : Nat, E : Set)
  requires prime : Prime(d)
  requires positive : (1:N) ≤ M
  requires values : ∀ V ∈ ℝ, E(V) = primeError(d, M, realExp(V))
  shows ∃ C ∈ ℝ, ∀ V ∈ ℝ, (0:R) ≤ V → abs(E(V)) ≤ R[C * realExp(V)]
proof
  have oneC : ℂ[1] ∈ ℂ by typecheck
  have mean := pipLogDerivMean.member with prime, positive, oneC
  have kappaReal : complexRe(logDerivMean(d, M, ℂ[1])) ∈ ℝ by typecheck
  have kT : Real(complexRe(logDerivMean(d, M, ℂ[1]))) by typecheck
  have cReal : R[abs(complexRe(logDerivMean(d, M, ℂ[1]))) + 5] ∈ ℝ by
    typecheck
  refine ⟨R[abs(complexRe(logDerivMean(d, M, ℂ[1]))) + 5], cReal, ?_⟩
  intros V hV nonneg
  have vT : Real(V) by typecheck
  have mPositive : 0 < M by arith
  have totientPositive := totient.positive with mPositive
  have totientOne : 1 ≤ totient(M) by arith
  have pOne := realNat.one_le at totient(M) with totientOne
  have pNonzero : realNat(totient(M)) ≠ (0:R) by
    intro zero
    linarith
  have expOne := realExp.one_add_le at V
  have zeroB := lambdaSum.abs_exp_le at d, M, (0:N), V with prime
  have oneB := lambdaSum.abs_exp_le at d, M, (1:N), V with prime
  have zeroR := pipLambdaSum.real at d, M, (0:N), realExp(V)
  have oneR := pipLambdaSum.real at d, M, (1:N), realExp(V)
  have zeroT : Real(lambdaSum(d, M, (0:N), realExp(V))) by typecheck
  have oneT : Real(lambdaSum(d, M, (1:N), realExp(V))) by typecheck
  have zeroU := abs.upper at lambdaSum(d, M, (0:N), realExp(V))
  have zeroL := abs.upper_neg at lambdaSum(d, M, (0:N), realExp(V))
  have oneU := abs.upper at lambdaSum(d, M, (1:N), realExp(V))
  have oneL := abs.upper_neg at lambdaSum(d, M, (1:N), realExp(V))
  have kU := abs.upper at complexRe(logDerivMean(d, M, ℂ[1]))
  have kL := abs.upper_neg at complexRe(logDerivMean(d, M, ℂ[1]))
  have kN := abs.nonnegative at complexRe(logDerivMean(d, M, ℂ[1]))
  -- 0 ≤ v/φ(M) ≤ v.
  have quotient := realDiv.mul_right at V, realNat(totient(M)) with pNonzero
  have invPositive := realInvValue.positive at realNat(totient(M))
  have pPositive : (0:R) < realNat(totient(M)) by linarith
  have invPos := invPositive with pPositive
  have invNonneg : (0:R) ≤ realInvValue(realNat(totient(M))) by linarith
  have shape := realDiv.eq_mul_inv at V, realNat(totient(M))
  have qNonneg0 := realLe.mul_right_of_nonnegative at (0:R), V,
    realInvValue(realNat(totient(M))) with nonneg, invNonneg
  have invT : Real(realInvValue(realNat(totient(M)))) by typecheck
  have zeroMul : R[0 * realInvValue(realNat(totient(M)))] = (0:R) by ring
  have qNonneg : (0:R) ≤ R[V / realNat(totient(M))] by
    rw shape
    linarith
  have qScaled := realLe.mul_right_of_nonnegative at (1:R),
    realNat(totient(M)), R[V / realNat(totient(M))] with pOne, qNonneg
  have qT : Real(R[V / realNat(totient(M))]) by typecheck
  have pT : Real(realNat(totient(M))) by typecheck
  have commute : R[realNat(totient(M)) * (V / realNat(totient(M)))] =
    R[(V / realNat(totient(M))) * realNat(totient(M))] by ring
  have oneMul : R[1 * (V / realNat(totient(M)))] =
    R[V / realNat(totient(M))] by ring
  have qLe : R[V / realNat(totient(M))] ≤ V by linarith
  -- |κ| ≤ |κ| e^v.
  have expGe : (1:R) ≤ realExp(V) by linarith
  have kScaled := realLe.mul_right_of_nonnegative at (1:R), realExp(V),
    abs(complexRe(logDerivMean(d, M, ℂ[1]))) with expGe, kN
  have eT : Real(realExp(V)) by typecheck
  have aT : Real(abs(complexRe(logDerivMean(d, M, ℂ[1])))) by typecheck
  have expand : R[(abs(complexRe(logDerivMean(d, M, ℂ[1]))) + 5) *
      realExp(V)] = R[abs(complexRe(logDerivMean(d, M, ℂ[1]))) * realExp(V) +
      5 * realExp(V)] by ring
  have swapK : R[realExp(V) * abs(complexRe(logDerivMean(d, M, ℂ[1])))] =
    R[abs(complexRe(logDerivMean(d, M, ℂ[1]))) * realExp(V)] by ring
  have oneK : R[1 * abs(complexRe(logDerivMean(d, M, ℂ[1])))] =
    abs(complexRe(logDerivMean(d, M, ℂ[1]))) by ring
  have value := values with V, hV
  rw value
  unfold primeError
  rw (realLog.of_exp at V)
  apply abs.le_of_bounds
  . linarith
  . linarith

-- Section: The function Φ
-- Φ is meromorphic on ℂ.
theorem pipPhi.meromorphic (d M : Nat)
  requires prime : Prime(d)
  requires sevenModEight : d % 8 = (7:N)
  requires coprime : gcd(M, d) = (1:N)
  requires positive : (1:N) ≤ M
  shows Meromorphic(pipPhi(d, M))
proof
  sorry

-- Φ(s) is the Laplace transform of v ↦ R_M(e^v) for re s > 2.
theorem pipPhi.laplace (d M : Nat, E : Set)
  requires prime : Prime(d)
  requires sevenModEight : d % 8 = (7:N)
  requires coprime : gcd(M, d) = (1:N)
  requires positive : (1:N) ≤ M
  requires function : FunctionBetween(E, ℝ, ℝ)
  requires values : ∀ V ∈ ℝ, E(V) = primeError(d, M, realExp(V))
  shows ∀ s ∈ complexCarrier, (2:R) < complexRe(s) →
    pipPhi(d, M)(s) = laplaceTransform(E, s)
proof
  sorry

-- (s − 1)Φ(s) is analytic on re s ≥ 1.
theorem pipPhi.analytic_one (d M : Nat)
  requires prime : Prime(d)
  requires sevenModEight : d % 8 = (7:N)
  requires coprime : gcd(M, d) = (1:N)
  requires positive : (1:N) ≤ M
  shows ComplexAnalyticOnNhd(subMulMap(pipPhi(d, M), ℂ[1]),
    closedRightHalfPlane(R[1]))
proof
  sorry

-- (z − ρ)Φ(z) → Σ_ξ (ord_ρ L̃(ξ) − ord_ρ L̃(ξ(·/d))) / (φ(M) ρ (1 − ρ))
-- as z → ρ, for re ρ > 0.
theorem pipPhi.residue (d M : Nat, ρ : Set)
  requires prime : Prime(d)
  requires sevenModEight : d % 8 = (7:N)
  requires coprime : gcd(M, d) = (1:N)
  requires positive : (1:N) ≤ M
  requires hρ : ρ ∈ complexCarrier
  requires right : (0:R) < complexRe(ρ)
  shows HasPuncturedLimit(subMulMap(pipPhi(d, M), ρ), ρ,
    complexDiv(pipOrderSum(d, M, ρ),
      ℂ[complexOfReal(realNat(totient(M))) * (ρ * (1 - ρ))]))
proof
  sorry

-- A finite sum of reals taken in ℂ.
theorem pipFiniteSum.of_real (V t u : Set)
  requires finite : Finite(V)
  requires values : ∀ i ∈ V, t(i) ∈ ℝ
  requires embedded : ∀ i ∈ V, u(i) = complexOfReal(t(i))
  shows groupFiniteSum(complexAdditiveGroup, V, u) =
    complexOfReal(realFiniteSum(t, V))
proof
  have ngC := complexAdditiveGroup.normed
  obtain ⟨c, m⟩ := complexAdditiveGroup.parts
  have abelianC := ngC.left
  have groupC := AbelianGroup.to_group with abelianC
  have abelianR := realAdditiveGroup.abelian
  have groupR := AbelianGroup.to_group with abelianR
  obtain ⟨abR, cR, mR, oR⟩ := realAdditiveGroup.parts
  have fn : complexOfReal : Group.carrier(realAdditiveGroup) →
      Group.carrier(complexAdditiveGroup) by
    rw [c, cR]
    exact complexOfReal.function
  have hom : complexOfReal : realAdditiveGroup →* complexAdditiveGroup by
    apply GroupHom.mk with groupR, groupC, fn
    intros x hx y hy
    rw cR at hx
    rw cR at hy
    have xR : Real(x) by exact hx
    have yR : Real(y) by exact hy
    rw [m, mR]
    exact complexOfReal.add at x, y
  have valuesR : ∀ i ∈ V, t(i) ∈ Group.carrier(realAdditiveGroup) by
    rw cR
    exact values
  have mapped := groupFiniteSum.hom with abelianR, abelianC, hom, finite,
    valuesR, embedded
  unfold realFiniteSum
  rw mapped

end PolarTools
