-- Tools for the polarity of the prime error (isPolar_primeError): the
-- meromorphic function Φ(s) = (logDerivMean(s)/s − κ)/(s − 1), κ the real
-- part of logDerivMean(1), its local form near every point (the orders of
-- the L-functions L̃(s, ξ) and L̃(s, ξ(·/d)) as residues), its
-- analyticity at re s ≥ 1, and its agreement with the Laplace transform of
-- v ↦ R_M(e^v) for re s > 2.
-- Source: grh-compact/src/New/Endgame/PrimeError.lean (isPolar_primeError).
-- Part of: One-sided bound for non-split primes gives a zero-free
-- half-plane (GRH.Proof.Endgame.OneSidedCriterion).
-- Part of the GRH blueprint (layer 5, the argument).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Proof.Endgame.PolarTools
import GRH.Proof.Endgame.PrimeError
import GRH.Analytic.Landau

section PolarTools
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Section: Definitions
-- κ = re logDerivMean(1), the constant in R_M.
def pipKappa (d M : Nat) : Set := complexRe(logDerivMean(d, M, ℂ[1]))

-- ord_s L̃(ξ) − ord_s L̃(ξ(·/d)) in ℂ, as a function of ξ, and its sum
-- over the characters modulo M.
def pipOrderValue (d M : Nat, s ξ : Set) : Set :=
  complexOfReal(R[realNat(analyticOrderNat(entireLMap(M, ξ), s)) -
    realNat(analyticOrderNat(entireLMap(M * d, quadTwist(M, ξ, d)), s))])

def pipOrderValues (d M : Nat, s : Set) : Set :=
  { pipOrderValue(d, M, s, ξ) | ξ ∈ dirichletCharacters(M) }

defgraph pipOrderTerms (d M : Nat, s : Set) (ξ ∈ dirichletCharacters(M)) :
    pipOrderValues(d, M, s) := pipOrderValue(d, M, s, ξ)
proof
  unfold pipOrderValues
  simp

def pipOrderSum (d M : Nat, s : Set) : Set :=
  groupFiniteSum(complexAdditiveGroup, dirichletCharacters(M),
    pipOrderTerms(d, M, s))

-- Φ(s) = (logDerivMean(s)/s − κ)/(s − 1) on ℂ.
defgraph pipPhi (d M : Nat) (s ∈ complexCarrier) : complexCarrier :=
    complexDiv(ℂ[complexDiv(logDerivMean(d, M, s), s) -
      complexOfReal(pipKappa(d, M))], ℂ[s - 1])
requires prime : Prime(d)
requires positive : (1:N) ≤ M
proof
  sorry

-- Section: The prime error
-- R_M(x) is real.
theorem pipPrimeError.real (d M : Nat, X : Real)
  requires prime : Prime(d)
  requires positive : (1:N) ≤ M
  shows primeError(d, M, X) ∈ ℝ
proof
  sorry

-- v ↦ R_M(e^v) is measurable.
theorem pipPrimeErrorExp.measurable (d M : Nat, E : Set)
  requires prime : Prime(d)
  requires positive : (1:N) ≤ M
  requires function : FunctionBetween(E, ℝ, ℝ)
  requires values : ∀ V ∈ ℝ, E(V) = primeError(d, M, realExp(V))
  shows Measurable(E, realMeasurableSpace, realMeasurableSpace)
proof
  sorry

-- |R_M(e^v)| ≤ (|κ| + 5) e^v for v ≥ 0.
theorem pipPrimeErrorExp.bound (d M : Nat, E : Set)
  requires prime : Prime(d)
  requires positive : (1:N) ≤ M
  requires values : ∀ V ∈ ℝ, E(V) = primeError(d, M, realExp(V))
  shows ∃ C ∈ ℝ, ∀ V ∈ ℝ, (0:R) ≤ V → abs(E(V)) ≤ R[C * realExp(V)]
proof
  sorry

-- Section: The function Φ
-- Φ is meromorphic on ℂ.
theorem pipPhi.meromorphic (d M : Nat)
  requires prime : Prime(d)
  requires sevenModEight : d % 8 = (7:N)
  requires coprime : gcd(M, d) = (1:N)
  requires positive : (1:N) ≤ M
  shows Meromorphic(pipPhi(d, M))
proof
  sorry

-- Φ(s) is the Laplace transform of v ↦ R_M(e^v) for re s > 2.
theorem pipPhi.laplace (d M : Nat, E : Set)
  requires prime : Prime(d)
  requires sevenModEight : d % 8 = (7:N)
  requires coprime : gcd(M, d) = (1:N)
  requires positive : (1:N) ≤ M
  requires function : FunctionBetween(E, ℝ, ℝ)
  requires values : ∀ V ∈ ℝ, E(V) = primeError(d, M, realExp(V))
  shows ∀ s ∈ complexCarrier, (2:R) < complexRe(s) →
    pipPhi(d, M)(s) = laplaceTransform(E, s)
proof
  sorry

-- (s − 1)Φ(s) is analytic on re s ≥ 1.
theorem pipPhi.analytic_one (d M : Nat)
  requires prime : Prime(d)
  requires sevenModEight : d % 8 = (7:N)
  requires coprime : gcd(M, d) = (1:N)
  requires positive : (1:N) ≤ M
  shows ComplexAnalyticOnNhd(subMulMap(pipPhi(d, M), ℂ[1]),
    closedRightHalfPlane(R[1]))
proof
  sorry

-- (z − ρ)Φ(z) → Σ_ξ (ord_ρ L̃(ξ) − ord_ρ L̃(ξ(·/d))) / (φ(M) ρ (1 − ρ))
-- as z → ρ, for re ρ > 0.
theorem pipPhi.residue (d M : Nat, ρ : Set)
  requires prime : Prime(d)
  requires sevenModEight : d % 8 = (7:N)
  requires coprime : gcd(M, d) = (1:N)
  requires positive : (1:N) ≤ M
  requires hρ : ρ ∈ complexCarrier
  requires right : (0:R) < complexRe(ρ)
  shows HasPuncturedLimit(subMulMap(pipPhi(d, M), ρ), ρ,
    complexDiv(pipOrderSum(d, M, ρ),
      ℂ[complexOfReal(realNat(totient(M))) * (ρ * (1 - ρ))]))
proof
  sorry

-- A finite sum of reals taken in ℂ.
theorem pipFiniteSum.of_real (V t u : Set)
  requires finite : Finite(V)
  requires values : ∀ i ∈ V, t(i) ∈ ℝ
  requires embedded : ∀ i ∈ V, u(i) = complexOfReal(t(i))
  shows groupFiniteSum(complexAdditiveGroup, V, u) =
    complexOfReal(realFiniteSum(t, V))
proof
  sorry

end PolarTools
