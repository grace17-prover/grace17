-- Tools for the polarity of the prime error (isPolar_primeError): the
-- meromorphic function Φ(s) = (logDerivMean(s)/s − κ)/(s − 1), κ the real
-- part of logDerivMean(1), its local form near every point (the orders of
-- the L-functions L̃(s, ξ) and L̃(s, ξ(·/d)) as residues), its
-- analyticity at re s ≥ 1, and its agreement with the Laplace transform of
-- v ↦ R_M(e^v) for re s > 2.
-- Source: grh-compact/src/New/Endgame/PrimeError.lean (isPolar_primeError).
-- Part of: One-sided bound for non-split primes gives a zero-free
-- half-plane (GRH.Proof.Endgame.OneSidedCriterion).
-- Part of the GRH blueprint (layer 5, the argument).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Proof.Endgame.PolarTools
import GRH.Proof.Endgame.PolarReal
import GRH.Proof.Endgame.PolarLocal

section PolarTools
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Section: Definitions
-- κ = re logDerivMean(1), the constant in R_M.
def pipKappa (d M : Nat) : Set := complexRe(logDerivMean(d, M, ℂ[1]))

-- ord_s L̃(ξ) − ord_s L̃(ξ(·/d)) in ℂ, as a function of ξ, and its sum
-- over the characters modulo M.
def pipOrderValue (d M : Nat, s ξ : Set) : Set :=
  complexOfReal(R[realNat(analyticOrderNat(entireLMap(M, ξ), s)) -
    realNat(analyticOrderNat(entireLMap(M * d, quadTwist(M, ξ, d)), s))])

def pipOrderValues (d M : Nat, s : Set) : Set :=
  { pipOrderValue(d, M, s, ξ) | ξ ∈ dirichletCharacters(M) }

defgraph pipOrderTerms (d M : Nat, s : Set) (ξ ∈ dirichletCharacters(M)) :
    pipOrderValues(d, M, s) := pipOrderValue(d, M, s, ξ)
proof
  unfold pipOrderValues
  simp

def pipOrderSum (d M : Nat, s : Set) : Set :=
  groupFiniteSum(complexAdditiveGroup, dirichletCharacters(M),
    pipOrderTerms(d, M, s))

-- Section: logDerivMean
-- Σ_ξ (L̃′/L̃(s, ξ(·/d)) − L̃′/L̃(s, ξ)) is a complex number.
theorem pipLogDerivSum.member (d M : Nat, s : Set)
  requires prime : Prime(d)
  requires positive : (1:N) ≤ M
  requires hs : s ∈ complexCarrier
  shows groupFiniteSum(complexAdditiveGroup, dirichletCharacters(M),
    logDerivMeanTerms(d, M, s)) ∈ complexCarrier
proof
  have ngC := complexAdditiveGroup.normed
  obtain ⟨c, m⟩ := complexAdditiveGroup.parts
  have mPositive : 0 < M by arith
  have finite := dirichletCharacters.finite with mPositive
  have values : ∀ ξ ∈ dirichletCharacters(M),
      logDerivMeanTerms(d, M, s)(ξ) ∈ Group.carrier(complexAdditiveGroup) by
    intros ξ hξ
    rw c
    exact pipLogDerivMeanTerms.member with prime, positive, hs, hξ
  have member := groupFiniteSum.member with ngC.left, finite, values
  rwa c at member

-- logDerivMean(s) is a complex number.
theorem pipLogDerivMean.member (d M : Nat, s : Set)
  requires prime : Prime(d)
  requires positive : (1:N) ≤ M
  requires hs : s ∈ complexCarrier
  shows logDerivMean(d, M, s) ∈ complexCarrier
proof
  have sum := pipLogDerivSum.member with prime, positive, hs
  unfold logDerivMean
  unfold complexDiv
  have totientC : complexOfReal(realNat(totient(M))) ∈ ℂ by typecheck
  have inverse := complexInv.member with totientC
  typecheck

-- Φ(s) = (logDerivMean(s)/s − κ)/(s − 1) on ℂ.
defgraph pipPhi (d M : Nat) (s ∈ complexCarrier) : complexCarrier :=
    complexDiv(ℂ[complexDiv(logDerivMean(d, M, s), s) -
      complexOfReal(pipKappa(d, M))], ℂ[s - 1])
requires prime : Prime(d)
requires positive : (1:N) ≤ M
proof
  have mean := pipLogDerivMean.member with prime, positive, member
  unfold pipKappa
  have oneC : ℂ[1] ∈ ℂ by typecheck
  have meanOne := pipLogDerivMean.member with prime, positive, oneC
  have meanDiv : complexDiv(logDerivMean(d, M, s), s) ∈ ℂ by
    unfold complexDiv
    have inverse := complexInv.member with member
    typecheck
  have shift : ℂ[s - 1] ∈ ℂ by typecheck
  have inverse := complexInv.member with shift
  unfold complexDiv
  typecheck

-- Section: Local forms of Σ_ξ L̃′/L̃ terms
-- K(z) = Σ_ξ (L̃′/L̃(z, ξ(·/d)) − L̃′/L̃(z, ξ)).
def pipK (d M : Nat, z : Set) : Set :=
  groupFiniteSum(complexAdditiveGroup, dirichletCharacters(M),
    logDerivMeanTerms(d, M, z))

-- z ↦ (z − a)^m (L̃′/L̃(z, ξ(·/d)) − L̃′/L̃(z, ξ)), and the family of these
-- over ξ.
defgraph pipTermMap (d M : Nat, a : Set, m : Nat, ξ : Set)
    (z ∈ complexCarrier) : complexCarrier :=
    ℂ[(z - a) ^ m * logDerivMeanTerms(d, M, z)(ξ)]
requires prime : Prime(d)
requires positive : (1:N) ≤ M
requires ha : a ∈ complexCarrier
requires hξ : ξ ∈ dirichletCharacters(M)
proof
  have term := pipLogDerivMeanTerms.member with prime, positive, member, hξ
  have difference : ℂ[z - a] ∈ ℂ by typecheck
  have power := complexPow.member at ℂ[z - a], m with difference
  typecheck

def pipTermValues (d M : Nat, a : Set, m : Nat) : Set :=
  { pipTermMap(d, M, a, m, ξ) | ξ ∈ dirichletCharacters(M) }

defgraph pipTermFamily (d M : Nat, a : Set, m : Nat)
    (ξ ∈ dirichletCharacters(M)) : pipTermValues(d, M, a, m) :=
    pipTermMap(d, M, a, m, ξ)
proof
  unfold pipTermValues
  simp

-- z ↦ (z − a)^m K(z).
defgraph pipKPow (d M : Nat, a : Set, m : Nat) (z ∈ complexCarrier) :
    complexCarrier := ℂ[(z - a) ^ m * pipK(d, M, z)]
requires prime : Prime(d)
requires positive : (1:N) ≤ M
requires ha : a ∈ complexCarrier
proof
  have sum := pipLogDerivSum.member with prime, positive, member
  have difference : ℂ[z - a] ∈ ℂ by typecheck
  have power := complexPow.member at ℂ[z - a], m with difference
  unfold pipK
  typecheck

-- Local forms of the terms give one of (z − a)^m K(z).
theorem pipKPow.local_of (d M : Nat, a : Set, m : Nat, c : Set)
  requires prime : Prime(d)
  requires positive : (1:N) ≤ M
  requires ha : a ∈ complexCarrier
  requires cValues : ∀ ξ ∈ dirichletCharacters(M), c(ξ) ∈ complexCarrier
  requires locals : ∀ ξ ∈ dirichletCharacters(M),
    pipLocal(pipTermMap(d, M, a, m, ξ), a, c(ξ))
  shows pipLocal(pipKPow(d, M, a, m), a,
    groupFiniteSum(complexAdditiveGroup, dirichletCharacters(M), c))
proof
  have mPositive : 0 < M by arith
  have finite := dirichletCharacters.finite with mPositive
  have values : ∀ i ∈ dirichletCharacters(M), ∀ w ∈ complexCarrier,
      pipTermFamily(d, M, a, m)(i)(w) ∈ complexCarrier by
    intros i hi w hw
    rw [(pipTermFamily.value at d, M, a, m, i with hi),
      (pipTermMap.value with prime, positive, ha, hi, hw)]
    exact pipTermMap.closed with prime, positive, ha, hi, hw
  have localsT : ∀ i ∈ dirichletCharacters(M),
      pipLocal(pipTermFamily(d, M, a, m)(i), a, c(i)) by
    intros i hi
    rw (pipTermFamily.value at d, M, a, m, i with hi)
    exact locals with i, hi
  have reflexive := Subset.reflexive at dirichletCharacters(M)
  have family := pipLocal.family with ha, values, cValues, localsT,
    reflexive, finite
  apply pipLocal.congr with family
  intros z hz distinct
  have atz : ∀ i ∈ dirichletCharacters(M),
      pipTermFamily(d, M, a, m)(i)(z) ∈ complexCarrier by
    intros i hi
    exact values with i, hi, z, hz
  have carrier := complexRing.carrierOf
  have mulOf := complexRing.mulOf
  have additive := complexAdditiveGroup.ring_additive
  have commutative := complexRing.comm_ring
  have difference : ℂ[z - a] ∈ ℂ by typecheck
  have power := complexPow.member at ℂ[z - a], m with difference
  have powerK : ℂ[(z - a) ^ m] ∈ Ring.carrier(complexRing) by
    rw carrier
    exact power
  have termValues : ∀ i ∈ dirichletCharacters(M),
      logDerivMeanTerms(d, M, z)(i) ∈ Ring.carrier(complexRing) by
    intros i hi
    rw carrier
    exact pipLogDerivMeanTerms.member with prime, positive, hz, hi
  have product : ∀ i ∈ dirichletCharacters(M),
      pipFamilyAt(pipTermFamily(d, M, a, m), dirichletCharacters(M), z)(i) =
        Ring.mul(complexRing)(ℂ[(z - a) ^ m], logDerivMeanTerms(d, M, z)(i)) by
    intros i hi
    rw [(pipFamilyAt.value with atz, hi), (pipTermFamily.value at d, M, a, m,
      i with hi), (pipTermMap.value with prime, positive, ha, hi, hz), mulOf]
  have split := groupFiniteSum.ring_mul_left with commutative, finite,
    powerK, termValues, product
  rw [← additive, mulOf] at split
  rw [(pipKPow.value with prime, positive, ha, hz),
    (pipFamilySum.value with values, finite, reflexive, hz), split]
  unfold pipK
  rfl

-- ord_a L̃(ξ(·/d)) − ord_a L̃(ξ), as ord + ord · (−1).
def pipTwistOrderValue (d M : Nat, s ξ : Set) : Set :=
  ℂ[complexOfReal(realNat(analyticOrderNat(entireLMap(M * d,
      quadTwist(M, ξ, d)), s))) +
    complexOfReal(realNat(analyticOrderNat(entireLMap(M, ξ), s))) * -1]

-- (z − a)(L̃′/L̃(z, ξ(·/d)) − L̃′/L̃(z, ξ)) has a local form at a of value
-- ord_a L̃(ξ(·/d)) − ord_a L̃(ξ).
theorem pipTermMap.local_pole (d M : Nat, a ξ : Set)
  requires prime : Prime(d)
  requires positive : (1:N) ≤ M
  requires ha : a ∈ complexCarrier
  requires hξ : ξ ∈ dirichletCharacters(M)
  shows pipLocal(pipTermMap(d, M, a, (1:N), ξ), a,
    pipTwistOrderValue(d, M, a, ξ))
proof
  have character := dirichletCharacters.membership.forward with hξ
  have twistCharacter := quadTwist.character at M, d, ξ with prime, character
  have dLarge := Prime.two_le with prime
  have dPositive : (1:N) ≤ d by arith
  have levelPositive := LessEqual.one_le_mul with positive, dPositive
  have values1 : ∀ z ∈ complexCarrier,
      logDerivEntireLMap(M, ξ)(z) ∈ complexCarrier by
    intros z hz
    rw (logDerivEntireLMap.value with positive, character, hz)
    exact logDerivEntireLMap.closed with positive, character, hz
  have values2 : ∀ z ∈ complexCarrier,
      logDerivEntireLMap(M * d, quadTwist(M, ξ, d))(z) ∈ complexCarrier by
    intros z hz
    rw (logDerivEntireLMap.value with levelPositive, twistCharacter, hz)
    exact logDerivEntireLMap.closed with levelPositive, twistCharacter, hz
  have whole := ComplexOpen.whole
  have minusOne : ℂ[-1] ∈ ℂ by typecheck
  have holoWhole := HolomorphicOn.const with whole, minusOne
  have one : R[1] ∈ ℝ by typecheck
  have onePositive : (0:R) < R[1] by linarith
  have openD := complexDisk.open with ha, one
  have diskSub := complexDisk.subset at a, R[1]
  have holoQ := HolomorphicOn.mono with holoWhole, openD, diskSub
  have valuesQ := holoWhole.right.left
  have local2 := pipLogDerivEntireL.local with levelPositive, twistCharacter,
    ha
  have local1 := pipLogDerivEntireL.local with positive, character, ha
  have valuesS1 : ComplexValuedOn(subMulMap(logDerivEntireLMap(M, ξ), a),
      complexCarrier) by
    intros z hz
    rw (subMulMap.value with values1, ha, hz)
    exact subMulMap.closed with values1, ha, hz
  have product : ∀ z ∈ complexCarrier, z ≠ a →
      complexFunctionMul(subMulMap(logDerivEntireLMap(M, ξ), a),
        complexFunctionConst(ℂ[-1], complexCarrier), complexCarrier)(z) =
      ℂ[subMulMap(logDerivEntireLMap(M, ξ), a)(z) *
        complexFunctionConst(ℂ[-1], complexCarrier)(z)] by
    intros z hz distinct
    exact complexFunctionMul.value with valuesS1, valuesQ, hz
  have negative := pipLocal.mul with ha, local1, onePositive, holoQ, product
  have sum : ∀ z ∈ complexCarrier, z ≠ a →
      pipTermMap(d, M, a, (1:N), ξ)(z) =
      ℂ[subMulMap(logDerivEntireLMap(M * d, quadTwist(M, ξ, d)), a)(z) +
        complexFunctionMul(subMulMap(logDerivEntireLMap(M, ξ), a),
          complexFunctionConst(ℂ[-1], complexCarrier), complexCarrier)(z)] by
    intros z hz distinct
    have v1 := values1 with z, hz
    have v2 := values2 with z, hz
    rw [(pipTermMap.value with prime, positive, ha, hξ, hz),
      (pipLogDerivMeanTerms.apply with hξ),
      (complexFunctionMul.value with valuesS1, valuesQ, hz),
      (subMulMap.value with values1, ha, hz),
      (subMulMap.value with values2, ha, hz),
      (complexFunctionConst.value with minusOne, hz),
      (logDerivEntireLMap.value with positive, character, hz),
      (logDerivEntireLMap.value with levelPositive, twistCharacter, hz)]
    rw [← (logDerivEntireLMap.value with positive, character, hz),
      ← (logDerivEntireLMap.value with levelPositive, twistCharacter, hz)]
    rw [monoidPow.succ, monoidPow.zero]
    ring
  have added := pipLocal.add with ha, local2, negative, sum
  rw (complexFunctionConst.value with minusOne, ha) at added
  unfold pipTwistOrderValue
  exact added

-- Where neither L̃(ξ(·/d)) nor L̃(ξ) vanishes at a, the term
-- L̃′/L̃(z, ξ(·/d)) − L̃′/L̃(z, ξ) has a local form of its value at a.
theorem pipTermMap.local_regular (d M : Nat, a ξ : Set)
  requires prime : Prime(d)
  requires positive : (1:N) ≤ M
  requires ha : a ∈ complexCarrier
  requires hξ : ξ ∈ dirichletCharacters(M)
  requires nonzero1 : entireL(M, ξ, a) ≠ ℂ[0]
  requires nonzero2 : entireL(M * d, quadTwist(M, ξ, d), a) ≠ ℂ[0]
  shows pipLocal(pipTermMap(d, M, a, (0:N), ξ), a,
    logDerivMeanTerms(d, M, a)(ξ))
proof
  have character := dirichletCharacters.membership.forward with hξ
  have twistCharacter := quadTwist.character at M, d, ξ with prime, character
  have dLarge := Prime.two_le with prime
  have dPositive : (1:N) ≤ d by arith
  have levelPositive := LessEqual.one_le_mul with positive, dPositive
  have values1 : ∀ z ∈ complexCarrier,
      logDerivEntireLMap(M, ξ)(z) ∈ complexCarrier by
    intros z hz
    rw (logDerivEntireLMap.value with positive, character, hz)
    exact logDerivEntireLMap.closed with positive, character, hz
  have values2 : ∀ z ∈ complexCarrier,
      logDerivEntireLMap(M * d, quadTwist(M, ξ, d))(z) ∈ complexCarrier by
    intros z hz
    rw (logDerivEntireLMap.value with levelPositive, twistCharacter, hz)
    exact logDerivEntireLMap.closed with levelPositive, twistCharacter, hz
  have whole := ComplexOpen.whole
  have minusOne : ℂ[-1] ∈ ℂ by typecheck
  have holoWhole := HolomorphicOn.const with whole, minusOne
  have one : R[1] ∈ ℝ by typecheck
  have onePositive : (0:R) < R[1] by linarith
  have openD := complexDisk.open with ha, one
  have diskSub := complexDisk.subset at a, R[1]
  have holoQ := HolomorphicOn.mono with holoWhole, openD, diskSub
  have valuesQ := holoWhole.right.left
  have local2 := pipLogDerivEntireL.local_regular with levelPositive,
    twistCharacter, ha, nonzero2
  have local1 := pipLogDerivEntireL.local_regular with positive, character,
    ha, nonzero1
  have product : ∀ z ∈ complexCarrier, z ≠ a →
      complexFunctionMul(logDerivEntireLMap(M, ξ),
        complexFunctionConst(ℂ[-1], complexCarrier), complexCarrier)(z) =
      ℂ[logDerivEntireLMap(M, ξ)(z) *
        complexFunctionConst(ℂ[-1], complexCarrier)(z)] by
    intros z hz distinct
    have valuesL1 : ComplexValuedOn(logDerivEntireLMap(M, ξ),
        complexCarrier) by
      intros w hw
      exact values1 with w, hw
    exact complexFunctionMul.value with valuesL1, valuesQ, hz
  have negative := pipLocal.mul with ha, local1, onePositive, holoQ, product
  have sum : ∀ z ∈ complexCarrier, z ≠ a →
      pipTermMap(d, M, a, (0:N), ξ)(z) =
      ℂ[logDerivEntireLMap(M * d, quadTwist(M, ξ, d))(z) +
        complexFunctionMul(logDerivEntireLMap(M, ξ),
          complexFunctionConst(ℂ[-1], complexCarrier), complexCarrier)(z)] by
    intros z hz distinct
    have v1 := values1 with z, hz
    have v2 := values2 with z, hz
    have valuesL1 : ComplexValuedOn(logDerivEntireLMap(M, ξ),
        complexCarrier) by
      intros w hw
      exact values1 with w, hw
    rw [(pipTermMap.value with prime, positive, ha, hξ, hz),
      (pipLogDerivMeanTerms.apply with hξ),
      (complexFunctionMul.value with valuesL1, valuesQ, hz),
      (complexFunctionConst.value with minusOne, hz),
      (logDerivEntireLMap.value with positive, character, hz),
      (logDerivEntireLMap.value with levelPositive, twistCharacter, hz)]
    rw [← (logDerivEntireLMap.value with positive, character, hz),
      ← (logDerivEntireLMap.value with levelPositive, twistCharacter, hz)]
    rw monoidPow.zero
    ring
  have added := pipLocal.add with ha, local2, negative, sum
  rw (complexFunctionConst.value with minusOne, ha) at added
  have l1 := pipLogDerivEntireL.member with positive, character, ha
  have l2 := pipLogDerivEntireL.member with levelPositive, twistCharacter, ha
  have value : ℂ[logDerivEntireL(M * d, quadTwist(M, ξ, d), a) +
      logDerivEntireL(M, ξ, a) * -1] = logDerivMeanTerms(d, M, a)(ξ) by
    rw (pipLogDerivMeanTerms.apply with hξ)
    ring
  rw value at added
  exact added

def pipTwistOrderValues (d M : Nat, s : Set) : Set :=
  { pipTwistOrderValue(d, M, s, ξ) | ξ ∈ dirichletCharacters(M) }

defgraph pipTwistOrders (d M : Nat, s : Set) (ξ ∈ dirichletCharacters(M)) :
    pipTwistOrderValues(d, M, s) := pipTwistOrderValue(d, M, s, ξ)
proof
  unfold pipTwistOrderValues
  simp

-- (z − a) K(z) has a local form at a of value
-- Σ_ξ (ord_a L̃(ξ(·/d)) − ord_a L̃(ξ)).
theorem pipKPow.local_pole (d M : Nat, a : Set)
  requires prime : Prime(d)
  requires positive : (1:N) ≤ M
  requires ha : a ∈ complexCarrier
  shows pipLocal(pipKPow(d, M, a, (1:N)), a,
    groupFiniteSum(complexAdditiveGroup, dirichletCharacters(M),
      pipTwistOrders(d, M, a)))
proof
  have cValues : ∀ ξ ∈ dirichletCharacters(M),
      pipTwistOrders(d, M, a)(ξ) ∈ complexCarrier by
    intros ξ hξ
    have character := dirichletCharacters.membership.forward with hξ
    have twistCharacter := quadTwist.character at M, d, ξ with prime,
      character
    have dLarge := Prime.two_le with prime
    have dPositive : (1:N) ≤ d by arith
    have levelPositive := LessEqual.one_le_mul with positive, dPositive
    have facts1 := entireL.order_facts with positive, character, ha
    have facts2 := entireL.order_facts with levelPositive, twistCharacter, ha
    have n1 := nat.omega.backward at analyticOrderNat(entireLMap(M, ξ), a)
      with facts1.left
    have n2 := nat.omega.backward at analyticOrderNat(entireLMap(M * d,
      quadTwist(M, ξ, d)), a) with facts2.left
    rw (pipTwistOrders.value at d, M, a, ξ with hξ)
    unfold pipTwistOrderValue
    typecheck
  have locals : ∀ ξ ∈ dirichletCharacters(M),
      pipLocal(pipTermMap(d, M, a, (1:N), ξ), a, pipTwistOrders(d, M, a)(ξ))
    by
    intros ξ hξ
    rw (pipTwistOrders.value at d, M, a, ξ with hξ)
    exact pipTermMap.local_pole with prime, positive, ha, hξ
  exact pipKPow.local_of with prime, positive, ha, cValues, locals

-- Where no L̃(ξ) or L̃(ξ(·/d)) vanishes at a, K has a local form of value
-- K(a).
theorem pipKPow.local_regular (d M : Nat, a : Set)
  requires prime : Prime(d)
  requires positive : (1:N) ≤ M
  requires ha : a ∈ complexCarrier
  requires nonzero : ∀ ξ ∈ dirichletCharacters(M),
    entireL(M, ξ, a) ≠ ℂ[0] ∧ entireL(M * d, quadTwist(M, ξ, d), a) ≠ ℂ[0]
  shows pipLocal(pipKPow(d, M, a, (0:N)), a, pipK(d, M, a))
proof
  have cValues : ∀ ξ ∈ dirichletCharacters(M),
      logDerivMeanTerms(d, M, a)(ξ) ∈ complexCarrier by
    intros ξ hξ
    exact pipLogDerivMeanTerms.member with prime, positive, ha, hξ
  have locals : ∀ ξ ∈ dirichletCharacters(M),
      pipLocal(pipTermMap(d, M, a, (0:N), ξ), a,
        logDerivMeanTerms(d, M, a)(ξ)) by
    intros ξ hξ
    obtain ⟨nonzero1, nonzero2⟩ := nonzero with ξ, hξ
    exact pipTermMap.local_regular with prime, positive, ha, hξ, nonzero1,
      nonzero2
  have local := pipKPow.local_of with prime, positive, ha, cValues, locals
  unfold pipK
  exact local

-- R_M(x) is real.
theorem pipPrimeError.real (d M : Nat, X : Real)
  requires prime : Prime(d)
  requires positive : (1:N) ≤ M
  shows primeError(d, M, X) ∈ ℝ
proof
  have zero := pipLambdaSum.real at d, M, (0:N), X
  have one := pipLambdaSum.real at d, M, (1:N), X
  have oneC : ℂ[1] ∈ ℂ by typecheck
  have mean := pipLogDerivMean.member with prime, positive, oneC
  unfold primeError
  typecheck

-- v ↦ R_M(e^v) is measurable.
theorem pipPrimeErrorExp.measurable (d M : Nat, E : Set)
  requires prime : Prime(d)
  requires positive : (1:N) ≤ M
  requires function : FunctionBetween(E, ℝ, ℝ)
  requires values : ∀ V ∈ ℝ, E(V) = primeError(d, M, realExp(V))
  shows Measurable(E, realMeasurableSpace, realMeasurableSpace)
proof
  have oneC : ℂ[1] ∈ ℂ by typecheck
  have mean := pipLogDerivMean.member with prime, positive, oneC
  have kappa : complexRe(logDerivMean(d, M, ℂ[1])) ∈ ℝ by typecheck
  have kT : Real(complexRe(logDerivMean(d, M, ℂ[1]))) by typecheck
  have inverseT : Real(realInvValue(realNat(totient(M)))) by typecheck
  have head := pip2Head.measurable at d, M
  have affine := pip2Affine.measurable at R[-complexRe(logDerivMean(d, M,
    ℂ[1]))], R[-realInvValue(realNat(totient(M)))]
  have oneNonzero : (1:R) ≠ 0 by
    intro equal
    linarith
  have inverseOne := realInvValue.mul_left at (1:R) with oneNonzero
  have invOneT : Real(realInvValue((1:R))) by typecheck
  have times : R[realInvValue((1:R)) * 1] = realInvValue((1:R)) by ring
  rw times at inverseOne
  have invOne : realInvValue((1:R)) = (1:R) := inverseOne
  apply Measurable.real_add with head, affine
  intros V hV
  rw realMeasurableSpace.carrier at hV
  have vReal : Real(V) by typecheck
  have step0 := pip2Step.closed at d, M, (0:N), V with hV
  have step1 := pip2Step.closed at d, M, (1:N), V with hV
  have expT : Real(realExp(V)) by typecheck
  have pow0 : R[realExp(V) ^ (0:N)] = (1:R) by
    rw monoidPow.zero
  have pow1 : R[realExp(V) ^ (1:N)] = realExp(V) by
    rw [monoidPow.succ, monoidPow.zero]
    ring
  rw [(values with V, hV), (pip2Head.value with hV), (pip2Tail.value with hV),
    (pip2Product.value with hV), (pip2InvExp.value with hV),
    (pip2Affine.value with hV), (pip2Scale.value with hV)]
  have s0 : Real(realPartialSum(lambdaSumTerms(d, M, (0:N)),
      natFloor(realExp(V)))) by
    exact step0
  have s1 : Real(realPartialSum(lambdaSumTerms(d, M, (1:N)),
      natFloor(realExp(V)))) by
    exact step1
  rw [(pip2Step.value at d, M, (0:N), V with hV),
    (pip2Step.value at d, M, (1:N), V with hV)]
  unfold primeError
  unfold lambdaSum
  rw [pow0, pow1, realLog.of_exp, realDiv.eq_mul_inv, realDiv.eq_mul_inv,
    realDiv.eq_mul_inv, invOne]
  ring

-- |R_M(e^v)| ≤ (|κ| + 5) e^v for v ≥ 0.
theorem pipPrimeErrorExp.bound (d M : Nat, E : Set)
  requires prime : Prime(d)
  requires positive : (1:N) ≤ M
  requires values : ∀ V ∈ ℝ, E(V) = primeError(d, M, realExp(V))
  shows ∃ C ∈ ℝ, ∀ V ∈ ℝ, (0:R) ≤ V → abs(E(V)) ≤ R[C * realExp(V)]
proof
  have oneC : ℂ[1] ∈ ℂ by typecheck
  have mean := pipLogDerivMean.member with prime, positive, oneC
  have kappaReal : complexRe(logDerivMean(d, M, ℂ[1])) ∈ ℝ by typecheck
  have kT : Real(complexRe(logDerivMean(d, M, ℂ[1]))) by typecheck
  have cReal : R[abs(complexRe(logDerivMean(d, M, ℂ[1]))) + 5] ∈ ℝ by
    typecheck
  refine ⟨R[abs(complexRe(logDerivMean(d, M, ℂ[1]))) + 5], cReal, ?_⟩
  intros V hV nonneg
  have vT : Real(V) by typecheck
  have mPositive : 0 < M by arith
  have totientPositive := totient.positive with mPositive
  have totientOne : 1 ≤ totient(M) by arith
  have pOne := realNat.one_le at totient(M) with totientOne
  have pNonzero : realNat(totient(M)) ≠ (0:R) by
    intro zero
    linarith
  have expOne := realExp.one_add_le at V
  have zeroB := lambdaSum.abs_exp_le at d, M, (0:N), V with prime
  have oneB := lambdaSum.abs_exp_le at d, M, (1:N), V with prime
  have zeroR := pipLambdaSum.real at d, M, (0:N), realExp(V)
  have oneR := pipLambdaSum.real at d, M, (1:N), realExp(V)
  have zeroT : Real(lambdaSum(d, M, (0:N), realExp(V))) by typecheck
  have oneT : Real(lambdaSum(d, M, (1:N), realExp(V))) by typecheck
  have zeroU := abs.upper at lambdaSum(d, M, (0:N), realExp(V))
  have zeroL := abs.upper_neg at lambdaSum(d, M, (0:N), realExp(V))
  have oneU := abs.upper at lambdaSum(d, M, (1:N), realExp(V))
  have oneL := abs.upper_neg at lambdaSum(d, M, (1:N), realExp(V))
  have kU := abs.upper at complexRe(logDerivMean(d, M, ℂ[1]))
  have kL := abs.upper_neg at complexRe(logDerivMean(d, M, ℂ[1]))
  have kN := abs.nonnegative at complexRe(logDerivMean(d, M, ℂ[1]))
  -- 0 ≤ v/φ(M) ≤ v.
  have quotient := realDiv.mul_right at V, realNat(totient(M)) with pNonzero
  have invPositive := realInvValue.positive at realNat(totient(M))
  have pPositive : (0:R) < realNat(totient(M)) by linarith
  have invPos := invPositive with pPositive
  have invNonneg : (0:R) ≤ realInvValue(realNat(totient(M))) by linarith
  have shape := realDiv.eq_mul_inv at V, realNat(totient(M))
  have qNonneg0 := realLe.mul_right_of_nonnegative at (0:R), V,
    realInvValue(realNat(totient(M))) with nonneg, invNonneg
  have invT : Real(realInvValue(realNat(totient(M)))) by typecheck
  have zeroMul : R[0 * realInvValue(realNat(totient(M)))] = (0:R) by ring
  have qNonneg : (0:R) ≤ R[V / realNat(totient(M))] by
    rw shape
    linarith
  have qScaled := realLe.mul_right_of_nonnegative at (1:R),
    realNat(totient(M)), R[V / realNat(totient(M))] with pOne, qNonneg
  have qT : Real(R[V / realNat(totient(M))]) by typecheck
  have pT : Real(realNat(totient(M))) by typecheck
  have commute : R[realNat(totient(M)) * (V / realNat(totient(M)))] =
    R[(V / realNat(totient(M))) * realNat(totient(M))] by ring
  have oneMul : R[1 * (V / realNat(totient(M)))] =
    R[V / realNat(totient(M))] by ring
  have qLe : R[V / realNat(totient(M))] ≤ V by linarith
  -- |κ| ≤ |κ| e^v.
  have expGe : (1:R) ≤ realExp(V) by linarith
  have kScaled := realLe.mul_right_of_nonnegative at (1:R), realExp(V),
    abs(complexRe(logDerivMean(d, M, ℂ[1]))) with expGe, kN
  have eT : Real(realExp(V)) by typecheck
  have aT : Real(abs(complexRe(logDerivMean(d, M, ℂ[1])))) by typecheck
  have expand : R[(abs(complexRe(logDerivMean(d, M, ℂ[1]))) + 5) *
      realExp(V)] = R[abs(complexRe(logDerivMean(d, M, ℂ[1]))) * realExp(V) +
      5 * realExp(V)] by ring
  have swapK : R[realExp(V) * abs(complexRe(logDerivMean(d, M, ℂ[1])))] =
    R[abs(complexRe(logDerivMean(d, M, ℂ[1]))) * realExp(V)] by ring
  have oneK : R[1 * abs(complexRe(logDerivMean(d, M, ℂ[1])))] =
    abs(complexRe(logDerivMean(d, M, ℂ[1]))) by ring
  have value := values with V, hV
  rw value
  unfold primeError
  rw (realLog.of_exp at V)
  apply abs.le_of_bounds
  . linarith
  . linarith

-- Section: The residues of Φ
-- z ↦ 1/(φ(M) z (z − 1)) on ℂ.
defgraph pipInvPoly (M : Nat) (z ∈ complexCarrier) : complexCarrier :=
    complexDiv(ℂ[1], ℂ[complexOfReal(realNat(totient(M))) * (z * (z - 1))])
proof
  have denominator : ℂ[complexOfReal(realNat(totient(M))) * (z * (z - 1))] ∈
    ℂ by typecheck
  have inverse := complexInv.member with denominator
  unfold complexDiv
  typecheck

-- φ(M) ≠ 0 in ℂ.
theorem pipTotient.nonzero (M : Nat)
  requires positive : (1:N) ≤ M
  shows complexOfReal(realNat(totient(M))) ≠ ℂ[0]
proof
  have mPositive : 0 < M by arith
  have totientPositive := totient.positive with mPositive
  have totientNonzero : totient(M) ≠ (0:N) by arith
  have pPositive := realNat.positive at totient(M) with totientNonzero
  intro equal
  rw ← complexOfReal.zero at equal
  have same := complexOfReal.injective with equal
  linarith

-- Away from 0 and 1, z ↦ 1/(φ(M) z (z − 1)) is holomorphic on a disk
-- that misses 0 and 1.
theorem pipInvPoly.holomorphic (M : Nat, ρ : Set)
  requires positive : (1:N) ≤ M
  requires hρ : ρ ∈ complexCarrier
  requires notZero : ρ ≠ ℂ[0]
  requires notOne : ρ ≠ ℂ[1]
  shows ∃ r ∈ ℝ, (0:R) < r ∧ HolomorphicOn(pipInvPoly(M), complexDisk(ρ, r)) ∧
    (∀ z ∈ complexDisk(ρ, r), z ≠ ℂ[0] ∧ z ≠ ℂ[1])
proof
  have oneC : ℂ[1] ∈ ℂ by typecheck
  have shifted : ℂ[ρ - 1] ∈ ℂ by typecheck
  have shiftedNonzero : ℂ[ρ - 1] ≠ ℂ[0] by
    intro equal
    apply notOne
    have shape : ρ = ℂ[(ρ - 1) + 1] by ring
    rw [shape, equal]
    ring
  have abs0 := complexAbs.positive with hρ, notZero
  have abs1 := complexAbs.positive with shifted, shiftedNonzero
  have absR0 : complexAbs(ρ) ∈ ℝ by typecheck
  have absR1 : complexAbs(ℂ[ρ - 1]) ∈ ℝ by typecheck
  obtain ⟨r, hr, rPositive, r0, r1⟩ := realRadius.common with absR0, absR1,
    abs0, abs1
  have avoid : ∀ z ∈ complexDisk(ρ, r), z ≠ ℂ[0] ∧ z ≠ ℂ[1] by
    intros z hz
    obtain ⟨zC, close⟩ := complexDisk.membership.forward with hz
    refine ⟨?_, ?_⟩
    . intro zero
      rw zero at close
      have shape : ℂ[0 - ρ] = ℂ[-ρ] by ring
      rw [shape, (complexAbs.neg with hρ)] at close
      linarith
    . intro one
      rw one at close
      rw (complexAbs.dist_symm with oneC, hρ) at close
      linarith
  have openD := complexDisk.open with hρ, hr
  have diskSub := complexDisk.subset at ρ, r
  have pIn : complexOfReal(realNat(totient(M))) ∈ ℂ by typecheck
  have pNonzero := pipTotient.nonzero with positive
  have holoOne := HolomorphicOn.const with openD, oneC
  have holoP := HolomorphicOn.const with openD, pIn
  have holoId := HolomorphicOn.id with openD
  have holoW := lndPowerMap.holomorphic at ℂ[1], complexDisk(ρ, r), (1:N)
    with oneC, openD
  have holoZW := HolomorphicOn.mul with holoId, holoW
  have holoD := HolomorphicOn.mul with holoP, holoZW
  have valuesOne := holoOne.right.left
  have valuesP := holoP.right.left
  have valuesId := holoId.right.left
  have valuesW := holoW.right.left
  have valuesZW := holoZW.right.left
  have valuesD := holoD.right.left
  have dValue : ∀ z ∈ complexDisk(ρ, r), complexFunctionMul(
      complexFunctionConst(complexOfReal(realNat(totient(M))),
        complexDisk(ρ, r)), complexFunctionMul(complexFunctionId(
        complexDisk(ρ, r)), cxaPowerMap(ℂ[1], (1:N)), complexDisk(ρ, r)),
      complexDisk(ρ, r))(z) =
      ℂ[complexOfReal(realNat(totient(M))) * (z * (z - 1))] by
    intros z hz
    have zC := diskSub with z, hz
    rw [(complexFunctionMul.value with valuesP, valuesZW, hz),
      (complexFunctionMul.value with valuesId, valuesW, hz),
      (complexFunctionConst.value with pIn, hz),
      (complexFunctionId.value with diskSub, hz),
      (cxaPowerMap.value at ℂ[1], (1:N), z with oneC, zC),
      monoidPow.succ, monoidPow.zero]
    ring
  have nonvanishing : ∀ z ∈ complexDisk(ρ, r), complexFunctionMul(
      complexFunctionConst(complexOfReal(realNat(totient(M))),
        complexDisk(ρ, r)), complexFunctionMul(complexFunctionId(
        complexDisk(ρ, r)), cxaPowerMap(ℂ[1], (1:N)), complexDisk(ρ, r)),
      complexDisk(ρ, r))(z) ≠ ℂ[0] by
    intros z hz
    have zC := diskSub with z, hz
    obtain ⟨zNonzero, zNotOne⟩ := avoid with z, hz
    have wIn : ℂ[z - 1] ∈ ℂ by typecheck
    have wNonzero : ℂ[z - 1] ≠ ℂ[0] by
      intro equal
      apply zNotOne
      have shape : z = ℂ[(z - 1) + 1] by ring
      rw [shape, equal]
      ring
    have zwIn : ℂ[z * (z - 1)] ∈ ℂ by typecheck
    have zwNonzero : ℂ[z * (z - 1)] ≠ ℂ[0] by
      intro equal
      have zero := complexMul.eq_zero_cancel_left with zC, wIn, zNonzero, equal
      exact wNonzero with zero
    rw (dValue with z, hz)
    intro equal
    have zero := complexMul.eq_zero_cancel_left with pIn, zwIn, pNonzero, equal
    exact zwNonzero with zero
  have quotient := HolomorphicOn.div with holoOne, holoD, nonvanishing
  have agree : ∀ z ∈ complexDisk(ρ, r), complexFunctionDiv(
      complexFunctionConst(ℂ[1], complexDisk(ρ, r)), complexFunctionMul(
      complexFunctionConst(complexOfReal(realNat(totient(M))),
        complexDisk(ρ, r)), complexFunctionMul(complexFunctionId(
        complexDisk(ρ, r)), cxaPowerMap(ℂ[1], (1:N)), complexDisk(ρ, r)),
      complexDisk(ρ, r)), complexDisk(ρ, r))(z) = pipInvPoly(M)(z) by
    intros z hz
    have zC := diskSub with z, hz
    rw [(complexFunctionDiv.value with valuesOne, valuesD, hz),
      (complexFunctionConst.value with oneC, hz), (dValue with z, hz),
      (pipInvPoly.value at M, z with zC)]
  have holo := HolomorphicOn.congr with quotient, agree
  exact ⟨r, hr, rPositive, holo, avoid⟩

-- z ↦ (z − ρ)(−1 − φ(M) κ z) on ℂ, entire.
defgraph pipAffine (d M : Nat, ρ : Set) (z ∈ complexCarrier) : complexCarrier :=
    ℂ[(z - ρ) * (-1 - complexOfReal(realNat(totient(M))) *
      complexOfReal(pipKappa(d, M)) * z)]
requires prime : Prime(d)
requires positive : (1:N) ≤ M
requires hρ : ρ ∈ complexCarrier
proof
  have oneC : ℂ[1] ∈ ℂ by typecheck
  have mean := pipLogDerivMean.member with prime, positive, oneC
  have kappa : complexOfReal(pipKappa(d, M)) ∈ ℂ by
    unfold pipKappa
    typecheck
  typecheck

theorem pipAffine.holomorphic (d M : Nat, ρ : Set)
  requires prime : Prime(d)
  requires positive : (1:N) ≤ M
  requires hρ : ρ ∈ complexCarrier
  shows HolomorphicOn(pipAffine(d, M, ρ), complexCarrier)
proof
  have oneC : ℂ[1] ∈ ℂ by typecheck
  have mean := pipLogDerivMean.member with prime, positive, oneC
  have whole := ComplexOpen.whole
  have sub : complexCarrier ⊆ complexCarrier by
    intros z hz
    exact hz
  have kappa : complexOfReal(pipKappa(d, M)) ∈ ℂ by
    unfold pipKappa
    typecheck
  have minusOne : ℂ[-1] ∈ ℂ by typecheck
  have slope : ℂ[-(complexOfReal(realNat(totient(M))) *
    complexOfReal(pipKappa(d, M)))] ∈ ℂ by typecheck
  have holoA := HolomorphicOn.const with whole, minusOne
  have holoB := HolomorphicOn.const with whole, slope
  have holoId := HolomorphicOn.id with whole
  have holoBz := HolomorphicOn.mul with holoB, holoId
  have holoL := HolomorphicOn.add with holoA, holoBz
  have holoP := lndPowerMap.holomorphic at ρ, complexCarrier, (1:N) with hρ,
    whole
  have holoAll := HolomorphicOn.mul with holoP, holoL
  have valuesA := holoA.right.left
  have valuesB := holoB.right.left
  have valuesId := holoId.right.left
  have valuesBz := holoBz.right.left
  have valuesL := holoL.right.left
  have valuesP := holoP.right.left
  apply HolomorphicOn.congr with holoAll
  intros z hz
  rw [(complexFunctionMul.value with valuesP, valuesL, hz),
    (complexFunctionAdd.value with valuesA, valuesBz, hz),
    (complexFunctionMul.value with valuesB, valuesId, hz),
    (complexFunctionConst.value with minusOne, hz),
    (complexFunctionConst.value with slope, hz),
    (complexFunctionId.value with sub, hz),
    (cxaPowerMap.value at ρ, (1:N), z with hρ, hz),
    (pipAffine.value at d, M, ρ, z with prime, positive, hρ, hz), monoidPow.succ,
    monoidPow.zero]
  ring

-- Σ_ξ (ord L̃(ξ(·/d)) − ord L̃(ξ)) = −Σ_ξ (ord L̃(ξ) − ord L̃(ξ(·/d))).
theorem pipTwistOrders.sum (d M : Nat, s : Set)
  requires prime : Prime(d)
  requires positive : (1:N) ≤ M
  requires hs : s ∈ complexCarrier
  shows groupFiniteSum(complexAdditiveGroup, dirichletCharacters(M),
      pipTwistOrders(d, M, s)) = ℂ[-1 * pipOrderSum(d, M, s)]
proof
  have mPositive : 0 < M by arith
  have finite := dirichletCharacters.finite with mPositive
  have carrier := complexRing.carrierOf
  have mulOf := complexRing.mulOf
  have additive := complexAdditiveGroup.ring_additive
  have commutative := complexRing.comm_ring
  have minusOne : ℂ[-1] ∈ Ring.carrier(complexRing) by
    rw carrier
    typecheck
  have naturals : ∀ ξ ∈ dirichletCharacters(M),
      Nat(analyticOrderNat(entireLMap(M, ξ), s)) ∧
      Nat(analyticOrderNat(entireLMap(M * d, quadTwist(M, ξ, d)), s)) by
    intros ξ hξ
    have character := dirichletCharacters.membership.forward with hξ
    have twistCharacter := quadTwist.character at M, d, ξ with prime,
      character
    have dLarge := Prime.two_le with prime
    have dPositive : (1:N) ≤ d by arith
    have levelPositive := LessEqual.one_le_mul with positive, dPositive
    have facts1 := entireL.order_facts with positive, character, hs
    have facts2 := entireL.order_facts with levelPositive, twistCharacter, hs
    have n1 := nat.omega.backward at analyticOrderNat(entireLMap(M, ξ), s)
      with facts1.left
    have n2 := nat.omega.backward at analyticOrderNat(entireLMap(M * d,
      quadTwist(M, ξ, d)), s) with facts2.left
    exact ⟨n1, n2⟩
  have values : ∀ ξ ∈ dirichletCharacters(M),
      pipOrderTerms(d, M, s)(ξ) ∈ Ring.carrier(complexRing) by
    intros ξ hξ
    obtain ⟨n1, n2⟩ := naturals with ξ, hξ
    rw [carrier, (pipOrderTerms.value at d, M, s, ξ with hξ)]
    unfold pipOrderValue
    typecheck
  have product : ∀ ξ ∈ dirichletCharacters(M),
      pipTwistOrders(d, M, s)(ξ) =
        Ring.mul(complexRing)(ℂ[-1], pipOrderTerms(d, M, s)(ξ)) by
    intros ξ hξ
    obtain ⟨n1, n2⟩ := naturals with ξ, hξ
    rw [mulOf, (pipTwistOrders.value at d, M, s, ξ with hξ),
      (pipOrderTerms.value at d, M, s, ξ with hξ)]
    unfold pipTwistOrderValue
    unfold pipOrderValue
    rw complexOfReal.sub
    ring
  have split := groupFiniteSum.ring_mul_left with commutative, finite,
    minusOne, values, product
  rw [← additive, mulOf] at split
  unfold pipOrderSum
  rw split

-- (z − ρ) Φ(z) = ((z − ρ) K(z) + (z − ρ)(−1 − φ(M) κ z)) / (φ(M) z (z − 1))
-- for z ≠ 0, 1.
theorem pipPhi.sub_mul_eq (d M : Nat, ρ z : Set)
  requires prime : Prime(d)
  requires positive : (1:N) ≤ M
  requires hρ : ρ ∈ complexCarrier
  requires hz : z ∈ complexCarrier
  requires zNonzero : z ≠ ℂ[0]
  requires zNotOne : z ≠ ℂ[1]
  shows ℂ[(z - ρ) * pipPhi(d, M)(z)] =
    ℂ[ℂ[(z - ρ) * pipK(d, M, z) + pipAffine(d, M, ρ)(z)] * pipInvPoly(M)(z)]
proof
  have oneC : ℂ[1] ∈ ℂ by typecheck
  have meanOne := pipLogDerivMean.member with prime, positive, oneC
  have kappa : complexOfReal(pipKappa(d, M)) ∈ ℂ by
    unfold pipKappa
    typecheck
  have sum := pipLogDerivSum.member with prime, positive, hz
  have pIn : complexOfReal(realNat(totient(M))) ∈ ℂ by typecheck
  have pNonzero := pipTotient.nonzero with positive
  have wIn : ℂ[z - 1] ∈ ℂ by typecheck
  have wNonzero : ℂ[z - 1] ≠ ℂ[0] by
    intro equal
    apply zNotOne
    have shape : z = ℂ[(z - 1) + 1] by ring
    rw [shape, equal]
    ring
  have zwIn : ℂ[z * (z - 1)] ∈ ℂ by typecheck
  have zwNonzero : ℂ[z * (z - 1)] ≠ ℂ[0] by
    intro equal
    have zero := complexMul.eq_zero_cancel_left with hz, wIn, zNonzero, equal
    exact wNonzero with zero
  have dIn : ℂ[complexOfReal(realNat(totient(M))) * (z * (z - 1))] ∈ ℂ by
    typecheck
  have dNonzero : ℂ[complexOfReal(realNat(totient(M))) * (z * (z - 1))] ≠
      ℂ[0] by
    intro equal
    have zero := complexMul.eq_zero_cancel_left with pIn, zwIn, pNonzero, equal
    exact zwNonzero with zero
  have hP := complexInv.mul_cancel with pIn, pNonzero
  have hZ := complexInv.mul_cancel with hz, zNonzero
  have hW := complexInv.mul_cancel with wIn, wNonzero
  have hD := complexInv.mul_cancel with dIn, dNonzero
  have iP := complexInv.member with pIn
  have iZ := complexInv.member with hz
  have iW := complexInv.member with wIn
  have iD := complexInv.member with dIn
  rw [(pipPhi.value with prime, positive, hz),
    (pipAffine.value with prime, positive, hρ, hz),
    (pipInvPoly.value at M, z with hz)]
  unfold logDerivMean
  unfold pipK
  unfold complexDiv
  linear_combination ((z - ρ) * complexInv(ℂ[z - 1]) *
      complexOfReal(pipKappa(d, M)) * z * complexInv(z) +
    ((z - ρ) * (groupFiniteSum(complexAdditiveGroup, dirichletCharacters(M),
      logDerivMeanTerms(d, M, z)) - 1 - complexOfReal(realNat(totient(M))) *
      complexOfReal(pipKappa(d, M)) * z)) *
    complexInv(ℂ[complexOfReal(realNat(totient(M))) * (z * (z - 1))]) * z *
      complexInv(z) * (z - 1) * complexInv(ℂ[z - 1])) * hP +
    ((z - ρ) * complexInv(ℂ[z - 1]) * complexOfReal(pipKappa(d, M)) +
    ((z - ρ) * (groupFiniteSum(complexAdditiveGroup, dirichletCharacters(M),
      logDerivMeanTerms(d, M, z)) - 1 - complexOfReal(realNat(totient(M))) *
      complexOfReal(pipKappa(d, M)) * z)) *
    complexInv(ℂ[complexOfReal(realNat(totient(M))) * (z * (z - 1))]) *
      (z - 1) * complexInv(ℂ[z - 1])) * hZ +
    ((z - ρ) * (groupFiniteSum(complexAdditiveGroup, dirichletCharacters(M),
      logDerivMeanTerms(d, M, z)) - 1 - complexOfReal(realNat(totient(M))) *
      complexOfReal(pipKappa(d, M)) * z)) *
    complexInv(ℂ[complexOfReal(realNat(totient(M))) * (z * (z - 1))]) * hW -
    ((z - ρ) * (groupFiniteSum(complexAdditiveGroup, dirichletCharacters(M),
      logDerivMeanTerms(d, M, z)) - 1 - complexOfReal(realNat(totient(M))) *
      complexOfReal(pipKappa(d, M)) * z)) *
    complexInv(complexOfReal(realNat(totient(M)))) * complexInv(z) *
      complexInv(ℂ[z - 1]) * hD

-- Σ_ξ (ord L̃(ξ) − ord L̃(ξ(·/d))) is a complex number.
theorem pipOrderSum.member (d M : Nat, ρ : Set)
  requires prime : Prime(d)
  requires positive : (1:N) ≤ M
  requires hρ : ρ ∈ complexCarrier
  shows pipOrderSum(d, M, ρ) ∈ ℂ
proof
  have mPositive : 0 < M by arith
  have finite := dirichletCharacters.finite with mPositive
  have ngC := complexAdditiveGroup.normed
  obtain ⟨gc, gm⟩ := complexAdditiveGroup.parts
  have orderValues : ∀ ξ ∈ dirichletCharacters(M),
      pipOrderTerms(d, M, ρ)(ξ) ∈ Group.carrier(complexAdditiveGroup) by
    intros ξ hξ
    have character := dirichletCharacters.membership.forward with hξ
    have twistCharacter := quadTwist.character at M, d, ξ with prime,
      character
    have dLarge := Prime.two_le with prime
    have dPositive : (1:N) ≤ d by arith
    have levelPositive := LessEqual.one_le_mul with positive, dPositive
    have facts1 := entireL.order_facts with positive, character, hρ
    have facts2 := entireL.order_facts with levelPositive, twistCharacter, hρ
    have n1 := nat.omega.backward at analyticOrderNat(entireLMap(M, ξ), ρ)
      with facts1.left
    have n2 := nat.omega.backward at analyticOrderNat(entireLMap(M * d,
      quadTwist(M, ξ, d)), ρ) with facts2.left
    rw [gc, (pipOrderTerms.value at d, M, ρ, ξ with hξ)]
    unfold pipOrderValue
    typecheck
  have sumIn := groupFiniteSum.member with ngC.left, finite, orderValues
  rw gc at sumIn
  unfold pipOrderSum
  exact sumIn

-- φ(M) ρ (ρ − 1) and φ(M) ρ (1 − ρ) are not 0 for ρ ≠ 0, 1.
theorem pipDenominators.nonzero (M : Nat, ρ : Set)
  requires positive : (1:N) ≤ M
  requires hρ : ρ ∈ complexCarrier
  requires notZero : ρ ≠ ℂ[0]
  requires notOne : ρ ≠ ℂ[1]
  shows ℂ[complexOfReal(realNat(totient(M))) * (ρ * (ρ - 1))] ≠ ℂ[0] ∧
    ℂ[complexOfReal(realNat(totient(M))) * (ρ * (1 - ρ))] ≠ ℂ[0]
proof
  have pIn : complexOfReal(realNat(totient(M))) ∈ ℂ by typecheck
  have pNonzero := pipTotient.nonzero with positive
  have aIn : ℂ[ρ - 1] ∈ ℂ by typecheck
  have bIn : ℂ[1 - ρ] ∈ ℂ by typecheck
  have aNonzero : ℂ[ρ - 1] ≠ ℂ[0] by
    intro equal
    apply notOne
    have shape : ρ = ℂ[(ρ - 1) + 1] by ring
    rw [shape, equal]
    ring
  have bNonzero : ℂ[1 - ρ] ≠ ℂ[0] by
    intro equal
    apply notOne
    have shape : ρ = ℂ[1 - (1 - ρ)] by ring
    rw [shape, equal]
    ring
  have raIn : ℂ[ρ * (ρ - 1)] ∈ ℂ by typecheck
  have rbIn : ℂ[ρ * (1 - ρ)] ∈ ℂ by typecheck
  have raNonzero : ℂ[ρ * (ρ - 1)] ≠ ℂ[0] by
    intro equal
    exact aNonzero with (complexMul.eq_zero_cancel_left with hρ, aIn,
      notZero, equal)
  have rbNonzero : ℂ[ρ * (1 - ρ)] ≠ ℂ[0] by
    intro equal
    exact bNonzero with (complexMul.eq_zero_cancel_left with hρ, bIn,
      notZero, equal)
  refine ⟨?_, ?_⟩
  . intro equal
    exact raNonzero with (complexMul.eq_zero_cancel_left with pIn, raIn,
      pNonzero, equal)
  . intro equal
    exact rbNonzero with (complexMul.eq_zero_cancel_left with pIn, rbIn,
      pNonzero, equal)

-- (z − ρ) Φ(z) has a local form at ρ ≠ 0, 1.
theorem pipPhi.local_off_one (d M : Nat, ρ : Set)
  requires prime : Prime(d)
  requires positive : (1:N) ≤ M
  requires hρ : ρ ∈ complexCarrier
  requires notZero : ρ ≠ ℂ[0]
  requires notOne : ρ ≠ ℂ[1]
  shows pipLocal(subMulMap(pipPhi(d, M), ρ), ρ, ℂ[ℂ[groupFiniteSum(
    complexAdditiveGroup, dirichletCharacters(M), pipTwistOrders(d, M, ρ)) +
    pipAffine(d, M, ρ)(ρ)] * pipInvPoly(M)(ρ)])
proof
  obtain ⟨r, hr, rPositive, holoQ, avoid⟩ := pipInvPoly.holomorphic with
    positive, hρ, notZero, notOne
  have pole := pipKPow.local_pole with prime, positive, hρ
  have one : R[1] ∈ ℝ by typecheck
  have onePositive : (0:R) < R[1] by linarith
  have openD := complexDisk.open with hρ, one
  have diskSub := complexDisk.subset at ρ, R[1]
  have holoA := pipAffine.holomorphic with prime, positive, hρ
  have holoAD := HolomorphicOn.mono with holoA, openD, diskSub
  have localA := pipLocal.of_holomorphic with hρ, onePositive, holoAD
  have valuesF : ComplexValuedOn(pipKPow(d, M, ρ, (1:N)), complexCarrier) by
    intros z hz
    rw (pipKPow.value with prime, positive, hρ, hz)
    exact pipKPow.closed with prime, positive, hρ, hz
  have valuesA := holoA.right.left
  have valuesQ : ComplexValuedOn(pipInvPoly(M), complexCarrier) by
    intros z hz
    rw (pipInvPoly.value at M, z with hz)
    exact pipInvPoly.closed at M, z with hz
  have sumRelation : ∀ z ∈ complexCarrier, z ≠ ρ →
      complexFunctionAdd(pipKPow(d, M, ρ, (1:N)), pipAffine(d, M, ρ),
        complexCarrier)(z) =
      ℂ[pipKPow(d, M, ρ, (1:N))(z) + pipAffine(d, M, ρ)(z)] by
    intros z hz distinct
    exact complexFunctionAdd.value with valuesF, valuesA, hz
  have added := pipLocal.add with hρ, pole, localA, sumRelation
  have valuesS : ComplexValuedOn(complexFunctionAdd(pipKPow(d, M, ρ, (1:N)),
      pipAffine(d, M, ρ), complexCarrier), complexCarrier) by
    intros z hz
    rw (complexFunctionAdd.value with valuesF, valuesA, hz)
    exact complexFunctionAdd.closed with valuesF, valuesA, hz
  have productRelation : ∀ z ∈ complexCarrier, z ≠ ρ →
      complexFunctionMul(complexFunctionAdd(pipKPow(d, M, ρ, (1:N)),
        pipAffine(d, M, ρ), complexCarrier), pipInvPoly(M),
        complexCarrier)(z) =
      ℂ[complexFunctionAdd(pipKPow(d, M, ρ, (1:N)), pipAffine(d, M, ρ),
        complexCarrier)(z) * pipInvPoly(M)(z)] by
    intros z hz distinct
    exact complexFunctionMul.value with valuesS, valuesQ, hz
  have multiplied := pipLocal.mul with hρ, added, rPositive, holoQ,
    productRelation
  have valuesPhi : ∀ w ∈ complexCarrier, pipPhi(d, M)(w) ∈ complexCarrier by
    intros w hw
    rw (pipPhi.value with prime, positive, hw)
    exact pipPhi.closed with prime, positive, hw
  have agree : ∀ z ∈ complexDisk(ρ, r), z ≠ ρ →
      subMulMap(pipPhi(d, M), ρ)(z) =
      complexFunctionMul(complexFunctionAdd(pipKPow(d, M, ρ, (1:N)),
        pipAffine(d, M, ρ), complexCarrier), pipInvPoly(M),
        complexCarrier)(z) by
    intros z hz distinct
    have zC := (complexDisk.membership.forward with hz).left
    obtain ⟨zNonzero, zNotOne⟩ := avoid with z, hz
    have kz := pipLogDerivSum.member with prime, positive, zC
    have az := valuesA with z, zC
    have qz := valuesQ with z, zC
    rw [(subMulMap.value with valuesPhi, hρ, zC),
      (pipPhi.sub_mul_eq with prime, positive, hρ, zC, zNonzero, zNotOne),
      (complexFunctionMul.value with valuesS, valuesQ, zC),
      (complexFunctionAdd.value with valuesF, valuesA, zC),
      (pipKPow.value with prime, positive, hρ, zC), monoidPow.succ,
      monoidPow.zero]
    unfold pipK
    ring
  exact pipLocal.congr_disk with hρ, multiplied, rPositive, agree

-- The residue of Φ at ρ ≠ 0, 1.
theorem pipPhi.residue_off_one (d M : Nat, ρ : Set)
  requires prime : Prime(d)
  requires positive : (1:N) ≤ M
  requires hρ : ρ ∈ complexCarrier
  requires notZero : ρ ≠ ℂ[0]
  requires notOne : ρ ≠ ℂ[1]
  shows HasPuncturedLimit(subMulMap(pipPhi(d, M), ρ), ρ,
    complexDiv(pipOrderSum(d, M, ρ),
      ℂ[complexOfReal(realNat(totient(M))) * (ρ * (1 - ρ))]))
proof
  have local := pipPhi.local_off_one with prime, positive, hρ, notZero, notOne
  have valuesPhi : ∀ w ∈ complexCarrier, pipPhi(d, M)(w) ∈ complexCarrier by
    intros w hw
    rw (pipPhi.value with prime, positive, hw)
    exact pipPhi.closed with prime, positive, hw
  have valuesSub : ∀ z ∈ complexCarrier,
      subMulMap(pipPhi(d, M), ρ)(z) ∈ complexCarrier by
    intros z hz
    rw (subMulMap.value with valuesPhi, hρ, hz)
    exact subMulMap.closed with valuesPhi, hρ, hz
  have limit := pipLocal.limit with hρ, local, valuesSub
  -- The value: −S/(φ ρ (ρ − 1)) = S/(φ ρ (1 − ρ)).
  have mPositive : 0 < M by arith
  have finite := dirichletCharacters.finite with mPositive
  have ngC := complexAdditiveGroup.normed
  obtain ⟨gc, gm⟩ := complexAdditiveGroup.parts
  have sumIn2 := pipOrderSum.member with prime, positive, hρ
  obtain ⟨dNonzero, d2Nonzero⟩ := pipDenominators.nonzero with positive, hρ,
    notZero, notOne
  have dIn : ℂ[complexOfReal(realNat(totient(M))) * (ρ * (ρ - 1))] ∈ ℂ by
    typecheck
  have d2In : ℂ[complexOfReal(realNat(totient(M))) * (ρ * (1 - ρ))] ∈ ℂ by
    typecheck
  have h1 := complexInv.mul_cancel with dIn, dNonzero
  have h2 := complexInv.mul_cancel with d2In, d2Nonzero
  have i1 := complexInv.member with dIn
  have i2 := complexInv.member with d2In
  have kappa : complexOfReal(pipKappa(d, M)) ∈ ℂ by
    have oneC : ℂ[1] ∈ ℂ by typecheck
    have meanOne := pipLogDerivMean.member with prime, positive, oneC
    unfold pipKappa
    typecheck
  have constant : ℂ[ℂ[groupFiniteSum(complexAdditiveGroup,
      dirichletCharacters(M), pipTwistOrders(d, M, ρ)) +
      pipAffine(d, M, ρ)(ρ)] * pipInvPoly(M)(ρ)] =
      complexDiv(pipOrderSum(d, M, ρ),
        ℂ[complexOfReal(realNat(totient(M))) * (ρ * (1 - ρ))]) by
    rw [(pipTwistOrders.sum with prime, positive, hρ),
      (pipAffine.value with prime, positive, hρ, hρ),
      (pipInvPoly.value at M, ρ with hρ)]
    unfold complexDiv
    linear_combination (pipOrderSum(d, M, ρ) *
      complexInv(ℂ[complexOfReal(realNat(totient(M))) * (ρ * (1 - ρ))])) *
      h1 + (pipOrderSum(d, M, ρ) *
      complexInv(ℂ[complexOfReal(realNat(totient(M))) * (ρ * (ρ - 1))])) * h2
  rw constant at limit
  exact limit

-- z ↦ 1/(φ(M)(z − b)) on ℂ.
defgraph pipInvLin (M : Nat, b : Set) (z ∈ complexCarrier) : complexCarrier :=
    complexDiv(ℂ[1], ℂ[complexOfReal(realNat(totient(M))) * (z - b)])
requires hb : b ∈ complexCarrier
proof
  have denominator : ℂ[complexOfReal(realNat(totient(M))) * (z - b)] ∈ ℂ by
    typecheck
  have inverse := complexInv.member with denominator
  unfold complexDiv
  typecheck

theorem pipInvLin.holomorphic (M : Nat, a b : Set)
  requires positive : (1:N) ≤ M
  requires ha : a ∈ complexCarrier
  requires hb : b ∈ complexCarrier
  requires distinct : a ≠ b
  shows ∃ r ∈ ℝ, (0:R) < r ∧ HolomorphicOn(pipInvLin(M, b), complexDisk(a, r)) ∧
    (∀ z ∈ complexDisk(a, r), z ≠ b)
proof
  have shifted : ℂ[a - b] ∈ ℂ by typecheck
  have shiftedNonzero : ℂ[a - b] ≠ ℂ[0] by
    intro equal
    apply distinct
    have shape : a = ℂ[(a - b) + b] by ring
    rw [shape, equal]
    ring
  have abs1 := complexAbs.positive with shifted, shiftedNonzero
  have hr : complexAbs(ℂ[a - b]) ∈ ℝ by typecheck
  have avoid : ∀ z ∈ complexDisk(a, complexAbs(ℂ[a - b])), z ≠ b by
    intros z hz
    obtain ⟨zC, close⟩ := complexDisk.membership.forward with hz
    intro same
    rw same at close
    rw (complexAbs.dist_symm with hb, ha) at close
    linarith
  have openD := complexDisk.open with ha, hr
  have diskSub := complexDisk.subset at a, complexAbs(ℂ[a - b])
  have pIn : complexOfReal(realNat(totient(M))) ∈ ℂ by typecheck
  have pNonzero := pipTotient.nonzero with positive
  have oneC : ℂ[1] ∈ ℂ by typecheck
  have holoOne := HolomorphicOn.const with openD, oneC
  have holoP := HolomorphicOn.const with openD, pIn
  have holoW := lndPowerMap.holomorphic at b, complexDisk(a,
    complexAbs(ℂ[a - b])), (1:N) with hb, openD
  have holoD := HolomorphicOn.mul with holoP, holoW
  have valuesOne := holoOne.right.left
  have valuesP := holoP.right.left
  have valuesW := holoW.right.left
  have valuesD := holoD.right.left
  have dValue : ∀ z ∈ complexDisk(a, complexAbs(ℂ[a - b])), complexFunctionMul(
      complexFunctionConst(complexOfReal(realNat(totient(M))),
        complexDisk(a, complexAbs(ℂ[a - b]))), cxaPowerMap(b, (1:N)),
      complexDisk(a, complexAbs(ℂ[a - b])))(z) =
      ℂ[complexOfReal(realNat(totient(M))) * (z - b)] by
    intros z hz
    have zC := diskSub with z, hz
    rw [(complexFunctionMul.value with valuesP, valuesW, hz),
      (complexFunctionConst.value with pIn, hz),
      (cxaPowerMap.value at b, (1:N), z with hb, zC), monoidPow.succ,
      monoidPow.zero]
    ring
  have nonvanishing : ∀ z ∈ complexDisk(a, complexAbs(ℂ[a - b])),
      complexFunctionMul(complexFunctionConst(
        complexOfReal(realNat(totient(M))), complexDisk(a,
        complexAbs(ℂ[a - b]))), cxaPowerMap(b, (1:N)),
        complexDisk(a, complexAbs(ℂ[a - b])))(z) ≠ ℂ[0] by
    intros z hz
    have zC := diskSub with z, hz
    have wIn : ℂ[z - b] ∈ ℂ by typecheck
    have wNonzero : ℂ[z - b] ≠ ℂ[0] by
      intro equal
      apply (avoid with z, hz)
      have shape : z = ℂ[(z - b) + b] by ring
      rw [shape, equal]
      ring
    rw (dValue with z, hz)
    intro equal
    exact wNonzero with (complexMul.eq_zero_cancel_left with pIn, wIn,
      pNonzero, equal)
  have quotient := HolomorphicOn.div with holoOne, holoD, nonvanishing
  have agree : ∀ z ∈ complexDisk(a, complexAbs(ℂ[a - b])), complexFunctionDiv(
      complexFunctionConst(ℂ[1], complexDisk(a, complexAbs(ℂ[a - b]))),
      complexFunctionMul(complexFunctionConst(
        complexOfReal(realNat(totient(M))), complexDisk(a,
        complexAbs(ℂ[a - b]))), cxaPowerMap(b, (1:N)),
        complexDisk(a, complexAbs(ℂ[a - b]))),
      complexDisk(a, complexAbs(ℂ[a - b])))(z) = pipInvLin(M, b)(z) by
    intros z hz
    have zC := diskSub with z, hz
    rw [(complexFunctionDiv.value with valuesOne, valuesD, hz),
      (complexFunctionConst.value with oneC, hz), (dValue with z, hz),
      (pipInvLin.value at M, b, z with hb, zC)]
  have holo := HolomorphicOn.congr with quotient, agree
  exact ⟨complexAbs(ℂ[a - b]), hr, abs1, holo, avoid⟩

-- At a ∈ {0, 1} (b the other point), (z − a)² Φ(z) has a local form.
theorem pipPhi.local_endpoint (d M : Nat, a b : Set)
  requires prime : Prime(d)
  requires positive : (1:N) ≤ M
  requires pair : (a = ℂ[0] ∧ b = ℂ[1]) ∨ (a = ℂ[1] ∧ b = ℂ[0])
  shows ∃ c, pipLocal(complexFunctionMul(cxaPowerMap(a, (2:N)), pipPhi(d, M),
    complexCarrier), a, c)
proof
  have ha : a ∈ complexCarrier by
    rcases pair with ⟨same, _⟩ | ⟨same, _⟩
    . rw same
      typecheck
    . rw same
      typecheck
  have hb : b ∈ complexCarrier by
    rcases pair with ⟨_, same⟩ | ⟨_, same⟩
    . rw same
      typecheck
    . rw same
      typecheck
  have nontrivial := complexes.nontrivial
  unfold Nontrivial at nontrivial
  obtain ⟨_, _, zeroOne⟩ := nontrivial
  have distinct : a ≠ b by
    intro equal
    rcases pair with ⟨sa, sb⟩ | ⟨sa, sb⟩
    . rw [sa, sb] at equal
      exact zeroOne with equal
    . rw [sa, sb] at equal
      apply zeroOne
      rw equal
  have split : ∀ z ∈ complexCarrier, ℂ[z * (z - 1)] = ℂ[(z - a) * (z - b)]
    by
    intros z hz
    rcases pair with ⟨sa, sb⟩ | ⟨sa, sb⟩
    . rw [sa, sb]
      ring
    . rw [sa, sb]
      ring
  obtain ⟨r, hr, rPositive, holoQ, avoid⟩ := pipInvLin.holomorphic with
    positive, ha, hb, distinct
  have pole := pipKPow.local_pole with prime, positive, ha
  have one : R[1] ∈ ℝ by typecheck
  have onePositive : (0:R) < R[1] by linarith
  have openD := complexDisk.open with ha, one
  have diskSub := complexDisk.subset at a, R[1]
  have holoA := pipAffine.holomorphic with prime, positive, ha
  have holoAD := HolomorphicOn.mono with holoA, openD, diskSub
  have localA := pipLocal.of_holomorphic with ha, onePositive, holoAD
  have valuesF : ComplexValuedOn(pipKPow(d, M, a, (1:N)), complexCarrier) by
    intros z hz
    rw (pipKPow.value with prime, positive, ha, hz)
    exact pipKPow.closed with prime, positive, ha, hz
  have valuesA := holoA.right.left
  have valuesQ : ComplexValuedOn(pipInvLin(M, b), complexCarrier) by
    intros z hz
    rw (pipInvLin.value at M, b, z with hb, hz)
    exact pipInvLin.closed at M, b, z with hb, hz
  have sumRelation : ∀ z ∈ complexCarrier, z ≠ a →
      complexFunctionAdd(pipKPow(d, M, a, (1:N)), pipAffine(d, M, a),
        complexCarrier)(z) =
      ℂ[pipKPow(d, M, a, (1:N))(z) + pipAffine(d, M, a)(z)] by
    intros z hz distinctZ
    exact complexFunctionAdd.value with valuesF, valuesA, hz
  have added := pipLocal.add with ha, pole, localA, sumRelation
  have valuesS : ComplexValuedOn(complexFunctionAdd(pipKPow(d, M, a, (1:N)),
      pipAffine(d, M, a), complexCarrier), complexCarrier) by
    intros z hz
    rw (complexFunctionAdd.value with valuesF, valuesA, hz)
    exact complexFunctionAdd.closed with valuesF, valuesA, hz
  have productRelation : ∀ z ∈ complexCarrier, z ≠ a →
      complexFunctionMul(complexFunctionAdd(pipKPow(d, M, a, (1:N)),
        pipAffine(d, M, a), complexCarrier), pipInvLin(M, b),
        complexCarrier)(z) =
      ℂ[complexFunctionAdd(pipKPow(d, M, a, (1:N)), pipAffine(d, M, a),
        complexCarrier)(z) * pipInvLin(M, b)(z)] by
    intros z hz distinctZ
    exact complexFunctionMul.value with valuesS, valuesQ, hz
  have multiplied := pipLocal.mul with ha, added, rPositive, holoQ,
    productRelation
  have valuesPhi : ComplexValuedOn(pipPhi(d, M), complexCarrier) by
    intros w hw
    rw (pipPhi.value with prime, positive, hw)
    exact pipPhi.closed with prime, positive, hw
  have valuesPow : ComplexValuedOn(cxaPowerMap(a, (2:N)), complexCarrier) by
    intros w hw
    rw (cxaPowerMap.value at a, (2:N), w with ha, hw)
    exact cxaPowerMap.closed at a, (2:N), w with ha, hw
  have agree : ∀ z ∈ complexDisk(a, r), z ≠ a →
      complexFunctionMul(cxaPowerMap(a, (2:N)), pipPhi(d, M),
        complexCarrier)(z) =
      complexFunctionMul(complexFunctionAdd(pipKPow(d, M, a, (1:N)),
        pipAffine(d, M, a), complexCarrier), pipInvLin(M, b),
        complexCarrier)(z) by
    intros z hz distinctZ
    have zC := (complexDisk.membership.forward with hz).left
    have zNotB := avoid with z, hz
    have zNonzero : z ≠ ℂ[0] by
      rcases pair with ⟨sa, sb⟩ | ⟨sa, sb⟩
      . rw ← sa
        exact distinctZ
      . rw ← sb
        exact zNotB
    have zNotOne : z ≠ ℂ[1] by
      rcases pair with ⟨sa, sb⟩ | ⟨sa, sb⟩
      . rw ← sb
        exact zNotB
      . rw ← sa
        exact distinctZ
    have h := pipPhi.sub_mul_eq with prime, positive, ha, zC, zNonzero,
      zNotOne
    have kz := pipLogDerivSum.member with prime, positive, zC
    have kzK : pipK(d, M, z) ∈ ℂ by
      unfold pipK
      exact kz
    have az := valuesA with z, zC
    have phiZ := valuesPhi with z, zC
    have pIn : complexOfReal(realNat(totient(M))) ∈ ℂ by typecheck
    have pNonzero := pipTotient.nonzero with positive
    have eIn : ℂ[complexOfReal(realNat(totient(M))) * (z - b)] ∈ ℂ by
      typecheck
    have wIn : ℂ[z - b] ∈ ℂ by typecheck
    have wNonzero : ℂ[z - b] ≠ ℂ[0] by
      intro equal
      apply zNotB
      have shape : z = ℂ[(z - b) + b] by ring
      rw [shape, equal]
      ring
    have eNonzero : ℂ[complexOfReal(realNat(totient(M))) * (z - b)] ≠ ℂ[0] by
      intro equal
      exact wNonzero with (complexMul.eq_zero_cancel_left with pIn, wIn,
        pNonzero, equal)
    have dIn : ℂ[complexOfReal(realNat(totient(M))) * (z * (z - 1))] ∈ ℂ by
      typecheck
    have zwIn : ℂ[z * (z - 1)] ∈ ℂ by typecheck
    have vIn : ℂ[z - a] ∈ ℂ by typecheck
    have vNonzero : ℂ[z - a] ≠ ℂ[0] by
      intro equal
      apply distinctZ
      have shape : z = ℂ[(z - a) + a] by ring
      rw [shape, equal]
      ring
    have zwNonzero : ℂ[z * (z - 1)] ≠ ℂ[0] by
      rw (split with z, zC)
      intro equal
      exact wNonzero with (complexMul.eq_zero_cancel_left with vIn, wIn,
        vNonzero, equal)
    have dNonzero : ℂ[complexOfReal(realNat(totient(M))) * (z * (z - 1))] ≠
        ℂ[0] by
      intro equal
      exact zwNonzero with (complexMul.eq_zero_cancel_left with pIn, zwIn,
        pNonzero, equal)
    have hE := complexInv.mul_cancel with eIn, eNonzero
    have hD := complexInv.mul_cancel with dIn, dNonzero
    have iE := complexInv.member with eIn
    have iD := complexInv.member with dIn
    have splitZ := split with z, zC
    rw (pipInvPoly.value at M, z with zC) at h
    rw [(complexFunctionMul.value with valuesPow, valuesPhi, zC),
      (complexFunctionMul.value with valuesS, valuesQ, zC),
      (complexFunctionAdd.value with valuesF, valuesA, zC),
      (pipKPow.value with prime, positive, ha, zC),
      (cxaPowerMap.value at a, (2:N), z with ha, zC),
      (pipInvLin.value at M, b, z with hb, zC)]
    unfold complexDiv at h
    unfold complexDiv
    rw [monoidPow.succ, monoidPow.succ, monoidPow.zero]
    linear_combination (z - a) * h - ((z - a) * ((z - a) * pipK(d, M, z) +
      pipAffine(d, M, a)(z)) * complexInv(ℂ[complexOfReal(realNat(
      totient(M))) * (z * (z - 1))])) * hE + (((z - a) * pipK(d, M, z) +
      pipAffine(d, M, a)(z)) * complexInv(ℂ[complexOfReal(realNat(
      totient(M))) * (z - b)])) * hD - (((z - a) * pipK(d, M, z) +
      pipAffine(d, M, a)(z)) * complexInv(ℂ[complexOfReal(realNat(
      totient(M))) * (z - b)]) * complexInv(ℂ[complexOfReal(realNat(
      totient(M))) * (z * (z - 1))]) * complexOfReal(realNat(totient(M)))) *
      splitZ
  have local := pipLocal.congr_disk with ha, multiplied, rPositive, agree
  exact ⟨ℂ[ℂ[groupFiniteSum(complexAdditiveGroup, dirichletCharacters(M),
    pipTwistOrders(d, M, a)) + pipAffine(d, M, a)(a)] *
    pipInvLin(M, b)(a)], local⟩

-- Section: Φ near re s ≥ 1
-- logDerivMean(1) is real: logDerivMean(1) = κ (conjugate characters).
theorem pipLogDerivMean.real_one (d M : Nat)
  requires prime : Prime(d)
  requires positive : (1:N) ≤ M
  shows logDerivMean(d, M, ℂ[1]) = complexOfReal(pipKappa(d, M))
proof
  have oneC : ℂ[1] ∈ ℂ by typecheck
  have reOne : complexRe(ℂ[1]) = R[1] by
    rw [← complexOfReal.one, complexOfReal.re]
  have halfPlane : (1:R) ≤ complexRe(ℂ[1]) by
    rw reOne
    linarith
  have dLarge := Prime.two_le with prime
  have dPositive : (1:N) ≤ d by arith
  have levelPositive := LessEqual.one_le_mul with positive, dPositive
  have nonzero : ∀ ξ ∈ dirichletCharacters(M),
      entireL(M, ξ, ℂ[1]) ≠ ℂ[0] ∧
        entireL(M * d, quadTwist(M, ξ, d), ℂ[1]) ≠ ℂ[0] by
    intros ξ hξ
    have character := dirichletCharacters.membership.forward with hξ
    have twistCharacter := quadTwist.character at M, d, ξ with prime,
      character
    have first := entireL.ne_zero with positive, character, oneC, halfPlane
    have second := entireL.ne_zero with levelPositive, twistCharacter, oneC,
      halfPlane
    exact ⟨first, second⟩
  have local := pipKPow.local_regular with prime, positive, oneC, nonzero
  obtain ⟨t, tReal, tPositive, H, holomorphic, center, agree⟩ := local
  have real : ∀ X ∈ ℝ, (1:R) < X →
      complexAbs(ℂ[complexOfReal(X) - 1]) < t →
      complexIm(H(complexOfReal(X))) = (0:R) by
    intros X xReal above near
    have xC : complexOfReal(X) ∈ ℂ by typecheck
    have inDisk : complexOfReal(X) ∈ complexDisk(ℂ[1], t) by
      unfold complexDisk
      exact ⟨xC, near⟩
    have distinct : complexOfReal(X) ≠ ℂ[1] by
      intro equal
      have re := complexOfReal.re at X
      rw [equal, reOne] at re
      linarith
    have sum := pipLogDerivSum.member with prime, positive, xC
    have value := agree with complexOfReal(X), inDisk, distinct
    rw [(pipKPow.value with prime, positive, oneC, xC), monoidPow.zero] at
      value
    have same : ℂ[1 * pipK(d, M, complexOfReal(X))] =
        pipK(d, M, complexOfReal(X)) by
      unfold pipK
      ring
    rw [same] at value
    rw ← value
    unfold pipK
    exact pip2LogDerivSum.im_zero with prime, positive, above
  have imOne := pip2Holomorphic.im_zero_at_one with tPositive, holomorphic,
    real
  rw center at imOne
  have sumOne := pipLogDerivSum.member with prime, positive, oneC
  have kReal : pipK(d, M, ℂ[1]) = complexOfReal(complexRe(pipK(d, M, ℂ[1])))
    by
    unfold pipK
    unfold pipK at imOne
    exact pip2Complex.of_im_zero with sumOne, imOne
  have kRe := complexRe.real with sumOne
  have totientNonzero : realNat(totient(M)) ≠ R[0] by
    intro equal
    have bad := pipTotient.nonzero with positive
    rw [equal, complexOfReal.zero] at bad
    apply bad
    rfl
  have mean := pipLogDerivMean.member with prime, positive, oneC
  have imMean : complexIm(logDerivMean(d, M, ℂ[1])) = (0:R) by
    unfold logDerivMean
    unfold complexDiv
    unfold pipK at kReal
    rw [kReal, ← complexOfReal.one, ← complexOfReal.sub,
      ← (complexOfReal.inv with totientNonzero), ← complexOfReal.mul,
      complexOfReal.im]
  unfold pipKappa
  exact pip2Complex.of_im_zero with mean, imMean

-- z ↦ −1 − φ(M) κ z on ℂ, entire.
defgraph pipLine (d M : Nat) (z ∈ complexCarrier) : complexCarrier :=
    ℂ[-1 - complexOfReal(realNat(totient(M))) * complexOfReal(pipKappa(d, M)) *
      z]
requires prime : Prime(d)
requires positive : (1:N) ≤ M
proof
  have oneC : ℂ[1] ∈ ℂ by typecheck
  have mean := pipLogDerivMean.member with prime, positive, oneC
  have kappa : complexOfReal(pipKappa(d, M)) ∈ ℂ by
    unfold pipKappa
    typecheck
  typecheck

theorem pipLine.holomorphic (d M : Nat)
  requires prime : Prime(d)
  requires positive : (1:N) ≤ M
  shows HolomorphicOn(pipLine(d, M), complexCarrier)
proof
  have oneC : ℂ[1] ∈ ℂ by typecheck
  have mean := pipLogDerivMean.member with prime, positive, oneC
  have whole := ComplexOpen.whole
  have sub : complexCarrier ⊆ complexCarrier by
    intros z hz
    exact hz
  have kappa : complexOfReal(pipKappa(d, M)) ∈ ℂ by
    unfold pipKappa
    typecheck
  have minusOne : ℂ[-1] ∈ ℂ by typecheck
  have slope : ℂ[-(complexOfReal(realNat(totient(M))) *
    complexOfReal(pipKappa(d, M)))] ∈ ℂ by typecheck
  have holoA := HolomorphicOn.const with whole, minusOne
  have holoB := HolomorphicOn.const with whole, slope
  have holoId := HolomorphicOn.id with whole
  have holoBz := HolomorphicOn.mul with holoB, holoId
  have holoL := HolomorphicOn.add with holoA, holoBz
  have valuesA := holoA.right.left
  have valuesB := holoB.right.left
  have valuesId := holoId.right.left
  have valuesBz := holoBz.right.left
  apply HolomorphicOn.congr with holoL
  intros z hz
  rw [(complexFunctionAdd.value with valuesA, valuesBz, hz),
    (complexFunctionMul.value with valuesB, valuesId, hz),
    (complexFunctionConst.value with minusOne, hz),
    (complexFunctionConst.value with slope, hz),
    (complexFunctionId.value with sub, hz),
    (pipLine.value with prime, positive, hz)]
  ring

-- G(z) = (K(z) − 1 − φ(M) κ z)/(φ(M) z), built on (z − a)⁰ K(z).
def pipG (d M : Nat, a : Set) : Set :=
  complexFunctionMul(complexFunctionAdd(pipKPow(d, M, a, (0:N)),
    pipLine(d, M), complexCarrier), pipInvLin(M, ℂ[0]), complexCarrier)

-- The values of G.
theorem pipG.value (d M : Nat, a z : Set)
  requires prime : Prime(d)
  requires positive : (1:N) ≤ M
  requires ha : a ∈ complexCarrier
  requires hz : z ∈ complexCarrier
  shows pipG(d, M, a)(z) = ℂ[ℂ[pipK(d, M, z) + pipLine(d, M)(z)] *
    complexDiv(ℂ[1], ℂ[complexOfReal(realNat(totient(M))) * (z - 0)])]
proof
  have zeroC : ℂ[0] ∈ ℂ by typecheck
  have valuesF : ComplexValuedOn(pipKPow(d, M, a, (0:N)), complexCarrier) by
    intros w hw
    rw (pipKPow.value with prime, positive, ha, hw)
    exact pipKPow.closed with prime, positive, ha, hw
  have valuesL : ComplexValuedOn(pipLine(d, M), complexCarrier) by
    intros w hw
    rw (pipLine.value with prime, positive, hw)
    exact pipLine.closed with prime, positive, hw
  have valuesQ : ComplexValuedOn(pipInvLin(M, ℂ[0]), complexCarrier) by
    intros w hw
    rw (pipInvLin.value at M, ℂ[0], w with zeroC, hw)
    exact pipInvLin.closed at M, ℂ[0], w with zeroC, hw
  have valuesS : ComplexValuedOn(complexFunctionAdd(pipKPow(d, M, a, (0:N)),
      pipLine(d, M), complexCarrier), complexCarrier) by
    intros w hw
    rw (complexFunctionAdd.value with valuesF, valuesL, hw)
    exact complexFunctionAdd.closed with valuesF, valuesL, hw
  have kz := pipLogDerivSum.member with prime, positive, hz
  have kzK : pipK(d, M, z) ∈ ℂ by
    unfold pipK
    exact kz
  unfold pipG
  rw [(complexFunctionMul.value with valuesS, valuesQ, hz),
    (complexFunctionAdd.value with valuesF, valuesL, hz),
    (pipKPow.value with prime, positive, ha, hz),
    (pipInvLin.value at M, ℂ[0], z with zeroC, hz), monoidPow.zero]
  have lz := valuesL with z, hz
  have denominator : ℂ[complexOfReal(realNat(totient(M))) * (z - 0)] ∈ ℂ by
    typecheck
  have inverse := complexInv.member with denominator
  unfold complexDiv
  ring

-- Where re a ≥ 1, G is holomorphic on a disk about a that misses 0.
theorem pipG.holomorphic (d M : Nat, a : Set)
  requires prime : Prime(d)
  requires positive : (1:N) ≤ M
  requires ha : a ∈ complexCarrier
  requires halfPlane : (1:R) ≤ complexRe(a)
  shows ∃ t ∈ ℝ, (0:R) < t ∧ HolomorphicOn(pipG(d, M, a), complexDisk(a, t)) ∧
    (∀ z ∈ complexDisk(a, t), z ≠ ℂ[0])
proof
  have zeroC : ℂ[0] ∈ ℂ by typecheck
  have aNonzero : a ≠ ℂ[0] by
    intro equal
    have re := complexOfReal.re at R[0]
    rw [complexOfReal.zero] at re
    rw [equal, re] at halfPlane
    linarith
  have nonzero : ∀ ξ ∈ dirichletCharacters(M),
      entireL(M, ξ, a) ≠ ℂ[0] ∧ entireL(M * d, quadTwist(M, ξ, d), a) ≠ ℂ[0]
    by
    intros ξ hξ
    have character := dirichletCharacters.membership.forward with hξ
    have twistCharacter := quadTwist.character at M, d, ξ with prime,
      character
    have dLarge := Prime.two_le with prime
    have dPositive : (1:N) ≤ d by arith
    have levelPositive := LessEqual.one_le_mul with positive, dPositive
    have first := entireL.ne_zero with positive, character, ha, halfPlane
    have second := entireL.ne_zero with levelPositive, twistCharacter, ha,
      halfPlane
    exact ⟨first, second⟩
  have regular := pipKPow.local_regular with prime, positive, ha, nonzero
  have one : R[1] ∈ ℝ by typecheck
  have onePositive : (0:R) < R[1] by linarith
  have openD := complexDisk.open with ha, one
  have diskSub := complexDisk.subset at a, R[1]
  have holoL := pipLine.holomorphic with prime, positive
  have holoLD := HolomorphicOn.mono with holoL, openD, diskSub
  have localL := pipLocal.of_holomorphic with ha, onePositive, holoLD
  have valuesF : ComplexValuedOn(pipKPow(d, M, a, (0:N)), complexCarrier) by
    intros w hw
    rw (pipKPow.value with prime, positive, ha, hw)
    exact pipKPow.closed with prime, positive, ha, hw
  have valuesL := holoL.right.left
  have valuesQ : ComplexValuedOn(pipInvLin(M, ℂ[0]), complexCarrier) by
    intros w hw
    rw (pipInvLin.value at M, ℂ[0], w with zeroC, hw)
    exact pipInvLin.closed at M, ℂ[0], w with zeroC, hw
  have sumRelation : ∀ z ∈ complexCarrier, z ≠ a →
      complexFunctionAdd(pipKPow(d, M, a, (0:N)), pipLine(d, M),
        complexCarrier)(z) =
      ℂ[pipKPow(d, M, a, (0:N))(z) + pipLine(d, M)(z)] by
    intros z hz distinct
    exact complexFunctionAdd.value with valuesF, valuesL, hz
  have added := pipLocal.add with ha, regular, localL, sumRelation
  have valuesS : ComplexValuedOn(complexFunctionAdd(pipKPow(d, M, a, (0:N)),
      pipLine(d, M), complexCarrier), complexCarrier) by
    intros w hw
    rw (complexFunctionAdd.value with valuesF, valuesL, hw)
    exact complexFunctionAdd.closed with valuesF, valuesL, hw
  obtain ⟨r, hr, rPositive, holoQ, avoid⟩ := pipInvLin.holomorphic with
    positive, ha, zeroC, aNonzero
  have productRelation : ∀ z ∈ complexCarrier, z ≠ a →
      pipG(d, M, a)(z) =
      ℂ[complexFunctionAdd(pipKPow(d, M, a, (0:N)), pipLine(d, M),
        complexCarrier)(z) * pipInvLin(M, ℂ[0])(z)] by
    intros z hz distinct
    unfold pipG
    exact complexFunctionMul.value with valuesS, valuesQ, hz
  have multiplied := pipLocal.mul with ha, added, rPositive, holoQ,
    productRelation
  have atA : pipG(d, M, a)(a) =
      ℂ[ℂ[pipK(d, M, a) + pipLine(d, M)(a)] * pipInvLin(M, ℂ[0])(a)] by
    have ka := pipLogDerivSum.member with prime, positive, ha
    have kaK : pipK(d, M, a) ∈ ℂ by
      unfold pipK
      exact ka
    have la := valuesL with a, ha
    have qa := valuesQ with a, ha
    unfold pipG
    rw [(complexFunctionMul.value with valuesS, valuesQ, ha),
      (complexFunctionAdd.value with valuesF, valuesL, ha),
      (pipKPow.value with prime, positive, ha, ha), monoidPow.zero]
    ring
  obtain ⟨t, ht, tPositive, holo⟩ := pipLocal.holomorphic with ha,
    multiplied, atA
  obtain ⟨s, hs, sPositive, st, sr⟩ := realRadius.common with ht, hr,
    tPositive, rPositive
  have intoT := complexDisk.mono at a, s, t with ha, hs, ht, st
  have intoR := complexDisk.mono at a, s, r with ha, hs, hr, sr
  have openS := complexDisk.open with ha, hs
  have holoS := HolomorphicOn.mono with holo, openS, intoT
  refine ⟨s, hs, sPositive, holoS, ?_⟩
  intros z hz
  exact avoid with z, (intoR with z, hz)

-- (z − 1)Φ(z) = G(z) for z ≠ 0, 1.
theorem pipPhi.sub_one_eq (d M : Nat, a z : Set)
  requires prime : Prime(d)
  requires positive : (1:N) ≤ M
  requires ha : a ∈ complexCarrier
  requires hz : z ∈ complexCarrier
  requires zNonzero : z ≠ ℂ[0]
  requires zNotOne : z ≠ ℂ[1]
  shows subMulMap(pipPhi(d, M), ℂ[1])(z) = pipG(d, M, a)(z)
proof
  have oneC : ℂ[1] ∈ ℂ by typecheck
  have valuesPhi : ∀ w ∈ complexCarrier, pipPhi(d, M)(w) ∈ complexCarrier by
    intros w hw
    rw (pipPhi.value with prime, positive, hw)
    exact pipPhi.closed with prime, positive, hw
  have h := pipPhi.sub_mul_eq with prime, positive, oneC, hz, zNonzero,
    zNotOne
  rw [(pipInvPoly.value at M, z with hz),
    (pipAffine.value with prime, positive, oneC, hz)] at h
  have kz := pipLogDerivSum.member with prime, positive, hz
  have kzK : pipK(d, M, z) ∈ ℂ by
    unfold pipK
    exact kz
  have phiZ := valuesPhi with z, hz
  have meanOne := pipLogDerivMean.member with prime, positive, oneC
  have kappa : complexOfReal(pipKappa(d, M)) ∈ ℂ by
    unfold pipKappa
    typecheck
  have pIn : complexOfReal(realNat(totient(M))) ∈ ℂ by typecheck
  have pNonzero := pipTotient.nonzero with positive
  have zwIn : ℂ[z * (z - 1)] ∈ ℂ by typecheck
  have wIn : ℂ[z - 1] ∈ ℂ by typecheck
  have wNonzero : ℂ[z - 1] ≠ ℂ[0] by
    intro equal
    apply zNotOne
    have shape : z = ℂ[(z - 1) + 1] by ring
    rw [shape, equal]
    ring
  have zwNonzero : ℂ[z * (z - 1)] ≠ ℂ[0] by
    intro equal
    exact wNonzero with (complexMul.eq_zero_cancel_left with hz, wIn,
      zNonzero, equal)
  have dIn : ℂ[complexOfReal(realNat(totient(M))) * (z * (z - 1))] ∈ ℂ by
    typecheck
  have dNonzero : ℂ[complexOfReal(realNat(totient(M))) * (z * (z - 1))] ≠
      ℂ[0] by
    intro equal
    exact zwNonzero with (complexMul.eq_zero_cancel_left with pIn, zwIn,
      pNonzero, equal)
  have z0In : ℂ[z - 0] ∈ ℂ by typecheck
  have z0Nonzero : ℂ[z - 0] ≠ ℂ[0] by
    intro equal
    apply zNonzero
    have shape : z = ℂ[z - 0] by ring
    rw shape
    exact equal
  have eIn : ℂ[complexOfReal(realNat(totient(M))) * (z - 0)] ∈ ℂ by typecheck
  have eNonzero : ℂ[complexOfReal(realNat(totient(M))) * (z - 0)] ≠ ℂ[0] by
    intro equal
    exact z0Nonzero with (complexMul.eq_zero_cancel_left with pIn, z0In,
      pNonzero, equal)
  have hD := complexInv.mul_cancel with dIn, dNonzero
  have hE := complexInv.mul_cancel with eIn, eNonzero
  have iD := complexInv.member with dIn
  have iE := complexInv.member with eIn
  rw [(subMulMap.value with valuesPhi, oneC, hz),
    (pipG.value with prime, positive, ha, hz),
    (pipLine.value with prime, positive, hz)]
  unfold complexDiv at h
  unfold complexDiv
  linear_combination h - ((pipK(d, M, z) + (-1 -
      complexOfReal(realNat(totient(M))) * complexOfReal(pipKappa(d, M)) *
      z)) * (z - 1) * complexInv(ℂ[complexOfReal(realNat(totient(M))) *
      (z * (z - 1))])) * hE + ((pipK(d, M, z) + (-1 -
      complexOfReal(realNat(totient(M))) * complexOfReal(pipKappa(d, M)) *
      z)) * complexInv(ℂ[complexOfReal(realNat(totient(M))) * (z - 0)])) * hD

-- G(1) = logDerivMean(1) − κ = 0.
theorem pipG.at_one (d M : Nat, a : Set)
  requires prime : Prime(d)
  requires positive : (1:N) ≤ M
  requires ha : a ∈ complexCarrier
  shows pipG(d, M, a)(ℂ[1]) = ℂ[0]
proof
  have oneC : ℂ[1] ∈ ℂ by typecheck
  have real := pipLogDerivMean.real_one with prime, positive
  have k1 := pipLogDerivSum.member with prime, positive, oneC
  have k1K : pipK(d, M, ℂ[1]) ∈ ℂ by
    unfold pipK
    exact k1
  have meanOne := pipLogDerivMean.member with prime, positive, oneC
  have kappa : complexOfReal(pipKappa(d, M)) ∈ ℂ by
    unfold pipKappa
    typecheck
  have pIn : complexOfReal(realNat(totient(M))) ∈ ℂ by typecheck
  have pNonzero := pipTotient.nonzero with positive
  have hP := complexInv.mul_cancel with pIn, pNonzero
  have iP := complexInv.member with pIn
  have eIn : ℂ[complexOfReal(realNat(totient(M))) * (1 - 0)] ∈ ℂ by typecheck
  have iE := complexInv.member with eIn
  rw [(pipG.value with prime, positive, ha, oneC),
    (pipLine.value with prime, positive, oneC)]
  unfold logDerivMean at real
  unfold complexDiv at real
  unfold complexDiv
  unfold pipK
  linear_combination (complexOfReal(realNat(totient(M))) *
    complexInv(ℂ[complexOfReal(realNat(totient(M))) * (1 - 0)])) * real -
    ((groupFiniteSum(complexAdditiveGroup, dirichletCharacters(M),
      logDerivMeanTerms(d, M, ℂ[1])) - 1) *
    complexInv(ℂ[complexOfReal(realNat(totient(M))) * (1 - 0)])) * hP

-- Section: The function Φ
-- Φ is meromorphic on ℂ.
theorem pipPhi.meromorphic (d M : Nat)
  requires prime : Prime(d)
  requires sevenModEight : d % 8 = (7:N)
  requires coprime : gcd(M, d) = (1:N)
  requires positive : (1:N) ≤ M
  shows Meromorphic(pipPhi(d, M))
proof
  have valuesPhi : ComplexValuedOn(pipPhi(d, M), complexCarrier) by
    intros w hw
    rw (pipPhi.value with prime, positive, hw)
    exact pipPhi.closed with prime, positive, hw
  have endpoint : ∀ a ∈ complexCarrier, ∀ b,
      (a = ℂ[0] ∧ b = ℂ[1]) ∨ (a = ℂ[1] ∧ b = ℂ[0]) →
      MeromorphicAt(pipPhi(d, M), a) by
    intros a ha b pair
    obtain ⟨c, local⟩ := pipPhi.local_endpoint at d, M, a, b with prime,
      positive, pair
    have valuesPow : ComplexValuedOn(cxaPowerMap(a, (2:N)), complexCarrier)
      by
      intros w hw
      rw (cxaPowerMap.value at a, (2:N), w with ha, hw)
      exact cxaPowerMap.closed at a, (2:N), w with ha, hw
    have factor : ∀ z ∈ complexCarrier, z ≠ a →
        complexFunctionMul(cxaPowerMap(a, (2:N)), pipPhi(d, M),
          complexCarrier)(z) = ℂ[(z - a) ^ (2:N) * pipPhi(d, M)(z)] by
      intros z hz distinct
      rw [(complexFunctionMul.value with valuesPow, valuesPhi, hz),
        (cxaPowerMap.value at a, (2:N), z with ha, hz)]
    exact pipLocal.meromorphic with ha, local, factor
  unfold Meromorphic
  intros a ha
  by_cases zero : a = ℂ[0]
  . have pair : (a = ℂ[0] ∧ ℂ[1] = ℂ[1]) ∨ (a = ℂ[1] ∧ ℂ[1] = ℂ[0]) by
      left
      exact ⟨zero, rfl⟩
    exact endpoint with a, ha, ℂ[1], pair
  by_cases one : a = ℂ[1]
  . have pair : (a = ℂ[0] ∧ ℂ[0] = ℂ[1]) ∨ (a = ℂ[1] ∧ ℂ[0] = ℂ[0]) by
      right
      exact ⟨one, rfl⟩
    exact endpoint with a, ha, ℂ[0], pair
  have local := pipPhi.local_off_one with prime, positive, ha, zero, one
  have factor : ∀ z ∈ complexCarrier, z ≠ a →
      subMulMap(pipPhi(d, M), a)(z) = ℂ[(z - a) ^ (1:N) * pipPhi(d, M)(z)] by
    intros z hz distinct
    have phiZ := valuesPhi with z, hz
    rw [(subMulMap.value with valuesPhi, ha, hz), monoidPow.succ,
      monoidPow.zero]
    ring
  exact pipLocal.meromorphic with ha, local, factor

-- Φ(s) is the Laplace transform of v ↦ R_M(e^v) for re s > 2.
theorem pipPhi.laplace (d M : Nat, E : Set)
  requires prime : Prime(d)
  requires sevenModEight : d % 8 = (7:N)
  requires coprime : gcd(M, d) = (1:N)
  requires positive : (1:N) ≤ M
  requires function : FunctionBetween(E, ℝ, ℝ)
  requires values : ∀ V ∈ ℝ, E(V) = primeError(d, M, realExp(V))
  shows ∀ s ∈ complexCarrier, (2:R) < complexRe(s) →
    pipPhi(d, M)(s) = laplaceTransform(E, s)
proof
  sorry

-- (s − 1)Φ(s) is analytic on re s ≥ 1.
theorem pipPhi.analytic_one (d M : Nat)
  requires prime : Prime(d)
  requires sevenModEight : d % 8 = (7:N)
  requires coprime : gcd(M, d) = (1:N)
  requires positive : (1:N) ≤ M
  shows ComplexAnalyticOnNhd(subMulMap(pipPhi(d, M), ℂ[1]),
    closedRightHalfPlane(R[1]))
proof
  have oneC : ℂ[1] ∈ ℂ by typecheck
  have valuesPhi : ∀ w ∈ complexCarrier, pipPhi(d, M)(w) ∈ complexCarrier by
    intros w hw
    rw (pipPhi.value with prime, positive, hw)
    exact pipPhi.closed with prime, positive, hw
  unfold ComplexAnalyticOnNhd
  intros a haPlane
  unfold closedRightHalfPlane at haPlane
  simp at haPlane
  obtain ⟨ha, halfPlane⟩ := haPlane
  obtain ⟨t, ht, tPositive, holo, avoid⟩ := pipG.holomorphic with prime,
    positive, ha, halfPlane
  have agree : ∀ z ∈ complexDisk(a, t),
      pipG(d, M, a)(z) = subMulMap(pipPhi(d, M), ℂ[1])(z) by
    intros z hz
    have zC := (complexDisk.membership.forward with hz).left
    have zNonzero := avoid with z, hz
    by_cases same : z = ℂ[1]
    . rw [same, (pipG.at_one with prime, positive, ha),
        (subMulMap.value with valuesPhi, oneC, oneC)]
      have phiOne := valuesPhi with ℂ[1], oneC
      ring
    . rw (pipPhi.sub_one_eq with prime, positive, ha, zC, zNonzero, same)
  have holoSub := HolomorphicOn.congr with holo, agree
  have center := complexDisk.center with ha, ht, tPositive
  exact ComplexAnalyticAt.of_holomorphic with holoSub, center

-- (z − 1)Φ(z) → 0 as z → 1.
theorem pipPhi.residue_one (d M : Nat)
  requires prime : Prime(d)
  requires sevenModEight : d % 8 = (7:N)
  requires coprime : gcd(M, d) = (1:N)
  requires positive : (1:N) ≤ M
  shows HasPuncturedLimit(subMulMap(pipPhi(d, M), ℂ[1]), ℂ[1], ℂ[0])
proof
  have oneC : ℂ[1] ∈ ℂ by typecheck
  have valuesPhi : ∀ w ∈ complexCarrier, pipPhi(d, M)(w) ∈ complexCarrier by
    intros w hw
    rw (pipPhi.value with prime, positive, hw)
    exact pipPhi.closed with prime, positive, hw
  have re := complexRe.one
  have halfPlane : (1:R) ≤ complexRe(ℂ[1]) by
    rw re
    linarith
  obtain ⟨t, ht, tPositive, holo, avoid⟩ := pipG.holomorphic with prime,
    positive, oneC, halfPlane
  have local := pipLocal.of_holomorphic with oneC, tPositive, holo
  rw (pipG.at_one with prime, positive, oneC) at local
  have agree : ∀ z ∈ complexDisk(ℂ[1], t), z ≠ ℂ[1] →
      subMulMap(pipPhi(d, M), ℂ[1])(z) = pipG(d, M, ℂ[1])(z) by
    intros z hz distinct
    have zC := (complexDisk.membership.forward with hz).left
    have zNonzero := avoid with z, hz
    exact pipPhi.sub_one_eq with prime, positive, oneC, zC, zNonzero, distinct
  have localSub := pipLocal.congr_disk with oneC, local, tPositive, agree
  have valuesSub : ∀ z ∈ complexCarrier,
      subMulMap(pipPhi(d, M), ℂ[1])(z) ∈ complexCarrier by
    intros z hz
    rw (subMulMap.value with valuesPhi, oneC, hz)
    exact subMulMap.closed with valuesPhi, oneC, hz
  exact pipLocal.limit with oneC, localSub, valuesSub

-- (z − ρ)Φ(z) → Σ_ξ (ord_ρ L̃(ξ) − ord_ρ L̃(ξ(·/d))) / (φ(M) ρ (1 − ρ))
-- as z → ρ, for re ρ > 0.
theorem pipPhi.residue (d M : Nat, ρ : Set)
  requires prime : Prime(d)
  requires sevenModEight : d % 8 = (7:N)
  requires coprime : gcd(M, d) = (1:N)
  requires positive : (1:N) ≤ M
  requires hρ : ρ ∈ complexCarrier
  requires right : (0:R) < complexRe(ρ)
  shows HasPuncturedLimit(subMulMap(pipPhi(d, M), ρ), ρ,
    complexDiv(pipOrderSum(d, M, ρ),
      ℂ[complexOfReal(realNat(totient(M))) * (ρ * (1 - ρ))]))
proof
  by_cases one : ρ = ℂ[1]
  . have limit := pipPhi.residue_one with prime, sevenModEight, coprime,
      positive
    have zero : complexDiv(pipOrderSum(d, M, ρ),
        ℂ[complexOfReal(realNat(totient(M))) * (ρ * (1 - ρ))]) = ℂ[0] by
      have shape : ℂ[complexOfReal(realNat(totient(M))) * (ρ * (1 - ρ))] =
          ℂ[0] by
        rw one
        ring
      have sumIn := pipOrderSum.member with prime, positive, hρ
      unfold complexDiv
      rw [shape, complexInv.zero]
      ring
    rw [zero, one]
    exact limit
  . have notZero : ρ ≠ ℂ[0] by
      intro equal
      have re := complexOfReal.re at R[0]
      rw [complexOfReal.zero] at re
      rw [equal, re] at right
      linarith
    exact pipPhi.residue_off_one with prime, positive, hρ, notZero, one

-- A finite sum of reals taken in ℂ.
theorem pipFiniteSum.of_real (V t u : Set)
  requires finite : Finite(V)
  requires values : ∀ i ∈ V, t(i) ∈ ℝ
  requires embedded : ∀ i ∈ V, u(i) = complexOfReal(t(i))
  shows groupFiniteSum(complexAdditiveGroup, V, u) =
    complexOfReal(realFiniteSum(t, V))
proof
  have ngC := complexAdditiveGroup.normed
  obtain ⟨c, m⟩ := complexAdditiveGroup.parts
  have abelianC := ngC.left
  have groupC := AbelianGroup.to_group with abelianC
  have abelianR := realAdditiveGroup.abelian
  have groupR := AbelianGroup.to_group with abelianR
  obtain ⟨abR, cR, mR, oR⟩ := realAdditiveGroup.parts
  have fn : complexOfReal : Group.carrier(realAdditiveGroup) →
      Group.carrier(complexAdditiveGroup) by
    rw [c, cR]
    exact complexOfReal.function
  have hom : complexOfReal : realAdditiveGroup →* complexAdditiveGroup by
    apply GroupHom.mk with groupR, groupC, fn
    intros x hx y hy
    rw cR at hx
    rw cR at hy
    have xR : Real(x) by exact hx
    have yR : Real(y) by exact hy
    rw [m, mR]
    exact complexOfReal.add at x, y
  have valuesR : ∀ i ∈ V, t(i) ∈ Group.carrier(realAdditiveGroup) by
    rw cR
    exact values
  have mapped := groupFiniteSum.hom with abelianR, abelianC, hom, finite,
    valuesR, embedded
  unfold realFiniteSum
  rw mapped

end PolarTools
