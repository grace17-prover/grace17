-- The remainder `primeError` written as an exact finite prime sum: the
-- weight λ(ν) = Λ(ν)(1 − (ν/d)) on ν ≡ 1 mod M, the sums
-- y^(−r) Σ_{ν ≤ y} λ(ν) ν^(r−1), the constant φ(M)⁻¹(Σ_ξ (L̃′/L̃(s, ξ(·/d))
-- − L̃′/L̃(s, ξ)) − 1), and the remainder R_M(x).
-- Source: grh-compact/src/New/Endgame/PrimeError.lean. "Weighted
-- non-split prime sums; their Mellin transform has poles at zeros of
-- L-functions." Related work: Davenport, Multiplicative Number Theory.
-- Part of: One-sided bound for non-split primes gives a zero-free
-- half-plane (GRH.Proof.Endgame.OneSidedCriterion).
-- Part of the GRH blueprint (layer 5, the argument).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Proof.Endgame.PrimeError
import GRH.Proof.Forward
import GRH.Analytic.Legendre
import Grace.Cumulus.Real.PowerOrder

section PrimeError
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Section: Definitions
-- The positive part max(X, 0) (Mathlib's posPart, written X⁺).
def posPart (X : Real) : Set :=
  ⋃({ w ∈ ℝ | ((0:R) ≤ X ∧ w = X) ∨ (X < (0:R) ∧ w = realZero) })

-- ⌊y⌋₊: the floor of y ≥ 0, and 0 for y < 0 (Mathlib's Nat.floor).
def natFloor (Y : Real) : Set :=
  ⋃({ n ∈ ℕ | ((0:R) ≤ Y ∧ n = realFloor(Y)) ∨ (Y < (0:R) ∧ n = ∅) })

-- PrimeError.lean, lambdaClass: λ(ν) = Λ(ν)(1 − (ν/d)) for ν ≡ 1 mod M,
-- and 0 otherwise (Λ restricted to the class of 1 is track D's
-- residueClass).
def lambdaClass (d M ν : Nat) : Set :=
  R[residueClass(M, integerOne)(ν) *
    (1 - legendreSign(d, integerOfNat(ν)))]

-- The terms λ(ν)/ν · ν^r, ν = 1, 2, …, indexed from 0 as ν = j + 1.
def lambdaSumTerms (d M r : Nat) : Set :=
  { (j, R[lambdaClass(d, M, succ(j)) / realNat(succ(j)) *
      realNat(succ(j)) ^ r]) | j ∈ ℕ }

-- PrimeError.lean, lambdaSum: y^(−r) Σ_{1 ≤ ν ≤ ⌊y⌋} λ(ν) ν^(r−1).
def lambdaSum (d M r : Nat, Y : Real) : Set :=
  R[realPartialSum(lambdaSumTerms(d, M, r), natFloor(Y)) / Y ^ r]

-- The terms L̃′/L̃(s, ξ·(·/d)) − L̃′/L̃(s, ξ), as a function of the
-- character ξ modulo M.
def logDerivMeanTerms (d M : Nat, s : Set) : Set :=
  { (ξ, ℂ[logDerivEntireL(M * d, quadTwist(M, ξ, d), s) -
      logDerivEntireL(M, ξ, s)]) | ξ ∈ dirichletCharacters(M) }

-- PrimeError.lean, logDerivMean:
-- φ(M)⁻¹ (Σ_ξ (L̃′/L̃(s, ξ·(·/d)) − L̃′/L̃(s, ξ)) − 1), ξ over the
-- characters modulo M.
def logDerivMean (d M : Nat, s : Set) : Set :=
  complexDiv(ℂ[groupFiniteSum(complexAdditiveGroup, dirichletCharacters(M),
      logDerivMeanTerms(d, M, s)) - 1],
    complexOfReal(realNat(totient(M))))

-- PrimeError.lean, primeError: the remainder
-- R_M(x) = Σ_{ν ≤ x} λ(ν)(1/ν − 1/x) − log x/φ(M) − Re logDerivMean(1).
def primeError (d M : Nat, X : Real) : Set :=
  R[lambdaSum(d, M, 0, X) - lambdaSum(d, M, 1, X) -
    realLog(X) / realNat(totient(M)) - complexRe(logDerivMean(d, M, ℂ[1]))]

-- The terms λ(ν)(A/ν − A/z)⁺/A, ν = 1, 2, …, indexed from 0.
def primeErrorSumTerms (d M A : Nat, Z : Real) : Set :=
  { (j, R[lambdaClass(d, M, succ(j)) *
      posPart(R[realNat(A) / realNat(succ(j)) - realNat(A) / Z]) /
      realNat(A)]) | j ∈ ℕ }

-- Section: The weights and the sums
-- PrimeError.lean, lambdaClass_nonneg_and_abs_le: 0 ≤ λ(ν) ≤ 2ν.
theorem lambdaClass.nonneg_and_abs_le (d M ν : Nat)
  requires prime : Prime(d)
  shows (0:R) ≤ lambdaClass(d, M, ν) ∧
    abs(lambdaClass(d, M, ν)) ≤ R[2 * realNat(ν)]
proof
  have aNonneg := residueClass.nonneg at M, integerOne, ν
  have aLe := residueClass.le_vonMangoldt at M, integerOne, ν
  have aReal := residueClass.real at M, integerOne, ν
  have aT : Real(residueClass(M, integerOne)(ν)) by typecheck
  have lamReal := vonMangoldt.real at ν
  have lamT : Real(vonMangoldt(ν)) by typecheck
  have nuNonneg := realNat.nonnegative at ν
  have lamLe : vonMangoldt(ν) ≤ realNat(ν)
    by_cases zero : ν = (0:N)
    . have notPower : ¬PrimePower(ν)
        intro power
        obtain ⟨p, pIn, pPower⟩ := power
        obtain ⟨pPrime, k, kIn, kOne, equation⟩ := pPower
        have pNat := nat.omega.backward with pIn
        have kNat := nat.omega.backward with kIn
        have above := Prime.greater_than_one with pPrime
        have pNonzero : p ≠ (0:N) by arith
        have nonzero := pow.ne_zero at p, k with pNonzero
        rw ← equation at nonzero
        exact nonzero with zero
      rw (vonMangoldt.not_prime_power with notPower)
      linarith
    . have positive : 1 ≤ ν by arith
      have logLe := vonMangoldt.le_log with positive
      have atLeast := realNat.one_le with positive
      have pos : R[0] < realNat(ν) by linarith
      have sub := realLog.le_sub_one at realNat(ν) with pos
      linarith
  have legendreT := legendreSign.real at d, integerOfNat(ν)
  have legendreR : Real(legendreSign(d, integerOfNat(ν))) by typecheck
  have bounds : (0:R) ≤ R[1 - legendreSign(d, integerOfNat(ν))] ∧
      R[1 - legendreSign(d, integerOfNat(ν))] ≤ R[2]
    by_cases divides : IntegerCongruent(integerOfNat(d), integerOfNat(ν),
        integerZero)
    . rw (legendreSign.of_divides with divides)
      refine ⟨?_, ?_⟩
      . linarith
      . linarith
    . by_cases square : IntegerSquareMod(d, integerOfNat(ν))
      . rw (legendreSign.of_square with divides, square)
        refine ⟨?_, ?_⟩
        . linarith
        . linarith
      . rw (legendreSign.of_not_square with divides, square)
        refine ⟨?_, ?_⟩
        . linarith
        . linarith
  obtain ⟨lower, upper⟩ := bounds
  have product := realMulValue.nonnegative with aNonneg, lower
  have scaled := realLe.mul_left_of_nonnegative with upper, aNonneg
  unfold lambdaClass
  rw (abs.of_nonnegative with product)
  refine ⟨product, ?_⟩
  linarith

-- Section: The prime error
-- ⌊y⌋₊ is ⌊y⌋ for y ≥ 0 and 0 for y < 0.
theorem pipNatFloor.value (Y : Real)
  shows ((0:R) ≤ Y ∧ natFloor(Y) = realFloor(Y)) ∨
    (Y < (0:R) ∧ natFloor(Y) = ∅)
proof
  by_cases nonneg : (0:R) ≤ Y
  . left
    have natural := realFloor.natural with nonneg
    have member := nat.omega.forward with natural
    refine ⟨nonneg, ?_⟩
    unfold natFloor
    apply union.of_unique
    . refine ⟨member, ?_⟩
      left
      exact ⟨nonneg, rfl⟩
    . intros y hy
      obtain ⟨_, alternatives⟩ := hy
      rcases alternatives with ⟨_, yValue⟩ | ⟨negative, _⟩
      . exact yValue
      . exfalso
        linarith
  . right
    have negative := realLess.of_not_le with nonneg
    have member : ∅ ∈ ℕ by typecheck
    refine ⟨negative, ?_⟩
    unfold natFloor
    apply union.of_unique
    . refine ⟨member, ?_⟩
      right
      exact ⟨negative, rfl⟩
    . intros y hy
      obtain ⟨_, alternatives⟩ := hy
      rcases alternatives with ⟨nonneg2, _⟩ | ⟨_, yValue⟩
      . exfalso
        linarith
      . exact yValue

theorem pipNatFloor.natural (Y : Real)
  shows Nat(natFloor(Y))
proof
  rcases pipNatFloor.value at Y with ⟨nonneg, equal⟩ | ⟨_, equal⟩
  . rw equal
    exact realFloor.natural with nonneg
  . rw equal
    typecheck

-- λ(ν) is real.
theorem pipLambdaClass.real (d M ν : Nat)
  shows lambdaClass(d, M, ν) ∈ ℝ
proof
  have function := residueClass.function at M, integerOne
  have legendre := legendreSign.real at d, integerOfNat(ν)
  unfold lambdaClass
  typecheck

-- The terms λ(ν)/ν · ν^r form a real sequence.
theorem pipLambdaSumTerms.sequence (d M r : Nat)
  shows RealSequence(lambdaSumTerms(d, M, r))
proof
  unfold RealSequence
  apply coefficientGraph.function
  . intros p hp
    simp [lambdaSumTerms] at hp
    obtain ⟨j, jIn, eq⟩ := hp
    have jNat := nat.omega.backward with jIn
    have lambda := pipLambdaClass.real at d, M, succ(j)
    rw ← eq
    refine ⟨j, jIn, R[lambdaClass(d, M, succ(j)) / realNat(succ(j)) *
      realNat(succ(j)) ^ r], ?_, rfl⟩
    typecheck
  . intros a aIn
    have aNat := nat.omega.backward with aIn
    have lambda := pipLambdaClass.real at d, M, succ(a)
    refine ⟨R[lambdaClass(d, M, succ(a)) / realNat(succ(a)) *
      realNat(succ(a)) ^ r], ?_, ?_⟩
    . typecheck
    . simp [lambdaSumTerms]
  . intros a b c ab ac
    simp [lambdaSumTerms] at ab
    simp [lambdaSumTerms] at ac
    obtain ⟨z, _, abEq⟩ := ab
    obtain ⟨w, _, acEq⟩ := ac
    obtain ⟨za, zb⟩ := orderedPair.injective with abEq
    obtain ⟨wa, wc⟩ := orderedPair.injective with acEq
    cc

-- y^(−r) Σ_{ν ≤ y} λ(ν) ν^(r−1) is real.
theorem pipLambdaSum.real (d M r : Nat, Y : Real)
  shows lambdaSum(d, M, r, Y) ∈ ℝ
proof
  have sequence := pipLambdaSumTerms.sequence at d, M, r
  have natural := pipNatFloor.natural at Y
  have partial := realPartialSum.real at lambdaSumTerms(d, M, r),
    natFloor(Y) with sequence
  have power := realPow.real at Y, r
  unfold realPow at power
  have partialT : Real(realPartialSum(lambdaSumTerms(d, M, r), natFloor(Y)))
    by typecheck
  have quotient := realDiv.real at realPartialSum(lambdaSumTerms(d, M, r),
    natFloor(Y)), R[Y ^ r]
  unfold lambdaSum
  exact quotient


-- The terms λ(ν)/ν · ν^r at ν = j + 1.
theorem pip2LambdaSumTerms.apply (d M r j : Nat)
  shows lambdaSumTerms(d, M, r)(j) = R[lambdaClass(d, M, succ(j)) /
    realNat(succ(j)) * realNat(succ(j)) ^ r]
proof
  have index : j ∈ ℕ by typecheck
  have shape : ∀ p ∈ lambdaSumTerms(d, M, r), ∃ a ∈ ℕ, ∃ b, p = (a, b) by
    intros p hp
    simp [lambdaSumTerms] at hp
    obtain ⟨m, mIn, eq⟩ := hp
    rw ← eq
    exact ⟨m, mIn, R[lambdaClass(d, M, succ(m)) / realNat(succ(m)) *
      realNat(succ(m)) ^ r], rfl⟩
  have total : ∀ a ∈ ℕ, ∃ b, (a, b) ∈ lambdaSumTerms(d, M, r) by
    intros a aIn
    refine ⟨R[lambdaClass(d, M, succ(a)) / realNat(succ(a)) *
      realNat(succ(a)) ^ r], ?_⟩
    simp [lambdaSumTerms]
  have functional : ∀ a, ∀ b, ∀ c, (a, b) ∈ lambdaSumTerms(d, M, r) →
      (a, c) ∈ lambdaSumTerms(d, M, r) → b = c by
    intros a b c ab ac
    simp [lambdaSumTerms] at ab
    simp [lambdaSumTerms] at ac
    obtain ⟨m, _, abEq⟩ := ab
    obtain ⟨k, _, acEq⟩ := ac
    obtain ⟨ma, mb⟩ := orderedPair.injective with abEq
    obtain ⟨ka, kc⟩ := orderedPair.injective with acEq
    cc
  have mapped : (j, R[lambdaClass(d, M, succ(j)) / realNat(succ(j)) *
      realNat(succ(j)) ^ r]) ∈ lambdaSumTerms(d, M, r) by
    simp [lambdaSumTerms]
  exact coefficientGraph.apply with shape, total, functional, index, mapped

-- 0 ≤ λ(ν)/ν · ν^r ≤ 2 Y^r for ν = j + 1 ≤ Y.
theorem pip2LambdaSumTerms.bound (d M r j : Nat, Y : Real)
  requires prime : Prime(d)
  requires below : realNat(succ(j)) ≤ Y
  shows (0:R) ≤ lambdaSumTerms(d, M, r)(j) ∧
    lambdaSumTerms(d, M, r)(j) ≤ R[2 * Y ^ r]
proof
  obtain ⟨lambdaNonneg, absBound⟩ := lambdaClass.nonneg_and_abs_le at d, M,
    succ(j) with prime
  have lambdaT := pipLambdaClass.real at d, M, succ(j)
  have lambdaR : Real(lambdaClass(d, M, succ(j))) by typecheck
  rw (abs.of_nonnegative with lambdaNonneg) at absBound
  have nPositive := realNat.positive_succ at j
  have nNonneg : (0:R) ≤ realNat(succ(j)) by linarith
  have nNonzero : realNat(succ(j)) ≠ 0 by
    intro equal
    linarith
  have inverse := realInvValue.positive at realNat(succ(j)) with nPositive
  have inverseT : Real(realInvValue(realNat(succ(j)))) by typecheck
  have inverseNonneg : (0:R) ≤ realInvValue(realNat(succ(j))) by linarith
  have cancel := realInvValue.mul_left at realNat(succ(j)) with nNonzero
  have quotientNonneg := realMulValue.nonnegative with lambdaNonneg,
    inverseNonneg
  have scaled := realLe.mul_left_of_nonnegative with absBound, inverseNonneg
  have twice : R[realInvValue(realNat(succ(j))) * R[2 * realNat(succ(j))]] =
      R[2 * R[realInvValue(realNat(succ(j))) * realNat(succ(j))]] by ring
  rw [twice, cancel] at scaled
  have powNonneg := realPow.nonnegative at realNat(succ(j)), r with nNonneg
  unfold realPow at powNonneg
  have powMono := realPow.base_monotone at realNat(succ(j)), Y, r with nNonneg,
    below
  unfold realPow at powMono
  have powT := realPow.real at realNat(succ(j)), r
  unfold realPow at powT
  have yPowT := realPow.real at Y, r
  unfold realPow at yPowT
  have termNonneg := realMulValue.nonnegative with quotientNonneg, powNonneg
  have termLe := realLe.mul_left_of_nonnegative with scaled, powNonneg
  rw (pip2LambdaSumTerms.apply at d, M, r, j)
  rw realDiv.eq_mul_inv
  have commuted : R[R[lambdaClass(d, M, succ(j)) *
      realInvValue(realNat(succ(j)))] * realNat(succ(j)) ^ r] =
      R[realNat(succ(j)) ^ r * R[realInvValue(realNat(succ(j))) *
        lambdaClass(d, M, succ(j))]] by ring
  have commutedNonneg : R[R[lambdaClass(d, M, succ(j)) *
      realInvValue(realNat(succ(j)))] * realNat(succ(j)) ^ r] =
      R[R[lambdaClass(d, M, succ(j)) * realInvValue(realNat(succ(j)))] *
        realNat(succ(j)) ^ r] by rfl
  rw commuted
  constructor
  . have alt := realMulValue.nonnegative with powNonneg, quotientNonneg
    have same : R[realInvValue(realNat(succ(j))) * lambdaClass(d, M, succ(j))] =
        R[lambdaClass(d, M, succ(j)) * realInvValue(realNat(succ(j)))] by ring
    rw same
    exact alt
  . have e : R[R[realNat(succ(j)) ^ r] * R[2 * 1]] =
        R[2 * R[realNat(succ(j)) ^ r]] by ring
    rw e at termLe
    linarith

-- PrimeError.lean, abs_lambdaSum_exp_le: |lambdaSum(r, e^v)| ≤ 2 e^v.
theorem lambdaSum.abs_exp_le (d M r : Nat, V : Real)
  requires prime : Prime(d)
  shows abs(lambdaSum(d, M, r, realExp(V))) ≤ R[2 * realExp(V)]
proof
  have Y := realExp.positive at V
  have yNonneg : (0:R) ≤ realExp(V) by linarith
  have expT : Real(realExp(V)) by typecheck
  have floorEq : natFloor(realExp(V)) = realFloor(realExp(V)) by
    rcases pipNatFloor.value at realExp(V) with ⟨_, equal⟩ | ⟨negative, _⟩
    . exact equal
    . exfalso
      linarith
  have natural := pipNatFloor.natural at realExp(V)
  have floorLe := realFloor.le with yNonneg
  rw ← floorEq at floorLe
  have sequence := pipLambdaSumTerms.sequence at d, M, r
  have powPositive := realPow.positive at realExp(V), r with Y
  unfold realPow at powPositive
  have powT := realPow.real at realExp(V), r
  unfold realPow at powT
  have terms : ∀ k ∈ ℕ, k < natFloor(realExp(V)) →
      (0:R) ≤ lambdaSumTerms(d, M, r)(k) ∧
        lambdaSumTerms(d, M, r)(k) ≤ R[2 * realExp(V) ^ r] by
    intros k hk below
    have kNat := nat.omega.backward with hk
    have succLe : succ(k) ≤ natFloor(realExp(V)) by arith
    have realLe := realNat.le_of_natural_le with succLe
    have bound : realNat(succ(k)) ≤ realExp(V) by linarith
    exact pip2LambdaSumTerms.bound with prime, bound
  have nonneg := (realPartialSum.nonnegative_prefix at lambdaSumTerms(d, M, r),
    natFloor(realExp(V)) with sequence)
  have prefixNonneg : (0:R) ≤ realPartialSum(lambdaSumTerms(d, M, r),
      natFloor(realExp(V))) by
    apply nonneg
    intros k hk
    have kNat := natural.member at natFloor(realExp(V)) with hk
    have hkN : k ∈ ℕ by typecheck
    have below := (Less.of_membership at k, natFloor(realExp(V))) with hk
    exact (terms with k, hkN, below).left
  have ones := constantSequence.sequence at (1:R)
  have scaled := (realPartialSum.le_scaled at lambdaSumTerms(d, M, r),
    constantSequence((1:R)), R[2 * realExp(V) ^ r], natFloor(realExp(V)) with
    sequence, ones)
  have upper : realPartialSum(lambdaSumTerms(d, M, r), natFloor(realExp(V))) ≤
      R[R[2 * realExp(V) ^ r] * realPartialSum(constantSequence((1:R)),
        natFloor(realExp(V)))] by
    apply scaled
    intros k hk below
    have kNat := nat.omega.backward with hk
    rw (constantSequence.value at (1:R), k)
    have bound := (terms with k, hk, below).right
    have e : R[R[2 * R[realExp(V) ^ r]] * 1] = R[2 * R[realExp(V) ^ r]] by
      ring
    rw e
    exact bound
  rw (realPartialSum.constant at (1:R), natFloor(realExp(V))) at upper
  have prefixT : Real(realPartialSum(lambdaSumTerms(d, M, r),
      natFloor(realExp(V)))) by typecheck
  have inverse := realInvValue.positive at R[realExp(V) ^ r] with powPositive
  have inverseT : Real(realInvValue(R[realExp(V) ^ r])) by typecheck
  have inverseNonneg : (0:R) ≤ realInvValue(R[realExp(V) ^ r]) by linarith
  have powNonzero : R[realExp(V) ^ r] ≠ 0 by
    intro equal
    linarith
  have cancel := realInvValue.mul_left at R[realExp(V) ^ r] with powNonzero
  have multiplied := realLe.mul_left_of_nonnegative with upper, inverseNonneg
  have valueNonneg := realMulValue.nonnegative with inverseNonneg,
    prefixNonneg
  have nT : Real(realNat(natFloor(realExp(V)))) by typecheck
  have simplify : R[realInvValue(R[realExp(V) ^ r]) * R[R[2 * realExp(V) ^ r] *
      R[realNat(natFloor(realExp(V))) * 1]]] = R[2 * realNat(natFloor(
      realExp(V))) * R[realInvValue(R[realExp(V) ^ r]) * realExp(V) ^ r]] by
    ring
  rw [simplify, cancel] at multiplied
  have one : R[R[2 * realNat(natFloor(realExp(V)))] * 1] =
      R[2 * realNat(natFloor(realExp(V)))] by ring
  rw one at multiplied
  unfold lambdaSum
  rw realDiv.eq_mul_inv
  have commuted : R[realPartialSum(lambdaSumTerms(d, M, r),
      natFloor(realExp(V))) * realInvValue(R[realExp(V) ^ r])] =
      R[realInvValue(R[realExp(V) ^ r]) * realPartialSum(lambdaSumTerms(d, M,
        r), natFloor(realExp(V)))] by ring
  rw [commuted, (abs.of_nonnegative with valueNonneg)]
  linarith

-- PrimeError.lean, re_logDerivMean_one: for modulus 1 at s = 1 the real
-- part of logDerivMean is −1 − chowlaSelbergConst(d).
theorem logDerivMean.re_one (d : Nat)
  requires prime : Prime(d)
  shows complexRe(logDerivMean(d, 1, ℂ[1])) =
    R[-1 - chowlaSelbergConst(d)]
proof
  sorry

-- PrimeError.lean, primeError_eq_sum: for 0 < z ≤ A,
-- R_M(z) = Σ_{ν=1}^{A} λ(ν)(A/ν − A/z)⁺/A − log z/φ(M) − Re
-- logDerivMean(1).
theorem primeError.eq_sum (d M A : Nat, Z : Real)
  requires prime : Prime(d)
  requires positive : (1:N) ≤ M
  requires zPositive : (0:R) < Z
  requires below : Z ≤ realNat(A)
  shows primeError(d, M, Z) =
    R[realPartialSum(primeErrorSumTerms(d, M, A, Z), A) -
      realLog(Z) / realNat(totient(M)) -
      complexRe(logDerivMean(d, M, ℂ[1]))]
proof
  sorry

end PrimeError
