-- Theorem A (short forms: projected Poincaré series of integral forms
-- have small lifts and small index), Theorem B (enough forms: few
-- translates nearly span), the main height, the main ask and the
-- remainder as prime sums.
-- Source: grh-compact/src/New/Endgame/ShortAndEnough.lean. "Choice of the
-- level prime. The level is a prime N, found in a short window, whose
-- logarithm is within a small error of the total excess of the lifts'
-- size over their expected divisibility, per unit of order." Part of:
-- The inequality (⋆): upper bound for weighted non-split primes (see
-- GRH.Proof.Main).
-- Part of the GRH blueprint (layer 5, the argument).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Proof.Endgame.ShortAndEnough
import GRH.Proof.Forward.Lifts

section ShortAndEnough
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Section: Definitions
-- ShortAndEnough.lean, Data.mainHeight: h_main = m k 𝖴, 𝖴 = dirCost.
def mainHeight (P D : Set) : Set :=
  R[realNat(D.m) * realNat(dataK(D)) * dirCost(P, D)]

-- ShortAndEnough.lean, Data.mainAsk: a(log a − 1 − ℓ − w̄), ℓ the
-- Chowla-Selberg constant of d and w̄ the mean of log w(τ) over the
-- places.
def mainAsk (P D : Set) : Set :=
  R[realNat(dataA(P, D)) * (realLog(realNat(dataA(P, D))) - 1 -
    chowlaSelbergConst(Parameters.d(P)) -
    realFiniteSum(logWeightTerms(P, D), dataPlaces(P, D)) /
      realNat(dataF(P, D)))]

-- The terms Ask(a, τ) − mainAsk over the tops.
def remainderTerms (P D : Set) : Set :=
  { (τ, R[primeSum(P, D, realNat(dataA(P, D)), τ) - mainAsk(P, D)]) |
    τ ∈ tops(P, D) }

-- ShortAndEnough.lean, Data.remainder: rem = Σ_{τ ∈ tops}
-- (primeSum(a, τ) − mainAsk).
def remainder (P D : Set) : Set :=
  realFiniteSum(remainderTerms(P, D), tops(P, D))

-- Section: The remainder and its size
-- ShortAndEnough.lean, Data.abs_mainHeight_add_remainder_le:
-- |h_main| + m |rem| ≤ b² x⁹⁹.
theorem mainHeight.abs_add_remainder_le (P D : Set)
  requires data : Data(P, D)
  shows R[abs(mainHeight(P, D)) + realNat(D.m) * abs(remainder(P, D))] ≤
    R[dataB(D) ^ 2 * dataX(D) ^ 99]
proof
  sorry

-- ShortAndEnough.lean, Data.remainder_eq: rem = a(#thick (R_{N₀}(x) −
-- R_{N₀}(x₁)) + #tops R₁(x₁)).
theorem remainder.eq (P D : Set)
  requires data : Data(P, D)
  shows remainder(P, D) =
    R[realNat(dataA(P, D)) *
      (realNat(cardinality(D.thick)) *
        (primeError(Parameters.d(P), Parameters.N0(P), dataX(D)) -
          primeError(Parameters.d(P), Parameters.N0(P), dataX1(D))) +
       realNat(cardinality(tops(P, D))) *
        primeError(Parameters.d(P), 1, dataX1(D)))]
proof
  sorry

-- Section: Theorems A and B
-- The bound of Theorem A on one short form: ‖Θ₁ B_s φ‖²_σ ≤
-- exp(h_main − m rem + 𝓑 log b) for every s ∈ 𝖦 and σ ∈ Aut ℂ, with
-- 𝓑 = budget and B_s = c P_s.
predicate ShortAt (P D L c φ : Set) :=
  ∀ s ∈ dataGroup(P, D), ∀ σ ∈ complexAutomorphisms,
    RealLe(normSqAt(P, D, L, oneTwist(P, D, L),
        liftTheta(P, D, L, oneTwist(P, D, L))(scaledPoincare(P, D, L, c, s,
          φ)), σ),
      realExp(R[mainHeight(P, D) - realNat(D.m) * remainder(P, D) +
        D.logB * budget(P, D)]))

-- Theorem A, part (a): some S ⊆ integralRamified spans the ramified
-- columns and every φ ∈ S is short.
predicate ShortSpanning (P D L c : Set) :=
  ∃ S, S ⊆ integralRamified(P, D, L) ∧
    moduleSpan(ramifiedModule(P, D, L), complexRing, S) =
      ramifiedColumns(P, D, L) ∧
    (∀ φ ∈ S, ShortAt(P, D, L, c, φ))

-- Theorem A, part (b): for t ⊆ 𝖦, every finite family y : n → rows in
-- ⋃_{s ∈ t} B_s(integralRamified) has index at most |t| dim(columns) 𝓑.
predicate SmallIndex (P D L c : Set) :=
  ∀ t, t ⊆ dataGroup(P, D) → ∀ n ∈ ℕ, ∀ y,
    (y : n → Module.carrier(dataRows(P, D, L))) →
    (∀ i ∈ n, y(i) ∈ scaledTranslates(P, D, L, c, t)) →
    IndexLe(P, D, L, n, y, R[realNat(cardinality(t)) *
      realNat(columnDim(P, D, L)) * budget(P, D)])

-- ShortAndEnough.lean, Data.short_forms (Theorem A): for some rational
-- q = a/b > 0 and B_s = q P_s, (a) and (b).
theorem Data.short_forms (P D L : Set)
  requires lifts : LiftSystemOf(P, D, L)
  shows ∃ a ∈ ℕ, ∃ b ∈ ℕ, (0:N) < a ∧ (0:N) < b ∧
    ShortSpanning(P, D, L, complexOfReal(R[realNat(a) / realNat(b)])) ∧
    SmallIndex(P, D, L, complexOfReal(R[realNat(a) / realNat(b)]))
proof
  sorry

-- ShortAndEnough.lean, Data.enough_forms (Theorem B): columns and rows
-- are nonzero, and for some t ⊆ 𝖦 with |t| dim(columns) ≤
-- 5 D log(1 + b²), D = dim(rows), the ranges of the P_s, s ∈ t, span
-- dimension at least (1 − 4/b²) D.
theorem Data.enough_forms (P D L : Set)
  requires lifts : LiftSystemOf(P, D, L)
  shows (0:N) < columnDim(P, D, L) ∧ (0:N) < rowDim(P, D, L) ∧
    (∃ t, t ⊆ dataGroup(P, D) ∧
      R[realNat(cardinality(t)) * realNat(columnDim(P, D, L))] ≤
        R[5 * realNat(rowDim(P, D, L)) * realLog(R[1 + dataB(D) ^ 2])] ∧
      R[(1 - 4 / dataB(D) ^ 2) * realNat(rowDim(P, D, L))] ≤
        R[realNat(finrank(poincareRangeSpan(P, D, L, t), complexRing))])
proof
  sorry

end ShortAndEnough
