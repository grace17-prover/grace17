-- Measurability of v ↦ R_M(e^v): the sums Σ_{ν ≤ e^v} are step functions
-- of v, constant on the Borel sets where ⌊e^v⌋₊ = n.
-- Source: grh-compact/src/New/Endgame/PrimeError.lean (isPolar_primeError).
-- Part of: One-sided bound for non-split primes gives a zero-free
-- half-plane (GRH.Proof.Endgame.OneSidedCriterion).
-- Part of the GRH blueprint (layer 5, the argument).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Proof.Endgame.PolarMeasure
import GRH.Proof.Endgame.PrimeError
import GRH.Analytic.Landau

section PolarMeasure
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Section: Step functions of e^v
-- v ↦ −e^v, measurable.
defgraph pip2NegExp (V ∈ ℝ) : ℝ := R[-realExp(V)]
proof
  typecheck

theorem pip2NegExp.measurable
  shows Measurable(pip2NegExp, realMeasurableSpace, realMeasurableSpace)
proof
  have spaceLine := realLine.space
  have continuous := (Continuous.iff_real_line at realExp).forward with
    realExp.continuous
  have expMeasurable : Measurable(realExp, realMeasurableSpace,
      realMeasurableSpace) by
    unfold realMeasurableSpace
    exact Measurable.of_continuous with spaceLine, spaceLine, continuous
  apply Measurable.real_neg with expMeasurable
  intros x hx
  rw realMeasurableSpace.carrier at hx
  exact pip2NegExp.value with hx

-- The set where ⌊e^v⌋₊ = n, when A < Σ_{j<n} u(j), and ∅ otherwise.
def pip2LevelSet (u A n : Set) : Set :=
  { V ∈ ℝ | natFloor(realExp(V)) = n ∧ A < realPartialSum(u, n) }

def pip2Levels (u A : Set) : Set := { (n, pip2LevelSet(u, A, n)) | n ∈ ℕ }

theorem pip2Levels.apply (u A n : Set)
  requires index : n ∈ ℕ
  shows pip2Levels(u, A)(n) = pip2LevelSet(u, A, n)
proof
  have shape : ∀ p ∈ pip2Levels(u, A), ∃ a ∈ ℕ, ∃ b, p = (a, b) by
    intros p hp
    simp [pip2Levels] at hp
    obtain ⟨m, mIn, eq⟩ := hp
    rw ← eq
    exact ⟨m, mIn, pip2LevelSet(u, A, m), rfl⟩
  have total : ∀ a ∈ ℕ, ∃ b, (a, b) ∈ pip2Levels(u, A) by
    intros a aIn
    refine ⟨pip2LevelSet(u, A, a), ?_⟩
    simp [pip2Levels]
  have functional : ∀ a, ∀ b, ∀ c, (a, b) ∈ pip2Levels(u, A) →
      (a, c) ∈ pip2Levels(u, A) → b = c by
    intros a b c ab ac
    simp [pip2Levels] at ab
    simp [pip2Levels] at ac
    obtain ⟨m, _, abEq⟩ := ab
    obtain ⟨k, _, acEq⟩ := ac
    obtain ⟨ma, mb⟩ := orderedPair.injective with abEq
    obtain ⟨ka, kc⟩ := orderedPair.injective with acEq
    cc
  have mapped : (n, pip2LevelSet(u, A, n)) ∈ pip2Levels(u, A) by
    simp [pip2Levels]
  exact coefficientGraph.apply with shape, total, functional, index, mapped

-- ⌊e^v⌋₊ = n exactly when n ≤ e^v < n + 1.
theorem pip2NatFloor.exp_iff (V : Real, n : Nat)
  shows natFloor(realExp(V)) = n ↔
    realNat(n) ≤ realExp(V) ∧ realExp(V) < R[realNat(n) + 1]
proof
  have positive := realExp.positive at V
  have nonneg : (0:R) ≤ realExp(V) by linarith
  have floorEq : natFloor(realExp(V)) = realFloor(realExp(V)) by
    rcases pipNatFloor.value at realExp(V) with ⟨_, equal⟩ | ⟨negative, _⟩
    . exact equal
    . exfalso
      linarith
  rw floorEq
  constructor
  . intro equal
    have lower := realFloor.le with nonneg
    have upper := realFloor.lt with nonneg
    rw equal at lower
    rw equal at upper
    exact ⟨lower, upper⟩
  . intro bounds
    obtain ⟨lower, upper⟩ := bounds
    exact realFloor.eq_of_bounds with nonneg, lower, upper

-- The level sets are Borel.
theorem pip2LevelSet.measurable (u A : Set, n : Nat)
  shows MeasurableSet(realMeasurableSpace, pip2LevelSet(u, A, n))
proof
  have space := realMeasurableSpace.space
  by_cases big : A < realPartialSum(u, n)
  . have negative := pip2NegExp.measurable
    have lower := MeasurableSet.real_le_locus at realMeasurableSpace,
      pip2NegExp, R[-realNat(n)] with negative
    have upper := MeasurableSet.real_lt_locus at realMeasurableSpace,
      pip2NegExp, R[-(realNat(n) + 1)] with negative
    have both := MeasurableSet.inter with space, lower, upper
    rw realMeasurableSpace.carrier at both
    have same : pip2LevelSet(u, A, n) = realLeSet(pip2NegExp, ℝ,
        R[-realNat(n)]) ∩ realGtSet(pip2NegExp, ℝ, R[-(realNat(n) + 1)]) by
      ext V
      constructor
      . intro hV
        simp [pip2LevelSet] at hV
        obtain ⟨vIn, floor, _⟩ := hV
        have vReal : Real(V) by typecheck
        obtain ⟨low, high⟩ := (pip2NatFloor.exp_iff at V, n).forward with floor
        have inLe : V ∈ realLeSet(pip2NegExp, ℝ, R[-realNat(n)]) by
          simp [realLeSet]
          rw (pip2NegExp.value with vIn)
          refine ⟨vIn, ?_⟩
          linarith
        have inGt : V ∈ realGtSet(pip2NegExp, ℝ, R[-(realNat(n) + 1)]) by
          simp [realGtSet]
          rw (pip2NegExp.value with vIn)
          refine ⟨vIn, ?_⟩
          linarith
        exact intersection.membership.backward with ⟨inLe, inGt⟩
      . intro hV
        obtain ⟨inLe, inGt⟩ := intersection.membership.forward with hV
        simp [realLeSet] at inLe
        simp [realGtSet] at inGt
        obtain ⟨vIn, low⟩ := inLe
        obtain ⟨_, high⟩ := inGt
        have vReal : Real(V) by typecheck
        rw (pip2NegExp.value with vIn) at low
        rw (pip2NegExp.value with vIn) at high
        have bounds : realNat(n) ≤ realExp(V) ∧
            realExp(V) < R[realNat(n) + 1] by
          constructor
          . linarith
          . linarith
        have floor := (pip2NatFloor.exp_iff at V, n).backward with bounds
        simp [pip2LevelSet]
    rw same
    exact both
  . have same : pip2LevelSet(u, A, n) = ∅ by
      ext V
      constructor
      . intro hV
        simp [pip2LevelSet] at hV
      . intro hV
        simp at hV
    rw same
    exact MeasurableSet.empty with space

-- v ↦ Σ_{j < ⌊e^v⌋₊} u(j) is measurable.
theorem pip2StepExp.measurable (u f : Set)
  requires sequence : RealSequence(u)
  requires function : FunctionBetween(f, ℝ, ℝ)
  requires values : ∀ V ∈ ℝ, f(V) = realPartialSum(u, natFloor(realExp(V)))
  shows Measurable(f, realMeasurableSpace, realMeasurableSpace)
proof
  have space := realMeasurableSpace.space
  have maps : MapsInto(f, MeasurableSpace.carrier(realMeasurableSpace), ℝ) by
    rw realMeasurableSpace.carrier
    intros x hx
    exact FunctionBetween.apply_closed with function, hx
  apply Measurable.real_of_rays with space, maps
  intros A hA
  have levels : ∀ n ∈ ℕ, MeasurableSet(realMeasurableSpace,
      pip2Levels(u, A)(n)) by
    intros n hn
    have nNat := nat.omega.backward with hn
    rw (pip2Levels.apply with hn)
    exact pip2LevelSet.measurable at u, A, n
  have union := MeasurableSet.sequence_union with space, levels
  have same : realGtSet(f, MeasurableSpace.carrier(realMeasurableSpace), A) =
      sequenceUnion(pip2Levels(u, A)) by
    rw realMeasurableSpace.carrier
    ext V
    constructor
    . intro hV
      simp [realGtSet] at hV
      obtain ⟨vIn, above⟩ := hV
      have vReal : Real(V) by typecheck
      have natural := pipNatFloor.natural at realExp(V)
      have index : natFloor(realExp(V)) ∈ ℕ by typecheck
      rw (values with V, vIn) at above
      unfold sequenceUnion
      have inS : V ∈ pip2Levels(u, A)(natFloor(realExp(V))) by
        rw (pip2Levels.apply with index)
        simp [pip2LevelSet]
      have inV : pip2Levels(u, A)(natFloor(realExp(V))) ∈
          valuesOn(pip2Levels(u, A), ℕ) :=
        valuesOn.membership.backward with ⟨natFloor(realExp(V)), index, rfl⟩
      exact union.membership.backward with ⟨pip2Levels(u, A)(natFloor(
        realExp(V))), inV, inS⟩
    . intro hV
      unfold sequenceUnion at hV
      obtain ⟨S, sIn, vS⟩ := union.membership.forward with hV
      obtain ⟨n, nIn, sEq⟩ := valuesOn.membership.forward with sIn
      rw [← sEq, (pip2Levels.apply with nIn)] at vS
      simp [pip2LevelSet] at vS
      obtain ⟨vIn, floor, above⟩ := vS
      have vReal : Real(V) by typecheck
      rw ← floor at above
      rw ← (values with V, vIn) at above
      simp [realGtSet]
  rw same
  exact union

-- Section: The pieces of v ↦ R_M(e^v)
-- Σ_{ν ≤ e^v} λ(ν)/ν · ν^r, 1/e^v, their product, and v ↦ a + b v.
defgraph pip2Step (d M r : Nat) (V ∈ ℝ) : ℝ :=
    realPartialSum(lambdaSumTerms(d, M, r), natFloor(realExp(V)))
proof
  have sequence := pipLambdaSumTerms.sequence at d, M, r
  have natural := pipNatFloor.natural at realExp(V)
  exact realPartialSum.real at lambdaSumTerms(d, M, r), natFloor(realExp(V))
    with sequence

defgraph pip2InvExp (V ∈ ℝ) : ℝ := realInvValue(realExp(V))
proof
  typecheck

defgraph pip2Product (d M : Nat) (V ∈ ℝ) : ℝ :=
    R[pip2Step(d, M, (1:N))(V) * pip2InvExp(V)]
proof
  have step := pip2Step.closed at d, M, (1:N), V with member
  have inverse := pip2InvExp.closed with member
  typecheck

defgraph pip2Tail (d M : Nat) (V ∈ ℝ) : ℝ := R[-pip2Product(d, M)(V)]
proof
  have product := pip2Product.closed at d, M, V with member
  typecheck

defgraph pip2Head (d M : Nat) (V ∈ ℝ) : ℝ :=
    R[pip2Step(d, M, (0:N))(V) + pip2Tail(d, M)(V)]
proof
  have step := pip2Step.closed at d, M, (0:N), V with member
  have tail := pip2Tail.closed at d, M, V with member
  typecheck

defgraph pip2Scale (b : Real) (V ∈ ℝ) : ℝ := R[b * V]
proof
  typecheck

defgraph pip2Affine (a b : Real) (V ∈ ℝ) : ℝ := R[a + pip2Scale(b)(V)]
proof
  have scaled := pip2Scale.closed at b, V with member
  typecheck

theorem pip2Step.measurable (d M r : Nat)
  shows Measurable(pip2Step(d, M, r), realMeasurableSpace,
    realMeasurableSpace)
proof
  have sequence := pipLambdaSumTerms.sequence at d, M, r
  have function := pip2Step.function at d, M, r
  apply pip2StepExp.measurable with sequence, function
  intros V hV
  exact pip2Step.value with hV

theorem pip2InvExp.measurable
  shows Measurable(pip2InvExp, realMeasurableSpace, realMeasurableSpace)
proof
  have spaceLine := realLine.space
  have continuous := (Continuous.iff_real_line at realExp).forward with
    realExp.continuous
  have expMeasurable : Measurable(realExp, realMeasurableSpace,
      realMeasurableSpace) by
    unfold realMeasurableSpace
    exact Measurable.of_continuous with spaceLine, spaceLine, continuous
  apply Measurable.real_inv with expMeasurable
  intros x hx
  rw realMeasurableSpace.carrier at hx
  exact pip2InvExp.value with hx

theorem pip2Head.measurable (d M : Nat)
  shows Measurable(pip2Head(d, M), realMeasurableSpace, realMeasurableSpace)
proof
  have step0 := pip2Step.measurable at d, M, (0:N)
  have step1 := pip2Step.measurable at d, M, (1:N)
  have inverse := pip2InvExp.measurable
  have product : Measurable(pip2Product(d, M), realMeasurableSpace,
      realMeasurableSpace) by
    apply Measurable.real_mul with step1, inverse
    intros x hx
    rw realMeasurableSpace.carrier at hx
    exact pip2Product.value with hx
  have tail : Measurable(pip2Tail(d, M), realMeasurableSpace,
      realMeasurableSpace) by
    apply Measurable.real_neg with product
    intros x hx
    rw realMeasurableSpace.carrier at hx
    exact pip2Tail.value with hx
  apply Measurable.real_add with step0, tail
  intros x hx
  rw realMeasurableSpace.carrier at hx
  exact pip2Head.value with hx

theorem pip2Affine.measurable (a b : Real)
  shows Measurable(pip2Affine(a, b), realMeasurableSpace, realMeasurableSpace)
proof
  have space := realMeasurableSpace.space
  have identity := Measurable.identity with space
  have aMember : a ∈ MeasurableSpace.carrier(realMeasurableSpace) by
    rw realMeasurableSpace.carrier
    typecheck
  have bMember : b ∈ MeasurableSpace.carrier(realMeasurableSpace) by
    rw realMeasurableSpace.carrier
    typecheck
  have aMap : ∀ x ∈ MeasurableSpace.carrier(realMeasurableSpace),
      constantOn(MeasurableSpace.carrier(realMeasurableSpace), a)(x) = a by
    intros x hx
    exact constantOn.apply with hx
  have bMap : ∀ x ∈ MeasurableSpace.carrier(realMeasurableSpace),
      constantOn(MeasurableSpace.carrier(realMeasurableSpace), b)(x) = b by
    intros x hx
    exact constantOn.apply with hx
  have aConstant := Measurable.constant with space, space, aMember, aMap
  have bConstant := Measurable.constant with space, space, bMember, bMap
  have scaled : Measurable(pip2Scale(b), realMeasurableSpace,
      realMeasurableSpace) by
    apply Measurable.real_mul with bConstant, identity
    intros x hx
    rw [(constantOn.apply with hx), (identity.apply with hx)]
    rw realMeasurableSpace.carrier at hx
    exact pip2Scale.value with hx
  apply Measurable.real_add with aConstant, scaled
  intros x hx
  rw (constantOn.apply with hx)
  rw realMeasurableSpace.carrier at hx
  exact pip2Affine.value with hx

end PolarMeasure
