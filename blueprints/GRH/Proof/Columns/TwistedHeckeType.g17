module GRH.Proof.Columns.TwistedHeckeType
import GRH.Proof.Forward.Lifts

section TwistedHeckeType
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Section: Index of modules over O_ι
-- O_ι as a ring.
def valRing (p ι : Set) : Set := subringRing(complexRing, embValRing(p, ι))

-- S is an O_ι-submodule of the columns.
predicate ColumnOSubmodule (P D L p ι S : Set) :=
  S ⊆ Module.carrier(dataColumn(P, D, L)) ∧
  (∀ φ ∈ S, ∀ ψ ∈ S, call2(Module.add(dataColumn(P, D, L)), φ, ψ) ∈ S) ∧
  (∀ c ∈ embValRing(p, ι), ∀ φ ∈ S, Module.smul(dataColumn(P, D, L))(c, φ) ∈ S)

-- Σ_k m_{ik} Φ_k in the columns.
def columnCombinationTerms (P D L m Φ i k : Set) : Set :=
  { (j, Module.smul(dataColumn(P, D, L))(m((i, j)), Φ(j))) | j ∈ k }

def columnCombination (P D L m Φ i k : Set) : Set :=
  groupFiniteSum(Module.additive(dataColumn(P, D, L)), k,
    columnCombinationTerms(P, D, L, m, Φ, i, k))

-- ModuleIndex.lean, IndexDvd M N z: every finite family Φ in M has a square
-- matrix m over O_ι with det m ∣ z and every Σ_k m_{ik} Φ_k in N.
predicate IndexDvd (P D L p ι M Nm z : Set) :=
  ∀ k ∈ ℕ, ∀ Φ, (Φ : k → M) →
    ∃ m ∈ matrixSpace(valRing(p, ι), k, k),
      (∃ q ∈ embValRing(p, ι), z = ℂ[matDet(valRing(p, ι), k, m) * q]) ∧
      ∀ i ∈ k, columnCombination(P, D, L, m, Φ, i, k) ∈ Nm

-- y(M) + p^s M.
def imagePlusPower (P D L p y M s : Set) : Set :=
  { φ ∈ Module.carrier(dataColumn(P, D, L)) | ∃ u ∈ M, ∃ v ∈ M,
    φ = call2(Module.add(dataColumn(P, D, L)), y(u),
      Module.smul(dataColumn(P, D, L))(ℂ[complexOfReal(realNat(p)) ^ s], v)) }

-- ModuleIndex.lean, HasType p M s y c: y maps M into M, and the index of
-- y(M) + p^s M in M divides p^l for some natural l ≤ c.
predicate HasType (P D L p ι M s y c : Set) :=
  (∀ u ∈ M, y(u) ∈ M) ∧
  ∃ l ∈ ℕ, R[realNat(l)] ≤ (c:R) ∧
    IndexDvd(P, D, L, p, ι, M, imagePlusPower(P, D, L, p, y, M, s),
      ℂ[complexOfReal(realNat(p)) ^ l])

-- The columns integral at ι, as a set.
def integralColumnSet (P D L p ι : Set) : Set := integralColumns(P, D, L, p, ι)

-- Section: Marked primes
-- CrudeModularData.lean, Data.inducedPlace σ: the prime of E above p
-- induced by ιₚ ∘ σ.
def topPlace (P D p ι σ : Set) : Set :=
  inducedPlace(dataE(P, D), p, ι, placeEmbeddingE(P, D.s, σ))

-- CrudeModularData.lean, Data.IsMarked Λ: p < x₁ is non-split, Λ is a set
-- of primes of E induced by tops, disjoint from its conjugate, and empty
-- unless p is served.
predicate IsMarked (P D p ι Λ : Set) :=
  Λ ⊆ finPlaces(dataE(P, D)) ∧
  (∀ l ∈ Λ, conjugatePlace(dataE(P, D), l) ∉ Λ) ∧
  (Λ ≠ ∅ → IsServed(P, D, p)) ∧
  (∀ l ∈ Λ, ∃ τ ∈ tops(P, D), topPlace(P, D, p, ι, τ) = l) ∧
  IsSmallNonsplit(P, D, p)

-- CrudeModularData.lean, Data.IsFullMark Λ: marked, and containing the
-- prime induced by each top or its conjugate.
predicate IsFullMark (P D p ι Λ : Set) :=
  IsMarked(P, D, p, ι, Λ) ∧
  ∀ τ ∈ tops(P, D), topPlace(P, D, p, ι, τ) ∈ Λ ∨
    conjugatePlace(dataE(P, D), topPlace(P, D, p, ι, τ)) ∈ Λ

-- CrudeModularData.lean, Data.markExponent l: A_l = a · #{tops inducing l}.
def topsInducing (P D p ι l : Set) : Set :=
  { τ ∈ tops(P, D) | topPlace(P, D, p, ι, τ) = l }

def markExponent (P D p ι l : Set) : Set :=
  mul(dataA(P, D), cardinality(topsInducing(P, D, p, ι, l)))

-- CrudeModularData.lean, Data.evenPlaces Λ: the places inducing a prime in Λ.
def evenPlaces (P D p ι Λ : Set) : Set :=
  { σ ∈ dataPlaces(P, D) | topPlace(P, D, p, ι, σ) ∈ Λ }

-- FORWARD. SphericalHecke.lean, heckeSplit (at w = l, split from its
-- conjugate) T_{l,i} on the columns, an endomorphism of the ℂ-module of
-- columns (as a function); placeholder ∅.
def heckeSplitOp (P D L l i : Set) : Set := ∅

-- JetExponentBound.lean, Data.IsMarked.markOperator l: p^{A_l} T_{l,𝔯},
-- 𝔯 = ⌈log_p m⌉ (ceilLogM).
def markOperator (P D L p ι l : Set) : Set :=
  { (φ, Module.smul(dataColumn(P, D, L))(
      ℂ[complexOfReal(realNat(p)) ^ markExponent(P, D, p, ι, l)],
      heckeSplitOp(P, D, L, l, ceilLogM(D, p))(φ))) |
    φ ∈ Module.carrier(dataColumn(P, D, L)) }

-- Section: The chain B_μ
-- FORWARD (predicate). ChainValuation.lean, IsGoodDatum ϑ Ψ: Ψ is a finite
-- combination of admissible translations with coefficients integral away
-- from the twist, of bounded size, jointly invariant, whose chain of
-- 2(ϱ + 1) lifts is the paired chain. Placeholder body: the typing.
predicate IsGoodDatum (P D L ϑ Ψ : Set) := ϑ ∈ mfoldTwists(P, D, L) ∧ Ψ = Ψ

-- FORWARD. CrudeModularData.lean, Data.Bμ ϑ Ψ = restrictToY ∘ chainComb ϑ Ψ:
-- the chain of lifts with data Ψ, a linear map from the columns to the
-- forms on Y_m of the level setting liftLevelSetting(P, D, L, ϑ) (as a
-- function); placeholder ∅.
def chainBmu (P D L ϑ Ψ : Set) : Set := ∅

-- ClassReps.lean, GaugeLe 1 c F for a form F on Y_m: weylGauge(g, F(g)) ≤ c
-- for every g.
predicate YGaugeLe (P D L ϑ p ι c F : Set) :=
  ∀ g ∈ gfMatrices(LevelSetting.field(liftLevelSetting(P, D, L, ϑ)),
      LevelSetting.rank(liftLevelSetting(P, D, L, ϑ))),
    RealLe(weightGauge(LevelSetting.weight(liftLevelSetting(P, D, L, ϑ)), ι, g,
      formAt(LevelSetting.weight(liftLevelSetting(P, D, L, ϑ)), F, g)), c)

-- CrudeModularData.lean, Data.lowColumns j τ: Σ_{h < n_{j+1}, h ≠ 1} κ_τ(h).
def lowColumnTerms (P D τ : Set) : Set :=
  { (h, realNat(tallCount(columnCounts(P, D), τ, h))) | h ∈ ℕ }

def lowColumns (P D j τ : Set) : Set :=
  realPartialSum(lowColumnTerms(P, D, τ), dataRank(D, succ(j)))

end TwistedHeckeType
