-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Proof.Columns.LocalStatement
import GRH.Proof.Columns.MarkedPrimeType
import GRH.Proof.Columns.SizeEstimates

section LocalStatement
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- LocalStatement.lean, Data.liftLoss Λ j: 𝔯 Σ_{σ ∈ ev} lowColumns j σ −
-- jetExponent p j ev, ev the places inducing a prime in Λ.
def liftLossTerms (P D p ι Λ j : Set) : Set :=
  { (σ, lowColumns(P, D, j, σ)) | σ ∈ evenPlaces(P, D, p, ι, Λ) }

def liftLoss (P D p ι Λ j : Set) : Set :=
  R[realNat(ceilLogM(D, p)) *
      realFiniteSum(liftLossTerms(P, D, p, ι, Λ, j), evenPlaces(P, D, p, ι, Λ)) -
    jetExponent(P, D, p, j, evenPlaces(P, D, p, ι, Λ))]

-- p^x for a real x, as a real.
def natRpow (p x : Set) : Set := realRpow(realNat(p), x)

-- c·φ in the columns.
def columnScale (P D L c φ : Set) : Set := Module.smul(dataColumn(P, D, L))(c, φ)

-- Σ_{p<x₁ non-split} gain(p) log p.
def gainLogTerms (P D : Set) : Set :=
  { (p, R[liftGain(P, D, p) * realLog(realNat(p))]) | p ∈ nonsplitPrimes(P, D) }

def gainLogSum (P D : Set) : Set := realFiniteSum(gainLogTerms(P, D), nonsplitPrimes(P, D))

-- The squared norm ‖σ F(g)‖² of a form F on Y_m.
def yNormSqAt (P D L ϑ σ F g : Set) : Set :=
  weylNormSq(LevelSetting.weight(liftLevelSetting(P, D, L, ϑ)),
    conjFormAt(LevelSetting.weight(liftLevelSetting(P, D, L, ϑ)), σ, F, g))

-- The gain counted only below x₁ at non-split p.
def gainIfNonsplit (P D p : Set) : Set :=
  ⋃({ v ∈ ℝ | (p ∈ nonsplitPrimes(P, D) ∧ v = liftGain(P, D, p)) ∨
    (p ∉ nonsplitPrimes(P, D) ∧ v = realZero) })

-- Section: Facts
-- LocalStatement.lean, Data.IsGoodDatum.gaugeLe_one: for Ψ good for ϑ and p
-- prime to the primes of ϑ, p ≠ N, p ≠ d, B_μ keeps ι-integral columns
-- integral.
theorem chainBmu.integral (P D L ϑ Ψ p ι v : Set)
  requires system : LiftSystemOf(P, D, L)
  requires good : IsGoodDatum(P, D, L, ϑ, Ψ)
  requires prime : Prime(p)
  requires place : ι ∈ padicPlaces(p)
  requires coprime : gcd(p, twistLevelNorm(P, D, L, ϑ)) = (1:N)
  requires notN : p ≠ L.N
  requires notD : p ≠ Parameters.d(P)
  requires hv : v ∈ integralColumnSet(P, D, L, p, ι)
  shows YGaugeLe(P, D, L, ϑ, p, ι, realOne, chainBmu(P, D, L, ϑ, Ψ)(v))
proof
  sorry

-- LocalStatement.lean, Data.IsGoodDatum.gaugeLe_collisionSum: for p < x₁
-- non-split and prime to the primes of ϑ, B_μ v has valuation at least
-- gain(p) − loss(p) − m collisionSum(p, ∅) for v integral at ι.
theorem chainBmu.gauge_collisionSum (P D L ϑ Ψ p ι v : Set)
  requires system : LiftSystemOf(P, D, L)
  requires good : IsGoodDatum(P, D, L, ϑ, Ψ)
  requires prime : Prime(p)
  requires place : ι ∈ padicPlaces(p)
  requires coprime : gcd(p, twistLevelNorm(P, D, L, ϑ)) = (1:N)
  requires small : IsSmallNonsplit(P, D, p)
  requires hv : v ∈ integralColumnSet(P, D, L, p, ι)
  shows YGaugeLe(P, D, L, ϑ, p, ι,
    natRpow(p, R[realNat(D.m) * collisionSum(P, D, p, ∅) + loss(P, D, p) -
      liftGain(P, D, p)]),
    chainBmu(P, D, L, ϑ, Ψ)(v))
proof
  sorry

-- LocalStatement.lean, Data.IsGoodDatum.gaugeLe_pow_jetCeil_smul: B_μ(p^{j_p}v)
-- has valuation at least gain(p) − loss(p), j_p = jetCeil.
theorem chainBmu.gauge_jetCeil (P D L ϑ Ψ p ι v : Set)
  requires system : LiftSystemOf(P, D, L)
  requires good : IsGoodDatum(P, D, L, ϑ, Ψ)
  requires prime : Prime(p)
  requires place : ι ∈ padicPlaces(p)
  requires coprime : gcd(p, twistLevelNorm(P, D, L, ϑ)) = (1:N)
  requires small : IsSmallNonsplit(P, D, p)
  requires hv : v ∈ integralColumnSet(P, D, L, p, ι)
  shows YGaugeLe(P, D, L, ϑ, p, ι, natRpow(p, R[loss(P, D, p) - liftGain(P, D, p)]),
    chainBmu(P, D, L, ϑ, Ψ)(columnScale(P, D, L,
      ℂ[complexOfReal(realNat(p)) ^ jetCeil(P, D, p)], v)))
proof
  sorry

-- LocalStatement.lean, Data.weylNormSq_Bmu_le (size bound): for Ψ good for
-- the trivial twist and σ ∈ Aut ℂ, if ‖σφ(g)‖² ≤ e^B everywhere, then
-- ‖σ B_μφ(g)‖² ≤ exp(B + h₀ + 2 Σ_{p<x₁ non-split} gain(p) log p + f a (log b)³).
theorem chainBmu.normSq_le (P D L Ψ σ φ B : Set)
  requires system : LiftSystemOf(P, D, L)
  requires good : IsGoodDatum(P, D, L, oneTwist(P, D, L), Ψ)
  requires hσ : σ ∈ complexAutomorphisms
  requires hφ : φ ∈ Module.carrier(dataColumn(P, D, L))
  requires hB : B ∈ ℝ
  requires bound : ∀ g ∈ gfMatrices(dataE(P, D), dataRank(D, (0:N))),
    RealLe(weylNormSq(stageWeight(P, D, (0:N)),
      conjFormAt(stageWeight(P, D, (0:N)), σ, φ, g)), realExp(B))
  shows ∀ g ∈ gfMatrices(LevelSetting.field(liftLevelSetting(P, D, L, oneTwist(P, D, L))),
      LevelSetting.rank(liftLevelSetting(P, D, L, oneTwist(P, D, L)))),
    RealLe(yNormSqAt(P, D, L, oneTwist(P, D, L), σ,
        chainBmu(P, D, L, oneTwist(P, D, L), Ψ)(φ), g),
      realExp(R[B + heightPerRow(P, D, L.N) + 2 * gainLogSum(P, D) + budget(P, D)]))
proof
  sorry

-- LocalStatement.lean, Data.exists_indexDvd_Bmu_divisible (divisibility of
-- the chain at each prime): for an integer β < gain(p) − err(p) + 1 (gain
-- counted only for p < x₁ non-split), some O_ι-module S of columns has
-- index dividing p^l, l ≤ err(p) dim(columns), in the ι-integral columns,
-- and p^{−β} B_μφ is integral for every ramified φ ∈ S, every twist ϑ with
-- primes prime to p and every good Ψ.
theorem chainBmu.exists_divisible (P D L p ι β : Set)
  requires system : LiftSystemOf(P, D, L)
  requires prime : Prime(p)
  requires place : ι ∈ padicPlaces(p)
  requires hβ : β ∈ ℤ
  requires small : R[realInt(β)] <
    R[gainIfNonsplit(P, D, p) - allowedLoss(P, D, L.N, p) + 1]
  shows ∃ l ∈ ℕ, R[realNat(l)] ≤ R[allowedLoss(P, D, L.N, p) * realNat(columnDim(P, D, L))] ∧
    ∃ S, ColumnOSubmodule(P, D, L, p, ι, S) ∧
      IndexDvd(P, D, L, p, ι, integralColumnSet(P, D, L, p, ι), S,
        ℂ[complexOfReal(realNat(p)) ^ l]) ∧
      ∀ ϑ, ∀ Ψ, IsGoodDatum(P, D, L, ϑ, Ψ) → gcd(p, twistLevelNorm(P, D, L, ϑ)) = (1:N) →
        ∀ φ ∈ S, φ ∈ ramifiedColumns(P, D, L) →
          YGaugeLe(P, D, L, ϑ, p, ι, realOne,
            Module.smul(levelFormModule(liftLevelSetting(P, D, L, ϑ)))(
              complexOfReal(natRpow(p, R[-realInt(β)])),
              chainBmu(P, D, L, ϑ, Ψ)(φ)))
proof
  sorry

end LocalStatement
