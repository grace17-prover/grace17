-- Served primes and collisions at a non-split prime p, and the jet
-- exponent: the sum of jet exponents along the chain is at least the gain
-- minus the error.
-- Source: grh-compact/src/New/Columns/JetExponentBound.lean. "Part of:
-- Scaled Hecke operators repair divisibility at inert primes pairing tops
-- (see New.Columns.LocalStatement). Part of: Divisibility of the chain of
-- theta lifts at each prime (see New.Columns.LocalStatement). This file:
-- Marked primes at inert p: orders of -p, parity, balance; scaled Hecke
-- operator. Sum of jet exponents along the chain is at least gain minus
-- error." (Data.IsServed.m_dvd_orderOf, Data.le_loss,
-- Data.placeOfInt_mul_mem_tops_iff, Data.jetExponent,
-- Data.IsCollision.ne_and_odd_and_dvd, Data.collisionSum_le,
-- Data.mul_collisionSum_le_loss, Data.le_jetExponent; boxes of
-- Lib/Weil/Construction/DataProduct.lean.)
-- Encoding. The order of the place named by −p in (ℤ/N₁)ˣ is the least
-- o ≥ 1 with (−p)^o ≡ 1, classOrder modulo N₁ (GRH.Proof.Curve.LiveSum).
-- Not stated here: the marked primes (Data.inducedPlace, IsMarked,
-- IsFullMark and their lemmas, the operator markOperator), which read the
-- finite place of E induced by a ring map ι : ℂ → ℂ_p, more than the
-- absolute values that record a p-adic place in GRH.Adelic.CuspForms; and
-- lowColumns_lowBoxes_bounds, whose names belong to the marked part.
-- Part of the GRH blueprint (layer 5, the argument).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Proof.Columns.JetExponentBound
import GRH.Proof.Columns.SizeEstimates

section JetExponentBound
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- DataProduct.lean, boxes κ N: Σ_τ Σ_{h < N} h κ_τ(h), for κ on Φ × ℕ.
def boxTerms (κ τ : Set) : Set := { (h, realNat(mul(h, κ((τ, h))))) | h ∈ ℕ }

def boxRows (Φ κ N : Set) : Set := { (τ, realPartialSum(boxTerms(κ, τ), N)) | τ ∈ Φ }

def boxesOver (Φ κ N : Set) : Set := realFiniteSum(boxRows(Φ, κ, N), Φ)

-- ⌊X⌋₊ for a real X ≥ 0 (boxes is a natural number read as a real).
def natFloorCandidates (X : Set) : Set := { n ∈ ℕ | (X:R) < R[realNat(n) + 1] }

def natFloorOf (X : Set) : Set := leastNatural(natFloorCandidates(X))

-- The live exponents e ≤ log_p L (e odd or p = d).
def liveExponentsUpTo (P p L : Set) : Set :=
  { e ∈ ℕ | e ≤ logNat(p, L) ∧ (Odd(e) ∨ p = Parameters.d(P)) }

def couplingTerms (P D p j ev e : Set) : Set :=
  { (σ, couplingCount(p, columnCounts(P, D), dataRank(D, succ(j)), ev, σ,
      placeMul(P, D.s, placeOfNegNat(P, D.s, pow(p, e)), σ), e)) |
    σ ∈ dataPlaces(P, D) }

def couplingSums (P D p j ev : Set) : Set :=
  { (e, realFiniteSum(couplingTerms(P, D, p, j, ev, e), dataPlaces(P, D))) |
    e ∈ ℕ }

-- The number L of boxes of κ in heights below n_{j+1}.
def jetBoxes (P D j : Set) : Set :=
  boxesOver(dataPlaces(P, D), columnCounts(P, D), dataRank(D, succ(j)))

-- JetExponentBound.lean, Data.jetExponent p j ev: with n = n_{j+1} and
-- L = boxes κ n, (1/(p − 1) − ρ_p) L + ((p/d) − 1)/2 · Σ_{e live, e ≤ log_p L}
-- Σ_σ couplingCount(σ, −p^e σ, e) − f n³(⌊log_p L⌋ + 1).
def jetExponent (P D p j ev : Set) : Set :=
  R[(1 / (realNat(p) - 1) - nonsplitWeight(Parameters.d(P), p)) * jetBoxes(P, D, j) +
    (quadCharAt(Parameters.d(P), p) - 1) / 2 *
      realFiniteSum(couplingSums(P, D, p, j, ev),
        liveExponentsUpTo(P, p, natFloorOf(jetBoxes(P, D, j)))) -
    realNat(dataF(P, D)) * realNat(dataRank(D, succ(j))) ^ 3 *
      (realNat(logNat(p, natFloorOf(jetBoxes(P, D, j)))) + 1)]

-- JetExponentBound.lean, Data.IsServed.m_dvd_orderOf: if p is served, m
-- divides the order of the place named by −p in (ℤ/N₁)ˣ.
theorem IsServed.m_dvd_orderOf (P D p : Set)
  requires data : Data(P, D)
  requires prime : p ∈ ℕ ∧ Prime(p)
  requires served : IsServed(P, D, p)
  shows D.m ∣ classOrder(placeOfNegNat(P, D.s, p), levelN1(P, D.s))
proof
  sorry

-- JetExponentBound.lean, Data.le_loss: f (log b)² a/p ≤ loss(p).
theorem loss.ge (P D p : Set)
  requires data : Data(P, D)
  requires hp : p ∈ ℕ
  shows R[realNat(dataF(P, D)) * D.logB ^ 2 * (realNat(dataA(P, D)) / realNat(p))] ≤
    (loss(P, D, p):R)
proof
  sorry

-- JetExponentBound.lean, Data.placeOfInt_mul_mem_tops_iff: for odd e and
-- a top τ, −p^e τ is a top if and only if o₀ divides e.
theorem tops.partner_mem_iff (P D p e τ : Set)
  requires data : Data(P, D)
  requires prime : p ∈ ℕ ∧ Prime(p)
  requires odd : e ∈ ℕ ∧ Odd(e)
  requires top : τ ∈ tops(P, D)
  shows placeMul(P, D.s, placeOfNegNat(P, D.s, pow(p, e)), τ) ∈ tops(P, D) ↔
    placeOrderZero(P, D, p) ∣ e
proof
  sorry

-- JetExponentBound.lean, Data.IsCollision.ne_and_odd_and_dvd: a collision
-- (τ, e) has p ≠ d, e odd and o₀ ∣ e.
theorem IsCollision.ne_odd_dvd (P D p ev τ e : Set)
  requires data : Data(P, D)
  requires prime : p ∈ ℕ ∧ Prime(p)
  requires collision : IsCollision(P, D, p, ev, τ, e)
  shows p ≠ Parameters.d(P) ∧ Odd(e) ∧ placeOrderZero(P, D, p) ∣ e
proof
  sorry

-- JetExponentBound.lean, Data.collisionSum_le: if every collision (τ, e)
-- outside S has e ≥ o, the collision sum is at most 2 f a/p^o.
theorem collisionSum.le (P D p S : Set, o : Nat)
  requires data : Data(P, D)
  requires prime : p ∈ ℕ ∧ Prime(p)
  requires late : ∀ τ ∈ dataPlaces(P, D), ∀ e ∈ ℕ, IsCollision(P, D, p, S, τ, e) → o ≤ e
  shows (collisionSum(P, D, p, S):R) ≤
    R[2 * realNat(dataF(P, D)) * realNat(dataA(P, D)) / realNat(pow(p, o))]
proof
  sorry

-- JetExponentBound.lean, Data.mul_collisionSum_le_loss: for p < x₁
-- non-split and not served, m · collisionSum(p, ∅) ≤ loss(p).
theorem collisionSum.mul_le_loss (P D p : Set)
  requires data : Data(P, D)
  requires prime : p ∈ ℕ ∧ Prime(p)
  requires small : IsSmallNonsplit(P, D, p)
  requires notServed : ¬IsServed(P, D, p)
  shows R[realNat(D.m) * collisionSum(P, D, p, ∅)] ≤ (loss(P, D, p):R)
proof
  sorry

-- JetExponentBound.lean, Data.le_jetExponent: for j < m, p < x₁
-- non-split and a finite set ev of places, gain(p)/m − coll_p(ev) +
-- ½(1 − (p/d)) |tops ∩ ev| a/x₁ − f (log b)² a/(p m) ≤ jetExponent p j ev.
theorem jetExponent.ge (P D p ev : Set, j : Nat)
  requires data : Data(P, D)
  requires hj : j < D.m
  requires prime : p ∈ ℕ ∧ Prime(p)
  requires small : IsSmallNonsplit(P, D, p)
  requires hev : ev ⊆ dataPlaces(P, D)
  shows R[liftGain(P, D, p) / realNat(D.m) - collisionSum(P, D, p, ev) +
      (1 - quadCharAt(Parameters.d(P), p)) / 2 *
        realNat(cardinality(tops(P, D) ∩ ev)) * (realNat(dataA(P, D)) / dataX1(D)) -
      realNat(dataF(P, D)) * D.logB ^ 2 * (realNat(dataA(P, D)) / realNat(p)) /
        realNat(D.m)] ≤ (jetExponent(P, D, p, j, ev):R)
proof
  sorry

end JetExponentBound
