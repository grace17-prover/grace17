-- The columns: the primes of E dividing π, the levels on the spaces X_j
-- (the chosen level with last row ≡ (0, …, 0, 1) modulo π), the weight
-- (κ, e₀) of the columns, and the columns themselves, the algebraic forms
-- on X₀ of that weight fixed by the level of stage 0.
-- Source: grh-compact/src/New/Columns/ColumnDefs.lean ("Set-up for this
-- proof: records of the data and parameters of this proof, names for its
-- objects. This file: the primes of E dividing π; the levels on the spaces
-- X_j; columns, that is, algebraic forms on X_0 (not the columns of a
-- Young diagram, nor IsColumn); branching and restriction from X_m to
-- Y_m."; Data.piPlaces, card_piPlaces, Data.columnLevel, Data.Column,
-- Data.Stage), with New/Data/ChosenPlaceLevels.lean (Data.chosenLevel).
-- Encoding. X_j has n_j indices, read as the natural number n_j, its last
-- index being n_j − 1 (the source's InitIndex j ⊕ Unit). π is the field
-- of the record of choices (AutoChoices.pi). The weight datum of (κ, e)
-- is the FORWARD schurWeightDatum (GRH.Proof.Forward.Characters). The
-- branching matrix and the restriction to Y_m (Data.branching,
-- Data.restrictToY) are chosen from exists_branching_matrix and need the
-- Schur modules of Lib/GLn; they are not stated here.
-- Part of the GRH blueprint (layer 5, the argument).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Proof.Columns.ColumnDefs
import GRH.Proof.Seesaw.GradingsOfY

section ColumnDefs
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)

-- Section: The primes dividing π
-- ColumnDefs.lean, Data.piPlaces: the finite places w of E with π ∈ w.
def piPlaces (P D L : Set) : Set :=
  { w ∈ finPlaces(dataE(P, D)) | AutoChoices.pi(LiftChoices.choices(L)) ∈ w }

-- Section: Levels
-- ChosenPlaceLevels.lean, Data.chosenLevel = levelOf D.chosen ⊥ on n
-- indices: the k ∈ K₀ = GL_n(Ô) ∩ G_f reducing to 1 at every chosen place.
def chosenPlaceFamily (P D : Set) : Set :=
  { (x, chosenPlace(x)) | x ∈ chosenIndex(P, D) }

def chosenOneFamily (P D n : Set) : Set :=
  { (x, matOne(resField(dataE(P, D), chosenPlace(x)), n)) | x ∈ chosenIndex(P, D) }

def chosenLevelSetting (P D n : Set) : Set :=
  LevelSetting.mk(dataE(P, D), dataPhi(P, D), n, chosenPlaceFamily(P, D),
    {chosenOneFamily(P, D, n)}, ∅, ∅)

def chosenLevel (P D n : Set) : Set := levelOf(chosenLevelSetting(P, D, n))

-- The entry (k − 1)_{ij} of a matrix over the finite adeles.
def minusOneEntry (E n k i j : Set) : Set :=
  finAdd(E, k((i, j)), finNeg(E, matOne(finiteAdeleRing(E), n)((i, j))))

-- ColumnDefs.lean, Data.columnLevel j: the elements of the chosen level on
-- X_j whose last row is ≡ (0, …, 0, 1) modulo πÔ.
def columnLevel (P D L j : Set) : Set :=
  { k ∈ chosenLevel(P, D, dataRank(D, j)) |
    ∀ i ∈ dataRank(D, j), ∃ o ∈ finInt(dataE(P, D)),
      minusOneEntry(dataE(P, D), dataRank(D, j), k, sub(dataRank(D, j), 1), i) =
        finMul(dataE(P, D), finOf(dataE(P, D), AutoChoices.pi(LiftChoices.choices(L))), o) }

-- Section: The weight and the columns
-- LiveSum.lean, Data.κ and Data.lastEntry j, read on the CM type.
def columnCountsOnPhi (P D : Set) : Set :=
  { ((placeEmbeddingE(P, D.s, fst(q)), snd(q)), columnCount(P, D, fst(q), snd(q))) |
    q ∈ dataPlaces(P, D) × ℕ }

-- ColumnDefs.lean, Data.Stage j = AlgForm (X j) κ (lastEntry j): the
-- weight datum of stage j.
def stageWeight (P D j : Set) : Set :=
  schurWeightDatum(dataE(P, D), dataPhi(P, D), dataRank(D, j),
    columnCountsOnPhi(P, D), lastEntryOnPhi(P, D, j))

-- The weight of D.Column ⊆ AlgForm n κ e: a level setting whose field, CM
-- type, rank and weight datum are those of the columns (its places, level
-- group and character are unused and empty).
def columnSetting (P D L : Set) : Set :=
  LevelSetting.mk(dataE(P, D), dataPhi(P, D), dataRank(D, (0:N)), ∅, ∅, ∅,
    stageWeight(P, D, (0:N)))

-- ColumnDefs.lean, Data.Column = levelSpace (algFormRep κ (lastEntry 0))
-- (columnLevel 0): the algebraic forms on X₀ of weight (κ, e₀) fixed by
-- every k in the level of stage 0, as a set and as a ℂ-module.
def columnForms (P D L : Set) : Set :=
  { φ ∈ algForms(dataE(P, D), dataPhi(P, D), dataRank(D, (0:N)), stageWeight(P, D, (0:N))) |
    ∀ g ∈ gfMatrices(dataE(P, D), dataRank(D, (0:N))), ∀ k ∈ columnLevel(P, D, L, (0:N)),
      formAt(stageWeight(P, D, (0:N)), φ,
        matMul(finiteAdeleRing(dataE(P, D)), dataRank(D, (0:N)), dataRank(D, (0:N)),
          dataRank(D, (0:N)), g, k)) =
        formAt(stageWeight(P, D, (0:N)), φ, g) }

def columnModule (P D L : Set) : Set :=
  submoduleModule(formFunctions(dataE(P, D), dataRank(D, (0:N)), stageWeight(P, D, (0:N))),
    complexRing, columnForms(P, D, L))

end ColumnDefs
