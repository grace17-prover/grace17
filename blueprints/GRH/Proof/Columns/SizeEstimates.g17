-- Size bookkeeping for the columns: the height per row, the non-split
-- primes below x₁, the prime sum as a sum of local asks, the growth of the
-- Stirling term, the allowed loss err(p) and its weighted sum.
-- Source: grh-compact/src/New/Columns/SizeEstimates.lean. "Set-up for
-- this proof: size bookkeeping for the data of this proof. Part of:
-- Divisibility of the chain of theta lifts at each prime (see
-- New.Columns.LocalStatement). This file: Size bookkeeping: row lengths,
-- factorial sizes, class counts, sum of allowed losses."
-- (Data.heightPerRow, Data.nonsplitPrimes, primeSum_eq_sum_localAsk,
-- jetSize_le_add, Data.allowedLoss, sum_allowedLoss_mul_log_le.)
-- Encoding. The level prime N is an argument with LevelPrime(P, D, N)
-- (GRH.Proof.Seesaw.IndexTypes). Not stated here: diagramWeight_le_by_index
-- (Schur weights of Lib/GLn), norm_map_star_piG_sq, and the class counts
-- card_stdClasses_le_exp_mul_log, card_stdClasses_le_exp (StdClasses of
-- Lib/Adelic/Unitary).
-- Part of the GRH blueprint (layer 5, the argument).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Proof.Columns.SizeEstimates
import GRH.Proof.Curve.LiveSum
import GRH.Proof.Seesaw.IndexTypes

section SizeEstimates
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- SizeEstimates.lean, Data.heightPerRow:
-- m(Σ_{τ top} (st(a) − Ask(a, τ)) + k U) − |𝒯| a log N, st = jetSize,
-- Ask = primeSum, U = dirCost.
def heightTerms (P D : Set) : Set :=
  { (τ, R[jetSize(P, D, dataA(P, D)) - primeSum(P, D, realNat(dataA(P, D)), τ)]) |
    τ ∈ tops(P, D) }

def heightPerRow (P D N : Set) : Set :=
  R[realNat(D.m) * (realFiniteSum(heightTerms(P, D), tops(P, D)) +
      realNat(dataK(D)) * dirCost(P, D)) -
    realNat(cardinality(tops(P, D))) * realNat(dataA(P, D)) * realLog(realNat(N))]

-- SizeEstimates.lean, Data.nonsplitPrimes: the primes p < ⌈x₁⌉₊ with
-- (p/d) ≠ 1.
def nonsplitPrimes (P D : Set) : Set :=
  { p ∈ ℕ | R[realNat(p)] < dataX1(D) ∧ Prime(p) ∧
    quadCharAt(Parameters.d(P), p) ≠ realOne }

-- The primes below U and the terms 2 ask_p(y, σ) log p over them.
def primesBelow (U : Set) : Set := { p ∈ ℕ | p < U ∧ Prime(p) }

def askLogTerms (P D Y σ U : Set) : Set :=
  { (p, R[2 * localAsk(P, D, p, Y, σ) * realLog(realNat(p))]) | p ∈ primesBelow(U) }

-- SizeEstimates.lean, Data.primeSum_eq_sum_localAsk: for y ≤ a, a place σ
-- and U ≥ ⌈x₁⌉₊, Ask(y, σ) = Σ_{p < U prime} 2 ask_p(y, σ) log p.
theorem primeSum.eq_sum_localAsk (P D Y σ U : Set)
  requires data : Data(P, D)
  requires hU : U ∈ ℕ ∧ dataX1(D) ≤ R[realNat(U)]
  requires hY : Y ∈ ℝ ∧ (Y:R) ≤ R[realNat(dataA(P, D))]
  requires hσ : σ ∈ dataPlaces(P, D)
  shows primeSum(P, D, Y, σ) = realFiniteSum(askLogTerms(P, D, Y, σ, U), primesBelow(U))
proof
  sorry

-- SizeEstimates.lean, Data.jetSize_le_add: for l ≤ r + e,
-- st(l) ≤ st(r) + e (log(r + e + 1) − log(Ω/g)).
theorem jetSize.le_add (P D : Set, l r e : Nat)
  requires data : Data(P, D)
  requires hl : l ≤ r + e
  shows (jetSize(P, D, l):R) ≤ R[jetSize(P, D, r) +
    (realLog(R[realNat(r + e) + 1]) -
      realLog(R[bigOmega(P, D.s) / realNat(gProd(D))])) * realNat(e)]
proof
  sorry

-- SizeEstimates.lean, Data.allowedLoss: err(p) = 3 loss(p) for p a
-- non-split prime below x₁, 4 m f b for p = N, and 0 otherwise.
def allowedLoss (P D N p : Set) : Set :=
  ⋃({ v ∈ ℝ |
    (p ∈ nonsplitPrimes(P, D) ∧ v = R[3 * loss(P, D, p)]) ∨
    (p ∉ nonsplitPrimes(P, D) ∧ p = N ∧
      v = R[4 * realNat(D.m) * realNat(dataF(P, D)) * dataB(D)]) ∨
    (p ∉ nonsplitPrimes(P, D) ∧ p ≠ N ∧ v = realZero) })

def allowedLossTerms (P D N U : Set) : Set :=
  { (p, R[allowedLoss(P, D, N, p) * realLog(realNat(p))]) | p ∈ U }

-- SizeEstimates.lean, Data.sum_allowedLoss_mul_log_le: for every finite
-- set U of naturals, Σ_{p ∈ U} err(p) log p ≤ f a (log b)³ = budget.
theorem allowedLoss.sum_le_budget (P D N U : Set)
  requires data : Data(P, D)
  requires level : LevelPrime(P, D, N)
  requires hU : U ⊆ ℕ ∧ Finite(U)
  shows realFiniteSum(allowedLossTerms(P, D, N, U), U) ≤ (budget(P, D):R)
proof
  sorry

end SizeEstimates
