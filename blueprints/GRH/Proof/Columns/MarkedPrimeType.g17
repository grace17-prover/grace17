module GRH.Proof.Columns.MarkedPrimeType
import GRH.Proof.Columns.TwistedHeckeType

section MarkedPrimeType
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- MarkedPrimeType.lean, Data.IsMarked.hasType_markOperator: for Λ marked at
-- p, l ∈ Λ and any s, p^{A_l} T_{l,𝔯} keeps the integral columns and is onto
-- modulo p^s up to an index of exponent at most
-- (128 A_l log b/(m p) + s/x¹⁴ + x⁴⁰) dim(columns).
theorem IsMarked.hasType_markOperator (P D L p ι Λ l : Set, s : Nat)
  requires system : LiftSystemOf(P, D, L)
  requires prime : Prime(p)
  requires place : ι ∈ padicPlaces(p)
  requires marked : IsMarked(P, D, p, ι, Λ)
  requires hl : l ∈ Λ
  shows HasType(P, D, L, p, ι, integralColumnSet(P, D, L, p, ι), s,
    markOperator(P, D, L, p, ι, l),
    R[(128 * realNat(markExponent(P, D, p, ι, l)) *
        (D.logB / (realNat(D.m) * realNat(p))) +
      1 / dataX(D) ^ 14 * realNat(s) + dataX(D) ^ 40) * realNat(columnDim(P, D, L))])
proof
  sorry

end MarkedPrimeType
