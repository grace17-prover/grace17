-- The fixed parameters of the proof: a positive multiple N₀ of 18480 and
-- a prime d ≡ N₀/2 − 1 mod N₀; N₁ = 3^c 2^s N₀; the infinite places of
-- E = K(ζ_{N₁}), K = ℚ(√−d), as the units modulo N₁; the classes of a
-- place modulo the divisors of N₁; the root discriminant of E and the
-- period Ω.
-- Source: grh-compact/src/New/Data/Different.lean. "Parameters N₀, d;
-- fields K, E; infinite places as a group; CM type. Dictionary between
-- places, Galois elements and residue classes; counts of all infinite
-- places of E and of those congruent to 1 modulo N₀. [...] Different of
-- K(ζ) over K and ℚ, monogenicity, imaginary generator, its size."
-- Set-up for this proof: records of the data and parameters of this
-- proof, names for its objects; dictionaries between two encodings of
-- the same objects.
-- Encoding. The source's places Φ = InfinitePlace E form a group through
-- Gal(E/K) ≅ (ℤ/N₁)ˣ (`Parameters.placeMulEquiv`); this port writes a
-- place as its residue a, 0 ≤ a < N₁, gcd(a, N₁) = 1, under that
-- dictionary, so the group law is multiplication modulo N₁ and
-- `placeClass` is reduction modulo a divisor of N₁.
-- Part of the GRH blueprint (layer 5, the argument).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Proof.Data.Different
import GRH.Proof.Endgame.PrimeError
import GRH.Proof.Forward.Jets

-- Different.lean, Parameters: N₀ a positive multiple of 18480 and d a
-- prime with N₀ ∣ 2(d + 1) and N₀ ∤ d + 1, that is d ≡ N₀/2 − 1 mod N₀.
structure Parameters
  | N0 d : ℕ
  where
    dvd_N₀ : 18480 ∣ N0
    d_prime : Prime(d)
    d_congr : N0 ∣ 2 * (d + 1) ∧ ¬(N0 ∣ d + 1)

-- ⌊log₃ s⌋ (Mathlib's Nat.log 3 s, 0 for s = 0): the least k with
-- s < 3^(k+1).
def log3Candidates (s : Nat) : Set := { k ∈ ℕ | s < 3 ^ (k + 1) }
def natLog3 (s : Nat) : Nat := leastNatural(log3Candidates(s))
proof
  sorry

-- Different.lean, towerDeg: 3^c 2^s with c = ⌊log₃ s⌋ + 5.
def towerDeg (s : Nat) : Nat := 3 ^ (natLog3(s) + 5) * 2 ^ s
proof
  sorry

-- Different.lean, Parameters.N₁: N₁ = 3^c 2^s N₀.
def levelN1 (P : Parameters, s : Nat) : Nat := mul(Parameters.N0(P), towerDeg(s))
proof
  sorry

-- Different.lean, Parameters.Mω: M_ω = (N₀ d)^(s+6).
def levelMomega (P : Parameters, s : Nat) : Nat :=
  pow(mul(Parameters.N0(P), Parameters.d(P)), s + 6)
proof
  sorry

-- The units modulo N, as their residues 0 ≤ a < N.
def unitResidues (N : Nat) : Set := { a ∈ ℕ | a < N ∧ gcd(a, N) = 1 }

-- Different.lean, Parameters.Φ: the infinite places of E = K(ζ_{N₁}),
-- through the dictionary `placeMulEquiv` with (ℤ/N₁)ˣ.
def places (P : Parameters, s : Nat) : Set := unitResidues(levelN1(P, s))

-- The product of two places (the group law of Φ), and the quotient τ/σ is
-- not needed: the conditions on places below are stated without inverses.
def placeMul (P : Parameters, s σ τ : Nat) : Set :=
  (σ * τ) % levelN1(P, s)

-- Different.lean, Parameters.placeOfInt at −ν for a natural ν: the place
-- of the class of −ν modulo N₁ if ν is prime to N₁, and the identity
-- place 1 otherwise.
def placeOfNegNat (P : Parameters, s ν : Nat) : Set :=
  ⋃({ σ ∈ ℕ |
    (gcd(ν, levelN1(P, s)) = 1 ∧
      σ = (levelN1(P, s) - ν % levelN1(P, s)) % levelN1(P, s)) ∨
    (¬(gcd(ν, levelN1(P, s)) = 1) ∧ σ = 1) })

section Different
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- The terms log p/(p − 1) over the primes p dividing N, indexed by
-- j = 0, 1, …, N (0 off the primes dividing N).
def rootDiscLogValue (N j : Nat) : Set :=
  ⋃({ w ∈ ℝ |
    ((Prime(j) ∧ j ∣ N) ∧ w = R[realLog(realNat(j)) / realNat(j - 1)]) ∨
    (¬(Prime(j) ∧ j ∣ N) ∧ w = realZero) })
def rootDiscLogTerms (N : Nat) : Set :=
  { (j, rootDiscLogValue(N, j)) | j ∈ ℕ }

-- FORWARD (formula). Different.lean's rootDiscr (P.E s), the root
-- discriminant |disc E|^(1/[E:ℚ]) of E = K(ζ_{N₁}). Its value
-- √d · N₁ · ∏_{p ∣ N₁} p^(−1/(p−1)) (K and ℚ(ζ_{N₁}) have coprime
-- discriminants −d and that of ℚ(ζ_{N₁})) is written here; layer 4
-- defines rootDiscr from the discriminant (GRH.NumberField.Discriminant)
-- and proves this formula, after which the name keeps its value.
def rootDiscE (P : Parameters, s : Nat) : Set :=
  R[realSqrt(realNat(Parameters.d(P))) * realNat(levelN1(P, s)) *
    realExp(-realPartialSum(rootDiscLogTerms(levelN1(P, s)),
      succ(levelN1(P, s))))]

-- Different.lean, bigOmega: Ω = exp(γ − Re L′/L(1, χ_K)) · 2π/rd_E.
def bigOmega (P : Parameters, s : Nat) : Set :=
  R[realExp(chowlaSelbergConst(Parameters.d(P))) *
    (2 * realPi / rootDiscE(P, s))]

-- e^(2πik/N), the primitive N-th roots of unity being those with
-- k a unit modulo N.
def rootOfUnity (N k : Nat) : Set :=
  complexExp(ℂ[complexImaginaryUnit *
    complexOfReal(R[2 * realPi * realNat(k) / realNat(N)])])

-- log |ζ_k − ζ_j| over the primitive roots ζ_j ≠ ζ_k.
def cycloDerivLogTerms (N k : Nat) : Set :=
  { (j, realLog(complexAbs(ℂ[rootOfUnity(N, k) - rootOfUnity(N, j)]))) |
    j ∈ unitResidues(N) ∖ {k} }

-- |log ‖Φ_N′(ζ_k)‖| = |Σ_{j ≠ k} log |ζ_k − ζ_j||, as Φ_N(X) is the
-- product of X − ζ_j over the primitive N-th roots ζ_j.
def cycloDerivLogAbs (N : Nat) : Set :=
  { (k, abs(realFiniteSum(cycloDerivLogTerms(N, k),
      unitResidues(N) ∖ {k}))) | k ∈ unitResidues(N) }

-- Σ_ξ |log ‖Φ_{N}′(ξ)‖| over the primitive N-th roots of unity ξ (in
-- AdmissibleData.lean, Parameters.c).
def cycloDerivLogSum (N : Nat) : Set :=
  realFiniteSum(cycloDerivLogAbs(N), unitResidues(N))

-- AdmissibleData.lean, Parameters.c: C + 2d + 6 + N₀ +
-- |chowlaSelbergConst d| + Σ_ξ |log |P₀′(ξ)||. The source chooses C from
-- Parameters.exists_isJetConjugate_generator; here C is a field of the
-- data (`Data.jetConst`), any C with that property.
def paramC (P : Parameters, C : Set) : Set :=
  R[realNat(C) + realNat(2 * Parameters.d(P) + 6) +
    (realNat(Parameters.N0(P)) + abs(chowlaSelbergConst(Parameters.d(P))) +
      cycloDerivLogSum(Parameters.N0(P)))]

end Different

section JetGenerator
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- The vacuum part of exists_isJetConjugate_generator at one standard V:
-- some c ≠ 0 makes the values c·vac integral at every p-adic place and of
-- size at most e^{C N₁² n} at every σ ∈ Gal(ℂ/K), n the rank of V.
predicate VacuumIntegralBound (P C s V : Set) :=
  ∃ c ∈ complexCarrier, c ≠ ℂ[0] ∧
    (∀ p ∈ ℕ, Prime(p) → ∀ ι ∈ padicPlaces(p), ∀ x ∈ spacePoints(V),
      RealLe(padicPlaceNorm(p, ι, ℂ[c * vacValue(V, x)]), realOne)) ∧
    (∀ σ ∈ galoisOverK(Parameters.d(P)), ∀ x ∈ spacePoints(V),
      complexAbs(σ(ℂ[c * vacValue(V, x)])) ≤
        R[realExp(R[realNat(C) * realNat(levelN1(P, s)) ^ 2]) ^
          spaceRank(V)])

-- The generator part at V: some F ∈ 𝒲_f with θF = 1 whose translates span
-- 𝒲_f, and for each σ ∈ Gal(ℂ/K) some t with |t|² = 1/Ω and F′ ∈ 𝒲_f with
-- σ T_per ϱ(x)F = T_t ϱ(B_σ x)F′ (IsJetConjugate) for every x.
predicate JetGenerator (P s B V : Set) :=
  ∃ F ∈ finitePart(V), thetaValue(V, F) = ℂ[1] ∧
    finitePart(V) ⊆ moduleSpan(weilForms(V), complexRing, weilOrbit(V, F)) ∧
    (∀ σ ∈ galoisOverK(Parameters.d(P)), ∃ t ∈ complexCarrier,
      ∃ G ∈ finitePart(V),
        R[complexAbs(t) ^ 2] = R[1 / bigOmega(P, s)] ∧
        (∀ x ∈ spacePoints(V),
          IsJetConjugate(P, s, σ, t, weilAction(V, x, F),
            weilAction(V, ideleAct(V, B(σ), x), G))))

-- ConjugateGenerator.lean, Parameters.exists_isJetConjugate_generator: C
-- serves every s: for each s some B : Gal(ℂ/K) → 𝔸f(E)ˣ makes every
-- standard V satisfy the vacuum bound and the generator property. The
-- source's c chooses C by this property (Parameters.c); here C is the
-- field Data.jetConst bound by it.
predicate JetConjugateBound (P C : Set) :=
  C ∈ ℕ ∧ ∀ s ∈ ℕ, ∃ B,
    (B : galoisOverK(Parameters.d(P)) → finiteIdeles(P, s)) ∧
    ∀ V ∈ stdSpaces(P, s),
      VacuumIntegralBound(P, C, s, V) ∧ JetGenerator(P, s, B, V)

end JetGenerator

-- Section: The dictionary
-- Different.lean, Parameters.card_infinitePlace_E: the number of infinite
-- places of E is φ(N₁) (here by the dictionary, a theorem of layer 4 in
-- the source's encoding).
theorem places.card (P : Set, s : Nat)
  requires parameters : Parameters(P)
  shows HasCardinality(places(P, s), totient(levelN1(P, s)))
proof
  sorry

-- Different.lean, Parameters.coprime_N₁_d: gcd(N₁, d) = 1.
theorem levelN1.coprime_d (P : Set, s : Nat)
  requires parameters : Parameters(P)
  shows gcd(levelN1(P, s), Parameters.d(P)) = 1
proof
  sorry

-- Different.lean, Parameters.lt_d: 64 < d.
theorem Parameters.lt_d (P : Set)
  requires parameters : Parameters(P)
  shows 64 < Parameters.d(P)
proof
  sorry

-- Different.lean, instHeegD: d is a prime ≡ 7 mod 8.
theorem Parameters.prime_seven_mod_eight (P : Set)
  requires parameters : Parameters(P)
  shows PrimeSevenModEight(Parameters.d(P))
proof
  sorry
