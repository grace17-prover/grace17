-- Admissible data exist for every large x, and so do their systems of
-- lifts: the one place where the hypothesis bundle Data(P, D) is
-- discharged (only GRH.Proof.Main uses it).
-- Source: grh-compact/src/New/Data/DataExist.lean. "Admissible data
-- exist for large x; Behrend sets and class-group pigeonhole as inputs."
-- Known result: Behrend's construction for several equations at once.
-- Here all ratios up to a given bound are avoided at once, in a coset of
-- a cyclic group seen through a homomorphism, with the explicit count of
-- points on a sphere. Source: Shapira, Behrend-type constructions for
-- sets of linear equations, Acta Arith. 2006, Thm 1 (after Behrend, PNAS
-- 32, 1946).
-- Part of the GRH blueprint (layer 5, the argument).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Proof.Data.DataExist
import GRH.Proof.Endgame.OneSidedCriterion
import GRH.Proof.Forward.Lifts

section DataExist
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- The conclusion of exists_data at x: D is admissible with x(D) = x,
-- log x₁ = x^(ε/6) ≥ (10⁶ log x)², log log b = ε log x, and at least
-- 3^c 2^s / log b thick places.
predicate DataAt (P D : Set, E X : Real) :=
  Data(P, D) ∧ dataX(D) = X ∧ D.logX1 = realRpow(X, R[E / 6]) ∧
  R[(1000000 * realLog(X)) ^ 2] ≤ (D.logX1:R) ∧
  realLog(D.logB) = R[E * realLog(X)] ∧
  R[realNat(towerDeg(D.s)) / D.logB] ≤ R[realNat(cardinality(D.thick))]

-- DataExist.lean, exists_data: for 0 < ε < 1/100 and all large x there
-- are admissible data at x.
theorem Data.exists_data (P : Set, E : Real)
  requires parameters : Parameters(P)
  requires positive : (0:R) < R[E / 6]
  requires small : E < R[1 / 100]
  shows ∃ X0 ∈ ℝ, ∀ X ∈ ℝ, X0 ≤ X → ∃ D, DataAt(P, D, E, X)
proof
  sorry

-- The system of lifts of admissible data exists (in the source, the
-- objects are definitions on every D : Data P; see GRH.Proof.Forward.Lifts).
theorem LiftSystemOf.exists (P D : Set)
  requires data : Data(P, D)
  shows ∃ L, LiftSystemOf(P, D, L)
proof
  sorry

end DataExist
