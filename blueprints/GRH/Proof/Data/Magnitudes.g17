-- Size bookkeeping for admissible data: the logarithmic bounds
-- |F| ≤ e^l and e^l ≤ F, the comparison they give, and the sizes of the
-- ranks and weights the endgame uses.
-- Source: grh-compact/src/New/Data/Magnitudes.lean ("Logarithmic size
-- calculus (upper and lower exponent bounds) for the parameters of the
-- data") and New/Data/Weights.lean ("Size comparisons among nominal
-- weights and weights of the lifts"). Set-up for this proof: size
-- bookkeeping for the data of this proof.
-- The source's class HasLogBound drives instance search; here the two
-- bounds are predicates and the instances are theorems, stated as they
-- are needed.
-- Part of the GRH blueprint (layer 5, the argument).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Proof.Data.Magnitudes
import GRH.Proof.Data.AdmissibleData

section Magnitudes
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Magnitudes.lean, Data.HasLogUpper and Data.HasLogLower: |F| ≤ e^l, and
-- e^l ≤ F.
predicate HasLogUpper (F L : Real) := abs(F) ≤ realExp(L)
predicate HasLogLower (F L : Real) := realExp(L) ≤ F

-- Magnitudes.lean, Data.c_ge: 64 ≤ c, N₀ ≤ c, d ≤ c, φ(N₀) ≤ c.
theorem paramC.ge (P D : Set)
  requires data : Data(P, D)
  shows R[64] ≤ (paramC(P, D.jetConst):R) ∧
    R[realNat(Parameters.N0(P))] ≤ (paramC(P, D.jetConst):R) ∧
    R[realNat(Parameters.d(P))] ≤ (paramC(P, D.jetConst):R) ∧
    R[realNat(totient(Parameters.N0(P)))] ≤ (paramC(P, D.jetConst):R)
proof
  sorry

-- Magnitudes.lean, Data.le_m: 10000 ≤ m.
theorem Data.le_m (P D : Set)
  requires data : Data(P, D)
  shows (10000:N) ≤ D.m
proof
  sorry

-- Magnitudes.lean, Data.r_add: r + 1 = k + m.
theorem Data.r_add (P D : Set)
  requires data : Data(P, D)
  shows add(D.r, 1) = add(dataK(D), D.m)
proof
  sorry

-- Magnitudes.lean, Data.hundred_mul_m_le_k: 100 m ≤ k.
theorem Data.hundred_mul_m_le_k (P D : Set)
  requires data : Data(P, D)
  shows mul(100, D.m) ≤ dataK(D)
proof
  sorry

-- Magnitudes.lean, Data.k_add_t_add_one_le_h₂: k + t + 1 ≤ h₂ = r⁸.
theorem Data.k_add_t_add_one_le_h2 (P D : Set)
  requires data : Data(P, D)
  shows add(add(dataK(D), dataT(D)), 1) ≤ dataH2(D)
proof
  sorry

-- Magnitudes.lean, Data.roundUp_mem_Icc: for F ≥ e^l, roundUp(F) lies in
-- [F, F + N₁].
theorem roundUp.mem_Icc (P D : Set, F L : Real)
  requires data : Data(P, D)
  requires lower : HasLogLower(F, L)
  shows (F:R) ≤ R[realNat(roundUp(P, D, F))] ∧
    R[realNat(roundUp(P, D, F))] ≤ R[F + realNat(dataN1(P, D))]
proof
  sorry

-- Magnitudes.lean, instance HasLogBound D u D.a: e^(log b + log x) ≤ a
-- ≤ e^(log b + log x + 1).
theorem dataA.log_bounds (P D : Set)
  requires data : Data(P, D)
  shows HasLogLower(R[realNat(dataA(P, D))], R[D.logB + D.logX]) ∧
    HasLogUpper(R[realNat(dataA(P, D))], R[D.logB + D.logX + 1])
proof
  sorry

-- Magnitudes.lean, instance hasLogBound_f: x¹¹ ≤ f ≤ e^c x¹¹ (log b)^(1/5).
theorem dataF.log_bounds (P D : Set)
  requires data : Data(P, D)
  shows HasLogLower(R[realNat(dataF(P, D))], R[11 * D.logX]) ∧
    HasLogUpper(R[realNat(dataF(P, D))],
      R[11 * D.logX + realLog(D.logB) / 5 + paramC(P, D.jetConst)])
proof
  sorry

-- Weights.lean, Data.nominalWeight_mem_Icc: a/x₁ ≤ w(σ) ≤ a/x.
theorem nominalWeight.mem_Icc (P D σ : Set)
  requires data : Data(P, D)
  requires place : σ ∈ dataPlaces(P, D)
  shows R[realNat(dataA(P, D)) / dataX1(D)] ≤ (nominalWeight(P, D, σ):R) ∧
    (nominalWeight(P, D, σ):R) ≤ R[realNat(dataA(P, D)) / dataX(D)]
proof
  sorry

-- Weights.lean, Data.nominalWeight_add_le: w(σ) + x⁴² ≤ 2b.
theorem nominalWeight.add_le (P D σ : Set)
  requires data : Data(P, D)
  requires place : σ ∈ dataPlaces(P, D)
  shows R[nominalWeight(P, D, σ) + dataX(D) ^ 42] ≤ R[2 * dataB(D)]
proof
  sorry

-- Weights.lean, Data.w_le_nominalWeight_add: for j ≤ 2m,
-- w(σ) ≤ w_j(σ) − h₂ and w_j(σ) ≤ w(σ) + x⁴².
theorem weight.near_nominal (P D σ : Set, j : Nat)
  requires data : Data(P, D)
  requires place : σ ∈ dataPlaces(P, D)
  requires small : j ≤ mul(2, D.m)
  shows (nominalWeight(P, D, σ):R) ≤
      R[realNat(weight(P, D, j, σ)) - realNat(dataH2(D))] ∧
    R[realNat(weight(P, D, j, σ))] ≤ R[nominalWeight(P, D, σ) + dataX(D) ^ 42]
proof
  sorry

end Magnitudes
