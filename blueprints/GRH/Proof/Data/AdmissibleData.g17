-- Admissible data, as a hypothesis bundle: the record of scales x, x₁, b
-- (stored as their logarithms), the exponent s, the numbers m and r, the
-- thick places, the primes g₀ ≠ g₁ and an integer of K of norm g₀g₁,
-- with the conditions the source's structure `Data` imposes; and the
-- names the source gives to its derived numbers: ranks, weights, the
-- prime sum, the error budget and the cost of one direction.
-- Source: grh-compact/src/New/Data/AdmissibleData.lean. "Record of
-- admissible data; names for ranks, weights, the prime sum, the error
-- budget and the cost of one direction." Set-up for this proof: records
-- of the data and parameters of this proof, names for its objects.
-- Encoding. `Data P` is a predicate on a record (`DataRecord`): every
-- theorem of layer 5 assumes Data(P, D), and GRH.Proof.Data.DataExist
-- proves once that such D exist. The source's choice-made constant C of
-- Parameters.c is a field (`jetConst`) bound by JetConjugateBound. A place
-- is a unit residue modulo N₁ (GRH.Proof.Data.Different); piG ∈ 𝓞_K,
-- K = ℚ(√−d), d ≡ 3 mod 4, is A + B(1 + √−d)/2, of norm
-- A² + AB + B²(d + 1)/4.
-- Part of the GRH blueprint (layer 5, the argument).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Proof.Data.AdmissibleData
import GRH.Proof.Data.Different

-- The fields of AdmissibleData.lean's structure Data: logX = log x,
-- logB = log b, logX1 = log x₁; s, m, r; thick; g = (g0, g1); piG as
-- (piA, piB); and the constant C of Parameters.c.
structure DataRecord
  | logX logB logX1 : Real
  | s m r : ℕ
  | thick : Set
  | g0 g1 : ℕ
  | piA piB : Integer
  | jetConst : ℕ

-- Section: Derived numbers
-- AdmissibleData.lean, Data.N₁ and Data.Φ.
def dataN1 (P : Parameters, D : DataRecord) : Nat := levelN1(P, D.s)
proof
  sorry
def dataPlaces (P : Parameters, D : DataRecord) : Set := places(P, D.s)

-- AdmissibleData.lean, Data.f: the number of infinite places of E.
def dataF (P : Parameters, D : DataRecord) : Nat :=
  cardinality(dataPlaces(P, D))
proof
  sorry

-- AdmissibleData.lean, Data.k = (r + 1) − m (truncated) and Data.t = 5r.
def dataK (D : DataRecord) : Nat := sub(add(D.r, 1), D.m)
proof
  sorry
def dataT (D : DataRecord) : Nat := mul(5, D.r)
proof
  sorry

-- AdmissibleData.lean, Data.h₂ = r⁸ and Data.h = 2h₂.
def dataH2 (D : DataRecord) : Nat := pow(D.r, 8)
proof
  sorry
def dataH (D : DataRecord) : Nat := mul(2, dataH2(D))
proof
  sorry

-- AdmissibleData.lean, Data.n: the rank n_j = k + j(t + 1).
def dataRank (D : DataRecord, j : Nat) : Nat :=
  add(dataK(D), mul(j, add(dataT(D), 1)))
proof
  sorry

-- AdmissibleData.lean, Data.gProd: g = g₀ g₁.
def gProd (D : DataRecord) : Nat := mul(D.g0, D.g1)
proof
  sorry

-- AdmissibleData.lean, Data.tops: the places congruent to 1 modulo N₀.
def tops (P : Parameters, D : DataRecord) : Set :=
  { τ ∈ dataPlaces(P, D) | CongruentMod(τ, 1, Parameters.N0(P)) }

section AdmissibleData
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- AdmissibleData.lean, Data.x, Data.x₁, Data.b: x = e^logX, x₁ = e^logX₁,
-- b = e^logB.
def dataX (D : DataRecord) : Set := realExp(D.logX)
def dataX1 (D : DataRecord) : Set := realExp(D.logX1)
def dataB (D : DataRecord) : Set := realExp(D.logB)

-- AdmissibleData.lean, Data.roundUp: N₁⌈y/N₁⌉₊, the least natural
-- multiple of N₁ that is at least y (0 when y ≤ 0).
def roundUpCandidates (P : Parameters, D : DataRecord, Y : Set) : Set :=
  { n ∈ ℕ | dataN1(P, D) ∣ n ∧ Y ≤ (realNat(n):R) }
def roundUp (P : Parameters, D : DataRecord, Y : Set) : Nat :=
  leastNatural(roundUpCandidates(P, D, Y))
proof
  sorry

-- AdmissibleData.lean, Data.a: the least multiple of N₁ at least x b.
def dataA (P : Parameters, D : DataRecord) : Nat :=
  roundUp(P, D, R[dataX(D) * dataB(D)])

-- AdmissibleData.lean, Data.b₁ and Data.b₂: the least multiples of N₁ at
-- least a/x and a/x₁.
def dataB1 (P : Parameters, D : DataRecord) : Nat :=
  roundUp(P, D, R[realNat(dataA(P, D)) / dataX(D)])
def dataB2 (P : Parameters, D : DataRecord) : Nat :=
  roundUp(P, D, R[realNat(dataA(P, D)) / dataX1(D)])

-- AdmissibleData.lean, Data.w: w_j(σ) = w_j⁻(σ) + h₂, with w_j⁻(σ) =
-- b₁ + jh at a thick place σ and b₂ + jh elsewhere.
def weightBase (P : Parameters, D : DataRecord, σ : Set) : Nat :=
  ⋃({ n ∈ ℕ | (σ ∈ D.thick ∧ n = dataB1(P, D)) ∨
    (σ ∉ D.thick ∧ n = dataB2(P, D)) })
proof
  sorry
def weight (P : Parameters, D : DataRecord, j : Nat, σ : Set) : Nat :=
  add(add(weightBase(P, D, σ), mul(j, dataH(D))), dataH2(D))
proof
  sorry

-- AdmissibleData.lean, Data.nominalWeight: a/x at a thick place, a/x₁
-- elsewhere.
def nominalWeight (P : Parameters, D : DataRecord, σ : Set) : Set :=
  ⋃({ w ∈ ℝ |
    (σ ∈ D.thick ∧ w = R[realNat(dataA(P, D)) / dataX(D)]) ∨
    (σ ∉ D.thick ∧ w = R[realNat(dataA(P, D)) / dataX1(D)]) })

-- The terms λ(ν)(y/ν − w(−ν·σ))⁺ of the prime sum, ν = j + 1, with λ the
-- weight of modulus 1.
def primeSumTerms (P : Parameters, D : DataRecord, Y σ : Set) : Set :=
  { (j, R[lambdaClass(Parameters.d(P), 1, succ(j)) *
      posPart(R[Y / realNat(succ(j)) - nominalWeight(P, D,
        placeMul(P, D.s, placeOfNegNat(P, D.s, succ(j)), σ))])]) |
    j ∈ ℕ }

-- AdmissibleData.lean, Data.primeSum: for real y and a place σ,
-- Σ_{1 ≤ ν ≤ a} Λ(ν)(1 − (ν/d)) max(y/ν − w(−ν·σ), 0).
def primeSum (P : Parameters, D : DataRecord, Y σ : Set) : Set :=
  realPartialSum(primeSumTerms(P, D, Y, σ), dataA(P, D))

-- AdmissibleData.lean, Data.budget: the error budget f a (log b)³.
def budget (P : Parameters, D : DataRecord) : Set :=
  R[realNat(dataF(P, D)) * realNat(dataA(P, D)) * D.logB ^ 3]

-- AdmissibleData.lean, Data.jetSize: log j! − j log(Ω/g).
def jetSize (P : Parameters, D : DataRecord, j : Nat) : Set :=
  R[realLog(realNat(j !)) -
    realNat(j) * realLog(R[bigOmega(P, D.s) / realNat(gProd(D))])]

-- The terms jetSize(w₀(σ)) − primeSum(w(σ), σ) over the places σ.
def dirCostTerms (P : Parameters, D : DataRecord) : Set :=
  { (σ, R[jetSize(P, D, weight(P, D, 0, σ)) -
      primeSum(P, D, nominalWeight(P, D, σ), σ)]) | σ ∈ dataPlaces(P, D) }

-- AdmissibleData.lean, Data.dirCost: the cost of one direction,
-- Σ_σ (jetSize(w₀(σ)) − primeSum(w(σ), σ)).
def dirCost (P : Parameters, D : DataRecord) : Set :=
  realFiniteSum(dirCostTerms(P, D), dataPlaces(P, D))

-- Section: The conditions
-- Data.s_le and Data.scale: s ≤ 32 log x, and
-- 10¹² c ≤ log log b, 100 log log b ≤ log x, 10⁶ log x ≤ log x₁,
-- 10⁶ log x₁ ≤ log b, 6 log log x₁ ≤ log log b.
predicate DataScale (P D : Set) :=
  R[realNat(D.s)] ≤ R[32 * D.logX] ∧
  R[1000000000000 * paramC(P, D.jetConst)] ≤ realLog(D.logB) ∧
  R[100 * realLog(D.logB)] ≤ D.logX ∧
  R[1000000 * D.logX] ≤ D.logX1 ∧
  R[1000000 * D.logX1] ≤ D.logB ∧
  R[6 * realLog(D.logX1)] ≤ realLog(D.logB)

-- Data.m_mem, Data.r_mem, Data.m_pow, Data.r_pow: e^(logX/2) ≤ m ≤
-- 2e^(logX/2), e^(5 logX) ≤ r ≤ 3e^(5 logX), m = 2^(e+1) with
-- s = 22(e + 1), and r = 3^(e+1).
predicate DataRanks (D : Set) :=
  realExp(R[D.logX / 2]) ≤ R[realNat(D.m)] ∧
  R[realNat(D.m)] ≤ R[2 * realExp(R[D.logX / 2])] ∧
  realExp(R[5 * D.logX]) ≤ R[realNat(D.r)] ∧
  R[realNat(D.r)] ≤ R[3 * realExp(R[5 * D.logX])] ∧
  (∃ e ∈ ℕ, D.m = pow(2, e + 1) ∧ D.s = mul(e + 1, 22)) ∧
  (∃ e ∈ ℕ, D.r = pow(3, e + 1))

-- Data.thick_eq_neg_one_mod and Data.three_term: the thick places are
-- places, ≡ −1 modulo every divisor of N₁ dividing N₀ 3^(⌊log₃ s⌋+5); and
-- for 0 < i < j ≤ 324 s and thick σ, τ, ρ, the classes modulo 2^(s+1)
-- satisfy φ(τ/σ)^j = φ(ρ/σ)^i only if φ(τ/σ) = 1, written without
-- inverses: τ^j σ^i ≡ ρ^i σ^j forces τ ≡ σ.
predicate DataThick (P D : Set) :=
  D.thick ⊆ places(P, D.s) ∧
  (∀ k ∈ ℕ, k ∣ levelN1(P, D.s) →
    k ∣ mul(Parameters.N0(P), pow(3, add(natLog3(D.s), 5))) →
    ∀ σ ∈ D.thick, CongruentMod(add(σ, 1), (0:N), k)) ∧
  (∀ i ∈ ℕ, ∀ j ∈ ℕ, 0 < i → i < j → j ≤ mul(324, D.s) →
    ∀ σ ∈ D.thick, ∀ τ ∈ D.thick, ∀ ρ ∈ D.thick,
      CongruentMod(mul(pow(τ, j), pow(σ, i)), mul(pow(ρ, i), pow(σ, j)),
        pow(2, add(D.s, 1))) →
      CongruentMod(τ, σ, pow(2, add(D.s, 1))))

-- One of the primes g₀, g₁: Data.g_prime, Data.g_modEq_one,
-- Data.dvd_g_sub_one, Data.g_mem.
predicate DataPrime (P D g : Set) :=
  Prime(g) ∧ CongruentMod(g, (1:N), mul(levelN1(P, D.s), Parameters.d(P))) ∧
  pow(levelMomega(P, D.s), 2) ∣ sub(g, (1:N)) ∧
  realExp(D.logB) ^ 10 ≤ R[realNat(g)] ∧
  R[realNat(g)] ≤ realExp(D.logB) ^ 11

-- Data.g_*, Data.g_injective, Data.norm_piG: two distinct such primes,
-- and π_G = A + B(1 + √−d)/2 ∈ 𝓞_K with π_G π̄_G = g₀ g₁, that is
-- 4(A² + AB) + (d + 1)B² = 4 g₀ g₁.
predicate DataPrimes (P D : Set) :=
  DataPrime(P, D, D.g0) ∧ DataPrime(P, D, D.g1) ∧ D.g0 ≠ D.g1 ∧
  R[4 * (realInt(D.piA) ^ 2 + realInt(D.piA) * realInt(D.piB)) +
    realNat(add(Parameters.d(P), 1)) * realInt(D.piB) ^ 2] =
    R[4 * realNat(mul(D.g0, D.g1))]

-- Data.exists_prime_window: for 100 log b ≤ U ≤ 2^s some prime
-- p ≡ 1 mod M_ω² has U ≤ log p ≤ U + √(log b).
predicate DataWindow (P D : Set) :=
  ∀ U ∈ ℝ, R[100 * D.logB] ≤ U → U ≤ R[realNat(pow(2, D.s))] →
    ∃ p ∈ ℕ, Prime(p) ∧ CongruentMod(p, (1:N), pow(levelMomega(P, D.s), 2)) ∧
      U ≤ realLog(realNat(p)) ∧
      realLog(realNat(p)) ≤ R[U + realSqrt(D.logB)]

-- AdmissibleData.lean, structure Data P: D is admissible data for the
-- parameters P.
predicate Data (P D : Set) :=
  Parameters(P) ∧ DataRecord(D) ∧ JetConjugateBound(P, D.jetConst) ∧
  DataScale(P, D) ∧ DataRanks(D) ∧ DataThick(P, D) ∧ DataPrimes(P, D) ∧
  DataWindow(P, D)

end AdmissibleData
