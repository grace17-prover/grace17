-- The CM theta functions and their p-adic Taylor series, read from
-- layer 4: the twisted translations U^m_y of a CM datum, its theta
-- function θ = U_tσ/U_tσ(0), ξ = ℘(z + t) − ℘(t), φ = (℘′(z + t) − a₁ξ)/2,
-- the entire function G = φθ³ and the monomial sections θ^a σ^{2b} G^c;
-- Taylor series at 0, read in ℂ_p through a p-adic place, substitution
-- into linear forms, the subring 𝔬[[φ]] and exp(κψ).
-- Source: grh-compact/src/Lib/CM/Sigma/CurveTheta.lean (taylorAtZero,
-- taylorVia, linearSeries, CMLattice.twistedTranslate, CMLattice.θ,
-- translatedWp, translatedWpDeriv, phiThetaCube),
-- Lib/CM/Sigma/PadicSeriesDefs.lean (monomialDeg, monomialSection,
-- valRingCp, seriesToCp), Lib/CM/LocalHeight/IntegralParameter.lean
-- (expSubst, CMLattice.phiSeriesRing),
-- Lib/CM/LocalHeight/IsogenyIntegrality.lean (congruencePart),
-- Lib/CM/Sigma/SigmaFunction.lean (the sigma function σ of a lattice).
-- Encoding. A series over 𝔬 = valRingCp p is a series over ℂ_p whose
-- coefficients lie in the integers of ℂ_p (seriesToCp is the inclusion).
-- The substitution F(Σ_i c_i X_i) of a series in one variable is written
-- coefficientwise: its coefficient at z^m is F_{|m|} times that of
-- (Σ c_i X_i)^{|m|}. The sigma function is FORWARD (placeholder ∅) until
-- Lib/CM/Sigma is stated; everything else in the first sections is
-- defined from it. The Schur jets (Lib/GLn, Lib/Weil/Construction/
-- DataProduct.lean: WeylIndex, schurJet and the charges of the row
-- tableaux) are FORWARD.
-- Part of the GRH blueprint (layer 5, the argument).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Proof.Forward.Theta
import GRH.Proof.Curve.PeriodDefs
import GRH.Calculus.Analytic

section Theta
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Section: Functions on ℂ attached to a CM datum
-- FORWARD. SigmaFunction.lean, the Weierstrass sigma function σ_Λ of the
-- lattice of C (an entire function ℂ → ℂ), PeriodPair.sigma.
def cmSigma (C : Set) : Set := ∅

-- CurveTheta.lean, CMLattice.twistedTranslate m y F:
-- (U^m_y F)(z) = exp(−mπ(z ȳ + |y|²/2)/A) F(z + y), A the area of Λ.
def twistedTranslate (C m y F : Set) : Set :=
  { (z, ℂ[complexExp(ℂ[-(complexOfReal(R[realNat(m) * realPi / cmArea(C)]) *
      (z * complexConj(y) + complexOfReal(R[complexAbs(y) ^ 2 / 2])))]) *
      F(ℂ[z + y])]) | z ∈ complexCarrier }

-- CurveTheta.lean, CMLattice.θ: z ↦ (U_tσ)(z)/(U_tσ)(0).
def cmTheta (C : Set) : Set :=
  { (z, complexDiv(twistedTranslate(C, (1:N), C.t, cmSigma(C))(z),
      twistedTranslate(C, (1:N), C.t, cmSigma(C))(complexZero))) | z ∈ complexCarrier }

-- ℘′_Λ(z) = −2 Σ_{l ∈ Λ} (z − l)^{−3}.
def weierstrassDerivTerms (Λ z : Set) : Set :=
  { (l, complexInv(ℂ[(z - l) * (z - l) * (z - l)])) | l ∈ Λ }

def weierstrassDeriv (Λ z : Set) : Set :=
  ℂ[-2 * complexTsum(weierstrassDerivTerms(Λ, z), Λ)]

-- CurveTheta.lean, CMLattice.translatedWp: ξ(z) = ℘(z + t) − ℘(t).
def translatedWp (C : Set) : Set :=
  { (z, ℂ[weierstrassValue(cmLattice(C), ℂ[z + C.t]) -
      weierstrassValue(cmLattice(C), C.t)]) | z ∈ complexCarrier }

-- CurveTheta.lean, CMLattice.translatedWpDeriv: φ(z) = (℘′(z + t) − a₁ξ(z))/2.
def translatedWpDeriv (C : Set) : Set :=
  { (z, complexDiv(ℂ[weierstrassDeriv(cmLattice(C), ℂ[z + C.t]) -
      C.a1 * translatedWp(C)(z)], ℂ[2])) | z ∈ complexCarrier }

-- f′ for an entire function f.
def entireDeriv (f : Set) : Set := complexDeriv(f, complexCarrier)

-- CurveTheta.lean, CMLattice.phiThetaCube: G = σ(σ′θ − σ(θ′ + (a₁/2)θ)).
def phiThetaCube (C : Set) : Set :=
  { (z, ℂ[cmSigma(C)(z) * (entireDeriv(cmSigma(C))(z) * cmTheta(C)(z) -
      cmSigma(C)(z) * (entireDeriv(cmTheta(C))(z) +
        complexDiv(C.a1, ℂ[2]) * cmTheta(C)(z)))]) | z ∈ complexCarrier }

-- PadicSeriesDefs.lean, CMLattice.monomialDeg (a, b, c) = a + 2b + 3c.
def cmMonomialDeg (x : Set) : Set :=
  add(fst(x), add(mul(fst(snd(x)), 2), mul(snd(snd(x)), 3)))

-- PadicSeriesDefs.lean, CMLattice.monomialSection (a, b, c): θ^a σ^{2b} G^c.
def monomialSection (C x : Set) : Set :=
  { (z, ℂ[cmTheta(C)(z) ^ fst(x) * (cmSigma(C)(z) * cmSigma(C)(z)) ^ fst(snd(x)) *
      phiThetaCube(C)(z) ^ snd(snd(x))]) | z ∈ complexCarrier }

-- Section: Taylor series
-- CurveTheta.lean, taylorAtZero f: Σ_n f⁽ⁿ⁾(0)/n! Xⁿ.
def taylorAtZero (f : Set) : Set :=
  { (n, ℂ[complexOfReal(realInvValue(realNat(n !))) *
      holomorphicIteratedDeriv(f, complexCarrier, n)(complexZero)]) | n ∈ ℕ }

-- CurveTheta.lean, taylorVia ιₚ f: the Taylor series read in ℂ_p.
def taylorVia (p ι f : Set) : Set :=
  seriesMap(complexRing, placeCp(p, ι), placeHom(ι))(taylorAtZero(f))

-- CurveTheta.lean, linearSeries c = Σ_i c_i X_i over a ring R.
def linearCoeff (R I c m : Set) : Set :=
  ⋃({ a ∈ Ring.carrier(R) | (∃ i ∈ I, m = monomialVariable(I, i) ∧ a = c(i)) ∨
    (¬(∃ i ∈ I, m = monomialVariable(I, i)) ∧ a = Ring.zero(R)) })

def linearSeries (R I c : Set) : Set := { (m, linearCoeff(R, I, c, m)) | m ∈ monomials(I) }

-- PowerSeries.subst (linearSeries c) F: the coefficient at z^m is F_{|m|}
-- times that of (Σ c_i X_i)^{|m|}.
def linearSubst (R I F c : Set) : Set :=
  { (m, call2(Ring.mul(R), F(monomialDegree(I, m)),
      Ring.pow(mvPowerSeriesRing(R, I), linearSeries(R, I, c), monomialDegree(I, m))(m))) |
    m ∈ monomials(I) }

-- The series over 𝔬: series over ℂ_p with coefficients in O_C
-- (seriesToCp's range).
def integralSeries (p ι : Set) : Set :=
  { F ∈ powerSeriesCarrier(placeCp(p, ι)) | ∀ n ∈ ℕ, F(n) ∈ placeCpIntegers(p, ι) }

def integralMvSeries (p ι I : Set) : Set :=
  { F ∈ mvSeriesCarrier(placeCp(p, ι), I) |
    ∀ m ∈ monomials(I), F(m) ∈ placeCpIntegers(p, ι) }

-- IntegralParameter.lean, CMLattice.phiSeriesRing: 𝔬[[φ]], the series
-- S(φ) for S over 𝔬, φ the Taylor series of translatedWpDeriv read in ℂ_p.
def phiSeriesRing (p ι C : Set) : Set :=
  { F ∈ powerSeriesCarrier(placeCp(p, ι)) | ∃ S ∈ integralSeries(p, ι),
    F = seriesSubst(placeCp(p, ι), S, taylorVia(p, ι, translatedWpDeriv(C))) }

-- IntegralParameter.lean, expSubst a = exp(a), the exponential series
-- substituted into a (a with constant coefficient 0), in I variables.
def mvExpTerms (R I a m : Set) : Set :=
  { (k, call2(Ring.mul(R), seriesExp(R)(k),
      Ring.pow(mvPowerSeriesRing(R, I), a, k)(m))) | k ∈ succ(monomialDegree(I, m)) }

def mvExpSubst (R I a : Set) : Set :=
  { (m, finiteRingSum(succ(monomialDegree(I, m)), Ring.carrier(R), Ring.add(R),
      Ring.zero(R), Ring.neg(R), Ring.mul(R), Ring.one(R), mvExpTerms(R, I, a, m))) |
    m ∈ monomials(I) }

-- IsogenyIntegrality.lean, congruencePart m r f: the part of f in the
-- degrees n ≡ r mod m.
def congruenceCoeff (R M r f n : Set) : Set :=
  ⋃({ a ∈ Ring.carrier(R) | (CongruentMod(n, r, M) ∧ a = f(n)) ∨
    (¬CongruentMod(n, r, M) ∧ a = Ring.zero(R)) })

def congruencePart (R M r f : Set) : Set := { (n, congruenceCoeff(R, M, r, f, n)) | n ∈ ℕ }

-- Section: Schur jets (FORWARD)
-- FORWARD. ZerosCostDegree.lean, WeylIndex n κ: the families over the
-- places τ ∈ Φ of standard tableaux of shape κ_τ (columns of height h
-- counted by κ(τ, h)) with entries in the n rows; placeholder ∅. Needs the
-- Schur modules of Lib/GLn.
def weylIndexSet (Φ n κ : Set) : Set := ∅

-- FORWARD. DataProduct.lean, schurJet κ Θ i′ i: the (i′, i) entry of the
-- matrix of jets of the series Θ over the ring R, in the matrix variables
-- z_{τ,b,c} (τ ∈ Φ, b ∈ n′, c ∈ n), along the entries of the Schur matrix
-- S_κ(z) (jet of Θ along the polynomial S_κ(z)_{i′,i}); placeholder ∅.
def schurJetEntry (R Φ n n2 κ Θ i2 i : Set) : Set := ∅

-- FORWARD. JetDivisibility.lean, norm_schurJet_le, the charge
-- m = Σ_τ Σ_{h<N} Σ_j Σ_b g(τ, h, (i′_τ)_{h,j,b}) of the boxes of the row
-- tableau family i′ (N = |n′|); placeholder ∅.
def rowCharge (Φ N g i2 : Set) : Set := ∅

-- Section: Theta kernels (FORWARD)
-- FORWARD (predicate). BranchingPeriod.lean, thetaKernel hκ c ha hb K and
-- ConjugatesOfJets.lean, Kernel.raises 1 1 B: the datum Φ of the theta
-- kernel of scale c for the pair of standard spaces of ranks n, n2, the
-- lift weight (κ, e) and the characters a, b (of weights ea, eb), at
-- level K, multiplies the p-adic gauges at ι by at most max(B, 0): for
-- all g, h, ξ, weylGauge(h, ker(ω(g, h)Φ)ξ) ≤ max(B, 0) weylGauge(g, ξ).
-- Needs the theta kernels of Lib/Weil/CompactLift; placeholder body: the
-- typing.
predicate ThetaKernelRaises (W n n2 κ e a b K c p ι Φ B : Set) :=
  c ∈ complexCarrier ∧ B ∈ ℝ ∧ ι ∈ padicPlaces(p)

end Theta
