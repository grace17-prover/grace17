-- The CM theta functions and their p-adic Taylor series, read from
-- layer 4: the twisted translations U^m_y of a CM datum, its theta
-- function θ = U_tσ/U_tσ(0), ξ = ℘(z + t) − ℘(t), φ = (℘′(z + t) − a₁ξ)/2,
-- the entire function G = φθ³ and the monomial sections θ^a σ^{2b} G^c;
-- Taylor series at 0, read in ℂ_p through a p-adic place, substitution
-- into linear forms, the subring 𝔬[[φ]] and exp(κψ).
-- Source: grh-compact/src/Lib/CM/Sigma/CurveTheta.lean (taylorAtZero,
-- taylorVia, linearSeries, CMLattice.twistedTranslate, CMLattice.θ,
-- translatedWp, translatedWpDeriv, phiThetaCube),
-- Lib/CM/Sigma/PadicSeriesDefs.lean (monomialDeg, monomialSection,
-- valRingCp, seriesToCp), Lib/CM/LocalHeight/IntegralParameter.lean
-- (expSubst, CMLattice.phiSeriesRing),
-- Lib/CM/LocalHeight/IsogenyIntegrality.lean (congruencePart),
-- Lib/CM/Sigma/SigmaFunction.lean (the sigma function σ of a lattice).
-- Encoding. A series over 𝔬 = valRingCp p is a series over ℂ_p whose
-- coefficients lie in the integers of ℂ_p (seriesToCp is the inclusion).
-- The substitution F(Σ_i c_i X_i) of a series in one variable is written
-- coefficientwise: its coefficient at z^m is F_{|m|} times that of
-- (Σ c_i X_i)^{|m|}. The sigma function is FORWARD (placeholder ∅) until
-- Lib/CM/Sigma is stated; everything else in the first sections is
-- defined from it. The Schur jets (Lib/GLn, Lib/Weil/Construction/
-- DataProduct.lean: WeylIndex, schurJet and the charges of the row
-- tableaux) are FORWARD.
-- Part of the GRH blueprint (layer 5, the argument).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Proof.Forward.Theta
import GRH.Proof.Curve.PeriodDefs
import GRH.Calculus.Analytic

section Theta
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- The sigma function cmSigma, the functions attached to a CM datum (θ,
-- ξ, φ, G, the monomial sections), the Taylor series read in ℂ_p, the
-- subring 𝔬[[φ]], exp(a) and congruencePart are defined in
-- GRH.CM.CurveTheta.

-- Section: Schur jets (FORWARD)
-- FORWARD. ZerosCostDegree.lean, WeylIndex n κ: the families over the
-- places τ ∈ Φ of standard tableaux of shape κ_τ (columns of height h
-- counted by κ(τ, h)) with entries in the n rows; placeholder ∅. Needs the
-- Schur modules of Lib/GLn.
def weylIndexSet (Φ n κ : Set) : Set := ∅

-- FORWARD. DataProduct.lean, schurJet κ Θ i′ i: the (i′, i) entry of the
-- matrix of jets of the series Θ over the ring R, in the matrix variables
-- z_{τ,b,c} (τ ∈ Φ, b ∈ n′, c ∈ n), along the entries of the Schur matrix
-- S_κ(z) (jet of Θ along the polynomial S_κ(z)_{i′,i}); placeholder ∅.
def schurJetEntry (R Φ n n2 κ Θ i2 i : Set) : Set := ∅

-- FORWARD. JetDivisibility.lean, norm_schurJet_le, the charge
-- m = Σ_τ Σ_{h<N} Σ_j Σ_b g(τ, h, (i′_τ)_{h,j,b}) of the boxes of the row
-- tableau family i′ (N = |n′|); placeholder ∅.
def rowCharge (Φ N g i2 : Set) : Set := ∅

-- Section: Theta kernels (FORWARD)
-- FORWARD (predicate). BranchingPeriod.lean, thetaKernel hκ c ha hb K and
-- ConjugatesOfJets.lean, Kernel.raises 1 1 B: the datum Φ of the theta
-- kernel of scale c for the pair of standard spaces of ranks n, n2, the
-- lift weight (κ, e) and the characters a, b (of weights ea, eb), at
-- level K, multiplies the p-adic gauges at ι by at most max(B, 0): for
-- all g, h, ξ, weylGauge(h, ker(ω(g, h)Φ)ξ) ≤ max(B, 0) weylGauge(g, ξ).
-- Needs the theta kernels of Lib/Weil/CompactLift; placeholder body: the
-- typing.
predicate ThetaKernelRaises (W n n2 κ e a b K c p ι Φ B : Set) :=
  c ∈ complexCarrier ∧ B ∈ ℝ ∧ ι ∈ padicPlaces(p)

end Theta
