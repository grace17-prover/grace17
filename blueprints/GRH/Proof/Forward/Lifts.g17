-- FORWARD declarations for the endgame: the record of the objects of the
-- source's New/Seesaw, New/Rows, New/Columns and New/Trace that theorems
-- A, B and C mention (rows, columns, ramified columns, the finite group 𝖦,
-- the projected Poincaré series, the untwisted lift Θ₁, the squared norms
-- and covolumes at the automorphisms of ℂ, the index bound IndexLe).
-- Source: grh-compact/src/New/Seesaw/IndexTypes.lean (Data.G, Data.e₀,
-- Data.Θ via Data.liftChar), New/Rows/* (Data.rows, Data.rowDim,
-- covolumeSq), New/Columns/* (Data.Column, Data.ramifiedColumns,
-- integralFormsAt), New/Trace/GoodIdempotent.lean (goodProjTranslate),
-- New/Endgame/ShortAndEnough.lean (Data.projectedPoincare,
-- Data.integralRamified, Data.IndexLe). Lib/Weil (normSqAt, the lifts).
-- Encoding. The source defines these objects from the data D by choice
-- (Data.N, Data.π, Data.ω, Data.χ, Data.seesaw, ...). Here they are a
-- record L bound to D by the predicate LiftSystemOf(P, D, L). Its body is
-- FORWARD: it records the typing (ℂ-vector spaces, linear maps, a finite
-- group, real-valued norms) and not yet the defining properties, which
-- layers 4 and 5 (Seesaw.IndexTypes, Trace.GoodIdempotent, Rows, Columns)
-- supply by strengthening LiftSystemOf under the same name. Until then
-- theorems A, B and C, which quantify over every such L, say more than the
-- source does; they are admitted.
-- Part of the GRH blueprint (layer 5, the argument).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Proof.Forward.Lifts
import GRH.Proof.Data.AdmissibleData
import GRH.Linear.Dimension

-- The objects of the endgame for one admissible D:
-- rows: Data.rows, a ℂ-vector space (a Module value over complexRing);
-- columns: Data.Column; ramified: Data.ramifiedColumns, as a module;
-- integral: Data.integralRamified, the ramified columns integral at
-- every finite place; group: the finite group 𝖦 (Data.G);
-- poincare: s ↦ Data.projectedPoincare s, linear ramified → rows;
-- lifted: the space of lifted forms, lift: Data.Θ 1, rows → lifted;
-- normSq: (F, σ) ↦ ‖F‖²_σ (normSqAt); covolumeSq: (n, y, σ) ↦ the squared
-- covolume of the lifts of the family y : n → rows at σ (covolumeSq
-- (D.Θ 1 ∘ y) σ); automorphisms: the field automorphisms σ of ℂ;
-- indexLe: the triples (n, y, δ) with Data.IndexLe y δ.
structure LiftSystem
  | rows columns ramified integral group : Set
  | poincare lifted lift normSq covolumeSq : Set
  | automorphisms indexLe : Set

-- FORWARD (predicate): L is the system of lifts of the admissible data D.
-- The body records the shape the statements use; layers 4 and 5 add the
-- defining properties (see the module comment).
predicate LiftSystemOf (P D L : Set) :=
  Data(P, D) ∧ LiftSystem.Data(L) ∧
  Module(L.rows, complexRing) ∧ Module(L.columns, complexRing) ∧
  Module(L.ramified, complexRing) ∧
  L.integral ⊆ Module.carrier(L.ramified) ∧ Finite(L.group) ∧
  (∀ s ∈ L.group,
    LinearMap(L.poincare(s), L.ramified, complexRing, L.rows)) ∧
  (L.lift : Module.carrier(L.rows) → L.lifted) ∧
  (L.normSq : L.lifted × L.automorphisms → ℝ) ∧
  L.indexLe ⊆ (ℕ × 𝒫(ℕ × Module.carrier(L.rows))) × ℝ

-- The dimension D = finrank_ℂ(rows) (the source's Data.rowDim).
def rowDim (L : Set) : Set := finrank(L.rows, complexRing)

-- finrank_ℂ D.Column.
def columnDim (L : Set) : Set := finrank(L.columns, complexRing)

-- c · P_s(φ) in the rows, for a complex c.
def scaledPoincare (L c s φ : Set) : Set :=
  call2(Module.smul(L.rows), c, L.poincare(s)(φ))

-- Set.image2 (B ·) t (integralRamified) for B_s = c · P_s.
def scaledTranslates (L c t : Set) : Set :=
  { v ∈ Module.carrier(L.rows) |
    ∃ s ∈ t, ∃ φ ∈ L.integral, v = scaledPoincare(L, c, s, φ) }

-- The range of P_s, for s ∈ t, as a set of rows.
def poincareRanges (L t : Set) : Set :=
  { v ∈ Module.carrier(L.rows) |
    ∃ s ∈ t, v ∈ linearRange(L.poincare(s), L.ramified, L.rows) }

-- ⨆_{s ∈ t} range(P_s), as a module.
def poincareRangeSpan (L t : Set) : Set :=
  submoduleModule(L.rows, complexRing,
    moduleSpan(L.rows, complexRing, poincareRanges(L, t)))
