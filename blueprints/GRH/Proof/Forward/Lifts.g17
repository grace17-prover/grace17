-- The objects theorems A, B and C are stated with, defined from the
-- source's choices and the forward declarations of
-- GRH.Proof.Forward.Automorphic: the system of lifts of admissible data
-- (LiftSystemOf), the dimensions of the rows and of the columns, the
-- projected Poincaré series P_s = |𝖦| e₀ s 𝒫 i_N, the integral ramified
-- columns, the index bound IndexLe and the squared covolume.
-- Source: grh-compact/src/New/Endgame/ShortAndEnough.lean
-- (Data.scaledInclusion, Data.projectedPoincare, Data.integralRamified,
-- Data.IndexLe), New/Trace/GoodIdempotent.lean (Data.rowDim),
-- Lib/Adelic/CuspForms/LevelForms.lean (pairingMatrix, covolumeSq).
-- Encoding. In the source these objects are definitions on every
-- D : Data P, made from choices (Data.N, Data.seesaw.choose, ...). Here
-- the choices are a record L, and LiftSystemOf(P, D, L) says that D is
-- admissible and that each field of L has exactly the property the source
-- chooses it by; the objects are then functions of (P, D, L), and the
-- theorems quantify over every such L. What is FORWARD is listed in
-- GRH.Proof.Forward.Automorphic and GRH.Proof.Forward.Jets.
-- Part of the GRH blueprint (layer 5, the argument).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Proof.Forward.Lifts
import GRH.Proof.Forward.Automorphic
import GRH.Matrix.Determinant

-- L is a system of lifts of the admissible data D: the record of the
-- source's choices, each with the property it is chosen by.
predicate LiftSystemOf (P D L : Set) :=
  Data(P, D) ∧ LiftChoices.Data(L) ∧ LevelPrime(P, D, L.N) ∧
  AutomorphicChoices(P, D, L.N, L.choices) ∧
  SeesawConstant(P, D, L, L.seesawConst)

-- GoodIdempotent.lean, Data.rowDim: D = finrank_ℂ(rows).
def rowDim (P D L : Set) : Set := finrank(dataRows(P, D, L), complexRing)

-- finrank_ℂ D.Column.
def columnDim (P D L : Set) : Set := finrank(dataColumn(P, D, L), complexRing)

-- The ramified columns as a module (a submodule of the columns).
def ramifiedModule (P D L : Set) : Set :=
  submoduleModule(dataColumn(P, D, L), complexRing, ramifiedColumns(P, D, L))

-- ShortAndEnough.lean, Data.scaledInclusion φ = c φ, c the seesaw
-- constant, and Data.projectedPoincare s = goodProjTranslate s ∘ poincare
-- ∘ scaledInclusion, as a function on the ramified columns.
def projectedPoincare (P D L s : Set) : Set :=
  { (φ, goodProjTranslate(P, D, L, s)(dataPoincare(P, D, L)(
      call2(Module.smul(dataColumn(P, D, L)), L.seesawConst, φ)))) |
    φ ∈ ramifiedColumns(P, D, L) }

-- ShortAndEnough.lean, Data.integralRamified: the ramified columns
-- integral (integralFormsAt with d = 1) at every p-adic place ι above every
-- prime l.
def integralRamified (P D L : Set) : Set :=
  { φ ∈ ramifiedColumns(P, D, L) | ∀ l ∈ ℕ, Prime(l) →
    ∀ ι ∈ padicPlaces(l), φ ∈ integralColumns(P, D, L, l, ι) }

-- c · P_s(φ) in the rows, for a complex c.
def scaledPoincare (P D L c s φ : Set) : Set :=
  call2(Module.smul(dataRows(P, D, L)), c, projectedPoincare(P, D, L, s)(φ))

-- Set.image2 (B ·) t integralRamified for B_s = c · P_s.
def scaledTranslates (P D L c t : Set) : Set :=
  { v ∈ Module.carrier(dataRows(P, D, L)) |
    ∃ s ∈ t, ∃ φ ∈ integralRamified(P, D, L),
      v = scaledPoincare(P, D, L, c, s, φ) }

-- The range of P_s, for s ∈ t, as a set of rows.
def poincareRanges (P D L t : Set) : Set :=
  { v ∈ Module.carrier(dataRows(P, D, L)) |
    ∃ s ∈ t, v ∈ linearRange(projectedPoincare(P, D, L, s),
      ramifiedModule(P, D, L), dataRows(P, D, L)) }

-- ⨆_{s ∈ t} range(P_s), as a module.
def poincareRangeSpan (P D L t : Set) : Set :=
  submoduleModule(dataRows(P, D, L), complexRing,
    moduleSpan(dataRows(P, D, L), complexRing, poincareRanges(P, D, L, t)))

-- Section: The index
-- The terms e(l) for l ∈ U.
def indexTerms (e U : Set) : Set := { (l, e(l)) | l ∈ U }

-- The row k ↦ u_ik of the matrix u.
def matrixRowOf (n u i : Set) : Set := { (k, u((i, k))) | k ∈ n }

-- The row i of u applied to y: Σ_k u_ik y_k in the rows.
def matrixRowCombination (P D L n u y i : Set) : Set :=
  moduleCombination(dataRows(P, D, L), complexRing, n, matrixRowOf(n, u, i),
    y)

-- ShortAndEnough.lean, Data.IndexLe y δ for y : n → rows: some
-- e : ℕ → ℝ has Σ_{l ∈ U} e(l) ≤ δ for every finite U, and for every prime
-- l, p-adic place ι above l and m-fold twist ϑ with l prime to its level
-- norm, some n × n matrix u over O_ι has |ι(det u)| ≥ exp(−e(l)) and
-- turns y into rows Σ_k u_ik y_k whose lifts Θ_ϑ are ι-integral.
predicate IndexLe (P D L n y Δ : Set) :=
  ∃ e, (e : ℕ → ℝ) ∧
    (∀ U, U ⊆ ℕ → Finite(U) →
      RealLe(realFiniteSum(indexTerms(e, U), U), Δ)) ∧
    (∀ l ∈ ℕ, Prime(l) → ∀ ι ∈ padicPlaces(l),
      ∀ ϑ ∈ mfoldTwists(P, D, L), gcd(l, twistLevelNorm(P, D, L, ϑ)) = 1 →
        ∃ u, (u : n × n → embValRing(l, ι)) ∧
          RealLe(realExp(realNeg(e(l))),
            padicPlaceNorm(l, ι, matDet(complexRing, n, u))) ∧
          (∀ i ∈ n, liftTheta(P, D, L, ϑ)(matrixRowCombination(P, D, L, n,
            u, y, i)) ∈ integralForms(P, D, L, ϑ, l, ι)))

-- Section: The covolume
-- The matrix of pairings ⟨Θ₁ y_i, Θ₁ y_k⟩_σ (LevelForms.lean,
-- pairingMatrix (Θ₁ ∘ y) (fun _ ↦ σ)).
def liftPairingMatrix (P D L n y σ : Set) : Set :=
  { (q, formPairing(P, D, L, oneTwist(P, D, L), σ,
      liftTheta(P, D, L, oneTwist(P, D, L))(y(fst(q))),
      liftTheta(P, D, L, oneTwist(P, D, L))(y(snd(q))))) | q ∈ n × n }

-- LevelForms.lean, covolumeSq (D.Θ 1 ∘ y) σ: |det| of that matrix.
def covolumeSq (P D L n y σ : Set) : Set :=
  complexAbs(matDet(complexRing, n, liftPairingMatrix(P, D, L, n, y, σ)))
