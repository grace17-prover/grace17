module GRH.Proof.Forward.Jets
import GRH.Proof.Forward
import Grace.Cumulus.Algebra.Ring.Homomorphism

-- Section: The automorphisms of ℂ
-- The field automorphisms σ : ℂ ≃+* ℂ (the source's ℂ ≃+* ℂ, over which
-- normSqAt and covolumeSq are taken).
def complexAutomorphisms : Set :=
  { σ ∈ 𝒫(complexCarrier × complexCarrier) |
    RingIso(σ, complexRing, complexRing) }

-- i√d for d = Parameters.d, the generator (up to the factor 2 and a shift by 1) of
-- K = ℚ(√−d) inside ℂ.
def sqrtNegD (d : Nat) : Set :=
  complexMul(complexImaginaryUnit, complexOfReal(realSqrt(realNat(d))))

-- Gal(ℂ/K): the automorphisms of ℂ fixing K = ℚ(√−d), that is, fixing
-- i√d (they fix ℚ already).
def galoisOverK (d : Nat) : Set :=
  { σ ∈ complexAutomorphisms | σ(sqrtNegD(d)) = sqrtNegD(d) }

-- Section: The p-adic places of ℂ
-- FORWARD. AdicRingHomExt.lean, PadicPlace p: the ring homomorphisms
-- ιₚ : ℂ → ℂ_p (layer 3's cpField at an algebraic closure of ℚ_p).
def padicPlaces (p : Set) : Set := ∅

-- FORWARD. ‖ιₚ(z)‖, the norm of ℂ_p at the image of z (layer 3's cpNorm).
def padicPlaceNorm (p ι z : Set) : Set := ∅

-- ClassReps.lean, embValRing: the valuation ring O_ι ⊂ ℂ of the complex
-- numbers z with ‖ι(z)‖ ≤ 1.
def embValRing (p ι : Set) : Set :=
  { z ∈ complexCarrier | RealLe(padicPlaceNorm(p, ι, z), realOne) }

-- Section: Standard spaces and their Weil representation
-- FORWARD. Lib/Weil, Space (P.E s) n ε with [V.IsStd]: the standard
-- hermitian spaces with adelic frames over E = K(ζ_{N₁}), N₁ = N₁(P, s),
-- over all finite index sets n and signs ε.
def stdSpaces (P s : Set) : Set := ∅

-- FORWARD. The rank card n of the space V.
def spaceRank (V : Set) : Set := ∅

-- FORWARD. The points x at which the source evaluates (finVec x: the
-- finite-adelic vectors of V).
def spacePoints (V : Set) : Set := ∅

-- FORWARD. V.vacElem (finVec x): the value of the vacuum at x.
def vacValue (V x : Set) : Set := ∅

-- FORWARD. The ℂ-module of forms on which V's finite Weil representation
-- acts, and its submodule 𝒲_f = V.finitePart (as a set).
def weilForms (V : Set) : Set := ∅
def finitePart (V : Set) : Set := ∅

-- FORWARD. V.θ F, the theta functional, and V.ϱ (finVec x) F, the finite
-- Weil representation at x.
def thetaValue (V F : Set) : Set := ∅
def weilAction (V x F : Set) : Set := ∅

-- The orbit {ϱ(finVec x) F | x}.
def weilOrbit (V F : Set) : Set :=
  { G ∈ Module.carrier(weilForms(V)) |
    ∃ x ∈ spacePoints(V), G = weilAction(V, x, F) }

-- FORWARD. b • x for a finite idele b of E acting on the point x
-- (finVec (B σ • x) in the source).
def ideleAct (V b x : Set) : Set := ∅

-- FORWARD. 𝔸f(E)ˣ-valued choices: the finite ideles of E (P.E s).
def finiteIdeles (P s : Set) : Set := ∅

-- FORWARD (predicate). JetDivisibility.lean, IsJetConjugate σ
-- (placePerm s σ) (P.jetScale s) t F F′: the jet series of F at scale
-- per, conjugated by σ, is t times the jet series of F′ with the places
-- permuted by σ. Placeholder body: the typing alone.
predicate IsJetConjugate (P s σ t F G : Set) :=
  σ ∈ complexAutomorphisms ∧ t ∈ complexCarrier
