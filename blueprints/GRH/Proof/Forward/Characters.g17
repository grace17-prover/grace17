-- FORWARD declarations (with real bodies) for the characters of U(1)(𝔸)
-- of a CM field E that layer 5 names: the norm-one adeles, the continuous
-- unitary characters μ of U(1)(𝔸) trivial on U(1)(E) (the source's
-- AutChar E), the residue characters ψ_w : 𝔽_w → ℂ, and the relation
-- "μ has weight e and tame part ψ" (AutChar.HasWeight); integer powers in
-- ℂ, and the order of a residue character.
-- Source: grh-compact/src/Lib/ClassField/HeckeCharacter/CharacterDefs.lean
-- (charsTrivialOnRat, AutChar, AutChar.HasWeight); Mathlib's orderOf on
-- MulChar (ResField w) ℂ. Part of: "Algebraic Hecke characters (type A₀);
-- extension of the quadratic character of a CM field (known result; see
-- Lib.ClassField.HeckeCharacter.SplittingCharExists)."
-- Encoding. The bodies are final; layer 4 (GRH.ClassField.HeckeCharacter)
-- moves them to their home under the same names. A character is a function
-- on the norm-one adeles u ∈ 𝔸 = ℂ^Φ × 𝔸_f (uū = 1), with the subspace
-- topology of 𝔸; the infinite component of u at τ ∈ Φ is fst(u)(τ). A tame
-- part is a function on the finite places w of E whose value at w is a
-- multiplicative character of the residue field 𝔽_w (GRH.Characters.Mul).
-- The source's finite product ∏ᶠ_w ψ_w(u mod w) is a product over the
-- finite set of w with ψ_w ≠ 1, the other factors being 1 at the unit
-- u_w.
-- Part of the GRH blueprint (layer 5, the argument).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Proof.Forward.Characters
import GRH.GLn.WeightRep
import GRH.Characters.Mul

section Characters
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)

-- Section: U(1)(𝔸)
-- The adeles u with u ū = 1 (the source's unitary (𝔸 E)), and their
-- topology as a subspace of 𝔸.
def unitaryAdeles (E Φ : Set) : Set :=
  { u ∈ cmAdeles(E, Φ) |
    call2(Ring.mul(cmAdeleRing(E, Φ)), u, cmAdeleStar(E, Φ)(u)) =
      Ring.one(cmAdeleRing(E, Φ)) }

def unitaryAdeleSpace (E Φ : Set) : Set :=
  subspace(cmAdeleSpace(E, Φ), unitaryAdeles(E, Φ))

-- Section: Characters of U(1)(𝔸)
-- FORWARD (real body). CharacterDefs.lean, AutChar E =
-- charsTrivialOnRat E (unitary _) Subtype.val: the continuous
-- homomorphisms μ : U(1)(𝔸) → ℂ of absolute value 1, trivial at the
-- adeles of the elements of E.
predicate AutCharOf (E Φ μ : Set) :=
  FunctionBetween(μ, unitaryAdeles(E, Φ), complexCarrier) ∧
  (∀ u ∈ unitaryAdeles(E, Φ), ∀ v ∈ unitaryAdeles(E, Φ),
    μ(call2(Ring.mul(cmAdeleRing(E, Φ)), u, v)) = ℂ[μ(u) * μ(v)]) ∧
  (∀ u ∈ unitaryAdeles(E, Φ), complexAbs(μ(u)) = realOne) ∧
  Continuous(μ, unitaryAdeleSpace(E, Φ), complexSpace) ∧
  (∀ a ∈ Ring.carrier(E), toCMAdele(E, Φ, a) ∈ unitaryAdeles(E, Φ) →
    μ(toCMAdele(E, Φ, a)) = complexOne)

def autChars (E Φ : Set) : Set :=
  { μ ∈ functionSpace(unitaryAdeles(E, Φ), complexCarrier) | AutCharOf(E, Φ, μ) }

-- The trivial character 1 and the product μν.
def trivialAutChar (E Φ : Set) : Set :=
  { (u, complexOne) | u ∈ unitaryAdeles(E, Φ) }

def autCharMul (E Φ μ ν : Set) : Set :=
  { (u, ℂ[μ(u) * ν(u)]) | u ∈ unitaryAdeles(E, Φ) }

-- μⁿ for a natural n.
def autCharPow (E Φ μ : Set, n : Nat) : Set :=
  { (u, ℂ[μ(u) ^ n]) | u ∈ unitaryAdeles(E, Φ) }

-- Section: Residue characters
-- The multiplicative characters 𝔽_w → ℂ, and the trivial one.
def residueChars (E w : Set) : Set := mulChars(resField(E, w), complexRing)

def trivialResidueChar (E w : Set) : Set := trivialMulChar(resField(E, w), complexRing)

-- The families ψ = (ψ_w)_w of residue characters.
def residueCharSets (E : Set) : Set := { residueChars(E, w) | w ∈ finPlaces(E) }

def residueFamilies (E : Set) : Set :=
  { ψ ∈ functionSpace(finPlaces(E), ⋃(residueCharSets(E))) |
    ∀ w ∈ finPlaces(E), ψ(w) ∈ residueChars(E, w) }

-- The trivial family, the pointwise product and the power of families.
def trivialResidueFamily (E : Set) : Set :=
  { (w, trivialResidueChar(E, w)) | w ∈ finPlaces(E) }

def residueFamilyMul (E ψ φ : Set) : Set :=
  { (w, mulCharProduct(resField(E, w), complexRing, ψ(w), φ(w))) | w ∈ finPlaces(E) }

def residueFamilyPow (E ψ : Set, n : Nat) : Set :=
  { (w, mulCharPow(resField(E, w), complexRing, ψ(w), n)) | w ∈ finPlaces(E) }

-- Mathlib's orderOf for a residue character: the least o ≥ 1 with
-- ψ^o = 1 (0 when there is none).
def residueOrderCandidates (E w ψ : Set) : Set :=
  { o ∈ ℕ | (0:N) < o ∧ mulCharPow(resField(E, w), complexRing, ψ, o) =
    trivialResidueChar(E, w) }

def residueCharOrder (E w ψ : Set) : Set := leastNatural(residueOrderCandidates(E, w, ψ))

-- The places at which the family ψ is not trivial.
def ramifiedPlaces (E ψ : Set) : Set :=
  { w ∈ finPlaces(E) | ψ(w) ≠ trivialResidueChar(E, w) }

-- Section: Weight and tame part
-- z^e for z ∈ ℂ and an integer e: z^n for e = n ≥ 0 and (z⁻¹)^n for
-- e = −n.
def complexIntPow (z e : Set) : Set :=
  ⋃({ c ∈ complexCarrier |
    (∃ n ∈ ℕ, e = integerOfNat(n) ∧ c = ℂ[z ^ n]) ∨
    (∃ n ∈ ℕ, e = integerNegValue(integerOfNat(n)) ∧ c = ℂ[complexInv(z) ^ n]) })

-- The product of the complex numbers w(i) over a finite set S.
def charProduct (S w : Set) : Set :=
  finiteRingProduct(S, complexCarrier, complexAdd, complexZero, complexNeg,
    complexMul, complexOne, w)

def weightFactors (Φ e u : Set) : Set :=
  { (τ, complexIntPow(fst(u)(τ), e(τ))) | τ ∈ Φ }

def tameFactors (E ψ u : Set) : Set :=
  { (w, ψ(w)(reduceAt(E, w, snd(u)))) | w ∈ ramifiedPlaces(E, ψ) }

-- FORWARD (real body). CharacterDefs.lean, AutChar.HasWeight μ e ψ: μ is
-- a character of U(1)(𝔸), e : Φ → ℤ, ψ a family of residue characters
-- almost all trivial, and μ(u) = ∏_τ u_τ^{e(τ)} ∏_w ψ_w(u mod w) for every u
-- with integral finite part.
predicate HasWeight (E Φ μ e ψ : Set) :=
  μ ∈ autChars(E, Φ) ∧ FunctionBetween(e, Φ, ℤ) ∧ ψ ∈ residueFamilies(E) ∧
  Finite(ramifiedPlaces(E, ψ)) ∧
  ∀ u ∈ unitaryAdeles(E, Φ), snd(u) ∈ finInt(E) →
    μ(u) = ℂ[charProduct(Φ, weightFactors(Φ, e, u)) *
      charProduct(ramifiedPlaces(E, ψ), tameFactors(E, ψ, u))]

-- Section: Weights of algebraic forms
-- The weight datum schurWeightDatum of a weight (κ, e) of algebraic forms
-- (Lib/GLn/SchurModule/WeightRepBasic.lean) is defined in GRH.GLn.WeightRep.

end Characters
