-- FORWARD declarations for the endgame: the record of the choices the
-- source makes from admissible data D (the level prime N, the seesaw
-- constant c, and the rest), and the automorphic objects theorems A, B
-- and C mention, as functions of P, D and that record: the finite group 𝖦,
-- the rows, the columns and the ramified columns, the Poincaré series, the
-- translates by the good idempotent, the m-fold twists and the lifts Θ_ϑ,
-- the squared norms ‖·‖²_σ, the pairings of the covolume, and the
-- integral forms at the p-adic places.
-- Source: grh-compact/src/New/Seesaw/IndexTypes.lean (Data.G, Data.e₀,
-- Data.N, Data.π, Data.ω, Data.muFlat, Data.χ), Trace/GoodIdempotent.lean
-- (Data.spaceY, Data.principalForms, Data.rows), Columns/ColumnDefs.lean
-- (Data.Column), Columns/ChainValuation.lean (Data.ramifiedColumns),
-- Filling/FillingTheorem.lean (Data.poincare), Seesaw/BesselGeneric.lean
-- (Data.goodProjTranslate), Seesaw/SeesawTheorem.lean (Data.seesaw),
-- Exchange/LValueRatio.lean (Data.MFoldTwist), Rows/RowVolume.lean
-- (Data.Θ), Lib/Adelic/CuspForms/LevelForms.lean (normSqAt,
-- pairingMatrix, integralForms), Lib/Adelic/CuspForms/ClassReps.lean
-- (integralFormsAt).
-- Encoding. The source defines these objects from D by choice. Here the
-- choices are the fields of a record L (`LiftChoices`), bound to D by
-- predicates that state exactly the property each choice is made with
-- (LevelPrime for N, real; SeesawConstant and AutomorphicChoices, whose
-- bodies are FORWARD); every object is then a function of (P, D, L).
-- Each FORWARD declaration has a placeholder body (∅, or the typing alone
-- for a predicate) that layer 4 replaces under the same name with the
-- source's meaning.
-- Part of the GRH blueprint (layer 5, the argument).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Proof.Forward.Automorphic
import GRH.Proof.Seesaw.IndexTypes
import GRH.Linear.Dimension

-- Section: The choices
-- The choices the source makes from D: N = Data.N (the level prime),
-- seesawConst = the unit c of Data.seesaw (in Data.scaledInclusion), and
-- choices = the record of the remaining choices: Data.π (π π̄ = N), the
-- residue characters of order M_ω² at the chosen places (Data.ω),
-- Data.muFlat, Data.χ (characters of U(1)(𝔸) of given weight and tame
-- part), and the hermitian spaces Y_j with their frames (Data.spaceY).
structure LiftChoices
  | N seesawConst choices : Set

-- FORWARD (predicate). The properties of the source's remaining choices
-- (IndexTypes.lean: exists_pi_mul_star, exists_residue_char_of_order,
-- exists_char_hasWeight at (1, 0) and (0, 1); GoodIdempotent.lean:
-- exists_spaceY), for the level prime N. Placeholder body: the typing.
predicate AutomorphicChoices (P D N X : Set) := N ∈ ℕ ∧ X = X

-- Section: The group, the rows and the columns
-- FORWARD. IndexTypes.lean, Data.G: the finite group 𝖦 = ∏ GL_r(𝔽_w)
-- over the chosen places w above g₀ and g₁, as the set of its elements.
def dataGroup (P D : Set) : Set := ∅

-- FORWARD. GoodIdempotent.lean, Data.principalForms (Data.spaceY 0): the
-- forms on Y₀ of parameter ς fixed by the principal level at the chosen
-- places, a ℂ-module (a Module value over complexRing).
def principalForms (P D L : Set) : Set := ∅

-- FORWARD. GoodIdempotent.lean, Data.rows: the good forms on Y₀, the
-- image of the good idempotent e₀ acting on principalForms; a ℂ-module.
def dataRows (P D L : Set) : Set := ∅

-- FORWARD. ColumnDefs.lean, Data.Column: the columns, a ℂ-module.
def dataColumn (P D L : Set) : Set := ∅

-- FORWARD. ChainValuation.lean, Data.ramifiedColumns: the range of the
-- ramifying operator, a submodule of the columns (as a set).
def ramifiedColumns (P D L : Set) : Set := ∅

-- FORWARD. FillingTheorem.lean, Data.poincare: the Poincaré series, a
-- linear map from the columns to principalForms (as a function).
def dataPoincare (P D L : Set) : Set := ∅

-- FORWARD. BesselGeneric.lean, Data.goodProjTranslate s: for s ∈ 𝖦, the
-- linear map y ↦ |𝖦| e₀(s y) from principalForms to the rows.
def goodProjTranslate (P D L s : Set) : Set := ∅

-- Section: Twists and lifts
-- FORWARD. LValueRatio.lean, Data.MFoldTwist: the m-fold twists ϑ, as a
-- set; oneTwist is the twist 1 (Data.instOneTws).
def mfoldTwists (P D L : Set) : Set := ∅
def oneTwist (P D L : Set) : Set := ∅

-- FORWARD. IndexTypes.lean, TameChar.levelNorm: ∏_{w ∈ Q} q_w, for the
-- set Q of places of the twist ϑ.
def twistLevelNorm (P D L ϑ : Set) : Set := ∅

-- FORWARD. The ℂ-module of level forms that receives the lift of the
-- rows for the twist ϑ (the codomain of Data.iotaAtLevel ϑ).
def liftedForms (P D L ϑ : Set) : Set := ∅

-- FORWARD. RowVolume.lean, Data.Θ ϑ = Data.iotaAtLevel ϑ ∘ rows.subtype:
-- the lift, a linear map from the rows to liftedForms(P, D, L, ϑ).
def liftTheta (P D L ϑ : Set) : Set := ∅

-- FORWARD. LevelForms.lean, LevelForm.normSqAt σ F: for σ ∈ Aut ℂ, the
-- class sum of the squared Gram norms of the vectors σ(F(g)) (a real).
def normSqAt (P D L ϑ F σ : Set) : Set := ∅

-- FORWARD. LevelForms.lean, the entry of pairingMatrix y (fun _ ↦ σ) at
-- two forms F, G: the class sum over g of the Gram pairing of σ(F(g))
-- with σ(G(g)), a complex number.
def formPairing (P D L ϑ σ F G : Set) : Set := ∅

-- FORWARD. LevelForms.lean, integralForms ι: the lifted forms for ϑ
-- integral at the p-adic place ι : ℂ → ℂ_p (as a set).
def integralForms (P D L ϑ p ι : Set) : Set := ∅

-- FORWARD. ClassReps.lean, integralFormsAt D.Column 1 at ι: the columns
-- integral at the p-adic place ι (as a set).
def integralColumns (P D L p ι : Set) : Set := ∅

-- FORWARD (predicate). SeesawTheorem.lean, Data.seesaw: c is a nonzero
-- complex number such that for every twist ϑ some good datum Ψ has
-- ι_ϑ(𝒫(cφ)) = B^Ψ φ for every ramified column φ. Placeholder body: the
-- typing.
predicate SeesawConstant (P D L c : Set) :=
  c ∈ complexCarrier ∧ c ≠ complexZero
