-- The automorphic objects theorems A, B and C mention, as functions of
-- the parameters P, the data D and the record L of the source's choices:
-- the property of the choices (AutomorphicChoices), the finite group 𝖦,
-- the rows, the columns and the ramified columns, the Poincaré series, the
-- translates by the good idempotent, the m-fold twists and the lifts Θ_ϑ,
-- the squared norms ‖·‖²_σ, the pairings of the covolume, and the
-- integral forms at the p-adic places. Those still FORWARD are marked.
-- Source: grh-compact/src/New/Seesaw/IndexTypes.lean (Data.G, Data.N,
-- Data.π, Data.ω, Data.muFlat, Data.χ), Trace/GoodIdempotent.lean
-- (Data.spaceY, Data.principalForms, Data.rows), Columns/ColumnDefs.lean
-- (Data.Column), Columns/ChainValuation.lean (Data.ramifiedColumns),
-- Filling/FillingTheorem.lean (Data.poincare), Seesaw/BesselGeneric.lean
-- (Data.goodProjTranslate), Seesaw/SeesawTheorem.lean (Data.seesaw),
-- Exchange/LValueRatio.lean (Data.MFoldTwist), Rows/RowVolume.lean
-- (Data.Θ), Seesaw/GradingsOfY.lean (Data.iotaAtLevel); normSqAt,
-- formPairing, integralForms and integralColumns are the
-- Lib/Adelic/CuspForms objects of GRH.Adelic.CuspForms (LevelForms.lean,
-- normSqAt, pairingMatrix, integralForms; ClassReps.lean,
-- integralFormsAt) at the level settings liftLevelSetting
-- (GRH.Proof.Seesaw.GradingsOfY) and columnSetting
-- (GRH.Proof.Columns.ColumnDefs).
-- Encoding. The source defines these objects from D by choice. Here the
-- choices are the fields of a record L (`LiftChoices`, with `AutoChoices`,
-- GRH.Proof.Seesaw.IndexTypes), bound to D by predicates that state
-- exactly the property each choice is made with (LevelPrime for N,
-- AutomorphicChoices, SeesawConstant); every object is then a function of
-- (P, D, L). Each FORWARD declaration has a placeholder body (∅, or the
-- typing alone for a predicate) that a later module replaces under the
-- same name with the source's meaning: those that need the theta lifts
-- of Lib/Weil (the spaces Y_j and their forms, the rows, the lift Θ, the
-- Poincaré series, the seesaw), the Schur modules of Lib/GLn (the
-- ramifying operator) or the group algebra of 𝖦 (e₀).
-- Part of the GRH blueprint (layer 5, the argument).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Proof.Forward.Automorphic
import GRH.Proof.Columns.ColumnDefs
import GRH.Linear.Dimension
import GRH.Adelic.CuspForms

-- Section: The choices
-- The records LiftChoices (N, seesawConst, choices) and AutoChoices (π,
-- ω, μ♭, χ, the spaces Y_j) are declared in GRH.Proof.Seesaw.IndexTypes.

-- FORWARD (predicate). GoodIdempotent.lean, Data.exists_spaceY: the
-- hermitian spaces Y_j over E (signs Data.signsY j) with their frames,
-- standard for j ≥ m and of Gram matrix gradedGram and frame
-- gradedLatticeBasis·k for j < m (k integral, ≡ 1 at the chosen places).
-- Needs the graded spaces of Lib/Weil; placeholder body: the typing.
predicate SpacesYOf (P D N Y : Set) := N ∈ ℕ ∧ Y = Y

-- The properties of the source's remaining choices for the level prime
-- N: IndexTypes.lean, exists_pi_mul_star (π π̄ = N),
-- exists_residue_char_of_order (ω), exists_char_hasWeight at (1, 0) and
-- (0, 1) (μ♭, χ); GoodIdempotent.lean, exists_spaceY.
predicate AutomorphicChoices (P D N X : Set) :=
  AutoChoices.Data(X) ∧ LevelPi(P, D, N, X.pi) ∧ ResidueOmega(P, D, X.omega) ∧
  MuFlatChar(P, D, X.muFlat) ∧ ChiChar(P, D, X.omega, X.chi) ∧
  SpacesYOf(P, D, N, X.spaceY)

-- Section: The group, the rows and the columns
-- IndexTypes.lean, Data.G: the finite group 𝖦 = ∏ GL_r(𝔽_w) over the
-- chosen places w above g₀ and g₁, as the set of its elements
-- (GRH.Proof.Seesaw.IndexTypes, dataGroupStructure).
def dataGroup (P D : Set) : Set :=
  familyCarrier(chosenIndex(P, D), rowGLFamily(P, D))

-- FORWARD. GoodIdempotent.lean, Data.principalForms (Data.spaceY 0): the
-- forms on Y₀ of parameter ς fixed by the principal level at the chosen
-- places, a ℂ-module (a Module value over complexRing).
def principalForms (P D L : Set) : Set := ∅

-- FORWARD. GoodIdempotent.lean, Data.rows: the good forms on Y₀, the
-- image of the good idempotent e₀ acting on principalForms; a ℂ-module.
def dataRows (P D L : Set) : Set := ∅

-- ColumnDefs.lean, Data.Column: the columns, a ℂ-module
-- (GRH.Proof.Columns.ColumnDefs, columnModule).
def dataColumn (P D L : Set) : Set := columnModule(P, D, L)

-- FORWARD. ChainValuation.lean, Data.ramifiedColumns: the range of the
-- ramifying operator, a submodule of the columns (as a set).
def ramifiedColumns (P D L : Set) : Set := ∅

-- FORWARD. FillingTheorem.lean, Data.poincare: the Poincaré series, a
-- linear map from the columns to principalForms (as a function).
def dataPoincare (P D L : Set) : Set := ∅

-- FORWARD. BesselGeneric.lean, Data.goodProjTranslate s: for s ∈ 𝖦, the
-- linear map y ↦ |𝖦| e₀(s y) from principalForms to the rows.
def goodProjTranslate (P D L s : Set) : Set := ∅

-- Section: Twists and lifts
-- LValueRatio.lean, Data.MFoldTwist: the m-fold twists ϑ for the level
-- prime N, as a set; oneTwist is the twist 1 (Data.instOneTws)
-- (GRH.Proof.Seesaw.IndexTypes).
def mfoldTwists (P D L : Set) : Set := mfoldTwistsAt(P, D, L.N)
def oneTwist (P D L : Set) : Set := trivialTwist(P, D)

-- IndexTypes.lean, TameChar.levelNorm: ∏_{w ∈ Q} q_w, for the set Q of
-- places of the twist ϑ.
def twistLevelNorm (P D L ϑ : Set) : Set := placeNormProduct(dataE(P, D), ϑ.Q)

-- The level setting liftLevelSetting(P, D, L, ϑ) of the codomain of
-- Data.iotaAtLevel ϑ is defined in GRH.Proof.Seesaw.GradingsOfY.

-- The ℂ-module of level forms that receives the lift of the rows for the
-- twist ϑ (the codomain of Data.iotaAtLevel ϑ).
def liftedForms (P D L ϑ : Set) : Set := levelFormModule(liftLevelSetting(P, D, L, ϑ))

-- FORWARD. RowVolume.lean, Data.Θ ϑ = Data.iotaAtLevel ϑ ∘ rows.subtype:
-- the lift, a linear map from the rows to liftedForms(P, D, L, ϑ).
def liftTheta (P D L ϑ : Set) : Set := ∅

-- LevelForms.lean, LevelForm.normSqAt σ F: for σ ∈ Aut ℂ, the class sum
-- of the squared Gram norms of the vectors σ(F(g)) (a real).
def normSqAt (P D L ϑ F σ : Set) : Set := levelNormSqAt(liftLevelSetting(P, D, L, ϑ), F, σ)

-- LevelForms.lean, the entry of pairingMatrix y (fun _ ↦ σ) at two forms
-- F, G: the class sum over g of the Gram pairing of σ(F(g)) with σ(G(g)),
-- a complex number.
def formPairing (P D L ϑ σ F G : Set) : Set :=
  levelPairing(liftLevelSetting(P, D, L, ϑ), σ, F, G)

-- LevelForms.lean, integralForms ι: the lifted forms for ϑ integral at
-- the p-adic place ι : ℂ → ℂ_p (as a set).
def integralForms (P D L ϑ p ι : Set) : Set :=
  levelIntegralForms(liftLevelSetting(P, D, L, ϑ), p, ι)

-- The weight columnSetting(P, D, L) of the columns is defined in
-- GRH.Proof.Columns.ColumnDefs.

-- ClassReps.lean, integralFormsAt D.Column 1 at ι: the columns integral
-- at the p-adic place ι (as a set).
def integralColumns (P D L p ι : Set) : Set :=
  integralFormsAt(LevelSetting.field(columnSetting(P, D, L)),
    LevelSetting.rank(columnSetting(P, D, L)), LevelSetting.weight(columnSetting(P, D, L)),
    Module.carrier(dataColumn(P, D, L)),
    matOne(finiteAdeleRing(LevelSetting.field(columnSetting(P, D, L))),
      LevelSetting.rank(columnSetting(P, D, L))), p, ι)

-- FORWARD (predicate). SeesawTheorem.lean, Data.seesaw: c is a nonzero
-- complex number such that for every twist ϑ some good datum Ψ has
-- ι_ϑ(𝒫(cφ)) = B^Ψ φ for every ramified column φ. Placeholder body: the
-- typing.
predicate SeesawConstant (P D L c : Set) :=
  c ∈ complexCarrier ∧ c ≠ complexZero
