-- Derivatives between normed spaces: the Fréchet derivative at a point,
-- strict differentiability, directional derivatives, derivatives of maps
-- of one scalar variable; the derivative as a value; the rules (constants,
-- the identity, continuous linear maps, sums, scalar multiples, products
-- of scalar functions, pairs into a product, the chain rule); the bridge
-- to Cumulus's real derivative and layer 1's complex derivative; the mean
-- value inequality; continuously differentiable maps of every order on an
-- open set, through iterated directional derivatives; and the inverse
-- function theorem.
-- Part of the GRH blueprint.
-- Planned home: Analysis/Calculus/FDeriv.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Calculus.Frechet
import GRH.Normed.InnerProduct
import Grace.Cumulus.Real.Analysis.Differentiation

section Frechet
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Section: Definitions
-- f has Fréchet derivative L at x (Mathlib's HasFDerivAt): L is a
-- continuous linear map V → W and ‖f(x + h) − f(x) − L h‖ ≤ ε ‖h‖ for
-- ‖h‖ small, for every ε > 0. Only the values of f near x are read, so f
-- may be a function on any open set around x.
predicate HasFDerivAt (f V normV W normW K L x : Set) :=
  x ∈ Module.carrier(V) ∧ f(x) ∈ Module.carrier(W) ∧
  ContinuousLinearMap(L, V, normV, W, normW, K) ∧
  (∀ e ∈ ℝ, realZero < e → ∃ d ∈ ℝ, realZero < d ∧
    (∀ h ∈ Module.carrier(V), normV(h) < d →
      f(Module.add(V)(x, h)) ∈ Module.carrier(W) ∧
      normW(Module.add(W)(f(Module.add(V)(x, h)),
        Module.neg(W)(Module.add(W)(f(x), L(h))))) ≤ R[e * normV(h)]))

predicate FDifferentiableAt (f V normV W normW K x : Set) :=
  ∃ L, HasFDerivAt(f, V, normV, W, normW, K, L, x)

-- Differentiable at every point of an open set U.
predicate FDifferentiableOn (f V normV W normW K U : Set) :=
  U ∈ TopologicalSpace.opens(spaceTopology(V, normV)) ∧
  (∀ x ∈ U, FDifferentiableAt(f, V, normV, W, normW, K, x))

-- Strict differentiability (Mathlib's HasStrictFDerivAt):
-- ‖f(y) − f(z) − L(y − z)‖ ≤ ε ‖y − z‖ for y, z near x.
predicate HasStrictFDerivAt (f V normV W normW K L x : Set) :=
  x ∈ Module.carrier(V) ∧ ContinuousLinearMap(L, V, normV, W, normW, K) ∧
  (∀ e ∈ ℝ, realZero < e → ∃ d ∈ ℝ, realZero < d ∧
    (∀ y ∈ Module.carrier(V), ∀ z ∈ Module.carrier(V),
      normV(Module.add(V)(y, Module.neg(V)(x))) < d →
      normV(Module.add(V)(z, Module.neg(V)(x))) < d →
      normW(Module.add(W)(Module.add(W)(f(y), Module.neg(W)(f(z))),
        Module.neg(W)(L(Module.add(V)(y, Module.neg(V)(z)))))) ≤
        R[e * normV(Module.add(V)(y, Module.neg(V)(z)))]))

-- In an abelian group, (F − (P + Q₂)) − (F − (P + Q₁)) = Q₁ − Q₂: the
-- difference of two linear approximations.
theorem AbelianGroup.approx_diff (G F P Q1 Q2 : Set)
  requires abelian : AbelianGroup(G)
  requires memF : F ∈ G.carrier
  requires memP : P ∈ G.carrier
  requires memQ1 : Q1 ∈ G.carrier
  requires memQ2 : Q2 ∈ G.carrier
  shows G.mul(G.mul(F, G.inv(G.mul(P, Q2))),
    G.inv(G.mul(F, G.inv(G.mul(P, Q1))))) = G.mul(Q1, G.inv(Q2))
proof
  have group := AbelianGroup.to_group with abelian
  group_simp
  have invQ2 := Group.inv_mem at G, Q2 with group, memQ2
  have invF := Group.inv_mem at G, F with group, memF
  have a1 := mul_left_comm at G, G.inv(Q2), Q1, G.inv(F) with abelian, invQ2, memQ1, invF
  have inner := Group.mul_mem at G, G.inv(Q2), G.inv(F) with group, invQ2, invF
  have a2 := mul_left_comm at G, F, Q1, G.mul(G.inv(Q2), G.inv(F)) with abelian, memF, memQ1, inner
  have a3 := mul_left_comm at G, F, G.inv(Q2), G.inv(F) with abelian, memF, invQ2, invF
  have a4 := Group.mul_inv at G, F with group, memF
  have a5 := mul_one at G, G.inv(Q2) with group, invQ2
  rw [a1, a2, a3, a4, a5]

-- a − b = (a − (b + c)) + c in an abelian group.
theorem AbelianGroup.sub_split (G a b c : Set)
  requires abelian : AbelianGroup(G)
  requires memA : a ∈ G.carrier
  requires memB : b ∈ G.carrier
  requires memC : c ∈ G.carrier
  shows G.mul(a, G.inv(b)) = G.mul(G.mul(a, G.inv(G.mul(b, c))), c)
proof
  have group := AbelianGroup.to_group with abelian
  group_simp
  have ib := Group.inv_mem at G, b with group, memB
  have ic := Group.inv_mem at G, c with group, memC
  have a1 := mul_left_comm at G, G.inv(c), G.inv(b), c with abelian, ic, ib, memC
  have a2 := Group.inv_mul at G, c with group, memC
  have a3 := mul_one at G, G.inv(b) with group, ib
  rw [a1, a2, a3]

-- The action commutes with negation: t • (−b) = −(t • b).
theorem Module.smul_neg_value (V K t b : Set)
  requires ring : Ring(K)
  requires module : Module(V, K)
  requires scalar : t ∈ Ring.carrier(K)
  requires member : b ∈ Module.carrier(V)
  shows Module.smul(V)(t, Module.neg(V)(b)) = Module.neg(V)(Module.smul(V)(t, b))
proof
  have group := Module.additive_group at K, V with ring, module
  have negB := Module.neg_mem at K, V, b with *
  have s := smul_add at K, V, t, b, Module.neg(V)(b) with *
  have c := Group.mul_inv at Module.additive(V), b with group, *
  module_additive at c
  have z := smul_zero at K, V, t with *
  rw [c, z] at s
  have tb := Module.smul_mem at K, V, t, b with *
  have tnb := Module.smul_mem at K, V, t, Module.neg(V)(b) with *
  have eq : Group.mul(Module.additive(V))(Module.smul(V)(t, b), Module.smul(V)(t, Module.neg(V)(b))) = Group.one(Module.additive(V))
    module_additive
  have r := eq_inv_of_mul_eq_one_right at Module.additive(V), Module.smul(V)(t, b), Module.smul(V)(t, Module.neg(V)(b)) with group, *
  module_additive at r
  exact r

-- Module forms of the abelian-group identities behind the chain rule.
theorem frechetComp.recombine (V K a b : Set)
  requires module : Module(V, K)
  requires memberA : a ∈ Module.carrier(V)
  requires memberB : b ∈ Module.carrier(V)
  shows Module.add(V)(a, Module.add(V)(b, Module.neg(V)(a))) = b
proof
  have ring := Module.ring at V, K with module
  have group := Module.additive_group at K, V with ring, module
  have abelian := Module.additive.abelian_group at V, K with module
  have aA : a ∈ Group.carrier(Module.additive(V))
    rw Module.additive.carrier
    exact memberA
  have bA : b ∈ Group.carrier(Module.additive(V))
    rw Module.additive.carrier
    exact memberB
  have ia := Group.inv_mem at Module.additive(V), a with group, aA
  have c1 := mul_left_comm at Module.additive(V), a, b, Group.inv(Module.additive(V))(a) with abelian, aA, bA, ia
  have c2 := Group.mul_inv at Module.additive(V), a with group, aA
  have c3 := mul_one at Module.additive(V), b with group, bA
  rw [c2, c3] at c1
  rw [Module.additive.mul, Module.additive.inv] at c1
  exact c1

theorem frechetComp.add_sub_cancel (V K r p : Set)
  requires module : Module(V, K)
  requires memberR : r ∈ Module.carrier(V)
  requires memberP : p ∈ Module.carrier(V)
  shows Module.add(V)(Module.add(V)(r, p), Module.neg(V)(p)) = r
proof
  have ring := Module.ring at V, K with module
  have group := Module.additive_group at K, V with ring, module
  have rA : r ∈ Group.carrier(Module.additive(V))
    rw Module.additive.carrier
    exact memberR
  have pA : p ∈ Group.carrier(Module.additive(V))
    rw Module.additive.carrier
    exact memberP
  have c := mul_inv_cancel_right at Module.additive(V), r, p with group, rA, pA
  rw [Module.additive.mul, Module.additive.inv] at c
  exact c

theorem frechetComp.sub_add_cancel (V K a b : Set)
  requires module : Module(V, K)
  requires memberA : a ∈ Module.carrier(V)
  requires memberB : b ∈ Module.carrier(V)
  shows Module.add(V)(Module.add(V)(a, Module.neg(V)(b)), b) = a
proof
  have ring := Module.ring at V, K with module
  have group := Module.additive_group at K, V with ring, module
  have aA : a ∈ Group.carrier(Module.additive(V))
    rw Module.additive.carrier
    exact memberA
  have bA : b ∈ Group.carrier(Module.additive(V))
    rw Module.additive.carrier
    exact memberB
  have c := inv_mul_cancel_right at Module.additive(V), a, b with group, aA, bA
  rw [Module.additive.mul, Module.additive.inv] at c
  exact c

theorem frechetComp.sub_split (V K a b c : Set)
  requires module : Module(V, K)
  requires memberA : a ∈ Module.carrier(V)
  requires memberB : b ∈ Module.carrier(V)
  requires memberC : c ∈ Module.carrier(V)
  shows Module.add(V)(a, Module.neg(V)(b)) =
    Module.add(V)(Module.add(V)(a, Module.neg(V)(Module.add(V)(b, c))), c)
proof
  have abelian := Module.additive.abelian_group at V, K with module
  have aA : a ∈ Group.carrier(Module.additive(V))
    rw Module.additive.carrier
    exact memberA
  have bA : b ∈ Group.carrier(Module.additive(V))
    rw Module.additive.carrier
    exact memberB
  have cA : c ∈ Group.carrier(Module.additive(V))
    rw Module.additive.carrier
    exact memberC
  have sp := AbelianGroup.sub_split at Module.additive(V), a, b, c with abelian, aA, bA, cA
  rw [Module.additive.mul, Module.additive.inv] at sp
  exact sp

theorem frechetComp.approx_diff (V K F P Q1 Q2 : Set)
  requires module : Module(V, K)
  requires memF : F ∈ Module.carrier(V)
  requires memP : P ∈ Module.carrier(V)
  requires memQ1 : Q1 ∈ Module.carrier(V)
  requires memQ2 : Q2 ∈ Module.carrier(V)
  shows Module.add(V)(Module.add(V)(F, Module.neg(V)(Module.add(V)(P, Q2))),
    Module.neg(V)(Module.add(V)(F, Module.neg(V)(Module.add(V)(P, Q1))))) =
    Module.add(V)(Q1, Module.neg(V)(Q2))
proof
  have abelian := Module.additive.abelian_group at V, K with module
  have FA : F ∈ Group.carrier(Module.additive(V))
    rw Module.additive.carrier
    exact memF
  have PA : P ∈ Group.carrier(Module.additive(V))
    rw Module.additive.carrier
    exact memP
  have Q1A : Q1 ∈ Group.carrier(Module.additive(V))
    rw Module.additive.carrier
    exact memQ1
  have Q2A : Q2 ∈ Group.carrier(Module.additive(V))
    rw Module.additive.carrier
    exact memQ2
  have d := AbelianGroup.approx_diff at Module.additive(V), F, P, Q1, Q2 with abelian, FA, PA, Q1A, Q2A
  rw [Module.additive.mul, Module.additive.inv] at d
  exact d

theorem HasFDerivAt.arith_final (a e : Real)
  requires aNn : (0:R) ≤ a
  requires ePos : (0:R) < e
  requires le : (4:R) * a + (4:R) * e ≤ (2:R) * a
  shows ⊥
proof
  have s : (2:R) * a + (4:R) * e ≤ (0:R) by linarith
  linarith

-- The arithmetic behind the uniqueness of derivatives.
theorem HasFDerivAt.agree_arith (m n e s : Real)
  requires mPos : (0:R) < m
  requires nNn : (0:R) ≤ n
  requires eDef : e * ((4:R) * (n + (1:R))) = m
  requires sPos : (0:R) < s
  requires bound : s * m ≤ e * (s * n) + e * (s * n)
  shows ⊥
proof
  have ePos : (0:R) < e
    by_contra notPos
    have le0 : e ≤ (0:R) by linarith
    have denNn : (0:R) ≤ (4:R) * (n + (1:R)) by linarith
    have m2 := realLe.mul_right_of_nonnegative at e, (0:R), (4:R) * (n + (1:R)) with le0, denNn
    rw eDef at m2
    ring_nf at m2
    have bad : (1:R) < (1:R) by linarith
    linarith
  have eNn : (0:R) ≤ e by linarith
  have en := realLe.mul_left_of_nonnegative at (0:R), n, e with nNn, eNn
  have ez : e * (0:R) = (0:R) by ring
  rw ez at en
  have ex2 : e * (s * n) + e * (s * n) = ((2:R) * (e * n)) * s by ring
  have ex3 : s * m = m * s by ring
  rw [ex2, ex3] at bound
  have canc := realLe.mul_right_cancel_positive at m, (2:R) * (e * n), s with sPos, bound
  have ex : e * ((4:R) * (n + (1:R))) = (4:R) * (e * n) + (4:R) * e by ring
  rw ex at eDef
  rw ← eDef at canc
  exact HasFDerivAt.arith_final at e * n, e with en, ePos, canc

-- Two Fréchet derivatives of f at x agree: their difference D satisfies
-- ‖D k‖ ≤ 2ε‖k‖ for small k, and rescaling by small scalars spreads the
-- bound to every vector.
theorem HasFDerivAt.agree (f V normV W normW K absK L1 L2 x : Set)
  requires nontrivial : NontriviallyNormedField(K, absK)
  requires normedV : NormedSpace(V, K, absK, normV)
  requires normedW : NormedSpace(W, K, absK, normW)
  requires first : HasFDerivAt(f, V, normV, W, normW, K, L1, x)
  requires second : HasFDerivAt(f, V, normV, W, normW, K, L2, x)
  shows ∀ h ∈ Module.carrier(V), L1(h) = L2(h)
proof
  have nV := normedV
  obtain ⟨nfV, modV, ngV, lawV⟩ := nV
  have nW := normedW
  obtain ⟨nfW, modW, ngW, lawW⟩ := nW
  have nf2 := nfV
  obtain ⟨field, comm, nr, mulEq, oneEq⟩ := nf2
  have ring := nr.left
  have abelianW := Module.additive.abelian_group at W, K with modW
  have groupW := AbelianGroup.to_group with abelianW
  have ngV2 := ngV
  obtain ⟨abelianV, isNormV⟩ := ngV2
  obtain ⟨normFV, nonnegV, zeroIffV, invarV, triV⟩ := isNormV
  have ngW2 := ngW
  obtain ⟨abelianW2, isNormW⟩ := ngW2
  obtain ⟨normFW, nonnegW, zeroIffW, invarW, triW⟩ := isNormW
  obtain ⟨xIn, fxIn, clm1, approx1⟩ := first
  obtain ⟨xIn2, fxIn2, clm2, approx2⟩ := second
  obtain ⟨lin1, cont1⟩ := clm1
  obtain ⟨lin2, cont2⟩ := clm2
  obtain ⟨modV1, modW1, fn1, add1, smul1⟩ := lin1
  obtain ⟨modV2, modW2, fn2, add2, smul2⟩ := lin2
  intros h hIn
  have aIn := FunctionBetween.apply_closed with fn1, hIn
  have bIn := FunctionBetween.apply_closed with fn2, hIn
  have negB := Module.neg_mem at K, W, L2(h) with *
  have dIn := Module.add_mem at K, W, L1(h), Module.neg(W)(L2(h)) with *
  have dA : Module.add(W)(L1(h), Module.neg(W)(L2(h))) ∈ Group.carrier(Module.additive(W))
    rw Module.additive.carrier
    exact dIn
  have hA : h ∈ Group.carrier(Module.additive(V))
    rw Module.additive.carrier
    exact hIn
  have mR := FunctionBetween.apply_closed with normFW, dA
  have mRR : Real(normW(Module.add(W)(L1(h), Module.neg(W)(L2(h))))) by exact mR
  have mNn := nonnegW with Module.add(W)(L1(h), Module.neg(W)(L2(h))), dA
  have nhR := FunctionBetween.apply_closed with normFV, hA
  have nhRR : Real(normV(h)) by exact nhR
  have nhNn := nonnegV with h, hA
  have zeroNorm : normW(Module.add(W)(L1(h), Module.neg(W)(L2(h)))) = realZero
    by_contra nonzero
    have mPos : (0:R) < normW(Module.add(W)(L1(h), Module.neg(W)(L2(h))))
      by_contra notPos
      have eq0 : normW(Module.add(W)(L1(h), Module.neg(W)(L2(h)))) = realZero by linarith
      exact nonzero with eq0
    have nh1 : (0:R) < normV(h) + (1:R) by linarith
    have denPos : (0:R) < (4:R) * (normV(h) + (1:R)) by linarith
    have denNe : (4:R) * (normV(h) + (1:R)) ≠ (0:R)
      intro e0
      rw e0 at denPos
      linarith
    have eIn : (normW(Module.add(W)(L1(h), Module.neg(W)(L2(h)))) / ((4:R) * (normV(h) + (1:R)))) ∈ ℝ by typecheck
    have eRR : Real((normW(Module.add(W)(L1(h), Module.neg(W)(L2(h)))) / ((4:R) * (normV(h) + (1:R))))) by exact eIn
    have eMul := realDiv.mul_right at normW(Module.add(W)(L1(h), Module.neg(W)(L2(h)))), (4:R) * (normV(h) + (1:R)) with denNe
    have ePos : (0:R) < (normW(Module.add(W)(L1(h), Module.neg(W)(L2(h)))) / ((4:R) * (normV(h) + (1:R))))
      by_contra notPos
      have le0 : (normW(Module.add(W)(L1(h), Module.neg(W)(L2(h)))) / ((4:R) * (normV(h) + (1:R)))) ≤ (0:R) by linarith
      have denNn : (0:R) ≤ (4:R) * (normV(h) + (1:R)) by linarith
      have m2 := realLe.mul_right_of_nonnegative at (normW(Module.add(W)(L1(h), Module.neg(W)(L2(h)))) / ((4:R) * (normV(h) + (1:R)))), (0:R), (4:R) * (normV(h) + (1:R)) with le0, denNn
      rw eMul at m2
      ring_nf at m2
      have bad : (1:R) < (1:R) by linarith
      linarith
    obtain ⟨d1, d1In, d1Pos, est1⟩ := approx1 with (normW(Module.add(W)(L1(h), Module.neg(W)(L2(h)))) / ((4:R) * (normV(h) + (1:R)))), eIn, ePos
    obtain ⟨d2, d2In, d2Pos, est2⟩ := approx2 with (normW(Module.add(W)(L1(h), Module.neg(W)(L2(h)))) / ((4:R) * (normV(h) + (1:R)))), eIn, ePos
    have d1R : Real(d1) by exact d1In
    have d2R : Real(d2) by exact d2In
    have dmin : ∃ d ∈ ℝ, (0:R) < d ∧ d ≤ d1 ∧ d ≤ d2
      by_cases le12 : d1 ≤ d2
      . have self1 : d1 ≤ d1 by linarith
        exact ⟨d1, d1In, d1Pos, self1, le12⟩
      . have le21 : d2 ≤ d1 by linarith
        have self2 : d2 ≤ d2 by linarith
        exact ⟨d2, d2In, d2Pos, le21, self2⟩
    obtain ⟨d0, d0In, d0Pos, d0le1, d0le2⟩ := dmin
    have d0R : Real(d0) by exact d0In
    have nhNe : normV(h) + (1:R) ≠ (0:R)
      intro e0
      rw e0 at nh1
      linarith
    have rIn : d0 / (normV(h) + (1:R)) ∈ ℝ by typecheck
    have rRR : Real(d0 / (normV(h) + (1:R))) by exact rIn
    have rMul := realDiv.mul_right at d0, normV(h) + (1:R) with nhNe
    have rPos : (0:R) < d0 / (normV(h) + (1:R))
      by_contra notPos
      have le0 : d0 / (normV(h) + (1:R)) ≤ (0:R) by linarith
      have nNn : (0:R) ≤ normV(h) + (1:R) by linarith
      have m2 := realLe.mul_right_of_nonnegative at d0 / (normV(h) + (1:R)), (0:R), normV(h) + (1:R) with le0, nNn
      rw rMul at m2
      ring_nf at m2
      have bad : (1:R) < (1:R) by linarith
      linarith
    obtain ⟨t, tIn, tPos, tLt⟩ := NontriviallyNormedField.small at K, absK, d0 / (normV(h) + (1:R)) with nontrivial, rPos
    have tR := (NormedField.norm_real at K, absK, t with nfV, tIn).left
    have tRR : Real(absK(t)) by exact tR
    have kIn := Module.smul_mem at K, V, t, h with *
    have nk := lawV with t, tIn, h, hIn
    have tl := realLess.mul_right_of_positive at absK(t), d0 / (normV(h) + (1:R)), normV(h) + (1:R) with tLt, nh1
    rw rMul at tl
    have kSmall : normV(Module.smul(V)(t, h)) < d0
      rw nk
      ring_nf at tl
      have tnh := realLe.mul_left_of_nonnegative at (0:R), normV(h), absK(t) with nhNn, (realLess.implies_le with tPos)
      ring_nf at tnh
      ring_nf
      linarith
    have kA : Module.smul(V)(t, h) ∈ Group.carrier(Module.additive(V))
      rw Module.additive.carrier
      exact kIn
    have nkR := FunctionBetween.apply_closed with normFV, kA
    have nkRR : Real(normV(Module.smul(V)(t, h))) by exact nkR
    have k1 : normV(Module.smul(V)(t, h)) < d1 by linarith
    have k2 : normV(Module.smul(V)(t, h)) < d2 by linarith
    obtain ⟨Fin1, b1⟩ := est1 with Module.smul(V)(t, h), kIn, k1
    obtain ⟨Fin2, b2⟩ := est2 with Module.smul(V)(t, h), kIn, k2
    have FA : f(Module.add(V)(x, Module.smul(V)(t, h))) ∈ Group.carrier(Module.additive(W))
      rw Module.additive.carrier
      exact Fin1
    have PA : f(x) ∈ Group.carrier(Module.additive(W))
      rw Module.additive.carrier
      exact fxIn
    have Q1In := FunctionBetween.apply_closed with fn1, kIn
    have Q2In := FunctionBetween.apply_closed with fn2, kIn
    have Q1A : L1(Module.smul(V)(t, h)) ∈ Group.carrier(Module.additive(W))
      rw Module.additive.carrier
      exact Q1In
    have Q2A : L2(Module.smul(V)(t, h)) ∈ Group.carrier(Module.additive(W))
      rw Module.additive.carrier
      exact Q2In
    have diff := AbelianGroup.approx_diff at Module.additive(W), f(Module.add(V)(x, Module.smul(V)(t, h))), f(x), L1(Module.smul(V)(t, h)), L2(Module.smul(V)(t, h)) with abelianW, FA, PA, Q1A, Q2A
    module_additive at diff
    have uIn : Module.add(W)(f(Module.add(V)(x, Module.smul(V)(t, h))), Module.neg(W)(Module.add(W)(f(x), L2(Module.smul(V)(t, h))))) ∈ Module.carrier(W) by typecheck
    have vIn : Module.add(W)(f(Module.add(V)(x, Module.smul(V)(t, h))), Module.neg(W)(Module.add(W)(f(x), L1(Module.smul(V)(t, h))))) ∈ Module.carrier(W) by typecheck
    have uA : Module.add(W)(f(Module.add(V)(x, Module.smul(V)(t, h))), Module.neg(W)(Module.add(W)(f(x), L2(Module.smul(V)(t, h))))) ∈ Group.carrier(Module.additive(W))
      rw Module.additive.carrier
      exact uIn
    have vA : Module.add(W)(f(Module.add(V)(x, Module.smul(V)(t, h))), Module.neg(W)(Module.add(W)(f(x), L1(Module.smul(V)(t, h))))) ∈ Group.carrier(Module.additive(W))
      rw Module.additive.carrier
      exact vIn
    have nuR := FunctionBetween.apply_closed with normFW, uA
    have nvR := FunctionBetween.apply_closed with normFW, vA
    have nuRR : Real(normW(Module.add(W)(f(Module.add(V)(x, Module.smul(V)(t, h))), Module.neg(W)(Module.add(W)(f(x), L2(Module.smul(V)(t, h))))))) by exact nuR
    have nvRR : Real(normW(Module.add(W)(f(Module.add(V)(x, Module.smul(V)(t, h))), Module.neg(W)(Module.add(W)(f(x), L1(Module.smul(V)(t, h))))))) by exact nvR
    have sub := IsNorm.sub_le at Module.additive(W), normW, Module.add(W)(f(Module.add(V)(x, Module.smul(V)(t, h))), Module.neg(W)(Module.add(W)(f(x), L2(Module.smul(V)(t, h))))), Module.add(W)(f(Module.add(V)(x, Module.smul(V)(t, h))), Module.neg(W)(Module.add(W)(f(x), L1(Module.smul(V)(t, h))))) with ngW, uA, vA
    module_additive at sub
    rw diff at sub
    have s1 := smul1 with t, tIn, h, hIn
    have s2 := smul2 with t, tIn, h, hIn
    rw [s1, s2] at sub
    have sn := Module.smul_neg_value at W, K, t, L2(h) with ring, modW, tIn, bIn
    rw ← sn at sub
    have sa := smul_add at K, W, t, L1(h), Module.neg(W)(L2(h)) with *
    rw ← sa at sub
    have law := lawW with t, tIn, Module.add(W)(L1(h), Module.neg(W)(L2(h))), dIn
    rw law at sub
    rw nk at b1
    rw nk at b2
    rw s1 at b1
    rw s2 at b2
    rw s2 at nuRR
    rw s1 at nvRR
    have p1 : Real((normW(Module.add(W)(L1(h), Module.neg(W)(L2(h)))) / ((4:R) * (normV(h) + (1:R)))) * (absK(t) * normV(h))) by typecheck
    have p2 : Real(absK(t) * normW(Module.add(W)(L1(h), Module.neg(W)(L2(h))))) by typecheck
    have sum2 : absK(t) * normW(Module.add(W)(L1(h), Module.neg(W)(L2(h)))) ≤ (normW(Module.add(W)(L1(h), Module.neg(W)(L2(h)))) / ((4:R) * (normV(h) + (1:R)))) * (absK(t) * normV(h)) + (normW(Module.add(W)(L1(h), Module.neg(W)(L2(h)))) / ((4:R) * (normV(h) + (1:R)))) * (absK(t) * normV(h)) by linarith
    exact HasFDerivAt.agree_arith at normW(Module.add(W)(L1(h), Module.neg(W)(L2(h)))), normV(h), (normW(Module.add(W)(L1(h), Module.neg(W)(L2(h)))) / ((4:R) * (normV(h) + (1:R)))), absK(t) with mPos, nhNn, eMul, tPos, sum2
  have z := (zeroIffW with Module.add(W)(L1(h), Module.neg(W)(L2(h))), dA).forward with zeroNorm
  module_additive at z
  have crit := mul_inv_eq_one at Module.additive(W), L1(h), L2(h) with groupW, *
  module_additive at crit
  exact crit.forward with z

-- The derivative as a value: the unique L when f is differentiable at x
-- (Mathlib's fderiv, whose junk value 0 is not needed here).
defunique fderiv (f V normV W normW K x : Set)
    (L ∈ functionSpace(Module.carrier(V), Module.carrier(W))) :=
  HasFDerivAt(f, V, normV, W, normW, K, L, x)
requires differentiable : FDifferentiableAt(f, V, normV, W, normW, K, x)
requires normed : ∃ absK, NontriviallyNormedField(K, absK) ∧
  NormedSpace(V, K, absK, normV) ∧ NormedSpace(W, K, absK, normW)
proof
  obtain ⟨L, has⟩ := differentiable
  obtain ⟨xIn, fxIn, clm, approx⟩ := has
  obtain ⟨linear, cont⟩ := clm
  obtain ⟨modV, modW, fn, addLaw, smulLaw⟩ := linear
  have mem := functionSpace.mem_iff.backward with fn
  refine ⟨L, mem, ?_⟩
  unfold HasFDerivAt
  unfold ContinuousLinearMap
  unfold IsLinearMap
  exact ⟨xIn, fxIn, ⟨⟨modV, modW, fn, addLaw, smulLaw⟩, cont⟩, approx⟩
uniqueness
  intros L1 L1In first L2 L2In second
  obtain ⟨absK, ntf, nV, nW⟩ := normed
  have agree := HasFDerivAt.agree at f, V, normV, W, normW, K, absK, L1, L2, x with ntf, nV, nW, first, second
  have fn1 := (functionSpace.mem_iff at L1, Module.carrier(V), Module.carrier(W)).forward with L1In
  have fn2 := (functionSpace.mem_iff at L2, Module.carrier(V), Module.carrier(W)).forward with L2In
  exact FunctionBetween.ext with fn1, fn2, agree

-- The directional derivative of f at x along v: the derivative at 0 of
-- t ↦ f(x + t v), t in the scalar field K, with value D ∈ W.
predicate HasLineDerivAt (f V normV W normW K absK v D x : Set) :=
  x ∈ Module.carrier(V) ∧ v ∈ Module.carrier(V) ∧ D ∈ Module.carrier(W) ∧
  (∀ e ∈ ℝ, realZero < e → ∃ d ∈ ℝ, realZero < d ∧
    (∀ t ∈ Ring.carrier(K), absK(t) < d →
      normW(Module.add(W)(f(Module.add(V)(x, Module.smul(V)(t, v))),
        Module.neg(W)(Module.add(W)(f(x), Module.smul(W)(t, D))))) ≤
        R[e * absK(t)]))

-- The directional derivative along v as a relation from points to
-- values; on a set where it exists everywhere it is a function.
def lineDerivGraph (f V normV W normW K absK v : Set) : Set :=
  { p ∈ Module.carrier(V) × Module.carrier(W) |
    HasLineDerivAt(f, V, normV, W, normW, K, absK, v, snd(p), fst(p)) }

-- Derivatives of maps of one scalar variable (Mathlib's HasDerivAt for
-- f : 𝕜 → F): f(x + t) = f(x) + t D + o(t).
predicate HasDerivAt (f K absK W normW D x : Set) :=
  HasLineDerivAt(f, selfModule(K), absK, W, normW, K, absK, Ring.one(K), D, x)

-- Two directional derivatives of f at x along v agree, when f takes
-- values in W along the line: their difference d satisfies
-- |t| ‖d‖ ≤ 2ε|t| for small t ≠ 0.
theorem HasLineDerivAt.agree (f V normV W normW K absK v D E x : Set)
  requires nontrivial : NontriviallyNormedField(K, absK)
  requires normedW : NormedSpace(W, K, absK, normW)
  requires first : HasLineDerivAt(f, V, normV, W, normW, K, absK, v, D, x)
  requires second : HasLineDerivAt(f, V, normV, W, normW, K, absK, v, E, x)
  requires value : f(x) ∈ Module.carrier(W)
  requires values : ∀ t ∈ Ring.carrier(K),
    f(Module.add(V)(x, Module.smul(V)(t, v))) ∈ Module.carrier(W)
  shows D = E
proof
  have nW := normedW
  obtain ⟨nfW, modW, ngW, lawW⟩ := nW
  have nf2 := nfW
  obtain ⟨field, comm, nr, mulEq, oneEq⟩ := nf2
  have ring := nr.left
  have abelianW := Module.additive.abelian_group at W, K with modW
  have groupW := AbelianGroup.to_group with abelianW
  have ngW2 := ngW
  obtain ⟨abelianW2, isNormW⟩ := ngW2
  obtain ⟨normFW, nonnegW, zeroIffW, invarW, triW⟩ := isNormW
  obtain ⟨xIn, vIn, DIn, approx1⟩ := first
  obtain ⟨xIn2, vIn2, EIn, approx2⟩ := second
  have negE := Module.neg_mem at K, W, E with *
  have dIn := Module.add_mem at K, W, D, Module.neg(W)(E) with *
  have dA : Module.add(W)(D, Module.neg(W)(E)) ∈ Group.carrier(Module.additive(W))
    rw Module.additive.carrier
    exact dIn
  have mR := FunctionBetween.apply_closed with normFW, dA
  have mRR : Real(normW(Module.add(W)(D, Module.neg(W)(E)))) by exact mR
  have mNn := nonnegW with Module.add(W)(D, Module.neg(W)(E)), dA
  have zeroNorm : normW(Module.add(W)(D, Module.neg(W)(E))) = realZero
    by_contra nonzero
    have mPos : (0:R) < normW(Module.add(W)(D, Module.neg(W)(E)))
      by_contra notPos
      have eq0 : normW(Module.add(W)(D, Module.neg(W)(E))) = realZero by linarith
      exact nonzero with eq0
    have fourNe : (4:R) ≠ (0:R)
      intro e0
      have bad : (4:R) ≤ (0:R) by linarith
      linarith
    have eIn : (normW(Module.add(W)(D, Module.neg(W)(E))) / (4:R)) ∈ ℝ by typecheck
    have eRR : Real(normW(Module.add(W)(D, Module.neg(W)(E))) / (4:R)) by exact eIn
    have eMul := realDiv.mul_right at normW(Module.add(W)(D, Module.neg(W)(E))), (4:R) with fourNe
    have ePos : (0:R) < normW(Module.add(W)(D, Module.neg(W)(E))) / (4:R) by linarith
    obtain ⟨d1, d1In, d1Pos, est1⟩ := approx1 with (normW(Module.add(W)(D, Module.neg(W)(E))) / (4:R)), eIn, ePos
    obtain ⟨d2, d2In, d2Pos, est2⟩ := approx2 with (normW(Module.add(W)(D, Module.neg(W)(E))) / (4:R)), eIn, ePos
    have d1R : Real(d1) by exact d1In
    have d2R : Real(d2) by exact d2In
    have dmin : ∃ d ∈ ℝ, (0:R) < d ∧ d ≤ d1 ∧ d ≤ d2
      by_cases le12 : d1 ≤ d2
      . have self1 : d1 ≤ d1 by linarith
        exact ⟨d1, d1In, d1Pos, self1, le12⟩
      . have le21 : d2 ≤ d1 by linarith
        have self2 : d2 ≤ d2 by linarith
        exact ⟨d2, d2In, d2Pos, le21, self2⟩
    obtain ⟨d0, d0In, d0Pos, d0le1, d0le2⟩ := dmin
    have d0R : Real(d0) by exact d0In
    obtain ⟨t, tIn, tPos, tLt⟩ := NontriviallyNormedField.small at K, absK, d0 with nontrivial, d0Pos
    have tR := (NormedField.norm_real at K, absK, t with nfW, tIn).left
    have tRR : Real(absK(t)) by exact tR
    have k1 : absK(t) < d1 by linarith
    have k2 : absK(t) < d2 by linarith
    have b1 := est1 with t, tIn, k1
    have b2 := est2 with t, tIn, k2
    have Fin := values with t, tIn
    have FA : f(Module.add(V)(x, Module.smul(V)(t, v))) ∈ Group.carrier(Module.additive(W))
      rw Module.additive.carrier
      exact Fin
    have PA : f(x) ∈ Group.carrier(Module.additive(W))
      rw Module.additive.carrier
      exact value
    have Q1In := Module.smul_mem at K, W, t, D with *
    have Q2In := Module.smul_mem at K, W, t, E with *
    have Q1A : Module.smul(W)(t, D) ∈ Group.carrier(Module.additive(W))
      rw Module.additive.carrier
      exact Q1In
    have Q2A : Module.smul(W)(t, E) ∈ Group.carrier(Module.additive(W))
      rw Module.additive.carrier
      exact Q2In
    have diff := AbelianGroup.approx_diff at Module.additive(W), f(Module.add(V)(x, Module.smul(V)(t, v))), f(x), Module.smul(W)(t, D), Module.smul(W)(t, E) with abelianW, FA, PA, Q1A, Q2A
    module_additive at diff
    have uIn : Module.add(W)(f(Module.add(V)(x, Module.smul(V)(t, v))), Module.neg(W)(Module.add(W)(f(x), Module.smul(W)(t, E)))) ∈ Module.carrier(W) by typecheck
    have wIn : Module.add(W)(f(Module.add(V)(x, Module.smul(V)(t, v))), Module.neg(W)(Module.add(W)(f(x), Module.smul(W)(t, D)))) ∈ Module.carrier(W) by typecheck
    have uA : Module.add(W)(f(Module.add(V)(x, Module.smul(V)(t, v))), Module.neg(W)(Module.add(W)(f(x), Module.smul(W)(t, E)))) ∈ Group.carrier(Module.additive(W))
      rw Module.additive.carrier
      exact uIn
    have wA : Module.add(W)(f(Module.add(V)(x, Module.smul(V)(t, v))), Module.neg(W)(Module.add(W)(f(x), Module.smul(W)(t, D)))) ∈ Group.carrier(Module.additive(W))
      rw Module.additive.carrier
      exact wIn
    have nuR := FunctionBetween.apply_closed with normFW, uA
    have nwR := FunctionBetween.apply_closed with normFW, wA
    have nuRR : Real(normW(Module.add(W)(f(Module.add(V)(x, Module.smul(V)(t, v))), Module.neg(W)(Module.add(W)(f(x), Module.smul(W)(t, E)))))) by exact nuR
    have nwRR : Real(normW(Module.add(W)(f(Module.add(V)(x, Module.smul(V)(t, v))), Module.neg(W)(Module.add(W)(f(x), Module.smul(W)(t, D)))))) by exact nwR
    have sub := IsNorm.sub_le at Module.additive(W), normW, Module.add(W)(f(Module.add(V)(x, Module.smul(V)(t, v))), Module.neg(W)(Module.add(W)(f(x), Module.smul(W)(t, E)))), Module.add(W)(f(Module.add(V)(x, Module.smul(V)(t, v))), Module.neg(W)(Module.add(W)(f(x), Module.smul(W)(t, D)))) with ngW, uA, wA
    module_additive at sub
    rw diff at sub
    have sn := Module.smul_neg_value at W, K, t, E with ring, modW, tIn, EIn
    rw ← sn at sub
    have sa := smul_add at K, W, t, D, Module.neg(W)(E) with *
    rw ← sa at sub
    have law := lawW with t, tIn, Module.add(W)(D, Module.neg(W)(E)), dIn
    rw law at sub
    have p := realLess.mul_right_of_positive at (0:R), normW(Module.add(W)(D, Module.neg(W)(E))) / (4:R), absK(t) with ePos, tPos
    have z : (0:R) * absK(t) = (0:R) by ring
    rw z at p
    have ex : absK(t) * normW(Module.add(W)(D, Module.neg(W)(E))) = (4:R) * ((normW(Module.add(W)(D, Module.neg(W)(E))) / (4:R)) * absK(t))
      have ex2 : (4:R) * ((normW(Module.add(W)(D, Module.neg(W)(E))) / (4:R)) * absK(t)) = ((normW(Module.add(W)(D, Module.neg(W)(E))) / (4:R)) * (4:R)) * absK(t) by ring
      rw [ex2, eMul]
      ring
    rw ex at sub
    linarith
  have z := (zeroIffW with Module.add(W)(D, Module.neg(W)(E)), dA).forward with zeroNorm
  module_additive at z
  have crit := mul_inv_eq_one at Module.additive(W), D, E with groupW, *
  module_additive at crit
  exact crit.forward with z

defunique deriv (f K absK W normW x : Set) (D ∈ Module.carrier(W)) :=
  HasDerivAt(f, K, absK, W, normW, D, x)
requires differentiable : ∃ D, HasDerivAt(f, K, absK, W, normW, D, x)
requires normed : NontriviallyNormedField(K, absK) ∧ NormedSpace(W, K, absK, normW)
requires values : ∀ y ∈ Ring.carrier(K), f(y) ∈ Module.carrier(W)
proof
  obtain ⟨D, has⟩ := differentiable
  have has2 := has
  unfold HasDerivAt at has2
  obtain ⟨xIn, vIn, DIn, approx⟩ := has2
  refine ⟨D, DIn, has⟩
uniqueness
  intros D1 D1In p1 D2 D2In p2
  obtain ⟨nontrivial, normedW⟩ := normed
  unfold HasDerivAt at p1
  unfold HasDerivAt at p2
  have p1b := p1
  obtain ⟨xIn, oneIn, D1In2, approx⟩ := p1b
  have carEq : Module.carrier(selfModule(K)) = Ring.carrier(K)
    unfold selfModule
    simp [Module.mk.carrier]
  rw carEq at xIn
  rw carEq at oneIn
  have value := values with x, xIn
  have values2 : ∀ t ∈ Ring.carrier(K), f(Module.add(selfModule(K))(x, Module.smul(selfModule(K))(t, Ring.one(K)))) ∈ Module.carrier(W)
    intros t tIn
    have nf := normedW.left
    have ring := nf.right.right.left.left
    have addEq : Module.add(selfModule(K)) = Ring.add(K)
      unfold selfModule
      simp [Module.mk.add]
    have smulEq : Module.smul(selfModule(K)) = Ring.mul(K)
      unfold selfModule
      simp [Module.mk.smul]
    rw [addEq, smulEq]
    have m := Ring.mul_mem at K, t, Ring.one(K) with *
    have a := Ring.add_mem at K, x, Ring.mul(K)(t, Ring.one(K)) with *
    exact values with Ring.add(K)(x, Ring.mul(K)(t, Ring.one(K))), a
  exact HasLineDerivAt.agree with nontrivial, normedW, p1, p2, value, values2

-- Continuity on a subset, for maps between normed spaces.
predicate ContinuousOnSet (f V normV W normW U : Set) :=
  U ⊆ Module.carrier(V) ∧ (∀ x ∈ U, f(x) ∈ Module.carrier(W)) ∧
  (∀ x ∈ U, ∀ e ∈ ℝ, realZero < e → ∃ d ∈ ℝ, realZero < d ∧
    (∀ y ∈ U, normV(Module.add(V)(y, Module.neg(V)(x))) < d →
      normW(Module.add(W)(f(y), Module.neg(W)(f(x)))) < e))

-- The maps of class Cᵏ on an open set U, through iterated directional
-- derivatives: C⁰ is continuity on U, and Cᵏ⁺¹ asks that every
-- directional derivative exist on U and be of class Cᵏ there. Maps are
-- taken restricted to U. For a finite-dimensional V this is Mathlib's
-- ContDiffOn 𝕜 k f U.
def contDiffBase (V normV W normW U : Set) : Set :=
  { g ∈ functionSpace(U, Module.carrier(W)) |
    ContinuousOnSet(g, V, normV, W, normW, U) }
def contDiffStep (V normV W normW K absK U C : Set) : Set :=
  { g ∈ contDiffBase(V, normV, W, normW, U) |
    ∀ v ∈ Module.carrier(V),
      (∀ x ∈ U, ∃ D, HasLineDerivAt(g, V, normV, W, normW, K, absK, v, D, x)) ∧
      restrict(lineDerivGraph(g, V, normV, W, normW, K, absK, v), U) ∈ C }
def contDiffClass (V normV W normW K absK U : Set, k : Nat) → Set
  | V, normV, W, normW, K, absK, U, zero => contDiffBase(V, normV, W, normW, U)
  | V, normV, W, normW, K, absK, U, succ(j) =>
      contDiffStep(V, normV, W, normW, K, absK, U,
        contDiffClass(V, normV, W, normW, K, absK, U, j))

predicate ContDiffOn (f V normV W normW K absK U : Set, k : Nat) :=
  U ∈ TopologicalSpace.opens(spaceTopology(V, normV)) ∧
  restrict(f, U) ∈ contDiffClass(V, normV, W, normW, K, absK, U, k)

predicate SmoothOn (f V normV W normW K absK U : Set) :=
  ∀ k ∈ ℕ, ContDiffOn(f, V, normV, W, normW, K, absK, U, k)

-- The product of two K-modules with the max norm.
def productModule (K V W : Set) : Set :=
  Module.mk(Module.carrier(V) × Module.carrier(W),
    { p ∈ ((Module.carrier(V) × Module.carrier(W)) ×
        (Module.carrier(V) × Module.carrier(W))) ×
        (Module.carrier(V) × Module.carrier(W)) |
      snd(p) = (Module.add(V)(fst(fst(fst(p))), fst(snd(fst(p)))),
        Module.add(W)(snd(fst(fst(p))), snd(snd(fst(p))))) },
    (Module.zero(V), Module.zero(W)),
    { p ∈ (Module.carrier(V) × Module.carrier(W)) ×
        (Module.carrier(V) × Module.carrier(W)) |
      snd(p) = (Module.neg(V)(fst(fst(p))), Module.neg(W)(snd(fst(p)))) },
    { p ∈ (Ring.carrier(K) ×
        (Module.carrier(V) × Module.carrier(W))) ×
        (Module.carrier(V) × Module.carrier(W)) |
      snd(p) = (Module.smul(V)(fst(fst(p)), fst(snd(fst(p)))),
        Module.smul(W)(fst(fst(p)), snd(snd(fst(p))))) })
def productNorm (V W normV normW : Set) : Set :=
  { p ∈ (Module.carrier(V) × Module.carrier(W)) × ℝ |
    normV(fst(fst(p))) ≤ snd(p) ∧ normW(snd(fst(p))) ≤ snd(p) ∧
    (snd(p) = normV(fst(fst(p))) ∨ snd(p) = normW(snd(fst(p)))) }

-- The real arithmetic of the chain rule.
theorem frechetComp.pos_div (a b : Real)
  requires positiveA : (0:R) < a
  requires positiveB : (0:R) < b
  shows (0:R) < a / b ∧ (a / b) * b = a
proof
  have bne : b ≠ (0:R)
    intro z
    rw z at positiveB
    linarith
  have m := realDiv.mul_right at a, b with bne
  have qR := realDiv.real at a, b
  refine ⟨?_, m⟩
  by_contra np
  have le : a / b ≤ (0:R) by linarith
  have bNn : (0:R) ≤ b by linarith
  have mm := realLe.mul_right_of_nonnegative at a / b, (0:R), b with le, bNn
  rw m at mm
  have z : (0:R) * b = (0:R) by ring
  rw z at mm
  linarith

theorem frechetComp.min3 (a b c : Real)
  requires positiveA : (0:R) < a
  requires positiveB : (0:R) < b
  requires positiveC : (0:R) < c
  shows ∃ d ∈ ℝ, (0:R) < d ∧ d ≤ a ∧ d ≤ b ∧ d ≤ c
proof
  have aIn : a ∈ ℝ by typecheck
  have bIn : b ∈ ℝ by typecheck
  have cIn : c ∈ ℝ by typecheck
  by_cases ab : a ≤ b
  . by_cases ac : a ≤ c
    . have aa : a ≤ a by linarith
      exact ⟨a, aIn, positiveA, aa, ab, ac⟩
    . have cc : c ≤ c by linarith
      have ca : c ≤ a by linarith
      have cb : c ≤ b by linarith
      exact ⟨c, cIn, positiveC, ca, cb, cc⟩
  . by_cases bc : b ≤ c
    . have bb : b ≤ b by linarith
      have ba : b ≤ a by linarith
      exact ⟨b, bIn, positiveB, ba, bb, bc⟩
    . have cc : c ≤ c by linarith
      have ca : c ≤ a by linarith
      have cb : c ≤ b by linarith
      exact ⟨c, cIn, positiveC, ca, cb, cc⟩

theorem frechetComp.arith (T R2 MR D R1 k cM cL e1 e2 hf e : Real)
  requires tri : T ≤ R2 + MR
  requires r2 : R2 ≤ e2 * D
  requires mr : MR ≤ cM * R1
  requires r1 : R1 ≤ e1 * k
  requires dB : D ≤ k + cL * k
  requires e2Def : e2 * (cL + (1:R)) = hf
  requires e1Def : e1 * (cM + (1:R)) = hf
  requires hDef : hf + hf = e
  requires cMNn : (0:R) ≤ cM
  requires e1Nn : (0:R) ≤ e1
  requires e2Nn : (0:R) ≤ e2
  requires kNn : (0:R) ≤ k
  shows T ≤ e * k
proof
  have m1 := realLe.mul_left_of_nonnegative at D, k + cL * k, e2 with dB, e2Nn
  have ex1 : e2 * (k + cL * k) = (e2 * (cL + (1:R))) * k by ring
  rw e2Def at ex1
  have m2 := realLe.mul_left_of_nonnegative at R1, e1 * k, cM with r1, cMNn
  have ek := realMulValue.nonnegative at e1, k with e1Nn, kNn
  have ex2 : cM * (e1 * k) + e1 * k = (e1 * (cM + (1:R))) * k by ring
  rw e1Def at ex2
  have ex3 : hf * k + hf * k = (hf + hf) * k by ring
  rw hDef at ex3
  linarith

-- Section: The derivative
section Derivatives
variable (V K absK normV W normW : Set)
hypothesis normedV : NormedSpace(V, K, absK, normV)
hypothesis normedW : NormedSpace(W, K, absK, normW)
hypothesis nontrivial : NontriviallyNormedField(K, absK)

theorem HasFDerivAt.unique (f L1 L2 x : Set)
  requires first : HasFDerivAt(f, V, normV, W, normW, K, L1, x)
  requires second : HasFDerivAt(f, V, normV, W, normW, K, L2, x)
  shows ∀ h ∈ Module.carrier(V), L1(h) = L2(h)
proof
  exact HasFDerivAt.agree at f, V, normV, W, normW, K, absK, L1, L2, x with nontrivial, normedV, normedW, first, second

theorem fderiv.hasFDerivAt (f x : Set)
  requires differentiable : FDifferentiableAt(f, V, normV, W, normW, K, x)
  shows HasFDerivAt(f, V, normV, W, normW, K, fderiv(f, V, normV, W, normW, K, x), x)
proof
  have normed : ∃ absK2, NontriviallyNormedField(K, absK2) ∧
      NormedSpace(V, K, absK2, normV) ∧ NormedSpace(W, K, absK2, normW)
    exact ⟨absK, nontrivial, normedV, normedW⟩
  have sel := fderiv.selected at f, V, normV, W, normW, K, x with differentiable, normed
  exact sel.right

theorem fderiv.eq (f L x : Set)
  requires derivative : HasFDerivAt(f, V, normV, W, normW, K, L, x)
  requires function : L : Module.carrier(V) → Module.carrier(W)
  shows fderiv(f, V, normV, W, normW, K, x) = L
proof
  have differentiable : FDifferentiableAt(f, V, normV, W, normW, K, x)
    exact ⟨L, derivative⟩
  have normed : ∃ absK2, NontriviallyNormedField(K, absK2) ∧
      NormedSpace(V, K, absK2, normV) ∧ NormedSpace(W, K, absK2, normW)
    exact ⟨absK, nontrivial, normedV, normedW⟩
  have sel := fderiv.selected at f, V, normV, W, normW, K, x with differentiable, normed
  have agree := HasFDerivAt.agree at f, V, normV, W, normW, K, absK, fderiv(f, V, normV, W, normW, K, x), L, x with nontrivial, normedV, normedW, sel.right, derivative
  have fn1 := (functionSpace.mem_iff at fderiv(f, V, normV, W, normW, K, x), Module.carrier(V), Module.carrier(W)).forward with sel.left
  exact FunctionBetween.ext with fn1, function, agree

-- A differentiable map is continuous at the point.
theorem HasFDerivAt.continuous_at (f L x : Set)
  requires derivative : HasFDerivAt(f, V, normV, W, normW, K, L, x)
  shows ContinuousAtPoint(f, spaceTopology(V, normV), spaceTopology(W, normW), x)
proof
  have modV := normedV.right.left
  have modW := normedW.right.left
  have ring := Module.ring at V, K with modV
  have groupV := Module.additive_group at K, V with ring, modV
  have abelianV := Module.additive.abelian_group at V, K with modV
  have abelianW := Module.additive.abelian_group at W, K with modW
  have der := derivative
  obtain ⟨xIn, fxIn, clmL, approx⟩ := der
  have fnL := clmL.left.right.right.left
  have mV := spaceMetric.metric at V, K, absK, normV with normedV
  have mW := spaceMetric.metric at W, K, absK, normW with normedW
  have cNn := opNorm.nonneg at L, V, K, absK, normV, W, normW with normedV, normedW, nontrivial, clmL
  have cIn := (opNorm.bound at L, V, K, absK, normV, W, normW with normedV, normedW, nontrivial, clmL).left
  have cR : Real(opNorm(L, V, normV, normW)) by exact cIn
  unfold ContinuousAtPoint
  rw [spaceTopology.metric_eq, spaceTopology.metric_eq, metricTopology.carrier, spaceMetric.carrier]
  unfold Tendsto
  intros B hB
  have xM : x ∈ MetricSpace.carrier(spaceMetric(V, normV))
    rw spaceMetric.carrier
    exact xIn
  have fxM : f(x) ∈ MetricSpace.carrier(spaceMetric(W, normW))
    rw spaceMetric.carrier
    exact fxIn
  obtain ⟨Bsub, r, rIn, rPos, ballB⟩ := (nhds.metric_iff at spaceMetric(W, normW), f(x), B with mW, fxM).forward with hB
  have rR : Real(r) by exact rIn
  have oneIn : (1:R) ∈ ℝ by typecheck
  obtain ⟨d1, d1In, d1Pos, est⟩ := approx with (1:R), oneIn, realZero.lt_one
  have d1R : Real(d1) by exact d1In
  have c1Pos : (0:R) < opNorm(L, V, normV, normW) + (1:R) by linarith
  have c1Ne : opNorm(L, V, normV, normW) + (1:R) ≠ (0:R)
    intro z
    rw z at c1Pos
    linarith
  have qIn : r / (opNorm(L, V, normV, normW) + (1:R)) ∈ ℝ by typecheck
  have qR : Real(r / (opNorm(L, V, normV, normW) + (1:R))) by exact qIn
  have qMul := realDiv.mul_right at r, opNorm(L, V, normV, normW) + (1:R) with c1Ne
  have qPos : (0:R) < r / (opNorm(L, V, normV, normW) + (1:R))
    by_contra np
    have le : r / (opNorm(L, V, normV, normW) + (1:R)) ≤ (0:R) by linarith
    have c1Nn : (0:R) ≤ opNorm(L, V, normV, normW) + (1:R) by linarith
    have m := realLe.mul_right_of_nonnegative at r / (opNorm(L, V, normV, normW) + (1:R)), (0:R), opNorm(L, V, normV, normW) + (1:R) with le, c1Nn
    rw qMul at m
    have z : (0:R) * (opNorm(L, V, normV, normW) + (1:R)) = (0:R) by ring
    rw z at m
    linarith
  have dmin : ∃ d ∈ ℝ, (0:R) < d ∧ d ≤ d1 ∧ d ≤ r / (opNorm(L, V, normV, normW) + (1:R))
    by_cases le12 : d1 ≤ r / (opNorm(L, V, normV, normW) + (1:R))
    . have self1 : d1 ≤ d1 by linarith
      exact ⟨d1, d1In, d1Pos, self1, le12⟩
    . have le21 : r / (opNorm(L, V, normV, normW) + (1:R)) ≤ d1 by linarith
      have self2 : r / (opNorm(L, V, normV, normW) + (1:R)) ≤ r / (opNorm(L, V, normV, normW) + (1:R)) by linarith
      exact ⟨r / (opNorm(L, V, normV, normW) + (1:R)), qIn, qPos, le21, self2⟩
  obtain ⟨d, dIn, dPos, dle1, dleq⟩ := dmin
  have dR : Real(d) by exact dIn
  apply (nhds.metric_iff at spaceMetric(V, normV), x, functionPreimage(f, Module.carrier(V), B) with mV, xM).backward
  refine ⟨?_, d, dIn, dPos, ?_⟩
  . rw spaceMetric.carrier
    exact functionPreimage.subset at f, Module.carrier(V), B
  intros y hy
  have ySub := ball_subset at spaceMetric(V, normV), x, d with mV, xM
  have yM := ySub with y, hy
  have yIn : y ∈ Module.carrier(V)
    rw spaceMetric.carrier at yM
    exact yM
  have lt := (mem_ball at spaceMetric(V, normV), x, y, d with mV, xM, yM).forward with hy
  rw (spaceMetric.dist at V, K, absK, normV, x, y with normedV, xIn, yIn) at lt
  have ny := Module.neg_mem at K, V, y with ring, modV, yIn
  have nx := Module.neg_mem at K, V, x with ring, modV, xIn
  have hIn := Module.add_mem at K, V, y, Module.neg(V)(x) with ring, modV, yIn, nx
  have xA : x ∈ Group.carrier(Module.additive(V))
    rw Module.additive.carrier
    exact xIn
  have yA : y ∈ Group.carrier(Module.additive(V))
    rw Module.additive.carrier
    exact yIn
  have rev := IsNorm.sub_rev at Module.additive(V), normV, x, y with normedV.right.right.left, xA, yA
  rw [Module.additive.mul, Module.additive.inv] at rev
  rw rev at lt
  have ixA := Group.inv_mem at Module.additive(V), x with groupV, xA
  have c1 := mul_comm at Module.additive(V), y, Group.inv(Module.additive(V))(x) with abelianV, yA, ixA
  have c2 := mul_inv_cancel_left at Module.additive(V), x, y with groupV, xA, yA
  rw ← c1 at c2
  rw [Module.additive.mul, Module.additive.inv] at c2
  obtain ⟨nhIn, nhNn⟩ := NormedSpace.norm_real at V, K, absK, normV, Module.add(V)(y, Module.neg(V)(x)) with normedV, hIn
  have nhR : Real(normV(Module.add(V)(y, Module.neg(V)(x)))) by exact nhIn
  have s1 : normV(Module.add(V)(y, Module.neg(V)(x))) < d1 by linarith
  obtain ⟨fyIn, b1⟩ := est with Module.add(V)(y, Module.neg(V)(x)), hIn, s1
  rw c2 at fyIn
  rw c2 at b1
  have b2 := opNorm.le at L, V, K, absK, normV, W, normW, Module.add(V)(y, Module.neg(V)(x)) with normedV, normedW, nontrivial, clmL, hIn
  have Lh := FunctionBetween.apply_closed with fnL, hIn
  have fyA : f(y) ∈ Group.carrier(Module.additive(W))
    rw Module.additive.carrier
    exact fyIn
  have fxA : f(x) ∈ Group.carrier(Module.additive(W))
    rw Module.additive.carrier
    exact fxIn
  have LhA : L(Module.add(V)(y, Module.neg(V)(x))) ∈ Group.carrier(Module.additive(W))
    rw Module.additive.carrier
    exact Lh
  have split := AbelianGroup.sub_split at Module.additive(W), f(y), f(x), L(Module.add(V)(y, Module.neg(V)(x))) with abelianW, fyA, fxA, LhA
  rw [Module.additive.mul, Module.additive.inv] at split
  have s := Module.add_mem at K, W, f(x), L(Module.add(V)(y, Module.neg(V)(x))) with ring, modW, fxIn, Lh
  have ns := Module.neg_mem at K, W, Module.add(W)(f(x), L(Module.add(V)(y, Module.neg(V)(x)))) with ring, modW, s
  have A := Module.add_mem at K, W, f(y), Module.neg(W)(Module.add(W)(f(x), L(Module.add(V)(y, Module.neg(V)(x))))) with ring, modW, fyIn, ns
  have tri := NormedSpace.norm_add_le at W, K, absK, normW, Module.add(W)(f(y), Module.neg(W)(Module.add(W)(f(x), L(Module.add(V)(y, Module.neg(V)(x)))))), L(Module.add(V)(y, Module.neg(V)(x))) with normedW, A, Lh
  rw ← split at tri
  have AR : Real(normW(Module.add(W)(f(y), Module.neg(W)(Module.add(W)(f(x), L(Module.add(V)(y, Module.neg(V)(x)))))))) by exact (NormedSpace.norm_real at W, K, absK, normW, Module.add(W)(f(y), Module.neg(W)(Module.add(W)(f(x), L(Module.add(V)(y, Module.neg(V)(x)))))) with normedW, A).left
  have LR : Real(normW(L(Module.add(V)(y, Module.neg(V)(x))))) by exact (NormedSpace.norm_real at W, K, absK, normW, L(Module.add(V)(y, Module.neg(V)(x))) with normedW, Lh).left
  have nfx := Module.neg_mem at K, W, f(x) with ring, modW, fxIn
  have D := Module.add_mem at K, W, f(y), Module.neg(W)(f(x)) with ring, modW, fyIn, nfx
  have DR : Real(normW(Module.add(W)(f(y), Module.neg(W)(f(x))))) by exact (NormedSpace.norm_real at W, K, absK, normW, Module.add(W)(f(y), Module.neg(W)(f(x))) with normedW, D).left
  have hq : normV(Module.add(V)(y, Module.neg(V)(x))) < r / (opNorm(L, V, normV, normW) + (1:R)) by linarith
  have m := realLess.mul_left_of_positive at normV(Module.add(V)(y, Module.neg(V)(x))), r / (opNorm(L, V, normV, normW) + (1:R)), opNorm(L, V, normV, normW) + (1:R) with hq, c1Pos
  have ex : (opNorm(L, V, normV, normW) + (1:R)) * (r / (opNorm(L, V, normV, normW) + (1:R))) = r / (opNorm(L, V, normV, normW) + (1:R)) * (opNorm(L, V, normV, normW) + (1:R)) by ring
  rw [ex, qMul] at m
  have ex2 : (opNorm(L, V, normV, normW) + (1:R)) * normV(Module.add(V)(y, Module.neg(V)(x))) = opNorm(L, V, normV, normW) * normV(Module.add(V)(y, Module.neg(V)(x))) + (1:R) * normV(Module.add(V)(y, Module.neg(V)(x))) by ring
  rw ex2 at m
  have close : normW(Module.add(W)(f(y), Module.neg(W)(f(x)))) < r by linarith
  have fyM : f(y) ∈ MetricSpace.carrier(spaceMetric(W, normW))
    rw spaceMetric.carrier
    exact fyIn
  have dW := spaceMetric.dist at W, K, absK, normW, f(x), f(y) with normedW, fxIn, fyIn
  have rev2 := IsNorm.sub_rev at Module.additive(W), normW, f(x), f(y) with normedW.right.right.left, fxA, fyA
  rw [Module.additive.mul, Module.additive.inv] at rev2
  rw rev2 at dW
  have dlt : MetricSpace.dist(spaceMetric(W, normW))(f(x), f(y)) < r
    rw dW
    exact close
  have inBall := (mem_ball at spaceMetric(W, normW), f(x), f(y), r with mW, fxM, fyM).backward with dlt
  exact functionPreimage.of_apply with yIn, (ballB with f(y), inBall)

-- Only the values near x matter.
theorem HasFDerivAt.congr (f g L x : Set, r : Real)
  requires derivative : HasFDerivAt(f, V, normV, W, normW, K, L, x)
  requires positive : realZero < r
  requires agree : ∀ y ∈ ball(spaceMetric(V, normV), x, r), f(y) = g(y)
  shows HasFDerivAt(g, V, normV, W, normW, K, L, x)
proof
  have modV := normedV.right.left
  have ring := Module.ring at V, K with modV
  have der := derivative
  obtain ⟨xIn, fxIn, clmL, approx⟩ := der
  have abelian := Module.additive.abelian_group at V, K with modV
  have group := AbelianGroup.to_group with abelian
  have xA : x ∈ Group.carrier(Module.additive(V))
    rw Module.additive.carrier
    exact xIn
  have inBall : ∀ h ∈ Module.carrier(V), normV(h) < r →
      g(Module.add(V)(x, h)) = f(Module.add(V)(x, h))
    intros h hIn small
    have hA : h ∈ Group.carrier(Module.additive(V))
      rw Module.additive.carrier
      exact hIn
    have xh := Module.add_mem at K, V, x, h with ring, modV, xIn, hIn
    have xhA : Module.add(V)(x, h) ∈ Group.carrier(Module.additive(V))
      rw Module.additive.carrier
      exact xh
    have dist := spaceMetric.dist at V, K, absK, normV, x, Module.add(V)(x, h) with normedV, xIn, xh
    have rev := IsNorm.sub_rev at Module.additive(V), normV, x, Module.add(V)(x, h) with normedV.right.right.left, xA, xhA
    rw [Module.additive.mul, Module.additive.inv] at rev
    have c1 := mul_right_comm at Module.additive(V), x, h, Group.inv(Module.additive(V))(x) with abelian, xA, hA, (Group.inv_mem at Module.additive(V), x with group, xA)
    have c2 := Group.mul_inv at Module.additive(V), x with group, xA
    have c3 := one_mul at Module.additive(V), h with group, hA
    rw [c2, c3] at c1
    rw [Module.additive.mul, Module.additive.inv] at c1
    rw [rev, c1] at dist
    have near : MetricSpace.dist(spaceMetric(V, normV))(x, Module.add(V)(x, h)) < r
      rw dist
      exact small
    have xhM : Module.add(V)(x, h) ∈ MetricSpace.carrier(spaceMetric(V, normV))
      rw spaceMetric.carrier
      exact xh
    have mem := ball.of_distance with xhM, near
    rw ← ball.parts at mem
    have ag := agree with Module.add(V)(x, h), mem
    rw ag
  have zeroV := Module.zero_mem at K, V with ring, modV
  have nz := (NormedSpace.norm_eq_zero at V, K, absK, normV, Module.zero(V) with normedV, zeroV).backward with rfl
  have z0 : normV(Module.zero(V)) < r
    rw nz
    exact positive
  have gx := inBall with Module.zero(V), zeroV, z0
  have a0 := Module.add_zero at K, V, x with ring, modV, xIn
  rw a0 at gx
  unfold HasFDerivAt
  refine ⟨xIn, ?_, clmL, ?_⟩
  . rw gx
    exact fxIn
  intros e eIn ePos
  obtain ⟨d0, d0In, d0Pos, est⟩ := approx with e, eIn, ePos
  have d0R : Real(d0) by exact d0In
  have rIn : r ∈ ℝ by typecheck
  have dmin : ∃ d ∈ ℝ, (0:R) < d ∧ d ≤ d0 ∧ d ≤ r
    by_cases le12 : d0 ≤ r
    . have self1 : d0 ≤ d0 by linarith
      exact ⟨d0, d0In, d0Pos, self1, le12⟩
    . have le21 : r ≤ d0 by linarith
      have self2 : r ≤ r by linarith
      exact ⟨r, rIn, positive, le21, self2⟩
  obtain ⟨d, dIn, dPos, dle0, dler⟩ := dmin
  have dR : Real(d) by exact dIn
  refine ⟨d, dIn, dPos, ?_⟩
  intros h hIn small
  have nhR : Real(normV(h)) by exact (NormedSpace.norm_real at V, K, absK, normV, h with normedV, hIn).left
  have s0 : normV(h) < d0 by linarith
  have sr : normV(h) < r by linarith
  have e1 := inBall with h, hIn, sr
  rw [e1, gx]
  exact est with h, hIn, s0

-- Mathlib's hasFDerivAt_const, hasFDerivAt_id, and
-- ContinuousLinearMap.hasFDerivAt.
theorem HasFDerivAt.const (f c x Z : Set)
  requires member : x ∈ Module.carrier(V)
  requires value : c ∈ Module.carrier(W)
  requires constant : ∀ y ∈ Module.carrier(V), f(y) = c
  requires function : Z : Module.carrier(V) → Module.carrier(W)
  requires zero : ∀ v ∈ Module.carrier(V), Z(v) = Module.zero(W)
  shows HasFDerivAt(f, V, normV, W, normW, K, Z, x)
proof
  have modV := normedV.right.left
  have modW := normedW.right.left
  have ring := Module.ring at V, K with modV
  have zeroW := Module.zero_mem at K, W with ring, modW
  have zeroNorm := (NormedSpace.norm_eq_zero at W, K, absK, normW, Module.zero(W) with normedW, zeroW).backward with rfl
  have linZ : IsLinearMap(Z, V, W, K)
    unfold IsLinearMap
    refine ⟨modV, modW, function, ?_, ?_⟩
    . intros v hv w hw
      have vw := Module.add_mem at K, V, v, w with ring, modV, hv, hw
      rw [(zero with Module.add(V)(v, w), vw), (zero with v, hv), (zero with w, hw)]
      have a := Module.add_zero at K, W, Module.zero(W) with ring, modW, zeroW
      rw a
    . intros a ha v hv
      have av := Module.smul_mem at K, V, a, v with ring, modV, ha, hv
      rw [(zero with Module.smul(V)(a, v), av), (zero with v, hv)]
      have s := smul_zero at K, W, a with ring, modW, ha
      rw s
  have clmZ : ContinuousLinearMap(Z, V, normV, W, normW, K)
    apply (IsLinearMap.continuous_iff_small at Z, V, K, absK, normV, W, normW with normedV, normedW, linZ).backward
    unfold SmallToSmall
    intros e eIn ePos
    have oneIn : (1:R) ∈ ℝ by typecheck
    refine ⟨(1:R), oneIn, realZero.lt_one, ?_⟩
    intros v hv small
    rw [(zero with v, hv), zeroNorm]
    exact ePos
  have fx := constant with x, member
  unfold HasFDerivAt
  refine ⟨member, ?_, clmZ, ?_⟩
  . rw fx
    exact value
  intros e eIn ePos
  have oneIn : (1:R) ∈ ℝ by typecheck
  refine ⟨(1:R), oneIn, realZero.lt_one, ?_⟩
  intros h hIn small
  have xh := Module.add_mem at K, V, x, h with ring, modV, member, hIn
  have fxh := constant with Module.add(V)(x, h), xh
  rw [fxh, fx, (zero with h, hIn)]
  refine ⟨value, ?_⟩
  have a := Module.add_zero at K, W, c with ring, modW, value
  rw a
  have groupW := Module.additive_group at K, W with ring, modW
  have cA : c ∈ Group.carrier(Module.additive(W))
    rw Module.additive.carrier
    exact value
  have mi := Group.mul_inv at Module.additive(W), c with groupW, cA
  rw [Module.additive.mul, Module.additive.inv, Module.additive.one] at mi
  rw [mi, zeroNorm]
  obtain ⟨nhIn, nhNn⟩ := NormedSpace.norm_real at V, K, absK, normV, h with normedV, hIn
  have nhR : Real(normV(h)) by exact nhIn
  have eR : Real(e) by exact eIn
  have eNn : (0:R) ≤ e by linarith
  have p := realLe.mul_left_of_nonnegative at (0:R), normV(h), e with nhNn, eNn
  have z : e * (0:R) = (0:R) by ring
  rw z at p
  exact p

theorem HasFDerivAt.linear (L x : Set)
  requires continuous : ContinuousLinearMap(L, V, normV, W, normW, K)
  requires member : x ∈ Module.carrier(V)
  shows HasFDerivAt(L, V, normV, W, normW, K, L, x)
proof
  have clm := continuous
  obtain ⟨lin, cont⟩ := clm
  have lin2 := lin
  obtain ⟨modV, modW, fn, addLaw, smulLaw⟩ := lin2
  have nW := normedW
  obtain ⟨nfW, modW2, ngW, lawW⟩ := nW
  have nV := normedV
  obtain ⟨nfV, modV2, ngV, lawV⟩ := nV
  have ring := nfV.right.right.left.left
  have groupW := Module.additive_group at K, W with ring, modW
  have zeroNorm := IsNorm.zero at Module.additive(W), normW with ngW
  rw Module.additive.one at zeroNorm
  have LxIn := FunctionBetween.apply_closed with fn, member
  unfold HasFDerivAt
  refine ⟨member, LxIn, continuous, ?_⟩
  intros e eIn ePos
  have oneIn : (1:R) ∈ ℝ by typecheck
  refine ⟨(1:R), oneIn, realZero.lt_one, ?_⟩
  intros h hIn small
  have xh := Module.add_mem at K, V, x, h with *
  have LxhIn := FunctionBetween.apply_closed with fn, xh
  refine ⟨LxhIn, ?_⟩
  have add := addLaw with x, member, h, hIn
  rw add
  have LhIn := FunctionBetween.apply_closed with fn, hIn
  have sumIn := Module.add_mem at K, W, L(x), L(h) with *
  have c := Group.mul_inv at Module.additive(W), Module.add(W)(L(x), L(h)) with groupW, *
  module_additive at c
  rw [c, zeroNorm]
  have hA : h ∈ Group.carrier(Module.additive(V))
    rw Module.additive.carrier
    exact hIn
  have nh := IsNorm.nonneg at Module.additive(V), normV, h with ngV, hA
  have nhR := (realLe.reals with nh).right
  have nhRR : Real(normV(h)) by exact nhR
  have eRR : Real(e) by exact eIn
  have eNn : (0:R) ≤ e by linarith
  have p := realLe.mul_left_of_nonnegative at (0:R), normV(h), e with nh, eNn
  have z : e * (0:R) = (0:R) by ring
  rw z at p
  exact p

-- Mathlib's hasFDerivAt_comp_add_left: the derivative of y ↦ f(a + y) at
-- x is the derivative of f at a + x.
theorem HasFDerivAt.comp_add_left (f g L a x : Set)
  requires memberA : a ∈ Module.carrier(V)
  requires point : x ∈ Module.carrier(V)
  requires translate : ∀ y ∈ Module.carrier(V), g(y) = f(Module.add(V)(a, y))
  requires derivative : HasFDerivAt(f, V, normV, W, normW, K, L, Module.add(V)(a, x))
  shows HasFDerivAt(g, V, normV, W, normW, K, L, x)
proof
  have modV := normedV.right.left
  have ring := Module.ring at V, K with modV
  have der := derivative
  obtain ⟨axIn, faxIn, clmL, approx⟩ := der
  have gx := translate with x, point
  unfold HasFDerivAt
  refine ⟨point, ?_, clmL, ?_⟩
  . rw gx
    exact faxIn
  intros e eIn ePos
  obtain ⟨d, dIn, dPos, est⟩ := approx with e, eIn, ePos
  refine ⟨d, dIn, dPos, ?_⟩
  intros h hIn small
  have xh := Module.add_mem at K, V, x, h with ring, modV, point, hIn
  have gxh := translate with Module.add(V)(x, h), xh
  have assoc := Module.add_assoc at K, V, a, x, h with ring, modV, memberA, point, hIn
  rw ← assoc at gxh
  rw [gxh, gx]
  exact est with h, hIn, small

theorem HasFDerivAt.add (f g h L M N x : Set)
  requires first : HasFDerivAt(f, V, normV, W, normW, K, L, x)
  requires second : HasFDerivAt(g, V, normV, W, normW, K, M, x)
  requires sum : ∀ y ∈ Module.carrier(V), h(y) = Module.add(W)(f(y), g(y))
  requires sumL : ∀ v ∈ Module.carrier(V), N(v) = Module.add(W)(L(v), M(v))
  requires function : N : Module.carrier(V) → Module.carrier(W)
  shows HasFDerivAt(h, V, normV, W, normW, K, N, x)
proof
  have modV := normedV.right.left
  have modW := normedW.right.left
  have ring := Module.ring at V, K with modV
  have d1 := first
  obtain ⟨xIn, fxIn, clmL, approx1⟩ := d1
  have d2 := second
  obtain ⟨xIn2, gxIn, clmM, approx2⟩ := d2
  have both := opNorm.add_le at L, M, N, V, K, absK, normV, W, normW with normedV, normedW, nontrivial, clmL, clmM, sumL, function
  have clmN := both.left
  have hx := sum with x, xIn
  have hxIn : h(x) ∈ Module.carrier(W)
    rw hx
    exact Module.add_mem at K, W, f(x), g(x) with ring, modW, fxIn, gxIn
  unfold HasFDerivAt
  refine ⟨xIn, hxIn, clmN, ?_⟩
  intros e eIn ePos
  have eR : Real(e) by exact eIn
  have hPos := half.positive with ePos
  have hR := half.real at e
  have hIn : half(e) ∈ ℝ by exact hR
  have hsum := half.add_self at e
  obtain ⟨da, daIn, daPos, est1⟩ := approx1 with half(e), hIn, hPos
  obtain ⟨db, dbIn, dbPos, est2⟩ := approx2 with half(e), hIn, hPos
  have daR : Real(da) by exact daIn
  have dbR : Real(db) by exact dbIn
  have dmin : ∃ d ∈ ℝ, (0:R) < d ∧ d ≤ da ∧ d ≤ db
    by_cases le12 : da ≤ db
    . have self1 : da ≤ da by linarith
      exact ⟨da, daIn, daPos, self1, le12⟩
    . have le21 : db ≤ da by linarith
      have self2 : db ≤ db by linarith
      exact ⟨db, dbIn, dbPos, le21, self2⟩
  obtain ⟨d, dIn, dPos, dle1, dle2⟩ := dmin
  have dR : Real(d) by exact dIn
  refine ⟨d, dIn, dPos, ?_⟩
  intros k kIn small
  obtain ⟨nkIn, nkNn⟩ := NormedSpace.norm_real at V, K, absK, normV, k with normedV, kIn
  have nkR : Real(normV(k)) by exact nkIn
  have s1 : normV(k) < da by linarith
  have s2 : normV(k) < db by linarith
  obtain ⟨fxk, b1⟩ := est1 with k, kIn, s1
  obtain ⟨gxk, b2⟩ := est2 with k, kIn, s2
  have xk := Module.add_mem at K, V, x, k with ring, modV, xIn, kIn
  have Lk := FunctionBetween.apply_closed with clmL.left.right.right.left, kIn
  have Mk := FunctionBetween.apply_closed with clmM.left.right.right.left, kIn
  rw [(sum with Module.add(V)(x, k), xk), hx, (sumL with k, kIn)]
  refine ⟨(Module.add_mem at K, W, f(Module.add(V)(x, k)), g(Module.add(V)(x, k)) with ring, modW, fxk, gxk), ?_⟩
  have r1 := Module.add_add_add_swap at W, K, f(x), g(x), L(k), M(k) with modW, fxIn, gxIn, Lk, Mk
  rw r1
  have P := Module.add_mem at K, W, f(x), L(k) with ring, modW, fxIn, Lk
  have Q := Module.add_mem at K, W, g(x), M(k) with ring, modW, gxIn, Mk
  have r2 := Module.neg_add_split at W, K, Module.add(W)(f(x), L(k)), Module.add(W)(g(x), M(k)) with modW, P, Q
  rw r2
  have nP := Module.neg_mem at K, W, Module.add(W)(f(x), L(k)) with ring, modW, P
  have nQ := Module.neg_mem at K, W, Module.add(W)(g(x), M(k)) with ring, modW, Q
  have r3 := Module.add_add_add_swap at W, K, f(Module.add(V)(x, k)), g(Module.add(V)(x, k)), Module.neg(W)(Module.add(W)(f(x), L(k))), Module.neg(W)(Module.add(W)(g(x), M(k))) with modW, fxk, gxk, nP, nQ
  rw r3
  have A := Module.add_mem at K, W, f(Module.add(V)(x, k)), Module.neg(W)(Module.add(W)(f(x), L(k))) with ring, modW, fxk, nP
  have B := Module.add_mem at K, W, g(Module.add(V)(x, k)), Module.neg(W)(Module.add(W)(g(x), M(k))) with ring, modW, gxk, nQ
  have t := NormedSpace.norm_add_le at W, K, absK, normW, Module.add(W)(f(Module.add(V)(x, k)), Module.neg(W)(Module.add(W)(f(x), L(k)))), Module.add(W)(g(Module.add(V)(x, k)), Module.neg(W)(Module.add(W)(g(x), M(k)))) with normedW, A, B
  have AR : Real(normW(Module.add(W)(f(Module.add(V)(x, k)), Module.neg(W)(Module.add(W)(f(x), L(k)))))) by exact (NormedSpace.norm_real at W, K, absK, normW, Module.add(W)(f(Module.add(V)(x, k)), Module.neg(W)(Module.add(W)(f(x), L(k)))) with normedW, A).left
  have BR : Real(normW(Module.add(W)(g(Module.add(V)(x, k)), Module.neg(W)(Module.add(W)(g(x), M(k)))))) by exact (NormedSpace.norm_real at W, K, absK, normW, Module.add(W)(g(Module.add(V)(x, k)), Module.neg(W)(Module.add(W)(g(x), M(k)))) with normedW, B).left
  have AB := Module.add_mem at K, W, Module.add(W)(f(Module.add(V)(x, k)), Module.neg(W)(Module.add(W)(f(x), L(k)))), Module.add(W)(g(Module.add(V)(x, k)), Module.neg(W)(Module.add(W)(g(x), M(k)))) with ring, modW, A, B
  have ABR : Real(normW(Module.add(W)(Module.add(W)(f(Module.add(V)(x, k)), Module.neg(W)(Module.add(W)(f(x), L(k)))), Module.add(W)(g(Module.add(V)(x, k)), Module.neg(W)(Module.add(W)(g(x), M(k))))))) by exact (NormedSpace.norm_real at W, K, absK, normW, Module.add(W)(Module.add(W)(f(Module.add(V)(x, k)), Module.neg(W)(Module.add(W)(f(x), L(k)))), Module.add(W)(g(Module.add(V)(x, k)), Module.neg(W)(Module.add(W)(g(x), M(k))))) with normedW, AB).left
  have ex0 : (half(e) + half(e)) * normV(k) = half(e) * normV(k) + half(e) * normV(k) by ring
  rw hsum at ex0
  linarith

theorem HasFDerivAt.smul_const (f h L N c x : Set)
  requires commutative : CommRing(K)
  requires derivative : HasFDerivAt(f, V, normV, W, normW, K, L, x)
  requires scalar : c ∈ Ring.carrier(K)
  requires scaled : ∀ y ∈ Module.carrier(V), h(y) = Module.smul(W)(c, f(y))
  requires scaledL : ∀ v ∈ Module.carrier(V), N(v) = Module.smul(W)(c, L(v))
  requires function : N : Module.carrier(V) → Module.carrier(W)
  shows HasFDerivAt(h, V, normV, W, normW, K, N, x)
proof
  have modV := normedV.right.left
  have nW := normedW
  obtain ⟨nfW, modW, ngW, lawW⟩ := nW
  have ring := Module.ring at V, K with modV
  have der := derivative
  obtain ⟨xIn, fxIn, clmL, approx⟩ := der
  have both := opNorm.smul at L, N, c, V, K, absK, normV, W, normW with normedV, normedW, nontrivial, commutative, clmL, scalar, function, scaledL
  have clmN := both.left
  obtain ⟨cIn, cNn⟩ := NormedField.norm_real at K, absK, c with nfW, scalar
  have cR : Real(absK(c)) by exact cIn
  have hx := scaled with x, xIn
  have hxIn : h(x) ∈ Module.carrier(W)
    rw hx
    exact Module.smul_mem at K, W, c, f(x) with ring, modW, scalar, fxIn
  unfold HasFDerivAt
  refine ⟨xIn, hxIn, clmN, ?_⟩
  intros e eIn ePos
  have eR : Real(e) by exact eIn
  have c1Pos : (0:R) < absK(c) + (1:R) by linarith
  have c1Ne : absK(c) + (1:R) ≠ (0:R)
    intro z
    rw z at c1Pos
    linarith
  have e1In : e / (absK(c) + (1:R)) ∈ ℝ by typecheck
  have e1R : Real(e / (absK(c) + (1:R))) by exact e1In
  have e1Mul := realDiv.mul_right at e, absK(c) + (1:R) with c1Ne
  have e1Pos : (0:R) < e / (absK(c) + (1:R))
    by_contra np
    have le : e / (absK(c) + (1:R)) ≤ (0:R) by linarith
    have c1Nn : (0:R) ≤ absK(c) + (1:R) by linarith
    have m := realLe.mul_right_of_nonnegative at e / (absK(c) + (1:R)), (0:R), absK(c) + (1:R) with le, c1Nn
    rw e1Mul at m
    have z : (0:R) * (absK(c) + (1:R)) = (0:R) by ring
    rw z at m
    linarith
  obtain ⟨d, dIn, dPos, est⟩ := approx with e / (absK(c) + (1:R)), e1In, e1Pos
  refine ⟨d, dIn, dPos, ?_⟩
  intros k kIn small
  obtain ⟨fxk, bound⟩ := est with k, kIn, small
  have xk := Module.add_mem at K, V, x, k with ring, modV, xIn, kIn
  have hxk := scaled with Module.add(V)(x, k), xk
  have Lk := FunctionBetween.apply_closed with clmL.left.right.right.left, kIn
  rw [hxk, hx, (scaledL with k, kIn)]
  refine ⟨(Module.smul_mem at K, W, c, f(Module.add(V)(x, k)) with ring, modW, scalar, fxk), ?_⟩
  have s1 := smul_add at K, W, c, f(x), L(k) with ring, modW, scalar, fxIn, Lk
  rw ← s1
  have inner := Module.add_mem at K, W, f(x), L(k) with ring, modW, fxIn, Lk
  have s2 := Module.smul_sub at W, K, c, f(Module.add(V)(x, k)), Module.add(W)(f(x), L(k)) with modW, scalar, fxk, inner
  rw ← s2
  have ni := Module.neg_mem at K, W, Module.add(W)(f(x), L(k)) with ring, modW, inner
  have diff := Module.add_mem at K, W, f(Module.add(V)(x, k)), Module.neg(W)(Module.add(W)(f(x), L(k))) with ring, modW, fxk, ni
  rw (lawW with c, scalar, Module.add(W)(f(Module.add(V)(x, k)), Module.neg(W)(Module.add(W)(f(x), L(k)))), diff)
  obtain ⟨dIn2, dNn⟩ := NormedSpace.norm_real at W, K, absK, normW, Module.add(W)(f(Module.add(V)(x, k)), Module.neg(W)(Module.add(W)(f(x), L(k)))) with normedW, diff
  have dR : Real(normW(Module.add(W)(f(Module.add(V)(x, k)), Module.neg(W)(Module.add(W)(f(x), L(k)))))) by exact dIn2
  obtain ⟨nkIn, nkNn⟩ := NormedSpace.norm_real at V, K, absK, normV, k with normedV, kIn
  have nkR : Real(normV(k)) by exact nkIn
  have m := realLe.mul_left_of_nonnegative at normW(Module.add(W)(f(Module.add(V)(x, k)), Module.neg(W)(Module.add(W)(f(x), L(k))))), e / (absK(c) + (1:R)) * normV(k), absK(c) with bound, cNn
  have ex : e / (absK(c) + (1:R)) * (absK(c) + (1:R)) = absK(c) * (e / (absK(c) + (1:R))) + e / (absK(c) + (1:R)) by ring
  rw e1Mul at ex
  have ce : absK(c) * (e / (absK(c) + (1:R))) ≤ e by linarith
  have nkNn2 : (0:R) ≤ normV(k) by linarith
  have m2 := realLe.mul_right_of_nonnegative at absK(c) * (e / (absK(c) + (1:R))), e, normV(k) with ce, nkNn2
  have re : absK(c) * (e / (absK(c) + (1:R)) * normV(k)) = absK(c) * (e / (absK(c) + (1:R))) * normV(k) by ring
  rw re at m
  linarith

-- The product rule for scalar-valued maps: d(f g) = f(x) dg + g(x) df.
theorem HasFDerivAt.mul (f g h L M N x : Set)
  requires commutative : CommRing(K)
  requires first : HasFDerivAt(f, V, normV, selfModule(K), absK, K, L, x)
  requires second : HasFDerivAt(g, V, normV, selfModule(K), absK, K, M, x)
  requires product : ∀ y ∈ Module.carrier(V), h(y) = Ring.mul(K)(f(y), g(y))
  requires productL : ∀ v ∈ Module.carrier(V),
    N(v) = Ring.add(K)(Ring.mul(K)(f(x), M(v)), Ring.mul(K)(g(x), L(v)))
  requires function : N : Module.carrier(V) → Ring.carrier(K)
  shows HasFDerivAt(h, V, normV, selfModule(K), absK, K, N, x)
proof
  sorry

-- Mathlib's hasFDerivAt_prodMk_right: y ↦ (a, y) into V × W has
-- derivative w ↦ (0, w), and a map into a product is differentiable when
-- both coordinates are.
theorem HasFDerivAt.prod_mk_right (a h N y : Set)
  requires memberA : a ∈ Module.carrier(V)
  requires pair : ∀ w ∈ Module.carrier(W), h(w) = (a, w)
  requires pairL : ∀ w ∈ Module.carrier(W), N(w) = (Module.zero(V), w)
  requires function : N : Module.carrier(W) → Module.carrier(V) × Module.carrier(W)
  requires member : y ∈ Module.carrier(W)
  shows HasFDerivAt(h, W, normW, productModule(K, V, W), productNorm(V, W, normV, normW),
    K, N, y)
proof
  sorry

theorem HasFDerivAt.prod (U normU f g h L M N x : Set)
  requires normedU : NormedSpace(U, K, absK, normU)
  requires first : HasFDerivAt(f, U, normU, V, normV, K, L, x)
  requires second : HasFDerivAt(g, U, normU, W, normW, K, M, x)
  requires pair : ∀ y ∈ Module.carrier(U), h(y) = (f(y), g(y))
  requires pairL : ∀ u ∈ Module.carrier(U), N(u) = (L(u), M(u))
  requires function : N : Module.carrier(U) → Module.carrier(V) × Module.carrier(W)
  shows HasFDerivAt(h, U, normU, productModule(K, V, W), productNorm(V, W, normV, normW),
    K, N, x)
proof
  sorry

theorem productModule.normed
  shows NormedSpace(productModule(K, V, W), K, absK, productNorm(V, W, normV, normW))
proof
  sorry

-- The chain rule (Mathlib's HasFDerivAt.comp).
theorem HasFDerivAt.comp (U normU f g h L M N x : Set)
  requires normedU : NormedSpace(U, K, absK, normU)
  requires inner : HasFDerivAt(f, U, normU, V, normV, K, L, x)
  requires outer : HasFDerivAt(g, V, normV, W, normW, K, M, f(x))
  requires composite : ∀ y ∈ Module.carrier(U), h(y) = g(f(y))
  requires compositeL : ∀ u ∈ Module.carrier(U), N(u) = M(L(u))
  requires function : N : Module.carrier(U) → Module.carrier(W)
  shows HasFDerivAt(h, U, normU, W, normW, K, N, x)
proof
  have modU := normedU.right.left
  have modV := normedV.right.left
  have modW := normedW.right.left
  have ring := Module.ring at V, K with modV
  have d1 := inner
  obtain ⟨xIn, fxIn, clmL, approx1⟩ := d1
  have d2 := outer
  obtain ⟨fxIn2, gfxIn, clmM, approx2⟩ := d2
  have clmN := ContinuousLinearMap.comp with clmL, clmM, function, compositeL
  have linM := clmM.left
  obtain ⟨_, _, fnM, addM, smulM⟩ := linM
  have fnL := clmL.left.right.right.left
  have cLNn := opNorm.nonneg at L, U, K, absK, normU, V, normV with normedU, normedV, nontrivial, clmL
  have cLIn := (opNorm.bound at L, U, K, absK, normU, V, normV with normedU, normedV, nontrivial, clmL).left
  have cMNn := opNorm.nonneg at M, V, K, absK, normV, W, normW with normedV, normedW, nontrivial, clmM
  have cMIn := (opNorm.bound at M, V, K, absK, normV, W, normW with normedV, normedW, nontrivial, clmM).left
  have cLEx : ∃ cL, cL = opNorm(L, U, normU, normV)
    exact ⟨opNorm(L, U, normU, normV), rfl⟩
  obtain ⟨cL, cLEq⟩ := cLEx
  have cMEx : ∃ cM, cM = opNorm(M, V, normV, normW)
    exact ⟨opNorm(M, V, normV, normW), rfl⟩
  obtain ⟨cM, cMEq⟩ := cMEx
  rw ← cLEq at cLNn
  rw ← cLEq at cLIn
  rw ← cMEq at cMNn
  rw ← cMEq at cMIn
  have cLR : Real(cL) by exact cLIn
  have cMR : Real(cM) by exact cMIn
  have hx := composite with x, xIn
  have hxIn : h(x) ∈ Module.carrier(W)
    rw hx
    exact gfxIn
  unfold HasFDerivAt
  refine ⟨xIn, hxIn, clmN, ?_⟩
  intros e eIn ePos
  have eR : Real(e) by exact eIn
  have hPos := half.positive with ePos
  have hR := half.real at e
  have hsum := half.add_self at e
  have cL1 : (0:R) < cL + (1:R) by linarith
  have cM1 : (0:R) < cM + (1:R) by linarith
  obtain ⟨e1Pos, e1Def⟩ := frechetComp.pos_div at half(e), cM + (1:R) with hPos, cM1
  obtain ⟨e2Pos, e2Def⟩ := frechetComp.pos_div at half(e), cL + (1:R) with hPos, cL1
  have e1R := realDiv.real at half(e), cM + (1:R)
  have e2R := realDiv.real at half(e), cL + (1:R)
  have e1In : half(e) / (cM + (1:R)) ∈ ℝ by exact e1R
  have e2In : half(e) / (cL + (1:R)) ∈ ℝ by exact e2R
  have oneIn : (1:R) ∈ ℝ by typecheck
  have onePos := realZero.lt_one
  obtain ⟨da, daIn, daPos, est1⟩ := approx1 with half(e) / (cM + (1:R)), e1In, e1Pos
  obtain ⟨db, dbIn, dbPos, est1b⟩ := approx1 with (1:R), oneIn, onePos
  obtain ⟨dc, dcIn, dcPos, est2⟩ := approx2 with half(e) / (cL + (1:R)), e2In, e2Pos
  have daR : Real(da) by exact daIn
  have dbR : Real(db) by exact dbIn
  have dcR : Real(dc) by exact dcIn
  obtain ⟨dqPos, dqDef⟩ := frechetComp.pos_div at dc, cL + (1:R) with dcPos, cL1
  have dqR := realDiv.real at dc, cL + (1:R)
  obtain ⟨d, dIn, dPos, dle1, dle2, dle3⟩ := frechetComp.min3 at da, db, dc / (cL + (1:R)) with daPos, dbPos, dqPos
  have dR : Real(d) by exact dIn
  refine ⟨d, dIn, dPos, ?_⟩
  intros k kIn small
  obtain ⟨nkIn, nkNn⟩ := NormedSpace.norm_real at U, K, absK, normU, k with normedU, kIn
  have nkR : Real(normU(k)) by exact nkIn
  have s1 : normU(k) < da by linarith
  have s2 : normU(k) < db by linarith
  have s3 : normU(k) < dc / (cL + (1:R)) by linarith
  have xk := Module.add_mem at K, U, x, k with ring, modU, xIn, kIn
  rw [(composite with Module.add(U)(x, k), xk), hx, (compositeL with k, kIn)]
  obtain ⟨fxk, b1⟩ := est1 with k, kIn, s1
  obtain ⟨_, b1b⟩ := est1b with k, kIn, s2
  have yEx : ∃ y, y = f(Module.add(U)(x, k))
    exact ⟨f(Module.add(U)(x, k)), rfl⟩
  obtain ⟨y, yEq⟩ := yEx
  rw ← yEq
  rw ← yEq at fxk
  rw ← yEq at b1
  rw ← yEq at b1b
  have Lk := FunctionBetween.apply_closed with fnL, kIn
  have PEx : ∃ P, P = L(k)
    exact ⟨L(k), rfl⟩
  obtain ⟨P, PEq⟩ := PEx
  rw ← PEq
  rw ← PEq at Lk
  rw ← PEq at b1
  rw ← PEq at b1b
  have bL := opNorm.le at L, U, K, absK, normU, V, normV, k with normedU, normedV, nontrivial, clmL, kIn
  rw [← cLEq, ← PEq] at bL
  have nfx := Module.neg_mem at K, V, f(x) with ring, modV, fxIn
  have DIn := Module.add_mem at K, V, y, Module.neg(V)(f(x)) with ring, modV, fxk, nfx
  have fP := Module.add_mem at K, V, f(x), P with ring, modV, fxIn, Lk
  have nfP := Module.neg_mem at K, V, Module.add(V)(f(x), P) with ring, modV, fP
  have r1In := Module.add_mem at K, V, y, Module.neg(V)(Module.add(V)(f(x), P)) with ring, modV, fxk, nfP
  have split := frechetComp.sub_split at V, K, y, f(x), P with modV, fxk, fxIn, Lk
  have recomb := frechetComp.recombine at V, K, f(x), y with modV, fxIn, fxk
  have DEx : ∃ D, D = Module.add(V)(y, Module.neg(V)(f(x)))
    exact ⟨Module.add(V)(y, Module.neg(V)(f(x))), rfl⟩
  obtain ⟨D, DEq⟩ := DEx
  have rEx : ∃ r, r = Module.add(V)(y, Module.neg(V)(Module.add(V)(f(x), P)))
    exact ⟨Module.add(V)(y, Module.neg(V)(Module.add(V)(f(x), P))), rfl⟩
  obtain ⟨r, rEq⟩ := rEx
  rw [← DEq, ← rEq] at split
  rw ← DEq at recomb
  rw ← DEq at DIn
  rw ← rEq at r1In
  rw ← rEq at b1
  rw ← rEq at b1b
  have triD := NormedSpace.norm_add_le at V, K, absK, normV, r, P with normedV, r1In, Lk
  rw ← split at triD
  obtain ⟨nrIn, nrNn⟩ := NormedSpace.norm_real at V, K, absK, normV, r with normedV, r1In
  obtain ⟨nPIn, nPNn⟩ := NormedSpace.norm_real at V, K, absK, normV, P with normedV, Lk
  obtain ⟨nDIn, nDNn⟩ := NormedSpace.norm_real at V, K, absK, normV, D with normedV, DIn
  have nrR : Real(normV(r)) by exact nrIn
  have nPR : Real(normV(P)) by exact nPIn
  have nDR : Real(normV(D)) by exact nDIn
  have one1 : (1:R) * normU(k) = normU(k) by ring
  rw one1 at b1b
  have dB : normV(D) ≤ normU(k) + cL * normU(k) by linarith
  have m3 := realLess.mul_right_of_positive at normU(k), dc / (cL + (1:R)), cL + (1:R) with s3, cL1
  rw dqDef at m3
  have ex4 : normU(k) * (cL + (1:R)) = normU(k) + cL * normU(k) by ring
  rw ex4 at m3
  have small2 : normV(D) < dc by linarith
  obtain ⟨gIn, b2⟩ := est2 with D, DIn, small2
  rw recomb at gIn
  rw recomb at b2
  refine ⟨gIn, ?_⟩
  have MD := FunctionBetween.apply_closed with fnM, DIn
  have MP := FunctionBetween.apply_closed with fnM, Lk
  have Mr := FunctionBetween.apply_closed with fnM, r1In
  have diff := frechetComp.approx_diff at W, K, g(y), g(f(x)), M(D), M(P) with modW, gIn, gfxIn, MD, MP
  have nP := Module.neg_mem at K, V, P with ring, modV, Lk
  have lin2 := addM with D, DIn, Module.neg(V)(P), nP
  have mneg := IsLinearMap.map_neg at M, V, W, K, P with clmM.left, Lk
  rw mneg at lin2
  have back := frechetComp.add_sub_cancel at V, K, r, P with modV, r1In, Lk
  rw ← split at back
  rw back at lin2
  rw ← lin2 at diff
  have TEx : ∃ T, T = Module.add(W)(g(y), Module.neg(W)(Module.add(W)(g(f(x)), M(P))))
    exact ⟨Module.add(W)(g(y), Module.neg(W)(Module.add(W)(g(f(x)), M(P)))), rfl⟩
  obtain ⟨T, TEq⟩ := TEx
  have R2Ex : ∃ R2, R2 = Module.add(W)(g(y), Module.neg(W)(Module.add(W)(g(f(x)), M(D))))
    exact ⟨Module.add(W)(g(y), Module.neg(W)(Module.add(W)(g(f(x)), M(D)))), rfl⟩
  obtain ⟨R2, R2Eq⟩ := R2Ex
  rw ← TEq
  rw [← TEq, ← R2Eq] at diff
  rw ← R2Eq at b2
  have gP := Module.add_mem at K, W, g(f(x)), M(P) with ring, modW, gfxIn, MP
  have ngP := Module.neg_mem at K, W, Module.add(W)(g(f(x)), M(P)) with ring, modW, gP
  have TIn := Module.add_mem at K, W, g(y), Module.neg(W)(Module.add(W)(g(f(x)), M(P))) with ring, modW, gIn, ngP
  have gD := Module.add_mem at K, W, g(f(x)), M(D) with ring, modW, gfxIn, MD
  have ngD := Module.neg_mem at K, W, Module.add(W)(g(f(x)), M(D)) with ring, modW, gD
  have R2In := Module.add_mem at K, W, g(y), Module.neg(W)(Module.add(W)(g(f(x)), M(D))) with ring, modW, gIn, ngD
  rw ← TEq at TIn
  rw ← R2Eq at R2In
  have recT := frechetComp.sub_add_cancel at W, K, T, R2 with modW, TIn, R2In
  rw diff at recT
  have triT := NormedSpace.norm_add_le at W, K, absK, normW, M(r), R2 with normedW, Mr, R2In
  rw recT at triT
  have bM := opNorm.le at M, V, K, absK, normV, W, normW, r with normedV, normedW, nontrivial, clmM, r1In
  rw ← cMEq at bM
  obtain ⟨nTIn, nTNn⟩ := NormedSpace.norm_real at W, K, absK, normW, T with normedW, TIn
  obtain ⟨nR2In, nR2Nn⟩ := NormedSpace.norm_real at W, K, absK, normW, R2 with normedW, R2In
  obtain ⟨nMrIn, nMrNn⟩ := NormedSpace.norm_real at W, K, absK, normW, M(r) with normedW, Mr
  have nTR : Real(normW(T)) by exact nTIn
  have nR2R : Real(normW(R2)) by exact nR2In
  have nMrR : Real(normW(M(r))) by exact nMrIn
  have e1Nn : (0:R) ≤ half(e) / (cM + (1:R)) by linarith
  have e2Nn : (0:R) ≤ half(e) / (cL + (1:R)) by linarith
  have tri2 : normW(T) ≤ normW(R2) + normW(M(r)) by linarith
  exact frechetComp.arith at normW(T), normW(R2), normW(M(r)), normV(D), normV(r), normU(k), cM, cL, half(e) / (cM + (1:R)), half(e) / (cL + (1:R)), half(e), e with tri2, b2, bM, b1, dB, e2Def, e1Def, hsum, cMNn, e1Nn, e2Nn, nkNn

-- A Fréchet derivative gives every directional derivative: D_v f(x) = L v.
theorem HasFDerivAt.line (f L v x : Set)
  requires derivative : HasFDerivAt(f, V, normV, W, normW, K, L, x)
  requires direction : v ∈ Module.carrier(V)
  shows HasLineDerivAt(f, V, normV, W, normW, K, absK, v, L(v), x)
proof
  have modV := normedV.right.left
  have nV := normedV
  obtain ⟨nfV, modV2, ngV, lawV⟩ := nV
  have ring := Module.ring at V, K with modV
  have der := derivative
  obtain ⟨xIn, fxIn, clmL, approx⟩ := der
  have lin := clmL.left
  obtain ⟨modV3, modW, fnL, addL, smulL⟩ := lin
  have Lv := FunctionBetween.apply_closed with fnL, direction
  obtain ⟨nvIn, nvNn⟩ := NormedSpace.norm_real at V, K, absK, normV, v with normedV, direction
  have nvR : Real(normV(v)) by exact nvIn
  have v1Pos : (0:R) < normV(v) + (1:R) by linarith
  have v1Ne : normV(v) + (1:R) ≠ (0:R)
    intro z
    rw z at v1Pos
    linarith
  unfold HasLineDerivAt
  refine ⟨xIn, direction, Lv, ?_⟩
  intros e eIn ePos
  have eR : Real(e) by exact eIn
  have e1In : e / (normV(v) + (1:R)) ∈ ℝ by typecheck
  have e1R : Real(e / (normV(v) + (1:R))) by exact e1In
  have e1Mul := realDiv.mul_right at e, normV(v) + (1:R) with v1Ne
  have e1Pos : (0:R) < e / (normV(v) + (1:R))
    by_contra np
    have le : e / (normV(v) + (1:R)) ≤ (0:R) by linarith
    have v1Nn : (0:R) ≤ normV(v) + (1:R) by linarith
    have m := realLe.mul_right_of_nonnegative at e / (normV(v) + (1:R)), (0:R), normV(v) + (1:R) with le, v1Nn
    rw e1Mul at m
    have z : (0:R) * (normV(v) + (1:R)) = (0:R) by ring
    rw z at m
    linarith
  obtain ⟨d0, d0In, d0Pos, est⟩ := approx with e / (normV(v) + (1:R)), e1In, e1Pos
  have d0R : Real(d0) by exact d0In
  have dIn : d0 / (normV(v) + (1:R)) ∈ ℝ by typecheck
  have dR : Real(d0 / (normV(v) + (1:R))) by exact dIn
  have dMul := realDiv.mul_right at d0, normV(v) + (1:R) with v1Ne
  have dPos : (0:R) < d0 / (normV(v) + (1:R))
    by_contra np
    have le : d0 / (normV(v) + (1:R)) ≤ (0:R) by linarith
    have v1Nn : (0:R) ≤ normV(v) + (1:R) by linarith
    have m := realLe.mul_right_of_nonnegative at d0 / (normV(v) + (1:R)), (0:R), normV(v) + (1:R) with le, v1Nn
    rw dMul at m
    have z : (0:R) * (normV(v) + (1:R)) = (0:R) by ring
    rw z at m
    linarith
  refine ⟨d0 / (normV(v) + (1:R)), dIn, dPos, ?_⟩
  intros t tIn small
  obtain ⟨tRIn, tNn⟩ := NormedField.norm_real at K, absK, t with nfV, tIn
  have tR : Real(absK(t)) by exact tRIn
  have tv := Module.smul_mem at K, V, t, v with ring, modV, tIn, direction
  have ntv := lawV with t, tIn, v, direction
  have m1 := realLess.mul_right_of_positive at absK(t), d0 / (normV(v) + (1:R)), normV(v) + (1:R) with small, v1Pos
  rw dMul at m1
  have vle : normV(v) ≤ normV(v) + (1:R) by linarith
  have m2 := realLe.mul_left_of_nonnegative at normV(v), normV(v) + (1:R), absK(t) with vle, tNn
  have kSmall : normV(Module.smul(V)(t, v)) < d0
    rw ntv
    have sw : absK(t) * (normV(v) + (1:R)) = absK(t) * (normV(v) + (1:R)) by rfl
    linarith
  obtain ⟨fxk, bound⟩ := est with Module.smul(V)(t, v), tv, kSmall
  rw (smulL with t, tIn, v, direction) at bound
  rw ntv at bound
  have e1Nn : (0:R) ≤ e / (normV(v) + (1:R)) by linarith
  have ble := realLe.mul_left_of_nonnegative at absK(t) * normV(v), absK(t) * (normV(v) + (1:R)), e / (normV(v) + (1:R)) with m2, e1Nn
  have ex : e / (normV(v) + (1:R)) * (absK(t) * (normV(v) + (1:R))) = (e / (normV(v) + (1:R)) * (normV(v) + (1:R))) * absK(t) by ring
  rw [ex, e1Mul] at ble
  have Ltv := Module.smul_mem at K, W, t, L(v) with ring, modW, tIn, Lv
  have inner := Module.add_mem at K, W, f(x), Module.smul(W)(t, L(v)) with ring, modW, fxIn, Ltv
  have ni := Module.neg_mem at K, W, Module.add(W)(f(x), Module.smul(W)(t, L(v))) with ring, modW, inner
  have diff := Module.add_mem at K, W, f(Module.add(V)(x, Module.smul(V)(t, v))), Module.neg(W)(Module.add(W)(f(x), Module.smul(W)(t, L(v)))) with ring, modW, fxk, ni
  have dRR : Real(normW(Module.add(W)(f(Module.add(V)(x, Module.smul(V)(t, v))), Module.neg(W)(Module.add(W)(f(x), Module.smul(W)(t, L(v))))))) by exact (NormedSpace.norm_real at W, K, absK, normW, Module.add(W)(f(Module.add(V)(x, Module.smul(V)(t, v))), Module.neg(W)(Module.add(W)(f(x), Module.smul(W)(t, L(v))))) with normedW, diff).left
  linarith

theorem HasLineDerivAt.unique (f v D E x : Set)
  requires first : HasLineDerivAt(f, V, normV, W, normW, K, absK, v, D, x)
  requires second : HasLineDerivAt(f, V, normV, W, normW, K, absK, v, E, x)
  requires line : ∀ t ∈ Ring.carrier(K),
    f(Module.add(V)(x, Module.smul(V)(t, v))) ∈ Module.carrier(W)
  shows D = E
proof
  have f2 := first
  obtain ⟨xIn, vIn, DIn, rest⟩ := f2
  have modV := normedV.right.left
  have ring := Module.ring at V, K with modV
  have zeroK := Ring.zero_mem at K with ring
  have l0 := line with Ring.zero(K), zeroK
  have z := zero_smul at K, V, v with ring, modV, vIn
  have a0 := Module.add_zero at K, V, x with ring, modV, xIn
  rw [z, a0] at l0
  exact HasLineDerivAt.agree with nontrivial, normedW, first, second, l0, line

-- Strict differentiability implies differentiability, and a map with a
-- continuous derivative on an open set is strictly differentiable there.
theorem HasStrictFDerivAt.hasFDerivAt (f L x : Set)
  requires strict : HasStrictFDerivAt(f, V, normV, W, normW, K, L, x)
  requires value : f(x) ∈ Module.carrier(W)
  requires map : f : Module.carrier(V) → Module.carrier(W)
  shows HasFDerivAt(f, V, normV, W, normW, K, L, x)
proof
  have modV := normedV.right.left
  have modW := normedW.right.left
  have ring := Module.ring at V, K with modV
  have st := strict
  obtain ⟨xIn, clmL, approx⟩ := st
  have lin := clmL.left
  have lin2 := lin
  obtain ⟨modV2, modW2, fnL, addLaw, smulLaw⟩ := lin2
  have groupV := Module.additive_group at K, V with ring, modV
  have groupW := Module.additive_group at K, W with ring, modW
  have abelianW := Module.additive.abelian_group at W, K with modW
  have xA : x ∈ Group.carrier(Module.additive(V))
    rw Module.additive.carrier
    exact xIn
  have zeroV := Module.zero_mem at K, V with ring, modV
  have nz := (NormedSpace.norm_eq_zero at V, K, absK, normV, Module.zero(V) with normedV, zeroV).backward with rfl
  have xx := Group.mul_inv at Module.additive(V), x with groupV, xA
  rw [Module.additive.mul, Module.additive.inv, Module.additive.one] at xx
  unfold HasFDerivAt
  refine ⟨xIn, value, clmL, ?_⟩
  intros e eIn ePos
  obtain ⟨d, dIn, dPos, est⟩ := approx with e, eIn, ePos
  refine ⟨d, dIn, dPos, ?_⟩
  intros h hIn small
  have hA : h ∈ Group.carrier(Module.additive(V))
    rw Module.additive.carrier
    exact hIn
  have xh := Module.add_mem at K, V, x, h with ring, modV, xIn, hIn
  have fxh := FunctionBetween.apply_closed with map, xh
  refine ⟨fxh, ?_⟩
  have c1 := mul_right_comm at Module.additive(V), x, h, Group.inv(Module.additive(V))(x) with (Module.additive.abelian_group at V, K with modV), xA, hA, (Group.inv_mem at Module.additive(V), x with groupV, xA)
  have c2 := Group.mul_inv at Module.additive(V), x with groupV, xA
  have c3 := one_mul at Module.additive(V), h with groupV, hA
  rw [c2, c3] at c1
  rw [Module.additive.mul, Module.additive.inv] at c1
  have s1 : normV(Module.add(V)(Module.add(V)(x, h), Module.neg(V)(x))) < d
    rw c1
    exact small
  have s2 : normV(Module.add(V)(x, Module.neg(V)(x))) < d
    rw [xx, nz]
    exact dPos
  have r := est with Module.add(V)(x, h), xh, x, xIn, s1, s2
  rw c1 at r
  have Lh := FunctionBetween.apply_closed with fnL, hIn
  have fxA : f(x) ∈ Group.carrier(Module.additive(W))
    rw Module.additive.carrier
    exact value
  have fxhA : f(Module.add(V)(x, h)) ∈ Group.carrier(Module.additive(W))
    rw Module.additive.carrier
    exact fxh
  have LhA : L(h) ∈ Group.carrier(Module.additive(W))
    rw Module.additive.carrier
    exact Lh
  have e1 : Group.mul(Module.additive(W))(Group.mul(Module.additive(W))(f(Module.add(V)(x, h)), Group.inv(Module.additive(W))(f(x))), Group.inv(Module.additive(W))(L(h))) = Group.mul(Module.additive(W))(f(Module.add(V)(x, h)), Group.inv(Module.additive(W))(Group.mul(Module.additive(W))(f(x), L(h))))
    have mi := mul_inv at Module.additive(W), f(x), L(h) with abelianW, fxA, LhA
    rw mi
    have ia := Group.inv_mem at Module.additive(W), f(x) with groupW, fxA
    have ib := Group.inv_mem at Module.additive(W), L(h) with groupW, LhA
    exact mul_assoc at Module.additive(W), f(Module.add(V)(x, h)), Group.inv(Module.additive(W))(f(x)), Group.inv(Module.additive(W))(L(h)) with groupW, fxhA, ia, ib
  rw [Module.additive.mul, Module.additive.inv] at e1
  rw e1 at r
  exact r

-- The mean value inequality (Mathlib's
-- Convex.norm_image_sub_le_of_norm_fderiv_le): on a convex open set where
-- ‖f′‖ ≤ C, ‖f(y) − f(x)‖ ≤ C ‖y − x‖.
theorem HasFDerivAt.mean_value_bound (f U x y : Set, C : Real)
  requires realScalars : K = realRing
  requires open : U ∈ TopologicalSpace.opens(spaceTopology(V, normV))
  requires convex : ∀ a ∈ U, ∀ b ∈ U, ∀ t ∈ ℝ, realZero ≤ t → t ≤ realOne →
    Module.add(V)(Module.smul(V)(R[1 - t], a), Module.smul(V)(t, b)) ∈ U
  requires differentiable : ∀ z ∈ U, FDifferentiableAt(f, V, normV, W, normW, K, z)
  requires bound : ∀ z ∈ U,
    opNorm(fderiv(f, V, normV, W, normW, K, z), V, normV, normW) ≤ C
  requires memberX : x ∈ U
  requires memberY : y ∈ U
  shows normW(Module.add(W)(f(y), Module.neg(W)(f(x)))) ≤
    R[C * normV(Module.add(V)(y, Module.neg(V)(x)))]
proof
  sorry

-- A map with zero derivative on a connected open set is constant.
theorem HasFDerivAt.constant_of_zero (f U : Set)
  requires open : U ∈ TopologicalSpace.opens(spaceTopology(V, normV))
  requires connected : ConnectedSubset(spaceTopology(V, normV), U)
  requires zero : ∀ z ∈ U, HasFDerivAt(f, V, normV, W, normW, K,
    Module.carrier(V) × {Module.zero(W)}, z)
  shows ∀ x ∈ U, ∀ y ∈ U, f(x) = f(y)
proof
  sorry

-- Section: Cᵏ maps
-- Cᵏ⁺¹ implies Cᵏ, constants and continuous linear maps are smooth, and
-- sums and composites of Cᵏ maps are Cᵏ.
theorem ContDiffOn.mono (f U : Set, j k : Nat)
  requires smooth : ContDiffOn(f, V, normV, W, normW, K, absK, U, k)
  requires le : j ≤ k
  shows ContDiffOn(f, V, normV, W, normW, K, absK, U, j)
proof
  sorry

theorem ContDiffOn.linear (L U : Set)
  requires continuous : ContinuousLinearMap(L, V, normV, W, normW, K)
  requires open : U ∈ TopologicalSpace.opens(spaceTopology(V, normV))
  shows SmoothOn(L, V, normV, W, normW, K, absK, U)
proof
  sorry

theorem ContDiffOn.add (f g h U : Set, k : Nat)
  requires first : ContDiffOn(f, V, normV, W, normW, K, absK, U, k)
  requires second : ContDiffOn(g, V, normV, W, normW, K, absK, U, k)
  requires sum : ∀ y ∈ U, h(y) = Module.add(W)(f(y), g(y))
  shows ContDiffOn(h, V, normV, W, normW, K, absK, U, k)
proof
  sorry

theorem ContDiffOn.comp (U0 normU f g h S U : Set, k : Nat)
  requires normedU : NormedSpace(U0, K, absK, normU)
  requires inner : ContDiffOn(f, U0, normU, V, normV, K, absK, S, k)
  requires outer : ContDiffOn(g, V, normV, W, normW, K, absK, U, k)
  requires maps : ∀ y ∈ S, f(y) ∈ U
  requires composite : ∀ y ∈ S, h(y) = g(f(y))
  shows ContDiffOn(h, U0, normU, W, normW, K, absK, S, k)
proof
  sorry

-- For finite-dimensional V over ℝ or ℂ, C¹ on U means differentiable on U
-- with the derivative continuous in the operator norm.
theorem ContDiffOn.one_iff (f U : Set)
  requires scalars : RealOrComplexScalars(K, absK)
  requires finite : FiniteDimensionalModule(V, K)
  requires open : U ∈ TopologicalSpace.opens(spaceTopology(V, normV))
  shows ContDiffOn(f, V, normV, W, normW, K, absK, U, (1:N)) ↔
    FDifferentiableOn(f, V, normV, W, normW, K, U) ∧
    (∀ x ∈ U, ∀ e ∈ ℝ, realZero < e → ∃ d ∈ ℝ, realZero < d ∧
      (∀ y ∈ U, normV(Module.add(V)(y, Module.neg(V)(x))) < d →
        (∀ v ∈ Module.carrier(V),
          normW(Module.add(W)(fderiv(f, V, normV, W, normW, K, y)(v),
            Module.neg(W)(fderiv(f, V, normV, W, normW, K, x)(v)))) ≤
            R[e * normV(v)])))
proof
  sorry

-- A C¹ map is strictly differentiable at each point of its open set.
theorem ContDiffOn.strict (f U x : Set)
  requires scalars : RealOrComplexScalars(K, absK)
  requires finite : FiniteDimensionalModule(V, K)
  requires smooth : ContDiffOn(f, V, normV, W, normW, K, absK, U, (1:N))
  requires member : x ∈ U
  shows HasStrictFDerivAt(f, V, normV, W, normW, K,
    fderiv(f, V, normV, W, normW, K, x), x)
proof
  sorry

-- The inverse function theorem: a map strictly differentiable at x whose
-- derivative is invertible is a homeomorphism between neighborhoods of x
-- and of f(x), with differentiable inverse.
theorem HasStrictFDerivAt.local_inverse (f L Linv x : Set)
  requires complete : Complete(spaceMetric(V, normV))
  requires completeW : Complete(spaceMetric(W, normW))
  requires strict : HasStrictFDerivAt(f, V, normV, W, normW, K, L, x)
  requires inverse : ContinuousLinearMap(Linv, W, normW, V, normV, K)
  requires leftInverse : ∀ v ∈ Module.carrier(V), Linv(L(v)) = v
  requires rightInverse : ∀ w ∈ Module.carrier(W), L(Linv(w)) = w
  shows ∃ U, ∃ S, ∃ g, U ∈ nhds(spaceTopology(V, normV), x) ∧
    S ∈ nhds(spaceTopology(W, normW), f(x)) ∧
    (∀ y ∈ U, f(y) ∈ S ∧ g(f(y)) = y) ∧ (∀ z ∈ S, g(z) ∈ U ∧ f(g(z)) = z) ∧
    HasFDerivAt(g, W, normW, V, normV, K, Linv, f(x))
proof
  sorry

end Derivatives

-- Section: Maps of one real or complex variable
-- For f : ℝ → ℝ, the derivative here is Cumulus's derivative.
theorem HasDerivAt.real_iff (f : Set, D A : Real)
  requires function : f : ℝ → ℝ
  shows HasDerivAt(f, realRing, realAbs, realSelfModule, realAbs, D, A) ↔
    HasDerivativeAt(f, D, A)
proof
  sorry

-- For f : ℝ → ℝ the Fréchet derivative is multiplication by the
-- derivative.
theorem HasFDerivAt.real_iff (f L : Set, D A : Real)
  requires function : f : ℝ → ℝ
  requires linear : ∀ t ∈ ℝ, L(t) = R[t * D]
  requires functionL : L : ℝ → ℝ
  shows HasFDerivAt(f, realSelfModule, realAbs, realSelfModule, realAbs,
      realRing, L, A) ↔ HasDerivativeAt(f, D, A)
proof
  sorry

-- Mathlib's hasDerivAt_id, hasDerivAt_mul_const and hasDerivAt_const_mul
-- in one variable over 𝕜.
theorem HasDerivAt.identity (K absK x : Set)
  requires scalars : RealOrComplexScalars(K, absK)
  requires member : x ∈ Ring.carrier(K)
  shows HasDerivAt(identity(Ring.carrier(K)), K, absK, selfModule(K), absK,
    Ring.one(K), x)
proof
  have ntf : NontriviallyNormedField(K, absK)
    cases scalars with re | co
    . obtain ⟨kEq, aEq⟩ := re
      rw [kEq, aEq]
      exact NormedField.real
    . obtain ⟨kEq, aEq⟩ := co
      rw [kEq, aEq]
      exact NormedField.complex
  have nf := ntf.left
  have ring := nf.right.right.left.left
  have carEq : Module.carrier(selfModule(K)) = Ring.carrier(K)
    unfold selfModule
    simp [Module.mk.carrier]
  have smulEq : Module.smul(selfModule(K)) = Ring.mul(K)
    unfold selfModule
    simp [Module.mk.smul]
  have addEq : Module.add(selfModule(K)) = Ring.add(K)
    unfold selfModule
    simp [Module.mk.add]
  have negEq : Module.neg(selfModule(K)) = Ring.neg(K)
    unfold selfModule
    simp [Module.mk.neg]
  have oneIn := Ring.one_mem at K with ring
  unfold HasDerivAt
  unfold HasLineDerivAt
  rw [carEq, smulEq, addEq, negEq]
  refine ⟨member, oneIn, oneIn, ?_⟩
  intros e eIn ePos
  have oneR : (1:R) ∈ ℝ by typecheck
  refine ⟨(1:R), oneR, realZero.lt_one, ?_⟩
  intros t tIn small
  have t1 := Ring.mul_mem at K, t, Ring.one(K) with ring, tIn, oneIn
  have xt := Ring.add_mem at K, x, Ring.mul(K)(t, Ring.one(K)) with ring, member, t1
  have a1 := identity.apply at Ring.add(K)(x, Ring.mul(K)(t, Ring.one(K))), Ring.carrier(K) with xt
  have a2 := identity.apply at x, Ring.carrier(K) with member
  rw [a1, a2]
  have p := Ring.parts with ring
  have inv := IsRing.add_inverse_right with p, xt
  rw inv
  have ngK := nf.right.right.left.right.left
  have z := IsNorm.zero at Ring.additive(K), absK with ngK
  rw Ring.additive.one at z
  rw z
  obtain ⟨tRIn, tNn⟩ := NormedField.norm_real at K, absK, t with nf, tIn
  have tR : Real(absK(t)) by exact tRIn
  have eR : Real(e) by exact eIn
  have eNn : (0:R) ≤ e by linarith
  have m := realLe.mul_left_of_nonnegative at (0:R), absK(t), e with tNn, eNn
  have z2 : e * (0:R) = (0:R) by ring
  rw z2 at m
  exact m

end Frechet

-- The ring identities behind the scalar product rules.
section FrechetScalarIdentities
variable (K : Set)
notation ring S := (Ring.carrier(K), Ring.add(K), Ring.zero(K), Ring.neg(K),
  Ring.mul(K), Ring.one(K))
hypothesis commutative : CommRing(K)

theorem frechetScalar.mul_const_identity (a b t D c : Set)
  requires memberA : a ∈ Ring.carrier(K)
  requires memberB : b ∈ Ring.carrier(K)
  requires memberT : t ∈ Ring.carrier(K)
  requires memberD : D ∈ Ring.carrier(K)
  requires memberC : c ∈ Ring.carrier(K)
  shows S[a * c + -(b * c + t * (D * c))] = S[(a + -(b + t * D)) * c]
proof
  ring

theorem frechetScalar.const_mul_identity (a b t D c : Set)
  requires memberA : a ∈ Ring.carrier(K)
  requires memberB : b ∈ Ring.carrier(K)
  requires memberT : t ∈ Ring.carrier(K)
  requires memberD : D ∈ Ring.carrier(K)
  requires memberC : c ∈ Ring.carrier(K)
  shows S[c * a + -(c * b + t * (c * D))] = S[c * (a + -(b + t * D))]
proof
  ring

theorem frechetScalar.mul_one (t : Set)
  requires memberT : t ∈ Ring.carrier(K)
  shows Ring.mul(K)(t, Ring.one(K)) = t
proof
  ring

end FrechetScalarIdentities

section FrechetScalar
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- The arithmetic of scaling an estimate by |c|: with e′ (c + 1) = e,
-- X ≤ e′ t gives X c ≤ e t.
theorem frechetScalar.scale_arith (X t c e f : Real)
  requires bound : X ≤ f * t
  requires cNn : (0:R) ≤ c
  requires tNn : (0:R) ≤ t
  requires fNn : (0:R) ≤ f
  requires fDef : f * (c + (1:R)) = e
  shows X * c ≤ e * t
proof
  have m := realLe.mul_right_of_nonnegative at X, f * t, c with bound, cNn
  have ft := realMulValue.nonnegative at f, t with fNn, tNn
  have ex : (f * t) * c + f * t = (f * (c + (1:R))) * t by ring
  rw fDef at ex
  linarith

theorem HasDerivAt.mul_const (K absK f g c D x : Set)
  requires scalars : RealOrComplexScalars(K, absK)
  requires derivative : HasDerivAt(f, K, absK, selfModule(K), absK, D, x)
  requires scalar : c ∈ Ring.carrier(K)
  requires product : ∀ y ∈ Ring.carrier(K), g(y) = Ring.mul(K)(f(y), c)
  requires values : ∀ y ∈ Ring.carrier(K), f(y) ∈ Ring.carrier(K)
  shows HasDerivAt(g, K, absK, selfModule(K), absK, Ring.mul(K)(D, c), x)
proof
  have ntf : NontriviallyNormedField(K, absK)
    cases scalars with re | co
    . obtain ⟨kEq, aEq⟩ := re
      rw [kEq, aEq]
      exact NormedField.real
    . obtain ⟨kEq, aEq⟩ := co
      rw [kEq, aEq]
      exact NormedField.complex
  have nf := ntf.left
  have nf2 := nf
  obtain ⟨field, comm, nr, mulEq, oneEq⟩ := nf2
  have ring := nr.left
  have carEq : Module.carrier(selfModule(K)) = Ring.carrier(K)
    unfold selfModule
    simp [Module.mk.carrier]
  have smulEq : Module.smul(selfModule(K)) = Ring.mul(K)
    unfold selfModule
    simp [Module.mk.smul]
  have addEq : Module.add(selfModule(K)) = Ring.add(K)
    unfold selfModule
    simp [Module.mk.add]
  have negEq : Module.neg(selfModule(K)) = Ring.neg(K)
    unfold selfModule
    simp [Module.mk.neg]
  have der := derivative
  unfold HasDerivAt at der
  unfold HasLineDerivAt at der
  rw [carEq, smulEq, addEq, negEq] at der
  obtain ⟨xIn, oneIn, DIn, approx⟩ := der
  have Dc := Ring.mul_mem at K, D, c with ring, DIn, scalar
  obtain ⟨cIn, cNn⟩ := NormedField.norm_real at K, absK, c with nf, scalar
  have cR : Real(absK(c)) by exact cIn
  unfold HasDerivAt
  unfold HasLineDerivAt
  rw [carEq, smulEq, addEq, negEq]
  refine ⟨xIn, oneIn, Dc, ?_⟩
  intros e eIn ePos
  have eR : Real(e) by exact eIn
  have cne : absK(c) + (1:R) ≠ (0:R)
    intro z
    linarith
  have fIn : e / (absK(c) + (1:R)) ∈ ℝ by typecheck
  have fR : Real(e / (absK(c) + (1:R))) by exact fIn
  have fDef := realDiv.mul_right at e, absK(c) + (1:R) with cne
  have fPos : (0:R) < e / (absK(c) + (1:R))
    by_contra np
    have le0 : e / (absK(c) + (1:R)) ≤ (0:R) by linarith
    have den : (0:R) ≤ absK(c) + (1:R) by linarith
    have m := realLe.mul_right_of_nonnegative at e / (absK(c) + (1:R)), (0:R), absK(c) + (1:R) with le0, den
    rw fDef at m
    have z : (0:R) * (absK(c) + (1:R)) = (0:R) by ring
    rw z at m
    linarith
  have fNn : (0:R) ≤ e / (absK(c) + (1:R)) by linarith
  obtain ⟨d, dIn, dPos, est⟩ := approx with e / (absK(c) + (1:R)), fIn, fPos
  refine ⟨d, dIn, dPos, ?_⟩
  intros t tIn small
  have t1 := Ring.mul_mem at K, t, Ring.one(K) with ring, tIn, oneIn
  have xt := Ring.add_mem at K, x, Ring.mul(K)(t, Ring.one(K)) with ring, xIn, t1
  have r := est with t, tIn, small
  have aIn := values with Ring.add(K)(x, Ring.mul(K)(t, Ring.one(K))), xt
  have bIn := values with x, xIn
  rw [(product with Ring.add(K)(x, Ring.mul(K)(t, Ring.one(K))), xt), (product with x, xIn)]
  have ident := frechetScalar.mul_const_identity at K, f(Ring.add(K)(x, Ring.mul(K)(t, Ring.one(K)))), f(x), t, D, c with comm, aIn, bIn, tIn, DIn, scalar
  rw ident
  have tD := Ring.mul_mem at K, t, D with ring, tIn, DIn
  have btD := Ring.add_mem at K, f(x), Ring.mul(K)(t, D) with ring, bIn, tD
  have nb := Ring.neg_mem at K, Ring.add(K)(f(x), Ring.mul(K)(t, D)) with ring, btD
  have X := Ring.add_mem at K, f(Ring.add(K)(x, Ring.mul(K)(t, Ring.one(K)))), Ring.neg(K)(Ring.add(K)(f(x), Ring.mul(K)(t, D))) with ring, aIn, nb
  rw (mulEq with Ring.add(K)(f(Ring.add(K)(x, Ring.mul(K)(t, Ring.one(K)))), Ring.neg(K)(Ring.add(K)(f(x), Ring.mul(K)(t, D)))), X, c, scalar)
  obtain ⟨XIn, XNn⟩ := NormedField.norm_real at K, absK, Ring.add(K)(f(Ring.add(K)(x, Ring.mul(K)(t, Ring.one(K)))), Ring.neg(K)(Ring.add(K)(f(x), Ring.mul(K)(t, D)))) with nf, X
  obtain ⟨tRIn, tNn⟩ := NormedField.norm_real at K, absK, t with nf, tIn
  exact frechetScalar.scale_arith at absK(Ring.add(K)(f(Ring.add(K)(x, Ring.mul(K)(t, Ring.one(K)))), Ring.neg(K)(Ring.add(K)(f(x), Ring.mul(K)(t, D))))), absK(t), absK(c), e, e / (absK(c) + (1:R)) with r, cNn, tNn, fNn, fDef

theorem HasDerivAt.const_mul (K absK f g c D x : Set)
  requires scalars : RealOrComplexScalars(K, absK)
  requires derivative : HasDerivAt(f, K, absK, selfModule(K), absK, D, x)
  requires scalar : c ∈ Ring.carrier(K)
  requires product : ∀ y ∈ Ring.carrier(K), g(y) = Ring.mul(K)(c, f(y))
  requires values : ∀ y ∈ Ring.carrier(K), f(y) ∈ Ring.carrier(K)
  shows HasDerivAt(g, K, absK, selfModule(K), absK, Ring.mul(K)(c, D), x)
proof
  have ntf : NontriviallyNormedField(K, absK)
    cases scalars with re | co
    . obtain ⟨kEq, aEq⟩ := re
      rw [kEq, aEq]
      exact NormedField.real
    . obtain ⟨kEq, aEq⟩ := co
      rw [kEq, aEq]
      exact NormedField.complex
  have nf := ntf.left
  have nf2 := nf
  obtain ⟨field, comm, nr, mulEq, oneEq⟩ := nf2
  have ring := nr.left
  have carEq : Module.carrier(selfModule(K)) = Ring.carrier(K)
    unfold selfModule
    simp [Module.mk.carrier]
  have smulEq : Module.smul(selfModule(K)) = Ring.mul(K)
    unfold selfModule
    simp [Module.mk.smul]
  have addEq : Module.add(selfModule(K)) = Ring.add(K)
    unfold selfModule
    simp [Module.mk.add]
  have negEq : Module.neg(selfModule(K)) = Ring.neg(K)
    unfold selfModule
    simp [Module.mk.neg]
  have der := derivative
  unfold HasDerivAt at der
  unfold HasLineDerivAt at der
  rw [carEq, smulEq, addEq, negEq] at der
  obtain ⟨xIn, oneIn, DIn, approx⟩ := der
  have Dc := Ring.mul_mem at K, c, D with ring, scalar, DIn
  obtain ⟨cIn, cNn⟩ := NormedField.norm_real at K, absK, c with nf, scalar
  have cR : Real(absK(c)) by exact cIn
  unfold HasDerivAt
  unfold HasLineDerivAt
  rw [carEq, smulEq, addEq, negEq]
  refine ⟨xIn, oneIn, Dc, ?_⟩
  intros e eIn ePos
  have eR : Real(e) by exact eIn
  have cne : absK(c) + (1:R) ≠ (0:R)
    intro z
    linarith
  have fIn : e / (absK(c) + (1:R)) ∈ ℝ by typecheck
  have fR : Real(e / (absK(c) + (1:R))) by exact fIn
  have fDef := realDiv.mul_right at e, absK(c) + (1:R) with cne
  have fPos : (0:R) < e / (absK(c) + (1:R))
    by_contra np
    have le0 : e / (absK(c) + (1:R)) ≤ (0:R) by linarith
    have den : (0:R) ≤ absK(c) + (1:R) by linarith
    have m := realLe.mul_right_of_nonnegative at e / (absK(c) + (1:R)), (0:R), absK(c) + (1:R) with le0, den
    rw fDef at m
    have z : (0:R) * (absK(c) + (1:R)) = (0:R) by ring
    rw z at m
    linarith
  have fNn : (0:R) ≤ e / (absK(c) + (1:R)) by linarith
  obtain ⟨d, dIn, dPos, est⟩ := approx with e / (absK(c) + (1:R)), fIn, fPos
  refine ⟨d, dIn, dPos, ?_⟩
  intros t tIn small
  have t1 := Ring.mul_mem at K, t, Ring.one(K) with ring, tIn, oneIn
  have xt := Ring.add_mem at K, x, Ring.mul(K)(t, Ring.one(K)) with ring, xIn, t1
  have r := est with t, tIn, small
  have aIn := values with Ring.add(K)(x, Ring.mul(K)(t, Ring.one(K))), xt
  have bIn := values with x, xIn
  rw [(product with Ring.add(K)(x, Ring.mul(K)(t, Ring.one(K))), xt), (product with x, xIn)]
  have ident := frechetScalar.const_mul_identity at K, f(Ring.add(K)(x, Ring.mul(K)(t, Ring.one(K)))), f(x), t, D, c with comm, aIn, bIn, tIn, DIn, scalar
  rw ident
  have tD := Ring.mul_mem at K, t, D with ring, tIn, DIn
  have btD := Ring.add_mem at K, f(x), Ring.mul(K)(t, D) with ring, bIn, tD
  have nb := Ring.neg_mem at K, Ring.add(K)(f(x), Ring.mul(K)(t, D)) with ring, btD
  have X := Ring.add_mem at K, f(Ring.add(K)(x, Ring.mul(K)(t, Ring.one(K)))), Ring.neg(K)(Ring.add(K)(f(x), Ring.mul(K)(t, D))) with ring, aIn, nb
  rw (mulEq with c, scalar, Ring.add(K)(f(Ring.add(K)(x, Ring.mul(K)(t, Ring.one(K)))), Ring.neg(K)(Ring.add(K)(f(x), Ring.mul(K)(t, D)))), X)
  obtain ⟨XIn, XNn⟩ := NormedField.norm_real at K, absK, Ring.add(K)(f(Ring.add(K)(x, Ring.mul(K)(t, Ring.one(K)))), Ring.neg(K)(Ring.add(K)(f(x), Ring.mul(K)(t, D)))) with nf, X
  obtain ⟨tRIn, tNn⟩ := NormedField.norm_real at K, absK, t with nf, tIn
  have xR : Real(absK(Ring.add(K)(f(Ring.add(K)(x, Ring.mul(K)(t, Ring.one(K)))), Ring.neg(K)(Ring.add(K)(f(x), Ring.mul(K)(t, D)))))) by exact XIn
  have sw : absK(c) * absK(Ring.add(K)(f(Ring.add(K)(x, Ring.mul(K)(t, Ring.one(K)))), Ring.neg(K)(Ring.add(K)(f(x), Ring.mul(K)(t, D))))) = absK(Ring.add(K)(f(Ring.add(K)(x, Ring.mul(K)(t, Ring.one(K)))), Ring.neg(K)(Ring.add(K)(f(x), Ring.mul(K)(t, D))))) * absK(c) by ring
  rw sw
  exact frechetScalar.scale_arith at absK(Ring.add(K)(f(Ring.add(K)(x, Ring.mul(K)(t, Ring.one(K)))), Ring.neg(K)(Ring.add(K)(f(x), Ring.mul(K)(t, D))))), absK(t), absK(c), e, e / (absK(c) + (1:R)) with r, cNn, tNn, fNn, fDef

-- The map t ↦ t D from the scalars into W is continuous and linear.
theorem frechetScalar.line_clm (K absK W normW D L : Set)
  requires scalars : RealOrComplexScalars(K, absK)
  requires normed : NormedSpace(W, K, absK, normW)
  requires direction : D ∈ Module.carrier(W)
  requires linear : ∀ t ∈ Ring.carrier(K), L(t) = Module.smul(W)(t, D)
  requires function : L : Ring.carrier(K) → Module.carrier(W)
  shows ContinuousLinearMap(L, selfModule(K), absK, W, normW, K)
proof
  have ntf := RealOrComplexScalars.nontrivially_normed with scalars
  have nf := ntf.left
  have selfN := RealOrComplexScalars.self_normed with scalars
  have ring := nf.right.right.left.left
  have modK := Ring.to_module at K with ring
  have nW := normed
  obtain ⟨nfW, modW, ngW, lawW⟩ := nW
  have mW := modW
  obtain ⟨shape, ringR, addF, zeroIn, negF, smulF, additive, smulAdd, addSmul, mulSmul, oneSmul⟩ := mW
  have carEq : Module.carrier(selfModule(K)) = Ring.carrier(K)
    unfold selfModule
    simp [Module.mk.carrier]
  have smulEq : Module.smul(selfModule(K)) = Ring.mul(K)
    unfold selfModule
    simp [Module.mk.smul]
  have addEq : Module.add(selfModule(K)) = Ring.add(K)
    unfold selfModule
    simp [Module.mk.add]
  have lin : IsLinearMap(L, selfModule(K), W, K)
    unfold IsLinearMap
    rw [carEq, smulEq, addEq]
    refine ⟨modK, modW, function, ?_, ?_⟩
    . intros v hv w hw
      rw carEq at hv
      rw carEq at hw
      have vw := Ring.add_mem at K, v, w with ring, hv, hw
      rw [(linear with Ring.add(K)(v, w), vw), (linear with v, hv), (linear with w, hw)]
      exact addSmul with v, hv, w, hw, D, direction
    . intros c hc v hv
      rw carEq at hv
      have cv := Ring.mul_mem at K, c, v with ring, hc, hv
      rw [(linear with Ring.mul(K)(c, v), cv), (linear with v, hv)]
      exact mulSmul with c, hc, v, hv, D, direction
  apply (ContinuousLinearMap.iff_bounded at L, selfModule(K), K, absK, absK, W, normW with selfN, normed, ntf, lin).backward
  obtain ⟨dIn, dNn⟩ := NormedSpace.norm_real at W, K, absK, normW, D with normed, direction
  have dR : Real(normW(D)) by exact dIn
  refine ⟨normW(D), ?_⟩
  unfold LinearBound
  rw carEq
  refine ⟨dIn, dNn, ?_⟩
  intros v hv
  rw (linear with v, hv)
  rw (lawW with v, hv, D, direction)
  obtain ⟨vIn, vNn⟩ := NormedField.norm_real at K, absK, v with nf, hv
  have vR : Real(absK(v)) by exact vIn
  have sw : absK(v) * normW(D) = normW(D) * absK(v) by ring
  rw sw
  exact realLe.reflexive

-- The two directions of HasDerivAt.iff_fderiv; the converse needs D ∈ W,
-- which the Fréchet side does not record.
theorem HasDerivAt.to_fderiv (f K absK W normW D x L : Set)
  requires scalars : RealOrComplexScalars(K, absK)
  requires normed : NormedSpace(W, K, absK, normW)
  requires linear : ∀ t ∈ Ring.carrier(K), L(t) = Module.smul(W)(t, D)
  requires function : L : Ring.carrier(K) → Module.carrier(W)
  requires map : f : Ring.carrier(K) → Module.carrier(W)
  requires der : HasDerivAt(f, K, absK, W, normW, D, x)
  shows HasFDerivAt(f, selfModule(K), absK, W, normW, K, L, x)
proof
  have ntf := RealOrComplexScalars.nontrivially_normed with scalars
  have nf := ntf.left
  have comm := nf.right.left
  have selfN := RealOrComplexScalars.self_normed with scalars
  have ring := nf.right.right.left.left
  have nW := normed
  obtain ⟨nfW, modW, ngW, lawW⟩ := nW
  have mW := modW
  obtain ⟨shape, ringR, addF, zeroIn, negF, smulF, additive, smulAdd, addSmul, mulSmul, oneSmul⟩ := mW
  have carEq : Module.carrier(selfModule(K)) = Ring.carrier(K)
    unfold selfModule
    simp [Module.mk.carrier]
  have smulEq : Module.smul(selfModule(K)) = Ring.mul(K)
    unfold selfModule
    simp [Module.mk.smul]
  have addEq : Module.add(selfModule(K)) = Ring.add(K)
    unfold selfModule
    simp [Module.mk.add]
  have oneIn := Ring.one_mem at K with ring
  have d2 := der
  unfold HasDerivAt at d2
  unfold HasLineDerivAt at d2
  rw [carEq, smulEq, addEq] at d2
  obtain ⟨xIn, _, DIn, approx⟩ := d2
  have clm := frechetScalar.line_clm at K, absK, W, normW, D, L with scalars, normed, DIn, linear, function
  have fx := FunctionBetween.apply_closed with map, xIn
  unfold HasFDerivAt
  rw [carEq, addEq]
  refine ⟨xIn, fx, clm, ?_⟩
  intros e eIn ePos
  obtain ⟨d, dIn, dPos, est⟩ := approx with e, eIn, ePos
  refine ⟨d, dIn, dPos, ?_⟩
  intros h hh small
  rw carEq at hh
  have xh := Ring.add_mem at K, x, h with ring, xIn, hh
  have fxh := FunctionBetween.apply_closed with map, xh
  refine ⟨fxh, ?_⟩
  have r := est with h, hh, small
  rw (frechetScalar.mul_one at K, h with comm, hh) at r
  rw (linear with h, hh)
  exact r

theorem HasDerivAt.of_fderiv (f K absK W normW D x L : Set)
  requires scalars : RealOrComplexScalars(K, absK)
  requires normed : NormedSpace(W, K, absK, normW)
  requires linear : ∀ t ∈ Ring.carrier(K), L(t) = Module.smul(W)(t, D)
  requires direction : D ∈ Module.carrier(W)
  requires der : HasFDerivAt(f, selfModule(K), absK, W, normW, K, L, x)
  shows HasDerivAt(f, K, absK, W, normW, D, x)
proof
  have ntf := RealOrComplexScalars.nontrivially_normed with scalars
  have nf := ntf.left
  have comm := nf.right.left
  have selfN := RealOrComplexScalars.self_normed with scalars
  have ring := nf.right.right.left.left
  have nW := normed
  obtain ⟨nfW, modW, ngW, lawW⟩ := nW
  have mW := modW
  obtain ⟨shape, ringR, addF, zeroIn, negF, smulF, additive, smulAdd, addSmul, mulSmul, oneSmul⟩ := mW
  have carEq : Module.carrier(selfModule(K)) = Ring.carrier(K)
    unfold selfModule
    simp [Module.mk.carrier]
  have smulEq : Module.smul(selfModule(K)) = Ring.mul(K)
    unfold selfModule
    simp [Module.mk.smul]
  have addEq : Module.add(selfModule(K)) = Ring.add(K)
    unfold selfModule
    simp [Module.mk.add]
  have oneIn := Ring.one_mem at K with ring
  have oneV : Ring.one(K) ∈ Module.carrier(selfModule(K))
    rw carEq
    exact oneIn
  have line := HasFDerivAt.line at selfModule(K), K, absK, absK, W, normW, f, L, Ring.one(K), x with selfN, normed, ntf, der, oneV
  rw [(linear with Ring.one(K), oneIn), (oneSmul with D, direction)] at line
  unfold HasDerivAt
  exact line

-- The line t ↦ t E through E in a K-module, as a graph on the scalars.
defgraph frechetLine (K W E : Set) (t ∈ Ring.carrier(K)) : Module.carrier(W) :=
  Module.smul(W)(t, E)
requires module : Module(W, K) ∧ E ∈ Module.carrier(W)
proof
  obtain ⟨mod, eIn⟩ := module
  have ring := Module.ring at W, K with mod
  exact Module.smul_mem at K, W, t, E with ring, mod, member, eIn

-- One-variable derivatives are Fréchet derivatives t ↦ t D.
theorem HasDerivAt.iff_fderiv (f K absK W normW D x L : Set)
  requires scalars : RealOrComplexScalars(K, absK)
  requires normed : NormedSpace(W, K, absK, normW)
  requires linear : ∀ t ∈ Ring.carrier(K), L(t) = Module.smul(W)(t, D)
  requires function : L : Ring.carrier(K) → Module.carrier(W)
  requires map : f : Ring.carrier(K) → Module.carrier(W)
  shows HasDerivAt(f, K, absK, W, normW, D, x) ↔
    HasFDerivAt(f, selfModule(K), absK, W, normW, K, L, x)
proof
  sorry

-- The chain rule in one variable.
theorem HasDerivAt.comp (K absK W normW f g h D E x : Set)
  requires scalars : RealOrComplexScalars(K, absK)
  requires normed : NormedSpace(W, K, absK, normW)
  requires inner : HasDerivAt(f, K, absK, selfModule(K), absK, D, x)
  requires outer : HasDerivAt(g, K, absK, W, normW, E, f(x))
  requires composite : ∀ y ∈ Ring.carrier(K), h(y) = g(f(y))
  requires innerMap : f : Ring.carrier(K) → Ring.carrier(K)
  requires outerMap : g : Ring.carrier(K) → Module.carrier(W)
  shows HasDerivAt(h, K, absK, W, normW, Module.smul(W)(D, E), x)
proof
  have ntf := RealOrComplexScalars.nontrivially_normed with scalars
  have nf := ntf.left
  have selfN := RealOrComplexScalars.self_normed with scalars
  have ring := nf.right.right.left.left
  have modK := Ring.to_module at K with ring
  have modW := normed.right.left
  have mW := modW
  obtain ⟨shape, ringR, addF, zeroIn, negF, smulF, additive, smulAdd, addSmul, mulSmul, oneSmul⟩ := mW
  have carEq : Module.carrier(selfModule(K)) = Ring.carrier(K)
    unfold selfModule
    simp [Module.mk.carrier]
  have smulEq : Module.smul(selfModule(K)) = Ring.mul(K)
    unfold selfModule
    simp [Module.mk.smul]
  have i2 := inner
  unfold HasDerivAt at i2
  unfold HasLineDerivAt at i2
  obtain ⟨xIn, _, DIn, _⟩ := i2
  have o2 := outer
  unfold HasDerivAt at o2
  unfold HasLineDerivAt at o2
  obtain ⟨_, _, EIn, _⟩ := o2
  rw carEq at xIn
  rw carEq at DIn
  have DV : D ∈ Module.carrier(selfModule(K))
    rw carEq
    exact DIn
  have DE := Module.smul_mem at K, W, D, E with ring, modW, DIn, EIn
  have req1 : Module(selfModule(K), K) ∧ D ∈ Module.carrier(selfModule(K)) by exact ⟨modK, DV⟩
  have req2 : Module(W, K) ∧ E ∈ Module.carrier(W) by exact ⟨modW, EIn⟩
  have req3 : Module(W, K) ∧ Module.smul(W)(D, E) ∈ Module.carrier(W) by exact ⟨modW, DE⟩
  have fn1 := frechetLine.function with req1
  have fn2 := frechetLine.function with req2
  have fn3 := frechetLine.function with req3
  have lin1 : ∀ t ∈ Ring.carrier(K), frechetLine(K, selfModule(K), D)(t) = Module.smul(selfModule(K))(t, D)
    intros t ht
    exact frechetLine.value with req1, ht
  have lin2 : ∀ t ∈ Ring.carrier(K), frechetLine(K, W, E)(t) = Module.smul(W)(t, E)
    intros t ht
    exact frechetLine.value with req2, ht
  have lin3 : ∀ t ∈ Ring.carrier(K), frechetLine(K, W, Module.smul(W)(D, E))(t) = Module.smul(W)(t, Module.smul(W)(D, E))
    intros t ht
    exact frechetLine.value with req3, ht
  rw carEq at fn1
  have fn1b : frechetLine(K, selfModule(K), D) : Ring.carrier(K) → Module.carrier(selfModule(K))
    rw carEq
    exact fn1
  have innerMap2 : f : Ring.carrier(K) → Module.carrier(selfModule(K))
    rw carEq
    exact innerMap
  have fF := HasDerivAt.to_fderiv at f, K, absK, selfModule(K), absK, D, x, frechetLine(K, selfModule(K), D) with scalars, selfN, lin1, fn1b, innerMap2, inner
  have gF := HasDerivAt.to_fderiv at g, K, absK, W, normW, E, f(x), frechetLine(K, W, E) with scalars, normed, lin2, fn2, outerMap, outer
  have comp2 : ∀ y ∈ Module.carrier(selfModule(K)), h(y) = g(f(y))
    rw carEq
    exact composite
  have compL : ∀ u ∈ Module.carrier(selfModule(K)), frechetLine(K, W, Module.smul(W)(D, E))(u) = frechetLine(K, W, E)(frechetLine(K, selfModule(K), D)(u))
    intros u hu
    rw carEq at hu
    rw [(lin3 with u, hu), (lin1 with u, hu), smulEq]
    have uD := Ring.mul_mem at K, u, D with ring, hu, DIn
    rw (lin2 with Ring.mul(K)(u, D), uD)
    rw (mulSmul with u, hu, D, DIn, E, EIn)
  have fn3b : frechetLine(K, W, Module.smul(W)(D, E)) : Module.carrier(selfModule(K)) → Module.carrier(W)
    rw carEq
    exact fn3
  have hF := HasFDerivAt.comp at selfModule(K), K, absK, absK, W, normW, selfModule(K), absK, f, g, h, frechetLine(K, selfModule(K), D), frechetLine(K, W, E), frechetLine(K, W, Module.smul(W)(D, E)), x with selfN, normed, ntf, selfN, fF, gF, comp2, compL, fn3b
  exact HasDerivAt.of_fderiv at h, K, absK, W, normW, Module.smul(W)(D, E), x, frechetLine(K, W, Module.smul(W)(D, E)) with scalars, normed, lin3, DE, hF

-- Partial derivatives in ℝⁿ: a map on an open subset of ℝⁿ is C¹ when its
-- partial derivatives along the standard basis exist and are continuous.
theorem ContDiffOn.of_partials (f W normW U : Set, n : Nat)
  requires normed : NormedSpace(W, realRing, realAbs, normW)
  requires open : U ∈ TopologicalSpace.opens(spaceTopology(euclideanModule(realRing, n),
    euclideanNorm(realRing, realAbs, n)))
  requires partials : ∀ i ∈ n, ∀ x ∈ U, ∃ D,
    HasLineDerivAt(f, euclideanModule(realRing, n), euclideanNorm(realRing, realAbs, n),
      W, normW, realRing, realAbs, standardBasis(realRing, n)(i), D, x)
  requires continuous : ∀ i ∈ n,
    ContinuousOnSet(lineDerivGraph(f, euclideanModule(realRing, n),
      euclideanNorm(realRing, realAbs, n), W, normW, realRing, realAbs,
      standardBasis(realRing, n)(i)), euclideanModule(realRing, n),
      euclideanNorm(realRing, realAbs, n), W, normW, U)
  shows ContDiffOn(f, euclideanModule(realRing, n), euclideanNorm(realRing, realAbs, n),
    W, normW, realRing, realAbs, U, (1:N))
proof
  sorry

end FrechetScalar
