-- Inner-product spaces over ℝ and ℂ: the scalar fields with their
-- conjugation, inner products linear in the second argument and
-- conjugate-symmetric, the induced norm, Cauchy–Schwarz and the norm laws;
-- orthogonality and orthonormal families, expansion in an orthonormal
-- basis, Bessel and Parseval, orthogonal projection onto the span of an
-- orthonormal family, and the existence of orthonormal bases; Euclidean
-- space 𝕜ⁿ with its standard basis; adjoints, self-adjoint and positive
-- operators, the spectral theorem, square roots of positive operators,
-- and the ℓ² operator norm of a linear map against its Frobenius norm.
-- Part of the GRH blueprint.
-- Planned home: Analysis/InnerProductSpace.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Normed.InnerProduct
import GRH.Normed.Spaces

section InnerProducts
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Section: Definitions
-- The scalars 𝕜 are ℝ or ℂ (Mathlib's RCLike): the ring, its absolute
-- value, its conjugation (the identity on ℝ), and its embedding of ℝ.
predicate RCLike (K absK conj ofReal : Set) :=
  (K = realRing ∧ absK = realAbs ∧ conj = identity(ℝ) ∧ ofReal = identity(ℝ)) ∨
  (K = complexRing ∧ absK = complexAbs ∧ conj = complexConj ∧
    ofReal = complexOfReal)

-- An inner product on the K-module V (Mathlib's InnerProductSpace 𝕜 E,
-- with Mathlib's convention: conjugate-linear in the first argument,
-- linear in the second), with its norm ‖v‖ = √⟨v, v⟩, recorded as the
-- graph norm with ofReal(‖v‖²) = ⟨v, v⟩.
predicate InnerProductSpace (V K absK conj ofReal inner norm : Set) :=
  RCLike(K, absK, conj, ofReal) ∧ Module(V, K) ∧
  (inner : Module.carrier(V) × Module.carrier(V) → Ring.carrier(K)) ∧
  (norm : Module.carrier(V) → ℝ) ∧
  (∀ v ∈ Module.carrier(V), ∀ w ∈ Module.carrier(V),
    inner(w, v) = conj(inner(v, w))) ∧
  (∀ u ∈ Module.carrier(V), ∀ v ∈ Module.carrier(V), ∀ w ∈ Module.carrier(V),
    inner(u, Module.add(V)(v, w)) = Ring.add(K)(inner(u, v), inner(u, w))) ∧
  (∀ c ∈ Ring.carrier(K), ∀ u ∈ Module.carrier(V), ∀ v ∈ Module.carrier(V),
    inner(u, Module.smul(V)(c, v)) = Ring.mul(K)(c, inner(u, v))) ∧
  (∀ v ∈ Module.carrier(V), realZero ≤ norm(v) ∧
    inner(v, v) = ofReal(R[norm(v) * norm(v)])) ∧
  (∀ v ∈ Module.carrier(V), inner(v, v) = Ring.zero(K) → v = Module.zero(V))

-- Orthogonality, orthonormal families indexed by I, and orthonormal bases
-- indexed by n = {0, …, n − 1}.
predicate InnerOrthogonal (inner v w K : Set) := inner(v, w) = Ring.zero(K)
predicate Orthonormal (V K inner e I : Set) :=
  (∀ i ∈ I, e(i) ∈ Module.carrier(V)) ∧
  (∀ i ∈ I, inner(e(i), e(i)) = Ring.one(K)) ∧
  (∀ i ∈ I, ∀ j ∈ I, i ≠ j → inner(e(i), e(j)) = Ring.zero(K))
predicate OrthonormalBasis (V K inner e : Set, n : Nat) :=
  Orthonormal(V, K, inner, e, n) ∧ SpansModule(V, K, e, n)

-- The coefficient terms ⟨e(i), v⟩ e(i) of the expansion of v, and the
-- expansion Σ_{i<n} ⟨e(i), v⟩ e(i), which is the orthogonal projection of
-- v onto the span of e.
defgraph expansionTerms (V inner e v : Set) (i ∈ ℕ) : Module.carrier(V) :=
  Module.smul(V)(inner(e(i), v), e(i))
requires module : ∃ K, Module(V, K) ∧ ∀ i ∈ ℕ,
  inner(e(i), v) ∈ Ring.carrier(K) ∧ e(i) ∈ Module.carrier(V)
proof
  obtain ⟨K, mod, vals⟩ := module
  have both := vals with i, member
  have a := both.left
  have b := both.right
  exact Module.smul_mem with *

def orthogonalProjection (V inner e v : Set, n : Nat) : Set :=
  groupFiniteSum(Module.additive(V), n, expansionTerms(V, inner, e, v))

-- Section: Euclidean space
-- 𝕜ⁿ: the functions n → 𝕜 with pointwise operations, the inner product
-- ⟨x, y⟩ = Σ conj(x i) y i, and the norm √(Σ |x i|²) (Mathlib's
-- EuclideanSpace 𝕜 (Fin n)).
def euclideanModule (K : Set, n : Nat) : Set :=
  Module.mk(functionSpace(n, Ring.carrier(K)),
    { p ∈ (functionSpace(n, Ring.carrier(K)) × functionSpace(n, Ring.carrier(K))) ×
        functionSpace(n, Ring.carrier(K)) |
      ∀ i ∈ n, snd(p)(i) = Ring.add(K)(fst(fst(p))(i), snd(fst(p))(i)) },
    n × {Ring.zero(K)},
    { p ∈ functionSpace(n, Ring.carrier(K)) × functionSpace(n, Ring.carrier(K)) |
      ∀ i ∈ n, snd(p)(i) = Ring.neg(K)(fst(p)(i)) },
    { p ∈ (Ring.carrier(K) × functionSpace(n, Ring.carrier(K))) ×
        functionSpace(n, Ring.carrier(K)) |
      ∀ i ∈ n, snd(p)(i) = Ring.mul(K)(fst(fst(p)), snd(fst(p))(i)) })

defgraph euclideanInnerTerms (K conj x y : Set) (i ∈ ℕ) : Ring.carrier(K) :=
  Ring.mul(K)(conj(x(i)), y(i))
requires values : Ring(K) ∧ (∀ i ∈ ℕ, conj(x(i)) ∈ Ring.carrier(K) ∧
  y(i) ∈ Ring.carrier(K))
proof
  obtain ⟨ring, vals⟩ := values
  have both := vals with i, member
  exact Ring.mul_mem at K, conj(x(i)), y(i) with ring, both.left, both.right

defgraph euclideanSquareTerms (absK x : Set) (i ∈ ℕ) : ℝ :=
  R[absK(x(i)) * absK(x(i))]
requires values : ∀ i ∈ ℕ, absK(x(i)) ∈ ℝ
proof
  have a := values with i, member
  have aR : Real(absK(x(i))) by exact a
  typecheck

def euclideanInner (K conj : Set, n : Nat) : Set :=
  { p ∈ (functionSpace(n, Ring.carrier(K)) × functionSpace(n, Ring.carrier(K))) ×
      Ring.carrier(K) |
    snd(p) = groupFiniteSum(Ring.additive(K), n,
      euclideanInnerTerms(K, conj, fst(fst(p)), snd(fst(p)))) }

def euclideanNorm (K absK : Set, n : Nat) : Set :=
  { p ∈ functionSpace(n, Ring.carrier(K)) × ℝ |
    snd(p) = realSqrt(realFiniteSum(euclideanSquareTerms(absK, fst(p)), n)) }

-- The standard basis vector e_j of 𝕜ⁿ: 1 at j, 0 elsewhere.
def standardBasisVector (K : Set, n : Nat, j : Set) : Set :=
  { p ∈ n × Ring.carrier(K) |
    (fst(p) = j ∧ snd(p) = Ring.one(K)) ∨ (fst(p) ≠ j ∧ snd(p) = Ring.zero(K)) }
defgraph standardBasis (K : Set, n : Nat) (j ∈ ℕ) : 𝒫(n × Ring.carrier(K)) :=
  standardBasisVector(K, n, j)
proof
  apply powerset.membership_iff.backward
  intros p hp
  have hp2 := standardBasisVector.membership.forward with hp
  exact hp2.left

-- Section: Operators
-- The adjoint T* of T: ⟨T* v, w⟩ = ⟨v, T w⟩. T is self-adjoint when it is
-- its own adjoint, and positive when moreover ⟨v, T v⟩ is a nonnegative
-- real (Mathlib's IsPositive); strictly positive when it is positive for
-- v ≠ 0 (Mathlib's IsStrictlyPositive for matrices).
predicate IsAdjoint (inner S T V : Set) :=
  ∀ v ∈ Module.carrier(V), ∀ w ∈ Module.carrier(V),
    inner(S(v), w) = inner(v, T(w))
predicate SelfAdjoint (inner T V : Set) := IsAdjoint(inner, T, T, V)
predicate PositiveOperator (inner ofReal T V : Set) :=
  SelfAdjoint(inner, T, V) ∧
  (∀ v ∈ Module.carrier(V), ∃ t ∈ ℝ, realZero ≤ t ∧ inner(v, T(v)) = ofReal(t))
predicate StrictlyPositiveOperator (inner ofReal T V : Set) :=
  SelfAdjoint(inner, T, V) ∧
  (∀ v ∈ Module.carrier(V), v ≠ Module.zero(V) →
    ∃ t ∈ ℝ, realZero < t ∧ inner(v, T(v)) = ofReal(t))

-- Section: Laws of inner products
-- Conjugation on ℝ or ℂ is an involutive ring endomorphism.
theorem RCLike.conj_laws (K absK conj ofReal : Set)
  requires scalars : RCLike(K, absK, conj, ofReal)
  shows (∀ z ∈ Ring.carrier(K), conj(z) ∈ Ring.carrier(K) ∧ conj(conj(z)) = z) ∧
    (∀ z ∈ Ring.carrier(K), ∀ w ∈ Ring.carrier(K),
      conj(Ring.add(K)(z, w)) = Ring.add(K)(conj(z), conj(w)) ∧
      conj(Ring.mul(K)(z, w)) = Ring.mul(K)(conj(z), conj(w))) ∧
    conj(Ring.zero(K)) = Ring.zero(K)
proof
  cases scalars with re | co
  . obtain ⟨kEq, aEq, cEq, oEq⟩ := re
    have comm := realRing.comm_ring
    have ring := comm.left
    have zeroIn := Ring.zero_mem at realRing with ring
    rw realRing.carrierOf at zeroIn
    refine ⟨?_, ?_, ?_⟩
    . intros z hz
      rw [kEq, cEq]
      rw [kEq, realRing.carrierOf] at hz
      have a := identity.apply at z, ℝ with hz
      rw [a, a, realRing.carrierOf]
      exact ⟨hz, rfl⟩
    . intros z hz w hw
      rw [kEq, cEq]
      rw kEq at hz
      rw kEq at hw
      have zw := Ring.add_mem at realRing, z, w with ring, hz, hw
      have zw2 := Ring.mul_mem at realRing, z, w with ring, hz, hw
      rw realRing.carrierOf at hz
      rw realRing.carrierOf at hw
      rw realRing.carrierOf at zw
      rw realRing.carrierOf at zw2
      have a1 := identity.apply at z, ℝ with hz
      have a2 := identity.apply at w, ℝ with hw
      have a3 := identity.apply at Ring.add(realRing)(z, w), ℝ with zw
      have a4 := identity.apply at Ring.mul(realRing)(z, w), ℝ with zw2
      rw [a1, a2, a3, a4]
      exact ⟨rfl, rfl⟩
    . rw [kEq, cEq]
      exact identity.apply at Ring.zero(realRing), ℝ with zeroIn
  . obtain ⟨kEq, aEq, cEq, oEq⟩ := co
    refine ⟨?_, ?_, ?_⟩
    . intros z hz
      rw [kEq, cEq, complexRing.carrierOf]
      rw [kEq, complexRing.carrierOf] at hz
      have mem : complexConj(z) ∈ complexCarrier
        obtain ⟨a, aReal, b, bReal, shape⟩ := complexCarrier.cases with hz
        rw [shape, complexConj.pair]
        exact complexCarrier.pair at a, R[-b]
      exact ⟨mem, (complexConj.involutive with hz)⟩
    . intros z hz w hw
      rw [kEq, cEq, complexRing.addOf, complexRing.mulOf]
      rw [kEq, complexRing.carrierOf] at hz
      rw [kEq, complexRing.carrierOf] at hw
      exact ⟨(complexConj.add with hz, hw), (complexConj.mul with hz, hw)⟩
    . rw [kEq, cEq, complexRing.zeroOf]
      unfold complexZero
      rw complexConj.pair
      have z : R[-realZero] = realZero by ring
      rw z

-- The embedding of ℝ into the scalars is additive, injective, and lands
-- in the scalars.
theorem RCLike.ofReal_laws (K absK conj ofReal : Set)
  requires scalars : RCLike(K, absK, conj, ofReal)
  shows (∀ x ∈ ℝ, ofReal(x) ∈ Ring.carrier(K)) ∧
    (∀ x ∈ ℝ, ∀ y ∈ ℝ, Ring.add(K)(ofReal(x), ofReal(y)) = ofReal(R[x + y])) ∧
    (∀ x ∈ ℝ, ∀ y ∈ ℝ, ofReal(x) = ofReal(y) → x = y)
proof
  cases scalars with re | co
  . obtain ⟨kEq, aEq, cEq, oEq⟩ := re
    rw [kEq, oEq, realRing.carrierOf]
    have addEq : Ring.add(realRing) = realAdd
      unfold realRing
      simp [Ring.mk.add]
    refine ⟨?_, ?_, ?_⟩
    . intros x hx
      rw (identity.apply at x, ℝ with hx)
      exact hx
    . intros x hx y hy
      have xR : Real(x) by exact hx
      have yR : Real(y) by exact hy
      have s : x + y ∈ ℝ by typecheck
      rw [(identity.apply at x, ℝ with hx), (identity.apply at y, ℝ with hy), (identity.apply at R[x + y], ℝ with s), addEq]
    . intros x hx y hy same
      rw [(identity.apply at x, ℝ with hx), (identity.apply at y, ℝ with hy)] at same
      exact same
  . obtain ⟨kEq, aEq, cEq, oEq⟩ := co
    rw [kEq, oEq, complexRing.carrierOf, complexRing.addOf]
    refine ⟨?_, ?_, ?_⟩
    . intros x hx
      exact FunctionBetween.apply_closed with complexOfReal.function, hx
    . intros x hx y hy
      have xR : Real(x) by exact hx
      have yR : Real(y) by exact hy
      rw (complexOfReal.add at x, y)
    . intros x hx y hy same
      have xR : Real(x) by exact hx
      have yR : Real(y) by exact hy
      exact complexOfReal.injective with same

-- A finite sum whose terms vanish off one index j is the term at j.
theorem groupFiniteSum.single_support (G F j g : Set)
  requires abelian : AbelianGroup(G)
  requires finite : Finite(F)
  requires index : j ∈ F
  requires value : g(j) ∈ G.carrier
  requires vanish : ∀ i ∈ F, i ≠ j → g(i) = G.one
  shows groupFiniteSum(G, F, g) = g(j)
proof
  have onJ : ∀ i ∈ F ∩ {j}, g(i) = g(i)
    intros i hi
    rfl
  have offJ : ∀ i ∈ F, i ∉ {j} → g(i) = G.one
    intros i hi notJ
    have ne : i ≠ j
      intro eq
      apply notJ
      rw eq
      exact singleton.self at j
    exact vanish with i, hi, ne
  have shape : F ∩ {j} = {j}
    ext y
    constructor
    . intro hy
      simp at hy
      simp
    . intro hy
      simp at hy
      simp
  have values : ∀ i ∈ F ∩ {j}, g(i) ∈ G.carrier
    intros i hi
    rw shape at hi
    simp at hi
    rw hi
    exact value
  have e := groupFiniteSum.extend_one at G, F, {j}, g, g with abelian, finite, onJ, offJ, values
  rw [e, shape]
  exact groupFiniteSum.singleton with abelian, value

-- The terms of the expansion, read at any natural number.
theorem expansionTerms.apply (V inner e v i : Set)
  requires index : i ∈ ℕ
  shows expansionTerms(V, inner, e, v)(i) =
    Module.smul(V)(inner(e(i), v), e(i))
proof
  have edge : (i, Module.smul(V)(inner(e(i), v), e(i))) ∈ expansionTerms(V, inner, e, v)
    apply expansionTerms.membership.backward
    exact ⟨i, index, rfl⟩
  have pairs : ∀ p ∈ expansionTerms(V, inner, e, v), ∃ a, ∃ b, p = (a, b)
    intros p hp
    obtain ⟨k, hk, pEq⟩ := expansionTerms.membership.forward with hp
    rw ← pEq
    exact ⟨k, Module.smul(V)(inner(e(k), v), e(k)), rfl⟩
  have functional : ∀ a, ∀ b, ∀ c, (a, b) ∈ expansionTerms(V, inner, e, v) → (a, c) ∈ expansionTerms(V, inner, e, v) → b = c
    intros a b c hb hc
    obtain ⟨k, hk, bEq⟩ := expansionTerms.membership.forward with hb
    obtain ⟨m, hm, cEq⟩ := expansionTerms.membership.forward with hc
    have pb := orderedPair.injective with bEq
    have pc := orderedPair.injective with cEq
    obtain ⟨ka, bb⟩ := pb
    obtain ⟨ma, cc⟩ := pc
    rw [← bb, ← cc, ka, ← ma]
  exact pairGraph.apply with pairs, functional, edge

theorem RCLike.normed_field (K absK conj ofReal : Set)
  requires scalars : RCLike(K, absK, conj, ofReal)
  shows NontriviallyNormedField(K, absK)
proof
  cases scalars with re | co
  . obtain ⟨kEq, aEq, cEq, oEq⟩ := re
    rw [kEq, aEq]
    exact NormedField.real
  . obtain ⟨kEq, aEq, cEq, oEq⟩ := co
    rw [kEq, aEq]
    exact NormedField.complex

-- The scalars form a commutative ring.
theorem RCLike.comm_ring (K absK conj ofReal : Set)
  requires scalars : RCLike(K, absK, conj, ofReal)
  shows CommRing(K)
proof
  have ntf := RCLike.normed_field with scalars
  exact ntf.left.right.left

-- Mathlib's RCLike.mul_conj: z z̄ = |z|².
theorem RCLike.mul_conj (K absK conj ofReal z : Set)
  requires scalars : RCLike(K, absK, conj, ofReal)
  requires member : z ∈ Ring.carrier(K)
  shows Ring.mul(K)(z, conj(z)) = ofReal(R[absK(z) * absK(z)])
proof
  cases scalars with re | co
  . obtain ⟨kEq, aEq, cEq, oEq⟩ := re
    rw [kEq, cEq, oEq, aEq]
    rw [kEq, realRing.carrierOf] at member
    have zR : Real(z) by exact member
    have mulEq : Ring.mul(realRing) = realMul
      unfold realRing
      simp [Ring.mk.mul]
    have a1 := identity.apply at z, ℝ with member
    have sq : realAbs(z) * realAbs(z) ∈ ℝ by typecheck
    have a2 := identity.apply at realAbs(z) * realAbs(z), ℝ with sq
    rw [a1, a2, mulEq]
    have m := abs.mul at z, z
    unfold abs at m
    have nn := realMulValue.square_nonnegative at z
    have o := abs.of_nonnegative at z * z with nn
    unfold abs at o
    rw [← m, o]
    rfl
  . obtain ⟨kEq, aEq, cEq, oEq⟩ := co
    rw [kEq, cEq, oEq, aEq, complexRing.mulOf]
    rw [kEq, complexRing.carrierOf] at member
    exact complexAbs.mul_conj with member

-- More laws of the embedding of ℝ: it is multiplicative, sends 0 and 1 to
-- 0 and 1, is fixed by conjugation, and preserves nonnegative values.
theorem RCLike.ofReal_more (K absK conj ofReal : Set)
  requires scalars : RCLike(K, absK, conj, ofReal)
  shows ofReal(R[0]) = Ring.zero(K) ∧ ofReal(R[1]) = Ring.one(K) ∧
    (∀ x ∈ ℝ, ∀ y ∈ ℝ, Ring.mul(K)(ofReal(x), ofReal(y)) = ofReal(R[x * y])) ∧
    (∀ x ∈ ℝ, conj(ofReal(x)) = ofReal(x)) ∧
    (∀ x ∈ ℝ, realZero ≤ x → absK(ofReal(x)) = x)
proof
  cases scalars with re | co
  . obtain ⟨kEq, aEq, cEq, oEq⟩ := re
    have mulEq : Ring.mul(realRing) = realMul
      unfold realRing
      simp [Ring.mk.mul]
    have zeroEq : Ring.zero(realRing) = realZero
      unfold realRing
      simp [Ring.mk.zero]
    have oneEq : Ring.one(realRing) = realOne
      unfold realRing
      simp [Ring.mk.one]
    have z : R[0] ∈ ℝ by typecheck
    have o : R[1] ∈ ℝ by typecheck
    refine ⟨?_, ?_, ?_, ?_, ?_⟩
    . rw [kEq, oEq]
      rw [(identity.apply at R[0], ℝ with z), zeroEq]
    . rw [kEq, oEq]
      rw [(identity.apply at R[1], ℝ with o), oneEq]
    . intros x hx y hy
      rw [kEq, oEq]
      have xR : Real(x) by exact hx
      have yR : Real(y) by exact hy
      have xy : x * y ∈ ℝ by typecheck
      rw [(identity.apply at x, ℝ with hx), (identity.apply at y, ℝ with hy), (identity.apply at R[x * y], ℝ with xy), mulEq]
    . intros x hx
      rw [cEq, oEq]
      rw [(identity.apply at x, ℝ with hx), (identity.apply at x, ℝ with hx)]
    . intros x hx nn
      rw [aEq, oEq]
      have xR : Real(x) by exact hx
      rw (identity.apply at x, ℝ with hx)
      have a := abs.of_nonnegative at x with nn
      unfold abs at a
      exact a
  . obtain ⟨kEq, aEq, cEq, oEq⟩ := co
    rw [kEq, oEq, complexRing.zeroOf, complexRing.oneOf]
    refine ⟨complexOfReal.zero, complexOfReal.one, ?_, ?_, ?_⟩
    . intros x hx y hy
      rw [kEq, oEq, complexRing.mulOf]
      have xR : Real(x) by exact hx
      have yR : Real(y) by exact hy
      rw (complexOfReal.mul at x, y)
    . intros x hx
      rw [cEq, oEq]
      have xR : Real(x) by exact hx
      exact complexConj.of_real at x
    . intros x hx nn
      rw [aEq, oEq]
      have xR : Real(x) by exact hx
      rw (complexAbs.of_real at x)
      exact abs.of_nonnegative at x with nn

-- |z̄| = |z|, and z + z̄ is a real number at most 2|z|.
theorem RCLike.conj_abs (K absK conj ofReal : Set)
  requires scalars : RCLike(K, absK, conj, ofReal)
  shows (∀ z ∈ Ring.carrier(K), absK(conj(z)) = absK(z)) ∧
    (∀ z ∈ Ring.carrier(K), ∃ r ∈ ℝ, Ring.add(K)(z, conj(z)) = ofReal(r) ∧
      r ≤ R[absK(z) + absK(z)])
proof
  cases scalars with re | co
  . obtain ⟨kEq, aEq, cEq, oEq⟩ := re
    rw [kEq, aEq, cEq, oEq, realRing.carrierOf]
    have addEq : Ring.add(realRing) = realAdd
      unfold realRing
      simp [Ring.mk.add]
    refine ⟨?_, ?_⟩
    . intros z hz
      rw (identity.apply at z, ℝ with hz)
    . intros z hz
      have zR : Real(z) by exact hz
      have zz : z + z ∈ ℝ by typecheck
      rw [(identity.apply at z, ℝ with hz), addEq]
      refine ⟨R[z + z], zz, ?_, ?_⟩
      . rw (identity.apply at R[z + z], ℝ with zz)
      . have u := abs.upper at z
        unfold abs at u
        have ab := abs.real at z
        unfold abs at ab
        linarith
  . obtain ⟨kEq, aEq, cEq, oEq⟩ := co
    rw [kEq, aEq, cEq, oEq, complexRing.carrierOf, complexRing.addOf]
    refine ⟨?_, ?_⟩
    . intros z hz
      exact complexAbs.conj with hz
    . intros z hz
      obtain ⟨a, aReal, b, bReal, shape⟩ := complexCarrier.cases with hz
      have aa : a + a ∈ ℝ by typecheck
      refine ⟨R[a + a], aa, ?_, ?_⟩
      . rw [shape, complexConj.pair, complexAdd.pair, (complexOfReal.value at R[a + a] with aa)]
        have e : R[b + -b] = R[0] by ring
        rw e
      . have r := complexAbs.re_le with hz
        have reEq : complexRe(z) = a
          rw shape
          unfold complexRe
          rw fst.pair
        rw reEq at r
        have u := abs.upper at a
        have aR : Real(abs(a)) by exact (abs.real at a)
        have cR : Real(complexAbs(z)) by exact (FunctionBetween.apply_closed with complexAbs.function, hz)
        linarith

-- The inner products of x against a family w, and of a family e against
-- v, as graphs over ℕ.
def innerAgainst (inner x w : Set) : Set := { (i, inner(x, w(i))) | i ∈ ℕ }
def innerCoefficients (inner e v : Set) : Set := { (i, inner(e(i), v)) | i ∈ ℕ }

theorem innerAgainst.apply (inner x w i : Set)
  requires index : i ∈ ℕ
  shows innerAgainst(inner, x, w)(i) = inner(x, w(i))
proof
  have edge : (i, inner(x, w(i))) ∈ innerAgainst(inner, x, w)
    apply innerAgainst.membership.backward
    exact ⟨i, index, rfl⟩
  have pairs : ∀ p ∈ innerAgainst(inner, x, w), ∃ a, ∃ b, p = (a, b)
    intros p hp
    obtain ⟨k, hk, pEq⟩ := innerAgainst.membership.forward with hp
    rw ← pEq
    exact ⟨k, inner(x, w(k)), rfl⟩
  have functional : ∀ a, ∀ b, ∀ c, (a, b) ∈ innerAgainst(inner, x, w) → (a, c) ∈ innerAgainst(inner, x, w) → b = c
    intros a b c hb hc
    obtain ⟨k, hk, bEq⟩ := innerAgainst.membership.forward with hb
    obtain ⟨m, hm, cEq⟩ := innerAgainst.membership.forward with hc
    obtain ⟨ka, bb⟩ := orderedPair.injective with bEq
    obtain ⟨ma, cc⟩ := orderedPair.injective with cEq
    rw [← bb, ← cc, ka, ← ma]
  exact pairGraph.apply with pairs, functional, edge

theorem innerCoefficients.apply (inner e v i : Set)
  requires index : i ∈ ℕ
  shows innerCoefficients(inner, e, v)(i) = inner(e(i), v)
proof
  have edge : (i, inner(e(i), v)) ∈ innerCoefficients(inner, e, v)
    apply innerCoefficients.membership.backward
    exact ⟨i, index, rfl⟩
  have pairs : ∀ p ∈ innerCoefficients(inner, e, v), ∃ a, ∃ b, p = (a, b)
    intros p hp
    obtain ⟨k, hk, pEq⟩ := innerCoefficients.membership.forward with hp
    rw ← pEq
    exact ⟨k, inner(e(k), v), rfl⟩
  have functional : ∀ a, ∀ b, ∀ c, (a, b) ∈ innerCoefficients(inner, e, v) → (a, c) ∈ innerCoefficients(inner, e, v) → b = c
    intros a b c hb hc
    obtain ⟨k, hk, bEq⟩ := innerCoefficients.membership.forward with hb
    obtain ⟨m, hm, cEq⟩ := innerCoefficients.membership.forward with hc
    obtain ⟨ka, bb⟩ := orderedPair.injective with bEq
    obtain ⟨ma, cc⟩ := orderedPair.injective with cEq
    rw [← bb, ← cc, ka, ← ma]
  exact pairGraph.apply with pairs, functional, edge

theorem orthogonalProjection.eq_sum (V inner e v : Set, n : Nat)
  shows orthogonalProjection(V, inner, e, v, n) =
    groupFiniteSum(Module.additive(V), n, expansionTerms(V, inner, e, v))
proof
  unfold orthogonalProjection
  rfl

section InnerProductLaws
variable (V K absK conj ofReal inner norm : Set)
hypothesis space : InnerProductSpace(V, K, absK, conj, ofReal, inner, norm)

-- Mathlib's inner_conj_symm.
theorem InnerProductSpace.conj_symm (v w : Set)
  requires memberV : v ∈ Module.carrier(V)
  requires memberW : w ∈ Module.carrier(V)
  shows conj(inner(v, w)) = inner(w, v)
proof
  obtain ⟨rc, mod, innerF, normF, symm, addR, smulR, normEq, definite⟩ := space
  obtain ⟨cl, rest⟩ := RCLike.conj_laws with rc
  have s := symm with w, memberW, v, memberV
  have p := FunctionBetween.apply_closed with innerF, (product.pair with memberW, memberV)
  have same : inner((w, v)) = inner(w, v)
    unfold Algebra.call2
    rfl
  rw same at p
  rw s
  exact (cl with inner(w, v), p).right

-- Mathlib's inner_smul_left and inner_smul_right.
theorem InnerProductSpace.smul_left (c v w : Set)
  requires scalar : c ∈ Ring.carrier(K)
  requires memberV : v ∈ Module.carrier(V)
  requires memberW : w ∈ Module.carrier(V)
  shows inner(Module.smul(V)(c, v), w) = Ring.mul(K)(conj(c), inner(v, w))
proof
  have sp := space
  obtain ⟨rc, mod, innerF, normF, symm, addR, smulR, normEq, definite⟩ := sp
  obtain ⟨cl, ops, cz⟩ := RCLike.conj_laws with rc
  have ring := Module.ring at V, K with mod
  have cv := Module.smul_mem at K, V, c, v with ring, mod, scalar, memberV
  have p := FunctionBetween.apply_closed with innerF, (product.pair with memberW, memberV)
  have same : inner((w, v)) = inner(w, v)
    unfold Algebra.call2
    rfl
  rw same at p
  rw (symm with w, memberW, Module.smul(V)(c, v), cv)
  rw (smulR with c, scalar, w, memberW, v, memberV)
  have o := ops with c, scalar, inner(w, v), p
  rw o.right
  rw (InnerProductSpace.conj_symm at V, K, absK, conj, ofReal, inner, norm, w, v with space, memberW, memberV)

theorem InnerProductSpace.smul_right (c v w : Set)
  requires scalar : c ∈ Ring.carrier(K)
  requires memberV : v ∈ Module.carrier(V)
  requires memberW : w ∈ Module.carrier(V)
  shows inner(v, Module.smul(V)(c, w)) = Ring.mul(K)(c, inner(v, w))
proof
  obtain ⟨rc, mod, innerF, normF, symm, addR, smulR, normEq, definite⟩ := space
  exact smulR with c, scalar, v, memberV, w, memberW

theorem InnerProductSpace.add_left (u v w : Set)
  requires memberU : u ∈ Module.carrier(V)
  requires memberV : v ∈ Module.carrier(V)
  requires memberW : w ∈ Module.carrier(V)
  shows inner(Module.add(V)(u, v), w) = Ring.add(K)(inner(u, w), inner(v, w))
proof
  have sp := space
  obtain ⟨rc, mod, innerF, normF, symm, addR, smulR, normEq, definite⟩ := sp
  obtain ⟨cl, ops, cz⟩ := RCLike.conj_laws with rc
  have ring := Module.ring at V, K with mod
  have uv := Module.add_mem at K, V, u, v with ring, mod, memberU, memberV
  have p1 := FunctionBetween.apply_closed with innerF, (product.pair with memberW, memberU)
  have p2 := FunctionBetween.apply_closed with innerF, (product.pair with memberW, memberV)
  have same1 : inner((w, u)) = inner(w, u)
    unfold Algebra.call2
    rfl
  have same2 : inner((w, v)) = inner(w, v)
    unfold Algebra.call2
    rfl
  rw same1 at p1
  rw same2 at p2
  rw (symm with w, memberW, Module.add(V)(u, v), uv)
  rw (addR with w, memberW, u, memberU, v, memberV)
  have o := ops with inner(w, u), p1, inner(w, v), p2
  rw o.left
  rw [(InnerProductSpace.conj_symm at V, K, absK, conj, ofReal, inner, norm, w, u with space, memberW, memberU), (InnerProductSpace.conj_symm at V, K, absK, conj, ofReal, inner, norm, w, v with space, memberW, memberV)]

theorem InnerProductSpace.zero_left (v : Set)
  requires member : v ∈ Module.carrier(V)
  shows inner(Module.zero(V), v) = Ring.zero(K)
proof
  have sp := space
  obtain ⟨rc, mod, innerF, normF, symm, addR, smulR, normEq, definite⟩ := sp
  obtain ⟨cl, ops, cz⟩ := RCLike.conj_laws with rc
  have ring := Module.ring at V, K with mod
  have zeroV := Module.zero_mem at K, V with ring, mod
  have zeroK := Ring.zero_mem at K with ring
  have rz : inner(v, Module.zero(V)) = Ring.zero(K)
    have zs := zero_smul at K, V, Module.zero(V) with ring, mod, zeroV
    have s := smulR with Ring.zero(K), zeroK, v, member, Module.zero(V), zeroV
    rw zs at s
    rw s
    have p := FunctionBetween.apply_closed with innerF, (product.pair with member, zeroV)
    have same : inner((v, Module.zero(V))) = inner(v, Module.zero(V))
      unfold Algebra.call2
      rfl
    rw same at p
    have pr := Ring.parts with ring
    exact IsRing.zero_mul with pr, p
  rw (symm with v, member, Module.zero(V), zeroV)
  rw [rz, cz]

theorem InnerProductSpace.zero_right (v : Set)
  requires member : v ∈ Module.carrier(V)
  shows inner(v, Module.zero(V)) = Ring.zero(K)
proof
  have sp := space
  obtain ⟨rc, mod, innerF, normF, symm, addR, smulR, normEq, definite⟩ := sp
  obtain ⟨cl, ops, cz⟩ := RCLike.conj_laws with rc
  have ring := Module.ring at V, K with mod
  have zeroV := Module.zero_mem at K, V with ring, mod
  rw (symm with Module.zero(V), zeroV, v, member)
  rw (InnerProductSpace.zero_left at V, K, absK, conj, ofReal, inner, norm, v with space, member)
  exact cz

-- inner_sum and sum_inner over any finite index set.
theorem InnerProductSpace.inner_finite_sum (v w u F : Set)
  requires finite : Finite(F)
  requires member : v ∈ Module.carrier(V)
  requires values : ∀ i ∈ F, w(i) ∈ Module.carrier(V)
  requires terms : ∀ i ∈ F, u(i) = inner(v, w(i))
  shows inner(v, groupFiniteSum(Module.additive(V), F, w)) =
    groupFiniteSum(Ring.additive(K), F, u)
proof
  have sp := space
  obtain ⟨rc, mod, innerF, normF, symm, addR, smulR, normEq, definite⟩ := sp
  have ring := Module.ring at V, K with mod
  have abelianV := Module.additive.abelian_group at V, K with mod
  have abelianK := Ring.additive.abelian_group at K with ring
  induction finite with H a
  | empty =>
    have e1 := groupFiniteSum.empty at Module.additive(V), w with abelianV
    have e2 := groupFiniteSum.empty at Ring.additive(K), u with abelianK
    rw [e1, e2, Module.additive.one, Ring.additive.one]
    exact InnerProductSpace.zero_right at V, K, absK, conj, ofReal, inner, norm, v with space, member
  | insert using ih =>
    have valuesH : ∀ i ∈ H, w(i) ∈ Group.carrier(Module.additive(V))
      intros i hi
      rw Module.additive.carrier
      exact values with i, (HSubset with i, hi)
    have valuesU : ∀ i ∈ H, u(i) ∈ Group.carrier(Ring.additive(K))
      intros i hi
      rw Ring.additive.carrier
      have iF := HSubset with i, hi
      rw (terms with i, iF)
      have wi := values with i, iF
      have p := FunctionBetween.apply_closed with innerF, (product.pair with member, wi)
      have same : inner((v, w(i))) = inner(v, w(i))
        unfold Algebra.call2
        rfl
      rw same at p
      exact p
    have wa := values with a, aMember
    have wa2 : w(a) ∈ Group.carrier(Module.additive(V))
      rw Module.additive.carrier
      exact wa
    have ua2 : u(a) ∈ Group.carrier(Ring.additive(K))
      rw [Ring.additive.carrier, (terms with a, aMember)]
      have p := FunctionBetween.apply_closed with innerF, (product.pair with member, wa)
      have same : inner((v, w(a))) = inner(v, w(a))
        unfold Algebra.call2
        rfl
      rw same at p
      exact p
    have stepW := groupFiniteSum.insert at Module.additive(V), H, a, w with abelianV, HFinite, valuesH, wa2, aFresh
    have stepU := groupFiniteSum.insert at Ring.additive(K), H, a, u with abelianK, HFinite, valuesU, ua2, aFresh
    have sW := groupFiniteSum.member with abelianV, HFinite, valuesH
    rw Module.additive.carrier at sW
    rw [stepW, stepU, Module.additive.mul, Ring.additive.mul]
    rw (addR with v, member, groupFiniteSum(Module.additive(V), H, w), sW, w(a), wa)
    rw [ih, (terms with a, aMember)]

theorem InnerProductSpace.finite_sum_inner (v w u F : Set)
  requires finite : Finite(F)
  requires member : v ∈ Module.carrier(V)
  requires values : ∀ i ∈ F, w(i) ∈ Module.carrier(V)
  requires terms : ∀ i ∈ F, u(i) = inner(w(i), v)
  shows inner(groupFiniteSum(Module.additive(V), F, w), v) =
    groupFiniteSum(Ring.additive(K), F, u)
proof
  have sp := space
  obtain ⟨rc, mod, innerF, normF, symm, addR, smulR, normEq, definite⟩ := sp
  have ring := Module.ring at V, K with mod
  have abelianV := Module.additive.abelian_group at V, K with mod
  have abelianK := Ring.additive.abelian_group at K with ring
  induction finite with H a
  | empty =>
    have e1 := groupFiniteSum.empty at Module.additive(V), w with abelianV
    have e2 := groupFiniteSum.empty at Ring.additive(K), u with abelianK
    rw [e1, e2, Module.additive.one, Ring.additive.one]
    exact InnerProductSpace.zero_left at V, K, absK, conj, ofReal, inner, norm, v with space, member
  | insert using ih =>
    have valuesH : ∀ i ∈ H, w(i) ∈ Group.carrier(Module.additive(V))
      intros i hi
      rw Module.additive.carrier
      exact values with i, (HSubset with i, hi)
    have valuesU : ∀ i ∈ H, u(i) ∈ Group.carrier(Ring.additive(K))
      intros i hi
      rw Ring.additive.carrier
      have iF := HSubset with i, hi
      rw (terms with i, iF)
      have wi := values with i, iF
      have p := FunctionBetween.apply_closed with innerF, (product.pair with wi, member)
      have same : inner((w(i), v)) = inner(w(i), v)
        unfold Algebra.call2
        rfl
      rw same at p
      exact p
    have wa := values with a, aMember
    have wa2 : w(a) ∈ Group.carrier(Module.additive(V))
      rw Module.additive.carrier
      exact wa
    have ua2 : u(a) ∈ Group.carrier(Ring.additive(K))
      rw [Ring.additive.carrier, (terms with a, aMember)]
      have p := FunctionBetween.apply_closed with innerF, (product.pair with wa, member)
      have same : inner((w(a), v)) = inner(w(a), v)
        unfold Algebra.call2
        rfl
      rw same at p
      exact p
    have stepW := groupFiniteSum.insert at Module.additive(V), H, a, w with abelianV, HFinite, valuesH, wa2, aFresh
    have stepU := groupFiniteSum.insert at Ring.additive(K), H, a, u with abelianK, HFinite, valuesU, ua2, aFresh
    have sW := groupFiniteSum.member with abelianV, HFinite, valuesH
    rw Module.additive.carrier at sW
    rw [stepW, stepU, Module.additive.mul, Ring.additive.mul]
    rw (InnerProductSpace.add_left at V, K, absK, conj, ofReal, inner, norm, groupFiniteSum(Module.additive(V), H, w), w(a), v with space, sW, wa, member)
    rw [ih, (terms with a, aMember)]

-- ⟨u, −x⟩ = −⟨u, x⟩.
theorem InnerProductSpace.neg_right (u x : Set)
  requires memberU : u ∈ Module.carrier(V)
  requires memberX : x ∈ Module.carrier(V)
  shows inner(u, Module.neg(V)(x)) = Ring.neg(K)(inner(u, x))
proof
  have sp := space
  obtain ⟨rc, mod, innerF, normF, symm, addR, smulR, normEq, definite⟩ := sp
  have ring := Module.ring at V, K with mod
  have group := Module.additive_group at K, V with ring, mod
  have groupK := AbelianGroup.to_group with (Ring.additive.abelian_group at K with ring)
  have nx := Module.neg_mem at K, V, x with ring, mod, memberX
  have xA : x ∈ Group.carrier(Module.additive(V))
    rw Module.additive.carrier
    exact memberX
  have xz := Group.mul_inv at Module.additive(V), x with group, xA
  rw [Module.additive.mul, Module.additive.inv, Module.additive.one] at xz
  have a := addR with u, memberU, x, memberX, Module.neg(V)(x), nx
  rw [xz, (InnerProductSpace.zero_right at V, K, absK, conj, ofReal, inner, norm, u with space, memberU)] at a
  have p1 := FunctionBetween.apply_closed with innerF, (product.pair with memberU, memberX)
  have p2 := FunctionBetween.apply_closed with innerF, (product.pair with memberU, nx)
  have same1 : inner((u, x)) = inner(u, x)
    unfold Algebra.call2
    rfl
  have same2 : inner((u, Module.neg(V)(x))) = inner(u, Module.neg(V)(x))
    unfold Algebra.call2
    rfl
  rw same1 at p1
  rw same2 at p2
  have p1A : inner(u, x) ∈ Group.carrier(Ring.additive(K))
    rw Ring.additive.carrier
    exact p1
  have p2A : inner(u, Module.neg(V)(x)) ∈ Group.carrier(Ring.additive(K))
    rw Ring.additive.carrier
    exact p2
  have eq : Group.mul(Ring.additive(K))(inner(u, x), inner(u, Module.neg(V)(x))) = Group.one(Ring.additive(K))
    rw [Ring.additive.mul, Ring.additive.one]
    symm
    exact a
  have r := eq_inv_of_mul_eq_one_right at Ring.additive(K), inner(u, x), inner(u, Module.neg(V)(x)) with groupK, p1A, p2A, eq
  rw Ring.additive.inv at r
  exact r

-- ‖c • v‖ = |c| ‖v‖.
theorem InnerProductSpace.norm_smul (c v : Set)
  requires scalar : c ∈ Ring.carrier(K)
  requires member : v ∈ Module.carrier(V)
  shows norm(Module.smul(V)(c, v)) = R[absK(c) * norm(v)]
proof
  have sp := space
  obtain ⟨rc, mod, innerF, normF, symm, addR, smulR, normEq, definite⟩ := sp
  have comm := RCLike.comm_ring with rc
  have ring := comm.left
  obtain ⟨cl, ops, cz⟩ := RCLike.conj_laws with rc
  obtain ⟨ofIn, ofAdd, ofInj⟩ := RCLike.ofReal_laws with rc
  obtain ⟨of0, of1, ofMul, ofConj, ofAbs⟩ := RCLike.ofReal_more with rc
  have nf := (RCLike.normed_field with rc).left
  obtain ⟨cIn, cNn⟩ := NormedField.norm_real at K, absK, c with nf, scalar
  have cR : Real(absK(c)) by exact cIn
  have cv := Module.smul_mem at K, V, c, v with ring, mod, scalar, member
  obtain ⟨n1, e1⟩ := normEq with Module.smul(V)(c, v), cv
  obtain ⟨n2, e2⟩ := normEq with v, member
  have a := InnerProductSpace.smul_left at V, K, absK, conj, ofReal, inner, norm, c, v, Module.smul(V)(c, v) with space, scalar, member, cv
  rw (smulR with c, scalar, v, member, v, member) at a
  have pvv := FunctionBetween.apply_closed with innerF, (product.pair with member, member)
  have same : inner((v, v)) = inner(v, v)
    unfold Algebra.call2
    rfl
  rw same at pvv
  have cc := (cl with c, scalar).left
  have r : Ring.mul(K)(conj(c), Ring.mul(K)(c, inner(v, v))) = Ring.mul(K)(Ring.mul(K)(c, conj(c)), inner(v, v)) by ring
  rw [r, (RCLike.mul_conj at K, absK, conj, ofReal, c with rc, scalar), e2, e1] at a
  have nvR : Real(norm(v)) by exact (FunctionBetween.apply_closed with normF, member)
  have ncR : Real(norm(Module.smul(V)(c, v))) by exact (FunctionBetween.apply_closed with normF, cv)
  have q1 : absK(c) * absK(c) ∈ ℝ by typecheck
  have q2 : norm(v) * norm(v) ∈ ℝ by typecheck
  have q3 : norm(Module.smul(V)(c, v)) * norm(Module.smul(V)(c, v)) ∈ ℝ by typecheck
  have q4 : (absK(c) * absK(c)) * (norm(v) * norm(v)) ∈ ℝ by typecheck
  rw (ofMul with R[absK(c) * absK(c)], q1, R[norm(v) * norm(v)], q2) at a
  have sq := ofInj with R[norm(Module.smul(V)(c, v)) * norm(Module.smul(V)(c, v))], q3, R[(absK(c) * absK(c)) * (norm(v) * norm(v))], q4, a
  have nn := realMulValue.nonnegative at absK(c), norm(v) with cNn, n2
  have sq2 : norm(Module.smul(V)(c, v)) * norm(Module.smul(V)(c, v)) = (absK(c) * norm(v)) * (absK(c) * norm(v))
    rw sq
    ring
  exact realMulValue.eq_of_square_eq with n1, nn, sq2

-- Mathlib's inner_sum and sum_inner, over n = {0, …, n − 1}.
theorem InnerProductSpace.inner_sum (v w u : Set, n : Nat)
  requires member : v ∈ Module.carrier(V)
  requires values : ∀ i ∈ n, w(i) ∈ Module.carrier(V)
  requires terms : ∀ i ∈ n, u(i) = inner(v, w(i))
  shows inner(v, groupFiniteSum(Module.additive(V), n, w)) =
    groupFiniteSum(Ring.additive(K), n, u)
proof
  exact InnerProductSpace.inner_finite_sum at V, K, absK, conj, ofReal, inner, norm, v, w, u, n with space, (Finite.natural at n), member, values, terms

theorem InnerProductSpace.sum_inner (v w u : Set, n : Nat)
  requires member : v ∈ Module.carrier(V)
  requires values : ∀ i ∈ n, w(i) ∈ Module.carrier(V)
  requires terms : ∀ i ∈ n, u(i) = inner(w(i), v)
  shows inner(groupFiniteSum(Module.additive(V), n, w), v) =
    groupFiniteSum(Ring.additive(K), n, u)
proof
  exact InnerProductSpace.finite_sum_inner at V, K, absK, conj, ofReal, inner, norm, v, w, u, n with space, (Finite.natural at n), member, values, terms

-- Mathlib's inner_self_eq_zero and inner_eq_zero_symm.
theorem InnerProductSpace.self_eq_zero (v : Set)
  requires member : v ∈ Module.carrier(V)
  shows inner(v, v) = Ring.zero(K) ↔ v = Module.zero(V)
proof
  have sp := space
  obtain ⟨rc, mod, innerF, normF, symm, addR, smulR, normEq, definite⟩ := sp
  have ring := Module.ring at V, K with mod
  have zeroV := Module.zero_mem at K, V with ring, mod
  constructor
  . intro z
    exact definite with v, member, z
  . intro z
    rw z
    exact InnerProductSpace.zero_left at V, K, absK, conj, ofReal, inner, norm, Module.zero(V) with space, zeroV

theorem InnerProductSpace.eq_zero_symm (v w : Set)
  requires memberV : v ∈ Module.carrier(V)
  requires memberW : w ∈ Module.carrier(V)
  shows inner(v, w) = Ring.zero(K) ↔ inner(w, v) = Ring.zero(K)
proof
  have sp := space
  obtain ⟨rc, mod, innerF, normF, symm, addR, smulR, normEq, definite⟩ := sp
  obtain ⟨cl, ops, cz⟩ := RCLike.conj_laws with rc
  constructor
  . intro z
    rw (symm with v, memberV, w, memberW)
    rw [z, cz]
  . intro z
    rw (symm with w, memberW, v, memberV)
    rw [z, cz]

theorem InnerProductSpace.self_norm (v : Set)
  requires member : v ∈ Module.carrier(V)
  shows inner(v, v) = ofReal(R[norm(v) * norm(v)])
proof
  obtain ⟨rc, mod, innerF, normF, symm, addR, smulR, normEq, definite⟩ := space
  exact (normEq with v, member).right

-- A vector orthogonal to everything is zero; two vectors with the same
-- inner products are equal.
theorem InnerProductSpace.ext (v w : Set)
  requires memberV : v ∈ Module.carrier(V)
  requires memberW : w ∈ Module.carrier(V)
  requires same : ∀ u ∈ Module.carrier(V), inner(u, v) = inner(u, w)
  shows v = w
proof
  have sp := space
  obtain ⟨rc, mod, innerF, normF, symm, addR, smulR, normEq, definite⟩ := sp
  have ring := Module.ring at V, K with mod
  have group := Module.additive_group at K, V with ring, mod
  have zeroV := Module.zero_mem at K, V with ring, mod
  have zeroK := Ring.zero_mem at K with ring
  have nw := Module.neg_mem at K, V, w with ring, mod, memberW
  have d := Module.add_mem at K, V, v, Module.neg(V)(w) with ring, mod, memberV, nw
  have rz : inner(Module.add(V)(v, Module.neg(V)(w)), Module.zero(V)) = Ring.zero(K)
    have zs := zero_smul at K, V, Module.zero(V) with ring, mod, zeroV
    have s := smulR with Ring.zero(K), zeroK, Module.add(V)(v, Module.neg(V)(w)), d, Module.zero(V), zeroV
    rw zs at s
    rw s
    have p := FunctionBetween.apply_closed with innerF, (product.pair with d, zeroV)
    have same2 : inner((Module.add(V)(v, Module.neg(V)(w)), Module.zero(V))) = inner(Module.add(V)(v, Module.neg(V)(w)), Module.zero(V))
      unfold Algebra.call2
      rfl
    rw same2 at p
    have pr := Ring.parts with ring
    exact IsRing.zero_mul with pr, p
  have wA : w ∈ Group.carrier(Module.additive(V))
    rw Module.additive.carrier
    exact memberW
  have vA : v ∈ Group.carrier(Module.additive(V))
    rw Module.additive.carrier
    exact memberV
  have wz := Group.mul_inv at Module.additive(V), w with group, wA
  rw [Module.additive.mul, Module.additive.inv, Module.additive.one] at wz
  have a1 := addR with Module.add(V)(v, Module.neg(V)(w)), d, v, memberV, Module.neg(V)(w), nw
  have a2 := addR with Module.add(V)(v, Module.neg(V)(w)), d, w, memberW, Module.neg(V)(w), nw
  rw [wz, rz] at a2
  have s := same with Module.add(V)(v, Module.neg(V)(w)), d
  rw [s, ← a2] at a1
  have dz := definite with Module.add(V)(v, Module.neg(V)(w)), d, a1
  have c := (mul_inv_eq_one at Module.additive(V), v, w with group, vA, wA).forward
  rw [Module.additive.mul, Module.additive.inv, Module.additive.one] at c
  exact c with dz

-- Pythagoras: ‖v + w‖² = ‖v‖² + ‖w‖² for orthogonal v and w.
theorem InnerProductSpace.pythagoras (v w : Set)
  requires memberV : v ∈ Module.carrier(V)
  requires memberW : w ∈ Module.carrier(V)
  requires orthogonal : InnerOrthogonal(inner, v, w, K)
  shows R[norm(Module.add(V)(v, w)) * norm(Module.add(V)(v, w))] =
    R[norm(v) * norm(v) + norm(w) * norm(w)]
proof
  have sp := space
  obtain ⟨rc, mod, innerF, normF, symm, addR, smulR, normEq, definite⟩ := sp
  obtain ⟨ofIn, ofAdd, ofInj⟩ := RCLike.ofReal_laws with rc
  have ring := Module.ring at V, K with mod
  have pr := Ring.parts with ring
  have vw := Module.add_mem at K, V, v, w with ring, mod, memberV, memberW
  have o1 := orthogonal
  unfold InnerOrthogonal at o1
  have o2 := (InnerProductSpace.eq_zero_symm at V, K, absK, conj, ofReal, inner, norm, v, w with space, memberV, memberW).forward with o1
  have a1 := addR with Module.add(V)(v, w), vw, v, memberV, w, memberW
  rw [(InnerProductSpace.add_left at V, K, absK, conj, ofReal, inner, norm, v, w, v with space, memberV, memberW, memberV), (InnerProductSpace.add_left at V, K, absK, conj, ofReal, inner, norm, v, w, w with space, memberV, memberW, memberW), o1, o2] at a1
  have pvv := FunctionBetween.apply_closed with innerF, (product.pair with memberV, memberV)
  have pww := FunctionBetween.apply_closed with innerF, (product.pair with memberW, memberW)
  have same1 : inner((v, v)) = inner(v, v)
    unfold Algebra.call2
    rfl
  have same2 : inner((w, w)) = inner(w, w)
    unfold Algebra.call2
    rfl
  rw same1 at pvv
  rw same2 at pww
  rw [(IsRing.add_right_identity with pr, pvv), (IsRing.add_left_identity with pr, pww)] at a1
  have ne1 := (normEq with Module.add(V)(v, w), vw).right
  have ne2 := (normEq with v, memberV).right
  have ne3 := (normEq with w, memberW).right
  rw [ne1, ne2, ne3] at a1
  have nvIn := FunctionBetween.apply_closed with normF, memberV
  have nwIn := FunctionBetween.apply_closed with normF, memberW
  have nsIn := FunctionBetween.apply_closed with normF, vw
  have nvR : Real(norm(v)) by exact nvIn
  have nwR : Real(norm(w)) by exact nwIn
  have nsR : Real(norm(Module.add(V)(v, w))) by exact nsIn
  have q1 : norm(v) * norm(v) ∈ ℝ by typecheck
  have q2 : norm(w) * norm(w) ∈ ℝ by typecheck
  have q3 : norm(Module.add(V)(v, w)) * norm(Module.add(V)(v, w)) ∈ ℝ by typecheck
  have q4 : norm(v) * norm(v) + norm(w) * norm(w) ∈ ℝ by typecheck
  rw (ofAdd with R[norm(v) * norm(v)], q1, R[norm(w) * norm(w)], q2) at a1
  exact ofInj with R[norm(Module.add(V)(v, w)) * norm(Module.add(V)(v, w))], q3, R[norm(v) * norm(v) + norm(w) * norm(w)], q4, a1

-- Cauchy–Schwarz (Mathlib's norm_inner_le_norm).
theorem InnerProductSpace.cauchy_schwarz (v w : Set)
  requires memberV : v ∈ Module.carrier(V)
  requires memberW : w ∈ Module.carrier(V)
  shows absK(inner(v, w)) ≤ R[norm(v) * norm(w)]
proof
  have sp := space
  obtain ⟨rc, mod, innerF, normF, symm, addR, smulR, normEq, definite⟩ := sp
  have comm := RCLike.comm_ring with rc
  have ring := comm.left
  have abelianV := Module.additive.abelian_group at V, K with mod
  have group := Module.additive_group at K, V with ring, mod
  obtain ⟨cl, ops, cz⟩ := RCLike.conj_laws with rc
  obtain ⟨ofIn, ofAdd, ofInj⟩ := RCLike.ofReal_laws with rc
  obtain ⟨of0, of1, ofMul, ofConj, ofAbs⟩ := RCLike.ofReal_more with rc
  obtain ⟨absConj, reBound⟩ := RCLike.conj_abs with rc
  have nf := (RCLike.normed_field with rc).left
  have nf2 := nf
  obtain ⟨field, comm2, nr, mulEq, oneEq⟩ := nf2
  have pvw := FunctionBetween.apply_closed with innerF, (product.pair with memberV, memberW)
  have pwv := FunctionBetween.apply_closed with innerF, (product.pair with memberW, memberV)
  have pww := FunctionBetween.apply_closed with innerF, (product.pair with memberW, memberW)
  have same1 : inner((v, w)) = inner(v, w)
    unfold Algebra.call2
    rfl
  have same2 : inner((w, v)) = inner(w, v)
    unfold Algebra.call2
    rfl
  have same3 : inner((w, w)) = inner(w, w)
    unfold Algebra.call2
    rfl
  rw same1 at pvw
  rw same2 at pwv
  rw same3 at pww
  obtain ⟨nvNn, nvEq⟩ := normEq with v, memberV
  obtain ⟨nwNn, nwEq⟩ := normEq with w, memberW
  have nvR : Real(norm(v)) by exact (FunctionBetween.apply_closed with normF, memberV)
  have nwR : Real(norm(w)) by exact (FunctionBetween.apply_closed with normF, memberW)
  obtain ⟨mIn, mNn⟩ := NormedField.norm_real at K, absK, inner(w, v) with nf, pwv
  have mR : Real(absK(inner(w, v))) by exact mIn
  have target : absK(inner(v, w)) = absK(inner(w, v))
    rw (symm with w, memberW, v, memberV)
    exact absConj with inner(w, v), pwv
  rw target
  have rhsNn := realMulValue.nonnegative at norm(v), norm(w) with nvNn, nwNn
  by_cases wz : norm(w) = (0:R)
  . have wIsZero : w = Module.zero(V)
      apply definite with w, memberW
      rw [nwEq, wz]
      have z : (0:R) * (0:R) = (0:R) by ring
      rw [z, of0]
    have ip : inner(w, v) = Ring.zero(K)
      rw wIsZero
      exact InnerProductSpace.zero_left at V, K, absK, conj, ofReal, inner, norm, v with space, memberV
    rw ip
    have z0 : R[0] ∈ ℝ by typecheck
    have z0n : realZero ≤ R[0] by linarith
    rw [← of0, (ofAbs with R[0], z0, z0n), wz]
    have z : norm(v) * (0:R) = (0:R) by ring
    rw z
    linarith
  . have wPos : (0:R) < norm(w)
      by_contra np
      have e : norm(w) = (0:R) by linarith
      exact wz with e
    have sPos := realMulValue.positive at norm(w), norm(w) with wPos, wPos
    have sNe : norm(w) * norm(w) ≠ (0:R)
      intro e
      rw e at sPos
      linarith
    have sIn : norm(w) * norm(w) ∈ ℝ by typecheck
    have kIn : (1:R) / (norm(w) * norm(w)) ∈ ℝ by typecheck
    have kR : Real((1:R) / (norm(w) * norm(w))) by exact kIn
    have ks := realDiv.mul_right at (1:R), norm(w) * norm(w) with sNe
    have kNn : (0:R) ≤ (1:R) / (norm(w) * norm(w))
      by_contra neg
      have le0 : (1:R) / (norm(w) * norm(w)) ≤ (0:R) by linarith
      have sNn : (0:R) ≤ norm(w) * norm(w) by linarith
      have prod := realLe.mul_right_of_nonnegative at (1:R) / (norm(w) * norm(w)), (0:R), norm(w) * norm(w) with le0, sNn
      rw ks at prod
      have z0 : (0:R) * (norm(w) * norm(w)) = (0:R) by ring
      rw z0 at prod
      linarith
    have ofk := ofIn with R[(1:R) / (norm(w) * norm(w))], kIn
    have tIn := Ring.mul_mem at K, ofReal(R[(1:R) / (norm(w) * norm(w))]), inner(w, v) with ring, ofk, pwv
    have xIn := Module.smul_mem at K, V, Ring.mul(K)(ofReal(R[(1:R) / (norm(w) * norm(w))]), inner(w, v)), w with ring, mod, tIn, memberW
    have nx := Module.neg_mem at K, V, Module.smul(V)(Ring.mul(K)(ofReal(R[(1:R) / (norm(w) * norm(w))]), inner(w, v)), w) with ring, mod, xIn
    have uIn := Module.add_mem at K, V, v, Module.neg(V)(Module.smul(V)(Ring.mul(K)(ofReal(R[(1:R) / (norm(w) * norm(w))]), inner(w, v)), w)) with ring, mod, memberV, nx
    have wu : inner(w, Module.add(V)(v, Module.neg(V)(Module.smul(V)(Ring.mul(K)(ofReal(R[(1:R) / (norm(w) * norm(w))]), inner(w, v)), w)))) = Ring.zero(K)
      rw (addR with w, memberW, v, memberV, Module.neg(V)(Module.smul(V)(Ring.mul(K)(ofReal(R[(1:R) / (norm(w) * norm(w))]), inner(w, v)), w)), nx)
      rw (InnerProductSpace.neg_right at V, K, absK, conj, ofReal, inner, norm, w, Module.smul(V)(Ring.mul(K)(ofReal(R[(1:R) / (norm(w) * norm(w))]), inner(w, v)), w) with space, memberW, xIn)
      rw [(smulR with Ring.mul(K)(ofReal(R[(1:R) / (norm(w) * norm(w))]), inner(w, v)), tIn, w, memberW, w, memberW), nwEq]
      have ofs := ofIn with R[norm(w) * norm(w)], sIn
      have r1 : Ring.mul(K)(Ring.mul(K)(ofReal(R[(1:R) / (norm(w) * norm(w))]), inner(w, v)), ofReal(R[norm(w) * norm(w)])) = Ring.mul(K)(inner(w, v), Ring.mul(K)(ofReal(R[(1:R) / (norm(w) * norm(w))]), ofReal(R[norm(w) * norm(w)]))) by ring
      rw [r1, (ofMul with R[(1:R) / (norm(w) * norm(w))], kIn, R[norm(w) * norm(w)], sIn), ks, of1]
      ring
    have xu : InnerOrthogonal(inner, Module.smul(V)(Ring.mul(K)(ofReal(R[(1:R) / (norm(w) * norm(w))]), inner(w, v)), w), Module.add(V)(v, Module.neg(V)(Module.smul(V)(Ring.mul(K)(ofReal(R[(1:R) / (norm(w) * norm(w))]), inner(w, v)), w))), K)
      unfold InnerOrthogonal
      rw [(InnerProductSpace.smul_left at V, K, absK, conj, ofReal, inner, norm, Ring.mul(K)(ofReal(R[(1:R) / (norm(w) * norm(w))]), inner(w, v)), w, Module.add(V)(v, Module.neg(V)(Module.smul(V)(Ring.mul(K)(ofReal(R[(1:R) / (norm(w) * norm(w))]), inner(w, v)), w))) with space, tIn, memberW, uIn), wu]
      have ct := (cl with Ring.mul(K)(ofReal(R[(1:R) / (norm(w) * norm(w))]), inner(w, v)), tIn).left
      ring
    have py := InnerProductSpace.pythagoras at V, K, absK, conj, ofReal, inner, norm, Module.smul(V)(Ring.mul(K)(ofReal(R[(1:R) / (norm(w) * norm(w))]), inner(w, v)), w), Module.add(V)(v, Module.neg(V)(Module.smul(V)(Ring.mul(K)(ofReal(R[(1:R) / (norm(w) * norm(w))]), inner(w, v)), w))) with space, xIn, uIn, xu
    have xA : Module.smul(V)(Ring.mul(K)(ofReal(R[(1:R) / (norm(w) * norm(w))]), inner(w, v)), w) ∈ Group.carrier(Module.additive(V))
      rw Module.additive.carrier
      exact xIn
    have vA : v ∈ Group.carrier(Module.additive(V))
      rw Module.additive.carrier
      exact memberV
    have ixA := Group.inv_mem at Module.additive(V), Module.smul(V)(Ring.mul(K)(ofReal(R[(1:R) / (norm(w) * norm(w))]), inner(w, v)), w) with group, xA
    have c1 := mul_comm at Module.additive(V), v, Group.inv(Module.additive(V))(Module.smul(V)(Ring.mul(K)(ofReal(R[(1:R) / (norm(w) * norm(w))]), inner(w, v)), w)) with abelianV, vA, ixA
    have c2 := mul_inv_cancel_left at Module.additive(V), Module.smul(V)(Ring.mul(K)(ofReal(R[(1:R) / (norm(w) * norm(w))]), inner(w, v)), w), v with group, xA, vA
    rw ← c1 at c2
    rw [Module.additive.mul, Module.additive.inv] at c2
    rw c2 at py
    rw (InnerProductSpace.norm_smul at V, K, absK, conj, ofReal, inner, norm, Ring.mul(K)(ofReal(R[(1:R) / (norm(w) * norm(w))]), inner(w, v)), w with space, tIn, memberW) at py
    rw [(mulEq with ofReal(R[(1:R) / (norm(w) * norm(w))]), ofk, inner(w, v), pwv), (ofAbs with R[(1:R) / (norm(w) * norm(w))], kIn, kNn)] at py
    have uR : Real(norm(Module.add(V)(v, Module.neg(V)(Module.smul(V)(Ring.mul(K)(ofReal(R[(1:R) / (norm(w) * norm(w))]), inner(w, v)), w))))) by exact (FunctionBetween.apply_closed with normF, uIn)
    have usq := realMulValue.square_nonnegative at norm(Module.add(V)(v, Module.neg(V)(Module.smul(V)(Ring.mul(K)(ofReal(R[(1:R) / (norm(w) * norm(w))]), inner(w, v)), w))))
    have le1 : (((1:R) / (norm(w) * norm(w)) * absK(inner(w, v))) * norm(w)) * (((1:R) / (norm(w) * norm(w)) * absK(inner(w, v))) * norm(w)) ≤ norm(v) * norm(v) by linarith
    have sNn : (0:R) ≤ norm(w) * norm(w) by linarith
    have le2 := realLe.mul_right_of_nonnegative at (((1:R) / (norm(w) * norm(w)) * absK(inner(w, v))) * norm(w)) * (((1:R) / (norm(w) * norm(w)) * absK(inner(w, v))) * norm(w)), norm(v) * norm(v), norm(w) * norm(w) with le1, sNn
    have e1 : ((((1:R) / (norm(w) * norm(w)) * absK(inner(w, v))) * norm(w)) * (((1:R) / (norm(w) * norm(w)) * absK(inner(w, v))) * norm(w))) * (norm(w) * norm(w)) = (absK(inner(w, v)) * absK(inner(w, v))) * (((1:R) / (norm(w) * norm(w)) * (norm(w) * norm(w))) * ((1:R) / (norm(w) * norm(w)) * (norm(w) * norm(w)))) by ring
    rw [e1, ks] at le2
    have e2 : (norm(v) * norm(v)) * (norm(w) * norm(w)) = (norm(v) * norm(w)) * (norm(v) * norm(w)) by ring
    rw e2 at le2
    have e3 : (absK(inner(w, v)) * absK(inner(w, v))) * ((1:R) * (1:R)) = absK(inner(w, v)) * absK(inner(w, v)) by ring
    rw e3 at le2
    exact realMulValue.le_of_square_le with mNn, rhsNn, le2

-- An inner-product space is a normed space for its norm.
theorem InnerProductSpace.normed
  shows NormedSpace(V, K, absK, norm)
proof
  have sp := space
  obtain ⟨rc, mod, innerF, normF, symm, addR, smulR, normEq, definite⟩ := sp
  have comm := RCLike.comm_ring with rc
  have ring := comm.left
  have abelianV := Module.additive.abelian_group at V, K with mod
  have groupK := AbelianGroup.to_group with (Ring.additive.abelian_group at K with ring)
  obtain ⟨cl, ops, cz⟩ := RCLike.conj_laws with rc
  obtain ⟨ofIn, ofAdd, ofInj⟩ := RCLike.ofReal_laws with rc
  obtain ⟨of0, of1, ofMul, ofConj, ofAbs⟩ := RCLike.ofReal_more with rc
  obtain ⟨absConj, reBound⟩ := RCLike.conj_abs with rc
  have nf := (RCLike.normed_field with rc).left
  have pr := Ring.parts with ring
  have z0 : R[0] ∈ ℝ by typecheck
  have zeroV := Module.zero_mem at K, V with ring, mod
  have innerVal : ∀ x ∈ Module.carrier(V), ∀ y ∈ Module.carrier(V), inner(x, y) ∈ Ring.carrier(K)
    intros x hx y hy
    have p := FunctionBetween.apply_closed with innerF, (product.pair with hx, hy)
    have same : inner((x, y)) = inner(x, y)
      unfold Algebra.call2
      rfl
    rw same at p
    exact p
  have normSq : ∀ x ∈ Module.carrier(V), ∀ y ∈ Module.carrier(V), inner(x, x) = inner(y, y) → norm(x) = norm(y)
    intros x hx y hy same
    obtain ⟨nxNn, nxEq⟩ := normEq with x, hx
    obtain ⟨nyNn, nyEq⟩ := normEq with y, hy
    have nxR : Real(norm(x)) by exact (FunctionBetween.apply_closed with normF, hx)
    have nyR : Real(norm(y)) by exact (FunctionBetween.apply_closed with normF, hy)
    have q1 : norm(x) * norm(x) ∈ ℝ by typecheck
    have q2 : norm(y) * norm(y) ∈ ℝ by typecheck
    rw [nxEq, nyEq] at same
    have sq := ofInj with R[norm(x) * norm(x)], q1, R[norm(y) * norm(y)], q2, same
    exact realMulValue.eq_of_square_eq with nxNn, nyNn, sq
  unfold NormedSpace
  refine ⟨nf, mod, ?_, ?_⟩
  . unfold NormedGroup
    refine ⟨abelianV, ?_⟩
    unfold IsNorm
    refine ⟨?_, ?_, ?_, ?_, ?_⟩
    . rw Module.additive.carrier
      exact normF
    . intros x hx
      rw Module.additive.carrier at hx
      exact (normEq with x, hx).left
    . intros x hx
      rw Module.additive.carrier at hx
      rw Module.additive.one
      constructor
      . intro z
        have hx2 : x ∈ Module.carrier(V) by exact hx
        apply definite with x, hx2
        have ne := (normEq with x, hx2).right
        rw [ne, z]
        have e : (0:R) * (0:R) = R[0] by ring
        rw [e, of0]
      . intro z
        rw z
        obtain ⟨n0Nn, n0Eq⟩ := normEq with Module.zero(V), zeroV
        have n0R : Real(norm(Module.zero(V))) by exact (FunctionBetween.apply_closed with normF, zeroV)
        rw [(InnerProductSpace.zero_left at V, K, absK, conj, ofReal, inner, norm, Module.zero(V) with space, zeroV), ← of0] at n0Eq
        have q : norm(Module.zero(V)) * norm(Module.zero(V)) ∈ ℝ by typecheck
        have sq := ofInj with R[0], z0, R[norm(Module.zero(V)) * norm(Module.zero(V))], q, n0Eq
        have zz : realZero ≤ R[0] by linarith
        have sq2 : norm(Module.zero(V)) * norm(Module.zero(V)) = (0:R) * (0:R)
          rw ← sq
          ring
        exact realMulValue.eq_of_square_eq with n0Nn, zz, sq2
    . intros x hx
      rw Module.additive.carrier at hx
      rw Module.additive.inv
      have nx := Module.neg_mem at K, V, x with ring, mod, hx
      apply normSq with Module.neg(V)(x), nx, x, hx
      rw (InnerProductSpace.neg_right at V, K, absK, conj, ofReal, inner, norm, Module.neg(V)(x), x with space, nx, hx)
      rw (symm with x, hx, Module.neg(V)(x), nx)
      rw (InnerProductSpace.neg_right at V, K, absK, conj, ofReal, inner, norm, x, x with space, hx, hx)
      have a := innerVal with x, hx, x, hx
      have na := Ring.neg_mem at K, inner(x, x) with ring, a
      have ca := (cl with inner(x, x), a).left
      have cna := (cl with Ring.neg(K)(inner(x, x)), na).left
      have sumz := (ops with inner(x, x), a, Ring.neg(K)(inner(x, x)), na).left
      rw [(IsRing.add_inverse_right with pr, a), cz] at sumz
      have caA : conj(inner(x, x)) ∈ Group.carrier(Ring.additive(K))
        rw Ring.additive.carrier
        exact ca
      have cnaA : conj(Ring.neg(K)(inner(x, x))) ∈ Group.carrier(Ring.additive(K))
        rw Ring.additive.carrier
        exact cna
      have eq : Group.mul(Ring.additive(K))(conj(inner(x, x)), conj(Ring.neg(K)(inner(x, x)))) = Group.one(Ring.additive(K))
        rw [Ring.additive.mul, Ring.additive.one]
        symm
        exact sumz
      have r := eq_inv_of_mul_eq_one_right at Ring.additive(K), conj(inner(x, x)), conj(Ring.neg(K)(inner(x, x))) with groupK, caA, cnaA, eq
      rw Ring.additive.inv at r
      rw r
      have nxR : Real(norm(x)) by exact (FunctionBetween.apply_closed with normF, hx)
      have q : norm(x) * norm(x) ∈ ℝ by typecheck
      have ne := (normEq with x, hx).right
      rw [ne, (ofConj with R[norm(x) * norm(x)], q)]
      have o := ofIn with R[norm(x) * norm(x)], q
      ring
    . intros x hx y hy
      rw Module.additive.carrier at hx
      rw Module.additive.carrier at hy
      rw Module.additive.mul
      have xy := Module.add_mem at K, V, x, y with ring, mod, hx, hy
      obtain ⟨nxNn, nxEq⟩ := normEq with x, hx
      obtain ⟨nyNn, nyEq⟩ := normEq with y, hy
      obtain ⟨nsNn, nsEq⟩ := normEq with Module.add(V)(x, y), xy
      have nxR : Real(norm(x)) by exact (FunctionBetween.apply_closed with normF, hx)
      have nyR : Real(norm(y)) by exact (FunctionBetween.apply_closed with normF, hy)
      have nsR : Real(norm(Module.add(V)(x, y))) by exact (FunctionBetween.apply_closed with normF, xy)
      have a1 := addR with Module.add(V)(x, y), xy, x, hx, y, hy
      rw [(InnerProductSpace.add_left at V, K, absK, conj, ofReal, inner, norm, x, y, x with space, hx, hy, hx), (InnerProductSpace.add_left at V, K, absK, conj, ofReal, inner, norm, x, y, y with space, hx, hy, hy), (symm with x, hx, y, hy)] at a1
      have ixy := innerVal with x, hx, y, hy
      have ixx := innerVal with x, hx, x, hx
      have iyy := innerVal with y, hy, y, hy
      have cxy := (cl with inner(x, y), ixy).left
      have r1 : Ring.add(K)(Ring.add(K)(inner(x, x), conj(inner(x, y))), Ring.add(K)(inner(x, y), inner(y, y))) = Ring.add(K)(Ring.add(K)(inner(x, x), inner(y, y)), Ring.add(K)(inner(x, y), conj(inner(x, y)))) by ring
      rw r1 at a1
      obtain ⟨r, rIn, rEq, rLe⟩ := reBound with inner(x, y), ixy
      have rR : Real(r) by exact rIn
      have q1 : norm(x) * norm(x) ∈ ℝ by typecheck
      have q2 : norm(y) * norm(y) ∈ ℝ by typecheck
      have q3 : norm(x) * norm(x) + norm(y) * norm(y) ∈ ℝ by typecheck
      have q4 : norm(x) * norm(x) + norm(y) * norm(y) + r ∈ ℝ by typecheck
      have q5 : norm(Module.add(V)(x, y)) * norm(Module.add(V)(x, y)) ∈ ℝ by typecheck
      rw [nsEq, nxEq, nyEq, rEq, (ofAdd with R[norm(x) * norm(x)], q1, R[norm(y) * norm(y)], q2), (ofAdd with R[norm(x) * norm(x) + norm(y) * norm(y)], q3, r, rIn)] at a1
      have sq := ofInj with R[norm(Module.add(V)(x, y)) * norm(Module.add(V)(x, y))], q5, R[norm(x) * norm(x) + norm(y) * norm(y) + r], q4, a1
      have csb := InnerProductSpace.cauchy_schwarz at V, K, absK, conj, ofReal, inner, norm, x, y with space, hx, hy
      have aR : Real(absK(inner(x, y))) by exact (NormedField.norm_real at K, absK, inner(x, y) with nf, ixy).left
      have sumNn : (0:R) ≤ norm(x) + norm(y) by linarith
      have le : norm(Module.add(V)(x, y)) * norm(Module.add(V)(x, y)) ≤ (norm(x) + norm(y)) * (norm(x) + norm(y))
        have ex : (norm(x) + norm(y)) * (norm(x) + norm(y)) = norm(x) * norm(x) + norm(y) * norm(y) + (norm(x) * norm(y) + norm(x) * norm(y)) by ring
        rw [ex, sq]
        linarith
      exact realMulValue.le_of_square_le with nsNn, sumNn, le
  . intros c hc v hv
    exact InnerProductSpace.norm_smul at V, K, absK, conj, ofReal, inner, norm, c, v with space, hc, hv

-- The polarization identity over ℝ: ⟨v, w⟩ = (‖v + w‖² − ‖v − w‖²)/4.
theorem InnerProductSpace.polarization_real (v w : Set)
  requires real : K = realRing
  requires memberV : v ∈ Module.carrier(V)
  requires memberW : w ∈ Module.carrier(V)
  shows inner(v, w) =
    R[(norm(Module.add(V)(v, w)) * norm(Module.add(V)(v, w)) -
      norm(Module.add(V)(v, Module.neg(V)(w))) *
        norm(Module.add(V)(v, Module.neg(V)(w)))) / 4]
proof
  sorry

-- The inner product is continuous.
theorem InnerProductSpace.inner_continuous
  shows inner : productSpace(spaceTopology(V, norm), spaceTopology(V, norm)) ⇒
    normTopology(Ring.additive(K), absK)
proof
  sorry

-- Section: Orthonormal families
theorem Orthonormal.norm_one (e I i : Set)
  requires orthonormal : Orthonormal(V, K, inner, e, I)
  requires member : i ∈ I
  shows norm(e(i)) = realOne
proof
  have sp := space
  obtain ⟨rc, mod, innerF, normF, symm, addR, smulR, normEq, definite⟩ := sp
  obtain ⟨vals, ones, zeros⟩ := orthonormal
  have ei := vals with i, member
  obtain ⟨nNn, sq⟩ := normEq with e(i), ei
  rw (ones with i, member) at sq
  have nIn := FunctionBetween.apply_closed with normF, ei
  have nR : Real(norm(e(i))) by exact nIn
  have sqIn : norm(e(i)) * norm(e(i)) ∈ ℝ by typecheck
  have sq1 : norm(e(i)) * norm(e(i)) = (1:R)
    cases rc with re | co
    . obtain ⟨kEq, aEq, cEq, oEq⟩ := re
      rw [oEq, kEq] at sq
      have a := identity.apply at norm(e(i)) * norm(e(i)), ℝ with sqIn
      rw a at sq
      have oneEq : Ring.one(realRing) = realOne
        unfold realRing
        simp [Ring.mk.one]
      rw oneEq at sq
      rw ← sq
    . obtain ⟨kEq, aEq, cEq, oEq⟩ := co
      rw [oEq, kEq, complexRing.oneOf, ← complexOfReal.one] at sq
      have r := complexOfReal.injective with sq
      rw r
  have one := realZero.lt_one
  by_contra ne
  by_cases lt : norm(e(i)) < (1:R)
  . have m := realLe.mul_left_of_nonnegative at norm(e(i)), (1:R), norm(e(i)) with (realLess.implies_le with lt), nNn
    have z : norm(e(i)) * (1:R) = norm(e(i)) by ring
    rw z at m
    linarith
  . have gt : (1:R) < norm(e(i))
      have le : (1:R) ≤ norm(e(i)) by linarith
      by_contra ng
      have eq : norm(e(i)) = (1:R) by linarith
      exact ne with eq
    have oneNn : (0:R) ≤ (1:R) by linarith
    have pos : (0:R) < norm(e(i)) by linarith
    have m := realLess.mul_left_of_positive at (1:R), norm(e(i)), norm(e(i)) with gt, pos
    have z : norm(e(i)) * (1:R) = norm(e(i)) by ring
    rw z at m
    linarith

-- The coefficients of a combination of an orthonormal family are its
-- inner products: ⟨e(j), Σ c(i) e(i)⟩ = c(j).
theorem Orthonormal.coefficient (e c w j : Set, n : Nat)
  requires orthonormal : Orthonormal(V, K, inner, e, n)
  requires scalars : ∀ i ∈ n, c(i) ∈ Ring.carrier(K)
  requires terms : ∀ i ∈ n, w(i) = Module.smul(V)(c(i), e(i))
  requires member : j ∈ n
  shows inner(e(j), groupFiniteSum(Module.additive(V), n, w)) = c(j)
proof
  have sp := space
  obtain ⟨rc, mod, innerF, normF, symm, addR, smulR, normEq, definite⟩ := sp
  have comm := RCLike.comm_ring with rc
  have ring := comm.left
  have abelianK := Ring.additive.abelian_group at K with ring
  have on := orthonormal
  obtain ⟨vals, ones, zeros⟩ := on
  have ej := vals with j, member
  have wvals : ∀ i ∈ n, w(i) ∈ Module.carrier(V)
    intros i hi
    rw (terms with i, hi)
    exact Module.smul_mem at K, V, c(i), e(i) with ring, mod, (scalars with i, hi), (vals with i, hi)
  have tms : ∀ i ∈ n, innerAgainst(inner, e(j), w)(i) = inner(e(j), w(i))
    intros i hi
    have iNat := natural.member at n with hi
    have iN : i ∈ ℕ by exact iNat
    exact innerAgainst.apply with iN
  have s := InnerProductSpace.inner_sum at V, K, absK, conj, ofReal, inner, norm, e(j), w, innerAgainst(inner, e(j), w), n with space, ej, wvals, tms
  rw s
  have atJ : innerAgainst(inner, e(j), w)(j) = c(j)
    rw [(tms with j, member), (terms with j, member), (smulR with c(j), (scalars with j, member), e(j), ej, e(j), ej), (ones with j, member)]
    have cj := scalars with j, member
    ring
  have vj : innerAgainst(inner, e(j), w)(j) ∈ Group.carrier(Ring.additive(K))
    rw [Ring.additive.carrier, atJ]
    exact scalars with j, member
  have vanish : ∀ i ∈ n, i ≠ j → innerAgainst(inner, e(j), w)(i) = Group.one(Ring.additive(K))
    intros i hi ne
    have nej : j ≠ i
      intro eq
      apply ne
      rw eq
    rw [(tms with i, hi), (terms with i, hi), (smulR with c(i), (scalars with i, hi), e(j), ej, e(i), (vals with i, hi)), (zeros with j, member, i, hi, nej), Ring.additive.one]
    have ci := scalars with i, hi
    ring
  rw (groupFiniteSum.single_support with abelianK, (Finite.natural at n), member, vj, vanish)
  exact atJ

-- An orthonormal family is linearly independent.
theorem Orthonormal.independent (e c w : Set, n : Nat)
  requires orthonormal : Orthonormal(V, K, inner, e, n)
  requires scalars : ∀ i ∈ n, c(i) ∈ Ring.carrier(K)
  requires terms : ∀ i ∈ n, w(i) = Module.smul(V)(c(i), e(i))
  requires vanishes : groupFiniteSum(Module.additive(V), n, w) = Module.zero(V)
  shows ∀ i ∈ n, c(i) = Ring.zero(K)
proof
  have sp := space
  obtain ⟨rc, mod, innerF, normF, symm, addR, smulR, normEq, definite⟩ := sp
  have on := orthonormal
  obtain ⟨vals, ones, zeros⟩ := on
  intros j hj
  have co := Orthonormal.coefficient at V, K, absK, conj, ofReal, inner, norm, e, c, w, j, n with space, orthonormal, scalars, terms, hj
  rw vanishes at co
  rw (InnerProductSpace.zero_right at V, K, absK, conj, ofReal, inner, norm, e(j) with space, (vals with j, hj)) at co
  rw co

-- The projection lies in V, and ⟨e(j), Pv⟩ = ⟨e(j), v⟩.
theorem orthogonalProjection.terms (e v : Set, n : Nat)
  requires orthonormal : Orthonormal(V, K, inner, e, n)
  requires member : v ∈ Module.carrier(V)
  shows (∀ i ∈ n, innerCoefficients(inner, e, v)(i) ∈ Ring.carrier(K)) ∧
    (∀ i ∈ n, expansionTerms(V, inner, e, v)(i) =
      Module.smul(V)(innerCoefficients(inner, e, v)(i), e(i))) ∧
    (∀ i ∈ n, expansionTerms(V, inner, e, v)(i) ∈ Module.carrier(V))
proof
  have sp := space
  obtain ⟨rc, mod, innerF, normF, symm, addR, smulR, normEq, definite⟩ := sp
  have ring := Module.ring at V, K with mod
  have on := orthonormal
  obtain ⟨vals, ones, zeros⟩ := on
  have cv : ∀ i ∈ n, innerCoefficients(inner, e, v)(i) ∈ Ring.carrier(K)
    intros i hi
    have iNat := natural.member at n with hi
    have iN : i ∈ ℕ by exact iNat
    rw (innerCoefficients.apply with iN)
    have p := FunctionBetween.apply_closed with innerF, (product.pair with (vals with i, hi), member)
    have same : inner((e(i), v)) = inner(e(i), v)
      unfold Algebra.call2
      rfl
    rw same at p
    exact p
  have tv : ∀ i ∈ n, expansionTerms(V, inner, e, v)(i) =
      Module.smul(V)(innerCoefficients(inner, e, v)(i), e(i))
    intros i hi
    have iNat := natural.member at n with hi
    have iN : i ∈ ℕ by exact iNat
    rw [(innerCoefficients.apply with iN), (expansionTerms.apply with iN)]
  refine ⟨cv, tv, ?_⟩
  intros i hi
  rw (tv with i, hi)
  exact Module.smul_mem at K, V, innerCoefficients(inner, e, v)(i), e(i) with ring, mod, (cv with i, hi), (vals with i, hi)

theorem orthogonalProjection.member (e v : Set, n : Nat)
  requires orthonormal : Orthonormal(V, K, inner, e, n)
  requires member : v ∈ Module.carrier(V)
  shows orthogonalProjection(V, inner, e, v, n) ∈ Module.carrier(V)
proof
  have sp := space
  obtain ⟨rc, mod, innerF, normF, symm, addR, smulR, normEq, definite⟩ := sp
  have abelianV := Module.additive.abelian_group at V, K with mod
  obtain ⟨cv, tv, mv⟩ := orthogonalProjection.terms at V, K, absK, conj, ofReal, inner, norm, e, v, n with space, orthonormal, member
  have values : ∀ i ∈ n, expansionTerms(V, inner, e, v)(i) ∈ Group.carrier(Module.additive(V))
    intros i hi
    rw Module.additive.carrier
    exact mv with i, hi
  have m := groupFiniteSum.member with abelianV, (Finite.natural at n), values
  rw Module.additive.carrier at m
  unfold orthogonalProjection
  exact m

theorem orthogonalProjection.inner_basis (e v j : Set, n : Nat)
  requires orthonormal : Orthonormal(V, K, inner, e, n)
  requires member : v ∈ Module.carrier(V)
  requires index : j ∈ n
  shows inner(e(j), orthogonalProjection(V, inner, e, v, n)) = inner(e(j), v)
proof
  obtain ⟨cv, tv, mv⟩ := orthogonalProjection.terms at V, K, absK, conj, ofReal, inner, norm, e, v, n with space, orthonormal, member
  have c := Orthonormal.coefficient at V, K, absK, conj, ofReal, inner, norm, e, innerCoefficients(inner, e, v), expansionTerms(V, inner, e, v), j, n with space, orthonormal, cv, tv, index
  have jNat := natural.member at n with index
  have jN : j ∈ ℕ by exact jNat
  rw (innerCoefficients.apply with jN) at c
  unfold orthogonalProjection
  exact c

-- The projection Σ ⟨e(i), v⟩ e(i) leaves v − Pv orthogonal to every e(j),
-- does not increase the norm, is idempotent, and is v itself when e is a
-- basis.
theorem orthogonalProjection.orthogonal (e v j : Set, n : Nat)
  requires orthonormal : Orthonormal(V, K, inner, e, n)
  requires member : v ∈ Module.carrier(V)
  requires index : j ∈ n
  shows inner(e(j), Module.add(V)(v,
    Module.neg(V)(orthogonalProjection(V, inner, e, v, n)))) = Ring.zero(K)
proof
  have sp := space
  obtain ⟨rc, mod, innerF, normF, symm, addR, smulR, normEq, definite⟩ := sp
  have ring := Module.ring at V, K with mod
  have group := Module.additive_group at K, V with ring, mod
  have on := orthonormal
  obtain ⟨vals, ones, zeros⟩ := on
  have ej := vals with j, index
  have pv := orthogonalProjection.member at V, K, absK, conj, ofReal, inner, norm, e, v, n with space, orthonormal, member
  have npv := Module.neg_mem at K, V, orthogonalProjection(V, inner, e, v, n) with ring, mod, pv
  have pA : orthogonalProjection(V, inner, e, v, n) ∈ Group.carrier(Module.additive(V))
    rw Module.additive.carrier
    exact pv
  have pz := Group.mul_inv at Module.additive(V), orthogonalProjection(V, inner, e, v, n) with group, pA
  rw [Module.additive.mul, Module.additive.inv, Module.additive.one] at pz
  have a1 := addR with e(j), ej, v, member, Module.neg(V)(orthogonalProjection(V, inner, e, v, n)), npv
  have a2 := addR with e(j), ej, orthogonalProjection(V, inner, e, v, n), pv, Module.neg(V)(orthogonalProjection(V, inner, e, v, n)), npv
  rw [pz, (InnerProductSpace.zero_right at V, K, absK, conj, ofReal, inner, norm, e(j) with space, ej), (orthogonalProjection.inner_basis at V, K, absK, conj, ofReal, inner, norm, e, v, j, n with space, orthonormal, member, index)] at a2
  rw [a1, ← a2]

theorem orthogonalProjection.norm_le (e v : Set, n : Nat)
  requires orthonormal : Orthonormal(V, K, inner, e, n)
  requires member : v ∈ Module.carrier(V)
  shows norm(orthogonalProjection(V, inner, e, v, n)) ≤ norm(v)
proof
  have sp := space
  obtain ⟨rc, mod, innerF, normF, symm, addR, smulR, normEq, definite⟩ := sp
  have comm := RCLike.comm_ring with rc
  have ring := comm.left
  obtain ⟨cl, ops, cz⟩ := RCLike.conj_laws with rc
  have abelianK := Ring.additive.abelian_group at K with ring
  have abelianV := Module.additive.abelian_group at V, K with mod
  have group := Module.additive_group at K, V with ring, mod
  have on := orthonormal
  obtain ⟨vals, ones, zeros⟩ := on
  obtain ⟨cv, tv, mv⟩ := orthogonalProjection.terms at V, K, absK, conj, ofReal, inner, norm, e, v, n with space, orthonormal, member
  have pv := orthogonalProjection.member at V, K, absK, conj, ofReal, inner, norm, e, v, n with space, orthonormal, member
  have npv := Module.neg_mem at K, V, orthogonalProjection(V, inner, e, v, n) with ring, mod, pv
  have x := Module.add_mem at K, V, v, Module.neg(V)(orthogonalProjection(V, inner, e, v, n)) with ring, mod, member, npv
  have t2 : ∀ i ∈ n, innerAgainst(inner, Module.add(V)(v, Module.neg(V)(orthogonalProjection(V, inner, e, v, n))), expansionTerms(V, inner, e, v))(i) = inner(Module.add(V)(v, Module.neg(V)(orthogonalProjection(V, inner, e, v, n))), expansionTerms(V, inner, e, v)(i))
    intros i hi
    have iNat := natural.member at n with hi
    have iN : i ∈ ℕ by exact iNat
    exact innerAgainst.apply with iN
  have s := InnerProductSpace.inner_finite_sum at V, K, absK, conj, ofReal, inner, norm, Module.add(V)(v, Module.neg(V)(orthogonalProjection(V, inner, e, v, n))), expansionTerms(V, inner, e, v), innerAgainst(inner, Module.add(V)(v, Module.neg(V)(orthogonalProjection(V, inner, e, v, n))), expansionTerms(V, inner, e, v)), n with space, (Finite.natural at n), x, mv, t2
  have zs : ∀ i ∈ n, innerAgainst(inner, Module.add(V)(v, Module.neg(V)(orthogonalProjection(V, inner, e, v, n))), expansionTerms(V, inner, e, v))(i) = Group.one(Ring.additive(K))
    intros i hi
    have ei := vals with i, hi
    rw [(t2 with i, hi), (tv with i, hi), (smulR with innerCoefficients(inner, e, v)(i), (cv with i, hi), Module.add(V)(v, Module.neg(V)(orthogonalProjection(V, inner, e, v, n))), x, e(i), ei)]
    rw (symm with e(i), ei, Module.add(V)(v, Module.neg(V)(orthogonalProjection(V, inner, e, v, n))), x)
    rw [(orthogonalProjection.orthogonal at V, K, absK, conj, ofReal, inner, norm, e, v, i, n with space, orthonormal, member, hi), cz, Ring.additive.one]
    have ci := cv with i, hi
    ring
  have z := groupFiniteSum.zero with abelianK, (Finite.natural at n), zs
  rw [z, Ring.additive.one] at s
  rw ← (orthogonalProjection.eq_sum at V, inner, e, v, n) at s
  have orth : InnerOrthogonal(inner, orthogonalProjection(V, inner, e, v, n), Module.add(V)(v, Module.neg(V)(orthogonalProjection(V, inner, e, v, n))), K)
    unfold InnerOrthogonal
    exact (InnerProductSpace.eq_zero_symm at V, K, absK, conj, ofReal, inner, norm, Module.add(V)(v, Module.neg(V)(orthogonalProjection(V, inner, e, v, n))), orthogonalProjection(V, inner, e, v, n) with space, x, pv).forward with s
  have py := InnerProductSpace.pythagoras at V, K, absK, conj, ofReal, inner, norm, orthogonalProjection(V, inner, e, v, n), Module.add(V)(v, Module.neg(V)(orthogonalProjection(V, inner, e, v, n))) with space, pv, x, orth
  have pA : orthogonalProjection(V, inner, e, v, n) ∈ Group.carrier(Module.additive(V))
    rw Module.additive.carrier
    exact pv
  have vA : v ∈ Group.carrier(Module.additive(V))
    rw Module.additive.carrier
    exact member
  have ipA := Group.inv_mem at Module.additive(V), orthogonalProjection(V, inner, e, v, n) with group, pA
  have c1 := mul_comm at Module.additive(V), v, Group.inv(Module.additive(V))(orthogonalProjection(V, inner, e, v, n)) with abelianV, vA, ipA
  have c2 := mul_inv_cancel_left at Module.additive(V), orthogonalProjection(V, inner, e, v, n), v with group, pA, vA
  rw ← c1 at c2
  rw [Module.additive.mul, Module.additive.inv] at c2
  rw c2 at py
  obtain ⟨nvNn, nvEq⟩ := normEq with v, member
  obtain ⟨npNn, npEq⟩ := normEq with orthogonalProjection(V, inner, e, v, n), pv
  obtain ⟨nxNn, nxEq⟩ := normEq with Module.add(V)(v, Module.neg(V)(orthogonalProjection(V, inner, e, v, n))), x
  have nvR : Real(norm(v)) by exact (FunctionBetween.apply_closed with normF, member)
  have npR : Real(norm(orthogonalProjection(V, inner, e, v, n))) by exact (FunctionBetween.apply_closed with normF, pv)
  have nxR : Real(norm(Module.add(V)(v, Module.neg(V)(orthogonalProjection(V, inner, e, v, n))))) by exact (FunctionBetween.apply_closed with normF, x)
  have sq := realMulValue.square_nonnegative at norm(Module.add(V)(v, Module.neg(V)(orthogonalProjection(V, inner, e, v, n))))
  have le : norm(orthogonalProjection(V, inner, e, v, n)) * norm(orthogonalProjection(V, inner, e, v, n)) ≤ norm(v) * norm(v) by linarith
  exact realMulValue.le_of_square_le with npNn, nvNn, le

theorem orthogonalProjection.idempotent (e v : Set, n : Nat)
  requires orthonormal : Orthonormal(V, K, inner, e, n)
  requires member : v ∈ Module.carrier(V)
  shows orthogonalProjection(V, inner, e,
      orthogonalProjection(V, inner, e, v, n), n) =
    orthogonalProjection(V, inner, e, v, n)
proof
  obtain ⟨cv, tv, mv⟩ := orthogonalProjection.terms at V, K, absK, conj, ofReal, inner, norm, e, v, n with space, orthonormal, member
  have pv := orthogonalProjection.member at V, K, absK, conj, ofReal, inner, norm, e, v, n with space, orthonormal, member
  rw [(orthogonalProjection.eq_sum at V, inner, e, orthogonalProjection(V, inner, e, v, n), n)]
  rw [(orthogonalProjection.eq_sum at V, inner, e, v, n)]
  apply groupFiniteSum.congr
  intros i hi
  have iNat := natural.member at n with hi
  have iN : i ∈ ℕ by exact iNat
  rw [(expansionTerms.apply at V, inner, e, groupFiniteSum(Module.additive(V), n, expansionTerms(V, inner, e, v)), i with iN), (expansionTerms.apply at V, inner, e, v, i with iN)]
  have ib := orthogonalProjection.inner_basis at V, K, absK, conj, ofReal, inner, norm, e, v, i, n with space, orthonormal, member, hi
  rw (orthogonalProjection.eq_sum at V, inner, e, v, n) at ib
  rw ib

theorem orthogonalProjection.self_adjoint (e v w : Set, n : Nat)
  requires orthonormal : Orthonormal(V, K, inner, e, n)
  requires memberV : v ∈ Module.carrier(V)
  requires memberW : w ∈ Module.carrier(V)
  shows inner(orthogonalProjection(V, inner, e, v, n), w) =
    inner(v, orthogonalProjection(V, inner, e, w, n))
proof
  have sp := space
  obtain ⟨rc, mod, innerF, normF, symm, addR, smulR, normEq, definite⟩ := sp
  have comm := RCLike.comm_ring with rc
  obtain ⟨cl, ops, cz⟩ := RCLike.conj_laws with rc
  have on := orthonormal
  obtain ⟨vals, ones, zeros⟩ := on
  obtain ⟨cv, tv, mv⟩ := orthogonalProjection.terms at V, K, absK, conj, ofReal, inner, norm, e, v, n with space, orthonormal, memberV
  obtain ⟨cw, tw, mw⟩ := orthogonalProjection.terms at V, K, absK, conj, ofReal, inner, norm, e, w, n with space, orthonormal, memberW
  have t1 : ∀ i ∈ n, innerCoefficients(inner, expansionTerms(V, inner, e, v), w)(i) = inner(expansionTerms(V, inner, e, v)(i), w)
    intros i hi
    have iNat := natural.member at n with hi
    have iN : i ∈ ℕ by exact iNat
    exact innerCoefficients.apply with iN
  have t2 : ∀ i ∈ n, innerAgainst(inner, v, expansionTerms(V, inner, e, w))(i) = inner(v, expansionTerms(V, inner, e, w)(i))
    intros i hi
    have iNat := natural.member at n with hi
    have iN : i ∈ ℕ by exact iNat
    exact innerAgainst.apply with iN
  have s1 := InnerProductSpace.finite_sum_inner at V, K, absK, conj, ofReal, inner, norm, w, expansionTerms(V, inner, e, v), innerCoefficients(inner, expansionTerms(V, inner, e, v), w), n with space, (Finite.natural at n), memberW, mv, t1
  have s2 := InnerProductSpace.inner_finite_sum at V, K, absK, conj, ofReal, inner, norm, v, expansionTerms(V, inner, e, w), innerAgainst(inner, v, expansionTerms(V, inner, e, w)), n with space, (Finite.natural at n), memberV, mw, t2
  rw [(orthogonalProjection.eq_sum at V, inner, e, v, n), (orthogonalProjection.eq_sum at V, inner, e, w, n), s1, s2]
  apply groupFiniteSum.congr
  intros i hi
  have iNat := natural.member at n with hi
  have iN : i ∈ ℕ by exact iNat
  have ei := vals with i, hi
  rw [(t1 with i, hi), (t2 with i, hi), (tv with i, hi), (tw with i, hi)]
  rw [(InnerProductSpace.smul_left at V, K, absK, conj, ofReal, inner, norm, innerCoefficients(inner, e, v)(i), e(i), w with space, (cv with i, hi), ei, memberW), (smulR with innerCoefficients(inner, e, w)(i), (cw with i, hi), v, memberV, e(i), ei)]
  rw [(innerCoefficients.apply at inner, e, v, i with iN), (innerCoefficients.apply at inner, e, w, i with iN)]
  rw (InnerProductSpace.conj_symm at V, K, absK, conj, ofReal, inner, norm, e(i), v with space, ei, memberV)
  have p1 := FunctionBetween.apply_closed with innerF, (product.pair with memberV, ei)
  have p2 := FunctionBetween.apply_closed with innerF, (product.pair with ei, memberW)
  have same1 : inner((v, e(i))) = inner(v, e(i))
    unfold Algebra.call2
    rfl
  have same2 : inner((e(i), w)) = inner(e(i), w)
    unfold Algebra.call2
    rfl
  rw same1 at p1
  rw same2 at p2
  ring

-- Expansion in an orthonormal basis, and Parseval's identity.
theorem OrthonormalBasis.expansion (e v : Set, n : Nat)
  requires basis : OrthonormalBasis(V, K, inner, e, n)
  requires member : v ∈ Module.carrier(V)
  shows v = orthogonalProjection(V, inner, e, v, n)
proof
  have b := basis
  obtain ⟨orthonormal, spans⟩ := b
  obtain ⟨mod, vals, span⟩ := spans
  obtain ⟨c, w, cw, vEq⟩ := span with v, member
  have cs : ∀ i ∈ n, c(i) ∈ Ring.carrier(K)
    intros i hi
    exact (cw with i, hi).left
  have ws : ∀ i ∈ n, w(i) = Module.smul(V)(c(i), e(i))
    intros i hi
    exact (cw with i, hi).right
  rw (orthogonalProjection.eq_sum at V, inner, e, v, n)
  have congr : groupFiniteSum(Module.additive(V), n, expansionTerms(V, inner, e, v)) = groupFiniteSum(Module.additive(V), n, w)
    apply groupFiniteSum.congr
    intros i hi
    have iNat := natural.member at n with hi
    have iN : i ∈ ℕ by exact iNat
    rw [(expansionTerms.apply at V, inner, e, v, i with iN), (ws with i, hi)]
    have co := Orthonormal.coefficient at V, K, absK, conj, ofReal, inner, norm, e, c, w, i, n with space, orthonormal, cs, ws, hi
    rw ← vEq at co
    rw co
  rw congr
  exact vEq

theorem OrthonormalBasis.parseval (e v u : Set, n : Nat)
  requires basis : OrthonormalBasis(V, K, inner, e, n)
  requires member : v ∈ Module.carrier(V)
  requires terms : ∀ i ∈ n, u(i) = R[absK(inner(e(i), v)) * absK(inner(e(i), v))]
  shows R[norm(v) * norm(v)] = realFiniteSum(u, n)
proof
  sorry

-- Bessel's inequality for an orthonormal family.
theorem Orthonormal.bessel (e v u : Set, n : Nat)
  requires orthonormal : Orthonormal(V, K, inner, e, n)
  requires member : v ∈ Module.carrier(V)
  requires terms : ∀ i ∈ n, u(i) = R[absK(inner(e(i), v)) * absK(inner(e(i), v))]
  shows realFiniteSum(u, n) ≤ R[norm(v) * norm(v)]
proof
  sorry

-- Gram–Schmidt: a finite-dimensional inner-product space has an
-- orthonormal basis (Mathlib's stdOrthonormalBasis), and every orthonormal
-- family extends to one.
theorem OrthonormalBasis.exists
  requires finite : FiniteDimensionalModule(V, K)
  shows ∃ n ∈ ℕ, ∃ e, OrthonormalBasis(V, K, inner, e, n)
proof
  sorry

theorem OrthonormalBasis.extend (e : Set, m : Nat)
  requires finite : FiniteDimensionalModule(V, K)
  requires orthonormal : Orthonormal(V, K, inner, e, m)
  shows ∃ n ∈ ℕ, m ≤ n ∧ (∃ f, OrthonormalBasis(V, K, inner, f, n) ∧
    (∀ i ∈ m, f(i) = e(i)))
proof
  sorry

-- Two orthonormal bases have the same length.
theorem OrthonormalBasis.length_unique (e f : Set, m n : Nat)
  requires first : OrthonormalBasis(V, K, inner, e, m)
  requires second : OrthonormalBasis(V, K, inner, f, n)
  shows m = n
proof
  sorry

-- Section: Operators
-- Every linear operator of a finite-dimensional inner-product space has a
-- unique adjoint, which is linear.
theorem IsAdjoint.exists (T : Set)
  requires finite : FiniteDimensionalModule(V, K)
  requires linear : IsLinearMap(T, V, V, K)
  shows ∃ S, IsLinearMap(S, V, V, K) ∧ IsAdjoint(inner, S, T, V)
proof
  sorry

theorem IsAdjoint.unique (S1 S2 T : Set)
  requires functionS1 : S1 : Module.carrier(V) → Module.carrier(V)
  requires functionS2 : S2 : Module.carrier(V) → Module.carrier(V)
  requires first : IsAdjoint(inner, S1, T, V)
  requires second : IsAdjoint(inner, S2, T, V)
  shows ∀ v ∈ Module.carrier(V), S1(v) = S2(v)
proof
  have sp := space
  obtain ⟨rc, mod, innerF, normF, symm, addR, smulR, normEq, definite⟩ := sp
  intros v hv
  have s1 := FunctionBetween.apply_closed with functionS1, hv
  have s2 := FunctionBetween.apply_closed with functionS2, hv
  apply InnerProductSpace.ext at V, K, absK, conj, ofReal, inner, norm, S1(v), S2(v) with space, s1, s2
  intros u hu
  rw [(symm with S1(v), s1, u, hu), (symm with S2(v), s2, u, hu)]
  rw [(first with v, hv, u, hu), (second with v, hv, u, hu)]

-- The spectral theorem: a self-adjoint operator of a finite-dimensional
-- space has an orthonormal basis of eigenvectors with real eigenvalues.
theorem SelfAdjoint.spectral (T : Set)
  requires finite : FiniteDimensionalModule(V, K)
  requires linear : IsLinearMap(T, V, V, K)
  requires selfAdjoint : SelfAdjoint(inner, T, V)
  shows ∃ n ∈ ℕ, ∃ e, ∃ λ, OrthonormalBasis(V, K, inner, e, n) ∧
    (∀ i ∈ n, λ(i) ∈ ℝ ∧ T(e(i)) = Module.smul(V)(ofReal(λ(i)), e(i)))
proof
  sorry

-- A self-adjoint operator is positive exactly when its eigenvalues are
-- nonnegative.
theorem PositiveOperator.iff_eigenvalues (T e λ : Set, n : Nat)
  requires linear : IsLinearMap(T, V, V, K)
  requires basis : OrthonormalBasis(V, K, inner, e, n)
  requires eigen : ∀ i ∈ n, λ(i) ∈ ℝ ∧ T(e(i)) = Module.smul(V)(ofReal(λ(i)), e(i))
  shows PositiveOperator(inner, ofReal, T, V) ↔ (∀ i ∈ n, realZero ≤ λ(i))
proof
  sorry

-- Mathlib's IsStrictlyPositive.add_nonneg: strictly positive plus
-- positive is strictly positive.
theorem StrictlyPositiveOperator.add_positive (S T U : Set)
  requires first : StrictlyPositiveOperator(inner, ofReal, S, V)
  requires second : PositiveOperator(inner, ofReal, T, V)
  requires mapS : S : Module.carrier(V) → Module.carrier(V)
  requires mapT : T : Module.carrier(V) → Module.carrier(V)
  requires sum : ∀ v ∈ Module.carrier(V), U(v) = Module.add(V)(S(v), T(v))
  shows StrictlyPositiveOperator(inner, ofReal, U, V)
proof
  sorry

-- A positive operator of a finite-dimensional space has a unique positive
-- square root.
theorem PositiveOperator.sqrt_exists (T : Set)
  requires finite : FiniteDimensionalModule(V, K)
  requires linear : IsLinearMap(T, V, V, K)
  requires positive : PositiveOperator(inner, ofReal, T, V)
  shows ∃ S, IsLinearMap(S, V, V, K) ∧ PositiveOperator(inner, ofReal, S, V) ∧
    (∀ v ∈ Module.carrier(V), S(S(v)) = T(v))
proof
  sorry

theorem PositiveOperator.sqrt_unique (T S1 S2 : Set)
  requires finite : FiniteDimensionalModule(V, K)
  requires linear1 : IsLinearMap(S1, V, V, K)
  requires linear2 : IsLinearMap(S2, V, V, K)
  requires positive1 : PositiveOperator(inner, ofReal, S1, V)
  requires positive2 : PositiveOperator(inner, ofReal, S2, V)
  requires square1 : ∀ v ∈ Module.carrier(V), S1(S1(v)) = T(v)
  requires square2 : ∀ v ∈ Module.carrier(V), S2(S2(v)) = T(v)
  shows ∀ v ∈ Module.carrier(V), S1(v) = S2(v)
proof
  sorry

-- The operator norm of a self-adjoint operator is the largest |λ|, and
-- ‖T* T‖ = ‖T‖².
theorem SelfAdjoint.opNorm_eigenvalues (T e λ : Set, n : Nat)
  requires linear : IsLinearMap(T, V, V, K)
  requires basis : OrthonormalBasis(V, K, inner, e, n)
  requires eigen : ∀ i ∈ n, λ(i) ∈ ℝ ∧ T(e(i)) = Module.smul(V)(ofReal(λ(i)), e(i))
  shows (∀ i ∈ n, abs(λ(i)) ≤ opNorm(T, V, norm, norm)) ∧
    (∀ C ∈ ℝ, realZero ≤ C → (∀ i ∈ n, abs(λ(i)) ≤ C) →
      opNorm(T, V, norm, norm) ≤ C)
proof
  sorry

-- The ℓ² operator norm is at most the Frobenius norm (the form of
-- Mathlib's Matrix.l2_opNorm_mulVec the source uses): for an orthonormal
-- basis e, ‖T‖² ≤ Σ_j ‖T e(j)‖².
theorem opNorm.le_frobenius (T e u : Set, n : Nat)
  requires linear : IsLinearMap(T, V, V, K)
  requires basis : OrthonormalBasis(V, K, inner, e, n)
  requires terms : ∀ j ∈ n, u(j) = R[norm(T(e(j))) * norm(T(e(j)))]
  shows R[opNorm(T, V, norm, norm) * opNorm(T, V, norm, norm)] ≤
    realFiniteSum(u, n)
proof
  sorry

end InnerProductLaws

-- Section: Euclidean space
theorem euclideanModule.module (K : Set, n : Nat)
  requires ring : Ring(K)
  shows Module(euclideanModule(K, n), K)
proof
  sorry

theorem euclideanModule.carrier (K : Set, n : Nat)
  shows Module.carrier(euclideanModule(K, n)) = functionSpace(n, Ring.carrier(K))
proof
  unfold euclideanModule
  simp [Module.mk.carrier]

theorem euclideanModule.inner_product (K absK conj ofReal : Set, n : Nat)
  requires scalars : RCLike(K, absK, conj, ofReal)
  shows InnerProductSpace(euclideanModule(K, n), K, absK, conj, ofReal,
    euclideanInner(K, conj, n), euclideanNorm(K, absK, n))
proof
  sorry

theorem euclideanModule.finite_dimensional (K : Set, n : Nat)
  requires ring : Ring(K)
  shows FiniteDimensionalModule(euclideanModule(K, n), K)
proof
  sorry

theorem standardBasis.orthonormal_basis (K absK conj ofReal : Set, n : Nat)
  requires scalars : RCLike(K, absK, conj, ofReal)
  shows OrthonormalBasis(euclideanModule(K, n), K, euclideanInner(K, conj, n),
    standardBasis(K, n), n)
proof
  sorry

-- Coordinates: ⟨e_j, x⟩ = x(j).
theorem standardBasis.inner (K absK conj ofReal x j : Set, n : Nat)
  requires scalars : RCLike(K, absK, conj, ofReal)
  requires member : x ∈ functionSpace(n, Ring.carrier(K))
  requires index : j ∈ n
  shows euclideanInner(K, conj, n)(standardBasis(K, n)(j), x) = x(j)
proof
  sorry

-- Mathlib's EuclideanSpace.norm_eq.
theorem euclideanNorm.value (K absK x : Set, n : Nat)
  requires scalars : RealOrComplexScalars(K, absK)
  requires member : x ∈ functionSpace(n, Ring.carrier(K))
  shows euclideanNorm(K, absK, n)(x) =
    realSqrt(realFiniteSum(euclideanSquareTerms(absK, x), n))
proof
  sorry

-- The Euclidean norm dominates every coordinate and is dominated by √n
-- times the sup norm.
theorem euclideanNorm.coordinate_le (K absK conj ofReal x j : Set, n : Nat)
  requires scalars : RCLike(K, absK, conj, ofReal)
  requires member : x ∈ functionSpace(n, Ring.carrier(K))
  requires index : j ∈ n
  shows absK(x(j)) ≤ euclideanNorm(K, absK, n)(x)
proof
  sorry

theorem euclideanNorm.le_sup (K absK conj ofReal x : Set, n : Nat)
  requires scalars : RCLike(K, absK, conj, ofReal)
  requires member : x ∈ functionSpace(n, Ring.carrier(K))
  shows euclideanNorm(K, absK, n)(x) ≤
    R[realSqrt(realNat(n)) * supNorm(n, absK, x)]
proof
  sorry

-- Every finite-dimensional inner-product space is isometric to 𝕜ⁿ through
-- the coordinates in an orthonormal basis.
theorem OrthonormalBasis.coordinates_isometry (V K absK conj ofReal inner norm e : Set, n : Nat)
  requires space : InnerProductSpace(V, K, absK, conj, ofReal, inner, norm)
  requires basis : OrthonormalBasis(V, K, inner, e, n)
  shows ∃ φ, IsLinearMap(φ, V, euclideanModule(K, n), K) ∧
    BijectiveBetween(φ, Module.carrier(V), functionSpace(n, Ring.carrier(K))) ∧
    (∀ v ∈ Module.carrier(V), ∀ j ∈ n, φ(v)(j) = inner(e(j), v)) ∧
    (∀ v ∈ Module.carrier(V), ∀ w ∈ Module.carrier(V),
      euclideanInner(K, conj, n)(φ(v), φ(w)) = inner(v, w))
proof
  sorry

theorem RCLike.real
  shows RCLike(realRing, realAbs, identity(ℝ), identity(ℝ))
proof
  left
  exact ⟨rfl, rfl, rfl, rfl⟩

theorem RCLike.complex
  shows RCLike(complexRing, complexAbs, complexConj, complexOfReal)
proof
  right
  exact ⟨rfl, rfl, rfl, rfl⟩

end InnerProducts
