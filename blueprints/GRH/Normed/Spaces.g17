-- Normed and Banach spaces over a normed field: modules with a norm
-- compatible with the action; linear and continuous linear maps, the
-- bound that makes a linear map continuous, the operator norm and its
-- laws, composition; finite-dimensional spaces over ℝ and ℂ, where every
-- linear map is continuous, the space is complete, closed balls are
-- compact, and all norms are equivalent; ℝ and ℂ as normed spaces.
-- Part of the GRH blueprint.
-- Planned home: Analysis/Normed/Space.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Normed.Spaces
import GRH.Normed.Groups

section NormedSpaces
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Section: Definitions
-- A normed space over the normed field (K, |·|): a K-module whose additive
-- group carries a norm with ‖c • v‖ = |c| ‖v‖ (Mathlib's NormedSpace over
-- a NormedField). The module is Cumulus's bundled Module(V, K).
predicate NormedSpace (V K absK norm : Set) :=
  NormedField(K, absK) ∧ Module(V, K) ∧
  NormedGroup(Module.additive(V), norm) ∧
  (∀ c ∈ Ring.carrier(K), ∀ v ∈ Module.carrier(V),
    norm(Module.smul(V)(c, v)) = R[absK(c) * norm(v)])

-- The metric space and the topology of a normed space.
def spaceMetric (V norm : Set) : Set := normMetric(Module.additive(V), norm)
def spaceTopology (V norm : Set) : Set := normTopology(Module.additive(V), norm)

-- A Banach space is a complete normed space.
predicate BanachSpace (V K absK norm : Set) :=
  NormedSpace(V, K, absK, norm) ∧ Complete(spaceMetric(V, norm))

-- A K-linear map between K-modules, read on the carrier of V (a local
-- form, to be identified with layer 2 track A's linear maps).
predicate IsLinearMap (f V W K : Set) :=
  Module(V, K) ∧ Module(W, K) ∧
  (f : Module.carrier(V) → Module.carrier(W)) ∧
  (∀ v ∈ Module.carrier(V), ∀ w ∈ Module.carrier(V),
    f(Module.add(V)(v, w)) = Module.add(W)(f(v), f(w))) ∧
  (∀ c ∈ Ring.carrier(K), ∀ v ∈ Module.carrier(V),
    f(Module.smul(V)(c, v)) = Module.smul(W)(c, f(v)))

-- A continuous linear map between normed spaces (Mathlib's
-- ContinuousLinearMap, E →L[𝕜] F).
predicate ContinuousLinearMap (f V normV W normW K : Set) :=
  IsLinearMap(f, V, W, K) ∧
  f : spaceTopology(V, normV) ⇒ spaceTopology(W, normW)

-- ‖f(v)‖ ≤ C ‖v‖ for every v.
predicate LinearBound (f V normV normW C : Set) :=
  C ∈ ℝ ∧ realZero ≤ C ∧
  (∀ v ∈ Module.carrier(V), normW(f(v)) ≤ R[C * normV(v)])

-- The bounds of f, as a set of reals.
def linearBoundSet (f V normV normW : Set) : Set :=
  { D ∈ ℝ | LinearBound(f, V, normV, normW, D) }

-- The operator norm: the least bound (Mathlib's ContinuousLinearMap.opNorm).
defunique opNorm (f V normV normW : Set) (C ∈ ℝ) :=
  LinearBound(f, V, normV, normW, C) ∧
  (∀ D, LinearBound(f, V, normV, normW, D) → C ≤ D)
requires bounded : ∃ C, LinearBound(f, V, normV, normW, C)
requires real : ∀ v ∈ Module.carrier(V), normV(v) ∈ ℝ ∧ normW(f(v)) ∈ ℝ
proof
  obtain ⟨C0, lb0⟩ := bounded
  have lb0b := lb0
  obtain ⟨C0In, C0Nn, C0Bound⟩ := lb0b
  have sub : linearBoundSet(f, V, normV, normW) ⊆ ℝ
    intros x hx
    exact (linearBoundSet.membership.forward with hx).left
  have C0Mem : C0 ∈ linearBoundSet(f, V, normV, normW)
    apply linearBoundSet.membership.backward
    exact ⟨C0In, lb0⟩
  have ne : Nonempty(linearBoundSet(f, V, normV, normW))
    unfold Nonempty
    exact ⟨C0, C0Mem⟩
  have zeroIn : (0:R) ∈ ℝ by typecheck
  have zeroLower : ∀ x ∈ linearBoundSet(f, V, normV, normW), (0:R) ≤ x
    intros x hx
    have hx2 := linearBoundSet.membership.forward with hx
    obtain ⟨xIn, xIn2, xNn, xBound⟩ := hx2
    exact xNn
  obtain ⟨U, UIn, lower, greatest⟩ := Real.inf_exists with sub, ne, ⟨(0:R), zeroIn, zeroLower⟩
  have UR : Real(U) by exact UIn
  have UNn := greatest with (0:R), zeroIn, zeroLower
  have C0R : Real(C0) by exact C0In
  have UC0 := lower with C0, C0Mem
  refine ⟨U, UIn, ?_, ?_⟩
  . unfold LinearBound
    refine ⟨UIn, UNn, ?_⟩
    intros v hv
    obtain ⟨nIn, wIn⟩ := real with v, hv
    have nR : Real(normV(v)) by exact nIn
    have wR : Real(normW(f(v))) by exact wIn
    by_cases pos : (0:R) < normV(v)
    . have nNe : normV(v) ≠ (0:R)
        intro e0
        rw e0 at pos
        linarith
      have qMul := realDiv.mul_right at normW(f(v)), normV(v) with nNe
      have qIn : normW(f(v)) / normV(v) ∈ ℝ by typecheck
      have qR : Real(normW(f(v)) / normV(v)) by exact qIn
      have qLower : ∀ x ∈ linearBoundSet(f, V, normV, normW), normW(f(v)) / normV(v) ≤ x
        intros x hx
        have hx2 := linearBoundSet.membership.forward with hx
        obtain ⟨xIn, xIn2, xNn, xBound⟩ := hx2
        have xR : Real(x) by exact xIn
        have b := xBound with v, hv
        rw ← qMul at b
        exact realLe.mul_right_cancel_positive at normW(f(v)) / normV(v), x, normV(v) with pos, b
      have qU := greatest with normW(f(v)) / normV(v), qIn, qLower
      have nNn : (0:R) ≤ normV(v) by linarith
      have m := realLe.mul_right_of_nonnegative at normW(f(v)) / normV(v), U, normV(v) with qU, nNn
      rw qMul at m
      exact m
    . have b := C0Bound with v, hv
      have nNp : (0:R) ≤ (0:R) - normV(v) by linarith
      have dNn : (0:R) ≤ C0 - U by linarith
      have m := realLe.mul_left_of_nonnegative at (0:R), (0:R) - normV(v), C0 - U with nNp, dNn
      have ex : (C0 - U) * ((0:R) - normV(v)) = U * normV(v) - C0 * normV(v) by ring
      have ez : (C0 - U) * (0:R) = (0:R) by ring
      rw [ex, ez] at m
      linarith
  . intros D lbD
    have lbD2 := lbD
    obtain ⟨DIn, DNn, DBound⟩ := lbD2
    have DMem : D ∈ linearBoundSet(f, V, normV, normW)
      apply linearBoundSet.membership.backward
      exact ⟨DIn, lbD⟩
    exact lower with D, DMem
uniqueness
  intros C1 C1In p1 C2 C2In p2
  obtain ⟨lb1, min1⟩ := p1
  obtain ⟨lb2, min2⟩ := p2
  have le12 := min1 with C2, lb2
  have le21 := min2 with C1, lb1
  have r1 : Real(C1) by exact C1In
  have r2 : Real(C2) by exact C2In
  linarith

-- A finite family b(0), …, b(n − 1) spans V over K when every vector is a
-- linear combination of it; V is finite-dimensional when some finite
-- family spans it (local forms, to be identified with track A's span and
-- finrank).
predicate SpansModule (V K b : Set, n : Nat) :=
  Module(V, K) ∧ (∀ i ∈ n, b(i) ∈ Module.carrier(V)) ∧
  (∀ v ∈ Module.carrier(V), ∃ c, ∃ w,
    (∀ i ∈ n, c(i) ∈ Ring.carrier(K) ∧ w(i) = Module.smul(V)(c(i), b(i))) ∧
    v = groupFiniteSum(Module.additive(V), n, w))
predicate FiniteDimensionalModule (V K : Set) :=
  ∃ n ∈ ℕ, ∃ b, SpansModule(V, K, b, n)

-- Two norms are equivalent when each is bounded by a multiple of the other.
predicate EquivalentNorms (V norm1 norm2 : Set) :=
  ∃ A ∈ ℝ, ∃ B ∈ ℝ, realZero < A ∧ realZero < B ∧
    (∀ v ∈ Module.carrier(V), norm1(v) ≤ R[A * norm2(v)]) ∧
    (∀ v ∈ Module.carrier(V), norm2(v) ≤ R[B * norm1(v)])

-- ℝ and ℂ as modules over themselves, and ℂ as a real module.
def realSelfModule : Set := selfModule(realRing)
def complexSelfModule : Set := selfModule(complexRing)

-- Section: Small scalars
-- In a normed field the norms of the powers of y are bounded by the
-- powers of its norm; a nontrivially normed field has nonzero scalars of
-- arbitrarily small norm.
theorem NormedField.norm_real (K absK z : Set)
  requires normed : NormedField(K, absK)
  requires member : z ∈ Ring.carrier(K)
  shows absK(z) ∈ ℝ ∧ realZero ≤ absK(z)
proof
  obtain ⟨field, comm, nr, mulEq, oneEq⟩ := normed
  obtain ⟨ring, ng, sub⟩ := nr
  obtain ⟨abelian, isNorm⟩ := ng
  obtain ⟨normF, nonneg, zeroIff, invar, tri⟩ := isNorm
  have zA : z ∈ Group.carrier(Ring.additive(K))
    rw Ring.additive.carrier
    exact member
  exact ⟨(FunctionBetween.apply_closed with normF, zA), (nonneg with z, zA)⟩

theorem NormedField.power_small (K absK y : Set, n : Nat)
  requires normed : NormedField(K, absK)
  requires member : y ∈ Ring.carrier(K)
  requires positive : realZero < absK(y)
  shows ∃ t ∈ Ring.carrier(K), realZero < absK(t) ∧
    (absK(t):R) ≤ (absK(y):R) ^ n
proof
  have n2 := normed
  obtain ⟨field, comm, nr, mulEq, oneEq⟩ := n2
  have ring := nr.left
  induction n
  | zero =>
    have yR := (NormedField.norm_real at K, absK, y with normed, member).left
    have yRR : Real(absK(y)) by exact yR
    have oneIn := Ring.one_mem at K with ring
    have pz := monoidPow.zero at realMul, realOne, absK(y)
    refine ⟨Ring.one(K), oneIn, ?_, ?_⟩
    . rw oneEq
      exact realZero.lt_one
    . rw [oneEq, pz]
      have one := realZero.lt_one
      linarith
  | succ(k) using ih =>
    obtain ⟨t, tIn, tPos, tLe⟩ := ih
    have prodIn := Ring.mul_mem at K, y, t with ring, member, tIn
    have e := mulEq with y, member, t, tIn
    have tR := (NormedField.norm_real at K, absK, t with normed, tIn).left
    have tRR : Real(absK(t)) by exact tR
    have yR := (NormedField.norm_real at K, absK, y with normed, member).left
    have yRR : Real(absK(y)) by exact yR
    have pR := realPow.real at absK(y), k
    refine ⟨Ring.mul(K)(y, t), prodIn, ?_, ?_⟩
    . rw e
      have p := realLess.mul_right_of_positive at (0:R), absK(y), absK(t) with positive, tPos
      have z0 : (0:R) * absK(t) = (0:R) by ring
      rw z0 at p
      exact p
    . rw [e, monoidPow.succ]
      have yNn : (0:R) ≤ absK(y) by linarith
      exact realLe.mul_left_of_nonnegative with tLe, yNn

theorem NontriviallyNormedField.small (K absK : Set, r : Real)
  requires nontrivial : NontriviallyNormedField(K, absK)
  requires positive : realZero < r
  shows ∃ t ∈ Ring.carrier(K), realZero < absK(t) ∧ absK(t) < r
proof
  obtain ⟨normed, x, xIn, big⟩ := nontrivial
  have n2 := normed
  obtain ⟨field, comm, nr, mulEq, oneEq⟩ := n2
  have nr2 := nr
  obtain ⟨ring, ng, sub⟩ := nr2
  obtain ⟨abelian, isNorm⟩ := ng
  obtain ⟨normF, nonneg, zeroIff, invar, tri⟩ := isNorm
  have xR := (NormedField.norm_real at K, absK, x with normed, xIn).left
  have xRR : Real(absK(x)) by exact xR
  have xNe : x ≠ Ring.zero(K)
    intro eq
    have xA : x ∈ Group.carrier(Ring.additive(K))
      rw Ring.additive.carrier
      exact xIn
    have iff := zeroIff with x, xA
    have z : absK(x) = realZero
      apply iff.backward
      rw Ring.additive.one
      exact eq
    rw z at big
    have bad := realZero.lt_one
    linarith
  have fieldParts := Field.parts with field
  obtain ⟨y, inv⟩ := IsField.inverse_exists with fieldParts, xIn, xNe
  obtain ⟨xIn2, yIn, yx, xy⟩ := inv
  have prod := mulEq with x, xIn, y, yIn
  rw [xy, oneEq] at prod
  have yNR := NormedField.norm_real at K, absK, y with normed, yIn
  have yR := yNR.left
  have yRR : Real(absK(y)) by exact yR
  have yNn := yNR.right
  have yPos : (0:R) < absK(y)
    by_contra notPos
    have z : absK(y) = (0:R) by linarith
    rw z at prod
    have bad : (1:R) = (0:R)
      rw prod
      ring
    have lt := realZero.lt_one
    linarith
  have yLt : absK(y) < (1:R)
    by_contra notLt
    have ge : (1:R) ≤ absK(y) by linarith
    have xNn : (0:R) ≤ absK(x) by linarith
    have m := realLe.mul_left_of_nonnegative at (1:R), absK(y), absK(x) with ge, xNn
    have xm : absK(x) * (1:R) = absK(x) by ring
    rw xm at m
    have bad : (1:R) < (1:R)
      rw prod at big
      linarith
    linarith
  have gap : (0:R) < (1:R) - absK(y) by linarith
  have c := realLess.mul_right_of_positive at (0:R), (1:R) - absK(y), r with gap, positive
  have z0 : (0:R) * r = (0:R) by ring
  rw z0 at c
  have cPos : (0:R) < ((1:R) - absK(y)) * r := c
  have cNe : ((1:R) - absK(y)) * r ≠ (0:R)
    intro e
    rw e at cPos
    linarith
  obtain ⟨n, nNat, below⟩ := Real.below_natural at (1:R) / (((1:R) - absK(y)) * r)
  have nR := realNat.real at n
  have nRR : Real(realNat(n)) by exact nR
  have inv1 := realDiv.mul_left at (1:R), ((1:R) - absK(y)) * r with cNe
  have scaled := realLess.mul_left_of_positive at (1:R) / (((1:R) - absK(y)) * r), realNat(n), ((1:R) - absK(y)) * r with below, cPos
  rw inv1 at scaled
  have decay := realPow.decay_bound at absK(y), n with yNn, yLt
  have pR := realPow.real at absK(y), n
  have pNn := realPow.nonnegative at absK(y), n with yNn
  have conv : realPow(absK(y), n) = monoidPow(realMul, realOne, absK(y), n)
    unfold realPow
    rfl
  rw conv at decay
  rw conv at pR
  rw conv at pNn
  have pRR : Real((absK(y):R) ^ n) by exact pR
  have powSmall : (absK(y):R) ^ n < r
    by_contra notSmall
    have ge : r ≤ (absK(y):R) ^ n by linarith
    have fNn : (0:R) ≤ (realNat(n):R) * ((1:R) - absK(y))
      have nNn := realNat.nonnegative at n
      have gl : (0:R) ≤ (1:R) - absK(y) by linarith
      have pr := realLe.mul_left_of_nonnegative at (0:R), (1:R) - absK(y), realNat(n) with gl, nNn
      have z1 : (realNat(n):R) * (0:R) = (0:R) by ring
      rw z1 at pr
      exact pr
    have m := realLe.mul_right_of_nonnegative at r, (absK(y):R) ^ n, (realNat(n):R) * ((1:R) - absK(y)) with ge, fNn
    ring_nf at decay
    ring_nf at scaled
    ring_nf at m
    ring_nf at pNn
    have bad : (1:R) < (1:R) by linarith
    linarith
  obtain ⟨t, tIn, tPos, tLe⟩ := NormedField.power_small at K, absK, y, n with normed, yIn, yPos
  refine ⟨t, tIn, tPos, ?_⟩
  linarith

-- Section: The metric of a normed space
-- The norm of a normed space is a real-valued function, nonnegative and
-- zero only at 0; the metric is d(x, y) = ‖x − y‖.
theorem NormedSpace.norm_real (V K absK norm v : Set)
  requires normed : NormedSpace(V, K, absK, norm)
  requires member : v ∈ Module.carrier(V)
  shows norm(v) ∈ ℝ ∧ realZero ≤ norm(v)
proof
  obtain ⟨nf, mod, ng, law⟩ := normed
  obtain ⟨abelian, isNorm⟩ := ng
  obtain ⟨normF, nonneg, zeroIff, invar, tri⟩ := isNorm
  have vA : v ∈ Group.carrier(Module.additive(V))
    rw Module.additive.carrier
    exact member
  exact ⟨(FunctionBetween.apply_closed with normF, vA), (nonneg with v, vA)⟩

theorem NormedSpace.norm_eq_zero (V K absK norm v : Set)
  requires normed : NormedSpace(V, K, absK, norm)
  requires member : v ∈ Module.carrier(V)
  shows norm(v) = realZero ↔ v = Module.zero(V)
proof
  obtain ⟨nf, mod, ng, law⟩ := normed
  obtain ⟨abelian, isNorm⟩ := ng
  obtain ⟨normF, nonneg, zeroIff, invar, tri⟩ := isNorm
  have vA : v ∈ Group.carrier(Module.additive(V))
    rw Module.additive.carrier
    exact member
  have z := zeroIff with v, vA
  rw Module.additive.one at z
  exact z

theorem NormedSpace.norm_add_le (V K absK norm v w : Set)
  requires normed : NormedSpace(V, K, absK, norm)
  requires memberV : v ∈ Module.carrier(V)
  requires memberW : w ∈ Module.carrier(V)
  shows norm(Module.add(V)(v, w)) ≤ R[norm(v) + norm(w)]
proof
  obtain ⟨nf, mod, ng, law⟩ := normed
  obtain ⟨abelian, isNorm⟩ := ng
  obtain ⟨normF, nonneg, zeroIff, invar, tri⟩ := isNorm
  have vA : v ∈ Group.carrier(Module.additive(V))
    rw Module.additive.carrier
    exact memberV
  have wA : w ∈ Group.carrier(Module.additive(V))
    rw Module.additive.carrier
    exact memberW
  have t := tri with v, vA, w, wA
  rw Module.additive.mul at t
  exact t

theorem NormedSpace.norm_neg (V K absK norm v : Set)
  requires normed : NormedSpace(V, K, absK, norm)
  requires member : v ∈ Module.carrier(V)
  shows norm(Module.neg(V)(v)) = norm(v)
proof
  obtain ⟨nf, mod, ng, law⟩ := normed
  obtain ⟨abelian, isNorm⟩ := ng
  obtain ⟨normF, nonneg, zeroIff, invar, tri⟩ := isNorm
  have vA : v ∈ Group.carrier(Module.additive(V))
    rw Module.additive.carrier
    exact member
  have t := invar with v, vA
  rw Module.additive.inv at t
  exact t

theorem Module.neg_zero (V K : Set)
  requires module : Module(V, K)
  shows Module.neg(V)(Module.zero(V)) = Module.zero(V)
proof
  have group := Module.additive_group with module
  have e := inv_one at Module.additive(V) with group
  rw [Module.additive.inv, Module.additive.one] at e
  exact e

theorem spaceMetric.metric (V K absK norm : Set)
  requires normed : NormedSpace(V, K, absK, norm)
  shows MetricSpace(spaceMetric(V, norm))
proof
  have ng := normed.right.right.left
  unfold spaceMetric
  exact normMetric.metric at Module.additive(V), norm with ng

theorem spaceMetric.carrier (V norm : Set)
  shows MetricSpace.carrier(spaceMetric(V, norm)) = Module.carrier(V)
proof
  unfold spaceMetric
  unfold normMetric
  metric_projections
  rw Module.additive.carrier

theorem spaceTopology.metric_eq (V norm : Set)
  shows spaceTopology(V, norm) = metricTopology(spaceMetric(V, norm))
proof
  unfold spaceTopology
  unfold spaceMetric
  unfold normTopology
  rfl

theorem spaceMetric.dist (V K absK norm x y : Set)
  requires normed : NormedSpace(V, K, absK, norm)
  requires memberX : x ∈ Module.carrier(V)
  requires memberY : y ∈ Module.carrier(V)
  shows MetricSpace.dist(spaceMetric(V, norm))(x, y) =
    norm(Module.add(V)(x, Module.neg(V)(y)))
proof
  have ng := normed.right.right.left
  have xA : x ∈ Group.carrier(Module.additive(V))
    rw Module.additive.carrier
    exact memberX
  have yA : y ∈ Group.carrier(Module.additive(V))
    rw Module.additive.carrier
    exact memberY
  have d := normMetric.dist at Module.additive(V), norm, x, y with ng, xA, yA
  rw [Module.additive.mul, Module.additive.inv] at d
  unfold spaceMetric
  exact d


-- The norms of the nonzero scalars t with |t| a < e, for the shell
-- rescaling below.
def shellScalars (K absK a e : Set) : Set :=
  { s ∈ ℝ | ∃ t ∈ Ring.carrier(K), realZero < absK(t) ∧ s = absK(t) ∧
    R[absK(t) * a] < e }

-- (a − b) • x = a • x − b • x and b • (x − y) = b • x − b • y.
theorem Module.sub_smul (V K a b x : Set)
  requires module : Module(V, K)
  requires memberA : a ∈ Ring.carrier(K)
  requires memberB : b ∈ Ring.carrier(K)
  requires memberX : x ∈ Module.carrier(V)
  shows Module.smul(V)(Ring.add(K)(a, Ring.neg(K)(b)), x) =
    Module.add(V)(Module.smul(V)(a, x), Module.neg(V)(Module.smul(V)(b, x)))
proof
  have ring := Module.ring at V, K with module
  have nb := Ring.neg_mem at K, b with ring, memberB
  have e1 := add_smul at K, V, a, Ring.neg(K)(b), x with ring, module, memberA, nb, memberX
  have e2 := add_smul at K, V, Ring.neg(K)(b), b, x with ring, module, nb, memberB, memberX
  have p := Ring.parts with ring
  have inv := IsRing.add_inverse_left with p, memberB
  rw inv at e2
  have z := zero_smul at K, V, x with ring, module, memberX
  rw z at e2
  have abelian := Module.additive.abelian_group at V, K with module
  have group := AbelianGroup.to_group with abelian
  have nbx := Module.smul_mem at K, V, Ring.neg(K)(b), x with ring, module, nb, memberX
  have bx := Module.smul_mem at K, V, b, x with ring, module, memberB, memberX
  have nbxA : Module.smul(V)(Ring.neg(K)(b), x) ∈ Group.carrier(Module.additive(V))
    rw Module.additive.carrier
    exact nbx
  have bxA : Module.smul(V)(b, x) ∈ Group.carrier(Module.additive(V))
    rw Module.additive.carrier
    exact bx
  have eq1 : Group.mul(Module.additive(V))(Module.smul(V)(Ring.neg(K)(b), x), Module.smul(V)(b, x)) = Group.one(Module.additive(V))
    rw [Module.additive.mul, Module.additive.one]
    rw ← e2
  have e := eq_inv_of_mul_eq_one_left at Module.additive(V), Module.smul(V)(Ring.neg(K)(b), x), Module.smul(V)(b, x) with group, nbxA, bxA, eq1
  rw Module.additive.inv at e
  rw [e1, e]

theorem Module.smul_sub (V K b x y : Set)
  requires module : Module(V, K)
  requires memberB : b ∈ Ring.carrier(K)
  requires memberX : x ∈ Module.carrier(V)
  requires memberY : y ∈ Module.carrier(V)
  shows Module.smul(V)(b, Module.add(V)(x, Module.neg(V)(y))) =
    Module.add(V)(Module.smul(V)(b, x), Module.neg(V)(Module.smul(V)(b, y)))
proof
  have ring := Module.ring at V, K with module
  have ny := Module.neg_mem at K, V, y with ring, module, memberY
  have e1 := smul_add at K, V, b, x, Module.neg(V)(y) with ring, module, memberB, memberX, ny
  have e2 := smul_add at K, V, b, Module.neg(V)(y), y with ring, module, memberB, ny, memberY
  have inv := Module.neg_add at K, V, y with ring, module, memberY
  rw inv at e2
  have z := smul_zero at K, V, b with ring, module, memberB
  rw z at e2
  have abelian := Module.additive.abelian_group at V, K with module
  have group := AbelianGroup.to_group with abelian
  have bny := Module.smul_mem at K, V, b, Module.neg(V)(y) with ring, module, memberB, ny
  have by := Module.smul_mem at K, V, b, y with ring, module, memberB, memberY
  have bnyA : Module.smul(V)(b, Module.neg(V)(y)) ∈ Group.carrier(Module.additive(V))
    rw Module.additive.carrier
    exact bny
  have byA : Module.smul(V)(b, y) ∈ Group.carrier(Module.additive(V))
    rw Module.additive.carrier
    exact by
  have eq1 : Group.mul(Module.additive(V))(Module.smul(V)(b, Module.neg(V)(y)), Module.smul(V)(b, y)) = Group.one(Module.additive(V))
    rw [Module.additive.mul, Module.additive.one]
    rw ← e2
  have e := eq_inv_of_mul_eq_one_left at Module.additive(V), Module.smul(V)(b, Module.neg(V)(y)), Module.smul(V)(b, y) with group, bnyA, byA, eq1
  rw Module.additive.inv at e
  rw [e1, e]

-- −(p + q) = −p + −q in a module.
theorem Module.neg_add_distrib (V K p q : Set)
  requires module : Module(V, K)
  requires memberP : p ∈ Module.carrier(V)
  requires memberQ : q ∈ Module.carrier(V)
  shows Module.neg(V)(Module.add(V)(p, q)) =
    Module.add(V)(Module.neg(V)(p), Module.neg(V)(q))
proof
  have abelian := Module.additive.abelian_group at V, K with module
  have pA : p ∈ Group.carrier(Module.additive(V))
    rw Module.additive.carrier
    exact memberP
  have qA : q ∈ Group.carrier(Module.additive(V))
    rw Module.additive.carrier
    exact memberQ
  have e := mul_inv at Module.additive(V), p, q with abelian, pA, qA
  rw [Module.additive.mul, Module.additive.inv] at e
  exact e

-- Section: Laws of normed spaces
section NormedSpaceLaws
variable (V K absK norm : Set)
hypothesis normed : NormedSpace(V, K, absK, norm)

theorem NormedSpace.smul (c v : Set)
  requires scalar : c ∈ K.carrier
  requires member : v ∈ V.carrier
  shows norm(V.smul(c, v)) = R[absK(c) * norm(v)]
proof
  obtain ⟨nf, mod, ng, law⟩ := normed
  exact law with c, scalar, v, member

theorem NormedSpace.topological_module
  shows TopologicalModule(V, K, normTopology(Ring.additive(K), absK),
    spaceTopology(V, norm))
proof
  have n2 := normed
  obtain ⟨nf, mod, ng, law⟩ := n2
  have nf2 := nf
  obtain ⟨field, comm, nr, mulEq, oneEq⟩ := nf2
  have ring := nr.left
  have ngK := nr.right.left
  have ngK2 := ngK
  obtain ⟨abelianK, isNormK⟩ := ngK2
  obtain ⟨normFK, nonnegK, zeroIffK, invarK, triK⟩ := isNormK
  have ng2 := ng
  obtain ⟨abelianV, isNormV⟩ := ng2
  obtain ⟨normFV, nonnegV, zeroIffV, invarV, triV⟩ := isNormV
  have tr := NormedRing.topological at K, absK with nr
  have tg := normTopology.topological_group at Module.additive(V), norm with ng
  have mm := mod
  obtain ⟨shape, ringR, addF, zeroIn, negF, smulF, rest⟩ := mm
  have smulF2 : Module.smul(V) : Group.carrier(Ring.additive(K)) × Group.carrier(Module.additive(V)) → Group.carrier(Module.additive(V))
    rw [Ring.additive.carrier, Module.additive.carrier]
    exact smulF
  unfold TopologicalModule
  refine ⟨mod, tr, ?_, ?_⟩
  . unfold spaceTopology
    exact tg
  unfold spaceTopology
  apply normTopology.joint_continuous with ngK, ng, ng, smulF2
  intros a ha x hx e eIn ePos
  have aK : a ∈ Ring.carrier(K)
    rw ← Ring.additive.carrier
    exact ha
  have xV : x ∈ Module.carrier(V)
    rw ← Module.additive.carrier
    exact hx
  have naR : Real(absK(a)) by exact (FunctionBetween.apply_closed with normFK, ha)
  have nxR : Real(norm(x)) by exact (FunctionBetween.apply_closed with normFV, hx)
  have naNn := nonnegK with a, ha
  have nxNn := nonnegV with x, hx
  have eR : Real(e) by exact eIn
  obtain ⟨d, dIn, dPos, est⟩ := bilinear.delta at e, norm(x), absK(a) with ePos, nxNn, naNn
  refine ⟨d, dIn, dPos, ?_⟩
  intros b hb y hy db dy
  have bK : b ∈ Ring.carrier(K)
    rw ← Ring.additive.carrier
    exact hb
  have yV : y ∈ Module.carrier(V)
    rw ← Module.additive.carrier
    exact hy
  have ax := Module.smul_mem at K, V, a, x with ring, mod, aK, xV
  have bx := Module.smul_mem at K, V, b, x with ring, mod, bK, xV
  have by := Module.smul_mem at K, V, b, y with ring, mod, bK, yV
  have axA : Module.smul(V)(a, x) ∈ Group.carrier(Module.additive(V))
    rw Module.additive.carrier
    exact ax
  have bxA : Module.smul(V)(b, x) ∈ Group.carrier(Module.additive(V))
    rw Module.additive.carrier
    exact bx
  have byA : Module.smul(V)(b, y) ∈ Group.carrier(Module.additive(V))
    rw Module.additive.carrier
    exact by
  have t := IsNorm.sub_triangle at Module.additive(V), norm, Module.smul(V)(a, x), Module.smul(V)(b, x), Module.smul(V)(b, y) with ng, axA, bxA, byA
  have lb := IsNorm.le_add_sub at Ring.additive(K), absK, a, b with ngK, ha, hb
  rw [Module.additive.mul, Module.additive.inv] at t
  rw [Ring.additive.mul, Ring.additive.inv] at lb
  rw [Ring.additive.mul, Ring.additive.inv] at db
  rw [Module.additive.mul, Module.additive.inv] at dy
  rw [Module.additive.mul, Module.additive.inv]
  have s1 := Module.sub_smul at V, K, a, b, x with mod, aK, bK, xV
  have s2 := Module.smul_sub at V, K, b, x, y with mod, bK, xV, yV
  rw [← s1, ← s2] at t
  have nb := Ring.neg_mem at K, b with ring, bK
  have ny := Module.neg_mem at K, V, y with ring, mod, yV
  have ab := Ring.add_mem at K, a, Ring.neg(K)(b) with ring, aK, nb
  have xy := Module.add_mem at K, V, x, Module.neg(V)(y) with ring, mod, xV, ny
  have m1 := law with Ring.add(K)(a, Ring.neg(K)(b)), ab, x, xV
  have m2 := law with b, bK, Module.add(V)(x, Module.neg(V)(y)), xy
  rw [m1, m2] at t
  have abA : Ring.add(K)(a, Ring.neg(K)(b)) ∈ Group.carrier(Ring.additive(K))
    rw Ring.additive.carrier
    exact ab
  have xyA : Module.add(V)(x, Module.neg(V)(y)) ∈ Group.carrier(Module.additive(V))
    rw Module.additive.carrier
    exact xy
  have sIn := FunctionBetween.apply_closed with normFK, abA
  have tIn := FunctionBetween.apply_closed with normFV, xyA
  have uIn := FunctionBetween.apply_closed with normFK, hb
  have sR : Real(absK(Ring.add(K)(a, Ring.neg(K)(b)))) by exact sIn
  have tR : Real(norm(Module.add(V)(x, Module.neg(V)(y)))) by exact tIn
  have uR : Real(absK(b)) by exact uIn
  have s0 := nonnegK with Ring.add(K)(a, Ring.neg(K)(b)), abA
  have t0 := nonnegV with Module.add(V)(x, Module.neg(V)(y)), xyA
  have u0 := nonnegK with b, hb
  have r := est with absK(Ring.add(K)(a, Ring.neg(K)(b))), sIn, norm(Module.add(V)(x, Module.neg(V)(y))), tIn, absK(b), uIn, s0, db, t0, dy, u0, lb
  have nby := Module.neg_mem at K, V, Module.smul(V)(b, y) with ring, mod, by
  have whole : Module.add(V)(Module.smul(V)(a, x), Module.neg(V)(Module.smul(V)(b, y))) ∈ Group.carrier(Module.additive(V))
    rw Module.additive.carrier
    exact Module.add_mem at K, V, Module.smul(V)(a, x), Module.neg(V)(Module.smul(V)(b, y)) with ring, mod, ax, nby
  have wR : Real(norm(Module.add(V)(Module.smul(V)(a, x), Module.neg(V)(Module.smul(V)(b, y))))) by exact (FunctionBetween.apply_closed with normFV, whole)
  linarith

-- The unit sphere scaling: every nonzero vector is a multiple of a vector
-- of norm 1 when K is ℝ or ℂ-like (Mathlib's rescale_to_shell, the form
-- the source uses): for ‖c‖ > 1 and ε > 0, every v ≠ 0 has a multiple
-- c^k v with ε/‖c‖ ≤ ‖c^k v‖ < ε.
theorem NormedSpace.rescale_to_shell (c v : Set, e : Real)
  requires scalar : c ∈ K.carrier
  requires large : realOne < absK(c)
  requires positive : realZero < e
  requires member : v ∈ V.carrier
  requires nonzero : v ≠ V.zero
  shows ∃ d ∈ K.carrier, d ≠ K.zero ∧
    R[e / absK(c)] ≤ norm(V.smul(d, v)) ∧ norm(V.smul(d, v)) < e
proof
  have n2 := normed
  obtain ⟨nf, mod, ng, law⟩ := n2
  have nf2 := nf
  obtain ⟨field, comm, nr, mulEq, oneEq⟩ := nf2
  have nr2 := nr
  obtain ⟨ring, ngK, subK⟩ := nr2
  obtain ⟨abelianK, isNormK⟩ := ngK
  obtain ⟨normFK, nonnegK, zeroIffK, invarK, triK⟩ := isNormK
  have ntf : NontriviallyNormedField(K, absK)
    unfold NontriviallyNormedField
    exact ⟨nf, c, scalar, large⟩
  obtain ⟨aIn, aNn⟩ := NormedSpace.norm_real at V, K, absK, norm, v with normed, member
  have aR : Real(norm(v)) by exact aIn
  have aPos : (0:R) < norm(v)
    by_contra np
    have z : norm(v) = (0:R) by linarith
    have vz := (NormedSpace.norm_eq_zero at V, K, absK, norm, v with normed, member).forward with z
    exact nonzero with vz
  have aNe : norm(v) ≠ (0:R)
    intro z
    rw z at aPos
    linarith
  have cR := (NormedField.norm_real at K, absK, c with nf, scalar).left
  have cRR : Real(absK(c)) by exact cR
  have one := realZero.lt_one
  have cPos : (0:R) < absK(c) by linarith
  have cNe : absK(c) ≠ (0:R)
    intro z
    rw z at cPos
    linarith
  have eaIn : e / norm(v) ∈ ℝ by typecheck
  have eaR : Real(e / norm(v)) by exact eaIn
  have eaMul := realDiv.mul_right at e, norm(v) with aNe
  have eaPos : (0:R) < e / norm(v)
    by_contra np
    have le : e / norm(v) ≤ (0:R) by linarith
    have m := realLe.mul_right_of_nonnegative at e / norm(v), (0:R), norm(v) with le, aNn
    rw eaMul at m
    have z : (0:R) * norm(v) = (0:R) by ring
    rw z at m
    linarith
  obtain ⟨t0, t0In, t0Pos, t0Lt⟩ := NontriviallyNormedField.small at K, absK, e / norm(v) with ntf, eaPos
  have t0R := (NormedField.norm_real at K, absK, t0 with nf, t0In).left
  have t0RR : Real(absK(t0)) by exact t0R
  have t0a := realLess.mul_right_of_positive at absK(t0), e / norm(v), norm(v) with t0Lt, aPos
  rw eaMul at t0a
  have sub : shellScalars(K, absK, norm(v), e) ⊆ ℝ
    intros x hx
    exact (shellScalars.membership.forward with hx).left
  have t0Mem : absK(t0) ∈ shellScalars(K, absK, norm(v), e)
    apply shellScalars.membership.backward
    exact ⟨t0R, t0, t0In, t0Pos, rfl, t0a⟩
  have ne : Nonempty(shellScalars(K, absK, norm(v), e))
    unfold Nonempty
    exact ⟨absK(t0), t0Mem⟩
  have upper : ∀ x ∈ shellScalars(K, absK, norm(v), e), x ≤ e / norm(v)
    intros x hx
    obtain ⟨xIn, t, tIn, tPos, xEq, ta⟩ := shellScalars.membership.forward with hx
    have xR : Real(x) by exact xIn
    rw ← xEq at ta
    by_contra big
    have lt : e / norm(v) < x by linarith
    have m := realLess.mul_right_of_positive at e / norm(v), x, norm(v) with lt, aPos
    rw eaMul at m
    linarith
  obtain ⟨U, UIn, ub, least⟩ := Real.sup_exists with sub, ne, ⟨e / norm(v), eaIn, upper⟩
  have UR : Real(U) by exact UIn
  have t0U := ub with absK(t0), t0Mem
  have UPos : (0:R) < U by linarith
  have qIn : U / absK(c) ∈ ℝ by typecheck
  have qR : Real(U / absK(c)) by exact qIn
  have qMul := realDiv.mul_right at U, absK(c) with cNe
  have exists : ∃ s ∈ shellScalars(K, absK, norm(v), e), U / absK(c) < s
    by_contra none
    have bound : ∀ x ∈ shellScalars(K, absK, norm(v), e), x ≤ U / absK(c)
      intros x hx
      have xR : Real(x) by exact (sub with x, hx)
      by_contra big
      have lt : U / absK(c) < x by linarith
      exact none with ⟨x, hx, lt⟩
    have Uq := least with U / absK(c), qIn, bound
    have cNn : (0:R) ≤ absK(c) by linarith
    have m1 := realLe.mul_right_of_nonnegative at U, U / absK(c), absK(c) with Uq, cNn
    rw qMul at m1
    have m2 := realLess.mul_left_of_positive at (1:R), absK(c), U with large, UPos
    have u1 : U * (1:R) = U by ring
    rw u1 at m2
    linarith
  obtain ⟨s, sMem, sBig⟩ := exists
  obtain ⟨sIn, t, tIn, tPos, sEq, ta⟩ := shellScalars.membership.forward with sMem
  have tR := (NormedField.norm_real at K, absK, t with nf, tIn).left
  have tRR : Real(absK(t)) by exact tR
  rw sEq at sBig
  have tNe : t ≠ Ring.zero(K)
    intro tz
    have tA : t ∈ Group.carrier(Ring.additive(K))
      rw Ring.additive.carrier
      exact tIn
    have z : absK(t) = (0:R)
      apply (zeroIffK with t, tA).backward
      rw Ring.additive.one
      exact tz
    rw z at tPos
    linarith
  have nt := law with t, tIn, v, member
  refine ⟨t, tIn, tNe, ?_, ?_⟩
  . rw nt
    have uIn := Ring.mul_mem at K, c, t with ring, scalar, tIn
    have uEq := mulEq with c, scalar, t, tIn
    have tNn : (0:R) ≤ absK(t) by linarith
    have taNn : (0:R) ≤ absK(t) * norm(v)
      have m := realLe.mul_right_of_nonnegative at (0:R), absK(t), norm(v) with tNn, aNn
      have z : (0:R) * norm(v) = (0:R) by ring
      rw z at m
      exact m
    have taR : Real(absK(t) * norm(v)) by typecheck
    have big : e ≤ absK(c) * (absK(t) * norm(v))
      by_contra small
      have lt : absK(c) * (absK(t) * norm(v)) < e by linarith
      have uPos : (0:R) < absK(Ring.mul(K)(c, t))
        rw uEq
        have m := realLess.mul_left_of_positive at (0:R), absK(t), absK(c) with tPos, cPos
        have z : absK(c) * (0:R) = (0:R) by ring
        rw z at m
        exact m
      have uR := (NormedField.norm_real at K, absK, Ring.mul(K)(c, t) with nf, uIn).left
      have uMem : absK(Ring.mul(K)(c, t)) ∈ shellScalars(K, absK, norm(v), e)
        apply shellScalars.membership.backward
        refine ⟨uR, Ring.mul(K)(c, t), uIn, uPos, rfl, ?_⟩
        rw uEq
        have as : absK(c) * absK(t) * norm(v) = absK(c) * (absK(t) * norm(v)) by ring
        rw as
        exact lt
      have uU := ub with absK(Ring.mul(K)(c, t)), uMem
      rw uEq at uU
      have m := realLess.mul_left_of_positive at U / absK(c), absK(t), absK(c) with sBig, cPos
      have qc := realDiv.mul_left at U, absK(c) with cNe
      rw qc at m
      linarith
    have ecIn : e / absK(c) ∈ ℝ by typecheck
    have ecR : Real(e / absK(c)) by exact ecIn
    have ecMul := realDiv.mul_right at e, absK(c) with cNe
    apply realLe.mul_right_cancel_positive at e / absK(c), absK(t) * norm(v), absK(c) with cPos
    rw ecMul
    have sw : absK(t) * norm(v) * absK(c) = absK(c) * (absK(t) * norm(v)) by ring
    rw sw
    exact big
  . rw nt
    exact ta

end NormedSpaceLaws

-- Section: Linear maps
-- A linear map is a homomorphism of the additive groups.
theorem IsLinearMap.additive_hom (f V W K : Set)
  requires linear : IsLinearMap(f, V, W, K)
  shows f : Module.additive(V) →* Module.additive(W)
proof
  obtain ⟨modV, modW, fn, addLaw, smulLaw⟩ := linear
  have abelianV := Module.additive.abelian_group at V, K with modV
  have abelianW := Module.additive.abelian_group at W, K with modW
  have groupV := AbelianGroup.to_group with abelianV
  have groupW := AbelianGroup.to_group with abelianW
  have fn2 : f : Group.carrier(Module.additive(V)) → Group.carrier(Module.additive(W))
    rw [Module.additive.carrier, Module.additive.carrier]
    exact fn
  apply GroupHom.mk with groupV, groupW, fn2
  intros x hx y hy
  rw Module.additive.carrier at hx
  rw Module.additive.carrier at hy
  rw [Module.additive.mul, Module.additive.mul]
  exact addLaw with x, hx, y, hy

theorem IsLinearMap.map_zero (f V W K : Set)
  requires linear : IsLinearMap(f, V, W, K)
  shows f(Module.zero(V)) = Module.zero(W)
proof
  have hom := IsLinearMap.additive_hom with linear
  have one := GroupHom.map_one at f, Module.additive(V), Module.additive(W) with hom
  rw [Module.additive.one, Module.additive.one] at one
  exact one

theorem IsLinearMap.map_neg (f V W K v : Set)
  requires linear : IsLinearMap(f, V, W, K)
  requires member : v ∈ Module.carrier(V)
  shows f(Module.neg(V)(v)) = Module.neg(W)(f(v))
proof
  have hom := IsLinearMap.additive_hom with linear
  have m2 : v ∈ Group.carrier(Module.additive(V))
    rw Module.additive.carrier
    exact member
  have inv := GroupHom.map_inv at f, Module.additive(V), Module.additive(W), v with hom, m2
  rw [Module.additive.inv, Module.additive.inv] at inv
  exact inv

theorem IsLinearMap.map_sum (f V W K w u : Set, n : Nat)
  requires linear : IsLinearMap(f, V, W, K)
  requires values : ∀ i ∈ n, w(i) ∈ Module.carrier(V)
  requires composite : ∀ i ∈ n, u(i) = f(w(i))
  shows f(groupFiniteSum(Module.additive(V), n, w)) =
    groupFiniteSum(Module.additive(W), n, u)
proof
  obtain ⟨modV, modW, fn, addLaw, smulLaw⟩ := linear
  have abelianV := Module.additive.abelian_group at V, K with modV
  have abelianW := Module.additive.abelian_group at W, K with modW
  have groupV := AbelianGroup.to_group with abelianV
  have groupW := AbelianGroup.to_group with abelianW
  have fn2 : f : Group.carrier(Module.additive(V)) → Group.carrier(Module.additive(W))
    rw [Module.additive.carrier, Module.additive.carrier]
    exact fn
  have hom : f : Module.additive(V) →* Module.additive(W)
    apply GroupHom.mk with groupV, groupW, fn2
    intros x hx y hy
    rw Module.additive.carrier at hx
    rw Module.additive.carrier at hy
    rw [Module.additive.mul, Module.additive.mul]
    exact addLaw with x, hx, y, hy
  have values2 : ∀ i ∈ n, w(i) ∈ Group.carrier(Module.additive(V))
    rw Module.additive.carrier
    exact values
  exact groupFiniteSum.hom at f, Module.additive(V), Module.additive(W), n, w, u with abelianV, abelianW, hom, (Finite.natural at n), values2, composite

-- The carrier of the topology of a normed space is the module's carrier.
theorem spaceTopology.carrier_eq (V norm : Set)
  shows TopologicalSpace.carrier(spaceTopology(V, norm)) = Module.carrier(V)
proof
  unfold spaceTopology
  unfold normTopology
  rw metricTopology.carrier
  have m : MetricSpace.carrier(normMetric(Module.additive(V), norm)) =
      Group.carrier(Module.additive(V))
    unfold normMetric
    metric_projections
  rw [m, Module.additive.carrier]

-- A linear map is continuous exactly when it sends small vectors to small
-- vectors: ‖v‖ < δ forces ‖f v‖ < ε.
predicate SmallToSmall (f V normV normW : Set) :=
  ∀ e ∈ ℝ, realZero < e → ∃ d ∈ ℝ, realZero < d ∧
    (∀ v ∈ Module.carrier(V), normV(v) < d → normW(f(v)) < e)

theorem IsLinearMap.continuous_iff_small (f V K absK normV W normW : Set)
  requires normedV : NormedSpace(V, K, absK, normV)
  requires normedW : NormedSpace(W, K, absK, normW)
  requires linear : IsLinearMap(f, V, W, K)
  shows ContinuousLinearMap(f, V, normV, W, normW, K) ↔
    SmallToSmall(f, V, normV, normW)
proof
  have l2 := linear
  obtain ⟨modV, modW, fn, addLaw, smulLaw⟩ := l2
  have mV := spaceMetric.metric at V, K, absK, normV with normedV
  have mW := spaceMetric.metric at W, K, absK, normW with normedW
  have cV := spaceMetric.carrier at V, normV
  have cW := spaceMetric.carrier at W, normW
  have fnM : f : MetricSpace.carrier(spaceMetric(V, normV)) →
      MetricSpace.carrier(spaceMetric(W, normW))
    rw [cV, cW]
    exact fn
  have zeroV := Module.zero_mem at K, V with modV
  have f0 := IsLinearMap.map_zero with linear
  have nz0V := Module.neg_zero at V, K with modV
  have nz0W := Module.neg_zero at W, K with modW
  constructor
  . intro clm
    have cont := clm.right
    unfold SmallToSmall
    intros e eIn ePos
    have zeroT : Module.zero(V) ∈ TopologicalSpace.carrier(spaceTopology(V, normV))
      rw spaceTopology.carrier_eq
      exact zeroV
    have at0 := ContinuousAtPoint.of_continuous with cont, zeroT
    rw [spaceTopology.metric_eq, spaceTopology.metric_eq] at at0
    have zM : Module.zero(V) ∈ MetricSpace.carrier(spaceMetric(V, normV))
      rw cV
      exact zeroV
    have m := (ContinuousAtPoint.metric_iff with mV, mW, fnM, zM).forward with at0
    obtain ⟨d, dIn, dPos, near⟩ := m with e, eIn, ePos
    refine ⟨d, dIn, dPos, ?_⟩
    intros v hv small
    have vM : v ∈ MetricSpace.carrier(spaceMetric(V, normV))
      rw cV
      exact hv
    have dv := spaceMetric.dist at V, K, absK, normV, v, Module.zero(V) with normedV, hv, zeroV
    have a0 := Module.add_zero at K, V, v with modV, hv
    rw [nz0V, a0] at dv
    have lt : MetricSpace.dist(spaceMetric(V, normV))(v, Module.zero(V)) < d
      rw dv
      exact small
    have r := near with v, vM, lt
    have fv := FunctionBetween.apply_closed with fn, hv
    have zeroW := Module.zero_mem at K, W with modW
    rw f0 at r
    have dw := spaceMetric.dist at W, K, absK, normW, f(v), Module.zero(W) with normedW, fv, zeroW
    have b0 := Module.add_zero at K, W, f(v) with modW, fv
    rw [nz0W, b0] at dw
    rw dw at r
    exact r
  . intro small
    have spV := spaceMetric.metric at V, K, absK, normV with normedV
    have tV := MetricSpace.topological_space with mV
    have tW := MetricSpace.topological_space with mW
    have fnT : f : TopologicalSpace.carrier(metricTopology(spaceMetric(V, normV))) →
        TopologicalSpace.carrier(metricTopology(spaceMetric(W, normW)))
      rw [metricTopology.carrier, metricTopology.carrier]
      exact fnM
    have crit := Continuous.iff_continuousAt at f, metricTopology(spaceMetric(V, normV)), metricTopology(spaceMetric(W, normW)) with tV, tW, fnT
    have cont : f : metricTopology(spaceMetric(V, normV)) ⇒ metricTopology(spaceMetric(W, normW))
      apply crit.backward
      intros x hx
      rw metricTopology.carrier at hx
      apply (ContinuousAtPoint.metric_iff with mV, mW, fnM, hx).backward
      intros e eIn ePos
      obtain ⟨d, dIn, dPos, near⟩ := small with e, eIn, ePos
      refine ⟨d, dIn, dPos, ?_⟩
      intros y hy close
      rw cV at hx
      rw cV at hy
      have nx := Module.neg_mem at K, V, x with modV, hx
      have yx := Module.add_mem at K, V, y, Module.neg(V)(x) with modV, hy, nx
      have dyx := spaceMetric.dist at V, K, absK, normV, y, x with normedV, hy, hx
      rw dyx at close
      have r := near with Module.add(V)(y, Module.neg(V)(x)), yx, close
      have a1 := addLaw with y, hy, Module.neg(V)(x), nx
      have a2 := IsLinearMap.map_neg at f, V, W, K, x with linear, hx
      rw [a1, a2] at r
      have fy := FunctionBetween.apply_closed with fn, hy
      have fx := FunctionBetween.apply_closed with fn, hx
      have dfx := spaceMetric.dist at W, K, absK, normW, f(y), f(x) with normedW, fy, fx
      rw dfx
      exact r
    unfold ContinuousLinearMap
    refine ⟨linear, ?_⟩
    rw [spaceTopology.metric_eq, spaceTopology.metric_eq]
    exact cont


-- Mathlib's ContinuousLinearMap.comp: composites of continuous linear maps
-- are continuous linear.
theorem ContinuousLinearMap.comp (f g h U normU V normV W normW K : Set)
  requires first : ContinuousLinearMap(f, U, normU, V, normV, K)
  requires second : ContinuousLinearMap(g, V, normV, W, normW, K)
  requires function : h : Module.carrier(U) → Module.carrier(W)
  requires composite : ∀ u ∈ Module.carrier(U), h(u) = g(f(u))
  shows ContinuousLinearMap(h, U, normU, W, normW, K)
proof
  obtain ⟨linF, contF⟩ := first
  obtain ⟨linG, contG⟩ := second
  obtain ⟨modU, modV, fnF, addF, smulF⟩ := linF
  obtain ⟨modV2, modW, fnG, addG, smulG⟩ := linG
  have cc := Continuous.comp with contF, contG
  rw [spaceTopology.carrier_eq, spaceTopology.carrier_eq, spaceTopology.carrier_eq] at cc
  have fnC := compose.function at g, f, Module.carrier(U), Module.carrier(V), Module.carrier(W) with fnF, fnG
  have same : h = compose(g, f, Module.carrier(U), Module.carrier(V), Module.carrier(W))
    apply FunctionBetween.ext with function, fnC
    intros u hu
    have a := compose.apply at g, f, Module.carrier(U), Module.carrier(V), Module.carrier(W), u with fnF, fnG, hu
    have c1 := composite with u, hu
    rw [a, c1]
  unfold ContinuousLinearMap
  refine ⟨?_, ?_⟩
  . unfold IsLinearMap
    refine ⟨modU, modW, function, ?_, ?_⟩
    . intros v hv w hw
      have vw := Module.add_mem at K, U, v, w with *
      have fv := FunctionBetween.apply_closed with fnF, hv
      have fw := FunctionBetween.apply_closed with fnF, hw
      have c1 := composite with Module.add(U)(v, w), vw
      have c2 := composite with v, hv
      have c3 := composite with w, hw
      have a1 := addF with v, hv, w, hw
      rw [c1, c2, c3, a1]
      exact addG with f(v), fv, f(w), fw
    . intros c hc v hv
      have cv := Module.smul_mem at K, U, c, v with *
      have fv := FunctionBetween.apply_closed with fnF, hv
      have c1 := composite with Module.smul(U)(c, v), cv
      have c2 := composite with v, hv
      have a1 := smulF with c, hc, v, hv
      rw [c1, c2, a1]
      exact smulG with c, hc, f(v), fv
  . rw same
    exact cc

theorem ContinuousLinearMap.identity (V K absK norm : Set)
  requires normed : NormedSpace(V, K, absK, norm)
  shows ContinuousLinearMap(identity(Module.carrier(V)), V, norm, V, norm, K)
proof
  have n2 := normed
  obtain ⟨nf, module, ng, law⟩ := n2
  have ring := nf.right.right.left.left
  have space := normTopology.space at Module.additive(V), norm with ng
  have carrier := normTopology.carrier at Module.additive(V), norm with ng
  rw Module.additive.carrier at carrier
  have cont := Continuous.id at normTopology(Module.additive(V), norm) with space
  rw carrier at cont
  unfold ContinuousLinearMap
  refine ⟨?_, ?_⟩
  . unfold IsLinearMap
    refine ⟨module, module, (identity.function at Module.carrier(V)), ?_, ?_⟩
    . intros v hv w hw
      have vw := Module.add_mem at K, V, v, w with *
      have a1 := identity.apply at Module.add(V)(v, w), Module.carrier(V) with vw
      have a2 := identity.apply at v, Module.carrier(V) with hv
      have a3 := identity.apply at w, Module.carrier(V) with hw
      rw [a1, a2, a3]
    . intros c hc v hv
      have cv := Module.smul_mem at K, V, c, v with *
      have a1 := identity.apply at Module.smul(V)(c, v), Module.carrier(V) with cv
      have a2 := identity.apply at v, Module.carrier(V) with hv
      rw [a1, a2]
  . unfold spaceTopology
    exact cont

-- A linear map between normed spaces is continuous exactly when it is
-- bounded.
theorem ContinuousLinearMap.iff_bounded (f V K absK normV W normW : Set)
  requires normedV : NormedSpace(V, K, absK, normV)
  requires normedW : NormedSpace(W, K, absK, normW)
  requires nontrivial : NontriviallyNormedField(K, absK)
  requires linear : IsLinearMap(f, V, W, K)
  shows ContinuousLinearMap(f, V, normV, W, normW, K) ↔
    (∃ C, LinearBound(f, V, normV, normW, C))
proof
  have crit := IsLinearMap.continuous_iff_small at f, V, K, absK, normV, W, normW with normedV, normedW, linear
  have l2 := linear
  obtain ⟨modV, modW, fn, addLaw, smulLaw⟩ := l2
  have nW := normedW
  obtain ⟨nfW, modW2, ngW, lawW⟩ := nW
  have nV := normedV
  obtain ⟨nfV, modV2, ngV, lawV⟩ := nV
  have one := realZero.lt_one
  have oneIn : (1:R) ∈ ℝ by typecheck
  constructor
  . intro clm
    have small := crit.forward with clm
    unfold SmallToSmall at small
    obtain ⟨d, dIn, dPos, near⟩ := small with (1:R), oneIn, one
    have dR : Real(d) by exact dIn
    have dNe : d ≠ (0:R)
      intro z
      rw z at dPos
      linarith
    obtain ⟨nf, c, cIn, cBig⟩ := nontrivial
    have cR := (NormedField.norm_real at K, absK, c with nf, cIn).left
    have cRR : Real(absK(c)) by exact cR
    have qIn : absK(c) / d ∈ ℝ by typecheck
    have qR : Real(absK(c) / d) by exact qIn
    have qMul := realDiv.mul_right at absK(c), d with dNe
    have qPos : (0:R) < absK(c) / d
      by_contra np
      have le : absK(c) / d ≤ (0:R) by linarith
      have dNn : (0:R) ≤ d by linarith
      have m := realLe.mul_right_of_nonnegative at absK(c) / d, (0:R), d with le, dNn
      rw qMul at m
      have z : (0:R) * d = (0:R) by ring
      rw z at m
      linarith
    have qNn : (0:R) ≤ absK(c) / d by linarith
    refine ⟨absK(c) / d, ?_⟩
    unfold LinearBound
    refine ⟨qIn, qNn, ?_⟩
    intros v hv
    obtain ⟨nvIn, nvNn⟩ := NormedSpace.norm_real at V, K, absK, normV, v with normedV, hv
    have nvR : Real(normV(v)) by exact nvIn
    have fv := FunctionBetween.apply_closed with fn, hv
    obtain ⟨nwIn, nwNn⟩ := NormedSpace.norm_real at W, K, absK, normW, f(v) with normedW, fv
    have nwR : Real(normW(f(v))) by exact nwIn
    by_cases vz : v = Module.zero(V)
    . have f0 := IsLinearMap.map_zero with linear
      rw [vz, f0]
      have zw := Module.zero_mem at K, W with modW
      have zv := Module.zero_mem at K, V with modV
      have a := (NormedSpace.norm_eq_zero at W, K, absK, normW, Module.zero(W) with normedW, zw).backward with rfl
      have b := (NormedSpace.norm_eq_zero at V, K, absK, normV, Module.zero(V) with normedV, zv).backward with rfl
      rw [a, b]
      have z : (absK(c) / d) * (0:R) = (0:R) by ring
      rw z
      linarith
    . obtain ⟨t, tIn, tNe, lower, upper⟩ := NormedSpace.rescale_to_shell at V, K, absK, normV, c, v, d with normedV, cIn, cBig, dPos, hv, vz
      have tv := Module.smul_mem at K, V, t, v with modV, tIn, hv
      have r := near with Module.smul(V)(t, v), tv, upper
      have s1 := smulLaw with t, tIn, v, hv
      rw s1 at r
      have s2 := lawW with t, tIn, f(v), fv
      rw s2 at r
      have s3 := lawV with t, tIn, v, hv
      rw s3 at lower
      have tR := (NormedField.norm_real at K, absK, t with nfV, tIn).left
      have tRR : Real(absK(t)) by exact tR
      have cNe : absK(c) ≠ (0:R)
        intro z
        rw z at cBig
        linarith
      have cPos : (0:R) < absK(c) by linarith
      have dcMul := realDiv.mul_right at d, absK(c) with cNe
      have dcR : Real(d / absK(c)) by typecheck
      have cNn : (0:R) ≤ absK(c) by linarith
      have low2 := realLe.mul_right_of_nonnegative at d / absK(c), absK(t) * normV(v), absK(c) with lower, cNn
      rw dcMul at low2
      have r2 := realLess.mul_right_of_positive at absK(t) * normW(f(v)), (1:R), d with r, dPos
      have tPos : (0:R) < absK(t)
        have tA : t ∈ Group.carrier(Ring.additive(K))
          rw Ring.additive.carrier
          exact tIn
        have tNn := (NormedField.norm_real at K, absK, t with nfV, tIn).right
        by_contra np
        have z : absK(t) = (0:R) by linarith
        obtain ⟨field, comm, nr, mulEq, oneEq⟩ := nfV
        obtain ⟨abelianK, isNormK⟩ := nr.right.left
        obtain ⟨normFK, nonnegK, zeroIffK, invarK, triK⟩ := isNormK
        have tz := (zeroIffK with t, tA).forward with z
        rw Ring.additive.one at tz
        exact tNe with tz
      have key : (normW(f(v)) * d) * absK(t) ≤ ((absK(c) / d) * normV(v) * d) * absK(t)
        have e1 : (normW(f(v)) * d) * absK(t) = absK(t) * normW(f(v)) * d by ring
        have e2 : ((absK(c) / d) * normV(v) * d) * absK(t) = (absK(c) / d * d) * (absK(t) * normV(v)) by ring
        rw [e1, e2, qMul]
        have e3 : (1:R) * d = d by ring
        rw e3 at r2
        have e4 : absK(t) * normV(v) * absK(c) = absK(c) * (absK(t) * normV(v)) by ring
        rw e4 at low2
        linarith
      have k2 := realLe.mul_right_cancel_positive at normW(f(v)) * d, (absK(c) / d) * normV(v) * d, absK(t) with tPos, key
      exact realLe.mul_right_cancel_positive at normW(f(v)), (absK(c) / d) * normV(v), d with dPos, k2
  . intro bounded
    obtain ⟨C, lb⟩ := bounded
    obtain ⟨CIn, CNn, bound⟩ := lb
    have CR : Real(C) by exact CIn
    apply crit.backward
    unfold SmallToSmall
    intros e eIn ePos
    have eR : Real(e) by exact eIn
    have c1Pos : (0:R) < C + (1:R) by linarith
    have c1Ne : C + (1:R) ≠ (0:R)
      intro z
      rw z at c1Pos
      linarith
    have dIn : e / (C + (1:R)) ∈ ℝ by typecheck
    have dR : Real(e / (C + (1:R))) by exact dIn
    have dMul := realDiv.mul_left at e, C + (1:R) with c1Ne
    have dPos : (0:R) < e / (C + (1:R))
      by_contra np
      have le : e / (C + (1:R)) ≤ (0:R) by linarith
      have c1Nn : (0:R) ≤ C + (1:R) by linarith
      have m := realLe.mul_left_of_nonnegative at e / (C + (1:R)), (0:R), C + (1:R) with le, c1Nn
      rw dMul at m
      have z : (C + (1:R)) * (0:R) = (0:R) by ring
      rw z at m
      linarith
    refine ⟨e / (C + (1:R)), dIn, dPos, ?_⟩
    intros v hv small
    obtain ⟨nvIn, nvNn⟩ := NormedSpace.norm_real at V, K, absK, normV, v with normedV, hv
    have nvR : Real(normV(v)) by exact nvIn
    have fv := FunctionBetween.apply_closed with fn, hv
    obtain ⟨nwIn, nwNn⟩ := NormedSpace.norm_real at W, K, absK, normW, f(v) with normedW, fv
    have nwR : Real(normW(f(v))) by exact nwIn
    have b := bound with v, hv
    have smallLe : normV(v) ≤ e / (C + (1:R)) by linarith
    have m := realLe.mul_left_of_nonnegative at normV(v), e / (C + (1:R)), C with smallLe, CNn
    have ex : (C + (1:R)) * (e / (C + (1:R))) = C * (e / (C + (1:R))) + e / (C + (1:R)) by ring
    rw dMul at ex
    linarith

-- A linear map continuous at 0 is continuous.
theorem ContinuousLinearMap.of_continuous_at_zero (f V K absK normV W normW : Set)
  requires normedV : NormedSpace(V, K, absK, normV)
  requires normedW : NormedSpace(W, K, absK, normW)
  requires linear : IsLinearMap(f, V, W, K)
  requires atZero : ContinuousAtPoint(f, spaceTopology(V, normV),
    spaceTopology(W, normW), Module.zero(V))
  shows ContinuousLinearMap(f, V, normV, W, normW, K)
proof
  have l2 := linear
  obtain ⟨modV, modW, fn, addLaw, smulLaw⟩ := l2
  have mV := spaceMetric.metric at V, K, absK, normV with normedV
  have mW := spaceMetric.metric at W, K, absK, normW with normedW
  have cV := spaceMetric.carrier at V, normV
  have cW := spaceMetric.carrier at W, normW
  have fnM : f : MetricSpace.carrier(spaceMetric(V, normV)) →
      MetricSpace.carrier(spaceMetric(W, normW))
    rw [cV, cW]
    exact fn
  have zeroV := Module.zero_mem at K, V with modV
  have f0 := IsLinearMap.map_zero with linear
  have nz0V := Module.neg_zero at V, K with modV
  have nz0W := Module.neg_zero at W, K with modW
  apply (IsLinearMap.continuous_iff_small at f, V, K, absK, normV, W, normW with normedV, normedW, linear).backward
  unfold SmallToSmall
  intros e eIn ePos
  have at0 := atZero
  rw [spaceTopology.metric_eq, spaceTopology.metric_eq] at at0
  have zM : Module.zero(V) ∈ MetricSpace.carrier(spaceMetric(V, normV))
    rw cV
    exact zeroV
  have m := (ContinuousAtPoint.metric_iff with mV, mW, fnM, zM).forward with at0
  obtain ⟨d, dIn, dPos, near⟩ := m with e, eIn, ePos
  refine ⟨d, dIn, dPos, ?_⟩
  intros v hv small
  have vM : v ∈ MetricSpace.carrier(spaceMetric(V, normV))
    rw cV
    exact hv
  have dv := spaceMetric.dist at V, K, absK, normV, v, Module.zero(V) with normedV, hv, zeroV
  have a0 := Module.add_zero at K, V, v with modV, hv
  rw [nz0V, a0] at dv
  have lt : MetricSpace.dist(spaceMetric(V, normV))(v, Module.zero(V)) < d
    rw dv
    exact small
  have r := near with v, vM, lt
  have fv := FunctionBetween.apply_closed with fn, hv
  have zeroW := Module.zero_mem at K, W with modW
  rw f0 at r
  have dw := spaceMetric.dist at W, K, absK, normW, f(v), Module.zero(W) with normedW, fv, zeroW
  have b0 := Module.add_zero at K, W, f(v) with modW, fv
  rw [nz0W, b0] at dw
  rw dw at r
  exact r

-- The norms read by the operator norm are real.
theorem opNorm.real_values (f V K absK normV W normW : Set)
  requires normedV : NormedSpace(V, K, absK, normV)
  requires normedW : NormedSpace(W, K, absK, normW)
  requires linear : IsLinearMap(f, V, W, K)
  shows ∀ v ∈ Module.carrier(V), normV(v) ∈ ℝ ∧ normW(f(v)) ∈ ℝ
proof
  obtain ⟨nfV, modV, ngV, lawV⟩ := normedV
  obtain ⟨nfW, modW, ngW, lawW⟩ := normedW
  obtain ⟨abelianV, isNormV⟩ := ngV
  obtain ⟨normFV, restV⟩ := isNormV
  obtain ⟨abelianW, isNormW⟩ := ngW
  obtain ⟨normFW, restW⟩ := isNormW
  obtain ⟨modV2, modW2, fn, addLaw, smulLaw⟩ := linear
  intros v hv
  have fv := FunctionBetween.apply_closed with fn, hv
  have vA : v ∈ Group.carrier(Module.additive(V))
    rw Module.additive.carrier
    exact hv
  have fvA : f(v) ∈ Group.carrier(Module.additive(W))
    rw Module.additive.carrier
    exact fv
  have a := FunctionBetween.apply_closed with normFV, vA
  have b := FunctionBetween.apply_closed with normFW, fvA
  exact ⟨a, b⟩

-- Section: The operator norm
section OperatorNorm
variable (f V K absK normV W normW : Set)
hypothesis normedV : NormedSpace(V, K, absK, normV)
hypothesis normedW : NormedSpace(W, K, absK, normW)
hypothesis nontrivial : NontriviallyNormedField(K, absK)
hypothesis continuous : ContinuousLinearMap(f, V, normV, W, normW, K)

theorem opNorm.bound
  shows LinearBound(f, V, normV, normW, opNorm(f, V, normV, normW))
proof
  have lin := continuous.left
  have real := opNorm.real_values with normedV, normedW, lin
  have bdd := (ContinuousLinearMap.iff_bounded at f, V, K, absK, normV, W, normW with normedV, normedW, nontrivial, lin).forward with continuous
  have sel := opNorm.selected at f, V, normV, normW with bdd, real
  obtain ⟨mem, prop⟩ := sel
  exact prop.left

theorem opNorm.nonneg
  shows realZero ≤ opNorm(f, V, normV, normW)
proof
  have b := opNorm.bound at f, V, K, absK, normV, W, normW with normedV, normedW, nontrivial, continuous
  obtain ⟨In, nn, rest⟩ := b
  exact nn

-- Mathlib's le_opNorm: ‖f v‖ ≤ ‖f‖ ‖v‖.
theorem opNorm.le (v : Set)
  requires member : v ∈ Module.carrier(V)
  shows normW(f(v)) ≤ R[opNorm(f, V, normV, normW) * normV(v)]
proof
  have b := opNorm.bound at f, V, K, absK, normV, W, normW with normedV, normedW, nontrivial, continuous
  obtain ⟨In, nn, rest⟩ := b
  exact rest with v, member

-- Mathlib's opNorm_le_bound.
theorem opNorm.le_bound (C : Real)
  requires nonneg : realZero ≤ C
  requires bound : ∀ v ∈ Module.carrier(V), normW(f(v)) ≤ R[C * normV(v)]
  shows opNorm(f, V, normV, normW) ≤ C
proof
  have lin := continuous.left
  have real := opNorm.real_values with normedV, normedW, lin
  have CIn : C ∈ ℝ by typecheck
  have lb : LinearBound(f, V, normV, normW, C)
    unfold LinearBound
    exact ⟨CIn, nonneg, bound⟩
  have sel := opNorm.selected at f, V, normV, normW with ⟨C, lb⟩, real
  obtain ⟨mem, prop⟩ := sel
  obtain ⟨lbO, least⟩ := prop
  exact least with C, lb

theorem opNorm.eq_zero_iff
  shows opNorm(f, V, normV, normW) = realZero ↔
    (∀ v ∈ Module.carrier(V), f(v) = Module.zero(W))
proof
  have b := opNorm.bound at f, V, K, absK, normV, W, normW with normedV, normedW, nontrivial, continuous
  obtain ⟨oIn, oNn, oBound⟩ := b
  have oR : Real(opNorm(f, V, normV, normW)) by exact oIn
  have lin := continuous.left
  have l2 := lin
  obtain ⟨modV, modW, fn, addLaw, smulLaw⟩ := l2
  constructor
  . intro oz
    intros v hv
    have fv := FunctionBetween.apply_closed with fn, hv
    obtain ⟨nvIn, nvNn⟩ := NormedSpace.norm_real at V, K, absK, normV, v with normedV, hv
    have nvR : Real(normV(v)) by exact nvIn
    obtain ⟨nwIn, nwNn⟩ := NormedSpace.norm_real at W, K, absK, normW, f(v) with normedW, fv
    have nwR : Real(normW(f(v))) by exact nwIn
    have bv := oBound with v, hv
    rw oz at bv
    have z : (0:R) * normV(v) = (0:R) by ring
    rw z at bv
    have nz : normW(f(v)) = (0:R) by linarith
    exact (NormedSpace.norm_eq_zero at W, K, absK, normW, f(v) with normedW, fv).forward with nz
  . intro allZero
    have zNn : realZero ≤ (0:R) by linarith
    have bz : ∀ v ∈ Module.carrier(V), normW(f(v)) ≤ R[(0:R) * normV(v)]
      intros v hv
      have fz := allZero with v, hv
      rw fz
      have zw := Module.zero_mem at K, W with modW
      have a := (NormedSpace.norm_eq_zero at W, K, absK, normW, Module.zero(W) with normedW, zw).backward with rfl
      rw a
      obtain ⟨nvIn, nvNn⟩ := NormedSpace.norm_real at V, K, absK, normV, v with normedV, hv
      have nvR : Real(normV(v)) by exact nvIn
      have z : (0:R) * normV(v) = (0:R) by ring
      rw z
      linarith
    have le := opNorm.le_bound at f, V, K, absK, normV, W, normW, (0:R) with normedV, normedW, nontrivial, continuous, zNn, bz
    linarith

-- On a nonzero space, ‖f‖ is the supremum of ‖f v‖ over the unit ball:
-- every number below ‖f‖ is exceeded by some ‖f v‖ with ‖v‖ ≤ 1.
theorem opNorm.approx (B : Real)
  requires below : B < opNorm(f, V, normV, normW)
  shows ∃ v ∈ Module.carrier(V), normV(v) ≤ realOne ∧ B < normW(f(v))
proof
  sorry

end OperatorNorm

-- (a + b) + (c + d) = (a + c) + (b + d) in a module.
theorem Module.add_add_add_comm (V K a b c d : Set)
  requires module : Module(V, K)
  requires memberA : a ∈ Module.carrier(V)
  requires memberB : b ∈ Module.carrier(V)
  requires memberC : c ∈ Module.carrier(V)
  requires memberD : d ∈ Module.carrier(V)
  shows Module.add(V)(Module.add(V)(a, b), Module.add(V)(c, d)) =
    Module.add(V)(Module.add(V)(a, c), Module.add(V)(b, d))
proof
  have abelian := Module.additive.abelian_group at V, K with module
  have aA : a ∈ Group.carrier(Module.additive(V))
    rw Module.additive.carrier
    exact memberA
  have bA : b ∈ Group.carrier(Module.additive(V))
    rw Module.additive.carrier
    exact memberB
  have cA : c ∈ Group.carrier(Module.additive(V))
    rw Module.additive.carrier
    exact memberC
  have dA : d ∈ Group.carrier(Module.additive(V))
    rw Module.additive.carrier
    exact memberD
  have e := mul_mul_mul_comm at Module.additive(V), a, b, c, d with abelian, aA, bA, cA, dA
  rw Module.additive.mul at e
  exact e

-- Mathlib's opNorm_comp_le: ‖g ∘ f‖ ≤ ‖g‖ ‖f‖.
theorem opNorm.comp_le (f g h U K absK normU V normV W normW : Set)
  requires normedU : NormedSpace(U, K, absK, normU)
  requires normedV : NormedSpace(V, K, absK, normV)
  requires normedW : NormedSpace(W, K, absK, normW)
  requires nontrivial : NontriviallyNormedField(K, absK)
  requires first : ContinuousLinearMap(f, U, normU, V, normV, K)
  requires second : ContinuousLinearMap(g, V, normV, W, normW, K)
  requires function : h : Module.carrier(U) → Module.carrier(W)
  requires composite : ∀ u ∈ Module.carrier(U), h(u) = g(f(u))
  shows opNorm(h, U, normU, normW) ≤
    R[opNorm(g, V, normV, normW) * opNorm(f, U, normU, normV)]
proof
  have clmH := ContinuousLinearMap.comp with first, second, function, composite
  have gb := opNorm.bound at g, V, K, absK, normV, W, normW with normedV, normedW, nontrivial, second
  have fb := opNorm.bound at f, U, K, absK, normU, V, normV with normedU, normedV, nontrivial, first
  obtain ⟨gIn, gNn, gB⟩ := gb
  obtain ⟨fIn, fNn, fB⟩ := fb
  have gR : Real(opNorm(g, V, normV, normW)) by exact gIn
  have fR : Real(opNorm(f, U, normU, normV)) by exact fIn
  have pNn := realLe.mul_left_of_nonnegative at (0:R), opNorm(f, U, normU, normV), opNorm(g, V, normV, normW) with fNn, gNn
  have z : opNorm(g, V, normV, normW) * (0:R) = (0:R) by ring
  rw z at pNn
  have fn := first.left.right.right.left
  have bnd : ∀ u ∈ Module.carrier(U), normW(h(u)) ≤ R[(opNorm(g, V, normV, normW) * opNorm(f, U, normU, normV)) * normU(u)]
    intros u hu
    have c := composite with u, hu
    rw c
    have fu := FunctionBetween.apply_closed with fn, hu
    have b1 := gB with f(u), fu
    have b2 := fB with u, hu
    have nuR : Real(normU(u)) by exact (NormedSpace.norm_real at U, K, absK, normU, u with normedU, hu).left
    have nfR : Real(normV(f(u))) by exact (NormedSpace.norm_real at V, K, absK, normV, f(u) with normedV, fu).left
    have gfu := FunctionBetween.apply_closed with second.left.right.right.left, fu
    have ngR : Real(normW(g(f(u)))) by exact (NormedSpace.norm_real at W, K, absK, normW, g(f(u)) with normedW, gfu).left
    have m := realLe.mul_left_of_nonnegative at normV(f(u)), opNorm(f, U, normU, normV) * normU(u), opNorm(g, V, normV, normW) with b2, gNn
    have e : opNorm(g, V, normV, normW) * (opNorm(f, U, normU, normV) * normU(u)) = (opNorm(g, V, normV, normW) * opNorm(f, U, normU, normV)) * normU(u) by ring
    rw e at m
    linarith
  have pR : Real(opNorm(g, V, normV, normW) * opNorm(f, U, normU, normV)) by typecheck
  exact opNorm.le_bound at h, U, K, absK, normU, W, normW, opNorm(g, V, normV, normW) * opNorm(f, U, normU, normV) with normedU, normedW, nontrivial, clmH, pNn, bnd

-- Mathlib's opNorm_add_le: ‖f + g‖ ≤ ‖f‖ + ‖g‖.
theorem opNorm.add_le (f g h V K absK normV W normW : Set)
  requires normedV : NormedSpace(V, K, absK, normV)
  requires normedW : NormedSpace(W, K, absK, normW)
  requires nontrivial : NontriviallyNormedField(K, absK)
  requires first : ContinuousLinearMap(f, V, normV, W, normW, K)
  requires second : ContinuousLinearMap(g, V, normV, W, normW, K)
  requires sum : ∀ v ∈ Module.carrier(V), h(v) = Module.add(W)(f(v), g(v))
  requires function : h : Module.carrier(V) → Module.carrier(W)
  shows ContinuousLinearMap(h, V, normV, W, normW, K) ∧
    opNorm(h, V, normV, normW) ≤
      R[opNorm(f, V, normV, normW) + opNorm(g, V, normV, normW)]
proof
  have linF := first.left
  have linG := second.left
  have l2 := linF
  obtain ⟨modV, modW, fnF, addF, smulF⟩ := l2
  have l3 := linG
  obtain ⟨modV2, modW2, fnG, addG, smulG⟩ := l3
  have ringK := Module.ring at V, K with modV
  have linH : IsLinearMap(h, V, W, K)
    unfold IsLinearMap
    refine ⟨modV, modW, function, ?_, ?_⟩
    . intros v hv w hw
      have vw := Module.add_mem at K, V, v, w with ringK, modV, hv, hw
      have fv := FunctionBetween.apply_closed with fnF, hv
      have fw := FunctionBetween.apply_closed with fnF, hw
      have gv := FunctionBetween.apply_closed with fnG, hv
      have gw := FunctionBetween.apply_closed with fnG, hw
      rw [(sum with Module.add(V)(v, w), vw), (sum with v, hv), (sum with w, hw), (addF with v, hv, w, hw), (addG with v, hv, w, hw)]
      exact Module.add_add_add_comm at W, K, f(v), f(w), g(v), g(w) with modW, fv, fw, gv, gw
    . intros c hc v hv
      have cv := Module.smul_mem at K, V, c, v with ringK, modV, hc, hv
      have fv := FunctionBetween.apply_closed with fnF, hv
      have gv := FunctionBetween.apply_closed with fnG, hv
      rw [(sum with Module.smul(V)(c, v), cv), (sum with v, hv), (smulF with c, hc, v, hv), (smulG with c, hc, v, hv)]
      have e := smul_add at K, W, c, f(v), g(v) with ringK, modW, hc, fv, gv
      rw e
  have fb := opNorm.bound at f, V, K, absK, normV, W, normW with normedV, normedW, nontrivial, first
  have gb := opNorm.bound at g, V, K, absK, normV, W, normW with normedV, normedW, nontrivial, second
  obtain ⟨fIn, fNn, fB⟩ := fb
  obtain ⟨gIn, gNn, gB⟩ := gb
  have gR : Real(opNorm(g, V, normV, normW)) by exact gIn
  have fR : Real(opNorm(f, V, normV, normW)) by exact fIn
  have sNn : (0:R) ≤ opNorm(f, V, normV, normW) + opNorm(g, V, normV, normW) by linarith
  have sIn : opNorm(f, V, normV, normW) + opNorm(g, V, normV, normW) ∈ ℝ by typecheck
  have bnd : ∀ v ∈ Module.carrier(V), normW(h(v)) ≤ R[(opNorm(f, V, normV, normW) + opNorm(g, V, normV, normW)) * normV(v)]
    intros v hv
    have fv := FunctionBetween.apply_closed with fnF, hv
    have gv := FunctionBetween.apply_closed with fnG, hv
    rw (sum with v, hv)
    have t := NormedSpace.norm_add_le at W, K, absK, normW, f(v), g(v) with normedW, fv, gv
    have b1 := fB with v, hv
    have b2 := gB with v, hv
    have nvR : Real(normV(v)) by exact (NormedSpace.norm_real at V, K, absK, normV, v with normedV, hv).left
    have nfR : Real(normW(f(v))) by exact (NormedSpace.norm_real at W, K, absK, normW, f(v) with normedW, fv).left
    have ngR : Real(normW(g(v))) by exact (NormedSpace.norm_real at W, K, absK, normW, g(v) with normedW, gv).left
    have fgv := Module.add_mem at K, W, f(v), g(v) with ringK, modW, fv, gv
    have nsR : Real(normW(Module.add(W)(f(v), g(v)))) by exact (NormedSpace.norm_real at W, K, absK, normW, Module.add(W)(f(v), g(v)) with normedW, fgv).left
    have e : (opNorm(f, V, normV, normW) + opNorm(g, V, normV, normW)) * normV(v) = opNorm(f, V, normV, normW) * normV(v) + opNorm(g, V, normV, normW) * normV(v) by ring
    rw e
    linarith
  have lb : LinearBound(h, V, normV, normW, opNorm(f, V, normV, normW) + opNorm(g, V, normV, normW))
    unfold LinearBound
    exact ⟨sIn, sNn, bnd⟩
  have clmH := (ContinuousLinearMap.iff_bounded at h, V, K, absK, normV, W, normW with normedV, normedW, nontrivial, linH).backward with ⟨opNorm(f, V, normV, normW) + opNorm(g, V, normV, normW), lb⟩
  refine ⟨clmH, ?_⟩
  exact opNorm.le_bound at h, V, K, absK, normV, W, normW, opNorm(f, V, normV, normW) + opNorm(g, V, normV, normW) with normedV, normedW, nontrivial, clmH, sNn, bnd

-- Mathlib's opNorm_smul: ‖c f‖ = |c| ‖f‖.
theorem opNorm.smul (f h c V K absK normV W normW : Set)
  requires normedV : NormedSpace(V, K, absK, normV)
  requires normedW : NormedSpace(W, K, absK, normW)
  requires nontrivial : NontriviallyNormedField(K, absK)
  requires commutative : CommRing(K)
  requires continuous : ContinuousLinearMap(f, V, normV, W, normW, K)
  requires scalar : c ∈ Ring.carrier(K)
  requires function : h : Module.carrier(V) → Module.carrier(W)
  requires scaled : ∀ v ∈ Module.carrier(V), h(v) = Module.smul(W)(c, f(v))
  shows ContinuousLinearMap(h, V, normV, W, normW, K) ∧
    opNorm(h, V, normV, normW) = R[absK(c) * opNorm(f, V, normV, normW)]
proof
  have linF := continuous.left
  have l2 := linF
  obtain ⟨modV, modW, fnF, addF, smulF⟩ := l2
  have ringK := Module.ring at V, K with modV
  have nW := normedW
  obtain ⟨nf, modW2, ngW, lawW⟩ := nW
  have nf2 := nf
  obtain ⟨field, comm, nr, mulEq, oneEq⟩ := nf2
  have linH : IsLinearMap(h, V, W, K)
    unfold IsLinearMap
    refine ⟨modV, modW, function, ?_, ?_⟩
    . intros v hv w hw
      have vw := Module.add_mem at K, V, v, w with ringK, modV, hv, hw
      have fv := FunctionBetween.apply_closed with fnF, hv
      have fw := FunctionBetween.apply_closed with fnF, hw
      rw [(scaled with Module.add(V)(v, w), vw), (scaled with v, hv), (scaled with w, hw), (addF with v, hv, w, hw)]
      exact smul_add at K, W, c, f(v), f(w) with ringK, modW, scalar, fv, fw
    . intros a ha v hv
      have av := Module.smul_mem at K, V, a, v with ringK, modV, ha, hv
      have fv := FunctionBetween.apply_closed with fnF, hv
      rw [(scaled with Module.smul(V)(a, v), av), (scaled with v, hv), (smulF with a, ha, v, hv)]
      have e1 := mul_smul at K, W, c, a, f(v) with ringK, modW, scalar, ha, fv
      have e2 := mul_smul at K, W, a, c, f(v) with ringK, modW, ha, scalar, fv
      have sw : Ring.mul(K)(c, a) = Ring.mul(K)(a, c) by ring
      rw sw at e1
      rw [← e1, e2]
  have fb := opNorm.bound at f, V, K, absK, normV, W, normW with normedV, normedW, nontrivial, continuous
  obtain ⟨fIn, fNn, fB⟩ := fb
  have fR : Real(opNorm(f, V, normV, normW)) by exact fIn
  obtain ⟨cIn, cNn⟩ := NormedField.norm_real at K, absK, c with nf, scalar
  have cR : Real(absK(c)) by exact cIn
  have pNn := realLe.mul_left_of_nonnegative at (0:R), opNorm(f, V, normV, normW), absK(c) with fNn, cNn
  have z : absK(c) * (0:R) = (0:R) by ring
  rw z at pNn
  have pIn : absK(c) * opNorm(f, V, normV, normW) ∈ ℝ by typecheck
  have bnd : ∀ v ∈ Module.carrier(V), normW(h(v)) ≤ R[(absK(c) * opNorm(f, V, normV, normW)) * normV(v)]
    intros v hv
    have fv := FunctionBetween.apply_closed with fnF, hv
    rw [(scaled with v, hv), (lawW with c, scalar, f(v), fv)]
    have b := fB with v, hv
    have nvR : Real(normV(v)) by exact (NormedSpace.norm_real at V, K, absK, normV, v with normedV, hv).left
    have nfR : Real(normW(f(v))) by exact (NormedSpace.norm_real at W, K, absK, normW, f(v) with normedW, fv).left
    have m := realLe.mul_left_of_nonnegative at normW(f(v)), opNorm(f, V, normV, normW) * normV(v), absK(c) with b, cNn
    have e : absK(c) * (opNorm(f, V, normV, normW) * normV(v)) = (absK(c) * opNorm(f, V, normV, normW)) * normV(v) by ring
    rw e at m
    exact m
  have lb : LinearBound(h, V, normV, normW, absK(c) * opNorm(f, V, normV, normW))
    unfold LinearBound
    exact ⟨pIn, pNn, bnd⟩
  have clmH := (ContinuousLinearMap.iff_bounded at h, V, K, absK, normV, W, normW with normedV, normedW, nontrivial, linH).backward with ⟨absK(c) * opNorm(f, V, normV, normW), lb⟩
  have upper := opNorm.le_bound at h, V, K, absK, normV, W, normW, absK(c) * opNorm(f, V, normV, normW) with normedV, normedW, nontrivial, clmH, pNn, bnd
  have hb := opNorm.bound at h, V, K, absK, normV, W, normW with normedV, normedW, nontrivial, clmH
  obtain ⟨hIn, hNn, hB⟩ := hb
  have hR : Real(opNorm(h, V, normV, normW)) by exact hIn
  refine ⟨clmH, ?_⟩
  by_cases cz : c = Ring.zero(K)
  . have ngK := nr.right.left
    obtain ⟨abelianK, isNormK⟩ := ngK
    obtain ⟨normFK, nonnegK, zeroIffK, invarK, triK⟩ := isNormK
    have cA : c ∈ Group.carrier(Ring.additive(K))
      rw Ring.additive.carrier
      exact scalar
    have c0 : absK(c) = (0:R)
      apply (zeroIffK with c, cA).backward
      rw Ring.additive.one
      exact cz
    rw c0 at upper
    rw c0
    have z2 : (0:R) * opNorm(f, V, normV, normW) = (0:R) by ring
    rw z2 at upper
    rw z2
    linarith
  . have fieldParts := Field.parts with field
    obtain ⟨y, inv⟩ := IsField.inverse_exists with fieldParts, scalar, cz
    obtain ⟨cIn2, yIn, yc, cy⟩ := inv
    obtain ⟨yRIn, yNn⟩ := NormedField.norm_real at K, absK, y with nf, yIn
    have yR : Real(absK(y)) by exact yRIn
    have qNn := realLe.mul_left_of_nonnegative at (0:R), opNorm(h, V, normV, normW), absK(y) with hNn, yNn
    have z3 : absK(y) * (0:R) = (0:R) by ring
    rw z3 at qNn
    have bnd2 : ∀ v ∈ Module.carrier(V), normW(f(v)) ≤ R[(absK(y) * opNorm(h, V, normV, normW)) * normV(v)]
      intros v hv
      have fv := FunctionBetween.apply_closed with fnF, hv
      have hv2 := FunctionBetween.apply_closed with function, hv
      have back : f(v) = Module.smul(W)(y, h(v))
        rw (scaled with v, hv)
        have e1 := mul_smul at K, W, y, c, f(v) with ringK, modW, yIn, scalar, fv
        rw [yc] at e1
        have e2 := one_smul at K, W, f(v) with ringK, modW, fv
        rw e2 at e1
        exact e1
      rw back
      rw (lawW with y, yIn, h(v), hv2)
      have b := hB with v, hv
      have nvR : Real(normV(v)) by exact (NormedSpace.norm_real at V, K, absK, normV, v with normedV, hv).left
      have nhR : Real(normW(h(v))) by exact (NormedSpace.norm_real at W, K, absK, normW, h(v) with normedW, hv2).left
      have m := realLe.mul_left_of_nonnegative at normW(h(v)), opNorm(h, V, normV, normW) * normV(v), absK(y) with b, yNn
      have e : absK(y) * (opNorm(h, V, normV, normW) * normV(v)) = (absK(y) * opNorm(h, V, normV, normW)) * normV(v) by ring
      rw e at m
      exact m
    have yhR : Real(absK(y) * opNorm(h, V, normV, normW)) by typecheck
    have lower := opNorm.le_bound at f, V, K, absK, normV, W, normW, absK(y) * opNorm(h, V, normV, normW) with normedV, normedW, nontrivial, continuous, qNn, bnd2
    have m := realLe.mul_left_of_nonnegative at opNorm(f, V, normV, normW), absK(y) * opNorm(h, V, normV, normW), absK(c) with lower, cNn
    have prod := mulEq with c, scalar, y, yIn
    rw [cy, oneEq] at prod
    have e : absK(c) * (absK(y) * opNorm(h, V, normV, normW)) = (absK(c) * absK(y)) * opNorm(h, V, normV, normW) by ring
    rw [e, ← prod] at m
    have e2 : (1:R) * opNorm(h, V, normV, normW) = opNorm(h, V, normV, normW) by ring
    rw e2 at m
    linarith

theorem opNorm.identity_le (V K absK norm : Set)
  requires normed : NormedSpace(V, K, absK, norm)
  shows opNorm(identity(Module.carrier(V)), V, norm, norm) ≤ realOne
proof
  have clm := ContinuousLinearMap.identity at V, K, absK, norm with normed
  have lin := clm.left
  have real := opNorm.real_values with normed, normed, lin
  have oneIn : (1:R) ∈ ℝ by typecheck
  have oneNn : (0:R) ≤ (1:R) by linarith
  have lb : LinearBound(identity(Module.carrier(V)), V, norm, norm, (1:R))
    unfold LinearBound
    refine ⟨oneIn, oneNn, ?_⟩
    intros v hv
    have a := identity.apply at v, Module.carrier(V) with hv
    rw a
    have nR := (real with v, hv).left
    have nRR : Real(norm(v)) by exact nR
    have e : (1:R) * norm(v) = norm(v) by ring
    rw e
    linarith
  have sel := opNorm.selected at identity(Module.carrier(V)), V, norm, norm with ⟨(1:R), lb⟩, real
  obtain ⟨mem, prop⟩ := sel
  obtain ⟨lbO, least⟩ := prop
  exact least with (1:R), lb

-- Uniform boundedness for sequences of operators converging pointwise is
-- not needed; continuous linear maps into a Banach space from a dense
-- subspace extend uniquely (Mathlib's ContinuousLinearMap.extend), stated
-- as uniqueness: two continuous linear maps agreeing on a dense set agree.
theorem ContinuousLinearMap.eq_of_dense (f g D V K absK normV W normW : Set)
  requires normedV : NormedSpace(V, K, absK, normV)
  requires normedW : NormedSpace(W, K, absK, normW)
  requires first : ContinuousLinearMap(f, V, normV, W, normW, K)
  requires second : ContinuousLinearMap(g, V, normV, W, normW, K)
  requires dense : Dense(spaceTopology(V, normV), D)
  requires agree : ∀ v ∈ D, f(v) = g(v)
  shows ∀ v ∈ Module.carrier(V), f(v) = g(v)
proof
  have cF := first.right
  have cG := second.right
  have ngW := normedW.right.right.left
  have ngV := normedV.right.right.left
  have modV := normedV.right.left
  have haus := normTopology.hausdorff at Module.additive(W), normW with ngW
  have haus2 : Hausdorff(spaceTopology(W, normW))
    unfold spaceTopology
    exact haus
  have closed := Continuous.closed_eq with cF, cG, haus2
  unfold Closed at closed
  have d2 := dense
  unfold Dense at d2
  unfold IsDense at d2
  rw spaceTopology.carrier_eq at d2
  rw spaceTopology.carrier_eq at closed
  have zeroV := Module.zero_mem at K, V with modV
  have zc : Module.zero(V) ∈ closure(Module.carrier(V), TopologicalSpace.opens(spaceTopology(V, normV)), D)
    rw d2
    exact zeroV
  unfold closure at zc
  simp [familyIntersection] at zc
  obtain ⟨zu, zall⟩ := zc
  obtain ⟨C, CIn, zC⟩ := union.membership.forward with zu
  obtain ⟨CP, Cclosed, DC⟩ := closedSupersets.membership.forward with CIn
  have DV : D ⊆ Module.carrier(V)
    intros x hx
    have xC := DC with x, hx
    exact Cclosed.left with x, xC
  have sub : D ⊆ equalizer(f, g, Module.carrier(V))
    intros v hv
    apply equalizer.membership.backward
    exact ⟨(DV with v, hv), (agree with v, hv)⟩
  have least := closure.least with closed, sub
  rw d2 at least
  intros v hv
  have m := least with v, hv
  exact (equalizer.membership.forward with m).right

-- Section: Finite-dimensional spaces over ℝ and ℂ
-- The scalar field is ℝ with |·| or ℂ with its modulus.
predicate RealOrComplexScalars (K absK : Set) :=
  (K = realRing ∧ absK = realAbs) ∨ (K = complexRing ∧ absK = complexAbs)

theorem FiniteDimensional.norms_equivalent (V K absK norm1 norm2 : Set)
  requires scalars : RealOrComplexScalars(K, absK)
  requires first : NormedSpace(V, K, absK, norm1)
  requires second : NormedSpace(V, K, absK, norm2)
  requires finite : FiniteDimensionalModule(V, K)
  shows EquivalentNorms(V, norm1, norm2)
proof
  sorry

theorem FiniteDimensional.complete (V K absK norm : Set)
  requires scalars : RealOrComplexScalars(K, absK)
  requires normed : NormedSpace(V, K, absK, norm)
  requires finite : FiniteDimensionalModule(V, K)
  shows BanachSpace(V, K, absK, norm)
proof
  sorry

-- Mathlib's LinearMap.continuous_of_finiteDimensional.
theorem FiniteDimensional.linear_continuous (f V K absK normV W normW : Set)
  requires scalars : RealOrComplexScalars(K, absK)
  requires normedV : NormedSpace(V, K, absK, normV)
  requires normedW : NormedSpace(W, K, absK, normW)
  requires finite : FiniteDimensionalModule(V, K)
  requires linear : IsLinearMap(f, V, W, K)
  shows ContinuousLinearMap(f, V, normV, W, normW, K)
proof
  sorry

-- Mathlib's isCompact_closedBall in a finite-dimensional space (a proper
-- space), and Heine–Borel.
theorem FiniteDimensional.closed_ball_compact (V K absK norm v : Set, r : Real)
  requires scalars : RealOrComplexScalars(K, absK)
  requires normed : NormedSpace(V, K, absK, norm)
  requires finite : FiniteDimensionalModule(V, K)
  requires member : v ∈ Module.carrier(V)
  shows Compact(spaceTopology(V, norm), closedBall(spaceMetric(V, norm), v, r))
proof
  sorry

theorem FiniteDimensional.compact_iff (V K absK norm A : Set)
  requires scalars : RealOrComplexScalars(K, absK)
  requires normed : NormedSpace(V, K, absK, norm)
  requires finite : FiniteDimensionalModule(V, K)
  requires inside : A ⊆ Module.carrier(V)
  shows Compact(spaceTopology(V, norm), A) ↔
    Closed(spaceTopology(V, norm), A) ∧ Bounded(spaceMetric(V, norm), A)
proof
  sorry

theorem FiniteDimensional.locally_compact (V K absK norm : Set)
  requires scalars : RealOrComplexScalars(K, absK)
  requires normed : NormedSpace(V, K, absK, norm)
  requires finite : FiniteDimensionalModule(V, K)
  shows LocallyCompact(spaceTopology(V, norm))
proof
  sorry

-- A finite-dimensional subspace of a normed space is closed.
theorem FiniteDimensional.subspace_closed (V K absK norm S b : Set, n : Nat)
  requires scalars : RealOrComplexScalars(K, absK)
  requires normed : NormedSpace(V, K, absK, norm)
  requires spanning : ∀ i ∈ n, b(i) ∈ S
  requires inside : S ⊆ Module.carrier(V)
  requires span : ∀ v ∈ S, ∃ c, ∃ w,
    (∀ i ∈ n, c(i) ∈ Ring.carrier(K) ∧ w(i) = Module.smul(V)(c(i), b(i))) ∧
    v = groupFiniteSum(Module.additive(V), n, w)
  requires closedUnder : ∀ c, ∀ w,
    (∀ i ∈ n, c(i) ∈ Ring.carrier(K) ∧ w(i) = Module.smul(V)(c(i), b(i))) →
    groupFiniteSum(Module.additive(V), n, w) ∈ S
  shows Closed(spaceTopology(V, norm), S)
proof
  sorry

-- Section: ℝ and ℂ as normed spaces
theorem NormedSpace.real_self
  shows NormedSpace(realSelfModule, realRing, realAbs, realAbs)
proof
  have ntf := NormedField.real
  have nf := ntf.left
  have nf2 := nf
  obtain ⟨field, comm, nr, mulEq, oneEq⟩ := nf2
  obtain ⟨ring, ng, sub⟩ := nr
  have module := Ring.to_module at realRing with ring
  have addEq : Module.additive(realSelfModule) = Ring.additive(realRing)
    unfold realSelfModule
    unfold selfModule
    unfold Module.additive
    unfold Ring.additive
    simp [Module.mk.carrier, Module.mk.add, Module.mk.zero, Module.mk.neg]
  have smulEq : Module.smul(realSelfModule) = Ring.mul(realRing)
    unfold realSelfModule
    unfold selfModule
    simp [Module.mk.smul]
  have carEq : Module.carrier(realSelfModule) = Ring.carrier(realRing)
    unfold realSelfModule
    unfold selfModule
    simp [Module.mk.carrier]
  unfold NormedSpace
  refine ⟨nf, ?_, ?_, ?_⟩
  . unfold realSelfModule
    exact module
  . rw addEq
    exact ng
  . rw [carEq, smulEq]
    exact mulEq

theorem NormedSpace.complex_self
  shows NormedSpace(complexSelfModule, complexRing, complexAbs, complexAbs)
proof
  have ntf := NormedField.complex
  have nf := ntf.left
  have nf2 := nf
  obtain ⟨field, comm, nr, mulEq, oneEq⟩ := nf2
  obtain ⟨ring, ng, sub⟩ := nr
  have module := Ring.to_module at complexRing with ring
  have addEq : Module.additive(complexSelfModule) = Ring.additive(complexRing)
    unfold complexSelfModule
    unfold selfModule
    unfold Module.additive
    unfold Ring.additive
    simp [Module.mk.carrier, Module.mk.add, Module.mk.zero, Module.mk.neg]
  have smulEq : Module.smul(complexSelfModule) = Ring.mul(complexRing)
    unfold complexSelfModule
    unfold selfModule
    simp [Module.mk.smul]
  have carEq : Module.carrier(complexSelfModule) = Ring.carrier(complexRing)
    unfold complexSelfModule
    unfold selfModule
    simp [Module.mk.carrier]
  unfold NormedSpace
  refine ⟨nf, ?_, ?_, ?_⟩
  . unfold complexSelfModule
    exact module
  . rw addEq
    exact ng
  . rw [carEq, smulEq]
    exact mulEq

-- A commutative ring is a one-dimensional module over itself, spanned by 1.
theorem FiniteDimensional.self_module (K : Set)
  requires commutative : CommRing(K)
  shows FiniteDimensionalModule(selfModule(K), K)
proof
  have ring := commutative.left
  have module := Ring.to_module at K with ring
  have carEq : Module.carrier(selfModule(K)) = Ring.carrier(K)
    unfold selfModule
    simp [Module.mk.carrier]
  have smulEq : Module.smul(selfModule(K)) = Ring.mul(K)
    unfold selfModule
    simp [Module.mk.smul]
  have oneIn := Ring.one_mem at K with ring
  have oneNat : (1:N) ∈ ℕ by typecheck
  have zeroIn : (0:N) ∈ (1:N) by simp
  have shape1 := natural.successor_as_insert at (0:N)
  have shape2 : insert((0:N), (0:N)) = {(0:N)}
    ext x
    constructor
    . intro hx
      have hx2 := insert.membership.forward with hx
      cases hx2 with a | b
      . simp [a]
      . exfalso
        unfold zero at b
        exact set.empty with b
    . intro hx
      simp at hx
      apply insert.membership.backward
      left
      exact hx
  rw shape2 at shape1
  have shape : (1:N) = {(0:N)}
    exact shape1
  have abelian := Module.additive.abelian_group at selfModule(K), K with module
  unfold FiniteDimensionalModule
  refine ⟨(1:N), oneNat, constantFunction((1:N), Ring.carrier(K), Ring.one(K)), ?_⟩
  unfold SpansModule
  refine ⟨module, ?_, ?_⟩
  . intros i hi
    rw carEq
    have a := constantFunction.apply at (1:N), Ring.carrier(K), i, Ring.one(K) with hi, oneIn
    rw a
    exact oneIn
  . intros v hv
    rw carEq at hv
    refine ⟨constantFunction((1:N), Ring.carrier(K), v), constantFunction((1:N), Ring.carrier(K), v), ?_, ?_⟩
    . intros i hi
      have a1 := constantFunction.apply at (1:N), Ring.carrier(K), i, v with hi, hv
      have a2 := constantFunction.apply at (1:N), Ring.carrier(K), i, Ring.one(K) with hi, oneIn
      rw [a1, a2, smulEq]
      have e : Ring.mul(K)(v, Ring.one(K)) = v by ring
      rw e
      exact ⟨hv, rfl⟩
    . have a0 := constantFunction.apply at (1:N), Ring.carrier(K), (0:N), v with zeroIn, hv
      have vA : constantFunction((1:N), Ring.carrier(K), v)((0:N)) ∈ Group.carrier(Module.additive(selfModule(K)))
        rw [Module.additive.carrier, carEq, a0]
        exact hv
      have s := groupFiniteSum.singleton at Module.additive(selfModule(K)), (0:N), constantFunction((1:N), Ring.carrier(K), v) with abelian, vA
      rw ← shape at s
      rw [s, a0]

theorem FiniteDimensional.real_self
  shows FiniteDimensionalModule(realSelfModule, realRing)
proof
  have comm := realRing.comm_ring
  unfold realSelfModule
  exact FiniteDimensional.self_module at realRing with comm

theorem FiniteDimensional.complex_self
  shows FiniteDimensionalModule(complexSelfModule, complexRing)
proof
  have comm := complexRing.comm_ring
  unfold complexSelfModule
  exact FiniteDimensional.self_module at complexRing with comm

theorem spaceTopology.real_self
  shows spaceTopology(realSelfModule, realAbs) = realLine
proof
  have addEq : Module.additive(realSelfModule) = Ring.additive(realRing)
    unfold realSelfModule
    unfold selfModule
    unfold Module.additive
    unfold Ring.additive
    simp [Module.mk.carrier, Module.mk.add, Module.mk.zero, Module.mk.neg]
  unfold spaceTopology
  rw addEq
  exact normTopology.real

theorem spaceTopology.complex_self
  shows spaceTopology(complexSelfModule, complexAbs) = complexSpace
proof
  have addEq : Module.additive(complexSelfModule) = Ring.additive(complexRing)
    unfold complexSelfModule
    unfold selfModule
    unfold Module.additive
    unfold Ring.additive
    simp [Module.mk.carrier, Module.mk.add, Module.mk.zero, Module.mk.neg]
  unfold spaceTopology
  rw [addEq, ← complexAdditiveGroup.ring_additive]
  unfold complexSpace
  rfl

-- Over ℝ or ℂ a continuous linear map ℂ → ℂ is multiplication by f(1).
theorem ContinuousLinearMap.complex_self (f : Set)
  requires linear : IsLinearMap(f, complexSelfModule, complexSelfModule, complexRing)
  shows ∀ z ∈ complexCarrier, f(z) = complexMul(z, f(complexOne))
proof
  obtain ⟨modV, modW, fn, addLaw, smulLaw⟩ := linear
  have comm := complexRing.comm_ring
  have ring := comm.left
  have carEq : Module.carrier(complexSelfModule) = Ring.carrier(complexRing)
    unfold complexSelfModule
    unfold selfModule
    simp [Module.mk.carrier]
  have smulEq : Module.smul(complexSelfModule) = Ring.mul(complexRing)
    unfold complexSelfModule
    unfold selfModule
    simp [Module.mk.smul]
  rw [carEq, smulEq] at smulLaw
  have oneIn := Ring.one_mem at complexRing with ring
  intros z hz
  have zIn : z ∈ Ring.carrier(complexRing)
    rw complexRing.carrierOf
    exact hz
  have law := smulLaw with z, zIn, Ring.one(complexRing), oneIn
  have e : Ring.mul(complexRing)(z, Ring.one(complexRing)) = z by ring
  rw e at law
  rw [complexRing.mulOf, complexRing.oneOf] at law
  exact law

end NormedSpaces
