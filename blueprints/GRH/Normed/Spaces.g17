-- Normed and Banach spaces over a normed field: modules with a norm
-- compatible with the action; linear and continuous linear maps, the
-- bound that makes a linear map continuous, the operator norm and its
-- laws, composition; finite-dimensional spaces over ℝ and ℂ, where every
-- linear map is continuous, the space is complete, closed balls are
-- compact, and all norms are equivalent; ℝ and ℂ as normed spaces.
-- Part of the GRH blueprint.
-- Planned home: Analysis/Normed/Space.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Normed.Spaces
import GRH.Normed.Groups

section NormedSpaces
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Section: Definitions
-- A normed space over the normed field (K, |·|): a K-module whose additive
-- group carries a norm with ‖c • v‖ = |c| ‖v‖ (Mathlib's NormedSpace over
-- a NormedField). The module is Cumulus's bundled Module(V, K).
predicate NormedSpace (V K absK norm : Set) :=
  NormedField(K, absK) ∧ Module(V, K) ∧
  NormedGroup(Module.additive(V), norm) ∧
  (∀ c ∈ Ring.carrier(K), ∀ v ∈ Module.carrier(V),
    norm(Module.smul(V)(c, v)) = R[absK(c) * norm(v)])

-- The metric space and the topology of a normed space.
def spaceMetric (V norm : Set) : Set := normMetric(Module.additive(V), norm)
def spaceTopology (V norm : Set) : Set := normTopology(Module.additive(V), norm)

-- A Banach space is a complete normed space.
predicate BanachSpace (V K absK norm : Set) :=
  NormedSpace(V, K, absK, norm) ∧ Complete(spaceMetric(V, norm))

-- A K-linear map between K-modules, read on the carrier of V (a local
-- form, to be identified with layer 2 track A's linear maps).
predicate IsLinearMap (f V W K : Set) :=
  Module(V, K) ∧ Module(W, K) ∧
  (f : Module.carrier(V) → Module.carrier(W)) ∧
  (∀ v ∈ Module.carrier(V), ∀ w ∈ Module.carrier(V),
    f(Module.add(V)(v, w)) = Module.add(W)(f(v), f(w))) ∧
  (∀ c ∈ Ring.carrier(K), ∀ v ∈ Module.carrier(V),
    f(Module.smul(V)(c, v)) = Module.smul(W)(c, f(v)))

-- A continuous linear map between normed spaces (Mathlib's
-- ContinuousLinearMap, E →L[𝕜] F).
predicate ContinuousLinearMap (f V normV W normW K : Set) :=
  IsLinearMap(f, V, W, K) ∧
  f : spaceTopology(V, normV) ⇒ spaceTopology(W, normW)

-- ‖f(v)‖ ≤ C ‖v‖ for every v.
predicate LinearBound (f V normV normW C : Set) :=
  C ∈ ℝ ∧ realZero ≤ C ∧
  (∀ v ∈ Module.carrier(V), normW(f(v)) ≤ R[C * normV(v)])

-- The bounds of f, as a set of reals.
def linearBoundSet (f V normV normW : Set) : Set :=
  { D ∈ ℝ | LinearBound(f, V, normV, normW, D) }

-- The operator norm: the least bound (Mathlib's ContinuousLinearMap.opNorm).
defunique opNorm (f V normV normW : Set) (C ∈ ℝ) :=
  LinearBound(f, V, normV, normW, C) ∧
  (∀ D, LinearBound(f, V, normV, normW, D) → C ≤ D)
requires bounded : ∃ C, LinearBound(f, V, normV, normW, C)
requires real : ∀ v ∈ Module.carrier(V), normV(v) ∈ ℝ ∧ normW(f(v)) ∈ ℝ
proof
  obtain ⟨C0, lb0⟩ := bounded
  have lb0b := lb0
  obtain ⟨C0In, C0Nn, C0Bound⟩ := lb0b
  have sub : linearBoundSet(f, V, normV, normW) ⊆ ℝ
    intros x hx
    exact (linearBoundSet.membership.forward with hx).left
  have C0Mem : C0 ∈ linearBoundSet(f, V, normV, normW)
    apply linearBoundSet.membership.backward
    exact ⟨C0In, lb0⟩
  have ne : Nonempty(linearBoundSet(f, V, normV, normW))
    unfold Nonempty
    exact ⟨C0, C0Mem⟩
  have zeroIn : (0:R) ∈ ℝ by typecheck
  have zeroLower : ∀ x ∈ linearBoundSet(f, V, normV, normW), (0:R) ≤ x
    intros x hx
    have hx2 := linearBoundSet.membership.forward with hx
    obtain ⟨xIn, xIn2, xNn, xBound⟩ := hx2
    exact xNn
  obtain ⟨U, UIn, lower, greatest⟩ := Real.inf_exists with sub, ne, ⟨(0:R), zeroIn, zeroLower⟩
  have UR : Real(U) by exact UIn
  have UNn := greatest with (0:R), zeroIn, zeroLower
  have C0R : Real(C0) by exact C0In
  have UC0 := lower with C0, C0Mem
  refine ⟨U, UIn, ?_, ?_⟩
  . unfold LinearBound
    refine ⟨UIn, UNn, ?_⟩
    intros v hv
    obtain ⟨nIn, wIn⟩ := real with v, hv
    have nR : Real(normV(v)) by exact nIn
    have wR : Real(normW(f(v))) by exact wIn
    by_cases pos : (0:R) < normV(v)
    . have nNe : normV(v) ≠ (0:R)
        intro e0
        rw e0 at pos
        linarith
      have qMul := realDiv.mul_right at normW(f(v)), normV(v) with nNe
      have qIn : normW(f(v)) / normV(v) ∈ ℝ by typecheck
      have qR : Real(normW(f(v)) / normV(v)) by exact qIn
      have qLower : ∀ x ∈ linearBoundSet(f, V, normV, normW), normW(f(v)) / normV(v) ≤ x
        intros x hx
        have hx2 := linearBoundSet.membership.forward with hx
        obtain ⟨xIn, xIn2, xNn, xBound⟩ := hx2
        have xR : Real(x) by exact xIn
        have b := xBound with v, hv
        rw ← qMul at b
        exact realLe.mul_right_cancel_positive at normW(f(v)) / normV(v), x, normV(v) with pos, b
      have qU := greatest with normW(f(v)) / normV(v), qIn, qLower
      have nNn : (0:R) ≤ normV(v) by linarith
      have m := realLe.mul_right_of_nonnegative at normW(f(v)) / normV(v), U, normV(v) with qU, nNn
      rw qMul at m
      exact m
    . have b := C0Bound with v, hv
      have nNp : (0:R) ≤ (0:R) - normV(v) by linarith
      have dNn : (0:R) ≤ C0 - U by linarith
      have m := realLe.mul_left_of_nonnegative at (0:R), (0:R) - normV(v), C0 - U with nNp, dNn
      have ex : (C0 - U) * ((0:R) - normV(v)) = U * normV(v) - C0 * normV(v) by ring
      have ez : (C0 - U) * (0:R) = (0:R) by ring
      rw [ex, ez] at m
      linarith
  . intros D lbD
    have lbD2 := lbD
    obtain ⟨DIn, DNn, DBound⟩ := lbD2
    have DMem : D ∈ linearBoundSet(f, V, normV, normW)
      apply linearBoundSet.membership.backward
      exact ⟨DIn, lbD⟩
    exact lower with D, DMem
uniqueness
  intros C1 C1In p1 C2 C2In p2
  obtain ⟨lb1, min1⟩ := p1
  obtain ⟨lb2, min2⟩ := p2
  have le12 := min1 with C2, lb2
  have le21 := min2 with C1, lb1
  have r1 : Real(C1) by exact C1In
  have r2 : Real(C2) by exact C2In
  linarith

-- A finite family b(0), …, b(n − 1) spans V over K when every vector is a
-- linear combination of it; V is finite-dimensional when some finite
-- family spans it (local forms, to be identified with track A's span and
-- finrank).
predicate SpansModule (V K b : Set, n : Nat) :=
  Module(V, K) ∧ (∀ i ∈ n, b(i) ∈ Module.carrier(V)) ∧
  (∀ v ∈ Module.carrier(V), ∃ c, ∃ w,
    (∀ i ∈ n, c(i) ∈ Ring.carrier(K) ∧ w(i) = Module.smul(V)(c(i), b(i))) ∧
    v = groupFiniteSum(Module.additive(V), n, w))
predicate FiniteDimensionalModule (V K : Set) :=
  ∃ n ∈ ℕ, ∃ b, SpansModule(V, K, b, n)

-- Two norms are equivalent when each is bounded by a multiple of the other.
predicate EquivalentNorms (V norm1 norm2 : Set) :=
  ∃ A ∈ ℝ, ∃ B ∈ ℝ, realZero < A ∧ realZero < B ∧
    (∀ v ∈ Module.carrier(V), norm1(v) ≤ R[A * norm2(v)]) ∧
    (∀ v ∈ Module.carrier(V), norm2(v) ≤ R[B * norm1(v)])

-- ℝ and ℂ as modules over themselves, and ℂ as a real module.
def realSelfModule : Set := selfModule(realRing)
def complexSelfModule : Set := selfModule(complexRing)

-- Section: Laws of normed spaces
section NormedSpaceLaws
variable (V K absK norm : Set)
hypothesis normed : NormedSpace(V, K, absK, norm)

theorem NormedSpace.smul (c v : Set)
  requires scalar : c ∈ K.carrier
  requires member : v ∈ V.carrier
  shows norm(V.smul(c, v)) = R[absK(c) * norm(v)]
proof
  obtain ⟨nf, mod, ng, law⟩ := normed
  exact law with c, scalar, v, member

theorem NormedSpace.topological_module
  shows TopologicalModule(V, K, normTopology(Ring.additive(K), absK),
    spaceTopology(V, norm))
proof
  sorry

-- The unit sphere scaling: every nonzero vector is a multiple of a vector
-- of norm 1 when K is ℝ or ℂ-like (Mathlib's rescale_to_shell, the form
-- the source uses): for ‖c‖ > 1 and ε > 0, every v ≠ 0 has a multiple
-- c^k v with ε/‖c‖ ≤ ‖c^k v‖ < ε.
theorem NormedSpace.rescale_to_shell (c v : Set, e : Real)
  requires scalar : c ∈ K.carrier
  requires large : realOne < absK(c)
  requires positive : realZero < e
  requires member : v ∈ V.carrier
  requires nonzero : v ≠ V.zero
  shows ∃ d ∈ K.carrier, d ≠ K.zero ∧
    R[e / absK(c)] ≤ norm(V.smul(d, v)) ∧ norm(V.smul(d, v)) < e
proof
  sorry

end NormedSpaceLaws

-- Section: Linear maps
-- A linear map is a homomorphism of the additive groups.
theorem IsLinearMap.additive_hom (f V W K : Set)
  requires linear : IsLinearMap(f, V, W, K)
  shows f : Module.additive(V) →* Module.additive(W)
proof
  obtain ⟨modV, modW, fn, addLaw, smulLaw⟩ := linear
  have abelianV := Module.additive.abelian_group at V, K with modV
  have abelianW := Module.additive.abelian_group at W, K with modW
  have groupV := AbelianGroup.to_group with abelianV
  have groupW := AbelianGroup.to_group with abelianW
  have fn2 : f : Group.carrier(Module.additive(V)) → Group.carrier(Module.additive(W))
    rw [Module.additive.carrier, Module.additive.carrier]
    exact fn
  apply GroupHom.mk with groupV, groupW, fn2
  intros x hx y hy
  rw Module.additive.carrier at hx
  rw Module.additive.carrier at hy
  rw [Module.additive.mul, Module.additive.mul]
  exact addLaw with x, hx, y, hy

theorem IsLinearMap.map_zero (f V W K : Set)
  requires linear : IsLinearMap(f, V, W, K)
  shows f(Module.zero(V)) = Module.zero(W)
proof
  have hom := IsLinearMap.additive_hom with linear
  have one := GroupHom.map_one at f, Module.additive(V), Module.additive(W) with hom
  rw [Module.additive.one, Module.additive.one] at one
  exact one

theorem IsLinearMap.map_neg (f V W K v : Set)
  requires linear : IsLinearMap(f, V, W, K)
  requires member : v ∈ Module.carrier(V)
  shows f(Module.neg(V)(v)) = Module.neg(W)(f(v))
proof
  have hom := IsLinearMap.additive_hom with linear
  have m2 : v ∈ Group.carrier(Module.additive(V))
    rw Module.additive.carrier
    exact member
  have inv := GroupHom.map_inv at f, Module.additive(V), Module.additive(W), v with hom, m2
  rw [Module.additive.inv, Module.additive.inv] at inv
  exact inv

theorem IsLinearMap.map_sum (f V W K w u : Set, n : Nat)
  requires linear : IsLinearMap(f, V, W, K)
  requires values : ∀ i ∈ n, w(i) ∈ Module.carrier(V)
  requires composite : ∀ i ∈ n, u(i) = f(w(i))
  shows f(groupFiniteSum(Module.additive(V), n, w)) =
    groupFiniteSum(Module.additive(W), n, u)
proof
  obtain ⟨modV, modW, fn, addLaw, smulLaw⟩ := linear
  have abelianV := Module.additive.abelian_group at V, K with modV
  have abelianW := Module.additive.abelian_group at W, K with modW
  have groupV := AbelianGroup.to_group with abelianV
  have groupW := AbelianGroup.to_group with abelianW
  have fn2 : f : Group.carrier(Module.additive(V)) → Group.carrier(Module.additive(W))
    rw [Module.additive.carrier, Module.additive.carrier]
    exact fn
  have hom : f : Module.additive(V) →* Module.additive(W)
    apply GroupHom.mk with groupV, groupW, fn2
    intros x hx y hy
    rw Module.additive.carrier at hx
    rw Module.additive.carrier at hy
    rw [Module.additive.mul, Module.additive.mul]
    exact addLaw with x, hx, y, hy
  have values2 : ∀ i ∈ n, w(i) ∈ Group.carrier(Module.additive(V))
    rw Module.additive.carrier
    exact values
  exact groupFiniteSum.hom at f, Module.additive(V), Module.additive(W), n, w, u with abelianV, abelianW, hom, (Finite.natural at n), values2, composite

-- The carrier of the topology of a normed space is the module's carrier.
theorem spaceTopology.carrier_eq (V norm : Set)
  shows TopologicalSpace.carrier(spaceTopology(V, norm)) = Module.carrier(V)
proof
  unfold spaceTopology
  unfold normTopology
  rw metricTopology.carrier
  have m : MetricSpace.carrier(normMetric(Module.additive(V), norm)) =
      Group.carrier(Module.additive(V))
    unfold normMetric
    metric_projections
  rw [m, Module.additive.carrier]

-- Mathlib's ContinuousLinearMap.comp: composites of continuous linear maps
-- are continuous linear.
theorem ContinuousLinearMap.comp (f g h U normU V normV W normW K : Set)
  requires first : ContinuousLinearMap(f, U, normU, V, normV, K)
  requires second : ContinuousLinearMap(g, V, normV, W, normW, K)
  requires function : h : Module.carrier(U) → Module.carrier(W)
  requires composite : ∀ u ∈ Module.carrier(U), h(u) = g(f(u))
  shows ContinuousLinearMap(h, U, normU, W, normW, K)
proof
  obtain ⟨linF, contF⟩ := first
  obtain ⟨linG, contG⟩ := second
  obtain ⟨modU, modV, fnF, addF, smulF⟩ := linF
  obtain ⟨modV2, modW, fnG, addG, smulG⟩ := linG
  have cc := Continuous.comp with contF, contG
  rw [spaceTopology.carrier_eq, spaceTopology.carrier_eq, spaceTopology.carrier_eq] at cc
  have fnC := compose.function at g, f, Module.carrier(U), Module.carrier(V), Module.carrier(W) with fnF, fnG
  have same : h = compose(g, f, Module.carrier(U), Module.carrier(V), Module.carrier(W))
    apply FunctionBetween.ext with function, fnC
    intros u hu
    have a := compose.apply at g, f, Module.carrier(U), Module.carrier(V), Module.carrier(W), u with fnF, fnG, hu
    have c1 := composite with u, hu
    rw [a, c1]
  unfold ContinuousLinearMap
  refine ⟨?_, ?_⟩
  . unfold IsLinearMap
    refine ⟨modU, modW, function, ?_, ?_⟩
    . intros v hv w hw
      have vw := Module.add_mem at K, U, v, w with *
      have fv := FunctionBetween.apply_closed with fnF, hv
      have fw := FunctionBetween.apply_closed with fnF, hw
      have c1 := composite with Module.add(U)(v, w), vw
      have c2 := composite with v, hv
      have c3 := composite with w, hw
      have a1 := addF with v, hv, w, hw
      rw [c1, c2, c3, a1]
      exact addG with f(v), fv, f(w), fw
    . intros c hc v hv
      have cv := Module.smul_mem at K, U, c, v with *
      have fv := FunctionBetween.apply_closed with fnF, hv
      have c1 := composite with Module.smul(U)(c, v), cv
      have c2 := composite with v, hv
      have a1 := smulF with c, hc, v, hv
      rw [c1, c2, a1]
      exact smulG with c, hc, f(v), fv
  . rw same
    exact cc

theorem ContinuousLinearMap.identity (V K absK norm : Set)
  requires normed : NormedSpace(V, K, absK, norm)
  shows ContinuousLinearMap(identity(Module.carrier(V)), V, norm, V, norm, K)
proof
  have n2 := normed
  obtain ⟨nf, module, ng, law⟩ := n2
  have ring := nf.right.right.left.left
  have space := normTopology.space at Module.additive(V), norm with ng
  have carrier := normTopology.carrier at Module.additive(V), norm with ng
  rw Module.additive.carrier at carrier
  have cont := Continuous.id at normTopology(Module.additive(V), norm) with space
  rw carrier at cont
  unfold ContinuousLinearMap
  refine ⟨?_, ?_⟩
  . unfold IsLinearMap
    refine ⟨module, module, (identity.function at Module.carrier(V)), ?_, ?_⟩
    . intros v hv w hw
      have vw := Module.add_mem at K, V, v, w with *
      have a1 := identity.apply at Module.add(V)(v, w), Module.carrier(V) with vw
      have a2 := identity.apply at v, Module.carrier(V) with hv
      have a3 := identity.apply at w, Module.carrier(V) with hw
      rw [a1, a2, a3]
    . intros c hc v hv
      have cv := Module.smul_mem at K, V, c, v with *
      have a1 := identity.apply at Module.smul(V)(c, v), Module.carrier(V) with cv
      have a2 := identity.apply at v, Module.carrier(V) with hv
      rw [a1, a2]
  . unfold spaceTopology
    exact cont

-- A linear map between normed spaces is continuous exactly when it is
-- bounded.
theorem ContinuousLinearMap.iff_bounded (f V K absK normV W normW : Set)
  requires normedV : NormedSpace(V, K, absK, normV)
  requires normedW : NormedSpace(W, K, absK, normW)
  requires linear : IsLinearMap(f, V, W, K)
  shows ContinuousLinearMap(f, V, normV, W, normW, K) ↔
    (∃ C, LinearBound(f, V, normV, normW, C))
proof
  sorry

-- A linear map continuous at 0 is continuous.
theorem ContinuousLinearMap.of_continuous_at_zero (f V K absK normV W normW : Set)
  requires normedV : NormedSpace(V, K, absK, normV)
  requires normedW : NormedSpace(W, K, absK, normW)
  requires linear : IsLinearMap(f, V, W, K)
  requires atZero : ContinuousAtPoint(f, spaceTopology(V, normV),
    spaceTopology(W, normW), Module.zero(V))
  shows ContinuousLinearMap(f, V, normV, W, normW, K)
proof
  sorry

-- The norms read by the operator norm are real.
theorem opNorm.real_values (f V K absK normV W normW : Set)
  requires normedV : NormedSpace(V, K, absK, normV)
  requires normedW : NormedSpace(W, K, absK, normW)
  requires linear : IsLinearMap(f, V, W, K)
  shows ∀ v ∈ Module.carrier(V), normV(v) ∈ ℝ ∧ normW(f(v)) ∈ ℝ
proof
  obtain ⟨nfV, modV, ngV, lawV⟩ := normedV
  obtain ⟨nfW, modW, ngW, lawW⟩ := normedW
  obtain ⟨abelianV, isNormV⟩ := ngV
  obtain ⟨normFV, restV⟩ := isNormV
  obtain ⟨abelianW, isNormW⟩ := ngW
  obtain ⟨normFW, restW⟩ := isNormW
  obtain ⟨modV2, modW2, fn, addLaw, smulLaw⟩ := linear
  intros v hv
  have fv := FunctionBetween.apply_closed with fn, hv
  have vA : v ∈ Group.carrier(Module.additive(V))
    rw Module.additive.carrier
    exact hv
  have fvA : f(v) ∈ Group.carrier(Module.additive(W))
    rw Module.additive.carrier
    exact fv
  have a := FunctionBetween.apply_closed with normFV, vA
  have b := FunctionBetween.apply_closed with normFW, fvA
  exact ⟨a, b⟩

-- Section: The operator norm
section OperatorNorm
variable (f V K absK normV W normW : Set)
hypothesis normedV : NormedSpace(V, K, absK, normV)
hypothesis normedW : NormedSpace(W, K, absK, normW)
hypothesis continuous : ContinuousLinearMap(f, V, normV, W, normW, K)

theorem opNorm.bound
  shows LinearBound(f, V, normV, normW, opNorm(f, V, normV, normW))
proof
  sorry

theorem opNorm.nonneg
  shows realZero ≤ opNorm(f, V, normV, normW)
proof
  sorry

-- Mathlib's le_opNorm: ‖f v‖ ≤ ‖f‖ ‖v‖.
theorem opNorm.le (v : Set)
  requires member : v ∈ Module.carrier(V)
  shows normW(f(v)) ≤ R[opNorm(f, V, normV, normW) * normV(v)]
proof
  sorry

-- Mathlib's opNorm_le_bound.
theorem opNorm.le_bound (C : Real)
  requires nonneg : realZero ≤ C
  requires bound : ∀ v ∈ Module.carrier(V), normW(f(v)) ≤ R[C * normV(v)]
  shows opNorm(f, V, normV, normW) ≤ C
proof
  have lin := continuous.left
  have real := opNorm.real_values with normedV, normedW, lin
  have CIn : C ∈ ℝ by typecheck
  have lb : LinearBound(f, V, normV, normW, C)
    unfold LinearBound
    exact ⟨CIn, nonneg, bound⟩
  have sel := opNorm.selected at f, V, normV, normW with ⟨C, lb⟩, real
  obtain ⟨mem, prop⟩ := sel
  obtain ⟨lbO, least⟩ := prop
  exact least with C, lb

theorem opNorm.eq_zero_iff
  shows opNorm(f, V, normV, normW) = realZero ↔
    (∀ v ∈ Module.carrier(V), f(v) = Module.zero(W))
proof
  sorry

-- On a nonzero space, ‖f‖ is the supremum of ‖f v‖ over the unit ball:
-- every number below ‖f‖ is exceeded by some ‖f v‖ with ‖v‖ ≤ 1.
theorem opNorm.approx (B : Real)
  requires below : B < opNorm(f, V, normV, normW)
  shows ∃ v ∈ Module.carrier(V), normV(v) ≤ realOne ∧ B < normW(f(v))
proof
  sorry

end OperatorNorm

-- Mathlib's opNorm_comp_le: ‖g ∘ f‖ ≤ ‖g‖ ‖f‖.
theorem opNorm.comp_le (f g h U K absK normU V normV W normW : Set)
  requires normedU : NormedSpace(U, K, absK, normU)
  requires normedV : NormedSpace(V, K, absK, normV)
  requires normedW : NormedSpace(W, K, absK, normW)
  requires first : ContinuousLinearMap(f, U, normU, V, normV, K)
  requires second : ContinuousLinearMap(g, V, normV, W, normW, K)
  requires function : h : Module.carrier(U) → Module.carrier(W)
  requires composite : ∀ u ∈ Module.carrier(U), h(u) = g(f(u))
  shows opNorm(h, U, normU, normW) ≤
    R[opNorm(g, V, normV, normW) * opNorm(f, U, normU, normV)]
proof
  sorry

-- Mathlib's opNorm_add_le: ‖f + g‖ ≤ ‖f‖ + ‖g‖.
theorem opNorm.add_le (f g h V K absK normV W normW : Set)
  requires normedV : NormedSpace(V, K, absK, normV)
  requires normedW : NormedSpace(W, K, absK, normW)
  requires first : ContinuousLinearMap(f, V, normV, W, normW, K)
  requires second : ContinuousLinearMap(g, V, normV, W, normW, K)
  requires sum : ∀ v ∈ Module.carrier(V), h(v) = Module.add(W)(f(v), g(v))
  requires function : h : Module.carrier(V) → Module.carrier(W)
  shows ContinuousLinearMap(h, V, normV, W, normW, K) ∧
    opNorm(h, V, normV, normW) ≤
      R[opNorm(f, V, normV, normW) + opNorm(g, V, normV, normW)]
proof
  sorry

-- Mathlib's opNorm_smul: ‖c f‖ = |c| ‖f‖.
theorem opNorm.smul (f h c V K absK normV W normW : Set)
  requires normedV : NormedSpace(V, K, absK, normV)
  requires normedW : NormedSpace(W, K, absK, normW)
  requires commutative : CommRing(K)
  requires continuous : ContinuousLinearMap(f, V, normV, W, normW, K)
  requires scalar : c ∈ Ring.carrier(K)
  requires function : h : Module.carrier(V) → Module.carrier(W)
  requires scaled : ∀ v ∈ Module.carrier(V), h(v) = Module.smul(W)(c, f(v))
  shows ContinuousLinearMap(h, V, normV, W, normW, K) ∧
    opNorm(h, V, normV, normW) = R[absK(c) * opNorm(f, V, normV, normW)]
proof
  sorry

theorem opNorm.identity_le (V K absK norm : Set)
  requires normed : NormedSpace(V, K, absK, norm)
  shows opNorm(identity(Module.carrier(V)), V, norm, norm) ≤ realOne
proof
  have clm := ContinuousLinearMap.identity at V, K, absK, norm with normed
  have lin := clm.left
  have real := opNorm.real_values with normed, normed, lin
  have oneIn : (1:R) ∈ ℝ by typecheck
  have oneNn : (0:R) ≤ (1:R) by linarith
  have lb : LinearBound(identity(Module.carrier(V)), V, norm, norm, (1:R))
    unfold LinearBound
    refine ⟨oneIn, oneNn, ?_⟩
    intros v hv
    have a := identity.apply at v, Module.carrier(V) with hv
    rw a
    have nR := (real with v, hv).left
    have nRR : Real(norm(v)) by exact nR
    have e : (1:R) * norm(v) = norm(v) by ring
    rw e
    linarith
  have sel := opNorm.selected at identity(Module.carrier(V)), V, norm, norm with ⟨(1:R), lb⟩, real
  obtain ⟨mem, prop⟩ := sel
  obtain ⟨lbO, least⟩ := prop
  exact least with (1:R), lb

-- Uniform boundedness for sequences of operators converging pointwise is
-- not needed; continuous linear maps into a Banach space from a dense
-- subspace extend uniquely (Mathlib's ContinuousLinearMap.extend), stated
-- as uniqueness: two continuous linear maps agreeing on a dense set agree.
theorem ContinuousLinearMap.eq_of_dense (f g D V K absK normV W normW : Set)
  requires normedV : NormedSpace(V, K, absK, normV)
  requires normedW : NormedSpace(W, K, absK, normW)
  requires first : ContinuousLinearMap(f, V, normV, W, normW, K)
  requires second : ContinuousLinearMap(g, V, normV, W, normW, K)
  requires dense : Dense(spaceTopology(V, normV), D)
  requires agree : ∀ v ∈ D, f(v) = g(v)
  shows ∀ v ∈ Module.carrier(V), f(v) = g(v)
proof
  sorry

-- Section: Finite-dimensional spaces over ℝ and ℂ
-- The scalar field is ℝ with |·| or ℂ with its modulus.
predicate RealOrComplexScalars (K absK : Set) :=
  (K = realRing ∧ absK = realAbs) ∨ (K = complexRing ∧ absK = complexAbs)

theorem FiniteDimensional.norms_equivalent (V K absK norm1 norm2 : Set)
  requires scalars : RealOrComplexScalars(K, absK)
  requires first : NormedSpace(V, K, absK, norm1)
  requires second : NormedSpace(V, K, absK, norm2)
  requires finite : FiniteDimensionalModule(V, K)
  shows EquivalentNorms(V, norm1, norm2)
proof
  sorry

theorem FiniteDimensional.complete (V K absK norm : Set)
  requires scalars : RealOrComplexScalars(K, absK)
  requires normed : NormedSpace(V, K, absK, norm)
  requires finite : FiniteDimensionalModule(V, K)
  shows BanachSpace(V, K, absK, norm)
proof
  sorry

-- Mathlib's LinearMap.continuous_of_finiteDimensional.
theorem FiniteDimensional.linear_continuous (f V K absK normV W normW : Set)
  requires scalars : RealOrComplexScalars(K, absK)
  requires normedV : NormedSpace(V, K, absK, normV)
  requires normedW : NormedSpace(W, K, absK, normW)
  requires finite : FiniteDimensionalModule(V, K)
  requires linear : IsLinearMap(f, V, W, K)
  shows ContinuousLinearMap(f, V, normV, W, normW, K)
proof
  sorry

-- Mathlib's isCompact_closedBall in a finite-dimensional space (a proper
-- space), and Heine–Borel.
theorem FiniteDimensional.closed_ball_compact (V K absK norm v : Set, r : Real)
  requires scalars : RealOrComplexScalars(K, absK)
  requires normed : NormedSpace(V, K, absK, norm)
  requires finite : FiniteDimensionalModule(V, K)
  requires member : v ∈ Module.carrier(V)
  shows Compact(spaceTopology(V, norm), closedBall(spaceMetric(V, norm), v, r))
proof
  sorry

theorem FiniteDimensional.compact_iff (V K absK norm A : Set)
  requires scalars : RealOrComplexScalars(K, absK)
  requires normed : NormedSpace(V, K, absK, norm)
  requires finite : FiniteDimensionalModule(V, K)
  requires inside : A ⊆ Module.carrier(V)
  shows Compact(spaceTopology(V, norm), A) ↔
    Closed(spaceTopology(V, norm), A) ∧ Bounded(spaceMetric(V, norm), A)
proof
  sorry

theorem FiniteDimensional.locally_compact (V K absK norm : Set)
  requires scalars : RealOrComplexScalars(K, absK)
  requires normed : NormedSpace(V, K, absK, norm)
  requires finite : FiniteDimensionalModule(V, K)
  shows LocallyCompact(spaceTopology(V, norm))
proof
  sorry

-- A finite-dimensional subspace of a normed space is closed.
theorem FiniteDimensional.subspace_closed (V K absK norm S b : Set, n : Nat)
  requires scalars : RealOrComplexScalars(K, absK)
  requires normed : NormedSpace(V, K, absK, norm)
  requires spanning : ∀ i ∈ n, b(i) ∈ S
  requires inside : S ⊆ Module.carrier(V)
  requires span : ∀ v ∈ S, ∃ c, ∃ w,
    (∀ i ∈ n, c(i) ∈ Ring.carrier(K) ∧ w(i) = Module.smul(V)(c(i), b(i))) ∧
    v = groupFiniteSum(Module.additive(V), n, w)
  requires closedUnder : ∀ c, ∀ w,
    (∀ i ∈ n, c(i) ∈ Ring.carrier(K) ∧ w(i) = Module.smul(V)(c(i), b(i))) →
    groupFiniteSum(Module.additive(V), n, w) ∈ S
  shows Closed(spaceTopology(V, norm), S)
proof
  sorry

-- Section: ℝ and ℂ as normed spaces
theorem NormedSpace.real_self
  shows NormedSpace(realSelfModule, realRing, realAbs, realAbs)
proof
  have ntf := NormedField.real
  have nf := ntf.left
  have nf2 := nf
  obtain ⟨field, comm, nr, mulEq, oneEq⟩ := nf2
  obtain ⟨ring, ng, sub⟩ := nr
  have module := Ring.to_module at realRing with ring
  have addEq : Module.additive(realSelfModule) = Ring.additive(realRing)
    unfold realSelfModule
    unfold selfModule
    unfold Module.additive
    unfold Ring.additive
    simp [Module.mk.carrier, Module.mk.add, Module.mk.zero, Module.mk.neg]
  have smulEq : Module.smul(realSelfModule) = Ring.mul(realRing)
    unfold realSelfModule
    unfold selfModule
    simp [Module.mk.smul]
  have carEq : Module.carrier(realSelfModule) = Ring.carrier(realRing)
    unfold realSelfModule
    unfold selfModule
    simp [Module.mk.carrier]
  unfold NormedSpace
  refine ⟨nf, ?_, ?_, ?_⟩
  . unfold realSelfModule
    exact module
  . rw addEq
    exact ng
  . rw [carEq, smulEq]
    exact mulEq

theorem NormedSpace.complex_self
  shows NormedSpace(complexSelfModule, complexRing, complexAbs, complexAbs)
proof
  have ntf := NormedField.complex
  have nf := ntf.left
  have nf2 := nf
  obtain ⟨field, comm, nr, mulEq, oneEq⟩ := nf2
  obtain ⟨ring, ng, sub⟩ := nr
  have module := Ring.to_module at complexRing with ring
  have addEq : Module.additive(complexSelfModule) = Ring.additive(complexRing)
    unfold complexSelfModule
    unfold selfModule
    unfold Module.additive
    unfold Ring.additive
    simp [Module.mk.carrier, Module.mk.add, Module.mk.zero, Module.mk.neg]
  have smulEq : Module.smul(complexSelfModule) = Ring.mul(complexRing)
    unfold complexSelfModule
    unfold selfModule
    simp [Module.mk.smul]
  have carEq : Module.carrier(complexSelfModule) = Ring.carrier(complexRing)
    unfold complexSelfModule
    unfold selfModule
    simp [Module.mk.carrier]
  unfold NormedSpace
  refine ⟨nf, ?_, ?_, ?_⟩
  . unfold complexSelfModule
    exact module
  . rw addEq
    exact ng
  . rw [carEq, smulEq]
    exact mulEq

theorem FiniteDimensional.real_self
  shows FiniteDimensionalModule(realSelfModule, realRing)
proof
  sorry

theorem FiniteDimensional.complex_self
  shows FiniteDimensionalModule(complexSelfModule, complexRing)
proof
  sorry

theorem spaceTopology.real_self
  shows spaceTopology(realSelfModule, realAbs) = realLine
proof
  sorry

theorem spaceTopology.complex_self
  shows spaceTopology(complexSelfModule, complexAbs) = complexSpace
proof
  sorry

-- Over ℝ or ℂ a continuous linear map ℂ → ℂ is multiplication by f(1).
theorem ContinuousLinearMap.complex_self (f : Set)
  requires linear : IsLinearMap(f, complexSelfModule, complexSelfModule, complexRing)
  shows ∀ z ∈ complexCarrier, f(z) = complexMul(z, f(complexOne))
proof
  sorry

end NormedSpaces
