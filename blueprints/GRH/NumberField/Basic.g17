-- Number fields: the rings ℤ and ℚ as bundled rings and their canonical
-- maps into a ring (Int.cast, Rat.cast), fields of characteristic zero,
-- number fields as fields finite-dimensional over ℚ (Mathlib's
-- NumberField), the degree, the ring of integers 𝓞 K as the integral
-- closure of ℤ (NumberField.RingOfIntegers) with its rank, integral bases,
-- and fraction field, and the norm and trace of a finite free algebra
-- (Algebra.norm, Algebra.trace) with their laws, specialised to K/ℚ and to
-- 𝓞 K over ℤ.
-- Part of the GRH blueprint.
-- Planned home: NumberTheory/NumberField/Basic (ℤ, ℚ as rings: Int/Ring,
-- Rat/Field; the trace: LinearAlgebra; norm and trace: Algebra/Norm).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.NumberField.Basic
import GRH.Algebra.DVR
import GRH.Cyclotomy.Fields
import Grace.Cumulus.Rat.Operations

-- Section: ℤ and ℚ as rings, and their canonical maps
-- The integers and the rationals as bundled rings, on Cumulus's ℤ and ℚ
-- with their operation graphs (Int.instCommRing, Rat.instField).
-- Cross-module request: these belong beside Cumulus's Int/Ring and Rat;
-- track F (cyclotomic fields) needs the same objects.
-- The canonical map ℤ → R (Int.castRingHom): the class of (a, b), that is
-- the integer a − b, goes to a · 1 − b · 1. That this graph is a function
-- (independence of the representative) is a theorem.
def intCastMap (R : Set) : Set :=
  { p ∈ ℤ × Ring.carrier(R) | ∃ a ∈ ℕ, ∃ b ∈ ℕ,
    p = (integerClass(a, b), Ring.sub(R, natCast(R, a), natCast(R, b))) }

-- Helper: m − k written as a sum of integers is the class (m, k).
theorem tkF.integerClass.as_sum (m k : Nat)
  shows integerAddValue(integerOfNat(m), integerNegValue(integerOfNat(k))) =
    integerClass(m, k)
proof
  unfold integerOfNat
  rw integerNegValue.classes
  unfold integerClassNeg
  rw integerAddValue.classes
  unfold integerClassSum
  have e : add(add(m, 0), k) = add(m, add(0, k)) by arith
  exact integerClass.eq at add(m, 0), add(0, k), m, k with e


-- It is Cyclotomy.RootsOfUnity's intCastHom, written with integer classes.
theorem intCastMap.eq_int_cast_hom (R : Set)
  requires ring : Ring(R)
  shows intCastMap(R) = intCastHom(R)
proof
  ext p
  constructor
  . intro hp
    unfold intCastMap at hp
    obtain ⟨pin, a, aN, b, bN, pEq⟩ := hp
    have aNat := natural.member at a with aN
    have bNat := natural.member at b with bN
    have cl := tkF.integerClass.as_sum at a, b
    unfold intCastHom
    refine ⟨pin, a, aN, b, bN, ?_, ?_⟩
    . rw [pEq, fst.pair, cl]
    . rw [pEq, snd.pair]
  . intro hp
    unfold intCastHom at hp
    obtain ⟨pin, m, mN, k, kN, f1, s1⟩ := hp
    have mNat := natural.member at m with mN
    have kNat := natural.member at k with kN
    have cl := tkF.integerClass.as_sum at m, k
    obtain ⟨_, x, hx, y, hy, shape⟩ := product.membership.forward with pin
    rw shape at f1
    rw shape at s1
    rw fst.pair at f1
    rw snd.pair at s1
    rw cl at f1
    unfold intCastMap
    refine ⟨pin, m, mN, k, kN, ?_⟩
    rw [shape, f1, s1]


-- The canonical map ℚ → K of a field of characteristic zero
-- (Rat.castHom): (a − b)/m goes to the x with x · m = a − b.
def ratCastMap (K : Set) : Set :=
  { p ∈ ℚ × Ring.carrier(K) | ∃ a ∈ ℕ, ∃ b ∈ ℕ, ∃ m ∈ ℕ,
    ∃ x ∈ Ring.carrier(K), m ≠ 0 ∧ p = (rationalClass(a, b, m), x) ∧
      call2(Ring.mul(K), x, natCast(K, m)) =
        Ring.sub(K, natCast(K, a), natCast(K, b)) }

-- Characteristic zero (CharZero): n · 1 ≠ 0 for n ≠ 0.
predicate CharZero (R : Set) :=
  ∀ n ∈ ℕ, n ≠ 0 → natCast(R, n) ≠ Ring.zero(R)

-- R as a ℤ-algebra, and a field of characteristic zero as a ℚ-algebra,
-- along the canonical maps (algebraInt, DivisionRing.toRatAlgebra).
def integerAlgebra (R : Set) : Set := Algebra.mk(integerRing, R, intCastMap(R))

def rationalAlgebra (K : Set) : Set :=
  Algebra.mk(rationalRing, K, ratCastMap(K))

-- K as a ℚ-vector space.
def rationalModule (K : Set) : Set := algebraModule(rationalAlgebra(K))

-- Section: Number fields and their rings of integers
-- A number field: a field of characteristic zero, finite-dimensional over
-- ℚ (NumberField K, with its Field K instance).
predicate NumberField (K : Set) :=
  Field(K) ∧ CharZero(K) ∧ FiniteDimensional(rationalModule(K), rationalRing)

-- The degree [K : ℚ] (Module.finrank ℚ K).
def numberFieldDegree (K : Set) : Set := finrank(rationalModule(K), rationalRing)

-- The ring of integers 𝓞 K: the elements of K integral over ℤ
-- (NumberField.RingOfIntegers, integralClosure ℤ K), as a subset of K,
-- and as a ring with the operations of K.
def ringOfIntegers (K : Set) : Set := integralClosure(integerAlgebra(K))

def ringOfIntegersRing (K : Set) : Set := subringRing(K, ringOfIntegers(K))

-- 𝓞 K as a ℤ-algebra and as a ℤ-module.
def ringOfIntegersAlgebra (K : Set) : Set := integerAlgebra(ringOfIntegersRing(K))

def ringOfIntegersModule (K : Set) : Set := algebraModule(ringOfIntegersAlgebra(K))

-- K as an 𝓞 K-algebra along the inclusion (the algebra 𝓞 K → K).
def ringOfIntegersInclusion (K : Set) : Set :=
  Algebra.mk(ringOfIntegersRing(K), K, identity(ringOfIntegers(K)))

-- The ring homomorphism f : K →+* L restricted to the rings of integers
-- (NumberField.RingOfIntegers.mapRingHom), and 𝓞 L as an 𝓞 K-algebra.
def ringOfIntegersMap (f K : Set) : Set := restrict(f, ringOfIntegers(K))

def ringOfIntegersExtension (f K L : Set) : Set :=
  Algebra.mk(ringOfIntegersRing(K), ringOfIntegersRing(L), ringOfIntegersMap(f, K))

-- Section: Norm and trace
-- The norm and the trace of x in an algebra A that is finite free over its
-- base: the determinant and the trace of multiplication by x
-- (Algebra.norm, Algebra.trace). Mathlib sets the norm to 1 and the trace
-- to 0 when A is not finite free; here they are unspecified there, and
-- every theorem assumes A finite free.
def algebraNorm (A x : Set) : Set :=
  linearDet(algebraModule(A), Algebra.base(A), algebraMultiplication(A, x))

def algebraTrace (A x : Set) : Set :=
  linearTrace(algebraModule(A), Algebra.base(A), algebraMultiplication(A, x))

-- The absolute norm and trace N_{K/ℚ}, Tr_{K/ℚ} (Algebra.norm ℚ,
-- Algebra.trace ℚ), and their integral versions on 𝓞 K
-- (Algebra.norm ℤ, Algebra.trace ℤ on 𝓞 K), valued in ℤ.
def fieldNorm (K x : Set) : Set := algebraNorm(rationalAlgebra(K), x)

def fieldTrace (K x : Set) : Set := algebraTrace(rationalAlgebra(K), x)

def integerNorm (K x : Set) : Set := algebraNorm(ringOfIntegersAlgebra(K), x)

def integerTrace (K x : Set) : Set := algebraTrace(ringOfIntegersAlgebra(K), x)

-- An algebra that is finite free over its base (Module.Free, Module.Finite).
predicate FiniteFreeAlgebra (A : Set) :=
  Algebra(A) ∧ FiniteFreeModule(algebraModule(A), Algebra.base(A))

-- The ring automorphisms of K (K ≃+* K; for a number field every one is a
-- ℚ-algebra automorphism, K ≃ₐ[ℚ] K).
def fieldAutomorphisms (K : Set) : Set :=
  { σ ∈ functionSpace(Ring.carrier(K), Ring.carrier(K)) | RingIso(σ, K, K) }

-- A number field Galois over ℚ: as many automorphisms as its degree
-- (IsGalois ℚ K, by IsGalois.card_aut_eq_finrank). Cross-module request:
-- to be unified with track F's IsGalois.
predicate GaloisNumberField (K : Set) :=
  NumberField(K) ∧
  HasCardinality(fieldAutomorphisms(K), numberFieldDegree(K))

-- The family σ ↦ σ(x) over the automorphisms, for the norm as a product.
def automorphismValues (K x : Set) : Set :=
  { (σ, σ(x)) | σ ∈ fieldAutomorphisms(K) }

-- Int.instIsDomain
theorem integerRing.integral_domain
  shows IntegralDomain(integerRing)
proof
  have h := integerRing.comm_ring at 0
  exact h.right

-- Helper: the positive naturals whose image lies in a set of integers.
def tkFPositiveMembers (I : Set) : Set :=
  { n ∈ ℕ | n ≠ 0 ∧ integerOfNat(n) ∈ I }

-- EuclideanDomain.to_principal_ideal_domain for ℤ
theorem integerRing.principal
  shows PrincipalIdealDomain(integerRing)
proof
  have dom := integerRing.integral_domain
  have ir := integerRing.comm_ring at 0
  have comm := ir.left
  have ringZ := CommRing.to_ring with comm
  have rc : Ring.carrier(integerRing) = ℤ by simp [integerRing, Ring.mk.carrier]
  have ra : Ring.add(integerRing) = integerAdd by simp [integerRing, Ring.mk.add]
  have rm : Ring.mul(integerRing) = integerMul by simp [integerRing, Ring.mk.mul]
  have rn : Ring.neg(integerRing) = integerNeg by simp [integerRing, Ring.mk.neg]
  have rz : Ring.zero(integerRing) = integerZero by simp [integerRing, Ring.mk.zero]
  unfold PrincipalIdealDomain
  refine ⟨dom, ?_⟩
  intros I ideal
  have isub := Ideal.subset at integerRing, I with ideal
  unfold PrincipalIdeal
  refine ⟨ideal, ?_⟩
  by_cases h : Nonempty(tkFPositiveMembers(I))
  . have sN : tkFPositiveMembers(I) ⊆ ℕ
      intros n hn
      unfold tkFPositiveMembers at hn
      exact hn.left
    have mS := leastNatural.member at tkFPositiveMembers(I) with h, sN
    have mS0 := mS
    unfold tkFPositiveMembers at mS0
    obtain ⟨mN, mnz, mI⟩ := mS0
    have mNat := natural.member at leastNatural(tkFPositiveMembers(I)) with mN
    have pos : 0 < leastNatural(tkFPositiveMembers(I)) by arith
    have mZ : integerOfNat(leastNatural(tkFPositiveMembers(I))) ∈ Ring.carrier(integerRing)
      rw rc
      typecheck
    refine ⟨integerOfNat(leastNatural(tkFPositiveMembers(I))), mZ, ?_⟩
    ext x
    constructor
    . intro hx
      have xR := isub with x, hx
      have xZ : x ∈ ℤ
        rw rc at xR
        exact xR
      have rNat := integerMod.natural at x, leastNatural(tkFPositiveMembers(I)) with pos
      have rlt := integerMod.below at x, leastNatural(tkFPositiveMembers(I)) with pos
      have cong := integerMod.congruent at x, leastNatural(tkFPositiveMembers(I)) with pos
      unfold IntegerCongruent at cong
      unfold IntegerDivides at cong
      obtain ⟨q, qZ, qe⟩ := cong
      have rN : integerMod(x, leastNatural(tkFPositiveMembers(I))) ∈ ℕ by typecheck
      have rR : integerOfNat(integerMod(x, leastNatural(tkFPositiveMembers(I)))) ∈ Ring.carrier(integerRing)
        rw rc
        typecheck
      have qR : q ∈ Ring.carrier(integerRing)
        rw rc
        exact qZ
      have qe2 : call2(Ring.mul(integerRing), integerOfNat(leastNatural(tkFPositiveMembers(I))), q) = Ring.sub(integerRing, x, integerOfNat(integerMod(x, leastNatural(tkFPositiveMembers(I)))))
        rw rm
        rw integerMulValue.notation
        unfold Ring.sub
        rw [ra, rn]
        unfold integerSubValue at qe
        exact qe
      have mR := isub with integerOfNat(leastNatural(tkFPositiveMembers(I))), mI
      have rI : integerOfNat(integerMod(x, leastNatural(tkFPositiveMembers(I)))) ∈ I
        have e : integerOfNat(integerMod(x, leastNatural(tkFPositiveMembers(I)))) = Ring.sub(integerRing, x, call2(Ring.mul(integerRing), integerOfNat(leastNatural(tkFPositiveMembers(I))), q))
          rw qe2
          ring
        rw e
        typecheck
      have r0 : integerMod(x, leastNatural(tkFPositiveMembers(I))) = 0
        by_contra rnz
        have inS : integerMod(x, leastNatural(tkFPositiveMembers(I))) ∈ tkFPositiveMembers(I)
          unfold tkFPositiveMembers
          exact ⟨rN, rnz, rI⟩
        have le := leastNatural.least at tkFPositiveMembers(I), integerMod(x, leastNatural(tkFPositiveMembers(I))) with h, sN, inS
        arith
      rw r0 at qe2
      have z0 : integerOfNat(0) = Ring.zero(integerRing)
        rw rz
        unfold integerOfNat
        unfold integerZero
        rfl
      rw z0 at qe2
      have t : call2(Ring.mul(integerRing), q, integerOfNat(leastNatural(tkFPositiveMembers(I)))) = Ring.sub(integerRing, x, Ring.zero(integerRing))
        rw ← qe2
        ring
      have t2 : Ring.sub(integerRing, x, Ring.zero(integerRing)) = x by ring
      rw t2 at t
      have xe : x = call2(Ring.mul(integerRing), q, integerOfNat(leastNatural(tkFPositiveMembers(I)))) by rw t
      unfold ringMultiples
      exact ⟨xR, q, qR, xe⟩
    . intro hx
      unfold ringMultiples at hx
      obtain ⟨_, c, cIn, xEq⟩ := hx
      rw xEq
      have mR := isub with integerOfNat(leastNatural(tkFPositiveMembers(I))), mI
      typecheck
  . have zR : Ring.zero(integerRing) ∈ Ring.carrier(integerRing) by typecheck
    refine ⟨Ring.zero(integerRing), zR, ?_⟩
    have zz : Ring.zero(integerRing) = Ring.zero(integerRing) by rfl
    have rm0 := (ringMultiples.eq_zero_iff at integerRing, Ring.zero(integerRing) with comm, zR).backward with zz
    rw rm0
    have z0 : integerOfNat(0) = Ring.zero(integerRing)
      rw rz
      unfold integerOfNat
      unfold integerZero
      rfl
    have zn0 : integerNegativeOfNat(0) = Ring.zero(integerRing)
      rw rz
      unfold integerNegativeOfNat
      unfold integerZero
      rfl
    ext x
    constructor
    . intro hx
      have xR := isub with x, hx
      have xZ : x ∈ ℤ
        rw rc at xR
        exact xR
      obtain ⟨n, nNat, sign⟩ := Integer.signed_natural at x
      have nN : n ∈ ℕ by typecheck
      have n0 : n = 0
        by_contra nnz
        apply h
        have nI : integerOfNat(n) ∈ I
          cases sign with p | p
          . rw ← p
            exact hx
          . have nx : Ring.neg(integerRing)(x) ∈ I by typecheck
            have e : Ring.neg(integerRing)(x) = integerOfNat(n)
              rw [rn, p]
              rw integerNegValue.notation
              unfold integerNegativeOfNat
              rw integerNegValue.classes
              unfold integerClassNeg
              unfold integerOfNat
              rfl
            rw e at nx
            exact nx
        have inS : n ∈ tkFPositiveMembers(I)
          unfold tkFPositiveMembers
          exact ⟨nN, nnz, nI⟩
        unfold Nonempty
        exact ⟨n, inS⟩
      rw n0 at sign
      cases sign with p | p
      . rw [p, z0]
        exact singleton.membership.backward at Ring.zero(integerRing), Ring.zero(integerRing) with rfl
      . rw [p, zn0]
        exact singleton.membership.backward at Ring.zero(integerRing), Ring.zero(integerRing) with rfl
    . intro hx
      have x0 := singleton.membership.forward with hx
      rw x0
      typecheck


-- Rat.instCharZero
theorem rationalRing.char_zero
  shows CharZero(rationalRing)
proof
  unfold CharZero
  intros n hn ne eq
  have h := rationalRing.field
  have cp := h.right
  obtain ⟨_, iff⟩ := cp
  have d := (iff at n with hn).forward with eq
  have z := zero.divides_only_zero at n with d
  exact ne with z

-- Helper: a ring homomorphism between fields is injective.
theorem tkF.fieldHom.injective (K L f : Set)
  requires sourceField : Field(K)
  requires targetField : Field(L)
  requires hom : RingHom(f, K, L)
  shows InjectiveBetween(f, Ring.carrier(K), Ring.carrier(L))
proof
  have kp := Field.parts at K with sourceField
  have lc := Field.to_comm_ring at L with targetField
  have lp := CommRing.parts with lc
  have hp := RingHom.parts with hom
  have ld := Field.domain at L with targetField
  have ld0 := ld
  obtain ⟨_, nt, _⟩ := ld0
  have zL : Ring.zero(L) ∈ Ring.carrier(L) by typecheck
  have oL : Ring.one(L) ∈ Ring.carrier(L) by typecheck
  have ntL : Nontrivial(Ring.carrier(L), Ring.zero(L), Ring.one(L))
    unfold Nontrivial
    exact ⟨zL, oL, nt⟩
  exact IsRingHom.field_injective at Ring.carrier(K), Ring.add(K), Ring.zero(K), Ring.neg(K), Ring.mul(K), Ring.one(K), Ring.carrier(L), Ring.add(L), Ring.zero(L), Ring.neg(L), Ring.mul(L), Ring.one(L), f with kp, lp, ntL, hp


-- Int.castRingHom
theorem intCastMap.ring_hom (R : Set)
  requires ring : CommRing(R)
  shows RingHom(intCastMap(R), integerRing, R)
proof
  have ringR := CommRing.to_ring with ring
  have e := intCastMap.eq_int_cast_hom at R with ringR
  rw e
  exact intCastHom.hom at R with ring


-- Int.cast_natCast
theorem intCastMap.of_nat (R : Set) (n : Nat)
  requires ring : CommRing(R)
  shows intCastMap(R)(integerOfNat(n)) = natCast(R, n)
proof
  have ringR := CommRing.to_ring with ring
  have hom := intCastMap.ring_hom at R with ring
  have hom0 := hom
  obtain ⟨_, _, fF, _⟩ := hom0
  have c : Ring.carrier(integerRing) = ℤ by simp [integerRing, Ring.mk.carrier]
  rw c at fF
  have nN : n ∈ ℕ by typecheck
  have zN : 0 ∈ ℕ by typecheck
  have xin : integerOfNat(n) ∈ ℤ by typecheck
  have nR : natCast(R, n) ∈ Ring.carrier(R)
    unfold natCast
    typecheck
  have n0 : natCast(R, 0) = Ring.zero(R)
    unfold natCast
    exact ringNat.zero at Ring.add(R), Ring.zero(R), Ring.one(R)
  have sv : Ring.sub(R, natCast(R, n), natCast(R, 0)) = natCast(R, n)
    rw n0
    rw Ring.sub.value
    ring
  have pin := product.pair at integerOfNat(n), natCast(R, n), ℤ, Ring.carrier(R) with xin, nR
  have eq : (integerOfNat(n), natCast(R, n)) = (integerClass(n, 0), Ring.sub(R, natCast(R, n), natCast(R, 0)))
    rw sv
    unfold integerOfNat
    rfl
  have rel : relates(intCastMap(R), integerOfNat(n), natCast(R, n))
    unfold relates
    unfold intCastMap
    exact ⟨pin, n, nN, 0, zN, eq⟩
  exact FunctionBetween.apply_value at intCastMap(R), ℤ, Ring.carrier(R), integerOfNat(n), natCast(R, n) with fF, xin, rel


-- RingHom.eq_intCast': ℤ is initial among rings.
theorem intCastMap.unique (R f : Set)
  requires ring : CommRing(R)
  requires hom : RingHom(f, integerRing, R)
  shows f = intCastMap(R)
proof
  have ringR := CommRing.to_ring with ring
  have e := intCastMap.eq_int_cast_hom at R with ringR
  rw e
  exact intCastHom.unique at R, f with ring, hom


-- Rat.castHom
theorem ratCastMap.ring_hom (K : Set)
  requires field : Field(K)
  requires zero : CharZero(K)
  shows RingHom(ratCastMap(K), rationalRing, K)
proof
  sorry

-- Helpers: the natural n in ℚ is the class n/1, and (a − b)/m times m
-- is a − b in ℚ.
theorem tkF.natCast.rational (n : Nat)
  shows natCast(rationalRing, n) = rationalClass(n, 0, 1)
proof
  have ra : Ring.add(rationalRing) = rationalAdd by simp [rationalRing, Ring.mk.add]
  have rz : Ring.zero(rationalRing) = rationalZero by simp [rationalRing, Ring.mk.zero]
  have ro : Ring.one(rationalRing) = rationalOne by simp [rationalRing, Ring.mk.one]
  have one : (1:N) ≠ 0 by arith
  induction n
  | zero =>
    unfold natCast
    rw ringNat.zero
    rw rz
    unfold rationalZero
    rfl
  | succ(k) using ih =>
    unfold natCast
    rw ringNat.succ
    have fk : ringNat(Ring.add(rationalRing), Ring.zero(rationalRing), Ring.one(rationalRing), k) = natCast(rationalRing, k) by unfold natCast; rfl
    rw [fk, ih, ra, ro]
    rw rationalAddValue.notation
    unfold rationalOne
    rw rationalAddValue.classes
    unfold rationalClassSum
    have oo : 1 * 1 ≠ 0 by arith
    have e : 1 * (1 * k + 1 * 1) + (1 * 1) * 0 = (1 * 1) * succ(k) + 1 * (1 * 0 + 1 * 0) by arith
    exact rationalClass.eq at 1 * k + 1 * 1, 1 * 0 + 1 * 0, 1 * 1, succ(k), 0, 1 with oo, one, e



theorem tkF.ratClass.mul_den (a b m : Nat)
  requires nonzero : m ≠ 0
  shows call2(Ring.mul(rationalRing), rationalClass(a, b, m), natCast(rationalRing, m)) =
    Ring.sub(rationalRing, natCast(rationalRing, a), natCast(rationalRing, b))
proof
  have ra : Ring.add(rationalRing) = rationalAdd by simp [rationalRing, Ring.mk.add]
  have rm : Ring.mul(rationalRing) = rationalMul by simp [rationalRing, Ring.mk.mul]
  have rn : Ring.neg(rationalRing) = rationalNeg by simp [rationalRing, Ring.mk.neg]
  have one : (1:N) ≠ 0 by arith
  rw [(tkF.natCast.rational at m), (tkF.natCast.rational at a), (tkF.natCast.rational at b)]
  unfold Ring.sub
  rw [ra, rm, rn]
  rw rationalNegValue.notation
  rw rationalNegValue.classes
  unfold rationalClassNeg
  rw [rationalAddValue.notation, rationalMulValue.notation]
  rw rationalAddValue.classes
  rw rationalMulValue.classes
  unfold rationalClassSum
  unfold rationalClassMul
  have mm := mul.nonzero at m, 1 with nonzero, one
  have e : 1 * 1 * (a * m + b * 0) + m * 1 * (1 * 0 + 1 * b) = m * 1 * (1 * a + 1 * 0) + 1 * 1 * (a * 0 + b * m) by ring
  have oo := mul.nonzero at 1, 1 with one, one
  exact rationalClass.eq with mm, oo, e


-- RingHom.ext_rat: the only ring homomorphism ℚ → K.
theorem ratCastMap.unique (K f : Set)
  requires field : Field(K)
  requires zero : CharZero(K)
  requires hom : RingHom(f, rationalRing, K)
  shows f = ratCastMap(K)
proof
  have hK := ratCastMap.ring_hom at K with field, zero
  have kc := Field.to_comm_ring at K with field
  have qf := rationalRing.field
  have qff := qf.left
  have qc := Field.to_comm_ring at rationalRing with qff
  have hK0 := hK
  obtain ⟨_, _, fK, _⟩ := hK0
  have kd := Field.domain at K with field
  obtain ⟨_, _, nzd⟩ := kd
  have same : ∀ q ∈ Ring.carrier(rationalRing), f(q) = ratCastMap(K)(q)
    intros q hq
    have r := FunctionBetween.relates_apply at ratCastMap(K), Ring.carrier(rationalRing), Ring.carrier(K), q with fK, hq
    unfold relates at r
    unfold ratCastMap at r
    obtain ⟨_, a, aN, b, bN, m, mN, x, xK, mnz, pEq, law⟩ := r
    have h1 : fst((q, ratCastMap(K)(q))) = fst((rationalClass(a, b, m), x)) by rw pEq
    rw [fst.pair, fst.pair] at h1
    have h2 : snd((q, ratCastMap(K)(q))) = snd((rationalClass(a, b, m), x)) by rw pEq
    rw [snd.pair, snd.pair] at h2
    rw h2
    have aNat := natural.member at a with aN
    have bNat := natural.member at b with bN
    have mNat := natural.member at m with mN
    have qd := tkF.ratClass.mul_den at a, b, m with mnz
    rw ← h1 at qd
    have nmQ : natCast(rationalRing, m) ∈ Ring.carrier(rationalRing)
      unfold natCast
      typecheck
    have naQ : natCast(rationalRing, a) ∈ Ring.carrier(rationalRing)
      unfold natCast
      typecheck
    have nbQ : natCast(rationalRing, b) ∈ Ring.carrier(rationalRing)
      unfold natCast
      typecheck
    have mm := RingHom.map_mul at f, rationalRing, K, q, natCast(rationalRing, m) with hom, hq, nmQ
    have ms := RingHom.map_sub at f, rationalRing, K, natCast(rationalRing, a), natCast(rationalRing, b) with hom, naQ, nbQ
    have numm := RingHom.map_numeral at rationalRing, K, f, m with qc, kc, hom
    have numa := RingHom.map_numeral at rationalRing, K, f, a with qc, kc, hom
    have numb := RingHom.map_numeral at rationalRing, K, f, b with qc, kc, hom
    have cq : ∀ n ∈ ℕ, natCast(rationalRing, n) = ringNat(Ring.add(rationalRing), Ring.zero(rationalRing), Ring.one(rationalRing), n)
      intros n hn
      unfold natCast
      rfl
    have ck : ∀ n ∈ ℕ, natCast(K, n) = ringNat(Ring.add(K), Ring.zero(K), Ring.one(K), n)
      intros n hn
      unfold natCast
      rfl
    rw [← (cq with mN), ← (ck with mN)] at numm
    rw [← (cq with aN), ← (ck with aN)] at numa
    rw [← (cq with bN), ← (ck with bN)] at numb
    rw [qd, ms, numm, numa, numb] at mm
    have fqK : f(q) ∈ Ring.carrier(K) by typecheck
    have nmK : natCast(K, m) ∈ Ring.carrier(K)
      unfold natCast
      typecheck
    have naK : natCast(K, a) ∈ Ring.carrier(K)
      unfold natCast
      typecheck
    have nbK : natCast(K, b) ∈ Ring.carrier(K)
      unfold natCast
      typecheck
    have nmnz : natCast(K, m) ≠ Ring.zero(K)
      unfold CharZero at zero
      exact zero with mN, mnz
    have d : call2(Ring.mul(K), Ring.sub(K, f(q), x), natCast(K, m)) = Ring.zero(K)
      have e1 : call2(Ring.mul(K), Ring.sub(K, f(q), x), natCast(K, m)) = Ring.sub(K, call2(Ring.mul(K), f(q), natCast(K, m)), call2(Ring.mul(K), x, natCast(K, m))) by ring
      rw [e1, ← mm, law]
      ring
    have dIn : Ring.sub(K, f(q), x) ∈ Ring.carrier(K) by typecheck
    have c1 := nzd with dIn
    have c2 := c1 with nmK, d
    cases c2 with h | h
    . have e2 : f(q) = call2(Ring.add(K), Ring.sub(K, f(q), x), x) by ring
      rw [e2, h]
      ring
    . exfalso
      exact nmnz with h
  exact RingHom.ext at f, rationalRing, K, ratCastMap(K) with hom, hK, same


-- Rat.cast_injective
theorem ratCastMap.injective (K : Set)
  requires field : Field(K)
  requires zero : CharZero(K)
  shows InjectiveBetween(ratCastMap(K), ℚ, Ring.carrier(K))
proof
  have qf := rationalRing.field
  have qff := qf.left
  have hom := ratCastMap.ring_hom at K with field, zero
  have inj := tkF.fieldHom.injective at rationalRing, K, ratCastMap(K) with qff, field, hom
  have c : Ring.carrier(rationalRing) = ℚ by simp [rationalRing, Ring.mk.carrier]
  rw c at inj
  exact inj


-- Rat.cast_intCast
theorem ratCastMap.of_int (K z : Set)
  requires field : Field(K)
  requires zero : CharZero(K)
  requires integer : z ∈ ℤ
  shows ratCastMap(K)(intCastMap(rationalRing)(z)) = intCastMap(K)(z)
proof
  have qf := rationalRing.field
  have qff := qf.left
  have qc := Field.to_comm_ring at rationalRing with qff
  have kc := Field.to_comm_ring at K with field
  have ir := integerRing.comm_ring at 0
  have ic := ir.left
  have hQ := intCastMap.ring_hom at rationalRing with qc
  have hK := ratCastMap.ring_hom at K with field, zero
  have comp := RingHom.comp at intCastMap(rationalRing), ratCastMap(K), integerRing, rationalRing, K with ic, hQ, hK
  have u := intCastMap.unique at K, compose(ratCastMap(K), intCastMap(rationalRing), Ring.carrier(integerRing), Ring.carrier(rationalRing), Ring.carrier(K)) with kc, comp
  have hQ0 := hQ
  obtain ⟨_, _, fQ, _⟩ := hQ0
  have hK0 := hK
  obtain ⟨_, _, fK, _⟩ := hK0
  have c : Ring.carrier(integerRing) = ℤ by simp [integerRing, Ring.mk.carrier]
  have zIn : z ∈ Ring.carrier(integerRing)
    rw c
    exact integer
  have ca := compose.apply at ratCastMap(K), intCastMap(rationalRing), Ring.carrier(integerRing), Ring.carrier(rationalRing), Ring.carrier(K), z with fQ, fK, zIn
  rw u at ca
  rw ca


-- RingHom.charZero: a field receiving a ring homomorphism from a field of
-- characteristic zero has characteristic zero.
theorem CharZero.of_hom (K L f : Set)
  requires sourceField : Field(K)
  requires targetField : Field(L)
  requires zero : CharZero(K)
  requires hom : RingHom(f, K, L)
  shows CharZero(L)
proof
  have kc := Field.to_comm_ring at K with sourceField
  have lc := Field.to_comm_ring at L with targetField
  have inj := tkF.fieldHom.injective at K, L, f with sourceField, targetField, hom
  have mz := RingHom.map_zero at f, K, L with hom
  unfold CharZero
  intros n hn ne eq
  have nNat := natural.member at n with hn
  have mn := RingHom.map_numeral at K, L, f, n with kc, lc, hom
  have e1 : natCast(K, n) = ringNat(Ring.add(K), Ring.zero(K), Ring.one(K), n) by unfold natCast; rfl
  have e2 : natCast(L, n) = ringNat(Ring.add(L), Ring.zero(L), Ring.one(L), n) by unfold natCast; rfl
  rw [← e1, ← e2, eq, ← mz] at mn
  have nK : natCast(K, n) ∈ Ring.carrier(K)
    rw e1
    typecheck
  have zK : Ring.zero(K) ∈ Ring.carrier(K) by typecheck
  have nz := Injective.apply_cancel at f, Ring.carrier(K), Ring.carrier(L), natCast(K, n), Ring.zero(K) with inj, nK, zK, mn
  exact (zero with hn, ne) with nz


-- RingHom.map_ratCast: ring homomorphisms between fields of
-- characteristic zero commute with the casts.
theorem ratCastMap.comp_hom (K L f q : Set)
  requires sourceField : Field(K)
  requires targetField : Field(L)
  requires zero : CharZero(K)
  requires hom : RingHom(f, K, L)
  requires rational : q ∈ ℚ
  shows f(ratCastMap(K)(q)) = ratCastMap(L)(q)
proof
  have qf := rationalRing.field
  have qff := qf.left
  have qc := Field.to_comm_ring at rationalRing with qff
  have zL := CharZero.of_hom at K, L, f with sourceField, targetField, zero, hom
  have hK := ratCastMap.ring_hom at K with sourceField, zero
  have comp := RingHom.comp at ratCastMap(K), f, rationalRing, K, L with qc, hK, hom
  have u := ratCastMap.unique at L, compose(f, ratCastMap(K), Ring.carrier(rationalRing), Ring.carrier(K), Ring.carrier(L)) with targetField, zL, comp
  have hK0 := hK
  obtain ⟨_, _, fK, _⟩ := hK0
  have hom0 := hom
  obtain ⟨_, _, ff, _⟩ := hom0
  have c : Ring.carrier(rationalRing) = ℚ by simp [rationalRing, Ring.mk.carrier]
  have qIn : q ∈ Ring.carrier(rationalRing)
    rw c
    exact rational
  have ca := compose.apply at f, ratCastMap(K), Ring.carrier(rationalRing), Ring.carrier(K), Ring.carrier(L), q with fK, ff, qIn
  rw u at ca
  rw ca


theorem integerAlgebra.algebra (R : Set)
  requires ring : CommRing(R)
  shows Algebra(integerAlgebra(R))
proof
  have ir := integerRing.comm_ring at 0
  have irc := ir.left
  have hom := intCastMap.ring_hom at R with ring
  unfold integerAlgebra
  exact Algebra.intro with irc, ring, hom


theorem rationalAlgebra.algebra (K : Set)
  requires field : Field(K)
  requires zero : CharZero(K)
  shows Algebra(rationalAlgebra(K))
proof
  have qf := rationalRing.field
  have qff := qf.left
  have qc := Field.to_comm_ring at rationalRing with qff
  have kc := Field.to_comm_ring at K with field
  have hom := ratCastMap.ring_hom at K with field, zero
  unfold rationalAlgebra
  exact Algebra.intro with qc, kc, hom


-- Helper: ℚ is spanned by 1 as a module over itself.
theorem tkF.rationalModule.span_one
  shows Module(rationalModule(rationalRing), rationalRing) ∧
    {Ring.one(rationalRing)} ⊆ Module.carrier(rationalModule(rationalRing)) ∧
    moduleSpan(rationalModule(rationalRing), rationalRing, {Ring.one(rationalRing)}) =
      Module.carrier(rationalModule(rationalRing))
proof
  have qf := rationalRing.field
  have qff := qf.left
  have qc := Field.to_comm_ring at rationalRing with qff
  have qring := CommRing.to_ring with qc
  have cz := rationalRing.char_zero
  have idh := RingHom.id at rationalRing with qc
  have u := ratCastMap.unique at rationalRing, identity(Ring.carrier(rationalRing)) with qff, cz, idh
  have alg := rationalAlgebra.algebra at rationalRing with qff, cz
  have mod := algebraModule.module_of at rationalAlgebra(rationalRing) with alg
  have ce := algebraModule.carrier_eq at rationalAlgebra(rationalRing)
  have bs : Algebra.base(rationalAlgebra(rationalRing)) = rationalRing by simp [rationalAlgebra, Algebra.mk.base]
  have rr : Algebra.ring(rationalAlgebra(rationalRing)) = rationalRing by simp [rationalAlgebra, Algebra.mk.ring]
  have mp : Algebra.map(rationalAlgebra(rationalRing)) = ratCastMap(rationalRing) by simp [rationalAlgebra, Algebra.mk.map]
  have ac : algebraCarrier(rationalAlgebra(rationalRing)) = Ring.carrier(rationalRing)
    unfold algebraCarrier
    rw rr
  have oneQ : Ring.one(rationalRing) ∈ Ring.carrier(rationalRing) by typecheck
  have oneA : Ring.one(rationalRing) ∈ algebraCarrier(rationalAlgebra(rationalRing))
    rw ac
    exact oneQ
  have oneM := algebraModule.mem at rationalAlgebra(rationalRing), Ring.one(rationalRing) with oneA
  rw bs at mod
  have sp := moduleSpan.singleton at rationalRing, algebraModule(rationalAlgebra(rationalRing)), Ring.one(rationalRing) with qring, mod, oneM
  have sub : {Ring.one(rationalRing)} ⊆ Module.carrier(algebraModule(rationalAlgebra(rationalRing)))
    intros y hy
    have yx := singleton.membership.forward with hy
    rw yx
    exact oneM
  have span : moduleSpan(algebraModule(rationalAlgebra(rationalRing)), rationalRing, {Ring.one(rationalRing)}) = Module.carrier(algebraModule(rationalAlgebra(rationalRing)))
    rw sp
    ext y
    constructor
    . intro hy
      unfold scalarMultiples at hy
      exact hy.left
    . intro hy
      have yA := hy
      rw [ce, ac] at yA
      have bsy : y ∈ Ring.carrier(Algebra.base(rationalAlgebra(rationalRing)))
        rw bs
        exact yA
      have sv := algebraModule.smul_value at rationalAlgebra(rationalRing), y, Ring.one(rationalRing) with alg, bsy, oneA
      rw [mp, rr, ← u] at sv
      have ia := identity.apply at y, Ring.carrier(rationalRing) with yA
      rw ia at sv
      have e : y = call2(Module.smul(algebraModule(rationalAlgebra(rationalRing))), y, Ring.one(rationalRing))
        rw sv
        ring
      unfold scalarMultiples
      exact ⟨hy, y, yA, e⟩
  unfold rationalModule
  exact ⟨mod, sub, span⟩


-- Section: Number fields
-- Rat.numberField
theorem NumberField.rationals
  shows NumberField(rationalRing)
proof
  have qf := rationalRing.field
  have qff := qf.left
  have cz := rationalRing.char_zero
  have so := tkF.rationalModule.span_one
  obtain ⟨mod, sub, span⟩ := so
  have fin := Finite.singleton at Ring.one(rationalRing)
  have fg : FinitelyGeneratedModule(rationalModule(rationalRing), rationalRing)
    unfold FinitelyGeneratedModule
    exact ⟨mod, {Ring.one(rationalRing)}, sub, fin, span⟩
  unfold NumberField
  unfold FiniteDimensional
  exact ⟨qff, cz, qff, fg⟩



-- NumberField.of_module_finite: a finite extension of a number field is a
-- number field.
theorem NumberField.of_module_finite (K L f : Set)
  requires numberField : NumberField(K)
  requires field : Field(L)
  requires hom : RingHom(f, K, L)
  requires finite : FiniteDimensional(algebraModule(Algebra.mk(K, L, f)), K)
  shows NumberField(L)
proof
  sorry

-- The converse direction: a ring homomorphism of number fields makes the
-- target finite over the source (Module.Finite K L for number fields).
theorem NumberField.finite_over (K L f : Set)
  requires source : NumberField(K)
  requires target : NumberField(L)
  requires hom : RingHom(f, K, L)
  shows FiniteDimensional(algebraModule(Algebra.mk(K, L, f)), K)
proof
  sorry

-- Module.finrank_mul_finrank: [L : ℚ] = [L : K] [K : ℚ].
theorem numberFieldDegree.tower (K L f : Set)
  requires source : NumberField(K)
  requires target : NumberField(L)
  requires hom : RingHom(f, K, L)
  shows numberFieldDegree(L) =
    mul(finrank(algebraModule(Algebra.mk(K, L, f)), K), numberFieldDegree(K))
proof
  sorry

-- A subring of an integral domain is an integral domain.
theorem tkF.subringRing.integral_domain (R S : Set)
  requires domain : IntegralDomain(R)
  requires subring : Subring(R, S)
  shows IntegralDomain(subringRing(R, S))
proof
  obtain ⟨comm, nt, nzd⟩ := domain
  have sc := subringRing.comm_ring at R, S with comm, subring
  have incl := Subring.inclusion at R, S with comm, subring
  have c := subringRing.carrierOf at R, S
  have z : Ring.zero(subringRing(R, S)) = Ring.zero(R) by simp [subringRing, Ring.mk.zero]
  have o : Ring.one(subringRing(R, S)) = Ring.one(R) by simp [subringRing, Ring.mk.one]
  unfold IntegralDomain
  refine ⟨sc, ?_, ?_⟩
  . rw [z, o]
    exact nt
  . intros x hx y hy eq
    have hxS : x ∈ S by rw ← c; exact hx
    have hyS : y ∈ S by rw ← c; exact hy
    have bounded := subring.left
    have xR := bounded with x, hxS
    have yR := bounded with y, hyS
    have mm := RingHom.map_mul at identity(S), subringRing(R, S), R, x, y with incl, hx, hy
    have pIn : call2(Ring.mul(subringRing(R, S)), x, y) ∈ S by rw eq; rw z; exact subring.right.left
    have i1 := identity.apply at call2(Ring.mul(subringRing(R, S)), x, y), S with pIn
    have i2 := identity.apply at x, S with hxS
    have i3 := identity.apply at y, S with hyS
    rw [i1, i2, i3, eq, z] at mm
    have mms : call2(Ring.mul(R), x, y) = Ring.zero(R) by rw ← mm
    have r1 := nzd with xR
    have r := r1 with yR, mms
    rw z
    exact r


-- Section: The ring of integers
section RingOfIntegers
variable (K : Set)
hypothesis field : Field(K)
hypothesis numberField : NumberField(K)

-- NumberField.mem_ringOfIntegers
theorem ringOfIntegers.mem_iff (x : Set)
  shows x ∈ ringOfIntegers(K) ↔ IntegralElement(integerAlgebra(K), x)
proof
  unfold ringOfIntegers
  unfold integralClosure
  constructor
  . intro h
    exact h.right
  . intro h
    have h0 := h
    obtain ⟨_, mem, _⟩ := h0
    exact ⟨mem, h⟩


-- (integralClosure ℤ K).toSubring
theorem ringOfIntegers.subring
  shows Subring(K, ringOfIntegers(K))
proof
  have kc := Field.to_comm_ring at K with field
  have alg := integerAlgebra.algebra at K with kc
  have sub := intHelp.closure_subring at integerAlgebra(K) with alg
  unfold ringOfIntegers
  have r : Algebra.ring(integerAlgebra(K)) = K by simp [integerAlgebra, Algebra.mk.ring]
  rw r at sub
  exact sub


-- NumberField.RingOfIntegers.instIsDomain
theorem ringOfIntegersRing.integral_domain
  shows IntegralDomain(ringOfIntegersRing(K))
proof
  have sub := ringOfIntegers.subring at K with field, numberField
  have fd := Field.domain at K with field
  unfold ringOfIntegersRing
  exact tkF.subringRing.integral_domain at K, ringOfIntegers(K) with fd, sub


-- The integers lie in 𝓞 K (algebraMap ℤ (𝓞 K)).
theorem ringOfIntegers.intCast_mem (z : Set)
  requires integer : z ∈ ℤ
  shows intCastMap(K)(z) ∈ ringOfIntegers(K)
proof
  have kc := Field.to_comm_ring at K with field
  have alg := integerAlgebra.algebra at K with kc
  have b : Ring.carrier(Algebra.base(integerAlgebra(K))) = ℤ by simp [integerAlgebra, Algebra.mk.base, integerRing, Ring.mk.carrier]
  have zIn : z ∈ Ring.carrier(Algebra.base(integerAlgebra(K))) by rw b; exact integer
  have ie := IntegralElement.algebra_map at integerAlgebra(K), z with alg, zIn
  have mp : Algebra.map(integerAlgebra(K)) = intCastMap(K) by simp [integerAlgebra, Algebra.mk.map]
  rw mp at ie
  have mem := (ringOfIntegers.mem_iff at K, intCastMap(K)(z) with field, numberField).backward
  exact mem with ie


-- 𝓞 K ∩ ℚ = ℤ (IsIntegrallyClosed ℤ, Rat.ringOfIntegersEquiv).
theorem ringOfIntegers.ratCast_mem_iff (q : Set)
  requires rational : q ∈ ℚ
  shows ratCastMap(K)(q) ∈ ringOfIntegers(K) ↔
    (∃ z ∈ ℤ, q = intCastMap(rationalRing)(z))
proof
  sorry

-- Rat.ringOfIntegersEquiv: 𝓞 ℚ is the image of ℤ.
theorem ringOfIntegers.rationals
  shows ringOfIntegers(rationalRing) =
    functionImage(intCastMap(rationalRing), ℤ, ℚ)
proof
  sorry

-- NumberField.RingOfIntegers.instFree, instModuleFinite: 𝓞 K is a free
-- ℤ-module of finite rank.
theorem ringOfIntegers.free
  shows FiniteFreeModule(ringOfIntegersModule(K), integerRing)
proof
  sorry

-- NumberField.RingOfIntegers.rank: the rank of 𝓞 K over ℤ is [K : ℚ].
theorem ringOfIntegers.rank
  shows finrank(ringOfIntegersModule(K), integerRing) = numberFieldDegree(K)
proof
  sorry

-- NumberField.integralBasis, integralBasis_apply: a ℤ-basis of 𝓞 K is a
-- ℚ-basis of K.
theorem ringOfIntegers.integral_basis (I b : Set)
  requires basis : ModuleBasis(ringOfIntegersModule(K), integerRing, I, b)
  shows ModuleBasis(rationalModule(K), rationalRing, I, b)
proof
  sorry

-- exists_integral_multiples: every x ∈ K has a nonzero integer multiple
-- in 𝓞 K.
theorem ringOfIntegers.exists_multiple (x : K)
  shows ∃ n ∈ ℕ, n ≠ 0 ∧ natCast(K, n) * x ∈ ringOfIntegers(K)
proof
  sorry

-- NumberField.RingOfIntegers.instIsFractionRing: K is the fraction field
-- of 𝓞 K.
theorem ringOfIntegers.fraction_ring
  shows IsFractionRing(ringOfIntegersInclusion(K))
proof
  sorry

-- NumberField.RingOfIntegers.not_isField
theorem ringOfIntegers.not_field
  shows ¬Field(ringOfIntegersRing(K))
proof
  sorry

-- IsIntegralClosure.isNoetherianRing
theorem ringOfIntegers.noetherian
  shows NoetherianRing(ringOfIntegersRing(K))
proof
  sorry

-- NumberField.RingOfIntegers.instIsIntegrallyClosed
theorem ringOfIntegers.integrally_closed
  shows IntegrallyClosedDomain(ringOfIntegersRing(K))
proof
  sorry

-- IsIntegralClosure (𝓞 K) ℤ K, along the inclusion.
theorem ringOfIntegers.is_integral_closure
  shows IsIntegralClosure(ringOfIntegersAlgebra(K), integerAlgebra(K),
    identity(ringOfIntegers(K)))
proof
  have kc := Field.to_comm_ring at K with field
  have sub := ringOfIntegers.subring at K with field, numberField
  have sc := subringRing.comm_ring at K, ringOfIntegers(K) with kc, sub
  have ir := integerRing.comm_ring at 0
  have ic := ir.left
  have gS := intCastMap.ring_hom at subringRing(K, ringOfIntegers(K)) with sc
  have gS0 := gS
  obtain ⟨_, _, gF, _⟩ := gS0
  have c := subringRing.carrierOf at K, ringOfIntegers(K)
  have gF1 := gF
  rw c at gF1
  have ssub := sub.left
  have gK : intCastMap(subringRing(K, ringOfIntegers(K))) : Ring.carrier(integerRing) → Ring.carrier(K)
    apply FunctionBetween.codomain_of_values with gF1
    intros z hz
    have v := FunctionBetween.apply_closed with gF1, hz
    exact ssub with intCastMap(subringRing(K, ringOfIntegers(K)))(z), v
  have incl := Subring.inclusion at K, ringOfIntegers(K) with kc, sub
  have incl0 := incl
  obtain ⟨_, _, idF, _⟩ := incl0
  have comp := RingHom.comp at intCastMap(subringRing(K, ringOfIntegers(K))), identity(ringOfIntegers(K)), integerRing, subringRing(K, ringOfIntegers(K)), K with ic, gS, incl
  have u := intCastMap.unique at K, compose(identity(ringOfIntegers(K)), intCastMap(subringRing(K, ringOfIntegers(K))), Ring.carrier(integerRing), Ring.carrier(subringRing(K, ringOfIntegers(K))), Ring.carrier(K)) with kc, comp
  have compF := compose.function at identity(ringOfIntegers(K)), intCastMap(subringRing(K, ringOfIntegers(K))), Ring.carrier(integerRing), Ring.carrier(subringRing(K, ringOfIntegers(K))), Ring.carrier(K) with gF, idF
  have ext : intCastMap(subringRing(K, ringOfIntegers(K))) = compose(identity(ringOfIntegers(K)), intCastMap(subringRing(K, ringOfIntegers(K))), Ring.carrier(integerRing), Ring.carrier(subringRing(K, ringOfIntegers(K))), Ring.carrier(K))
    apply FunctionBetween.ext with gK, compF
    intros z hz
    have ca := compose.apply at identity(ringOfIntegers(K)), intCastMap(subringRing(K, ringOfIntegers(K))), Ring.carrier(integerRing), Ring.carrier(subringRing(K, ringOfIntegers(K))), Ring.carrier(K), z with gF, idF, hz
    have v := FunctionBetween.apply_closed with gF1, hz
    have ia := identity.apply at intCastMap(subringRing(K, ringOfIntegers(K)))(z), ringOfIntegers(K) with v
    rw [ca, ia]
  have e : intCastMap(subringRing(K, ringOfIntegers(K))) = intCastMap(K)
    rw ext
    exact u
  have alg := integerAlgebra.algebra at K with kc
  have ic2 := integralClosure.is_integral_closure at integerAlgebra(K) with alg
  have roi : integralClosure(integerAlgebra(K)) = ringOfIntegers(K) by unfold ringOfIntegers; rfl
  have bK : Algebra.base(integerAlgebra(K)) = integerRing by simp [integerAlgebra, Algebra.mk.base]
  have rK : Algebra.ring(integerAlgebra(K)) = K by simp [integerAlgebra, Algebra.mk.ring]
  have mK : Algebra.map(integerAlgebra(K)) = intCastMap(K) by simp [integerAlgebra, Algebra.mk.map]
  have target : ringOfIntegersAlgebra(K) = Algebra.mk(Algebra.base(integerAlgebra(K)), subringRing(Algebra.ring(integerAlgebra(K)), integralClosure(integerAlgebra(K))), Algebra.map(integerAlgebra(K)))
    rw [bK, rK, mK, roi]
    unfold ringOfIntegersAlgebra
    unfold ringOfIntegersRing
    unfold integerAlgebra
    rw e
  rw ← roi
  rw target
  exact ic2


-- NumberField.RingOfIntegers.ext, coe_injective: equality in 𝓞 K is
-- equality in K, and its operations are those of K.
theorem ringOfIntegersRing.carrier
  shows Ring.carrier(ringOfIntegersRing(K)) = ringOfIntegers(K)
proof
  unfold ringOfIntegersRing
  exact subringRing.carrierOf

-- NumberField.RingOfIntegers.isUnit_norm: x is a unit of 𝓞 K exactly when
-- its norm is ±1.
theorem ringOfIntegers.unit_iff_norm (x : Set)
  requires member : x ∈ ringOfIntegers(K)
  shows RingUnit(ringOfIntegersRing(K), x) ↔
    (integerNorm(K, x) = integerOne ∨ integerNorm(K, x) = integerNeg(integerOne))
proof
  sorry

-- Algebra.coe_norm_int: the norm of an algebraic integer is the integer
-- norm, cast to ℚ.
theorem fieldNorm.of_integer (x : Set)
  requires member : x ∈ ringOfIntegers(K)
  shows integerNorm(K, x) ∈ ℤ ∧
    fieldNorm(K, x) = intCastMap(rationalRing)(integerNorm(K, x))
proof
  sorry

-- Algebra.coe_trace_int
theorem fieldTrace.of_integer (x : Set)
  requires member : x ∈ ringOfIntegers(K)
  shows integerTrace(K, x) ∈ ℤ ∧
    fieldTrace(K, x) = intCastMap(rationalRing)(integerTrace(K, x))
proof
  sorry

-- Algebra.norm_eq_prod_automorphisms: for K Galois over ℚ, N(x) is the
-- product of the conjugates σ(x).
theorem fieldNorm.prod_automorphisms (x : K)
  requires galois : GaloisNumberField(K)
  shows ratCastMap(K)(fieldNorm(K, x)) =
    finiteRingProduct(fieldAutomorphisms(K), Ring.carrier(K), Ring.add(K),
      Ring.zero(K), Ring.neg(K), Ring.mul(K), Ring.one(K),
      automorphismValues(K, x))
proof
  sorry

-- Algebra.trace_eq_sum_automorphisms
theorem fieldTrace.sum_automorphisms (x : K)
  requires galois : GaloisNumberField(K)
  shows ratCastMap(K)(fieldTrace(K, x)) =
    finiteRingSum(fieldAutomorphisms(K), Ring.carrier(K), Ring.add(K),
      Ring.zero(K), Ring.neg(K), Ring.mul(K), Ring.one(K),
      automorphismValues(K, x))
proof
  sorry

end RingOfIntegers

-- Helper: a ring homomorphism is a homomorphism of ℤ-algebras.
theorem tkF.integerAlgebra.hom (K L f : Set)
  requires source : CommRing(K)
  requires target : CommRing(L)
  requires hom : RingHom(f, K, L)
  shows AlgebraHom(f, integerAlgebra(K), integerAlgebra(L))
proof
  have algK := integerAlgebra.algebra at K with source
  have algL := integerAlgebra.algebra at L with target
  have ir := integerRing.comm_ring at 0
  have ic := ir.left
  have hK := intCastMap.ring_hom at K with source
  have comp := RingHom.comp at intCastMap(K), f, integerRing, K, L with ic, hK, hom
  have u := intCastMap.unique at L, compose(f, intCastMap(K), Ring.carrier(integerRing), Ring.carrier(K), Ring.carrier(L)) with target, comp
  have hK0 := hK
  obtain ⟨_, _, fK, _⟩ := hK0
  have hom0 := hom
  obtain ⟨_, _, ff, _⟩ := hom0
  have bK : Algebra.base(integerAlgebra(K)) = integerRing by simp [integerAlgebra, Algebra.mk.base]
  have bL : Algebra.base(integerAlgebra(L)) = integerRing by simp [integerAlgebra, Algebra.mk.base]
  have rK : Algebra.ring(integerAlgebra(K)) = K by simp [integerAlgebra, Algebra.mk.ring]
  have rL : Algebra.ring(integerAlgebra(L)) = L by simp [integerAlgebra, Algebra.mk.ring]
  have mK : Algebra.map(integerAlgebra(K)) = intCastMap(K) by simp [integerAlgebra, Algebra.mk.map]
  have mL : Algebra.map(integerAlgebra(L)) = intCastMap(L) by simp [integerAlgebra, Algebra.mk.map]
  have be : Algebra.base(integerAlgebra(K)) = Algebra.base(integerAlgebra(L))
    rw [bK, bL]
  have rh : RingHom(f, Algebra.ring(integerAlgebra(K)), Algebra.ring(integerAlgebra(L)))
    rw [rK, rL]
    exact hom
  have cm : ∀ a ∈ Ring.carrier(Algebra.base(integerAlgebra(K))), f(Algebra.map(integerAlgebra(K))(a)) = Algebra.map(integerAlgebra(L))(a)
    intros a ha
    rw bK at ha
    rw [mK, mL]
    have ca := compose.apply at f, intCastMap(K), Ring.carrier(integerRing), Ring.carrier(K), Ring.carrier(L), a with fK, ff, ha
    rw u at ca
    rw ca
  unfold AlgebraHom
  exact ⟨algK, algL, be, rh, cm⟩


-- NumberField.RingOfIntegers.map: a ring homomorphism of number fields
-- maps algebraic integers to algebraic integers.
theorem ringOfIntegers.map_mem (K L f x : Set)
  requires source : NumberField(K)
  requires target : NumberField(L)
  requires hom : RingHom(f, K, L)
  requires member : x ∈ ringOfIntegers(K)
  shows f(x) ∈ ringOfIntegers(L)
proof
  have sk := source
  obtain ⟨fk, _⟩ := sk
  have tl := target
  obtain ⟨fl, _⟩ := tl
  have kc := Field.to_comm_ring at K with fk
  have lc := Field.to_comm_ring at L with fl
  have ah := tkF.integerAlgebra.hom at K, L, f with kc, lc, hom
  have ie := (ringOfIntegers.mem_iff at K, x with fk, source).forward with member
  have ie2 := IntegralElement.map at integerAlgebra(K), integerAlgebra(L), f, x with ah, ie
  exact (ringOfIntegers.mem_iff at L, f(x) with fl, target).backward with ie2


-- Helpers: the operations of a subring agree with those of the ring, and
-- a ring homomorphism of number fields restricts to the rings of integers.
theorem tkF.subring.op_values (R S x y : Set)
  requires comm : CommRing(R)
  requires subring : Subring(R, S)
  requires first : x ∈ S
  requires second : y ∈ S
  shows call2(Ring.add(subringRing(R, S)), x, y) = call2(Ring.add(R), x, y) ∧
    call2(Ring.mul(subringRing(R, S)), x, y) = call2(Ring.mul(R), x, y) ∧
    Ring.one(subringRing(R, S)) = Ring.one(R)
proof
  have sc := subringRing.comm_ring at R, S with comm, subring
  have incl := Subring.inclusion at R, S with comm, subring
  have c := subringRing.carrierOf at R, S
  have hx : x ∈ Ring.carrier(subringRing(R, S))
    rw c
    exact first
  have hy : y ∈ Ring.carrier(subringRing(R, S))
    rw c
    exact second
  have sIn : call2(Ring.add(subringRing(R, S)), x, y) ∈ S
    have t : call2(Ring.add(subringRing(R, S)), x, y) ∈ Ring.carrier(subringRing(R, S)) by typecheck
    rw c at t
    exact t
  have pIn : call2(Ring.mul(subringRing(R, S)), x, y) ∈ S
    have t : call2(Ring.mul(subringRing(R, S)), x, y) ∈ Ring.carrier(subringRing(R, S)) by typecheck
    rw c at t
    exact t
  have ma := RingHom.map_add at identity(S), subringRing(R, S), R, x, y with incl, hx, hy
  have mm := RingHom.map_mul at identity(S), subringRing(R, S), R, x, y with incl, hx, hy
  have i1 := identity.apply at call2(Ring.add(subringRing(R, S)), x, y), S with sIn
  have i2 := identity.apply at call2(Ring.mul(subringRing(R, S)), x, y), S with pIn
  have i3 := identity.apply at x, S with first
  have i4 := identity.apply at y, S with second
  rw [i1, i3, i4] at ma
  rw [i2, i3, i4] at mm
  have o : Ring.one(subringRing(R, S)) = Ring.one(R) by simp [subringRing, Ring.mk.one]
  exact ⟨ma, mm, o⟩


theorem tkF.ringOfIntegersMap.hom (K L f : Set)
  requires source : NumberField(K)
  requires target : NumberField(L)
  requires hom : RingHom(f, K, L)
  shows RingHom(ringOfIntegersMap(f, K), ringOfIntegersRing(K), ringOfIntegersRing(L))
proof
  have sk := source
  obtain ⟨fk, _⟩ := sk
  have tl := target
  obtain ⟨fl, _⟩ := tl
  have kc := Field.to_comm_ring at K with fk
  have lc := Field.to_comm_ring at L with fl
  have subK := ringOfIntegers.subring at K with fk, source
  have subL := ringOfIntegers.subring at L with fl, target
  have scK := subringRing.comm_ring at K, ringOfIntegers(K) with kc, subK
  have scL := subringRing.comm_ring at L, ringOfIntegers(L) with lc, subL
  have cK := ringOfIntegersRing.carrier at K with fk, source
  have cL := ringOfIntegersRing.carrier at L with fl, target
  have hom0 := hom
  obtain ⟨_, _, ff, _⟩ := hom0
  have ksub := subK.left
  have closed : ∀ x ∈ ringOfIntegers(K), f(x) ∈ ringOfIntegers(L)
    intros x hx
    exact ringOfIntegers.map_mem at K, L, f, x with source, target, hom, hx
  have gF := restrict.function at f, Ring.carrier(K), Ring.carrier(L), ringOfIntegers(K), ringOfIntegers(L) with ff, ksub, closed
  have gv : ∀ x ∈ ringOfIntegers(K), ringOfIntegersMap(f, K)(x) = f(x)
    intros x hx
    unfold ringOfIntegersMap
    exact restrict.apply at f, Ring.carrier(K), Ring.carrier(L), ringOfIntegers(K), ringOfIntegers(L), x with ff, ksub, closed, hx
  unfold ringOfIntegersRing
  apply RingHom.mk at ringOfIntegersMap(f, K), subringRing(K, ringOfIntegers(K)), subringRing(L, ringOfIntegers(L)) with scK, scL
  . have c1 := subringRing.carrierOf at K, ringOfIntegers(K)
    have c2 := subringRing.carrierOf at L, ringOfIntegers(L)
    rw [c1, c2]
    unfold ringOfIntegersMap
    exact gF
  . intros x hx y hy
    have c1 := subringRing.carrierOf at K, ringOfIntegers(K)
    rw c1 at hx
    rw c1 at hy
    have ops := tkF.subring.op_values at K, ringOfIntegers(K), x, y with kc, subK, hx, hy
    obtain ⟨oa, _, _⟩ := ops
    have fx := closed with x, hx
    have fy := closed with y, hy
    have opsL := tkF.subring.op_values at L, ringOfIntegers(L), f(x), f(y) with lc, subL, fx, fy
    obtain ⟨la, _, _⟩ := opsL
    have xK := ksub with x, hx
    have yK := ksub with y, hy
    have sIn : call2(Ring.add(K), x, y) ∈ ringOfIntegers(K)
      exact subK.right.right.right.right.left with x, hx, y, hy
    rw [oa, (gv with sIn), (gv with hx), (gv with hy), la]
    exact RingHom.map_add at f, K, L, x, y with hom, xK, yK
  . intros x hx y hy
    have c1 := subringRing.carrierOf at K, ringOfIntegers(K)
    rw c1 at hx
    rw c1 at hy
    have ops := tkF.subring.op_values at K, ringOfIntegers(K), x, y with kc, subK, hx, hy
    obtain ⟨_, om, _⟩ := ops
    have fx := closed with x, hx
    have fy := closed with y, hy
    have opsL := tkF.subring.op_values at L, ringOfIntegers(L), f(x), f(y) with lc, subL, fx, fy
    obtain ⟨_, lm, _⟩ := opsL
    have xK := ksub with x, hx
    have yK := ksub with y, hy
    have pIn : call2(Ring.mul(K), x, y) ∈ ringOfIntegers(K)
      exact subK.right.right.right.right.right with x, hx, y, hy
    rw [om, (gv with pIn), (gv with hx), (gv with hy), lm]
    exact RingHom.map_mul at f, K, L, x, y with hom, xK, yK
  . have o1 : Ring.one(subringRing(K, ringOfIntegers(K))) = Ring.one(K) by simp [subringRing, Ring.mk.one]
    have o2 : Ring.one(subringRing(L, ringOfIntegers(L))) = Ring.one(L) by simp [subringRing, Ring.mk.one]
    have oIn := subK.right.right.left
    rw [o1, o2, (gv with oIn)]
    exact RingHom.map_one at f, K, L with hom


-- 𝓞 L is an 𝓞 K-algebra along f, finite free over 𝓞 K when it is so over
-- ℤ (Module.Finite (𝓞 K) (𝓞 L)).
theorem ringOfIntegersExtension.algebra (K L f : Set)
  requires source : NumberField(K)
  requires target : NumberField(L)
  requires hom : RingHom(f, K, L)
  shows Algebra(ringOfIntegersExtension(f, K, L)) ∧
    FiniteAlgebra(ringOfIntegersExtension(f, K, L))
proof
  have sk := source
  obtain ⟨fk, _⟩ := sk
  have tl := target
  obtain ⟨fl, _⟩ := tl
  have kc := Field.to_comm_ring at K with fk
  have lc := Field.to_comm_ring at L with fl
  have subK := ringOfIntegers.subring at K with fk, source
  have subL := ringOfIntegers.subring at L with fl, target
  have scK : CommRing(ringOfIntegersRing(K))
    unfold ringOfIntegersRing
    exact subringRing.comm_ring at K, ringOfIntegers(K) with kc, subK
  have scL : CommRing(ringOfIntegersRing(L))
    unfold ringOfIntegersRing
    exact subringRing.comm_ring at L, ringOfIntegers(L) with lc, subL
  have rkRing := CommRing.to_ring with scK
  have gh := tkF.ringOfIntegersMap.hom at K, L, f with source, target, hom
  have alg : Algebra(ringOfIntegersExtension(f, K, L))
    unfold ringOfIntegersExtension
    exact Algebra.intro with scK, scL, gh
  have bE : Algebra.base(ringOfIntegersExtension(f, K, L)) = ringOfIntegersRing(K) by simp [ringOfIntegersExtension, Algebra.mk.base]
  have rE : Algebra.ring(ringOfIntegersExtension(f, K, L)) = ringOfIntegersRing(L) by simp [ringOfIntegersExtension, Algebra.mk.ring]
  have mE : Algebra.map(ringOfIntegersExtension(f, K, L)) = ringOfIntegersMap(f, K) by simp [ringOfIntegersExtension, Algebra.mk.map]
  have algZ := integerAlgebra.algebra at ringOfIntegersRing(L) with scL
  have bZ : Algebra.base(integerAlgebra(ringOfIntegersRing(L))) = integerRing by simp [integerAlgebra, Algebra.mk.base]
  have rZ : Algebra.ring(integerAlgebra(ringOfIntegersRing(L))) = ringOfIntegersRing(L) by simp [integerAlgebra, Algebra.mk.ring]
  have mZ : Algebra.map(integerAlgebra(ringOfIntegersRing(L))) = intCastMap(ringOfIntegersRing(L)) by simp [integerAlgebra, Algebra.mk.map]
  have ceE := algebraModule.carrier_eq at ringOfIntegersExtension(f, K, L)
  have ceZ := algebraModule.carrier_eq at integerAlgebra(ringOfIntegersRing(L))
  have acE : algebraCarrier(ringOfIntegersExtension(f, K, L)) = Ring.carrier(ringOfIntegersRing(L))
    unfold algebraCarrier
    rw rE
  have acZ : algebraCarrier(integerAlgebra(ringOfIntegersRing(L))) = Ring.carrier(ringOfIntegersRing(L))
    unfold algebraCarrier
    rw rZ
  rw acE at ceE
  rw acZ at ceZ
  have aeE := algebraModule.add_eq at ringOfIntegersExtension(f, K, L)
  have aeZ := algebraModule.add_eq at integerAlgebra(ringOfIntegersRing(L))
  rw rE at aeE
  rw rZ at aeZ
  have zeE : Module.zero(algebraModule(ringOfIntegersExtension(f, K, L))) = Ring.zero(Algebra.ring(ringOfIntegersExtension(f, K, L))) by unfold algebraModule; module_projections
  have zeZ : Module.zero(algebraModule(integerAlgebra(ringOfIntegersRing(L)))) = Ring.zero(Algebra.ring(integerAlgebra(ringOfIntegersRing(L)))) by unfold algebraModule; module_projections
  rw rE at zeE
  rw rZ at zeZ
  have modE := algebraModule.module_of at ringOfIntegersExtension(f, K, L) with alg
  rw bE at modE
  have fr := ringOfIntegers.free at L with fl, target
  obtain ⟨I, v, finI, basis⟩ := fr
  obtain ⟨_, spans⟩ := basis
  obtain ⟨modZ, vF, spanZ⟩ := spans
  unfold ringOfIntegersModule at modZ
  unfold ringOfIntegersModule at vF
  unfold ringOfIntegersModule at spanZ
  unfold ringOfIntegersAlgebra at modZ
  unfold ringOfIntegersAlgebra at vF
  unfold ringOfIntegersAlgebra at spanZ
  have S0Z : functionImage(v, I, Module.carrier(algebraModule(integerAlgebra(ringOfIntegersRing(L))))) ⊆ Module.carrier(algebraModule(integerAlgebra(ringOfIntegersRing(L))))
    exact functionImage.subset at v, I, Module.carrier(algebraModule(integerAlgebra(ringOfIntegersRing(L))))
  have S0E : functionImage(v, I, Module.carrier(algebraModule(integerAlgebra(ringOfIntegersRing(L))))) ⊆ Module.carrier(algebraModule(ringOfIntegersExtension(f, K, L)))
    intros y hy
    have yZ := S0Z with y, hy
    rw ceZ at yZ
    rw ceE
    exact yZ
  have refl : I ⊆ I
    intros i hi
    exact hi
  have finS := Finite.function_image at I, Module.carrier(algebraModule(integerAlgebra(ringOfIntegersRing(L)))), v, I with vF, finI, refl
  have subNE := moduleSpan.submodule at ringOfIntegersRing(K), algebraModule(ringOfIntegersExtension(f, K, L)), functionImage(v, I, Module.carrier(algebraModule(integerAlgebra(ringOfIntegersRing(L))))) with rkRing, modE
  have subNE0 := subNE
  obtain ⟨_, Nsub, zN, addN, smulN⟩ := subNE0
  have ir := integerRing.comm_ring at 0
  have ic := ir.left
  have zRing := CommRing.to_ring with ic
  have hKc := intCastMap.ring_hom at ringOfIntegersRing(K) with scK
  have comp := RingHom.comp at intCastMap(ringOfIntegersRing(K)), ringOfIntegersMap(f, K), integerRing, ringOfIntegersRing(K), ringOfIntegersRing(L) with ic, hKc, gh
  have u := intCastMap.unique at ringOfIntegersRing(L), compose(ringOfIntegersMap(f, K), intCastMap(ringOfIntegersRing(K)), Ring.carrier(integerRing), Ring.carrier(ringOfIntegersRing(K)), Ring.carrier(ringOfIntegersRing(L))) with scL, comp
  have hKc0 := hKc
  obtain ⟨_, _, iF, _⟩ := hKc0
  have gh0 := gh
  obtain ⟨_, _, gF, _⟩ := gh0
  have subNZ : SubmoduleOf(moduleSpan(algebraModule(ringOfIntegersExtension(f, K, L)), ringOfIntegersRing(K), functionImage(v, I, Module.carrier(algebraModule(integerAlgebra(ringOfIntegersRing(L)))))), algebraModule(integerAlgebra(ringOfIntegersRing(L))), integerRing)
    unfold SubmoduleOf
    refine ⟨modZ, ?_, ?_, ?_, ?_⟩
    . intros y hy
      have t := Nsub with y, hy
      rw ceE at t
      rw ceZ
      exact t
    . rw zeZ
      rw zeE at zN
      exact zN
    . rw aeZ
      rw aeE at addN
      exact addN
    . intros r hr y hy
      have yE := Nsub with y, hy
      rw ceE at yE
      have yZ : y ∈ algebraCarrier(integerAlgebra(ringOfIntegersRing(L)))
        rw acZ
        exact yE
      have yEx : y ∈ algebraCarrier(ringOfIntegersExtension(f, K, L))
        rw acE
        exact yE
      have rB : r ∈ Ring.carrier(Algebra.base(integerAlgebra(ringOfIntegersRing(L))))
        rw bZ
        exact hr
      have svZ := algebraModule.smul_value at integerAlgebra(ringOfIntegersRing(L)), r, y with algZ, rB, yZ
      rw [mZ, rZ] at svZ
      have tIn : intCastMap(ringOfIntegersRing(K))(r) ∈ Ring.carrier(ringOfIntegersRing(K)) := FunctionBetween.apply_closed with iF, hr
      have tB : intCastMap(ringOfIntegersRing(K))(r) ∈ Ring.carrier(Algebra.base(ringOfIntegersExtension(f, K, L)))
        rw bE
        exact tIn
      have svE := algebraModule.smul_value at ringOfIntegersExtension(f, K, L), intCastMap(ringOfIntegersRing(K))(r), y with alg, tB, yEx
      rw [mE, rE] at svE
      have ca := compose.apply at ringOfIntegersMap(f, K), intCastMap(ringOfIntegersRing(K)), Ring.carrier(integerRing), Ring.carrier(ringOfIntegersRing(K)), Ring.carrier(ringOfIntegersRing(L)), r with iF, gF, hr
      rw u at ca
      rw [svZ, ca, ← svE]
      have s1 := smulN with tIn
      exact s1 with hy
  have inSpan := moduleSpan.subset_span at ringOfIntegersRing(K), algebraModule(ringOfIntegersExtension(f, K, L)), functionImage(v, I, Module.carrier(algebraModule(integerAlgebra(ringOfIntegersRing(L))))) with rkRing, modE, S0E
  have least := (moduleSpan.least at integerRing, algebraModule(integerAlgebra(ringOfIntegersRing(L))), functionImage(v, I, Module.carrier(algebraModule(integerAlgebra(ringOfIntegersRing(L))))), moduleSpan(algebraModule(ringOfIntegersExtension(f, K, L)), ringOfIntegersRing(K), functionImage(v, I, Module.carrier(algebraModule(integerAlgebra(ringOfIntegersRing(L)))))) with zRing, modZ, S0Z, subNZ).backward with inSpan
  rw spanZ at least
  have eq : moduleSpan(algebraModule(ringOfIntegersExtension(f, K, L)), ringOfIntegersRing(K), functionImage(v, I, Module.carrier(algebraModule(integerAlgebra(ringOfIntegersRing(L)))))) = Module.carrier(algebraModule(ringOfIntegersExtension(f, K, L)))
    ext y
    constructor
    . intro hy
      exact Nsub with y, hy
    . intro hy
      have yZ : y ∈ Module.carrier(algebraModule(integerAlgebra(ringOfIntegersRing(L))))
        rw ceZ
        rw ceE at hy
        exact hy
      exact least with y, yZ
  have fg : FinitelyGeneratedModule(algebraModule(ringOfIntegersExtension(f, K, L)), ringOfIntegersRing(K))
    unfold FinitelyGeneratedModule
    exact ⟨modE, functionImage(v, I, Module.carrier(algebraModule(integerAlgebra(ringOfIntegersRing(L))))), S0E, finS, eq⟩
  have fa : FiniteAlgebra(ringOfIntegersExtension(f, K, L))
    unfold FiniteAlgebra
    rw bE
    exact ⟨alg, fg⟩
  exact ⟨alg, fa⟩


-- Helper: the trace of an endomorphism does not depend on the basis.
theorem tkF.matTrace.basis_independent (R M f I b J c : Set)
  requires ring : CommRing(R)
  requires finiteI : Finite(I)
  requires finiteJ : Finite(J)
  requires basisB : ModuleBasis(M, R, I, b)
  requires basisC : ModuleBasis(M, R, J, c)
  requires linear : LinearMap(f, M, R, M)
  shows matTrace(R, J, linearToMatrix(M, R, M, J, c, J, c, f)) =
    matTrace(R, I, linearToMatrix(M, R, M, I, b, I, b, f))
proof
  have basis0 := basisB
  obtain ⟨_, spans⟩ := basis0
  obtain ⟨module, _, _⟩ := spans
  have identityLinear := LinearMap.identity at M, R with module
  have matrixB := linearToMatrix.mem at R, M, M, I, b, I, b, f with ring, finiteI, finiteI, basisB, basisB, linear
  have matrixP := linearToMatrix.mem at R, M, M, I, b, J, c, identity(Module.carrier(M)) with ring, finiteI, finiteJ, basisB, basisC, identityLinear
  have matrixQ := linearToMatrix.mem at R, M, M, J, c, I, b, identity(Module.carrier(M)) with ring, finiteJ, finiteI, basisC, basisB, identityLinear
  have change := linearToMatrix.change_of_basis at R, M, I, b, J, c, f with ring, finiteI, finiteJ, basisB, basisC, linear
  have composed := linearToMatrix.compose at R, M, M, M, I, b, J, c, I, b, identity(Module.carrier(M)), identity(Module.carrier(M)) with ring, finiteI, finiteJ, finiteI, basisB, basisC, basisB, identityLinear, identityLinear
  have identityFunction := identity.function at Module.carrier(M)
  have collapse := compose.identity_left at identity(Module.carrier(M)), Module.carrier(M), Module.carrier(M) with identityFunction
  rw collapse at composed
  have unitI := linearToMatrix.identity at R, M, I, b with ring, finiteI, basisB
  rw unitI at composed
  have bq := matMul.mem at R, I, I, J, linearToMatrix(M, R, M, I, b, I, b, f), linearToMatrix(M, R, M, J, c, I, b, identity(Module.carrier(M))) with ring, finiteI, matrixB, matrixQ
  have mc := matTrace.mul_comm at R, J, I, linearToMatrix(M, R, M, I, b, J, c, identity(Module.carrier(M))), matMul(R, I, I, J, linearToMatrix(M, R, M, I, b, I, b, f), linearToMatrix(M, R, M, J, c, I, b, identity(Module.carrier(M)))) with ring, finiteJ, finiteI, matrixP, bq
  have assoc := matMul.assoc at R, I, I, J, I, linearToMatrix(M, R, M, I, b, I, b, f), linearToMatrix(M, R, M, J, c, I, b, identity(Module.carrier(M))), linearToMatrix(M, R, M, I, b, J, c, identity(Module.carrier(M))) with ring, finiteI, finiteJ, matrixB, matrixQ, matrixP
  have one := matMul.one_right at R, I, I, linearToMatrix(M, R, M, I, b, I, b, f) with ring, finiteI, matrixB
  rw ← change
  rw [mc, assoc, ← composed, one]


-- Section: Laws of the norm and the trace of a finite free algebra
section NormTrace
variable (A : Set)
hypothesis free : FiniteFreeAlgebra(A)

-- LinearMap.trace_eq_matrix_trace: the trace in any finite basis.
theorem algebraTrace.of_basis (x I b : Set)
  requires member : x ∈ algebraCarrier(A)
  requires finite : Finite(I)
  requires basis : ModuleBasis(algebraModule(A), Algebra.base(A), I, b)
  shows algebraTrace(A, x) = matTrace(Algebra.base(A), I,
    linearToMatrix(algebraModule(A), Algebra.base(A), algebraModule(A), I, b,
      I, b, algebraMultiplication(A, x)))
proof
  obtain ⟨alg, freeM⟩ := free
  have bc := Algebra.base_comm_ring with alg
  have lin := algebraMultiplication.linear at A, x with alg, member
  have sel := linearTrace.selected at algebraModule(A), Algebra.base(A), algebraMultiplication(A, x) with bc, freeM, lin
  obtain ⟨_, J, c, finiteJ, basisC, eq⟩ := sel
  have bi := tkF.matTrace.basis_independent at Algebra.base(A), algebraModule(A), algebraMultiplication(A, x), I, b, J, c with bc, finite, finiteJ, basis, basisC, lin
  unfold algebraTrace
  rw eq
  exact bi


-- Algebra.norm_eq_matrix_det (LinearMap.det_toMatrix): the norm is the
-- determinant of the multiplication matrix in any finite basis.
theorem algebraNorm.of_basis (x I b : Set)
  requires member : x ∈ algebraCarrier(A)
  requires finite : Finite(I)
  requires basis : ModuleBasis(algebraModule(A), Algebra.base(A), I, b)
  shows algebraNorm(A, x) = matDet(Algebra.base(A), I,
    linearToMatrix(algebraModule(A), Algebra.base(A), algebraModule(A), I, b,
      I, b, algebraMultiplication(A, x)))
proof
  obtain ⟨alg, freeM⟩ := free
  have bc := Algebra.base_comm_ring with alg
  have lin := algebraMultiplication.linear at A, x with alg, member
  unfold algebraNorm
  exact linearDet.of_basis at Algebra.base(A), algebraModule(A), algebraMultiplication(A, x), I, b with bc, freeM, lin, finite, basis


theorem algebraNorm.mem (x : Set)
  requires member : x ∈ algebraCarrier(A)
  shows algebraNorm(A, x) ∈ Ring.carrier(Algebra.base(A))
proof
  obtain ⟨alg, freeM⟩ := free
  have bc := Algebra.base_comm_ring with alg
  have lin := algebraMultiplication.linear at A, x with alg, member
  have sel := linearDet.selected at algebraModule(A), Algebra.base(A), algebraMultiplication(A, x) with bc, freeM, lin
  unfold algebraNorm
  exact sel.left


theorem algebraTrace.mem (x : Set)
  requires member : x ∈ algebraCarrier(A)
  shows algebraTrace(A, x) ∈ Ring.carrier(Algebra.base(A))
proof
  obtain ⟨alg, freeM⟩ := free
  have bc := Algebra.base_comm_ring with alg
  have lin := algebraMultiplication.linear at A, x with alg, member
  have sel := linearTrace.selected at algebraModule(A), Algebra.base(A), algebraMultiplication(A, x) with bc, freeM, lin
  unfold algebraTrace
  exact sel.left


-- map_mul (Algebra.norm is a monoid homomorphism)
theorem algebraNorm.mul (x y : Set)
  requires first : x ∈ algebraCarrier(A)
  requires second : y ∈ algebraCarrier(A)
  shows algebraNorm(A, call2(Ring.mul(Algebra.ring(A)), x, y)) =
    call2(Ring.mul(Algebra.base(A)), algebraNorm(A, x), algebraNorm(A, y))
proof
  obtain ⟨alg, freeM⟩ := free
  have bc := Algebra.base_comm_ring with alg
  have ac := Algebra.comm_ring with alg
  have ce := algebraModule.carrier_eq at A
  have xR : x ∈ Ring.carrier(Algebra.ring(A))
    unfold algebraCarrier at first
    exact first
  have yR : y ∈ Ring.carrier(Algebra.ring(A))
    unfold algebraCarrier at second
    exact second
  have xyA : call2(Ring.mul(Algebra.ring(A)), x, y) ∈ algebraCarrier(A)
    unfold algebraCarrier
    typecheck
  have linx := algebraMultiplication.linear at A, x with alg, first
  have liny := algebraMultiplication.linear at A, y with alg, second
  have comp := linearDet.compose at Algebra.base(A), algebraModule(A), algebraMultiplication(A, y), algebraMultiplication(A, x) with bc, freeM, liny, linx
  rw ce at comp
  have vals : ∀ a ∈ algebraCarrier(A), ∀ b ∈ algebraCarrier(A), call2(Ring.mul(Algebra.ring(A)), a, b) ∈ algebraCarrier(A)
    intros a ha b hb
    have aR : a ∈ Ring.carrier(Algebra.ring(A))
      unfold algebraCarrier at ha
      exact ha
    have bR : b ∈ Ring.carrier(Algebra.ring(A))
      unfold algebraCarrier at hb
      exact hb
    unfold algebraCarrier
    typecheck
  have fx := algebraMultiplication.graph_function at A, x with (vals with first)
  have fy := algebraMultiplication.graph_function at A, y with (vals with second)
  have fxy := algebraMultiplication.graph_function at A, call2(Ring.mul(Algebra.ring(A)), x, y) with (vals with xyA)
  have fc := compose.function at algebraMultiplication(A, x), algebraMultiplication(A, y), algebraCarrier(A), algebraCarrier(A), algebraCarrier(A) with fy, fx
  have e : algebraMultiplication(A, call2(Ring.mul(Algebra.ring(A)), x, y)) = compose(algebraMultiplication(A, x), algebraMultiplication(A, y), algebraCarrier(A), algebraCarrier(A), algebraCarrier(A))
    apply FunctionBetween.ext with fxy, fc
    intros b hb
    have bR : b ∈ Ring.carrier(Algebra.ring(A))
      unfold algebraCarrier at hb
      exact hb
    have ybA : call2(Ring.mul(Algebra.ring(A)), y, b) ∈ algebraCarrier(A)
      unfold algebraCarrier
      typecheck
    have c := compose.apply at algebraMultiplication(A, x), algebraMultiplication(A, y), algebraCarrier(A), algebraCarrier(A), algebraCarrier(A), b with fy, fx, hb
    have v1 := algebraMultiplication.value at A, call2(Ring.mul(Algebra.ring(A)), x, y), b with alg, xyA, hb
    have v2 := algebraMultiplication.value at A, y, b with alg, second, hb
    have v3 := algebraMultiplication.value at A, x, call2(Ring.mul(Algebra.ring(A)), y, b) with alg, first, ybA
    rw [c, v1, v2, v3]
    ring
  unfold algebraNorm
  rw e
  exact comp


-- map_one
theorem algebraNorm.one
  shows algebraNorm(A, Ring.one(Algebra.ring(A))) = Ring.one(Algebra.base(A))
proof
  obtain ⟨alg, freeM⟩ := free
  have bc := Algebra.base_comm_ring with alg
  have ac := Algebra.comm_ring with alg
  have ce := algebraModule.carrier_eq at A
  have oneR : Ring.one(Algebra.ring(A)) ∈ Ring.carrier(Algebra.ring(A)) by typecheck
  have oneA : Ring.one(Algebra.ring(A)) ∈ algebraCarrier(A)
    unfold algebraCarrier
    exact oneR
  have values : ∀ b ∈ algebraCarrier(A), call2(Ring.mul(Algebra.ring(A)), Ring.one(Algebra.ring(A)), b) ∈ algebraCarrier(A)
    intros b hb
    have bR : b ∈ Ring.carrier(Algebra.ring(A))
      unfold algebraCarrier at hb
      exact hb
    unfold algebraCarrier
    typecheck
  have mf := algebraMultiplication.graph_function at A, Ring.one(Algebra.ring(A)) with values
  have idf := identity.function at algebraCarrier(A)
  have e : algebraMultiplication(A, Ring.one(Algebra.ring(A))) = identity(algebraCarrier(A))
    apply FunctionBetween.ext with mf, idf
    intros b hb
    have v := algebraMultiplication.value at A, Ring.one(Algebra.ring(A)), b with alg, oneA, hb
    have i := identity.apply at b, algebraCarrier(A) with hb
    have bR : b ∈ Ring.carrier(Algebra.ring(A))
      unfold algebraCarrier at hb
      exact hb
    rw [v, i]
    ring
  have idd := linearDet.identity at Algebra.base(A), algebraModule(A) with bc, freeM
  rw ce at idd
  unfold algebraNorm
  rw e
  exact idd


-- Algebra.norm_algebraMap: N(a) = a^[A : R] for a in the base.
theorem algebraNorm.algebraMap (a : Set)
  requires member : a ∈ Ring.carrier(Algebra.base(A))
  shows algebraNorm(A, Algebra.map(A)(a)) = Ring.pow(Algebra.base(A), a,
    finrank(algebraModule(A), Algebra.base(A)))
proof
  sorry

-- map_add (Algebra.trace is linear)
theorem algebraTrace.add (x y : Set)
  requires first : x ∈ algebraCarrier(A)
  requires second : y ∈ algebraCarrier(A)
  shows algebraTrace(A, call2(Ring.add(Algebra.ring(A)), x, y)) =
    call2(Ring.add(Algebra.base(A)), algebraTrace(A, x), algebraTrace(A, y))
proof
  sorry

-- map_smul: Tr(a x) = a Tr(x) for a in the base.
theorem algebraTrace.smul (a x : Set)
  requires scalar : a ∈ Ring.carrier(Algebra.base(A))
  requires member : x ∈ algebraCarrier(A)
  shows algebraTrace(A, call2(Ring.mul(Algebra.ring(A)), Algebra.map(A)(a), x)) =
    call2(Ring.mul(Algebra.base(A)), a, algebraTrace(A, x))
proof
  sorry

-- Algebra.trace_algebraMap: Tr(a) = [A : R] · a.
theorem algebraTrace.algebraMap (a : Set)
  requires member : a ∈ Ring.carrier(Algebra.base(A))
  shows algebraTrace(A, Algebra.map(A)(a)) =
    call2(Ring.mul(Algebra.base(A)),
      natCast(Algebra.base(A), finrank(algebraModule(A), Algebra.base(A))), a)
proof
  sorry

-- Algebra.norm_eq_of_algEquiv, trace_eq_of_algEquiv: invariance under an
-- isomorphism of algebras.
theorem algebraNorm.of_iso (B e x : Set)
  requires other : FiniteFreeAlgebra(B)
  requires iso : AlgebraIso(e, A, B)
  requires member : x ∈ algebraCarrier(A)
  shows algebraNorm(B, e(x)) = algebraNorm(A, x) ∧
    algebraTrace(B, e(x)) = algebraTrace(A, x)
proof
  sorry

end NormTrace

-- Section: Norm and trace of field extensions
section FieldExtension
variable (K L f : Set)
hypothesis base : Field(K)
hypothesis field : Field(L)
hypothesis hom : RingHom(f, K, L)
hypothesis finite : FiniteDimensional(algebraModule(Algebra.mk(K, L, f)), K)

-- A finite field extension is a finite free algebra.
theorem FiniteFreeAlgebra.of_field_extension
  shows FiniteFreeAlgebra(Algebra.mk(K, L, f))
proof
  have kc := Field.to_comm_ring at K with base
  have lc := Field.to_comm_ring at L with field
  have alg : Algebra(Algebra.mk(K, L, f)) := Algebra.intro with kc, lc, hom
  have bs : Algebra.base(Algebra.mk(K, L, f)) = K by simp [Algebra.mk.base]
  have module := algebraModule.module_of at Algebra.mk(K, L, f) with alg
  rw bs at module
  have free := FiniteDimensional.finite_free at K, algebraModule(Algebra.mk(K, L, f)) with base, module, finite
  unfold FiniteFreeAlgebra
  rw bs
  exact ⟨alg, free⟩


-- Algebra.norm_eq_zero_iff: in a field extension N(x) = 0 only for x = 0.
theorem algebraNorm.eq_zero_iff (x : L)
  shows algebraNorm(Algebra.mk(K, L, f), x) = Ring.zero(K) ↔ x = Ring.zero(L)
proof
  have kc := Field.to_comm_ring at K with base
  have lc := Field.to_comm_ring at L with field
  have ff := FiniteFreeAlgebra.of_field_extension at K, L, f with base, field, hom, finite
  have ff0 := ff
  obtain ⟨alg, freeM⟩ := ff0
  have bs : Algebra.base(Algebra.mk(K, L, f)) = K by simp [Algebra.mk.base]
  have rr : Algebra.ring(Algebra.mk(K, L, f)) = L by simp [Algebra.mk.ring]
  have ac : algebraCarrier(Algebra.mk(K, L, f)) = Ring.carrier(L)
    unfold algebraCarrier
    rw rr
  have ce := algebraModule.carrier_eq at Algebra.mk(K, L, f)
  rw ac at ce
  have xR : x ∈ Ring.carrier(L) by typecheck
  have xA : x ∈ algebraCarrier(Algebra.mk(K, L, f))
    rw ac
    exact xR
  have nIn := algebraNorm.mem at Algebra.mk(K, L, f), x with ff, xA
  rw bs at nIn
  rw bs at freeM
  have lin := algebraMultiplication.linear at Algebra.mk(K, L, f), x with alg, xA
  rw bs at lin
  have ui := linearDet.unit_iff at K, algebraModule(Algebra.mk(K, L, f)), algebraMultiplication(Algebra.mk(K, L, f), x) with kc, freeM, lin
  have fu := Field.unit_iff at K, algebraNorm(Algebra.mk(K, L, f), x) with base, nIn
  have vals : ∀ b ∈ algebraCarrier(Algebra.mk(K, L, f)), call2(Ring.mul(Algebra.ring(Algebra.mk(K, L, f))), x, b) ∈ algebraCarrier(Algebra.mk(K, L, f))
    intros b hb
    rw ac at hb
    rw [ac, rr]
    typecheck
  have mF := algebraMultiplication.graph_function at Algebra.mk(K, L, f), x with vals
  rw ac at mF
  have val : ∀ b ∈ Ring.carrier(L), algebraMultiplication(Algebra.mk(K, L, f), x)(b) = call2(Ring.mul(L), x, b)
    intros b hb
    have bA : b ∈ algebraCarrier(Algebra.mk(K, L, f))
      rw ac
      exact hb
    have v := algebraMultiplication.value at Algebra.mk(K, L, f), x, b with alg, xA, bA
    rw rr at v
    exact v
  have ld := Field.domain at L with field
  obtain ⟨_, lnt, lnzd⟩ := ld
  unfold algebraNorm
  rw bs
  unfold algebraNorm at fu
  rw bs at fu
  constructor
  . intro h0
    by_contra xnz
    have inj : InjectiveBetween(algebraMultiplication(Algebra.mk(K, L, f), x), Ring.carrier(L), Ring.carrier(L))
      unfold InjectiveBetween
      refine ⟨mF, ?_⟩
      intros a ha b hb z hz ra rb
      have va := FunctionBetween.apply_value with mF, ha, ra
      have vb := FunctionBetween.apply_value with mF, hb, rb
      rw (val with ha) at va
      rw (val with hb) at vb
      have dIn : Ring.sub(L, a, b) ∈ Ring.carrier(L) by typecheck
      have d : call2(Ring.mul(L), x, Ring.sub(L, a, b)) = Ring.zero(L)
        have e1 : call2(Ring.mul(L), x, Ring.sub(L, a, b)) = Ring.sub(L, call2(Ring.mul(L), x, a), call2(Ring.mul(L), x, b)) by ring
        rw [e1, va, vb]
        ring
      have c1 := lnzd with xR
      have c2 := c1 with dIn, d
      cases c2 with h | h
      . exfalso
        exact xnz with h
      . have e2 : a = call2(Ring.add(L), Ring.sub(L, a, b), b) by ring
        rw [e2, h]
        ring
    have xu := (Field.unit_iff at L, x with field, xR).backward with xnz
    obtain ⟨_, w, wIn, xw, _⟩ := xu
    have surj : SurjectiveBetween(algebraMultiplication(Algebra.mk(K, L, f), x), Ring.carrier(L), Ring.carrier(L))
      unfold SurjectiveBetween
      refine ⟨mF, ?_⟩
      intros y hy
      have aIn : call2(Ring.mul(L), w, y) ∈ Ring.carrier(L) by typecheck
      have r := FunctionBetween.relates_apply at algebraMultiplication(Algebra.mk(K, L, f), x), Ring.carrier(L), Ring.carrier(L), call2(Ring.mul(L), w, y) with mF, aIn
      have e : algebraMultiplication(Algebra.mk(K, L, f), x)(call2(Ring.mul(L), w, y)) = y
        rw (val with aIn)
        have e3 : call2(Ring.mul(L), x, call2(Ring.mul(L), w, y)) = call2(Ring.mul(L), call2(Ring.mul(L), x, w), y) by ring
        rw [e3, xw]
        ring
      rw e at r
      exact ⟨call2(Ring.mul(L), w, y), aIn, r⟩
    have eqv : LinearEquiv(algebraMultiplication(Algebra.mk(K, L, f), x), algebraModule(Algebra.mk(K, L, f)), K, algebraModule(Algebra.mk(K, L, f)))
      unfold LinearEquiv
      rw ce
      exact ⟨lin, ⟨inj, surj⟩⟩
    have u := ui.forward with eqv
    have nz := fu.forward with u
    exact nz with h0
  . intro hx
    by_contra hn
    have u := fu.backward with hn
    have eqv := ui.backward with u
    unfold LinearEquiv at eqv
    rw ce at eqv
    obtain ⟨_, bij⟩ := eqv
    obtain ⟨inj, _⟩ := bij
    have oneL : Ring.one(L) ∈ Ring.carrier(L) by typecheck
    have zeroL : Ring.zero(L) ∈ Ring.carrier(L) by typecheck
    have v1 := val with oneL
    have v0 := val with zeroL
    have same : algebraMultiplication(Algebra.mk(K, L, f), x)(Ring.one(L)) = algebraMultiplication(Algebra.mk(K, L, f), x)(Ring.zero(L))
      rw [v1, v0, hx]
      ring
    have c := Injective.apply_cancel at algebraMultiplication(Algebra.mk(K, L, f), x), Ring.carrier(L), Ring.carrier(L), Ring.one(L), Ring.zero(L) with inj, oneL, zeroL, same
    have c2 : Ring.zero(L) = Ring.one(L) by rw c
    exact lnt with c2


-- Algebra.norm_inv, read multiplicatively: N(x) N(y) = 1 when x y = 1.
theorem algebraNorm.inv (x y : L)
  requires inverse : x * y = Ring.one(L)
  shows call2(Ring.mul(K), algebraNorm(Algebra.mk(K, L, f), x),
    algebraNorm(Algebra.mk(K, L, f), y)) = Ring.one(K)
proof
  sorry



-- Algebra.trace_surjective: in characteristic zero the trace is onto.
theorem algebraTrace.surjective (a : K)
  requires zero : CharZero(K)
  shows ∃ x ∈ Ring.carrier(L), algebraTrace(Algebra.mk(K, L, f), x) = a
proof
  sorry

-- traceForm_nondegenerate: in characteristic zero (x, y) ↦ Tr(x y) is
-- nondegenerate.
theorem algebraTrace.nondegenerate (x : L)
  requires zero : CharZero(K)
  requires pairing : ∀ y ∈ Ring.carrier(L),
    algebraTrace(Algebra.mk(K, L, f), x * y) = Ring.zero(K)
  shows x = Ring.zero(L)
proof
  sorry

-- Algebra.norm_norm and Algebra.trace_trace: transitivity in a tower
-- K → L → M.
theorem algebraNorm.tower (M g x : Set)
  requires top : Field(M)
  requires upper : RingHom(g, L, M)
  requires upperFinite : FiniteDimensional(algebraModule(Algebra.mk(L, M, g)), L)
  requires member : x ∈ Ring.carrier(M)
  shows algebraNorm(Algebra.mk(K, L, f), algebraNorm(Algebra.mk(L, M, g), x)) =
      algebraNorm(Algebra.mk(K, M,
        compose(g, f, Ring.carrier(K), Ring.carrier(L), Ring.carrier(M))), x) ∧
    algebraTrace(Algebra.mk(K, L, f), algebraTrace(Algebra.mk(L, M, g), x)) =
      algebraTrace(Algebra.mk(K, M,
        compose(g, f, Ring.carrier(K), Ring.carrier(L), Ring.carrier(M))), x)
proof
  sorry

end FieldExtension

theorem NumberField.finite_free (K : Set)
  requires numberField : NumberField(K)
  shows FiniteFreeAlgebra(rationalAlgebra(K)) ∧
    FiniteFreeAlgebra(ringOfIntegersAlgebra(K))
proof
  have nf := numberField
  obtain ⟨field, cz, fdim⟩ := nf
  have qf := rationalRing.field
  have qff := qf.left
  have hom := ratCastMap.ring_hom at K with field, cz
  have fdim2 : FiniteDimensional(algebraModule(Algebra.mk(rationalRing, K, ratCastMap(K))), rationalRing)
    unfold rationalModule at fdim
    unfold rationalAlgebra at fdim
    exact fdim
  have ff := FiniteFreeAlgebra.of_field_extension at rationalRing, K, ratCastMap(K) with qff, field, hom, fdim2
  have left : FiniteFreeAlgebra(rationalAlgebra(K))
    unfold rationalAlgebra
    exact ff
  have kc := Field.to_comm_ring at K with field
  have sub := ringOfIntegers.subring at K with field, numberField
  have sc := subringRing.comm_ring at K, ringOfIntegers(K) with kc, sub
  have alg := integerAlgebra.algebra at subringRing(K, ringOfIntegers(K)) with sc
  have fr := ringOfIntegers.free at K with field, numberField
  have b : Algebra.base(ringOfIntegersAlgebra(K)) = integerRing by simp [ringOfIntegersAlgebra, integerAlgebra, Algebra.mk.base]
  have right : FiniteFreeAlgebra(ringOfIntegersAlgebra(K))
    unfold FiniteFreeAlgebra
    rw b
    unfold ringOfIntegersModule at fr
    refine ⟨?_, fr⟩
    unfold ringOfIntegersAlgebra
    unfold ringOfIntegersRing
    exact alg
  exact ⟨left, right⟩

-- Module.finrank_pos
theorem numberFieldDegree.pos (K : Set)
  requires numberField : NumberField(K)
  shows numberFieldDegree(K) ∈ ℕ ∧ 0 < (numberFieldDegree(K):N)
proof
  have nf := numberField
  obtain ⟨field, cz, _⟩ := nf
  have ff := NumberField.finite_free at K with numberField
  obtain ⟨left, _⟩ := ff
  obtain ⟨alg, freeA⟩ := left
  have bs : Algebra.base(rationalAlgebra(K)) = rationalRing by simp [rationalAlgebra, Algebra.mk.base]
  have rr : Algebra.ring(rationalAlgebra(K)) = K by simp [rationalAlgebra, Algebra.mk.ring]
  rw bs at freeA
  have free : FiniteFreeModule(rationalModule(K), rationalRing)
    unfold rationalModule
    exact freeA
  have qf := rationalRing.field
  have qff := qf.left
  have qc := Field.to_comm_ring at rationalRing with qff
  have qd := Field.domain at rationalRing with qff
  obtain ⟨_, qnt, _⟩ := qd
  have kd := Field.domain at K with field
  obtain ⟨_, knt, _⟩ := kd
  have sel := finrank.selected at rationalModule(K), rationalRing with qc, qnt, free
  obtain ⟨nIn, rank⟩ := sel
  have nNat := natural.member at finrank(rationalModule(K), rationalRing) with nIn
  unfold numberFieldDegree
  refine ⟨nIn, ?_⟩
  by_contra h
  have n0 : finrank(rationalModule(K), rationalRing) = 0 by arith
  rw n0 at rank
  unfold HasRank at rank
  obtain ⟨v, basis⟩ := rank
  obtain ⟨_, spans⟩ := basis
  obtain ⟨mod, vF, spanEq⟩ := spans
  have qring := CommRing.to_ring with qc
  have zs := SubmoduleOf.zero_submodule at rationalRing, rationalModule(K) with qring, mod
  have imgSub : functionImage(v, 0, Module.carrier(rationalModule(K))) ⊆ {Module.zero(rationalModule(K))}
    intros y hy
    unfold functionImage at hy
    obtain ⟨_, x, hx, _⟩ := hy
    rw nat.zero at hx
    exfalso
    exact set.empty with hx
  have imgM : functionImage(v, 0, Module.carrier(rationalModule(K))) ⊆ Module.carrier(rationalModule(K))
    exact functionImage.subset at v, 0, Module.carrier(rationalModule(K))
  have l := (moduleSpan.least at rationalRing, rationalModule(K), functionImage(v, 0, Module.carrier(rationalModule(K))), {Module.zero(rationalModule(K))} with qring, mod, imgM, zs).backward with imgSub
  rw spanEq at l
  have ce := algebraModule.carrier_eq at rationalAlgebra(K)
  have ze : Module.zero(algebraModule(rationalAlgebra(K))) = Ring.zero(Algebra.ring(rationalAlgebra(K))) by unfold algebraModule; module_projections
  unfold rationalModule at l
  rw [ce, ze] at l
  unfold algebraCarrier at l
  rw rr at l
  have oneK : Ring.one(K) ∈ Ring.carrier(K) by typecheck
  have o := l with Ring.one(K), oneK
  have o2 := singleton.membership.forward with o
  have o3 : Ring.zero(K) = Ring.one(K) by rw o2
  exact knt with o3

-- The absolute norm and trace of a number field are those of the finite
-- free ℚ-algebra K, and N(n) = n^[K : ℚ] (Algebra.norm_natCast).
theorem fieldNorm.natCast (K : Set) (n : Nat)
  requires numberField : NumberField(K)
  shows fieldNorm(K, natCast(K, n)) =
    Ring.pow(rationalRing, natCast(rationalRing, n), numberFieldDegree(K))
proof
  have nf := numberField
  obtain ⟨field, cz, _⟩ := nf
  have kc := Field.to_comm_ring at K with field
  have qf := rationalRing.field
  have qff := qf.left
  have qc := Field.to_comm_ring at rationalRing with qff
  have ff := NumberField.finite_free at K with numberField
  obtain ⟨left, _⟩ := ff
  have hK := ratCastMap.ring_hom at K with field, cz
  have num := RingHom.map_numeral at rationalRing, K, ratCastMap(K), n with qc, kc, hK
  have e1 : natCast(rationalRing, n) = ringNat(Ring.add(rationalRing), Ring.zero(rationalRing), Ring.one(rationalRing), n) by unfold natCast; rfl
  have e2 : natCast(K, n) = ringNat(Ring.add(K), Ring.zero(K), Ring.one(K), n) by unfold natCast; rfl
  rw [← e1, ← e2] at num
  have bs : Algebra.base(rationalAlgebra(K)) = rationalRing by simp [rationalAlgebra, Algebra.mk.base]
  have mp : Algebra.map(rationalAlgebra(K)) = ratCastMap(K) by simp [rationalAlgebra, Algebra.mk.map]
  have nQ : natCast(rationalRing, n) ∈ Ring.carrier(Algebra.base(rationalAlgebra(K)))
    rw bs
    unfold natCast
    typecheck
  have am := algebraNorm.algebraMap at rationalAlgebra(K), natCast(rationalRing, n) with left, nQ
  rw [mp, num, bs] at am
  unfold fieldNorm
  unfold numberFieldDegree
  unfold rationalModule
  exact am

-- Rat.finrank: Module.finrank ℚ ℚ = 1
theorem numberFieldDegree.rationals
  shows numberFieldDegree(rationalRing) = 1
proof
  have qf := rationalRing.field
  have qff := qf.left
  have so := tkF.rationalModule.span_one
  obtain ⟨mod, sub, span⟩ := so
  have fin := Finite.singleton at Ring.one(rationalRing)
  have idF := identity.function at {Ring.one(rationalRing)}
  have vF : identity({Ring.one(rationalRing)}) : {Ring.one(rationalRing)} → Module.carrier(rationalModule(rationalRing))
    apply FunctionBetween.codomain_of_values with idF
    intros z hz
    have ia := identity.apply at z, {Ring.one(rationalRing)} with hz
    rw ia
    exact sub with z, hz
  have img : functionImage(identity({Ring.one(rationalRing)}), {Ring.one(rationalRing)}, Module.carrier(rationalModule(rationalRing))) = {Ring.one(rationalRing)}
    ext y
    constructor
    . intro hy
      unfold functionImage at hy
      obtain ⟨_, z, hz, yEq⟩ := hy
      have ia := identity.apply at z, {Ring.one(rationalRing)} with hz
      rw [yEq, ia]
      exact hz
    . intro hy
      have yM := sub with y, hy
      have ia := identity.apply at y, {Ring.one(rationalRing)} with hy
      have e : y = identity({Ring.one(rationalRing)})(y) by rw ia
      unfold functionImage
      exact ⟨yM, y, hy, e⟩
  have spans : SpansModule(rationalModule(rationalRing), rationalRing, {Ring.one(rationalRing)}, identity({Ring.one(rationalRing)}))
    unfold SpansModule
    rw img
    exact ⟨mod, vF, span⟩
  have le := SpansModule.finrank_le_card at rationalRing, rationalModule(rationalRing), {Ring.one(rationalRing)}, identity({Ring.one(rationalRing)}) with qff, mod, fin, spans
  obtain ⟨_, bound⟩ := le
  have c1 := cardinality.singleton at Ring.one(rationalRing)
  rw c1 at bound
  have nfq := NumberField.rationals
  have pos := numberFieldDegree.pos at rationalRing with nfq
  obtain ⟨nIn, p⟩ := pos
  have nNat := natural.member at numberFieldDegree(rationalRing) with nIn
  unfold numberFieldDegree at p
  unfold numberFieldDegree
  arith

