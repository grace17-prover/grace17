-- Number fields: the rings ℤ and ℚ as bundled rings and their canonical
-- maps into a ring (Int.cast, Rat.cast), fields of characteristic zero,
-- number fields as fields finite-dimensional over ℚ (Mathlib's
-- NumberField), the degree, the ring of integers 𝓞 K as the integral
-- closure of ℤ (NumberField.RingOfIntegers) with its rank, integral bases,
-- and fraction field, and the norm and trace of a finite free algebra
-- (Algebra.norm, Algebra.trace) with their laws, specialised to K/ℚ and to
-- 𝓞 K over ℤ.
-- Part of the GRH blueprint.
-- Planned home: NumberTheory/NumberField/Basic (ℤ, ℚ as rings: Int/Ring,
-- Rat/Field; the trace: LinearAlgebra; norm and trace: Algebra/Norm).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.NumberField.Basic
import GRH.Algebra.DVR
import GRH.Cyclotomy.Fields
import Grace.Cumulus.Rat.Operations

-- Section: ℤ and ℚ as rings, and their canonical maps
-- The integers and the rationals as bundled rings, on Cumulus's ℤ and ℚ
-- with their operation graphs (Int.instCommRing, Rat.instField).
-- Cross-module request: these belong beside Cumulus's Int/Ring and Rat;
-- track F (cyclotomic fields) needs the same objects.
-- The canonical map ℤ → R (Int.castRingHom): the class of (a, b), that is
-- the integer a − b, goes to a · 1 − b · 1. That this graph is a function
-- (independence of the representative) is a theorem.
def intCastMap (R : Set) : Set :=
  { p ∈ ℤ × Ring.carrier(R) | ∃ a ∈ ℕ, ∃ b ∈ ℕ,
    p = (integerClass(a, b), Ring.sub(R, natCast(R, a), natCast(R, b))) }

-- It is Cyclotomy.RootsOfUnity's intCastHom, written with integer classes.
theorem intCastMap.eq_int_cast_hom (R : Set)
  requires ring : Ring(R)
  shows intCastMap(R) = intCastHom(R)
proof
  sorry

-- The canonical map ℚ → K of a field of characteristic zero
-- (Rat.castHom): (a − b)/m goes to the x with x · m = a − b.
def ratCastMap (K : Set) : Set :=
  { p ∈ ℚ × Ring.carrier(K) | ∃ a ∈ ℕ, ∃ b ∈ ℕ, ∃ m ∈ ℕ,
    ∃ x ∈ Ring.carrier(K), m ≠ 0 ∧ p = (rationalClass(a, b, m), x) ∧
      call2(Ring.mul(K), x, natCast(K, m)) =
        Ring.sub(K, natCast(K, a), natCast(K, b)) }

-- Characteristic zero (CharZero): n · 1 ≠ 0 for n ≠ 0.
predicate CharZero (R : Set) :=
  ∀ n ∈ ℕ, n ≠ 0 → natCast(R, n) ≠ Ring.zero(R)

-- R as a ℤ-algebra, and a field of characteristic zero as a ℚ-algebra,
-- along the canonical maps (algebraInt, DivisionRing.toRatAlgebra).
def integerAlgebra (R : Set) : Set := Algebra.mk(integerRing, R, intCastMap(R))

def rationalAlgebra (K : Set) : Set :=
  Algebra.mk(rationalRing, K, ratCastMap(K))

-- K as a ℚ-vector space.
def rationalModule (K : Set) : Set := algebraModule(rationalAlgebra(K))

-- Section: Number fields and their rings of integers
-- A number field: a field of characteristic zero, finite-dimensional over
-- ℚ (NumberField K, with its Field K instance).
predicate NumberField (K : Set) :=
  Field(K) ∧ CharZero(K) ∧ FiniteDimensional(rationalModule(K), rationalRing)

-- The degree [K : ℚ] (Module.finrank ℚ K).
def numberFieldDegree (K : Set) : Set := finrank(rationalModule(K), rationalRing)

-- The ring of integers 𝓞 K: the elements of K integral over ℤ
-- (NumberField.RingOfIntegers, integralClosure ℤ K), as a subset of K,
-- and as a ring with the operations of K.
def ringOfIntegers (K : Set) : Set := integralClosure(integerAlgebra(K))

def ringOfIntegersRing (K : Set) : Set := subringRing(K, ringOfIntegers(K))

-- 𝓞 K as a ℤ-algebra and as a ℤ-module.
def ringOfIntegersAlgebra (K : Set) : Set := integerAlgebra(ringOfIntegersRing(K))

def ringOfIntegersModule (K : Set) : Set := algebraModule(ringOfIntegersAlgebra(K))

-- K as an 𝓞 K-algebra along the inclusion (the algebra 𝓞 K → K).
def ringOfIntegersInclusion (K : Set) : Set :=
  Algebra.mk(ringOfIntegersRing(K), K, identity(ringOfIntegers(K)))

-- The ring homomorphism f : K →+* L restricted to the rings of integers
-- (NumberField.RingOfIntegers.mapRingHom), and 𝓞 L as an 𝓞 K-algebra.
def ringOfIntegersMap (f K : Set) : Set := restrict(f, ringOfIntegers(K))

def ringOfIntegersExtension (f K L : Set) : Set :=
  Algebra.mk(ringOfIntegersRing(K), ringOfIntegersRing(L), ringOfIntegersMap(f, K))

-- Section: Norm and trace
-- The norm and the trace of x in an algebra A that is finite free over its
-- base: the determinant and the trace of multiplication by x
-- (Algebra.norm, Algebra.trace). Mathlib sets the norm to 1 and the trace
-- to 0 when A is not finite free; here they are unspecified there, and
-- every theorem assumes A finite free.
def algebraNorm (A x : Set) : Set :=
  linearDet(algebraModule(A), Algebra.base(A), algebraMultiplication(A, x))

def algebraTrace (A x : Set) : Set :=
  linearTrace(algebraModule(A), Algebra.base(A), algebraMultiplication(A, x))

-- The absolute norm and trace N_{K/ℚ}, Tr_{K/ℚ} (Algebra.norm ℚ,
-- Algebra.trace ℚ), and their integral versions on 𝓞 K
-- (Algebra.norm ℤ, Algebra.trace ℤ on 𝓞 K), valued in ℤ.
def fieldNorm (K x : Set) : Set := algebraNorm(rationalAlgebra(K), x)

def fieldTrace (K x : Set) : Set := algebraTrace(rationalAlgebra(K), x)

def integerNorm (K x : Set) : Set := algebraNorm(ringOfIntegersAlgebra(K), x)

def integerTrace (K x : Set) : Set := algebraTrace(ringOfIntegersAlgebra(K), x)

-- An algebra that is finite free over its base (Module.Free, Module.Finite).
predicate FiniteFreeAlgebra (A : Set) :=
  Algebra(A) ∧ FiniteFreeModule(algebraModule(A), Algebra.base(A))

-- The ring automorphisms of K (K ≃+* K; for a number field every one is a
-- ℚ-algebra automorphism, K ≃ₐ[ℚ] K).
def fieldAutomorphisms (K : Set) : Set :=
  { σ ∈ functionSpace(Ring.carrier(K), Ring.carrier(K)) | RingIso(σ, K, K) }

-- A number field Galois over ℚ: as many automorphisms as its degree
-- (IsGalois ℚ K, by IsGalois.card_aut_eq_finrank). Cross-module request:
-- to be unified with track F's IsGalois.
predicate GaloisNumberField (K : Set) :=
  NumberField(K) ∧
  HasCardinality(fieldAutomorphisms(K), numberFieldDegree(K))

-- The family σ ↦ σ(x) over the automorphisms, for the norm as a product.
def automorphismValues (K x : Set) : Set :=
  { (σ, σ(x)) | σ ∈ fieldAutomorphisms(K) }

-- Int.instIsDomain
theorem integerRing.integral_domain
  shows IntegralDomain(integerRing)
proof
  have h := integerRing.comm_ring at 0
  exact h.right

-- EuclideanDomain.to_principal_ideal_domain for ℤ
theorem integerRing.principal
  shows PrincipalIdealDomain(integerRing)
proof
  sorry

-- Rat.instCharZero
theorem rationalRing.char_zero
  shows CharZero(rationalRing)
proof
  unfold CharZero
  intros n hn ne eq
  have h := rationalRing.field
  have cp := h.right
  obtain ⟨_, iff⟩ := cp
  have d := (iff at n with hn).forward with eq
  have z := zero.divides_only_zero at n with d
  exact ne with z

-- Int.castRingHom
theorem intCastMap.ring_hom (R : Set)
  requires ring : CommRing(R)
  shows RingHom(intCastMap(R), integerRing, R)
proof
  sorry

-- Int.cast_natCast
theorem intCastMap.of_nat (R : Set) (n : Nat)
  requires ring : CommRing(R)
  shows intCastMap(R)(integerOfNat(n)) = natCast(R, n)
proof
  sorry

-- RingHom.eq_intCast': ℤ is initial among rings.
theorem intCastMap.unique (R f : Set)
  requires ring : CommRing(R)
  requires hom : RingHom(f, integerRing, R)
  shows f = intCastMap(R)
proof
  sorry

-- Rat.castHom
theorem ratCastMap.ring_hom (K : Set)
  requires field : Field(K)
  requires zero : CharZero(K)
  shows RingHom(ratCastMap(K), rationalRing, K)
proof
  sorry

-- RingHom.ext_rat: the only ring homomorphism ℚ → K.
theorem ratCastMap.unique (K f : Set)
  requires field : Field(K)
  requires zero : CharZero(K)
  requires hom : RingHom(f, rationalRing, K)
  shows f = ratCastMap(K)
proof
  sorry

-- Rat.cast_injective
theorem ratCastMap.injective (K : Set)
  requires field : Field(K)
  requires zero : CharZero(K)
  shows InjectiveBetween(ratCastMap(K), ℚ, Ring.carrier(K))
proof
  sorry

-- Rat.cast_intCast
theorem ratCastMap.of_int (K z : Set)
  requires field : Field(K)
  requires zero : CharZero(K)
  requires integer : z ∈ ℤ
  shows ratCastMap(K)(intCastMap(rationalRing)(z)) = intCastMap(K)(z)
proof
  sorry

-- RingHom.map_ratCast: ring homomorphisms between fields of
-- characteristic zero commute with the casts.
theorem ratCastMap.comp_hom (K L f q : Set)
  requires sourceField : Field(K)
  requires targetField : Field(L)
  requires zero : CharZero(K)
  requires hom : RingHom(f, K, L)
  requires rational : q ∈ ℚ
  shows f(ratCastMap(K)(q)) = ratCastMap(L)(q)
proof
  sorry

-- RingHom.charZero: a field receiving a ring homomorphism from a field of
-- characteristic zero has characteristic zero.
theorem CharZero.of_hom (K L f : Set)
  requires sourceField : Field(K)
  requires targetField : Field(L)
  requires zero : CharZero(K)
  requires hom : RingHom(f, K, L)
  shows CharZero(L)
proof
  sorry

theorem integerAlgebra.algebra (R : Set)
  requires ring : CommRing(R)
  shows Algebra(integerAlgebra(R))
proof
  have ir := integerRing.comm_ring at 0
  have irc := ir.left
  have hom := intCastMap.ring_hom at R with ring
  unfold integerAlgebra
  exact Algebra.intro with irc, ring, hom


theorem rationalAlgebra.algebra (K : Set)
  requires field : Field(K)
  requires zero : CharZero(K)
  shows Algebra(rationalAlgebra(K))
proof
  have qf := rationalRing.field
  have qff := qf.left
  have qc := Field.to_comm_ring at rationalRing with qff
  have kc := Field.to_comm_ring at K with field
  have hom := ratCastMap.ring_hom at K with field, zero
  unfold rationalAlgebra
  exact Algebra.intro with qc, kc, hom


-- Section: Number fields
-- Rat.numberField
theorem NumberField.rationals
  shows NumberField(rationalRing)
proof
  sorry

-- Rat.finrank: Module.finrank ℚ ℚ = 1
theorem numberFieldDegree.rationals
  shows numberFieldDegree(rationalRing) = 1
proof
  sorry

-- NumberField.of_module_finite: a finite extension of a number field is a
-- number field.
theorem NumberField.of_module_finite (K L f : Set)
  requires numberField : NumberField(K)
  requires field : Field(L)
  requires hom : RingHom(f, K, L)
  requires finite : FiniteDimensional(algebraModule(Algebra.mk(K, L, f)), K)
  shows NumberField(L)
proof
  sorry

-- The converse direction: a ring homomorphism of number fields makes the
-- target finite over the source (Module.Finite K L for number fields).
theorem NumberField.finite_over (K L f : Set)
  requires source : NumberField(K)
  requires target : NumberField(L)
  requires hom : RingHom(f, K, L)
  shows FiniteDimensional(algebraModule(Algebra.mk(K, L, f)), K)
proof
  sorry

-- Module.finrank_pos
theorem numberFieldDegree.pos (K : Set)
  requires numberField : NumberField(K)
  shows numberFieldDegree(K) ∈ ℕ ∧ 0 < (numberFieldDegree(K):N)
proof
  sorry

-- Module.finrank_mul_finrank: [L : ℚ] = [L : K] [K : ℚ].
theorem numberFieldDegree.tower (K L f : Set)
  requires source : NumberField(K)
  requires target : NumberField(L)
  requires hom : RingHom(f, K, L)
  shows numberFieldDegree(L) =
    mul(finrank(algebraModule(Algebra.mk(K, L, f)), K), numberFieldDegree(K))
proof
  sorry

-- A subring of an integral domain is an integral domain.
theorem tkF.subringRing.integral_domain (R S : Set)
  requires domain : IntegralDomain(R)
  requires subring : Subring(R, S)
  shows IntegralDomain(subringRing(R, S))
proof
  obtain ⟨comm, nt, nzd⟩ := domain
  have sc := subringRing.comm_ring at R, S with comm, subring
  have incl := Subring.inclusion at R, S with comm, subring
  have c := subringRing.carrierOf at R, S
  have z : Ring.zero(subringRing(R, S)) = Ring.zero(R) by simp [subringRing, Ring.mk.zero]
  have o : Ring.one(subringRing(R, S)) = Ring.one(R) by simp [subringRing, Ring.mk.one]
  unfold IntegralDomain
  refine ⟨sc, ?_, ?_⟩
  . rw [z, o]
    exact nt
  . intros x hx y hy eq
    have hxS : x ∈ S by rw ← c; exact hx
    have hyS : y ∈ S by rw ← c; exact hy
    have bounded := subring.left
    have xR := bounded with x, hxS
    have yR := bounded with y, hyS
    have mm := RingHom.map_mul at identity(S), subringRing(R, S), R, x, y with incl, hx, hy
    have pIn : call2(Ring.mul(subringRing(R, S)), x, y) ∈ S by rw eq; rw z; exact subring.right.left
    have i1 := identity.apply at call2(Ring.mul(subringRing(R, S)), x, y), S with pIn
    have i2 := identity.apply at x, S with hxS
    have i3 := identity.apply at y, S with hyS
    rw [i1, i2, i3, eq, z] at mm
    have mms : call2(Ring.mul(R), x, y) = Ring.zero(R) by rw ← mm
    have r1 := nzd with xR
    have r := r1 with yR, mms
    rw z
    exact r


-- Section: The ring of integers
section RingOfIntegers
variable (K : Set)
hypothesis field : Field(K)
hypothesis numberField : NumberField(K)

-- NumberField.mem_ringOfIntegers
theorem ringOfIntegers.mem_iff (x : Set)
  shows x ∈ ringOfIntegers(K) ↔ IntegralElement(integerAlgebra(K), x)
proof
  unfold ringOfIntegers
  unfold integralClosure
  constructor
  . intro h
    exact h.right
  . intro h
    have h0 := h
    obtain ⟨_, mem, _⟩ := h0
    exact ⟨mem, h⟩


-- (integralClosure ℤ K).toSubring
theorem ringOfIntegers.subring
  shows Subring(K, ringOfIntegers(K))
proof
  have kc := Field.to_comm_ring at K with field
  have alg := integerAlgebra.algebra at K with kc
  have sub := intHelp.closure_subring at integerAlgebra(K) with alg
  unfold ringOfIntegers
  have r : Algebra.ring(integerAlgebra(K)) = K by simp [integerAlgebra, Algebra.mk.ring]
  rw r at sub
  exact sub


-- NumberField.RingOfIntegers.instIsDomain
theorem ringOfIntegersRing.integral_domain
  shows IntegralDomain(ringOfIntegersRing(K))
proof
  have sub := ringOfIntegers.subring at K with field, numberField
  have fd := Field.domain at K with field
  unfold ringOfIntegersRing
  exact tkF.subringRing.integral_domain at K, ringOfIntegers(K) with fd, sub


-- The integers lie in 𝓞 K (algebraMap ℤ (𝓞 K)).
theorem ringOfIntegers.intCast_mem (z : Set)
  requires integer : z ∈ ℤ
  shows intCastMap(K)(z) ∈ ringOfIntegers(K)
proof
  have kc := Field.to_comm_ring at K with field
  have alg := integerAlgebra.algebra at K with kc
  have b : Ring.carrier(Algebra.base(integerAlgebra(K))) = ℤ by simp [integerAlgebra, Algebra.mk.base, integerRing, Ring.mk.carrier]
  have zIn : z ∈ Ring.carrier(Algebra.base(integerAlgebra(K))) by rw b; exact integer
  have ie := IntegralElement.algebra_map at integerAlgebra(K), z with alg, zIn
  have mp : Algebra.map(integerAlgebra(K)) = intCastMap(K) by simp [integerAlgebra, Algebra.mk.map]
  rw mp at ie
  have mem := (ringOfIntegers.mem_iff at K, intCastMap(K)(z) with field, numberField).backward
  exact mem with ie


-- 𝓞 K ∩ ℚ = ℤ (IsIntegrallyClosed ℤ, Rat.ringOfIntegersEquiv).
theorem ringOfIntegers.ratCast_mem_iff (q : Set)
  requires rational : q ∈ ℚ
  shows ratCastMap(K)(q) ∈ ringOfIntegers(K) ↔
    (∃ z ∈ ℤ, q = intCastMap(rationalRing)(z))
proof
  sorry

-- Rat.ringOfIntegersEquiv: 𝓞 ℚ is the image of ℤ.
theorem ringOfIntegers.rationals
  shows ringOfIntegers(rationalRing) =
    functionImage(intCastMap(rationalRing), ℤ, ℚ)
proof
  sorry

-- NumberField.RingOfIntegers.instFree, instModuleFinite: 𝓞 K is a free
-- ℤ-module of finite rank.
theorem ringOfIntegers.free
  shows FiniteFreeModule(ringOfIntegersModule(K), integerRing)
proof
  sorry

-- NumberField.RingOfIntegers.rank: the rank of 𝓞 K over ℤ is [K : ℚ].
theorem ringOfIntegers.rank
  shows finrank(ringOfIntegersModule(K), integerRing) = numberFieldDegree(K)
proof
  sorry

-- NumberField.integralBasis, integralBasis_apply: a ℤ-basis of 𝓞 K is a
-- ℚ-basis of K.
theorem ringOfIntegers.integral_basis (I b : Set)
  requires basis : ModuleBasis(ringOfIntegersModule(K), integerRing, I, b)
  shows ModuleBasis(rationalModule(K), rationalRing, I, b)
proof
  sorry

-- exists_integral_multiples: every x ∈ K has a nonzero integer multiple
-- in 𝓞 K.
theorem ringOfIntegers.exists_multiple (x : K)
  shows ∃ n ∈ ℕ, n ≠ 0 ∧ natCast(K, n) * x ∈ ringOfIntegers(K)
proof
  sorry

-- NumberField.RingOfIntegers.instIsFractionRing: K is the fraction field
-- of 𝓞 K.
theorem ringOfIntegers.fraction_ring
  shows IsFractionRing(ringOfIntegersInclusion(K))
proof
  sorry

-- NumberField.RingOfIntegers.not_isField
theorem ringOfIntegers.not_field
  shows ¬Field(ringOfIntegersRing(K))
proof
  sorry

-- IsIntegralClosure.isNoetherianRing
theorem ringOfIntegers.noetherian
  shows NoetherianRing(ringOfIntegersRing(K))
proof
  sorry

-- NumberField.RingOfIntegers.instIsIntegrallyClosed
theorem ringOfIntegers.integrally_closed
  shows IntegrallyClosedDomain(ringOfIntegersRing(K))
proof
  sorry

-- IsIntegralClosure (𝓞 K) ℤ K, along the inclusion.
theorem ringOfIntegers.is_integral_closure
  shows IsIntegralClosure(ringOfIntegersAlgebra(K), integerAlgebra(K),
    identity(ringOfIntegers(K)))
proof
  sorry

-- NumberField.RingOfIntegers.ext, coe_injective: equality in 𝓞 K is
-- equality in K, and its operations are those of K.
theorem ringOfIntegersRing.carrier
  shows Ring.carrier(ringOfIntegersRing(K)) = ringOfIntegers(K)
proof
  unfold ringOfIntegersRing
  exact subringRing.carrierOf

-- NumberField.RingOfIntegers.isUnit_norm: x is a unit of 𝓞 K exactly when
-- its norm is ±1.
theorem ringOfIntegers.unit_iff_norm (x : Set)
  requires member : x ∈ ringOfIntegers(K)
  shows RingUnit(ringOfIntegersRing(K), x) ↔
    (integerNorm(K, x) = integerOne ∨ integerNorm(K, x) = integerNeg(integerOne))
proof
  sorry

-- Algebra.coe_norm_int: the norm of an algebraic integer is the integer
-- norm, cast to ℚ.
theorem fieldNorm.of_integer (x : Set)
  requires member : x ∈ ringOfIntegers(K)
  shows integerNorm(K, x) ∈ ℤ ∧
    fieldNorm(K, x) = intCastMap(rationalRing)(integerNorm(K, x))
proof
  sorry

-- Algebra.coe_trace_int
theorem fieldTrace.of_integer (x : Set)
  requires member : x ∈ ringOfIntegers(K)
  shows integerTrace(K, x) ∈ ℤ ∧
    fieldTrace(K, x) = intCastMap(rationalRing)(integerTrace(K, x))
proof
  sorry

-- Algebra.norm_eq_prod_automorphisms: for K Galois over ℚ, N(x) is the
-- product of the conjugates σ(x).
theorem fieldNorm.prod_automorphisms (x : K)
  requires galois : GaloisNumberField(K)
  shows ratCastMap(K)(fieldNorm(K, x)) =
    finiteRingProduct(fieldAutomorphisms(K), Ring.carrier(K), Ring.add(K),
      Ring.zero(K), Ring.neg(K), Ring.mul(K), Ring.one(K),
      automorphismValues(K, x))
proof
  sorry

-- Algebra.trace_eq_sum_automorphisms
theorem fieldTrace.sum_automorphisms (x : K)
  requires galois : GaloisNumberField(K)
  shows ratCastMap(K)(fieldTrace(K, x)) =
    finiteRingSum(fieldAutomorphisms(K), Ring.carrier(K), Ring.add(K),
      Ring.zero(K), Ring.neg(K), Ring.mul(K), Ring.one(K),
      automorphismValues(K, x))
proof
  sorry

end RingOfIntegers

-- NumberField.RingOfIntegers.map: a ring homomorphism of number fields
-- maps algebraic integers to algebraic integers.
theorem ringOfIntegers.map_mem (K L f x : Set)
  requires source : NumberField(K)
  requires target : NumberField(L)
  requires hom : RingHom(f, K, L)
  requires member : x ∈ ringOfIntegers(K)
  shows f(x) ∈ ringOfIntegers(L)
proof
  sorry

-- 𝓞 L is an 𝓞 K-algebra along f, finite free over 𝓞 K when it is so over
-- ℤ (Module.Finite (𝓞 K) (𝓞 L)).
theorem ringOfIntegersExtension.algebra (K L f : Set)
  requires source : NumberField(K)
  requires target : NumberField(L)
  requires hom : RingHom(f, K, L)
  shows Algebra(ringOfIntegersExtension(f, K, L)) ∧
    FiniteAlgebra(ringOfIntegersExtension(f, K, L))
proof
  sorry

-- Section: Laws of the norm and the trace of a finite free algebra
section NormTrace
variable (A : Set)
hypothesis free : FiniteFreeAlgebra(A)

-- LinearMap.trace_eq_matrix_trace: the trace in any finite basis.
theorem algebraTrace.of_basis (x I b : Set)
  requires member : x ∈ algebraCarrier(A)
  requires finite : Finite(I)
  requires basis : ModuleBasis(algebraModule(A), Algebra.base(A), I, b)
  shows algebraTrace(A, x) = matTrace(Algebra.base(A), I,
    linearToMatrix(algebraModule(A), Algebra.base(A), algebraModule(A), I, b,
      I, b, algebraMultiplication(A, x)))
proof
  sorry

-- Algebra.norm_eq_matrix_det (LinearMap.det_toMatrix): the norm is the
-- determinant of the multiplication matrix in any finite basis.
theorem algebraNorm.of_basis (x I b : Set)
  requires member : x ∈ algebraCarrier(A)
  requires finite : Finite(I)
  requires basis : ModuleBasis(algebraModule(A), Algebra.base(A), I, b)
  shows algebraNorm(A, x) = matDet(Algebra.base(A), I,
    linearToMatrix(algebraModule(A), Algebra.base(A), algebraModule(A), I, b,
      I, b, algebraMultiplication(A, x)))
proof
  obtain ⟨alg, freeM⟩ := free
  have bc := Algebra.base_comm_ring with alg
  have lin := algebraMultiplication.linear at A, x with alg, member
  unfold algebraNorm
  exact linearDet.of_basis at Algebra.base(A), algebraModule(A), algebraMultiplication(A, x), I, b with bc, freeM, lin, finite, basis


theorem algebraNorm.mem (x : Set)
  requires member : x ∈ algebraCarrier(A)
  shows algebraNorm(A, x) ∈ Ring.carrier(Algebra.base(A))
proof
  obtain ⟨alg, freeM⟩ := free
  have bc := Algebra.base_comm_ring with alg
  have lin := algebraMultiplication.linear at A, x with alg, member
  have sel := linearDet.selected at algebraModule(A), Algebra.base(A), algebraMultiplication(A, x) with bc, freeM, lin
  unfold algebraNorm
  exact sel.left


theorem algebraTrace.mem (x : Set)
  requires member : x ∈ algebraCarrier(A)
  shows algebraTrace(A, x) ∈ Ring.carrier(Algebra.base(A))
proof
  obtain ⟨alg, freeM⟩ := free
  have bc := Algebra.base_comm_ring with alg
  have lin := algebraMultiplication.linear at A, x with alg, member
  have sel := linearTrace.selected at algebraModule(A), Algebra.base(A), algebraMultiplication(A, x) with bc, freeM, lin
  unfold algebraTrace
  exact sel.left


-- map_mul (Algebra.norm is a monoid homomorphism)
theorem algebraNorm.mul (x y : Set)
  requires first : x ∈ algebraCarrier(A)
  requires second : y ∈ algebraCarrier(A)
  shows algebraNorm(A, call2(Ring.mul(Algebra.ring(A)), x, y)) =
    call2(Ring.mul(Algebra.base(A)), algebraNorm(A, x), algebraNorm(A, y))
proof
  obtain ⟨alg, freeM⟩ := free
  have bc := Algebra.base_comm_ring with alg
  have ac := Algebra.comm_ring with alg
  have ce := algebraModule.carrier_eq at A
  have xR : x ∈ Ring.carrier(Algebra.ring(A))
    unfold algebraCarrier at first
    exact first
  have yR : y ∈ Ring.carrier(Algebra.ring(A))
    unfold algebraCarrier at second
    exact second
  have xyA : call2(Ring.mul(Algebra.ring(A)), x, y) ∈ algebraCarrier(A)
    unfold algebraCarrier
    typecheck
  have linx := algebraMultiplication.linear at A, x with alg, first
  have liny := algebraMultiplication.linear at A, y with alg, second
  have comp := linearDet.compose at Algebra.base(A), algebraModule(A), algebraMultiplication(A, y), algebraMultiplication(A, x) with bc, freeM, liny, linx
  rw ce at comp
  have vals : ∀ a ∈ algebraCarrier(A), ∀ b ∈ algebraCarrier(A), call2(Ring.mul(Algebra.ring(A)), a, b) ∈ algebraCarrier(A)
    intros a ha b hb
    have aR : a ∈ Ring.carrier(Algebra.ring(A))
      unfold algebraCarrier at ha
      exact ha
    have bR : b ∈ Ring.carrier(Algebra.ring(A))
      unfold algebraCarrier at hb
      exact hb
    unfold algebraCarrier
    typecheck
  have fx := algebraMultiplication.graph_function at A, x with (vals with first)
  have fy := algebraMultiplication.graph_function at A, y with (vals with second)
  have fxy := algebraMultiplication.graph_function at A, call2(Ring.mul(Algebra.ring(A)), x, y) with (vals with xyA)
  have fc := compose.function at algebraMultiplication(A, x), algebraMultiplication(A, y), algebraCarrier(A), algebraCarrier(A), algebraCarrier(A) with fy, fx
  have e : algebraMultiplication(A, call2(Ring.mul(Algebra.ring(A)), x, y)) = compose(algebraMultiplication(A, x), algebraMultiplication(A, y), algebraCarrier(A), algebraCarrier(A), algebraCarrier(A))
    apply FunctionBetween.ext with fxy, fc
    intros b hb
    have bR : b ∈ Ring.carrier(Algebra.ring(A))
      unfold algebraCarrier at hb
      exact hb
    have ybA : call2(Ring.mul(Algebra.ring(A)), y, b) ∈ algebraCarrier(A)
      unfold algebraCarrier
      typecheck
    have c := compose.apply at algebraMultiplication(A, x), algebraMultiplication(A, y), algebraCarrier(A), algebraCarrier(A), algebraCarrier(A), b with fy, fx, hb
    have v1 := algebraMultiplication.value at A, call2(Ring.mul(Algebra.ring(A)), x, y), b with alg, xyA, hb
    have v2 := algebraMultiplication.value at A, y, b with alg, second, hb
    have v3 := algebraMultiplication.value at A, x, call2(Ring.mul(Algebra.ring(A)), y, b) with alg, first, ybA
    rw [c, v1, v2, v3]
    ring
  unfold algebraNorm
  rw e
  exact comp


-- map_one
theorem algebraNorm.one
  shows algebraNorm(A, Ring.one(Algebra.ring(A))) = Ring.one(Algebra.base(A))
proof
  obtain ⟨alg, freeM⟩ := free
  have bc := Algebra.base_comm_ring with alg
  have ac := Algebra.comm_ring with alg
  have ce := algebraModule.carrier_eq at A
  have oneR : Ring.one(Algebra.ring(A)) ∈ Ring.carrier(Algebra.ring(A)) by typecheck
  have oneA : Ring.one(Algebra.ring(A)) ∈ algebraCarrier(A)
    unfold algebraCarrier
    exact oneR
  have values : ∀ b ∈ algebraCarrier(A), call2(Ring.mul(Algebra.ring(A)), Ring.one(Algebra.ring(A)), b) ∈ algebraCarrier(A)
    intros b hb
    have bR : b ∈ Ring.carrier(Algebra.ring(A))
      unfold algebraCarrier at hb
      exact hb
    unfold algebraCarrier
    typecheck
  have mf := algebraMultiplication.graph_function at A, Ring.one(Algebra.ring(A)) with values
  have idf := identity.function at algebraCarrier(A)
  have e : algebraMultiplication(A, Ring.one(Algebra.ring(A))) = identity(algebraCarrier(A))
    apply FunctionBetween.ext with mf, idf
    intros b hb
    have v := algebraMultiplication.value at A, Ring.one(Algebra.ring(A)), b with alg, oneA, hb
    have i := identity.apply at b, algebraCarrier(A) with hb
    have bR : b ∈ Ring.carrier(Algebra.ring(A))
      unfold algebraCarrier at hb
      exact hb
    rw [v, i]
    ring
  have idd := linearDet.identity at Algebra.base(A), algebraModule(A) with bc, freeM
  rw ce at idd
  unfold algebraNorm
  rw e
  exact idd


-- Algebra.norm_algebraMap: N(a) = a^[A : R] for a in the base.
theorem algebraNorm.algebraMap (a : Set)
  requires member : a ∈ Ring.carrier(Algebra.base(A))
  shows algebraNorm(A, Algebra.map(A)(a)) = Ring.pow(Algebra.base(A), a,
    finrank(algebraModule(A), Algebra.base(A)))
proof
  sorry

-- map_add (Algebra.trace is linear)
theorem algebraTrace.add (x y : Set)
  requires first : x ∈ algebraCarrier(A)
  requires second : y ∈ algebraCarrier(A)
  shows algebraTrace(A, call2(Ring.add(Algebra.ring(A)), x, y)) =
    call2(Ring.add(Algebra.base(A)), algebraTrace(A, x), algebraTrace(A, y))
proof
  sorry

-- map_smul: Tr(a x) = a Tr(x) for a in the base.
theorem algebraTrace.smul (a x : Set)
  requires scalar : a ∈ Ring.carrier(Algebra.base(A))
  requires member : x ∈ algebraCarrier(A)
  shows algebraTrace(A, call2(Ring.mul(Algebra.ring(A)), Algebra.map(A)(a), x)) =
    call2(Ring.mul(Algebra.base(A)), a, algebraTrace(A, x))
proof
  sorry

-- Algebra.trace_algebraMap: Tr(a) = [A : R] · a.
theorem algebraTrace.algebraMap (a : Set)
  requires member : a ∈ Ring.carrier(Algebra.base(A))
  shows algebraTrace(A, Algebra.map(A)(a)) =
    call2(Ring.mul(Algebra.base(A)),
      natCast(Algebra.base(A), finrank(algebraModule(A), Algebra.base(A))), a)
proof
  sorry

-- Algebra.norm_eq_of_algEquiv, trace_eq_of_algEquiv: invariance under an
-- isomorphism of algebras.
theorem algebraNorm.of_iso (B e x : Set)
  requires other : FiniteFreeAlgebra(B)
  requires iso : AlgebraIso(e, A, B)
  requires member : x ∈ algebraCarrier(A)
  shows algebraNorm(B, e(x)) = algebraNorm(A, x) ∧
    algebraTrace(B, e(x)) = algebraTrace(A, x)
proof
  sorry

end NormTrace

-- Section: Norm and trace of field extensions
section FieldExtension
variable (K L f : Set)
hypothesis base : Field(K)
hypothesis field : Field(L)
hypothesis hom : RingHom(f, K, L)
hypothesis finite : FiniteDimensional(algebraModule(Algebra.mk(K, L, f)), K)

-- A finite field extension is a finite free algebra.
theorem FiniteFreeAlgebra.of_field_extension
  shows FiniteFreeAlgebra(Algebra.mk(K, L, f))
proof
  sorry

-- Algebra.norm_eq_zero_iff: in a field extension N(x) = 0 only for x = 0.
theorem algebraNorm.eq_zero_iff (x : L)
  shows algebraNorm(Algebra.mk(K, L, f), x) = Ring.zero(K) ↔ x = Ring.zero(L)
proof
  sorry

-- Algebra.norm_inv, read multiplicatively: N(x) N(y) = 1 when x y = 1.
theorem algebraNorm.inv (x y : L)
  requires inverse : x * y = Ring.one(L)
  shows call2(Ring.mul(K), algebraNorm(Algebra.mk(K, L, f), x),
    algebraNorm(Algebra.mk(K, L, f), y)) = Ring.one(K)
proof
  sorry

-- Algebra.trace_surjective: in characteristic zero the trace is onto.
theorem algebraTrace.surjective (a : K)
  requires zero : CharZero(K)
  shows ∃ x ∈ Ring.carrier(L), algebraTrace(Algebra.mk(K, L, f), x) = a
proof
  sorry

-- traceForm_nondegenerate: in characteristic zero (x, y) ↦ Tr(x y) is
-- nondegenerate.
theorem algebraTrace.nondegenerate (x : L)
  requires zero : CharZero(K)
  requires pairing : ∀ y ∈ Ring.carrier(L),
    algebraTrace(Algebra.mk(K, L, f), x * y) = Ring.zero(K)
  shows x = Ring.zero(L)
proof
  sorry

-- Algebra.norm_norm and Algebra.trace_trace: transitivity in a tower
-- K → L → M.
theorem algebraNorm.tower (M g x : Set)
  requires top : Field(M)
  requires upper : RingHom(g, L, M)
  requires upperFinite : FiniteDimensional(algebraModule(Algebra.mk(L, M, g)), L)
  requires member : x ∈ Ring.carrier(M)
  shows algebraNorm(Algebra.mk(K, L, f), algebraNorm(Algebra.mk(L, M, g), x)) =
      algebraNorm(Algebra.mk(K, M,
        compose(g, f, Ring.carrier(K), Ring.carrier(L), Ring.carrier(M))), x) ∧
    algebraTrace(Algebra.mk(K, L, f), algebraTrace(Algebra.mk(L, M, g), x)) =
      algebraTrace(Algebra.mk(K, M,
        compose(g, f, Ring.carrier(K), Ring.carrier(L), Ring.carrier(M))), x)
proof
  sorry

end FieldExtension

-- The absolute norm and trace of a number field are those of the finite
-- free ℚ-algebra K, and N(n) = n^[K : ℚ] (Algebra.norm_natCast).
theorem fieldNorm.natCast (K : Set) (n : Nat)
  requires numberField : NumberField(K)
  shows fieldNorm(K, natCast(K, n)) =
    Ring.pow(rationalRing, natCast(rationalRing, n), numberFieldDegree(K))
proof
  sorry

theorem NumberField.finite_free (K : Set)
  requires numberField : NumberField(K)
  shows FiniteFreeAlgebra(rationalAlgebra(K)) ∧
    FiniteFreeAlgebra(ringOfIntegersAlgebra(K))
proof
  have nf := numberField
  obtain ⟨field, cz, fdim⟩ := nf
  have qf := rationalRing.field
  have qff := qf.left
  have hom := ratCastMap.ring_hom at K with field, cz
  have fdim2 : FiniteDimensional(algebraModule(Algebra.mk(rationalRing, K, ratCastMap(K))), rationalRing)
    unfold rationalModule at fdim
    unfold rationalAlgebra at fdim
    exact fdim
  have ff := FiniteFreeAlgebra.of_field_extension at rationalRing, K, ratCastMap(K) with qff, field, hom, fdim2
  have left : FiniteFreeAlgebra(rationalAlgebra(K))
    unfold rationalAlgebra
    exact ff
  have kc := Field.to_comm_ring at K with field
  have sub := ringOfIntegers.subring at K with field, numberField
  have sc := subringRing.comm_ring at K, ringOfIntegers(K) with kc, sub
  have alg := integerAlgebra.algebra at subringRing(K, ringOfIntegers(K)) with sc
  have fr := ringOfIntegers.free at K with field, numberField
  have b : Algebra.base(ringOfIntegersAlgebra(K)) = integerRing by simp [ringOfIntegersAlgebra, integerAlgebra, Algebra.mk.base]
  have right : FiniteFreeAlgebra(ringOfIntegersAlgebra(K))
    unfold FiniteFreeAlgebra
    rw b
    unfold ringOfIntegersModule at fr
    refine ⟨?_, fr⟩
    unfold ringOfIntegersAlgebra
    unfold ringOfIntegersRing
    exact alg
  exact ⟨left, right⟩

