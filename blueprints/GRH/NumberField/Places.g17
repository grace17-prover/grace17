-- Places of a number field: the complex embeddings K →+* ℂ, real and
-- complex embeddings and conjugation (NumberField.ComplexEmbedding), the
-- infinite places as classes {σ, σ̄} of embeddings (InfinitePlace, here
-- without a chosen representative), their absolute values, real and
-- complex places and multiplicities, r₁ + 2 r₂ = n, the norm as a product
-- over embeddings, places in extensions and unramified extensions, the
-- house, Kronecker's theorem, the discriminant through embeddings and its
-- sign, Minkowski's bound for the class group, the finite places with
-- their normalised absolute values N(P)^{−ord_P} and the product formula,
-- and the P-adic completions K_P ⊇ 𝓞_P with their topology
-- (HeightOneSpectrum.adicCompletion, adicCompletionIntegers).
-- Part of the GRH blueprint.
-- Planned home: NumberTheory/NumberField/Places.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.NumberField.Places
import GRH.NumberField.Discriminant
import GRH.Normed.Groups
import GRH.Algebra.Completion

-- Section: Complex embeddings
-- The ring homomorphisms K →+* ℂ (K →+* ℂ, NumberField.Embeddings).
def complexEmbeddings (K : Set) : Set :=
  { σ ∈ functionSpace(Ring.carrier(K), complexCarrier) | RingHom(σ, K, complexRing) }

-- The conjugate embedding σ̄ = conj ∘ σ (ComplexEmbedding.conjugate).
def conjugateEmbedding (K σ : Set) : Set :=
  compose(complexConj, σ, Ring.carrier(K), complexCarrier, complexCarrier)

-- A real embedding: σ̄ = σ (ComplexEmbedding.IsReal).
predicate RealEmbedding (K σ : Set) :=
  σ ∈ complexEmbeddings(K) ∧ (∀ x ∈ Ring.carrier(K), complexConj(σ(x)) = σ(x))

-- The embeddings τ of L restricting to σ along f : K →+* L
-- (ComplexEmbedding.LiesOver, the fibre of the restriction).
def embeddingsOver (f K L σ : Set) : Set :=
  { τ ∈ complexEmbeddings(L) | ∀ x ∈ Ring.carrier(K), τ(f(x)) = σ(x) }

-- The family σ ↦ σ(x) over the embeddings, and σ ↦ |σ(x)|.
def embeddingValues (K x : Set) : Set :=
  { (σ, σ(x)) | σ ∈ complexEmbeddings(K) }

def embeddingAbsValues (K x : Set) : Set :=
  { (σ, complexAbs(σ(x))) | σ ∈ complexEmbeddings(K) }

-- For a family b over I and an enumeration e : I → embeddings, the matrix
-- (e(j)(b(i)))_{i, j} (Algebra.embeddingsMatrixReindex).
def embeddingMatrix (K I b e : Set) : Set :=
  { q ∈ (I × I) × complexCarrier | ∃ i ∈ I, ∃ j ∈ I, q = ((i, j), e(j)(b(i))) }

-- Section: Infinite places
-- The infinite place of σ: the pair {σ, σ̄} (InfinitePlace.mk σ, which
-- Mathlib takes to be the absolute value |σ(·)|; the two determine each
-- other, InfinitePlace.mk_eq_iff). The places are the set of these pairs,
-- with no embedding chosen for a place.
def infinitePlaceOf (K σ : Set) : Set := {σ, conjugateEmbedding(K, σ)}

def infinitePlaces (K : Set) : Set :=
  { infinitePlaceOf(K, σ) | σ ∈ complexEmbeddings(K) }

-- The absolute value w(x) = |σ(x)| for σ ∈ w (InfinitePlace.apply); it
-- does not depend on σ since |σ̄(x)| = |σ(x)|.
defunique infinitePlaceValue (K w x : Set) (r ∈ ℝ) :=
  ∃ σ ∈ w, r = complexAbs(σ(x))
requires field : Field(K)
requires place : w ∈ infinitePlaces(K)
requires member : x ∈ Ring.carrier(K)
proof
  obtain ⟨σ, hσ, eq⟩ := infinitePlaces.membership.forward with place
  have e0 := hσ
  unfold complexEmbeddings at e0
  obtain ⟨sp, _⟩ := e0
  have fn := functionSpace.mem_iff.forward with sp
  have v := FunctionBetween.apply_closed with fn, member
  have r : complexAbs(σ(x)) ∈ ℝ by typecheck
  have t : σ ∈ w
    rw ← eq
    unfold infinitePlaceOf
    exact pair.left
  witness complexAbs(σ(x))
  exact ⟨r, σ, t, rfl⟩
uniqueness
  intros a ha first b hb second
  obtain ⟨σ1, h1, e1⟩ := first
  obtain ⟨σ2, h2, e2⟩ := second
  rw [e1, e2]
  obtain ⟨σ, hσ, eq⟩ := infinitePlaces.membership.forward with place
  have e0 := hσ
  unfold complexEmbeddings at e0
  obtain ⟨sp, _⟩ := e0
  have fn := functionSpace.mem_iff.forward with sp
  have v := FunctionBetween.apply_closed with fn, member
  have key : ∀ ρ ∈ w, complexAbs(ρ(x)) = complexAbs(σ(x))
    intros ρ hρ
    rw ← eq at hρ
    unfold infinitePlaceOf at hρ
    simp at hρ
    cases hρ with ha1 | hb1
    . rw ha1
    . rw hb1
      unfold conjugateEmbedding
      have ap := compose.apply at complexConj, σ, Ring.carrier(K), complexCarrier, complexCarrier, x with fn, complexConj.function, member
      rw ap
      exact complexAbs.conj with v
  have k1 := key with σ1, h1
  have k2 := key with σ2, h2
  rw [k1, k2]

-- Real places (InfinitePlace.IsReal: some, equivalently every, embedding
-- in the place is real) and complex places (InfinitePlace.IsComplex).
predicate RealPlace (K w : Set) :=
  w ∈ infinitePlaces(K) ∧ (∀ σ ∈ w, RealEmbedding(K, σ))

predicate ComplexPlace (K w : Set) := w ∈ infinitePlaces(K) ∧ ¬RealPlace(K, w)

def realPlaces (K : Set) : Set := { w ∈ infinitePlaces(K) | RealPlace(K, w) }

def complexPlaces (K : Set) : Set := { w ∈ infinitePlaces(K) | ComplexPlace(K, w) }

-- The multiplicity of a place: 1 if real, 2 if complex, the number of
-- embeddings in it (InfinitePlace.mult).
def placeMult (w : Set) : Set := cardinality(w)

-- r₁ and r₂ (InfinitePlace.nrRealPlaces, nrComplexPlaces).
def nrRealPlaces (K : Set) : Set := cardinality(realPlaces(K))

def nrComplexPlaces (K : Set) : Set := cardinality(complexPlaces(K))

-- The family w ↦ w(x) over the real places, and w ↦ w(x)² over the
-- complex places.
def realPlaceValues (K x : Set) : Set :=
  { (w, infinitePlaceValue(K, w, x)) | w ∈ realPlaces(K) }

def complexPlaceSquares (K x : Set) : Set :=
  { (w, realMul((infinitePlaceValue(K, w, x), infinitePlaceValue(K, w, x)))) |
    w ∈ complexPlaces(K) }

-- The restriction of a place w of L along f : K →+* L: the embeddings
-- τ ∘ f, τ ∈ w (InfinitePlace.comap).
def placeRestriction (f K L w : Set) : Set :=
  { compose(τ, f, Ring.carrier(K), Ring.carrier(L), complexCarrier) | τ ∈ w }

-- L/K is unramified at the infinite places: every place of L has the
-- multiplicity of its restriction (IsUnramifiedAtInfinitePlaces,
-- InfinitePlace.IsUnramified).
predicate UnramifiedAtInfinitePlaces (f K L : Set) :=
  ∀ w ∈ infinitePlaces(L), cardinality(w) = cardinality(placeRestriction(f, K, L, w))

-- The house of x: the largest |σ(x)| (NumberField.house).
defunique house (K x : Set) (r ∈ ℝ) :=
  (∃ σ ∈ complexEmbeddings(K), r = complexAbs(σ(x))) ∧
  (∀ σ ∈ complexEmbeddings(K), (complexAbs(σ(x)):R) ≤ (r:R))
requires numberField : NumberField(K)
requires member : x ∈ Ring.carrier(K)
proof
  sorry
uniqueness
  sorry

-- Minkowski's bound (4/π)^{r₂} n!/nⁿ √|d_K|.
section MinkowskiBound
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

def minkowskiBound (K : Set) : Set :=
  R[(4 / realPi) ^ (nrComplexPlaces(K):N) *
    (realNat(factorial(numberFieldDegree(K))) /
      realNat(numberFieldDegree(K)) ^ (numberFieldDegree(K):N)) *
    √(realNat(discrMagnitude(K)))]

end MinkowskiBound

-- Section: Finite places
-- The normalised absolute value at a nonzero prime P of 𝓞 K:
-- |x|_P = N(P)^{−ord_P(x)}, |0|_P = 0 (NumberField.FinitePlace, with
-- FinitePlace.norm_def; the finite places are indexed by the nonzero
-- primes themselves, FinitePlace.equivHeightOneSpectrum).
defunique finitePlaceValue (K P x : Set) (r ∈ ℝ) :=
  (x = Ring.zero(K) ∧ r = realZero) ∨
  (x ≠ Ring.zero(K) ∧ r = realRpow(realNat(absNorm(K, P)),
    realNeg(intCastMap(realRing)(adicOrder(ringOfIntegersInclusion(K), P, x)))))
requires numberField : NumberField(K)
requires prime : P ∈ heightOneSpectrum(ringOfIntegersRing(K))
requires member : x ∈ Ring.carrier(K)
proof
  by_cases xz : x = Ring.zero(K)
  . witness realZero
    have z : realZero ∈ ℝ by typecheck
    refine ⟨z, ?_⟩
    left
    exact ⟨xz, rfl⟩
  . have nf0 := numberField
    obtain ⟨field, _, _⟩ := nf0
    have comm := Field.to_comm_ring at K with field
    have sub := ringOfIntegers.subring at K with field, numberField
    have oc := subringRing.comm_ring at K, ringOfIntegers(K) with comm, sub
    have ocR : CommRing(ringOfIntegersRing(K))
      unfold ringOfIntegersRing
      exact oc
    have pr0 := prime
    unfold heightOneSpectrum at pr0
    obtain ⟨_, pi, _⟩ := pr0
    obtain ⟨proper, _⟩ := pi
    obtain ⟨idl, _⟩ := proper
    have an := idealAbsNorm.selected at ringOfIntegersRing(K), P with ocR, idl
    obtain ⟨anN, _⟩ := an
    have anNat : Nat(absNorm(K, P))
      unfold absNorm
      exact nat.omega.backward with anN
    have rn : realNat(absNorm(K, P)) ∈ ℝ by typecheck
    have fr := ringOfIntegers.fraction_ring at K with field, numberField
    have dd := ringOfIntegers.dedekind at K with numberField
    have b : Algebra.base(ringOfIntegersInclusion(K)) = ringOfIntegersRing(K) by simp [ringOfIntegersInclusion, Algebra.mk.base]
    have rg : Algebra.ring(ringOfIntegersInclusion(K)) = K by simp [ringOfIntegersInclusion, Algebra.mk.ring]
    have dd2 : DedekindDomain(Algebra.base(ringOfIntegersInclusion(K))) by rw b; exact dd
    have pr2 : P ∈ heightOneSpectrum(Algebra.base(ringOfIntegersInclusion(K))) by rw b; exact prime
    have mem2 : x ∈ algebraCarrier(ringOfIntegersInclusion(K))
      unfold algebraCarrier
      rw rg
      exact member
    have nz2 : x ≠ Ring.zero(Algebra.ring(ringOfIntegersInclusion(K))) by rw rg; exact xz
    have ao := adicOrder.selected at ringOfIntegersInclusion(K), P, x with fr, dd2, pr2, mem2, nz2
    obtain ⟨aoZ, _⟩ := ao
    have rf := realRing.field
    have rc := Field.to_comm_ring at realRing with rf
    have ih := intCastMap.ring_hom at realRing with rc
    obtain ⟨_, _, ifn, _⟩ := ih
    have ic : Ring.carrier(integerRing) = ℤ by simp [integerRing, Ring.mk.carrier]
    rw [ic, realRing.carrierOf] at ifn
    have iv := FunctionBetween.apply_closed with ifn, aoZ
    have nr : realNeg(intCastMap(realRing)(adicOrder(ringOfIntegersInclusion(K), P, x))) ∈ ℝ by typecheck
    have rr : realRpow(realNat(absNorm(K, P)), realNeg(intCastMap(realRing)(adicOrder(ringOfIntegersInclusion(K), P, x)))) ∈ ℝ by typecheck
    witness realRpow(realNat(absNorm(K, P)), realNeg(intCastMap(realRing)(adicOrder(ringOfIntegersInclusion(K), P, x))))
    refine ⟨rr, ?_⟩
    right
    exact ⟨xz, rfl⟩
uniqueness
  intros a ha first b hb second
  cases first with f1 | f2
  . obtain ⟨x0, a0⟩ := f1
    cases second with g1 | g2
    . obtain ⟨_, b0⟩ := g1
      rw [a0, b0]
    . obtain ⟨xn, _⟩ := g2
      exfalso
      exact xn with x0
  . obtain ⟨xn, a1⟩ := f2
    cases second with g1 | g2
    . obtain ⟨x0, _⟩ := g1
      exfalso
      exact xn with x0
    . obtain ⟨_, b1⟩ := g2
      rw [a1, b1]

-- The family P ↦ |x|_P over the primes where x has nonzero order.
def finitePlaceValues (K x : Set) : Set :=
  { (P, finitePlaceValue(K, P, x)) | P ∈ adicSupport(ringOfIntegersInclusion(K), x) }

-- Section: Completions at finite places
-- 𝓞_P, the P-adic completion lim 𝓞 K ⧸ Pⁿ
-- (HeightOneSpectrum.adicCompletionIntegers), the map 𝓞 K → 𝓞_P, and K_P
-- as the fraction field of 𝓞_P (HeightOneSpectrum.adicCompletion K P; for
-- a complete DVR the fraction field is the completion of K).
def adicCompletionIntegers (K P : Set) : Set :=
  adicCompletionRing(ringOfIntegersRing(K), P)

def adicIntegerMap (K P : Set) : Set :=
  adicOf(selfModule(ringOfIntegersRing(K)), ringOfIntegersRing(K), P)

def adicCompletionField (K P : Set) : Set :=
  fractionRing(adicCompletionIntegers(K, P))

-- The inclusion 𝓞_P → K_P, and 𝓞_P as a subset of K_P.
def adicCompletionInclusion (K P : Set) : Set :=
  localizationMap(adicCompletionIntegers(K, P),
    nonZeroDivisors(adicCompletionIntegers(K, P)))

def adicCompletionIntegersIn (K P : Set) : Set :=
  functionImage(adicCompletionInclusion(K, P),
    Ring.carrier(adicCompletionIntegers(K, P)),
    Ring.carrier(adicCompletionField(K, P)))

-- The embedding K → K_P: a/b goes to the fraction of the images of a, b
-- (the coercion K → adicCompletion K P).
def adicCompletionEmbedding (K P : Set) : Set :=
  { q ∈ Ring.carrier(K) × Ring.carrier(adicCompletionField(K, P)) |
    ∃ x ∈ Ring.carrier(K), ∃ a ∈ ringOfIntegers(K), ∃ b ∈ ringOfIntegers(K),
      b ≠ Ring.zero(K) ∧ call2(Ring.mul(K), x, b) = a ∧
      q = (x, fraction(adicCompletionIntegers(K, P),
        nonZeroDivisors(adicCompletionIntegers(K, P)),
        adicIntegerMap(K, P)(a), adicIntegerMap(K, P)(b))) }

-- The order on K_P: ord(a) − ord(b) for z = a/b with a, b ∈ 𝓞_P nonzero,
-- through the valuation of the DVR 𝓞_P (Valued.v on adicCompletion,
-- additively).
defunique completionOrder (K P z : Set) (n ∈ ℤ) :=
  ∃ a ∈ Ring.carrier(adicCompletionIntegers(K, P)),
  ∃ b ∈ Ring.carrier(adicCompletionIntegers(K, P)),
    a ≠ Ring.zero(adicCompletionIntegers(K, P)) ∧
    b ≠ Ring.zero(adicCompletionIntegers(K, P)) ∧
    z = fraction(adicCompletionIntegers(K, P),
      nonZeroDivisors(adicCompletionIntegers(K, P)), a, b) ∧
    n = integerClass(dvrValuation(adicCompletionIntegers(K, P), a),
      dvrValuation(adicCompletionIntegers(K, P), b))
requires numberField : NumberField(K)
requires prime : P ∈ heightOneSpectrum(ringOfIntegersRing(K))
requires member : z ∈ Ring.carrier(adicCompletionField(K, P))
requires nonzero : z ≠ Ring.zero(adicCompletionField(K, P))
proof
  sorry
uniqueness
  sorry

-- The P-adic topology on K_P: U is open when around each of its points
-- it contains a translate of the image of a power of the maximal ideal of
-- 𝓞_P (the valued topology of adicCompletion).
def adicBall (K P z : Set, n : Nat) : Set :=
  { w ∈ Ring.carrier(adicCompletionField(K, P)) |
    Ring.sub(adicCompletionField(K, P), w, z) ∈
      functionImage(adicCompletionInclusion(K, P),
        idealPow(adicCompletionIntegers(K, P),
          localMaximalIdeal(adicCompletionIntegers(K, P)), n),
        Ring.carrier(adicCompletionField(K, P))) }

def adicCompletionOpens (K P : Set) : Set :=
  { U ∈ 𝒫(Ring.carrier(adicCompletionField(K, P))) |
    ∀ z ∈ U, ∃ n ∈ ℕ, adicBall(K, P, z, n) ⊆ U }

def adicCompletionSpace (K P : Set) : Set :=
  TopologicalSpace.mk(Ring.carrier(adicCompletionField(K, P)),
    adicCompletionOpens(K, P))

-- An embedding is a function K → ℂ.
theorem tkF.complexEmbeddings.function (K σ : Set)
  requires embedding : σ ∈ complexEmbeddings(K)
  shows σ : Ring.carrier(K) → complexCarrier
proof
  unfold complexEmbeddings at embedding
  obtain ⟨sp, _⟩ := embedding
  exact functionSpace.mem_iff.forward with sp


-- Complex conjugation is a ring homomorphism ℂ → ℂ.
theorem tkF.complexConj.ring_hom
  shows RingHom(complexConj, complexRing, complexRing)
proof
  have cr := complexRing.comm_ring
  have rr := CommRing.to_ring with cr
  unfold RingHom
  rw [complexRing.carrierOf, complexRing.addOf, complexRing.zeroOf, complexRing.negOf, complexRing.mulOf, complexRing.oneOf]
  refine ⟨rr, rr, complexConj.function, complexConj.zero, complexConj.one, ?_, ?_, ?_⟩
  . intros x hx
    have hx2 : x ∈ complexCarrier by rw ← complexRing.carrierOf; exact hx
    exact complexConj.neg with hx2
  . intros x hx y hy
    have hx2 : x ∈ complexCarrier by rw ← complexRing.carrierOf; exact hx
    have hy2 : y ∈ complexCarrier by rw ← complexRing.carrierOf; exact hy
    exact complexConj.add with hx2, hy2
  . intros x hx y hy
    have hx2 : x ∈ complexCarrier by rw ← complexRing.carrierOf; exact hx
    have hy2 : y ∈ complexCarrier by rw ← complexRing.carrierOf; exact hy
    exact complexConj.mul with hx2, hy2


-- The conjugate of an embedding is an embedding.
theorem tkF.conjugateEmbedding.mem (K σ : Set)
  requires comm : CommRing(K)
  requires embedding : σ ∈ complexEmbeddings(K)
  shows conjugateEmbedding(K, σ) ∈ complexEmbeddings(K)
proof
  have fn := tkF.complexEmbeddings.function at K, σ with embedding
  have e0 := embedding
  unfold complexEmbeddings at e0
  obtain ⟨_, hom⟩ := e0
  have ch := tkF.complexConj.ring_hom
  have comp := RingHom.comp at σ, complexConj, K, complexRing, complexRing with comm, hom, ch
  rw complexRing.carrierOf at comp
  have cf := compose.function with fn, complexConj.function
  have sp := functionSpace.mem_iff.backward with cf
  unfold conjugateEmbedding
  unfold complexEmbeddings
  exact ⟨sp, comp⟩


-- The values of the conjugate embedding.
theorem tkF.conjugateEmbedding.apply (K σ x : Set)
  requires embedding : σ ∈ complexEmbeddings(K)
  requires member : x ∈ Ring.carrier(K)
  shows conjugateEmbedding(K, σ)(x) = complexConj(σ(x))
proof
  have fn := tkF.complexEmbeddings.function at K, σ with embedding
  unfold conjugateEmbedding
  exact compose.apply at complexConj, σ, Ring.carrier(K), complexCarrier, complexCarrier, x with fn, complexConj.function, member


-- The place of an embedding is a place.
theorem tkF.infinitePlaceOf.mem (K σ : Set)
  requires embedding : σ ∈ complexEmbeddings(K)
  shows infinitePlaceOf(K, σ) ∈ infinitePlaces(K)
proof
  unfold infinitePlaces
  exact infinitePlaces.membership.backward at K, infinitePlaceOf(K, σ) with ⟨σ, embedding, rfl⟩


-- Every place is the place of one of its embeddings.
theorem tkF.infinitePlaces.cases (K w : Set)
  requires place : w ∈ infinitePlaces(K)
  shows ∃ σ ∈ complexEmbeddings(K), w = infinitePlaceOf(K, σ)
proof
  have h := infinitePlaces.membership.forward with place
  obtain ⟨σ, hσ, eq⟩ := h
  symm at eq
  exact ⟨σ, hσ, eq⟩



-- Section: Graphs given by their pairs (copied from LSeries.Dirichlet's
-- coefficientGraph lemmas, which Places does not import).
theorem tkF.graph.function (G A B : Set)
  requires shape : ∀ p ∈ G, ∃ a ∈ A, ∃ b ∈ B, p = (a, b)
  requires total : ∀ a ∈ A, ∃ b ∈ B, (a, b) ∈ G
  requires functional : ∀ a, ∀ b, ∀ c, (a, b) ∈ G → (a, c) ∈ G → b = c
  shows G : A → B
proof
  refine ⟨?_, ?_, ?_⟩
  . unfold RelationBetween
    unfold Subset
    intros p hp
    obtain ⟨a, aIn, b, bIn, eq⟩ := shape with p, hp
    rw eq
    exact product.pair with aIn, bIn
  . unfold Functional
    intros x y xy z xz
    unfold relates at xy
    unfold relates at xz
    exact functional with x, y, z, xy, xz
  . intros a aIn
    obtain ⟨b, bIn, ab⟩ := total with a, aIn
    unfold relates
    exact ⟨b, bIn, ab⟩

theorem tkF.graph.second_in_union (G a b : Set)
  requires mapped : (a, b) ∈ G
  shows b ∈ ⋃(⋃(G))
proof
  have inner := orderedPair.second_in_union at a, b
  obtain ⟨q, qIn, bq⟩ := union.membership.forward with inner
  have qUnion : q ∈ ⋃(G)
    apply union.membership.backward
    exact ⟨(a, b), mapped, qIn⟩
  apply union.membership.backward
  exact ⟨q, qUnion, bq⟩

theorem tkF.graph.apply (G A x y : Set)
  requires shape : ∀ p ∈ G, ∃ a ∈ A, ∃ b, p = (a, b)
  requires total : ∀ a ∈ A, ∃ b, (a, b) ∈ G
  requires functional : ∀ a, ∀ b, ∀ c, (a, b) ∈ G → (a, c) ∈ G → b = c
  requires index : x ∈ A
  requires mapped : (x, y) ∈ G
  shows G(x) = y
proof
  have shapeB : ∀ p ∈ G, ∃ a ∈ A, ∃ b ∈ ⋃(⋃(G)), p = (a, b)
    intros p hp
    obtain ⟨a, aIn, b, eq⟩ := shape with p, hp
    have abIn : (a, b) ∈ G
      rw ← eq
      exact hp
    have outer := tkF.graph.second_in_union with abIn
    exact ⟨a, aIn, b, outer, eq⟩
  have totalB : ∀ a ∈ A, ∃ b ∈ ⋃(⋃(G)), (a, b) ∈ G
    intros a aIn
    obtain ⟨b, ab⟩ := total with a, aIn
    have outer := tkF.graph.second_in_union with ab
    exact ⟨b, outer, ab⟩
  have function := tkF.graph.function with shapeB, totalB, functional
  apply FunctionBetween.apply_value with function, index
  unfold relates
  exact mapped

-- The values σ(x) of an embedding.
theorem tkF.embeddingValues.apply (K x σ : Set)
  requires embedding : σ ∈ complexEmbeddings(K)
  shows embeddingValues(K, x)(σ) = σ(x)
proof
  have shape : ∀ p0 ∈ embeddingValues(K, x), ∃ a0 ∈ complexEmbeddings(K), ∃ b0, p0 = (a0, b0)
    intros p0 hp
    simp [embeddingValues] at hp
    obtain ⟨m0, mIn, eq⟩ := hp
    rw ← eq
    exact ⟨m0, mIn, m0(x), rfl⟩
  have total : ∀ a0 ∈ complexEmbeddings(K), ∃ b0, (a0, b0) ∈ embeddingValues(K, x)
    intros a0 aIn
    refine ⟨a0(x), ?_⟩
    simp [embeddingValues]
  have functional : ∀ a0, ∀ b0, ∀ c0, (a0, b0) ∈ embeddingValues(K, x) →
      (a0, c0) ∈ embeddingValues(K, x) → b0 = c0
    intros a0 b0 c0 ab ac
    simp [embeddingValues] at ab
    simp [embeddingValues] at ac
    obtain ⟨m0, _, abEq⟩ := ab
    obtain ⟨k0, _, acEq⟩ := ac
    obtain ⟨ma, mb⟩ := orderedPair.injective with abEq
    obtain ⟨ka, kc⟩ := orderedPair.injective with acEq
    cc
  have mapped : (σ, σ(x)) ∈ embeddingValues(K, x)
    simp [embeddingValues]
  exact tkF.graph.apply with shape, total, functional, embedding, mapped


-- A place has one embedding exactly when it is fixed by conjugation, and
-- two otherwise.
theorem tkF.infinitePlaceOf.card (K σ : Set)
  shows (conjugateEmbedding(K, σ) = σ → cardinality(infinitePlaceOf(K, σ)) = 1) ∧
    (conjugateEmbedding(K, σ) ≠ σ → cardinality(infinitePlaceOf(K, σ)) = 2)
proof
  constructor
  . intro h
    unfold infinitePlaceOf
    rw h
    rw pair.self
    exact cardinality.singleton
  . intro h
    unfold infinitePlaceOf
    rw pair.eq_union2
    have fs := Finite.singleton at σ
    have fresh : ¬conjugateEmbedding(K, σ) ∈ {σ}
      intro m
      have mm := singleton.membership.forward with m
      exact h with mm
    have c := cardinality.union_singleton at {σ}, conjugateEmbedding(K, σ) with fs, fresh
    rw [c, cardinality.singleton]
    arith


-- An embedding of L composed with K →+* L is an embedding of K.
theorem tkF.complexEmbeddings.compose (K L f τ : Set)
  requires comm : CommRing(K)
  requires hom : RingHom(f, K, L)
  requires embedding : τ ∈ complexEmbeddings(L)
  shows compose(τ, f, Ring.carrier(K), Ring.carrier(L), complexCarrier) ∈
    complexEmbeddings(K)
proof
  have fn := tkF.complexEmbeddings.function at L, τ with embedding
  have e0 := embedding
  unfold complexEmbeddings at e0
  obtain ⟨_, homτ⟩ := e0
  have h0 := hom
  obtain ⟨_, _, ffn, _⟩ := h0
  have comp := RingHom.comp at f, τ, K, L, complexRing with comm, hom, homτ
  rw complexRing.carrierOf at comp
  have cf := compose.function with ffn, fn
  have sp := functionSpace.mem_iff.backward with cf
  unfold complexEmbeddings
  exact ⟨sp, comp⟩


-- ℂ has characteristic zero.
theorem tkF.complexRing.char_zero
  shows CharZero(complexRing)
proof
  unfold CharZero
  intros n hn ne
  have nNat : Nat(n) by typecheck
  have pos : 0 < n by arith
  unfold natCast
  rw [complexRing.addOf, complexRing.zeroOf, complexRing.oneOf]
  exact complexNumeral.nonzero at n with pos


-- Section: Complex embeddings of a number field
section Embeddings
variable (K : Set)
hypothesis field : Field(K)
hypothesis numberField : NumberField(K)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- NumberField.Embeddings.card: there are [K : ℚ] embeddings.
theorem complexEmbeddings.card
  shows HasCardinality(complexEmbeddings(K), numberFieldDegree(K))
proof
  sorry

-- ComplexEmbedding.conjugate is an embedding, and an involution.
theorem conjugateEmbedding.mem (σ : Set)
  requires embedding : σ ∈ complexEmbeddings(K)
  shows conjugateEmbedding(K, σ) ∈ complexEmbeddings(K) ∧
    conjugateEmbedding(K, conjugateEmbedding(K, σ)) = σ
proof
  have comm := Field.to_comm_ring at K with field
  have m := tkF.conjugateEmbedding.mem at K, σ with comm, embedding
  have mm := tkF.conjugateEmbedding.mem at K, conjugateEmbedding(K, σ) with comm, m
  have fn := tkF.complexEmbeddings.function at K, σ with embedding
  have fn4 := tkF.complexEmbeddings.function at K, conjugateEmbedding(K, conjugateEmbedding(K, σ)) with mm
  have same : ∀ x ∈ Ring.carrier(K), conjugateEmbedding(K, conjugateEmbedding(K, σ))(x) = σ(x)
    intros x hx
    have a1 := tkF.conjugateEmbedding.apply at K, conjugateEmbedding(K, σ), x with m, hx
    have a2 := tkF.conjugateEmbedding.apply at K, σ, x with embedding, hx
    have v := FunctionBetween.apply_closed with fn, hx
    rw [a1, a2]
    exact complexConj.involutive with v
  have inv := FunctionBetween.ext with fn4, fn, same
  exact ⟨m, inv⟩



-- ComplexEmbedding.conjugate_comp, the values of the conjugate.
theorem conjugateEmbedding.apply (σ x : Set)
  requires embedding : σ ∈ complexEmbeddings(K)
  requires member : x ∈ Ring.carrier(K)
  shows conjugateEmbedding(K, σ)(x) = complexConj(σ(x))
proof
  exact tkF.conjugateEmbedding.apply at K, σ, x with embedding, member


-- ComplexEmbedding.isReal_iff: real exactly when equal to its conjugate.
theorem RealEmbedding.iff_conjugate (σ : Set)
  requires embedding : σ ∈ complexEmbeddings(K)
  shows RealEmbedding(K, σ) ↔ conjugateEmbedding(K, σ) = σ
proof
  have fn := tkF.complexEmbeddings.function at K, σ with embedding
  have comm := Field.to_comm_ring at K with field
  have m := tkF.conjugateEmbedding.mem at K, σ with comm, embedding
  have fnc := tkF.complexEmbeddings.function at K, conjugateEmbedding(K, σ) with m
  constructor
  . intro h
    obtain ⟨_, all⟩ := h
    have same : ∀ x ∈ Ring.carrier(K), conjugateEmbedding(K, σ)(x) = σ(x)
      intros x hx
      have a := tkF.conjugateEmbedding.apply at K, σ, x with embedding, hx
      rw a
      exact all with x, hx
    exact FunctionBetween.ext with fnc, fn, same
  . intro h
    unfold RealEmbedding
    refine ⟨embedding, ?_⟩
    intros x hx
    have a := tkF.conjugateEmbedding.apply at K, σ, x with embedding, hx
    rw ← a
    rw h


-- Algebra.norm_eq_prod_embeddings: N(x) = Π_σ σ(x) in ℂ.
theorem fieldNorm.prod_embeddings (x : K)
  shows ratCastMap(complexRing)(fieldNorm(K, x)) =
    finiteRingProduct(complexEmbeddings(K), complexCarrier, complexAdd,
      complexZero, complexNeg, complexMul, complexOne, embeddingValues(K, x))
proof
  sorry

-- Algebra.trace_eq_sum_embeddings: Tr(x) = Σ_σ σ(x) in ℂ.
theorem fieldTrace.sum_embeddings (x : K)
  shows ratCastMap(complexRing)(fieldTrace(K, x)) =
    finiteRingSum(complexEmbeddings(K), complexCarrier, complexAdd,
      complexZero, complexNeg, complexMul, complexOne, embeddingValues(K, x))
proof
  sorry

-- |N(x)| = Π_σ |σ(x)| (the absolute value of norm_eq_prod_embeddings).
theorem fieldNorm.abs_prod_embeddings (x : K)
  shows realAbs(ratCastMap(realRing)(fieldNorm(K, x))) =
    finiteRingProduct(complexEmbeddings(K), ℝ, realAdd, realZero, realNeg,
      realMul, realOne, embeddingAbsValues(K, x))
proof
  sorry

-- The embedding matrix is a square complex matrix.
theorem embeddingMatrix.mem (I b e : Set)
  requires family : b : I → Ring.carrier(K)
  requires enumeration : e : I → complexEmbeddings(K)
  shows embeddingMatrix(K, I, b, e) ∈ matrixSpace(complexRing, I, I)
proof
  have values : ∀ i ∈ I, ∀ j ∈ I, e(j)(b(i)) ∈ complexCarrier
    intros i hi j hj
    have ej := FunctionBetween.apply_closed with enumeration, hj
    have bi := FunctionBetween.apply_closed with family, hi
    have fn := tkF.complexEmbeddings.function at K, e(j) with ej
    exact FunctionBetween.apply_closed with fn, bi
  have function : embeddingMatrix(K, I, b, e) : I × I → complexCarrier
    constructor
      intros q0 member
      obtain ⟨bounded, witnesses⟩ := embeddingMatrix.membership.forward with member
      exact bounded
    . constructor
        intros z0 first xFirst second xSecond
        unfold relates at xFirst
        obtain ⟨_, a1, a1In, b1, b1In, firstShape⟩ := embeddingMatrix.membership.forward with xFirst
        unfold relates at xSecond
        obtain ⟨_, a2, a2In, b2, b2In, secondShape⟩ := embeddingMatrix.membership.forward with xSecond
        obtain ⟨xi, firstEqual⟩ := orderedPair.injective with firstShape
        obtain ⟨xj, secondEqual⟩ := orderedPair.injective with secondShape
        rw xi at xj
        obtain ⟨aa, bb⟩ := orderedPair.injective with xj
        rw [firstEqual, secondEqual]
        cc
      . intros q0 pIn
        obtain ⟨bound, i, rowIn, j, colIn, shape⟩ := product.membership.forward with pIn
        have valueIn := values with i, rowIn, j, colIn
        have pairIn := product.pair at i, j, I, I with rowIn, colIn
        have outer := product.pair at (i, j), e(j)(b(i)), I × I, complexCarrier with pairIn, valueIn
        have mapped : relates(embeddingMatrix(K, I, b, e), (i, j), e(j)(b(i)))
          unfold relates
          apply embeddingMatrix.membership.backward
          exact ⟨outer, i, rowIn, j, colIn, rfl⟩
        rw shape
        exact ⟨e(j)(b(i)), valueIn, mapped⟩
  unfold matrixSpace
  rw complexRing.carrierOf
  exact functionSpace.mem_iff.backward with function


-- Algebra.discr_eq_det_embeddingsMatrixReindex_pow_two: for a ℤ-basis b
-- of 𝓞 K and an enumeration e of the embeddings by the same index set,
-- d_K = det(σ_j(b_i))².
theorem numberFieldDiscr.det_embeddings (I b e : Set)
  requires finite : Finite(I)
  requires basis : ModuleBasis(ringOfIntegersModule(K), integerRing, I, b)
  requires enumeration : BijectiveBetween(e, I, complexEmbeddings(K))
  shows intCastMap(complexRing)(numberFieldDiscr(K)) =
    complexMul((matDet(complexRing, I, embeddingMatrix(K, I, b, e)),
      matDet(complexRing, I, embeddingMatrix(K, I, b, e))))
proof
  sorry

-- NumberField.Embeddings.pow_eq_one_of_norm_eq_one (Kronecker): an
-- algebraic integer all of whose conjugates have modulus 1 is a root of
-- unity.
theorem complexEmbeddings.pow_eq_one_of_abs_eq_one (x : Set)
  requires integral : x ∈ ringOfIntegers(K)
  requires unit : ∀ σ ∈ complexEmbeddings(K), complexAbs(σ(x)) = realOne
  shows ∃ n ∈ ℕ, n ≠ 0 ∧ Ring.pow(K, x, n) = Ring.one(K)
proof
  sorry

-- NumberField.one_le_house_of_isIntegral
theorem house.one_le (x : Set)
  requires integral : x ∈ ringOfIntegers(K)
  requires nonzero : x ≠ Ring.zero(K)
  shows (1:R) ≤ (house(K, x):R)
proof
  sorry

-- Section: Infinite places
-- InfinitePlace.mk_eq_iff: two embeddings give the same place exactly
-- when they are equal or conjugate.
theorem infinitePlaceOf.eq_iff (σ τ : Set)
  requires first : σ ∈ complexEmbeddings(K)
  requires second : τ ∈ complexEmbeddings(K)
  shows infinitePlaceOf(K, σ) = infinitePlaceOf(K, τ) ↔
    (τ = σ ∨ τ = conjugateEmbedding(K, σ))
proof
  have comm := Field.to_comm_ring at K with field
  constructor
  . intro eq
    have t : τ ∈ infinitePlaceOf(K, τ)
      unfold infinitePlaceOf
      exact pair.left
    rw ← eq at t
    unfold infinitePlaceOf at t
    simp at t
    exact t
  . intro h
    cases h with h1 | h2
    . rw h1
    . have inv := conjugateEmbedding.mem at K, σ with field, numberField, first
      obtain ⟨_, back⟩ := inv
      rw h2
      unfold infinitePlaceOf
      rw back
      exact pair.commutative


-- The places partition the embeddings (InfinitePlace.mk surjective,
-- mk_embedding; Σ_w mult(w) = n, InfinitePlace.sum_mult_eq).
theorem infinitePlaces.partition
  shows ⋃(infinitePlaces(K)) = complexEmbeddings(K) ∧
    (∀ v ∈ infinitePlaces(K), ∀ w ∈ infinitePlaces(K), v ≠ w → v ∩ w = ∅)
proof
  constructor
  . ext ρ
    constructor
    . intro h
      obtain ⟨w, hw, hρ⟩ := set.union.forward with h
      obtain ⟨σ, hσ, eq⟩ := tkF.infinitePlaces.cases at K, w with hw
      rw eq at hρ
      unfold infinitePlaceOf at hρ
      simp at hρ
      cases hρ with h1 | h2
      . rw h1
        exact hσ
      . have m := conjugateEmbedding.mem at K, σ with field, numberField, hσ
        rw h2
        exact m.left
    . intro h
      have pl := tkF.infinitePlaceOf.mem at K, ρ with h
      have t : ρ ∈ infinitePlaceOf(K, ρ)
        unfold infinitePlaceOf
        exact pair.left
      exact set.union.backward with ⟨infinitePlaceOf(K, ρ), pl, t⟩
  . intros v hv w hw ne
    ext ρ
    constructor
    . intro hρ
      exfalso
      simp at hρ
      obtain ⟨inv, inw⟩ := hρ
      obtain ⟨σ, hσ, eqv⟩ := tkF.infinitePlaces.cases at K, v with hv
      obtain ⟨τ, hτ, eqw⟩ := tkF.infinitePlaces.cases at K, w with hw
      have ρin : ρ ∈ complexEmbeddings(K)
        rw eqv at inv
        unfold infinitePlaceOf at inv
        simp at inv
        cases inv with h1 | h2
        . rw h1
          exact hσ
        . have m := conjugateEmbedding.mem at K, σ with field, numberField, hσ
          rw h2
          exact m.left
      rw eqv at inv
      rw eqw at inw
      unfold infinitePlaceOf at inv
      unfold infinitePlaceOf at inw
      simp at inv
      simp at inw
      have e1 := (infinitePlaceOf.eq_iff at K, σ, ρ with field, numberField, hσ, ρin).backward with inv
      have e2 := (infinitePlaceOf.eq_iff at K, τ, ρ with field, numberField, hτ, ρin).backward with inw
      apply ne
      rw [eqv, eqw, e1, e2]
    . intro hρ
      exfalso
      simp at hρ


-- InfinitePlace.finite: finitely many places.
theorem infinitePlaces.finite
  shows Finite(infinitePlaces(K))
proof
  have card := complexEmbeddings.card at K with field, numberField
  have fe : Finite(complexEmbeddings(K)) := ⟨numberFieldDegree(K), card⟩
  have fp := Finite.powerset at complexEmbeddings(K) with fe
  have sub : infinitePlaces(K) ⊆ 𝒫(complexEmbeddings(K))
    intros w hw
    have part := infinitePlaces.partition at K with field, numberField
    obtain ⟨un, _⟩ := part
    apply powerset.membership_iff.backward
    intros ρ hρ
    rw ← un
    exact set.union.backward with ⟨w, hw, hρ⟩
  exact Finite.subset with fp, sub


-- InfinitePlace.isReal_or_isComplex, not_isReal_iff_isComplex
theorem infinitePlaces.real_or_complex (w : Set)
  requires place : w ∈ infinitePlaces(K)
  shows (RealPlace(K, w) ∨ ComplexPlace(K, w)) ∧ ¬(RealPlace(K, w) ∧ ComplexPlace(K, w))
proof
  constructor
  . by_cases h : RealPlace(K, w)
    . left
      exact h
    . right
      unfold ComplexPlace
      exact ⟨place, h⟩
  . intro both
    obtain ⟨r, c⟩ := both
    obtain ⟨_, nr⟩ := c
    exact nr with r


-- InfinitePlace.isReal_mk_iff
theorem RealPlace.of_embedding (σ : Set)
  requires embedding : σ ∈ complexEmbeddings(K)
  shows RealPlace(K, infinitePlaceOf(K, σ)) ↔ RealEmbedding(K, σ)
proof
  have comm := Field.to_comm_ring at K with field
  have pl := tkF.infinitePlaceOf.mem at K, σ with embedding
  constructor
  . intro h
    obtain ⟨_, all⟩ := h
    have t : σ ∈ infinitePlaceOf(K, σ)
      unfold infinitePlaceOf
      exact pair.left
    exact all with σ, t
  . intro h
    have c := (RealEmbedding.iff_conjugate at K, σ with field, numberField, embedding).forward with h
    unfold RealPlace
    refine ⟨pl, ?_⟩
    intros τ hτ
    unfold infinitePlaceOf at hτ
    simp at hτ
    cases hτ with h1 | h2
    . rw h1
      exact h
    . rw [h2, c]
      exact h


-- InfinitePlace.isReal_mk_iff, mult: a real place has one embedding, a
-- complex place two.
theorem placeMult.value (w : Set)
  requires place : w ∈ infinitePlaces(K)
  shows (RealPlace(K, w) ↔ placeMult(w) = 1) ∧ (ComplexPlace(K, w) ↔ placeMult(w) = 2)
proof
  sorry



-- InfinitePlace.card_add_two_mul_card_eq_rank: r₁ + 2 r₂ = [K : ℚ].
theorem nrPlaces.card_add_two_mul
  shows add(nrRealPlaces(K), mul(2, nrComplexPlaces(K))) = numberFieldDegree(K)
proof
  sorry

-- InfinitePlace.card_eq_nrRealPlaces_add_nrComplexPlaces
theorem infinitePlaces.card
  shows HasCardinality(infinitePlaces(K), add(nrRealPlaces(K), nrComplexPlaces(K)))
proof
  have fin := infinitePlaces.finite at K with field, numberField
  have subR : realPlaces(K) ⊆ infinitePlaces(K)
    intros w hw
    unfold realPlaces at hw
    exact hw.left
  have subC : complexPlaces(K) ⊆ infinitePlaces(K)
    intros w hw
    unfold complexPlaces at hw
    exact hw.left
  have finR := Finite.subset with fin, subR
  have finC := Finite.subset with fin, subC
  have dis : Disjoint(realPlaces(K), complexPlaces(K))
    unfold Disjoint
    ext w
    constructor
    . intro h
      exfalso
      simp at h
      obtain ⟨hr, hc⟩ := h
      unfold complexPlaces at hc
      obtain ⟨_, cp⟩ := hc
      obtain ⟨_, nr⟩ := cp
      unfold realPlaces at hr
      obtain ⟨_, r⟩ := hr
      exact nr with r
    . intro h
      exfalso
      simp at h
  have un : realPlaces(K) ∪ complexPlaces(K) = infinitePlaces(K)
    ext w
    constructor
    . intro h
      have hh := union2.membership.forward with h
      cases hh with h1 | h2
      . exact subR with w, h1
      . exact subC with w, h2
    . intro h
      have rc := infinitePlaces.real_or_complex at K, w with field, numberField, h
      obtain ⟨either, _⟩ := rc
      apply union2.membership.backward
      cases either with r | c
      . left
        unfold realPlaces
        exact ⟨h, r⟩
      . right
        unfold complexPlaces
        exact ⟨h, c⟩
  have cu := cardinality.union_disjoint at realPlaces(K), complexPlaces(K) with finR, finC, dis
  rw un at cu
  have cc := cardinality.correct at infinitePlaces(K) with fin
  rw cu at cc
  unfold nrRealPlaces
  unfold nrComplexPlaces
  exact cc


-- InfinitePlace.apply, the value through any embedding of the place.
theorem infinitePlaceValue.of_embedding (σ x : Set)
  requires embedding : σ ∈ complexEmbeddings(K)
  requires member : x ∈ Ring.carrier(K)
  shows infinitePlaceValue(K, infinitePlaceOf(K, σ), x) = complexAbs(σ(x))
proof
  have pl := tkF.infinitePlaceOf.mem at K, σ with embedding
  have fn := tkF.complexEmbeddings.function at K, σ with embedding
  have v := FunctionBetween.apply_closed with fn, member
  have sel := infinitePlaceValue.selected at K, infinitePlaceOf(K, σ), x with field, pl, member
  obtain ⟨_, τ, hτ, eq⟩ := sel
  rw eq
  unfold infinitePlaceOf at hτ
  simp at hτ
  cases hτ with h1 | h2
  . rw h1
  . rw h2
    have a := tkF.conjugateEmbedding.apply at K, σ, x with embedding, member
    rw a
    exact complexAbs.conj with v


-- An infinite place is an absolute value: nonnegative, zero only at 0,
-- multiplicative, subadditive (InfinitePlace as AbsoluteValue).
theorem infinitePlaceValue.absolute_value (w x y : Set)
  requires place : w ∈ infinitePlaces(K)
  requires first : x ∈ Ring.carrier(K)
  requires second : y ∈ Ring.carrier(K)
  shows (0:R) ≤ (infinitePlaceValue(K, w, x):R) ∧
    (infinitePlaceValue(K, w, x) = realZero ↔ x = Ring.zero(K)) ∧
    infinitePlaceValue(K, w, call2(Ring.mul(K), x, y)) =
      realMul((infinitePlaceValue(K, w, x), infinitePlaceValue(K, w, y))) ∧
    (infinitePlaceValue(K, w, call2(Ring.add(K), x, y)):R) ≤
      R[infinitePlaceValue(K, w, x) + infinitePlaceValue(K, w, y)]
proof
  have comm := Field.to_comm_ring at K with field
  have ringK := CommRing.to_ring with comm
  have cc := complexRing.comm_ring
  obtain ⟨σ, hσ, eq⟩ := tkF.infinitePlaces.cases at K, w with place
  have xyIn : call2(Ring.mul(K), x, y) ∈ Ring.carrier(K) by typecheck
  have xpyIn : call2(Ring.add(K), x, y) ∈ Ring.carrier(K) by typecheck
  have vx := infinitePlaceValue.of_embedding at K, σ, x with field, numberField, hσ, first
  have vy := infinitePlaceValue.of_embedding at K, σ, y with field, numberField, hσ, second
  have vxy := infinitePlaceValue.of_embedding at K, σ, call2(Ring.mul(K), x, y) with field, numberField, hσ, xyIn
  have vxpy := infinitePlaceValue.of_embedding at K, σ, call2(Ring.add(K), x, y) with field, numberField, hσ, xpyIn
  have fn := tkF.complexEmbeddings.function at K, σ with hσ
  have sx := FunctionBetween.apply_closed with fn, first
  have sy := FunctionBetween.apply_closed with fn, second
  have h0 := hσ
  unfold complexEmbeddings at h0
  obtain ⟨_, hom⟩ := h0
  rw eq
  rw [vx, vy, vxy, vxpy]
  refine ⟨?_, ?_, ?_, ?_⟩
  . exact complexAbs.nonnegative with sx
  . constructor
    . intro z
      have sz := (complexAbs.zero_iff with sx).forward with z
      by_contra nz
      have u := (Field.unit_iff at K, x with field, first).backward with nz
      have su := RingUnit.map at K, complexRing, σ, x with comm, cc, hom, u
      have nt := complexRing.nontrivial
      have ne := RingUnit.ne_zero at complexRing, σ(x) with cc, nt, su
      rw complexRing.zeroOf at ne
      exact ne with sz
    . intro z
      rw z
      have m0 := RingHom.map_zero at σ, K, complexRing with hom
      rw [m0, complexRing.zeroOf]
      have zz := complexAbs.zero_iff at complexZero with complexZero.member
      exact zz.backward with rfl
  . have mm := RingHom.map_mul at σ, K, complexRing, x, y with hom, first, second
    rw complexRing.mulOf at mm
    rw mm
    have cm := complexAbs.mul with sx, sy
    unfold call2 at cm
    unfold call2
    exact cm
  . have ma := RingHom.map_add at σ, K, complexRing, x, y with hom, first, second
    rw complexRing.addOf at ma
    rw ma
    exact complexAbs.triangle with sx, sy


-- InfinitePlace.ext: a place is determined by its values.
theorem infinitePlaces.ext (v w : Set)
  requires first : v ∈ infinitePlaces(K)
  requires second : w ∈ infinitePlaces(K)
  requires same : ∀ x ∈ Ring.carrier(K), infinitePlaceValue(K, v, x) = infinitePlaceValue(K, w, x)
  shows v = w
proof
  sorry

-- InfinitePlace.prod_eq_abs_norm: Π_w w(x)^{mult w} = |N(x)|, split into
-- the real and the complex places.
theorem infinitePlaceValue.prod_eq_abs_norm (x : K)
  shows realMul((finiteRingProduct(realPlaces(K), ℝ, realAdd, realZero, realNeg,
      realMul, realOne, realPlaceValues(K, x)),
    finiteRingProduct(complexPlaces(K), ℝ, realAdd, realZero, realNeg,
      realMul, realOne, complexPlaceSquares(K, x)))) =
    realAbs(ratCastMap(realRing)(fieldNorm(K, x)))
proof
  sorry

-- NumberField.IsTotallyReal.nrComplexPlaces_eq_zero and its converse:
-- every place is real exactly when r₂ = 0.
theorem nrComplexPlaces.eq_zero_iff
  shows nrComplexPlaces(K) = 0 ↔
    (∀ σ ∈ complexEmbeddings(K), RealEmbedding(K, σ))
proof
  have fin := infinitePlaces.finite at K with field, numberField
  have subC : complexPlaces(K) ⊆ infinitePlaces(K)
    intros w hw
    unfold complexPlaces at hw
    exact hw.left
  have finC := Finite.subset with fin, subC
  unfold nrComplexPlaces
  constructor
  . intro z
    have empty := cardinality.eq_empty_of_zero at complexPlaces(K) with finC, z
    intros σ hσ
    have pl := tkF.infinitePlaceOf.mem at K, σ with hσ
    have rp := RealPlace.of_embedding at K, σ with field, numberField, hσ
    by_contra nr
    have nrp : ¬RealPlace(K, infinitePlaceOf(K, σ))
      intro r
      exact nr with (rp.forward with r)
    have cp : infinitePlaceOf(K, σ) ∈ complexPlaces(K)
      unfold complexPlaces
      unfold ComplexPlace
      exact ⟨pl, pl, nrp⟩
    rw empty at cp
    simp at cp
  . intro all
    have empty : complexPlaces(K) = ∅
      ext w
      constructor
      . intro h
        exfalso
        unfold complexPlaces at h
        obtain ⟨hw, cp⟩ := h
        obtain ⟨_, nr⟩ := cp
        obtain ⟨σ, hσ, eq⟩ := tkF.infinitePlaces.cases at K, w with hw
        have rp := RealPlace.of_embedding at K, σ with field, numberField, hσ
        have r := rp.backward with (all with σ, hσ)
        rw eq at nr
        exact nr with r
      . intro h
        exfalso
        simp at h
    rw empty
    exact cardinality.empty


-- The sign of the discriminant is (−1)^{r₂} (NumberField.sign_discr).
theorem numberFieldDiscr.sign
  shows (∀ m ∈ ℕ, nrComplexPlaces(K) = mul(2, m) →
      integerLess(integerZero, numberFieldDiscr(K))) ∧
    (∀ m ∈ ℕ, nrComplexPlaces(K) = succ(mul(2, m)) →
      integerLess(numberFieldDiscr(K), integerZero))
proof
  sorry

-- NumberField.exists_ideal_in_class_of_norm_le (Minkowski): every ideal
-- class contains an ideal of norm at most the Minkowski bound.
theorem classGroup.exists_ideal_of_norm_le (I : Set)
  requires fractional : I ∈ nonzeroFractionalIdeals(ringOfIntegersInclusion(K))
  shows ∃ J, Ideal(ringOfIntegersRing(K), J) ∧ J ≠ {Ring.zero(K)} ∧
    ⟦coeIdeal(ringOfIntegersInclusion(K), J)⟧[
      nonzeroFractionalIdeals(ringOfIntegersInclusion(K)),
      idealClassRelation(ringOfIntegersInclusion(K))] =
    ⟦I⟧[nonzeroFractionalIdeals(ringOfIntegersInclusion(K)),
      idealClassRelation(ringOfIntegersInclusion(K))] ∧
    (realNat(absNorm(K, J)):R) ≤ (minkowskiBound(K):R)
proof
  sorry

-- Section: Finite places
-- FinitePlace.norm_le_one, norm_eq_one_iff_not_mem: on 𝓞 K the absolute
-- value is at most 1, and below 1 exactly on P.
theorem finitePlaceValue.of_integer (P x : Set)
  requires prime : P ∈ heightOneSpectrum(ringOfIntegersRing(K))
  requires integral : x ∈ ringOfIntegers(K)
  shows (finitePlaceValue(K, P, x):R) ≤ (1:R) ∧
    (finitePlaceValue(K, P, x) = realOne ↔ x ∉ P)
proof
  sorry

-- The finite places are absolute values, nonarchimedean
-- (FinitePlace as AbsoluteValue, IsNonarchimedean).
theorem finitePlaceValue.absolute_value (P x y : Set)
  requires prime : P ∈ heightOneSpectrum(ringOfIntegersRing(K))
  requires first : x ∈ Ring.carrier(K)
  requires second : y ∈ Ring.carrier(K)
  shows (0:R) ≤ (finitePlaceValue(K, P, x):R) ∧
    (finitePlaceValue(K, P, x) = realZero ↔ x = Ring.zero(K)) ∧
    finitePlaceValue(K, P, call2(Ring.mul(K), x, y)) =
      realMul((finitePlaceValue(K, P, x), finitePlaceValue(K, P, y))) ∧
    ((finitePlaceValue(K, P, call2(Ring.add(K), x, y)):R) ≤
      (finitePlaceValue(K, P, x):R) ∨
     (finitePlaceValue(K, P, call2(Ring.add(K), x, y)):R) ≤
      (finitePlaceValue(K, P, y):R))
proof
  sorry

-- NumberField.FinitePlace.prod_eq_inv_abs_norm: Π_P |x|_P = |N(x)|⁻¹.
theorem finitePlaceValue.prod_eq_inv_abs_norm (x : K)
  requires nonzero : x ≠ Ring.zero(K)
  shows realMul((finiteRingProduct(adicSupport(ringOfIntegersInclusion(K), x), ℝ,
      realAdd, realZero, realNeg, realMul, realOne, finitePlaceValues(K, x)),
    realAbs(ratCastMap(realRing)(fieldNorm(K, x))))) = realOne
proof
  sorry

-- NumberField.prod_abs_eq_one (the product formula):
-- Π_w w(x)^{mult w} Π_P |x|_P = 1.
theorem placeValues.product_formula (x : K)
  requires nonzero : x ≠ Ring.zero(K)
  shows realMul((realMul((finiteRingProduct(realPlaces(K), ℝ, realAdd, realZero,
        realNeg, realMul, realOne, realPlaceValues(K, x)),
      finiteRingProduct(complexPlaces(K), ℝ, realAdd, realZero, realNeg,
        realMul, realOne, complexPlaceSquares(K, x)))),
    finiteRingProduct(adicSupport(ringOfIntegersInclusion(K), x), ℝ,
      realAdd, realZero, realNeg, realMul, realOne, finitePlaceValues(K, x)))) =
    realOne
proof
  sorry

-- Section: Completions at finite places
-- adicCompletionIntegers is a complete DVR, and K_P is its fraction field
-- (HeightOneSpectrum.adicCompletionIntegers, valuationSubringAtPrime).
theorem adicCompletionIntegers.dvr (P : Set)
  requires prime : P ∈ heightOneSpectrum(ringOfIntegersRing(K))
  shows DiscreteValuationRing(adicCompletionIntegers(K, P)) ∧
    AdicCompleteRing(adicCompletionIntegers(K, P),
      localMaximalIdeal(adicCompletionIntegers(K, P)))
proof
  sorry

theorem adicCompletionField.field (P : Set)
  requires prime : P ∈ heightOneSpectrum(ringOfIntegersRing(K))
  shows Field(adicCompletionField(K, P)) ∧
    RingHom(adicCompletionInclusion(K, P), adicCompletionIntegers(K, P),
      adicCompletionField(K, P)) ∧
    InjectiveBetween(adicCompletionInclusion(K, P),
      Ring.carrier(adicCompletionIntegers(K, P)),
      Ring.carrier(adicCompletionField(K, P)))
proof
  sorry

-- The coercion K → K_P is an injective ring homomorphism with dense image
-- (adicCompletion.coe_injective, denseRange_coe).
theorem adicCompletionEmbedding.ring_hom (P : Set)
  requires prime : P ∈ heightOneSpectrum(ringOfIntegersRing(K))
  shows RingHom(adicCompletionEmbedding(K, P), K, adicCompletionField(K, P)) ∧
    InjectiveBetween(adicCompletionEmbedding(K, P), Ring.carrier(K),
      Ring.carrier(adicCompletionField(K, P))) ∧
    (∀ z ∈ Ring.carrier(adicCompletionField(K, P)), ∀ n ∈ ℕ,
      ∃ x ∈ Ring.carrier(K), adicCompletionEmbedding(K, P)(x) ∈ adicBall(K, P, z, n))
proof
  sorry

-- valuedAdicCompletion_eq_valuation: the order of K_P extends that of K.
theorem completionOrder.of_embedding (P x : Set)
  requires prime : P ∈ heightOneSpectrum(ringOfIntegersRing(K))
  requires member : x ∈ Ring.carrier(K)
  requires nonzero : x ≠ Ring.zero(K)
  shows completionOrder(K, P, adicCompletionEmbedding(K, P)(x)) =
    adicOrder(ringOfIntegersInclusion(K), P, x)
proof
  sorry

-- valuedAdicCompletion_surjective: the order takes every integer value.
theorem completionOrder.surjective (P n : Set)
  requires prime : P ∈ heightOneSpectrum(ringOfIntegersRing(K))
  requires integer : n ∈ ℤ
  shows ∃ z ∈ Ring.carrier(adicCompletionField(K, P)),
    z ≠ Ring.zero(adicCompletionField(K, P)) ∧ completionOrder(K, P, z) = n
proof
  sorry

-- mem_adicCompletionIntegers: 𝓞_P is the set of elements of nonnegative
-- order, with 0.
theorem adicCompletionIntegersIn.mem_iff (P z : Set)
  requires prime : P ∈ heightOneSpectrum(ringOfIntegersRing(K))
  requires member : z ∈ Ring.carrier(adicCompletionField(K, P))
  shows z ∈ adicCompletionIntegersIn(K, P) ↔
    (z = Ring.zero(adicCompletionField(K, P)) ∨
      integerLe(integerZero, completionOrder(K, P, z)))
proof
  sorry

-- K_P is a locally compact topological field in which 𝓞_P is open and
-- compact (the residue field 𝓞 K ⧸ P is finite).
theorem adicCompletionSpace.locally_compact (P : Set)
  requires prime : P ∈ heightOneSpectrum(ringOfIntegersRing(K))
  shows TopologicalSpace(adicCompletionSpace(K, P)) ∧
    TopologicalRing(adicCompletionField(K, P), adicCompletionSpace(K, P)) ∧
    LocallyCompact(adicCompletionSpace(K, P)) ∧
    adicCompletionIntegersIn(K, P) ∈ TopologicalSpace.opens(adicCompletionSpace(K, P)) ∧
    Compact(adicCompletionSpace(K, P), adicCompletionIntegersIn(K, P))
proof
  sorry

end Embeddings

-- Rat.isReal_infinitePlace: ℚ has one infinite place, and it is real.
theorem infinitePlaces.rationals
  shows HasCardinality(infinitePlaces(rationalRing), 1) ∧
    (∀ w ∈ infinitePlaces(rationalRing), RealPlace(rationalRing, w))
proof
  have qf0 := rationalRing.field
  have qf := qf0.left
  have qc := Field.to_comm_ring at rationalRing with qf
  have nfq := NumberField.rationals
  have cz := tkF.complexRing.char_zero
  have cf := complexRing.field
  have hom := ratCastMap.ring_hom at complexRing with cf, cz
  have h0 := hom
  obtain ⟨_, _, fn, _⟩ := h0
  rw complexRing.carrierOf at fn
  have fs := functionSpace.mem_iff.backward with fn
  have ρIn : ratCastMap(complexRing) ∈ complexEmbeddings(rationalRing)
    unfold complexEmbeddings
    exact ⟨fs, hom⟩
  have only : ∀ σ ∈ complexEmbeddings(rationalRing), σ = ratCastMap(complexRing)
    intros σ hσ
    have h1 := hσ
    unfold complexEmbeddings at h1
    obtain ⟨_, homσ⟩ := h1
    exact ratCastMap.unique at complexRing, σ with cf, cz, homσ
  have cm := conjugateEmbedding.mem at rationalRing, ratCastMap(complexRing) with qf, nfq, ρIn
  have cfix := only with conjugateEmbedding(rationalRing, ratCastMap(complexRing)), cm.left
  have re := (RealEmbedding.iff_conjugate at rationalRing, ratCastMap(complexRing) with qf, nfq, ρIn).backward with cfix
  have single : infinitePlaces(rationalRing) = {infinitePlaceOf(rationalRing, ratCastMap(complexRing))}
    ext w
    constructor
    . intro hw
      obtain ⟨σ, hσ, eq⟩ := tkF.infinitePlaces.cases at rationalRing, w with hw
      have e := only with σ, hσ
      rw [eq, e]
      simp
    . intro hw
      have e := singleton.membership.forward with hw
      rw e
      exact tkF.infinitePlaceOf.mem at rationalRing, ratCastMap(complexRing) with ρIn
  constructor
  . rw single
    have fsg := Finite.singleton at infinitePlaceOf(rationalRing, ratCastMap(complexRing))
    have c := cardinality.correct with fsg
    rw cardinality.singleton at c
    exact c
  . intros w hw
    obtain ⟨σ, hσ, eq⟩ := tkF.infinitePlaces.cases at rationalRing, w with hw
    have e := only with σ, hσ
    rw [eq, e]
    exact (RealPlace.of_embedding at rationalRing, ratCastMap(complexRing) with qf, nfq, ρIn).backward with re


-- Algebra.norm_complex_eq, Algebra.norm_complex_apply: over ℝ the norm of
-- z ∈ ℂ is |z|² and its trace 2 re z.
theorem algebraNorm.complex (z : Set)
  requires member : z ∈ complexCarrier
  shows algebraNorm(Algebra.mk(realRing, complexRing, complexOfReal), z) =
      realMul((complexAbs(z), complexAbs(z))) ∧
    algebraTrace(Algebra.mk(realRing, complexRing, complexOfReal), z) =
      realAdd((complexRe(z), complexRe(z)))
proof
  sorry

-- Section: Places in extensions
section Extension
variable (K L f : Set)
hypothesis sourceField : Field(K)
hypothesis targetField : Field(L)
hypothesis source : NumberField(K)
hypothesis target : NumberField(L)
hypothesis hom : RingHom(f, K, L)

-- NumberField.ComplexEmbedding.lift, lift_comp_algebraMap: every embedding
-- of K extends to L, in [L : K] ways.
theorem embeddingsOver.card (σ : Set)
  requires embedding : σ ∈ complexEmbeddings(K)
  shows HasCardinality(embeddingsOver(f, K, L, σ),
    finrank(algebraModule(Algebra.mk(K, L, f)), K))
proof
  sorry

-- InfinitePlace.comap_mk, ComplexEmbedding.liesOver_iff: the restriction
-- of the place of τ is the place of τ ∘ f.
theorem placeRestriction.of_embedding (τ : Set)
  requires embedding : τ ∈ complexEmbeddings(L)
  shows placeRestriction(f, K, L, infinitePlaceOf(L, τ)) =
    infinitePlaceOf(K, compose(τ, f, Ring.carrier(K), Ring.carrier(L), complexCarrier))
proof
  have fn := tkF.complexEmbeddings.function at L, τ with embedding
  have h0 := hom
  obtain ⟨_, _, ffn, _⟩ := h0
  have assoc := compose.associative at complexConj, τ, f, Ring.carrier(K), Ring.carrier(L), complexCarrier, complexCarrier with ffn, fn, complexConj.function
  ext ρ
  constructor
  . intro h
    obtain ⟨ρ0, hρ0, eq⟩ := placeRestriction.membership.forward with h
    unfold infinitePlaceOf at hρ0
    simp at hρ0
    unfold infinitePlaceOf
    cases hρ0 with h1 | h2
    . rw ← eq
      rw h1
      exact pair.left
    . rw ← eq
      rw h2
      unfold conjugateEmbedding
      rw ← assoc
      exact pair.right
  . intro h
    unfold infinitePlaceOf at h
    simp at h
    apply placeRestriction.membership.backward
    cases h with h1 | h2
    . have t : τ ∈ infinitePlaceOf(L, τ)
        unfold infinitePlaceOf
        exact pair.left
      symm at h1
      exact ⟨τ, t, h1⟩
    . have t : conjugateEmbedding(L, τ) ∈ infinitePlaceOf(L, τ)
        unfold infinitePlaceOf
        exact pair.right
      have e : compose(conjugateEmbedding(L, τ), f, Ring.carrier(K), Ring.carrier(L), complexCarrier) = ρ
        rw h2
        unfold conjugateEmbedding
        symm
        exact assoc
      exact ⟨conjugateEmbedding(L, τ), t, e⟩


-- The restriction of a place of L is a place of K (InfinitePlace.comap).
theorem placeRestriction.mem (w : Set)
  requires place : w ∈ infinitePlaces(L)
  shows placeRestriction(f, K, L, w) ∈ infinitePlaces(K)
proof
  have comm := Field.to_comm_ring at K with sourceField
  obtain ⟨τ, hτ, eq⟩ := tkF.infinitePlaces.cases at L, w with place
  rw eq
  have r := placeRestriction.of_embedding at K, L, f, τ with sourceField, targetField, source, target, hom, hτ
  rw r
  have ce := tkF.complexEmbeddings.compose at K, L, f, τ with comm, hom, hτ
  exact tkF.infinitePlaceOf.mem at K, compose(τ, f, Ring.carrier(K), Ring.carrier(L), complexCarrier) with ce


-- isTotallyComplex_of_algebra flavour for places: a complex place of K
-- has only complex places above it.
theorem placeRestriction.complex_of_complex (w : Set)
  requires place : w ∈ infinitePlaces(L)
  requires complex : ComplexPlace(K, placeRestriction(f, K, L, w))
  shows ComplexPlace(L, w)
proof
  have comm := Field.to_comm_ring at K with sourceField
  obtain ⟨τ, hτ, eq⟩ := tkF.infinitePlaces.cases at L, w with place
  have r := placeRestriction.of_embedding at K, L, f, τ with sourceField, targetField, source, target, hom, hτ
  have ce := tkF.complexEmbeddings.compose at K, L, f, τ with comm, hom, hτ
  have fn := tkF.complexEmbeddings.function at L, τ with hτ
  have h0 := hom
  obtain ⟨_, _, ffn, _⟩ := h0
  unfold ComplexPlace
  refine ⟨place, ?_⟩
  intro realW
  obtain ⟨_, nr⟩ := complex
  apply nr
  rw [eq, r]
  rw eq at realW
  have rL := (RealPlace.of_embedding at L, τ with targetField, target, hτ).forward with realW
  obtain ⟨_, allL⟩ := rL
  have re : RealEmbedding(K, compose(τ, f, Ring.carrier(K), Ring.carrier(L), complexCarrier))
    unfold RealEmbedding
    refine ⟨ce, ?_⟩
    intros x hx
    have a := compose.apply at τ, f, Ring.carrier(K), Ring.carrier(L), complexCarrier, x with ffn, fn, hx
    rw a
    have fx := FunctionBetween.apply_closed with ffn, hx
    exact allL with f(x), fx
  exact (RealPlace.of_embedding at K, compose(τ, f, Ring.carrier(K), Ring.carrier(L), complexCarrier) with sourceField, source, ce).backward with re


-- IsUnramifiedAtInfinitePlaces.card_infinitePlace: in an extension
-- unramified at infinity, #places(L) = [L : K] #places(K).
theorem UnramifiedAtInfinitePlaces.card
  requires unramified : UnramifiedAtInfinitePlaces(f, K, L)
  shows HasCardinality(infinitePlaces(L),
    mul(finrank(algebraModule(Algebra.mk(K, L, f)), K), cardinality(infinitePlaces(K))))
proof
  sorry

end Extension
