-- Adeles of a number field: restricted products Π' [X_i, A_i] of a family
-- of spaces along subsets, with the restricted product topology
-- (RestrictedProduct over the cofinite filter), and of rings along
-- subrings; the finite adele ring Π'_P [K_P, 𝓞_P]
-- (IsDedekindDomain.FiniteAdeleRing); the mixed space of K, functions u on
-- the complex embeddings with u(σ̄) = conj u(σ), which serves both as the
-- infinite adele ring (NumberField.InfiniteAdeleRing) and as the target
-- of the Minkowski embedding (NumberField.mixedEmbedding,
-- mixedEmbedding.mixedSpace); the adele ring 𝔸_K = 𝔸_∞ × 𝔸_f
-- (NumberField.AdeleRing) with the diagonal embedding of K; norms at
-- places on the mixed space; and the covolume of 𝓞 K.
-- Part of the GRH blueprint.
-- Planned home: Topology/RestrictedProduct, NumberTheory/NumberField/Adeles.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.NumberField.Adeles
import GRH.NumberField.Places
import GRH.Measure.Haar

-- Section: Restricted products of rings
-- The carriers of a family of rings.
def ringCarriers (I F : Set) : Set := { (i, Ring.carrier(F(i))) | i ∈ I }

-- The restricted product of a family of rings F along subrings A(i), with
-- the pointwise operations (RestrictedProduct as a ring).
def restrictedProductRing (I F A : Set) : Set :=
  subringRing(piRing(I, F), restrictedProduct(I, ringCarriers(I, F), A))

-- The coordinate maps u ↦ u(i) (RestrictedProduct.evalRingHom), and the
-- map induced by maps φ(i) : X(i) → Y(i) (RestrictedProduct.mapAlong).
def restrictedEval (I X A i : Set) : Set :=
  { p ∈ restrictedProduct(I, X, A) × X(i) | ∃ u ∈ restrictedProduct(I, X, A),
    p = (u, u(i)) }

def mappedFunction (I φ u : Set) : Set := { (i, φ(i)(u(i))) | i ∈ I }

def restrictedMap (I X A φ : Set) : Set :=
  { (u, mappedFunction(I, φ, u)) | u ∈ restrictedProduct(I, X, A) }

-- The binary product of two rings, with componentwise operations
-- (Prod.instRing), and the product of two spaces is Cumulus's productSpace.
def pairAdd (R S : Set) : Set :=
  { q ∈ ((Ring.carrier(R) × Ring.carrier(S)) × (Ring.carrier(R) × Ring.carrier(S))) ×
      (Ring.carrier(R) × Ring.carrier(S)) |
    ∃ a ∈ Ring.carrier(R), ∃ b ∈ Ring.carrier(S), ∃ c ∈ Ring.carrier(R),
    ∃ d ∈ Ring.carrier(S),
      q = (((a, b), (c, d)), (call2(Ring.add(R), a, c), call2(Ring.add(S), b, d))) }

def pairMul (R S : Set) : Set :=
  { q ∈ ((Ring.carrier(R) × Ring.carrier(S)) × (Ring.carrier(R) × Ring.carrier(S))) ×
      (Ring.carrier(R) × Ring.carrier(S)) |
    ∃ a ∈ Ring.carrier(R), ∃ b ∈ Ring.carrier(S), ∃ c ∈ Ring.carrier(R),
    ∃ d ∈ Ring.carrier(S),
      q = (((a, b), (c, d)), (call2(Ring.mul(R), a, c), call2(Ring.mul(S), b, d))) }

def pairNeg (R S : Set) : Set :=
  { q ∈ (Ring.carrier(R) × Ring.carrier(S)) × (Ring.carrier(R) × Ring.carrier(S)) |
    ∃ a ∈ Ring.carrier(R), ∃ b ∈ Ring.carrier(S),
      q = ((a, b), (apply(Ring.neg(R), a), apply(Ring.neg(S), b))) }

def productRing (R S : Set) : Set :=
  Ring.mk(Ring.carrier(R) × Ring.carrier(S), pairAdd(R, S),
    (Ring.zero(R), Ring.zero(S)), pairNeg(R, S), pairMul(R, S),
    (Ring.one(R), Ring.one(S)))

-- Section: The finite adeles
-- The families P ↦ K_P, P ↦ 𝓞_P ⊆ K_P and P ↦ the space K_P over the
-- nonzero primes of 𝓞 K.
def completionFamily (K : Set) : Set :=
  { (P, adicCompletionField(K, P)) | P ∈ heightOneSpectrum(ringOfIntegersRing(K)) }

def completionIntegersFamily (K : Set) : Set :=
  { (P, adicCompletionIntegersIn(K, P)) | P ∈ heightOneSpectrum(ringOfIntegersRing(K)) }

def completionSpaces (K : Set) : Set :=
  { (P, adicCompletionSpace(K, P)) | P ∈ heightOneSpectrum(ringOfIntegersRing(K)) }

-- The finite adele ring 𝔸_f = Π'_P [K_P, 𝓞_P] and its topology
-- (IsDedekindDomain.FiniteAdeleRing (𝓞 K) K).
def finiteAdeleRing (K : Set) : Set :=
  restrictedProductRing(heightOneSpectrum(ringOfIntegersRing(K)),
    completionFamily(K), completionIntegersFamily(K))

def finiteAdeleSpace (K : Set) : Set :=
  restrictedProductSpace(heightOneSpectrum(ringOfIntegersRing(K)),
    completionSpaces(K), completionIntegersFamily(K))

-- The integral finite adeles Π_P 𝓞_P inside 𝔸_f
-- (range of RestrictedProduct.structureMap).
def integralFiniteAdeles (K : Set) : Set :=
  { u ∈ Ring.carrier(finiteAdeleRing(K)) |
    ∀ P ∈ heightOneSpectrum(ringOfIntegersRing(K)), u(P) ∈ adicCompletionIntegersIn(K, P) }

-- The units of 𝓞_P inside K_P, and the primes at which an adele u is not
-- such a unit.
def completionUnitsIn (K P : Set) : Set :=
  functionImage(adicCompletionInclusion(K, P), ringUnits(adicCompletionIntegers(K, P)),
    Ring.carrier(adicCompletionField(K, P)))

def nonUnitPrimes (K u : Set) : Set :=
  { P ∈ heightOneSpectrum(ringOfIntegersRing(K)) | u(P) ∉ completionUnitsIn(K, P) }

-- The diagonal embedding K → 𝔸_f (algebraMap K (FiniteAdeleRing (𝓞 K) K)).
def finiteAdeleValues (K x : Set) : Set :=
  { (P, adicCompletionEmbedding(K, P)(x)) | P ∈ heightOneSpectrum(ringOfIntegersRing(K)) }

def finiteAdeleEmbedding (K : Set) : Set :=
  { (x, finiteAdeleValues(K, x)) | x ∈ Ring.carrier(K) }

-- Section: The mixed space and the infinite adeles
-- The constant families σ ↦ ℂ (as rings and as spaces) on the embeddings.
def complexFamily (K : Set) : Set := { (σ, complexRing) | σ ∈ complexEmbeddings(K) }

def complexSpaces (K : Set) : Set := { (σ, complexSpace) | σ ∈ complexEmbeddings(K) }

-- The mixed space: u : embeddings → ℂ with u(σ̄) = conj u(σ). Choosing one
-- embedding in each complex place identifies it with ℝ^{r₁} × ℂ^{r₂}
-- (mixedEmbedding.mixedSpace), and with Π_w K_w
-- (NumberField.InfiniteAdeleRing, InfiniteAdeleRing.ringEquiv_mixedSpace);
-- the set itself needs no choice.
def mixedSpace (K : Set) : Set :=
  { u ∈ piCarrier(complexEmbeddings(K), complexFamily(K)) |
    ∀ σ ∈ complexEmbeddings(K), u(conjugateEmbedding(K, σ)) = complexConj(u(σ)) }

-- The infinite adele ring: the mixed space as a subring of ℂ^{embeddings},
-- with the subspace topology of the product (InfiniteAdeleRing K).
def infiniteAdeleRing (K : Set) : Set :=
  subringRing(piRing(complexEmbeddings(K), complexFamily(K)), mixedSpace(K))

def infiniteAdeleSpace (K : Set) : Set :=
  subspace(piSpace(complexEmbeddings(K), complexSpaces(K)), mixedSpace(K))

-- The mixed space as an ℝ-algebra along r ↦ (σ ↦ r).
def constantMixed (K r : Set) : Set :=
  { (σ, complexOfReal(r)) | σ ∈ complexEmbeddings(K) }

def mixedScalars (K : Set) : Set := { (r, constantMixed(K, r)) | r ∈ ℝ }

def mixedAlgebra (K : Set) : Set :=
  Algebra.mk(realRing, infiniteAdeleRing(K), mixedScalars(K))

-- The canonical embedding x ↦ (σ(x))_σ (NumberField.canonicalEmbedding),
-- which is also the Minkowski embedding into the mixed space
-- (NumberField.mixedEmbedding) and the embedding K → 𝔸_∞.
def mixedEmbedding (K : Set) : Set :=
  { (x, embeddingValues(K, x)) | x ∈ Ring.carrier(K) }

-- The norm at a place, |u(σ)| for σ ∈ w (mixedEmbedding.normAtPlace),
-- and the norm Π_σ |u(σ)| = Π_w normAtPlace(w)^{mult w}
-- (mixedEmbedding.norm).
defunique normAtPlace (K w u : Set) (r ∈ ℝ) :=
  ∃ σ ∈ w, r = complexAbs(u(σ))
requires numberField : NumberField(K)
requires place : w ∈ infinitePlaces(K)
requires member : u ∈ mixedSpace(K)
proof
  sorry
uniqueness
  sorry

def mixedAbsValues (K u : Set) : Set :=
  { (σ, complexAbs(u(σ))) | σ ∈ complexEmbeddings(K) }

def mixedNorm (K u : Set) : Set :=
  finiteRingProduct(complexEmbeddings(K), ℝ, realAdd, realZero, realNeg,
    realMul, realOne, mixedAbsValues(K, u))

-- Real coordinates of the mixed space: σ ↦ re u(σ) + im u(σ). On a complex
-- pair {σ, σ̄} this is (a, b) ↦ (a + b, a − b), of determinant −2, so
-- Lebesgue measure on ℝ^{embeddings} pulled back by these coordinates is
-- 2^{r₂} times Mathlib's volume on ℝ^{r₁} × ℂ^{r₂}.
def mixedRealCoordinates (K u : Set) : Set :=
  { (σ, realAdd((complexRe(u(σ)), complexIm(u(σ))))) | σ ∈ complexEmbeddings(K) }

-- For a ℤ-basis b of 𝓞 K over I and an enumeration e : I → embeddings,
-- the real matrix of the coordinates of the lattice vectors.
def latticeCoordinateMatrix (K I b e : Set) : Set :=
  { q ∈ (I × I) × ℝ | ∃ i ∈ I, ∃ j ∈ I,
    q = ((i, j), mixedRealCoordinates(K, mixedEmbedding(K)(b(i)))(e(j))) }

-- Section: The adele ring
-- 𝔸_K = 𝔸_∞ × 𝔸_f with the product topology (NumberField.AdeleRing).
def adeleRing (K : Set) : Set := productRing(infiniteAdeleRing(K), finiteAdeleRing(K))

def adeleSpace (K : Set) : Set := productSpace(infiniteAdeleSpace(K), finiteAdeleSpace(K))

-- The diagonal embedding K → 𝔸_K (algebraMap K (AdeleRing (𝓞 K) K)).
def adeleEmbedding (K : Set) : Set :=
  { (x, (mixedEmbedding(K)(x), finiteAdeleEmbedding(K)(x))) | x ∈ Ring.carrier(K) }

-- Section: Restricted products
section RestrictedProducts
variable (I T A : Set)
hypothesis spaces : ∀ i ∈ I, TopologicalSpace(T(i))
hypothesis open : ∀ i ∈ I, A(i) ∈ TopologicalSpace.opens(T(i))

-- RestrictedProduct.topologicalSpace is a topology.
theorem restrictedProductSpace.space
  shows TopologicalSpace(restrictedProductSpace(I, T, A))
proof
  sorry

-- RestrictedProduct.ext: elements agreeing at every coordinate are equal.
theorem restrictedProduct.ext (u v : Set)
  requires first : u ∈ restrictedProduct(I, spaceCarriers(I, T), A)
  requires second : v ∈ restrictedProduct(I, spaceCarriers(I, T), A)
  requires same : ∀ i ∈ I, u(i) = v(i)
  shows u = v
proof
  unfold restrictedProduct at first
  unfold restrictedProduct at second
  obtain ⟨d1, _⟩ := first
  obtain ⟨d2, _⟩ := second
  unfold dependentFunctions at d1
  unfold dependentFunctions at d2
  obtain ⟨s1, _⟩ := d1
  obtain ⟨s2, _⟩ := d2
  have f1 := functionSpace.mem_iff.forward with s1
  have f2 := functionSpace.mem_iff.forward with s2
  exact FunctionBetween.ext with f1, f2, same


-- RestrictedProduct.isOpen_forall_mem, range_structureMap: the integral
-- part {u | ∀ i, u(i) ∈ A(i)} is open.
theorem restrictedProduct.integral_open
  shows integralPart(I, spaceCarriers(I, T), A) ∈
    TopologicalSpace.opens(restrictedProductSpace(I, T, A))
proof
  sorry

-- RestrictedProduct.isEmbedding_structureMap: on the integral part the
-- restricted product topology is the product topology of the A(i).
theorem restrictedProduct.integral_embedding
  shows subspace(restrictedProductSpace(I, T, A), integralPart(I, spaceCarriers(I, T), A)) =
    piSpace(I, subspaceFamily(I, T, A))
proof
  sorry

-- RestrictedProduct.continuous_eval: the coordinate maps are continuous.
theorem restrictedEval.continuous (i : Set)
  requires index : i ∈ I
  shows restrictedEval(I, spaceCarriers(I, T), A, i) : restrictedProductSpace(I, T, A) ⇒ T(i)
proof
  sorry

-- RestrictedProduct.mapAlong_continuous: maps φ(i) continuous with
-- φ(i)(A(i)) ⊆ B(i) induce a continuous map.
theorem restrictedMap.continuous (U B φ : Set)
  requires targets : ∀ i ∈ I, TopologicalSpace(U(i))
  requires targetOpen : ∀ i ∈ I, B(i) ∈ TopologicalSpace.opens(U(i))
  requires maps : ∀ i ∈ I, φ(i) : T(i) ⇒ U(i)
  requires integral : ∀ i ∈ I, ∀ x ∈ A(i), φ(i)(x) ∈ B(i)
  shows restrictedMap(I, spaceCarriers(I, T), A, φ) :
    restrictedProductSpace(I, T, A) ⇒ restrictedProductSpace(I, U, B)
proof
  sorry

-- Restricted products of locally compact spaces along compact open
-- subsets are locally compact (RestrictedProduct.instLocallyCompactSpace).
theorem restrictedProduct.locally_compact
  requires local : ∀ i ∈ I, LocallyCompact(T(i))
  requires compact : ∀ i ∈ I, Compact(T(i), A(i))
  shows LocallyCompact(restrictedProductSpace(I, T, A))
proof
  sorry

end RestrictedProducts

section RestrictedRings
variable (I F A T : Set)
hypothesis rings : ∀ i ∈ I, CommRing(F(i))
hypothesis subrings : ∀ i ∈ I, Subring(F(i), A(i))
hypothesis topological : ∀ i ∈ I, TopologicalRing(F(i), T(i))
hypothesis open : ∀ i ∈ I, A(i) ∈ TopologicalSpace.opens(T(i))

-- The restricted product of rings is a commutative ring, a subring of the
-- product, and a topological ring (RestrictedProduct.instCommRing,
-- instIsTopologicalRing).
theorem restrictedProductRing.topological_ring
  shows CommRing(restrictedProductRing(I, F, A)) ∧
    Subring(piRing(I, F), restrictedProduct(I, ringCarriers(I, F), A)) ∧
    TopologicalRing(restrictedProductRing(I, F, A), restrictedProductSpace(I, T, A))
proof
  sorry

-- RestrictedProduct.evalRingHom
theorem restrictedEval.ring_hom (i : Set)
  requires index : i ∈ I
  shows RingHom(restrictedEval(I, ringCarriers(I, F), A, i),
    restrictedProductRing(I, F, A), F(i))
proof
  sorry

-- RestrictedProduct.mapAlongRingHom: ring homomorphisms φ(i) with
-- φ(i)(A(i)) ⊆ B(i) induce a ring homomorphism.
theorem restrictedMap.ring_hom (G B φ : Set)
  requires targets : ∀ i ∈ I, CommRing(G(i))
  requires targetSubrings : ∀ i ∈ I, Subring(G(i), B(i))
  requires homs : ∀ i ∈ I, RingHom(φ(i), F(i), G(i))
  requires integral : ∀ i ∈ I, ∀ x ∈ A(i), φ(i)(x) ∈ B(i)
  shows RingHom(restrictedMap(I, ringCarriers(I, F), A, φ),
    restrictedProductRing(I, F, A), restrictedProductRing(I, G, B))
proof
  sorry

end RestrictedRings

-- The product of two commutative rings (Prod.instCommRing), and of two
-- topological rings (Prod.instIsTopologicalRing).
theorem productRing.comm_ring (R S X Y : Set)
  requires first : CommRing(R)
  requires second : CommRing(S)
  shows CommRing(productRing(R, S)) ∧
    (TopologicalRing(R, X) → TopologicalRing(S, Y) →
      TopologicalRing(productRing(R, S), productSpace(X, Y)))
proof
  sorry

-- Section: Adeles of a number field
section Adeles
variable (K : Set)
hypothesis field : Field(K)
hypothesis numberField : NumberField(K)

-- The finite adeles form a locally compact topological ring
-- (FiniteAdeleRing.instIsTopologicalRing, instLocallyCompactSpace).
theorem finiteAdeleRing.topological_ring
  shows CommRing(finiteAdeleRing(K)) ∧
    TopologicalRing(finiteAdeleRing(K), finiteAdeleSpace(K)) ∧
    LocallyCompact(finiteAdeleSpace(K)) ∧
    Hausdorff(finiteAdeleSpace(K))
proof
  sorry

-- Π_P 𝓞_P is an open compact subring of 𝔸_f
-- (FiniteAdeleRing.isOpen_integralAdeles, isCompact_integralAdeles).
theorem integralFiniteAdeles.open_compact
  shows Subring(finiteAdeleRing(K), integralFiniteAdeles(K)) ∧
    integralFiniteAdeles(K) ∈ TopologicalSpace.opens(finiteAdeleSpace(K)) ∧
    Compact(finiteAdeleSpace(K), integralFiniteAdeles(K))
proof
  sorry

-- The diagonal embedding K → 𝔸_f is well defined (x ∈ 𝓞_P for almost
-- all P) and an injective ring homomorphism
-- (FiniteAdeleRing.algebraMap, algebraMap_injective).
theorem finiteAdeleEmbedding.ring_hom
  shows RingHom(finiteAdeleEmbedding(K), K, finiteAdeleRing(K)) ∧
    InjectiveBetween(finiteAdeleEmbedding(K), Ring.carrier(K),
      Ring.carrier(finiteAdeleRing(K)))
proof
  sorry

-- The image of K meets Π_P 𝓞_P in 𝓞 K
-- (FiniteAdeleRing.mem_integralAdeles_iff for principal adeles).
theorem finiteAdeleEmbedding.integral_iff (x : K)
  shows finiteAdeleEmbedding(K)(x) ∈ integralFiniteAdeles(K) ↔ x ∈ ringOfIntegers(K)
proof
  sorry

-- IsDedekindDomain.FiniteAdeleRing.unitsEquiv_finite_valued_eq_one: a
-- unit of 𝔸_f is a unit of 𝓞_P at all but finitely many P.
theorem finiteAdeleRing.units_almost_integral (u : Set)
  requires unit : RingUnit(finiteAdeleRing(K), u)
  shows Finite(nonUnitPrimes(K, u))
proof
  sorry

-- The mixed space is a subring of ℂ^{embeddings}, a locally compact
-- topological ring, and an ℝ-algebra of dimension [K : ℚ]
-- (mixedEmbedding.finrank, InfiniteAdeleRing.locallyCompactSpace).
theorem infiniteAdeleRing.topological_ring
  shows Subring(piRing(complexEmbeddings(K), complexFamily(K)), mixedSpace(K)) ∧
    CommRing(infiniteAdeleRing(K)) ∧
    TopologicalRing(infiniteAdeleRing(K), infiniteAdeleSpace(K)) ∧
    LocallyCompact(infiniteAdeleSpace(K)) ∧ Hausdorff(infiniteAdeleSpace(K)) ∧
    Algebra(mixedAlgebra(K)) ∧
    finrank(algebraModule(mixedAlgebra(K)), realRing) = numberFieldDegree(K)
proof
  sorry

-- NumberField.mixedEmbedding_injective, canonicalEmbedding_injective: the
-- Minkowski embedding is an injective ring homomorphism into the mixed
-- space.
theorem mixedEmbedding.ring_hom
  shows RingHom(mixedEmbedding(K), K, infiniteAdeleRing(K)) ∧
    InjectiveBetween(mixedEmbedding(K), Ring.carrier(K), mixedSpace(K))
proof
  sorry

-- mixedEmbedding.latticeBasis, latticeBasis_repr_apply: the image of a
-- ℤ-basis of 𝓞 K is an ℝ-basis of the mixed space.
theorem mixedEmbedding.lattice_basis (I b : Set)
  requires finite : Finite(I)
  requires basis : ModuleBasis(ringOfIntegersModule(K), integerRing, I, b)
  shows ModuleBasis(algebraModule(mixedAlgebra(K)), realRing, I,
    compose(mixedEmbedding(K), b, I, Ring.carrier(K), mixedSpace(K)))
proof
  sorry

-- The real coordinates of a point of the mixed space form a real vector,
-- and the lattice coordinate matrix is a square real matrix.
theorem latticeCoordinateMatrix.mem (I b e : Set)
  requires family : b : I → Ring.carrier(K)
  requires enumeration : e : I → complexEmbeddings(K)
  shows (∀ u ∈ mixedSpace(K),
      mixedRealCoordinates(K, u) : complexEmbeddings(K) → ℝ) ∧
    latticeCoordinateMatrix(K, I, b, e) ∈ matrixSpace(realRing, I, I)
proof
  sorry

-- mixedEmbedding.volume_fundamentalDomain_latticeBasis, in coordinates:
-- the covolume of the image of 𝓞 K in the real coordinates is √|d_K|
-- (Mathlib's volume, normalised on ℂ by re and im, gives 2^{−r₂} √|d_K|).
theorem mixedEmbedding.covolume (I b e : Set)
  requires finite : Finite(I)
  requires basis : ModuleBasis(ringOfIntegersModule(K), integerRing, I, b)
  requires enumeration : BijectiveBetween(e, I, complexEmbeddings(K))
  shows realAbs(matDet(realRing, I, latticeCoordinateMatrix(K, I, b, e))) =
    √(realNat(discrMagnitude(K)))
proof
  sorry

-- mixedEmbedding.norm_apply: the norm of the image of x is |N(x)|.
theorem mixedNorm.of_embedding (x : K)
  shows mixedNorm(K, mixedEmbedding(K)(x)) = realAbs(ratCastMap(realRing)(fieldNorm(K, x)))
proof
  sorry

-- mixedEmbedding.norm_smul, normAtPlace_smul: scaling by r multiplies the
-- norm at each place by |r| and the norm by |r|^{[K : ℚ]}.
theorem mixedNorm.smul (r u w : Set)
  requires scalar : r ∈ ℝ
  requires member : u ∈ mixedSpace(K)
  requires place : w ∈ infinitePlaces(K)
  shows normAtPlace(K, w, call2(Ring.mul(infiniteAdeleRing(K)), mixedScalars(K)(r), u)) =
      realMul((realAbs(r), normAtPlace(K, w, u))) ∧
    mixedNorm(K, call2(Ring.mul(infiniteAdeleRing(K)), mixedScalars(K)(r), u)) =
      realMul((realPow(realAbs(r), numberFieldDegree(K)), mixedNorm(K, u)))
proof
  sorry

-- normAtPlace of an embedded element is the place's value
-- (mixedEmbedding.normAtPlace_apply).
theorem normAtPlace.of_embedding (w x : Set)
  requires place : w ∈ infinitePlaces(K)
  requires member : x ∈ Ring.carrier(K)
  shows normAtPlace(K, w, mixedEmbedding(K)(x)) = infinitePlaceValue(K, w, x)
proof
  sorry

-- The image of 𝓞 K is discrete in the mixed space
-- (mixedEmbedding: the lattice is a discrete subgroup, ZLattice).
theorem mixedEmbedding.integers_discrete
  shows DiscreteSubset(infiniteAdeleSpace(K),
    functionImage(mixedEmbedding(K), ringOfIntegers(K), mixedSpace(K)))
proof
  sorry

-- The adele ring is a locally compact Hausdorff topological ring
-- (NumberField.AdeleRing, its topological ring and locally compact
-- instances), so its additive group carries Haar measures.
theorem adeleRing.topological_ring
  shows CommRing(adeleRing(K)) ∧
    TopologicalRing(adeleRing(K), adeleSpace(K)) ∧
    LocallyCompactGroup(Ring.additive(adeleRing(K)), adeleSpace(K))
proof
  sorry

-- The diagonal embedding K → 𝔸_K is an injective ring homomorphism
-- (algebraMap K (AdeleRing (𝓞 K) K)).
theorem adeleEmbedding.ring_hom
  shows RingHom(adeleEmbedding(K), K, adeleRing(K)) ∧
    InjectiveBetween(adeleEmbedding(K), Ring.carrier(K), Ring.carrier(adeleRing(K)))
proof
  sorry

end Adeles
