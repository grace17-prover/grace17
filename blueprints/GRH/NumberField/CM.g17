-- Totally real, totally complex, and CM fields: the predicates
-- (NumberField.IsTotallyReal, IsTotallyComplex), the maximal real subfield
-- K⁺ = {x | σ(x) real for every σ} (NumberField.maximalRealSubfield), CM
-- fields as totally complex quadratic extensions of their maximal real
-- subfield, totally real (NumberField.IsCMField), complex conjugation of a
-- CM field (IsCMField.complexConj) with its laws, the places of K and K⁺,
-- CM extensions, and the units and roots of unity of 𝓞 K
-- (NumberField.Units, torsion, torsionOrder).
-- Part of the GRH blueprint.
-- Planned home: NumberTheory/NumberField/CMField.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.NumberField.CM
import GRH.NumberField.Places

-- Section: Totally real and totally complex fields
-- Every embedding real (IsTotallyReal), none real (IsTotallyComplex).
predicate TotallyReal (K : Set) :=
  NumberField(K) ∧ (∀ σ ∈ complexEmbeddings(K), RealEmbedding(K, σ))

predicate TotallyComplex (K : Set) :=
  NumberField(K) ∧ (∀ σ ∈ complexEmbeddings(K), ¬RealEmbedding(K, σ))

-- Section: The maximal real subfield
-- K⁺: the x whose image under every embedding is real
-- (NumberField.maximalRealSubfield), as a subset, as a ring, and K as a
-- K⁺-algebra along the inclusion.
def maximalRealSubfield (K : Set) : Set :=
  { x ∈ Ring.carrier(K) | ∀ σ ∈ complexEmbeddings(K), complexConj(σ(x)) = σ(x) }

def maximalRealSubfieldRing (K : Set) : Set := subringRing(K, maximalRealSubfield(K))

def realSubfieldAlgebra (K : Set) : Set :=
  Algebra.mk(maximalRealSubfieldRing(K), K, identity(maximalRealSubfield(K)))

-- The degree [K : K⁺].
def realSubfieldDegree (K : Set) : Set :=
  finrank(algebraModule(realSubfieldAlgebra(K)), maximalRealSubfieldRing(K))

-- A CM field: totally complex, with K⁺ totally real and [K : K⁺] = 2
-- (NumberField.IsCMField, with IsTotallyComplex K,
-- IsTotallyReal (maximalRealSubfield K) and
-- IsQuadraticExtension (maximalRealSubfield K) K).
predicate CMField (K : Set) :=
  TotallyComplex(K) ∧ TotallyReal(maximalRealSubfieldRing(K)) ∧
  realSubfieldDegree(K) = 2

-- Complex conjugation of K: the map c with σ(c(x)) = conj(σ(x)) for every
-- embedding σ (IsCMField.complexConj); that this graph is a function on a
-- CM field is a theorem.
def cmConjugation (K : Set) : Set :=
  { p ∈ Ring.carrier(K) × Ring.carrier(K) | ∃ x ∈ Ring.carrier(K),
    ∃ y ∈ Ring.carrier(K), p = (x, y) ∧
      (∀ σ ∈ complexEmbeddings(K), σ(y) = complexConj(σ(x))) }

-- F → K is a CM extension: F totally real, K totally complex, [K : F] = 2
-- (NumberField.CMExtension).
predicate CMExtension (f F K : Set) :=
  Field(F) ∧ Field(K) ∧ TotallyReal(F) ∧ TotallyComplex(K) ∧ RingHom(f, F, K) ∧
  finrank(algebraModule(Algebra.mk(F, K, f)), F) = 2

-- Restriction of places of K to K⁺.
def realSubfieldPlaceMap (K : Set) : Set :=
  { (w, placeRestriction(identity(maximalRealSubfield(K)),
      maximalRealSubfieldRing(K), K, w)) | w ∈ infinitePlaces(K) }

-- Section: Units and roots of unity
-- The unit group of 𝓞 K ((𝓞 K)ˣ) and its torsion, the roots of unity in K
-- (NumberField.Units.torsion), of order torsionOrder
-- (NumberField.Units.torsionOrder).
def integerUnits (K : Set) : Set := ringUnits(ringOfIntegersRing(K))

def torsionUnits (K : Set) : Set :=
  { x ∈ ringOfIntegers(K) | ∃ n ∈ ℕ, n ≠ 0 ∧ Ring.pow(K, x, n) = Ring.one(K) }

def torsionOrder (K : Set) : Set := cardinality(torsionUnits(K))

-- A number field has a complex embedding.
theorem tkF.complexEmbeddings.nonempty (K : Set)
  requires field : Field(K)
  requires numberField : NumberField(K)
  shows ∃ σ, σ ∈ complexEmbeddings(K)
proof
  have card := complexEmbeddings.card at K with field, numberField
  have np := numberFieldDegree.pos at K with numberField
  obtain ⟨nIn, nPos⟩ := np
  have nNat : Nat(numberFieldDegree(K)) := nat.omega.backward with nIn
  have alternatives := natural.zero_or_successor at numberFieldDegree(K)
  cases alternatives with zero | successor
  . exfalso
    rw zero at nPos
    arith
  . obtain ⟨k, kNat, shape⟩ := successor
    rw shape at card
    exact HasCardinality.exists_member at complexEmbeddings(K), k with card


-- Section: Totally real and complex fields
-- Rat.isTotallyReal
theorem TotallyReal.rationals
  shows TotallyReal(rationalRing)
proof
  have qn := NumberField.rationals
  have qf := rationalRing.field
  have qff := qf.left
  have qz := rationalRing.char_zero
  unfold TotallyReal
  refine ⟨qn, ?_⟩
  intros σ hσ
  unfold RealEmbedding
  refine ⟨hσ, ?_⟩
  intros x hx
  have h0 := hσ
  unfold complexEmbeddings at h0
  obtain ⟨_, σhom⟩ := h0
  have cf := complexRing.field
  have cz := CharZero.of_hom at rationalRing, complexRing, σ with qff, cf, qz, σhom
  have cm := conjugateEmbedding.mem at rationalRing, σ with qff, qn, hσ
  obtain ⟨cmem, _⟩ := cm
  have c0 := cmem
  unfold complexEmbeddings at c0
  obtain ⟨_, chom⟩ := c0
  have u1 := ratCastMap.unique at complexRing, σ with cf, cz, σhom
  have u2 := ratCastMap.unique at complexRing, conjugateEmbedding(rationalRing, σ) with cf, cz, chom
  have ap := conjugateEmbedding.apply at rationalRing, σ, x with qff, qn, hσ, hx
  have e : conjugateEmbedding(rationalRing, σ) = σ
    rw u2
    rw u1
  rw e at ap
  rw ← ap


-- NumberField.IsTotallyReal.nrComplexPlaces_eq_zero
theorem TotallyReal.nrComplexPlaces (K : Set)
  requires field : Field(K)
  requires real : TotallyReal(K)
  shows nrComplexPlaces(K) = 0 ∧ nrRealPlaces(K) = numberFieldDegree(K)
proof
  have rr := real
  obtain ⟨nf, allR⟩ := rr
  have z := (nrComplexPlaces.eq_zero_iff at K with field, nf).backward with allR
  refine ⟨z, ?_⟩
  have fin := infinitePlaces.finite at K with field, nf
  have subR : realPlaces(K) ⊆ infinitePlaces(K)
    intros w hw
    unfold realPlaces at hw
    exact hw.left
  have finR := Finite.subset with fin, subR
  have rn := cardinality.nat at realPlaces(K) with finR
  have rn2 : Nat(nrRealPlaces(K)) by unfold nrRealPlaces; exact rn
  have c := nrPlaces.card_add_two_mul at K with field, nf
  rw z at c
  arith


-- IsTotallyComplex.nrRealPlaces_eq_zero, finrank_eq_two_mul: no real
-- places, and [K : ℚ] = 2 r₂.
theorem TotallyComplex.nrRealPlaces (K : Set)
  requires field : Field(K)
  requires complex : TotallyComplex(K)
  shows nrRealPlaces(K) = 0 ∧ numberFieldDegree(K) = mul(2, nrComplexPlaces(K))
proof
  have cc := complex
  obtain ⟨nf, noReal⟩ := cc
  have sub : realPlaces(K) ⊆ ∅
    intros w hw
    exfalso
    unfold realPlaces at hw
    obtain ⟨wIn, rp⟩ := hw
    obtain ⟨_, allR⟩ := rp
    have h := infinitePlaces.membership.forward with wIn
    obtain ⟨σ, hσ, eq⟩ := h
    have m : σ ∈ infinitePlaceOf(K, σ) by unfold infinitePlaceOf; simp
    rw eq at m
    have r := allR with m
    have n := noReal with hσ
    exact n with r
  have e := (Subset.empty_iff at realPlaces(K)).forward with sub
  have z : nrRealPlaces(K) = 0
    unfold nrRealPlaces
    rw e
    exact cardinality.empty
  refine ⟨z, ?_⟩
  have fin := infinitePlaces.finite at K with field, nf
  have subC : complexPlaces(K) ⊆ infinitePlaces(K)
    intros w hw
    unfold complexPlaces at hw
    exact hw.left
  have finC := Finite.subset with fin, subC
  have cn := cardinality.nat at complexPlaces(K) with finC
  have cn2 : Nat(nrComplexPlaces(K)) by unfold nrComplexPlaces; exact cn
  have c := nrPlaces.card_add_two_mul at K with field, nf
  rw z at c
  arith


-- NumberField.isTotallyComplex_of_algebra: an extension of a totally
-- complex field is totally complex.
theorem TotallyComplex.of_extension (K L f : Set)
  requires sourceField : Field(K)
  requires targetField : Field(L)
  requires complex : TotallyComplex(K)
  requires target : NumberField(L)
  requires hom : RingHom(f, K, L)
  shows TotallyComplex(L)
proof
  have kc := Field.to_comm_ring at K with sourceField
  have h0 := hom
  obtain ⟨_, _, fFun, _⟩ := h0
  obtain ⟨_, noReal⟩ := complex
  unfold TotallyComplex
  refine ⟨target, ?_⟩
  intros σ hσ re
  have hσ0 := hσ
  unfold complexEmbeddings at hσ0
  obtain ⟨_, σhom⟩ := hσ0
  have σ0 := σhom
  obtain ⟨_, _, σFun, _⟩ := σ0
  have comp := RingHom.comp at f, σ, K, L, complexRing with kc, hom, σhom
  have cc := complexRing.carrierOf
  rw cc at comp
  rw cc at σFun
  have cFun := compose.function at σ, f, Ring.carrier(K), Ring.carrier(L), complexCarrier with fFun, σFun
  have csp := (functionSpace.mem_iff at compose(σ, f, Ring.carrier(K), Ring.carrier(L), complexCarrier), Ring.carrier(K), complexCarrier).backward with cFun
  have cmem : compose(σ, f, Ring.carrier(K), Ring.carrier(L), complexCarrier) ∈ complexEmbeddings(K)
    unfold complexEmbeddings
    exact ⟨csp, comp⟩
  have nr := noReal with cmem
  apply nr
  unfold RealEmbedding
  refine ⟨cmem, ?_⟩
  intros a aK
  obtain ⟨_, fix⟩ := re
  have faL := FunctionBetween.apply_closed at f, Ring.carrier(K), Ring.carrier(L), a with fFun, aK
  have fx := fix with faL
  have ap := compose.apply at σ, f, Ring.carrier(K), Ring.carrier(L), complexCarrier, a with fFun, σFun, aK
  rw ap
  exact fx


-- A subfield of a totally real field is totally real
-- (IsTotallyReal.ofRingHom).
theorem TotallyReal.of_hom (K L f : Set)
  requires sourceField : Field(K)
  requires targetField : Field(L)
  requires source : NumberField(K)
  requires real : TotallyReal(L)
  requires hom : RingHom(f, K, L)
  shows TotallyReal(K)
proof
  sorry

-- Section: The maximal real subfield
section MaximalRealSubfield
variable (K : Set)
hypothesis field : Field(K)
hypothesis numberField : NumberField(K)

-- maximalRealSubfield is a subfield, and a number field.
theorem maximalRealSubfield.subfield
  shows Subring(K, maximalRealSubfield(K)) ∧ Field(maximalRealSubfieldRing(K)) ∧
    NumberField(maximalRealSubfieldRing(K))
proof
  sorry

-- NumberField.maximalRealSubfield is totally real
-- (IsTotallyReal (maximalRealSubfield K)).
theorem maximalRealSubfield.totally_real
  shows TotallyReal(maximalRealSubfieldRing(K))
proof
  sorry

-- The maximal real subfield contains every totally real subfield
-- (NumberField.IsTotallyReal.le_maximalRealSubfield).
theorem maximalRealSubfield.maximal (F f : Set)
  requires subfieldField : Field(F)
  requires real : TotallyReal(F)
  requires hom : RingHom(f, F, K)
  shows functionImage(f, Ring.carrier(F), Ring.carrier(K)) ⊆ maximalRealSubfield(K)
proof
  intros y hy
  have hy0 := hy
  unfold functionImage at hy0
  obtain ⟨yK, a, aF, ye⟩ := hy0
  have fc := Field.to_comm_ring at F with subfieldField
  have h0 := hom
  obtain ⟨_, _, fFun, _⟩ := h0
  unfold maximalRealSubfield
  refine ⟨yK, ?_⟩
  intros σ hσ
  have hσ0 := hσ
  unfold complexEmbeddings at hσ0
  obtain ⟨σsp, σhom⟩ := hσ0
  have σ0 := σhom
  obtain ⟨_, _, σFun, _⟩ := σ0
  have comp := RingHom.comp at f, σ, F, K, complexRing with fc, hom, σhom
  have cc := complexRing.carrierOf
  rw cc at comp
  rw cc at σFun
  have cFun := compose.function at σ, f, Ring.carrier(F), Ring.carrier(K), complexCarrier with fFun, σFun
  have csp := (functionSpace.mem_iff at compose(σ, f, Ring.carrier(F), Ring.carrier(K), complexCarrier), Ring.carrier(F), complexCarrier).backward with cFun
  have cmem : compose(σ, f, Ring.carrier(F), Ring.carrier(K), complexCarrier) ∈ complexEmbeddings(F)
    unfold complexEmbeddings
    exact ⟨csp, comp⟩
  obtain ⟨_, allReal⟩ := real
  have re := allReal with cmem
  obtain ⟨_, fix⟩ := re
  have fa := fix with aF
  have ap := compose.apply at σ, f, Ring.carrier(F), Ring.carrier(K), complexCarrier, a with fFun, σFun, aF
  rw ap at fa
  rw ye
  exact fa


end MaximalRealSubfield

-- Section: CM fields
section CMFields
variable (K : Set)
hypothesis field : Field(K)
hypothesis cm : CMField(K)

-- A CM field is a number field.
theorem CMField.number_field
  shows NumberField(K) ∧ TotallyComplex(K)
proof
  obtain ⟨tc, _⟩ := cm
  have tc0 := tc
  obtain ⟨nf, _⟩ := tc0
  exact ⟨nf, tc⟩


-- IsCMField.isQuadraticExtension: [K : K⁺] = 2, and so
-- [K : ℚ] = 2 [K⁺ : ℚ].
theorem CMField.quadratic
  shows realSubfieldDegree(K) = 2 ∧
    numberFieldDegree(K) = mul(2, numberFieldDegree(maximalRealSubfieldRing(K)))
proof
  have nfc := CMField.number_field at K with field, cm
  obtain ⟨nf, _⟩ := nfc
  have sf := maximalRealSubfield.subfield at K with field, nf
  obtain ⟨sub, _, nfp⟩ := sf
  have kc := Field.to_comm_ring at K with field
  have incl := Subring.inclusion at K, maximalRealSubfield(K) with kc, sub
  have hom : RingHom(identity(maximalRealSubfield(K)), maximalRealSubfieldRing(K), K)
    unfold maximalRealSubfieldRing
    exact incl
  have cm0 := cm
  obtain ⟨_, _, two⟩ := cm0
  have t := numberFieldDegree.tower at maximalRealSubfieldRing(K), K, identity(maximalRealSubfield(K)) with nfp, nf, hom
  have rd : realSubfieldDegree(K) = finrank(algebraModule(Algebra.mk(maximalRealSubfieldRing(K), K, identity(maximalRealSubfield(K)))), maximalRealSubfieldRing(K))
    unfold realSubfieldDegree
    unfold realSubfieldAlgebra
    rfl
  rw ← rd at t
  rw two at t
  exact ⟨two, t⟩


-- IsCMField.complexConj is a ring automorphism of K.
theorem cmConjugation.automorphism
  shows cmConjugation(K) ∈ fieldAutomorphisms(K)
proof
  sorry

-- IsCMField.complexEmbedding_complexConj, isConj_complexConj: every
-- embedding intertwines c with complex conjugation.
theorem cmConjugation.embedding (σ x : Set)
  requires embedding : σ ∈ complexEmbeddings(K)
  requires member : x ∈ Ring.carrier(K)
  shows σ(cmConjugation(K)(x)) = complexConj(σ(x))
proof
  sorry

-- The conjugation of a CM field is a function on K.
theorem tkF.cmConjugation.function
  shows cmConjugation(K) : Ring.carrier(K) → Ring.carrier(K)
proof
  have a := cmConjugation.automorphism at K with field, cm
  unfold fieldAutomorphisms at a
  obtain ⟨sp, _⟩ := a
  exact (functionSpace.mem_iff at cmConjugation(K), Ring.carrier(K), Ring.carrier(K)).forward with sp


-- c(x) = y as soon as σ(y) = conj(σ(x)) for every embedding σ.
theorem tkF.cmConjugation.pair (x y : Set)
  requires first : x ∈ Ring.carrier(K)
  requires second : y ∈ Ring.carrier(K)
  requires law : ∀ σ ∈ complexEmbeddings(K), σ(y) = complexConj(σ(x))
  shows cmConjugation(K)(x) = y
proof
  have fn := tkF.cmConjugation.function at K with field, cm
  have pIn := product.pair at x, y, Ring.carrier(K), Ring.carrier(K) with first, second
  have rel : relates(cmConjugation(K), x, y)
    unfold relates
    apply cmConjugation.membership.backward
    exact ⟨pIn, x, first, y, second, rfl, law⟩
  exact FunctionBetween.apply_value at cmConjugation(K), Ring.carrier(K), Ring.carrier(K), x, y with fn, first, rel


-- IsCMField.orderOf_complexConj, complexConj_ne_one: c is an involution
-- other than the identity.
theorem cmConjugation.order_two
  shows compose(cmConjugation(K), cmConjugation(K), Ring.carrier(K), Ring.carrier(K),
      Ring.carrier(K)) = identity(Ring.carrier(K)) ∧
    cmConjugation(K) ≠ identity(Ring.carrier(K))
proof
  have fn := tkF.cmConjugation.function at K with field, cm
  have cc := compose.function at cmConjugation(K), cmConjugation(K), Ring.carrier(K), Ring.carrier(K), Ring.carrier(K) with fn, fn
  have idf := identity.function at Ring.carrier(K)
  have same : ∀ x ∈ Ring.carrier(K), compose(cmConjugation(K), cmConjugation(K), Ring.carrier(K), Ring.carrier(K), Ring.carrier(K))(x) = identity(Ring.carrier(K))(x)
    intros x hx
    have ap := compose.apply at cmConjugation(K), cmConjugation(K), Ring.carrier(K), Ring.carrier(K), Ring.carrier(K), x with fn, fn, hx
    have ia := identity.apply at x, Ring.carrier(K) with hx
    rw [ap, ia]
    have cx := FunctionBetween.apply_closed at cmConjugation(K), Ring.carrier(K), Ring.carrier(K), x with fn, hx
    have law : ∀ σ ∈ complexEmbeddings(K), σ(x) = complexConj(σ(cmConjugation(K)(x)))
      intros σ hσ
      have em := cmConjugation.embedding at K, σ, x with field, cm, hσ, hx
      rw em
      have hσ0 := hσ
      unfold complexEmbeddings at hσ0
      obtain ⟨sp, _⟩ := hσ0
      have sf := (functionSpace.mem_iff at σ, Ring.carrier(K), complexCarrier).forward with sp
      have sx := FunctionBetween.apply_closed at σ, Ring.carrier(K), complexCarrier, x with sf, hx
      have inv := complexConj.involutive at σ(x) with sx
      rw inv
    exact tkF.cmConjugation.pair at K, cmConjugation(K)(x), x with field, cm, cx, hx, law
  have eq := FunctionBetween.ext at compose(cmConjugation(K), cmConjugation(K), Ring.carrier(K), Ring.carrier(K), Ring.carrier(K)), identity(Ring.carrier(K)), Ring.carrier(K), Ring.carrier(K) with cc, idf, same
  refine ⟨eq, ?_⟩
  intro e
  have nfc := CMField.number_field at K with field, cm
  obtain ⟨nf, tc⟩ := nfc
  have ne := tkF.complexEmbeddings.nonempty at K with field, nf
  obtain ⟨σ, hσ⟩ := ne
  obtain ⟨_, noReal⟩ := tc
  have nr := noReal with hσ
  apply nr
  unfold RealEmbedding
  refine ⟨hσ, ?_⟩
  intros x hx
  have em := cmConjugation.embedding at K, σ, x with field, cm, hσ, hx
  rw e at em
  have ia := identity.apply at x, Ring.carrier(K) with hx
  rw ia at em
  rw ← em


-- IsCMField.complexConj_eq_self_iff: the fixed points of c form K⁺.
theorem cmConjugation.fixed_iff (x : K)
  shows cmConjugation(K)(x) = x ↔ x ∈ maximalRealSubfield(K)
proof
  have xK : x ∈ Ring.carrier(K) by assumption
  constructor
  . intro e
    unfold maximalRealSubfield
    refine ⟨xK, ?_⟩
    intros σ hσ
    have em := cmConjugation.embedding at K, σ, x with field, cm, hσ, xK
    rw e at em
    rw ← em
  . intro h
    unfold maximalRealSubfield at h
    obtain ⟨_, all⟩ := h
    have law : ∀ σ ∈ complexEmbeddings(K), σ(x) = complexConj(σ(x))
      intros σ hσ
      have a := all with hσ
      rw a
    exact tkF.cmConjugation.pair at K, x, x with field, cm, xK, xK, law


-- IsCMField.ringOfIntegersComplexConj, ringOfIntegersComplexConj_eq_self_iff:
-- c preserves 𝓞 K, fixing exactly 𝓞 K ∩ K⁺.
theorem cmConjugation.integers (x : Set)
  requires integral : x ∈ ringOfIntegers(K)
  shows cmConjugation(K)(x) ∈ ringOfIntegers(K) ∧
    (cmConjugation(K)(x) = x ↔ x ∈ maximalRealSubfield(K))
proof
  have nfc := CMField.number_field at K with field, cm
  obtain ⟨nf, _⟩ := nfc
  have a := cmConjugation.automorphism at K with field, cm
  unfold fieldAutomorphisms at a
  obtain ⟨_, iso⟩ := a
  obtain ⟨hom, _⟩ := iso
  have m := ringOfIntegers.map_mem at K, K, cmConjugation(K), x with nf, nf, hom, integral
  have sub := ringOfIntegers.subring at K with field, nf
  have bounded := sub.left
  have xK := bounded with x, integral
  have fx := cmConjugation.fixed_iff at K, x with field, cm, xK
  exact ⟨m, fx⟩


-- IsCMField.unitsComplexConj_torsion: c inverts roots of unity.
theorem cmConjugation.torsion (ζ : Set)
  requires torsion : ζ ∈ torsionUnits(K)
  shows call2(Ring.mul(K), cmConjugation(K)(ζ), ζ) = Ring.one(K)
proof
  sorry

-- IsCMField.unitsMulComplexConjInv: u / c(u) is a root of unity for every
-- unit u.
theorem cmConjugation.unit_ratio (u v : Set)
  requires unit : u ∈ integerUnits(K)
  requires inverse : v ∈ ringOfIntegers(K)
  requires inverts : call2(Ring.mul(K), cmConjugation(K)(u), v) = Ring.one(K)
  shows call2(Ring.mul(K), u, v) ∈ torsionUnits(K)
proof
  sorry

-- IsCMField.card_infinitePlace_eq_card_infinitePlace, equivInfinitePlace:
-- K and K⁺ have equally many infinite places, by restriction.
theorem CMField.places
  shows cardinality(infinitePlaces(K)) =
      cardinality(infinitePlaces(maximalRealSubfieldRing(K))) ∧
    BijectiveBetween(realSubfieldPlaceMap(K),
      infinitePlaces(K), infinitePlaces(maximalRealSubfieldRing(K)))
proof
  sorry

end CMFields

-- Section: CM extensions
-- NumberField.IsCMField.ofCMExtension: the top of a CM extension is CM.
theorem CMExtension.cm_field (f F K : Set)
  requires extension : CMExtension(f, F, K)
  shows CMField(K)
proof
  sorry

-- NumberField.CMExtension.equivMaximalRealSubfield: f maps F onto K⁺.
theorem CMExtension.image (f F K : Set)
  requires extension : CMExtension(f, F, K)
  shows functionImage(f, Ring.carrier(F), Ring.carrier(K)) = maximalRealSubfield(K) ∧
    InjectiveBetween(f, Ring.carrier(F), Ring.carrier(K))
proof
  sorry

-- Section: Units and roots of unity
section Units
variable (K : Set)
hypothesis field : Field(K)
hypothesis numberField : NumberField(K)

-- NumberField.Units.torsion is finite and contains ±1
-- (Units.torsionOrder_pos; 2 divides the torsion order).
theorem torsionUnits.finite
  shows Finite(torsionUnits(K)) ∧ torsionUnits(K) ⊆ integerUnits(K) ∧
    torsionOrder(K) ∈ ℕ ∧ (∃ m ∈ ℕ, torsionOrder(K) = mul(2, m)) ∧ torsionOrder(K) ≠ 0
proof
  sorry

-- NumberField.Units.dvd_torsionOrder_of_isPrimitiveRoot: a root of unity
-- of exact order n gives n | torsionOrder.
theorem torsionOrder.dvd_of_root (ζ : Set) (n : Nat)
  requires member : ζ ∈ Ring.carrier(K)
  requires positive : n ≠ 0
  requires root : Ring.pow(K, ζ, n) = Ring.one(K)
  requires primitive : ∀ k ∈ n, k ≠ 0 → Ring.pow(K, ζ, k) ≠ Ring.one(K)
  shows ∃ m ∈ ℕ, torsionOrder(K) = mul(n, m)
proof
  sorry

-- Roots of unity are the units of modulus one at every embedding
-- (NumberField.Units.mem_torsion).
theorem torsionUnits.mem_iff (x : Set)
  requires integral : x ∈ ringOfIntegers(K)
  shows x ∈ torsionUnits(K) ↔
    (∀ σ ∈ complexEmbeddings(K), complexAbs(σ(x)) = realOne)
proof
  sorry

end Units
