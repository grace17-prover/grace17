-- Dedekind domains: Noetherian integrally closed domains of dimension at
-- most one (IsDedekindDomain), the nonzero primes (HeightOneSpectrum),
-- divisibility and multiplicities of ideals and the factorisation into
-- prime powers, the P-adic valuations of R and of its fraction field
-- (intValuation, valuation, written additively), fractional ideals
-- (FractionalIdeal) with products, inverses, principal fractional ideals
-- and the exponents count_P, the class group and class number, the
-- ramification index and inertia degree of a prime over a prime, and the
-- absolute norm of ideals of a ring of integers (Ideal.absNorm,
-- FractionalIdeal.absNorm).
-- Part of the GRH blueprint.
-- Planned home: Algebra/Ring/DedekindDomain, NumberTheory/NumberField/Ideal.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.NumberField.Dedekind
import GRH.NumberField.Basic
import Grace.Cumulus.Int.Order
import Grace.Cumulus.NumberTheory.Prime

-- Section: Dedekind domains and their nonzero primes
-- A Dedekind domain: a Noetherian integrally closed domain in which every
-- nonzero prime is maximal (IsDedekindDomain; Mathlib does not exclude
-- fields, and neither does this).
predicate DedekindDomain (R : Set) :=
  IntegralDomain(R) ∧ NoetherianRing(R) ∧ IntegrallyClosedDomain(R) ∧
  (∀ P, PrimeIdeal(R, P) → P ≠ {Ring.zero(R)} → MaximalIdeal(R, P))

-- The nonzero primes of R (IsDedekindDomain.HeightOneSpectrum R, whose
-- elements are the ideals v.asIdeal themselves here).
def heightOneSpectrum (R : Set) : Set :=
  { P ∈ 𝒫(Ring.carrier(R)) | PrimeIdeal(R, P) ∧ P ≠ {Ring.zero(R)} }

-- I divides J: J = I C for an ideal C (Dvd on Ideal R).
predicate IdealDvd (R I J : Set) :=
  Ideal(R, I) ∧ Ideal(R, J) ∧ (∃ C, Ideal(R, C) ∧ J = idealProduct(R, I, C))

-- The exponent of P in a nonzero ideal I: the k with I ⊆ Pᵏ, I ⊄ Pᵏ⁺¹
-- (multiplicity of v.asIdeal in I, Associates.count of the factors).
defunique idealMultiplicity (R P I : Set) (k ∈ ℕ) :=
  I ⊆ idealPow(R, P, k) ∧ ¬(I ⊆ idealPow(R, P, succ(k)))
requires dedekind : DedekindDomain(R)
requires prime : P ∈ heightOneSpectrum(R)
requires ideal : Ideal(R, I)
requires nonzero : I ≠ {Ring.zero(R)}
proof
  sorry
uniqueness
  sorry

-- The family k ↦ e(k)^{multiplicity of e(k) in J} over an enumeration
-- e : n → primes, whose product is the factorisation of J.
def factorFamily (R J e n : Set) : Set :=
  { (k, idealPow(R, e(k), idealMultiplicity(R, e(k), J))) | k ∈ n }

-- The primes containing J, that is dividing J.
def primeFactors (R J : Set) : Set :=
  { P ∈ heightOneSpectrum(R) | J ⊆ P }

-- Section: Adic valuations
-- The P-adic order of a nonzero r ∈ R (IsDedekindDomain.HeightOneSpectrum
-- .intValuation, which is exp(−ord_P(r)) in ℤₘ₀; written additively).
def intValuationOrder (R P r : Set) : Set :=
  idealMultiplicity(R, P, ringMultiples(R, r))

-- The P-adic order of a nonzero x of the fraction field A of R
-- (HeightOneSpectrum.valuation, additively): ord(a) − ord(b) for x = a/b.
defunique adicOrder (A P x : Set) (n ∈ ℤ) :=
  ∃ a ∈ Ring.carrier(Algebra.base(A)), ∃ b ∈ Ring.carrier(Algebra.base(A)),
    a ≠ Ring.zero(Algebra.base(A)) ∧ b ≠ Ring.zero(Algebra.base(A)) ∧
    call2(Ring.mul(Algebra.ring(A)), x, Algebra.map(A)(b)) = Algebra.map(A)(a) ∧
    n = integerClass(intValuationOrder(Algebra.base(A), P, a),
      intValuationOrder(Algebra.base(A), P, b))
requires fraction : IsFractionRing(A)
requires dedekind : DedekindDomain(Algebra.base(A))
requires prime : P ∈ heightOneSpectrum(Algebra.base(A))
requires member : x ∈ algebraCarrier(A)
requires nonzero : x ≠ Ring.zero(Algebra.ring(A))
proof
  sorry
uniqueness
  sorry

-- The primes at which a nonzero x has nonzero order.
def adicSupport (A x : Set) : Set :=
  { P ∈ heightOneSpectrum(Algebra.base(A)) | adicOrder(A, P, x) ≠ integerZero }

-- Section: Fractional ideals
-- The image of R in its fraction field A, which is the fractional ideal 1.
def integerElements (A : Set) : Set :=
  functionImage(Algebra.map(A), Ring.carrier(Algebra.base(A)), algebraCarrier(A))

-- A fractional ideal of R in A: an R-submodule I of A with a I ⊆ R for a
-- nonzero divisor a of R (FractionalIdeal R⁰ K, IsFractional).
predicate FractionalIdeal (A I : Set) :=
  SubmoduleOf(I, algebraModule(A), Algebra.base(A)) ∧
  (∃ a ∈ nonZeroDivisors(Algebra.base(A)), ∀ x ∈ I,
    call2(Ring.mul(Algebra.ring(A)), Algebra.map(A)(a), x) ∈ integerElements(A))

def fractionalIdeals (A : Set) : Set :=
  { I ∈ 𝒫(algebraCarrier(A)) | FractionalIdeal(A, I) }

-- The zero fractional ideal and the nonzero ones ((FractionalIdeal R⁰ K)⁰).
def fractionalIdealZero (A : Set) : Set := {Ring.zero(Algebra.ring(A))}

def nonzeroFractionalIdeals (A : Set) : Set :=
  { I ∈ fractionalIdeals(A) | I ≠ fractionalIdealZero(A) }

-- An ideal of R as a fractional ideal (FractionalIdeal.coeIdeal).
def coeIdeal (A I : Set) : Set :=
  functionImage(Algebra.map(A), I, algebraCarrier(A))

-- The principal fractional ideal R x (FractionalIdeal.spanSingleton).
def spanSingleton (A x : Set) : Set :=
  scalarMultiples(algebraModule(A), Algebra.base(A), x)

-- The products x y with x ∈ I, y ∈ J, and the product I J, the submodule
-- they span (FractionalIdeal.mul).
def elementProducts (A I J : Set) : Set :=
  { z ∈ algebraCarrier(A) | ∃ x ∈ I, ∃ y ∈ J,
    z = call2(Ring.mul(Algebra.ring(A)), x, y) }

def fractionalIdealMul (A I J : Set) : Set :=
  moduleSpan(algebraModule(A), Algebra.base(A), elementProducts(A, I, J))

-- The inverse I⁻¹ = (1 : I) = { x | x I ⊆ R }, and 0⁻¹ = 0
-- (FractionalIdeal.inv, 1 / I).
def fractionalIdealInv (A I : Set) : Set :=
  { x ∈ algebraCarrier(A) |
    (I = fractionalIdealZero(A) → x = Ring.zero(Algebra.ring(A))) ∧
    (∀ y ∈ I, call2(Ring.mul(Algebra.ring(A)), x, y) ∈ integerElements(A)) }

-- The exponent of P in a nonzero fractional ideal I: for a I = J with
-- a ∈ R nonzero and J an ideal, ord_P(J) − ord_P(a)
-- (FractionalIdeal.count; its independence of a is count_well_defined).
defunique fractionalCount (A P I : Set) (n ∈ ℤ) :=
  ∃ a ∈ Ring.carrier(Algebra.base(A)), ∃ J,
    a ≠ Ring.zero(Algebra.base(A)) ∧ Ideal(Algebra.base(A), J) ∧
    fractionalIdealMul(A, spanSingleton(A, Algebra.map(A)(a)), I) = coeIdeal(A, J) ∧
    n = integerClass(idealMultiplicity(Algebra.base(A), P, J),
      intValuationOrder(Algebra.base(A), P, a))
requires fraction : IsFractionRing(A)
requires dedekind : DedekindDomain(Algebra.base(A))
requires prime : P ∈ heightOneSpectrum(Algebra.base(A))
requires fractional : I ∈ nonzeroFractionalIdeals(A)
proof
  sorry
uniqueness
  sorry

-- The primes at which a nonzero fractional ideal has nonzero exponent.
def countSupport (A I : Set) : Set :=
  { P ∈ heightOneSpectrum(Algebra.base(A)) | fractionalCount(A, P, I) ≠ integerZero }

-- Section: The class group
-- Two nonzero fractional ideals are in one class when I = x J for a
-- nonzero x; the class group is the quotient (ClassGroup R, as
-- (FractionalIdeal R⁰ K)ˣ ⧸ principal ideals) and the class number its
-- cardinality (NumberField.classNumber, Fintype.card (ClassGroup (𝓞 K))).
def idealClassRelation (A : Set) : Set :=
  { p ∈ nonzeroFractionalIdeals(A) × nonzeroFractionalIdeals(A) |
    ∃ I, ∃ J, ∃ x ∈ algebraCarrier(A), p = (I, J) ∧
      x ≠ Ring.zero(Algebra.ring(A)) ∧
      I = fractionalIdealMul(A, spanSingleton(A, x), J) }

def classGroupCarrier (A : Set) : Set :=
  (nonzeroFractionalIdeals(A) ⧸ idealClassRelation(A))

def classNumber (K : Set) : Set :=
  cardinality(classGroupCarrier(ringOfIntegersInclusion(K)))

-- Section: Primes over primes
-- For f : R →+* S and primes p of R, P of S: the ramification index, the
-- exponent of P in p S (Ideal.ramificationIdx), and the inertia degree,
-- the degree of S ⧸ P over R ⧸ p (Ideal.inertiaDeg).
def ramificationIndex (f S p P : Set) : Set :=
  idealMultiplicity(S, P, idealExtension(f, S, p))

def residueExtension (f R S p P : Set) : Set :=
  Algebra.mk(quotientRing(R, p), quotientRing(S, P), quotientRingMap(R, S, f, p, P))

def inertiaDegree (f R S p P : Set) : Set :=
  finrank(algebraModule(residueExtension(f, R, S, p, P)), quotientRing(R, p))

-- The primes of S over p (Ideal.primesOver, IsDedekindDomain.primesOverFinset).
def primesOver (f R S p : Set) : Set :=
  { P ∈ heightOneSpectrum(S) | LiesOver(f, R, P, p) }

-- The prime ideal p ℤ of ℤ, and the primes of 𝓞 K over it.
def integerPrimeIdeal (p : Set) : Set := ringMultiples(integerRing, integerOfNat(p))

-- The family P ↦ e(P | p) f(P | p) over the primes of 𝓞 L over p, in ℤ.
def ramificationInertiaFamily (f K L p : Set) : Set :=
  { (P, integerOfNat(mul(
      ramificationIndex(ringOfIntegersMap(f, K), ringOfIntegersRing(L), p, P),
      inertiaDegree(ringOfIntegersMap(f, K), ringOfIntegersRing(K),
        ringOfIntegersRing(L), p, P)))) |
    P ∈ primesOver(ringOfIntegersMap(f, K), ringOfIntegersRing(K),
      ringOfIntegersRing(L), p) }

-- Section: The absolute norm of an ideal
-- The cardinality of R ⧸ I, and 0 when R ⧸ I is infinite (Ideal.absNorm,
-- by Submodule.cardQuot and Nat.card).
defunique idealAbsNorm (R I : Set) (n ∈ ℕ) :=
  (Finite(Ring.carrier(quotientRing(R, I))) ∧
    HasCardinality(Ring.carrier(quotientRing(R, I)), n)) ∨
  (¬Finite(Ring.carrier(quotientRing(R, I))) ∧ n = 0)
requires ring : CommRing(R)
requires ideal : Ideal(R, I)
proof
  sorry
uniqueness
  sorry

-- The absolute norm of an ideal of 𝓞 K.
def absNorm (K I : Set) : Set := idealAbsNorm(ringOfIntegersRing(K), I)

-- The ideals of 𝓞 K of norm n.
def idealsOfNorm (K n : Set) : Set :=
  { I ∈ 𝒫(ringOfIntegers(K)) | Ideal(ringOfIntegersRing(K), I) ∧ absNorm(K, I) = n }

-- The absolute norm of a nonzero fractional ideal of K, in ℚ:
-- N(J) / N(a R) for a I = J (FractionalIdeal.absNorm).
defunique fractionalAbsNorm (K I : Set) (q ∈ ℚ) :=
  ∃ a ∈ ringOfIntegers(K), ∃ J,
    a ≠ Ring.zero(K) ∧ Ideal(ringOfIntegersRing(K), J) ∧
    fractionalIdealMul(ringOfIntegersInclusion(K),
      spanSingleton(ringOfIntegersInclusion(K), a), I) =
      coeIdeal(ringOfIntegersInclusion(K), J) ∧
    rationalMul((q, natCast(rationalRing,
      absNorm(K, ringMultiples(ringOfIntegersRing(K), a))))) =
      natCast(rationalRing, absNorm(K, J))
requires numberField : NumberField(K)
requires fractional : I ∈ nonzeroFractionalIdeals(ringOfIntegersInclusion(K))
proof
  sorry
uniqueness
  sorry

-- Section: Dedekind domains
-- NumberField.RingOfIntegers.instIsDedekindDomain
theorem ringOfIntegers.dedekind (K : Set)
  requires numberField : NumberField(K)
  shows DedekindDomain(ringOfIntegersRing(K))
proof
  sorry

-- IsPrincipalIdealRing.isDedekindDomain
theorem DedekindDomain.of_principal (R : Set)
  requires principal : PrincipalIdealDomain(R)
  shows DedekindDomain(R)
proof
  sorry

-- ℤ is a Dedekind domain.
theorem integerRing.dedekind
  shows DedekindDomain(integerRing)
proof
  sorry

-- IsLocalization.isDedekindDomain: a localization at a set of nonzero
-- elements is Dedekind.
theorem DedekindDomain.localization (S A : Set)
  requires dedekind : DedekindDomain(Algebra.base(A))
  requires localization : IsLocalization(S, A)
  requires nonzero : S ⊆ nonZeroDivisors(Algebra.base(A))
  shows DedekindDomain(Algebra.ring(A))
proof
  sorry

section Dedekind
variable (R : Set)
hypothesis dedekind : DedekindDomain(R)

-- IsLocalization.AtPrime.isDiscreteValuationRing_of_dedekind_domain
theorem DedekindDomain.localization_dvr (P : Set)
  requires prime : P ∈ heightOneSpectrum(R)
  shows DiscreteValuationRing(localizationAtPrime(R, P))
proof
  sorry

-- HeightOneSpectrum.isMaximal, HeightOneSpectrum.prime
theorem heightOneSpectrum.maximal (P : Set)
  requires prime : P ∈ heightOneSpectrum(R)
  shows MaximalIdeal(R, P) ∧ PrimeIdeal(R, P)
proof
  sorry

-- HeightOneSpectrum.equivMaximalSpectrum: when R is not a field, the
-- nonzero primes are the maximal ideals.
theorem heightOneSpectrum.iff_maximal (P : Set)
  requires notField : ¬Field(R)
  shows P ∈ heightOneSpectrum(R) ↔ MaximalIdeal(R, P)
proof
  sorry

-- HeightOneSpectrum.ideal_ne_top_iff_exists
theorem heightOneSpectrum.ideal_ne_top_iff_exists (I : Set)
  requires notField : ¬Field(R)
  requires ideal : Ideal(R, I)
  shows I ≠ Ring.carrier(R) ↔ (∃ P ∈ heightOneSpectrum(R), I ⊆ P)
proof
  sorry

-- HeightOneSpectrum.asIdeal_injective, ext_iff: a nonzero prime is
-- determined by its ideal (here they are the same set).
theorem heightOneSpectrum.mem_iff (P : Set)
  shows P ∈ heightOneSpectrum(R) ↔ (PrimeIdeal(R, P) ∧ P ≠ {Ring.zero(R)})
proof
  sorry

-- Section: Divisibility and factorisation of ideals
-- Ideal.dvd_iff_le: to divide is to contain.
theorem IdealDvd.iff_subset (I J : Set)
  requires first : Ideal(R, I)
  requires second : Ideal(R, J)
  shows IdealDvd(R, I, J) ↔ J ⊆ I
proof
  sorry

-- Ideal.dvd_span_singleton
theorem IdealDvd.span_singleton (I r : Set)
  requires ideal : Ideal(R, I)
  requires member : r ∈ Ring.carrier(R)
  shows IdealDvd(R, I, ringMultiples(R, r)) ↔ r ∈ I
proof
  sorry

-- Ideal.finite_factors: a nonzero ideal has finitely many prime factors.
theorem primeFactors.finite (J : Set)
  requires ideal : Ideal(R, J)
  requires nonzero : J ≠ {Ring.zero(R)}
  shows Finite(primeFactors(R, J))
proof
  sorry

-- The multiplicity is positive exactly at the prime factors
-- (count_ne_zero of normalizedFactors).
theorem idealMultiplicity.ne_zero_iff (P J : Set)
  requires prime : P ∈ heightOneSpectrum(R)
  requires ideal : Ideal(R, J)
  requires nonzero : J ≠ {Ring.zero(R)}
  shows idealMultiplicity(R, P, J) ≠ 0 ↔ J ⊆ P
proof
  sorry

-- Ideal.IsDedekindDomain.count_mul: multiplicities add.
theorem idealMultiplicity.mul (P I J : Set)
  requires prime : P ∈ heightOneSpectrum(R)
  requires first : Ideal(R, I)
  requires second : Ideal(R, J)
  requires firstNonzero : I ≠ {Ring.zero(R)}
  requires secondNonzero : J ≠ {Ring.zero(R)}
  shows idealMultiplicity(R, P, idealProduct(R, I, J)) =
    add(idealMultiplicity(R, P, I), idealMultiplicity(R, P, J))
proof
  sorry

-- The multiplicities of a prime power: n at P, 0 elsewhere
-- (count_pow_self, count of a different prime).
theorem idealMultiplicity.prime_pow (P Q : Set) (n : Nat)
  requires first : P ∈ heightOneSpectrum(R)
  requires second : Q ∈ heightOneSpectrum(R)
  shows (P = Q → idealMultiplicity(R, Q, idealPow(R, P, n)) = n) ∧
    (P ≠ Q → idealMultiplicity(R, Q, idealPow(R, P, n)) = 0)
proof
  sorry

-- Unique factorisation, as an order statement: for nonzero ideals,
-- I ⊆ J exactly when every exponent of J is at most that of I
-- (Ideal.dvd_iff_le with the factorisation, count_le_of_le).
theorem idealMultiplicity.subset_iff (I J : Set)
  requires first : Ideal(R, I)
  requires second : Ideal(R, J)
  requires firstNonzero : I ≠ {Ring.zero(R)}
  requires secondNonzero : J ≠ {Ring.zero(R)}
  shows I ⊆ J ↔ (∀ P ∈ heightOneSpectrum(R),
    (idealMultiplicity(R, P, J):N) ≤ (idealMultiplicity(R, P, I):N))
proof
  sorry

-- Ideal.finprod_heightOneSpectrum_factorization: a nonzero ideal is the
-- product of the powers P^{ord_P(J)} of its prime factors, in any
-- enumeration of them.
theorem idealMultiplicity.factorization (J e : Set) (n : Nat)
  requires ideal : Ideal(R, J)
  requires nonzero : J ≠ {Ring.zero(R)}
  requires enumeration : BijectiveBetween(e, n, primeFactors(R, J))
  shows J = idealFamilyProduct(R, factorFamily(R, J, e, n), n)
proof
  sorry

-- HeightOneSpectrum.isCoprime_pow_of_ne: powers of distinct primes are
-- coprime.
theorem heightOneSpectrum.coprime_pow (P Q : Set) (m n : Nat)
  requires first : P ∈ heightOneSpectrum(R)
  requires second : Q ∈ heightOneSpectrum(R)
  requires distinct : P ≠ Q
  shows idealSum(R, idealPow(R, P, m), idealPow(R, Q, n)) = Ring.carrier(R)
proof
  sorry

-- IsDedekindDomain.exists_forall_sub_mem_ideal (approximation): for
-- distinct primes e(i), exponents k(i) and targets x(i), some y is close
-- to every x(i).
theorem DedekindDomain.exists_forall_sub_mem (e k x : Set) (n : Nat)
  requires primes : InjectiveBetween(e, n, heightOneSpectrum(R))
  requires exponents : k : n → ℕ
  requires targets : x : n → Ring.carrier(R)
  shows ∃ y ∈ Ring.carrier(R), ∀ i ∈ n,
    Ring.sub(R, y, x(i)) ∈ idealPow(R, e(i), k(i))
proof
  sorry

-- IsDedekindDomain.exists_eq_span_pair, exists_sup_span_eq: an ideal is
-- generated by any of its nonzero elements and one more.
theorem DedekindDomain.span_pair (I a : Set)
  requires ideal : Ideal(R, I)
  requires member : a ∈ I
  requires nonzero : a ≠ Ring.zero(R)
  shows ∃ b ∈ I, I = generatedIdeal(R, {a, b})
proof
  sorry

-- Section: The adic valuation of R
-- map_mul for intValuation: orders add.
theorem intValuationOrder.mul (P a b : Set)
  requires prime : P ∈ heightOneSpectrum(R)
  requires first : a ∈ Ring.carrier(R)
  requires second : b ∈ Ring.carrier(R)
  requires firstNonzero : a ≠ Ring.zero(R)
  requires secondNonzero : b ≠ Ring.zero(R)
  shows intValuationOrder(R, P, call2(Ring.mul(R), a, b)) =
    add(intValuationOrder(R, P, a), intValuationOrder(R, P, b))
proof
  sorry

-- HeightOneSpectrum.intValuation_le_pow_iff_mem: n ≤ ord_P(r) exactly when
-- r ∈ Pⁿ.
theorem intValuationOrder.le_iff_mem_pow (P r : Set) (n : Nat)
  requires prime : P ∈ heightOneSpectrum(R)
  requires member : r ∈ Ring.carrier(R)
  requires nonzero : r ≠ Ring.zero(R)
  shows n ≤ (intValuationOrder(R, P, r):N) ↔ r ∈ idealPow(R, P, n)
proof
  sorry

-- HeightOneSpectrum.intValuation_le_pow_iff_dvd
theorem intValuationOrder.le_iff_dvd (P r : Set) (n : Nat)
  requires prime : P ∈ heightOneSpectrum(R)
  requires member : r ∈ Ring.carrier(R)
  requires nonzero : r ≠ Ring.zero(R)
  shows n ≤ (intValuationOrder(R, P, r):N) ↔
    IdealDvd(R, idealPow(R, P, n), ringMultiples(R, r))
proof
  sorry

-- HeightOneSpectrum.intValuation_eq_one_iff, valuation_eq_one_iff_notMem,
-- intValuation_lt_one_iff_mem: ord_P(r) = 0 exactly when r ∉ P.
theorem intValuationOrder.eq_zero_iff (P r : Set)
  requires prime : P ∈ heightOneSpectrum(R)
  requires member : r ∈ Ring.carrier(R)
  requires nonzero : r ≠ Ring.zero(R)
  shows intValuationOrder(R, P, r) = 0 ↔ r ∉ P
proof
  sorry

-- HeightOneSpectrum.intValuation_singleton: a uniformizer has order 1.
theorem intValuationOrder.uniformizer (P π : Set)
  requires prime : P ∈ heightOneSpectrum(R)
  requires member : π ∈ P
  requires notSquare : π ∉ idealPow(R, P, 2)
  shows intValuationOrder(R, P, π) = 1
proof
  sorry

-- The ultrametric inequality (Valuation.map_add): a common lower bound of
-- the orders of a and b bounds that of a + b.
theorem intValuationOrder.add (P a b : Set) (n : Nat)
  requires prime : P ∈ heightOneSpectrum(R)
  requires first : a ∈ Ring.carrier(R)
  requires second : b ∈ Ring.carrier(R)
  requires firstNonzero : a ≠ Ring.zero(R)
  requires secondNonzero : b ≠ Ring.zero(R)
  requires sumNonzero : call2(Ring.add(R), a, b) ≠ Ring.zero(R)
  requires firstBound : n ≤ (intValuationOrder(R, P, a):N)
  requires secondBound : n ≤ (intValuationOrder(R, P, b):N)
  shows n ≤ (intValuationOrder(R, P, call2(Ring.add(R), a, b)):N)
proof
  sorry

end Dedekind

-- Section: The adic valuation of the fraction field
section FractionField
variable (A : Set)
hypothesis fraction : IsFractionRing(A)
hypothesis dedekind : DedekindDomain(Algebra.base(A))

-- HeightOneSpectrum.valuation_of_algebraMap: on R the order is that of R.
theorem adicOrder.of_algebraMap (P r : Set)
  requires prime : P ∈ heightOneSpectrum(Algebra.base(A))
  requires member : r ∈ Ring.carrier(Algebra.base(A))
  requires nonzero : r ≠ Ring.zero(Algebra.base(A))
  shows adicOrder(A, P, Algebra.map(A)(r)) =
    integerOfNat(intValuationOrder(Algebra.base(A), P, r))
proof
  sorry

-- map_mul for the valuation: orders add.
theorem adicOrder.mul (P x y : Set)
  requires prime : P ∈ heightOneSpectrum(Algebra.base(A))
  requires first : x ∈ algebraCarrier(A)
  requires second : y ∈ algebraCarrier(A)
  requires firstNonzero : x ≠ Ring.zero(Algebra.ring(A))
  requires secondNonzero : y ≠ Ring.zero(Algebra.ring(A))
  shows adicOrder(A, P, call2(Ring.mul(Algebra.ring(A)), x, y)) =
    call2(integerAdd, adicOrder(A, P, x), adicOrder(A, P, y))
proof
  sorry

-- Valuation.map_add: the ultrametric inequality.
theorem adicOrder.add (P x y n : Set)
  requires prime : P ∈ heightOneSpectrum(Algebra.base(A))
  requires first : x ∈ algebraCarrier(A)
  requires second : y ∈ algebraCarrier(A)
  requires firstNonzero : x ≠ Ring.zero(Algebra.ring(A))
  requires secondNonzero : y ≠ Ring.zero(Algebra.ring(A))
  requires sumNonzero : call2(Ring.add(Algebra.ring(A)), x, y) ≠ Ring.zero(Algebra.ring(A))
  requires integer : n ∈ ℤ
  requires firstBound : integerLe(n, adicOrder(A, P, x))
  requires secondBound : integerLe(n, adicOrder(A, P, y))
  shows integerLe(n, adicOrder(A, P, call2(Ring.add(Algebra.ring(A)), x, y)))
proof
  sorry

-- HeightOneSpectrum.valuation_exists_uniformizer
theorem adicOrder.exists_uniformizer (P : Set)
  requires prime : P ∈ heightOneSpectrum(Algebra.base(A))
  shows ∃ π ∈ algebraCarrier(A), π ≠ Ring.zero(Algebra.ring(A)) ∧
    adicOrder(A, P, π) = integerOne
proof
  sorry

-- HeightOneSpectrum.mem_integers_of_valuation_le_one: an element of
-- nonnegative order at every prime lies in R.
theorem adicOrder.mem_integers (x : Set)
  requires member : x ∈ algebraCarrier(A)
  requires nonzero : x ≠ Ring.zero(Algebra.ring(A))
  requires integral : ∀ P ∈ heightOneSpectrum(Algebra.base(A)),
    integerLe(integerZero, adicOrder(A, P, x))
  shows x ∈ integerElements(A)
proof
  sorry

-- A nonzero element has nonzero order at finitely many primes
-- (Valuation finiteness behind FiniteAdeleRing.algebraMap).
theorem adicOrder.finite_support (x : Set)
  requires member : x ∈ algebraCarrier(A)
  requires nonzero : x ≠ Ring.zero(Algebra.ring(A))
  shows Finite(adicSupport(A, x))
proof
  sorry

-- Section: Fractional ideals
-- coeIdeal is a fractional ideal contained in 1 (coeIdeal_le_one), and
-- every fractional ideal inside 1 is one (le_one_iff_exists_coeIdeal).
theorem coeIdeal.fractional (I : Set)
  requires ideal : Ideal(Algebra.base(A), I)
  shows FractionalIdeal(A, coeIdeal(A, I)) ∧ coeIdeal(A, I) ⊆ integerElements(A)
proof
  sorry

theorem FractionalIdeal.le_one_iff_exists_coeIdeal (I : Set)
  requires fractional : FractionalIdeal(A, I)
  shows I ⊆ integerElements(A) ↔ (∃ J, Ideal(Algebra.base(A), J) ∧ I = coeIdeal(A, J))
proof
  sorry

-- FractionalIdeal.coeIdeal_inj
theorem coeIdeal.injective (I J : Set)
  requires first : Ideal(Algebra.base(A), I)
  requires second : Ideal(Algebra.base(A), J)
  shows coeIdeal(A, I) = coeIdeal(A, J) ↔ I = J
proof
  sorry

-- FractionalIdeal.coeIdeal_mul, coeIdeal_pow
theorem coeIdeal.mul (I J : Set)
  requires first : Ideal(Algebra.base(A), I)
  requires second : Ideal(Algebra.base(A), J)
  shows coeIdeal(A, idealProduct(Algebra.base(A), I, J)) =
    fractionalIdealMul(A, coeIdeal(A, I), coeIdeal(A, J))
proof
  sorry

-- FractionalIdeal.coeIdeal_ne_zero
theorem coeIdeal.ne_zero (I : Set)
  requires ideal : Ideal(Algebra.base(A), I)
  shows coeIdeal(A, I) ≠ fractionalIdealZero(A) ↔ I ≠ {Ring.zero(Algebra.base(A))}
proof
  sorry

-- FractionalIdeal.coeIdeal_span_singleton
theorem coeIdeal.span_singleton (r : Set)
  requires member : r ∈ Ring.carrier(Algebra.base(A))
  shows coeIdeal(A, ringMultiples(Algebra.base(A), r)) =
    spanSingleton(A, Algebra.map(A)(r))
proof
  sorry

-- The fractional ideal spanned by one element (spanSingleton is
-- fractional), spanSingleton_mul_spanSingleton,
-- spanSingleton_eq_zero_iff, spanSingleton_le_iff_mem.
theorem spanSingleton.fractional (x : Set)
  requires member : x ∈ algebraCarrier(A)
  shows FractionalIdeal(A, spanSingleton(A, x))
proof
  sorry

theorem spanSingleton.mul (x y : Set)
  requires first : x ∈ algebraCarrier(A)
  requires second : y ∈ algebraCarrier(A)
  shows fractionalIdealMul(A, spanSingleton(A, x), spanSingleton(A, y)) =
    spanSingleton(A, call2(Ring.mul(Algebra.ring(A)), x, y))
proof
  sorry

theorem spanSingleton.eq_zero_iff (x : Set)
  requires member : x ∈ algebraCarrier(A)
  shows spanSingleton(A, x) = fractionalIdealZero(A) ↔ x = Ring.zero(Algebra.ring(A))
proof
  sorry

theorem spanSingleton.subset_iff_mem (I x : Set)
  requires fractional : FractionalIdeal(A, I)
  requires member : x ∈ algebraCarrier(A)
  shows spanSingleton(A, x) ⊆ I ↔ x ∈ I
proof
  sorry

-- FractionalIdeal.spanSingleton_eq_spanSingleton: equal exactly when the
-- generators differ by a unit of R.
theorem spanSingleton.eq_iff (x y : Set)
  requires first : x ∈ algebraCarrier(A)
  requires second : y ∈ algebraCarrier(A)
  shows spanSingleton(A, x) = spanSingleton(A, y) ↔
    (∃ u ∈ ringUnits(Algebra.base(A)),
      y = call2(Ring.mul(Algebra.ring(A)), Algebra.map(A)(u), x))
proof
  sorry

-- FractionalIdeal.mem_singleton_mul
theorem spanSingleton.mem_mul (I x z : Set)
  requires fractional : FractionalIdeal(A, I)
  requires member : x ∈ algebraCarrier(A)
  shows z ∈ fractionalIdealMul(A, spanSingleton(A, x), I) ↔
    (∃ y ∈ I, z = call2(Ring.mul(Algebra.ring(A)), x, y))
proof
  sorry

-- FractionalIdeal.mul is a fractional ideal.
theorem fractionalIdealMul.fractional (I J : Set)
  requires first : FractionalIdeal(A, I)
  requires second : FractionalIdeal(A, J)
  shows FractionalIdeal(A, fractionalIdealMul(A, I, J))
proof
  sorry

-- FractionalIdeal.mem_inv_iff
theorem fractionalIdealInv.mem_iff (I x : Set)
  requires fractional : I ∈ nonzeroFractionalIdeals(A)
  shows x ∈ fractionalIdealInv(A, I) ↔
    (x ∈ algebraCarrier(A) ∧ (∀ y ∈ I,
      call2(Ring.mul(Algebra.ring(A)), x, y) ∈ integerElements(A)))
proof
  sorry

-- FractionalIdeal.mul_inv_cancel: in a Dedekind domain every nonzero
-- fractional ideal is invertible.
theorem fractionalIdealInv.mul_cancel (I : Set)
  requires fractional : I ∈ nonzeroFractionalIdeals(A)
  shows fractionalIdealInv(A, I) ∈ nonzeroFractionalIdeals(A) ∧
    fractionalIdealMul(A, I, fractionalIdealInv(A, I)) = integerElements(A)
proof
  sorry

-- Section: Exponents of fractional ideals
-- FractionalIdeal.count_mul
theorem fractionalCount.mul (P I J : Set)
  requires prime : P ∈ heightOneSpectrum(Algebra.base(A))
  requires first : I ∈ nonzeroFractionalIdeals(A)
  requires second : J ∈ nonzeroFractionalIdeals(A)
  shows fractionalCount(A, P, fractionalIdealMul(A, I, J)) =
    call2(integerAdd, fractionalCount(A, P, I), fractionalCount(A, P, J))
proof
  sorry

-- FractionalIdeal.count_one
theorem fractionalCount.one (P : Set)
  requires prime : P ∈ heightOneSpectrum(Algebra.base(A))
  shows fractionalCount(A, P, integerElements(A)) = integerZero
proof
  sorry

-- FractionalIdeal.count_coe_nonneg, count of an ideal: the multiplicity.
theorem fractionalCount.coeIdeal (P J : Set)
  requires prime : P ∈ heightOneSpectrum(Algebra.base(A))
  requires ideal : Ideal(Algebra.base(A), J)
  requires nonzero : J ≠ {Ring.zero(Algebra.base(A))}
  shows fractionalCount(A, P, coeIdeal(A, J)) =
    integerOfNat(idealMultiplicity(Algebra.base(A), P, J))
proof
  sorry

-- FractionalIdeal.count_maximal, count_maximal_coprime
theorem fractionalCount.prime (P Q : Set)
  requires first : P ∈ heightOneSpectrum(Algebra.base(A))
  requires second : Q ∈ heightOneSpectrum(Algebra.base(A))
  shows (P = Q → fractionalCount(A, Q, coeIdeal(A, P)) = integerOne) ∧
    (P ≠ Q → fractionalCount(A, Q, coeIdeal(A, P)) = integerZero)
proof
  sorry

-- The count of a principal fractional ideal is the order
-- (FractionalIdeal.count_singleton with the valuation).
theorem fractionalCount.span_singleton (P x : Set)
  requires prime : P ∈ heightOneSpectrum(Algebra.base(A))
  requires member : x ∈ algebraCarrier(A)
  requires nonzero : x ≠ Ring.zero(Algebra.ring(A))
  shows fractionalCount(A, P, spanSingleton(A, x)) = adicOrder(A, P, x)
proof
  sorry

-- FractionalIdeal.finprod_heightOneSpectrum_factorization' (support):
-- finitely many exponents are nonzero.
theorem fractionalCount.finite_support (I : Set)
  requires fractional : I ∈ nonzeroFractionalIdeals(A)
  shows Finite(countSupport(A, I))
proof
  sorry

-- Unique factorisation of fractional ideals: two nonzero fractional
-- ideals with the same exponents are equal
-- (finprod_heightOneSpectrum_factorization').
theorem fractionalCount.ext (I J : Set)
  requires first : I ∈ nonzeroFractionalIdeals(A)
  requires second : J ∈ nonzeroFractionalIdeals(A)
  requires same : ∀ P ∈ heightOneSpectrum(Algebra.base(A)),
    fractionalCount(A, P, I) = fractionalCount(A, P, J)
  shows I = J
proof
  sorry

end FractionField

-- Section: The class group of a number field
section ClassGroup
variable (K : Set)
hypothesis field : Field(K)
hypothesis numberField : NumberField(K)

-- ClassGroup.fintypeOfAdmissibleOfFinite: the class group is finite.
theorem classGroup.finite
  shows Finite(classGroupCarrier(ringOfIntegersInclusion(K)))
proof
  sorry

-- NumberField.classNumber_pos, classNumber_ne_zero
theorem classNumber.pos
  shows classNumber(K) ∈ ℕ ∧ classNumber(K) ≠ 0
proof
  sorry

-- ClassGroup.mk0_eq_one_iff: a class is trivial exactly when the ideal is
-- principal.
theorem classGroup.eq_one_iff (I : Set)
  requires fractional : I ∈ nonzeroFractionalIdeals(ringOfIntegersInclusion(K))
  shows ⟦I⟧[nonzeroFractionalIdeals(ringOfIntegersInclusion(K)),
      idealClassRelation(ringOfIntegersInclusion(K))] =
    ⟦integerElements(ringOfIntegersInclusion(K))⟧[
      nonzeroFractionalIdeals(ringOfIntegersInclusion(K)),
      idealClassRelation(ringOfIntegersInclusion(K))] ↔
    (∃ x ∈ Ring.carrier(K), I = spanSingleton(ringOfIntegersInclusion(K), x))
proof
  sorry

-- NumberField.classNumber_eq_one_iff (isPrincipalIdealRing_iff): class
-- number one exactly for principal ideal domains.
theorem classNumber.eq_one_iff
  shows classNumber(K) = 1 ↔ PrincipalIdealDomain(ringOfIntegersRing(K))
proof
  sorry

-- Section: The absolute norm of ideals of 𝓞 K
-- map_mul for Ideal.absNorm
theorem absNorm.mul (I J : Set)
  requires first : Ideal(ringOfIntegersRing(K), I)
  requires second : Ideal(ringOfIntegersRing(K), J)
  shows absNorm(K, idealProduct(ringOfIntegersRing(K), I, J)) =
    mul(absNorm(K, I), absNorm(K, J))
proof
  sorry

-- Ideal.absNorm_eq_zero_iff, absNorm_pos_of_nonZeroDivisors
theorem absNorm.eq_zero_iff (I : Set)
  requires ideal : Ideal(ringOfIntegersRing(K), I)
  shows absNorm(K, I) = 0 ↔ I = {Ring.zero(K)}
proof
  sorry

-- Ideal.absNorm_eq_one_iff
theorem absNorm.eq_one_iff (I : Set)
  requires ideal : Ideal(ringOfIntegersRing(K), I)
  shows absNorm(K, I) = 1 ↔ I = ringOfIntegers(K)
proof
  sorry

-- Ideal.absNorm_mem, span_singleton_absNorm_le: N(I) ∈ I.
theorem absNorm.mem (I : Set)
  requires ideal : Ideal(ringOfIntegersRing(K), I)
  shows natCast(K, absNorm(K, I)) ∈ I
proof
  sorry

-- Ideal.absNorm_span_singleton: N(x 𝓞 K) = |N_{K/ℚ}(x)|.
theorem absNorm.span_singleton (x : Set)
  requires member : x ∈ ringOfIntegers(K)
  shows integerNorm(K, x) = integerOfNat(absNorm(K, ringMultiples(ringOfIntegersRing(K), x))) ∨
    integerNorm(K, x) =
      integerNeg(integerOfNat(absNorm(K, ringMultiples(ringOfIntegersRing(K), x))))
proof
  sorry

-- Ideal.absNorm_dvd_norm_of_mem
theorem absNorm.dvd_norm_of_mem (I x : Set)
  requires ideal : Ideal(ringOfIntegersRing(K), I)
  requires member : x ∈ I
  shows ∃ z ∈ ℤ, integerNorm(K, x) = call2(integerMul, integerOfNat(absNorm(K, I)), z)
proof
  sorry

-- Ideal.absNorm_span_natCast: N(n 𝓞 K) = n^[K : ℚ].
theorem absNorm.span_natCast (n : Nat)
  shows absNorm(K, ringMultiples(ringOfIntegersRing(K), natCast(K, n))) =
    n ^ numberFieldDegree(K)
proof
  sorry

-- Ideal.finite_setOfPred_absNorm_eq: finitely many ideals of a given
-- nonzero norm.
theorem absNorm.finite_of_eq (n : Nat)
  requires nonzero : n ≠ 0
  shows Finite(idealsOfNorm(K, n))
proof
  sorry

-- NumberField.HeightOneSpectrum.one_lt_absNorm
theorem absNorm.prime_gt_one (P : Set)
  requires prime : P ∈ heightOneSpectrum(ringOfIntegersRing(K))
  shows absNorm(K, P) ≠ 0 ∧ absNorm(K, P) ≠ 1
proof
  sorry

-- Ideal.absNorm_pow_inertiaDeg, Nat.absNorm_under_prime: a prime P over
-- the rational prime p has norm p^f, f the inertia degree.
theorem absNorm.prime_eq_pow (P : Set) (p : Nat)
  requires prime : P ∈ heightOneSpectrum(ringOfIntegersRing(K))
  requires rational : Prime(p)
  requires over : natCast(K, p) ∈ P
  shows absNorm(K, P) = p ^ (inertiaDegree(intCastMap(ringOfIntegersRing(K)),
    integerRing, ringOfIntegersRing(K), integerPrimeIdeal(p), P):N)
proof
  sorry

-- Ideal.exists_isMaximal_dvd_of_dvd_absNorm: a rational prime dividing
-- N(I) lies under a prime factor of I.
theorem absNorm.exists_prime_of_dvd (I : Set) (p : Nat)
  requires ideal : Ideal(ringOfIntegersRing(K), I)
  requires rational : Prime(p)
  requires divides : ∃ m ∈ ℕ, absNorm(K, I) = mul(p, m)
  shows ∃ P ∈ heightOneSpectrum(ringOfIntegersRing(K)), I ⊆ P ∧ natCast(K, p) ∈ P
proof
  sorry

-- Ideal.irreducible_of_irreducible_absNorm: an ideal of prime norm is
-- prime.
theorem absNorm.prime_of_prime (I : Set) (p : Nat)
  requires ideal : Ideal(ringOfIntegersRing(K), I)
  requires rational : Prime(p)
  requires norm : absNorm(K, I) = p
  shows I ∈ heightOneSpectrum(ringOfIntegersRing(K))
proof
  sorry

-- FractionalIdeal.absNorm is multiplicative (map_mul).
theorem fractionalAbsNorm.mul (I J : Set)
  requires first : I ∈ nonzeroFractionalIdeals(ringOfIntegersInclusion(K))
  requires second : J ∈ nonzeroFractionalIdeals(ringOfIntegersInclusion(K))
  shows fractionalAbsNorm(K, fractionalIdealMul(ringOfIntegersInclusion(K), I, J)) =
    rationalMul((fractionalAbsNorm(K, I), fractionalAbsNorm(K, J)))
proof
  sorry

-- FractionalIdeal.coeIdeal_absNorm
theorem fractionalAbsNorm.coeIdeal (I : Set)
  requires ideal : Ideal(ringOfIntegersRing(K), I)
  requires nonzero : I ≠ {Ring.zero(K)}
  shows fractionalAbsNorm(K, coeIdeal(ringOfIntegersInclusion(K), I)) =
    natCast(rationalRing, absNorm(K, I))
proof
  sorry

-- FractionalIdeal.absNorm_span_singleton: |N_{K/ℚ}(x)|.
theorem fractionalAbsNorm.span_singleton (x : Set)
  requires member : x ∈ Ring.carrier(K)
  requires nonzero : x ≠ Ring.zero(K)
  shows fractionalAbsNorm(K, spanSingleton(ringOfIntegersInclusion(K), x)) = fieldNorm(K, x) ∨
    fractionalAbsNorm(K, spanSingleton(ringOfIntegersInclusion(K), x)) =
      rationalNeg(fieldNorm(K, x))
proof
  sorry

end ClassGroup

-- Rat.classNumber_eq
theorem classNumber.rationals
  shows classNumber(rationalRing) = 1
proof
  sorry

-- Section: Primes over primes in an extension of number fields
section Extension
variable (K L f : Set)
hypothesis sourceField : Field(K)
hypothesis targetField : Field(L)
hypothesis source : NumberField(K)
hypothesis target : NumberField(L)
hypothesis hom : RingHom(f, K, L)

-- Ideal.liesOver_iff_dvd_map: P lies over p exactly when P divides p 𝓞 L.
theorem LiesOver.iff_subset (p P : Set)
  requires below : p ∈ heightOneSpectrum(ringOfIntegersRing(K))
  requires above : P ∈ heightOneSpectrum(ringOfIntegersRing(L))
  shows LiesOver(ringOfIntegersMap(f, K), ringOfIntegersRing(K), P, p) ↔
    idealExtension(ringOfIntegersMap(f, K), ringOfIntegersRing(L), p) ⊆ P
proof
  sorry

-- Finitely many primes lie over p, and at least one
-- (IsDedekindDomain.primesOverFinset, Ideal.exists_ideal_liesOver).
theorem primesOver.finite_nonempty (p : Set)
  requires below : p ∈ heightOneSpectrum(ringOfIntegersRing(K))
  shows Finite(primesOver(ringOfIntegersMap(f, K), ringOfIntegersRing(K),
      ringOfIntegersRing(L), p)) ∧
    primesOver(ringOfIntegersMap(f, K), ringOfIntegersRing(K),
      ringOfIntegersRing(L), p) ≠ ∅
proof
  sorry

-- The ramification index and inertia degree are positive at primes over p
-- (Ideal.IsDedekindDomain.ramificationIdx_ne_zero, inertiaDeg_pos).
theorem ramificationIndex.pos (p P : Set)
  requires below : p ∈ heightOneSpectrum(ringOfIntegersRing(K))
  requires above : P ∈ primesOver(ringOfIntegersMap(f, K), ringOfIntegersRing(K),
    ringOfIntegersRing(L), p)
  shows ramificationIndex(ringOfIntegersMap(f, K), ringOfIntegersRing(L), p, P) ≠ 0 ∧
    inertiaDegree(ringOfIntegersMap(f, K), ringOfIntegersRing(K),
      ringOfIntegersRing(L), p, P) ≠ 0
proof
  sorry

-- HeightOneSpectrum.valuation_liesOver: ord_P(f(x)) = e(P | p) ord_p(x).
theorem adicOrder.lies_over (p P x : Set)
  requires below : p ∈ heightOneSpectrum(ringOfIntegersRing(K))
  requires above : P ∈ primesOver(ringOfIntegersMap(f, K), ringOfIntegersRing(K),
    ringOfIntegersRing(L), p)
  requires member : x ∈ Ring.carrier(K)
  requires nonzero : x ≠ Ring.zero(K)
  shows adicOrder(ringOfIntegersInclusion(L), P, f(x)) =
    call2(integerMul,
      integerOfNat(ramificationIndex(ringOfIntegersMap(f, K), ringOfIntegersRing(L), p, P)),
      adicOrder(ringOfIntegersInclusion(K), p, x))
proof
  sorry

-- Ideal.absNorm of an extended ideal: N(p 𝓞 L) = N(p)^[L : K]
-- (Ideal.absNorm_map / relNorm of the extension).
theorem absNorm.extension (p : Set)
  requires ideal : Ideal(ringOfIntegersRing(K), p)
  shows absNorm(L, idealExtension(ringOfIntegersMap(f, K), ringOfIntegersRing(L), p)) =
    (absNorm(K, p):N) ^ (finrank(algebraModule(Algebra.mk(K, L, f)), K):N)
proof
  sorry

-- Ideal.sum_ramification_inertia: Σ_{P | p} e(P | p) f(P | p) = [L : K],
-- in ℤ over the finite set of primes over p.
theorem primesOver.sum_ramification_inertia (p : Set)
  requires below : p ∈ heightOneSpectrum(ringOfIntegersRing(K))
  shows finiteRingSum(primesOver(ringOfIntegersMap(f, K), ringOfIntegersRing(K),
      ringOfIntegersRing(L), p), ℤ, integerAdd, integerZero, integerNeg,
      integerMul, integerOne, ramificationInertiaFamily(f, K, L, p)) =
    integerOfNat(finrank(algebraModule(Algebra.mk(K, L, f)), K))
proof
  sorry

end Extension
