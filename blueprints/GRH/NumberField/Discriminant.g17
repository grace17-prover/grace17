-- Discriminants and differents: the trace matrix and discriminant of a
-- family (Algebra.traceMatrix, Algebra.discr), the discriminant d_K of a
-- number field (NumberField.discr) and the root discriminant |d_K|^{1/n}
-- (NumberField.rootDiscr), the trace dual and the different ideal of an
-- extension of number fields (Submodule.traceDual, differentIdeal), its
-- relation to ramification, to the discriminant (N 𝔇_K = |d_K|, the tower
-- formula |d_L| = N 𝔇_{L/K} |d_K|^{[L:K]}), and to monogenic orders.
-- Part of the GRH blueprint.
-- Planned home: NumberTheory/NumberField/Discriminant, NumberTheory/Different.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.NumberField.Discriminant
import GRH.NumberField.Dedekind
import GRH.Log
import Grace.Cumulus.Real.Field

-- Section: Discriminants
-- The trace matrix (Tr(b(i) b(j)))_{i, j} of a family b over I
-- (Algebra.traceMatrix) and its determinant (Algebra.discr).
def traceMatrix (A I b : Set) : Set :=
  { q ∈ (I × I) × Ring.carrier(Algebra.base(A)) | ∃ i ∈ I, ∃ j ∈ I,
    q = ((i, j), algebraTrace(A, call2(Ring.mul(Algebra.ring(A)), b(i), b(j)))) }

def algebraDiscr (A I b : Set) : Set := matDet(Algebra.base(A), I, traceMatrix(A, I, b))

-- The discriminant of K: the discriminant of a ℤ-basis of 𝓞 K, the same
-- for every basis (NumberField.discr K = Algebra.discr ℤ (integralBasis K)).
defunique numberFieldDiscr (K : Set) (d ∈ ℤ) :=
  ∃ I, ∃ b, Finite(I) ∧ ModuleBasis(ringOfIntegersModule(K), integerRing, I, b) ∧
    d = algebraDiscr(ringOfIntegersAlgebra(K), I, b)
requires numberField : NumberField(K)
proof
  sorry
uniqueness
  sorry

-- |d_K| as a natural number (Int.natAbs (discr K)).
def discrMagnitude (K : Set) : Set := integerMagnitude(numberFieldDiscr(K))

-- The root discriminant |d_K|^{1/[K : ℚ]} (NumberField.rootDiscr).
def rootDiscr (K : Set) : Set :=
  realRpow(natCast(realRing, discrMagnitude(K)),
    realInv(natCast(realRing, numberFieldDegree(K))))

-- Section: The different
-- The trace dual of a subset I of L over 𝓞 K: the x with Tr_{L/K}(x y)
-- ∈ 𝓞 K for every y ∈ I (Submodule.traceDual (𝓞 K) K I,
-- FractionalIdeal.dual).
def traceDual (f K L I : Set) : Set :=
  { x ∈ Ring.carrier(L) | ∀ y ∈ I,
    algebraTrace(Algebra.mk(K, L, f), call2(Ring.mul(L), x, y)) ∈ ringOfIntegers(K) }

-- The different of L over K: the inverse of the trace dual of 𝓞 L, an
-- ideal of 𝓞 L (differentIdeal (𝓞 K) (𝓞 L), coeIdeal_differentIdeal).
def differentIdeal (f K L : Set) : Set :=
  { x ∈ ringOfIntegers(L) | ∀ y ∈ traceDual(f, K, L, ringOfIntegers(L)),
    call2(Ring.mul(L), x, y) ∈ ringOfIntegers(L) }

-- The absolute different 𝔇_K = 𝔇_{K/ℚ} (differentIdeal ℤ (𝓞 K)); the
-- integers of ℚ are the image of ℤ, so the two traces duals agree.
def absoluteDifferent (K : Set) : Set := differentIdeal(ratCastMap(K), rationalRing, K)

-- The trace matrix of a family in a finite free algebra is a square
-- matrix over the base (Algebra.traceMatrix), so the discriminant lies in
-- the base.
theorem traceMatrix.mem (A I b : Set)
  requires free : FiniteFreeAlgebra(A)
  requires finite : Finite(I)
  requires family : b : I → algebraCarrier(A)
  shows traceMatrix(A, I, b) ∈ matrixSpace(Algebra.base(A), I, I) ∧
    algebraDiscr(A, I, b) ∈ Ring.carrier(Algebra.base(A))
proof
  sorry

-- Section: The discriminant of a number field
section Discriminant
variable (K : Set)
hypothesis field : Field(K)
hypothesis numberField : NumberField(K)

-- Algebra.discr_eq_discr: every ℤ-basis of 𝓞 K gives d_K.
theorem numberFieldDiscr.of_basis (I b : Set)
  requires finite : Finite(I)
  requires basis : ModuleBasis(ringOfIntegersModule(K), integerRing, I, b)
  shows numberFieldDiscr(K) = algebraDiscr(ringOfIntegersAlgebra(K), I, b)
proof
  sorry

-- NumberField.coe_discr: over ℚ the same basis gives d_K, cast to ℚ.
theorem numberFieldDiscr.rational (I b : Set)
  requires finite : Finite(I)
  requires basis : ModuleBasis(ringOfIntegersModule(K), integerRing, I, b)
  shows algebraDiscr(rationalAlgebra(K), I, b) =
    intCastMap(rationalRing)(numberFieldDiscr(K))
proof
  sorry

-- NumberField.discr_ne_zero
theorem numberFieldDiscr.ne_zero
  shows numberFieldDiscr(K) ≠ integerZero
proof
  sorry

-- Algebra.discr_eq_discr_of_toMatrix_coeff_isIntegral (and
-- discr_mul_isIntegral_mem_adjoin): the discriminant of a ℚ-basis of K of
-- algebraic integers is d_K times a square.
theorem numberFieldDiscr.dvd_of_integral (I b : Set)
  requires finite : Finite(I)
  requires basis : ModuleBasis(rationalModule(K), rationalRing, I, b)
  requires integral : ∀ i ∈ I, b(i) ∈ ringOfIntegers(K)
  shows ∃ z ∈ ℤ, z ≠ integerZero ∧ algebraDiscr(rationalAlgebra(K), I, b) =
    intCastMap(rationalRing)(call2(integerMul, numberFieldDiscr(K),
      call2(integerMul, z, z)))
proof
  sorry

-- The root discriminant is a real number at least 1.
theorem rootDiscr.ge_one
  shows rootDiscr(K) ∈ ℝ ∧ (1:R) ≤ (rootDiscr(K):R)
proof
  sorry

-- The defining identity rootDiscr^{[K : ℚ]} = |d_K| (NumberField.rootDiscr_def).
theorem rootDiscr.pow_degree
  shows realRpow(rootDiscr(K), natCast(realRing, numberFieldDegree(K))) =
    natCast(realRing, discrMagnitude(K))
proof
  sorry

-- Section: The absolute different
-- differentIdeal is an ideal of 𝓞 K.
theorem absoluteDifferent.ideal
  shows Ideal(ringOfIntegersRing(K), absoluteDifferent(K))
proof
  sorry

-- NumberField.absNorm_differentIdeal: N(𝔇_K) = |d_K|.
theorem absoluteDifferent.absNorm
  shows absNorm(K, absoluteDifferent(K)) = discrMagnitude(K)
proof
  sorry

-- NumberField.discr_mem_differentIdeal
theorem absoluteDifferent.discr_mem
  shows intCastMap(K)(numberFieldDiscr(K)) ∈ absoluteDifferent(K)
proof
  sorry

-- Dedekind's discriminant theorem: a rational prime p ramifies in K
-- exactly when it divides d_K (from not_dvd_differentIdeal_iff and
-- absNorm_differentIdeal).
theorem numberFieldDiscr.ramified_iff (p : Nat)
  requires rational : Prime(p)
  shows (∃ P ∈ heightOneSpectrum(ringOfIntegersRing(K)), natCast(K, p) ∈ P ∧
      ramificationIndex(intCastMap(ringOfIntegersRing(K)), ringOfIntegersRing(K),
        integerPrimeIdeal(p), P) ≠ 1) ↔
    (∃ m ∈ ℕ, discrMagnitude(K) = mul(p, m))
proof
  sorry

end Discriminant

-- Rat.discr, NumberField.discr_rat: d_ℚ = 1.
theorem numberFieldDiscr.rationals
  shows numberFieldDiscr(rationalRing) = integerOne
proof
  sorry

-- Section: The relative different
section Different
variable (K L f : Set)
hypothesis sourceField : Field(K)
hypothesis targetField : Field(L)
hypothesis source : NumberField(K)
hypothesis target : NumberField(L)
hypothesis hom : RingHom(f, K, L)

-- Submodule.mem_traceDual
theorem traceDual.mem_iff (I x : Set)
  shows x ∈ traceDual(f, K, L, I) ↔ (x ∈ Ring.carrier(L) ∧ (∀ y ∈ I,
    algebraTrace(Algebra.mk(K, L, f), call2(Ring.mul(L), x, y)) ∈ ringOfIntegers(K)))
proof
  sorry

-- FractionalIdeal.one_le_dual_one, dual_ne_zero: the dual of 𝓞 L is a
-- nonzero fractional ideal containing 𝓞 L.
theorem traceDual.fractional
  shows ringOfIntegers(L) ⊆ traceDual(f, K, L, ringOfIntegers(L)) ∧
    traceDual(f, K, L, ringOfIntegers(L)) ∈
      nonzeroFractionalIdeals(ringOfIntegersInclusion(L))
proof
  sorry

-- differentIdeal is an ideal of 𝓞 L, and differentIdeal_ne_bot.
theorem differentIdeal.ideal
  shows Ideal(ringOfIntegersRing(L), differentIdeal(f, K, L)) ∧
    differentIdeal(f, K, L) ≠ {Ring.zero(L)}
proof
  sorry

-- coeIdeal_differentIdeal: 𝔇 is the inverse of the dual of 𝓞 L.
theorem differentIdeal.coe_eq_inv_dual
  shows coeIdeal(ringOfIntegersInclusion(L), differentIdeal(f, K, L)) =
    fractionalIdealInv(ringOfIntegersInclusion(L), traceDual(f, K, L, ringOfIntegers(L)))
proof
  sorry

-- not_dvd_differentIdeal_iff: P divides the different exactly when it is
-- ramified over K (residue fields are finite, hence separable).
theorem differentIdeal.not_dvd_iff (p P : Set)
  requires below : p ∈ heightOneSpectrum(ringOfIntegersRing(K))
  requires above : P ∈ primesOver(ringOfIntegersMap(f, K), ringOfIntegersRing(K),
    ringOfIntegersRing(L), p)
  shows ¬(differentIdeal(f, K, L) ⊆ P) ↔
    ramificationIndex(ringOfIntegersMap(f, K), ringOfIntegersRing(L), p, P) = 1
proof
  sorry

-- pow_sub_one_dvd_differentIdeal: P^{e − 1} divides 𝔇, i.e.
-- e ≤ ord_P(𝔇) + 1.
theorem differentIdeal.pow_sub_one_dvd (p P : Set)
  requires below : p ∈ heightOneSpectrum(ringOfIntegersRing(K))
  requires above : P ∈ primesOver(ringOfIntegersMap(f, K), ringOfIntegersRing(K),
    ringOfIntegersRing(L), p)
  shows (ramificationIndex(ringOfIntegersMap(f, K), ringOfIntegersRing(L), p, P):N) ≤
    succ(idealMultiplicity(ringOfIntegersRing(L), P, differentIdeal(f, K, L)))
proof
  sorry

-- NumberField.natAbs_discr_eq_absNorm_differentIdeal_mul_natAbs_discr_pow:
-- |d_L| = N(𝔇_{L/K}) |d_K|^{[L : K]}.
theorem discrMagnitude.tower
  shows discrMagnitude(L) = mul(absNorm(L, differentIdeal(f, K, L)),
    (discrMagnitude(K):N) ^ (finrank(algebraModule(Algebra.mk(K, L, f)), K):N))
proof
  sorry

-- The root discriminant does not decrease up a tower, and is unchanged
-- when L/K is unramified at every prime (𝔇_{L/K} = 𝓞 L).
theorem rootDiscr.tower
  shows (rootDiscr(K):R) ≤ (rootDiscr(L):R) ∧
    (differentIdeal(f, K, L) = ringOfIntegers(L) → rootDiscr(L) = rootDiscr(K))
proof
  sorry

-- differentIdeal_eq_differentIdeal_mul_differentIdeal: in a tower
-- K → L → M, 𝔇_{M/K} = 𝔇_{M/L} · 𝔇_{L/K} 𝓞 M.
theorem differentIdeal.tower (M g : Set)
  requires topField : Field(M)
  requires top : NumberField(M)
  requires upper : RingHom(g, L, M)
  shows differentIdeal(compose(g, f, Ring.carrier(K), Ring.carrier(L), Ring.carrier(M)),
      K, M) =
    idealProduct(ringOfIntegersRing(M), differentIdeal(g, L, M),
      idealExtension(ringOfIntegersMap(g, L), ringOfIntegersRing(M),
        differentIdeal(f, K, L)))
proof
  sorry

-- conductor_mul_differentIdeal for a monogenic extension (conductor 1):
-- if 𝓞 L = 𝓞 K[α] and p is a monic polynomial over 𝓞 K of degree [L : K]
-- with p(α) = 0, then 𝔇_{L/K} = (p'(α)).
theorem differentIdeal.monogenic (α p : Set)
  requires generated : adjoinOf(ringOfIntegersExtension(f, K, L), {α}) = ringOfIntegers(L)
  requires monic : PolyMonic(ringOfIntegersRing(K), p)
  requires degree : polyNatDegree(ringOfIntegersRing(K), p) =
    finrank(algebraModule(Algebra.mk(K, L, f)), K)
  requires root : polyAeval(ringOfIntegersExtension(f, K, L), α, p) = Ring.zero(L)
  shows differentIdeal(f, K, L) = ringMultiples(ringOfIntegersRing(L),
    polyAeval(ringOfIntegersExtension(f, K, L), α,
      polyDerivative(ringOfIntegersRing(K))(p)))
proof
  sorry

end Different
