-- Discriminants and differents: the trace matrix and discriminant of a
-- family (Algebra.traceMatrix, Algebra.discr), the discriminant d_K of a
-- number field (NumberField.discr) and the root discriminant |d_K|^{1/n}
-- (NumberField.rootDiscr), the trace dual and the different ideal of an
-- extension of number fields (Submodule.traceDual, differentIdeal), its
-- relation to ramification, to the discriminant (N 𝔇_K = |d_K|, the tower
-- formula |d_L| = N 𝔇_{L/K} |d_K|^{[L:K]}), and to monogenic orders.
-- Part of the GRH blueprint.
-- Planned home: NumberTheory/NumberField/Discriminant, NumberTheory/Different.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.NumberField.Discriminant
import GRH.NumberField.Dedekind
import GRH.Log
import Grace.Cumulus.Real.Field

-- Section: Discriminants
-- The trace matrix (Tr(b(i) b(j)))_{i, j} of a family b over I
-- (Algebra.traceMatrix) and its determinant (Algebra.discr).
def traceMatrix (A I b : Set) : Set :=
  { q ∈ (I × I) × Ring.carrier(Algebra.base(A)) | ∃ i ∈ I, ∃ j ∈ I,
    q = ((i, j), algebraTrace(A, call2(Ring.mul(Algebra.ring(A)), b(i), b(j)))) }

def algebraDiscr (A I b : Set) : Set := matDet(Algebra.base(A), I, traceMatrix(A, I, b))

-- The discriminant of K: the discriminant of a ℤ-basis of 𝓞 K, the same
-- for every basis (NumberField.discr K = Algebra.discr ℤ (integralBasis K)).
defunique numberFieldDiscr (K : Set) (d ∈ ℤ) :=
  ∃ I, ∃ b, Finite(I) ∧ ModuleBasis(ringOfIntegersModule(K), integerRing, I, b) ∧
    d = algebraDiscr(ringOfIntegersAlgebra(K), I, b)
requires numberField : NumberField(K)
proof
  sorry
uniqueness
  sorry

-- |d_K| as a natural number (Int.natAbs (discr K)).
def discrMagnitude (K : Set) : Set := integerMagnitude(numberFieldDiscr(K))

-- The root discriminant |d_K|^{1/[K : ℚ]} (NumberField.rootDiscr).
def rootDiscr (K : Set) : Set :=
  realRpow(natCast(realRing, discrMagnitude(K)),
    realInv(natCast(realRing, numberFieldDegree(K))))

-- Section: The different
-- The trace dual of a subset I of L over 𝓞 K: the x with Tr_{L/K}(x y)
-- ∈ 𝓞 K for every y ∈ I (Submodule.traceDual (𝓞 K) K I,
-- FractionalIdeal.dual).
def traceDual (f K L I : Set) : Set :=
  { x ∈ Ring.carrier(L) | ∀ y ∈ I,
    algebraTrace(Algebra.mk(K, L, f), call2(Ring.mul(L), x, y)) ∈ ringOfIntegers(K) }

-- The different of L over K: the inverse of the trace dual of 𝓞 L, an
-- ideal of 𝓞 L (differentIdeal (𝓞 K) (𝓞 L), coeIdeal_differentIdeal).
def differentIdeal (f K L : Set) : Set :=
  { x ∈ ringOfIntegers(L) | ∀ y ∈ traceDual(f, K, L, ringOfIntegers(L)),
    call2(Ring.mul(L), x, y) ∈ ringOfIntegers(L) }

-- The absolute different 𝔇_K = 𝔇_{K/ℚ} (differentIdeal ℤ (𝓞 K)); the
-- integers of ℚ are the image of ℤ, so the two traces duals agree.
def absoluteDifferent (K : Set) : Set := differentIdeal(ratCastMap(K), rationalRing, K)

-- The trace matrix is a function on I × I into the base, given its entries.
theorem tkF.traceMatrix.function (A I b : Set)
  requires values : ∀ i ∈ I, ∀ j ∈ I, algebraTrace(A,
    call2(Ring.mul(Algebra.ring(A)), b(i), b(j))) ∈ Ring.carrier(Algebra.base(A))
  shows traceMatrix(A, I, b) : I × I → Ring.carrier(Algebra.base(A))
proof
  constructor
    intros q0 member
    obtain ⟨bounded, witnesses⟩ := traceMatrix.membership.forward with member
    exact bounded
  . constructor
      intros z0 first xFirst second xSecond
      unfold relates at xFirst
      obtain ⟨_, a1, a1In, b1, b1In, firstShape⟩ := traceMatrix.membership.forward with xFirst
      unfold relates at xSecond
      obtain ⟨_, a2, a2In, b2, b2In, secondShape⟩ := traceMatrix.membership.forward with xSecond
      obtain ⟨xi, firstEqual⟩ := orderedPair.injective with firstShape
      obtain ⟨xj, secondEqual⟩ := orderedPair.injective with secondShape
      rw xi at xj
      obtain ⟨aa, bb⟩ := orderedPair.injective with xj
      rw [firstEqual, secondEqual]
      cc
    . intros q0 pIn
      obtain ⟨bound, i, rowIn, j, colIn, shape⟩ := product.membership.forward with pIn
      have valueIn := values with i, rowIn, j, colIn
      have pairIn := product.pair at i, j, I, I with rowIn, colIn
      have outer := product.pair at (i, j), algebraTrace(A, call2(Ring.mul(Algebra.ring(A)), b(i), b(j))), I × I, Ring.carrier(Algebra.base(A)) with pairIn, valueIn
      have mapped : relates(traceMatrix(A, I, b), (i, j), algebraTrace(A, call2(Ring.mul(Algebra.ring(A)), b(i), b(j))))
        unfold relates
        apply traceMatrix.membership.backward
        exact ⟨outer, i, rowIn, j, colIn, rfl⟩
      rw shape
      exact ⟨algebraTrace(A, call2(Ring.mul(Algebra.ring(A)), b(i), b(j))), valueIn, mapped⟩

-- The trace matrix of a family in a finite free algebra is a square
-- matrix over the base (Algebra.traceMatrix), so the discriminant lies in
-- the base.
theorem traceMatrix.mem (A I b : Set)
  requires free : FiniteFreeAlgebra(A)
  requires finite : Finite(I)
  requires family : b : I → algebraCarrier(A)
  shows traceMatrix(A, I, b) ∈ matrixSpace(Algebra.base(A), I, I) ∧
    algebraDiscr(A, I, b) ∈ Ring.carrier(Algebra.base(A))
proof
  have free0 := free
  obtain ⟨alg, _⟩ := free0
  have bc := Algebra.base_comm_ring with alg
  have values : ∀ i ∈ I, ∀ j ∈ I, algebraTrace(A, call2(Ring.mul(Algebra.ring(A)), b(i), b(j))) ∈ Ring.carrier(Algebra.base(A))
    intros i hi j hj
    have bi := FunctionBetween.apply_closed at b, I, algebraCarrier(A), i with family, hi
    have bj := FunctionBetween.apply_closed at b, I, algebraCarrier(A), j with family, hj
    unfold algebraCarrier at bi
    unfold algebraCarrier at bj
    have pr : call2(Ring.mul(Algebra.ring(A)), b(i), b(j)) ∈ algebraCarrier(A)
      unfold algebraCarrier
      typecheck
    exact algebraTrace.mem at A, call2(Ring.mul(Algebra.ring(A)), b(i), b(j)) with free, pr
  have fn := tkF.traceMatrix.function at A, I, b with values
  have mat := matrixSpace.of_function at Algebra.base(A), I, I, traceMatrix(A, I, b) with fn
  have det := matDet.mem at Algebra.base(A), I, traceMatrix(A, I, b) with bc, finite, mat
  unfold algebraDiscr
  exact ⟨mat, det⟩


-- The natural number n in the real field is realNat(n).
theorem tkF.natCast.real (n : Nat)
  shows natCast(realRing, n) = realNat(n)
proof
  induction n
  | zero =>
    have d : natCast(realRing, 0) = ringNat(Ring.add(realRing), Ring.zero(realRing), Ring.one(realRing), 0) by unfold natCast; rfl
    rw [d, ringNat.zero, realNat.zero]
    simp [realRing, Ring.mk.zero]
  | succ(k) using ih =>
    have d : natCast(realRing, succ(k)) = ringNat(Ring.add(realRing), Ring.zero(realRing), Ring.one(realRing), succ(k)) by unfold natCast; rfl
    have s := ringNat.succ at Ring.add(realRing), Ring.zero(realRing), Ring.one(realRing), k
    have d2 : ringNat(Ring.add(realRing), Ring.zero(realRing), Ring.one(realRing), k) = natCast(realRing, k) by unfold natCast; rfl
    rw [d, s, d2, ih, realNat.succ]
    have kR := realNat.real at k
    have a : Ring.add(realRing) = realAdd by simp [realRing, Ring.mk.add]
    have o : Ring.one(realRing) = realOne by simp [realRing, Ring.mk.one]
    rw [a, o]
    unfold realAddValue
    unfold call2
    rfl


-- Section: The discriminant of a number field
section Discriminant
variable (K : Set)
hypothesis field : Field(K)
hypothesis numberField : NumberField(K)

-- Algebra.discr_eq_discr: every ℤ-basis of 𝓞 K gives d_K.
theorem numberFieldDiscr.of_basis (I b : Set)
  requires finite : Finite(I)
  requires basis : ModuleBasis(ringOfIntegersModule(K), integerRing, I, b)
  shows numberFieldDiscr(K) = algebraDiscr(ringOfIntegersAlgebra(K), I, b)
proof
  have nf := NumberField.finite_free at K with numberField
  have ff := nf.right
  have b0 := basis
  obtain ⟨li, _⟩ := b0
  obtain ⟨_, fam, _⟩ := li
  have mc : Module.carrier(ringOfIntegersModule(K)) = algebraCarrier(ringOfIntegersAlgebra(K)) by simp [ringOfIntegersModule, algebraModule, Module.mk.carrier]
  rw mc at fam
  have tm := traceMatrix.mem at ringOfIntegersAlgebra(K), I, b with ff, finite, fam
  have bc : Ring.carrier(Algebra.base(ringOfIntegersAlgebra(K))) = ℤ by simp [ringOfIntegersAlgebra, integerAlgebra, Algebra.mk.base, integerRing, Ring.mk.carrier]
  have dIn := tm.right
  rw bc at dIn
  have sel := numberFieldDiscr.selected at K with numberField
  obtain ⟨selIn, selP⟩ := sel
  have pb : ∃ J, ∃ c, Finite(J) ∧ ModuleBasis(ringOfIntegersModule(K), integerRing, J, c) ∧ algebraDiscr(ringOfIntegersAlgebra(K), I, b) = algebraDiscr(ringOfIntegersAlgebra(K), J, c)
    exact ⟨I, b, finite, basis, rfl⟩
  have u1 := numberFieldDiscr.unique at K with numberField
  have u2 := u1 with selIn
  have u3 := u2 with selP
  have u4 := u3 with dIn
  exact u4 with pb


-- NumberField.coe_discr: over ℚ the same basis gives d_K, cast to ℚ.
theorem numberFieldDiscr.rational (I b : Set)
  requires finite : Finite(I)
  requires basis : ModuleBasis(ringOfIntegersModule(K), integerRing, I, b)
  shows algebraDiscr(rationalAlgebra(K), I, b) =
    intCastMap(rationalRing)(numberFieldDiscr(K))
proof
  sorry

-- NumberField.discr_ne_zero
theorem numberFieldDiscr.ne_zero
  shows numberFieldDiscr(K) ≠ integerZero
proof
  sorry

-- Algebra.discr_eq_discr_of_toMatrix_coeff_isIntegral (and
-- discr_mul_isIntegral_mem_adjoin): the discriminant of a ℚ-basis of K of
-- algebraic integers is d_K times a square.
theorem numberFieldDiscr.dvd_of_integral (I b : Set)
  requires finite : Finite(I)
  requires basis : ModuleBasis(rationalModule(K), rationalRing, I, b)
  requires integral : ∀ i ∈ I, b(i) ∈ ringOfIntegers(K)
  shows ∃ z ∈ ℤ, z ≠ integerZero ∧ algebraDiscr(rationalAlgebra(K), I, b) =
    intCastMap(rationalRing)(call2(integerMul, numberFieldDiscr(K),
      call2(integerMul, z, z)))
proof
  sorry

-- |d_K| is a nonzero natural number.
theorem tkF.discrMagnitude.pos
  shows Nat(discrMagnitude(K)) ∧ discrMagnitude(K) ≠ 0
proof
  have sel := numberFieldDiscr.selected at K with numberField
  obtain ⟨dIn, _⟩ := sel
  have ne := numberFieldDiscr.ne_zero at K with field, numberField
  have nat := integerNatAbs.natural at numberFieldDiscr(K)
  have e : discrMagnitude(K) = integerNatAbs(numberFieldDiscr(K)) by unfold discrMagnitude; unfold integerNatAbs; rfl
  rw e
  refine ⟨nat, ?_⟩
  intro z
  have zz := (integerNatAbs.zero_iff at numberFieldDiscr(K)).forward with z
  exact ne with zz


-- The root discriminant is a real number at least 1.
theorem rootDiscr.ge_one
  shows rootDiscr(K) ∈ ℝ ∧ (1:R) ≤ (rootDiscr(K):R)
proof
  have dp := tkF.discrMagnitude.pos at K with field, numberField
  obtain ⟨mNat, mNe⟩ := dp
  have np := numberFieldDegree.pos at K with numberField
  obtain ⟨nIn, nPos⟩ := np
  have nNat : Nat(numberFieldDegree(K)) := nat.omega.backward with nIn
  have nNe : numberFieldDegree(K) ≠ 0 by arith
  have cm := tkF.natCast.real at discrMagnitude(K)
  have cn := tkF.natCast.real at numberFieldDegree(K)
  unfold rootDiscr
  rw [cm, cn]
  have mR := realNat.real at discrMagnitude(K)
  have mPos := realNat.positive at discrMagnitude(K) with mNe
  have nR := realNat.real at numberFieldDegree(K)
  have nPosR := realNat.positive at numberFieldDegree(K) with nNe
  have iv : realInv(realNat(numberFieldDegree(K))) = realInvValue(realNat(numberFieldDegree(K))) by unfold realInvValue; rfl
  rw iv
  have ivR := realInvValue.real at realNat(numberFieldDegree(K))
  have ip := realInvValue.positive at realNat(numberFieldDegree(K)) with nPosR
  have r := realRpow.real at realNat(discrMagnitude(K)), realInvValue(realNat(numberFieldDegree(K)))
  refine ⟨r, ?_⟩
  have ob := realRpow.one_base at realInvValue(realNat(numberFieldDegree(K)))
  by_cases h : discrMagnitude(K) = 1
  . rw [h, realNat.one, ob]
    linarith
  . have m2 : 2 ≤ discrMagnitude(K) by arith
    have le := realNat.le_of_natural_le at 2, discrMagnitude(K) with m2
    have two : (2:R) = realNat(2) by unfold realNumeral; rfl
    have gt : (1:R) < realNat(discrMagnitude(K)) by linarith
    have zo : (0:R) < (1:R) by linarith
    have lt := realRpow.lt_of_base at (1:R), realNat(discrMagnitude(K)), realInvValue(realNat(numberFieldDegree(K))) with zo, gt, ip
    rw ob at lt
    linarith


-- The defining identity rootDiscr^{[K : ℚ]} = |d_K| (NumberField.rootDiscr_def).
theorem rootDiscr.pow_degree
  shows realRpow(rootDiscr(K), natCast(realRing, numberFieldDegree(K))) =
    natCast(realRing, discrMagnitude(K))
proof
  have dp := tkF.discrMagnitude.pos at K with field, numberField
  obtain ⟨mNat, mNe⟩ := dp
  have np := numberFieldDegree.pos at K with numberField
  obtain ⟨nIn, nPos⟩ := np
  have nNat : Nat(numberFieldDegree(K)) := nat.omega.backward with nIn
  have nNe : numberFieldDegree(K) ≠ 0 by arith
  have cm := tkF.natCast.real at discrMagnitude(K)
  have cn := tkF.natCast.real at numberFieldDegree(K)
  unfold rootDiscr
  rw [cm, cn]
  have mPos := realNat.positive at discrMagnitude(K) with mNe
  have nR := realNat.real at numberFieldDegree(K)
  have nRne := realNat.ne_zero at numberFieldDegree(K) with nNe
  have iv : realInv(realNat(numberFieldDegree(K))) = realInvValue(realNat(numberFieldDegree(K))) by unfold realInvValue; rfl
  rw iv
  have ivR := realInvValue.real at realNat(numberFieldDegree(K))
  have me := realRpow.mul_exponent at realNat(discrMagnitude(K)), realInvValue(realNat(numberFieldDegree(K))), realNat(numberFieldDegree(K)) with mPos
  rw me
  have one := realInvValue.mul_left at realNat(numberFieldDegree(K)) with nRne
  rw one
  exact realRpow.one at realNat(discrMagnitude(K)) with mPos


-- Section: The absolute different
-- NumberField.absNorm_differentIdeal: N(𝔇_K) = |d_K|.
theorem absoluteDifferent.absNorm
  shows absNorm(K, absoluteDifferent(K)) = discrMagnitude(K)
proof
  sorry

-- NumberField.discr_mem_differentIdeal
theorem absoluteDifferent.discr_mem
  shows intCastMap(K)(numberFieldDiscr(K)) ∈ absoluteDifferent(K)
proof
  sorry

-- Dedekind's discriminant theorem: a rational prime p ramifies in K
-- exactly when it divides d_K (from not_dvd_differentIdeal_iff and
-- absNorm_differentIdeal).
theorem numberFieldDiscr.ramified_iff (p : Nat)
  requires rational : Prime(p)
  shows (∃ P ∈ heightOneSpectrum(ringOfIntegersRing(K)), natCast(K, p) ∈ P ∧
      ramificationIndex(intCastMap(ringOfIntegersRing(K)), ringOfIntegersRing(K),
        integerPrimeIdeal(p), P) ≠ 1) ↔
    (∃ m ∈ ℕ, discrMagnitude(K) = mul(p, m))
proof
  sorry

end Discriminant

-- Rat.discr, NumberField.discr_rat: d_ℚ = 1.
theorem numberFieldDiscr.rationals
  shows numberFieldDiscr(rationalRing) = integerOne
proof
  sorry

-- Section: The relative different
section Different
variable (K L f : Set)
hypothesis sourceField : Field(K)
hypothesis targetField : Field(L)
hypothesis source : NumberField(K)
hypothesis target : NumberField(L)
hypothesis hom : RingHom(f, K, L)

-- Submodule.mem_traceDual
theorem traceDual.mem_iff (I x : Set)
  shows x ∈ traceDual(f, K, L, I) ↔ (x ∈ Ring.carrier(L) ∧ (∀ y ∈ I,
    algebraTrace(Algebra.mk(K, L, f), call2(Ring.mul(L), x, y)) ∈ ringOfIntegers(K)))
proof
  unfold traceDual
  constructor
  . intro h
    exact ⟨h.left, h.right⟩
  . intro h
    exact h


-- FractionalIdeal.one_le_dual_one, dual_ne_zero: the dual of 𝓞 L is a
-- nonzero fractional ideal containing 𝓞 L.
theorem traceDual.fractional
  shows ringOfIntegers(L) ⊆ traceDual(f, K, L, ringOfIntegers(L)) ∧
    traceDual(f, K, L, ringOfIntegers(L)) ∈
      nonzeroFractionalIdeals(ringOfIntegersInclusion(L))
proof
  sorry

-- differentIdeal is an ideal of 𝓞 L, and differentIdeal_ne_bot.
theorem differentIdeal.ideal
  shows Ideal(ringOfIntegersRing(L), differentIdeal(f, K, L)) ∧
    differentIdeal(f, K, L) ≠ {Ring.zero(L)}
proof
  sorry

-- coeIdeal_differentIdeal: 𝔇 is the inverse of the dual of 𝓞 L.
theorem differentIdeal.coe_eq_inv_dual
  shows coeIdeal(ringOfIntegersInclusion(L), differentIdeal(f, K, L)) =
    fractionalIdealInv(ringOfIntegersInclusion(L), traceDual(f, K, L, ringOfIntegers(L)))
proof
  have tf := traceDual.fractional at K, L, f with sourceField, targetField, source, target, hom
  obtain ⟨roiSub, _⟩ := tf
  have subL := ringOfIntegers.subring at L with targetField, target
  have subL0 := subL
  obtain ⟨roiL, _, oneIn, _⟩ := subL0
  have rc := ringOfIntegersRing.carrier at L with targetField, target
  have bs : Algebra.base(ringOfIntegersInclusion(L)) = ringOfIntegersRing(L) by simp [ringOfIntegersInclusion, Algebra.mk.base]
  have rg : Algebra.ring(ringOfIntegersInclusion(L)) = L by simp [ringOfIntegersInclusion, Algebra.mk.ring]
  have mp : Algebra.map(ringOfIntegersInclusion(L)) = identity(ringOfIntegers(L)) by simp [ringOfIntegersInclusion, Algebra.mk.map]
  have ac : algebraCarrier(ringOfIntegersInclusion(L)) = Ring.carrier(L)
    unfold algebraCarrier
    rw rg
  have ie : integerElements(ringOfIntegersInclusion(L)) = ringOfIntegers(L)
    unfold integerElements
    rw [bs, rc, mp, ac]
    ext y
    constructor
    . intro hy
      unfold functionImage at hy
      obtain ⟨_, w, wIn, yEq⟩ := hy
      have ia := identity.apply at w, ringOfIntegers(L) with wIn
      rw [yEq, ia]
      exact wIn
    . intro hy
      have yL := roiL with y, hy
      have ia := identity.apply at y, ringOfIntegers(L) with hy
      have e : y = identity(ringOfIntegers(L))(y) by rw ia
      unfold functionImage
      exact ⟨yL, y, hy, e⟩
  have oneT := roiSub with Ring.one(L), oneIn
  have Tnz : traceDual(f, K, L, ringOfIntegers(L)) ≠ fractionalIdealZero(ringOfIntegersInclusion(L))
    intro e
    rw e at oneT
    unfold fractionalIdealZero at oneT
    rw rg at oneT
    have o := singleton.membership.forward with oneT
    have kd := Field.domain at L with targetField
    obtain ⟨_, nt, _⟩ := kd
    have o2 : Ring.zero(L) = Ring.one(L) by rw o
    exact nt with o2
  unfold coeIdeal
  rw [mp, ac]
  ext x
  constructor
  . intro hx
    unfold fractionalIdealInv
    rw [ac, ie, rg]
    unfold functionImage at hx
    obtain ⟨xL, d, dD, xEq⟩ := hx
    unfold differentIdeal at dD
    obtain ⟨dR, dAll⟩ := dD
    have ia := identity.apply at d, ringOfIntegers(L) with dR
    rw ia at xEq
    have imp : traceDual(f, K, L, ringOfIntegers(L)) = fractionalIdealZero(ringOfIntegersInclusion(L)) → x = Ring.zero(L)
      intro e
      exfalso
      exact Tnz with e
    have all2 : ∀ y ∈ traceDual(f, K, L, ringOfIntegers(L)), call2(Ring.mul(Algebra.ring(ringOfIntegersInclusion(L))), x, y) ∈ ringOfIntegers(L)
      intros y hy
      rw [rg, xEq]
      exact dAll with y, hy
    exact ⟨xL, imp, all2⟩
  . intro hx
    unfold fractionalIdealInv at hx
    rw [ac, ie, rg] at hx
    obtain ⟨xL, _, xAll⟩ := hx
    have xAll2 : ∀ y ∈ traceDual(f, K, L, ringOfIntegers(L)), call2(Ring.mul(L), x, y) ∈ ringOfIntegers(L)
      intros y hy
      have t := xAll with y, hy
      rw rg at t
      exact t
    have x1 := xAll2 with Ring.one(L), oneT
    have e1 : call2(Ring.mul(L), x, Ring.one(L)) = x by ring
    rw e1 at x1
    have xD : x ∈ differentIdeal(f, K, L)
      unfold differentIdeal
      exact ⟨x1, xAll2⟩
    have ia := identity.apply at x, ringOfIntegers(L) with x1
    have e : x = identity(ringOfIntegers(L))(x) by rw ia
    unfold functionImage
    exact ⟨xL, x, xD, e⟩


-- not_dvd_differentIdeal_iff: P divides the different exactly when it is
-- ramified over K (residue fields are finite, hence separable).
theorem differentIdeal.not_dvd_iff (p P : Set)
  requires below : p ∈ heightOneSpectrum(ringOfIntegersRing(K))
  requires above : P ∈ primesOver(ringOfIntegersMap(f, K), ringOfIntegersRing(K),
    ringOfIntegersRing(L), p)
  shows ¬(differentIdeal(f, K, L) ⊆ P) ↔
    ramificationIndex(ringOfIntegersMap(f, K), ringOfIntegersRing(L), p, P) = 1
proof
  sorry

-- pow_sub_one_dvd_differentIdeal: P^{e − 1} divides 𝔇, i.e.
-- e ≤ ord_P(𝔇) + 1.
theorem differentIdeal.pow_sub_one_dvd (p P : Set)
  requires below : p ∈ heightOneSpectrum(ringOfIntegersRing(K))
  requires above : P ∈ primesOver(ringOfIntegersMap(f, K), ringOfIntegersRing(K),
    ringOfIntegersRing(L), p)
  shows (ramificationIndex(ringOfIntegersMap(f, K), ringOfIntegersRing(L), p, P):N) ≤
    succ(idealMultiplicity(ringOfIntegersRing(L), P, differentIdeal(f, K, L)))
proof
  sorry

-- NumberField.natAbs_discr_eq_absNorm_differentIdeal_mul_natAbs_discr_pow:
-- |d_L| = N(𝔇_{L/K}) |d_K|^{[L : K]}.
theorem discrMagnitude.tower
  shows discrMagnitude(L) = mul(absNorm(L, differentIdeal(f, K, L)),
    (discrMagnitude(K):N) ^ (finrank(algebraModule(Algebra.mk(K, L, f)), K):N))
proof
  sorry

-- The root discriminant does not decrease up a tower, and is unchanged
-- when L/K is unramified at every prime (𝔇_{L/K} = 𝓞 L).
theorem rootDiscr.tower
  shows (rootDiscr(K):R) ≤ (rootDiscr(L):R) ∧
    (differentIdeal(f, K, L) = ringOfIntegers(L) → rootDiscr(L) = rootDiscr(K))
proof
  sorry

-- differentIdeal_eq_differentIdeal_mul_differentIdeal: in a tower
-- K → L → M, 𝔇_{M/K} = 𝔇_{M/L} · 𝔇_{L/K} 𝓞 M.
theorem differentIdeal.tower (M g : Set)
  requires topField : Field(M)
  requires top : NumberField(M)
  requires upper : RingHom(g, L, M)
  shows differentIdeal(compose(g, f, Ring.carrier(K), Ring.carrier(L), Ring.carrier(M)),
      K, M) =
    idealProduct(ringOfIntegersRing(M), differentIdeal(g, L, M),
      idealExtension(ringOfIntegersMap(g, L), ringOfIntegersRing(M),
        differentIdeal(f, K, L)))
proof
  sorry

-- conductor_mul_differentIdeal for a monogenic extension (conductor 1):
-- if 𝓞 L = 𝓞 K[α] and p is a monic polynomial over 𝓞 K of degree [L : K]
-- with p(α) = 0, then 𝔇_{L/K} = (p'(α)).
theorem differentIdeal.monogenic (α p : Set)
  requires generated : adjoinOf(ringOfIntegersExtension(f, K, L), {α}) = ringOfIntegers(L)
  requires monic : PolyMonic(ringOfIntegersRing(K), p)
  requires degree : polyNatDegree(ringOfIntegersRing(K), p) =
    finrank(algebraModule(Algebra.mk(K, L, f)), K)
  requires root : polyAeval(ringOfIntegersExtension(f, K, L), α, p) = Ring.zero(L)
  shows differentIdeal(f, K, L) = ringMultiples(ringOfIntegersRing(L),
    polyAeval(ringOfIntegersExtension(f, K, L), α,
      polyDerivative(ringOfIntegersRing(K))(p)))
proof
  sorry

end Different

-- Section: The absolute different as an ideal (moved after the relative
-- different, whose ideal law it uses)
section AbsoluteDifferentIdeal
variable (K : Set)
hypothesis field : Field(K)
hypothesis numberField : NumberField(K)

-- differentIdeal is an ideal of 𝓞 K.
theorem absoluteDifferent.ideal
  shows Ideal(ringOfIntegersRing(K), absoluteDifferent(K))
proof
  have qf := rationalRing.field
  have qff := qf.left
  have qn := NumberField.rationals
  have nf0 := numberField
  obtain ⟨_, cz, _⟩ := nf0
  have hom := ratCastMap.ring_hom at K with field, cz
  have d := differentIdeal.ideal at rationalRing, K, ratCastMap(K) with qff, field, qn, numberField, hom
  unfold absoluteDifferent
  exact d.left

end AbsoluteDifferentIdeal
