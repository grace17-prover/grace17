-- The exponential function. The real and imaginary parts, conjugate,
-- modulus, and inverse of a complex number; complex series and absolute
-- convergence; exp z as the sum of the series Σ zⁿ/n!, with
-- exp(z + w) = exp z · exp w, exp 0 = 1, and exp z ≠ 0; and the real
-- exponential e^x as the sum of Σ xⁿ/n!, increasing and a bijection of ℝ
-- onto (0, ∞).
-- Part of the GRH blueprint.
-- Planned home: Complex/Exp.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Exp
import Grace.Cumulus.Complex.SequentialContinuity
import Grace.Cumulus.Complex.PowerArithmetic
import Grace.Cumulus.Real.Analysis.Series

-- Section: Parts, conjugate, modulus, and inverse
-- A complex number is a pair (a, b) of reals: a is its real part, b its
-- imaginary part. The imaginary unit is complexImaginaryUnit = (0, 1).
def complexRe (z : Set) : Set := fst(z)
def complexIm (z : Set) : Set := snd(z)

defgraph complexOfReal (a ∈ ℝ) : complexCarrier := (a, realZero)
proof
  have aReal : Real(a) by exact member
  have zeroReal : Real(realZero) := realZero.real
  exact complexCarrier.pair at a, realZero with aReal, zeroReal

defgraph complexConj (z ∈ complexCarrier) : complexCarrier := (fst(z),
    realNeg(snd(z)))
proof
  obtain ⟨a, aReal, b, bReal, shape⟩ := complexCarrier.cases with member
  have negReal : Real(realNeg(b)) by typecheck
  rw [shape, fst.pair, snd.pair]
  exact complexCarrier.pair at a, realNeg(b) with aReal, negReal

-- The modulus |z| = √(re(z)² + im(z)²).
defgraph complexAbs (z ∈ complexCarrier) : ℝ :=
    realSqrt(complexNormSquared(z))
proof
  sorry

-- The multiplicative inverse is the field inverse of ℂ, with 0⁻¹ = 0.
def complexInv : Set :=
  fieldInverse(complexCarrier, complexAdd, complexZero, complexNeg,
    complexMul, complexOne)

def complexDiv (z w : Set) : Set := complexMul(z, complexInv(w))

def positiveReals : Set := { X ∈ ℝ | realZero < X }

-- Section: Complex series
-- The sum of the first n terms, and the sum of a series as the limit of
-- these partial sums.
def complexPartialSum (u : Set) (n : Nat) → Set
  | u, zero => complexZero
  | u, succ(k) => complexAdd(complexPartialSum(u, k), uₖ)

defgraph complexPrefixSums (u : Set) (n ∈ ℕ) : complexCarrier :=
    complexPartialSum(u, n)
requires sequence : ComplexSequence(u)
proof
  sorry

defgraph complexAbsSequence (u : Set) (n ∈ ℕ) : ℝ := complexAbs(u(n))
requires sequence : ComplexSequence(u)
proof
  sorry

predicate ComplexSumsTo (u S : Set) :=
  ComplexSequence(u) ∧ ComplexConvergesTo(complexPrefixSums(u), S)

predicate ComplexSummable (u : Set) :=
  ∃ S ∈ complexCarrier, ComplexSumsTo(u, S)

predicate ComplexAbsolutelySummable (u : Set) :=
  ComplexSequence(u) ∧ Summable(complexAbsSequence(u))

section Complexes
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Section: The exponential series
-- The terms zⁿ/n! and the real terms xⁿ/n!.
defgraph expTerms (z : Set) (n ∈ ℕ) : complexCarrier :=
    ℂ[complexOfReal(R[1 / n!]) * z ^ n]
requires hz : z ∈ complexCarrier
proof
  sorry

defgraph realExpTerms (X : Real) (n ∈ ℕ) : ℝ := X ^ n / n!
proof
  sorry

-- exp z is the sum of Σ zⁿ/n!, which converges absolutely for every z.
defunique complexExpValue (z : Set) (w ∈ complexCarrier) :=
  ComplexSumsTo(expTerms(z), w)
requires hz : z ∈ complexCarrier
proof
  sorry
uniqueness
  sorry

defgraph complexExp (z ∈ complexCarrier) : complexCarrier :=
    complexExpValue(z)
proof
  have selected := complexExpValue.selected with member
  exact selected.left

-- e^x is the sum of Σ xⁿ/n!.
defunique realExpValue (X : Real) (Y ∈ ℝ) := SumsTo(realExpTerms(X), Y)
proof
  sorry
uniqueness
  sorry

defgraph realExp (X ∈ ℝ) : ℝ := realExpValue(X)
proof
  sorry

-- Section: Parts and the embedding of ℝ
theorem complex.ext (z : Set)
  requires hz : z ∈ ℂ
  shows z = (complexRe(z), complexIm(z))
proof
  sorry

theorem complexRe.real (z : Set)
  requires hz : z ∈ ℂ
  shows complexRe(z) ∈ ℝ
proof
  sorry

theorem complexIm.real (z : Set)
  requires hz : z ∈ ℂ
  shows complexIm(z) ∈ ℝ
proof
  sorry

theorem complexRe.add (z w : Set)
  requires hz : z ∈ ℂ
  requires hw : w ∈ ℂ
  shows complexRe(ℂ[z + w]) = R[complexRe(z) + complexRe(w)]
proof
  sorry

theorem complexIm.add (z w : Set)
  requires hz : z ∈ ℂ
  requires hw : w ∈ ℂ
  shows complexIm(ℂ[z + w]) = R[complexIm(z) + complexIm(w)]
proof
  sorry

theorem complexRe.mul (z w : Set)
  requires hz : z ∈ ℂ
  requires hw : w ∈ ℂ
  shows complexRe(ℂ[z * w]) =
    R[complexRe(z) * complexRe(w) - complexIm(z) * complexIm(w)]
proof
  sorry

theorem complexIm.mul (z w : Set)
  requires hz : z ∈ ℂ
  requires hw : w ∈ ℂ
  shows complexIm(ℂ[z * w]) =
    R[complexRe(z) * complexIm(w) + complexIm(z) * complexRe(w)]
proof
  sorry

theorem complex.re_add_im (z : Set)
  requires hz : z ∈ ℂ
  shows z = ℂ[complexOfReal(complexRe(z)) +
    complexImaginaryUnit * complexOfReal(complexIm(z))]
proof
  sorry

theorem complexOfReal.re (a : Real)
  shows complexRe(complexOfReal(a)) = a
proof
  have aMember : a ∈ ℝ by typecheck
  rw [complexOfReal.value at a with aMember]
  unfold complexRe
  rw fst.pair

theorem complexOfReal.im (a : Real)
  shows complexIm(complexOfReal(a)) = R[0]
proof
  have aMember : a ∈ ℝ by typecheck
  rw [complexOfReal.value at a with aMember]
  unfold complexIm
  rw snd.pair

theorem complexOfReal.injective (a b : Real)
  requires same : complexOfReal(a) = complexOfReal(b)
  shows a = b
proof
  sorry

theorem complexOfReal.zero
  shows complexOfReal(R[0]) = ℂ[0]
proof
  sorry

theorem complexOfReal.one
  shows complexOfReal(R[1]) = ℂ[1]
proof
  sorry

theorem complexOfReal.add (a b : Real)
  shows complexOfReal(R[a + b]) = ℂ[complexOfReal(a) + complexOfReal(b)]
proof
  sorry

theorem complexOfReal.neg (a : Real)
  shows complexOfReal(R[-a]) = ℂ[-complexOfReal(a)]
proof
  sorry

theorem complexOfReal.mul (a b : Real)
  shows complexOfReal(R[a * b]) = ℂ[complexOfReal(a) * complexOfReal(b)]
proof
  sorry

theorem complexOfReal.pow (a : Real) (n : Nat)
  shows complexOfReal(R[a ^ n]) = ℂ[complexOfReal(a) ^ n]
proof
  sorry

theorem complexOfReal.nat (n : Nat)
  shows complexOfReal(realNat(n)) = ringNat(complexAdd, complexZero,
    complexOne, n)
proof
  sorry

-- Section: Conjugate
theorem complexConj.re (z : Set)
  requires hz : z ∈ ℂ
  shows complexRe(complexConj(z)) = complexRe(z)
proof
  sorry

theorem complexConj.im (z : Set)
  requires hz : z ∈ ℂ
  shows complexIm(complexConj(z)) = R[-complexIm(z)]
proof
  sorry

theorem complexConj.involutive (z : Set)
  requires hz : z ∈ ℂ
  shows complexConj(complexConj(z)) = z
proof
  sorry

theorem complexConj.add (z w : Set)
  requires hz : z ∈ ℂ
  requires hw : w ∈ ℂ
  shows complexConj(ℂ[z + w]) = ℂ[complexConj(z) + complexConj(w)]
proof
  sorry

theorem complexConj.mul (z w : Set)
  requires hz : z ∈ ℂ
  requires hw : w ∈ ℂ
  shows complexConj(ℂ[z * w]) = ℂ[complexConj(z) * complexConj(w)]
proof
  sorry

theorem complexConj.of_real (a : Real)
  shows complexConj(complexOfReal(a)) = complexOfReal(a)
proof
  sorry

theorem complexConj.mul_self (z : Set)
  requires hz : z ∈ ℂ
  shows ℂ[z * complexConj(z)] = complexOfReal(complexNormSquared(z))
proof
  sorry

-- Section: Modulus
theorem complexNormSquared.parts (z : Set)
  requires hz : z ∈ ℂ
  shows complexNormSquared(z) =
    R[complexRe(z) * complexRe(z) + complexIm(z) * complexIm(z)]
proof
  sorry

theorem complexAbs.nonnegative (z : Set)
  requires hz : z ∈ ℂ
  shows R[0] ≤ complexAbs(z)
proof
  sorry

theorem complexAbs.square (z : Set)
  requires hz : z ∈ ℂ
  shows R[complexAbs(z) * complexAbs(z)] = complexNormSquared(z)
proof
  sorry

theorem complexAbs.zero_iff (z : Set)
  requires hz : z ∈ ℂ
  shows complexAbs(z) = R[0] ↔ z = ℂ[0]
proof
  sorry

theorem complexAbs.positive (z : Set)
  requires hz : z ∈ ℂ
  requires nonzero : z ≠ ℂ[0]
  shows R[0] < complexAbs(z)
proof
  sorry

theorem complexAbs.mul (z w : Set)
  requires hz : z ∈ ℂ
  requires hw : w ∈ ℂ
  shows complexAbs(ℂ[z * w]) = R[complexAbs(z) * complexAbs(w)]
proof
  sorry

theorem complexAbs.triangle (z w : Set)
  requires hz : z ∈ ℂ
  requires hw : w ∈ ℂ
  shows complexAbs(ℂ[z + w]) ≤ R[complexAbs(z) + complexAbs(w)]
proof
  sorry

theorem complexAbs.neg (z : Set)
  requires hz : z ∈ ℂ
  shows complexAbs(ℂ[-z]) = complexAbs(z)
proof
  sorry

theorem complexAbs.conj (z : Set)
  requires hz : z ∈ ℂ
  shows complexAbs(complexConj(z)) = complexAbs(z)
proof
  sorry

theorem complexAbs.of_real (a : Real)
  shows complexAbs(complexOfReal(a)) = abs(a)
proof
  sorry

theorem complexAbs.one
  shows complexAbs(ℂ[1]) = R[1]
proof
  sorry

theorem complexAbs.pow (z : Set) (n : Nat)
  requires hz : z ∈ ℂ
  shows complexAbs(ℂ[z ^ n]) = R[complexAbs(z) ^ n]
proof
  sorry

theorem complexAbs.re_le (z : Set)
  requires hz : z ∈ ℂ
  shows abs(complexRe(z)) ≤ complexAbs(z)
proof
  sorry

theorem complexAbs.im_le (z : Set)
  requires hz : z ∈ ℂ
  shows abs(complexIm(z)) ≤ complexAbs(z)
proof
  sorry

-- Section: Inverse
theorem complexInv.member (z : Set)
  requires hz : z ∈ ℂ
  shows complexInv(z) ∈ ℂ
proof
  sorry

theorem complexInv.mul_cancel (z : Set)
  requires hz : z ∈ ℂ
  requires nonzero : z ≠ ℂ[0]
  shows ℂ[z * complexInv(z)] = ℂ[1]
proof
  sorry

theorem complexInv.zero
  shows complexInv(ℂ[0]) = ℂ[0]
proof
  sorry

theorem complexInv.nonzero (z : Set)
  requires hz : z ∈ ℂ
  requires nonzero : z ≠ ℂ[0]
  shows complexInv(z) ≠ ℂ[0]
proof
  sorry

theorem complexInv.mul (z w : Set)
  requires hz : z ∈ ℂ
  requires hw : w ∈ ℂ
  shows complexInv(ℂ[z * w]) = ℂ[complexInv(z) * complexInv(w)]
proof
  sorry

theorem complexInv.abs (z : Set)
  requires hz : z ∈ ℂ
  requires nonzero : z ≠ ℂ[0]
  shows complexAbs(complexInv(z)) = R[1 / complexAbs(z)]
proof
  sorry

theorem complexInv.of_real (a : Real)
  requires nonzero : a ≠ R[0]
  shows complexInv(complexOfReal(a)) = complexOfReal(R[1 / a])
proof
  sorry

theorem complexDiv.mul_cancel (z w : Set)
  requires hz : z ∈ ℂ
  requires hw : w ∈ ℂ
  requires nonzero : w ≠ ℂ[0]
  shows ℂ[complexDiv(z, w) * w] = z
proof
  sorry

-- Section: Series
theorem ComplexConvergesTo.unique (u a b : Set)
  requires first : ComplexConvergesTo(u, a)
  requires second : ComplexConvergesTo(u, b)
  shows a = b
proof
  sorry

-- Convergence in ℂ is convergence of |uₙ − a| to 0.
theorem ComplexConvergesTo.iff_abs (u a : Set)
  requires sequence : ComplexSequence(u)
  requires ha : a ∈ ℂ
  shows ComplexConvergesTo(u, a) ↔
    (∀ e ∈ ℝ, R[0] < e → ∃ N ∈ ℕ, ∀ n ∈ ℕ, N ≤ n →
      complexAbs(ℂ[u(n) - a]) < e)
proof
  sorry

theorem complexPartialSum.zero (u : Set)
  shows complexPartialSum(u, 0) = ℂ[0]
proof
  rw complexPartialSum
  rfl

theorem complexPartialSum.succ (u : Set) (n : Nat)
  shows complexPartialSum(u, succ(n)) = ℂ[complexPartialSum(u, n) + u(n)]
proof
  rw complexPartialSum
  rfl

theorem complexPartialSum.member (u : Set) (n : Nat)
  requires sequence : ComplexSequence(u)
  shows complexPartialSum(u, n) ∈ ℂ
proof
  sorry

theorem ComplexSumsTo.unique (u S T : Set)
  requires first : ComplexSumsTo(u, S)
  requires second : ComplexSumsTo(u, T)
  shows S = T
proof
  sorry

theorem ComplexSumsTo.member (u S : Set)
  requires sums : ComplexSumsTo(u, S)
  shows S ∈ ℂ
proof
  obtain ⟨sequence, converges⟩ := sums
  obtain ⟨_, member, _⟩ := converges
  exact member

-- An absolutely convergent series converges.
theorem ComplexAbsolutelySummable.summable (u : Set)
  requires absolute : ComplexAbsolutelySummable(u)
  shows ComplexSummable(u)
proof
  sorry

-- Comparison with a convergent series of real bounds.
theorem ComplexAbsolutelySummable.of_bound (u v : Set)
  requires sequence : ComplexSequence(u)
  requires bounds : Summable(v)
  requires dominated : ∀ n ∈ ℕ, complexAbs(u(n)) ≤ v(n)
  shows ComplexAbsolutelySummable(u)
proof
  sorry

-- Section: The complex exponential
theorem expTerms.sequence (z : Set)
  requires hz : z ∈ ℂ
  shows ComplexSequence(expTerms(z))
proof
  sorry

theorem expTerms.absolutely_summable (z : Set)
  requires hz : z ∈ ℂ
  shows ComplexAbsolutelySummable(expTerms(z))
proof
  sorry

theorem complexExp.sums (z : Set)
  requires hz : z ∈ ℂ
  shows ComplexSumsTo(expTerms(z), complexExp(z))
proof
  have selected := complexExpValue.selected with hz
  have value := complexExp.value with hz
  rw value
  exact selected.right

theorem complexExp.member (z : Set)
  requires hz : z ∈ ℂ
  shows complexExp(z) ∈ ℂ
proof
  sorry

theorem complexExp.zero
  shows complexExp(ℂ[0]) = ℂ[1]
proof
  sorry

theorem complexExp.add (z w : Set)
  requires hz : z ∈ ℂ
  requires hw : w ∈ ℂ
  shows complexExp(ℂ[z + w]) = ℂ[complexExp(z) * complexExp(w)]
proof
  sorry

theorem complexExp.neg (z : Set)
  requires hz : z ∈ ℂ
  shows ℂ[complexExp(-z) * complexExp(z)] = ℂ[1]
proof
  sorry

theorem complexExp.nonzero (z : Set)
  requires hz : z ∈ ℂ
  shows complexExp(z) ≠ ℂ[0]
proof
  sorry

theorem complexExp.inv (z : Set)
  requires hz : z ∈ ℂ
  shows complexExp(ℂ[-z]) = complexInv(complexExp(z))
proof
  sorry

theorem complexExp.nat_mul (z : Set) (n : Nat)
  requires hz : z ∈ ℂ
  shows complexExp(ℂ[complexOfReal(realNat(n)) * z]) =
    ℂ[complexExp(z) ^ n]
proof
  sorry

theorem complexExp.conj (z : Set)
  requires hz : z ∈ ℂ
  shows complexExp(complexConj(z)) = complexConj(complexExp(z))
proof
  sorry

theorem complexExp.continuous
  shows ComplexContinuous(complexExp)
proof
  sorry

-- |exp z − 1 − z| ≤ |z|² for |z| ≤ 1, the bound behind the derivative.
theorem complexExp.quadratic_bound (z : Set)
  requires hz : z ∈ ℂ
  requires small : complexAbs(z) ≤ R[1]
  shows complexAbs(ℂ[complexExp(z) - 1 - z]) ≤
    R[complexAbs(z) * complexAbs(z)]
proof
  sorry

-- Section: The real exponential
theorem realExpTerms.sequence (X : Real)
  shows RealSequence(realExpTerms(X))
proof
  sorry

theorem realExp.sums (X : Real)
  shows SumsTo(realExpTerms(X), realExp(X))
proof
  sorry

theorem realExp.real (X : Real)
  shows realExp(X) ∈ ℝ
proof
  sorry

theorem complexExp.of_real (X : Real)
  shows complexExp(complexOfReal(X)) = complexOfReal(realExp(X))
proof
  sorry

theorem realExp.zero
  shows realExp(R[0]) = R[1]
proof
  sorry

theorem realExp.add (X Y : Real)
  shows realExp(R[X + Y]) = R[realExp(X) * realExp(Y)]
proof
  sorry

theorem realExp.positive (X : Real)
  shows R[0] < realExp(X)
proof
  sorry

theorem realExp.neg (X : Real)
  shows realExp(R[-X]) = R[1 / realExp(X)]
proof
  sorry

theorem realExp.nat_mul (X : Real) (n : Nat)
  shows realExp(R[realNat(n) * X]) = R[realExp(X) ^ n]
proof
  sorry

theorem realExp.one_add_le (X : Real)
  shows R[1 + X] ≤ realExp(X)
proof
  sorry

theorem realExp.strictly_increasing (X Y : Real)
  requires less : X < Y
  shows realExp(X) < realExp(Y)
proof
  sorry

theorem realExp.le_iff (X Y : Real)
  shows realExp(X) ≤ realExp(Y) ↔ X ≤ Y
proof
  sorry

theorem realExp.injective (X Y : Real)
  requires same : realExp(X) = realExp(Y)
  shows X = Y
proof
  sorry

theorem realExp.continuous
  shows Continuous(realExp)
proof
  sorry

theorem realExp.derivative (X : Real)
  shows HasDerivativeAt(realExp, realExp(X), X)
proof
  sorry

theorem realExp.onto_positive (Y : Real)
  requires positive : R[0] < Y
  shows ∃ X ∈ ℝ, realExp(X) = Y
proof
  sorry

theorem realExp.bijective
  shows BijectiveBetween(realExp, ℝ, positiveReals)
proof
  sorry

-- |exp z| = e^(re z).
theorem complexExp.abs (z : Set)
  requires hz : z ∈ ℂ
  shows complexAbs(complexExp(z)) = realExp(complexRe(z))
proof
  sorry

end Complexes
