-- The exponential function. The real and imaginary parts, conjugate,
-- modulus, and inverse of a complex number; complex series and absolute
-- convergence; exp z as the sum of the series Σ zⁿ/n!, with
-- exp(z + w) = exp z · exp w, exp 0 = 1, and exp z ≠ 0; and the real
-- exponential e^x as the sum of Σ xⁿ/n!, increasing and a bijection of ℝ
-- onto (0, ∞).
-- Part of the GRH blueprint.
-- Planned home: Complex/Exp.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Exp
import Grace.Cumulus.Complex.SequentialContinuity
import Grace.Cumulus.Complex.PowerArithmetic
import Grace.Cumulus.Real.Analysis.GeometricSeries
import Grace.Cumulus.Real.Analysis.IntermediateValue

-- Section: Parts, conjugate, modulus, and inverse
-- A complex number is a pair (a, b) of reals: a is its real part, b its
-- imaginary part. The imaginary unit is complexImaginaryUnit = (0, 1).
def complexRe (z : Set) : Set := fst(z)
def complexIm (z : Set) : Set := snd(z)

defgraph complexOfReal (a ∈ ℝ) : complexCarrier := (a, realZero)
proof
  have aReal : Real(a) by exact member
  have zeroReal : Real(realZero) := realZero.real
  exact complexCarrier.pair at a, realZero with aReal, zeroReal

defgraph complexConj (z ∈ complexCarrier) : complexCarrier := (fst(z),
    realNeg(snd(z)))
proof
  obtain ⟨a, aReal, b, bReal, shape⟩ := complexCarrier.cases with member
  have negReal : Real(realNeg(b)) by typecheck
  rw [shape, fst.pair, snd.pair]
  exact complexCarrier.pair at a, realNeg(b) with aReal, negReal

-- The modulus |z| = √(re(z)² + im(z)²).
defgraph complexAbs (z ∈ complexCarrier) : ℝ :=
    realSqrt(complexNormSquared(z))
proof
  have point := complexNormSquared.real with member
  have nonnegative := complexNormSquared.nonnegative with member
  have real := realSqrt.real with nonnegative
  exact real

-- The multiplicative inverse is the field inverse of ℂ, with 0⁻¹ = 0.
def complexInv : Set :=
  fieldInverse(complexCarrier, complexAdd, complexZero, complexNeg,
    complexMul, complexOne)

def complexDiv (z w : Set) : Set := complexMul(z, complexInv(w))

def positiveReals : Set := { X ∈ ℝ | realZero < X }

-- Section: Complex series
-- The sum of the first n terms, and the sum of a series as the limit of
-- these partial sums.
def complexPartialSum (u : Set) (n : Nat) → Set
  | u, zero => complexZero
  | u, succ(k) => complexAdd(complexPartialSum(u, k), uₖ)

theorem complexPartialSum.closed (u : Set) (n : Nat)
  requires sequence : ComplexSequence(u)
  shows complexPartialSum(u, n) ∈ complexCarrier
proof
  induction n
  | zero =>
    rw complexPartialSum
    exact complexZero.member
  | succ(k) using ih =>
    have ring := complexes.comm_ring
    have ordinary := IsCommRing.ring with ring
    have kIn := nat.omega.forward at k with assumption
    have function : u : ℕ → complexCarrier by exact sequence
    have term := FunctionBetween.apply_closed with function, kIn
    rw complexPartialSum
    exact IsRing.add_closed with ordinary, ih, term

defgraph complexPrefixSums (u : Set) (n ∈ ℕ) : complexCarrier :=
    complexPartialSum(u, n)
requires sequence : ComplexSequence(u)
proof
  have nNat := nat.omega.backward at n with member
  exact complexPartialSum.closed at u, n with sequence

defgraph complexAbsSequence (u : Set) (n ∈ ℕ) : ℝ := complexAbs(u(n))
requires sequence : ComplexSequence(u)
proof
  have function : u : ℕ → complexCarrier by exact sequence
  have term := FunctionBetween.apply_closed with function, member
  exact FunctionBetween.apply_closed with complexAbs.function, term

predicate ComplexSumsTo (u S : Set) :=
  ComplexSequence(u) ∧ ComplexConvergesTo(complexPrefixSums(u), S)

predicate ComplexSummable (u : Set) :=
  ∃ S ∈ complexCarrier, ComplexSumsTo(u, S)

predicate ComplexAbsolutelySummable (u : Set) :=
  ComplexSequence(u) ∧ Summable(complexAbsSequence(u))

section Complexes
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Section: Parts and the embedding of ℝ
theorem complex.ext (z : Set)
  requires hz : z ∈ ℂ
  shows z = (complexRe(z), complexIm(z))
proof
  obtain ⟨a, aReal, b, bReal, shape⟩ := complexCarrier.cases with hz
  unfold complexRe
  unfold complexIm
  rw [shape, fst.pair, snd.pair]

theorem complexRe.real (z : Set)
  requires hz : z ∈ ℂ
  shows complexRe(z) ∈ ℝ
proof
  obtain ⟨a, aReal, b, bReal, shape⟩ := complexCarrier.cases with hz
  unfold complexRe
  rw [shape, fst.pair]
  typecheck

theorem complexIm.real (z : Set)
  requires hz : z ∈ ℂ
  shows complexIm(z) ∈ ℝ
proof
  obtain ⟨a, aReal, b, bReal, shape⟩ := complexCarrier.cases with hz
  unfold complexIm
  rw [shape, snd.pair]
  typecheck

theorem complexRe.add (z w : Set)
  requires hz : z ∈ ℂ
  requires hw : w ∈ ℂ
  shows complexRe(ℂ[z + w]) = R[complexRe(z) + complexRe(w)]
proof
  obtain ⟨a, aReal, b, bReal, zShape⟩ := complexCarrier.cases with hz
  obtain ⟨c, cReal, d, dReal, wShape⟩ := complexCarrier.cases with hw
  unfold complexRe
  simp [zShape, wShape, complexAdd.pair, fst.pair]

theorem complexIm.add (z w : Set)
  requires hz : z ∈ ℂ
  requires hw : w ∈ ℂ
  shows complexIm(ℂ[z + w]) = R[complexIm(z) + complexIm(w)]
proof
  obtain ⟨a, aReal, b, bReal, zShape⟩ := complexCarrier.cases with hz
  obtain ⟨c, cReal, d, dReal, wShape⟩ := complexCarrier.cases with hw
  unfold complexIm
  simp [zShape, wShape, complexAdd.pair, snd.pair]

theorem complexRe.mul (z w : Set)
  requires hz : z ∈ ℂ
  requires hw : w ∈ ℂ
  shows complexRe(ℂ[z * w]) =
    R[complexRe(z) * complexRe(w) - complexIm(z) * complexIm(w)]
proof
  obtain ⟨a, aReal, b, bReal, zShape⟩ := complexCarrier.cases with hz
  obtain ⟨c, cReal, d, dReal, wShape⟩ := complexCarrier.cases with hw
  unfold complexRe
  unfold complexIm
  simp [zShape, wShape, complexMul.pair, fst.pair, snd.pair]

theorem complexIm.mul (z w : Set)
  requires hz : z ∈ ℂ
  requires hw : w ∈ ℂ
  shows complexIm(ℂ[z * w]) =
    R[complexRe(z) * complexIm(w) + complexIm(z) * complexRe(w)]
proof
  obtain ⟨a, aReal, b, bReal, zShape⟩ := complexCarrier.cases with hz
  obtain ⟨c, cReal, d, dReal, wShape⟩ := complexCarrier.cases with hw
  unfold complexRe
  unfold complexIm
  simp [zShape, wShape, complexMul.pair, fst.pair, snd.pair]

theorem complex.re_add_im (z : Set)
  requires hz : z ∈ ℂ
  shows z = ℂ[complexOfReal(complexRe(z)) +
    complexImaginaryUnit * complexOfReal(complexIm(z))]
proof
  obtain ⟨a, aReal, b, bReal, shape⟩ := complexCarrier.cases with hz
  have aIn : a ∈ ℝ by typecheck
  have bIn : b ∈ ℝ by typecheck
  unfold complexRe
  unfold complexIm
  unfold complexImaginaryUnit
  simp [shape, fst.pair, snd.pair, complexOfReal.value, complexMul.pair, complexAdd.pair]
  have first : R[a + (0 * b - 1 * 0)] = a by ring
  have second : R[0 + (0 * 0 + 1 * b)] = b by ring
  rw [first, second]

theorem complexOfReal.re (a : Real)
  shows complexRe(complexOfReal(a)) = a
proof
  have aMember : a ∈ ℝ by typecheck
  rw [complexOfReal.value at a with aMember]
  unfold complexRe
  rw fst.pair

theorem complexOfReal.im (a : Real)
  shows complexIm(complexOfReal(a)) = R[0]
proof
  have aMember : a ∈ ℝ by typecheck
  rw [complexOfReal.value at a with aMember]
  unfold complexIm
  rw snd.pair

theorem complexOfReal.injective (a b : Real)
  requires same : complexOfReal(a) = complexOfReal(b)
  shows a = b
proof
  have aIn : a ∈ ℝ by typecheck
  have bIn : b ∈ ℝ by typecheck
  rw [complexOfReal.value at a with aIn, complexOfReal.value at b with bIn] at same
  have parts := orderedPair.injective with same
  exact parts.left

theorem complexOfReal.zero
  shows complexOfReal(R[0]) = ℂ[0]
proof
  have zeroIn : R[0] ∈ ℝ by typecheck
  rw complexOfReal.value at R[0] with zeroIn
  unfold complexZero
  rfl

theorem complexOfReal.one
  shows complexOfReal(R[1]) = ℂ[1]
proof
  have oneIn : R[1] ∈ ℝ by typecheck
  rw complexOfReal.value at R[1] with oneIn
  unfold complexOne
  rfl

theorem complexOfReal.add (a b : Real)
  shows complexOfReal(R[a + b]) = ℂ[complexOfReal(a) + complexOfReal(b)]
proof
  have aIn : a ∈ ℝ by typecheck
  have bIn : b ∈ ℝ by typecheck
  have sumIn : R[a + b] ∈ ℝ by typecheck
  simp [complexOfReal.value, complexAdd.pair]
  have zero : R[0 + 0] = R[0] by ring
  rw zero

theorem complexOfReal.neg (a : Real)
  shows complexOfReal(R[-a]) = ℂ[-complexOfReal(a)]
proof
  have aIn : a ∈ ℝ by typecheck
  have negIn : R[-a] ∈ ℝ by typecheck
  simp [complexOfReal.value, complexNeg.pair]
  have zero : R[-0] = R[0] by ring
  rw zero

theorem complexOfReal.mul (a b : Real)
  shows complexOfReal(R[a * b]) = ℂ[complexOfReal(a) * complexOfReal(b)]
proof
  have aIn : a ∈ ℝ by typecheck
  have bIn : b ∈ ℝ by typecheck
  have productIn : R[a * b] ∈ ℝ by typecheck
  simp [complexOfReal.value, complexMul.pair]
  have first : R[a * b - 0 * 0] = R[a * b] by ring
  have second : R[a * 0 + 0 * b] = R[0] by ring
  rw [first, second]

theorem complexOfReal.pow (a : Real) (n : Nat)
  shows complexOfReal(R[a ^ n]) = ℂ[complexOfReal(a) ^ n]
proof
  induction n
  | zero =>
    rw [monoidPow.zero, monoidPow.zero]
    exact complexOfReal.one
  | succ(k) using ih =>
    rw [monoidPow.succ, monoidPow.succ, complexOfReal.mul, ih]

theorem complexOfReal.nat (n : Nat)
  shows complexOfReal(realNat(n)) = ringNat(complexAdd, complexZero,
    complexOne, n)
proof
  induction n
  | zero =>
    rw [realNat.zero, ringNat.zero]
    exact complexOfReal.zero
  | succ(k) using ih =>
    have same : realAddValue(realNat(k), R[1]) = R[realNat(k) + 1]
      simp [realAddValue, call2]
    rw [realNat.succ, ringNat.succ, same, complexOfReal.add, ih, complexOfReal.one]

-- Section: Conjugate
theorem complex.pair_congr (a b c d : Set)
  requires first : a = c
  requires second : b = d
  shows (a, b) = (c, d)
proof
  rw [first, second]

theorem complexConj.pair (a b : Real)
  shows complexConj((a, b)) = (a, R[-b])
proof
  have member := complexCarrier.pair at a, b
  rw [complexConj.value at (a, b) with member, fst.pair, snd.pair]

theorem complexConj.re (z : Set)
  requires hz : z ∈ ℂ
  shows complexRe(complexConj(z)) = complexRe(z)
proof
  obtain ⟨a, aReal, b, bReal, shape⟩ := complexCarrier.cases with hz
  unfold complexRe
  rw [shape, complexConj.pair, fst.pair, fst.pair]

theorem complexConj.im (z : Set)
  requires hz : z ∈ ℂ
  shows complexIm(complexConj(z)) = R[-complexIm(z)]
proof
  obtain ⟨a, aReal, b, bReal, shape⟩ := complexCarrier.cases with hz
  unfold complexIm
  rw [shape, complexConj.pair, snd.pair, snd.pair]

theorem complexConj.involutive (z : Set)
  requires hz : z ∈ ℂ
  shows complexConj(complexConj(z)) = z
proof
  obtain ⟨a, aReal, b, bReal, shape⟩ := complexCarrier.cases with hz
  rw [shape, complexConj.pair, complexConj.pair]
  apply complex.pair_congr
  . rfl
  . ring

theorem complexConj.add (z w : Set)
  requires hz : z ∈ ℂ
  requires hw : w ∈ ℂ
  shows complexConj(ℂ[z + w]) = ℂ[complexConj(z) + complexConj(w)]
proof
  obtain ⟨a, aReal, b, bReal, zShape⟩ := complexCarrier.cases with hz
  obtain ⟨c, cReal, d, dReal, wShape⟩ := complexCarrier.cases with hw
  simp [zShape, wShape, complexAdd.pair, complexConj.pair]
  apply complex.pair_congr
  . rfl
  . ring

theorem complexConj.mul (z w : Set)
  requires hz : z ∈ ℂ
  requires hw : w ∈ ℂ
  shows complexConj(ℂ[z * w]) = ℂ[complexConj(z) * complexConj(w)]
proof
  obtain ⟨a, aReal, b, bReal, zShape⟩ := complexCarrier.cases with hz
  obtain ⟨c, cReal, d, dReal, wShape⟩ := complexCarrier.cases with hw
  simp [zShape, wShape, complexMul.pair, complexConj.pair]
  apply complex.pair_congr
  . ring
  . ring

theorem complexConj.of_real (a : Real)
  shows complexConj(complexOfReal(a)) = complexOfReal(a)
proof
  have aIn : a ∈ ℝ by typecheck
  rw [complexOfReal.value at a with aIn, complexConj.pair]
  apply complex.pair_congr
  . rfl
  . ring

theorem complexConj.mul_self (z : Set)
  requires hz : z ∈ ℂ
  shows ℂ[z * complexConj(z)] = complexOfReal(complexNormSquared(z))
proof
  obtain ⟨a, aReal, b, bReal, shape⟩ := complexCarrier.cases with hz
  have normIn : R[a * a + b * b] ∈ ℝ by typecheck
  simp [shape, complexConj.pair, complexMul.pair, complexNormSquared.pair, complexOfReal.value]
  apply complex.pair_congr
  . ring
  . ring

-- Section: Modulus
theorem complexNormSquared.parts (z : Set)
  requires hz : z ∈ ℂ
  shows complexNormSquared(z) =
    R[complexRe(z) * complexRe(z) + complexIm(z) * complexIm(z)]
proof
  obtain ⟨a, aReal, b, bReal, shape⟩ := complexCarrier.cases with hz
  unfold complexRe
  unfold complexIm
  simp [shape, fst.pair, snd.pair, complexNormSquared.pair]

theorem complexAbs.nonnegative (z : Set)
  requires hz : z ∈ ℂ
  shows R[0] ≤ complexAbs(z)
proof
  have nonnegative := complexNormSquared.nonnegative with hz
  rw complexAbs.value with hz
  exact realSqrt.nonneg with nonnegative

theorem complexAbs.square (z : Set)
  requires hz : z ∈ ℂ
  shows R[complexAbs(z) * complexAbs(z)] = complexNormSquared(z)
proof
  have nonnegative := complexNormSquared.nonnegative with hz
  rw complexAbs.value with hz
  exact realSqrt.square with nonnegative

-- The modulus is the nonnegative square root of the squared modulus.
theorem complexAbs.unique (z : Set) (t : Real)
  requires hz : z ∈ ℂ
  requires nonnegative : R[0] ≤ t
  requires square : R[t * t] = complexNormSquared(z)
  shows complexAbs(z) = t
proof
  have absNonnegative := complexAbs.nonnegative with hz
  have absSquare := complexAbs.square with hz
  have squares : R[complexAbs(z) * complexAbs(z)] = R[t * t]
    rw [absSquare, square]
  exact realMulValue.eq_of_square_eq with absNonnegative, nonnegative, squares

theorem complexAbs.zero_iff (z : Set)
  requires hz : z ∈ ℂ
  shows complexAbs(z) = R[0] ↔ z = ℂ[0]
proof
  have absSquare := complexAbs.square with hz
  constructor
  . intro zero
    have normZero : complexNormSquared(z) = R[0]
      rw [← absSquare, zero]
      ring
    exact complexNormSquared.zero_iff.forward with hz, normZero
  . intro zero
    rw zero
    have le := realLe.reflexive at R[0]
    have square : R[0 * 0] = complexNormSquared(ℂ[0])
      rw complexNormSquared.zero
      ring
    exact complexAbs.unique with complexZero.member, le, square

theorem complexAbs.positive (z : Set)
  requires hz : z ∈ ℂ
  requires nonzero : z ≠ ℂ[0]
  shows R[0] < complexAbs(z)
proof
  have nonnegative := complexAbs.nonnegative with hz
  have nonvanishing : complexAbs(z) ≠ R[0]
    intro zero
    have equivalence := complexAbs.zero_iff with hz
    exact nonzero with equivalence.forward with zero
  exact Real.positive_of_nonnegative_of_ne_zero with nonnegative, nonvanishing

theorem complexAbs.mul (z w : Set)
  requires hz : z ∈ ℂ
  requires hw : w ∈ ℂ
  shows complexAbs(ℂ[z * w]) = R[complexAbs(z) * complexAbs(w)]
proof
  have ring := complexes.comm_ring
  have ordinary := IsCommRing.ring with ring
  have product := IsRing.mul_closed with ordinary, hz, hw
  have zNonnegative := complexAbs.nonnegative with hz
  have wNonnegative := complexAbs.nonnegative with hw
  have zSquare := complexAbs.square with hz
  have wSquare := complexAbs.square with hw
  have nonnegative := realMulValue.nonnegative with zNonnegative, wNonnegative
  have square : R[(complexAbs(z) * complexAbs(w)) * (complexAbs(z) * complexAbs(w))] = complexNormSquared(ℂ[z * w])
    have normProduct := complexNormSquared.mul with hz, hw
    rw [normProduct, ← zSquare, ← wSquare]
    ring
  exact complexAbs.unique with product, nonnegative, square

theorem complexAbs.triangle (z w : Set)
  requires hz : z ∈ ℂ
  requires hw : w ∈ ℂ
  shows complexAbs(ℂ[z + w]) ≤ R[complexAbs(z) + complexAbs(w)]
proof
  have ring := complexes.comm_ring
  have ordinary := IsCommRing.ring with ring
  have sum := IsRing.add_closed with ordinary, hz, hw
  have zNonnegative := complexAbs.nonnegative with hz
  have wNonnegative := complexAbs.nonnegative with hw
  have sNonnegative := complexAbs.nonnegative with sum
  have zSquare := complexAbs.square with hz
  have wSquare := complexAbs.square with hw
  have sSquare := complexAbs.square with sum
  obtain ⟨a, aReal, b, bReal, zShape⟩ := complexCarrier.cases with hz
  obtain ⟨c, cReal, d, dReal, wShape⟩ := complexCarrier.cases with hw
  have zNorm : complexNormSquared(z) = R[a * a + b * b] by rw [zShape, complexNormSquared.pair]
  have wNorm : complexNormSquared(w) = R[c * c + d * d] by rw [wShape, complexNormSquared.pair]
  have sNorm : complexNormSquared(ℂ[z + w]) = R[(a + c) * (a + c) + (b + d) * (b + d)] by rw [zShape, wShape, complexAdd.pair, complexNormSquared.pair]
  rw zNorm at zSquare
  rw wNorm at wSquare
  rw sNorm at sSquare
  have bothNonnegative := realMulValue.nonnegative with zNonnegative, wNonnegative
  have cross := realMulValue.square_nonnegative at R[a * d - b * c]
  have schwarz : R[(a * c + b * d) * (a * c + b * d)] ≤ R[(complexAbs(z) * complexAbs(w)) * (complexAbs(z) * complexAbs(w))]
    have regroup : R[(complexAbs(z) * complexAbs(w)) * (complexAbs(z) * complexAbs(w))] = R[(complexAbs(z) * complexAbs(z)) * (complexAbs(w) * complexAbs(w))] by ring
    have identity : R[(a * a + b * b) * (c * c + d * d)] = R[(a * c + b * d) * (a * c + b * d) + (a * d - b * c) * (a * d - b * c)] by ring
    rw [regroup, zSquare, wSquare, identity]
    linarith
  have dotNonnegative := abs.nonnegative at R[a * c + b * d]
  have dotSquare := realMulValue.square_nonnegative at R[a * c + b * d]
  have absDot : R[abs(a * c + b * d) * abs(a * c + b * d)] = R[(a * c + b * d) * (a * c + b * d)]
    rw [← abs.mul, abs.of_nonnegative with dotSquare]
  rw ← absDot at schwarz
  have dotBound := realMulValue.le_of_square_le with dotNonnegative, bothNonnegative, schwarz
  have dotUpper := abs.upper at R[a * c + b * d]
  have total : R[0] ≤ R[complexAbs(z) + complexAbs(w)] by linarith
  have squares : R[complexAbs(ℂ[z + w]) * complexAbs(ℂ[z + w])] ≤ R[(complexAbs(z) + complexAbs(w)) * (complexAbs(z) + complexAbs(w))]
    have expand : R[(complexAbs(z) + complexAbs(w)) * (complexAbs(z) + complexAbs(w))] = R[complexAbs(z) * complexAbs(z) + 2 * (complexAbs(z) * complexAbs(w)) + complexAbs(w) * complexAbs(w)] by ring
    have identity : R[(a + c) * (a + c) + (b + d) * (b + d)] = R[(a * a + b * b) + 2 * (a * c + b * d) + (c * c + d * d)] by ring
    rw [expand, sSquare, zSquare, wSquare, identity]
    linarith
  exact realMulValue.le_of_square_le with sNonnegative, total, squares

theorem complexAbs.neg (z : Set)
  requires hz : z ∈ ℂ
  shows complexAbs(ℂ[-z]) = complexAbs(z)
proof
  have ring := complexes.comm_ring
  have ordinary := IsCommRing.ring with ring
  have negated := IsRing.neg_closed with ordinary, hz
  have nonnegative := complexAbs.nonnegative with hz
  have square := complexAbs.square with hz
  rw ← complexNormSquared.neg with hz at square
  exact complexAbs.unique with negated, nonnegative, square

theorem complexAbs.conj (z : Set)
  requires hz : z ∈ ℂ
  shows complexAbs(complexConj(z)) = complexAbs(z)
proof
  have conjugate : complexConj(z) ∈ ℂ by exact FunctionBetween.apply_closed with complexConj.function, hz
  have nonnegative := complexAbs.nonnegative with hz
  have square := complexAbs.square with hz
  have same : complexNormSquared(complexConj(z)) = complexNormSquared(z)
    obtain ⟨a, aReal, b, bReal, shape⟩ := complexCarrier.cases with hz
    rw [shape, complexConj.pair, complexNormSquared.pair, complexNormSquared.pair]
    ring
  rw ← same at square
  exact complexAbs.unique with conjugate, nonnegative, square

theorem complexAbs.of_real (a : Real)
  shows complexAbs(complexOfReal(a)) = abs(a)
proof
  have aIn : a ∈ ℝ by typecheck
  have member : complexOfReal(a) ∈ ℂ by exact FunctionBetween.apply_closed with complexOfReal.function, aIn
  have nonnegative := abs.nonnegative at a
  have squareNonnegative := realMulValue.square_nonnegative at a
  have square : R[abs(a) * abs(a)] = complexNormSquared(complexOfReal(a))
    rw [← abs.mul, abs.of_nonnegative with squareNonnegative, complexOfReal.value with aIn, complexNormSquared.pair]
    ring
  exact complexAbs.unique with member, nonnegative, square

theorem complexAbs.one
  shows complexAbs(ℂ[1]) = R[1]
proof
  have nonnegative : R[0] ≤ R[1] by exact realLess.implies_le with realZero.lt_one
  have square : R[1 * 1] = complexNormSquared(ℂ[1])
    rw complexNormSquared.one
    ring
  exact complexAbs.unique with complexOne.member, nonnegative, square

theorem complexAbs.pow (z : Set) (n : Nat)
  requires hz : z ∈ ℂ
  shows complexAbs(ℂ[z ^ n]) = R[complexAbs(z) ^ n]
proof
  induction n
  | zero =>
    rw [monoidPow.zero, monoidPow.zero]
    exact complexAbs.one
  | succ(k) using ih =>
    have ring := complexes.comm_ring
    have ordinary := IsCommRing.ring with ring
    have monoid := IsRing.multiplicative with ordinary
    have power := monoidPow.closed at ℂ, complexMul, complexOne, z, k with monoid, hz
    have product := complexAbs.mul with hz, power
    rw [monoidPow.succ, monoidPow.succ, product, ih]

theorem complexAbs.re_le (z : Set)
  requires hz : z ∈ ℂ
  shows abs(complexRe(z)) ≤ complexAbs(z)
proof
  have reReal := complexRe.real with hz
  have imReal := complexIm.real with hz
  have nonnegative := abs.nonnegative at complexRe(z)
  have absNonnegative := complexAbs.nonnegative with hz
  have square := complexAbs.square with hz
  have parts := complexNormSquared.parts with hz
  have imSquare := realMulValue.square_nonnegative at complexIm(z)
  have reSquare := realMulValue.square_nonnegative at complexRe(z)
  have absSquare : R[abs(complexRe(z)) * abs(complexRe(z))] = R[complexRe(z) * complexRe(z)]
    rw [← abs.mul, abs.of_nonnegative with reSquare]
  have squares : R[abs(complexRe(z)) * abs(complexRe(z))] ≤ R[complexAbs(z) * complexAbs(z)]
    rw [absSquare, square, parts]
    linarith
  exact realMulValue.le_of_square_le with nonnegative, absNonnegative, squares

theorem complexAbs.im_le (z : Set)
  requires hz : z ∈ ℂ
  shows abs(complexIm(z)) ≤ complexAbs(z)
proof
  have reReal := complexRe.real with hz
  have imReal := complexIm.real with hz
  have nonnegative := abs.nonnegative at complexIm(z)
  have absNonnegative := complexAbs.nonnegative with hz
  have square := complexAbs.square with hz
  have parts := complexNormSquared.parts with hz
  have imSquare := realMulValue.square_nonnegative at complexIm(z)
  have reSquare := realMulValue.square_nonnegative at complexRe(z)
  have absSquare : R[abs(complexIm(z)) * abs(complexIm(z))] = R[complexIm(z) * complexIm(z)]
    rw [← abs.mul, abs.of_nonnegative with imSquare]
  have squares : R[abs(complexIm(z)) * abs(complexIm(z))] ≤ R[complexAbs(z) * complexAbs(z)]
    rw [absSquare, square, parts]
    linarith
  exact realMulValue.le_of_square_le with nonnegative, absNonnegative, squares

-- Section: Inverse
theorem complexInv.member (z : Set)
  requires hz : z ∈ ℂ
  shows complexInv(z) ∈ ℂ
proof
  have field := complexes.is_field
  have function := fieldInverse.function at complexCarrier, complexAdd, complexZero, complexNeg, complexMul, complexOne with field
  unfold complexInv
  exact FunctionBetween.apply_closed with function, hz

theorem complexInv.right_inverse (z : Set)
  requires hz : z ∈ ℂ
  requires nonzero : z ≠ ℂ[0]
  shows IsInverse(ℂ, complexMul, complexOne, z, complexInv(z))
proof
  have field := complexes.is_field
  unfold complexInv
  exact fieldInverse.inverse with field, hz, nonzero

-- A right inverse is the inverse.
theorem complexInv.unique (z x : Set)
  requires hz : z ∈ ℂ
  requires hx : x ∈ ℂ
  requires product : ℂ[z * x] = ℂ[1]
  shows complexInv(z) = x
proof
  have nonzero : z ≠ ℂ[0]
    intro zero
    rw zero at product
    have vanishes : ℂ[0 * x] = ℂ[0] by ring
    have distinct := complexRing.nontrivial
    rw [complexRing.zeroOf, complexRing.oneOf] at distinct
    apply distinct
    rw [← vanishes, product]
  have inverse := complexInv.right_inverse with hz, nonzero
  have commutes : ℂ[x * z] = ℂ[1]
    rw ← product
    ring
  have other : IsInverse(ℂ, complexMul, complexOne, z, x)
    unfold IsInverse
    refine ⟨hz, hx, commutes, product⟩
  have ring := complexes.comm_ring
  have ordinary := IsCommRing.ring with ring
  have monoid := IsRing.multiplicative with ordinary
  exact IsInverse.unique with monoid, inverse, other

theorem complexInv.mul_cancel (z : Set)
  requires hz : z ∈ ℂ
  requires nonzero : z ≠ ℂ[0]
  shows ℂ[z * complexInv(z)] = ℂ[1]
proof
  have inverse := complexInv.right_inverse with hz, nonzero
  obtain ⟨_, _, _, right⟩ := inverse
  exact right

theorem complexInv.zero
  shows complexInv(ℂ[0]) = ℂ[0]
proof
  have field := complexes.is_field
  unfold complexInv
  exact fieldInverse.zero with field

theorem complexInv.nonzero (z : Set)
  requires hz : z ∈ ℂ
  requires nonzero : z ≠ ℂ[0]
  shows complexInv(z) ≠ ℂ[0]
proof
  intro zero
  have cancel := complexInv.mul_cancel with hz, nonzero
  rw zero at cancel
  have vanishes : ℂ[z * 0] = ℂ[0] by ring
  have distinct := complexRing.nontrivial
  rw [complexRing.zeroOf, complexRing.oneOf] at distinct
  apply distinct
  rw [← vanishes, cancel]

theorem complexInv.mul (z w : Set)
  requires hz : z ∈ ℂ
  requires hw : w ∈ ℂ
  shows complexInv(ℂ[z * w]) = ℂ[complexInv(z) * complexInv(w)]
proof
  have ring := complexes.comm_ring
  have ordinary := IsCommRing.ring with ring
  have product := IsRing.mul_closed with ordinary, hz, hw
  have zInverse := complexInv.member with hz
  have wInverse := complexInv.member with hw
  have zCases : z = ℂ[0] ∨ z ≠ ℂ[0] by tauto
  cases zCases with zZero | zNonzero
  . rw zZero
    have left : ℂ[0 * w] = ℂ[0] by ring
    have right : ℂ[0 * complexInv(w)] = ℂ[0] by ring
    rw [left, complexInv.zero, right]
  . have wCases : w = ℂ[0] ∨ w ≠ ℂ[0] by tauto
    cases wCases with wZero | wNonzero
    . rw wZero
      have left : ℂ[z * 0] = ℂ[0] by ring
      have right : ℂ[complexInv(z) * 0] = ℂ[0] by ring
      rw [left, complexInv.zero, right]
    . have zCancel := complexInv.mul_cancel with hz, zNonzero
      have wCancel := complexInv.mul_cancel with hw, wNonzero
      have inverses := IsRing.mul_closed with ordinary, zInverse, wInverse
      have cancel : ℂ[(z * w) * (complexInv(z) * complexInv(w))] = ℂ[1]
        have regroup : ℂ[(z * w) * (complexInv(z) * complexInv(w))] = ℂ[(z * complexInv(z)) * (w * complexInv(w))] by ring
        rw [regroup, zCancel, wCancel]
        ring
      exact complexInv.unique with product, inverses, cancel

theorem complexInv.abs (z : Set)
  requires hz : z ∈ ℂ
  requires nonzero : z ≠ ℂ[0]
  shows complexAbs(complexInv(z)) = R[1 / complexAbs(z)]
proof
  have inverse := complexInv.member with hz
  have cancel := complexInv.mul_cancel with hz, nonzero
  have positive := complexAbs.positive with hz, nonzero
  have absNonzero : complexAbs(z) ≠ R[0]
    intro zero
    rw zero at positive
    exact realLess.irreflexive_on with R[0], positive
  have product := complexAbs.mul with hz, inverse
  rw [cancel, complexAbs.one] at product
  have law : R[complexAbs(z) * complexAbs(complexInv(z))] = R[1] by rw product
  have inverseValue := realInvValue.eq_of_mul_right with absNonzero, law
  rw [realDiv.eq_mul_inv, inverseValue]
  ring

theorem complexInv.of_real (a : Real)
  requires nonzero : a ≠ R[0]
  shows complexInv(complexOfReal(a)) = complexOfReal(R[1 / a])
proof
  have aIn : a ∈ ℝ by typecheck
  have quotientIn : R[1 / a] ∈ ℝ by typecheck
  have member : complexOfReal(a) ∈ ℂ by exact FunctionBetween.apply_closed with complexOfReal.function, aIn
  have quotient : complexOfReal(R[1 / a]) ∈ ℂ by exact FunctionBetween.apply_closed with complexOfReal.function, quotientIn
  have cancel := realDiv.mul_left at R[1], a with nonzero
  have product : ℂ[complexOfReal(a) * complexOfReal(R[1 / a])] = ℂ[1]
    rw [← complexOfReal.mul, cancel, complexOfReal.one]
  exact complexInv.unique with member, quotient, product

theorem complexDiv.mul_cancel (z w : Set)
  requires hz : z ∈ ℂ
  requires hw : w ∈ ℂ
  requires nonzero : w ≠ ℂ[0]
  shows ℂ[complexDiv(z, w) * w] = z
proof
  have cancel := complexInv.mul_cancel with hw, nonzero
  have inverse := complexInv.member with hw
  unfold complexDiv
  have regroup : ℂ[(z * complexInv(w)) * w] = ℂ[z * (w * complexInv(w))] by ring
  rw [regroup, cancel]
  ring

-- Section: Series
theorem ComplexConvergesTo.unique (u a b : Set)
  requires first : ComplexConvergesTo(u, a)
  requires second : ComplexConvergesTo(u, b)
  shows a = b
proof
  obtain ⟨sequence, aIn, ax, ay⟩ := first
  obtain ⟨_, bIn, bx, by⟩ := second
  have xs := ConvergesTo.unique with ax, bx
  have ys := ConvergesTo.unique with ay, by
  have aPoint := complex.point with aIn
  have bPoint := complex.point with bIn
  have aCoordinates := Euclidean.coordinates at a
  have bCoordinates := Euclidean.coordinates at b
  rw [aCoordinates, bCoordinates]
  exact complex.pair_congr with xs, ys

-- Convergence in ℂ is convergence of |uₙ − a| to 0.
theorem ComplexConvergesTo.iff_abs (u a : Set)
  requires sequence : ComplexSequence(u)
  requires ha : a ∈ ℂ
  shows ComplexConvergesTo(u, a) ↔
    (∀ e ∈ ℝ, R[0] < e → ∃ N ∈ ℕ, ∀ n ∈ ℕ, N ≤ n →
      complexAbs(ℂ[u(n) - a]) < e)
proof
  have ring := complexes.comm_ring
  have ordinary := IsCommRing.ring with ring
  have negated := IsRing.neg_closed with ordinary, ha
  have function : u : ℕ → ℂ by exact sequence
  constructor
  . intro converges
    intros e eIn positive
    have eReal : Real(e) by exact eIn
    have squarePositive := realMulValue.positive with positive, positive
    obtain ⟨N, natural, close⟩ := ComplexConvergesTo.eventually_squared_distance at u, a, R[e * e] with converges, squarePositive
    refine ⟨N, natural, ?_⟩
    intros n nIn after
    have term := FunctionBetween.apply_closed with function, nIn
    have difference := IsRing.add_closed with ordinary, term, negated
    have near := close with n, nIn, after
    have nonnegative := complexAbs.nonnegative with difference
    have square := complexAbs.square with difference
    rw ← square at near
    have bound := realSquare.abs_lt_of_lt_square at complexAbs(ℂ[u(n) - a]), e with positive, near
    rwa abs.of_nonnegative with nonnegative at bound
  . intro close
    apply ComplexConvergesTo.of_squared_distance with sequence, ha
    intros e eIn positive
    have eReal : Real(e) by exact eIn
    have eNonnegative := realLess.implies_le with positive
    have rootNonnegative := realSqrt.nonneg with eNonnegative
    have rootSquare := realSqrt.square with eNonnegative
    have rootNonzero : realSqrt(e) ≠ R[0]
      intro zero
      rw zero at rootSquare
      have vanishes : R[0 * 0] = R[0] by ring
      rw vanishes at rootSquare
      rw ← rootSquare at positive
      exact realLess.irreflexive_on with R[0], positive
    have rootPositive := Real.positive_of_nonnegative_of_ne_zero with rootNonnegative, rootNonzero
    have rootIn : realSqrt(e) ∈ ℝ by typecheck
    obtain ⟨N, natural, near⟩ := close with realSqrt(e), rootIn, rootPositive
    refine ⟨N, natural, ?_⟩
    intros n nIn after
    have term := FunctionBetween.apply_closed with function, nIn
    have difference := IsRing.add_closed with ordinary, term, negated
    have small := near with n, nIn, after
    have nonnegative := complexAbs.nonnegative with difference
    have square := complexAbs.square with difference
    have smallLe := realLess.implies_le with small
    have first := realLe.mul_left_of_nonnegative at complexAbs(ℂ[u(n) - a]), realSqrt(e), complexAbs(ℂ[u(n) - a]) with smallLe, nonnegative
    have second := realLess.mul_right_of_positive at complexAbs(ℂ[u(n) - a]), realSqrt(e), realSqrt(e) with small, rootPositive
    have combined := realLe.transitive_less with first, second
    rwa [square, rootSquare] at combined

theorem complexPartialSum.zero (u : Set)
  shows complexPartialSum(u, 0) = ℂ[0]
proof
  rw complexPartialSum
  rfl

theorem complexPartialSum.succ (u : Set) (n : Nat)
  shows complexPartialSum(u, succ(n)) = ℂ[complexPartialSum(u, n) + u(n)]
proof
  rw complexPartialSum
  rfl

theorem complexPartialSum.member (u : Set) (n : Nat)
  requires sequence : ComplexSequence(u)
  shows complexPartialSum(u, n) ∈ ℂ
proof
  exact complexPartialSum.closed at u, n with sequence

theorem ComplexSumsTo.unique (u S T : Set)
  requires first : ComplexSumsTo(u, S)
  requires second : ComplexSumsTo(u, T)
  shows S = T
proof
  obtain ⟨_, firstLimit⟩ := first
  obtain ⟨_, secondLimit⟩ := second
  exact ComplexConvergesTo.unique with firstLimit, secondLimit

theorem ComplexSumsTo.member (u S : Set)
  requires sums : ComplexSumsTo(u, S)
  shows S ∈ ℂ
proof
  obtain ⟨sequence, converges⟩ := sums
  obtain ⟨_, member, _⟩ := converges
  exact member

theorem complexRe.x (z : Set)
  requires hz : z ∈ ℂ
  shows Euclidean.x(z) = complexRe(z)
proof
  obtain ⟨a, aReal, b, bReal, shape⟩ := complexCarrier.cases with hz
  unfold complexRe
  rw [shape, Euclidean.x.pair, fst.pair]

theorem complexIm.y (z : Set)
  requires hz : z ∈ ℂ
  shows Euclidean.y(z) = complexIm(z)
proof
  obtain ⟨a, aReal, b, bReal, shape⟩ := complexCarrier.cases with hz
  unfold complexIm
  rw [shape, Euclidean.y.pair, snd.pair]

theorem complexAdd.x (z w : Set)
  requires hz : z ∈ ℂ
  requires hw : w ∈ ℂ
  shows Euclidean.x(ℂ[z + w]) = R[Euclidean.x(z) + Euclidean.x(w)]
proof
  obtain ⟨a, aReal, b, bReal, zShape⟩ := complexCarrier.cases with hz
  obtain ⟨c, cReal, d, dReal, wShape⟩ := complexCarrier.cases with hw
  simp [zShape, wShape, complexAdd.pair, Euclidean.x.pair]

theorem complexAdd.y (z w : Set)
  requires hz : z ∈ ℂ
  requires hw : w ∈ ℂ
  shows Euclidean.y(ℂ[z + w]) = R[Euclidean.y(z) + Euclidean.y(w)]
proof
  obtain ⟨a, aReal, b, bReal, zShape⟩ := complexCarrier.cases with hz
  obtain ⟨c, cReal, d, dReal, wShape⟩ := complexCarrier.cases with hw
  simp [zShape, wShape, complexAdd.pair, Euclidean.y.pair]

-- The coordinates of a partial sum are the partial sums of the coordinates.
theorem complexPartialSum.x (u : Set) (n : Nat)
  requires sequence : ComplexSequence(u)
  shows Euclidean.x(complexPartialSum(u, n)) = ∑ i < n, complexSequenceX(u)(i)
proof
  induction n
  | zero =>
    rw [complexPartialSum.zero, realPartialSum.zero]
    unfold complexZero
    rw Euclidean.x.pair
  | succ(k) using ih =>
    have kIn := nat.omega.forward at k with assumption
    have function : u : ℕ → ℂ by exact sequence
    have term := FunctionBetween.apply_closed with function, kIn
    have partial := complexPartialSum.closed at u, k with sequence
    have sum := complexAdd.x with partial, term
    have value := complexSequenceX.value at u, k with sequence
    rw [complexPartialSum.succ, realPartialSum.succ, sum, ih, value]
    simp [realAddValue, call2]

theorem complexPartialSum.y (u : Set) (n : Nat)
  requires sequence : ComplexSequence(u)
  shows Euclidean.y(complexPartialSum(u, n)) = ∑ i < n, complexSequenceY(u)(i)
proof
  induction n
  | zero =>
    rw [complexPartialSum.zero, realPartialSum.zero]
    unfold complexZero
    rw Euclidean.y.pair
  | succ(k) using ih =>
    have kIn := nat.omega.forward at k with assumption
    have function : u : ℕ → ℂ by exact sequence
    have term := FunctionBetween.apply_closed with function, kIn
    have partial := complexPartialSum.closed at u, k with sequence
    have sum := complexAdd.y with partial, term
    have value := complexSequenceY.value at u, k with sequence
    rw [complexPartialSum.succ, realPartialSum.succ, sum, ih, value]
    simp [realAddValue, call2]

theorem complexSequenceX.prefix (u : Set)
  requires sequence : ComplexSequence(u)
  shows complexSequenceX(complexPrefixSums(u)) = prefixSums(complexSequenceX(u))
proof
  have prefixes : ComplexSequence(complexPrefixSums(u)) by exact complexPrefixSums.function with sequence
  have left := complexSequenceX.function at complexPrefixSums(u) with prefixes
  have xs := complexSequenceX.sequence with sequence
  have right : prefixSums(complexSequenceX(u)) : ℕ → ℝ by exact prefixSums.sequence with xs
  apply FunctionBetween.ext with left, right
  intros n nIn
  have nNat := nat.omega.backward at n with nIn
  have xValue := complexSequenceX.value at complexPrefixSums(u), n with prefixes
  have prefixValue := complexPrefixSums.value at u, n with nIn, sequence
  have sumValue := prefixSums.value at complexSequenceX(u), n with nIn
  rw [xValue, prefixValue, sumValue]
  exact complexPartialSum.x at u, n with sequence

theorem complexSequenceY.prefix (u : Set)
  requires sequence : ComplexSequence(u)
  shows complexSequenceY(complexPrefixSums(u)) = prefixSums(complexSequenceY(u))
proof
  have prefixes : ComplexSequence(complexPrefixSums(u)) by exact complexPrefixSums.function with sequence
  have left := complexSequenceY.function at complexPrefixSums(u) with prefixes
  have ys := complexSequenceY.sequence with sequence
  have right : prefixSums(complexSequenceY(u)) : ℕ → ℝ by exact prefixSums.sequence with ys
  apply FunctionBetween.ext with left, right
  intros n nIn
  have nNat := nat.omega.backward at n with nIn
  have yValue := complexSequenceY.value at complexPrefixSums(u), n with prefixes
  have prefixValue := complexPrefixSums.value at u, n with nIn, sequence
  have sumValue := prefixSums.value at complexSequenceY(u), n with nIn
  rw [yValue, prefixValue, sumValue]
  exact complexPartialSum.y at u, n with sequence

-- A complex series sums to (A, B) when its coordinates sum to A and B.
theorem ComplexSumsTo.of_parts (u : Set) (A B : Real)
  requires sequence : ComplexSequence(u)
  requires horizontal : SumsTo(complexSequenceX(u), A)
  requires vertical : SumsTo(complexSequenceY(u), B)
  shows ComplexSumsTo(u, (A, B))
proof
  have prefixes : ComplexSequence(complexPrefixSums(u)) by exact complexPrefixSums.function with sequence
  have member := complexCarrier.pair at A, B
  have xConverges := SumsTo.converges with horizontal
  have yConverges := SumsTo.converges with vertical
  have xPrefix := complexSequenceX.prefix with sequence
  have yPrefix := complexSequenceY.prefix with sequence
  unfold ComplexSumsTo
  refine ⟨sequence, ?_⟩
  unfold ComplexConvergesTo
  refine ⟨prefixes, member, ?_, ?_⟩
  . rw [Euclidean.x.pair, xPrefix]
    exact xConverges
  . rw [Euclidean.y.pair, yPrefix]
    exact yConverges

-- A nondecreasing sequence stays below its limit.
theorem Nondecreasing.le_limit (u : Set) (L : Real, n : Nat)
  requires sequence : RealSequence(u)
  requires increasing : Nondecreasing(u)
  requires converges : ConvergesTo(u, L)
  shows (u(n):R) ≤ L
proof
  have shifted := ConvergesTo.shifted at u, L, n with converges
  have term := RealSequence.value at u, n with sequence
  have below : BoundedBelowBy(shiftedRealSequence(u, n), u(n))
    intros k kIn
    have kNat := nat.omega.backward at k with kIn
    have nIn := nat.omega.forward at n with assumption
    have sumIn := nat.omega.forward at add(n, k) with assumption
    have later : n ≤ add(n, k) by arith
    rw shiftedRealSequence.value at u, n, k with sequence
    exact increasing with n, nIn, add(n, k), sumIn, later
  exact ConvergesTo.ge_constant with shifted, below

-- The partial sums of a series of nonnegative terms increase.
theorem prefixSums.nondecreasing (v : Set)
  requires sequence : RealSequence(v)
  requires nonnegative : NonnegativeTerms(v)
  shows Nondecreasing(prefixSums(v))
proof
  have sums := prefixSums.sequence with sequence
  apply StepwiseNondecreasing.nondecreasing with sums
  intros n nIn
  have nNat := nat.omega.backward at n with nIn
  have succIn := nat.omega.forward at succ(n) with assumption
  have term := RealSequence.value at v, n with sequence
  have partial := realPartialSum.real at v, n with sequence
  have termNonnegativeRaw := nonnegative with n, nIn
  have termNonnegative := realLe.characterization.backward with termNonnegativeRaw
  apply realLe.characterization.forward
  rw [(prefixSums.value at v, n with nIn), (prefixSums.value at v, succ(n) with succIn), realPartialSum.succ]
  linarith

-- Every partial sum of a convergent series of nonnegative terms is at most
-- its sum.
theorem SumsTo.partial_le (v : Set) (V : Real, n : Nat)
  requires sums : SumsTo(v, V)
  requires nonnegative : NonnegativeTerms(v)
  shows (∑ i < n, v(i):R) ≤ V
proof
  have sequence := SumsTo.sequence with sums
  have converges := SumsTo.converges with sums
  have partials := prefixSums.sequence with sequence
  have increasing := prefixSums.nondecreasing with sequence, nonnegative
  have bound := Nondecreasing.le_limit at prefixSums(v), V, n with partials, increasing, converges
  have nIn := nat.omega.forward at n with assumption
  rwa prefixSums.value at v, n with nIn at bound

-- Comparison: a series of nonnegative terms dominated by a convergent
-- series converges.
theorem Summable.of_nonnegative_le (w v : Set)
  requires sequence : RealSequence(w)
  requires summable : Summable(v)
  requires nonnegative : NonnegativeTerms(w)
  requires dominated : PointwiseLE(w, v)
  shows Summable(w)
proof
  obtain ⟨V, vIn, sums⟩ := summable
  have vSequence := SumsTo.sequence with sums
  have vNonnegative : NonnegativeTerms(v)
    intros n nIn
    have nNat := nat.omega.backward at n with nIn
    have wTerm := RealSequence.value at w, n with sequence
    have vTerm := RealSequence.value at v, n with vSequence
    have firstRaw := nonnegative with n, nIn
    have first := realLe.characterization.backward with firstRaw
    have secondRaw := dominated with n, nIn
    have second := realLe.characterization.backward with secondRaw
    apply realLe.characterization.forward
    linarith
  have partials := prefixSums.sequence with sequence
  have increasing := prefixSums.nondecreasing with sequence, nonnegative
  have bounded : BoundedAboveBy(prefixSums(w), V)
    intros n nIn
    have nNat := nat.omega.backward at n with nIn
    have termwise : ∀ k ∈ ℕ, (w[k]:R) ≤ (v[k]:R)
      intros k kIn
      have raw := dominated with k, kIn
      exact realLe.characterization.backward with raw
    have compared := realPartialSum.monotone at w, v, n with sequence, vSequence, termwise
    have total := SumsTo.partial_le at v, V, n with sums, vNonnegative
    have wPartial := realPartialSum.real at w, n with sequence
    have vPartial := realPartialSum.real at v, n with vSequence
    apply realLe.characterization.forward
    rw prefixSums.value at w, n with nIn
    linarith
  have inhabited := RealSequence.range_nonempty with partials
  have rangeUpper := BoundedAboveBy.range_upper_bound with partials, bounded
  have least := realSup.least_upper_bound with inhabited, rangeUpper
  have supUpper : RealUpperBound(range(prefixSums(w)), realSup(range(prefixSums(w)))) by simp [RealLeastUpperBound]
  rcases supUpper with ⟨supReal, _, _⟩
  have typedSup : Real(realSup(range(prefixSums(w)))) by exact supReal
  have converges := Nondecreasing.converges_to_supremum with partials, increasing, bounded
  have sumsW := SumsTo.of_converges with sequence, converges
  exact SumsTo.summable with sumsW

-- Comparison: a real series whose absolute values are dominated by a
-- convergent series converges.
theorem Summable.of_abs_le (u v : Set)
  requires sequence : RealSequence(u)
  requires summable : Summable(v)
  requires dominated : ∀ n ∈ ℕ, abs(u(n)) ≤ v(n)
  shows Summable(u)
proof
  obtain ⟨V, vIn, sums⟩ := summable
  have vSequence := SumsTo.sequence with sums
  have shifted := addSequence.sequence with sequence, vSequence
  have doubled := addSequence.sequence with vSequence, vSequence
  have nonnegative : NonnegativeTerms(addSequence(u, v))
    intros n nIn
    have nNat := nat.omega.backward at n with nIn
    have uTerm := RealSequence.value at u, n with sequence
    have vTerm := RealSequence.value at v, n with vSequence
    have bound := dominated with n, nIn
    have lower := abs.upper_neg at u(n)
    apply realLe.characterization.forward
    rw addSequence.value at u, v, n with sequence, vSequence, uTerm, vTerm
    linarith
  have below : PointwiseLE(addSequence(u, v), addSequence(v, v))
    intros n nIn
    have nNat := nat.omega.backward at n with nIn
    have uTerm := RealSequence.value at u, n with sequence
    have vTerm := RealSequence.value at v, n with vSequence
    have bound := dominated with n, nIn
    have upper := abs.upper at u(n)
    apply realLe.characterization.forward
    rw [(addSequence.value at u, v, n with sequence, vSequence, uTerm, vTerm), (addSequence.value at v, v, n with vSequence, vSequence, vTerm, vTerm)]
    linarith
  have vSummable := SumsTo.summable with sums
  have doubleSummable := Summable.add with vSummable, vSummable
  have shiftedSummable := Summable.of_nonnegative_le with shifted, doubleSummable, nonnegative, below
  have difference := Summable.sub with shiftedSummable, vSummable
  have differenceSequence := subSequence.sequence with shifted, vSequence
  have same : subSequence(addSequence(u, v), v) = u
    apply FunctionBetween.ext with differenceSequence, sequence
    intros n nIn
    have nNat := nat.omega.backward at n with nIn
    have uTerm := RealSequence.value at u, n with sequence
    have vTerm := RealSequence.value at v, n with vSequence
    have sTerm := RealSequence.value at addSequence(u, v), n with shifted
    rw [(subSequence.value at addSequence(u, v), v, n with shifted, vSequence, sTerm, vTerm), (addSequence.value at u, v, n with sequence, vSequence, uTerm, vTerm)]
    ring
  rwa same at difference

-- An absolutely convergent series converges.
theorem ComplexAbsolutelySummable.summable (u : Set)
  requires absolute : ComplexAbsolutelySummable(u)
  shows ComplexSummable(u)
proof
  obtain ⟨sequence, summable⟩ := absolute
  have xs := complexSequenceX.sequence with sequence
  have ys := complexSequenceY.sequence with sequence
  have function : u : ℕ → ℂ by exact sequence
  have xBound : ∀ n ∈ ℕ, abs(complexSequenceX(u)(n)) ≤ complexAbsSequence(u)(n)
    intros n nIn
    have nNat := nat.omega.backward at n with nIn
    have term := FunctionBetween.apply_closed with function, nIn
    have xValue := complexSequenceX.value at u, n with sequence
    have absValue := complexAbsSequence.value at u, n with sequence
    have coordinate := complexRe.x with term
    rw [xValue, absValue, coordinate]
    exact complexAbs.re_le with term
  have yBound : ∀ n ∈ ℕ, abs(complexSequenceY(u)(n)) ≤ complexAbsSequence(u)(n)
    intros n nIn
    have nNat := nat.omega.backward at n with nIn
    have term := FunctionBetween.apply_closed with function, nIn
    have yValue := complexSequenceY.value at u, n with sequence
    have absValue := complexAbsSequence.value at u, n with sequence
    have coordinate := complexIm.y with term
    rw [yValue, absValue, coordinate]
    exact complexAbs.im_le with term
  have xSummable := Summable.of_abs_le with xs, summable, xBound
  have ySummable := Summable.of_abs_le with ys, summable, yBound
  obtain ⟨A, aIn, xSums⟩ := xSummable
  obtain ⟨B, bIn, ySums⟩ := ySummable
  have sums := ComplexSumsTo.of_parts at u, A, B with sequence, xSums, ySums
  have member := complexCarrier.pair at A, B
  witness (A, B)
  refine ⟨member, sums⟩

-- Comparison with a convergent series of real bounds.
theorem ComplexAbsolutelySummable.of_bound (u v : Set)
  requires sequence : ComplexSequence(u)
  requires bounds : Summable(v)
  requires dominated : ∀ n ∈ ℕ, complexAbs(u(n)) ≤ v(n)
  shows ComplexAbsolutelySummable(u)
proof
  have absSequence : RealSequence(complexAbsSequence(u)) by exact complexAbsSequence.function with sequence
  have function : u : ℕ → ℂ by exact sequence
  have nonnegative : NonnegativeTerms(complexAbsSequence(u))
    intros n nIn
    have nNat := nat.omega.backward at n with nIn
    have term := FunctionBetween.apply_closed with function, nIn
    have absValue := complexAbsSequence.value at u, n with sequence
    apply realLe.characterization.forward
    rw absValue
    exact complexAbs.nonnegative with term
  have below : PointwiseLE(complexAbsSequence(u), v)
    intros n nIn
    have nNat := nat.omega.backward at n with nIn
    have absValue := complexAbsSequence.value at u, n with sequence
    apply realLe.characterization.forward
    rw absValue
    exact dominated with n, nIn
  have absSummable := Summable.of_nonnegative_le with absSequence, bounds, nonnegative, below
  unfold ComplexAbsolutelySummable
  refine ⟨sequence, absSummable⟩

-- Section: The exponential series
-- The terms zⁿ/n! and the real terms xⁿ/n!.
defgraph expTerms (z : Set) (n ∈ ℕ) : complexCarrier :=
    ℂ[complexOfReal(R[1 / n!]) * z ^ n]
requires hz : z ∈ complexCarrier
proof
  have nNat := nat.omega.backward at n with member
  have ring := complexes.comm_ring
  have ordinary := IsCommRing.ring with ring
  have monoid := IsRing.multiplicative with ordinary
  have coefficientIn : R[1 / factorial(n)] ∈ ℝ by typecheck
  have coefficient := FunctionBetween.apply_closed with complexOfReal.function, coefficientIn
  have power := monoidPow.closed at ℂ, complexMul, complexOne, z, n with monoid, hz
  exact IsRing.mul_closed with ordinary, coefficient, power

defgraph realExpTerms (X : Real) (n ∈ ℕ) : ℝ := X ^ n / n!
proof
  have nNat := nat.omega.backward at n with member
  typecheck

theorem realNat.factorial_successor (n : Nat)
  shows realNat(factorial(succ(n))) = R[(realNat(n) + 1) * realNat(factorial(n))]
proof
  have unfolded : factorial(succ(n)) = mul(succ(n), factorial(n)) by rw factorial
  rw [unfolded, realNat.mul, realNat.succ]
  simp [realAddValue, call2]

theorem realNat.factorial_pos (n : Nat)
  shows R[0] < realNat(factorial(n))
proof
  induction n
  | zero =>
    have unfolded : factorial(0) = (1:N) by rw factorial
    rw [unfolded, realNat.one]
    exact realZero.lt_one
  | succ(k) using ih =>
    have natReal := realNat.real at k
    have natNonnegative := realNat.nonnegative at k
    have one := realZero.lt_one
    have successorPositive : R[0] < R[realNat(k) + 1] by linarith
    rw realNat.factorial_successor
    exact realMulValue.positive with successorPositive, ih

theorem realExpTerms.nonnegative (X : Real) (n : Nat)
  requires nonnegative : R[0] ≤ X
  shows R[0] ≤ realExpTerms(X)(n)
proof
  have nIn := nat.omega.forward at n with assumption
  have power := realPow.nonnegative at X, n with nonnegative
  unfold realPow at power
  have positive := realNat.factorial_pos at n
  have inverse := realInvValue.positive with positive
  have inverseNonnegative := realLess.implies_le with inverse
  rw [(realExpTerms.value at X, n with nIn), realDiv.eq_mul_inv]
  exact realMulValue.nonnegative with power, inverseNonnegative

-- The ratio of consecutive terms: (n + 1)·xⁿ⁺¹/(n + 1)! = x·xⁿ/n!.
theorem realExpTerms.succ (X : Real) (n : Nat)
  shows R[(realNat(n) + 1) * realExpTerms(X)(succ(n))] = R[X * realExpTerms(X)(n)]
proof
  have nIn := nat.omega.forward at n with assumption
  have succIn := nat.omega.forward at succ(n) with assumption
  have positive := realNat.factorial_pos at n
  have successorPositive := realNat.positive_succ at n
  have factorialNonzero : realNat(factorial(n)) ≠ R[0]
    intro zero
    rw zero at positive
    exact realLess.irreflexive_on with R[0], positive
  have successorNonzero : R[realNat(n) + 1] ≠ R[0]
    intro zero
    have same : realNat(succ(n)) = R[realNat(n) + 1]
      rw realNat.succ
      simp [realAddValue, call2]
    rw [same, zero] at successorPositive
    exact realLess.irreflexive_on with R[0], successorPositive
  have cancel := realInvValue.mul_right with successorNonzero
  have split := realInvValue.mul with successorNonzero, factorialNonzero
  rw [(realExpTerms.value at X, succ(n) with succIn), (realExpTerms.value at X, n with nIn), realDiv.eq_mul_inv, realDiv.eq_mul_inv, realNat.factorial_successor, split, monoidPow.succ]
  have regroup : R[(realNat(n) + 1) * ((X * X ^ n) * (realInvValue(realNat(n) + 1) * realInvValue(realNat(factorial(n)))))] = R[((realNat(n) + 1) * realInvValue(realNat(n) + 1)) * (X * (X ^ n * realInvValue(realNat(factorial(n)))))] by ring
  rw [regroup, cancel]
  ring

theorem realPow.exponent_monotone (A : Real) (m n : Nat)
  requires above : R[1] ≤ A
  requires le : m ≤ n
  shows (R[A ^ m]:R) ≤ R[A ^ n]
proof
  obtain ⟨k, kNat, sum⟩ := le
  have nonnegative : R[0] ≤ A
    have zeroOne := realLess.implies_le with realZero.lt_one
    linarith
  have mPower := realPow.nonnegative at A, m with nonnegative
  have kPower := realPow.one_le at A, k with above
  have split := realPow.add at A, m, k
  unfold realPow at mPower
  unfold realPow at kPower
  unfold realPow at split
  rw [← sum, split]
  have product := realLe.mul_left_of_nonnegative at R[1], R[A ^ k], R[A ^ m] with kPower, mPower
  have unit : R[A ^ m * 1] = R[A ^ m] by ring
  rwa unit at product

theorem realExpTerms.zero (X : Real)
  shows realExpTerms(X)(0) = R[1]
proof
  have zeroIn := nat.omega.forward at 0 with assumption
  have unfolded : factorial(0) = (1:N) by rw factorial
  have oneNonzero := realZero.ne_one
  have nonzero : R[1] ≠ R[0]
    intro same
    apply oneNonzero
    rw same
  rw [(realExpTerms.value at X, 0 with zeroIn), monoidPow.zero, unfolded, realNat.one]
  exact realDiv.self with nonzero

-- xⁿ/n! ≤ (1 + x)ⁿ for x ≥ 0.
theorem realExpTerms.power_bound (S : Real) (n : Nat)
  requires nonnegative : R[0] ≤ S
  shows (realExpTerms(S)(n):R) ≤ R[(1 + S) ^ n]
proof
  induction n
  | zero =>
    rw [realExpTerms.zero, monoidPow.zero]
    exact realLe.reflexive at R[1]
  | succ(k) using ih =>
    have recurrence := realExpTerms.succ at S, k
    have current := realExpTerms.nonnegative at S, k with nonnegative
    have next := realExpTerms.nonnegative at S, succ(k) with nonnegative
    have natNonnegative := realNat.nonnegative at k
    have natReal := realNat.real at k
    have power := realPow.nonnegative at R[1 + S], k
    unfold realPow at power
    have weighted := realMulValue.nonnegative with natNonnegative, next
    have scaled := realLe.mul_left_of_nonnegative with ih, nonnegative
    have expandLeft : R[(realNat(k) + 1) * realExpTerms(S)(succ(k))] = R[realNat(k) * realExpTerms(S)(succ(k)) + realExpTerms(S)(succ(k))] by ring
    have expandRight : R[(1 + S) * (1 + S) ^ k] = R[(1 + S) ^ k + S * (1 + S) ^ k] by ring
    rw [monoidPow.succ, expandRight]
    rw expandLeft at recurrence
    have termReal : R[realExpTerms(S)(succ(k))] ∈ ℝ by typecheck
    linarith

-- Past M ≥ x the terms xⁿ/n! decrease, so all are at most (1 + x)ᴹ.
theorem realExpTerms.tail_bound (S : Real) (M n : Nat)
  requires nonnegative : R[0] ≤ S
  requires large : S ≤ realNat(M)
  shows M ≤ n → (realExpTerms(S)(n):R) ≤ R[(1 + S) ^ M]
proof
  induction n
  | zero =>
    intro below
    have zero : M = (0:N) by arith
    rw zero
    exact realExpTerms.power_bound at S, 0 with nonnegative
  | succ(k) using ih =>
    intro below
    have split := Less.or_LessEqual at k, M
    cases split with early | late
    . have equal : M = succ(k) by arith
      rw equal
      exact realExpTerms.power_bound at S, succ(k) with nonnegative
    . have previous := ih with late
      have recurrence := realExpTerms.succ at S, k
      have current := realExpTerms.nonnegative at S, k with nonnegative
      have natLe := realNat.le_of_natural_le at M, k with late
      have natReal := realNat.real at k
      have natNonnegative := realNat.nonnegative at k
      have successorPositive : R[0] < R[realNat(k) + 1]
        have one := realZero.lt_one
        linarith
      have sBelow : S ≤ R[realNat(k) + 1]
        have one := realZero.lt_one
        linarith
      have scaled := realLe.mul_right_of_nonnegative with sBelow, current
      have product : R[realExpTerms(S)(succ(k)) * (realNat(k) + 1)] ≤ R[realExpTerms(S)(k) * (realNat(k) + 1)]
        have commuteLeft : R[realExpTerms(S)(succ(k)) * (realNat(k) + 1)] = R[(realNat(k) + 1) * realExpTerms(S)(succ(k))] by ring
        have commuteRight : R[realExpTerms(S)(k) * (realNat(k) + 1)] = R[(realNat(k) + 1) * realExpTerms(S)(k)] by ring
        rw [commuteLeft, commuteRight, recurrence]
        have commuteScaled : R[S * realExpTerms(S)(k)] = R[realExpTerms(S)(k) * S] by ring
        rw commuteScaled
        linarith
      have decreasing := realLe.mul_right_cancel_positive with successorPositive, product
      linarith

theorem realExpTerms.uniform_bound (S : Real) (M n : Nat)
  requires nonnegative : R[0] ≤ S
  requires large : S ≤ realNat(M)
  shows (realExpTerms(S)(n):R) ≤ R[(1 + S) ^ M]
proof
  have split := Less.or_LessEqual at n, M
  cases split with early | late
  . have le := Less.implies_LessEqual with early
    have power := realExpTerms.power_bound at S, n with nonnegative
    have above : R[1] ≤ R[1 + S] by linarith
    have monotone := realPow.exponent_monotone at R[1 + S], n, M with above, le
    linarith
  . have tail := realExpTerms.tail_bound at S, M, n with nonnegative, large
    exact tail with late

theorem realExpTerms.summable_nonnegative (X : Real)
  requires nonnegative : R[0] ≤ X
  shows Summable(realExpTerms(X))
proof
  have one := realZero.lt_one
  have doubleNonnegative : R[0] ≤ R[2 * X] by linarith
  obtain ⟨M, mNat, above⟩ := Real.below_natural at R[2 * X]
  have large := realLess.implies_le with above
  have twoNonzero : R[2] ≠ R[0]
    intro zero
    have impossible : R[0] < R[2] by linarith
    rw zero at impossible
    exact realLess.irreflexive_on with R[0], impossible
  have twoPositive : R[0] < R[2] by linarith
  have inverse := realInvValue.positive with twoPositive
  have halfValue := realDiv.eq_mul_inv at R[1], R[2]
  have halfPositive : R[0] < R[1 / 2]
    rw halfValue
    linarith
  have halfDouble := realDiv.mul_left at R[1], R[2] with twoNonzero
  have halfSmall : R[1 / 2] < R[1] by linarith
  have halfNonnegative := realLess.implies_le with halfPositive
  have halfAbs := abs.of_nonnegative at R[1 / 2] with halfNonnegative
  have small : abs(R[1 / 2]) < R[1] by rwa halfAbs
  have geometric := geometricSeries.sums_to at R[1 / 2] with small
  have geometricSummable := SumsTo.summable with geometric
  have bounds := Summable.scale at geometricTerms(R[1 / 2]), R[(1 + 2 * X) ^ M] with geometricSummable
  have sequence : RealSequence(realExpTerms(X)) by exact realExpTerms.function at X
  have termsNonnegative : NonnegativeTerms(realExpTerms(X))
    intros n nIn
    have nNat := nat.omega.backward at n with nIn
    apply realLe.characterization.forward
    exact realExpTerms.nonnegative at X, n with nonnegative
  have dominated : PointwiseLE(realExpTerms(X), mulSequence(constantSequence(R[(1 + 2 * X) ^ M]), geometricTerms(R[1 / 2])))
    intros n nIn
    have nNat := nat.omega.backward at n with nIn
    apply realLe.characterization.forward
    have constant := constantSequence.sequence at R[(1 + 2 * X) ^ M]
    have geometricSequence := geometricTerms.sequence at R[1 / 2]
    have constantValue := constantSequence.value at R[(1 + 2 * X) ^ M], n
    have geometricValue := geometricTerms.value at R[1 / 2], n with nIn
    have constantReal := RealSequence.value at constantSequence(R[(1 + 2 * X) ^ M]), n with constant
    have geometricReal := RealSequence.value at geometricTerms(R[1 / 2]), n with geometricSequence
    have productValue := mulSequence.value at constantSequence(R[(1 + 2 * X) ^ M]), geometricTerms(R[1 / 2]), n with constant, geometricSequence, constantReal, geometricReal
    rw [productValue, constantValue, geometricValue]
    unfold realPow
    have split := realPow.mul at R[2], X, n
    unfold realPow at split
    have halves := realPow.mul at R[1 / 2], R[2], n
    unfold realPow at halves
    have unitPower := realPow.one at n
    unfold realPow at unitPower
    have cancel := realDiv.mul_right at R[1], R[2] with twoNonzero
    rw [cancel, unitPower] at halves
    have positive := realNat.factorial_pos at n
    have identity : realExpTerms(X)(n) = R[(1 / 2) ^ n * realExpTerms(R[2 * X])(n)]
      have first := realDiv.eq_mul_inv at R[X ^ n], realNat(factorial(n))
      have second := realDiv.eq_mul_inv at R[(2 * X) ^ n], realNat(factorial(n))
      rw [(realExpTerms.value at X, n with nIn), (realExpTerms.value at R[2 * X], n with nIn), first, second, split]
      have regroup : R[(1 / 2) ^ n * ((2 ^ n * X ^ n) * realInvValue(realNat(factorial(n))))] = R[((1 / 2) ^ n * 2 ^ n) * (X ^ n * realInvValue(realNat(factorial(n))))] by ring
      rw [regroup, ← halves]
      ring
    have bound := realExpTerms.uniform_bound at R[2 * X], M, n with doubleNonnegative, large
    have halfPower := realPow.nonnegative at R[1 / 2], n with halfNonnegative
    unfold realPow at halfPower
    have product := realLe.mul_left_of_nonnegative with bound, halfPower
    have commute : R[(1 + 2 * X) ^ M * (1 / 2) ^ n] = R[(1 / 2) ^ n * (1 + 2 * X) ^ M] by ring
    rw [identity, commute]
    exact product
  exact Summable.of_nonnegative_le with sequence, bounds, termsNonnegative, dominated

theorem realExpTerms.abs (X : Real) (n : Nat)
  shows abs(realExpTerms(X)(n)) = realExpTerms(abs(X))(n)
proof
  have nIn := nat.omega.forward at n with assumption
  have positive := realNat.factorial_pos at n
  have nonzero : realNat(factorial(n)) ≠ R[0]
    intro zero
    rw zero at positive
    exact realLess.irreflexive_on with R[0], positive
  have nonnegative := realLess.implies_le with positive
  have power := realPow.abs at X, n
  unfold realPow at power
  rw [(realExpTerms.value at X, n with nIn), (realExpTerms.value at abs(X), n with nIn), realDiv.eq_mul_inv, realDiv.eq_mul_inv, abs.mul, abs.inv with nonzero, abs.of_nonnegative with nonnegative, power]

theorem realExpTerms.summable (X : Real)
  shows Summable(realExpTerms(X))
proof
  have sequence : RealSequence(realExpTerms(X)) by exact realExpTerms.function at X
  have absNonnegative := abs.nonnegative at X
  have bounds := realExpTerms.summable_nonnegative at abs(X) with absNonnegative
  have dominated : ∀ n ∈ ℕ, abs(realExpTerms(X)(n)) ≤ realExpTerms(abs(X))(n)
    intros n nIn
    have nNat := nat.omega.backward at n with nIn
    rw realExpTerms.abs
    exact realLe.reflexive at realExpTerms(abs(X))(n)
  exact Summable.of_abs_le with sequence, bounds, dominated

theorem expTerms.abs (z : Set) (n : Nat)
  requires hz : z ∈ ℂ
  shows complexAbs(expTerms(z)(n)) = realExpTerms(complexAbs(z))(n)
proof
  have nIn := nat.omega.forward at n with assumption
  have ring := complexes.comm_ring
  have ordinary := IsCommRing.ring with ring
  have monoid := IsRing.multiplicative with ordinary
  have coefficientIn : R[1 / factorial(n)] ∈ ℝ by typecheck
  have coefficient := FunctionBetween.apply_closed with complexOfReal.function, coefficientIn
  have power := monoidPow.closed at ℂ, complexMul, complexOne, z, n with monoid, hz
  have absIn := FunctionBetween.apply_closed with complexAbs.function, hz
  have product := complexAbs.mul with coefficient, power
  have powerAbs := complexAbs.pow at z, n with hz
  have positive := realNat.factorial_pos at n
  have inverse := realInvValue.positive with positive
  have coefficientPositive : R[0] < R[1 / factorial(n)]
    rw realDiv.eq_mul_inv
    have one := realZero.lt_one
    have unit : R[1 * realInvValue(realNat(factorial(n)))] = realInvValue(realNat(factorial(n))) by ring
    rwa unit
  have coefficientNonnegative := realLess.implies_le with coefficientPositive
  have coefficientAbs := abs.of_nonnegative with coefficientNonnegative
  rw [(expTerms.value at z, n with nIn, hz), product, complexAbs.of_real, coefficientAbs, powerAbs, (realExpTerms.value at complexAbs(z), n with nIn), realDiv.eq_mul_inv, realDiv.eq_mul_inv]
  ring

theorem expTerms.summable_abs (z : Set)
  requires hz : z ∈ ℂ
  shows ComplexAbsolutelySummable(expTerms(z))
proof
  have sequence : ComplexSequence(expTerms(z)) by exact expTerms.function at z with hz
  have absIn := FunctionBetween.apply_closed with complexAbs.function, hz
  have absReal : Real(complexAbs(z)) by exact absIn
  have bounds := realExpTerms.summable at complexAbs(z)
  have dominated : ∀ n ∈ ℕ, complexAbs(expTerms(z)(n)) ≤ realExpTerms(complexAbs(z))(n)
    intros n nIn
    have nNat := nat.omega.backward at n with nIn
    rw expTerms.abs at z, n with hz
    exact realLe.reflexive at realExpTerms(complexAbs(z))(n)
  exact ComplexAbsolutelySummable.of_bound with sequence, bounds, dominated

-- exp z is the sum of Σ zⁿ/n!, which converges absolutely for every z.
defunique complexExpValue (z : Set) (w ∈ complexCarrier) :=
  ComplexSumsTo(expTerms(z), w)
requires hz : z ∈ complexCarrier
proof
  have absolute := expTerms.summable_abs with hz
  exact ComplexAbsolutelySummable.summable with absolute
uniqueness
  intros v vIn first w wIn second
  exact ComplexSumsTo.unique with first, second

defgraph complexExp (z ∈ complexCarrier) : complexCarrier :=
    complexExpValue(z)
proof
  have selected := complexExpValue.selected with member
  exact selected.left

-- e^x is the sum of Σ xⁿ/n!.
defunique realExpValue (X : Real) (Y ∈ ℝ) := SumsTo(realExpTerms(X), Y)
proof
  exact realExpTerms.summable at X
uniqueness
  intros Y yIn first Z zIn second
  have yReal : Real(Y) by exact yIn
  have zReal : Real(Z) by exact zIn
  exact SumsTo.unique with first, second

defgraph realExp (X ∈ ℝ) : ℝ := realExpValue(X)
proof
  have xReal : Real(X) by exact member
  have selected := realExpValue.selected at X
  exact selected.left

-- Section: The complex exponential
theorem expTerms.sequence (z : Set)
  requires hz : z ∈ ℂ
  shows ComplexSequence(expTerms(z))
proof
  exact expTerms.function at z with hz

theorem expTerms.absolutely_summable (z : Set)
  requires hz : z ∈ ℂ
  shows ComplexAbsolutelySummable(expTerms(z))
proof
  exact expTerms.summable_abs with hz

theorem complexExp.sums (z : Set)
  requires hz : z ∈ ℂ
  shows ComplexSumsTo(expTerms(z), complexExp(z))
proof
  have selected := complexExpValue.selected with hz
  have value := complexExp.value with hz
  rw value
  exact selected.right

theorem complexExp.member (z : Set)
  requires hz : z ∈ ℂ
  shows complexExp(z) ∈ ℂ
proof
  exact FunctionBetween.apply_closed with complexExp.function, hz

theorem realExpTerms.sequence (X : Real)
  shows RealSequence(realExpTerms(X))
proof
  exact realExpTerms.function at X

theorem realExp.sums (X : Real)
  shows SumsTo(realExpTerms(X), realExp(X))
proof
  have xIn : X ∈ ℝ by typecheck
  have selected := realExpValue.selected at X
  rw realExp.value at X with xIn
  exact selected.right

theorem realExp.real (X : Real)
  shows realExp(X) ∈ ℝ
proof
  have xIn : X ∈ ℝ by typecheck
  exact FunctionBetween.apply_closed with realExp.function, xIn

theorem complexExp.of_real (X : Real)
  shows complexExp(complexOfReal(X)) = complexOfReal(realExp(X))
proof
  have xIn : X ∈ ℝ by typecheck
  have zIn := FunctionBetween.apply_closed with complexOfReal.function, xIn
  have sequence := expTerms.sequence with zIn
  have realSequence := realExpTerms.sequence at X
  have term : ∀ n ∈ ℕ, expTerms(complexOfReal(X))(n) = complexOfReal(realExpTerms(X)(n))
    intros n nIn
    have nNat := nat.omega.backward at n with nIn
    have value := realExpTerms.value at X, n with nIn
    have quotient := realDiv.eq_mul_inv at R[X ^ n], realNat(factorial(n))
    have reciprocal := realDiv.eq_mul_inv at R[1], realNat(factorial(n))
    rw [(expTerms.value at complexOfReal(X), n with nIn, zIn), ← complexOfReal.pow, ← complexOfReal.mul, value, quotient, reciprocal]
    have same : R[(1 * realInvValue(realNat(factorial(n)))) * X ^ n] = R[X ^ n * realInvValue(realNat(factorial(n)))] by ring
    rw same
  have xs := complexSequenceX.function at expTerms(complexOfReal(X)) with sequence
  have ys := complexSequenceY.function at expTerms(complexOfReal(X)) with sequence
  have zeroSequence := constantSequence.sequence at R[0]
  have xSame : complexSequenceX(expTerms(complexOfReal(X))) = realExpTerms(X)
    apply FunctionBetween.ext with xs, realSequence
    intros n nIn
    have nNat := nat.omega.backward at n with nIn
    have termReal := RealSequence.value at realExpTerms(X), n with realSequence
    have shape := term with n, nIn
    rw [(complexSequenceX.value at expTerms(complexOfReal(X)), n with sequence), shape, complexOfReal.value, Euclidean.x.pair]
  have ySame : complexSequenceY(expTerms(complexOfReal(X))) = constantSequence(R[0])
    apply FunctionBetween.ext with ys, zeroSequence
    intros n nIn
    have nNat := nat.omega.backward at n with nIn
    have termReal := RealSequence.value at realExpTerms(X), n with realSequence
    have shape := term with n, nIn
    rw [(complexSequenceY.value at expTerms(complexOfReal(X)), n with sequence), shape, complexOfReal.value, Euclidean.y.pair, constantSequence.value]
  have xSums := realExp.sums at X
  rw ← xSame at xSums
  have ySums := SumsTo.zero
  rw ← ySame at ySums
  have expReal := realExp.real at X
  have sums := ComplexSumsTo.of_parts at expTerms(complexOfReal(X)), realExp(X), R[0] with sequence, xSums, ySums
  have expSums := complexExp.sums with zIn
  have equal := ComplexSumsTo.unique with expSums, sums
  rw [equal, complexOfReal.value at realExp(X) with expReal]

theorem realExp.zero
  shows realExp(R[0]) = R[1]
proof
  have sequence := realExpTerms.sequence at R[0]
  have vanishing : ∀ n ∈ ℕ, succ(0) ≤ n → realExpTerms(R[0])[n] = (0:R)
    intros n nIn after
    obtain ⟨m, mNat, split⟩ := after
    have shape : n = succ(m) by arith
    have succIn := nat.omega.forward at succ(m) with assumption
    rw [shape, (realExpTerms.value at R[0], succ(m) with succIn), monoidPow.succ, realDiv.eq_mul_inv]
    ring
  have sums := SumsTo.of_eventually_zero at realExpTerms(R[0]), succ(0) with sequence, vanishing
  have first := realExpTerms.zero at R[0]
  have one : realPartialSum(realExpTerms(R[0]), succ(0)) = R[1]
    have same : realAddValue(R[0], R[1]) = R[0 + 1] by simp [realAddValue, call2]
    rw [realPartialSum.succ, realPartialSum.zero, first, same]
    ring
  rw one at sums
  have value := realExp.sums at R[0]
  exact SumsTo.unique with value, sums

theorem complexExp.zero
  shows complexExp(ℂ[0]) = ℂ[1]
proof
  have value := complexExp.of_real at R[0]
  rw [complexOfReal.zero, realExp.zero, complexOfReal.one] at value
  exact value

theorem complexExp.add (z w : Set)
  requires hz : z ∈ ℂ
  requires hw : w ∈ ℂ
  shows complexExp(ℂ[z + w]) = ℂ[complexExp(z) * complexExp(w)]
proof
  sorry

theorem complexExp.neg (z : Set)
  requires hz : z ∈ ℂ
  shows ℂ[complexExp(-z) * complexExp(z)] = ℂ[1]
proof
  have ring := complexes.comm_ring
  have ordinary := IsCommRing.ring with ring
  have negated := IsRing.neg_closed with ordinary, hz
  have sum := complexExp.add with negated, hz
  have cancel : ℂ[-z + z] = ℂ[0] by ring
  rw [cancel, complexExp.zero] at sum
  rw ← sum

theorem complexExp.nonzero (z : Set)
  requires hz : z ∈ ℂ
  shows complexExp(z) ≠ ℂ[0]
proof
  intro zero
  have product := complexExp.neg with hz
  rw zero at product
  have ring := complexes.comm_ring
  have ordinary := IsCommRing.ring with ring
  have negated := IsRing.neg_closed with ordinary, hz
  have member := complexExp.member with negated
  have vanishes : ℂ[complexExp(-z) * 0] = ℂ[0] by ring
  have distinct := complexRing.nontrivial
  rw [complexRing.zeroOf, complexRing.oneOf] at distinct
  apply distinct
  rw [← vanishes, product]

theorem complexExp.inv (z : Set)
  requires hz : z ∈ ℂ
  shows complexExp(ℂ[-z]) = complexInv(complexExp(z))
proof
  have ring := complexes.comm_ring
  have ordinary := IsCommRing.ring with ring
  have negated := IsRing.neg_closed with ordinary, hz
  have value := complexExp.member with hz
  have inverse := complexExp.member with negated
  have product := complexExp.neg with hz
  have commuted : ℂ[complexExp(z) * complexExp(-z)] = ℂ[1]
    rw ← product
    ring
  have unique := complexInv.unique with value, inverse, commuted
  rw unique

theorem complexExp.nat_mul (z : Set) (n : Nat)
  requires hz : z ∈ ℂ
  shows complexExp(ℂ[complexOfReal(realNat(n)) * z]) =
    ℂ[complexExp(z) ^ n]
proof
  have ring := complexes.comm_ring
  have ordinary := IsCommRing.ring with ring
  induction n
  | zero =>
    have vanishes : ℂ[0 * z] = ℂ[0] by ring
    rw [realNat.zero, complexOfReal.zero, vanishes, complexExp.zero, monoidPow.zero]
  | succ(k) using ih =>
    have natIn : realNat(k) ∈ ℝ by typecheck
    have coefficient := FunctionBetween.apply_closed with complexOfReal.function, natIn
    have product := IsRing.mul_closed with ordinary, coefficient, hz
    have same : realAddValue(realNat(k), R[1]) = R[realNat(k) + 1] by simp [realAddValue, call2]
    have expand : ℂ[(complexOfReal(realNat(k)) + 1) * z] = ℂ[complexOfReal(realNat(k)) * z + z] by ring
    have sum := complexExp.add with product, hz
    rw [realNat.succ, same, complexOfReal.add, complexOfReal.one, expand, sum, ih, monoidPow.succ]
    have expIn := complexExp.member with hz
    have monoid := IsRing.multiplicative with ordinary
    have power := monoidPow.closed at ℂ, complexMul, complexOne, complexExp(z), k with monoid, expIn
    ring

theorem complexConj.neg (z : Set)
  requires hz : z ∈ ℂ
  shows complexConj(ℂ[-z]) = ℂ[-complexConj(z)]
proof
  obtain ⟨a, aReal, b, bReal, shape⟩ := complexCarrier.cases with hz
  simp [shape, complexNeg.pair, complexConj.pair]

theorem complexConj.one
  shows complexConj(ℂ[1]) = ℂ[1]
proof
  unfold complexOne
  rw complexConj.pair
  apply complex.pair_congr
  . rfl
  . ring

theorem complexConj.zero
  shows complexConj(ℂ[0]) = ℂ[0]
proof
  unfold complexZero
  rw complexConj.pair
  apply complex.pair_congr
  . rfl
  . ring

theorem complexConj.pow (z : Set) (n : Nat)
  requires hz : z ∈ ℂ
  shows complexConj(ℂ[z ^ n]) = ℂ[complexConj(z) ^ n]
proof
  induction n
  | zero =>
    rw [monoidPow.zero, monoidPow.zero, complexConj.one]
  | succ(k) using ih =>
    have ring := complexes.comm_ring
    have ordinary := IsCommRing.ring with ring
    have monoid := IsRing.multiplicative with ordinary
    have power := monoidPow.closed at ℂ, complexMul, complexOne, z, k with monoid, hz
    have product := complexConj.mul with hz, power
    rw [monoidPow.succ, monoidPow.succ, product, ih]

theorem expTerms.conj (z : Set) (n : Nat)
  requires hz : z ∈ ℂ
  shows complexConj(expTerms(z)(n)) = expTerms(complexConj(z))(n)
proof
  have nIn := nat.omega.forward at n with assumption
  have conjugate := FunctionBetween.apply_closed with complexConj.function, hz
  have ring := complexes.comm_ring
  have ordinary := IsCommRing.ring with ring
  have monoid := IsRing.multiplicative with ordinary
  have coefficientIn : R[1 / factorial(n)] ∈ ℝ by typecheck
  have coefficient := FunctionBetween.apply_closed with complexOfReal.function, coefficientIn
  have power := monoidPow.closed at ℂ, complexMul, complexOne, z, n with monoid, hz
  have product := complexConj.mul with coefficient, power
  rw [(expTerms.value at z, n with nIn, hz), (expTerms.value at complexConj(z), n with nIn, conjugate), product, complexConj.of_real, complexConj.pow with hz]

theorem complexPartialSum.conj (z : Set) (n : Nat)
  requires hz : z ∈ ℂ
  shows complexConj(complexPartialSum(expTerms(z), n)) = complexPartialSum(expTerms(complexConj(z)), n)
proof
  have sequence := expTerms.sequence with hz
  induction n
  | zero =>
    rw [complexPartialSum.zero, complexPartialSum.zero, complexConj.zero]
  | succ(k) using ih =>
    have kIn := nat.omega.forward at k with assumption
    have function : expTerms(z) : ℕ → ℂ by exact sequence
    have term := FunctionBetween.apply_closed with function, kIn
    have partial := complexPartialSum.closed at expTerms(z), k with sequence
    have sum := complexConj.add with partial, term
    rw [complexPartialSum.succ, complexPartialSum.succ, sum, ih, expTerms.conj with hz]

theorem complexExp.conj (z : Set)
  requires hz : z ∈ ℂ
  shows complexExp(complexConj(z)) = complexConj(complexExp(z))
proof
  have ring := complexes.comm_ring
  have ordinary := IsCommRing.ring with ring
  have conjugate := FunctionBetween.apply_closed with complexConj.function, hz
  have sequence := expTerms.sequence with hz
  have conjSequence := expTerms.sequence with conjugate
  have sums := complexExp.sums with hz
  obtain ⟨_, converges⟩ := sums
  have expIn := complexExp.member with hz
  have target := FunctionBetween.apply_closed with complexConj.function, expIn
  have prefixes : ComplexSequence(complexPrefixSums(expTerms(z))) by exact complexPrefixSums.function with sequence
  have conjPrefixes : ComplexSequence(complexPrefixSums(expTerms(complexConj(z)))) by exact complexPrefixSums.function with conjSequence
  have equivalence := ComplexConvergesTo.iff_abs with prefixes, expIn
  have close := equivalence.forward with converges
  have conjEquivalence := ComplexConvergesTo.iff_abs with conjPrefixes, target
  have conjConverges : ComplexConvergesTo(complexPrefixSums(expTerms(complexConj(z))), complexConj(complexExp(z)))
    apply conjEquivalence.backward
    intros e eIn positive
    obtain ⟨N, nIn, near⟩ := close with e, eIn, positive
    refine ⟨N, nIn, ?_⟩
    intros n mIn after
    have nNat := nat.omega.backward at n with mIn
    have bound := near with n, mIn, after
    have prefixValue := complexPrefixSums.value at expTerms(z), n with mIn, sequence
    have conjValue := complexPrefixSums.value at expTerms(complexConj(z)), n with mIn, conjSequence
    rw prefixValue at bound
    rw conjValue
    have partial := complexPartialSum.closed at expTerms(z), n with sequence
    have negExp := IsRing.neg_closed with ordinary, expIn
    have difference := IsRing.add_closed with ordinary, partial, negExp
    have conjDifference := complexConj.add with partial, negExp
    have conjNeg := complexConj.neg with expIn
    have same := complexAbs.conj with difference
    rw [conjDifference, conjNeg, complexPartialSum.conj with hz] at same
    rwa same
  have conjSums : ComplexSumsTo(expTerms(complexConj(z)), complexConj(complexExp(z)))
    unfold ComplexSumsTo
    refine ⟨conjSequence, conjConverges⟩
  have expSums := complexExp.sums with conjugate
  exact ComplexSumsTo.unique with expSums, conjSums

theorem realNat.factorial_ge_one (n : Nat)
  shows R[1] ≤ realNat(factorial(n))
proof
  induction n
  | zero =>
    have unfolded : factorial(0) = (1:N) by rw factorial
    rw [unfolded, realNat.one]
    exact realLe.reflexive at R[1]
  | succ(k) using ih =>
    have natReal := realNat.real at k
    have natNonnegative := realNat.nonnegative at k
    have factorialReal := realNat.real at factorial(k)
    have one := realZero.lt_one
    have factorialNonnegative : R[0] ≤ realNat(factorial(k)) by linarith
    have product := realMulValue.nonnegative with natNonnegative, factorialNonnegative
    have expand : R[(realNat(k) + 1) * realNat(factorial(k))] = R[realNat(k) * realNat(factorial(k)) + realNat(factorial(k))] by ring
    rw [realNat.factorial_successor, expand]
    linarith

-- (k + 2)! ≥ 2ᵏ⁺¹.
theorem realNat.factorial_power_bound (k : Nat)
  shows (R[2 ^ succ(k)]:R) ≤ realNat(factorial(succ(succ(k))))
proof
  have one := realZero.lt_one
  induction k
  | zero =>
    have first := realNat.factorial_ge_one at succ((0:N))
    have value : realNat(succ((0:N))) = R[1] by exact realNat.one
    rw [realNat.factorial_successor, value, monoidPow.succ, monoidPow.zero]
    have factorialReal := realNat.real at factorial(succ((0:N)))
    have expand : R[(1 + 1) * realNat(factorial(succ((0:N))))] = R[realNat(factorial(succ((0:N)))) + realNat(factorial(succ((0:N))))] by ring
    rw expand
    have zeroOne := realZero.lt_one
    linarith
  | succ(j) using ih =>
    have natReal := realNat.real at j
    have natNonnegative := realNat.nonnegative at j
    have factorialReal := realNat.real at factorial(succ(succ(j)))
    have zeroOne := realZero.lt_one
    have twoNonnegative : R[0] ≤ R[2] by linarith
    have power := realPow.nonnegative at R[2], succ(j) with twoNonnegative
    unfold realPow at power
    have powerReal : R[2 ^ succ(j)] ∈ ℝ by typecheck
    have twoStep : realNat(succ(succ(j))) = R[realNat(j) + 1 + 1]
      rw [realNat.succ, realNat.succ]
      simp [realAddValue, call2]
    have bigFactor : R[2] ≤ R[realNat(succ(succ(j))) + 1]
      rw twoStep
      linarith
    have scaled := realLe.mul_right_of_nonnegative with bigFactor, power
    have factorNonnegative : R[0] ≤ R[realNat(succ(succ(j))) + 1]
      rw twoStep
      linarith
    have grown := realLe.mul_left_of_nonnegative with ih, factorNonnegative
    rw [realNat.factorial_successor, monoidPow.succ]
    have commute : R[2 * 2 ^ succ(j)] = R[2 ^ succ(j) * 2] by ring
    rw commute
    have commuteRight : R[(realNat(succ(succ(j))) + 1) * 2 ^ succ(j)] = R[2 ^ succ(j) * (realNat(succ(succ(j))) + 1)] by ring
    rw commuteRight at grown
    linarith

-- |exp-term k + 2| · 2ᵏ⁺¹ ≤ |z|² for |z| ≤ 1.
theorem expTerms.tail_term (z : Set) (k : Nat)
  requires hz : z ∈ ℂ
  requires small : complexAbs(z) ≤ R[1]
  shows R[complexAbs(expTerms(z)(succ(succ(k)))) * 2 ^ succ(k)] ≤ R[complexAbs(z) * complexAbs(z)]
proof
  have index := nat.omega.forward at succ(succ(k)) with assumption
  have absIn := FunctionBetween.apply_closed with complexAbs.function, hz
  have absReal : Real(complexAbs(z)) by exact absIn
  have absNonnegative := complexAbs.nonnegative with hz
  have value := expTerms.abs at z, succ(succ(k)) with hz
  have termValue := realExpTerms.value at complexAbs(z), succ(succ(k)) with index
  have positive := realNat.factorial_pos at succ(succ(k))
  have nonzero : realNat(factorial(succ(succ(k)))) ≠ R[0]
    intro zero
    rw zero at positive
    exact realLess.irreflexive_on with R[0], positive
  have cancel := realDiv.mul_right at R[complexAbs(z) ^ succ(succ(k))], realNat(factorial(succ(succ(k)))) with nonzero
  have bound := realNat.factorial_power_bound at k
  have termNonnegative := realExpTerms.nonnegative at complexAbs(z), succ(succ(k)) with absNonnegative
  have scaled := realLe.mul_left_of_nonnegative with bound, termNonnegative
  rw [value]
  have exact : R[realExpTerms(complexAbs(z))(succ(succ(k))) * realNat(factorial(succ(succ(k))))] = R[complexAbs(z) ^ succ(succ(k))]
    rw [termValue, cancel]
  rw exact at scaled
  have lower := realPow.le_one at complexAbs(z), k with absNonnegative, small
  unfold realPow at lower
  have square := realMulValue.square_nonnegative at complexAbs(z)
  have shrink := realLe.mul_left_of_nonnegative with lower, square
  have expand : R[complexAbs(z) ^ succ(succ(k))] = R[(complexAbs(z) * complexAbs(z)) * complexAbs(z) ^ k] by rw [monoidPow.succ, monoidPow.succ]; ring
  rw expand at scaled
  have unit : R[(complexAbs(z) * complexAbs(z)) * 1] = R[complexAbs(z) * complexAbs(z)] by ring
  rw unit at shrink
  have powerReal : R[complexAbs(z) ^ k] ∈ ℝ by typecheck
  have termReal : R[realExpTerms(complexAbs(z))(succ(succ(k)))] ∈ ℝ by typecheck
  have twoReal : R[2 ^ succ(k)] ∈ ℝ by typecheck
  have commute : R[realExpTerms(complexAbs(z))(succ(succ(k))) * 2 ^ succ(k)] = R[realExpTerms(complexAbs(z))(succ(succ(k))) * 2 ^ succ(k)] by ring
  linarith

-- |P(k + 2) − 1 − z| · 2ᵏ ≤ |z|²(2ᵏ − 1), for the partial sums P of exp z.
theorem expTerms.partial_tail (z : Set) (k : Nat)
  requires hz : z ∈ ℂ
  requires small : complexAbs(z) ≤ R[1]
  shows R[complexAbs(ℂ[complexPartialSum(expTerms(z), succ(succ(k))) - (1 + z)]) * 2 ^ k] ≤ R[complexAbs(z) * complexAbs(z) * (2 ^ k - 1)]
proof
  have sequence := expTerms.sequence with hz
  have ring := complexes.comm_ring
  have ordinary := IsCommRing.ring with ring
  have function : expTerms(z) : ℕ → ℂ by exact sequence
  have linear := IsRing.add_closed with ordinary, complexOne.member, hz
  have negLinear := IsRing.neg_closed with ordinary, linear
  have absIn := FunctionBetween.apply_closed with complexAbs.function, hz
  have absReal : Real(complexAbs(z)) by exact absIn
  induction k
  | zero =>
    have zeroIn := nat.omega.forward at (0:N) with assumption
    have oneIn := nat.omega.forward at succ((0:N)) with assumption
    have unfolded : factorial((0:N)) = (1:N) by rw factorial
    have unfoldedOne : factorial(succ((0:N))) = (1:N)
      rw [factorial, unfolded]
      arith
    have oneNonzero : R[1] ≠ R[0]
      intro same
      have distinct := realZero.ne_one
      apply distinct
      rw same
    have unitQuotient := realDiv.self at R[1] with oneNonzero
    have first : expTerms(z)((0:N)) = ℂ[1]
      rw [(expTerms.value at z, (0:N) with zeroIn, hz), unfolded, realNat.one, unitQuotient, complexOfReal.one, monoidPow.zero]
      ring
    have second : expTerms(z)(succ((0:N))) = z
      rw [(expTerms.value at z, succ((0:N)) with oneIn, hz), unfoldedOne, realNat.one, unitQuotient, complexOfReal.one, monoidPow.succ, monoidPow.zero]
      ring
    have base : complexPartialSum(expTerms(z), succ(succ((0:N)))) = ℂ[1 + z]
      rw [complexPartialSum.succ, complexPartialSum.succ, complexPartialSum.zero, first, second]
      ring
    have cancel : ℂ[ℂ[1 + z] - (1 + z)] = ℂ[0] by ring
    have absZero := complexAbs.zero_iff at ℂ[0] with complexZero.member
    have vanishes := absZero.backward with rfl
    rw [base, cancel, vanishes, monoidPow.zero]
    have left : R[0 * 1] = R[0] by ring
    have right : R[complexAbs(z) * complexAbs(z) * (1 - 1)] = R[0] by ring
    rw [left, right]
    exact realLe.reflexive at R[0]
  | succ(j) using ih =>
    have index := nat.omega.forward at succ(succ(j)) with assumption
    have term := FunctionBetween.apply_closed with function, index
    have partial := complexPartialSum.closed at expTerms(z), succ(succ(j)) with sequence
    have difference := IsRing.add_closed with ordinary, partial, negLinear
    have regroup : ℂ[ℂ[complexPartialSum(expTerms(z), succ(succ(j))) + expTerms(z)(succ(succ(j)))] - (1 + z)] = ℂ[(complexPartialSum(expTerms(z), succ(succ(j))) - (1 + z)) + expTerms(z)(succ(succ(j)))] by ring
    have triangle := complexAbs.triangle with difference, term
    rw ← regroup at triangle
    have tail := expTerms.tail_term at z, j with hz, small
    have twoNonnegative : R[0] ≤ R[2]
      have one := realZero.lt_one
      linarith
    have powerNonnegative := realPow.nonnegative at R[2], j with twoNonnegative
    unfold realPow at powerNonnegative
    have doubleNonnegative : R[0] ≤ R[2 * 2 ^ j] by linarith
    have scaled := realLe.mul_right_of_nonnegative with triangle, doubleNonnegative
    have dReal : complexAbs(ℂ[complexPartialSum(expTerms(z), succ(succ(j))) - (1 + z)]) ∈ ℝ by typecheck
    have uReal : complexAbs(expTerms(z)(succ(succ(j)))) ∈ ℝ by typecheck
    have pReal : R[2 ^ j] ∈ ℝ by typecheck
    have expandScaled : R[(complexAbs(ℂ[complexPartialSum(expTerms(z), succ(succ(j))) - (1 + z)]) + complexAbs(expTerms(z)(succ(succ(j))))) * (2 * 2 ^ j)] = R[2 * (complexAbs(ℂ[complexPartialSum(expTerms(z), succ(succ(j))) - (1 + z)]) * 2 ^ j) + complexAbs(expTerms(z)(succ(succ(j)))) * (2 * 2 ^ j)] by ring
    rw expandScaled at scaled
    rw monoidPow.succ at tail
    have expandHypothesis : R[complexAbs(z) * complexAbs(z) * (2 ^ j - 1)] = R[(complexAbs(z) * complexAbs(z)) * 2 ^ j - complexAbs(z) * complexAbs(z)] by ring
    rw expandHypothesis at ih
    rw [complexPartialSum.succ, monoidPow.succ]
    have expandGoal : R[complexAbs(z) * complexAbs(z) * (2 * 2 ^ j - 1)] = R[2 * ((complexAbs(z) * complexAbs(z)) * 2 ^ j) - complexAbs(z) * complexAbs(z)] by ring
    rw expandGoal
    linarith

-- A bound that holds eventually along a convergent sequence holds at its
-- limit.
theorem ComplexConvergesTo.abs_le (u S c : Set) (B : Real) (N : Nat)
  requires converges : ComplexConvergesTo(u, S)
  requires hc : c ∈ ℂ
  requires bound : ∀ n ∈ ℕ, N ≤ n → complexAbs(ℂ[u(n) - c]) ≤ B
  shows complexAbs(ℂ[S - c]) ≤ B
proof
  have convergesAgain := converges
  obtain ⟨sequence, hS, _, _⟩ := converges
  have ring := complexes.comm_ring
  have ordinary := IsCommRing.ring with ring
  have negC := IsRing.neg_closed with ordinary, hc
  have difference := IsRing.add_closed with ordinary, hS, negC
  have function : u : ℕ → ℂ by exact sequence
  have split : complexAbs(ℂ[S - c]) ≤ B ∨ ¬(complexAbs(ℂ[S - c]) ≤ B) by tauto
  cases split with done | over
  . exact done
  . exfalso
    have absIn := FunctionBetween.apply_closed with complexAbs.function, difference
    have absReal : Real(complexAbs(ℂ[S - c])) by exact absIn
    have less := realLess.of_not_le with over
    have gapPositive : R[0] < R[complexAbs(ℂ[S - c]) - B] by linarith
    have gapIn : R[complexAbs(ℂ[S - c]) - B] ∈ ℝ by typecheck
    have equivalence := ComplexConvergesTo.iff_abs with sequence, hS
    have close := equivalence.forward with convergesAgain
    obtain ⟨M, mIn, near⟩ := close with R[complexAbs(ℂ[S - c]) - B], gapIn, gapPositive
    have mNat := nat.omega.backward at M with mIn
    have nIn := nat.omega.forward at add(N, M) with assumption
    have firstLe : N ≤ add(N, M) by arith
    have secondLe : M ≤ add(N, M) by arith
    have bounded := bound with add(N, M), nIn, firstLe
    have nearby := near with add(N, M), nIn, secondLe
    have term := FunctionBetween.apply_closed with function, nIn
    have negS := IsRing.neg_closed with ordinary, hS
    have negTerm := IsRing.neg_closed with ordinary, term
    have toTerm := IsRing.add_closed with ordinary, hS, negTerm
    have fromTerm := IsRing.add_closed with ordinary, term, negC
    have regroup : ℂ[S - c] = ℂ[(S - u(add(N, M))) + (u(add(N, M)) - c)] by ring
    have triangle := complexAbs.triangle with toTerm, fromTerm
    rw ← regroup at triangle
    have flipped := IsRing.add_closed with ordinary, term, negS
    have reverse : ℂ[S - u(add(N, M))] = ℂ[-(u(add(N, M)) - S)] by ring
    have symmetric := complexAbs.neg with flipped
    rw [reverse, symmetric] at triangle
    linarith

theorem complexExp.quadratic_estimate (z : Set)
  requires hz : z ∈ ℂ
  requires small : complexAbs(z) ≤ R[1]
  shows complexAbs(ℂ[complexExp(z) - 1 - z]) ≤
    R[complexAbs(z) * complexAbs(z)]
proof
  have ring := complexes.comm_ring
  have ordinary := IsCommRing.ring with ring
  have sequence := expTerms.sequence with hz
  have linear := IsRing.add_closed with ordinary, complexOne.member, hz
  have sums := complexExp.sums with hz
  obtain ⟨_, converges⟩ := sums
  have absIn := FunctionBetween.apply_closed with complexAbs.function, hz
  have absReal : Real(complexAbs(z)) by exact absIn
  have bound : ∀ n ∈ ℕ, succ(succ((0:N))) ≤ n → complexAbs(ℂ[complexPrefixSums(expTerms(z))(n) - (1 + z)]) ≤ R[complexAbs(z) * complexAbs(z)]
    intros n nIn after
    obtain ⟨k, kNat, split⟩ := after
    have shape : n = succ(succ(k)) by arith
    have prefixValue := complexPrefixSums.value at expTerms(z), n with nIn, sequence
    rw [prefixValue, shape]
    have tail := expTerms.partial_tail at z, k with hz, small
    have twoNonnegative : R[0] ≤ R[2]
      have one := realZero.lt_one
      linarith
    have one := realZero.lt_one
    have twoAbove : R[1] ≤ R[2] by linarith
    have powerAbove := realPow.one_le at R[2], k with twoAbove
    unfold realPow at powerAbove
    have powerIn : R[2 ^ k] ∈ ℝ by typecheck
    have powerPositive : R[0] < (R[2 ^ k]:R) by linarith
    have square := realMulValue.square_nonnegative at complexAbs(z)
    have expand : R[complexAbs(z) * complexAbs(z) * (2 ^ k - 1)] = R[(complexAbs(z) * complexAbs(z)) * 2 ^ k - complexAbs(z) * complexAbs(z)] by ring
    rw expand at tail
    have weaker : R[complexAbs(ℂ[complexPartialSum(expTerms(z), succ(succ(k))) - (1 + z)]) * 2 ^ k] ≤ R[(complexAbs(z) * complexAbs(z)) * 2 ^ k] by linarith
    exact realLe.mul_right_cancel_positive with powerPositive, weaker
  have limit := ComplexConvergesTo.abs_le at complexPrefixSums(expTerms(z)), complexExp(z), ℂ[1 + z], R[complexAbs(z) * complexAbs(z)], succ(succ((0:N))) with converges, linear, bound
  have same : ℂ[complexExp(z) - 1 - z] = ℂ[complexExp(z) - (1 + z)]
    have expIn := complexExp.member with hz
    ring
  rwa same

theorem complexExp.continuous
  shows ComplexContinuous(complexExp)
proof
  have ring := complexes.comm_ring
  have ordinary := IsCommRing.ring with ring
  have function := complexExp.function
  have one := realZero.lt_one
  unfold ComplexContinuous
  refine ⟨function, ?_⟩
  intros a aIn
  unfold ComplexContinuousAt
  refine ⟨function, aIn, ?_⟩
  intros e eIn ePositive
  have eReal : Real(e) by exact eIn
  have expA := complexExp.member with aIn
  have aAbsIn := FunctionBetween.apply_closed with complexAbs.function, expA
  have aAbsReal : Real(complexAbs(complexExp(a))) by exact aAbsIn
  have aNonnegative := complexAbs.nonnegative with expA
  have aSquare := realMulValue.square_nonnegative at complexAbs(complexExp(a))
  have scalePositive : R[0] < R[4 * (complexAbs(complexExp(a)) * complexAbs(complexExp(a))) + e + 1] by linarith
  have scaleNonzero : R[4 * (complexAbs(complexExp(a)) * complexAbs(complexExp(a))) + e + 1] ≠ R[0]
    intro zero
    rw zero at scalePositive
    exact realLess.irreflexive_on with R[0], scalePositive
  have inverse := realInvValue.positive with scalePositive
  have radiusPositive := realMulValue.positive with ePositive, inverse
  have radiusNonnegative := realLess.implies_le with radiusPositive
  have cancel := realInvValue.mul_right with scaleNonzero
  have radiusIn : R[e * realInvValue(4 * (complexAbs(complexExp(a)) * complexAbs(complexExp(a))) + e + 1)] ∈ ℝ by typecheck
  have whole : R[(e * realInvValue(4 * (complexAbs(complexExp(a)) * complexAbs(complexExp(a))) + e + 1)) * (4 * (complexAbs(complexExp(a)) * complexAbs(complexExp(a))) + e + 1)] = e
    have regroup : R[(e * realInvValue(4 * (complexAbs(complexExp(a)) * complexAbs(complexExp(a))) + e + 1)) * (4 * (complexAbs(complexExp(a)) * complexAbs(complexExp(a))) + e + 1)] = R[e * ((4 * (complexAbs(complexExp(a)) * complexAbs(complexExp(a))) + e + 1) * realInvValue(4 * (complexAbs(complexExp(a)) * complexAbs(complexExp(a))) + e + 1))] by ring
    rw [regroup, cancel]
    ring
  have radiusSmall : R[e * realInvValue(4 * (complexAbs(complexExp(a)) * complexAbs(complexExp(a))) + e + 1)] ≤ R[1]
    have multiplied : R[(e * realInvValue(4 * (complexAbs(complexExp(a)) * complexAbs(complexExp(a))) + e + 1)) * (4 * (complexAbs(complexExp(a)) * complexAbs(complexExp(a))) + e + 1)] ≤ R[1 * (4 * (complexAbs(complexExp(a)) * complexAbs(complexExp(a))) + e + 1)]
      rw whole
      have unit : R[1 * (4 * (complexAbs(complexExp(a)) * complexAbs(complexExp(a))) + e + 1)] = R[4 * (complexAbs(complexExp(a)) * complexAbs(complexExp(a))) + e + 1] by ring
      rw unit
      linarith
    exact realLe.mul_right_cancel_positive with scalePositive, multiplied
  have radiusControl : R[4 * (complexAbs(complexExp(a)) * complexAbs(complexExp(a))) * (e * realInvValue(4 * (complexAbs(complexExp(a)) * complexAbs(complexExp(a))) + e + 1))] < e
    have below : R[4 * (complexAbs(complexExp(a)) * complexAbs(complexExp(a)))] < R[4 * (complexAbs(complexExp(a)) * complexAbs(complexExp(a))) + e + 1] by linarith
    have strict := realLess.mul_right_of_positive with below, radiusPositive
    have commute : R[(4 * (complexAbs(complexExp(a)) * complexAbs(complexExp(a))) + e + 1) * (e * realInvValue(4 * (complexAbs(complexExp(a)) * complexAbs(complexExp(a))) + e + 1))] = R[(e * realInvValue(4 * (complexAbs(complexExp(a)) * complexAbs(complexExp(a))) + e + 1)) * (4 * (complexAbs(complexExp(a)) * complexAbs(complexExp(a))) + e + 1)] by ring
    rw [commute, whole] at strict
    exact strict
  refine ⟨R[e * realInvValue(4 * (complexAbs(complexExp(a)) * complexAbs(complexExp(a))) + e + 1)], radiusIn, radiusPositive, ?_⟩
  intros x xIn near
  have negA := IsRing.neg_closed with ordinary, aIn
  have hIn := IsRing.add_closed with ordinary, xIn, negA
  have hSquare := complexAbs.square with hIn
  have hNonnegative := complexAbs.nonnegative with hIn
  have hAbsIn := FunctionBetween.apply_closed with complexAbs.function, hIn
  have hReal : Real(complexAbs(ℂ[x - a])) by exact hAbsIn
  have hSmall : complexAbs(ℂ[x - a]) ≤ R[1]
    have split : complexAbs(ℂ[x - a]) ≤ R[1] ∨ ¬(complexAbs(ℂ[x - a]) ≤ R[1]) by tauto
    cases split with done | over
    . exact done
    . exfalso
      have large := realLess.of_not_le with over
      have hPositive : R[0] < complexAbs(ℂ[x - a]) by linarith
      have grown := realLess.mul_left_of_positive with large, hPositive
      rw hSquare at grown
      have unit : R[complexAbs(ℂ[x - a]) * 1] = complexAbs(ℂ[x - a]) by ring
      rw unit at grown
      have impossible : R[1] < R[1] by linarith
      exact realLess.irreflexive_on with R[1], impossible
  have quadratic := complexExp.quadratic_estimate with hIn, hSmall
  have expH := complexExp.member with hIn
  have negOne := IsRing.neg_closed with ordinary, complexOne.member
  have shifted := IsRing.add_closed with ordinary, expH, negOne
  have negH := IsRing.neg_closed with ordinary, hIn
  have remainder := IsRing.add_closed with ordinary, shifted, negH
  have triangle := complexAbs.triangle with remainder, hIn
  have regroup : ℂ[(complexExp(x - a) - 1 - (x - a)) + (x - a)] = ℂ[complexExp(x - a) - 1] by ring
  rw regroup at triangle
  have squareLe := realLe.mul_left_of_nonnegative with hSmall, hNonnegative
  have unitH : R[complexAbs(ℂ[x - a]) * 1] = complexAbs(ℂ[x - a]) by ring
  rw unitH at squareLe
  have mNonnegative := complexAbs.nonnegative with shifted
  have mAbsIn := FunctionBetween.apply_closed with complexAbs.function, shifted
  have mReal : Real(complexAbs(ℂ[complexExp(x - a) - 1])) by exact mAbsIn
  have mBound : complexAbs(ℂ[complexExp(x - a) - 1]) ≤ R[2 * complexAbs(ℂ[x - a])] by linarith
  have sum := complexExp.add with aIn, hIn
  have total : ℂ[a + (x - a)] = x by ring
  rw total at sum
  have expX := complexExp.member with xIn
  have identity : ℂ[complexExp(x) - complexExp(a)] = ℂ[complexExp(a) * (complexExp(x - a) - 1)]
    rw sum
    ring
  have product := complexAbs.mul with expA, shifted
  rw ← identity at product
  have negExpA := IsRing.neg_closed with ordinary, expA
  have difference := IsRing.add_closed with ordinary, expX, negExpA
  have differenceSquare := complexAbs.square with difference
  rw product at differenceSquare
  have twoH : R[0] ≤ R[2 * complexAbs(ℂ[x - a])] by linarith
  have firstStep := realLe.mul_left_of_nonnegative with mBound, mNonnegative
  have secondStep := realLe.mul_right_of_nonnegative with mBound, twoH
  have mSquare : R[complexAbs(ℂ[complexExp(x - a) - 1]) * complexAbs(ℂ[complexExp(x - a) - 1])] ≤ R[(2 * complexAbs(ℂ[x - a])) * (2 * complexAbs(ℂ[x - a]))] by linarith
  have scaled := realLe.mul_left_of_nonnegative with mSquare, aSquare
  have nearLe := realLess.implies_le with near
  have cNonnegative : R[0] ≤ R[4 * (complexAbs(complexExp(a)) * complexAbs(complexExp(a)))] by linarith
  have nearScaled := realLe.mul_left_of_nonnegative with nearLe, cNonnegative
  have expandLeft : R[(complexAbs(complexExp(a)) * complexAbs(ℂ[complexExp(x - a) - 1])) * (complexAbs(complexExp(a)) * complexAbs(ℂ[complexExp(x - a) - 1]))] = R[(complexAbs(complexExp(a)) * complexAbs(complexExp(a))) * (complexAbs(ℂ[complexExp(x - a) - 1]) * complexAbs(ℂ[complexExp(x - a) - 1]))] by ring
  have expandRight : R[(complexAbs(complexExp(a)) * complexAbs(complexExp(a))) * ((2 * complexAbs(ℂ[x - a])) * (2 * complexAbs(ℂ[x - a])))] = R[4 * (complexAbs(complexExp(a)) * complexAbs(complexExp(a))) * (complexAbs(ℂ[x - a]) * complexAbs(ℂ[x - a]))] by ring
  rw expandRight at scaled
  rw hSquare at scaled
  rw ← differenceSquare
  rw expandLeft
  linarith

-- |exp z − 1 − z| ≤ |z|² for |z| ≤ 1, the bound behind the derivative.
theorem complexExp.quadratic_bound (z : Set)
  requires hz : z ∈ ℂ
  requires small : complexAbs(z) ≤ R[1]
  shows complexAbs(ℂ[complexExp(z) - 1 - z]) ≤
    R[complexAbs(z) * complexAbs(z)]
proof
  exact complexExp.quadratic_estimate with hz, small

-- Section: The real exponential
theorem realExp.add (X Y : Real)
  shows realExp(R[X + Y]) = R[realExp(X) * realExp(Y)]
proof
  have sumReal := realExp.real at R[X + Y]
  have xReal := realExp.real at X
  have yReal := realExp.real at Y
  have xIn : X ∈ ℝ by typecheck
  have yIn : Y ∈ ℝ by typecheck
  have xComplex := FunctionBetween.apply_closed with complexOfReal.function, xIn
  have yComplex := FunctionBetween.apply_closed with complexOfReal.function, yIn
  have sum := complexExp.add with xComplex, yComplex
  have image : complexOfReal(realExp(R[X + Y])) = complexOfReal(R[realExp(X) * realExp(Y)])
    rw [complexOfReal.mul, ← complexExp.of_real, ← complexExp.of_real, ← complexExp.of_real, complexOfReal.add, sum]
  exact complexOfReal.injective with image

theorem realExp.positive (X : Real)
  shows R[0] < realExp(X)
proof
  have halfReal := half.real at X
  have halves := half.add_self at X
  have sum := realExp.add at half(X), half(X)
  rw halves at sum
  have halfExp := realExp.real at half(X)
  have square := realMulValue.square_nonnegative at realExp(half(X))
  have nonnegative : R[0] ≤ realExp(X)
    rw sum
    exact square
  have negReal : R[-X] ∈ ℝ by typecheck
  have cancel := realExp.add at X, R[-X]
  have zero : R[X + -X] = R[0] by ring
  rw [zero, realExp.zero] at cancel
  have expReal := realExp.real at X
  have negExp := realExp.real at R[-X]
  have nonzero : realExp(X) ≠ R[0]
    intro vanishes
    rw vanishes at cancel
    have impossible : R[0 * realExp(-X)] = R[0] by ring
    rw impossible at cancel
    have distinct := realZero.ne_one
    apply distinct
    rw cancel
  exact Real.positive_of_nonnegative_of_ne_zero with nonnegative, nonzero

theorem realExp.neg (X : Real)
  shows realExp(R[-X]) = R[1 / realExp(X)]
proof
  have cancel := realExp.add at X, R[-X]
  have zero : R[X + -X] = R[0] by ring
  rw [zero, realExp.zero] at cancel
  have positive := realExp.positive at X
  have nonzero : realExp(X) ≠ R[0]
    intro vanishes
    rw vanishes at positive
    exact realLess.irreflexive_on with R[0], positive
  have law : R[realExp(X) * realExp(-X)] = R[1] by rw cancel
  have inverse := realInvValue.eq_of_mul_right with nonzero, law
  rw [realDiv.eq_mul_inv, inverse]
  ring

theorem realExp.nat_mul (X : Real) (n : Nat)
  shows realExp(R[realNat(n) * X]) = R[realExp(X) ^ n]
proof
  induction n
  | zero =>
    have vanishes : R[0 * X] = R[0] by ring
    rw [realNat.zero, vanishes, realExp.zero, monoidPow.zero]
  | succ(k) using ih =>
    have natReal := realNat.real at k
    have same : realAddValue(realNat(k), R[1]) = R[realNat(k) + 1] by simp [realAddValue, call2]
    have expand : R[(realNat(k) + 1) * X] = R[realNat(k) * X + X] by ring
    have sum := realExp.add at R[realNat(k) * X], X
    rw [realNat.succ, same, expand, sum, ih, monoidPow.succ]
    have expReal := realExp.real at X
    ring

-- eᵗ(1 − t) ≤ 1 for 0 ≤ t < 1, by comparison with the geometric series.
theorem realExp.geometric_bound (T : Real)
  requires nonnegative : R[0] ≤ T
  requires small : T < R[1]
  shows R[(1 - T) * realExp(T)] ≤ R[1]
proof
  have sums := realExp.sums at T
  have absValue := abs.of_nonnegative at T with nonnegative
  have absSmall : abs(T) < R[1] by rwa absValue
  have geometric := geometricSeries.sums_to at T with absSmall
  have below : PointwiseLE(realExpTerms(T), geometricTerms(T))
    intros n nIn
    have nNat := nat.omega.backward at n with nIn
    apply realLe.characterization.forward
    have termNonnegative := realExpTerms.nonnegative at T, n with nonnegative
    have factorialLarge := realNat.factorial_ge_one at n
    have positive := realNat.factorial_pos at n
    have nonzero : realNat(factorial(n)) ≠ R[0]
      intro zero
      rw zero at positive
      exact realLess.irreflexive_on with R[0], positive
    have value := realExpTerms.value at T, n with nIn
    have cancel := realDiv.mul_right at R[T ^ n], realNat(factorial(n)) with nonzero
    have whole : R[realExpTerms(T)(n) * realNat(factorial(n))] = R[T ^ n]
      rw [value, cancel]
    have factorialReal := realNat.real at factorial(n)
    have excess : R[0] ≤ R[realNat(factorial(n)) - 1] by linarith
    have product := realMulValue.nonnegative with termNonnegative, excess
    have expand : R[realExpTerms(T)(n) * (realNat(factorial(n)) - 1)] = R[realExpTerms(T)(n) * realNat(factorial(n)) - realExpTerms(T)(n)] by ring
    rw [expand, whole] at product
    rw geometricTerms.value at T, n with nIn
    unfold realPow
    have termReal : R[realExpTerms(T)(n)] ∈ ℝ by typecheck
    have powerReal : R[T ^ n] ∈ ℝ by typecheck
    linarith
  have compared := SumsTo.le_of_le_terms with sums, geometric, below
  have gapPositive : R[0] < R[1 - T] by linarith
  have gapNonnegative := realLess.implies_le with gapPositive
  have gapNonzero : R[1 - T] ≠ R[0]
    intro zero
    rw zero at gapPositive
    exact realLess.irreflexive_on with R[0], gapPositive
  have scaled := realLe.mul_left_of_nonnegative with compared, gapNonnegative
  have cancel := realDiv.mul_left at R[1], R[1 - T] with gapNonzero
  unfold realSubValue at scaled
  rwa cancel at scaled

theorem realExp.one_add_le (X : Real)
  shows R[1 + X] ≤ realExp(X)
proof
  have one := realZero.lt_one
  have positive := realExp.positive at X
  have expReal := realExp.real at X
  have split : R[0] ≤ X ∨ ¬(R[0] ≤ X) by tauto
  cases split with nonnegative | negative
  . have sums := realExp.sums at X
    have termsNonnegative : NonnegativeTerms(realExpTerms(X))
      intros n nIn
      have nNat := nat.omega.backward at n with nIn
      apply realLe.characterization.forward
      exact realExpTerms.nonnegative at X, n with nonnegative
    have partial := SumsTo.partial_le at realExpTerms(X), realExp(X), succ(succ((0:N))) with sums, termsNonnegative
    have oneIn := nat.omega.forward at succ((0:N)) with assumption
    have unfolded : factorial((0:N)) = (1:N) by rw factorial
    have unfoldedOne : factorial(succ((0:N))) = (1:N)
      rw [factorial, unfolded]
      arith
    have oneNonzero : R[1] ≠ R[0]
      intro same
      have distinct := realZero.ne_one
      apply distinct
      rw same
    have linear : realExpTerms(X)(succ((0:N))) = X
      rw [(realExpTerms.value at X, succ((0:N)) with oneIn), unfoldedOne, realNat.one, monoidPow.succ, monoidPow.zero, realDiv.eq_mul_inv]
      have inverse := realInvValue.eq_of_mul_right at R[1], R[1] with oneNonzero
      have unit : R[1 * 1] = R[1] by ring
      rw unit at inverse
      rw ← inverse
      ring
    have first := realExpTerms.zero at X
    rw [realPartialSum.succ, realPartialSum.succ, realPartialSum.zero, first, linear] at partial
    have zeroSum : realAddValue(R[0], R[1]) = R[0 + 1] by simp [realAddValue, call2]
    have nextSum : realAddValue(R[0 + 1], X) = R[(0 + 1) + X] by simp [realAddValue, call2]
    rw [zeroSum, nextSum] at partial
    linarith
  . have below := realLess.of_not_le with negative
    have far : R[1 + X] ≤ R[0] ∨ ¬(R[1 + X] ≤ R[0]) by tauto
    cases far with large | near
    . linarith
    . have close := realLess.of_not_le with near
      have tNonnegative : R[0] ≤ R[-X] by linarith
      have tSmall : R[-X] < R[1] by linarith
      have bound := realExp.geometric_bound at R[-X] with tNonnegative, tSmall
      have cancel := realExp.add at X, R[-X]
      have zero : R[X + -X] = R[0] by ring
      rw [zero, realExp.zero] at cancel
      have nonnegative := realLess.implies_le with positive
      have scaled := realLe.mul_left_of_nonnegative with bound, nonnegative
      have negReal := realExp.real at R[-X]
      have identity : R[realExp(X) * ((1 - -X) * realExp(-X))] = R[(1 - -X) * (realExp(X) * realExp(-X))] by ring
      rw [identity, ← cancel] at scaled
      have left : R[(1 - -X) * 1] = R[1 + X] by ring
      have right : R[realExp(X) * 1] = realExp(X) by ring
      rwa [left, right] at scaled

theorem realExp.strictly_increasing (X Y : Real)
  requires less : X < Y
  shows realExp(X) < realExp(Y)
proof
  have gapPositive : R[0] < R[Y - X] by linarith
  have sum := realExp.add at X, R[Y - X]
  have total : R[X + (Y - X)] = Y by ring
  rw total at sum
  have bound := realExp.one_add_le at R[Y - X]
  have positive := realExp.positive at X
  have nonnegative := realLess.implies_le with positive
  have scaled := realLe.mul_left_of_nonnegative with bound, nonnegative
  have extra := realMulValue.positive with positive, gapPositive
  have expReal := realExp.real at X
  have gapExp := realExp.real at R[Y - X]
  have expand : R[realExp(X) * (1 + (Y - X))] = R[realExp(X) + realExp(X) * (Y - X)] by ring
  rw expand at scaled
  rw sum
  linarith

theorem realExp.le_iff (X Y : Real)
  shows realExp(X) ≤ realExp(Y) ↔ X ≤ Y
proof
  have xReal := realExp.real at X
  have yReal := realExp.real at Y
  constructor
  . intro le
    have split : X ≤ Y ∨ ¬(X ≤ Y) by tauto
    cases split with done | over
    . exact done
    . have less := realLess.of_not_le with over
      have strict := realExp.strictly_increasing at Y, X with less
      exfalso
      have impossible := realLess.transitive_le with strict, le
      exact realLess.irreflexive_on with realExp(Y), impossible
  . intro le
    have cases := realLess.trichotomy at X, Y
    cases cases with less | rest
    . have strict := realExp.strictly_increasing at X, Y with less
      exact realLess.implies_le with strict
    . cases rest with same | greater
      . rw same
        exact realLe.reflexive at realExp(Y)
      . exfalso
        have impossible := realLess.transitive_le with greater, le
        exact realLess.irreflexive_on with Y, impossible

theorem realExp.injective (X Y : Real)
  requires same : realExp(X) = realExp(Y)
  shows X = Y
proof
  have xReal := realExp.real at X
  have yReal := realExp.real at Y
  have first : realExp(X) ≤ realExp(Y)
    rw same
    exact realLe.reflexive at realExp(Y)
  have second : realExp(Y) ≤ realExp(X)
    rw same
    exact realLe.reflexive at realExp(Y)
  have firstIff := realExp.le_iff at X, Y
  have secondIff := realExp.le_iff at Y, X
  have xy := firstIff.forward with first
  have yx := secondIff.forward with second
  exact realLe.antisymmetric with xy, yx

theorem openBall.of_abs (X C E : Real)
  requires close : abs(R[X - C]) < E
  shows X ∈ openBall(C, E)
proof
  have xIn : X ∈ ℝ by typecheck
  apply openBall.membership.backward
  constructor
  . exact xIn
  . unfold dist
    unfold realSubValue
    exact close

theorem openBall.abs (X C E : Real)
  requires member : X ∈ openBall(C, E)
  shows abs(R[X - C]) < E
proof
  have parts := openBall.membership.forward with member
  obtain ⟨_, close⟩ := parts
  unfold dist at close
  unfold realSubValue at close
  exact close

-- |eʰ − 1 − h| ≤ h² for |h| ≤ 1.
theorem realExp.quadratic_bound (H : Real)
  requires small : abs(H) ≤ R[1]
  shows abs(R[realExp(H) - 1 - H]) ≤ R[abs(H) * abs(H)]
proof
  have hIn : H ∈ ℝ by typecheck
  have embedded := FunctionBetween.apply_closed with complexOfReal.function, hIn
  have absValue := complexAbs.of_real at H
  have smallComplex : complexAbs(complexOfReal(H)) ≤ R[1] by rwa absValue
  have bound := complexExp.quadratic_bound with embedded, smallComplex
  have expReal := realExp.real at H
  have same : ℂ[complexExp(complexOfReal(H)) - 1 - complexOfReal(H)] = complexOfReal(R[realExp(H) - 1 - H])
    rw [complexOfReal.add, complexOfReal.add, complexOfReal.neg, complexOfReal.neg, complexOfReal.one, complexExp.of_real]
  rw [same, complexAbs.of_real, absValue] at bound
  exact bound

-- The derivative of eˣ is eˣ.
theorem realExp.has_derivative (X : Real)
  shows HasDerivativeAt(realExp, realExp(X), X)
proof
  have function := realExp.function
  have quotientFunction := differenceQuotient.function at realExp, X with function
  have expReal := realExp.real at X
  have positive := realExp.positive at X
  have one := realZero.lt_one
  unfold HasDerivativeAt
  refine ⟨function, ?_⟩
  unfold TendsToAt
  refine ⟨quotientFunction, ?_⟩
  intros e eIn ePositive
  have eReal : Real(e) by exact eIn
  have scalePositive : R[0] < R[realExp(X) + e + 1] by linarith
  have scaleNonzero : R[realExp(X) + e + 1] ≠ R[0]
    intro zero
    rw zero at scalePositive
    exact realLess.irreflexive_on with R[0], scalePositive
  have inverse := realInvValue.positive with scalePositive
  have radiusPositive := realMulValue.positive with ePositive, inverse
  have cancel := realInvValue.mul_right with scaleNonzero
  have radiusIn : R[e * realInvValue(realExp(X) + e + 1)] ∈ ℝ by typecheck
  have whole : R[(e * realInvValue(realExp(X) + e + 1)) * (realExp(X) + e + 1)] = e
    have regroup : R[(e * realInvValue(realExp(X) + e + 1)) * (realExp(X) + e + 1)] = R[e * ((realExp(X) + e + 1) * realInvValue(realExp(X) + e + 1))] by ring
    rw [regroup, cancel]
    ring
  refine ⟨R[e * realInvValue(realExp(X) + e + 1)], radiusIn, radiusPositive, ?_⟩
  intros H hIn nonzero near
  have hReal : Real(H) by exact hIn
  have closeRaw := openBall.abs with near
  have shift : R[H - 0] = H by ring
  rw shift at closeRaw
  have radiusNonnegative := realLess.implies_le with radiusPositive
  have radiusSmall : R[e * realInvValue(realExp(X) + e + 1)] ≤ R[1]
    have multiplied : R[(e * realInvValue(realExp(X) + e + 1)) * (realExp(X) + e + 1)] ≤ R[1 * (realExp(X) + e + 1)]
      rw whole
      have unit : R[1 * (realExp(X) + e + 1)] = R[realExp(X) + e + 1] by ring
      rw unit
      linarith
    exact realLe.mul_right_cancel_positive with scalePositive, multiplied
  have hSmall : abs(H) ≤ R[1]
    have weak := realLess.implies_le with closeRaw
    linarith
  have quadratic := realExp.quadratic_bound at H with hSmall
  have hNonzero : H ≠ R[0] by exact nonzero
  have absPositive := abs.positive_of_ne at H with hNonzero
  have value := differenceQuotient.value at realExp, X, H with function
  have quotientIn : R[(realExp(X + H) - realExp(X)) / H] ∈ ℝ by typecheck
  have shiftedReal := realExp.real at R[X + H]
  have hExpReal := realExp.real at H
  have recover := realDiv.mul_right at R[realExp(X + H) - realExp(X)], H with hNonzero
  have sum := realExp.add at X, H
  have product : R[((realExp(X + H) - realExp(X)) / H - realExp(X)) * H] = R[realExp(X) * (realExp(H) - 1 - H)]
    have expand : R[((realExp(X + H) - realExp(X)) / H - realExp(X)) * H] = R[((realExp(X + H) - realExp(X)) / H) * H - realExp(X) * H] by ring
    rw [expand, recover, sum]
    ring
  have absProduct := abs.mul at R[(realExp(X + H) - realExp(X)) / H - realExp(X)], H
  rw product at absProduct
  have absFactor := abs.mul at realExp(X), R[realExp(H) - 1 - H]
  have expNonnegative := realLess.implies_le with positive
  have expAbs := abs.of_nonnegative at realExp(X) with expNonnegative
  rw [absFactor, expAbs] at absProduct
  have scaledQuadratic := realLe.mul_left_of_nonnegative with quadratic, expNonnegative
  have absNonnegative := abs.nonnegative at H
  have bounded : R[abs((realExp(X + H) - realExp(X)) / H - realExp(X)) * abs(H)] ≤ R[(realExp(X) * abs(H)) * abs(H)]
    rw ← absProduct
    have regroup : R[realExp(X) * (abs(H) * abs(H))] = R[(realExp(X) * abs(H)) * abs(H)] by ring
    rwa regroup at scaledQuadratic
  have cancelled := realLe.mul_right_cancel_positive with absPositive, bounded
  have closeScaled := realLess.mul_left_of_positive with closeRaw, positive
  have radiusScaled : R[realExp(X) * (e * realInvValue(realExp(X) + e + 1))] < e
    have eNonnegative := realLess.implies_le with ePositive
    have expBelow : realExp(X) < R[realExp(X) + e + 1] by linarith
    have strict := realLess.mul_left_of_positive with expBelow, radiusPositive
    have commute : R[realExp(X) * (e * realInvValue(realExp(X) + e + 1))] = R[(e * realInvValue(realExp(X) + e + 1)) * realExp(X)] by ring
    rw commute
    linarith
  rw value
  apply openBall.of_abs
  unfold realSubValue
  linarith

theorem realExp.continuous
  shows Continuous(realExp)
proof
  have function := realExp.function
  unfold Continuous
  refine ⟨function, ?_⟩
  intros a aIn
  have aReal : Real(a) by exact aIn
  have derivative := realExp.has_derivative at a
  exact HasDerivativeAt.continuous_at with derivative

theorem realExp.derivative (X : Real)
  shows HasDerivativeAt(realExp, realExp(X), X)
proof
  exact realExp.has_derivative at X

theorem realExp.onto_above_one (Y : Real)
  requires above : R[1] ≤ Y
  shows ∃ X ∈ ℝ, realExp(X) = Y
proof
  have one := realZero.lt_one
  have nonnegative : R[0] ≤ Y by linarith
  have continuous := realExp.continuous
  have subset := closedInterval.subset_reals at R[0], Y
  have on := Continuous.continuous_on with continuous, subset
  have below : realExp(R[0]) ≤ Y by rwa realExp.zero
  have growth := realExp.one_add_le at Y
  have beyond : Y ≤ realExp(Y) by linarith
  obtain ⟨C, cIn, value⟩ := closedInterval.intermediate_value_le at realExp, R[0], Y, Y with nonnegative, on, below, beyond
  have cReal : C ∈ ℝ by exact subset with C, cIn
  refine ⟨C, cReal, value⟩

theorem realExp.onto_positive (Y : Real)
  requires positive : R[0] < Y
  shows ∃ X ∈ ℝ, realExp(X) = Y
proof
  have one := realZero.lt_one
  have split : R[1] ≤ Y ∨ ¬(R[1] ≤ Y) by tauto
  cases split with large | small
  . exact realExp.onto_above_one at Y with large
  . have below := realLess.of_not_le with small
    have nonzero : Y ≠ R[0]
      intro zero
      rw zero at positive
      exact realLess.irreflexive_on with R[0], positive
    have cancel := realDiv.mul_left at R[1], Y with nonzero
    have reciprocalIn : R[1 / Y] ∈ ℝ by typecheck
    have reciprocalLarge : R[1] ≤ R[1 / Y]
      have reciprocalSplit : R[1] ≤ R[1 / Y] ∨ ¬(R[1] ≤ R[1 / Y]) by tauto
      cases reciprocalSplit with done | over
      . exact done
      . exfalso
        have less := realLess.of_not_le with over
        have scaled := realLess.mul_left_of_positive with less, positive
        rw cancel at scaled
        have unit : R[Y * 1] = Y by ring
        rw unit at scaled
        have impossible := realLess.transitive with scaled, below
        exact realLess.irreflexive_on with R[1], impossible
    obtain ⟨C, cIn, value⟩ := realExp.onto_above_one at R[1 / Y] with reciprocalLarge
    have cReal : Real(C) by exact cIn
    have negIn : R[-C] ∈ ℝ by typecheck
    refine ⟨R[-C], negIn, ?_⟩
    have inverse := realInvValue.involutive at Y with nonzero
    have simplify : R[1 * realInvValue(Y)] = realInvValue(Y) by ring
    rw [realExp.neg, value, realDiv.eq_mul_inv, realDiv.eq_mul_inv, simplify, inverse]
    ring

theorem realExp.bijective
  shows BijectiveBetween(realExp, ℝ, positiveReals)
proof
  have function := realExp.function
  have values : ∀ x ∈ ℝ, realExp(x) ∈ positiveReals
    intros x xIn
    have xReal : Real(x) by exact xIn
    have expIn := realExp.real at x
    have positive := realExp.positive at x
    exact positiveReals.membership.backward with ⟨expIn, positive⟩
  have restricted := FunctionBetween.codomain_of_values with function, values
  constructor
  . refine ⟨restricted, ?_⟩
    intros x xIn y yIn w wIn first second
    have firstValue := FunctionBetween.apply_value with restricted, xIn, first
    have secondValue := FunctionBetween.apply_value with restricted, yIn, second
    have xReal : Real(x) by exact xIn
    have yReal : Real(y) by exact yIn
    have same : realExp(x) = realExp(y) by rw [firstValue, secondValue]
    exact realExp.injective with same
  . refine ⟨restricted, ?_⟩
    intros y yIn
    obtain ⟨yReal, positive⟩ := positiveReals.membership.forward with yIn
    have typed : Real(y) by exact yReal
    obtain ⟨x, xIn, value⟩ := realExp.onto_positive at y with positive
    have relates := FunctionBetween.relates_apply with restricted, xIn
    rw value at relates
    refine ⟨x, xIn, relates⟩

-- |exp z| = e^(re z).
theorem complexExp.abs (z : Set)
  requires hz : z ∈ ℂ
  shows complexAbs(complexExp(z)) = realExp(complexRe(z))
proof
  have ring := complexes.comm_ring
  have ordinary := IsCommRing.ring with ring
  have reIn := complexRe.real with hz
  have imIn := complexIm.real with hz
  have reReal : Real(complexRe(z)) by exact reIn
  have imReal : Real(complexIm(z)) by exact imIn
  have shape := complex.re_add_im with hz
  have realPart := FunctionBetween.apply_closed with complexOfReal.function, reIn
  have imaginaryPart := FunctionBetween.apply_closed with complexOfReal.function, imIn
  have unit := complexImaginaryUnit.member
  have rotation := IsRing.mul_closed with ordinary, unit, imaginaryPart
  have negRotation := IsRing.neg_closed with ordinary, rotation
  have sum := complexExp.add with realPart, rotation
  rw ← shape at sum
  have rotationExp := complexExp.member with rotation
  have conjUnit : complexConj(complexImaginaryUnit) = ℂ[-complexImaginaryUnit]
    unfold complexImaginaryUnit
    rw [complexConj.pair, complexNeg.pair]
    apply complex.pair_congr
    . ring
    . rfl
  have conjRotation : complexConj(ℂ[complexImaginaryUnit * complexOfReal(complexIm(z))]) = ℂ[-(complexImaginaryUnit * complexOfReal(complexIm(z)))]
    have product := complexConj.mul with unit, imaginaryPart
    rw [product, conjUnit, complexConj.of_real]
    ring
  have conjExp := complexExp.conj with rotation
  rw conjRotation at conjExp
  have cancel := complexExp.neg with rotation
  have selfProduct := complexConj.mul_self with rotationExp
  rw ← conjExp at selfProduct
  have commuted : ℂ[complexExp(complexImaginaryUnit * complexOfReal(complexIm(z))) * complexExp(-(complexImaginaryUnit * complexOfReal(complexIm(z))))] = ℂ[1]
    have negExp := complexExp.member with negRotation
    rw ← cancel
    ring
  rw [commuted, ← complexOfReal.one] at selfProduct
  have normReal := complexNormSquared.real with rotationExp
  have normOne := complexOfReal.injective with selfProduct
  have oneNonnegative := realLess.implies_le with realZero.lt_one
  have square : R[1 * 1] = complexNormSquared(complexExp(ℂ[complexImaginaryUnit * complexOfReal(complexIm(z))]))
    rw ← normOne
    ring
  have unitAbs := complexAbs.unique with rotationExp, oneNonnegative, square
  have realExpIn := complexExp.member with realPart
  have product := complexAbs.mul with realExpIn, rotationExp
  have expPositive := realExp.positive at complexRe(z)
  have expNonnegative := realLess.implies_le with expPositive
  have expAbs := abs.of_nonnegative with expNonnegative
  rw [sum, product, unitAbs, complexExp.of_real, complexAbs.of_real, expAbs]
  have expReal := realExp.real at complexRe(z)
  ring

end Complexes
