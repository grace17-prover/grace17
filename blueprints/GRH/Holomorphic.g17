-- Holomorphic functions. The topology of ℂ from the modulus, with open
-- disks, connected and compact subsets; complex differentiability of a
-- function at a point of an open set, and holomorphy on an open set;
-- sums, products, quotients, and composites of holomorphic functions;
-- power series are holomorphic inside their radius of convergence; exp,
-- sin, cos, the principal logarithm, and s ↦ x^s are holomorphic; uniform
-- limits on compact subsets of holomorphic functions are holomorphic; and
-- the identity theorem.
-- Part of the GRH blueprint.
-- Planned home: Complex/Holomorphic.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Holomorphic
import GRH.Log
import Grace.Cumulus.Topology.Connected
import Grace.Cumulus.Topology.Plane
import Grace.Cumulus.Real.Analysis.Integration

section Holomorphy
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Section: The topology of ℂ
-- The open disk {z : |z − a| < r}, the closed disk {z : |z − a| ≤ r},
-- and the topology whose open sets
-- contain an open disk around each of their points.
def complexDisk (a r : Set) : Set :=
  { z ∈ complexCarrier | complexAbs(ℂ[z - a]) < r }

def complexClosedDisk (a r : Set) : Set :=
  { z ∈ complexCarrier | complexAbs(ℂ[z - a]) ≤ r }

def complexTopology : Set :=
  { U ∈ 𝒫(complexCarrier) | ∀ a ∈ U, ∃ r ∈ ℝ, realZero < r ∧
      complexDisk(a, r) ⊆ U }

predicate ComplexOpen (U : Set) := U ∈ complexTopology

predicate ComplexConnected (U : Set) :=
  IsConnectedSubset(complexCarrier, complexTopology, U)

predicate ComplexCompact (K : Set) :=
  IsCompact(complexCarrier, complexTopology, K)

-- The half-plane re z > σ.
def rightHalfPlane (S : Real) : Set :=
  { z ∈ complexCarrier | S < complexRe(z) }

-- Section: Functions on a set
-- A function on U is given by its values on U; the predicates below read
-- only those values.
predicate ComplexValuedOn (f U : Set) := ∀ z ∈ U, f(z) ∈ complexCarrier

predicate ComplexContinuousOn (f U : Set) :=
  U ⊆ complexCarrier ∧ ComplexValuedOn(f, U) ∧
  (∀ a ∈ U, ∀ e ∈ ℝ, realZero < e → ∃ d ∈ ℝ, realZero < d ∧
    (∀ z ∈ U, complexAbs(ℂ[z - a]) < d →
      complexAbs(ℂ[f(z) - f(a)]) < e))

-- Section: Complex differentiability
-- f has derivative D at the point a of the open set U when
-- |f(z) − f(a) − D (z − a)| ≤ ε |z − a| for z ∈ U near a, for every ε > 0;
-- that is, (f(z) − f(a)) / (z − a) → D as z → a.
predicate HasComplexDerivativeAt (f U D a : Set) :=
  ComplexOpen(U) ∧ a ∈ U ∧ D ∈ complexCarrier ∧ ComplexValuedOn(f, U) ∧
  (∀ e ∈ ℝ, realZero < e → ∃ d ∈ ℝ, realZero < d ∧
    (∀ z ∈ U, complexAbs(ℂ[z - a]) < d →
      complexAbs(ℂ[f(z) - f(a) - D * (z - a)]) ≤
        R[e * complexAbs(ℂ[z - a])]))

predicate ComplexDifferentiableAt (f U a : Set) :=
  ∃ D ∈ complexCarrier, HasComplexDerivativeAt(f, U, D, a)

predicate HolomorphicOn (f U : Set) :=
  ComplexOpen(U) ∧ ComplexValuedOn(f, U) ∧
  (∀ a ∈ U, ComplexDifferentiableAt(f, U, a))

-- Two positive radii have a positive radius below both.
theorem realRadius.common (r s : Set)
  requires hr : r ∈ ℝ
  requires hs : s ∈ ℝ
  requires positiveR : R[0] < r
  requires positiveS : R[0] < s
  shows ∃ t ∈ ℝ, R[0] < t ∧ t ≤ r ∧ t ≤ s
proof
  have order := realLess.trichotomy at r, s
  cases order with smaller | rest
  . refine ⟨r, hr, positiveR, ?_, ?_⟩
    . linarith
    . linarith
  . refine ⟨s, hs, positiveS, ?_, ?_⟩
    . cases rest with equal | larger
      . linarith
      . linarith
    . linarith

-- A nonnegative factor K can be absorbed: some 0 < ε ≤ e has K ε ≤ e.
theorem realScale.absorb (K e : Set)
  requires hK : K ∈ ℝ
  requires he : e ∈ ℝ
  requires nonnegative : R[0] ≤ K
  requires positive : R[0] < e
  shows ∃ ε ∈ ℝ, R[0] < ε ∧ R[K * ε] ≤ e ∧ ε ≤ e
proof
  have sumPositive : R[0] < R[K + 1] by linarith
  have sumNonzero : R[K + 1] ≠ R[0] by linarith
  have typedE : Real(e) by typecheck
  have typedK : Real(K) by typecheck
  have cancel := realDiv.mul_right at e, R[K + 1] with sumNonzero
  have εReal : R[e / (K + 1)] ∈ ℝ by typecheck
  have εPositive : R[0] < R[e / (K + 1)]
    by_contra notPositive
    have nonpositive : R[e / (K + 1)] ≤ R[0] by linarith
    have sumNonnegative : R[0] ≤ R[K + 1] by linarith
    have product := realLe.mul_right_of_nonnegative with nonpositive,
      sumNonnegative
    have zero : R[0 * (K + 1)] = R[0] by ring
    linarith
  have expand : R[K * (e / (K + 1)) + e / (K + 1)] = e by
    linear_combination cancel
  have εNonnegative : R[0] ≤ R[e / (K + 1)] by linarith
  have product := realLe.mul_right_of_nonnegative with nonnegative,
    εNonnegative
  have zero : R[0 * (e / (K + 1))] = R[0] by ring
  refine ⟨R[e / (K + 1)], εReal, εPositive, ?_, ?_⟩
  . linarith
  . linarith

-- |x − y| ≤ |x| + |y|.
theorem complexAbs.sub_le (x y : Set)
  requires hx : x ∈ ℂ
  requires hy : y ∈ ℂ
  shows complexAbs(ℂ[x - y]) ≤ R[complexAbs(x) + complexAbs(y)]
proof
  have negY : ℂ[-y] ∈ ℂ by typecheck
  have triangle := complexAbs.triangle with hx, negY
  rw (complexAbs.neg with hy) at triangle
  exact triangle

theorem HasComplexDerivativeAt.unique (f U D E a : Set)
  requires first : HasComplexDerivativeAt(f, U, D, a)
  requires second : HasComplexDerivativeAt(f, U, E, a)
  shows D = E
proof
  obtain ⟨isOpen, ha, hD, values, close1⟩ := first
  obtain ⟨_, _, hE, _, close2⟩ := second
  have member : U ∈ complexTopology by exact isOpen
  obtain ⟨subsets, disks⟩ := complexTopology.membership.forward with member
  have inside := powerset.membership_iff.forward with subsets
  have aMember := inside with a, ha
  obtain ⟨r, hr, rPositive, disk⟩ := disks with a, ha
  have difference : ℂ[D - E] ∈ ℂ by typecheck
  by_contra distinct
  have nonzero : ℂ[D - E] ≠ ℂ[0]
    intro zero
    apply distinct
    have same : D = ℂ[(D - E) + E] by ring
    rw [same, zero]
    ring
  have gap := complexAbs.positive with difference, nonzero
  have gapReal : complexAbs(ℂ[D - E]) ∈ ℝ by typecheck
  have typedGap : Real(complexAbs(ℂ[D - E])) by typecheck
  have halfGap := half.positive with gap
  have halfBelow := half.lt_self with gap
  have halfReal : half(complexAbs(ℂ[D - E])) ∈ ℝ by typecheck
  have two : R[2] ∈ ℝ by typecheck
  have twoNonnegative : R[0] ≤ R[2] by linarith
  obtain ⟨ε, hε, εPositive, twice, _⟩ := realScale.absorb with two, halfReal,
    twoNonnegative, halfGap
  obtain ⟨d1, hd1, positive1, near1⟩ := close1 with ε, hε, εPositive
  obtain ⟨d2, hd2, positive2, near2⟩ := close2 with ε, hε, εPositive
  obtain ⟨t, ht, tPositive, le1, le2⟩ := realRadius.common with hd1, hd2,
    positive1, positive2
  obtain ⟨u, hu, uPositive, leT, leR⟩ := realRadius.common with ht, hr,
    tPositive, rPositive
  have typedU : Real(u) by typecheck
  have sPositive := half.positive with uPositive
  have sBelow := half.lt_self with uPositive
  have sReal : half(u) ∈ ℝ by typecheck
  have step : complexOfReal(half(u)) ∈ ℂ by typecheck
  have z : ℂ[a + complexOfReal(half(u))] ∈ ℂ by typecheck
  have shift : ℂ[(a + complexOfReal(half(u))) - a] = complexOfReal(half(u))
    by ring
  have distance : complexAbs(ℂ[(a + complexOfReal(half(u))) - a]) = half(u)
    have sNonnegative : R[0] ≤ half(u) by linarith
    rw [shift, (complexAbs.of_real at half(u))]
    exact abs.of_nonnegative at half(u) with sNonnegative
  have inDisk : ℂ[a + complexOfReal(half(u))] ∈ complexDisk(a, r)
    apply complexDisk.membership.backward
    refine ⟨z, ?_⟩
    rw distance
    linarith
  have zU := disk with ℂ[a + complexOfReal(half(u))], inDisk
  have small1 : complexAbs(ℂ[(a + complexOfReal(half(u))) - a]) < d1 by
    linarith
  have small2 : complexAbs(ℂ[(a + complexOfReal(half(u))) - a]) < d2 by
    linarith
  have bound1 := near1 with ℂ[a + complexOfReal(half(u))], zU, small1
  have bound2 := near2 with ℂ[a + complexOfReal(half(u))], zU, small2
  rw distance at bound1, bound2
  have fz := values with ℂ[a + complexOfReal(half(u))], zU
  have fa := values with a, ha
  have error1 : ℂ[f(a + complexOfReal(half(u))) - f(a) -
      D * ((a + complexOfReal(half(u))) - a)] ∈ ℂ by typecheck
  have error2 : ℂ[f(a + complexOfReal(half(u))) - f(a) -
      E * ((a + complexOfReal(half(u))) - a)] ∈ ℂ by typecheck
  have identity : ℂ[(D - E) * ((a + complexOfReal(half(u))) - a)] =
      ℂ[(f(a + complexOfReal(half(u))) - f(a) -
        E * ((a + complexOfReal(half(u))) - a)) -
        (f(a + complexOfReal(half(u))) - f(a) -
        D * ((a + complexOfReal(half(u))) - a))] by ring
  have triangle := complexAbs.sub_le with error2, error1
  rw ← identity at triangle
  have zDifference : ℂ[(a + complexOfReal(half(u))) - a] ∈ ℂ by typecheck
  rw [(complexAbs.mul with difference, zDifference), distance] at triangle
  have sum : R[ε * half(u) + ε * half(u)] = R[(2 * ε) * half(u)] by ring
  have sNonnegative : R[0] ≤ half(u) by linarith
  have scaled := realLe.mul_right_of_nonnegative with twice, sNonnegative
  have error1Real : complexAbs(ℂ[f(a + complexOfReal(half(u))) - f(a) -
      D * ((a + complexOfReal(half(u))) - a)]) ∈ ℝ by typecheck
  have error2Real : complexAbs(ℂ[f(a + complexOfReal(half(u))) - f(a) -
      E * ((a + complexOfReal(half(u))) - a)]) ∈ ℝ by typecheck
  have products : R[complexAbs(ℂ[D - E]) * half(u)] ≤
      R[half(complexAbs(ℂ[D - E])) * half(u)]
    have rightReal : R[half(complexAbs(ℂ[D - E])) * half(u)] ∈ ℝ by
      typecheck
    linarith
  have cancelled := realLe.mul_right_cancel_positive with sPositive, products
  linarith

-- The derivative f′(a), and the derivative of a holomorphic function as a
-- function on its open set.
defunique complexDerivativeValue (f U a : Set) (D ∈ complexCarrier) :=
  HasComplexDerivativeAt(f, U, D, a)
requires differentiable : ComplexDifferentiableAt(f, U, a)
proof
  exact differentiable
uniqueness
  intros D hD first E hE second
  exact HasComplexDerivativeAt.unique with first, second

defgraph complexDeriv (f U : Set) (a ∈ U) : complexCarrier :=
    complexDerivativeValue(f, U, a)
requires holomorphic : HolomorphicOn(f, U)
proof
  obtain ⟨_, _, differentiable⟩ := holomorphic
  have selected := complexDerivativeValue.selected with
    (differentiable with member)
  exact selected.left

-- Section: Operations on functions
-- The pointwise sum, product, quotient, and composite of functions on U,
-- and the constant and identity functions on U.
defgraph complexFunctionAdd (f g U : Set) (z ∈ U) : complexCarrier :=
    ℂ[f(z) + g(z)]
requires valuesF : ComplexValuedOn(f, U)
requires valuesG : ComplexValuedOn(g, U)
proof
  have fz := valuesF with member
  have gz := valuesG with member
  typecheck

defgraph complexFunctionNeg (f U : Set) (z ∈ U) : complexCarrier :=
    ℂ[-f(z)]
requires valuesF : ComplexValuedOn(f, U)
proof
  have fz := valuesF with member
  typecheck

defgraph complexFunctionMul (f g U : Set) (z ∈ U) : complexCarrier :=
    ℂ[f(z) * g(z)]
requires valuesF : ComplexValuedOn(f, U)
requires valuesG : ComplexValuedOn(g, U)
proof
  have fz := valuesF with member
  have gz := valuesG with member
  typecheck

defgraph complexFunctionDiv (f g U : Set) (z ∈ U) : complexCarrier :=
    complexDiv(f(z), g(z))
requires valuesF : ComplexValuedOn(f, U)
requires valuesG : ComplexValuedOn(g, U)
proof
  have fz := valuesF with member
  have gz := valuesG with member
  have inverse := complexInv.member with gz
  unfold complexDiv
  typecheck

defgraph complexFunctionComp (g f U : Set) (z ∈ U) : complexCarrier :=
    g(f(z))
requires values : ∀ z ∈ U, g(f(z)) ∈ complexCarrier
proof
  exact values with member

defgraph complexFunctionConst (c U : Set) (z ∈ U) : complexCarrier := c
requires hc : c ∈ complexCarrier
proof
  exact hc

defgraph complexFunctionId (U : Set) (z ∈ U) : complexCarrier := z
requires inside : U ⊆ complexCarrier
proof
  exact inside with member

-- Section: Series of functions and power series
-- The sum of a convergent complex series.
defunique complexSeriesSum (u : Set) (S ∈ complexCarrier) :=
  ComplexSumsTo(u, S)
requires summable : ComplexSummable(u)
proof
  exact summable
uniqueness
  intros S hS first T hT second
  exact ComplexSumsTo.unique with first, second

-- The sequence n ↦ Fₙ(z) of values of a sequence of functions at z.
defgraph complexValueSequence (F z : Set) (n ∈ ℕ) : complexCarrier :=
    F(n)(z)
requires values : ∀ n ∈ ℕ, F(n)(z) ∈ complexCarrier
proof
  exact values with member

-- The function z ↦ Σ Fₙ(z) on U.
defgraph complexFunctionSeries (F U : Set) (z ∈ U) : complexCarrier :=
    complexSeriesSum(complexValueSequence(F, z))
requires summable : ∀ z ∈ U, ComplexSummable(complexValueSequence(F, z))
proof
  have selected := complexSeriesSum.selected with (summable with member)
  exact selected.left

-- Powers of complex numbers are complex.
theorem complexPow.member (z : Set) (n : Nat)
  requires hz : z ∈ ℂ
  shows ℂ[z ^ n] ∈ ℂ
proof
  have ring := complexes.comm_ring
  have ordinary := IsCommRing.ring with ring
  have monoid := IsRing.multiplicative with ordinary
  exact monoidPow.closed at ℂ, complexMul, complexOne, z, n with monoid, hz

-- The terms cₙ (z − a)ⁿ of the power series with coefficients c about a.
defgraph powerSeriesTerms (c a z : Set) (n ∈ ℕ) : complexCarrier :=
    ℂ[c(n) * (z - a) ^ n]
requires coefficients : ComplexSequence(c)
requires ha : a ∈ complexCarrier
requires hz : z ∈ complexCarrier
proof
  have cn := FunctionBetween.apply_closed with coefficients, member
  have nNat := nat.omega.backward at n with member
  have difference : ℂ[z - a] ∈ ℂ by typecheck
  have power := complexPow.member at ℂ[z - a], n with difference
  typecheck

-- The radius of convergence is at least r when |cₙ| ρⁿ is bounded for
-- every 0 ≤ ρ < r (the Cauchy–Hadamard description); r is a real here,
-- and an infinite radius is radius at least r for every r.
predicate PowerSeriesRadiusAtLeast (c r : Set) :=
  ComplexSequence(c) ∧ r ∈ ℝ ∧
  (∀ ρ ∈ ℝ, realZero ≤ ρ → ρ < r → ∃ B ∈ ℝ, ∀ n ∈ ℕ,
    R[complexAbs(c(n)) * ρ ^ n] ≤ B)

-- Dominated by a geometric series: if |uₙ| ≤ B qⁿ with 0 ≤ q < 1 then u
-- is absolutely summable.
theorem ComplexAbsolutelySummable.of_geometric (u : Set) (B q : Real)
  requires sequence : ComplexSequence(u)
  requires nonnegative : R[0] ≤ q
  requires below : q < R[1]
  requires dominated : ∀ n ∈ ℕ, complexAbs(u(n)) ≤ R[B * q ^ n]
  shows ComplexAbsolutelySummable(u)
proof
  have small : abs(q) < (1:R)
    rw (abs.of_nonnegative at q with nonnegative)
    exact below
  have sums := geometricSeries.sums_to with small
  have summable := SumsTo.summable with sums
  have scaled := Summable.scale at geometricTerms(q), B with summable
  apply ComplexAbsolutelySummable.of_bound with sequence, scaled
  intros n hn
  have nNat := nat.omega.backward at n with hn
  have geometric := geometricTerms.sequence at q
  have constant := constantSequence.sequence at B
  have powerReal : Real(realPow(q, n)) by typecheck
  have convert : realPow(q, n) = R[q ^ n]
    unfold realPow
    rfl
  have term := geometricTerms.value at q, n with hn
  have constantValue := constantSequence.value at B, n
  have typedGeometric : Real(geometricTerms(q)(n))
    rw term
    exact powerReal
  have typedConstant : Real(constantSequence(B)(n))
    rw constantValue
    typecheck
  rw [(mulSequence.value with constant, geometric, typedConstant,
    typedGeometric), term, constantValue, convert]
  exact dominated with n, hn

-- Inside the radius the terms are dominated by a geometric series.
theorem powerSeriesTerms.absolutely_summable (c a r z : Set)
  requires radius : PowerSeriesRadiusAtLeast(c, r)
  requires ha : a ∈ ℂ
  requires hz : z ∈ complexDisk(a, r)
  shows ComplexAbsolutelySummable(powerSeriesTerms(c, a, z))
proof
  obtain ⟨coefficients, hr, bounded⟩ := radius
  obtain ⟨zMember, near⟩ := complexDisk.membership.forward with hz
  have step : ℂ[z - a] ∈ ℂ by typecheck
  have tNonnegative := complexAbs.nonnegative with step
  have tReal : complexAbs(ℂ[z - a]) ∈ ℝ by typecheck
  have typedT : Real(complexAbs(ℂ[z - a])) by typecheck
  have typedR : Real(r) by typecheck
  have sumReal : R[complexAbs(ℂ[z - a]) + r] ∈ ℝ by typecheck
  have typedSum : Real(R[complexAbs(ℂ[z - a]) + r]) by typecheck
  have halfSum := half.add_self at R[complexAbs(ℂ[z - a]) + r]
  have ρReal : half(R[complexAbs(ℂ[z - a]) + r]) ∈ ℝ by typecheck
  have above : complexAbs(ℂ[z - a]) < half(R[complexAbs(ℂ[z - a]) + r]) by
    linarith
  have belowR : half(R[complexAbs(ℂ[z - a]) + r]) < r by linarith
  have ρPositive : R[0] < half(R[complexAbs(ℂ[z - a]) + r]) by linarith
  have ρNonnegative : R[0] ≤ half(R[complexAbs(ℂ[z - a]) + r]) by linarith
  obtain ⟨B, hB, bound⟩ := bounded with half(R[complexAbs(ℂ[z - a]) + r]),
    ρReal, ρNonnegative, belowR
  have typedB : Real(B) by typecheck
  have ρNonzero : half(R[complexAbs(ℂ[z - a]) + r]) ≠ R[0] by linarith
  have cancel := realDiv.mul_right at complexAbs(ℂ[z - a]),
    half(R[complexAbs(ℂ[z - a]) + r]) with ρNonzero
  have qReal : R[complexAbs(ℂ[z - a]) / half(R[complexAbs(ℂ[z - a]) + r])]
    ∈ ℝ by typecheck
  have typedQ : Real(R[complexAbs(ℂ[z - a]) /
    half(R[complexAbs(ℂ[z - a]) + r])]) by typecheck
  have qNonnegative : R[0] ≤ R[complexAbs(ℂ[z - a]) /
      half(R[complexAbs(ℂ[z - a]) + r])]
    by_contra notNonnegative
    have below : R[complexAbs(ℂ[z - a]) /
      half(R[complexAbs(ℂ[z - a]) + r])] < R[0] by linarith
    have product := realLess.mul_right_of_positive with below, ρPositive
    have zeroTimes : R[0 * half(R[complexAbs(ℂ[z - a]) + r])] = R[0] by ring
    linarith
  have qBelow : R[complexAbs(ℂ[z - a]) /
      half(R[complexAbs(ℂ[z - a]) + r])] < R[1]
    by_contra notBelow
    have large : R[1] ≤ R[complexAbs(ℂ[z - a]) /
      half(R[complexAbs(ℂ[z - a]) + r])] by linarith
    have product := realLe.mul_right_of_nonnegative with large, ρNonnegative
    have oneTimes : R[1 * half(R[complexAbs(ℂ[z - a]) + r])] =
      half(R[complexAbs(ℂ[z - a]) + r]) by ring
    linarith
  have sequence := powerSeriesTerms.function with coefficients, ha, zMember
  apply ComplexAbsolutelySummable.of_geometric at powerSeriesTerms(c, a, z),
    B, R[complexAbs(ℂ[z - a]) / half(R[complexAbs(ℂ[z - a]) + r])] with
    sequence, qNonnegative, qBelow
  intros n hn
  have nNat := nat.omega.backward at n with hn
  have cn := FunctionBetween.apply_closed with coefficients, hn
  have power := complexPow.member at ℂ[z - a], n with step
  rw [(powerSeriesTerms.value with coefficients, ha, zMember, hn),
    (complexAbs.mul with cn, power), (complexAbs.pow at ℂ[z - a], n with step)]
  have split : complexAbs(ℂ[z - a]) = R[(complexAbs(ℂ[z - a]) /
      half(R[complexAbs(ℂ[z - a]) + r])) * half(R[complexAbs(ℂ[z - a]) + r])]
    rw cancel
  have powers : R[complexAbs(ℂ[z - a]) ^ n] =
      R[(complexAbs(ℂ[z - a]) / half(R[complexAbs(ℂ[z - a]) + r])) ^ n *
        half(R[complexAbs(ℂ[z - a]) + r]) ^ n]
    have product := realPow.mul at R[complexAbs(ℂ[z - a]) /
      half(R[complexAbs(ℂ[z - a]) + r])], half(R[complexAbs(ℂ[z - a]) + r]), n
    rw ← split at product
    unfold realPow at product
    exact product
  rw powers
  have termBound := bound with n, hn
  have qPower := realPow.nonnegative at R[complexAbs(ℂ[z - a]) /
    half(R[complexAbs(ℂ[z - a]) + r])], n with qNonnegative
  have scaled := realLe.mul_right_of_nonnegative with termBound, qPower
  have regroup : R[complexAbs(c(n)) * ((complexAbs(ℂ[z - a]) /
      half(R[complexAbs(ℂ[z - a]) + r])) ^ n *
      half(R[complexAbs(ℂ[z - a]) + r]) ^ n)] =
      R[(complexAbs(c(n)) * half(R[complexAbs(ℂ[z - a]) + r]) ^ n) *
      (complexAbs(ℂ[z - a]) / half(R[complexAbs(ℂ[z - a]) + r])) ^ n] by ring
  rw regroup
  unfold realPow at scaled
  exact scaled

-- The sum of the power series on the open disk of radius r about a.
defgraph powerSeriesSum (c a r : Set) (z ∈ complexDisk(a, r)) :
    complexCarrier := complexSeriesSum(powerSeriesTerms(c, a, z))
requires radius : PowerSeriesRadiusAtLeast(c, r)
requires ha : a ∈ complexCarrier
proof
  have absolute := powerSeriesTerms.absolutely_summable with radius, ha,
    member
  have summable := ComplexAbsolutelySummable.summable with absolute
  have selected := complexSeriesSum.selected with summable
  exact selected.left

-- The coefficients (n + 1) cₙ₊₁ of the termwise derivative.
defgraph powerSeriesDerivCoefficients (c : Set) (n ∈ ℕ) : complexCarrier :=
    ℂ[complexOfReal(realNat(succ(n))) * c(succ(n))]
requires coefficients : ComplexSequence(c)
proof
  have successor : succ(n) ∈ ℕ by typecheck
  have cn := FunctionBetween.apply_closed with coefficients, successor
  typecheck

-- Section: Series manipulations
-- The series with its first term removed.
defgraph complexShift (u : Set) (n ∈ ℕ) : complexCarrier := u(succ(n))
requires sequence : ComplexSequence(u)
proof
  have nNat := nat.omega.backward at n with member
  have next : succ(n) ∈ ℕ by typecheck
  exact FunctionBetween.apply_closed with sequence, next

-- The prefix sums of a series converge to S exactly when
-- |Σ_{k<n} u(k) − S| is eventually small.
theorem ComplexSumsTo.iff_partial (u S : Set)
  requires sequence : ComplexSequence(u)
  requires hS : S ∈ ℂ
  shows ComplexSumsTo(u, S) ↔ (∀ e ∈ ℝ, R[0] < e → ∃ N ∈ ℕ, ∀ n ∈ ℕ,
    N ≤ n → complexAbs(ℂ[complexPartialSum(u, n) - S]) < e)
proof
  have prefixes : ComplexSequence(complexPrefixSums(u)) by
    exact complexPrefixSums.function with sequence
  have form := ComplexConvergesTo.iff_abs with prefixes, hS
  constructor
  . intro sums
    obtain ⟨_, converges⟩ := sums
    intros e he positive
    obtain ⟨N, hN, tail⟩ := form.forward with converges, e, he, positive
    refine ⟨N, hN, ?_⟩
    intros n hn above
    have near := tail with n, hn, above
    rw (complexPrefixSums.value with hn, sequence) at near
    exact near
  . intro small
    refine ⟨sequence, ?_⟩
    apply form.backward
    intros e he positive
    obtain ⟨N, hN, tail⟩ := small with e, he, positive
    refine ⟨N, hN, ?_⟩
    intros n hn above
    rw (complexPrefixSums.value with hn, sequence)
    exact tail with n, hn, above

theorem complexShift.sums (u S : Set)
  requires sums : ComplexSumsTo(u, S)
  shows ComplexSumsTo(complexShift(u), ℂ[S - u((0:N))])
proof
  have hS := ComplexSumsTo.member with sums
  obtain ⟨sequence, _⟩ := sums
  have shifted : ComplexSequence(complexShift(u)) by
    exact complexShift.function with sequence
  have zeroIn : (0:N) ∈ ℕ by typecheck
  have first := FunctionBetween.apply_closed with sequence, zeroIn
  have target : ℂ[S - u((0:N))] ∈ ℂ by typecheck
  have tail := (ComplexSumsTo.iff_partial with sequence, hS).forward with sums
  apply (ComplexSumsTo.iff_partial with shifted, target).backward
  intros e he positive
  obtain ⟨N, hN, near⟩ := tail with e, he, positive
  refine ⟨N, hN, ?_⟩
  intros n hn above
  have nNat := nat.omega.backward at n with hn
  have next : succ(n) ∈ ℕ by typecheck
  have aboveNext : N ≤ succ(n) by arith
  have close := near with succ(n), next, aboveNext
  have values : ∀ j ∈ ℕ, j < n → complexShift(u)(j) = u(succ(j))
    intros j hj below
    exact complexShift.value with sequence, hj
  have split := complexPartialSum.shift_first at u, complexShift(u), n with
    sequence, shifted, values
  rw split at close
  have partial := complexPartialSum.member at complexShift(u), n with shifted
  have same : ℂ[u((0:N)) + complexPartialSum(complexShift(u), n) - S] =
      ℂ[complexPartialSum(complexShift(u), n) - (S - u((0:N)))] by ring
  rw same at close
  exact close

-- A combination u − v − k w of convergent series converges to the same
-- combination of the sums.
theorem complexPartialSum.combination (u v w h k : Set) (n : Nat)
  requires sequenceU : ComplexSequence(u)
  requires sequenceV : ComplexSequence(v)
  requires sequenceW : ComplexSequence(w)
  requires hk : k ∈ ℂ
  requires terms : ∀ m ∈ ℕ, h(m) = ℂ[u(m) - v(m) - k * w(m)]
  shows complexPartialSum(h, n) = ℂ[complexPartialSum(u, n) -
    complexPartialSum(v, n) - k * complexPartialSum(w, n)]
proof
  induction n
  | zero =>
    rw [complexPartialSum.zero, complexPartialSum.zero, complexPartialSum.zero,
      complexPartialSum.zero]
    ring
  | succ(m) using ih =>
    have mNat : Nat(m) by typecheck
    have mIn : m ∈ ℕ by typecheck
    have um := FunctionBetween.apply_closed with sequenceU, mIn
    have vm := FunctionBetween.apply_closed with sequenceV, mIn
    have wm := FunctionBetween.apply_closed with sequenceW, mIn
    have pu := complexPartialSum.member at u, m with sequenceU
    have pv := complexPartialSum.member at v, m with sequenceV
    have pw := complexPartialSum.member at w, m with sequenceW
    rw [complexPartialSum.succ, complexPartialSum.succ, complexPartialSum.succ,
      complexPartialSum.succ, ih, (terms with m, mIn)]
    ring

theorem ComplexSumsTo.combination (u v w h k S T W : Set)
  requires sumsU : ComplexSumsTo(u, S)
  requires sumsV : ComplexSumsTo(v, T)
  requires sumsW : ComplexSumsTo(w, W)
  requires hk : k ∈ ℂ
  requires sequenceH : ComplexSequence(h)
  requires terms : ∀ m ∈ ℕ, h(m) = ℂ[u(m) - v(m) - k * w(m)]
  shows ComplexSumsTo(h, ℂ[S - T - k * W])
proof
  have hS := ComplexSumsTo.member with sumsU
  have hT := ComplexSumsTo.member with sumsV
  have hW := ComplexSumsTo.member with sumsW
  obtain ⟨sequenceU, _⟩ := sumsU
  obtain ⟨sequenceV, _⟩ := sumsV
  obtain ⟨sequenceW, _⟩ := sumsW
  have tailU := (ComplexSumsTo.iff_partial with sequenceU, hS).forward with
    sumsU
  have tailV := (ComplexSumsTo.iff_partial with sequenceV, hT).forward with
    sumsV
  have tailW := (ComplexSumsTo.iff_partial with sequenceW, hW).forward with
    sumsW
  have target : ℂ[S - T - k * W] ∈ ℂ by typecheck
  apply (ComplexSumsTo.iff_partial with sequenceH, target).backward
  intros e he positive
  have kNonnegative := complexAbs.nonnegative with hk
  have scaleReal : R[2 + complexAbs(k)] ∈ ℝ by typecheck
  have scaleNonnegative : R[0] ≤ R[2 + complexAbs(k)] by linarith
  obtain ⟨ε, hε, εPositive, absorb, _⟩ := realScale.absorb with scaleReal, he,
    scaleNonnegative, positive
  obtain ⟨N1, hN1, near1⟩ := tailU with ε, hε, εPositive
  obtain ⟨N2, hN2, near2⟩ := tailV with ε, hε, εPositive
  obtain ⟨N3, hN3, near3⟩ := tailW with ε, hε, εPositive
  have N1Nat := nat.omega.backward at N1 with hN1
  have N2Nat := nat.omega.backward at N2 with hN2
  have N3Nat := nat.omega.backward at N3 with hN3
  have sumIn : N1 + N2 + N3 ∈ ℕ by typecheck
  refine ⟨N1 + N2 + N3, sumIn, ?_⟩
  intros n hn above
  have nNat := nat.omega.backward at n with hn
  have above1 : N1 ≤ n by arith
  have above2 : N2 ≤ n by arith
  have above3 : N3 ≤ n by arith
  have close1 := near1 with n, hn, above1
  have close2 := near2 with n, hn, above2
  have close3 := near3 with n, hn, above3
  rw (complexPartialSum.combination at u, v, w, h, k, n with sequenceU,
    sequenceV, sequenceW, hk, terms)
  have pu := complexPartialSum.member at u, n with sequenceU
  have pv := complexPartialSum.member at v, n with sequenceV
  have pw := complexPartialSum.member at w, n with sequenceW
  have differenceU : ℂ[complexPartialSum(u, n) - S] ∈ ℂ by typecheck
  have differenceV : ℂ[complexPartialSum(v, n) - T] ∈ ℂ by typecheck
  have differenceW : ℂ[complexPartialSum(w, n) - W] ∈ ℂ by typecheck
  have scaledW : ℂ[k * (complexPartialSum(w, n) - W)] ∈ ℂ by typecheck
  have twoTerms : ℂ[(complexPartialSum(u, n) - S) -
    (complexPartialSum(v, n) - T)] ∈ ℂ by typecheck
  have same : ℂ[(complexPartialSum(u, n) - complexPartialSum(v, n) -
      k * complexPartialSum(w, n)) - (S - T - k * W)] =
      ℂ[((complexPartialSum(u, n) - S) - (complexPartialSum(v, n) - T)) -
      k * (complexPartialSum(w, n) - W)] by ring
  rw same
  have outer := complexAbs.sub_le with twoTerms, scaledW
  have inner := complexAbs.sub_le with differenceU, differenceV
  rw (complexAbs.mul with hk, differenceW) at outer
  have scaled := realLe.mul_left_of_nonnegative with
    (realLess.implies_le with close3), kNonnegative
  have r1 : complexAbs(ℂ[complexPartialSum(u, n) - S]) ∈ ℝ by typecheck
  have r2 : complexAbs(ℂ[complexPartialSum(v, n) - T]) ∈ ℝ by typecheck
  have r3 : R[complexAbs(k) * complexAbs(ℂ[complexPartialSum(w, n) - W])] ∈ ℝ
    by typecheck
  have r5 : complexAbs(ℂ[(complexPartialSum(u, n) - S) -
    (complexPartialSum(v, n) - T)]) ∈ ℝ by typecheck
  have expand : R[(2 + complexAbs(k)) * ε] = R[2 * ε + complexAbs(k) * ε] by
    ring
  linarith

-- Section: Uniform convergence
predicate ComplexUniformlyConvergesOn (F f K : Set) :=
  ∀ e ∈ ℝ, realZero < e → ∃ N ∈ ℕ, ∀ n ∈ ℕ, N ≤ n → ∀ z ∈ K,
    complexAbs(ℂ[F(n)(z) - f(z)]) < e

-- Uniform convergence on every compact subset of U.
predicate ComplexLocallyUniformlyConvergesOn (F f U : Set) :=
  ∀ K, K ⊆ U → ComplexCompact(K) → ComplexUniformlyConvergesOn(F, f, K)

-- Section: The topology of ℂ, facts
theorem complexDisk.subset (a r : Set)
  shows complexDisk(a, r) ⊆ ℂ
proof
  intros z hz
  have parts := complexDisk.membership.forward with hz
  exact parts.left

-- The triangle inequality for distances.
theorem complexAbs.dist_triangle (z w a : Set)
  requires hz : z ∈ ℂ
  requires hw : w ∈ ℂ
  requires ha : a ∈ ℂ
  shows complexAbs(ℂ[z - a]) ≤
    R[complexAbs(ℂ[z - w]) + complexAbs(ℂ[w - a])]
proof
  have first : ℂ[z - w] ∈ ℂ by typecheck
  have second : ℂ[w - a] ∈ ℂ by typecheck
  have split : ℂ[z - a] = ℂ[(z - w) + (w - a)] by ring
  rw split
  exact complexAbs.triangle with first, second

theorem complexAbs.dist_symm (z w : Set)
  requires hz : z ∈ ℂ
  requires hw : w ∈ ℂ
  shows complexAbs(ℂ[z - w]) = complexAbs(ℂ[w - z])
proof
  have difference : ℂ[w - z] ∈ ℂ by typecheck
  have flip : ℂ[z - w] = ℂ[-(w - z)] by ring
  rw flip
  exact complexAbs.neg with difference

theorem complexDisk.mono (a r s : Set)
  requires ha : a ∈ ℂ
  requires hr : r ∈ ℝ
  requires hs : s ∈ ℝ
  requires le : r ≤ s
  shows complexDisk(a, r) ⊆ complexDisk(a, s)
proof
  intros z hz
  obtain ⟨member, near⟩ := complexDisk.membership.forward with hz
  apply complexDisk.membership.backward
  refine ⟨member, ?_⟩
  linarith

-- A point of a disk has a smaller disk about it inside.
theorem complexDisk.inner (a r z : Set)
  requires ha : a ∈ ℂ
  requires hr : r ∈ ℝ
  requires hz : z ∈ complexDisk(a, r)
  shows ∃ s ∈ ℝ, R[0] < s ∧ complexDisk(z, s) ⊆ complexDisk(a, r)
proof
  obtain ⟨member, near⟩ := complexDisk.membership.forward with hz
  have difference : ℂ[z - a] ∈ ℂ by typecheck
  have sReal : R[r - complexAbs(ℂ[z - a])] ∈ ℝ by typecheck
  have positive : R[0] < R[r - complexAbs(ℂ[z - a])] by linarith
  refine ⟨R[r - complexAbs(ℂ[z - a])], sReal, positive, ?_⟩
  intros w hw
  obtain ⟨wMember, wNear⟩ := complexDisk.membership.forward with hw
  have triangle := complexAbs.dist_triangle with wMember, member, ha
  apply complexDisk.membership.backward
  refine ⟨wMember, ?_⟩
  linarith

theorem complexIm.neg (z : Set)
  requires hz : z ∈ ℂ
  shows complexIm(ℂ[-z]) = R[-complexIm(z)]
proof
  obtain ⟨a, aReal, b, bReal, shape⟩ := complexCarrier.cases with hz
  rw [shape, complexNeg.pair]
  unfold complexIm
  rw [snd.pair, snd.pair]

theorem complexRe.sub (z w : Set)
  requires hz : z ∈ ℂ
  requires hw : w ∈ ℂ
  shows complexRe(ℂ[z - w]) = R[complexRe(z) - complexRe(w)]
proof
  have negW : ℂ[-w] ∈ ℂ by typecheck
  rw [(complexRe.add with hz, negW), (complexRe.neg with hw)]

theorem complexIm.sub (z w : Set)
  requires hz : z ∈ ℂ
  requires hw : w ∈ ℂ
  shows complexIm(ℂ[z - w]) = R[complexIm(z) - complexIm(w)]
proof
  have negW : ℂ[-w] ∈ ℂ by typecheck
  rw [(complexIm.add with hz, negW), (complexIm.neg with hw)]

-- The modulus is at most the sum of the moduli of the parts.
theorem complexAbs.le_parts (z : Set)
  requires hz : z ∈ ℂ
  shows complexAbs(z) ≤ R[abs(complexRe(z)) + abs(complexIm(z))]
proof
  have reReal := complexRe.real with hz
  have imReal := complexIm.real with hz
  have reMember : complexOfReal(complexRe(z)) ∈ ℂ by typecheck
  have imMember : complexOfReal(complexIm(z)) ∈ ℂ by typecheck
  have iMember := complexImaginaryUnit.member
  have product : ℂ[complexImaginaryUnit * complexOfReal(complexIm(z))] ∈ ℂ
    by typecheck
  have triangle := complexAbs.triangle with reMember, product
  have shape := complex.re_add_im with hz
  rw [(complexAbs.mul with iMember, imMember), complexAbs.imaginary,
    (complexAbs.of_real at complexRe(z)), (complexAbs.of_real at complexIm(z)),
    ← shape] at triangle
  have one : R[1 * abs(complexIm(z))] = abs(complexIm(z)) by ring
  rw one at triangle
  exact triangle

-- Real and imaginary parts move by at most the distance.
theorem complexRe.sub_bound (z w : Set)
  requires hz : z ∈ ℂ
  requires hw : w ∈ ℂ
  shows R[complexRe(z) - complexRe(w)] ≤ complexAbs(ℂ[z - w])
proof
  have difference : ℂ[z - w] ∈ ℂ by typecheck
  have parts := complexRe.sub with hz, hw
  have upper := abs.upper at complexRe(ℂ[z - w])
  have bound := complexAbs.re_le with difference
  rw parts at upper, bound
  linarith

theorem complexIm.sub_bound (z w : Set)
  requires hz : z ∈ ℂ
  requires hw : w ∈ ℂ
  shows R[complexIm(z) - complexIm(w)] ≤ complexAbs(ℂ[z - w])
proof
  have difference : ℂ[z - w] ∈ ℂ by typecheck
  have parts := complexIm.sub with hz, hw
  have upper := abs.upper at complexIm(ℂ[z - w])
  have bound := complexAbs.im_le with difference
  rw parts at upper, bound
  linarith

-- A set of complex numbers with a disk about each of its points is open.
theorem ComplexOpen.of_disks (U : Set)
  requires inside : U ⊆ ℂ
  requires disks : ∀ a ∈ U, ∃ r ∈ ℝ, R[0] < r ∧ complexDisk(a, r) ⊆ U
  shows ComplexOpen(U)
proof
  apply complexTopology.membership.backward
  exact ⟨(powerset.membership_iff.backward with inside), disks⟩

theorem complexTopology.topology
  shows IsTopology(complexCarrier, complexTopology)
proof
  have one : R[1] ∈ ℝ by typecheck
  have onePositive : R[0] < R[1] by linarith
  constructor
  . intros U hU
    have parts := complexTopology.membership.forward with hU
    exact parts.left
  . constructor
    . apply complexTopology.membership.backward
      refine ⟨(powerset.self at complexCarrier), ?_⟩
      intros a ha
      exact ⟨R[1], one, onePositive, (complexDisk.subset at a, R[1])⟩
    . constructor
      . intros S hS
        apply complexTopology.membership.backward
        constructor
        . apply powerset.membership_iff.backward
          apply union.subset
          intros U hU
          have parts := complexTopology.membership.forward with (hS with U, hU)
          exact powerset.membership_iff.forward with parts.left
        . intros a ha
          obtain ⟨U, hU, haU⟩ := union.membership.forward with ha
          have parts := complexTopology.membership.forward with (hS with U, hU)
          obtain ⟨r, hr, positive, inside⟩ := parts.right with a, haU
          refine ⟨r, hr, positive, ?_⟩
          exact Subset.transitive with inside, (union.subset_of_member with hU)
      . intros U hU V hV
        have partsU := complexTopology.membership.forward with hU
        have partsV := complexTopology.membership.forward with hV
        have insideU := powerset.membership_iff.forward with partsU.left
        apply complexTopology.membership.backward
        constructor
        . apply powerset.membership_iff.backward
          exact Subset.transitive with (intersection.subset_left at U, V),
              insideU
        . intros a ha
          have both := intersection.membership.forward with ha
          have aMember := insideU with a, both.left
          obtain ⟨r1, hr1, positive1, inside1⟩ := partsU.right with a, both.left
          obtain ⟨r2, hr2, positive2, inside2⟩ := partsV.right with a,
              both.right
          obtain ⟨t, ht, positive, le1, le2⟩ := realRadius.common with hr1,
            hr2, positive1, positive2
          refine ⟨t, ht, positive, ?_⟩
          apply intersection.greatest
          . exact Subset.transitive with
              (complexDisk.mono at a, t, r1 with aMember, ht,
              hr1, le1), inside1
          . exact Subset.transitive with
              (complexDisk.mono at a, t, r2 with aMember, ht,
              hr2, le2), inside2
-- The modulus topology is the product topology of the plane.
theorem complexTopology.eq_plane
  shows complexTopology = planeTopology
proof
  have carrier : complexCarrier = ℝ × ℝ
    unfold complexCarrier
    rfl
  unfold planeTopology
  apply Subset.antisymmetric
  . intros U hU
    obtain ⟨subsets, disks⟩ := complexTopology.membership.forward with hU
    apply productTopology.membership.backward
    refine ⟨?_, ?_⟩
    . rw carrier at subsets
      exact subsets
    . intros p hp
      have inside := powerset.membership_iff.forward with subsets
      have pMember := inside with p, hp
      obtain ⟨r, hr, positive, diskInside⟩ := disks with p, hp
      have rReal : Real(r) by typecheck
      have halfPositive := half.positive with positive
      have reP := complexRe.real with pMember
      have imP := complexIm.real with pMember
      have openA := openBall.open at complexRe(p), half(r)
      have openB := openBall.open at complexIm(p), half(r)
      refine ⟨openBall(complexRe(p), half(r)), openA,
        openBall(complexIm(p), half(r)), openB, ?_, ?_⟩
      . have shape := complex.ext with pMember
        have box := product.pair with
          (openBall.center at complexRe(p), half(r) with halfPositive),
          (openBall.center at complexIm(p), half(r) with halfPositive)
        rw ← shape at box
        exact box
      . intros w hw
        obtain ⟨_, x, hx, y, hy, shape⟩ := product.membership.forward with hw
        have xReal := openBall.subset_reals at complexRe(p), half(r) with x, hx
        have yReal := openBall.subset_reals at complexIm(p), half(r) with y, hy
        have wMember : w ∈ ℂ
          rw shape
          exact complexCarrier.pair at x, y
        have reW : complexRe(w) = x
          rw shape
          unfold complexRe
          rw fst.pair
        have imW : complexIm(w) = y
          rw shape
          unfold complexIm
          rw snd.pair
        have nearX := openBall.abs with hx
        have nearY := openBall.abs with hy
        have difference : ℂ[w - p] ∈ ℂ by typecheck
        have parts := complexAbs.le_parts with difference
        rw [(complexRe.sub with wMember, pMember),
          (complexIm.sub with wMember, pMember), reW, imW] at parts
        have total := half.add_self at r
        have inDisk : w ∈ complexDisk(p, r)
          apply complexDisk.membership.backward
          refine ⟨wMember, ?_⟩
          linarith
        exact diskInside with w, inDisk
  . intros U hU
    obtain ⟨subsets, boxes⟩ := productTopology.membership.forward with hU
    have subsetsC : U ∈ 𝒫(complexCarrier)
      rw carrier
      exact subsets
    apply ComplexOpen.of_disks with (powerset.membership_iff.forward with
      subsetsC)
    intros p hp
    have inside := powerset.membership_iff.forward with subsetsC
    have pMember := inside with p, hp
    obtain ⟨A, hA, B, hB, pBox, boxInside⟩ := boxes with p, hp
    have shape := complex.ext with pMember
    rw shape at pBox
    obtain ⟨reA, imB⟩ := product.pair_membership.forward with pBox
    obtain ⟨_, ballsA⟩ := realTopology.membership.forward with hA
    obtain ⟨_, ballsB⟩ := realTopology.membership.forward with hB
    obtain ⟨e1, he1, positive1, ballA⟩ := ballsA with complexRe(p), reA
    obtain ⟨e2, he2, positive2, ballB⟩ := ballsB with complexIm(p), imB
    obtain ⟨t, ht, positive, le1, le2⟩ := realRadius.common with he1, he2,
      positive1, positive2
    refine ⟨t, ht, positive, ?_⟩
    intros w hw
    obtain ⟨wMember, near⟩ := complexDisk.membership.forward with hw
    have difference : ℂ[w - p] ∈ ℂ by typecheck
    have reBound := complexAbs.re_le with difference
    have imBound := complexAbs.im_le with difference
    rw (complexRe.sub with wMember, pMember) at reBound
    rw (complexIm.sub with wMember, pMember) at imBound
    have closeRe : abs(R[complexRe(w) - complexRe(p)]) < e1 by linarith
    have closeIm : abs(R[complexIm(w) - complexIm(p)]) < e2 by linarith
    have inA := ballA with complexRe(w), (openBall.of_abs with closeRe)
    have inB := ballB with complexIm(w), (openBall.of_abs with closeIm)
    have wShape := complex.ext with wMember
    have box := product.pair with inA, inB
    rw ← wShape at box
    exact boxInside with w, box

theorem complexDisk.open (a r : Set)
  requires ha : a ∈ ℂ
  requires hr : r ∈ ℝ
  shows ComplexOpen(complexDisk(a, r))
proof
  apply complexTopology.membership.backward
  refine ⟨(powerset.membership_iff.backward with
    (complexDisk.subset at a, r)), ?_⟩
  intros z hz
  exact complexDisk.inner with ha, hr, hz

theorem complexDisk.center (a r : Set)
  requires ha : a ∈ ℂ
  requires hr : r ∈ ℝ
  requires positive : R[0] < r
  shows a ∈ complexDisk(a, r)
proof
  have zero : ℂ[a - a] = ℂ[0] by ring
  have absolute : complexAbs(ℂ[a - a]) = R[0]
    rw zero
    exact (complexAbs.zero_iff with complexZero.member).backward with rfl
  apply complexDisk.membership.backward
  refine ⟨ha, ?_⟩
  rw absolute
  exact positive

-- Star-shaped sets are connected. Along the segment t ↦ p + t (q − p)
-- from a point of one side of a separation to a point of the other, the
-- indicator of the second side would be continuous on [0, 1] and take only
-- the values 0 and 1, against the intermediate value theorem.
def segmentHits (p q V : Set) : Set :=
  { t ∈ ℝ | ℂ[p + complexOfReal(t) * (q - p)] ∈ V }

defgraph segmentIndicator (p q V : Set) (t ∈ ℝ) : ℝ :=
    realNat(indicator(segmentHits(p, q, V), t))
proof
  have natural := indicator.natural at segmentHits(p, q, V), t
  typecheck

theorem segmentIndicator.hit (p q V t : Set)
  requires ht : t ∈ ℝ
  requires hit : ℂ[p + complexOfReal(t) * (q - p)] ∈ V
  shows segmentIndicator(p, q, V)(t) = R[1]
proof
  have member : t ∈ segmentHits(p, q, V) :=
    segmentHits.membership.backward with ⟨ht, hit⟩
  rw [(segmentIndicator.value with ht), (indicator.member with member),
    realNat.one]

theorem segmentIndicator.miss (p q V t : Set)
  requires ht : t ∈ ℝ
  requires miss : ¬(ℂ[p + complexOfReal(t) * (q - p)] ∈ V)
  shows segmentIndicator(p, q, V)(t) = R[0]
proof
  have absent : ¬(t ∈ segmentHits(p, q, V))
    intro member
    have parts := segmentHits.membership.forward with member
    exact miss with parts.right
  rw [(segmentIndicator.value with ht), (indicator.absent with absent),
    realNat.zero]

-- Points of the segment are as far apart as their parameters, scaled.
theorem segment.distance (p q t s : Set)
  requires hp : p ∈ ℂ
  requires hq : q ∈ ℂ
  requires ht : t ∈ ℝ
  requires hs : s ∈ ℝ
  shows complexAbs(ℂ[(p + complexOfReal(t) * (q - p)) -
      (p + complexOfReal(s) * (q - p))]) =
    R[abs(R[t - s]) * complexAbs(ℂ[q - p])]
proof
  have difference : ℂ[q - p] ∈ ℂ by typecheck
  have parameter : complexOfReal(R[t - s]) ∈ ℂ by typecheck
  have shift : complexOfReal(R[t - s]) =
      ℂ[complexOfReal(t) - complexOfReal(s)]
    rw [(complexOfReal.add at t, R[-s]), (complexOfReal.neg at s)]
  have same : ℂ[(p + complexOfReal(t) * (q - p)) -
      (p + complexOfReal(s) * (q - p))] =
      ℂ[complexOfReal(R[t - s]) * (q - p)]
    rw shift
    ring
  rw [same, (complexAbs.mul with parameter, difference),
    (complexAbs.of_real at R[t - s])]

-- Near a parameter whose point lies in an open set W, the points of the
-- segment stay in W.
theorem segment.stays (p q W t0 : Set)
  requires hp : p ∈ ℂ
  requires hq : q ∈ ℂ
  requires isOpen : ComplexOpen(W)
  requires ht0 : t0 ∈ ℝ
  requires inside : ℂ[p + complexOfReal(t0) * (q - p)] ∈ W
  shows ∃ D ∈ ℝ, R[0] < D ∧ (∀ t ∈ ℝ, t ∈ openBall(t0, D) →
    ℂ[p + complexOfReal(t) * (q - p)] ∈ W)
proof
  have member : W ∈ complexTopology by exact isOpen
  obtain ⟨_, disks⟩ := complexTopology.membership.forward with member
  obtain ⟨r, hr, positive, disk⟩ := disks with
    ℂ[p + complexOfReal(t0) * (q - p)], inside
  have typedR : Real(r) by typecheck
  have difference : ℂ[q - p] ∈ ℂ by typecheck
  have M := complexAbs.nonnegative with difference
  have MReal : complexAbs(ℂ[q - p]) ∈ ℝ by typecheck
  have sumPositive : R[0] < R[complexAbs(ℂ[q - p]) + 1] by linarith
  have sumNonzero : R[complexAbs(ℂ[q - p]) + 1] ≠ R[0] by linarith
  have cancel := realDiv.mul_right at r, R[complexAbs(ℂ[q - p]) + 1] with
    sumNonzero
  have DReal : R[r / (complexAbs(ℂ[q - p]) + 1)] ∈ ℝ by typecheck
  have DPositive : R[0] < R[r / (complexAbs(ℂ[q - p]) + 1)]
    by_contra notPositive
    have nonpositive : R[r / (complexAbs(ℂ[q - p]) + 1)] ≤ R[0] by linarith
    have sumNonnegative : R[0] ≤ R[complexAbs(ℂ[q - p]) + 1] by linarith
    have product := realLe.mul_right_of_nonnegative with nonpositive,
      sumNonnegative
    have zero : R[0 * (complexAbs(ℂ[q - p]) + 1)] = R[0] by ring
    linarith
  refine ⟨R[r / (complexAbs(ℂ[q - p]) + 1)], DReal, DPositive, ?_⟩
  intros t ht near
  have close := openBall.abs with near
  have closeLe : abs(R[t - t0]) ≤ R[r / (complexAbs(ℂ[q - p]) + 1)] by
    linarith
  have scaled := realLe.mul_right_of_nonnegative with closeLe, M
  have distance := segment.distance with hp, hq, ht, ht0
  have expand : R[r / (complexAbs(ℂ[q - p]) + 1) * complexAbs(ℂ[q - p]) +
      r / (complexAbs(ℂ[q - p]) + 1)] = r by
    linear_combination cancel
  have point : ℂ[p + complexOfReal(t) * (q - p)] ∈ ℂ by typecheck
  have inDisk : ℂ[p + complexOfReal(t) * (q - p)] ∈
      complexDisk(ℂ[p + complexOfReal(t0) * (q - p)], r)
    apply complexDisk.membership.backward
    refine ⟨point, ?_⟩
    rw distance
    linarith
  exact disk with ℂ[p + complexOfReal(t) * (q - p)], inDisk

-- The indicator of V along a segment inside A is continuous on [0, 1]
-- when U and V separate A.
theorem segmentIndicator.continuous (A p q U V : Set)
  requires hp : p ∈ ℂ
  requires hq : q ∈ ℂ
  requires star : ∀ t ∈ ℝ, R[0] ≤ t → t ≤ R[1] →
    ℂ[p + complexOfReal(t) * (q - p)] ∈ A
  requires separation : OpenSeparation(complexTopology, A, U, V)
  shows ContinuousOn(segmentIndicator(p, q, V), closedInterval(R[0], R[1]))
proof
  obtain ⟨hU, hV, covers, disjoint, _, _⟩ := separation
  have apart := Disjoint.iff.forward with disjoint
  have function := segmentIndicator.function at p, q, V
  have interval := closedInterval.subset_reals at R[0], R[1]
  refine ⟨function, interval, ?_⟩
  intros t0 ht0
  obtain ⟨t0Real, lower0, upper0⟩ := closedInterval.membership.forward with
    ht0
  refine ⟨function, interval, ?_⟩
  intros e eReal ePositive
  have inA := star with t0, t0Real, lower0, upper0
  have sides := covers with ℂ[p + complexOfReal(t0) * (q - p)], inA
  cases (union2.membership.forward with sides) with inU | inV
  . have openU : ComplexOpen(U) by exact hU
    obtain ⟨D, hD, DPositive, stays⟩ := segment.stays with hp, hq, openU,
      t0Real, inU
    refine ⟨D, hD, DPositive, ?_⟩
    intros t ht tInterval near
    obtain ⟨_, lower, upper⟩ := closedInterval.membership.forward with
      tInterval
    have tU := stays with t, ht, near
    have tA := star with t, ht, lower, upper
    have missT : ¬(ℂ[p + complexOfReal(t) * (q - p)] ∈ V)
      intro tV
      have both := intersection.membership.backward with ⟨tU, tA⟩
      exact apart with ℂ[p + complexOfReal(t) * (q - p)], both,
        (intersection.membership.backward with ⟨tV, tA⟩)
    have missT0 : ¬(ℂ[p + complexOfReal(t0) * (q - p)] ∈ V)
      intro t0V
      have both := intersection.membership.backward with ⟨inU, inA⟩
      exact apart with ℂ[p + complexOfReal(t0) * (q - p)], both,
        (intersection.membership.backward with ⟨t0V, inA⟩)
    rw [(segmentIndicator.miss with ht, missT),
      (segmentIndicator.miss with t0Real, missT0)]
    exact openBall.center at R[0], e with ePositive
  . have openV : ComplexOpen(V) by exact hV
    obtain ⟨D, hD, DPositive, stays⟩ := segment.stays with hp, hq, openV,
      t0Real, inV
    refine ⟨D, hD, DPositive, ?_⟩
    intros t ht tInterval near
    have tV := stays with t, ht, near
    rw [(segmentIndicator.hit with ht, tV),
      (segmentIndicator.hit with t0Real, inV)]
    exact openBall.center at R[1], e with ePositive

-- A set star-shaped about a point of U has no separation with q in V.
theorem ComplexConnected.star_no_separation (A p U V : Set)
  requires inside : A ⊆ ℂ
  requires hp : p ∈ A
  requires star : ∀ q ∈ A, ∀ t ∈ ℝ, R[0] ≤ t → t ≤ R[1] →
    ℂ[p + complexOfReal(t) * (q - p)] ∈ A
  requires separation : OpenSeparation(complexTopology, A, U, V)
  requires pU : p ∈ U
  shows ⊥
proof
  obtain ⟨_, _, _, disjoint, _, inhabitedV⟩ := separation
  have apart := Disjoint.iff.forward with disjoint
  obtain ⟨q, hq⟩ := inhabitedV
  obtain ⟨qV, qA⟩ := intersection.membership.forward with hq
  have pMember := inside with p, hp
  have qMember := inside with q, qA
  have starQ := star with q, qA
  have continuous := segmentIndicator.continuous with pMember, qMember,
    starQ, separation
  have zero : R[0] ∈ ℝ by typecheck
  have one : R[1] ∈ ℝ by typecheck
  have startPoint : ℂ[p + complexOfReal(R[0]) * (q - p)] = p
    rw complexOfReal.zero
    ring
  have endPoint : ℂ[p + complexOfReal(R[1]) * (q - p)] = q
    rw complexOfReal.one
    ring
  have missStart : ¬(ℂ[p + complexOfReal(R[0]) * (q - p)] ∈ V)
    rw startPoint
    intro pV
    exact apart with p, (intersection.membership.backward with ⟨pU, hp⟩),
      (intersection.membership.backward with ⟨pV, hp⟩)
  have hitEnd : ℂ[p + complexOfReal(R[1]) * (q - p)] ∈ V
    rw endPoint
    exact qV
  have atStart := segmentIndicator.miss with zero, missStart
  have atEnd := segmentIndicator.hit with one, hitEnd
  have onePositive : R[0] < R[1] by linarith
  have halfPositive := half.positive with onePositive
  have halfBelow := half.lt_self with onePositive
  have ordered : R[0] ≤ R[1] by linarith
  have below : (segmentIndicator(p, q, V)(R[0]):R) < half(R[1])
    rw atStart
    exact halfPositive
  have above : half(R[1]) < (segmentIndicator(p, q, V)(R[1]):R)
    rw atEnd
    exact halfBelow
  obtain ⟨C, hC, value⟩ := closedInterval.intermediate_value with ordered,
    continuous, below, above
  obtain ⟨CReal, _, _⟩ := closedInterval.membership.forward with hC
  have alternatives : ℂ[p + complexOfReal(C) * (q - p)] ∈ V ∨
      ¬(ℂ[p + complexOfReal(C) * (q - p)] ∈ V) by tauto
  cases alternatives with hit | miss
  . rw (segmentIndicator.hit with CReal, hit) at value
    linarith
  . rw (segmentIndicator.miss with CReal, miss) at value
    linarith

theorem ComplexConnected.of_star (A p : Set)
  requires inside : A ⊆ ℂ
  requires hp : p ∈ A
  requires star : ∀ q ∈ A, ∀ t ∈ ℝ, R[0] ≤ t → t ≤ R[1] →
    ℂ[p + complexOfReal(t) * (q - p)] ∈ A
  shows ComplexConnected(A)
proof
  unfold ComplexConnected
  refine ⟨inside, ?_⟩
  intro separated
  obtain ⟨U, V, separation⟩ := separated
  obtain ⟨_, _, covers, _, _, _⟩ := separation
  cases (union2.membership.forward with (covers with p, hp)) with pU | pV
  . exact ComplexConnected.star_no_separation with inside, hp, star,
      separation, pU
  . have swapped := OpenSeparation.symmetric with separation
    exact ComplexConnected.star_no_separation with inside, hp, star,
      swapped, pV

-- The real and imaginary parts along a segment.
theorem segment.re (p q t : Set)
  requires hp : p ∈ ℂ
  requires hq : q ∈ ℂ
  requires ht : t ∈ ℝ
  shows complexRe(ℂ[p + complexOfReal(t) * (q - p)]) =
    R[complexRe(p) + t * (complexRe(q) - complexRe(p))]
proof
  have tMember : complexOfReal(t) ∈ ℂ by typecheck
  have difference : ℂ[q - p] ∈ ℂ by typecheck
  have product : ℂ[complexOfReal(t) * (q - p)] ∈ ℂ by typecheck
  rw [(complexRe.add with hp, product),
      (complexRe.mul with tMember, difference),
    (complexRe.sub with hq, hp), (complexIm.sub with hq, hp),
    (complexOfReal.re at t), (complexOfReal.im at t)]
  ring

theorem segment.im (p q t : Set)
  requires hp : p ∈ ℂ
  requires hq : q ∈ ℂ
  requires ht : t ∈ ℝ
  shows complexIm(ℂ[p + complexOfReal(t) * (q - p)]) =
    R[complexIm(p) + t * (complexIm(q) - complexIm(p))]
proof
  have tMember : complexOfReal(t) ∈ ℂ by typecheck
  have difference : ℂ[q - p] ∈ ℂ by typecheck
  have product : ℂ[complexOfReal(t) * (q - p)] ∈ ℂ by typecheck
  rw [(complexIm.add with hp, product),
      (complexIm.mul with tMember, difference),
    (complexRe.sub with hq, hp), (complexIm.sub with hq, hp),
    (complexOfReal.re at t), (complexOfReal.im at t)]
  ring

-- The slit plane is star-shaped about 1.
theorem slitPlane.star (w t : Set)
  requires hw : w ∈ slitPlane
  requires ht : t ∈ ℝ
  requires lower : R[0] ≤ t
  requires upper : t ≤ R[1]
  shows ℂ[1 + complexOfReal(t) * (w - 1)] ∈ slitPlane
proof
  obtain ⟨wMember, notSlit⟩ := slitPlane.membership.forward with hw
  have one := complexOne.member
  have point : ℂ[1 + complexOfReal(t) * (w - 1)] ∈ ℂ by typecheck
  have reW := complexRe.real with wMember
  have imW := complexIm.real with wMember
  have reOne : complexRe(ℂ[1]) = R[1]
    rw ← complexOfReal.one
    exact complexOfReal.re at R[1]
  have imOne : complexIm(ℂ[1]) = R[0]
    rw ← complexOfReal.one
    exact complexOfReal.im at R[1]
  have rePart := segment.re with one, wMember, ht
  have imPart := segment.im with one, wMember, ht
  rw [reOne] at rePart
  rw [imOne] at imPart
  apply slitPlane.membership.backward
  refine ⟨point, ?_⟩
  intro slit
  obtain ⟨onAxis, nonpositive⟩ := slit
  rw imPart at onAxis
  rw rePart at nonpositive
  have simplify : R[0 + t * (complexIm(w) - 0)] = R[t * complexIm(w)] by ring
  rw simplify at onAxis
  have product : R[t * complexIm(w)] = R[0] := onAxis
  cases (realMulValue.eq_zero_or with product) with zero | imZero
  . rw zero at nonpositive
    have collapse : R[1 + 0 * (complexRe(w) - 1)] = R[1] by ring
    rw collapse at nonpositive
    linarith
  . have rePositive : R[0] < complexRe(w)
      by_contra notPositive
      have reNonpositive : complexRe(w) ≤ R[0] by linarith
      exact notSlit with ⟨imZero, reNonpositive⟩
    have reNonnegative : R[0] ≤ complexRe(w) by linarith
    have scaled := realLe.mul_right_of_nonnegative with lower, reNonnegative
    have zeroTimes : R[0 * complexRe(w)] = R[0] by ring
    have expand : R[1 + t * (complexRe(w) - 1)] =
        R[1 - t + t * complexRe(w)] by ring
    rw expand at nonpositive
    have split := realLess.trichotomy at t, R[1]
    cases split with below | rest
    . linarith
    . cases rest with equal | above
      . rw equal at nonpositive
        have oneTimes : R[1 - 1 + 1 * complexRe(w)] = complexRe(w) by ring
        rw oneTimes at nonpositive
        linarith
      . linarith

theorem complexDisk.connected (a r : Set)
  requires ha : a ∈ ℂ
  requires hr : r ∈ ℝ
  shows ComplexConnected(complexDisk(a, r))
proof
  have inside := complexDisk.subset at a, r
  have split := realLess.trichotomy at R[0], r
  cases split with positive | rest
  . have center := complexDisk.center with ha, hr, positive
    apply ComplexConnected.of_star with inside, center
    intros q hq t ht lower upper
    obtain ⟨qMember, near⟩ := complexDisk.membership.forward with hq
    have tMember : complexOfReal(t) ∈ ℂ by typecheck
    have difference : ℂ[q - a] ∈ ℂ by typecheck
    have point : ℂ[a + complexOfReal(t) * (q - a)] ∈ ℂ by typecheck
    have shift : ℂ[(a + complexOfReal(t) * (q - a)) - a] =
        ℂ[complexOfReal(t) * (q - a)] by ring
    have distance := complexAbs.mul with tMember, difference
    rw [(complexAbs.of_real at t), (abs.of_nonnegative at t with lower)]
      at distance
    have nonnegative := complexAbs.nonnegative with difference
    have scaled := realLe.mul_right_of_nonnegative with upper, nonnegative
    have times : R[1 * complexAbs(ℂ[q - a])] = complexAbs(ℂ[q - a]) by ring
    rw times at scaled
    apply complexDisk.membership.backward
    refine ⟨point, ?_⟩
    rw [shift, distance]
    linarith
  . have nonpositive : r ≤ R[0]
      cases rest with equal | negative
      . linarith
      . linarith
    unfold ComplexConnected
    refine ⟨inside, ?_⟩
    intro separated
    obtain ⟨U, V, separation⟩ := separated
    obtain ⟨_, _, _, _, inhabited, _⟩ := separation
    obtain ⟨z, hz⟩ := inhabited
    obtain ⟨_, zDisk⟩ := intersection.membership.forward with hz
    obtain ⟨zMember, near⟩ := complexDisk.membership.forward with zDisk
    have difference : ℂ[z - a] ∈ ℂ by typecheck
    have nonnegative := complexAbs.nonnegative with difference
    linarith

theorem ComplexOpen.whole
  shows ComplexOpen(complexCarrier)
proof
  have topology := complexTopology.topology
  exact IsTopology.whole with topology

theorem ComplexConnected.whole
  shows ComplexConnected(complexCarrier)
proof
  have inside := Subset.reflexive at complexCarrier
  have zero := complexZero.member
  apply ComplexConnected.of_star with inside, zero
  intros q hq t ht lower upper
  typecheck

theorem ComplexOpen.subset (U : Set)
  requires isOpen : ComplexOpen(U)
  shows U ⊆ ℂ
proof
  have member : U ∈ complexTopology by exact isOpen
  have parts := complexTopology.membership.forward with member
  exact powerset.membership_iff.forward with parts.left

theorem ComplexOpen.disk (U a : Set)
  requires isOpen : ComplexOpen(U)
  requires ha : a ∈ U
  shows ∃ r ∈ ℝ, R[0] < r ∧ complexDisk(a, r) ⊆ U
proof
  have member : U ∈ complexTopology by exact isOpen
  obtain ⟨_, disks⟩ := complexTopology.membership.forward with member
  exact disks with ha

theorem ComplexOpen.inter (U V : Set)
  requires openU : ComplexOpen(U)
  requires openV : ComplexOpen(V)
  shows ComplexOpen(U ∩ V)
proof
  have topology := complexTopology.topology
  exact IsTopology.intersection2 with topology, openU, openV

-- ℂ with a point removed is open and connected.
theorem complexPunctured.open (a : Set)
  requires ha : a ∈ ℂ
  shows ComplexOpen(complexCarrier ∖ {a})
proof
  have inside : complexCarrier ∖ {a} ⊆ ℂ
    intros z hz
    have parts := difference.membership.forward with hz
    exact parts.left
  apply ComplexOpen.of_disks with inside
  intros z hz
  obtain ⟨member, away⟩ := difference.membership.forward with hz
  have distinct : ℂ[z - a] ≠ ℂ[0]
    intro zero
    apply away
    apply singleton.membership.backward
    have same : z = ℂ[(z - a) + a] by ring
    rw [same, zero]
    ring
  have difference : ℂ[z - a] ∈ ℂ by typecheck
  have positive := complexAbs.positive with difference, distinct
  have radius : complexAbs(ℂ[z - a]) ∈ ℝ by typecheck
  refine ⟨complexAbs(ℂ[z - a]), radius, positive, ?_⟩
  intros w hw
  obtain ⟨wMember, near⟩ := complexDisk.membership.forward with hw
  apply difference.membership.backward
  refine ⟨wMember, ?_⟩
  intro hit
  have equal := singleton.membership.forward with hit
  rw equal at near
  have symmetric := complexAbs.dist_symm with ha, member
  linarith

-- ℂ with a point a removed is the union of two copies of the slit plane:
-- those z with c (z − a) in the slit plane, for c = 1 and c = −1.
def puncturedSide (a c : Set) : Set :=
  { z ∈ complexCarrier | ℂ[c * (z - a)] ∈ slitPlane }

theorem puncturedSide.connected (a c : Set)
  requires ha : a ∈ ℂ
  requires hc : c ∈ ℂ
  requires square : ℂ[c * c] = ℂ[1]
  shows ComplexConnected(puncturedSide(a, c))
proof
  have inside : puncturedSide(a, c) ⊆ ℂ
    intros z hz
    have parts := puncturedSide.membership.forward with hz
    exact parts.left
  have pMember : ℂ[a + c] ∈ ℂ by typecheck
  have positive : R[0] < R[1] by linarith
  have one := slitPlane.positive_real at R[1] with positive
  rw complexOfReal.one at one
  have center : ℂ[a + c] ∈ puncturedSide(a, c)
    apply puncturedSide.membership.backward
    refine ⟨pMember, ?_⟩
    have same : ℂ[c * ((a + c) - a)] = ℂ[c * c] by ring
    rw [same, square]
    exact one
  apply ComplexConnected.of_star with inside, center
  intros q hq t ht lower upper
  obtain ⟨qMember, qSlit⟩ := puncturedSide.membership.forward with hq
  have point : ℂ[(a + c) + complexOfReal(t) * (q - (a + c))] ∈ ℂ by typecheck
  have along := slitPlane.star with qSlit, ht, lower, upper
  have same : ℂ[c * (((a + c) + complexOfReal(t) * (q - (a + c))) - a)] =
      ℂ[c * c + complexOfReal(t) * (c * (q - a) - c * c)] by ring
  rw square at same
  apply puncturedSide.membership.backward
  refine ⟨point, ?_⟩
  rw same
  exact along

theorem puncturedSide.cover (a : Set)
  requires ha : a ∈ ℂ
  shows complexCarrier ∖ {a} = puncturedSide(a, ℂ[1]) ∪ puncturedSide(a, ℂ[-1])
proof
  have oneMember := complexOne.member
  apply Subset.antisymmetric
  . intros z hz
    obtain ⟨member, away⟩ := difference.membership.forward with hz
    have w : ℂ[z - a] ∈ ℂ by typecheck
    have nonzero : ℂ[z - a] ≠ ℂ[0]
      intro zero
      apply away
      apply singleton.membership.backward
      have same : z = ℂ[(z - a) + a] by ring
      rw [same, zero]
      ring
    have oneTimes : ℂ[1 * (z - a)] = ℂ[z - a] by ring
    have alternatives : ℂ[z - a] ∈ slitPlane ∨ ¬(ℂ[z - a] ∈ slitPlane) by
      tauto
    cases alternatives with inSlit | outSlit
    . apply union2.membership.backward
      left
      apply puncturedSide.membership.backward
      refine ⟨member, ?_⟩
      rw oneTimes
      exact inSlit
    . have reW := complexRe.real with w
      have imW := complexIm.real with w
      have onSlit : complexIm(ℂ[z - a]) = R[0] ∧ complexRe(ℂ[z - a]) ≤ R[0]
        by_contra notOn
        exact outSlit with (slitPlane.membership.backward with ⟨w, notOn⟩)
      obtain ⟨imZero, reNonpositive⟩ := onSlit
      have reNegative : complexRe(ℂ[z - a]) < R[0]
        by_contra notNegative
        have reZero : complexRe(ℂ[z - a]) = R[0] by linarith
        apply nonzero
        rw [(complex.ext with w), reZero, imZero]
        unfold complexZero
        rfl
      have flip : ℂ[-1 * (z - a)] = ℂ[-(z - a)] by ring
      have flipped : ℂ[-(z - a)] ∈ slitPlane
        have flippedMember : ℂ[-(z - a)] ∈ ℂ by typecheck
        apply slitPlane.membership.backward
        refine ⟨flippedMember, ?_⟩
        rw (complexRe.neg with w)
        intro slit
        obtain ⟨_, nonpositive⟩ := slit
        linarith
      apply union2.membership.backward
      right
      apply puncturedSide.membership.backward
      refine ⟨member, ?_⟩
      rw flip
      exact flipped
  . intros z hz
    have zMember : z ∈ ℂ
      cases (union2.membership.forward with hz) with first | second
      . have parts := puncturedSide.membership.forward with first
        exact parts.left
      . have parts := puncturedSide.membership.forward with second
        exact parts.left
    apply difference.membership.backward
    refine ⟨zMember, ?_⟩
    intro hit
    have same := singleton.membership.forward with hit
    have zero : ℂ[0] ∈ slitPlane
      cases (union2.membership.forward with hz) with first | second
      . obtain ⟨_, inSlit⟩ := puncturedSide.membership.forward with first
        have collapse : ℂ[1 * (z - a)] = ℂ[0]
          rw same
          ring
        rw collapse at inSlit
        exact inSlit
      . obtain ⟨_, inSlit⟩ := puncturedSide.membership.forward with second
        have collapse : ℂ[-1 * (z - a)] = ℂ[0]
          rw same
          ring
        rw collapse at inSlit
        exact inSlit
    have nonzeroMember := slitPlane.nonzero with zero
    obtain ⟨_, nonzero⟩ := complexNonzero.membership.forward with
      nonzeroMember
    exact nonzero with rfl

theorem complexPunctured.connected (a : Set)
  requires ha : a ∈ ℂ
  shows ComplexConnected(complexCarrier ∖ {a})
proof
  have oneMember := complexOne.member
  have negOne : ℂ[-1] ∈ ℂ by typecheck
  have squareOne : ℂ[1 * 1] = ℂ[1] by ring
  have squareNeg : ℂ[-1 * -1] = ℂ[1] by ring
  have first := puncturedSide.connected with ha, oneMember, squareOne
  have second := puncturedSide.connected with ha, negOne, squareNeg
  have iMember := complexImaginaryUnit.member
  have imI : complexIm(complexImaginaryUnit) = R[1]
    unfold complexImaginaryUnit
    unfold complexIm
    rw snd.pair
  have point : ℂ[a + complexImaginaryUnit] ∈ ℂ by typecheck
  have meetsFirst : ℂ[a + complexImaginaryUnit] ∈ puncturedSide(a, ℂ[1])
    apply puncturedSide.membership.backward
    refine ⟨point, ?_⟩
    have same : ℂ[1 * ((a + complexImaginaryUnit) - a)] =
        complexImaginaryUnit by ring
    rw same
    apply slitPlane.membership.backward
    refine ⟨iMember, ?_⟩
    rw imI
    intro slit
    obtain ⟨one, _⟩ := slit
    have contradiction : R[0] < R[1] by linarith
    linarith
  have meetsSecond : ℂ[a + complexImaginaryUnit] ∈ puncturedSide(a, ℂ[-1])
    apply puncturedSide.membership.backward
    refine ⟨point, ?_⟩
    have same : ℂ[-1 * ((a + complexImaginaryUnit) - a)] =
        ℂ[-complexImaginaryUnit] by ring
    rw same
    have negMember : ℂ[-complexImaginaryUnit] ∈ ℂ by typecheck
    apply slitPlane.membership.backward
    refine ⟨negMember, ?_⟩
    rw [(complexIm.neg with iMember), imI]
    intro slit
    obtain ⟨one, _⟩ := slit
    have contradiction : R[0] < R[1] by linarith
    linarith
  have meets : Nonempty(puncturedSide(a, ℂ[1]) ∩ puncturedSide(a, ℂ[-1]))
    exact ⟨ℂ[a + complexImaginaryUnit],
      (intersection.membership.backward with ⟨meetsFirst, meetsSecond⟩)⟩
  have union := IsConnectedSubset.union2 with first, second, meets
  unfold ComplexConnected
  rw (puncturedSide.cover with ha)
  exact union

theorem rightHalfPlane.open (S : Real)
  shows ComplexOpen(rightHalfPlane(S))
proof
  have inside : rightHalfPlane(S) ⊆ ℂ
    intros z hz
    have parts := rightHalfPlane.membership.forward with hz
    exact parts.left
  apply ComplexOpen.of_disks with inside
  intros z hz
  obtain ⟨member, right⟩ := rightHalfPlane.membership.forward with hz
  have radius : R[complexRe(z) - S] ∈ ℝ by typecheck
  have positive : R[0] < R[complexRe(z) - S] by linarith
  refine ⟨R[complexRe(z) - S], radius, positive, ?_⟩
  intros w hw
  obtain ⟨wMember, near⟩ := complexDisk.membership.forward with hw
  have bound := complexRe.sub_bound with member, wMember
  have symmetric := complexAbs.dist_symm with member, wMember
  apply rightHalfPlane.membership.backward
  refine ⟨wMember, ?_⟩
  linarith

theorem rightHalfPlane.connected (S : Real)
  shows ComplexConnected(rightHalfPlane(S))
proof
  have inside : rightHalfPlane(S) ⊆ ℂ
    intros z hz
    have parts := rightHalfPlane.membership.forward with hz
    exact parts.left
  have centerMember : complexOfReal(R[S + 1]) ∈ ℂ by typecheck
  have center : complexOfReal(R[S + 1]) ∈ rightHalfPlane(S)
    apply rightHalfPlane.membership.backward
    refine ⟨centerMember, ?_⟩
    rw complexOfReal.re at R[S + 1]
    linarith
  apply ComplexConnected.of_star with inside, center
  intros q hq t ht lower upper
  obtain ⟨qMember, right⟩ := rightHalfPlane.membership.forward with hq
  have typedT : Real(t) by typecheck
  have point : ℂ[complexOfReal(R[S + 1]) +
      complexOfReal(t) * (q - complexOfReal(R[S + 1]))] ∈ ℂ by typecheck
  have rePart := segment.re with centerMember, qMember, ht
  rw (complexOfReal.re at R[S + 1]) at rePart
  have gap : R[0] ≤ R[complexRe(q) - S] by linarith
  have scaled := realLe.mul_right_of_nonnegative with lower, gap
  have scaledUpper := realLe.mul_right_of_nonnegative with upper, gap
  have zeroTimes : R[0 * (complexRe(q) - S)] = R[0] by ring
  have oneTimes : R[1 * (complexRe(q) - S)] = R[complexRe(q) - S] by ring
  apply rightHalfPlane.membership.backward
  refine ⟨point, ?_⟩
  rw rePart
  have expand : R[S + 1 + t * (complexRe(q) - (S + 1))] =
      R[S + 1 + t * (complexRe(q) - S) - t] by ring
  rw expand
  have split := realLess.trichotomy at t, R[1]
  cases split with below | rest
  . linarith
  . cases rest with equal | above
    . rw equal
      linarith
    . linarith

theorem slitPlane.open
  shows ComplexOpen(slitPlane)
proof
  have inside : slitPlane ⊆ ℂ
    intros z hz
    have parts := slitPlane.membership.forward with hz
    exact parts.left
  apply ComplexOpen.of_disks with inside
  intros z hz
  obtain ⟨member, notSlit⟩ := slitPlane.membership.forward with hz
  have reReal := complexRe.real with member
  have split := realLess.trichotomy at R[0], complexRe(z)
  cases split with right | rest
  . refine ⟨complexRe(z), reReal, right, ?_⟩
    intros w hw
    obtain ⟨wMember, near⟩ := complexDisk.membership.forward with hw
    have bound := complexRe.sub_bound with member, wMember
    have symmetric := complexAbs.dist_symm with member, wMember
    have wReal := complexRe.real with wMember
    apply slitPlane.membership.backward
    refine ⟨wMember, ?_⟩
    intro slit
    obtain ⟨_, nonpositive⟩ := slit
    linarith
  . have nonpositive : complexRe(z) ≤ R[0]
      cases rest with equal | left
      . linarith
      . linarith
    have offAxis : complexIm(z) ≠ R[0]
      intro onAxis
      exact notSlit with ⟨onAxis, nonpositive⟩
    have positive := abs.positive_of_ne with offAxis
    have radius : abs(complexIm(z)) ∈ ℝ by typecheck
    refine ⟨abs(complexIm(z)), radius, positive, ?_⟩
    intros w hw
    obtain ⟨wMember, near⟩ := complexDisk.membership.forward with hw
    have below := complexIm.sub_bound with member, wMember
    have above := complexIm.sub_bound with wMember, member
    have symmetric := complexAbs.dist_symm with member, wMember
    apply slitPlane.membership.backward
    refine ⟨wMember, ?_⟩
    intro slit
    obtain ⟨onAxis, _⟩ := slit
    rw onAxis at below, above
    have upper : complexIm(z) ≤ complexAbs(ℂ[w - z]) by linarith
    have lower : R[-complexIm(z)] ≤ complexAbs(ℂ[w - z]) by linarith
    have absolute := realAbs.le_of_bounds with upper, lower
    linarith

theorem slitPlane.connected
  shows ComplexConnected(slitPlane)
proof
  have inside : slitPlane ⊆ ℂ
    intros z hz
    have parts := slitPlane.membership.forward with hz
    exact parts.left
  have positive : R[0] < R[1] by linarith
  have one := slitPlane.positive_real at R[1] with positive
  rw complexOfReal.one at one
  apply ComplexConnected.of_star with inside, one
  intros q hq t ht lower upper
  exact slitPlane.star with hq, ht, lower, upper

-- A closed disk is closed.
theorem complexClosedDisk.closed (a r : Set)
  requires ha : a ∈ ℂ
  requires hr : r ∈ ℝ
  shows IsClosed(complexCarrier, complexTopology, complexClosedDisk(a, r))
proof
  constructor
  . intros z hz
    have parts := complexClosedDisk.membership.forward with hz
    exact parts.left
  . have inside : complement(complexCarrier, complexClosedDisk(a, r)) ⊆ ℂ
      intros z hz
      have parts := complement.membership.forward with hz
      exact parts.left
    have openSet := ComplexOpen.of_disks with inside
    apply openSet
    intros z hz
    obtain ⟨member, outside⟩ := complement.membership.forward with hz
    have far : r < complexAbs(ℂ[z - a])
      by_contra notFar
      apply outside
      apply complexClosedDisk.membership.backward
      refine ⟨member, ?_⟩
      linarith
    have radius : R[complexAbs(ℂ[z - a]) - r] ∈ ℝ by typecheck
    have positive : R[0] < R[complexAbs(ℂ[z - a]) - r] by linarith
    refine ⟨R[complexAbs(ℂ[z - a]) - r], radius, positive, ?_⟩
    intros w hw
    obtain ⟨wMember, near⟩ := complexDisk.membership.forward with hw
    apply complement.membership.backward
    refine ⟨wMember, ?_⟩
    intro within
    obtain ⟨_, close⟩ := complexClosedDisk.membership.forward with within
    have triangle := complexAbs.dist_triangle with member, wMember, ha
    have symmetric := complexAbs.dist_symm with member, wMember
    linarith

-- A closed disk {z : |z − a| ≤ r} is compact.
theorem complexClosedDisk.compact (a r : Set)
  requires ha : a ∈ ℂ
  requires hr : r ∈ ℝ
  shows ComplexCompact(complexClosedDisk(a, r))
proof
  have carrier : complexCarrier = ℝ × ℝ
    unfold complexCarrier
    rfl
  have absNonnegative := abs.nonnegative at r
  have orderedX : R[complexRe(a) - abs(r)] ≤ R[complexRe(a) + abs(r)] by
    linarith
  have orderedY : R[complexIm(a) - abs(r)] ≤ R[complexIm(a) + abs(r)] by
    linarith
  have rectangle := closedRectangle.compact with orderedX, orderedY
  have closed := complexClosedDisk.closed with ha, hr
  rw [carrier, complexTopology.eq_plane] at closed
  have inside : complexClosedDisk(a, r) ⊆
      closedInterval(R[complexRe(a) - abs(r)], R[complexRe(a) + abs(r)]) ×
      closedInterval(R[complexIm(a) - abs(r)], R[complexIm(a) + abs(r)])
    intros z hz
    obtain ⟨member, close⟩ := complexClosedDisk.membership.forward with hz
    have upperRe := complexRe.sub_bound with member, ha
    have lowerRe := complexRe.sub_bound with ha, member
    have upperIm := complexIm.sub_bound with member, ha
    have lowerIm := complexIm.sub_bound with ha, member
    have symmetric := complexAbs.dist_symm with member, ha
    have reZ := complexRe.real with member
    have imZ := complexIm.real with member
    have upper := abs.upper at r
    have inX : complexRe(z) ∈
        closedInterval(R[complexRe(a) - abs(r)], R[complexRe(a) + abs(r)])
      apply closedInterval.membership.backward
      refine ⟨reZ, ?_, ?_⟩
      . linarith
      . linarith
    have inY : complexIm(z) ∈
        closedInterval(R[complexIm(a) - abs(r)], R[complexIm(a) + abs(r)])
      apply closedInterval.membership.backward
      refine ⟨imZ, ?_, ?_⟩
      . linarith
      . linarith
    have box := product.pair with inX, inY
    rw ← (complex.ext with member) at box
    exact box
  have compactPlane := IsCompact.closed_subset with planeTopology.topology,
    rectangle, closed, inside
  unfold ComplexCompact
  rw [carrier, complexTopology.eq_plane]
  exact compactPlane

-- Open sets whose points all have disks of one radius inside U, and the
-- families of them with a common radius.
def marginOpens (U : Set) : Set :=
  { W ∈ complexTopology | ∃ r ∈ ℝ, R[0] < r ∧ (∀ b ∈ W, complexDisk(b, r) ⊆ U) }

def marginFamilies (U C : Set) : Set :=
  { G ∈ 𝒫(C) | ∃ r ∈ ℝ, R[0] < r ∧
      (∀ W ∈ G, ∀ b ∈ W, complexDisk(b, r) ⊆ U) }

theorem marginFamilies.finite (U F : Set)
  requires inside : F ⊆ marginOpens(U)
  requires finite : Finite(F)
  shows ∃ r ∈ ℝ, R[0] < r ∧ (∀ W ∈ F, ∀ b ∈ W, complexDisk(b, r) ⊆ U)
proof
  have one : R[1] ∈ ℝ by typecheck
  have onePositive : R[0] < R[1] by linarith
  have base : ∅ ∈ marginFamilies(U, marginOpens(U))
    apply marginFamilies.membership.backward
    refine ⟨(powerset.empty_member at marginOpens(U)), R[1], one,
      onePositive, ?_⟩
    intros W hW
    exfalso
    exact empty.membership at W with hW
  have step : ∀ G ⊆ marginOpens(U), Finite(G) → ∀ W ∈ marginOpens(U),
      W ∉ G → G ∈ marginFamilies(U, marginOpens(U)) →
      G ∪ {W} ∈ marginFamilies(U, marginOpens(U))
    intros G GInside finiteG W hW fresh GFamily
    obtain ⟨_, r1, hr1, positive1, disks1⟩ :=
      marginFamilies.membership.forward with GFamily
    obtain ⟨_, r2, hr2, positive2, disks2⟩ :=
      marginOpens.membership.forward with hW
    obtain ⟨t, ht, positive, le1, le2⟩ := realRadius.common with hr1, hr2,
      positive1, positive2
    apply marginFamilies.membership.backward
    have single := (singleton.subset_iff at W, marginOpens(U)).backward with hW
    refine ⟨(powerset.membership_iff.backward with
      (union2.subset with GInside, single)), t, ht, positive, ?_⟩
    intros V hV b hb
    have bMember : b ∈ ℂ
      cases (union2.membership.forward with hV) with inG | isW
      . have open := GInside with V, inG
        obtain ⟨member, _⟩ := marginOpens.membership.forward with open
        have sub := ComplexOpen.subset with member
        exact sub with b, hb
      . have same := singleton.membership.forward with isW
        rw same at hb
        obtain ⟨member, _⟩ := marginOpens.membership.forward with hW
        have sub := ComplexOpen.subset with member
        exact sub with b, hb
    cases (union2.membership.forward with hV) with inG | isW
    . exact Subset.transitive with (complexDisk.mono at b, t, r1 with bMember,
        ht, hr1, le1), (disks1 with V, inG, b, hb)
    . have same := singleton.membership.forward with isW
      rw same at hb
      exact Subset.transitive with (complexDisk.mono at b, t, r2 with bMember,
        ht, hr2, le2), (disks2 with b, hb)
  have all := Finite.induction at marginOpens(U),
    marginFamilies(U, marginOpens(U)) with base, step
  have member := all with F, inside, finite
  obtain ⟨_, r, hr, positive, disks⟩ :=
    marginFamilies.membership.forward with member
  exact ⟨r, hr, positive, disks⟩

-- A compact subset of an open set lies in it with a margin: some closed
-- r-neighbourhood of it stays inside.
theorem ComplexCompact.margin (K U : Set)
  requires compact : ComplexCompact(K)
  requires isOpen : ComplexOpen(U)
  requires inside : K ⊆ U
  shows ∃ r ∈ ℝ, R[0] < r ∧ (∀ a ∈ K, complexDisk(a, r) ⊆ U)
proof
  have cover : OpenCover(complexTopology, K, marginOpens(U))
    constructor
    . intros W hW
      have parts := marginOpens.membership.forward with hW
      exact parts.left
    . intros a ha
      have aU := inside with a, ha
      have sub := ComplexOpen.subset with isOpen
      have aMember := sub with a, aU
      obtain ⟨r, hr, positive, disk⟩ := ComplexOpen.disk with isOpen, aU
      have halfPositive := half.positive with positive
      have halfReal : half(r) ∈ ℝ by typecheck
      have total := half.add_self at r
      have inner : complexDisk(a, half(r)) ∈ marginOpens(U)
        apply marginOpens.membership.backward
        refine ⟨(complexDisk.open with aMember, halfReal), half(r), halfReal,
          halfPositive, ?_⟩
        intros b hb w hw
        obtain ⟨bMember, bNear⟩ := complexDisk.membership.forward with hb
        obtain ⟨wMember, wNear⟩ := complexDisk.membership.forward with hw
        have triangle := complexAbs.dist_triangle with wMember, bMember,
          aMember
        have close : w ∈ complexDisk(a, r)
          apply complexDisk.membership.backward
          refine ⟨wMember, ?_⟩
          linarith
        exact disk with w, close
      have center := complexDisk.center with aMember, halfReal, halfPositive
      exact union.contains with center, inner
  obtain ⟨F, FInside, finite, covers⟩ := IsCompact.subcover with compact,
    cover
  obtain ⟨r, hr, positive, disks⟩ := marginFamilies.finite with FInside,
    finite
  refine ⟨r, hr, positive, ?_⟩
  intros a ha
  obtain ⟨W, hW, aW⟩ := union.membership.forward with (covers with a, ha)
  exact disks with W, hW, a, aW

-- Continuity at a point, stated with the modulus.
theorem ComplexContinuousAt.abs_form (f a : Set)
  requires continuous : ComplexContinuousAt(f, a)
  shows ∀ e ∈ ℝ, R[0] < e → ∃ d ∈ ℝ, R[0] < d ∧
    (∀ x ∈ ℂ, complexAbs(ℂ[x - a]) < d → complexAbs(ℂ[f(x) - f(a)]) < e)
proof
  obtain ⟨function, center, close⟩ := continuous
  intros e eReal positive
  have squareReal : R[e * e] ∈ ℝ by typecheck
  have squarePositive : R[0] < R[e * e]
    have product := realLess.mul_right_of_positive with positive, positive
    have zero : R[0 * e] = R[0] by ring
    linarith
  obtain ⟨d0, hd0, positive0, near⟩ := close with R[e * e], squareReal,
    squarePositive
  have one : R[1] ∈ ℝ by typecheck
  have onePositive : R[0] < R[1] by linarith
  obtain ⟨d, hd, dPositive, le0, le1⟩ := realRadius.common with hd0, one,
    positive0, onePositive
  refine ⟨d, hd, dPositive, ?_⟩
  intros x hx small
  have difference : ℂ[x - a] ∈ ℂ by typecheck
  have nonnegative := complexAbs.nonnegative with difference
  have belowOne : complexAbs(ℂ[x - a]) ≤ R[1] by linarith
  have squareLe := realLe.mul_left_of_nonnegative with belowOne, nonnegative
  have square := complexAbs.square with difference
  have times : R[complexAbs(ℂ[x - a]) * 1] = complexAbs(ℂ[x - a]) by ring
  rw times at squareLe
  have normSmall : complexNormSquared(ℂ[x - a]) < d0 by linarith
  have bound := near with x, hx, normSmall
  have fx := FunctionBetween.apply_closed with function, hx
  have fa := FunctionBetween.apply_closed with function, center
  have image : ℂ[f(x) - f(a)] ∈ ℂ by typecheck
  have imageSquare := complexAbs.square with image
  have imageNonnegative := complexAbs.nonnegative with image
  by_contra notSmall
  have large : e ≤ complexAbs(ℂ[f(x) - f(a)]) by linarith
  have eNonnegative : R[0] ≤ e by linarith
  have first := realLe.mul_right_of_nonnegative with large, eNonnegative
  have second := realLe.mul_left_of_nonnegative with large, imageNonnegative
  linarith

-- ComplexContinuous, on all of ℂ, is continuity on ℂ.
theorem ComplexContinuousOn.whole (f : Set)
  requires continuous : ComplexContinuous(f)
  shows ComplexContinuousOn(f, complexCarrier)
proof
  obtain ⟨function, everywhere⟩ := continuous
  refine ⟨(Subset.reflexive at complexCarrier), ?_, ?_⟩
  . intros z hz
    exact FunctionBetween.apply_closed with function, hz
  . intros a ha e eReal positive
    have form := ComplexContinuousAt.abs_form with (everywhere with a, ha)
    exact form with e, eReal, positive

theorem ComplexContinuousOn.mono (f U V : Set)
  requires continuous : ComplexContinuousOn(f, U)
  requires inside : V ⊆ U
  shows ComplexContinuousOn(f, V)
proof
  obtain ⟨subset, values, close⟩ := continuous
  refine ⟨(Subset.transitive with inside, subset), ?_, ?_⟩
  . intros z hz
    exact values with z, (inside with z, hz)
  . intros a ha e eReal positive
    obtain ⟨d, hd, dPositive, near⟩ := close with a, (inside with a, ha), e,
      eReal, positive
    refine ⟨d, hd, dPositive, ?_⟩
    intros z hz small
    exact near with z, (inside with z, hz), small

-- Open sets on whose trace on K the modulus of f is bounded, and the
-- families of them with a common bound.
def boundedOpens (f K : Set) : Set :=
  { W ∈ complexTopology | ∃ B ∈ ℝ, ∀ z ∈ W, z ∈ K → complexAbs(f(z)) ≤ B }

def boundedFamilies (f K C : Set) : Set :=
  { G ∈ 𝒫(C) | ∃ B ∈ ℝ, ∀ W ∈ G, ∀ z ∈ W, z ∈ K →
      complexAbs(f(z)) ≤ B }

theorem boundedFamilies.finite (f K F : Set)
  requires values : ComplexValuedOn(f, K)
  requires inside : F ⊆ boundedOpens(f, K)
  requires finite : Finite(F)
  shows ∃ B ∈ ℝ, ∀ W ∈ F, ∀ z ∈ W, z ∈ K → complexAbs(f(z)) ≤ B
proof
  have zero : R[0] ∈ ℝ by typecheck
  have base : ∅ ∈ boundedFamilies(f, K, boundedOpens(f, K))
    apply boundedFamilies.membership.backward
    refine ⟨(powerset.empty_member at boundedOpens(f, K)), R[0], zero, ?_⟩
    intros W hW
    exfalso
    exact empty.membership at W with hW
  have step : ∀ G ⊆ boundedOpens(f, K), Finite(G) →
      ∀ W ∈ boundedOpens(f, K), W ∉ G →
      G ∈ boundedFamilies(f, K, boundedOpens(f, K)) →
      G ∪ {W} ∈ boundedFamilies(f, K, boundedOpens(f, K))
    intros G GInside finiteG W hW fresh GFamily
    obtain ⟨_, B1, hB1, bounds1⟩ :=
      boundedFamilies.membership.forward with GFamily
    obtain ⟨_, B2, hB2, bounds2⟩ := boundedOpens.membership.forward with hW
    have upper1 := abs.upper at B1
    have upper2 := abs.upper at B2
    have nonnegative1 := abs.nonnegative at B1
    have nonnegative2 := abs.nonnegative at B2
    have sumReal : R[abs(B1) + abs(B2)] ∈ ℝ by typecheck
    apply boundedFamilies.membership.backward
    have single := (singleton.subset_iff at W, boundedOpens(f, K)).backward
      with hW
    refine ⟨(powerset.membership_iff.backward with
      (union2.subset with GInside, single)), R[abs(B1) + abs(B2)], sumReal,
      ?_⟩
    intros V hV z hz zK
    have fz := values with z, zK
    cases (union2.membership.forward with hV) with inG | isW
    . have bound := bounds1 with V, inG, z, hz, zK
      linarith
    . have same := singleton.membership.forward with isW
      rw same at hz
      have bound := bounds2 with z, hz, zK
      linarith
  have all := Finite.induction at boundedOpens(f, K),
    boundedFamilies(f, K, boundedOpens(f, K)) with base, step
  have member := all with F, inside, finite
  obtain ⟨_, B, hB, bounds⟩ := boundedFamilies.membership.forward with member
  exact ⟨B, hB, bounds⟩

-- A continuous function attains a maximum modulus on a nonempty compact set.
theorem ComplexContinuousOn.abs_bounded (f K : Set)
  requires continuous : ComplexContinuousOn(f, K)
  requires compact : ComplexCompact(K)
  shows ∃ B ∈ ℝ, ∀ z ∈ K, complexAbs(f(z)) ≤ B
proof
  obtain ⟨subset, values, close⟩ := continuous
  have one : R[1] ∈ ℝ by typecheck
  have onePositive : R[0] < R[1] by linarith
  have cover : OpenCover(complexTopology, K, boundedOpens(f, K))
    constructor
    . intros W hW
      have parts := boundedOpens.membership.forward with hW
      exact parts.left
    . intros a ha
      have aMember := subset with a, ha
      have fa := values with a, ha
      obtain ⟨d, hd, positive, near⟩ := close with a, ha, R[1], one,
        onePositive
      have boundReal : R[complexAbs(f(a)) + 1] ∈ ℝ by typecheck
      have inner : complexDisk(a, d) ∈ boundedOpens(f, K)
        apply boundedOpens.membership.backward
        refine ⟨(complexDisk.open with aMember, hd), R[complexAbs(f(a)) + 1],
          boundReal, ?_⟩
        intros z hz zK
        obtain ⟨_, zNear⟩ := complexDisk.membership.forward with hz
        have fz := values with z, zK
        have difference : ℂ[f(z) - f(a)] ∈ ℂ by typecheck
        have small := near with z, zK, zNear
        have split : f(z) = ℂ[(f(z) - f(a)) + f(a)] by ring
        have triangle := complexAbs.triangle with difference, fa
        rw ← split at triangle
        linarith
      have center := complexDisk.center with aMember, hd, positive
      exact union.contains with center, inner
  obtain ⟨F, FInside, finite, covers⟩ := IsCompact.subcover with compact,
    cover
  obtain ⟨B, hB, bounds⟩ := boundedFamilies.finite with values, FInside,
    finite
  refine ⟨B, hB, ?_⟩
  intros z hz
  obtain ⟨W, hW, zW⟩ := union.membership.forward with (covers with z, hz)
  exact bounds with W, hW, z, zW, hz

-- Section: Derivatives
-- The error of the linear approximation is the error of the difference
-- quotient times the step.
theorem complexDiv.error (X w D : Set)
  requires hX : X ∈ ℂ
  requires hw : w ∈ ℂ
  requires hD : D ∈ ℂ
  requires nonzero : w ≠ ℂ[0]
  shows complexAbs(ℂ[X - D * w]) =
    R[complexAbs(ℂ[complexDiv(X, w) - D]) * complexAbs(w)]
proof
  have inverse := complexInv.member with hw
  have quotient : complexDiv(X, w) ∈ ℂ
    unfold complexDiv
    typecheck
  have cancel := complexDiv.mul_cancel with hX, hw, nonzero
  have difference : ℂ[complexDiv(X, w) - D] ∈ ℂ by typecheck
  have same : ℂ[X - D * w] = ℂ[(complexDiv(X, w) - D) * w]
    have expand : ℂ[(complexDiv(X, w) - D) * w] =
        ℂ[complexDiv(X, w) * w - D * w] by ring
    rw [expand, cancel]
  rw [same, (complexAbs.mul with difference, hw)]

theorem complexAbs.zero
  shows complexAbs(ℂ[0]) = R[0]
proof
  exact (complexAbs.zero_iff with complexZero.member).backward with rfl

-- The difference quotient tends to the derivative.
theorem HasComplexDerivativeAt.iff_quotient (f U D a : Set)
  requires isOpen : ComplexOpen(U)
  requires ha : a ∈ U
  requires hD : D ∈ ℂ
  requires values : ComplexValuedOn(f, U)
  shows HasComplexDerivativeAt(f, U, D, a) ↔
    (∀ e ∈ ℝ, R[0] < e → ∃ d ∈ ℝ, R[0] < d ∧
      (∀ z ∈ U, z ≠ a → complexAbs(ℂ[z - a]) < d →
        complexAbs(ℂ[complexDiv(ℂ[f(z) - f(a)], ℂ[z - a]) - D]) < e))
proof
  have sub := ComplexOpen.subset with isOpen
  have aMember := sub with a, ha
  have fa := values with a, ha
  constructor
  . intro derivative
    obtain ⟨_, _, _, _, close⟩ := derivative
    intros e he positive
    have typedE : Real(e) by typecheck
    have halfPositive := half.positive with positive
    have halfBelow := half.lt_self with positive
    have halfReal : half(e) ∈ ℝ by typecheck
    obtain ⟨d, hd, dPositive, near⟩ := close with half(e), halfReal,
      halfPositive
    refine ⟨d, hd, dPositive, ?_⟩
    intros z hz distinct small
    have zMember := sub with z, hz
    have fz := values with z, hz
    have step : ℂ[z - a] ∈ ℂ by typecheck
    have stepNonzero : ℂ[z - a] ≠ ℂ[0]
      intro zero
      apply distinct
      have same : z = ℂ[(z - a) + a] by ring
      rw [same, zero]
      ring
    have stepPositive := complexAbs.positive with step, stepNonzero
    have increment : ℂ[f(z) - f(a)] ∈ ℂ by typecheck
    have error := complexDiv.error with increment, step, hD, stepNonzero
    have inverse := complexInv.member with step
    have quotientMember : ℂ[complexDiv(ℂ[f(z) - f(a)], ℂ[z - a]) - D] ∈ ℂ
      unfold complexDiv
      typecheck
    have quotientReal : complexAbs(ℂ[complexDiv(ℂ[f(z) - f(a)], ℂ[z - a]) -
      D]) ∈ ℝ by typecheck
    have bound := near with z, hz, small
    rw error at bound
    have cancelled := realLe.mul_right_cancel_positive with stepPositive,
      bound
    linarith
  . intro quotient
    refine ⟨isOpen, ha, hD, values, ?_⟩
    intros e he positive
    obtain ⟨d, hd, dPositive, near⟩ := quotient with e, he, positive
    refine ⟨d, hd, dPositive, ?_⟩
    intros z hz small
    have zMember := sub with z, hz
    have fz := values with z, hz
    have step : ℂ[z - a] ∈ ℂ by typecheck
    have alternatives : z = a ∨ z ≠ a by tauto
    cases alternatives with same | distinct
    . rw same
      have zero : ℂ[f(a) - f(a) - D * (a - a)] = ℂ[0] by ring
      have zeroStep : ℂ[a - a] = ℂ[0] by ring
      rw [zero, zeroStep, complexAbs.zero]
      have collapse : R[e * 0] = R[0] by ring
      rw collapse
      linarith
    . have stepNonzero : ℂ[z - a] ≠ ℂ[0]
        intro zero
        apply distinct
        have same : z = ℂ[(z - a) + a] by ring
        rw [same, zero]
        ring
      have stepPositive := complexAbs.positive with step, stepNonzero
      have increment : ℂ[f(z) - f(a)] ∈ ℂ by typecheck
      have error := complexDiv.error with increment, step, hD, stepNonzero
      have bound := near with z, hz, distinct, small
      have inverse := complexInv.member with step
      have quotientMember : ℂ[complexDiv(ℂ[f(z) - f(a)], ℂ[z - a]) - D] ∈ ℂ
        unfold complexDiv
        typecheck
      have quotientReal : complexAbs(ℂ[complexDiv(ℂ[f(z) - f(a)],
        ℂ[z - a]) - D]) ∈ ℝ by typecheck
      rw error
      have boundLe : complexAbs(ℂ[complexDiv(ℂ[f(z) - f(a)], ℂ[z - a]) - D])
          ≤ e by linarith
      have stepNonnegative : R[0] ≤ complexAbs(ℂ[z - a]) by linarith
      exact realLe.mul_right_of_nonnegative with boundLe, stepNonnegative

theorem complexDeriv.has_derivative (f U a : Set)
  requires holomorphic : HolomorphicOn(f, U)
  requires ha : a ∈ U
  shows HasComplexDerivativeAt(f, U, complexDeriv(f, U)(a), a)
proof
  obtain ⟨_, _, differentiableAll⟩ := holomorphic
  have differentiable := differentiableAll with a, ha
  have selected := complexDerivativeValue.selected with differentiable
  rw (complexDeriv.value with holomorphic, ha)
  exact selected.right

-- The derivative depends only on the values near the point: on a smaller
-- open set the derivative is the same.
theorem HasComplexDerivativeAt.mono (f U V D a : Set)
  requires derivative : HasComplexDerivativeAt(f, U, D, a)
  requires isOpen : ComplexOpen(V)
  requires inside : V ⊆ U
  requires ha : a ∈ V
  shows HasComplexDerivativeAt(f, V, D, a)
proof
  obtain ⟨_, _, hD, values, close⟩ := derivative
  have restricted : ComplexValuedOn(f, V)
    intros z hz
    exact values with z, (inside with z, hz)
  refine ⟨isOpen, ha, hD, restricted, ?_⟩
  intros e he positive
  obtain ⟨d, hd, dPositive, near⟩ := close with e, he, positive
  refine ⟨d, hd, dPositive, ?_⟩
  intros z hz small
  exact near with z, (inside with z, hz), small

-- Functions agreeing on U have the same derivatives there.
theorem HasComplexDerivativeAt.congr (f g U D a : Set)
  requires derivative : HasComplexDerivativeAt(f, U, D, a)
  requires agree : ∀ z ∈ U, f(z) = g(z)
  shows HasComplexDerivativeAt(g, U, D, a)
proof
  obtain ⟨isOpen, ha, hD, values, close⟩ := derivative
  have valuesG : ComplexValuedOn(g, U)
    intros z hz
    rw ← (agree with z, hz)
    exact values with z, hz
  refine ⟨isOpen, ha, hD, valuesG, ?_⟩
  intros e he positive
  obtain ⟨d, hd, dPositive, near⟩ := close with e, he, positive
  refine ⟨d, hd, dPositive, ?_⟩
  intros z hz small
  rw [← (agree with z, hz), ← (agree with a, ha)]
  exact near with z, hz, small

-- Near the point, a differentiable function moves by at most
-- (1 + |D|) times the step.
theorem HasComplexDerivativeAt.lipschitz (f U D a : Set)
  requires derivative : HasComplexDerivativeAt(f, U, D, a)
  shows ∃ d ∈ ℝ, R[0] < d ∧ (∀ z ∈ U, complexAbs(ℂ[z - a]) < d →
    complexAbs(ℂ[f(z) - f(a)]) ≤ R[(1 + complexAbs(D)) * complexAbs(ℂ[z - a])])
proof
  obtain ⟨isOpen, ha, hD, values, close⟩ := derivative
  have sub := ComplexOpen.subset with isOpen
  have aMember := sub with a, ha
  have fa := values with a, ha
  have one : R[1] ∈ ℝ by typecheck
  have onePositive : R[0] < R[1] by linarith
  obtain ⟨d, hd, dPositive, near⟩ := close with R[1], one, onePositive
  refine ⟨d, hd, dPositive, ?_⟩
  intros z hz small
  have zMember := sub with z, hz
  have fz := values with z, hz
  have step : ℂ[z - a] ∈ ℂ by typecheck
  have error : ℂ[f(z) - f(a) - D * (z - a)] ∈ ℂ by typecheck
  have linear : ℂ[D * (z - a)] ∈ ℂ by typecheck
  have bound := near with z, hz, small
  have split : ℂ[f(z) - f(a)] = ℂ[(f(z) - f(a) - D * (z - a)) + D * (z - a)]
    by ring
  have triangle := complexAbs.triangle with error, linear
  rw [← split, (complexAbs.mul with hD, step)] at triangle
  have oneTimes : R[1 * complexAbs(ℂ[z - a])] = complexAbs(ℂ[z - a]) by ring
  rw oneTimes at bound
  have expand : R[(1 + complexAbs(D)) * complexAbs(ℂ[z - a])] =
      R[complexAbs(ℂ[z - a]) + complexAbs(D) * complexAbs(ℂ[z - a])] by ring
  have productReal : R[complexAbs(D) * complexAbs(ℂ[z - a])] ∈ ℝ by
    typecheck
  have scaledReal : R[(1 + complexAbs(D)) * complexAbs(ℂ[z - a])] ∈ ℝ by
    typecheck
  linarith

theorem HasComplexDerivativeAt.continuous (f U D a : Set)
  requires derivative : HasComplexDerivativeAt(f, U, D, a)
  shows ∀ e ∈ ℝ, R[0] < e → ∃ d ∈ ℝ, R[0] < d ∧
    (∀ z ∈ U, complexAbs(ℂ[z - a]) < d → complexAbs(ℂ[f(z) - f(a)]) < e)
proof
  obtain ⟨d1, hd1, positive1, lipschitz⟩ :=
    HasComplexDerivativeAt.lipschitz with derivative
  obtain ⟨isOpen, ha, hD, values, _⟩ := derivative
  have sub := ComplexOpen.subset with isOpen
  have fa := values with a, ha
  intros e he positive
  have DNonnegative := complexAbs.nonnegative with hD
  have scaleReal : R[1 + complexAbs(D)] ∈ ℝ by typecheck
  have scalePositive : R[0] < R[1 + complexAbs(D)] by linarith
  have scaleNonnegative : R[0] ≤ R[1 + complexAbs(D)] by linarith
  obtain ⟨ε, hε, εPositive, scaled, _⟩ := realScale.absorb with scaleReal, he,
    scaleNonnegative, positive
  obtain ⟨d, hd, dPositive, le1, leε⟩ := realRadius.common with hd1, hε,
    positive1, εPositive
  refine ⟨d, hd, dPositive, ?_⟩
  intros z hz small
  have zMember := sub with z, hz
  have fz := values with z, hz
  have aMember := sub with a, ha
  have stepD1 : complexAbs(ℂ[z - a]) < d1 by linarith
  have bound := lipschitz with z, hz, stepD1
  have stepSmall : complexAbs(ℂ[z - a]) < ε by linarith
  have growth := realLess.mul_left_of_positive with stepSmall, scalePositive
  have productReal : R[(1 + complexAbs(D)) * complexAbs(ℂ[z - a])] ∈ ℝ by
    typecheck
  linarith

theorem HasComplexDerivativeAt.const (c U a : Set)
  requires isOpen : ComplexOpen(U)
  requires ha : a ∈ U
  requires hc : c ∈ ℂ
  shows HasComplexDerivativeAt(complexFunctionConst(c, U), U, ℂ[0], a)
proof
  have sub := ComplexOpen.subset with isOpen
  have zero := complexZero.member
  have values : ComplexValuedOn(complexFunctionConst(c, U), U)
    intros z hz
    rw (complexFunctionConst.value with hc, hz)
    exact hc
  refine ⟨isOpen, ha, zero, values, ?_⟩
  intros e he positive
  have one : R[1] ∈ ℝ by typecheck
  have onePositive : R[0] < R[1] by linarith
  refine ⟨R[1], one, onePositive, ?_⟩
  intros z hz small
  have zMember := sub with z, hz
  have aMember := sub with a, ha
  have step : ℂ[z - a] ∈ ℂ by typecheck
  rw [(complexFunctionConst.value with hc, hz),
    (complexFunctionConst.value with hc, ha)]
  have collapse : ℂ[c - c - 0 * (z - a)] = ℂ[0] by ring
  rw [collapse, complexAbs.zero]
  have stepNonnegative := complexAbs.nonnegative with step
  have eNonnegative : R[0] ≤ e by linarith
  have product := realLe.mul_right_of_nonnegative with eNonnegative,
    stepNonnegative
  have zeroTimes : R[0 * complexAbs(ℂ[z - a])] = R[0] by ring
  linarith

theorem HasComplexDerivativeAt.id (U a : Set)
  requires isOpen : ComplexOpen(U)
  requires ha : a ∈ U
  shows HasComplexDerivativeAt(complexFunctionId(U), U, ℂ[1], a)
proof
  have sub := ComplexOpen.subset with isOpen
  have one := complexOne.member
  have values : ComplexValuedOn(complexFunctionId(U), U)
    intros z hz
    rw (complexFunctionId.value with sub, hz)
    exact sub with z, hz
  refine ⟨isOpen, ha, one, values, ?_⟩
  intros e he positive
  have oneReal : R[1] ∈ ℝ by typecheck
  have onePositive : R[0] < R[1] by linarith
  refine ⟨R[1], oneReal, onePositive, ?_⟩
  intros z hz small
  have zMember := sub with z, hz
  have aMember := sub with a, ha
  have step : ℂ[z - a] ∈ ℂ by typecheck
  rw [(complexFunctionId.value with sub, hz),
    (complexFunctionId.value with sub, ha)]
  have collapse : ℂ[z - a - 1 * (z - a)] = ℂ[0] by ring
  rw [collapse, complexAbs.zero]
  have stepNonnegative := complexAbs.nonnegative with step
  have eNonnegative : R[0] ≤ e by linarith
  have product := realLe.mul_right_of_nonnegative with eNonnegative,
    stepNonnegative
  have zeroTimes : R[0 * complexAbs(ℂ[z - a])] = R[0] by ring
  linarith

theorem HasComplexDerivativeAt.add (f g U D E a : Set)
  requires derivativeF : HasComplexDerivativeAt(f, U, D, a)
  requires derivativeG : HasComplexDerivativeAt(g, U, E, a)
  shows HasComplexDerivativeAt(complexFunctionAdd(f, g, U), U, ℂ[D + E], a)
proof
  obtain ⟨isOpen, ha, hD, valuesF, closeF⟩ := derivativeF
  obtain ⟨_, _, hE, valuesG, closeG⟩ := derivativeG
  have sub := ComplexOpen.subset with isOpen
  have aMember := sub with a, ha
  have fa := valuesF with a, ha
  have ga := valuesG with a, ha
  have sum : ℂ[D + E] ∈ ℂ by typecheck
  have values : ComplexValuedOn(complexFunctionAdd(f, g, U), U)
    intros z hz
    rw (complexFunctionAdd.value with valuesF, valuesG, hz)
    exact complexFunctionAdd.closed with valuesF, valuesG, hz
  refine ⟨isOpen, ha, sum, values, ?_⟩
  intros e he positive
  have two : R[2] ∈ ℝ by typecheck
  have twoNonnegative : R[0] ≤ R[2] by linarith
  obtain ⟨ε, hε, εPositive, twice, _⟩ := realScale.absorb with two, he,
    twoNonnegative, positive
  obtain ⟨d1, hd1, positive1, nearF⟩ := closeF with ε, hε, εPositive
  obtain ⟨d2, hd2, positive2, nearG⟩ := closeG with ε, hε, εPositive
  obtain ⟨d, hd, dPositive, le1, le2⟩ := realRadius.common with hd1, hd2,
    positive1, positive2
  refine ⟨d, hd, dPositive, ?_⟩
  intros z hz small
  have zMember := sub with z, hz
  have fz := valuesF with z, hz
  have gz := valuesG with z, hz
  have step : ℂ[z - a] ∈ ℂ by typecheck
  have errorF : ℂ[f(z) - f(a) - D * (z - a)] ∈ ℂ by typecheck
  have errorG : ℂ[g(z) - g(a) - E * (z - a)] ∈ ℂ by typecheck
  have smallF : complexAbs(ℂ[z - a]) < d1 by linarith
  have smallG : complexAbs(ℂ[z - a]) < d2 by linarith
  have boundF := nearF with z, hz, smallF
  have boundG := nearG with z, hz, smallG
  rw [(complexFunctionAdd.value with valuesF, valuesG, hz),
    (complexFunctionAdd.value with valuesF, valuesG, ha)]
  have split : ℂ[(f(z) + g(z)) - (f(a) + g(a)) - (D + E) * (z - a)] =
      ℂ[(f(z) - f(a) - D * (z - a)) + (g(z) - g(a) - E * (z - a))] by ring
  rw split
  have triangle := complexAbs.triangle with errorF, errorG
  have stepNonnegative := complexAbs.nonnegative with step
  have scaled := realLe.mul_right_of_nonnegative with twice, stepNonnegative
  have expand : R[ε * complexAbs(ℂ[z - a]) + ε * complexAbs(ℂ[z - a])] =
      R[(2 * ε) * complexAbs(ℂ[z - a])] by ring
  linarith

theorem HasComplexDerivativeAt.neg (f U D a : Set)
  requires derivativeF : HasComplexDerivativeAt(f, U, D, a)
  shows HasComplexDerivativeAt(complexFunctionNeg(f, U), U, ℂ[-D], a)
proof
  obtain ⟨isOpen, ha, hD, valuesF, closeF⟩ := derivativeF
  have sub := ComplexOpen.subset with isOpen
  have aMember := sub with a, ha
  have fa := valuesF with a, ha
  have negD : ℂ[-D] ∈ ℂ by typecheck
  have values : ComplexValuedOn(complexFunctionNeg(f, U), U)
    intros z hz
    rw (complexFunctionNeg.value with valuesF, hz)
    exact complexFunctionNeg.closed with valuesF, hz
  refine ⟨isOpen, ha, negD, values, ?_⟩
  intros e he positive
  obtain ⟨d, hd, dPositive, near⟩ := closeF with e, he, positive
  refine ⟨d, hd, dPositive, ?_⟩
  intros z hz small
  have zMember := sub with z, hz
  have fz := valuesF with z, hz
  have errorF : ℂ[f(z) - f(a) - D * (z - a)] ∈ ℂ by typecheck
  rw [(complexFunctionNeg.value with valuesF, hz),
    (complexFunctionNeg.value with valuesF, ha)]
  have flip : ℂ[-f(z) - -f(a) - -D * (z - a)] =
      ℂ[-(f(z) - f(a) - D * (z - a))] by ring
  rw [flip, (complexAbs.neg with errorF)]
  exact near with z, hz, small

theorem HasComplexDerivativeAt.mul (f g U D E a : Set)
  requires derivativeF : HasComplexDerivativeAt(f, U, D, a)
  requires derivativeG : HasComplexDerivativeAt(g, U, E, a)
  shows HasComplexDerivativeAt(complexFunctionMul(f, g, U), U,
    ℂ[D * g(a) + f(a) * E], a)
proof
  have continuousG := HasComplexDerivativeAt.continuous with derivativeG
  obtain ⟨isOpen, ha, hD, valuesF, closeF⟩ := derivativeF
  obtain ⟨_, _, hE, valuesG, closeG⟩ := derivativeG
  have sub := ComplexOpen.subset with isOpen
  have aMember := sub with a, ha
  have fa := valuesF with a, ha
  have ga := valuesG with a, ha
  have slope : ℂ[D * g(a) + f(a) * E] ∈ ℂ by typecheck
  have values : ComplexValuedOn(complexFunctionMul(f, g, U), U)
    intros z hz
    rw (complexFunctionMul.value with valuesF, valuesG, hz)
    exact complexFunctionMul.closed with valuesF, valuesG, hz
  refine ⟨isOpen, ha, slope, values, ?_⟩
  intros e he positive
  -- Split e into three, and absorb the factors |g(a)| + 1, |D|, |f(a)|.
  have three : R[3] ∈ ℝ by typecheck
  have threeNonnegative : R[0] ≤ R[3] by linarith
  obtain ⟨e3, he3, e3Positive, thrice, _⟩ := realScale.absorb with three, he,
    threeNonnegative, positive
  have gaNonnegative := complexAbs.nonnegative with ga
  have faNonnegative := complexAbs.nonnegative with fa
  have DNonnegative := complexAbs.nonnegative with hD
  have GbReal : R[complexAbs(g(a)) + 1] ∈ ℝ by typecheck
  have GbNonnegative : R[0] ≤ R[complexAbs(g(a)) + 1] by linarith
  have DReal : complexAbs(D) ∈ ℝ by typecheck
  have faReal : complexAbs(f(a)) ∈ ℝ by typecheck
  obtain ⟨εF, hεF, εFPositive, absorbF, _⟩ := realScale.absorb with GbReal,
    he3, GbNonnegative, e3Positive
  obtain ⟨η, hη, ηPositive, absorbD, _⟩ := realScale.absorb with DReal, he3,
    DNonnegative, e3Positive
  obtain ⟨εG, hεG, εGPositive, absorbG, _⟩ := realScale.absorb with faReal,
    he3, faNonnegative, e3Positive
  have one : R[1] ∈ ℝ by typecheck
  have onePositive : R[0] < R[1] by linarith
  obtain ⟨d1, hd1, positive1, nearF⟩ := closeF with εF, hεF, εFPositive
  obtain ⟨d2, hd2, positive2, nearG⟩ := closeG with εG, hεG, εGPositive
  obtain ⟨d3, hd3, positive3, nearOne⟩ := continuousG with R[1], one,
    onePositive
  obtain ⟨d4, hd4, positive4, nearη⟩ := continuousG with η, hη, ηPositive
  obtain ⟨d12, hd12, positive12, le1, le2⟩ := realRadius.common with hd1,
    hd2, positive1, positive2
  obtain ⟨d34, hd34, positive34, le3, le4⟩ := realRadius.common with hd3,
    hd4, positive3, positive4
  obtain ⟨d, hd, dPositive, le12, le34⟩ := realRadius.common with hd12,
    hd34, positive12, positive34
  refine ⟨d, hd, dPositive, ?_⟩
  intros z hz small
  have zMember := sub with z, hz
  have fz := valuesF with z, hz
  have gz := valuesG with z, hz
  have step : ℂ[z - a] ∈ ℂ by typecheck
  have stepReal : complexAbs(ℂ[z - a]) ∈ ℝ by typecheck
  have stepNonnegative := complexAbs.nonnegative with step
  have small1 : complexAbs(ℂ[z - a]) < d1 by linarith
  have small2 : complexAbs(ℂ[z - a]) < d2 by linarith
  have small3 : complexAbs(ℂ[z - a]) < d3 by linarith
  have small4 : complexAbs(ℂ[z - a]) < d4 by linarith
  have boundF := nearF with z, hz, small1
  have boundG := nearG with z, hz, small2
  have boundOne := nearOne with z, hz, small3
  have boundη := nearη with z, hz, small4
  have errorF : ℂ[f(z) - f(a) - D * (z - a)] ∈ ℂ by typecheck
  have errorG : ℂ[g(z) - g(a) - E * (z - a)] ∈ ℂ by typecheck
  have changeG : ℂ[g(z) - g(a)] ∈ ℂ by typecheck
  have linear : ℂ[D * (z - a)] ∈ ℂ by typecheck
  have term1 : ℂ[(f(z) - f(a) - D * (z - a)) * g(z)] ∈ ℂ by typecheck
  have term2 : ℂ[(D * (z - a)) * (g(z) - g(a))] ∈ ℂ by typecheck
  have term3 : ℂ[f(a) * (g(z) - g(a) - E * (z - a))] ∈ ℂ by typecheck
  have term12 : ℂ[(f(z) - f(a) - D * (z - a)) * g(z) +
    (D * (z - a)) * (g(z) - g(a))] ∈ ℂ by typecheck
  rw [(complexFunctionMul.value with valuesF, valuesG, hz),
    (complexFunctionMul.value with valuesF, valuesG, ha)]
  have split : ℂ[f(z) * g(z) - f(a) * g(a) - (D * g(a) + f(a) * E) * (z - a)]
      = ℂ[((f(z) - f(a) - D * (z - a)) * g(z) +
        (D * (z - a)) * (g(z) - g(a))) +
        f(a) * (g(z) - g(a) - E * (z - a))] by ring
  rw split
  have triangleOuter := complexAbs.triangle with term12, term3
  have triangleInner := complexAbs.triangle with term1, term2
  rw [(complexAbs.mul with errorF, gz)] at triangleInner
  rw [(complexAbs.mul with linear, changeG), (complexAbs.mul with hD, step)]
    at triangleInner
  rw [(complexAbs.mul with fa, errorG)] at triangleOuter
  -- |g(z)| ≤ |g(a)| + 1.
  have splitG : g(z) = ℂ[(g(z) - g(a)) + g(a)] by ring
  have triangleG := complexAbs.triangle with changeG, ga
  rw ← splitG at triangleG
  have gzReal : complexAbs(g(z)) ∈ ℝ by typecheck
  have changeReal : complexAbs(ℂ[g(z) - g(a)]) ∈ ℝ by typecheck
  have gzBound : complexAbs(g(z)) ≤ R[complexAbs(g(a)) + 1] by linarith
  -- The first term.
  have errorFNonnegative := complexAbs.nonnegative with errorF
  have errorFReal : complexAbs(ℂ[f(z) - f(a) - D * (z - a)]) ∈ ℝ by typecheck
  have first1 := realLe.mul_left_of_nonnegative with gzBound,
    errorFNonnegative
  have first2 := realLe.mul_right_of_nonnegative with boundF, GbNonnegative
  have first3 := realLe.mul_right_of_nonnegative with absorbF, stepNonnegative
  have first4 : R[(εF * complexAbs(ℂ[z - a])) * (complexAbs(g(a)) + 1)] =
      R[((complexAbs(g(a)) + 1) * εF) * complexAbs(ℂ[z - a])] by ring
  -- The second term.
  have changeLe : complexAbs(ℂ[g(z) - g(a)]) ≤ η by linarith
  have DStep : R[0] ≤ R[complexAbs(D) * complexAbs(ℂ[z - a])]
    have product := realLe.mul_right_of_nonnegative with DNonnegative,
      stepNonnegative
    have zeroTimes : R[0 * complexAbs(ℂ[z - a])] = R[0] by ring
    linarith
  have second1 := realLe.mul_left_of_nonnegative with changeLe, DStep
  have second2 := realLe.mul_right_of_nonnegative with absorbD,
    stepNonnegative
  have second3 : R[(complexAbs(D) * complexAbs(ℂ[z - a])) * η] =
      R[(complexAbs(D) * η) * complexAbs(ℂ[z - a])] by ring
  -- The third term.
  have third1 := realLe.mul_left_of_nonnegative with boundG, faNonnegative
  have third2 := realLe.mul_right_of_nonnegative with absorbG,
    stepNonnegative
  have third3 : R[complexAbs(f(a)) * (εG * complexAbs(ℂ[z - a]))] =
      R[(complexAbs(f(a)) * εG) * complexAbs(ℂ[z - a])] by ring
  -- Together.
  have total := realLe.mul_right_of_nonnegative with thrice, stepNonnegative
  have sum : R[e3 * complexAbs(ℂ[z - a]) + e3 * complexAbs(ℂ[z - a]) +
      e3 * complexAbs(ℂ[z - a])] = R[(3 * e3) * complexAbs(ℂ[z - a])] by ring
  have errorGReal : complexAbs(ℂ[g(z) - g(a) - E * (z - a)]) ∈ ℝ by typecheck
  have r1 : R[complexAbs(ℂ[f(z) - f(a) - D * (z - a)]) * complexAbs(g(z))] ∈ ℝ
    by typecheck
  have r2 : R[complexAbs(ℂ[f(z) - f(a) - D * (z - a)]) *
    (complexAbs(g(a)) + 1)] ∈ ℝ by typecheck
  have r3 : R[(εF * complexAbs(ℂ[z - a])) * (complexAbs(g(a)) + 1)] ∈ ℝ by
    typecheck
  have r4 : R[((complexAbs(g(a)) + 1) * εF) * complexAbs(ℂ[z - a])] ∈ ℝ by
    typecheck
  have r5 : R[e3 * complexAbs(ℂ[z - a])] ∈ ℝ by typecheck
  have r6 : R[(complexAbs(D) * complexAbs(ℂ[z - a])) *
    complexAbs(ℂ[g(z) - g(a)])] ∈ ℝ by typecheck
  have r7 : R[(complexAbs(D) * complexAbs(ℂ[z - a])) * η] ∈ ℝ by typecheck
  have r8 : R[(complexAbs(D) * η) * complexAbs(ℂ[z - a])] ∈ ℝ by typecheck
  have r9 : R[complexAbs(f(a)) * complexAbs(ℂ[g(z) - g(a) - E * (z - a)])]
    ∈ ℝ by typecheck
  have r10 : R[complexAbs(f(a)) * (εG * complexAbs(ℂ[z - a]))] ∈ ℝ by
    typecheck
  have r11 : R[(complexAbs(f(a)) * εG) * complexAbs(ℂ[z - a])] ∈ ℝ by
    typecheck
  have r14 : complexAbs(ℂ[((f(z) - f(a) - D * (z - a)) * g(z) +
    (D * (z - a)) * (g(z) - g(a)))]) ∈ ℝ by typecheck
  linarith

-- The reciprocal rule, for 1 / g written as complexDiv(1, g(z)).
theorem HasComplexDerivativeAt.inv (g U E a : Set)
  requires derivativeG : HasComplexDerivativeAt(g, U, E, a)
  requires nonvanishing : ∀ z ∈ U, g(z) ≠ ℂ[0]
  shows HasComplexDerivativeAt(
    complexFunctionDiv(complexFunctionConst(ℂ[1], U), g, U), U,
    ℂ[-(E * complexInv(g(a)) * complexInv(g(a)))], a)
proof
  have continuousG := HasComplexDerivativeAt.continuous with derivativeG
  obtain ⟨isOpen, ha, hE, valuesG, closeG⟩ := derivativeG
  have sub := ComplexOpen.subset with isOpen
  have aMember := sub with a, ha
  have ga := valuesG with a, ha
  have one := complexOne.member
  have valuesOne : ComplexValuedOn(complexFunctionConst(ℂ[1], U), U)
    intros z hz
    rw (complexFunctionConst.value with one, hz)
    exact one
  have formula : ∀ z ∈ U,
      complexFunctionDiv(complexFunctionConst(ℂ[1], U), g, U)(z) =
      ℂ[1 * complexInv(g(z))]
    intros z hz
    rw [(complexFunctionDiv.value with valuesOne, valuesG, hz),
      (complexFunctionConst.value with one, hz)]
    unfold complexDiv
    rfl
  have ia := complexInv.member with ga
  have slope : ℂ[-(E * complexInv(g(a)) * complexInv(g(a)))] ∈ ℂ by typecheck
  have values : ComplexValuedOn(
      complexFunctionDiv(complexFunctionConst(ℂ[1], U), g, U), U)
    intros z hz
    rw (complexFunctionDiv.value with valuesOne, valuesG, hz)
    exact complexFunctionDiv.closed with valuesOne, valuesG, hz
  refine ⟨isOpen, ha, slope, values, ?_⟩
  intros e he positive
  -- |g(a)| |1/g(a)| = 1, and B = 2 |1/g(a)| bounds |1/g(z)| near a.
  have gaNonzero := nonvanishing with a, ha
  have cancelA := complexInv.mul_cancel with ga, gaNonzero
  have gaPositive := complexAbs.positive with ga, gaNonzero
  have gaReal : complexAbs(g(a)) ∈ ℝ by typecheck
  have typedGa : Real(complexAbs(g(a))) by typecheck
  have productA : R[complexAbs(g(a)) * complexAbs(complexInv(g(a)))] = R[1]
    rw [← (complexAbs.mul with ga, ia), cancelA, complexAbs.one]
  have iaNonnegative := complexAbs.nonnegative with ia
  have iaReal : complexAbs(complexInv(g(a))) ∈ ℝ by typecheck
  have halfPositive := half.positive with gaPositive
  have halfReal : half(complexAbs(g(a))) ∈ ℝ by typecheck
  have halfTwice := half.add_self at complexAbs(g(a))
  have typedE : Real(e) by typecheck
  have eHalfPositive := half.positive with positive
  have eHalfReal : half(e) ∈ ℝ by typecheck
  have eTwice := half.add_self at e
  have K1Real : R[(2 * complexAbs(complexInv(g(a)))) *
    complexAbs(complexInv(g(a)))] ∈ ℝ by typecheck
  have K1Nonnegative : R[0] ≤ R[(2 * complexAbs(complexInv(g(a)))) *
      complexAbs(complexInv(g(a)))]
    have twoIa : R[0] ≤ R[2 * complexAbs(complexInv(g(a)))] by linarith
    have product := realLe.mul_right_of_nonnegative with twoIa,
      iaNonnegative
    have zeroTimes : R[0 * complexAbs(complexInv(g(a)))] = R[0] by ring
    linarith
  have ENonnegative := complexAbs.nonnegative with hE
  have K2Real : R[complexAbs(E) * (complexAbs(complexInv(g(a))) *
    complexAbs(complexInv(g(a)))) * (2 * complexAbs(complexInv(g(a))))] ∈ ℝ
    by typecheck
  have K2Nonnegative : R[0] ≤ R[complexAbs(E) *
      (complexAbs(complexInv(g(a))) * complexAbs(complexInv(g(a)))) *
      (2 * complexAbs(complexInv(g(a))))]
    have square := realLe.mul_right_of_nonnegative with iaNonnegative,
      iaNonnegative
    have zeroSquare : R[0 * complexAbs(complexInv(g(a)))] = R[0] by ring
    have squareNonnegative : R[0] ≤ R[complexAbs(complexInv(g(a))) *
      complexAbs(complexInv(g(a)))] by linarith
    have first := realLe.mul_left_of_nonnegative with squareNonnegative,
      ENonnegative
    have zeroFirst : R[complexAbs(E) * 0] = R[0] by ring
    have firstNonnegative : R[0] ≤ R[complexAbs(E) *
      (complexAbs(complexInv(g(a))) * complexAbs(complexInv(g(a))))] by
      linarith
    have twoIa : R[0] ≤ R[2 * complexAbs(complexInv(g(a)))] by linarith
    have second := realLe.mul_right_of_nonnegative with firstNonnegative,
      twoIa
    have zeroSecond : R[0 * (2 * complexAbs(complexInv(g(a))))] = R[0] by ring
    linarith
  obtain ⟨εG, hεG, εGPositive, absorbG, _⟩ := realScale.absorb with K1Real,
    eHalfReal, K1Nonnegative, eHalfPositive
  obtain ⟨η, hη, ηPositive, absorbη, _⟩ := realScale.absorb with K2Real,
    eHalfReal, K2Nonnegative, eHalfPositive
  obtain ⟨d1, hd1, positive1, nearG⟩ := closeG with εG, hεG, εGPositive
  obtain ⟨d2, hd2, positive2, nearHalf⟩ := continuousG with
    half(complexAbs(g(a))), halfReal, halfPositive
  obtain ⟨d3, hd3, positive3, nearη⟩ := continuousG with η, hη, ηPositive
  obtain ⟨d12, hd12, positive12, le1, le2⟩ := realRadius.common with hd1,
    hd2, positive1, positive2
  obtain ⟨d, hd, dPositive, le12, le3⟩ := realRadius.common with hd12,
    hd3, positive12, positive3
  refine ⟨d, hd, dPositive, ?_⟩
  intros z hz small
  have zMember := sub with z, hz
  have gz := valuesG with z, hz
  have gzNonzero := nonvanishing with z, hz
  have iz := complexInv.member with gz
  have cancelZ := complexInv.mul_cancel with gz, gzNonzero
  have step : ℂ[z - a] ∈ ℂ by typecheck
  have stepReal : complexAbs(ℂ[z - a]) ∈ ℝ by typecheck
  have stepNonnegative := complexAbs.nonnegative with step
  have small1 : complexAbs(ℂ[z - a]) < d1 by linarith
  have small2 : complexAbs(ℂ[z - a]) < d2 by linarith
  have small3 : complexAbs(ℂ[z - a]) < d3 by linarith
  have boundG := nearG with z, hz, small1
  have boundHalf := nearHalf with z, hz, small2
  have boundη := nearη with z, hz, small3
  -- |1/g(z)| ≤ 2 |1/g(a)|.
  have changeG : ℂ[g(z) - g(a)] ∈ ℂ by typecheck
  have changeReal : complexAbs(ℂ[g(z) - g(a)]) ∈ ℝ by typecheck
  have reverse := complexAbs.sub_le with ga, gz
  have flip := complexAbs.dist_symm with ga, gz
  have splitA : g(a) = ℂ[(g(a) - g(z)) + g(z)] by ring
  have backward : ℂ[g(a) - g(z)] ∈ ℂ by typecheck
  have triangleA := complexAbs.triangle with backward, gz
  rw ← splitA at triangleA
  have gzReal : complexAbs(g(z)) ∈ ℝ by typecheck
  have lower : half(complexAbs(g(a))) ≤ complexAbs(g(z)) by linarith
  have productZ : R[complexAbs(g(z)) * complexAbs(complexInv(g(z)))] = R[1]
    rw [← (complexAbs.mul with gz, iz), cancelZ, complexAbs.one]
  have izNonnegative := complexAbs.nonnegative with iz
  have izReal : complexAbs(complexInv(g(z))) ∈ ℝ by typecheck
  have lowerScaled := realLe.mul_right_of_nonnegative with lower,
    izNonnegative
  have halfIdentity : R[(2 * complexAbs(complexInv(g(a)))) *
      half(complexAbs(g(a)))] = R[1]
    have expand : R[(2 * complexAbs(complexInv(g(a)))) *
        half(complexAbs(g(a)))] = R[complexAbs(complexInv(g(a))) *
        (half(complexAbs(g(a))) + half(complexAbs(g(a))))] by ring
    rw [expand, halfTwice]
    linear_combination productA
  have izBoundProduct : R[complexAbs(complexInv(g(z))) *
      half(complexAbs(g(a)))] ≤ R[(2 * complexAbs(complexInv(g(a)))) *
      half(complexAbs(g(a)))]
    have commuted : R[half(complexAbs(g(a))) *
        complexAbs(complexInv(g(z)))] = R[complexAbs(complexInv(g(z))) *
        half(complexAbs(g(a)))] by ring
    have r1 : R[complexAbs(complexInv(g(z))) * half(complexAbs(g(a)))] ∈ ℝ
      by typecheck
    have r2 : R[complexAbs(g(z)) * complexAbs(complexInv(g(z)))] ∈ ℝ by
      typecheck
    have r3 : R[half(complexAbs(g(a))) * complexAbs(complexInv(g(z)))] ∈ ℝ
      by typecheck
    linarith
  have izBound := realLe.mul_right_cancel_positive with halfPositive,
    izBoundProduct
  -- The algebra of the error.
  have errorG : ℂ[g(z) - g(a) - E * (z - a)] ∈ ℂ by typecheck
  have inverses : ℂ[complexInv(g(z)) * complexInv(g(a))] ∈ ℂ by typecheck
  have tail : ℂ[complexInv(g(a)) * complexInv(g(a)) * complexInv(g(z))] ∈ ℂ
    by typecheck
  have linear : ℂ[E * (z - a)] ∈ ℂ by typecheck
  have term1 : ℂ[-((g(z) - g(a) - E * (z - a)) *
    (complexInv(g(z)) * complexInv(g(a))))] ∈ ℂ by typecheck
  have term1Inner : ℂ[(g(z) - g(a) - E * (z - a)) *
    (complexInv(g(z)) * complexInv(g(a)))] ∈ ℂ by typecheck
  have term2 : ℂ[(E * (z - a)) * ((complexInv(g(a)) * complexInv(g(a)) *
    complexInv(g(z))) * (g(z) - g(a)))] ∈ ℂ by typecheck
  have expanded : ℂ[-((g(z) - g(a) - E * (z - a)) *
      (complexInv(g(z)) * complexInv(g(a)))) + (E * (z - a)) *
      ((complexInv(g(a)) * complexInv(g(a)) * complexInv(g(z))) *
      (g(z) - g(a)))] =
      ℂ[-((g(z) * complexInv(g(z))) * complexInv(g(a))) +
        (g(a) * complexInv(g(a))) * complexInv(g(z)) +
        E * (z - a) * complexInv(g(z)) * complexInv(g(a)) +
        E * (z - a) * complexInv(g(a)) * complexInv(g(a)) *
          (g(z) * complexInv(g(z))) -
        E * (z - a) * complexInv(g(a)) * complexInv(g(z)) *
          (g(a) * complexInv(g(a)))] by ring
  rw [cancelZ, cancelA] at expanded
  have collapse : ℂ[-(1 * complexInv(g(a))) + 1 * complexInv(g(z)) +
      E * (z - a) * complexInv(g(z)) * complexInv(g(a)) +
      E * (z - a) * complexInv(g(a)) * complexInv(g(a)) * 1 -
      E * (z - a) * complexInv(g(a)) * complexInv(g(z)) * 1] =
      ℂ[1 * complexInv(g(z)) - 1 * complexInv(g(a)) -
        -(E * complexInv(g(a)) * complexInv(g(a))) * (z - a)] by ring
  rw [(formula with z, hz), (formula with a, ha), ← collapse, ← expanded]
  have triangle := complexAbs.triangle with term1, term2
  have factor : ℂ[(complexInv(g(a)) * complexInv(g(a)) * complexInv(g(z))) *
    (g(z) - g(a))] ∈ ℂ by typecheck
  have square : ℂ[complexInv(g(a)) * complexInv(g(a))] ∈ ℂ by typecheck
  rw [(complexAbs.neg with term1Inner), (complexAbs.mul with errorG, inverses),
    (complexAbs.mul with iz, ia), (complexAbs.mul with linear, factor),
    (complexAbs.mul with hE, step), (complexAbs.mul with tail, changeG),
    (complexAbs.mul with square, iz), (complexAbs.mul with ia, ia)]
    at triangle
  -- The first term.
  have errorGNonnegative := complexAbs.nonnegative with errorG
  have first1 := realLe.mul_right_of_nonnegative with izBound, iaNonnegative
  have first2 := realLe.mul_left_of_nonnegative with first1,
    errorGNonnegative
  have first3 := realLe.mul_right_of_nonnegative with boundG, K1Nonnegative
  have first4 := realLe.mul_right_of_nonnegative with absorbG,
    stepNonnegative
  have first5 : R[(εG * complexAbs(ℂ[z - a])) *
      ((2 * complexAbs(complexInv(g(a)))) * complexAbs(complexInv(g(a))))] =
      R[(((2 * complexAbs(complexInv(g(a)))) *
        complexAbs(complexInv(g(a)))) * εG) * complexAbs(ℂ[z - a])] by ring
  -- The second term.
  have squareProduct := realLe.mul_right_of_nonnegative with iaNonnegative,
    iaNonnegative
  have zeroSquare : R[0 * complexAbs(complexInv(g(a)))] = R[0] by ring
  have squareNonnegative : R[0] ≤ R[complexAbs(complexInv(g(a))) *
    complexAbs(complexInv(g(a)))] by linarith
  have changeNonnegative := complexAbs.nonnegative with changeG
  have changeLe : complexAbs(ℂ[g(z) - g(a)]) ≤ η by linarith
  have second1 := realLe.mul_left_of_nonnegative with izBound,
    squareNonnegative
  have second2 := realLe.mul_right_of_nonnegative with second1,
    changeNonnegative
  have twoIa : R[0] ≤ R[2 * complexAbs(complexInv(g(a)))] by linarith
  have scaleProduct := realLe.mul_right_of_nonnegative with squareNonnegative,
    twoIa
  have zeroScale : R[0 * (2 * complexAbs(complexInv(g(a))))] = R[0] by ring
  have scaleNonnegative : R[0] ≤ R[(complexAbs(complexInv(g(a))) *
    complexAbs(complexInv(g(a)))) * (2 * complexAbs(complexInv(g(a))))] by
    linarith
  have second3 := realLe.mul_left_of_nonnegative with changeLe,
    scaleNonnegative
  have EStepProduct := realLe.mul_right_of_nonnegative with ENonnegative,
    stepNonnegative
  have zeroEStep : R[0 * complexAbs(ℂ[z - a])] = R[0] by ring
  have EStep : R[0] ≤ R[complexAbs(E) * complexAbs(ℂ[z - a])] by linarith
  have chainReal1 : R[((complexAbs(complexInv(g(a))) *
    complexAbs(complexInv(g(a)))) * complexAbs(complexInv(g(z)))) *
    complexAbs(ℂ[g(z) - g(a)])] ∈ ℝ by typecheck
  have chainReal2 : R[((complexAbs(complexInv(g(a))) *
    complexAbs(complexInv(g(a)))) * (2 * complexAbs(complexInv(g(a))))) *
    complexAbs(ℂ[g(z) - g(a)])] ∈ ℝ by typecheck
  have chainReal3 : R[((complexAbs(complexInv(g(a))) *
    complexAbs(complexInv(g(a)))) * (2 * complexAbs(complexInv(g(a))))) *
    η] ∈ ℝ by typecheck
  have chain : R[((complexAbs(complexInv(g(a))) *
      complexAbs(complexInv(g(a)))) * complexAbs(complexInv(g(z)))) *
      complexAbs(ℂ[g(z) - g(a)])] ≤ R[((complexAbs(complexInv(g(a))) *
      complexAbs(complexInv(g(a)))) * (2 * complexAbs(complexInv(g(a))))) *
      η] by linarith
  have second4 := realLe.mul_left_of_nonnegative with chain, EStep
  have second5 := realLe.mul_right_of_nonnegative with absorbη,
    stepNonnegative
  have second6 : R[(complexAbs(E) * complexAbs(ℂ[z - a])) *
      (((complexAbs(complexInv(g(a))) * complexAbs(complexInv(g(a)))) *
      (2 * complexAbs(complexInv(g(a))))) * η)] =
      R[((complexAbs(E) * (complexAbs(complexInv(g(a))) *
      complexAbs(complexInv(g(a)))) * (2 * complexAbs(complexInv(g(a))))) *
      η) * complexAbs(ℂ[z - a])] by ring
  -- Together.
  have sum : R[half(e) * complexAbs(ℂ[z - a]) +
      half(e) * complexAbs(ℂ[z - a])] =
      R[(half(e) + half(e)) * complexAbs(ℂ[z - a])] by ring
  rw eTwice at sum
  have r1 : complexAbs(ℂ[g(z) - g(a) - E * (z - a)]) ∈ ℝ by typecheck
  have r2 : R[complexAbs(complexInv(g(z))) * complexAbs(complexInv(g(a)))] ∈ ℝ
    by typecheck
  have r3 : R[complexAbs(ℂ[g(z) - g(a) - E * (z - a)]) *
    (complexAbs(complexInv(g(z))) * complexAbs(complexInv(g(a))))] ∈ ℝ by
    typecheck
  have r4 : R[complexAbs(ℂ[g(z) - g(a) - E * (z - a)]) *
    ((2 * complexAbs(complexInv(g(a)))) * complexAbs(complexInv(g(a))))] ∈ ℝ
    by typecheck
  have r5 : R[(εG * complexAbs(ℂ[z - a])) *
    ((2 * complexAbs(complexInv(g(a)))) * complexAbs(complexInv(g(a))))] ∈ ℝ
    by typecheck
  have r6 : R[(((2 * complexAbs(complexInv(g(a)))) *
    complexAbs(complexInv(g(a)))) * εG) * complexAbs(ℂ[z - a])] ∈ ℝ by
    typecheck
  have r8 : R[(complexAbs(E) * complexAbs(ℂ[z - a])) *
    (((complexAbs(complexInv(g(a))) * complexAbs(complexInv(g(a)))) *
    complexAbs(complexInv(g(z)))) * complexAbs(ℂ[g(z) - g(a)]))] ∈ ℝ by
    typecheck
  have r9 : R[(complexAbs(E) * complexAbs(ℂ[z - a])) *
    (((complexAbs(complexInv(g(a))) * complexAbs(complexInv(g(a)))) *
    (2 * complexAbs(complexInv(g(a))))) * η)] ∈ ℝ by typecheck
  have r10 : R[((complexAbs(E) * (complexAbs(complexInv(g(a))) *
    complexAbs(complexInv(g(a)))) * (2 * complexAbs(complexInv(g(a))))) *
    η) * complexAbs(ℂ[z - a])] ∈ ℝ by typecheck
  linarith

theorem HasComplexDerivativeAt.div (f g U D E a : Set)
  requires derivativeF : HasComplexDerivativeAt(f, U, D, a)
  requires derivativeG : HasComplexDerivativeAt(g, U, E, a)
  requires nonvanishing : ∀ z ∈ U, g(z) ≠ ℂ[0]
  shows HasComplexDerivativeAt(complexFunctionDiv(f, g, U), U,
    complexDiv(ℂ[D * g(a) - f(a) * E], ℂ[g(a) * g(a)]), a)
proof
  have recip := HasComplexDerivativeAt.inv with derivativeG, nonvanishing
  have product := HasComplexDerivativeAt.mul with derivativeF, recip
  obtain ⟨isOpen, ha, hD, valuesF, _⟩ := derivativeF
  obtain ⟨_, _, hE, valuesG, _⟩ := derivativeG
  obtain ⟨_, _, _, valuesH, _⟩ := recip
  have one := complexOne.member
  have valuesOne : ComplexValuedOn(complexFunctionConst(ℂ[1], U), U)
    intros z hz
    rw (complexFunctionConst.value with one, hz)
    exact one
  have formula : ∀ z ∈ U,
      complexFunctionDiv(complexFunctionConst(ℂ[1], U), g, U)(z) =
      ℂ[1 * complexInv(g(z))]
    intros z hz
    rw [(complexFunctionDiv.value with valuesOne, valuesG, hz),
      (complexFunctionConst.value with one, hz)]
    unfold complexDiv
    rfl
  have agree : ∀ z ∈ U, complexFunctionMul(f,
      complexFunctionDiv(complexFunctionConst(ℂ[1], U), g, U), U)(z) =
      complexFunctionDiv(f, g, U)(z)
    intros z hz
    have fz := valuesF with z, hz
    have gz := valuesG with z, hz
    have iz := complexInv.member with gz
    rw [(complexFunctionMul.value with valuesF, valuesH, hz),
        (formula with z, hz),
      (complexFunctionDiv.value with valuesF, valuesG, hz)]
    unfold complexDiv
    ring
  have moved := HasComplexDerivativeAt.congr with product, agree
  have fa := valuesF with a, ha
  have ga := valuesG with a, ha
  have ia := complexInv.member with ga
  have gaNonzero := nonvanishing with a, ha
  have cancelA := complexInv.mul_cancel with ga, gaNonzero
  have value : ℂ[D * complexFunctionDiv(complexFunctionConst(ℂ[1], U), g,
      U)(a) + f(a) * -(E * complexInv(g(a)) * complexInv(g(a)))] =
      complexDiv(ℂ[D * g(a) - f(a) * E], ℂ[g(a) * g(a)])
    rw [(formula with a, ha)]
    unfold complexDiv
    rw (complexInv.mul with ga, ga)
    have expand : ℂ[(D * g(a) - f(a) * E) *
        (complexInv(g(a)) * complexInv(g(a)))] =
        ℂ[D * (g(a) * complexInv(g(a))) * complexInv(g(a)) -
          f(a) * E * complexInv(g(a)) * complexInv(g(a))] by ring
    rw [expand, cancelA]
    ring
  rw value at moved
  exact moved

-- The chain rule.
theorem HasComplexDerivativeAt.comp (f g U V D E a : Set)
  requires derivativeF : HasComplexDerivativeAt(f, U, D, a)
  requires derivativeG : HasComplexDerivativeAt(g, V, E, f(a))
  requires maps : ∀ z ∈ U, f(z) ∈ V
  shows HasComplexDerivativeAt(complexFunctionComp(g, f, U), U, ℂ[E * D], a)
proof
  obtain ⟨dL, hdL, positiveL, lipschitz⟩ :=
    HasComplexDerivativeAt.lipschitz with derivativeF
  have continuousF := HasComplexDerivativeAt.continuous with derivativeF
  obtain ⟨isOpen, ha, hD, valuesF, closeF⟩ := derivativeF
  obtain ⟨openV, hb, hE, valuesG, closeG⟩ := derivativeG
  have sub := ComplexOpen.subset with isOpen
  have subV := ComplexOpen.subset with openV
  have aMember := sub with a, ha
  have fa := valuesF with a, ha
  have gb := valuesG with f(a), hb
  have composed : ∀ z ∈ U, g(f(z)) ∈ complexCarrier
    intros z hz
    exact valuesG with f(z), (maps with z, hz)
  have slope : ℂ[E * D] ∈ ℂ by typecheck
  have values : ComplexValuedOn(complexFunctionComp(g, f, U), U)
    intros z hz
    rw (complexFunctionComp.value with composed, hz)
    exact composed with z, hz
  refine ⟨isOpen, ha, slope, values, ?_⟩
  intros e he positive
  have typedE : Real(e) by typecheck
  have halfPositive := half.positive with positive
  have halfReal : half(e) ∈ ℝ by typecheck
  have total := half.add_self at e
  have DNonnegative := complexAbs.nonnegative with hD
  have ENonnegative := complexAbs.nonnegative with hE
  have scaleReal : R[1 + complexAbs(D)] ∈ ℝ by typecheck
  have scaleNonnegative : R[0] ≤ R[1 + complexAbs(D)] by linarith
  have EReal : complexAbs(E) ∈ ℝ by typecheck
  obtain ⟨εG, hεG, εGPositive, absorbG, _⟩ := realScale.absorb with scaleReal,
    halfReal, scaleNonnegative, halfPositive
  obtain ⟨εF, hεF, εFPositive, absorbF, _⟩ := realScale.absorb with EReal,
    halfReal, ENonnegative, halfPositive
  obtain ⟨dG, hdG, positiveG, nearG⟩ := closeG with εG, hεG, εGPositive
  obtain ⟨dC, hdC, positiveC, nearC⟩ := continuousF with dG, hdG, positiveG
  obtain ⟨dF, hdF, positiveF, nearF⟩ := closeF with εF, hεF, εFPositive
  obtain ⟨d1, hd1, positive1, leL, leC⟩ := realRadius.common with hdL, hdC,
    positiveL, positiveC
  obtain ⟨d, hd, dPositive, le1, leF⟩ := realRadius.common with hd1, hdF,
    positive1, positiveF
  refine ⟨d, hd, dPositive, ?_⟩
  intros z hz small
  have zMember := sub with z, hz
  have fz := valuesF with z, hz
  have fzV := maps with z, hz
  have gfz := valuesG with f(z), fzV
  have step : ℂ[z - a] ∈ ℂ by typecheck
  have stepReal : complexAbs(ℂ[z - a]) ∈ ℝ by typecheck
  have stepNonnegative := complexAbs.nonnegative with step
  have smallL : complexAbs(ℂ[z - a]) < dL by linarith
  have smallC : complexAbs(ℂ[z - a]) < dC by linarith
  have smallF : complexAbs(ℂ[z - a]) < dF by linarith
  have moved := lipschitz with z, hz, smallL
  have close := nearC with z, hz, smallC
  have boundG := nearG with f(z), fzV, close
  have boundF := nearF with z, hz, smallF
  rw [(complexFunctionComp.value with composed, hz),
    (complexFunctionComp.value with composed, ha)]
  have errorG : ℂ[g(f(z)) - g(f(a)) - E * (f(z) - f(a))] ∈ ℂ by typecheck
  have errorF : ℂ[f(z) - f(a) - D * (z - a)] ∈ ℂ by typecheck
  have scaledF : ℂ[E * (f(z) - f(a) - D * (z - a))] ∈ ℂ by typecheck
  have split : ℂ[g(f(z)) - g(f(a)) - E * D * (z - a)] =
      ℂ[(g(f(z)) - g(f(a)) - E * (f(z) - f(a))) +
        E * (f(z) - f(a) - D * (z - a))] by ring
  rw split
  have triangle := complexAbs.triangle with errorG, scaledF
  rw (complexAbs.mul with hE, errorF) at triangle
  -- The first term.
  have εGNonnegative : R[0] ≤ εG by linarith
  have first1 := realLe.mul_left_of_nonnegative with moved, εGNonnegative
  have first2 := realLe.mul_right_of_nonnegative with absorbG, stepNonnegative
  have first3 : R[εG * ((1 + complexAbs(D)) * complexAbs(ℂ[z - a]))] =
      R[((1 + complexAbs(D)) * εG) * complexAbs(ℂ[z - a])] by ring
  -- The second term.
  have second1 := realLe.mul_left_of_nonnegative with boundF, ENonnegative
  have second2 := realLe.mul_right_of_nonnegative with absorbF,
    stepNonnegative
  have second3 : R[complexAbs(E) * (εF * complexAbs(ℂ[z - a]))] =
      R[(complexAbs(E) * εF) * complexAbs(ℂ[z - a])] by ring
  have sum : R[half(e) * complexAbs(ℂ[z - a]) +
      half(e) * complexAbs(ℂ[z - a])] =
      R[(half(e) + half(e)) * complexAbs(ℂ[z - a])] by ring
  rw total at sum
  have r1 : complexAbs(ℂ[g(f(z)) - g(f(a)) - E * (f(z) - f(a))]) ∈ ℝ by
    typecheck
  have r2 : R[εG * complexAbs(ℂ[f(z) - f(a)])] ∈ ℝ by typecheck
  have r3 : R[εG * ((1 + complexAbs(D)) * complexAbs(ℂ[z - a]))] ∈ ℝ by
    typecheck
  have r4 : R[((1 + complexAbs(D)) * εG) * complexAbs(ℂ[z - a])] ∈ ℝ by
    typecheck
  have r5 : R[half(e) * complexAbs(ℂ[z - a])] ∈ ℝ by typecheck
  have r6 : R[complexAbs(E) * complexAbs(ℂ[f(z) - f(a) - D * (z - a)])] ∈ ℝ
    by typecheck
  linarith

-- Section: Holomorphic functions
-- A derivative on an open neighbourhood inside U is a derivative on U.
theorem HasComplexDerivativeAt.of_local (f U V D a : Set)
  requires derivative : HasComplexDerivativeAt(f, V, D, a)
  requires isOpen : ComplexOpen(U)
  requires inside : V ⊆ U
  requires values : ComplexValuedOn(f, U)
  shows HasComplexDerivativeAt(f, U, D, a)
proof
  obtain ⟨openV, ha, hD, _, close⟩ := derivative
  have aU := inside with a, ha
  obtain ⟨r, hr, rPositive, disk⟩ := ComplexOpen.disk with openV, ha
  refine ⟨isOpen, aU, hD, values, ?_⟩
  intros e he positive
  obtain ⟨d1, hd1, positive1, near⟩ := close with e, he, positive
  obtain ⟨d, hd, dPositive, le1, leR⟩ := realRadius.common with hd1, hr,
    positive1, rPositive
  refine ⟨d, hd, dPositive, ?_⟩
  intros z hz small
  have sub := ComplexOpen.subset with isOpen
  have zMember := sub with z, hz
  have aMember := sub with a, aU
  have inDisk : z ∈ complexDisk(a, r)
    apply complexDisk.membership.backward
    refine ⟨zMember, ?_⟩
    linarith
  have zV := disk with z, inDisk
  have small1 : complexAbs(ℂ[z - a]) < d1 by linarith
  exact near with z, zV, small1

theorem HolomorphicOn.differentiable (f U a : Set)
  requires holomorphic : HolomorphicOn(f, U)
  requires ha : a ∈ U
  shows ComplexDifferentiableAt(f, U, a)
proof
  obtain ⟨_, _, differentiable⟩ := holomorphic
  exact differentiable with ha

theorem HolomorphicOn.continuous (f U : Set)
  requires holomorphic : HolomorphicOn(f, U)
  shows ComplexContinuousOn(f, U)
proof
  obtain ⟨isOpen, values, differentiable⟩ := holomorphic
  have sub := ComplexOpen.subset with isOpen
  refine ⟨sub, values, ?_⟩
  intros a ha
  obtain ⟨D, hD, derivative⟩ := differentiable with a, ha
  exact HasComplexDerivativeAt.continuous with derivative

theorem HolomorphicOn.mono (f U V : Set)
  requires holomorphic : HolomorphicOn(f, U)
  requires isOpen : ComplexOpen(V)
  requires inside : V ⊆ U
  shows HolomorphicOn(f, V)
proof
  obtain ⟨_, values, differentiable⟩ := holomorphic
  have restricted : ComplexValuedOn(f, V)
    intros z hz
    exact values with z, (inside with z, hz)
  refine ⟨isOpen, restricted, ?_⟩
  intros a ha
  obtain ⟨D, hD, derivative⟩ := differentiable with a, (inside with a, ha)
  exact ⟨D, hD, (HasComplexDerivativeAt.mono with derivative, isOpen, inside,
    ha)⟩

theorem HolomorphicOn.congr (f g U : Set)
  requires holomorphic : HolomorphicOn(f, U)
  requires agree : ∀ z ∈ U, f(z) = g(z)
  shows HolomorphicOn(g, U)
proof
  obtain ⟨isOpen, values, differentiable⟩ := holomorphic
  have valuesG : ComplexValuedOn(g, U)
    intros z hz
    rw ← (agree with z, hz)
    exact values with z, hz
  refine ⟨isOpen, valuesG, ?_⟩
  intros a ha
  obtain ⟨D, hD, derivative⟩ := differentiable with a, ha
  exact ⟨D, hD, (HasComplexDerivativeAt.congr with derivative, agree)⟩

-- Holomorphy is local: a function holomorphic near each point of U is
-- holomorphic on U.
theorem HolomorphicOn.of_local (f U : Set)
  requires isOpen : ComplexOpen(U)
  requires local : ∀ a ∈ U, ∃ V, ComplexOpen(V) ∧ a ∈ V ∧ V ⊆ U ∧
    HolomorphicOn(f, V)
  shows HolomorphicOn(f, U)
proof
  have values : ComplexValuedOn(f, U)
    intros z hz
    obtain ⟨V, _, zV, _, holomorphicV⟩ := local with z, hz
    obtain ⟨_, valuesV, _⟩ := holomorphicV
    exact valuesV with z, zV
  refine ⟨isOpen, values, ?_⟩
  intros a ha
  obtain ⟨V, _, aV, inside, holomorphicV⟩ := local with a, ha
  obtain ⟨_, _, differentiable⟩ := holomorphicV
  obtain ⟨D, hD, derivative⟩ := differentiable with a, aV
  exact ⟨D, hD, (HasComplexDerivativeAt.of_local with derivative, isOpen,
    inside, values)⟩

theorem HolomorphicOn.const (c U : Set)
  requires isOpen : ComplexOpen(U)
  requires hc : c ∈ ℂ
  shows HolomorphicOn(complexFunctionConst(c, U), U)
proof
  have values : ComplexValuedOn(complexFunctionConst(c, U), U)
    intros z hz
    rw (complexFunctionConst.value with hc, hz)
    exact hc
  refine ⟨isOpen, values, ?_⟩
  intros a ha
  exact ⟨ℂ[0], complexZero.member, (HasComplexDerivativeAt.const with isOpen,
    ha, hc)⟩

theorem HolomorphicOn.id (U : Set)
  requires isOpen : ComplexOpen(U)
  shows HolomorphicOn(complexFunctionId(U), U)
proof
  have sub := ComplexOpen.subset with isOpen
  have values : ComplexValuedOn(complexFunctionId(U), U)
    intros z hz
    rw (complexFunctionId.value with sub, hz)
    exact sub with z, hz
  refine ⟨isOpen, values, ?_⟩
  intros a ha
  exact ⟨ℂ[1], complexOne.member, (HasComplexDerivativeAt.id with isOpen,
    ha)⟩

theorem HolomorphicOn.add (f g U : Set)
  requires holomorphicF : HolomorphicOn(f, U)
  requires holomorphicG : HolomorphicOn(g, U)
  shows HolomorphicOn(complexFunctionAdd(f, g, U), U)
proof
  obtain ⟨isOpen, valuesF, differentiableF⟩ := holomorphicF
  obtain ⟨_, valuesG, differentiableG⟩ := holomorphicG
  have values : ComplexValuedOn(complexFunctionAdd(f, g, U), U)
    intros z hz
    rw (complexFunctionAdd.value with valuesF, valuesG, hz)
    exact complexFunctionAdd.closed with valuesF, valuesG, hz
  refine ⟨isOpen, values, ?_⟩
  intros a ha
  obtain ⟨D, hD, derivativeF⟩ := differentiableF with a, ha
  obtain ⟨E, hE, derivativeG⟩ := differentiableG with a, ha
  have sum : ℂ[D + E] ∈ ℂ by typecheck
  exact ⟨ℂ[D + E], sum, (HasComplexDerivativeAt.add with derivativeF,
    derivativeG)⟩

theorem HolomorphicOn.neg (f U : Set)
  requires holomorphicF : HolomorphicOn(f, U)
  shows HolomorphicOn(complexFunctionNeg(f, U), U)
proof
  obtain ⟨isOpen, valuesF, differentiableF⟩ := holomorphicF
  have values : ComplexValuedOn(complexFunctionNeg(f, U), U)
    intros z hz
    rw (complexFunctionNeg.value with valuesF, hz)
    exact complexFunctionNeg.closed with valuesF, hz
  refine ⟨isOpen, values, ?_⟩
  intros a ha
  obtain ⟨D, hD, derivativeF⟩ := differentiableF with a, ha
  have negD : ℂ[-D] ∈ ℂ by typecheck
  exact ⟨ℂ[-D], negD, (HasComplexDerivativeAt.neg with derivativeF)⟩

theorem HolomorphicOn.mul (f g U : Set)
  requires holomorphicF : HolomorphicOn(f, U)
  requires holomorphicG : HolomorphicOn(g, U)
  shows HolomorphicOn(complexFunctionMul(f, g, U), U)
proof
  obtain ⟨isOpen, valuesF, differentiableF⟩ := holomorphicF
  obtain ⟨_, valuesG, differentiableG⟩ := holomorphicG
  have values : ComplexValuedOn(complexFunctionMul(f, g, U), U)
    intros z hz
    rw (complexFunctionMul.value with valuesF, valuesG, hz)
    exact complexFunctionMul.closed with valuesF, valuesG, hz
  refine ⟨isOpen, values, ?_⟩
  intros a ha
  obtain ⟨D, hD, derivativeF⟩ := differentiableF with a, ha
  obtain ⟨E, hE, derivativeG⟩ := differentiableG with a, ha
  have fa := valuesF with a, ha
  have ga := valuesG with a, ha
  have slope : ℂ[D * g(a) + f(a) * E] ∈ ℂ by typecheck
  exact ⟨ℂ[D * g(a) + f(a) * E], slope, (HasComplexDerivativeAt.mul with
    derivativeF, derivativeG)⟩

theorem HolomorphicOn.div (f g U : Set)
  requires holomorphicF : HolomorphicOn(f, U)
  requires holomorphicG : HolomorphicOn(g, U)
  requires nonvanishing : ∀ z ∈ U, g(z) ≠ ℂ[0]
  shows HolomorphicOn(complexFunctionDiv(f, g, U), U)
proof
  obtain ⟨isOpen, valuesF, differentiableF⟩ := holomorphicF
  obtain ⟨_, valuesG, differentiableG⟩ := holomorphicG
  have values : ComplexValuedOn(complexFunctionDiv(f, g, U), U)
    intros z hz
    rw (complexFunctionDiv.value with valuesF, valuesG, hz)
    exact complexFunctionDiv.closed with valuesF, valuesG, hz
  refine ⟨isOpen, values, ?_⟩
  intros a ha
  obtain ⟨D, hD, derivativeF⟩ := differentiableF with a, ha
  obtain ⟨E, hE, derivativeG⟩ := differentiableG with a, ha
  have fa := valuesF with a, ha
  have ga := valuesG with a, ha
  have square : ℂ[g(a) * g(a)] ∈ ℂ by typecheck
  have inverse := complexInv.member with square
  have slope : complexDiv(ℂ[D * g(a) - f(a) * E], ℂ[g(a) * g(a)]) ∈ ℂ
    unfold complexDiv
    typecheck
  exact ⟨complexDiv(ℂ[D * g(a) - f(a) * E], ℂ[g(a) * g(a)]), slope,
    (HasComplexDerivativeAt.div with derivativeF, derivativeG, nonvanishing)⟩

theorem HolomorphicOn.comp (f g U V : Set)
  requires holomorphicF : HolomorphicOn(f, U)
  requires holomorphicG : HolomorphicOn(g, V)
  requires maps : ∀ z ∈ U, f(z) ∈ V
  shows HolomorphicOn(complexFunctionComp(g, f, U), U)
proof
  obtain ⟨isOpen, valuesF, differentiableF⟩ := holomorphicF
  obtain ⟨_, valuesG, differentiableG⟩ := holomorphicG
  have composed : ∀ z ∈ U, g(f(z)) ∈ complexCarrier
    intros z hz
    exact valuesG with f(z), (maps with z, hz)
  have values : ComplexValuedOn(complexFunctionComp(g, f, U), U)
    intros z hz
    rw (complexFunctionComp.value with composed, hz)
    exact composed with z, hz
  refine ⟨isOpen, values, ?_⟩
  intros a ha
  obtain ⟨D, hD, derivativeF⟩ := differentiableF with a, ha
  obtain ⟨E, hE, derivativeG⟩ := differentiableG with f(a), (maps with a, ha)
  have slope : ℂ[E * D] ∈ ℂ by typecheck
  exact ⟨ℂ[E * D], slope, (HasComplexDerivativeAt.comp with derivativeF,
    derivativeG, maps)⟩

-- A holomorphic function is the sum of its power series on every open
-- disk about a point inside its open set.
theorem HolomorphicOn.power_series (f U a r : Set)
  requires holomorphic : HolomorphicOn(f, U)
  requires ha : a ∈ U
  requires hr : r ∈ ℝ
  requires inside : complexDisk(a, r) ⊆ U
  shows ∃ c, PowerSeriesRadiusAtLeast(c, r) ∧
    (∀ z ∈ complexDisk(a, r), ComplexSumsTo(powerSeriesTerms(c, a, z), f(z)))
proof
  sorry

-- Section: Power series
-- Inside the radius of convergence the series converges absolutely.
theorem PowerSeriesRadiusAtLeast.absolutely_summable (c a r z : Set)
  requires radius : PowerSeriesRadiusAtLeast(c, r)
  requires ha : a ∈ ℂ
  requires hz : z ∈ complexDisk(a, r)
  shows ComplexAbsolutelySummable(powerSeriesTerms(c, a, z))
proof
  exact powerSeriesTerms.absolutely_summable with radius, ha, hz

-- Finitely many terms of a complex sequence are bounded.
theorem ComplexSequence.initial_bound (u : Set) (m : Nat)
  requires sequence : ComplexSequence(u)
  shows ∃ B ∈ ℝ, ∀ j ∈ m, complexAbs(u(j)) ≤ B
proof
  induction m
  | zero =>
    have zero : R[0] ∈ ℝ by typecheck
    refine ⟨R[0], zero, ?_⟩
    intros j hj
    exfalso
    rw nat.zero at hj
    simpa using hj
  | succ(i) using ih =>
    obtain ⟨B, hB, bound⟩ := ih
    have iNat : Nat(i) by typecheck
    have iMember : i ∈ ℕ by typecheck
    have ui := FunctionBetween.apply_closed with sequence, iMember
    have typedB : Real(B) by typecheck
    have upper := abs.upper at B
    have absNonnegative := abs.nonnegative at B
    have uiNonnegative := complexAbs.nonnegative with ui
    have sumReal : R[abs(B) + complexAbs(u(i))] ∈ ℝ by typecheck
    refine ⟨R[abs(B) + complexAbs(u(i))], sumReal, ?_⟩
    intros j hj
    have split := bootstrap.succ.membership.forward with hj
    cases split with below | same
    . have jNat := natural.member at i with below
      have jMember : j ∈ ℕ by typecheck
      have uj := FunctionBetween.apply_closed with sequence, jMember
      have earlier := bound with j, below
      linarith
    . rw same
      linarith

-- The terms of a convergent complex series are bounded.
theorem ComplexSummable.terms_bounded (u : Set)
  requires summable : ComplexSummable(u)
  shows ∃ B ∈ ℝ, ∀ n ∈ ℕ, complexAbs(u(n)) ≤ B
proof
  obtain ⟨S, hS, sums⟩ := summable
  obtain ⟨sequence, converges⟩ := sums
  have prefixes : ComplexSequence(complexPrefixSums(u)) by
    exact complexPrefixSums.function with sequence
  have form := (ComplexConvergesTo.iff_abs with prefixes, hS).forward with
    converges
  have one : R[1] ∈ ℝ by typecheck
  have onePositive : R[0] < R[1] by linarith
  obtain ⟨N, hN, tail⟩ := form with R[1], one, onePositive
  have NNat := nat.omega.backward at N with hN
  obtain ⟨B, hB, initial⟩ := ComplexSequence.initial_bound at u, N with
    sequence
  have typedB : Real(B) by typecheck
  have upper := abs.upper at B
  have sumReal : R[abs(B) + 2] ∈ ℝ by typecheck
  refine ⟨R[abs(B) + 2], sumReal, ?_⟩
  intros n hn
  have nNat := nat.omega.backward at n with hn
  have un := FunctionBetween.apply_closed with sequence, hn
  have unReal : complexAbs(u(n)) ∈ ℝ by typecheck
  have absNonnegative := abs.nonnegative at B
  have split := Less.or_LessEqual at n, N
  cases split with below | above
  . have member : n ∈ N := membership.of_Less with below
    have bound := initial with n, member
    linarith
  . have nextNat : Nat(succ(n)) by typecheck
    have next : succ(n) ∈ ℕ by typecheck
    have aboveNext : N ≤ succ(n) by arith
    have near := tail with n, hn, above
    have nearNext := tail with succ(n), next, aboveNext
    rw [(complexPrefixSums.value with hn, sequence)] at near
    rw [(complexPrefixSums.value with next, sequence)] at nearNext
    rw complexPartialSum.succ at nearNext
    have partial := complexPartialSum.member at u, n with sequence
    have first : ℂ[complexPartialSum(u, n) + u(n) - S] ∈ ℂ by typecheck
    have second : ℂ[complexPartialSum(u, n) - S] ∈ ℂ by typecheck
    have difference := complexAbs.sub_le with first, second
    have same : ℂ[(complexPartialSum(u, n) + u(n) - S) -
        (complexPartialSum(u, n) - S)] = u(n) by ring
    rw same at difference
    have r1 : complexAbs(ℂ[complexPartialSum(u, n) + u(n) - S]) ∈ ℝ by
      typecheck
    have r2 : complexAbs(ℂ[complexPartialSum(u, n) - S]) ∈ ℝ by typecheck
    linarith

-- If the series converges at some point w then the radius is at least
-- |w − a|.
theorem PowerSeriesRadiusAtLeast.of_summable (c a w : Set)
  requires coefficients : ComplexSequence(c)
  requires ha : a ∈ ℂ
  requires hw : w ∈ ℂ
  requires summable : ComplexSummable(powerSeriesTerms(c, a, w))
  shows PowerSeriesRadiusAtLeast(c, complexAbs(ℂ[w - a]))
proof
  obtain ⟨B, hB, bound⟩ := ComplexSummable.terms_bounded with summable
  have step : ℂ[w - a] ∈ ℂ by typecheck
  have tReal : complexAbs(ℂ[w - a]) ∈ ℝ by typecheck
  refine ⟨coefficients, tReal, ?_⟩
  intros ρ hρ nonnegative below
  refine ⟨B, hB, ?_⟩
  intros n hn
  have nNat := nat.omega.backward with hn
  have cn := FunctionBetween.apply_closed with coefficients, hn
  have power := complexPow.member with step
  have term := bound with n, hn
  rw [(powerSeriesTerms.value with coefficients, ha, hw, hn),
    (complexAbs.mul with cn, power), (complexAbs.pow at ℂ[w - a], n with step)]
    at term
  have le : ρ ≤ complexAbs(ℂ[w - a]) by linarith
  have powers := realPow.base_monotone with nonnegative, le
  unfold realPow at powers
  have cnNonnegative := complexAbs.nonnegative with cn
  have scaled := realLe.mul_left_of_nonnegative with powers, cnNonnegative
  linarith

theorem powerSeriesSum.sums (c a r z : Set)
  requires radius : PowerSeriesRadiusAtLeast(c, r)
  requires ha : a ∈ ℂ
  requires hz : z ∈ complexDisk(a, r)
  shows ComplexSumsTo(powerSeriesTerms(c, a, z), powerSeriesSum(c, a, r)(z))
proof
  have absolute := powerSeriesTerms.absolutely_summable with radius, ha, hz
  have summable := ComplexAbsolutelySummable.summable with absolute
  have selected := complexSeriesSum.selected with summable
  rw (powerSeriesSum.value with radius, ha, hz)
  exact selected.right

-- (n + 1) ρⁿ (σ − ρ) ≤ σⁿ⁺¹ − ρⁿ⁺¹ for 0 ≤ ρ ≤ σ.
theorem realPow.difference_lower (ρ σ : Real) (n : Nat)
  requires nonnegative : R[0] ≤ ρ
  requires le : (ρ:R) ≤ (σ:R)
  shows R[realNat(succ(n)) * ρ ^ n * (σ - ρ)] ≤ R[σ ^ succ(n) - ρ ^ succ(n)]
proof
  induction n
  | zero =>
    rw [monoidPow.succ, monoidPow.succ, monoidPow.zero, monoidPow.zero,
      realNat.succ, realNat.zero]
    have one : realAddValue(R[0], R[1]) = R[1] by ring
    rw one
    have same : R[1 * 1 * (σ - ρ)] = R[σ * 1 - ρ * 1] by ring
    rw same
    linarith
  | succ(k) using ih =>
    have powerNonnegative := realPow.nonnegative with nonnegative
    unfold realPow at powerNonnegative
    have natNonnegative : R[0] ≤ realNat(succ(k))
      have positive := realNat.positive_succ at k
      linarith
    have gap : R[0] ≤ R[σ - ρ] by linarith
    have σNonnegative : R[0] ≤ σ by linarith
    have first := realLe.mul_right_of_nonnegative with natNonnegative,
      powerNonnegative
    have zero1 : R[0 * ρ ^ k] = R[0] by ring
    have firstNonnegative : R[0] ≤ R[realNat(succ(k)) * ρ ^ k] by linarith
    have second := realLe.mul_right_of_nonnegative with firstNonnegative, gap
    have zero2 : R[0 * (σ - ρ)] = R[0] by ring
    have QNonnegative : R[0] ≤ R[realNat(succ(k)) * ρ ^ k * (σ - ρ)] by
      linarith
    have stepA := realLe.mul_left_of_nonnegative with ih, σNonnegative
    have stepB := realLe.mul_right_of_nonnegative with le, QNonnegative
    have powS : R[σ ^ succ(succ(k))] = R[σ * (σ * σ ^ k)] by
      rw [monoidPow.succ, monoidPow.succ]
    have powR : R[ρ ^ succ(succ(k))] = R[ρ * (ρ * ρ ^ k)] by
      rw [monoidPow.succ, monoidPow.succ]
    have powR1 : R[ρ ^ succ(k)] = R[ρ * ρ ^ k] by rw monoidPow.succ
    have nat : realNat(succ(succ(k))) = R[realNat(succ(k)) + 1]
      rw (realNat.succ at succ(k))
      ring
    have powS1 : R[σ ^ succ(k)] = R[σ * σ ^ k] by rw monoidPow.succ
    rw [powS1, powR1] at stepA
    rw [powS, powR, powR1, nat]
    have target : R[(realNat(succ(k)) + 1) * (ρ * ρ ^ k) * (σ - ρ)] =
        R[ρ * (realNat(succ(k)) * ρ ^ k * (σ - ρ)) + ρ * ρ ^ k * (σ - ρ)] by
      ring
    have rhs : R[σ * (σ * σ ^ k) - ρ * (ρ * ρ ^ k)] =
        R[σ * (σ * σ ^ k - ρ * ρ ^ k) + ρ * ρ ^ k * (σ - ρ)] by ring
    rw [target, rhs]
    linarith

-- The second-order remainder of x^(n+1) about y:
-- P = x^(n+1) − y^(n+1) − (n + 1) yⁿ (x − y) satisfies
-- ρ |P| ≤ n (n + 1) ρⁿ |x − y|² when |x|, |y| ≤ ρ.
theorem complexPow.remainder_bound (x y ρ : Set) (n : Nat)
  requires hx : x ∈ ℂ
  requires hy : y ∈ ℂ
  requires hρ : ρ ∈ ℝ
  requires boundX : complexAbs(x) ≤ ρ
  requires boundY : complexAbs(y) ≤ ρ
  shows R[ρ * complexAbs(ℂ[x ^ succ(n) - y ^ succ(n) -
      complexOfReal(realNat(succ(n))) * y ^ n * (x - y)])] ≤
    R[realNat(n) * realNat(succ(n)) * ρ ^ n *
      (complexAbs(ℂ[x - y]) * complexAbs(ℂ[x - y]))]
proof
  have xNonnegative := complexAbs.nonnegative with hx
  have yNonnegative := complexAbs.nonnegative with hy
  have ρNonnegative : R[0] ≤ ρ by linarith
  have step : ℂ[x - y] ∈ ℂ by typecheck
  have δNonnegative := complexAbs.nonnegative with step
  have δδ := realLe.mul_right_of_nonnegative with δNonnegative, δNonnegative
  have zeroδ : R[0 * complexAbs(ℂ[x - y])] = R[0] by ring
  have δδNonnegative : R[0] ≤ R[complexAbs(ℂ[x - y]) *
    complexAbs(ℂ[x - y])] by linarith
  induction n
  | zero =>
    have one : complexOfReal(realNat(succ(0))) = ℂ[1]
      rw [realNat.succ, realNat.zero]
      have same : realAddValue(R[0], R[1]) = R[1] by ring
      rw [same, complexOfReal.one]
    rw [one, monoidPow.succ, monoidPow.succ, monoidPow.zero, monoidPow.zero,
      monoidPow.zero, realNat.zero]
    have collapse : ℂ[x * 1 - y * 1 - 1 * 1 * (x - y)] = ℂ[0] by ring
    rw [collapse, complexAbs.zero]
    have left : R[ρ * 0] = R[0] by ring
    have right : R[0 * realNat(succ((0:N))) * 1 *
      (complexAbs(ℂ[x - y]) * complexAbs(ℂ[x - y]))] = R[0] by ring
    rw [left, right]
    linarith
  | succ(k) using ih =>
    have N1Positive := realNat.positive_succ at k
    have N1Member : complexOfReal(realNat(succ(k))) ∈ ℂ by typecheck
    have NkNonnegative := realNat.nonnegative at k
    have xk := complexPow.member with hx
    have yk := complexPow.member with hy
    have N2 : complexOfReal(realNat(succ(succ(k)))) =
        ℂ[complexOfReal(realNat(succ(k))) + 1]
      rw [(realNat.succ at succ(k))]
      have same : realAddValue(realNat(succ(k)), R[1]) =
        R[realNat(succ(k)) + 1] by ring
      rw [same, (complexOfReal.add at realNat(succ(k)), R[1]),
        complexOfReal.one]
    have N2Real : R[realNat(succ(k)) + 1] = realNat(succ(succ(k)))
      rw (realNat.succ at succ(k))
      ring
    -- P_{k+1} = x P_k + (k + 1) yᵏ (x − y)².
    have previous : ℂ[x ^ succ(k) - y ^ succ(k) -
      complexOfReal(realNat(succ(k))) * y ^ k * (x - y)] ∈ ℂ by typecheck
    have correction : ℂ[complexOfReal(realNat(succ(k))) * y ^ k *
      (x - y) * (x - y)] ∈ ℂ by typecheck
    have scaledPrevious : ℂ[x * (x ^ succ(k) - y ^ succ(k) -
      complexOfReal(realNat(succ(k))) * y ^ k * (x - y))] ∈ ℂ by typecheck
    have identity : ℂ[x ^ succ(succ(k)) - y ^ succ(succ(k)) -
        complexOfReal(realNat(succ(succ(k)))) * y ^ succ(k) * (x - y)] =
        ℂ[x * (x ^ succ(k) - y ^ succ(k) -
        complexOfReal(realNat(succ(k))) * y ^ k * (x - y)) +
        complexOfReal(realNat(succ(k))) * y ^ k * (x - y) * (x - y)]
      rw [N2, monoidPow.succ, monoidPow.succ, monoidPow.succ, monoidPow.succ]
      ring
    rw identity
    have triangle := complexAbs.triangle with scaledPrevious, correction
    have yxy : ℂ[complexOfReal(realNat(succ(k))) * y ^ k * (x - y)] ∈ ℂ by
      typecheck
    have Ny : ℂ[complexOfReal(realNat(succ(k))) * y ^ k] ∈ ℂ by typecheck
    rw [(complexAbs.mul with hx, previous), (complexAbs.mul with yxy, step),
      (complexAbs.mul with Ny, step), (complexAbs.mul with N1Member, yk),
      (complexAbs.of_real at realNat(succ(k))),
      (abs.of_nonnegative at realNat(succ(k)) with
        (realLess.implies_le with N1Positive)),
      (complexAbs.pow at y, k with hy)] at triangle
    have powSucc : R[ρ ^ succ(k)] = R[ρ * ρ ^ k] by rw monoidPow.succ
    rw powSucc
    have PReal : complexAbs(ℂ[x ^ succ(k) - y ^ succ(k) -
        complexOfReal(realNat(succ(k))) * y ^ k * (x - y)]) ∈ ℝ by typecheck
    have PNonnegative := complexAbs.nonnegative with previous
    have ρkNonnegative := realPow.nonnegative with ρNonnegative
    unfold realPow at ρkNonnegative
    have YLe := realPow.base_monotone with yNonnegative, boundY
    unfold realPow at YLe
    have YNonnegative := realPow.nonnegative with yNonnegative
    have N1Nonnegative : R[0] ≤ realNat(succ(k)) by linarith
    -- Nonnegativity of the inductive bound.
    have m1 := realLe.mul_right_of_nonnegative with NkNonnegative,
      N1Nonnegative
    have z1 : R[0 * realNat(succ(k))] = R[0] by ring
    have n1 : R[0] ≤ R[realNat(k) * realNat(succ(k))] by linarith
    have m2 := realLe.mul_right_of_nonnegative with n1, ρkNonnegative
    have z2 : R[0 * ρ ^ k] = R[0] by ring
    have n2 : R[0] ≤ R[realNat(k) * realNat(succ(k)) * ρ ^ k] by linarith
    have m3 := realLe.mul_right_of_nonnegative with n2, δδNonnegative
    have z3 : R[0 * (complexAbs(ℂ[x - y]) * complexAbs(ℂ[x - y]))] = R[0] by
        ring
    have IHNonnegative : R[0] ≤ R[realNat(k) * realNat(succ(k)) * ρ ^ k *
      (complexAbs(ℂ[x - y]) * complexAbs(ℂ[x - y]))] by linarith
    -- The estimates.
    have s1 := realLe.mul_left_of_nonnegative with triangle, ρNonnegative
    have s2 := realLe.mul_left_of_nonnegative with ih, xNonnegative
    have s3 := realLe.mul_right_of_nonnegative with boundX, IHNonnegative
    have s4 := realLe.mul_left_of_nonnegative with YLe, N1Nonnegative
    have s5 := realLe.mul_right_of_nonnegative with s4, δδNonnegative
    have s6 := realLe.mul_left_of_nonnegative with s5, ρNonnegative
    have e1 : R[ρ * (complexAbs(x) *
        complexAbs(ℂ[x ^ succ(k) - y ^ succ(k) -
        complexOfReal(realNat(succ(k))) * y ^ k * (x - y)]) +
        realNat(succ(k)) * complexAbs(y) ^ k * complexAbs(ℂ[x - y]) *
            complexAbs(ℂ[x - y]))] =
        R[complexAbs(x) *
            (ρ * complexAbs(ℂ[x ^ succ(k) - y ^ succ(k) -
            complexOfReal(realNat(succ(k))) * y ^ k * (x - y)])) +
        ρ * (realNat(succ(k)) * complexAbs(y) ^ k *
            (complexAbs(ℂ[x - y]) * complexAbs(ℂ[x - y])))] by ring
    have e2 : R[ρ * (realNat(k) * realNat(succ(k)) * ρ ^ k *
        (complexAbs(ℂ[x - y]) * complexAbs(ℂ[x - y]))) + ρ *
            (realNat(succ(k)) * ρ ^ k *
            (complexAbs(ℂ[x - y]) * complexAbs(ℂ[x - y])))] =
        R[realNat(succ(k)) * realNat(succ(k)) * (ρ * ρ ^ k) *
            (complexAbs(ℂ[x - y]) * complexAbs(ℂ[x - y]))]
      have N1eq : realNat(succ(k)) = R[realNat(k) + 1]
        rw (realNat.succ at k)
        ring
      rw N1eq
      ring
    have N2Above : realNat(succ(k)) ≤ realNat(succ(succ(k))) by linarith
    have e3 := realLe.mul_left_of_nonnegative with N2Above, N1Nonnegative
    have ρρk := realLe.mul_left_of_nonnegative with ρkNonnegative,
      ρNonnegative
    have z4 : R[ρ * 0] = R[0] by ring
    have ZNonnegative : R[0] ≤
        R[(ρ * ρ ^ k) * (complexAbs(ℂ[x - y]) * complexAbs(ℂ[x - y]))]
      have productNonnegative : R[0] ≤ R[ρ * ρ ^ k] by linarith
      have m4 := realLe.mul_right_of_nonnegative with productNonnegative,
        δδNonnegative
      have z5 : R[0 * (complexAbs(ℂ[x - y]) * complexAbs(ℂ[x - y]))] = R[0] by
          ring
      linarith
    have e4 := realLe.mul_right_of_nonnegative with e3, ZNonnegative
    have e5 : R[realNat(succ(k)) * realNat(succ(k)) * ((ρ * ρ ^ k) *
        (complexAbs(ℂ[x - y]) * complexAbs(ℂ[x - y])))] =
            R[realNat(succ(k)) * realNat(succ(k)) *
        (ρ * ρ ^ k) * (complexAbs(ℂ[x - y]) * complexAbs(ℂ[x - y]))] by ring
    have e6 : R[realNat(succ(k)) * realNat(succ(succ(k))) * ((ρ * ρ ^ k) *
        (complexAbs(ℂ[x - y]) * complexAbs(ℂ[x - y])))] =
            R[realNat(succ(k)) * realNat(succ(succ(k))) *
        (ρ * ρ ^ k) * (complexAbs(ℂ[x - y]) * complexAbs(ℂ[x - y]))] by ring
    have r1 : R[complexAbs(x) *
        (ρ * complexAbs(ℂ[x ^ succ(k) - y ^ succ(k) -
        complexOfReal(realNat(succ(k))) * y ^ k * (x - y)]))] ∈ ℝ by typecheck
    have r2 : R[ρ * (realNat(succ(k)) * complexAbs(y) ^ k *
      (complexAbs(ℂ[x - y]) * complexAbs(ℂ[x - y])))] ∈ ℝ by typecheck
    have r3 : R[complexAbs(x) * (realNat(k) * realNat(succ(k)) * ρ ^ k *
      (complexAbs(ℂ[x - y]) * complexAbs(ℂ[x - y])))] ∈ ℝ by typecheck
    have r4 : R[ρ * (realNat(k) * realNat(succ(k)) * ρ ^ k *
      (complexAbs(ℂ[x - y]) * complexAbs(ℂ[x - y])))] ∈ ℝ by typecheck
    have r5 : R[ρ * (realNat(succ(k)) * ρ ^ k *
        (complexAbs(ℂ[x - y]) * complexAbs(ℂ[x - y])))] ∈ ℝ by
      typecheck
    have r6 : R[ρ * complexAbs(ℂ[x * (x ^ succ(k) - y ^ succ(k) -
      complexOfReal(realNat(succ(k))) * y ^ k * (x - y)) +
      complexOfReal(realNat(succ(k))) * y ^ k * (x - y) * (x - y)])] ∈ ℝ by
      typecheck
    have r7 : R[ρ * (complexAbs(x) *
        complexAbs(ℂ[x ^ succ(k) - y ^ succ(k) -
        complexOfReal(realNat(succ(k))) * y ^ k * (x - y)]) +
      realNat(succ(k)) * complexAbs(y) ^ k * complexAbs(ℂ[x - y]) *
          complexAbs(ℂ[x - y]))] ∈ ℝ by typecheck
    have r8 : R[realNat(succ(k)) * realNat(succ(succ(k))) * (ρ * ρ ^ k) *
      (complexAbs(ℂ[x - y]) * complexAbs(ℂ[x - y]))] ∈ ℝ by typecheck
    linarith

-- The terms c_(n+1) P_n of the remainder of a power series between z and
-- w, with P_n the second-order remainder of x^(n+1) about y for x = w − a,
-- y = z − a.
defgraph powerSeriesRemainder (c a w z : Set) (n ∈ ℕ) : complexCarrier :=
    ℂ[c(succ(n)) * ((w - a) ^ succ(n) - (z - a) ^ succ(n) -
      complexOfReal(realNat(succ(n))) * (z - a) ^ n * ((w - a) - (z - a)))]
requires coefficients : ComplexSequence(c)
requires ha : a ∈ complexCarrier
requires hw : w ∈ complexCarrier
requires hz : z ∈ complexCarrier
proof
  have nNat := nat.omega.backward with member
  have next : succ(n) ∈ ℕ by typecheck
  have cNext := FunctionBetween.apply_closed with coefficients, next
  have x : ℂ[w - a] ∈ ℂ by typecheck
  have y : ℂ[z - a] ∈ ℂ by typecheck
  have xPower := complexPow.member with x
  have yPower := complexPow.member with y
  have yPrevious := complexPow.member with y
  typecheck

-- ρ (σ − ρ) |c_(n+1) P_n| ≤ |w − z|² σ |c′_n| σⁿ when |w − a|, |z − a| ≤ ρ ≤ σ.
theorem powerSeriesRemainder.bound (c a w z ρ σ : Set) (n : Nat)
  requires coefficients : ComplexSequence(c)
  requires ha : a ∈ ℂ
  requires hw : w ∈ ℂ
  requires hz : z ∈ ℂ
  requires hρ : ρ ∈ ℝ
  requires hσ : σ ∈ ℝ
  requires boundW : complexAbs(ℂ[w - a]) ≤ ρ
  requires boundZ : complexAbs(ℂ[z - a]) ≤ ρ
  requires le : (ρ:R) ≤ (σ:R)
  shows R[ρ * (σ - ρ) * complexAbs(powerSeriesRemainder(c, a, w, z)(n))] ≤
    R[(complexAbs(ℂ[w - z]) * complexAbs(ℂ[w - z])) * σ *
      (complexAbs(powerSeriesDerivCoefficients(c)(n)) * σ ^ n)]
proof
  have nIn : n ∈ ℕ by typecheck
  have next : succ(n) ∈ ℕ by typecheck
  have cNext := FunctionBetween.apply_closed with coefficients, next
  have x : ℂ[w - a] ∈ ℂ by typecheck
  have y : ℂ[z - a] ∈ ℂ by typecheck
  have remainder :
      ℂ[(w - a) ^ succ(n) - (z - a) ^ succ(n) - complexOfReal(realNat(succ(n)))
      * (z - a) ^ n * ((w - a) - (z - a))] ∈ ℂ
    have xPower := complexPow.member with x
    have yPower := complexPow.member with y
    have yPrevious := complexPow.member with y
    have natMember : complexOfReal(realNat(succ(n))) ∈ ℂ by typecheck
    typecheck
  rw [(powerSeriesRemainder.value with coefficients, ha, hw, hz, nIn),
    (complexAbs.mul with cNext, remainder),
    (powerSeriesDerivCoefficients.value with coefficients, nIn)]
  have natPositive := realNat.positive_succ at n
  have natNonnegative : R[0] ≤ realNat(succ(n)) by linarith
  have natMember : complexOfReal(realNat(succ(n))) ∈ ℂ by typecheck
  rw [(complexAbs.mul with natMember, cNext),
    (complexAbs.of_real at realNat(succ(n))),
    (abs.of_nonnegative at realNat(succ(n)) with natNonnegative)]
  have rb := complexPow.remainder_bound with x, y, hρ, boundW, boundZ
  have step : ℂ[(w - a) - (z - a)] = ℂ[w - z] by ring
  rw step at rb
  rw step
  have ρNonnegative : R[0] ≤ ρ
    have nonnegative := complexAbs.nonnegative with x
    linarith
  have cNonnegative := complexAbs.nonnegative with cNext
  have gap : R[0] ≤ R[σ - ρ] by linarith
  have wz : ℂ[w - z] ∈ ℂ by typecheck
  have δNonnegative := complexAbs.nonnegative with wz
  have δδ := realLe.mul_right_of_nonnegative with δNonnegative, δNonnegative
  have zeroδ : R[0 * complexAbs(ℂ[w - z])] = R[0] by ring
  have δδNonnegative : R[0] ≤ R[complexAbs(ℂ[w - z]) * complexAbs(ℂ[w - z])] by
      linarith
  have NkNonnegative := realNat.nonnegative at n
  have NkLe : realNat(n) ≤ realNat(succ(n))
    have succValue : realNat(succ(n)) = R[realNat(n) + 1]
      rw realNat.succ
      ring
    rw succValue
    linarith
  have ρnNonnegative := realPow.nonnegative with ρNonnegative
  unfold realPow at ρnNonnegative
  have ρn1Nonnegative := realPow.nonnegative at ρ, succ(n) with ρNonnegative
  unfold realPow at ρn1Nonnegative
  -- Nonnegative factors.
  have f1 := realLe.mul_right_of_nonnegative with cNonnegative, gap
  have z1 : R[0 * (σ - ρ)] = R[0] by ring
  have F1 : R[0] ≤ R[complexAbs(c(succ(n))) * (σ - ρ)] by linarith
  have f2 := realLe.mul_right_of_nonnegative with cNonnegative, natNonnegative
  have z2 : R[0 * realNat(succ(n))] = R[0] by ring
  have F2a : R[0] ≤ R[complexAbs(c(succ(n))) * realNat(succ(n))] by linarith
  have f3 := realLe.mul_right_of_nonnegative with F2a, δδNonnegative
  have z3 : R[0 * (complexAbs(ℂ[w - z]) * complexAbs(ℂ[w - z]))] = R[0] by ring
  have F2 : R[0] ≤
      R[complexAbs(c(succ(n))) * realNat(succ(n)) *
      (complexAbs(ℂ[w - z]) * complexAbs(ℂ[w - z]))] by linarith
  have f4 := realLe.mul_right_of_nonnegative with natNonnegative,
    ρnNonnegative
  have z4 : R[0 * ρ ^ n] = R[0] by ring
  have X1 : R[0] ≤ R[realNat(succ(n)) * ρ ^ n] by linarith
  have f5 := realLe.mul_right_of_nonnegative with X1, δδNonnegative
  have z5 : R[0 * (realNat(succ(n)) * ρ ^ n) *
      (complexAbs(ℂ[w - z]) * complexAbs(ℂ[w - z]))] = R[0] by ring
  have X : R[0] ≤ R[realNat(succ(n)) * ρ ^ n *
      (complexAbs(ℂ[w - z]) * complexAbs(ℂ[w - z]))] by linarith
  -- The chain.
  have b1 := realLe.mul_right_of_nonnegative with NkLe, X
  have c1 := realLe.mul_left_of_nonnegative with rb, F1
  have regroupB : R[complexAbs(c(succ(n))) * (σ - ρ) *
      (realNat(n) * realNat(succ(n)) * ρ ^ n *
      (complexAbs(ℂ[w - z]) * complexAbs(ℂ[w - z])))] =
          R[(complexAbs(c(succ(n))) * (σ - ρ)) * (realNat(n) *
      (realNat(succ(n)) * ρ ^ n *
          (complexAbs(ℂ[w - z]) * complexAbs(ℂ[w - z]))))] by ring
  have c2 := realLe.mul_left_of_nonnegative with b1, F1
  have dl := realPow.difference_lower with ρNonnegative, le
  have σPower : R[σ ^ succ(n)] = R[σ * σ ^ n] by rw monoidPow.succ
  rw σPower at dl
  have dl2 : R[realNat(succ(n)) * ρ ^ n * (σ - ρ)] ≤ R[σ * σ ^ n] by linarith
  have c3 := realLe.mul_left_of_nonnegative with dl2, F2
  have e1 : R[ρ * (σ - ρ) *
      (complexAbs(c(succ(n))) *
      complexAbs(ℂ[(w - a) ^ succ(n) - (z - a) ^ succ(n) -
      complexOfReal(realNat(succ(n))) * (z - a) ^ n * (w - z)]))] =
      R[(complexAbs(c(succ(n))) * (σ - ρ)) *
          (ρ * complexAbs(ℂ[(w - a) ^ succ(n) - (z - a) ^ succ(n) -
          complexOfReal(realNat(succ(n))) * (z - a) ^ n * (w - z)]))] by ring
  have e2 : R[(complexAbs(c(succ(n))) * (σ - ρ)) * (realNat(succ(n)) *
      (realNat(succ(n)) * ρ ^ n *
          (complexAbs(ℂ[w - z]) * complexAbs(ℂ[w - z]))))] =
      R[(complexAbs(c(succ(n))) * realNat(succ(n)) *
          (complexAbs(ℂ[w - z]) * complexAbs(ℂ[w - z]))) *
      (realNat(succ(n)) * ρ ^ n * (σ - ρ))] by ring
  have e3 : R[(complexAbs(c(succ(n))) * realNat(succ(n)) *
      (complexAbs(ℂ[w - z]) * complexAbs(ℂ[w - z]))) * (σ * σ ^ n)] =
      R[(complexAbs(ℂ[w - z]) * complexAbs(ℂ[w - z])) * σ *
          (realNat(succ(n)) * complexAbs(c(succ(n))) * σ ^ n)] by ring
  have r1 : R[(complexAbs(c(succ(n))) * (σ - ρ)) *
      (ρ * complexAbs(ℂ[(w - a) ^ succ(n) - (z - a) ^ succ(n) -
      complexOfReal(realNat(succ(n))) * (z - a) ^ n * (w - z)]))] ∈ ℝ by
      typecheck
  have r2 : R[(complexAbs(c(succ(n))) * (σ - ρ)) *
      (realNat(n) * realNat(succ(n)) * ρ ^ n *
    (complexAbs(ℂ[w - z]) * complexAbs(ℂ[w - z])))] ∈ ℝ by typecheck
  have r3 : R[(complexAbs(c(succ(n))) * (σ - ρ)) *
      (realNat(n) * (realNat(succ(n)) * ρ ^ n *
    (complexAbs(ℂ[w - z]) * complexAbs(ℂ[w - z]))))] ∈ ℝ by typecheck
  have r4 : R[(complexAbs(c(succ(n))) * (σ - ρ)) *
      (realNat(succ(n)) * (realNat(succ(n)) *
    ρ ^ n * (complexAbs(ℂ[w - z]) * complexAbs(ℂ[w - z]))))] ∈ ℝ by typecheck
  have r5 : R[(complexAbs(c(succ(n))) * realNat(succ(n)) *
      (complexAbs(ℂ[w - z]) * complexAbs(ℂ[w - z]))) * (realNat(succ(n)) *
    ρ ^ n * (σ - ρ))] ∈ ℝ by typecheck
  have r6 : R[(complexAbs(c(succ(n))) * realNat(succ(n)) *
      (complexAbs(ℂ[w - z]) * complexAbs(ℂ[w - z]))) * (σ * σ ^ n)] ∈ ℝ by
    typecheck
  have r7 : R[ρ * (σ - ρ) *
      (complexAbs(c(succ(n))) *
      complexAbs(ℂ[(w - a) ^ succ(n) - (z - a) ^ succ(n) -
      complexOfReal(realNat(succ(n))) * (z - a) ^ n * (w - z)]))] ∈ ℝ by
      typecheck
  have r8 : R[(complexAbs(ℂ[w - z]) * complexAbs(ℂ[w - z])) * σ *
      (realNat(succ(n)) * complexAbs(c(succ(n))) * σ ^ n)] ∈ ℝ by
    typecheck
  have r9 : R[complexAbs(c(succ(n))) * (σ - ρ) *
      (realNat(n) * realNat(succ(n)) * ρ ^ n *
    (complexAbs(ℂ[w - z]) * complexAbs(ℂ[w - z])))] ∈ ℝ by typecheck
  linarith

-- The termwise-derivative coefficients keep the radius.
theorem powerSeriesDerivCoefficients.radius_at_least (c r : Set)
  requires radius : PowerSeriesRadiusAtLeast(c, r)
  shows PowerSeriesRadiusAtLeast(powerSeriesDerivCoefficients(c), r)
proof
  obtain ⟨coefficients, hr, bounded⟩ := radius
  have derived : ComplexSequence(powerSeriesDerivCoefficients(c)) by
    exact powerSeriesDerivCoefficients.function with coefficients
  refine ⟨derived, hr, ?_⟩
  intros ρ hρ nonnegative below
  have halfSum := half.add_self at R[ρ + r]
  have σReal : half(R[ρ + r]) ∈ ℝ by typecheck
  have above : ρ < half(R[ρ + r]) by linarith
  have belowR : half(R[ρ + r]) < r by linarith
  have σNonnegative : R[0] ≤ half(R[ρ + r]) by linarith
  have le : ρ ≤ half(R[ρ + r]) by linarith
  obtain ⟨B, hB, bound⟩ := bounded with half(R[ρ + r]), σReal, σNonnegative,
    belowR
  have gapPositive : R[0] < R[half(R[ρ + r]) - ρ] by linarith
  have gapNonzero : R[half(R[ρ + r]) - ρ] ≠ R[0] by linarith
  have cancel := realDiv.mul_right at B, R[half(R[ρ + r]) - ρ] with gapNonzero
  have boundReal : R[B / (half(R[ρ + r]) - ρ)] ∈ ℝ by typecheck
  refine ⟨R[B / (half(R[ρ + r]) - ρ)], boundReal, ?_⟩
  intros n hn
  have nNat := nat.omega.backward with hn
  have next : succ(n) ∈ ℕ by typecheck
  have cNext := FunctionBetween.apply_closed with coefficients, next
  have natPositive := realNat.positive_succ at n
  have natNonnegative : R[0] ≤ realNat(succ(n)) by linarith
  have natMember : complexOfReal(realNat(succ(n))) ∈ ℂ by typecheck
  rw [(powerSeriesDerivCoefficients.value with coefficients, hn),
    (complexAbs.mul with natMember, cNext),
    (complexAbs.of_real at realNat(succ(n))),
    (abs.of_nonnegative at realNat(succ(n)) with natNonnegative)]
  have difference := realPow.difference_lower with nonnegative, le
  have cNonnegative := complexAbs.nonnegative with cNext
  have scaled := realLe.mul_left_of_nonnegative with difference, cNonnegative
  have termBound := bound with succ(n), next
  have lowerPower := realPow.nonnegative at ρ, succ(n) with nonnegative
  unfold realPow at lowerPower
  have lowerTerm := realLe.mul_left_of_nonnegative with lowerPower,
    cNonnegative
  have zeroTimes : R[complexAbs(c(succ(n))) * 0] = R[0] by ring
  have product : R[(realNat(succ(n)) * complexAbs(c(succ(n))) * ρ ^ n) *
      (half(R[ρ + r]) - ρ)] ≤ R[(B / (half(R[ρ + r]) - ρ)) *
      (half(R[ρ + r]) - ρ)]
    rw cancel
    have regroup : R[(realNat(succ(n)) * complexAbs(c(succ(n))) * ρ ^ n) *
        (half(R[ρ + r]) - ρ)] = R[complexAbs(c(succ(n))) *
        (realNat(succ(n)) * ρ ^ n * (half(R[ρ + r]) - ρ))] by ring
    have expand : R[complexAbs(c(succ(n))) * (half(R[ρ + r]) ^ succ(n) -
        ρ ^ succ(n))] = R[complexAbs(c(succ(n))) * half(R[ρ + r]) ^ succ(n) -
        complexAbs(c(succ(n))) * ρ ^ succ(n)] by ring
    rw regroup
    have r1 : R[complexAbs(c(succ(n))) * (realNat(succ(n)) * ρ ^ n *
      (half(R[ρ + r]) - ρ))] ∈ ℝ by typecheck
    have r2 : R[complexAbs(c(succ(n))) * (half(R[ρ + r]) ^ succ(n) -
      ρ ^ succ(n))] ∈ ℝ by typecheck
    have r3 : R[complexAbs(c(succ(n))) * half(R[ρ + r]) ^ succ(n)] ∈ ℝ by
      typecheck
    linarith
  exact realLe.mul_right_cancel_positive with gapPositive, product


-- Termwise differentiation: the sum has the sum of the termwise
-- derivatives as its derivative.
theorem powerSeriesSum.has_derivative (c a r z : Set)
  requires radius : PowerSeriesRadiusAtLeast(c, r)
  requires ha : a ∈ ℂ
  requires hz : z ∈ complexDisk(a, r)
  shows HasComplexDerivativeAt(powerSeriesSum(c, a, r), complexDisk(a, r),
    powerSeriesSum(powerSeriesDerivCoefficients(c), a, r)(z), z)
proof
  have radiusDerived := powerSeriesDerivCoefficients.radius_at_least with radius
  have coefficients : ComplexSequence(c)
    obtain ⟨sequence, _, _⟩ := radius
    exact sequence
  have hr : r ∈ ℝ
    obtain ⟨_, real, _⟩ := radius
    exact real
  have coefficientsDerived : ComplexSequence(powerSeriesDerivCoefficients(c))
    obtain ⟨sequence, _, _⟩ := radiusDerived
    exact sequence
  have isOpen := complexDisk.open with ha, hr
  have functionF := powerSeriesSum.function with radius, ha
  have functionG := powerSeriesSum.function with radiusDerived, ha
  have values : ComplexValuedOn(powerSeriesSum(c, a, r), complexDisk(a, r))
    intros w hw
    exact FunctionBetween.apply_closed with functionF, hw
  have slope := FunctionBetween.apply_closed with functionG, hz
  refine ⟨isOpen, hz, slope, values, ?_⟩
  intros e he positive
  -- Radii |z − a| < ρ < σ < r.
  obtain ⟨zMember, zNear⟩ := complexDisk.membership.forward with hz
  have y : ℂ[z - a] ∈ ℂ by typecheck
  have t0Nonnegative := complexAbs.nonnegative with y
  have namedρ : ∃ ρ ∈ ℝ, R[ρ + ρ] = R[complexAbs(ℂ[z - a]) + r]
    have twice := half.add_self at R[complexAbs(ℂ[z - a]) + r]
    have real : half(R[complexAbs(ℂ[z - a]) + r]) ∈ ℝ by typecheck
    exact ⟨half(R[complexAbs(ℂ[z - a]) + r]), real, twice⟩
  obtain ⟨ρ, ρReal, ρTwice⟩ := namedρ
  have namedσ : ∃ σ ∈ ℝ, R[σ + σ] = R[ρ + r]
    have twice := half.add_self at R[ρ + r]
    have real : half(R[ρ + r]) ∈ ℝ by typecheck
    exact ⟨half(R[ρ + r]), real, twice⟩
  obtain ⟨σ, σReal, σTwice⟩ := namedσ
  have ρAbove : complexAbs(ℂ[z - a]) < ρ by linarith
  have ρBelow : ρ < r by linarith
  have σAbove : ρ < σ by linarith
  have σBelow : σ < r by linarith
  have ρPositive : R[0] < ρ by linarith
  have σPositive : R[0] < σ by linarith
  have ρσ : (ρ:R) ≤ (σ:R) by linarith
  -- The point a + σ and the summable majorant A(n) = |c′_n| σⁿ.
  have q : ℂ[a + complexOfReal(σ)] ∈ ℂ by typecheck
  have qDistance : complexAbs(ℂ[(a + complexOfReal(σ)) - a]) = σ
    have shift : ℂ[(a + complexOfReal(σ)) - a] = complexOfReal(σ) by
      ring
    have σNonnegative : R[0] ≤ σ by linarith
    rw [shift, (complexAbs.of_real at σ),
      (abs.of_nonnegative at σ with σNonnegative)]
  have qDisk : ℂ[a + complexOfReal(σ)] ∈ complexDisk(a, r)
    apply complexDisk.membership.backward
    refine ⟨q, ?_⟩
    rwa qDistance
  have absolute := powerSeriesTerms.absolutely_summable with radiusDerived, ha,
    qDisk
  obtain ⟨termsSequence, summableA⟩ := absolute
  obtain ⟨V, hV, sumsA⟩ := summableA
  have namedA : ∃ A,
      A = complexAbsSequence(powerSeriesTerms(powerSeriesDerivCoefficients(c),
      a, ℂ[a + complexOfReal(σ)])) by
    exact ⟨complexAbsSequence(powerSeriesTerms(powerSeriesDerivCoefficients(c),
        a, ℂ[a + complexOfReal(σ)])), rfl⟩
  obtain ⟨A, ADef⟩ := namedA
  rw ← ADef at sumsA
  have AValue : ∀ n ∈ ℕ, A(n) =
      R[complexAbs(powerSeriesDerivCoefficients(c)(n)) * σ ^ n]
    intros n hn
    have nNat := nat.omega.backward with hn
    have cn := FunctionBetween.apply_closed with coefficientsDerived, hn
    have qStep : ℂ[(a + complexOfReal(σ)) - a] ∈ ℂ by typecheck
    have power := complexPow.member at ℂ[(a + complexOfReal(σ)) - a], n
      with qStep
    rw [ADef, (complexAbsSequence.value with termsSequence, hn),
      (powerSeriesTerms.value with coefficientsDerived, ha, q, hn),
      (complexAbs.mul with cn, power),
      (complexAbs.pow at ℂ[(a + complexOfReal(σ)) - a], n with qStep),
      qDistance]
  have ANonnegative : NonnegativeTerms(A)
    intros n hn
    rw (AValue with n, hn)
    have nNat := nat.omega.backward with hn
    have cn := FunctionBetween.apply_closed with coefficientsDerived, hn
    have cNonnegative := complexAbs.nonnegative with cn
    have σNonnegative : R[0] ≤ σ by linarith
    have power := realPow.nonnegative with σNonnegative
    unfold realPow at power
    have product := realLe.mul_right_of_nonnegative with cNonnegative, power
    have zeroTimes : R[0 * σ ^ n] = R[0] by ring
    have r1 : R[complexAbs(powerSeriesDerivCoefficients(c)(n)) * σ ^ n] ∈ ℝ by
        typecheck
    have result : R[0] ≤ R[complexAbs(powerSeriesDerivCoefficients(c)(n)) *
      σ ^ n] by linarith
    exact realLe.characterization.forward with result
  have VNonnegative := SumsTo.nonnegative with sumsA, ANonnegative
  -- The constants C = ρ (σ − ρ) > 0 and M = σ V ≥ 0.
  have namedC : ∃ C ∈ ℝ, C = R[ρ * (σ - ρ)]
    have real : R[ρ * (σ - ρ)] ∈ ℝ by typecheck
    exact ⟨R[ρ * (σ - ρ)], real, rfl⟩
  obtain ⟨C, CReal, CDef⟩ := namedC
  have gapPositive : R[0] < R[σ - ρ] by linarith
  have CPositive : R[0] < C
    have product := realLess.mul_right_of_positive with ρPositive,
      gapPositive
    have zeroTimes : R[0 * (σ - ρ)] = R[0] by ring
    linarith
  have MReal : R[σ * V] ∈ ℝ by typecheck
  have MNonnegative : R[0] ≤ R[σ * V]
    have σNonnegative : R[0] ≤ σ by linarith
    have product := realLe.mul_right_of_nonnegative with σNonnegative,
      VNonnegative
    have zeroTimes : R[0 * V] = R[0] by ring
    linarith
  have eCReal : R[e * C] ∈ ℝ by typecheck
  have eCPositive : R[0] < R[e * C]
    have product := realLess.mul_right_of_positive with positive, CPositive
    have zeroTimes : R[0 * C] = R[0] by ring
    linarith
  obtain ⟨δ0, hδ0, δ0Positive, absorbM, _⟩ := realScale.absorb with MReal,
    eCReal, MNonnegative, eCPositive
  have marginReal : R[ρ - complexAbs(ℂ[z - a])] ∈ ℝ by typecheck
  have marginPositive : R[0] < R[ρ - complexAbs(ℂ[z - a])] by linarith
  obtain ⟨d, hd, dPositive, leδ0, leMargin⟩ := realRadius.common with hδ0,
    marginReal, δ0Positive, marginPositive
  refine ⟨d, hd, dPositive, ?_⟩
  intros w hw small
  obtain ⟨wMember, wNear⟩ := complexDisk.membership.forward with hw
  have x : ℂ[w - a] ∈ ℂ by typecheck
  have wz : ℂ[w - z] ∈ ℂ by typecheck
  have δNonnegative := complexAbs.nonnegative with wz
  have triangle := complexAbs.dist_triangle with wMember, zMember, ha
  have boundW : complexAbs(ℂ[w - a]) ≤ ρ by linarith
  have boundZ : complexAbs(ℂ[z - a]) ≤ ρ by linarith
  -- The remainder series sums to f(w) − f(z) − G (w − z).
  have sumsW := powerSeriesSum.sums with radius, ha, hw
  have sumsZ := powerSeriesSum.sums with radius, ha, hz
  have sumsG := powerSeriesSum.sums with radiusDerived, ha, hz
  have shiftW := complexShift.sums with sumsW
  have shiftZ := complexShift.sums with sumsZ
  have sequenceW := powerSeriesTerms.function with coefficients, ha, wMember
  have sequenceZ := powerSeriesTerms.function with coefficients, ha, zMember
  have sequenceG := powerSeriesTerms.function with coefficientsDerived, ha,
    zMember
  have sequenceH := powerSeriesRemainder.function with coefficients, ha,
    wMember, zMember
  have terms : ∀ m ∈ ℕ,
      powerSeriesRemainder(c, a, w, z)(m) =
      ℂ[complexShift(powerSeriesTerms(c, a, w))(m) -
      complexShift(powerSeriesTerms(c, a, z))(m) - (w - z) *
          powerSeriesTerms(powerSeriesDerivCoefficients(c), a, z)(m)]
    intros m hm
    have mNat := nat.omega.backward with hm
    have next : succ(m) ∈ ℕ by typecheck
    have cNext := FunctionBetween.apply_closed with coefficients, next
    have xPower := complexPow.member with x
    have yPower := complexPow.member with y
    have yPrevious := complexPow.member with y
    rw [(powerSeriesRemainder.value with coefficients, ha, wMember, zMember,
      hm), (complexShift.value with sequenceW, hm),
      (complexShift.value with sequenceZ, hm),
      (powerSeriesTerms.value with coefficients, ha, wMember, next),
      (powerSeriesTerms.value with coefficients, ha, zMember, next),
      (powerSeriesTerms.value with coefficientsDerived, ha, zMember, hm),
      (powerSeriesDerivCoefficients.value with coefficients, hm)]
    ring
  have combined := ComplexSumsTo.combination with shiftW, shiftZ, sumsG, wz,
    sequenceH, terms
  have zeroIn : (0:N) ∈ ℕ by typecheck
  have c0 := FunctionBetween.apply_closed with coefficients
  have fw := FunctionBetween.apply_closed with functionF, hw
  have fz := FunctionBetween.apply_closed with functionF, hz
  have total : ℂ[(powerSeriesSum(c, a, r)(w) -
      powerSeriesTerms(c, a, w)((0:N))) -
      (powerSeriesSum(c, a, r)(z) - powerSeriesTerms(c, a, z)((0:N))) -
      (w - z) * powerSeriesSum(powerSeriesDerivCoefficients(c), a, r)(z)] =
          ℂ[powerSeriesSum(c, a, r)(w) - powerSeriesSum(c, a, r)(z) -
          powerSeriesSum(powerSeriesDerivCoefficients(c), a, r)(z) * (w - z)]
    rw [(powerSeriesTerms.value with coefficients, ha, wMember, zeroIn),
      (powerSeriesTerms.value with coefficients, ha, zMember, zeroIn),
      monoidPow.zero, monoidPow.zero]
    ring
  rw total at combined
  -- |h(k)| ≤ K A(k) with K = |w − z|² σ / C.
  have CNonzero : C ≠ R[0] by linarith
  have δδσReal : R[complexAbs(ℂ[w - z]) * complexAbs(ℂ[w - z]) * σ] ∈ ℝ by
      typecheck
  have typedδδσ : Real(R[complexAbs(ℂ[w - z]) * complexAbs(ℂ[w - z]) * σ]) by
      typecheck
  have cancelK := realDiv.mul_right at
      R[complexAbs(ℂ[w - z]) * complexAbs(ℂ[w - z]) * σ], C with
    CNonzero
  have namedK : ∃ K ∈ ℝ,
      R[K * C] = R[complexAbs(ℂ[w - z]) * complexAbs(ℂ[w - z]) * σ]
    have real : R[(complexAbs(ℂ[w - z]) * complexAbs(ℂ[w - z]) * σ) / C] ∈ ℝ by
        typecheck
    exact ⟨R[(complexAbs(ℂ[w - z]) * complexAbs(ℂ[w - z]) * σ) / C], real,
        cancelK⟩
  obtain ⟨K, KReal, KCancel⟩ := namedK
  have typedK : Real(K) by typecheck
  have δδ := realLe.mul_right_of_nonnegative with δNonnegative, δNonnegative
  have zeroδ : R[0 * complexAbs(ℂ[w - z])] = R[0] by ring
  have δδNonnegative : R[0] ≤ R[complexAbs(ℂ[w - z]) * complexAbs(ℂ[w - z])] by
      linarith
  have σNonnegative : R[0] ≤ σ by linarith
  have δδσ := realLe.mul_right_of_nonnegative with δδNonnegative, σNonnegative
  have zeroσ : R[0 * σ] = R[0] by ring
  have δδσNonnegative : R[0] ≤
      R[complexAbs(ℂ[w - z]) * complexAbs(ℂ[w - z]) * σ] by linarith
  have KNonnegative : R[0] ≤ K
    by_contra negative
    have below : K < R[0] by linarith
    have product := realLess.mul_right_of_positive with below, CPositive
    have zeroTimes : R[0 * C] = R[0] by ring
    linarith
  have sequenceA : RealSequence(A)
    rw ADef
    exact complexAbsSequence.function with termsSequence
  have constant := constantSequence.sequence at K
  have gValue : ∀ k ∈ ℕ, mulSequence(constantSequence(K), A)(k) = R[K * A(k)]
    intros k hk
    have kNat := nat.omega.backward with hk
    have constantValue := constantSequence.value at K, k
    have typedConstant : Real(constantSequence(K)(k))
      rwa constantValue
    have AReal := RealSequence.value with sequenceA
    rw [(mulSequence.value with constant, sequenceA, typedConstant, AReal),
      constantValue]
  have sequenceMajorant := mulSequence.sequence with constant, sequenceA
  have termBound : ∀ k ∈ ℕ,
      complexAbs(powerSeriesRemainder(c, a, w, z)(k)) ≤
      mulSequence(constantSequence(K), A)(k)
    intros k hk
    have kNat := nat.omega.backward with hk
    have bound := powerSeriesRemainder.bound at c, a, w, z, ρ, σ, k
      with coefficients, ha, wMember, zMember, ρReal, σReal, boundW, boundZ, ρσ
    rw [← (AValue with k, hk)] at bound
    rw (gValue with k, hk)
    have hMember := FunctionBetween.apply_closed with sequenceH, hk
    have hReal : complexAbs(powerSeriesRemainder(c, a, w, z)(k)) ∈ ℝ by
        typecheck
    have AkReal : A(k) ∈ ℝ by typecheck
    have product : R[complexAbs(powerSeriesRemainder(c, a, w, z)(k)) * C] ≤
        R[(K * A(k)) * C]
      have left : R[complexAbs(powerSeriesRemainder(c, a, w, z)(k)) * C] =
          R[ρ * (σ - ρ) * complexAbs(powerSeriesRemainder(c, a, w, z)(k))]
        rw CDef
        ring
      have right : R[(K * A(k)) * C] = R[(K * C) * A(k)] by ring
      rwa [left, right, KCancel]
    exact realLe.mul_right_cancel_positive with CPositive, product
  -- Every partial sum of h is at most K V.
  have partials : ∀ n ∈ ℕ, (0:N) ≤ n →
      complexAbs(ℂ[complexPrefixSums(powerSeriesRemainder(c, a, w, z))(n) - 0])
          ≤ R[K * V]
    intros n hn nonnegativeIndex
    have nNat := nat.omega.backward with hn
    rw (complexPrefixSums.value with hn, sequenceH)
    have partial := complexPartialSum.member with sequenceH
    have minusZero :
        ℂ[complexPartialSum(powerSeriesRemainder(c, a, w, z), n) - 0] =
      complexPartialSum(powerSeriesRemainder(c, a, w, z), n) by ring
    rw minusZero
    have termsBelow : ∀ k ∈ ℕ,
        k < n → complexAbs(powerSeriesRemainder(c, a, w, z)(k)) ≤
        (mulSequence(constantSequence(K), A)[k]:R)
      intros k hk kBelow
      exact termBound with k, hk
    have first := complexPartialSum.abs_le with sequenceH, sequenceMajorant,
      termsBelow
    have scaledBelow : ∀ k ∈ ℕ,
        k < n → (mulSequence(constantSequence(K), A)[k]:R) ≤ R[K * A[k]]
      intros k hk kBelow
      rw (gValue with k, hk)
      have AkReal := RealSequence.value with sequenceA
      linarith
    have second := realPartialSum.le_scaled with sequenceMajorant, sequenceA,
      scaledBelow
    have third := SumsTo.partial_le with sumsA, ANonnegative
    have fourth := realLe.mul_left_of_nonnegative with third, KNonnegative
    have sumA := realPartialSum.real with sequenceA
    have r1 : R[K * (∑ i < n, A(i))] ∈ ℝ by typecheck
    have r2 : R[K * V] ∈ ℝ by typecheck
    have r3 : complexAbs(complexPartialSum(powerSeriesRemainder(c, a, w, z),
        n)) ∈ ℝ by typecheck
    linarith
  obtain ⟨_, converges⟩ := combined
  have zero := complexZero.member
  have bounded := ComplexConvergesTo.abs_le with converges, zero, partials
  have minusZero :
      ℂ[ℂ[powerSeriesSum(c, a, r)(w) - powerSeriesSum(c, a, r)(z) -
      powerSeriesSum(powerSeriesDerivCoefficients(c), a, r)(z) * (w - z)] - 0]
      = ℂ[powerSeriesSum(c, a, r)(w) - powerSeriesSum(c, a, r)(z) -
      powerSeriesSum(powerSeriesDerivCoefficients(c), a, r)(z) * (w - z)] by
      ring
  rw minusZero at bounded
  -- K V ≤ e |w − z|.
  have δBelow : complexAbs(ℂ[w - z]) ≤ δ0 by linarith
  have scaledM := realLe.mul_left_of_nonnegative with δBelow, MNonnegative
  have chain := realLe.mul_left_of_nonnegative with
    (realLe.transitive with scaledM, absorbM), δNonnegative
  have product : R[(K * V) * C] ≤ R[(e * complexAbs(ℂ[w - z])) * C]
    have left : R[(K * V) * C] = R[(K * C) * V] by ring
    rw [left, KCancel]
    have regroup1 : R[(complexAbs(ℂ[w - z]) * complexAbs(ℂ[w - z]) * σ) * V] =
        R[complexAbs(ℂ[w - z]) * (σ * V * complexAbs(ℂ[w - z]))] by ring
    have regroup2 : R[(e * complexAbs(ℂ[w - z])) * C] =
        R[complexAbs(ℂ[w - z]) * (e * C)] by ring
    rwa [regroup1, regroup2]
  have final := realLe.mul_right_cancel_positive with CPositive, product
  have r1 : complexAbs(ℂ[powerSeriesSum(c, a, r)(w) -
      powerSeriesSum(c, a, r)(z) -
      powerSeriesSum(powerSeriesDerivCoefficients(c), a, r)(z) * (w - z)]) ∈ ℝ
      by typecheck
  linarith


-- A power series is holomorphic inside its radius of convergence, with
-- the termwise derivative as its derivative.
theorem powerSeriesSum.holomorphic (c a r : Set)
  requires radius : PowerSeriesRadiusAtLeast(c, r)
  requires ha : a ∈ ℂ
  shows HolomorphicOn(powerSeriesSum(c, a, r), complexDisk(a, r))
proof
  have radiusDerived := powerSeriesDerivCoefficients.radius_at_least with
    radius
  have hr : r ∈ ℝ
    obtain ⟨_, real, _⟩ := radius
    exact real
  have functionF := powerSeriesSum.function with radius, ha
  have functionG := powerSeriesSum.function with radiusDerived, ha
  have values : ComplexValuedOn(powerSeriesSum(c, a, r), complexDisk(a, r))
    intros w hw
    exact FunctionBetween.apply_closed with functionF, hw
  refine ⟨(complexDisk.open with ha, hr), values, ?_⟩
  intros z hz
  exact ⟨powerSeriesSum(powerSeriesDerivCoefficients(c), a, r)(z),
    (FunctionBetween.apply_closed with functionG, hz),
    (powerSeriesSum.has_derivative with radius, ha, hz)⟩

theorem powerSeriesDerivCoefficients.radius (c r : Set)
  requires radius : PowerSeriesRadiusAtLeast(c, r)
  shows PowerSeriesRadiusAtLeast(powerSeriesDerivCoefficients(c), r)
proof
  exact powerSeriesDerivCoefficients.radius_at_least with radius
theorem powerSeriesSum.derivative (c a r z : Set)
  requires radius : PowerSeriesRadiusAtLeast(c, r)
  requires ha : a ∈ ℂ
  requires hz : z ∈ complexDisk(a, r)
  shows HasComplexDerivativeAt(powerSeriesSum(c, a, r), complexDisk(a, r),
    powerSeriesSum(powerSeriesDerivCoefficients(c), a, r)(z), z)
proof
  exact powerSeriesSum.has_derivative with radius, ha, hz
-- Section: Elementary functions
-- The error of exp(κ z) against its linear approximation at a is
-- exp(κ a) (exp(κ w) − 1 − κ w) with w = z − a, at most
-- |exp(κ a)| (|κ| |w|)² for |κ| |w| ≤ 1.
theorem complexExp.linear_error (κ a z : Set)
  requires hκ : κ ∈ ℂ
  requires ha : a ∈ ℂ
  requires hz : z ∈ ℂ
  requires small : R[complexAbs(κ) * complexAbs(ℂ[z - a])] ≤ R[1]
  shows complexAbs(ℂ[complexExp(κ * z) - complexExp(κ * a) -
      κ * complexExp(κ * a) * (z - a)]) ≤
    R[complexAbs(complexExp(ℂ[κ * a])) *
        ((complexAbs(κ) * complexAbs(ℂ[z - a])) *
      (complexAbs(κ) * complexAbs(ℂ[z - a])))]
proof
  have step : ℂ[z - a] ∈ ℂ by typecheck
  have κStep : ℂ[κ * (z - a)] ∈ ℂ by typecheck
  have κa : ℂ[κ * a] ∈ ℂ by typecheck
  have expA := complexExp.member with κa
  have expStep := complexExp.member with κStep
  have split : ℂ[κ * z] = ℂ[κ * a + κ * (z - a)] by ring
  have product := complexExp.add with κa, κStep
  rw ← split at product
  have absStep := complexAbs.mul with hκ, step
  have smallStep : complexAbs(ℂ[κ * (z - a)]) ≤ R[1]
    rwa absStep
  have quadratic := complexExp.quadratic_bound with smallStep
  rw absStep at quadratic
  have error : ℂ[complexExp(κ * (z - a)) - 1 - κ * (z - a)] ∈ ℂ by typecheck
  have same : ℂ[complexExp(κ * z) - complexExp(κ * a) -
      κ * complexExp(κ * a) * (z - a)] =
      ℂ[complexExp(κ * a) * (complexExp(κ * (z - a)) - 1 - κ * (z - a))]
    rw product
    ring
  rw [same, (complexAbs.mul with expA, error)]
  have expNonnegative := complexAbs.nonnegative with expA
  exact realLe.mul_left_of_nonnegative with quadratic, expNonnegative

-- f(x) = p exp(κ x) + q exp(μ x) on ℂ has derivative
-- p κ exp(κ a) + q μ exp(μ a) at a.
theorem HasComplexDerivativeAt.of_exp_combination (f a p q κ μ : Set)
  requires ha : a ∈ ℂ
  requires hp : p ∈ ℂ
  requires hq : q ∈ ℂ
  requires hκ : κ ∈ ℂ
  requires hμ : μ ∈ ℂ
  requires formula : ∀ x ∈ ℂ, f(x) =
    ℂ[p * complexExp(κ * x) + q * complexExp(μ * x)]
  shows HasComplexDerivativeAt(f, complexCarrier,
    ℂ[p * κ * complexExp(κ * a) + q * μ * complexExp(μ * a)], a)
proof
  have isOpen := ComplexOpen.whole
  have values : ComplexValuedOn(f, complexCarrier)
    intros x hx
    rw (formula with x, hx)
    have κx : ℂ[κ * x] ∈ ℂ by typecheck
    have μx : ℂ[μ * x] ∈ ℂ by typecheck
    have expκ := complexExp.member with κx
    have expμ := complexExp.member with μx
    typecheck
  have κa : ℂ[κ * a] ∈ ℂ by typecheck
  have μa : ℂ[μ * a] ∈ ℂ by typecheck
  have expκ := complexExp.member with κa
  have expμ := complexExp.member with μa
  have slope : ℂ[p * κ * complexExp(κ * a) + q * μ * complexExp(μ * a)] ∈ ℂ
    by typecheck
  refine ⟨isOpen, ha, slope, values, ?_⟩
  intros e he positive
  -- The constant K = |p exp(κ a)| |κ|² + |q exp(μ a)| |μ|².
  have pExp : ℂ[p * complexExp(κ * a)] ∈ ℂ by typecheck
  have qExp : ℂ[q * complexExp(μ * a)] ∈ ℂ by typecheck
  have CκNonnegative := complexAbs.nonnegative with pExp
  have CμNonnegative := complexAbs.nonnegative with qExp
  have kNonnegative := complexAbs.nonnegative with hκ
  have mNonnegative := complexAbs.nonnegative with hμ
  have kReal : complexAbs(κ) ∈ ℝ by typecheck
  have mReal : complexAbs(μ) ∈ ℝ by typecheck
  have kk := realLe.mul_right_of_nonnegative with kNonnegative, kNonnegative
  have mm := realLe.mul_right_of_nonnegative with mNonnegative, mNonnegative
  have zeroK : R[0 * complexAbs(κ)] = R[0] by ring
  have zeroM : R[0 * complexAbs(μ)] = R[0] by ring
  have kkNonnegative : R[0] ≤ R[complexAbs(κ) * complexAbs(κ)] by linarith
  have mmNonnegative : R[0] ≤ R[complexAbs(μ) * complexAbs(μ)] by linarith
  have Kκ := realLe.mul_left_of_nonnegative with kkNonnegative, CκNonnegative
  have Kμ := realLe.mul_left_of_nonnegative with mmNonnegative, CμNonnegative
  have timesZeroκ : R[complexAbs(ℂ[p * complexExp(κ * a)]) * 0] = R[0] by ring
  have timesZeroμ : R[complexAbs(ℂ[q * complexExp(μ * a)]) * 0] = R[0] by ring
  have KReal : R[complexAbs(ℂ[p * complexExp(κ * a)]) *
    (complexAbs(κ) * complexAbs(κ)) + complexAbs(ℂ[q * complexExp(μ * a)]) *
    (complexAbs(μ) * complexAbs(μ))] ∈ ℝ by typecheck
  have r1 : R[complexAbs(ℂ[p * complexExp(κ * a)]) *
    (complexAbs(κ) * complexAbs(κ))] ∈ ℝ by typecheck
  have r2 : R[complexAbs(ℂ[q * complexExp(μ * a)]) *
    (complexAbs(μ) * complexAbs(μ))] ∈ ℝ by typecheck
  have KNonnegative : R[0] ≤ R[complexAbs(ℂ[p * complexExp(κ * a)]) *
    (complexAbs(κ) * complexAbs(κ)) + complexAbs(ℂ[q * complexExp(μ * a)]) *
    (complexAbs(μ) * complexAbs(μ))] by linarith
  obtain ⟨ε, hε, εPositive, absorbK, _⟩ := realScale.absorb with KReal, he,
    KNonnegative, positive
  have one : R[1] ∈ ℝ by typecheck
  have onePositive : R[0] < R[1] by linarith
  obtain ⟨εκ, hεκ, εκPositive, absorbκ, _⟩ := realScale.absorb with kReal,
    one, kNonnegative, onePositive
  obtain ⟨εμ, hεμ, εμPositive, absorbμ, _⟩ := realScale.absorb with mReal,
    one, mNonnegative, onePositive
  obtain ⟨d1, hd1, positive1, leε, leκ⟩ := realRadius.common with hε, hεκ,
    εPositive, εκPositive
  obtain ⟨d, hd, dPositive, le1, leμ⟩ := realRadius.common with hd1, hεμ,
    positive1, εμPositive
  refine ⟨d, hd, dPositive, ?_⟩
  intros z hz small
  have step : ℂ[z - a] ∈ ℂ by typecheck
  have stepNonnegative := complexAbs.nonnegative with step
  have stepκ : complexAbs(ℂ[z - a]) ≤ εκ by linarith
  have stepμ : complexAbs(ℂ[z - a]) ≤ εμ by linarith
  have stepε : complexAbs(ℂ[z - a]) ≤ ε by linarith
  have scaledκ := realLe.mul_left_of_nonnegative with stepκ, kNonnegative
  have scaledμ := realLe.mul_left_of_nonnegative with stepμ, mNonnegative
  have smallκ : R[complexAbs(κ) * complexAbs(ℂ[z - a])] ≤ R[1] by linarith
  have smallμ : R[complexAbs(μ) * complexAbs(ℂ[z - a])] ≤ R[1] by linarith
  have errorκ := complexExp.linear_error with hκ, ha, hz, smallκ
  have errorμ := complexExp.linear_error with hμ, ha, hz, smallμ
  have κz : ℂ[κ * z] ∈ ℂ by typecheck
  have μz : ℂ[μ * z] ∈ ℂ by typecheck
  have expκz := complexExp.member with κz
  have expμz := complexExp.member with μz
  have partκ : ℂ[complexExp(κ * z) - complexExp(κ * a) -
    κ * complexExp(κ * a) * (z - a)] ∈ ℂ by typecheck
  have partμ : ℂ[complexExp(μ * z) - complexExp(μ * a) -
    μ * complexExp(μ * a) * (z - a)] ∈ ℂ by typecheck
  have termκ : ℂ[p * (complexExp(κ * z) - complexExp(κ * a) -
    κ * complexExp(κ * a) * (z - a))] ∈ ℂ by typecheck
  have termμ : ℂ[q * (complexExp(μ * z) - complexExp(μ * a) -
    μ * complexExp(μ * a) * (z - a))] ∈ ℂ by typecheck
  rw [(formula with z, hz), (formula with a, ha)]
  have split : ℂ[(p * complexExp(κ * z) + q * complexExp(μ * z)) -
      (p * complexExp(κ * a) + q * complexExp(μ * a)) -
      (p * κ * complexExp(κ * a) + q * μ * complexExp(μ * a)) * (z - a)] =
      ℂ[p * (complexExp(κ * z) - complexExp(κ * a) -
        κ * complexExp(κ * a) * (z - a)) +
        q * (complexExp(μ * z) - complexExp(μ * a) -
        μ * complexExp(μ * a) * (z - a))] by ring
  rw split
  have triangle := complexAbs.triangle with termκ, termμ
  rw [(complexAbs.mul with hp, partκ), (complexAbs.mul with hq, partμ)]
    at triangle
  have pNonnegative := complexAbs.nonnegative with hp
  have qNonnegative := complexAbs.nonnegative with hq
  have boundκ := realLe.mul_left_of_nonnegative with errorκ, pNonnegative
  have boundμ := realLe.mul_left_of_nonnegative with errorμ, qNonnegative
  have pAbs := complexAbs.mul with hp, expκ
  have qAbs := complexAbs.mul with hq, expμ
  have regroupκ : R[complexAbs(p) * (complexAbs(complexExp(ℂ[κ * a])) *
      ((complexAbs(κ) * complexAbs(ℂ[z - a])) *
      (complexAbs(κ) * complexAbs(ℂ[z - a]))))] =
      R[((complexAbs(p) * complexAbs(complexExp(ℂ[κ * a]))) *
      (complexAbs(κ) * complexAbs(κ))) * complexAbs(ℂ[z - a]) *
      complexAbs(ℂ[z - a])] by ring
  have regroupμ : R[complexAbs(q) * (complexAbs(complexExp(ℂ[μ * a])) *
      ((complexAbs(μ) * complexAbs(ℂ[z - a])) *
      (complexAbs(μ) * complexAbs(ℂ[z - a]))))] =
      R[((complexAbs(q) * complexAbs(complexExp(ℂ[μ * a]))) *
      (complexAbs(μ) * complexAbs(μ))) * complexAbs(ℂ[z - a]) *
      complexAbs(ℂ[z - a])] by ring
  rw [regroupκ, ← pAbs] at boundκ
  rw [regroupμ, ← qAbs] at boundμ
  have linearK := realLe.mul_left_of_nonnegative with stepε, KNonnegative
  have Kε : R[(complexAbs(ℂ[p * complexExp(κ * a)]) *
      (complexAbs(κ) * complexAbs(κ)) + complexAbs(ℂ[q * complexExp(μ * a)]) *
      (complexAbs(μ) * complexAbs(μ))) * complexAbs(ℂ[z - a])] ≤ e by
    have r7 : R[(complexAbs(ℂ[p * complexExp(κ * a)]) *
      (complexAbs(κ) * complexAbs(κ)) + complexAbs(ℂ[q * complexExp(μ * a)]) *
      (complexAbs(μ) * complexAbs(μ))) * complexAbs(ℂ[z - a])] ∈ ℝ by
      typecheck
    have r8 : R[(complexAbs(ℂ[p * complexExp(κ * a)]) *
      (complexAbs(κ) * complexAbs(κ)) + complexAbs(ℂ[q * complexExp(μ * a)]) *
      (complexAbs(μ) * complexAbs(μ))) * ε] ∈ ℝ by typecheck
    linarith
  have final := realLe.mul_right_of_nonnegative with Kε, stepNonnegative
  have expand : R[((complexAbs(ℂ[p * complexExp(κ * a)]) *
      (complexAbs(κ) * complexAbs(κ)) + complexAbs(ℂ[q * complexExp(μ * a)]) *
      (complexAbs(μ) * complexAbs(μ))) * complexAbs(ℂ[z - a])) *
      complexAbs(ℂ[z - a])] =
      R[complexAbs(ℂ[p * complexExp(κ * a)]) *
      (complexAbs(κ) * complexAbs(κ)) * complexAbs(ℂ[z - a]) *
      complexAbs(ℂ[z - a]) + complexAbs(ℂ[q * complexExp(μ * a)]) *
      (complexAbs(μ) * complexAbs(μ)) * complexAbs(ℂ[z - a]) *
      complexAbs(ℂ[z - a])] by ring
  have r9 : complexAbs(ℂ[complexExp(κ * z) - complexExp(κ * a) -
    κ * complexExp(κ * a) * (z - a)]) ∈ ℝ by typecheck
  have r10 : complexAbs(ℂ[complexExp(μ * z) - complexExp(μ * a) -
    μ * complexExp(μ * a) * (z - a)]) ∈ ℝ by typecheck
  have r11 : R[complexAbs(p) * complexAbs(ℂ[complexExp(κ * z) -
    complexExp(κ * a) - κ * complexExp(κ * a) * (z - a)])] ∈ ℝ by typecheck
  have r12 : R[complexAbs(q) * complexAbs(ℂ[complexExp(μ * z) -
    complexExp(μ * a) - μ * complexExp(μ * a) * (z - a)])] ∈ ℝ by typecheck
  have r13 : R[complexAbs(ℂ[p * complexExp(κ * a)]) *
    (complexAbs(κ) * complexAbs(κ)) * complexAbs(ℂ[z - a]) *
    complexAbs(ℂ[z - a])] ∈ ℝ by typecheck
  have r14 : R[complexAbs(ℂ[q * complexExp(μ * a)]) *
    (complexAbs(μ) * complexAbs(μ)) * complexAbs(ℂ[z - a]) *
    complexAbs(ℂ[z - a])] ∈ ℝ by typecheck
  have r16 : R[((complexAbs(ℂ[p * complexExp(κ * a)]) *
    (complexAbs(κ) * complexAbs(κ)) + complexAbs(ℂ[q * complexExp(μ * a)]) *
    (complexAbs(μ) * complexAbs(μ))) * complexAbs(ℂ[z - a])) *
    complexAbs(ℂ[z - a])] ∈ ℝ by typecheck
  linarith

theorem complexExp.has_derivative (a : Set)
  requires ha : a ∈ ℂ
  shows HasComplexDerivativeAt(complexExp, complexCarrier, complexExp(a), a)
proof
  have one := complexOne.member
  have zero := complexZero.member
  have formula : ∀ x ∈ ℂ, complexExp(x) =
      ℂ[1 * complexExp(1 * x) + 0 * complexExp(0 * x)]
    intros x hx
    have same : ℂ[1 * x] = x by ring
    have scaled : ℂ[0 * x] ∈ ℂ by typecheck
    have expScaled := complexExp.member with scaled
    have expX := complexExp.member with hx
    rw same
    ring
  have derivative := HasComplexDerivativeAt.of_exp_combination with ha, one,
    zero, one, zero, formula
  have same : ℂ[1 * a] = a by ring
  have scaled : ℂ[0 * a] ∈ ℂ by typecheck
  have expScaled := complexExp.member with scaled
  have expA := complexExp.member with ha
  have value : ℂ[1 * 1 * complexExp(1 * a) + 0 * 0 * complexExp(0 * a)] =
      complexExp(a)
    rw same
    ring
  rwa value at derivative

theorem complexExp.holomorphic
  shows HolomorphicOn(complexExp, complexCarrier)
proof
  have values : ComplexValuedOn(complexExp, complexCarrier)
    intros z hz
    exact complexExp.member with hz
  refine ⟨ComplexOpen.whole, values, ?_⟩
  intros a ha
  exact ⟨complexExp(a), (complexExp.member with ha),
    (complexExp.has_derivative with ha)⟩

theorem complexSin.has_derivative (a : Set)
  requires ha : a ∈ ℂ
  shows HasComplexDerivativeAt(complexSin, complexCarrier, complexCos(a), a)
proof
  have iMember := complexImaginaryUnit.member
  have halfMember : complexInv(ℂ[2]) ∈ ℂ := complexInv.member with *
  have pMember : ℂ[-(complexImaginaryUnit * complexInv(ℂ[2]))] ∈ ℂ by
    typecheck
  have qMember : ℂ[complexImaginaryUnit * complexInv(ℂ[2])] ∈ ℂ by typecheck
  have negI : ℂ[-complexImaginaryUnit] ∈ ℂ by typecheck
  have formula : ∀ x ∈ ℂ, complexSin(x) =
      ℂ[-(complexImaginaryUnit * complexInv(ℂ[2])) *
        complexExp(complexImaginaryUnit * x) +
        complexImaginaryUnit * complexInv(ℂ[2]) *
        complexExp(-complexImaginaryUnit * x)]
    intros x hx
    have argument : ℂ[-(complexImaginaryUnit * x)] =
        ℂ[-complexImaginaryUnit * x] by ring
    have first : complexExp(ℂ[complexImaginaryUnit * x]) ∈ ℂ by typecheck
    have second : complexExp(ℂ[-complexImaginaryUnit * x]) ∈ ℂ by typecheck
    rw [(complexSin.formula with hx), argument]
    ring
  have derivative := HasComplexDerivativeAt.of_exp_combination with
    ha, pMember, qMember, iMember, negI, formula
  have first : complexExp(ℂ[complexImaginaryUnit * a]) ∈ ℂ by typecheck
  have second : complexExp(ℂ[-complexImaginaryUnit * a]) ∈ ℂ by typecheck
  have argument : ℂ[-(complexImaginaryUnit * a)] =
      ℂ[-complexImaginaryUnit * a] by ring
  have value : ℂ[-(complexImaginaryUnit * complexInv(ℂ[2])) *
      complexImaginaryUnit * complexExp(complexImaginaryUnit * a) +
      complexImaginaryUnit * complexInv(ℂ[2]) * -complexImaginaryUnit *
      complexExp(-complexImaginaryUnit * a)] = complexCos(a)
    rw [(complexCos.formula with ha), argument]
    have regroup : ℂ[-(complexImaginaryUnit * complexInv(ℂ[2])) *
        complexImaginaryUnit * complexExp(complexImaginaryUnit * a) +
        complexImaginaryUnit * complexInv(ℂ[2]) * -complexImaginaryUnit *
        complexExp(-complexImaginaryUnit * a)] =
        ℂ[-(complexImaginaryUnit * complexImaginaryUnit) * complexInv(ℂ[2]) *
        (complexExp(complexImaginaryUnit * a) +
        complexExp(-complexImaginaryUnit * a))] by ring
    rw [regroup, complexImaginaryUnit.square]
    ring
  rwa value at derivative

theorem complexCos.has_derivative (a : Set)
  requires ha : a ∈ ℂ
  shows HasComplexDerivativeAt(complexCos, complexCarrier,
    ℂ[-complexSin(a)], a)
proof
  have iMember := complexImaginaryUnit.member
  have halfMember : complexInv(ℂ[2]) ∈ ℂ := complexInv.member with *
  have negI : ℂ[-complexImaginaryUnit] ∈ ℂ by typecheck
  have formula : ∀ x ∈ ℂ, complexCos(x) =
      ℂ[complexInv(ℂ[2]) * complexExp(complexImaginaryUnit * x) +
        complexInv(ℂ[2]) * complexExp(-complexImaginaryUnit * x)]
    intros x hx
    have argument : ℂ[-(complexImaginaryUnit * x)] =
        ℂ[-complexImaginaryUnit * x] by ring
    have first : complexExp(ℂ[complexImaginaryUnit * x]) ∈ ℂ by typecheck
    have second : complexExp(ℂ[-complexImaginaryUnit * x]) ∈ ℂ by typecheck
    rw [(complexCos.formula with hx), argument]
    ring
  have derivative := HasComplexDerivativeAt.of_exp_combination with
    ha, halfMember, halfMember, iMember, negI, formula
  have first : complexExp(ℂ[complexImaginaryUnit * a]) ∈ ℂ by typecheck
  have second : complexExp(ℂ[-complexImaginaryUnit * a]) ∈ ℂ by typecheck
  have argument : ℂ[-(complexImaginaryUnit * a)] =
      ℂ[-complexImaginaryUnit * a] by ring
  have value : ℂ[complexInv(ℂ[2]) * complexImaginaryUnit *
      complexExp(complexImaginaryUnit * a) +
      complexInv(ℂ[2]) * -complexImaginaryUnit *
      complexExp(-complexImaginaryUnit * a)] = ℂ[-complexSin(a)]
    rw [(complexSin.formula with ha), argument]
    ring
  rwa value at derivative

theorem complexLog.has_derivative (a : Set)
  requires ha : a ∈ slitPlane
  shows HasComplexDerivativeAt(complexLog, slitPlane, complexInv(a), a)
proof
  have isOpen := slitPlane.open
  obtain ⟨aMember, _⟩ := slitPlane.membership.forward with ha
  have aNonzeroMember := slitPlane.nonzero with ha
  obtain ⟨_, aNonzero⟩ := complexNonzero.membership.forward with
    aNonzeroMember
  have ia := complexInv.member with aMember
  have cancelA := complexInv.mul_cancel with aMember, aNonzero
  have values : ComplexValuedOn(complexLog, slitPlane)
    intros z hz
    obtain ⟨zMember, _⟩ := slitPlane.membership.forward with hz
    exact complexLog.member with zMember
  refine ⟨isOpen, ha, ia, values, ?_⟩
  intros e he positive
  have continuous := ComplexContinuousAt.abs_form with
    (complexLog.continuous_at with ha)
  -- Choose η ≤ 1/2 with 2 |1/a| η ≤ e.
  have iaNonnegative := complexAbs.nonnegative with ia
  have KReal : R[2 * complexAbs(complexInv(a))] ∈ ℝ by typecheck
  have KNonnegative : R[0] ≤ R[2 * complexAbs(complexInv(a))] by linarith
  obtain ⟨η1, hη1, η1Positive, absorbK, _⟩ := realScale.absorb with KReal, he,
    KNonnegative, positive
  have onePositive : R[0] < R[1] by linarith
  have halfOne := half.positive with onePositive
  have halfOneReal : half(R[1]) ∈ ℝ by typecheck
  have halfTwice := half.add_self at R[1]
  obtain ⟨η, hη, ηPositive, le1, leHalf⟩ := realRadius.common with hη1,
    halfOneReal, η1Positive, halfOne
  obtain ⟨d, hd, dPositive, near⟩ := continuous with η, hη, ηPositive
  refine ⟨d, hd, dPositive, ?_⟩
  intros z hz small
  obtain ⟨zMember, _⟩ := slitPlane.membership.forward with hz
  have zNonzeroMember := slitPlane.nonzero with hz
  obtain ⟨_, zNonzero⟩ := complexNonzero.membership.forward with
    zNonzeroMember
  have logZ := complexLog.member with zMember
  have logA := complexLog.member with aMember
  have u : ℂ[complexLog(z) - complexLog(a)] ∈ ℂ by typecheck
  have named : ∃ w ∈ ℂ, w = ℂ[complexLog(z) - complexLog(a)] by
    exact ⟨ℂ[complexLog(z) - complexLog(a)], u, rfl⟩
  obtain ⟨w, hw, wDef⟩ := named
  have wSmall := near with z, zMember, small
  rw ← wDef at wSmall
  have wNonnegative := complexAbs.nonnegative with hw
  -- z = a exp(w).
  have expW := complexExp.member with hw
  have shape : z = ℂ[a * complexExp(w)]
    have sum : complexLog(z) = ℂ[complexLog(a) + w]
      rw wDef
      ring
    have expanded := complexExp.add with logA, hw
    rw [← sum, (complexLog.exp with zMember, zNonzero),
      (complexLog.exp with aMember, aNonzero)] at expanded
    exact expanded
  have increment : ℂ[complexExp(w) - 1] = ℂ[complexInv(a) * (z - a)]
    rw shape
    have regroup : ℂ[complexInv(a) * (a * complexExp(w) - a)] =
        ℂ[(a * complexInv(a)) * (complexExp(w) - 1)] by ring
    rw [regroup, cancelA]
    ring
  have error : ℂ[w - complexInv(a) * (z - a)] =
      ℂ[-(complexExp(w) - 1 - w)]
    rw ← increment
    ring
  -- The quadratic estimate for exp at w.
  have wBelowOne : complexAbs(w) ≤ R[1] by linarith
  have quadratic := complexExp.quadratic_bound with hw, wBelowOne
  have errorExp : ℂ[complexExp(w) - 1 - w] ∈ ℂ by typecheck
  have wLe : complexAbs(w) ≤ η by linarith
  have square := realLe.mul_left_of_nonnegative with wLe, wNonnegative
  -- |w| ≤ 2 |1/a| |z − a|.
  have change : ℂ[complexExp(w) - 1] ∈ ℂ by typecheck
  have wSplit : w = ℂ[(complexExp(w) - 1) - (complexExp(w) - 1 - w)] by ring
  have wTriangle := complexAbs.sub_le with change, errorExp
  rw ← wSplit at wTriangle
  have step : ℂ[z - a] ∈ ℂ by typecheck
  have changeAbs : complexAbs(ℂ[complexExp(w) - 1]) =
      R[complexAbs(complexInv(a)) * complexAbs(ℂ[z - a])]
    rw [increment, (complexAbs.mul with ia, step)]
  have halfScaled := realLe.mul_left_of_nonnegative with leHalf,
    wNonnegative
  have halfExpand : R[complexAbs(w) * half(R[1]) +
      complexAbs(w) * half(R[1])] = complexAbs(w)
    have factor : R[complexAbs(w) * half(R[1]) +
        complexAbs(w) * half(R[1])] =
        R[complexAbs(w) * (half(R[1]) + half(R[1]))] by ring
    rw [factor, halfTwice]
    ring
  have r4 : R[complexAbs(complexInv(a)) * complexAbs(ℂ[z - a])] ∈ ℝ by
    typecheck
  have wBound : complexAbs(w) ≤
      R[2 * (complexAbs(complexInv(a)) * complexAbs(ℂ[z - a]))] by linarith
  -- Together: |error| ≤ |w|² ≤ η |w| ≤ 2 |1/a| η |z − a| ≤ e |z − a|.
  rw [← wDef, error, (complexAbs.neg with errorExp)]
  have ηNonnegative : R[0] ≤ η by linarith
  have chain1 := realLe.mul_right_of_nonnegative with wBound, ηNonnegative
  have stepNonnegative := complexAbs.nonnegative with step
  have Kη := realLe.mul_left_of_nonnegative with le1, KNonnegative
  have chain2 := realLe.mul_right_of_nonnegative with Kη, stepNonnegative
  have chain3 := realLe.mul_right_of_nonnegative with absorbK,
    stepNonnegative
  have regroup1 : R[complexAbs(w) * η] = R[η * complexAbs(w)] by ring
  have regroup2 : R[(2 * (complexAbs(complexInv(a)) *
      complexAbs(ℂ[z - a]))) * η] =
      R[((2 * complexAbs(complexInv(a))) * η) * complexAbs(ℂ[z - a])] by ring
  have r5 : R[(2 * (complexAbs(complexInv(a)) * complexAbs(ℂ[z - a]))) * η]
    ∈ ℝ by typecheck
  have r6 : R[((2 * complexAbs(complexInv(a))) * η) * complexAbs(ℂ[z - a])]
    ∈ ℝ by typecheck
  have r7 : R[((2 * complexAbs(complexInv(a))) * η1) * complexAbs(ℂ[z - a])]
    ∈ ℝ by typecheck
  linarith

theorem complexLog.holomorphic
  shows HolomorphicOn(complexLog, slitPlane)
proof
  have values : ComplexValuedOn(complexLog, slitPlane)
    intros z hz
    obtain ⟨zMember, _⟩ := slitPlane.membership.forward with hz
    exact complexLog.member with zMember
  refine ⟨slitPlane.open, values, ?_⟩
  intros a ha
  obtain ⟨aMember, _⟩ := slitPlane.membership.forward with ha
  exact ⟨complexInv(a), (complexInv.member with aMember),
    (complexLog.has_derivative with ha)⟩

-- d/ds x^s = log x · x^s.
theorem realCpowMap.has_derivative (X s : Set)
  requires positive : X ∈ positiveReals
  requires hs : s ∈ ℂ
  shows HasComplexDerivativeAt(realCpowMap(X), complexCarrier,
    ℂ[complexOfReal(realLog(X)) * realCpow(X, s)], s)
proof
  obtain ⟨realX, _⟩ := positiveReals.membership.forward with positive
  have typedX : Real(X) by typecheck
  have logMember : complexOfReal(realLog(X)) ∈ ℂ by typecheck
  have one := complexOne.member
  have zero := complexZero.member
  have formula : ∀ x ∈ ℂ, realCpowMap(X)(x) =
      ℂ[1 * complexExp(complexOfReal(realLog(X)) * x) + 0 * complexExp(0 * x)]
    intros x hx
    rw (realCpowMap.value with positive, hx)
    unfold realCpow
    have commuted : ℂ[x * complexOfReal(realLog(X))] =
        ℂ[complexOfReal(realLog(X)) * x] by ring
    have scaled : ℂ[0 * x] ∈ ℂ by typecheck
    have expScaled := complexExp.member with scaled
    have product : ℂ[complexOfReal(realLog(X)) * x] ∈ ℂ by typecheck
    have expProduct := complexExp.member with product
    rw commuted
    ring
  have derivative := HasComplexDerivativeAt.of_exp_combination at
    realCpowMap(X), s, ℂ[1], ℂ[0], complexOfReal(realLog(X)), ℂ[0] with hs,
    one, zero, logMember, zero, formula
  have scaled : ℂ[0 * s] ∈ ℂ by typecheck
  have expScaled := complexExp.member with scaled
  have product : ℂ[complexOfReal(realLog(X)) * s] ∈ ℂ by typecheck
  have expProduct := complexExp.member with product
  have value : ℂ[1 * complexOfReal(realLog(X)) *
      complexExp(complexOfReal(realLog(X)) * s) +
      0 * 0 * complexExp(0 * s)] =
      ℂ[complexOfReal(realLog(X)) * realCpow(X, s)]
    unfold realCpow
    have commuted : ℂ[s * complexOfReal(realLog(X))] =
        ℂ[complexOfReal(realLog(X)) * s] by ring
    rw commuted
    ring
  rw value at derivative
  exact derivative

theorem realCpowMap.holomorphic (X : Set)
  requires positive : X ∈ positiveReals
  shows HolomorphicOn(realCpowMap(X), complexCarrier)
proof
  obtain ⟨realX, _⟩ := positiveReals.membership.forward with positive
  have typedX : Real(X) by typecheck
  have function := realCpowMap.function with positive
  have values : ComplexValuedOn(realCpowMap(X), complexCarrier)
    intros z hz
    exact FunctionBetween.apply_closed with function, hz
  refine ⟨ComplexOpen.whole, values, ?_⟩
  intros s hs
  have power := realCpow.member with hs
  have slope : ℂ[complexOfReal(realLog(X)) * realCpow(X, s)] ∈ ℂ by typecheck
  exact ⟨ℂ[complexOfReal(realLog(X)) * realCpow(X, s)], slope,
    (realCpowMap.has_derivative with positive, hs)⟩

-- Section: Linear combinations of Riemann integrals
theorem realAddValue.ring_form (A B : Real)
  shows realAddValue(A, B) = R[A + B]
proof
  unfold realAddValue
  unfold call2
  rfl

theorem realMulValue.ring_form (A B : Real)
  shows realMulValue(A, B) = R[A * B]
proof
  unfold realMulValue
  unfold call2
  rfl

theorem riemannSum.combination (f g h p t : Set) (a b : Real, N : Nat)
  requires functionF : f : ℝ → ℝ
  requires functionG : g : ℝ → ℝ
  requires functionH : h : ℝ → ℝ
  requires points : RealSequence(p)
  requires tags : RealSequence(t)
  requires values : ∀ X ∈ ℝ, h(X) = R[a * f(X) + b * g(X)]
  shows riemannSum(h, p, t, N) =
    R[a * riemannSum(f, p, t, N) + b * riemannSum(g, p, t, N)]
proof
  induction N
  | zero =>
    rw [riemannSum.zero, riemannSum.zero, riemannSum.zero]
    ring
  | succ(k) using ih =>
    rw [(riemannSum.succ with functionH, points, tags),
      (riemannSum.succ with functionF, points, tags),
      (riemannSum.succ with functionG, points, tags), ih]
    have tagMember : t[k] ∈ ℝ := RealSequence.value with tags
    rw (values with t[k], tagMember)
    have fReal : f(t[k]) ∈ ℝ := FunctionBetween.apply_closed with functionF,
      tagMember
    have gReal : g(t[k]) ∈ ℝ := FunctionBetween.apply_closed with functionG,
      tagMember
    have sf := riemannSum.real at f, p, t, k with functionF, points, tags
    have sg := riemannSum.real at g, p, t, k with functionG, points, tags
    have pk : p[k] ∈ ℝ := RealSequence.value with points
    have pk1 : p[succ(k)] ∈ ℝ := RealSequence.value with points
    have s1 : riemannSum(f, p, t, k) ∈ ℝ by exact sf
    have s2 : riemannSum(g, p, t, k) ∈ ℝ by exact sg
    have check1 : R[a * f(t[k])] ∈ ℝ by typecheck
    have check2 : R[p[succ(k)] - p[k]] ∈ ℝ by typecheck
    rw [realAddValue.ring_form, realAddValue.ring_form, realAddValue.ring_form,
      realMulValue.ring_form, realMulValue.ring_form, realMulValue.ring_form]
    ring

theorem HasRiemannIntegral.combination (f g h : Set) (A B I J a b : Real)
  requires integralF : HasRiemannIntegral(f, A, B, I)
  requires integralG : HasRiemannIntegral(g, A, B, J)
  requires functionH : h : ℝ → ℝ
  requires values : ∀ X ∈ ℝ, h(X) = R[a * f(X) + b * g(X)]
  shows HasRiemannIntegral(h, A, B, R[a * I + b * J])
proof
  obtain ⟨functionF, ordered, controlF⟩ := integralF
  obtain ⟨functionG, _, controlG⟩ := integralG
  refine ⟨functionH, ordered, ?_⟩
  intros E realE positiveE
  have halfPositive := half.positive with positiveE
  have halfBelow := half.lt_self with positiveE
  have halfReal : half(E) ∈ ℝ by typecheck
  have absA := abs.nonnegative at a
  have absB := abs.nonnegative at b
  have weightReal : R[abs(a) + abs(b)] ∈ ℝ by typecheck
  have weightNonnegative : R[0] ≤ R[abs(a) + abs(b)] by linarith
  obtain ⟨ε, hε, εPositive, scaled, _⟩ := realScale.absorb with weightReal,
    halfReal, weightNonnegative, halfPositive
  obtain ⟨D1, realD1, positive1, estimate1⟩ := controlF with ε, hε, εPositive
  obtain ⟨D2, realD2, positive2, estimate2⟩ := controlG with ε, hε, εPositive
  obtain ⟨D, realD, positiveD, le1, le2⟩ := positiveMesh.common_two with
    positive1, positive2
  refine ⟨D, realD, positiveD, ?_⟩
  intros p t N naturalN tagged fine
  have typedN : Nat(N) := nat.omega.backward at N with naturalN
  have fine1 := FinePartition.weaken with fine, le1
  have fine2 := FinePartition.weaken with fine, le2
  have bound1 := estimate1 with p, t, N, naturalN, tagged, fine1
  have bound2 := estimate2 with p, t, N, naturalN, tagged, fine2
  obtain ⟨partition, tags, _⟩ := tagged
  obtain ⟨points, _⟩ := partition
  have sum := riemannSum.combination at f, g, h, p, t, a, b, N with functionF,
    functionG, functionH, points, tags, values
  have sf := riemannSum.real at f, p, t, N with functionF, points, tags
  have sg := riemannSum.real at g, p, t, N with functionG, points, tags
  unfold dist at bound1
  unfold dist at bound2
  unfold realSubValue at bound1
  unfold realSubValue at bound2
  unfold dist
  rw sum
  have regroup : realSubValue(R[a * riemannSum(f, p, t, N) +
      b * riemannSum(g, p, t, N)], R[a * I + b * J]) = R[a * (riemannSum(f, p, t, N) - I) +
      b * (riemannSum(g, p, t, N) - J)]
    unfold realSubValue
    ring
  rw regroup
  have triangle := abs.triangle at R[a * (riemannSum(f, p, t, N) - I)],
    R[b * (riemannSum(g, p, t, N) - J)]
  rw [abs.mul, abs.mul] at triangle
  have d1 := abs.nonnegative at R[riemannSum(f, p, t, N) - I]
  have d2 := abs.nonnegative at R[riemannSum(g, p, t, N) - J]
  have weak1 : abs(R[riemannSum(f, p, t, N) - I]) ≤ ε by linarith
  have weak2 : abs(R[riemannSum(g, p, t, N) - J]) ≤ ε by linarith
  have m1 := realLe.mul_left_of_nonnegative with weak1, absA
  have m2 := realLe.mul_left_of_nonnegative with weak2, absB
  have expand : R[(abs(a) + abs(b)) * ε] = R[abs(a) * ε + abs(b) * ε] by ring
  linarith

-- Section: Complex functions of a real variable
-- A complex function of a real variable is a set g with g(X) ∈ ℂ for every
-- real X; it is integrated through its real and imaginary parts.
defgraph pathRe (g : Set) (X ∈ ℝ) : ℝ := complexRe(g(X))
requires values : ComplexValuedOn(g, ℝ)
proof
  exact complexRe.real with (values with member)

defgraph pathIm (g : Set) (X ∈ ℝ) : ℝ := complexIm(g(X))
requires values : ComplexValuedOn(g, ℝ)
proof
  exact complexIm.real with (values with member)

predicate HasPathIntegral (g : Set) (A B : Real) (I : Set) :=
  ComplexValuedOn(g, ℝ) ∧ I ∈ complexCarrier ∧
  HasRiemannIntegral(pathRe(g), A, B, complexRe(I)) ∧
  HasRiemannIntegral(pathIm(g), A, B, complexIm(I))

def pathIntegral (g : Set, A B : Real) : Set :=
  (riemannIntegral(pathRe(g), A, B), riemannIntegral(pathIm(g), A, B))

predicate PathContinuousOn (g : Set) (A B : Real) :=
  ComplexValuedOn(g, ℝ) ∧
  (∀ X ∈ closedInterval(A, B), ∀ e ∈ ℝ, R[0] < e → ∃ d ∈ ℝ, R[0] < d ∧
    (∀ Y ∈ closedInterval(A, B), abs(R[Y - X]) < d →
      complexAbs(ℂ[g(Y) - g(X)]) < e))

theorem pathRe.apply (g : Set) (X : Real)
  requires values : ComplexValuedOn(g, ℝ)
  shows pathRe(g)(X) = complexRe(g(X))
proof
  have xReal : X ∈ ℝ by typecheck
  exact pathRe.value at g, X with values, xReal

theorem pathIm.apply (g : Set) (X : Real)
  requires values : ComplexValuedOn(g, ℝ)
  shows pathIm(g)(X) = complexIm(g(X))
proof
  have xReal : X ∈ ℝ by typecheck
  exact pathIm.value at g, X with values, xReal

theorem pathIntegral.member (g : Set) (A B : Real)
  shows pathIntegral(g, A, B) ∈ ℂ
proof
  obtain ⟨reMember, _⟩ := riemannIntegral.selected at pathRe(g), A, B
  obtain ⟨imMember, _⟩ := riemannIntegral.selected at pathIm(g), A, B
  have reReal : Real(riemannIntegral(pathRe(g), A, B)) by exact reMember
  have imReal : Real(riemannIntegral(pathIm(g), A, B)) by exact imMember
  unfold pathIntegral
  exact complexCarrier.pair at riemannIntegral(pathRe(g), A, B),
    riemannIntegral(pathIm(g), A, B) with reReal, imReal

theorem HasPathIntegral.eq (g : Set) (A B : Real) (I : Set)
  requires integral : HasPathIntegral(g, A, B, I)
  shows pathIntegral(g, A, B) = I
proof
  obtain ⟨values, hI, reIntegral, imIntegral⟩ := integral
  unfold pathIntegral
  rw [(riemannIntegral.eq_of_integral with reIntegral),
    (riemannIntegral.eq_of_integral with imIntegral)]
  symm
  exact complex.ext with hI

theorem HasPathIntegral.unique (g : Set) (A B : Real) (I J : Set)
  requires first : HasPathIntegral(g, A, B, I)
  requires second : HasPathIntegral(g, A, B, J)
  shows I = J
proof
  rw [← (HasPathIntegral.eq with first), (HasPathIntegral.eq with second)]

-- The real and imaginary parts of a continuous path are continuous.
theorem PathContinuousOn.parts (g : Set) (A B : Real)
  requires continuous : PathContinuousOn(g, A, B)
  shows ContinuousOn(pathRe(g), closedInterval(A, B)) ∧
    ContinuousOn(pathIm(g), closedInterval(A, B))
proof
  obtain ⟨values, close⟩ := continuous
  have functionRe := pathRe.function with values
  have functionIm := pathIm.function with values
  have reals := closedInterval.subset_reals at A, B
  refine ⟨?_, ?_⟩
  . refine ⟨functionRe, reals, ?_⟩
    intros X hX
    have xReal : X ∈ ℝ := reals with X, hX
    refine ⟨functionRe, reals, ?_⟩
    intros E realE positiveE
    obtain ⟨d, hd, dPositive, near⟩ := close with X, hX, E, realE, positiveE
    refine ⟨d, hd, dPositive, ?_⟩
    intros Y realY hY ball
    obtain ⟨_, distance⟩ := openBall.membership.forward with ball
    unfold dist at distance
    unfold realSubValue at distance
    have bound := near with Y, hY, distance
    have gX := values with X, xReal
    have gY := values with Y, realY
    have difference : ℂ[g(Y) - g(X)] ∈ ℂ by typecheck
    have part := complexAbs.re_le with difference
    rw (complexRe.sub with gY, gX) at part
    apply openBall.membership.backward
    have valueY := pathRe.value at g, Y with values, realY
    have valueX := pathRe.value at g, X with values, xReal
    refine ⟨(FunctionBetween.apply_closed with functionRe, realY), ?_⟩
    rw [valueY, valueX]
    unfold dist
    unfold realSubValue
    linarith
  . refine ⟨functionIm, reals, ?_⟩
    intros X hX
    have xReal : X ∈ ℝ := reals with X, hX
    refine ⟨functionIm, reals, ?_⟩
    intros E realE positiveE
    obtain ⟨d, hd, dPositive, near⟩ := close with X, hX, E, realE, positiveE
    refine ⟨d, hd, dPositive, ?_⟩
    intros Y realY hY ball
    obtain ⟨_, distance⟩ := openBall.membership.forward with ball
    unfold dist at distance
    unfold realSubValue at distance
    have bound := near with Y, hY, distance
    have gX := values with X, xReal
    have gY := values with Y, realY
    have difference : ℂ[g(Y) - g(X)] ∈ ℂ by typecheck
    have part := complexAbs.im_le with difference
    rw (complexIm.sub with gY, gX) at part
    apply openBall.membership.backward
    have valueY := pathIm.value at g, Y with values, realY
    have valueX := pathIm.value at g, X with values, xReal
    refine ⟨(FunctionBetween.apply_closed with functionIm, realY), ?_⟩
    rw [valueY, valueX]
    unfold dist
    unfold realSubValue
    linarith

-- A continuous path has its integral.
theorem pathIntegral.spec (g : Set) (A B : Real)
  requires ordered : A ≤ B
  requires continuous : PathContinuousOn(g, A, B)
  shows HasPathIntegral(g, A, B, pathIntegral(g, A, B))
proof
  obtain ⟨reContinuous, imContinuous⟩ := PathContinuousOn.parts with
    continuous
  have reIntegral := riemannIntegral.continuous with ordered, reContinuous
  have imIntegral := riemannIntegral.continuous with ordered, imContinuous
  have member := pathIntegral.member at g, A, B
  have reSame : complexRe(pathIntegral(g, A, B)) =
      riemannIntegral(pathRe(g), A, B)
    unfold pathIntegral
    unfold complexRe
    rw fst.pair
  have imSame : complexIm(pathIntegral(g, A, B)) =
      riemannIntegral(pathIm(g), A, B)
    unfold pathIntegral
    unfold complexIm
    rw snd.pair
  refine ⟨continuous.left, member, ?_, ?_⟩
  . rw reSame
    exact reIntegral
  . rw imSame
    exact imIntegral

-- Integrals are linear.
theorem HasPathIntegral.scale (g h c : Set) (A B : Real) (I : Set)
  requires integral : HasPathIntegral(g, A, B, I)
  requires hc : c ∈ ℂ
  requires formula : ∀ X ∈ ℝ, h(X) = ℂ[c * g(X)]
  shows HasPathIntegral(h, A, B, ℂ[c * I])
proof
  obtain ⟨values, hI, reIntegral, imIntegral⟩ := integral
  have valuesH : ComplexValuedOn(h, ℝ)
    intros X hX
    rw (formula with X, hX)
    have gX := values with X, hX
    typecheck
  have product : ℂ[c * I] ∈ ℂ by typecheck
  have reC : complexRe(c) ∈ ℝ by typecheck
  have imC : complexIm(c) ∈ ℝ by typecheck
  have reI : complexRe(I) ∈ ℝ by typecheck
  have imI : complexIm(I) ∈ ℝ by typecheck
  have functionRe := pathRe.function with valuesH
  have functionIm := pathIm.function with valuesH
  refine ⟨valuesH, product, ?_, ?_⟩
  . have parts : ∀ X ∈ ℝ, pathRe(h)(X) = R[complexRe(c) * pathRe(g)(X) +
        -complexIm(c) * pathIm(g)(X)]
      intros X hX
      have gX := values with X, hX
      rw [(pathRe.value at h, X with valuesH, hX),
        (pathRe.value at g, X with values, hX),
        (pathIm.value at g, X with values, hX), (formula with X, hX),
        (complexRe.mul with hc, gX)]
      ring
    have combined := HasRiemannIntegral.combination with reIntegral,
      imIntegral, functionRe, parts
    rw (complexRe.mul with hc, hI)
    have same : R[complexRe(c) * complexRe(I) + -complexIm(c) *
        complexIm(I)] = R[complexRe(c) * complexRe(I) - complexIm(c) *
        complexIm(I)] by ring
    rwa same at combined
  . have parts : ∀ X ∈ ℝ, pathIm(h)(X) = R[complexIm(c) * pathRe(g)(X) +
        complexRe(c) * pathIm(g)(X)]
      intros X hX
      have gX := values with X, hX
      rw [(pathIm.value at h, X with valuesH, hX),
        (pathRe.value at g, X with values, hX),
        (pathIm.value at g, X with values, hX), (formula with X, hX),
        (complexIm.mul with hc, gX)]
      ring
    have combined := HasRiemannIntegral.combination with reIntegral,
      imIntegral, functionIm, parts
    rw (complexIm.mul with hc, hI)
    have same : R[complexIm(c) * complexRe(I) + complexRe(c) *
        complexIm(I)] = R[complexRe(c) * complexIm(I) + complexIm(c) *
        complexRe(I)] by ring
    rwa same at combined

theorem HasPathIntegral.add (g1 g2 h : Set) (A B : Real) (I1 I2 : Set)
  requires first : HasPathIntegral(g1, A, B, I1)
  requires second : HasPathIntegral(g2, A, B, I2)
  requires formula : ∀ X ∈ ℝ, h(X) = ℂ[g1(X) + g2(X)]
  shows HasPathIntegral(h, A, B, ℂ[I1 + I2])
proof
  obtain ⟨values1, hI1, re1, im1⟩ := first
  obtain ⟨values2, hI2, re2, im2⟩ := second
  have valuesH : ComplexValuedOn(h, ℝ)
    intros X hX
    rw (formula with X, hX)
    have g1X := values1 with X, hX
    have g2X := values2 with X, hX
    typecheck
  have sum : ℂ[I1 + I2] ∈ ℂ by typecheck
  have functionRe := pathRe.function with valuesH
  have functionIm := pathIm.function with valuesH
  refine ⟨valuesH, sum, ?_, ?_⟩
  . have parts : ∀ X ∈ ℝ, pathRe(h)(X) = R[1 * pathRe(g1)(X) +
        1 * pathRe(g2)(X)]
      intros X hX
      have g1X := values1 with X, hX
      have g2X := values2 with X, hX
      rw [(pathRe.value at h, X with valuesH, hX),
        (pathRe.value at g1, X with values1, hX),
        (pathRe.value at g2, X with values2, hX), (formula with X, hX),
        (complexRe.add with g1X, g2X)]
      ring
    have combined := HasRiemannIntegral.combination with re1, re2,
      functionRe, parts
    rw (complexRe.add with hI1, hI2)
    have same : R[1 * complexRe(I1) + 1 * complexRe(I2)] =
        R[complexRe(I1) + complexRe(I2)] by ring
    rwa same at combined
  . have parts : ∀ X ∈ ℝ, pathIm(h)(X) = R[1 * pathIm(g1)(X) +
        1 * pathIm(g2)(X)]
      intros X hX
      have g1X := values1 with X, hX
      have g2X := values2 with X, hX
      rw [(pathIm.value at h, X with valuesH, hX),
        (pathIm.value at g1, X with values1, hX),
        (pathIm.value at g2, X with values2, hX), (formula with X, hX),
        (complexIm.add with g1X, g2X)]
      ring
    have combined := HasRiemannIntegral.combination with im1, im2,
      functionIm, parts
    rw (complexIm.add with hI1, hI2)
    have same : R[1 * complexIm(I1) + 1 * complexIm(I2)] =
        R[complexIm(I1) + complexIm(I2)] by ring
    rwa same at combined

defgraph pathScale (c g : Set) (X ∈ ℝ) : complexCarrier := ℂ[c * g(X)]
requires hc : c ∈ complexCarrier
requires values : ComplexValuedOn(g, ℝ)
proof
  have gX := values with member
  typecheck

theorem HasPathIntegral.combination (g1 g2 h c1 c2 : Set) (A B : Real)
    (I1 I2 : Set)
  requires first : HasPathIntegral(g1, A, B, I1)
  requires second : HasPathIntegral(g2, A, B, I2)
  requires hc1 : c1 ∈ ℂ
  requires hc2 : c2 ∈ ℂ
  requires formula : ∀ X ∈ ℝ, h(X) = ℂ[c1 * g1(X) + c2 * g2(X)]
  shows HasPathIntegral(h, A, B, ℂ[c1 * I1 + c2 * I2])
proof
  have values1 := first.left
  have values2 := second.left
  have formula1 : ∀ X ∈ ℝ, pathScale(c1, g1)(X) = ℂ[c1 * g1(X)]
    intros X hX
    exact pathScale.value with hc1, values1, hX
  have formula2 : ∀ X ∈ ℝ, pathScale(c2, g2)(X) = ℂ[c2 * g2(X)]
    intros X hX
    exact pathScale.value with hc2, values2, hX
  have scaled1 := HasPathIntegral.scale with first, hc1, formula1
  have scaled2 := HasPathIntegral.scale with second, hc2, formula2
  have sum : ∀ X ∈ ℝ, h(X) = ℂ[pathScale(c1, g1)(X) + pathScale(c2, g2)(X)]
    intros X hX
    rw [(formula with X, hX), (formula1 with X, hX), (formula2 with X, hX)]
  exact HasPathIntegral.add with scaled1, scaled2, sum

theorem abs.le_of_two_sided (A B : Real)
  requires lower : R[-B] ≤ A
  requires upper : A ≤ B
  shows abs(A) ≤ B
proof
  have order := realLess.trichotomy at A, R[0]
  cases order with negative | rest
  . have nonpositive : A ≤ R[0] by linarith
    rw (abs.of_nonpositive at A with nonpositive)
    linarith
  . have nonnegative : R[0] ≤ A
      cases rest with zero | positive
      . linarith
      . linarith
    rw (abs.of_nonnegative at A with nonnegative)
    exact upper

-- The integral over a point is zero.
theorem HasPathIntegral.point (g : Set) (A : Real) (I : Set)
  requires integral : HasPathIntegral(g, A, A, I)
  shows I = ℂ[0]
proof
  obtain ⟨values, hI, reIntegral, imIntegral⟩ := integral
  have reZero := HasRiemannIntegral.unique_point with reIntegral,
    (HasRiemannIntegral.point with (pathRe.function with values))
  have imZero := HasRiemannIntegral.unique_point with imIntegral,
    (HasRiemannIntegral.point with (pathIm.function with values))
  rw [(complex.ext with hI), reZero, imZero]
  unfold complexZero
  rfl

-- |∫ g| ≤ 2 M (B − A) when |g| ≤ M on [A, B].
theorem HasPathIntegral.abs_le (g : Set) (A B M : Real) (I : Set)
  requires integral : HasPathIntegral(g, A, B, I)
  requires bound : ∀ X ∈ closedInterval(A, B), complexAbs(g(X)) ≤ M
  shows complexAbs(I) ≤ R[2 * (M * (B - A))]
proof
  have copy := integral
  obtain ⟨values, hI, reIntegral, imIntegral⟩ := integral
  have reCopy := reIntegral
  obtain ⟨_, ordered, _⟩ := reCopy
  have order := realLess.trichotomy at A, B
  cases order with smaller | rest
  . have lowerRe : ∀ X ∈ closedInterval(A, B), R[-M] ≤ pathRe(g)(X)
      intros X hX
      have xReal : X ∈ ℝ := closedInterval.subset_reals at A, B with X, hX
      have gX := values with X, xReal
      rw (pathRe.value at g, X with values, xReal)
      have part := complexAbs.re_le with gX
      have neg := abs.upper_neg at complexRe(g(X))
      have b := bound with X, hX
      linarith
    have upperRe : ∀ X ∈ closedInterval(A, B), pathRe(g)(X) ≤ M
      intros X hX
      have xReal : X ∈ ℝ := closedInterval.subset_reals at A, B with X, hX
      have gX := values with X, xReal
      rw (pathRe.value at g, X with values, xReal)
      have part := complexAbs.re_le with gX
      have pos := abs.upper at complexRe(g(X))
      have b := bound with X, hX
      linarith
    have lowerIm : ∀ X ∈ closedInterval(A, B), R[-M] ≤ pathIm(g)(X)
      intros X hX
      have xReal : X ∈ ℝ := closedInterval.subset_reals at A, B with X, hX
      have gX := values with X, xReal
      rw (pathIm.value at g, X with values, xReal)
      have part := complexAbs.im_le with gX
      have neg := abs.upper_neg at complexIm(g(X))
      have b := bound with X, hX
      linarith
    have upperIm : ∀ X ∈ closedInterval(A, B), pathIm(g)(X) ≤ M
      intros X hX
      have xReal : X ∈ ℝ := closedInterval.subset_reals at A, B with X, hX
      have gX := values with X, xReal
      rw (pathIm.value at g, X with values, xReal)
      have part := complexAbs.im_le with gX
      have pos := abs.upper at complexIm(g(X))
      have b := bound with X, hX
      linarith
    obtain ⟨reLow, reHigh⟩ := HasRiemannIntegral.between_constants with
      smaller, reIntegral, lowerRe, upperRe
    obtain ⟨imLow, imHigh⟩ := HasRiemannIntegral.between_constants with
      smaller, imIntegral, lowerIm, upperIm
    unfold realSubValue at reLow
    unfold realSubValue at reHigh
    unfold realSubValue at imLow
    unfold realSubValue at imHigh
    have negate : R[-M * (B - A)] = R[-(M * (B - A))] by ring
    rw negate at reLow
    rw negate at imLow
    have reBound : abs(complexRe(I)) ≤ R[M * (B - A)]
      apply abs.le_of_two_sided
      . linarith
      . linarith
    have imBound : abs(complexIm(I)) ≤ R[M * (B - A)]
      apply abs.le_of_two_sided
      . linarith
      . linarith
    have parts := complexAbs.le_parts with hI
    linarith
  . cases rest with equal | larger
    . rw equal at copy
      have zero := HasPathIntegral.point with copy
      rw [zero, complexAbs.zero, equal]
      have same : R[2 * (M * (B - B))] = R[0] by ring
      rw same
      exact realLe.reflexive at R[0]
    . exfalso
      linarith

theorem PathContinuousOn.mono (g : Set) (A B C D : Real)
  requires continuous : PathContinuousOn(g, A, B)
  requires lower : A ≤ C
  requires upper : D ≤ B
  shows PathContinuousOn(g, C, D)
proof
  obtain ⟨values, close⟩ := continuous
  have inside : ∀ X ∈ closedInterval(C, D), X ∈ closedInterval(A, B)
    intros X hX
    obtain ⟨xReal, low, high⟩ := closedInterval.membership.forward with hX
    apply closedInterval.membership.backward
    refine ⟨xReal, ?_, ?_⟩
    . linarith
    . linarith
  refine ⟨values, ?_⟩
  intros X hX e he positive
  obtain ⟨d, hd, dPositive, near⟩ := close with X, (inside with X, hX), e, he,
    positive
  refine ⟨d, hd, dPositive, ?_⟩
  intros Y hY small
  exact near with Y, (inside with Y, hY), small

-- A continuous path is bounded.
theorem PathContinuousOn.bounded (g : Set) (A B : Real)
  requires ordered : A ≤ B
  requires continuous : PathContinuousOn(g, A, B)
  shows ∃ M ∈ ℝ, ∀ X ∈ closedInterval(A, B), complexAbs(g(X)) ≤ M
proof
  have values := continuous.left
  obtain ⟨reContinuous, imContinuous⟩ := PathContinuousOn.parts with
    continuous
  obtain ⟨L1, hL1, U1, hU1, bounds1⟩ :=
    ContinuousOn.closed_interval_value_bounds with ordered, reContinuous
  obtain ⟨L2, hL2, U2, hU2, bounds2⟩ :=
    ContinuousOn.closed_interval_value_bounds with ordered, imContinuous
  have mReal : R[(abs(L1) + abs(U1)) + (abs(L2) + abs(U2))] ∈ ℝ by typecheck
  refine ⟨R[(abs(L1) + abs(U1)) + (abs(L2) + abs(U2))], mReal, ?_⟩
  intros X hX
  have xReal : X ∈ ℝ := closedInterval.subset_reals at A, B with X, hX
  have gX := values with X, xReal
  obtain ⟨low1, high1⟩ := bounds1 with X, hX
  obtain ⟨low2, high2⟩ := bounds2 with X, hX
  rw (pathRe.value at g, X with values, xReal) at low1
  rw (pathRe.value at g, X with values, xReal) at high1
  rw (pathIm.value at g, X with values, xReal) at low2
  rw (pathIm.value at g, X with values, xReal) at high2
  have reBound : abs(complexRe(g(X))) ≤ R[abs(L1) + abs(U1)]
    have a1 := abs.upper_neg at L1
    have a2 := abs.upper at U1
    have n1 := abs.nonnegative at L1
    have n2 := abs.nonnegative at U1
    apply abs.le_of_two_sided
    . linarith
    . linarith
  have imBound : abs(complexIm(g(X))) ≤ R[abs(L2) + abs(U2)]
    have a1 := abs.upper_neg at L2
    have a2 := abs.upper at U2
    have n1 := abs.nonnegative at L2
    have n2 := abs.nonnegative at U2
    apply abs.le_of_two_sided
    . linarith
    . linarith
  have parts := complexAbs.le_parts with gX
  linarith

-- ∫_A^C g + ∫_C^B g = ∫_A^B g.
theorem pathIntegral.add_interval (g : Set) (A C B : Real)
  requires left : A ≤ C
  requires right : C ≤ B
  requires continuous : PathContinuousOn(g, A, B)
  shows ℂ[pathIntegral(g, A, C) + pathIntegral(g, C, B)] =
    pathIntegral(g, A, B)
proof
  have values := continuous.left
  have ordered : A ≤ B by linarith
  have reflexiveA : A ≤ A by linarith
  have reflexiveB : B ≤ B by linarith
  have first := pathIntegral.spec with left,
    (PathContinuousOn.mono with continuous, reflexiveA, right)
  have second := pathIntegral.spec with right,
    (PathContinuousOn.mono with continuous, left, reflexiveB)
  obtain ⟨M, hM, bound⟩ := PathContinuousOn.bounded with ordered, continuous
  obtain ⟨_, member1, re1, im1⟩ := first
  obtain ⟨_, member2, re2, im2⟩ := second
  have reBound : ∀ X ∈ closedInterval(A, B), abs(pathRe(g)(X)) ≤ M
    intros X hX
    have xReal : X ∈ ℝ := closedInterval.subset_reals at A, B with X, hX
    rw (pathRe.value at g, X with values, xReal)
    have gX := values with X, xReal
    have part := complexAbs.re_le with gX
    have b := bound with X, hX
    linarith
  have imBound : ∀ X ∈ closedInterval(A, B), abs(pathIm(g)(X)) ≤ M
    intros X hX
    have xReal : X ∈ ℝ := closedInterval.subset_reals at A, B with X, hX
    rw (pathIm.value at g, X with values, xReal)
    have gX := values with X, xReal
    have part := complexAbs.im_le with gX
    have b := bound with X, hX
    linarith
  have reTotal := HasRiemannIntegral.add_adjacent with re1, re2, reBound
  have imTotal := HasRiemannIntegral.add_adjacent with im1, im2, imBound
  have sum : ℂ[pathIntegral(g, A, C) + pathIntegral(g, C, B)] ∈ ℂ by
    typecheck
  have total : HasPathIntegral(g, A, B,
      ℂ[pathIntegral(g, A, C) + pathIntegral(g, C, B)])
    refine ⟨values, sum, ?_, ?_⟩
    . rw (complexRe.add with member1, member2)
      exact reTotal
    . rw (complexIm.add with member1, member2)
      exact imTotal
  symm
  exact HasPathIntegral.eq with total

-- Section: Derivatives of paths and the fundamental theorem
-- A function whose increments are D h up to ε |h| near 0 has derivative D.
theorem HasDerivativeAt.of_linear_bound (f : Set) (D A : Real)
  requires function : f : ℝ → ℝ
  requires bound : ∀ e ∈ ℝ, R[0] < e → ∃ d ∈ ℝ, R[0] < d ∧
    (∀ H ∈ ℝ, H ≠ R[0] → abs(H) < d →
      abs(R[f(R[A + H]) - f(A) - D * H]) ≤ R[e * abs(H)])
  shows HasDerivativeAt(f, D, A)
proof
  have quotient := differenceQuotient.function at f, A with function
  unfold HasDerivativeAt
  refine ⟨function, ?_⟩
  unfold TendsToAt
  refine ⟨quotient, ?_⟩
  intros e realE positiveE
  have halfPositive := half.positive with positiveE
  have halfBelow := half.lt_self with positiveE
  have halfReal : half(e) ∈ ℝ by typecheck
  obtain ⟨d, dReal, dPositive, estimate⟩ := bound with half(e), halfReal,
    halfPositive
  witness d
  refine ⟨dReal, dPositive, ?_⟩
  intros x realX nonzero near
  obtain ⟨above, below⟩ := openBall.order_characterization.forward with near
  have distance : abs(x) < d
    have sign := realLess.trichotomy at x, R[0]
    cases sign with negative | rest
    . have nonpositive : x ≤ R[0] by linarith
      rw abs.of_nonpositive with nonpositive
      linarith
    . cases rest with zero | positiveX
      . exfalso
        exact nonzero with zero
      . have nonnegative : R[0] ≤ x by linarith
        rw abs.of_nonnegative with nonnegative
        linarith
  have small := estimate with realX, nonzero, distance
  rw differenceQuotient.value at f, A, x with function
  have product := realDiv.mul_right at realSubValue(f(R[A + x]), f(A)), x
    with nonzero
  have relation : R[R[realSubValue(f(R[A + x]), f(A)) / x - D] * x] =
      R[f(R[A + x]) - f(A) - D * x] by
    linear_combination product
  have absProduct := abs.mul at R[realSubValue(f(R[A + x]), f(A)) / x - D], x
  rw relation at absProduct
  have absPositive := abs.positive_of_ne with nonzero
  have chain : R[abs(R[realSubValue(f(R[A + x]), f(A)) / x - D]) * abs(x)] ≤
      R[half(e) * abs(x)]
    rw ← absProduct
    exact small
  have cancelled := realLe.mul_right_cancel_positive with absPositive, chain
  have close : abs(R[realSubValue(f(R[A + x]), f(A)) / x - D]) < e by linarith
  have upper := abs.upper at R[realSubValue(f(R[A + x]), f(A)) / x - D]
  have lower := abs.upper_neg at R[realSubValue(f(R[A + x]), f(A)) / x - D]
  have quotientReal : Real(realSubValue(f(R[A + x]), f(A)) / x) by typecheck
  have lowerBound : R[D - e] < realSubValue(f(R[A + x]), f(A)) / x by linarith
  have upperBound : realSubValue(f(R[A + x]), f(A)) / x < R[D + e] by linarith
  unfold realSubValue at lowerBound
  unfold realSubValue at upperBound
  apply openBall.order_characterization.backward
  unfold realSubValue
  exact ⟨lowerBound, upperBound⟩

-- φ has derivative D at X: |φ(Y) − φ(X) − D (Y − X)| ≤ ε |Y − X| near X.
predicate HasPathDerivative (φ D : Set) (X : Real) :=
  ComplexValuedOn(φ, ℝ) ∧ D ∈ complexCarrier ∧
  (∀ e ∈ ℝ, R[0] < e → ∃ d ∈ ℝ, R[0] < d ∧
    (∀ Y ∈ ℝ, abs(R[Y - X]) < d →
      complexAbs(ℂ[φ(Y) - φ(X) - D * complexOfReal(R[Y - X])]) ≤
        R[e * abs(R[Y - X])]))

theorem HasPathDerivative.parts (φ D : Set) (X : Real)
  requires derivative : HasPathDerivative(φ, D, X)
  shows HasDerivativeAt(pathRe(φ), complexRe(D), X) ∧
    HasDerivativeAt(pathIm(φ), complexIm(D), X)
proof
  obtain ⟨values, hD, close⟩ := derivative
  have xReal : X ∈ ℝ by typecheck
  have φX := values with X, xReal
  have reD : complexRe(D) ∈ ℝ by typecheck
  have imD : complexIm(D) ∈ ℝ by typecheck
  have reX : complexRe(φ(X)) ∈ ℝ by typecheck
  have imX : complexIm(φ(X)) ∈ ℝ by typecheck
  refine ⟨?_, ?_⟩
  . apply HasDerivativeAt.of_linear_bound with (pathRe.function with values)
    intros e he positive
    obtain ⟨d, hd, dPositive, near⟩ := close with e, he, positive
    refine ⟨d, hd, dPositive, ?_⟩
    intros H hH nonzero small
    have yReal : R[X + H] ∈ ℝ by typecheck
    have shift : R[R[X + H] - X] = H by ring
    have estimate := near with R[X + H], yReal
    rw shift at estimate
    have bound := estimate with small
    have φY := values with R[X + H], yReal
    have step : complexOfReal(H) ∈ ℂ by typecheck
    have error : ℂ[φ(R[X + H]) - φ(X) - D * complexOfReal(H)] ∈ ℂ by
      typecheck
    have part := complexAbs.re_le with error
    have expand : complexRe(ℂ[φ(R[X + H]) - φ(X) - D * complexOfReal(H)]) =
        R[complexRe(φ(R[X + H])) - complexRe(φ(X)) - complexRe(D) * H]
      have first : ℂ[φ(R[X + H]) - φ(X)] ∈ ℂ by typecheck
      have product : ℂ[D * complexOfReal(H)] ∈ ℂ by typecheck
      rw [(complexRe.sub with first, product), (complexRe.sub with φY, φX),
        (complexRe.mul with hD, step), complexOfReal.re, complexOfReal.im]
      ring
    rw expand at part
    rw [(pathRe.value at φ, R[X + H] with values, yReal),
      (pathRe.value at φ, X with values, xReal)]
    linarith
  . apply HasDerivativeAt.of_linear_bound with (pathIm.function with values)
    intros e he positive
    obtain ⟨d, hd, dPositive, near⟩ := close with e, he, positive
    refine ⟨d, hd, dPositive, ?_⟩
    intros H hH nonzero small
    have yReal : R[X + H] ∈ ℝ by typecheck
    have shift : R[R[X + H] - X] = H by ring
    have estimate := near with R[X + H], yReal
    rw shift at estimate
    have bound := estimate with small
    have φY := values with R[X + H], yReal
    have step : complexOfReal(H) ∈ ℂ by typecheck
    have error : ℂ[φ(R[X + H]) - φ(X) - D * complexOfReal(H)] ∈ ℂ by
      typecheck
    have part := complexAbs.im_le with error
    have expand : complexIm(ℂ[φ(R[X + H]) - φ(X) - D * complexOfReal(H)]) =
        R[complexIm(φ(R[X + H])) - complexIm(φ(X)) - complexIm(D) * H]
      have first : ℂ[φ(R[X + H]) - φ(X)] ∈ ℂ by typecheck
      have product : ℂ[D * complexOfReal(H)] ∈ ℂ by typecheck
      rw [(complexIm.sub with first, product), (complexIm.sub with φY, φX),
        (complexIm.mul with hD, step), complexOfReal.re, complexOfReal.im]
      ring
    rw expand at part
    rw [(pathIm.value at φ, R[X + H] with values, yReal),
      (pathIm.value at φ, X with values, xReal)]
    linarith

-- The fundamental theorem of calculus for paths.
theorem HasPathIntegral.of_derivative (φ ψ : Set) (A B : Real)
  requires ordered : A ≤ B
  requires continuousφ : PathContinuousOn(φ, A, B)
  requires continuousψ : PathContinuousOn(ψ, A, B)
  requires derivative : ∀ X ∈ ℝ, A < X → X < B →
    HasPathDerivative(φ, ψ(X), X)
  shows HasPathIntegral(ψ, A, B, ℂ[φ(B) - φ(A)])
proof
  have valuesφ := continuousφ.left
  have valuesψ := continuousψ.left
  obtain ⟨reφ, imφ⟩ := PathContinuousOn.parts with continuousφ
  obtain ⟨reψ, imψ⟩ := PathContinuousOn.parts with continuousψ
  have functionRe := pathRe.function with valuesψ
  have functionIm := pathIm.function with valuesψ
  have reDerivative : ∀ X ∈ ℝ, A < X → X < B →
      HasDerivativeAt(pathRe(φ), pathRe(ψ)(X), X)
    intros X hX left right
    have typedX : Real(X) by exact hX
    obtain ⟨first, _⟩ := HasPathDerivative.parts with
      (derivative with X, hX, left, right)
    rw (pathRe.value at ψ, X with valuesψ, hX)
    exact first
  have imDerivative : ∀ X ∈ ℝ, A < X → X < B →
      HasDerivativeAt(pathIm(φ), pathIm(ψ)(X), X)
    intros X hX left right
    have typedX : Real(X) by exact hX
    obtain ⟨_, second⟩ := HasPathDerivative.parts with
      (derivative with X, hX, left, right)
    rw (pathIm.value at ψ, X with valuesψ, hX)
    exact second
  have reIntegral := FTC.continuous_derivative at pathRe(ψ), pathRe(φ), A, B
    with ordered, reφ, reDerivative, reψ
  have imIntegral := FTC.continuous_derivative at pathIm(ψ), pathIm(φ), A, B
    with ordered, imφ, imDerivative, imψ
  have aReal : A ∈ ℝ by typecheck
  have bReal : B ∈ ℝ by typecheck
  have φA := valuesφ with A, aReal
  have φB := valuesφ with B, bReal
  have difference : ℂ[φ(B) - φ(A)] ∈ ℂ by typecheck
  refine ⟨valuesψ, difference, ?_, ?_⟩
  . rw (complexRe.sub with φB, φA)
    rw [(pathRe.value at φ, B with valuesφ, bReal),
      (pathRe.value at φ, A with valuesφ, aReal)] at reIntegral
    unfold realSubValue at reIntegral
    exact reIntegral
  . rw (complexIm.sub with φB, φA)
    rw [(pathIm.value at φ, B with valuesφ, bReal),
      (pathIm.value at φ, A with valuesφ, aReal)] at imIntegral
    unfold realSubValue at imIntegral
    exact imIntegral

-- Section: Rectangles
-- The point (X, Y) = X + iY of ℂ.
theorem complexPoint.eq (X Y : Real)
  shows (X, Y) = ℂ[complexOfReal(X) + complexImaginaryUnit * complexOfReal(Y)]
proof
  have xReal : X ∈ ℝ by typecheck
  have yReal : Y ∈ ℝ by typecheck
  rw [(complexOfReal.value at X with xReal), (complexOfReal.value at Y with yReal)]
  unfold complexImaginaryUnit
  rw [complexMul.pair, complexAdd.pair]
  have first : R[X + (0 * Y + -(1 * 0))] = X by ring
  have second : R[0 + (0 * 0 + 1 * Y)] = Y by ring
  rw [first, second]

theorem complexPoint.re (X Y : Real)
  shows complexRe((X, Y)) = X
proof
  unfold complexRe
  rw fst.pair

theorem complexPoint.im (X Y : Real)
  shows complexIm((X, Y)) = Y
proof
  unfold complexIm
  rw snd.pair

theorem complexPoint.dist (X Y P Q : Real)
  shows complexAbs(ℂ[(X, Y) - (P, Q)]) ≤
    R[abs(R[X - P]) + abs(R[Y - Q])]
proof
  have first := complexCarrier.pair at X, Y
  have second := complexCarrier.pair at P, Q
  have difference : ℂ[(X, Y) - (P, Q)] ∈ ℂ by typecheck
  have parts := complexAbs.le_parts with difference
  rw [(complexRe.sub with first, second), (complexIm.sub with first, second),
    complexPoint.re, complexPoint.re, complexPoint.im, complexPoint.im]
    at parts
  exact parts

-- The integrands along the horizontal line at height Y and the vertical
-- line through X: X ↦ f(X + iY) and Y ↦ i f(X + iY).
defgraph horizontalIntegrand (f : Set, Y : Real) (X ∈ ℝ) : complexCarrier :=
    f((X, Y))
requires values : ComplexValuedOn(f, complexCarrier)
proof
  have xReal : Real(X) by exact member
  exact values with (complexCarrier.pair at X, Y)

defgraph verticalValues (f : Set, X : Real) (Y ∈ ℝ) : complexCarrier :=
    f((X, Y))
requires values : ComplexValuedOn(f, complexCarrier)
proof
  have yReal : Real(Y) by exact member
  exact values with (complexCarrier.pair at X, Y)

defgraph verticalIntegrand (f : Set, X : Real) (Y ∈ ℝ) : complexCarrier :=
    ℂ[complexImaginaryUnit * f((X, Y))]
requires values : ComplexValuedOn(f, complexCarrier)
proof
  have yReal : Real(Y) by exact member
  have fz := values with (complexCarrier.pair at X, Y)
  have iMember := complexImaginaryUnit.member
  typecheck

-- ∫ f(X + iY) dX over [X₀, X₁], i ∫ f(X + iY) dY over [Y₀, Y₁], and the
-- integral around the boundary of the rectangle [X₀, X₁] × [Y₀, Y₁].
def horizontalIntegral (f : Set, X0 X1 Y : Real) : Set :=
  pathIntegral(horizontalIntegrand(f, Y), X0, X1)

def verticalIntegral (f : Set, X Y0 Y1 : Real) : Set :=
  pathIntegral(verticalIntegrand(f, X), Y0, Y1)

def rectIntegral (f : Set, X0 X1 Y0 Y1 : Real) : Set :=
  ℂ[(horizontalIntegral(f, X0, X1, Y0) + verticalIntegral(f, X1, Y0, Y1)) -
    (horizontalIntegral(f, X0, X1, Y1) + verticalIntegral(f, X0, Y0, Y1))]

predicate RectInside (V : Set) (X0 X1 Y0 Y1 : Real) :=
  ∀ X ∈ closedInterval(X0, X1), ∀ Y ∈ closedInterval(Y0, Y1), (X, Y) ∈ V

theorem horizontalIntegral.member (f : Set) (X0 X1 Y : Real)
  shows horizontalIntegral(f, X0, X1, Y) ∈ ℂ
proof
  unfold horizontalIntegral
  exact pathIntegral.member

theorem verticalIntegral.member (f : Set) (X Y0 Y1 : Real)
  shows verticalIntegral(f, X, Y0, Y1) ∈ ℂ
proof
  unfold verticalIntegral
  exact pathIntegral.member

theorem rectIntegral.member (f : Set) (X0 X1 Y0 Y1 : Real)
  shows rectIntegral(f, X0, X1, Y0, Y1) ∈ ℂ
proof
  have h0 := horizontalIntegral.member at f, X0, X1, Y0
  have h1 := horizontalIntegral.member at f, X0, X1, Y1
  have v0 := verticalIntegral.member at f, X0, Y0, Y1
  have v1 := verticalIntegral.member at f, X1, Y0, Y1
  unfold rectIntegral
  typecheck

-- Along a segment inside an open set where f is continuous, the
-- integrands are continuous.
theorem horizontalIntegrand.continuous (f V : Set) (X0 X1 Y : Real)
  requires values : ComplexValuedOn(f, complexCarrier)
  requires continuous : ComplexContinuousOn(f, V)
  requires inside : ∀ X ∈ closedInterval(X0, X1), (X, Y) ∈ V
  shows PathContinuousOn(horizontalIntegrand(f, Y), X0, X1)
proof
  obtain ⟨_, _, close⟩ := continuous
  have function := horizontalIntegrand.function at f, Y with values
  refine ⟨?_, ?_⟩
  . intros X hX
    exact FunctionBetween.apply_closed with function, hX
  intros X hX e he positive
  obtain ⟨d, hd, dPositive, near⟩ := close with (X, Y), (inside with X, hX),
    e, he, positive
  refine ⟨d, hd, dPositive, ?_⟩
  intros Z hZ small
  have xReal : X ∈ ℝ := closedInterval.subset_reals at X0, X1 with X, hX
  have zReal : Z ∈ ℝ := closedInterval.subset_reals at X0, X1 with Z, hZ
  have typedX : Real(X) by exact xReal
  have typedZ : Real(Z) by exact zReal
  rw [(horizontalIntegrand.value at f, Y, Z with values, zReal),
    (horizontalIntegrand.value at f, Y, X with values, xReal)]
  have distance := complexPoint.dist at Z, Y, X, Y
  have zero : R[Y - Y] = R[0] by ring
  rw [zero, abs.zero] at distance
  have pointZ := complexCarrier.pair at Z, Y
  have pointX := complexCarrier.pair at X, Y
  have closeEnough : complexAbs(ℂ[(Z, Y) - (X, Y)]) < d by linarith
  exact near with (Z, Y), (inside with Z, hZ), closeEnough

theorem verticalIntegrand.continuous (f V : Set) (X Y0 Y1 : Real)
  requires values : ComplexValuedOn(f, complexCarrier)
  requires continuous : ComplexContinuousOn(f, V)
  requires inside : ∀ Y ∈ closedInterval(Y0, Y1), (X, Y) ∈ V
  shows PathContinuousOn(verticalIntegrand(f, X), Y0, Y1)
proof
  obtain ⟨_, _, close⟩ := continuous
  have function := verticalIntegrand.function at f, X with values
  refine ⟨?_, ?_⟩
  . intros Y hY
    exact FunctionBetween.apply_closed with function, hY
  intros Y hY e he positive
  obtain ⟨d, hd, dPositive, near⟩ := close with (X, Y), (inside with Y, hY),
    e, he, positive
  refine ⟨d, hd, dPositive, ?_⟩
  intros Z hZ small
  have yReal : Y ∈ ℝ := closedInterval.subset_reals at Y0, Y1 with Y, hY
  have zReal : Z ∈ ℝ := closedInterval.subset_reals at Y0, Y1 with Z, hZ
  have typedY : Real(Y) by exact yReal
  have typedZ : Real(Z) by exact zReal
  rw [(verticalIntegrand.value at f, X, Z with values, zReal),
    (verticalIntegrand.value at f, X, Y with values, yReal)]
  have distance := complexPoint.dist at X, Z, X, Y
  have zero : R[X - X] = R[0] by ring
  rw [zero, abs.zero] at distance
  have pointZ := complexCarrier.pair at X, Z
  have pointY := complexCarrier.pair at X, Y
  have closeEnough : complexAbs(ℂ[(X, Z) - (X, Y)]) < d by linarith
  have bound := near with (X, Z), (inside with Z, hZ), closeEnough
  have fZ := values with (X, Z), pointZ
  have fY := values with (X, Y), pointY
  have iMember := complexImaginaryUnit.member
  have difference : ℂ[f((X, Z)) - f((X, Y))] ∈ ℂ by typecheck
  have factor : ℂ[complexImaginaryUnit * f((X, Z)) -
      complexImaginaryUnit * f((X, Y))] =
      ℂ[complexImaginaryUnit * (f((X, Z)) - f((X, Y)))] by ring
  rw [factor, (complexAbs.mul with iMember, difference), complexAbs.imaginary]
  have one : R[1 * complexAbs(ℂ[f((X, Z)) - f((X, Y))])] =
    complexAbs(ℂ[f((X, Z)) - f((X, Y))]) by ring
  rw one
  exact bound

theorem RectInside.horizontal (V : Set) (X0 X1 Y0 Y1 Y : Real)
  requires inside : RectInside(V, X0, X1, Y0, Y1)
  requires hY : Y ∈ closedInterval(Y0, Y1)
  shows ∀ X ∈ closedInterval(X0, X1), (X, Y) ∈ V
proof
  intros X hX
  exact inside with X, hX, Y, hY

theorem RectInside.vertical (V : Set) (X0 X1 Y0 Y1 X : Real)
  requires inside : RectInside(V, X0, X1, Y0, Y1)
  requires hX : X ∈ closedInterval(X0, X1)
  shows ∀ Y ∈ closedInterval(Y0, Y1), (X, Y) ∈ V
proof
  intros Y hY
  exact inside with X, hX, Y, hY

theorem closedInterval.left_end (A B : Real)
  requires ordered : A ≤ B
  shows A ∈ closedInterval(A, B)
proof
  apply closedInterval.membership.backward
  have aReal : A ∈ ℝ by typecheck
  refine ⟨aReal, ?_, ordered⟩
  linarith

theorem closedInterval.right_end (A B : Real)
  requires ordered : A ≤ B
  shows B ∈ closedInterval(A, B)
proof
  apply closedInterval.membership.backward
  have bReal : B ∈ ℝ by typecheck
  refine ⟨bReal, ordered, ?_⟩
  linarith

theorem RectInside.sub (V : Set) (X0 X1 Y0 Y1 P0 P1 Q0 Q1 : Real)
  requires inside : RectInside(V, X0, X1, Y0, Y1)
  requires left : X0 ≤ P0
  requires right : P1 ≤ X1
  requires bottom : Y0 ≤ Q0
  requires top : Q1 ≤ Y1
  shows RectInside(V, P0, P1, Q0, Q1)
proof
  intros X hX Y hY
  obtain ⟨xReal, xLow, xHigh⟩ := closedInterval.membership.forward with hX
  obtain ⟨yReal, yLow, yHigh⟩ := closedInterval.membership.forward with hY
  have xIn : X ∈ closedInterval(X0, X1)
    apply closedInterval.membership.backward
    refine ⟨xReal, ?_, ?_⟩
    . linarith
    . linarith
  have yIn : Y ∈ closedInterval(Y0, Y1)
    apply closedInterval.membership.backward
    refine ⟨yReal, ?_, ?_⟩
    . linarith
    . linarith
  exact inside with X, xIn, Y, yIn

-- Cutting a rectangle by a vertical or a horizontal line.
theorem rectIntegral.split_x (f V : Set) (X0 Xm X1 Y0 Y1 : Real)
  requires values : ComplexValuedOn(f, complexCarrier)
  requires continuous : ComplexContinuousOn(f, V)
  requires inside : RectInside(V, X0, X1, Y0, Y1)
  requires left : X0 ≤ Xm
  requires right : Xm ≤ X1
  requires vertical : Y0 ≤ Y1
  shows rectIntegral(f, X0, X1, Y0, Y1) =
    ℂ[rectIntegral(f, X0, Xm, Y0, Y1) + rectIntegral(f, Xm, X1, Y0, Y1)]
proof
  have bottom := horizontalIntegrand.continuous with values, continuous,
    (RectInside.horizontal with inside, (closedInterval.left_end with vertical))
  have top := horizontalIntegrand.continuous with values, continuous,
    (RectInside.horizontal with inside,
      (closedInterval.right_end with vertical))
  have splitBottom := pathIntegral.add_interval with left, right, bottom
  have splitTop := pathIntegral.add_interval with left, right, top
  have h00 := horizontalIntegral.member at f, X0, Xm, Y0
  have h01 := horizontalIntegral.member at f, X0, Xm, Y1
  have h10 := horizontalIntegral.member at f, Xm, X1, Y0
  have h11 := horizontalIntegral.member at f, Xm, X1, Y1
  have v0 := verticalIntegral.member at f, X0, Y0, Y1
  have vm := verticalIntegral.member at f, Xm, Y0, Y1
  have v1 := verticalIntegral.member at f, X1, Y0, Y1
  unfold rectIntegral
  unfold horizontalIntegral
  unfold horizontalIntegral at h00
  unfold horizontalIntegral at h01
  unfold horizontalIntegral at h10
  unfold horizontalIntegral at h11
  rw [← splitBottom, ← splitTop]
  ring

theorem rectIntegral.split_y (f V : Set) (X0 X1 Y0 Ym Y1 : Real)
  requires values : ComplexValuedOn(f, complexCarrier)
  requires continuous : ComplexContinuousOn(f, V)
  requires inside : RectInside(V, X0, X1, Y0, Y1)
  requires bottom : Y0 ≤ Ym
  requires top : Ym ≤ Y1
  requires horizontal : X0 ≤ X1
  shows rectIntegral(f, X0, X1, Y0, Y1) =
    ℂ[rectIntegral(f, X0, X1, Y0, Ym) + rectIntegral(f, X0, X1, Ym, Y1)]
proof
  have leftSide := verticalIntegrand.continuous with values, continuous,
    (RectInside.vertical with inside,
      (closedInterval.left_end with horizontal))
  have rightSide := verticalIntegrand.continuous with values, continuous,
    (RectInside.vertical with inside,
      (closedInterval.right_end with horizontal))
  have splitLeft := pathIntegral.add_interval with bottom, top, leftSide
  have splitRight := pathIntegral.add_interval with bottom, top, rightSide
  have h0 := horizontalIntegral.member at f, X0, X1, Y0
  have hm := horizontalIntegral.member at f, X0, X1, Ym
  have h1 := horizontalIntegral.member at f, X0, X1, Y1
  have v00 := verticalIntegral.member at f, X0, Y0, Ym
  have v01 := verticalIntegral.member at f, X0, Ym, Y1
  have v10 := verticalIntegral.member at f, X1, Y0, Ym
  have v11 := verticalIntegral.member at f, X1, Ym, Y1
  unfold rectIntegral
  unfold verticalIntegral
  unfold verticalIntegral at v00
  unfold verticalIntegral at v01
  unfold verticalIntegral at v10
  unfold verticalIntegral at v11
  rw [← splitLeft, ← splitRight]
  ring

-- |∮ f| ≤ 4 M (width + height) around a rectangle on which |f| ≤ M.
theorem horizontalIntegral.abs_le (f V : Set) (X0 X1 Y M : Real)
  requires values : ComplexValuedOn(f, complexCarrier)
  requires continuous : ComplexContinuousOn(f, V)
  requires inside : ∀ X ∈ closedInterval(X0, X1), (X, Y) ∈ V
  requires ordered : X0 ≤ X1
  requires bound : ∀ X ∈ closedInterval(X0, X1), complexAbs(f((X, Y))) ≤ M
  shows complexAbs(horizontalIntegral(f, X0, X1, Y)) ≤
    R[2 * (M * (X1 - X0))]
proof
  have integral := pathIntegral.spec with ordered,
    (horizontalIntegrand.continuous with values, continuous, inside)
  have pointwise : ∀ X ∈ closedInterval(X0, X1),
      complexAbs(horizontalIntegrand(f, Y)(X)) ≤ M
    intros X hX
    have xReal : X ∈ ℝ := closedInterval.subset_reals at X0, X1 with X, hX
    rw (horizontalIntegrand.value at f, Y, X with values, xReal)
    exact bound with X, hX
  unfold horizontalIntegral
  exact HasPathIntegral.abs_le with integral, pointwise

theorem verticalIntegral.abs_le (f V : Set) (X Y0 Y1 M : Real)
  requires values : ComplexValuedOn(f, complexCarrier)
  requires continuous : ComplexContinuousOn(f, V)
  requires inside : ∀ Y ∈ closedInterval(Y0, Y1), (X, Y) ∈ V
  requires ordered : Y0 ≤ Y1
  requires bound : ∀ Y ∈ closedInterval(Y0, Y1), complexAbs(f((X, Y))) ≤ M
  shows complexAbs(verticalIntegral(f, X, Y0, Y1)) ≤
    R[2 * (M * (Y1 - Y0))]
proof
  have integral := pathIntegral.spec with ordered,
    (verticalIntegrand.continuous with values, continuous, inside)
  have iMember := complexImaginaryUnit.member
  have pointwise : ∀ Y ∈ closedInterval(Y0, Y1),
      complexAbs(verticalIntegrand(f, X)(Y)) ≤ M
    intros Y hY
    have yReal : Y ∈ ℝ := closedInterval.subset_reals at Y0, Y1 with Y, hY
    have typedY : Real(Y) by exact yReal
    have fY := values with (X, Y), (complexCarrier.pair at X, Y)
    rw [(verticalIntegrand.value at f, X, Y with values, yReal),
      (complexAbs.mul with iMember, fY), complexAbs.imaginary]
    have b := bound with Y, hY
    have one : R[1 * complexAbs(f((X, Y)))] = complexAbs(f((X, Y))) by ring
    rw one
    exact b
  unfold verticalIntegral
  exact HasPathIntegral.abs_le with integral, pointwise

theorem rectIntegral.abs_le (f V : Set) (X0 X1 Y0 Y1 M : Real)
  requires values : ComplexValuedOn(f, complexCarrier)
  requires continuous : ComplexContinuousOn(f, V)
  requires inside : RectInside(V, X0, X1, Y0, Y1)
  requires horizontal : X0 ≤ X1
  requires vertical : Y0 ≤ Y1
  requires bound : ∀ X ∈ closedInterval(X0, X1),
    ∀ Y ∈ closedInterval(Y0, Y1), complexAbs(f((X, Y))) ≤ M
  shows complexAbs(rectIntegral(f, X0, X1, Y0, Y1)) ≤
    R[4 * (M * ((X1 - X0) + (Y1 - Y0)))]
proof
  have y0In := closedInterval.left_end with vertical
  have y1In := closedInterval.right_end with vertical
  have x0In := closedInterval.left_end with horizontal
  have x1In := closedInterval.right_end with horizontal
  have boundH : ∀ Y ∈ closedInterval(Y0, Y1), ∀ X ∈ closedInterval(X0, X1),
      complexAbs(f((X, Y))) ≤ M
    intros Y hY X hX
    exact bound with X, hX, Y, hY
  have b0 := horizontalIntegral.abs_le with values, continuous,
    (RectInside.horizontal with inside, y0In), horizontal, (boundH with Y0, y0In)
  have b1 := horizontalIntegral.abs_le with values, continuous,
    (RectInside.horizontal with inside, y1In), horizontal, (boundH with Y1, y1In)
  have c0 := verticalIntegral.abs_le with values, continuous,
    (RectInside.vertical with inside, x0In), vertical, (bound with X0, x0In)
  have c1 := verticalIntegral.abs_le with values, continuous,
    (RectInside.vertical with inside, x1In), vertical, (bound with X1, x1In)
  have h0 := horizontalIntegral.member at f, X0, X1, Y0
  have h1 := horizontalIntegral.member at f, X0, X1, Y1
  have v0 := verticalIntegral.member at f, X0, Y0, Y1
  have v1 := verticalIntegral.member at f, X1, Y0, Y1
  have firstSum : ℂ[horizontalIntegral(f, X0, X1, Y0) +
    verticalIntegral(f, X1, Y0, Y1)] ∈ ℂ by typecheck
  have secondSum : ℂ[horizontalIntegral(f, X0, X1, Y1) +
    verticalIntegral(f, X0, Y0, Y1)] ∈ ℂ by typecheck
  have outer := complexAbs.sub_le with firstSum, secondSum
  have t1 := complexAbs.triangle with h0, v1
  have t2 := complexAbs.triangle with h1, v0
  have expand : R[4 * (M * ((X1 - X0) + (Y1 - Y0)))] =
      R[2 * (M * (X1 - X0)) + 2 * (M * (X1 - X0)) + 2 * (M * (Y1 - Y0)) +
        2 * (M * (Y1 - Y0))] by ring
  unfold rectIntegral
  rw expand
  linarith

-- Section: Paths through holomorphic functions
theorem complexOfReal.sub (a b : Real)
  shows complexOfReal(R[a - b]) = ℂ[complexOfReal(a) - complexOfReal(b)]
proof
  have negB : R[-b] ∈ ℝ by typecheck
  rw [complexOfReal.add, complexOfReal.neg]
  have aMember : complexOfReal(a) ∈ ℂ by typecheck
  have bMember : complexOfReal(b) ∈ ℂ by typecheck
  ring

-- The chain rule along a path: (G ∘ γ)′ = G′(γ) γ′.
theorem HasPathDerivative.comp (G V γ φ D v : Set) (X : Real)
  requires derivative : HasComplexDerivativeAt(G, V, D, γ(X))
  requires path : HasPathDerivative(γ, v, X)
  requires inside : ∀ Y ∈ ℝ, γ(Y) ∈ V
  requires formula : ∀ Y ∈ ℝ, φ(Y) = G(γ(Y))
  shows HasPathDerivative(φ, ℂ[D * v], X)
proof
  obtain ⟨isOpen, hγX, hD, valuesG, closeG⟩ := derivative
  obtain ⟨valuesγ, hv, closeγ⟩ := path
  have xReal : X ∈ ℝ by typecheck
  have sub := ComplexOpen.subset with isOpen
  have γX := valuesγ with X, xReal
  have GγX := valuesG with γ(X), hγX
  have valuesφ : ComplexValuedOn(φ, ℝ)
    intros Y hY
    rw (formula with Y, hY)
    exact valuesG with γ(Y), (inside with Y, hY)
  have product : ℂ[D * v] ∈ ℂ by typecheck
  refine ⟨valuesφ, product, ?_⟩
  intros e he positive
  have halfPositive := half.positive with positive
  have halfReal : half(e) ∈ ℝ by typecheck
  have absV := complexAbs.nonnegative with hv
  have absD := complexAbs.nonnegative with hD
  have kReal : R[1 + complexAbs(v)] ∈ ℝ by typecheck
  have kPositive : R[0] < R[1 + complexAbs(v)] by linarith
  have kNonnegative : R[0] ≤ R[1 + complexAbs(v)] by linarith
  have dAbsReal : complexAbs(D) ∈ ℝ by typecheck
  obtain ⟨εG, hεG, εGPositive, scaledG, _⟩ := realScale.absorb with kReal,
    halfReal, kNonnegative, halfPositive
  obtain ⟨εγ, hεγ, εγPositive, scaledγ, _⟩ := realScale.absorb with dAbsReal,
    halfReal, absD, halfPositive
  obtain ⟨δ, hδ, δPositive, nearG⟩ := closeG with εG, hεG, εGPositive
  obtain ⟨t, ht, tPositive, scaledT, _⟩ := realScale.absorb with kReal, hδ,
    kNonnegative, δPositive
  have one : R[1] ∈ ℝ by typecheck
  have onePositive : R[0] < R[1] by linarith
  obtain ⟨d1, hd1, d1Positive, near1⟩ := closeγ with R[1], one, onePositive
  obtain ⟨d2, hd2, d2Positive, near2⟩ := closeγ with εγ, hεγ, εγPositive
  obtain ⟨d3, hd3, d3Positive, le1, le2⟩ := realRadius.common with hd1, hd2,
    d1Positive, d2Positive
  obtain ⟨d, hd, dPositive, le3, le4⟩ := realRadius.common with hd3, ht,
    d3Positive, tPositive
  refine ⟨d, hd, dPositive, ?_⟩
  intros Y hY small
  have typedY : Real(Y) by exact hY
  have γY := valuesγ with Y, hY
  have step : complexOfReal(R[Y - X]) ∈ ℂ by typecheck
  have absStep := abs.nonnegative at R[Y - X]
  have small1 : abs(R[Y - X]) < d1 by linarith
  have small2 : abs(R[Y - X]) < d2 by linarith
  have first := near1 with Y, hY, small1
  have second := near2 with Y, hY, small2
  -- |γ(Y) − γ(X)| ≤ (1 + |v|) |Y − X| < δ.
  have linear : ℂ[v * complexOfReal(R[Y - X])] ∈ ℂ by typecheck
  have errorγ : ℂ[γ(Y) - γ(X) - v * complexOfReal(R[Y - X])] ∈ ℂ by
    typecheck
  have split : ℂ[γ(Y) - γ(X)] =
      ℂ[(γ(Y) - γ(X) - v * complexOfReal(R[Y - X])) +
        v * complexOfReal(R[Y - X])] by ring
  have triangle := complexAbs.triangle with errorγ, linear
  rw ← split at triangle
  rw [(complexAbs.mul with hv, step), complexAbs.of_real] at triangle
  have expandK : R[(1 + complexAbs(v)) * abs(R[Y - X])] =
      R[1 * abs(R[Y - X]) + complexAbs(v) * abs(R[Y - X])] by ring
  have moved : complexAbs(ℂ[γ(Y) - γ(X)]) ≤
      R[(1 + complexAbs(v)) * abs(R[Y - X])]
    rw expandK
    linarith
  have smallT : abs(R[Y - X]) < t by linarith
  have scaledStep := realLess.mul_left_of_positive with smallT, kPositive
  have closeγX : complexAbs(ℂ[γ(Y) - γ(X)]) < δ by linarith
  have boundG := nearG with γ(Y), (inside with Y, hY), closeγX
  -- Combine the two errors.
  have GγY := valuesG with γ(Y), (inside with Y, hY)
  have errorG : ℂ[G(γ(Y)) - G(γ(X)) - D * (γ(Y) - γ(X))] ∈ ℂ by typecheck
  have scaledError : ℂ[D * (γ(Y) - γ(X) - v * complexOfReal(R[Y - X]))] ∈ ℂ
    by typecheck
  have combine : ℂ[φ(Y) - φ(X) - D * v * complexOfReal(R[Y - X])] =
      ℂ[(G(γ(Y)) - G(γ(X)) - D * (γ(Y) - γ(X))) +
        D * (γ(Y) - γ(X) - v * complexOfReal(R[Y - X]))]
    rw [(formula with Y, hY), (formula with X, xReal)]
    ring
  rw combine
  have total := complexAbs.triangle with errorG, scaledError
  rw (complexAbs.mul with hD, errorγ) at total
  have εGNonnegative : R[0] ≤ εG by linarith
  have term1 := realLe.mul_left_of_nonnegative with moved, εGNonnegative
  have term2 := realLe.mul_left_of_nonnegative with second, absD
  have stepScaled1 := realLe.mul_right_of_nonnegative with scaledG, absStep
  have stepScaled2 := realLe.mul_right_of_nonnegative with scaledγ, absStep
  have regroup1 : R[εG * ((1 + complexAbs(v)) * abs(R[Y - X]))] =
      R[((1 + complexAbs(v)) * εG) * abs(R[Y - X])] by ring
  have regroup2 : R[complexAbs(D) * (εγ * abs(R[Y - X]))] =
      R[(complexAbs(D) * εγ) * abs(R[Y - X])] by ring
  have twice := half.add_self at e
  have halves : R[half(e) * abs(R[Y - X]) + half(e) * abs(R[Y - X])] =
      R[(half(e) + half(e)) * abs(R[Y - X])] by ring
  have expandE : R[e * abs(R[Y - X])] =
      R[(half(e) + half(e)) * abs(R[Y - X])]
    rw twice
  linarith

-- A path differentiable at every point of [A, B] is continuous there.
theorem HasPathDerivative.continuous_on (φ ψ : Set) (A B : Real)
  requires values : ComplexValuedOn(φ, ℝ)
  requires derivative : ∀ X ∈ closedInterval(A, B),
    HasPathDerivative(φ, ψ(X), X)
  shows PathContinuousOn(φ, A, B)
proof
  refine ⟨values, ?_⟩
  intros X hX e he positive
  have xReal : X ∈ ℝ := closedInterval.subset_reals at A, B with X, hX
  have typedX : Real(X) by exact xReal
  obtain ⟨_, hD, close⟩ := derivative with X, hX
  have one : R[1] ∈ ℝ by typecheck
  have onePositive : R[0] < R[1] by linarith
  obtain ⟨d1, hd1, d1Positive, near⟩ := close with R[1], one, onePositive
  have absD := complexAbs.nonnegative with hD
  have kReal : R[1 + complexAbs(ψ(X))] ∈ ℝ by typecheck
  have kPositive : R[0] < R[1 + complexAbs(ψ(X))] by linarith
  have kNonnegative : R[0] ≤ R[1 + complexAbs(ψ(X))] by linarith
  obtain ⟨t, ht, tPositive, scaled, _⟩ := realScale.absorb with kReal, he,
    kNonnegative, positive
  obtain ⟨d, hd, dPositive, le1, le2⟩ := realRadius.common with hd1, ht,
    d1Positive, tPositive
  refine ⟨d, hd, dPositive, ?_⟩
  intros Y hY small
  have yReal : Y ∈ ℝ := closedInterval.subset_reals at A, B with Y, hY
  have typedY : Real(Y) by exact yReal
  have small1 : abs(R[Y - X]) < d1 by linarith
  have bound := near with Y, yReal, small1
  have φX := values with X, xReal
  have φY := values with Y, yReal
  have step : complexOfReal(R[Y - X]) ∈ ℂ by typecheck
  have linear : ℂ[ψ(X) * complexOfReal(R[Y - X])] ∈ ℂ by typecheck
  have error : ℂ[φ(Y) - φ(X) - ψ(X) * complexOfReal(R[Y - X])] ∈ ℂ by
    typecheck
  have split : ℂ[φ(Y) - φ(X)] =
      ℂ[(φ(Y) - φ(X) - ψ(X) * complexOfReal(R[Y - X])) +
        ψ(X) * complexOfReal(R[Y - X])] by ring
  have triangle := complexAbs.triangle with error, linear
  rw ← split at triangle
  rw [(complexAbs.mul with hD, step), complexAbs.of_real] at triangle
  have smallT : abs(R[Y - X]) < t by linarith
  have scaledStep := realLess.mul_left_of_positive with smallT, kPositive
  have expandK : R[(1 + complexAbs(ψ(X))) * abs(R[Y - X])] =
      R[1 * abs(R[Y - X]) + complexAbs(ψ(X)) * abs(R[Y - X])] by ring
  linarith

-- The horizontal and vertical lines X ↦ X + iY and Y ↦ X + iY.
defgraph horizontalPath (Y : Real) (X ∈ ℝ) : complexCarrier := (X, Y)
proof
  have xReal : Real(X) by exact member
  exact complexCarrier.pair at X, Y

defgraph verticalPath (X : Real) (Y ∈ ℝ) : complexCarrier := (X, Y)
proof
  have yReal : Real(Y) by exact member
  exact complexCarrier.pair at X, Y

theorem horizontalPath.derivative (Y X : Real)
  shows HasPathDerivative(horizontalPath(Y), ℂ[1], X)
proof
  have function := horizontalPath.function at Y
  have values : ComplexValuedOn(horizontalPath(Y), ℝ)
    intros Z hZ
    exact FunctionBetween.apply_closed with function, hZ
  have oneMember : ℂ[1] ∈ ℂ by typecheck
  refine ⟨values, oneMember, ?_⟩
  intros e he positive
  refine ⟨e, he, positive, ?_⟩
  intros Z hZ small
  have typedZ : Real(Z) by exact hZ
  have xReal : X ∈ ℝ by typecheck
  rw [(horizontalPath.value at Y, Z with hZ),
    (horizontalPath.value at Y, X with xReal), complexPoint.eq,
    complexPoint.eq, complexOfReal.sub]
  have iMember := complexImaginaryUnit.member
  have zMember : complexOfReal(Z) ∈ ℂ by typecheck
  have xMember : complexOfReal(X) ∈ ℂ by typecheck
  have yMember : complexOfReal(Y) ∈ ℂ by typecheck
  have zero : ℂ[(complexOfReal(Z) + complexImaginaryUnit * complexOfReal(Y)) -
      (complexOfReal(X) + complexImaginaryUnit * complexOfReal(Y)) -
      1 * (complexOfReal(Z) - complexOfReal(X))] = ℂ[0] by ring
  rw [zero, complexAbs.zero]
  have absStep := abs.nonnegative at R[Z - X]
  have product := realLe.mul_left_of_nonnegative with absStep,
    (realLess.implies_le with positive)
  have zeroProduct : R[e * 0] = R[0] by ring
  linarith

theorem verticalPath.derivative (X Y : Real)
  shows HasPathDerivative(verticalPath(X), complexImaginaryUnit, Y)
proof
  have function := verticalPath.function at X
  have values : ComplexValuedOn(verticalPath(X), ℝ)
    intros Z hZ
    exact FunctionBetween.apply_closed with function, hZ
  have iMember := complexImaginaryUnit.member
  refine ⟨values, iMember, ?_⟩
  intros e he positive
  refine ⟨e, he, positive, ?_⟩
  intros Z hZ small
  have typedZ : Real(Z) by exact hZ
  have yReal : Y ∈ ℝ by typecheck
  rw [(verticalPath.value at X, Z with hZ),
    (verticalPath.value at X, Y with yReal), complexPoint.eq,
    complexPoint.eq, complexOfReal.sub]
  have zMember : complexOfReal(Z) ∈ ℂ by typecheck
  have xMember : complexOfReal(X) ∈ ℂ by typecheck
  have yMember : complexOfReal(Y) ∈ ℂ by typecheck
  have zero : ℂ[(complexOfReal(X) + complexImaginaryUnit * complexOfReal(Z)) -
      (complexOfReal(X) + complexImaginaryUnit * complexOfReal(Y)) -
      complexImaginaryUnit * (complexOfReal(Z) - complexOfReal(Y))] = ℂ[0]
    by ring
  rw [zero, complexAbs.zero]
  have absStep := abs.nonnegative at R[Z - Y]
  have product := realLe.mul_left_of_nonnegative with absStep,
    (realLess.implies_le with positive)
  have zeroProduct : R[e * 0] = R[0] by ring
  linarith

-- A function whose increments are A (u − w) up to K |u − w|² is
-- differentiable at w with derivative A.
theorem HasComplexDerivativeAt.of_quadratic (G V A w K : Set)
  requires isOpen : ComplexOpen(V)
  requires hw : w ∈ V
  requires hA : A ∈ ℂ
  requires values : ComplexValuedOn(G, V)
  requires hK : K ∈ ℝ
  requires nonnegative : R[0] ≤ K
  requires bound : ∀ u ∈ V, complexAbs(ℂ[G(u) - G(w) - A * (u - w)]) ≤
    R[K * (complexAbs(ℂ[u - w]) * complexAbs(ℂ[u - w]))]
  shows HasComplexDerivativeAt(G, V, A, w)
proof
  refine ⟨isOpen, hw, hA, values, ?_⟩
  intros e he positive
  obtain ⟨d, hd, dPositive, scaled, _⟩ := realScale.absorb with hK, he,
    nonnegative, positive
  refine ⟨d, hd, dPositive, ?_⟩
  intros u hu small
  have sub := ComplexOpen.subset with isOpen
  have uMember := sub with u, hu
  have wMember := sub with w, hw
  have difference : ℂ[u - w] ∈ ℂ by typecheck
  have absDiff := complexAbs.nonnegative with difference
  have b := bound with u, hu
  have Gu := values with u, hu
  have Gw := values with w, hw
  have weak : complexAbs(ℂ[u - w]) ≤ d by linarith
  have step := realLe.mul_left_of_nonnegative with weak, nonnegative
  have step2 := realLe.mul_right_of_nonnegative with step, absDiff
  have step3 := realLe.mul_right_of_nonnegative with scaled, absDiff
  have regroup : R[K * (complexAbs(ℂ[u - w]) * complexAbs(ℂ[u - w]))] =
      R[(K * complexAbs(ℂ[u - w])) * complexAbs(ℂ[u - w])] by ring
  linarith

-- The fundamental theorem along the sides of a rectangle.
theorem horizontalIntegral.of_derivative (G g : Set) (X0 X1 Y : Real)
  requires valuesG : ComplexValuedOn(G, complexCarrier)
  requires valuesg : ComplexValuedOn(g, complexCarrier)
  requires derivative : ∀ w ∈ ℂ, HasComplexDerivativeAt(G, ℂ, g(w), w)
  requires continuous : ComplexContinuousOn(g, ℂ)
  requires ordered : X0 ≤ X1
  shows horizontalIntegral(g, X0, X1, Y) = ℂ[G((X1, Y)) - G((X0, Y))]
proof
  have everywhere : ∀ X ∈ closedInterval(X0, X1), (X, Y) ∈ ℂ
    intros X hX
    have xReal : Real(X) by exact closedInterval.subset_reals at X0, X1 with
      X, hX
    exact complexCarrier.pair at X, Y
  have continuousψ := horizontalIntegrand.continuous with valuesg, continuous,
    everywhere
  have functionφ := horizontalIntegrand.function at G, Y with valuesG
  have valuesφ : ComplexValuedOn(horizontalIntegrand(G, Y), ℝ)
    intros X hX
    exact FunctionBetween.apply_closed with functionφ, hX
  have pathInside : ∀ Z ∈ ℝ, horizontalPath(Y)(Z) ∈ ℂ
    intros Z hZ
    exact FunctionBetween.apply_closed with (horizontalPath.function at Y), hZ
  have formula : ∀ Z ∈ ℝ,
      horizontalIntegrand(G, Y)(Z) = G(horizontalPath(Y)(Z))
    intros Z hZ
    rw [(horizontalIntegrand.value at G, Y, Z with valuesG, hZ),
      (horizontalPath.value at Y, Z with hZ)]
  have derivativeAll : ∀ X ∈ ℝ,
      HasPathDerivative(horizontalIntegrand(G, Y),
        horizontalIntegrand(g, Y)(X), X)
    intros X hX
    have typedX : Real(X) by exact hX
    have point := complexCarrier.pair at X, Y
    have atPoint := derivative with (X, Y), point
    rw ← (horizontalPath.value at Y, X with hX) at atPoint
    have chain := HasPathDerivative.comp with atPoint,
      (horizontalPath.derivative at Y, X), pathInside, formula
    have gX := valuesg with (X, Y), point
    have same : horizontalIntegrand(g, Y)(X) =
        ℂ[g(horizontalPath(Y)(X)) * 1]
      rw [(horizontalIntegrand.value at g, Y, X with valuesg, hX),
        (horizontalPath.value at Y, X with hX)]
      ring
    rw same
    exact chain
  have derivativeInside : ∀ X ∈ closedInterval(X0, X1),
      HasPathDerivative(horizontalIntegrand(G, Y),
        horizontalIntegrand(g, Y)(X), X)
    intros X hX
    exact derivativeAll with X,
      (closedInterval.subset_reals at X0, X1 with X, hX)
  have continuousφ := HasPathDerivative.continuous_on with valuesφ,
    derivativeInside
  have interior : ∀ X ∈ ℝ, X0 < X → X < X1 →
      HasPathDerivative(horizontalIntegrand(G, Y),
        horizontalIntegrand(g, Y)(X), X)
    intros X hX left right
    exact derivativeAll with X, hX
  have integral := HasPathIntegral.of_derivative with ordered, continuousφ,
    continuousψ, interior
  have x0Real : X0 ∈ ℝ by typecheck
  have x1Real : X1 ∈ ℝ by typecheck
  rw [(horizontalIntegrand.value at G, Y, X1 with valuesG, x1Real),
    (horizontalIntegrand.value at G, Y, X0 with valuesG, x0Real)] at integral
  unfold horizontalIntegral
  exact HasPathIntegral.eq with integral

theorem verticalIntegral.of_derivative (G g : Set) (X Y0 Y1 : Real)
  requires valuesG : ComplexValuedOn(G, complexCarrier)
  requires valuesg : ComplexValuedOn(g, complexCarrier)
  requires derivative : ∀ w ∈ ℂ, HasComplexDerivativeAt(G, ℂ, g(w), w)
  requires continuous : ComplexContinuousOn(g, ℂ)
  requires ordered : Y0 ≤ Y1
  shows verticalIntegral(g, X, Y0, Y1) = ℂ[G((X, Y1)) - G((X, Y0))]
proof
  have everywhere : ∀ Y ∈ closedInterval(Y0, Y1), (X, Y) ∈ ℂ
    intros Y hY
    have yReal : Real(Y) by exact closedInterval.subset_reals at Y0, Y1 with
      Y, hY
    exact complexCarrier.pair at X, Y
  have continuousψ := verticalIntegrand.continuous with valuesg, continuous,
    everywhere
  have functionφ := verticalValues.function at G, X with valuesG
  have valuesφ : ComplexValuedOn(verticalValues(G, X), ℝ)
    intros Y hY
    exact FunctionBetween.apply_closed with functionφ, hY
  have pathInside : ∀ Z ∈ ℝ, verticalPath(X)(Z) ∈ ℂ
    intros Z hZ
    exact FunctionBetween.apply_closed with (verticalPath.function at X), hZ
  have formula : ∀ Z ∈ ℝ, verticalValues(G, X)(Z) = G(verticalPath(X)(Z))
    intros Z hZ
    rw [(verticalValues.value at G, X, Z with valuesG, hZ),
      (verticalPath.value at X, Z with hZ)]
  have iMember := complexImaginaryUnit.member
  have derivativeAll : ∀ Y ∈ ℝ,
      HasPathDerivative(verticalValues(G, X), verticalIntegrand(g, X)(Y), Y)
    intros Y hY
    have typedY : Real(Y) by exact hY
    have point := complexCarrier.pair at X, Y
    have atPoint := derivative with (X, Y), point
    rw ← (verticalPath.value at X, Y with hY) at atPoint
    have chain := HasPathDerivative.comp with atPoint,
      (verticalPath.derivative at X, Y), pathInside, formula
    have gY := valuesg with (X, Y), point
    have same : verticalIntegrand(g, X)(Y) =
        ℂ[g(verticalPath(X)(Y)) * complexImaginaryUnit]
      rw [(verticalIntegrand.value at g, X, Y with valuesg, hY),
        (verticalPath.value at X, Y with hY)]
      ring
    rw same
    exact chain
  have derivativeInside : ∀ Y ∈ closedInterval(Y0, Y1),
      HasPathDerivative(verticalValues(G, X), verticalIntegrand(g, X)(Y), Y)
    intros Y hY
    exact derivativeAll with Y,
      (closedInterval.subset_reals at Y0, Y1 with Y, hY)
  have continuousφ := HasPathDerivative.continuous_on with valuesφ,
    derivativeInside
  have interior : ∀ Y ∈ ℝ, Y0 < Y → Y < Y1 →
      HasPathDerivative(verticalValues(G, X), verticalIntegrand(g, X)(Y), Y)
    intros Y hY bottom top
    exact derivativeAll with Y, hY
  have integral := HasPathIntegral.of_derivative with ordered, continuousφ,
    continuousψ, interior
  have y0Real : Y0 ∈ ℝ by typecheck
  have y1Real : Y1 ∈ ℝ by typecheck
  rw [(verticalValues.value at G, X, Y1 with valuesG, y1Real),
    (verticalValues.value at G, X, Y0 with valuesG, y0Real)] at integral
  unfold verticalIntegral
  exact HasPathIntegral.eq with integral

-- The integral of a derivative around a rectangle vanishes.
theorem rectIntegral.of_derivative (G g : Set) (X0 X1 Y0 Y1 : Real)
  requires valuesG : ComplexValuedOn(G, complexCarrier)
  requires valuesg : ComplexValuedOn(g, complexCarrier)
  requires derivative : ∀ w ∈ ℂ, HasComplexDerivativeAt(G, ℂ, g(w), w)
  requires continuous : ComplexContinuousOn(g, ℂ)
  requires horizontal : X0 ≤ X1
  requires vertical : Y0 ≤ Y1
  shows rectIntegral(g, X0, X1, Y0, Y1) = ℂ[0]
proof
  have p00 := valuesG with (X0, Y0), (complexCarrier.pair at X0, Y0)
  have p01 := valuesG with (X0, Y1), (complexCarrier.pair at X0, Y1)
  have p10 := valuesG with (X1, Y0), (complexCarrier.pair at X1, Y0)
  have p11 := valuesG with (X1, Y1), (complexCarrier.pair at X1, Y1)
  unfold rectIntegral
  rw [(horizontalIntegral.of_derivative at G, g, X0, X1, Y0 with valuesG,
      valuesg, derivative, continuous, horizontal),
    (horizontalIntegral.of_derivative at G, g, X0, X1, Y1 with valuesG,
      valuesg, derivative, continuous, horizontal),
    (verticalIntegral.of_derivative at G, g, X0, Y0, Y1 with valuesG,
      valuesg, derivative, continuous, vertical),
    (verticalIntegral.of_derivative at G, g, X1, Y0, Y1 with valuesG,
      valuesg, derivative, continuous, vertical)]
  ring

-- Section: Affine functions around a rectangle
defgraph affineFunction (c D z : Set) (w ∈ complexCarrier) : complexCarrier :=
    ℂ[c + D * (w - z)]
requires hc : c ∈ complexCarrier
requires hD : D ∈ complexCarrier
requires hz : z ∈ complexCarrier
proof
  typecheck

defgraph affinePrimitive (c D z : Set) (w ∈ complexCarrier) :
    complexCarrier :=
    ℂ[c * (w - z) + D * complexInv(ℂ[2]) * ((w - z) * (w - z))]
requires hc : c ∈ complexCarrier
requires hD : D ∈ complexCarrier
requires hz : z ∈ complexCarrier
proof
  have two : ℂ[2] ∈ ℂ by typecheck
  have inverse := complexInv.member with two
  typecheck

theorem affineFunction.has_derivative (c D z w : Set)
  requires hc : c ∈ ℂ
  requires hD : D ∈ ℂ
  requires hz : z ∈ ℂ
  requires hw : w ∈ ℂ
  shows HasComplexDerivativeAt(affineFunction(c, D, z), ℂ, D, w)
proof
  have function := affineFunction.function with hc, hD, hz
  have values : ComplexValuedOn(affineFunction(c, D, z), ℂ)
    intros u hu
    exact FunctionBetween.apply_closed with function, hu
  have zero : R[0] ∈ ℝ by typecheck
  have zeroLe : R[0] ≤ R[0] by linarith
  apply HasComplexDerivativeAt.of_quadratic with ComplexOpen.whole, hw, hD,
    values, zero, zeroLe
  intros u hu
  rw [(affineFunction.value with hc, hD, hz, hu),
    (affineFunction.value with hc, hD, hz, hw)]
  have exact : ℂ[(c + D * (u - z)) - (c + D * (w - z)) - D * (u - w)] =
    ℂ[0] by ring
  rw [exact, complexAbs.zero]
  have difference : ℂ[u - w] ∈ ℂ by typecheck
  have absDiff := complexAbs.nonnegative with difference
  have square := realMulValue.square_nonnegative at complexAbs(ℂ[u - w])
  have product : R[0 * (complexAbs(ℂ[u - w]) * complexAbs(ℂ[u - w]))] = R[0]
    by ring
  linarith

theorem affinePrimitive.has_derivative (c D z w : Set)
  requires hc : c ∈ ℂ
  requires hD : D ∈ ℂ
  requires hz : z ∈ ℂ
  requires hw : w ∈ ℂ
  shows HasComplexDerivativeAt(affinePrimitive(c, D, z), ℂ,
    affineFunction(c, D, z)(w), w)
proof
  have function := affinePrimitive.function with hc, hD, hz
  have values : ComplexValuedOn(affinePrimitive(c, D, z), ℂ)
    intros u hu
    exact FunctionBetween.apply_closed with function, hu
  have two : ℂ[2] ∈ ℂ by typecheck
  have half := complexInv.member with two
  have twice := complexHalf.twice
  have factor : ℂ[D * complexInv(ℂ[2])] ∈ ℂ by typecheck
  have kReal : complexAbs(ℂ[D * complexInv(ℂ[2])]) ∈ ℝ by typecheck
  have kNonnegative := complexAbs.nonnegative with factor
  have slope := FunctionBetween.apply_closed with
    (affineFunction.function with hc, hD, hz), hw
  rw (affineFunction.value with hc, hD, hz, hw)
  rw (affineFunction.value with hc, hD, hz, hw) at slope
  apply HasComplexDerivativeAt.of_quadratic with ComplexOpen.whole, hw, slope,
    values, kReal, kNonnegative
  intros u hu
  rw [(affinePrimitive.value with hc, hD, hz, hu),
    (affinePrimitive.value with hc, hD, hz, hw)]
  have difference : ℂ[u - w] ∈ ℂ by typecheck
  have exact : ℂ[(c * (u - z) + D * complexInv(ℂ[2]) * ((u - z) * (u - z))) -
      (c * (w - z) + D * complexInv(ℂ[2]) * ((w - z) * (w - z))) -
      (c + D * (w - z)) * (u - w)] =
      ℂ[(D * complexInv(ℂ[2])) * ((u - w) * (u - w))]
    linear_combination (D * (w - z) * (u - w)) * twice
  have square : ℂ[(u - w) * (u - w)] ∈ ℂ by typecheck
  rw [exact, (complexAbs.mul with factor, square),
    (complexAbs.mul with difference, difference)]
  exact realLe.reflexive

theorem affineFunction.continuous (c D z : Set)
  requires hc : c ∈ ℂ
  requires hD : D ∈ ℂ
  requires hz : z ∈ ℂ
  shows ComplexContinuousOn(affineFunction(c, D, z), ℂ)
proof
  have function := affineFunction.function with hc, hD, hz
  have values : ComplexValuedOn(affineFunction(c, D, z), ℂ)
    intros u hu
    exact FunctionBetween.apply_closed with function, hu
  have holomorphic : HolomorphicOn(affineFunction(c, D, z), ℂ)
    refine ⟨ComplexOpen.whole, values, ?_⟩
    intros w hw
    exact ⟨D, hD, (affineFunction.has_derivative with hc, hD, hz, hw)⟩
  exact HolomorphicOn.continuous with holomorphic

theorem rectIntegral.affine (c D z : Set) (X0 X1 Y0 Y1 : Real)
  requires hc : c ∈ ℂ
  requires hD : D ∈ ℂ
  requires hz : z ∈ ℂ
  requires horizontal : X0 ≤ X1
  requires vertical : Y0 ≤ Y1
  shows rectIntegral(affineFunction(c, D, z), X0, X1, Y0, Y1) = ℂ[0]
proof
  have functionG := affinePrimitive.function with hc, hD, hz
  have functiong := affineFunction.function with hc, hD, hz
  have valuesG : ComplexValuedOn(affinePrimitive(c, D, z), ℂ)
    intros u hu
    exact FunctionBetween.apply_closed with functionG, hu
  have valuesg : ComplexValuedOn(affineFunction(c, D, z), ℂ)
    intros u hu
    exact FunctionBetween.apply_closed with functiong, hu
  have derivative : ∀ w ∈ ℂ, HasComplexDerivativeAt(affinePrimitive(c, D, z),
      ℂ, affineFunction(c, D, z)(w), w)
    intros w hw
    exact affinePrimitive.has_derivative with hc, hD, hz, hw
  exact rectIntegral.of_derivative with valuesG, valuesg, derivative,
    (affineFunction.continuous with hc, hD, hz), horizontal, vertical

theorem ComplexContinuousOn.sub (f g h V : Set)
  requires continuousF : ComplexContinuousOn(f, V)
  requires continuousG : ComplexContinuousOn(g, V)
  requires formula : ∀ w ∈ V, h(w) = ℂ[f(w) - g(w)]
  shows ComplexContinuousOn(h, V)
proof
  obtain ⟨subset, valuesF, closeF⟩ := continuousF
  obtain ⟨_, valuesG, closeG⟩ := continuousG
  have valuesH : ComplexValuedOn(h, V)
    intros w hw
    rw (formula with w, hw)
    have fw := valuesF with w, hw
    have gw := valuesG with w, hw
    typecheck
  refine ⟨subset, valuesH, ?_⟩
  intros a ha e he positive
  have halfPositive := half.positive with positive
  have halfReal : half(e) ∈ ℝ by typecheck
  obtain ⟨d1, hd1, d1Positive, near1⟩ := closeF with a, ha, half(e), halfReal,
    halfPositive
  obtain ⟨d2, hd2, d2Positive, near2⟩ := closeG with a, ha, half(e), halfReal,
    halfPositive
  obtain ⟨d, hd, dPositive, le1, le2⟩ := realRadius.common with hd1, hd2,
    d1Positive, d2Positive
  refine ⟨d, hd, dPositive, ?_⟩
  intros w hw small
  have subW := subset with w, hw
  have subA := subset with a, ha
  have s1 : complexAbs(ℂ[w - a]) < d1 by linarith
  have s2 : complexAbs(ℂ[w - a]) < d2 by linarith
  have b1 := near1 with w, hw, s1
  have b2 := near2 with w, hw, s2
  rw [(formula with w, hw), (formula with a, ha)]
  have fw := valuesF with w, hw
  have fa := valuesF with a, ha
  have gw := valuesG with w, hw
  have ga := valuesG with a, ha
  have first : ℂ[f(w) - f(a)] ∈ ℂ by typecheck
  have second : ℂ[g(w) - g(a)] ∈ ℂ by typecheck
  have regroup : ℂ[(f(w) - g(w)) - (f(a) - g(a))] =
    ℂ[(f(w) - f(a)) - (g(w) - g(a))] by ring
  rw regroup
  have triangle := complexAbs.sub_le with first, second
  have twice := half.add_self at e
  linarith

defgraph linearError (f c D z : Set) (w ∈ complexCarrier) : complexCarrier :=
    ℂ[f(w) - affineFunction(c, D, z)(w)]
requires values : ComplexValuedOn(f, complexCarrier)
requires hc : c ∈ complexCarrier
requires hD : D ∈ complexCarrier
requires hz : z ∈ complexCarrier
proof
  have fw := values with member
  have aw := FunctionBetween.apply_closed with
    (affineFunction.function with hc, hD, hz), member
  typecheck

-- Integrals around rectangles add.
theorem rectIntegral.add (f g k V : Set) (X0 X1 Y0 Y1 : Real)
  requires valuesG : ComplexValuedOn(g, complexCarrier)
  requires valuesK : ComplexValuedOn(k, complexCarrier)
  requires continuousG : ComplexContinuousOn(g, V)
  requires continuousK : ComplexContinuousOn(k, V)
  requires inside : RectInside(V, X0, X1, Y0, Y1)
  requires horizontal : X0 ≤ X1
  requires vertical : Y0 ≤ Y1
  requires formula : ∀ w ∈ ℂ, f(w) = ℂ[g(w) + k(w)]
  shows rectIntegral(f, X0, X1, Y0, Y1) =
    ℂ[rectIntegral(g, X0, X1, Y0, Y1) + rectIntegral(k, X0, X1, Y0, Y1)]
proof
  have valuesF : ComplexValuedOn(f, ℂ)
    intros w hw
    rw (formula with w, hw)
    have gw := valuesG with w, hw
    have kw := valuesK with w, hw
    typecheck
  have iMember := complexImaginaryUnit.member
  have sideH : ∀ Y ∈ closedInterval(Y0, Y1), horizontalIntegral(f, X0, X1, Y) =
      ℂ[horizontalIntegral(g, X0, X1, Y) + horizontalIntegral(k, X0, X1, Y)]
    intros Y hY
    have typedY : Real(Y) by exact closedInterval.subset_reals at Y0, Y1 with
      Y, hY
    have line := RectInside.horizontal with inside, hY
    have integralG := pathIntegral.spec with horizontal,
      (horizontalIntegrand.continuous with valuesG, continuousG, line)
    have integralK := pathIntegral.spec with horizontal,
      (horizontalIntegrand.continuous with valuesK, continuousK, line)
    have pointwise : ∀ X ∈ ℝ, horizontalIntegrand(f, Y)(X) =
        ℂ[horizontalIntegrand(g, Y)(X) + horizontalIntegrand(k, Y)(X)]
      intros X hX
      have typedX : Real(X) by exact hX
      rw [(horizontalIntegrand.value at f, Y, X with valuesF, hX),
        (horizontalIntegrand.value at g, Y, X with valuesG, hX),
        (horizontalIntegrand.value at k, Y, X with valuesK, hX)]
      exact formula with (X, Y), (complexCarrier.pair at X, Y)
    have sum := HasPathIntegral.add with integralG, integralK, pointwise
    unfold horizontalIntegral
    exact HasPathIntegral.eq with sum
  have sideV : ∀ X ∈ closedInterval(X0, X1), verticalIntegral(f, X, Y0, Y1) =
      ℂ[verticalIntegral(g, X, Y0, Y1) + verticalIntegral(k, X, Y0, Y1)]
    intros X hX
    have typedX : Real(X) by exact closedInterval.subset_reals at X0, X1 with
      X, hX
    have line := RectInside.vertical with inside, hX
    have integralG := pathIntegral.spec with vertical,
      (verticalIntegrand.continuous with valuesG, continuousG, line)
    have integralK := pathIntegral.spec with vertical,
      (verticalIntegrand.continuous with valuesK, continuousK, line)
    have pointwise : ∀ Y ∈ ℝ, verticalIntegrand(f, X)(Y) =
        ℂ[verticalIntegrand(g, X)(Y) + verticalIntegrand(k, X)(Y)]
      intros Y hY
      have typedY : Real(Y) by exact hY
      have point := complexCarrier.pair at X, Y
      have gw := valuesG with (X, Y), point
      have kw := valuesK with (X, Y), point
      rw [(verticalIntegrand.value at f, X, Y with valuesF, hY),
        (verticalIntegrand.value at g, X, Y with valuesG, hY),
        (verticalIntegrand.value at k, X, Y with valuesK, hY),
        (formula with (X, Y), point)]
      ring
    have sum := HasPathIntegral.add with integralG, integralK, pointwise
    unfold verticalIntegral
    exact HasPathIntegral.eq with sum
  have x0In := closedInterval.left_end with horizontal
  have x1In := closedInterval.right_end with horizontal
  have y0In := closedInterval.left_end with vertical
  have y1In := closedInterval.right_end with vertical
  have g1 := horizontalIntegral.member at g, X0, X1, Y0
  have g2 := horizontalIntegral.member at g, X0, X1, Y1
  have g3 := verticalIntegral.member at g, X0, Y0, Y1
  have g4 := verticalIntegral.member at g, X1, Y0, Y1
  have k1 := horizontalIntegral.member at k, X0, X1, Y0
  have k2 := horizontalIntegral.member at k, X0, X1, Y1
  have k3 := verticalIntegral.member at k, X0, Y0, Y1
  have k4 := verticalIntegral.member at k, X1, Y0, Y1
  unfold rectIntegral
  rw [(sideH with Y0, y0In), (sideH with Y1, y1In), (sideV with X0, x0In),
    (sideV with X1, x1In)]
  ring

-- Section: Goursat's lemma for rectangles
-- A stage is a rectangle ((X₀, X₁), (Y₀, Y₁)); its four quarters, and the
-- integral around it.
def rectStages : Set := (ℝ × ℝ) × (ℝ × ℝ)

def stageIntegral (f s : Set) : Set :=
  rectIntegral(f, fst(fst(s)), snd(fst(s)), fst(snd(s)), snd(snd(s)))

def stageMidX (s : Set) : Set := half(R[fst(fst(s)) + snd(fst(s))])
def stageMidY (s : Set) : Set := half(R[fst(snd(s)) + snd(snd(s))])

def quarter1 (s : Set) : Set :=
  ((fst(fst(s)), stageMidX(s)), (fst(snd(s)), stageMidY(s)))
def quarter2 (s : Set) : Set :=
  ((stageMidX(s), snd(fst(s))), (fst(snd(s)), stageMidY(s)))
def quarter3 (s : Set) : Set :=
  ((fst(fst(s)), stageMidX(s)), (stageMidY(s), snd(snd(s))))
def quarter4 (s : Set) : Set :=
  ((stageMidX(s), snd(fst(s))), (stageMidY(s), snd(snd(s))))

theorem rectStages.parts (s : Set)
  requires hs : s ∈ rectStages
  shows fst(fst(s)) ∈ ℝ ∧ snd(fst(s)) ∈ ℝ ∧ fst(snd(s)) ∈ ℝ ∧
    snd(snd(s)) ∈ ℝ ∧ s = ((fst(fst(s)), snd(fst(s))), (fst(snd(s)), snd(snd(s))))
proof
  unfold rectStages at hs
  obtain ⟨_, p, hp, q, hq, shape⟩ := product.membership.forward with hs
  obtain ⟨_, x0, hx0, x1, hx1, pShape⟩ := product.membership.forward with hp
  obtain ⟨_, y0, hy0, y1, hy1, qShape⟩ := product.membership.forward with hq
  rw [shape, pShape, qShape, fst.pair, snd.pair, fst.pair, snd.pair, fst.pair,
    snd.pair]
  exact ⟨hx0, hx1, hy0, hy1, rfl⟩

theorem rectStages.pair (A B C D : Real)
  shows ((A, B), (C, D)) ∈ rectStages
proof
  unfold rectStages
  have aReal : A ∈ ℝ by typecheck
  have bReal : B ∈ ℝ by typecheck
  have cReal : C ∈ ℝ by typecheck
  have dReal : D ∈ ℝ by typecheck
  have first : (A, B) ∈ ℝ × ℝ := product.pair_membership.backward with
    ⟨aReal, bReal⟩
  have second : (C, D) ∈ ℝ × ℝ := product.pair_membership.backward with
    ⟨cReal, dReal⟩
  exact product.pair_membership.backward with ⟨first, second⟩

theorem half.between (A B : Real)
  requires ordered : A ≤ B
  shows A ≤ half(R[A + B]) ∧ half(R[A + B]) ≤ B
proof
  have twice := half.add_self at R[A + B]
  refine ⟨?_, ?_⟩
  . linarith
  . linarith

-- The integral around a rectangle is the sum over its four quarters.
theorem rectIntegral.quarters (f V : Set) (X0 X1 Y0 Y1 : Real)
  requires values : ComplexValuedOn(f, complexCarrier)
  requires continuous : ComplexContinuousOn(f, V)
  requires inside : RectInside(V, X0, X1, Y0, Y1)
  requires horizontal : X0 ≤ X1
  requires vertical : Y0 ≤ Y1
  shows rectIntegral(f, X0, X1, Y0, Y1) =
    ℂ[(rectIntegral(f, X0, half(R[X0 + X1]), Y0, half(R[Y0 + Y1])) +
      rectIntegral(f, half(R[X0 + X1]), X1, Y0, half(R[Y0 + Y1]))) +
     (rectIntegral(f, X0, half(R[X0 + X1]), half(R[Y0 + Y1]), Y1) +
      rectIntegral(f, half(R[X0 + X1]), X1, half(R[Y0 + Y1]), Y1))]
proof
  obtain ⟨xLow, xHigh⟩ := half.between with horizontal
  obtain ⟨yLow, yHigh⟩ := half.between with vertical
  have reflexiveX0 : X0 ≤ X0 by linarith
  have reflexiveX1 : X1 ≤ X1 by linarith
  have reflexiveY0 : Y0 ≤ Y0 by linarith
  have reflexiveY1 : Y1 ≤ Y1 by linarith
  have splitX := rectIntegral.split_x with values, continuous, inside, xLow,
    xHigh, vertical
  have leftInside := RectInside.sub with inside, reflexiveX0, xHigh,
    reflexiveY0, reflexiveY1
  have rightInside := RectInside.sub with inside, xLow, reflexiveX1,
    reflexiveY0, reflexiveY1
  have splitLeft := rectIntegral.split_y with values, continuous, leftInside,
    yLow, yHigh, xLow
  have splitRight := rectIntegral.split_y with values, continuous,
    rightInside, yLow, yHigh, xHigh
  have r1 := rectIntegral.member at f, X0, half(R[X0 + X1]), Y0,
    half(R[Y0 + Y1])
  have r2 := rectIntegral.member at f, half(R[X0 + X1]), X1, Y0,
    half(R[Y0 + Y1])
  have r3 := rectIntegral.member at f, X0, half(R[X0 + X1]),
    half(R[Y0 + Y1]), Y1
  have r4 := rectIntegral.member at f, half(R[X0 + X1]), X1,
    half(R[Y0 + Y1]), Y1
  rw [splitX, splitLeft, splitRight]
  ring

theorem quarters.member (s : Set)
  requires hs : s ∈ rectStages
  shows quarter1(s) ∈ rectStages ∧ quarter2(s) ∈ rectStages ∧
    quarter3(s) ∈ rectStages ∧ quarter4(s) ∈ rectStages
proof
  obtain ⟨x0, x1, y0, y1, _⟩ := rectStages.parts with hs
  have tx0 : Real(fst(fst(s))) by exact x0
  have tx1 : Real(snd(fst(s))) by exact x1
  have ty0 : Real(fst(snd(s))) by exact y0
  have ty1 : Real(snd(snd(s))) by exact y1
  have mx : Real(stageMidX(s))
    unfold stageMidX
    typecheck
  have my : Real(stageMidY(s))
    unfold stageMidY
    typecheck
  unfold quarter1
  unfold quarter2
  unfold quarter3
  unfold quarter4
  exact ⟨(rectStages.pair at fst(fst(s)), stageMidX(s), fst(snd(s)),
      stageMidY(s)),
    (rectStages.pair at stageMidX(s), snd(fst(s)), fst(snd(s)),
      stageMidY(s)),
    (rectStages.pair at fst(fst(s)), stageMidX(s), stageMidY(s),
      snd(snd(s))),
    (rectStages.pair at stageMidX(s), snd(fst(s)), stageMidY(s),
      snd(snd(s)))⟩

-- A quarter carries at least a quarter of the integral.
predicate GoodQuarter (f s c : Set) :=
  complexAbs(stageIntegral(f, s)) ≤ R[4 * complexAbs(stageIntegral(f, c))]

-- The first quarter, in the order 1, 2, 3, 4, that carries at least a
-- quarter of the integral (the last one when none of the first three does).
defunique goursatChild (f s : Set) (c ∈ rectStages) :=
  (GoodQuarter(f, s, quarter1(s)) → c = quarter1(s)) ∧
  (¬GoodQuarter(f, s, quarter1(s)) → GoodQuarter(f, s, quarter2(s)) →
    c = quarter2(s)) ∧
  (¬GoodQuarter(f, s, quarter1(s)) → ¬GoodQuarter(f, s, quarter2(s)) →
    GoodQuarter(f, s, quarter3(s)) → c = quarter3(s)) ∧
  (¬GoodQuarter(f, s, quarter1(s)) → ¬GoodQuarter(f, s, quarter2(s)) →
    ¬GoodQuarter(f, s, quarter3(s)) → c = quarter4(s))
requires hs : s ∈ rectStages
proof
  obtain ⟨q1, q2, q3, q4⟩ := quarters.member with hs
  have case1 : GoodQuarter(f, s, quarter1(s)) ∨
    ¬GoodQuarter(f, s, quarter1(s)) by tauto
  cases case1 with good1 | bad1
  . refine ⟨quarter1(s), q1, ?_, ?_, ?_, ?_⟩
    . intro ignored
      rfl
    . intro bad
      exfalso
      exact bad with good1
    . intro bad
      exfalso
      exact bad with good1
    . intro bad
      exfalso
      exact bad with good1
  have case2 : GoodQuarter(f, s, quarter2(s)) ∨
    ¬GoodQuarter(f, s, quarter2(s)) by tauto
  cases case2 with good2 | bad2
  . refine ⟨quarter2(s), q2, ?_, ?_, ?_, ?_⟩
    . intro good
      exfalso
      exact bad1 with good
    . intros ignored again
      rfl
    . intros ignored bad
      exfalso
      exact bad with good2
    . intros ignored bad
      exfalso
      exact bad with good2
  have case3 : GoodQuarter(f, s, quarter3(s)) ∨
    ¬GoodQuarter(f, s, quarter3(s)) by tauto
  cases case3 with good3 | bad3
  . refine ⟨quarter3(s), q3, ?_, ?_, ?_, ?_⟩
    . intro good
      exfalso
      exact bad1 with good
    . intros ignored good
      exfalso
      exact bad2 with good
    . intros ignored again more
      rfl
    . intros ignored again bad
      exfalso
      exact bad with good3
  . refine ⟨quarter4(s), q4, ?_, ?_, ?_, ?_⟩
    . intro good
      exfalso
      exact bad1 with good
    . intros ignored good
      exfalso
      exact bad2 with good
    . intros ignored again good
      exfalso
      exact bad3 with good
    . intros ignored again more
      rfl
uniqueness
  intros c hc first d hd second
  obtain ⟨c1, c2, c3, c4⟩ := first
  obtain ⟨d1, d2, d3, d4⟩ := second
  have case1 : GoodQuarter(f, s, quarter1(s)) ∨
    ¬GoodQuarter(f, s, quarter1(s)) by tauto
  cases case1 with good1 | bad1
  . rw [(c1 with good1), (d1 with good1)]
  have case2 : GoodQuarter(f, s, quarter2(s)) ∨
    ¬GoodQuarter(f, s, quarter2(s)) by tauto
  cases case2 with good2 | bad2
  . rw [(c2 with bad1, good2), (d2 with bad1, good2)]
  have case3 : GoodQuarter(f, s, quarter3(s)) ∨
    ¬GoodQuarter(f, s, quarter3(s)) by tauto
  cases case3 with good3 | bad3
  . rw [(c3 with bad1, bad2, good3), (d3 with bad1, bad2, good3)]
  . rw [(c4 with bad1, bad2, bad3), (d4 with bad1, bad2, bad3)]

theorem stageIntegral.pair (f : Set) (A B C D : Real)
  shows stageIntegral(f, ((A, B), (C, D))) = rectIntegral(f, A, B, C, D)
proof
  unfold stageIntegral
  rw [fst.pair, snd.pair, fst.pair, snd.pair, fst.pair, snd.pair]

-- One step of the subdivision: the chosen quarter is a quarter of the
-- rectangle and carries at least a quarter of the integral.
theorem goursatChild.step (f V : Set) (A B C D : Real)
  requires values : ComplexValuedOn(f, complexCarrier)
  requires continuous : ComplexContinuousOn(f, V)
  requires inside : RectInside(V, A, B, C, D)
  requires horizontal : A ≤ B
  requires vertical : C ≤ D
  shows ∃ P ∈ ℝ, ∃ Q ∈ ℝ, ∃ S ∈ ℝ, ∃ T ∈ ℝ,
    goursatChild(f, ((A, B), (C, D))) = ((P, Q), (S, T)) ∧
    A ≤ P ∧ P ≤ Q ∧ Q ≤ B ∧ C ≤ S ∧ S ≤ T ∧ T ≤ D ∧
    R[(Q - P) + (Q - P)] = R[B - A] ∧ R[(T - S) + (T - S)] = R[D - C] ∧
    complexAbs(rectIntegral(f, A, B, C, D)) ≤
      R[4 * complexAbs(rectIntegral(f, P, Q, S, T))]
proof
  have hs := rectStages.pair at A, B, C, D
  obtain ⟨_, c1, c2, c3, c4⟩ := goursatChild.selected at f, ((A, B), (C, D))
    with hs
  obtain ⟨xLow, xHigh⟩ := half.between with horizontal
  obtain ⟨yLow, yHigh⟩ := half.between with vertical
  have twiceX := half.add_self at R[A + B]
  have twiceY := half.add_self at R[C + D]
  have mxReal : half(R[A + B]) ∈ ℝ by typecheck
  have myReal : half(R[C + D]) ∈ ℝ by typecheck
  have aReal : A ∈ ℝ by typecheck
  have bReal : B ∈ ℝ by typecheck
  have cReal : C ∈ ℝ by typecheck
  have dReal : D ∈ ℝ by typecheck
  have midX : stageMidX(((A, B), (C, D))) = half(R[A + B])
    unfold stageMidX
    rw [fst.pair, fst.pair, snd.pair]
  have midY : stageMidY(((A, B), (C, D))) = half(R[C + D])
    unfold stageMidY
    rw [snd.pair, fst.pair, snd.pair]
  have shape1 : quarter1(((A, B), (C, D))) =
      ((A, half(R[A + B])), (C, half(R[C + D])))
    unfold quarter1
    rw [midX, midY, fst.pair, fst.pair, snd.pair, fst.pair]
  have shape2 : quarter2(((A, B), (C, D))) =
      ((half(R[A + B]), B), (C, half(R[C + D])))
    unfold quarter2
    rw [midX, midY, fst.pair, snd.pair, snd.pair, fst.pair]
  have shape3 : quarter3(((A, B), (C, D))) =
      ((A, half(R[A + B])), (half(R[C + D]), D))
    unfold quarter3
    rw [midX, midY, fst.pair, fst.pair, snd.pair, snd.pair]
  have shape4 : quarter4(((A, B), (C, D))) =
      ((half(R[A + B]), B), (half(R[C + D]), D))
    unfold quarter4
    rw [midX, midY, fst.pair, snd.pair, snd.pair, snd.pair]
  have sum := rectIntegral.quarters with values, continuous, inside,
    horizontal, vertical
  have i1 := rectIntegral.member at f, A, half(R[A + B]), C, half(R[C + D])
  have i2 := rectIntegral.member at f, half(R[A + B]), B, C, half(R[C + D])
  have i3 := rectIntegral.member at f, A, half(R[A + B]), half(R[C + D]), D
  have i4 := rectIntegral.member at f, half(R[A + B]), B, half(R[C + D]), D
  have good : ∀ P ∈ ℝ, ∀ Q ∈ ℝ, ∀ S ∈ ℝ, ∀ T ∈ ℝ,
      GoodQuarter(f, ((A, B), (C, D)), ((P, Q), (S, T))) →
      complexAbs(rectIntegral(f, A, B, C, D)) ≤
        R[4 * complexAbs(rectIntegral(f, P, Q, S, T))]
    intros P hP Q hQ S hS T hT g
    have tP : Real(P) by exact hP
    have tQ : Real(Q) by exact hQ
    have tS : Real(S) by exact hS
    have tT : Real(T) by exact hT
    unfold GoodQuarter at g
    rw [stageIntegral.pair, stageIntegral.pair] at g
    exact g
  have case1 : GoodQuarter(f, ((A, B), (C, D)), quarter1(((A, B), (C, D)))) ∨
    ¬GoodQuarter(f, ((A, B), (C, D)), quarter1(((A, B), (C, D)))) by tauto
  cases case1 with good1 | bad1
  . have chosen := c1 with good1
    rw shape1 at good1
    rw shape1 at chosen
    refine ⟨A, aReal, half(R[A + B]), mxReal, C, cReal, half(R[C + D]),
      myReal, chosen, ?_, xLow, xHigh, ?_, yLow, yHigh, ?_, ?_, ?_⟩
    . linarith
    . linarith
    . linarith
    . linarith
    . exact good with A, aReal, half(R[A + B]), mxReal, C, cReal,
        half(R[C + D]), myReal, good1
  have case2 : GoodQuarter(f, ((A, B), (C, D)), quarter2(((A, B), (C, D)))) ∨
    ¬GoodQuarter(f, ((A, B), (C, D)), quarter2(((A, B), (C, D)))) by tauto
  cases case2 with good2 | bad2
  . have chosen := c2 with bad1, good2
    rw shape2 at good2
    rw shape2 at chosen
    refine ⟨half(R[A + B]), mxReal, B, bReal, C, cReal, half(R[C + D]),
      myReal, chosen, xLow, xHigh, ?_, ?_, yLow, yHigh, ?_, ?_, ?_⟩
    . linarith
    . linarith
    . linarith
    . linarith
    . exact good with half(R[A + B]), mxReal, B, bReal, C, cReal,
        half(R[C + D]), myReal, good2
  have case3 : GoodQuarter(f, ((A, B), (C, D)), quarter3(((A, B), (C, D)))) ∨
    ¬GoodQuarter(f, ((A, B), (C, D)), quarter3(((A, B), (C, D)))) by tauto
  cases case3 with good3 | bad3
  . have chosen := c3 with bad1, bad2, good3
    rw shape3 at good3
    rw shape3 at chosen
    refine ⟨A, aReal, half(R[A + B]), mxReal, half(R[C + D]), myReal, D,
      dReal, chosen, ?_, xLow, xHigh, yLow, yHigh, ?_, ?_, ?_, ?_⟩
    . linarith
    . linarith
    . linarith
    . linarith
    . exact good with A, aReal, half(R[A + B]), mxReal, half(R[C + D]),
        myReal, D, dReal, good3
  . have chosen := c4 with bad1, bad2, bad3
    rw shape4 at chosen
    rw shape1 at bad1
    rw shape2 at bad2
    rw shape3 at bad3
    unfold GoodQuarter at bad1
    unfold GoodQuarter at bad2
    unfold GoodQuarter at bad3
    rw [stageIntegral.pair, stageIntegral.pair] at bad1
    rw [stageIntegral.pair, stageIntegral.pair] at bad2
    rw [stageIntegral.pair, stageIntegral.pair] at bad3
    have less1 := realLess.of_not_le with bad1
    have less2 := realLess.of_not_le with bad2
    have less3 := realLess.of_not_le with bad3
    have s12 : ℂ[rectIntegral(f, A, half(R[A + B]), C, half(R[C + D])) +
      rectIntegral(f, half(R[A + B]), B, C, half(R[C + D]))] ∈ ℂ by typecheck
    have s34 : ℂ[rectIntegral(f, A, half(R[A + B]), half(R[C + D]), D) +
      rectIntegral(f, half(R[A + B]), B, half(R[C + D]), D)] ∈ ℂ by typecheck
    have t0 := complexAbs.triangle with s12, s34
    have t1 := complexAbs.triangle with i1, i2
    have t2 := complexAbs.triangle with i3, i4
    rw ← sum at t0
    refine ⟨half(R[A + B]), mxReal, B, bReal, half(R[C + D]), myReal, D,
      dReal, chosen, xLow, xHigh, ?_, yLow, yHigh, ?_, ?_, ?_, ?_⟩
    . linarith
    . linarith
    . linarith
    . linarith
    . linarith

theorem realRingPow.zero (A : Real)
  shows R[A ^ 0] = R[1]
proof
  have convert : realPow(A, 0) = R[A ^ 0]
    unfold realPow
    rfl
  rw [← convert, realPow.zero]

theorem realRingPow.succ (A : Real, n : Nat)
  shows R[A ^ succ(n)] = R[A * A ^ n]
proof
  have convert : realPow(A, succ(n)) = R[A ^ succ(n)]
    unfold realPow
    rfl
  have convertN : realPow(A, n) = R[A ^ n]
    unfold realPow
    rfl
  rw [← convert, realPow.succ, convertN]

-- The nested rectangles of Goursat's argument.
def goursatStage (f s : Set, n : Nat) → Set
  | f, s, zero => s
  | f, s, succ(k) => goursatChild(f, goursatStage(f, s, k))

theorem goursatStage.invariant (f V : Set) (X0 X1 Y0 Y1 : Real, n : Nat)
  requires values : ComplexValuedOn(f, complexCarrier)
  requires continuous : ComplexContinuousOn(f, V)
  requires inside : RectInside(V, X0, X1, Y0, Y1)
  requires horizontal : X0 ≤ X1
  requires vertical : Y0 ≤ Y1
  shows ∃ A ∈ ℝ, ∃ B ∈ ℝ, ∃ C ∈ ℝ, ∃ D ∈ ℝ,
    goursatStage(f, ((X0, X1), (Y0, Y1)), n) = ((A, B), (C, D)) ∧
    X0 ≤ A ∧ A ≤ B ∧ B ≤ X1 ∧ Y0 ≤ C ∧ C ≤ D ∧ D ≤ Y1 ∧
    R[B - A] = R[(X1 - X0) * half(R[1]) ^ n] ∧
    R[D - C] = R[(Y1 - Y0) * half(R[1]) ^ n] ∧
    R[complexAbs(rectIntegral(f, X0, X1, Y0, Y1)) *
      (half(R[1]) ^ n * half(R[1]) ^ n)] ≤
      complexAbs(rectIntegral(f, A, B, C, D))
proof
  have pReal : half(R[1]) ∈ ℝ by typecheck
  have twice := half.add_self at R[1]
  have j0 := rectIntegral.member at f, X0, X1, Y0, Y1
  have absJ0 := complexAbs.nonnegative with j0
  induction n
  | zero =>
    have x0Real : X0 ∈ ℝ by typecheck
    have x1Real : X1 ∈ ℝ by typecheck
    have y0Real : Y0 ∈ ℝ by typecheck
    have y1Real : Y1 ∈ ℝ by typecheck
    refine ⟨X0, x0Real, X1, x1Real, Y0, y0Real, Y1, y1Real, ?_, ?_, horizontal,
      ?_, ?_, vertical, ?_, ?_, ?_, ?_⟩
    . rw goursatStage
    . linarith
    . linarith
    . linarith
    . linarith
    . rw realRingPow.zero
      ring
    . rw realRingPow.zero
      ring
    . rw realRingPow.zero
      have same : R[complexAbs(rectIntegral(f, X0, X1, Y0, Y1)) * (1 * 1)] =
        complexAbs(rectIntegral(f, X0, X1, Y0, Y1)) by ring
      rw same
      exact realLe.reflexive
  | succ(k) using ih =>
    obtain ⟨A, hA, B, hB, C, hC, D, hD, stage, a0, ab, b1, c0, cd, d1, width,
      height, mass⟩ := ih
    have typedA : Real(A) by exact hA
    have typedB : Real(B) by exact hB
    have typedC : Real(C) by exact hC
    have typedD : Real(D) by exact hD
    have sub := RectInside.sub with inside, a0, b1, c0, d1
    obtain ⟨P, hP, Q, hQ, S, hS, T, hT, chosen, ap, pq, qb, cs, st, td,
      halfWidth, halfHeight, quarter⟩ := goursatChild.step with values,
      continuous, sub, ab, cd
    have pkReal : R[half(R[1]) ^ k] ∈ ℝ by typecheck
    refine ⟨P, hP, Q, hQ, S, hS, T, hT, ?_, ?_, pq, ?_, ?_, st, ?_, ?_, ?_,
      ?_⟩
    . rw [goursatStage, stage]
      exact chosen
    . linarith
    . linarith
    . linarith
    . linarith
    . rw realRingPow.succ
      linear_combination (-(R[Q - P])) * twice + half(R[1]) * halfWidth +
        half(R[1]) * width
    . rw realRingPow.succ
      linear_combination (-(R[T - S])) * twice + half(R[1]) * halfHeight +
        half(R[1]) * height
    . rw realRingPow.succ
      have ppNonnegative : R[0] ≤ R[half(R[1]) * half(R[1])]
        have onePositive : R[0] < R[1] by linarith
        have pPositive := half.positive with onePositive
        have product := realMulValue.positive with pPositive, pPositive
        linarith
      have scaled := realLe.mul_right_of_nonnegative with mass, ppNonnegative
      have scaled2 := realLe.mul_right_of_nonnegative with quarter,
        ppNonnegative
      have four : R[4 * (half(R[1]) * half(R[1]))] = R[1]
        linear_combination (half(R[1]) + half(R[1]) + 1) * twice
      have jReal := rectIntegral.member at f, P, Q, S, T
      have absReal : complexAbs(rectIntegral(f, P, Q, S, T)) ∈ ℝ by typecheck
      have regroup1 : R[complexAbs(rectIntegral(f, X0, X1, Y0, Y1)) *
          ((half(R[1]) * half(R[1]) ^ k) * (half(R[1]) * half(R[1]) ^ k))] =
          R[(complexAbs(rectIntegral(f, X0, X1, Y0, Y1)) *
          (half(R[1]) ^ k * half(R[1]) ^ k)) * (half(R[1]) * half(R[1]))]
        by ring
      have regroup2 : R[(4 * complexAbs(rectIntegral(f, P, Q, S, T))) *
          (half(R[1]) * half(R[1]))] =
          R[complexAbs(rectIntegral(f, P, Q, S, T)) *
          (4 * (half(R[1]) * half(R[1])))] by ring
      rw four at regroup2
      have one : R[complexAbs(rectIntegral(f, P, Q, S, T)) * 1] =
        complexAbs(rectIntegral(f, P, Q, S, T)) by ring
      linarith

theorem goursatStage.member (f s : Set, n : Nat)
  requires hs : s ∈ rectStages
  shows goursatStage(f, s, n) ∈ rectStages
proof
  induction n
  | zero =>
    rw goursatStage
    exact hs
  | succ(k) using ih =>
    rw goursatStage
    obtain ⟨member, _⟩ := goursatChild.selected at f, goursatStage(f, s, k)
      with ih
    exact member

defgraph goursatLeft (f s : Set) (n ∈ ℕ) : ℝ := fst(fst(goursatStage(f, s, n)))
requires hs : s ∈ rectStages
proof
  have typedN : Nat(n) := nat.omega.backward at n with member
  obtain ⟨x0, _⟩ := rectStages.parts with (goursatStage.member at f, s, n
    with hs)
  exact x0

defgraph goursatRight (f s : Set) (n ∈ ℕ) : ℝ :=
    snd(fst(goursatStage(f, s, n)))
requires hs : s ∈ rectStages
proof
  have typedN : Nat(n) := nat.omega.backward at n with member
  obtain ⟨_, x1, _⟩ := rectStages.parts with (goursatStage.member at f, s, n
    with hs)
  exact x1

defgraph goursatBottom (f s : Set) (n ∈ ℕ) : ℝ :=
    fst(snd(goursatStage(f, s, n)))
requires hs : s ∈ rectStages
proof
  have typedN : Nat(n) := nat.omega.backward at n with member
  obtain ⟨_, _, y0, _⟩ := rectStages.parts with (goursatStage.member at f, s,
    n with hs)
  exact y0

defgraph goursatTop (f s : Set) (n ∈ ℕ) : ℝ :=
    snd(snd(goursatStage(f, s, n)))
requires hs : s ∈ rectStages
proof
  have typedN : Nat(n) := nat.omega.backward at n with member
  obtain ⟨_, _, _, y1, _⟩ := rectStages.parts with (goursatStage.member at f,
    s, n with hs)
  exact y1

theorem RealSequence.monotone_aux (u : Set) (m k : Nat)
  requires sequence : RealSequence(u)
  requires step : ∀ n ∈ ℕ, u(n) ≤ u(succ(n))
  shows m ≤ k → u(m) ≤ u(k)
proof
  induction k
  | zero =>
    intro bound
    have zero : m = (0:N) := LessEqual.eq_zero with bound
    rw zero
    have u0 := RealSequence.value at u, (0:N) with sequence
    exact realLe.reflexive at u((0:N))
  | succ(j) using ih =>
    intro bound
    have hj : j ∈ ℕ by typecheck
    have uj := RealSequence.value at u, j with sequence
    have uj1 := RealSequence.value at u, succ(j) with sequence
    have um := RealSequence.value at u, m with sequence
    have cases := nat.le_succ_cases with bound
    cases cases with earlier | equal
    . have previous := ih with earlier
      have next := step with j, hj
      linarith
    . rw equal
      exact realLe.reflexive at u(succ(j))

theorem RealSequence.antitone_aux (u : Set) (m k : Nat)
  requires sequence : RealSequence(u)
  requires step : ∀ n ∈ ℕ, u(succ(n)) ≤ u(n)
  shows m ≤ k → u(k) ≤ u(m)
proof
  induction k
  | zero =>
    intro bound
    have zero : m = (0:N) := LessEqual.eq_zero with bound
    rw zero
    have u0 := RealSequence.value at u, (0:N) with sequence
    exact realLe.reflexive at u((0:N))
  | succ(j) using ih =>
    intro bound
    have hj : j ∈ ℕ by typecheck
    have uj := RealSequence.value at u, j with sequence
    have uj1 := RealSequence.value at u, succ(j) with sequence
    have um := RealSequence.value at u, m with sequence
    have cases := nat.le_succ_cases with bound
    cases cases with earlier | equal
    . have previous := ih with earlier
      have next := step with j, hj
      linarith
    . rw equal
      exact realLe.reflexive at u(succ(j))

theorem Nondecreasing.of_succ (u : Set)
  requires sequence : RealSequence(u)
  requires step : ∀ n ∈ ℕ, u(n) ≤ u(succ(n))
  shows Nondecreasing(u)
proof
  intros m hm n hn le
  have typedM : Nat(m) := nat.omega.backward at m with hm
  have typedN : Nat(n) := nat.omega.backward at n with hn
  have uM := RealSequence.value at u, m with sequence
  have uN := RealSequence.value at u, n with sequence
  have result := (RealSequence.monotone_aux at u, m, n with sequence, step)
    with le
  exact realLe.characterization.forward with result

theorem Nonincreasing.of_succ (u : Set)
  requires sequence : RealSequence(u)
  requires step : ∀ n ∈ ℕ, u(succ(n)) ≤ u(n)
  shows Nonincreasing(u)
proof
  intros m hm n hn le
  have typedM : Nat(m) := nat.omega.backward at m with hm
  have typedN : Nat(n) := nat.omega.backward at n with hn
  have uM := RealSequence.value at u, m with sequence
  have uN := RealSequence.value at u, n with sequence
  have result := (RealSequence.antitone_aux at u, m, n with sequence, step)
    with le
  exact realLe.characterization.forward with result

-- The nested rectangles close down on a point.
theorem goursatStage.limit (f V : Set) (X0 X1 Y0 Y1 : Real)
  requires values : ComplexValuedOn(f, complexCarrier)
  requires continuous : ComplexContinuousOn(f, V)
  requires inside : RectInside(V, X0, X1, Y0, Y1)
  requires horizontal : X0 ≤ X1
  requires vertical : Y0 ≤ Y1
  shows ∃ Xs ∈ ℝ, ∃ Ys ∈ ℝ, ∀ n ∈ ℕ, ∃ A ∈ ℝ, ∃ B ∈ ℝ, ∃ C ∈ ℝ, ∃ D ∈ ℝ,
    A ≤ Xs ∧ Xs ≤ B ∧ C ≤ Ys ∧ Ys ≤ D ∧
    X0 ≤ A ∧ B ≤ X1 ∧ Y0 ≤ C ∧ D ≤ Y1 ∧ A ≤ B ∧ C ≤ D ∧
    R[B - A] = R[(X1 - X0) * half(R[1]) ^ n] ∧
    R[D - C] = R[(Y1 - Y0) * half(R[1]) ^ n] ∧
    R[complexAbs(rectIntegral(f, X0, X1, Y0, Y1)) *
      (half(R[1]) ^ n * half(R[1]) ^ n)] ≤
      complexAbs(rectIntegral(f, A, B, C, D))
proof
  have hs := rectStages.pair at X0, X1, Y0, Y1
  have leftSeq : RealSequence(goursatLeft(f, ((X0, X1), (Y0, Y1))))
    exact goursatLeft.function with hs
  have rightSeq : RealSequence(goursatRight(f, ((X0, X1), (Y0, Y1))))
    exact goursatRight.function with hs
  have bottomSeq : RealSequence(goursatBottom(f, ((X0, X1), (Y0, Y1))))
    exact goursatBottom.function with hs
  have topSeq : RealSequence(goursatTop(f, ((X0, X1), (Y0, Y1))))
    exact goursatTop.function with hs
  -- The coordinates of the n-th stage.
  have coordinates : ∀ n ∈ ℕ, ∀ A ∈ ℝ, ∀ B ∈ ℝ, ∀ C ∈ ℝ, ∀ D ∈ ℝ,
      goursatStage(f, ((X0, X1), (Y0, Y1)), n) = ((A, B), (C, D)) →
      goursatLeft(f, ((X0, X1), (Y0, Y1)))(n) = A ∧
      goursatRight(f, ((X0, X1), (Y0, Y1)))(n) = B ∧
      goursatBottom(f, ((X0, X1), (Y0, Y1)))(n) = C ∧
      goursatTop(f, ((X0, X1), (Y0, Y1)))(n) = D
    intros n hn A hA B hB C hC D hD stage
    rw [(goursatLeft.value with hs, hn), (goursatRight.value with hs, hn),
      (goursatBottom.value with hs, hn), (goursatTop.value with hs, hn), stage]
    simp [fst.pair, snd.pair]
  have consecutive : ∀ n ∈ ℕ,
      goursatLeft(f, ((X0, X1), (Y0, Y1)))(n) ≤
        goursatLeft(f, ((X0, X1), (Y0, Y1)))(succ(n)) ∧
      goursatRight(f, ((X0, X1), (Y0, Y1)))(succ(n)) ≤
        goursatRight(f, ((X0, X1), (Y0, Y1)))(n) ∧
      goursatBottom(f, ((X0, X1), (Y0, Y1)))(n) ≤
        goursatBottom(f, ((X0, X1), (Y0, Y1)))(succ(n)) ∧
      goursatTop(f, ((X0, X1), (Y0, Y1)))(succ(n)) ≤
        goursatTop(f, ((X0, X1), (Y0, Y1)))(n) ∧
      goursatLeft(f, ((X0, X1), (Y0, Y1)))(n) ≤
        goursatRight(f, ((X0, X1), (Y0, Y1)))(n) ∧
      goursatBottom(f, ((X0, X1), (Y0, Y1)))(n) ≤
        goursatTop(f, ((X0, X1), (Y0, Y1)))(n)
    intros n hn
    have typedN : Nat(n) := nat.omega.backward at n with hn
    obtain ⟨A, hA, B, hB, C, hC, D, hD, stage, a0, ab, b1, c0, cd, d1, _⟩ :=
      goursatStage.invariant at f, V, X0, X1, Y0, Y1, n with values,
      continuous, inside, horizontal, vertical
    have typedA : Real(A) by exact hA
    have typedB : Real(B) by exact hB
    have typedC : Real(C) by exact hC
    have typedD : Real(D) by exact hD
    have sub := RectInside.sub with inside, a0, b1, c0, d1
    obtain ⟨P, hP, Q, hQ, S, hS, T, hT, chosen, ap, _, qb, cs, _, td, _⟩ :=
      goursatChild.step with values, continuous, sub, ab, cd
    have next : goursatStage(f, ((X0, X1), (Y0, Y1)), succ(n)) =
        ((P, Q), (S, T))
      rw [goursatStage, stage]
      exact chosen
    have hn1 : succ(n) ∈ ℕ by typecheck
    obtain ⟨l0, r0, b0, t0⟩ := coordinates with n, hn, A, hA, B, hB, C, hC, D,
      hD, stage
    obtain ⟨l1, r1, bn1, t1⟩ := coordinates with succ(n), hn1, P, hP, Q, hQ, S,
      hS, T, hT, next
    rw [l0, r0, b0, t0, l1, r1, bn1, t1]
    exact ⟨ap, qb, cs, td, ab, cd⟩
  have nestedX : NestedClosedIntervals(goursatLeft(f, ((X0, X1), (Y0, Y1))),
      goursatRight(f, ((X0, X1), (Y0, Y1))))
    refine ⟨leftSeq, rightSeq, ?_, ?_, ?_⟩
    . apply Nondecreasing.of_succ with leftSeq
      intros n hn
      exact (consecutive with n, hn).left
    . apply Nonincreasing.of_succ with rightSeq
      intros n hn
      obtain ⟨_, second, _⟩ := consecutive with n, hn
      exact second
    . intros n hn
      obtain ⟨_, _, _, _, fifth, _⟩ := consecutive with n, hn
      have lReal := RealSequence.value at goursatLeft(f, ((X0, X1), (Y0, Y1))),
        n with leftSeq
      have rReal := RealSequence.value at
        goursatRight(f, ((X0, X1), (Y0, Y1))), n with rightSeq
      exact realLe.characterization.forward with fifth
  have nestedY : NestedClosedIntervals(goursatBottom(f, ((X0, X1), (Y0, Y1))),
      goursatTop(f, ((X0, X1), (Y0, Y1))))
    refine ⟨bottomSeq, topSeq, ?_, ?_, ?_⟩
    . apply Nondecreasing.of_succ with bottomSeq
      intros n hn
      obtain ⟨_, _, third, _⟩ := consecutive with n, hn
      exact third
    . apply Nonincreasing.of_succ with topSeq
      intros n hn
      obtain ⟨_, _, _, fourth, _⟩ := consecutive with n, hn
      exact fourth
    . intros n hn
      obtain ⟨_, _, _, _, _, sixth⟩ := consecutive with n, hn
      have bReal := RealSequence.value at
        goursatBottom(f, ((X0, X1), (Y0, Y1))), n with bottomSeq
      have tReal := RealSequence.value at
        goursatTop(f, ((X0, X1), (Y0, Y1))), n with topSeq
      exact realLe.characterization.forward with sixth
  have xsReal := NestedClosedIntervals.supremum_real with nestedX
  have ysReal := NestedClosedIntervals.supremum_real with nestedY
  refine ⟨realSup(range(goursatLeft(f, ((X0, X1), (Y0, Y1))))), xsReal,
    realSup(range(goursatBottom(f, ((X0, X1), (Y0, Y1))))), ysReal, ?_⟩
  intros n hn
  have typedN : Nat(n) := nat.omega.backward at n with hn
  obtain ⟨A, hA, B, hB, C, hC, D, hD, stage, a0, ab, b1, c0, cd, d1, width,
    height, mass⟩ := goursatStage.invariant at f, V, X0, X1, Y0, Y1, n with
    values, continuous, inside, horizontal, vertical
  obtain ⟨l0, r0, b0, t0⟩ := coordinates with n, hn, A, hA, B, hB, C, hC, D,
    hD, stage
  have containsX := NestedClosedIntervals.contains_supremum at
    goursatLeft(f, ((X0, X1), (Y0, Y1))), goursatRight(f, ((X0, X1), (Y0, Y1))),
    n with nestedX
  have containsY := NestedClosedIntervals.contains_supremum at
    goursatBottom(f, ((X0, X1), (Y0, Y1))), goursatTop(f, ((X0, X1), (Y0, Y1))),
    n with nestedY
  rw [l0, r0] at containsX
  rw [b0, t0] at containsY
  obtain ⟨_, xLow, xHigh⟩ := closedInterval.membership.forward with containsX
  obtain ⟨_, yLow, yHigh⟩ := closedInterval.membership.forward with containsY
  exact ⟨A, hA, B, hB, C, hC, D, hD, xLow, xHigh, yLow, yHigh, a0, b1, c0, d1,
    ab, cd, width, height, mass⟩

-- (1/2)ⁿ is eventually below any positive number.
theorem realRingPow.half_small (E : Real)
  requires positive : R[0] < E
  shows ∃ N ∈ ℕ, R[half(R[1]) ^ N] < E
proof
  have twice := half.add_self at R[1]
  have onePositive : R[0] < R[1] by linarith
  have pPositive := half.positive with onePositive
  have pNonnegative : R[0] ≤ half(R[1]) by linarith
  have pBelow : half(R[1]) < R[1] by linarith
  obtain ⟨N, hN, small⟩ := realPow.eventually_small with pNonnegative, pBelow,
    positive
  have typedN : Nat(N) := nat.omega.backward at N with hN
  have reflexive : N ≤ N := LessEqual.reflexive at N
  have smallN := small with N, hN, reflexive
  have convert : realPow(half(R[1]), N) = R[half(R[1]) ^ N]
    unfold realPow
    rfl
  rw convert at smallN
  exact ⟨N, hN, smallN⟩

-- Goursat's lemma: the integral of a function differentiable at every
-- point of a rectangle around its boundary vanishes.
theorem rectIntegral.goursat (f V : Set) (X0 X1 Y0 Y1 : Real)
  requires values : ComplexValuedOn(f, complexCarrier)
  requires continuous : ComplexContinuousOn(f, V)
  requires inside : RectInside(V, X0, X1, Y0, Y1)
  requires horizontal : X0 ≤ X1
  requires vertical : Y0 ≤ Y1
  requires differentiable : ∀ X ∈ closedInterval(X0, X1),
    ∀ Y ∈ closedInterval(Y0, Y1), ComplexDifferentiableAt(f, V, (X, Y))
  shows rectIntegral(f, X0, X1, Y0, Y1) = ℂ[0]
proof
  obtain ⟨Xs, hXs, Ys, hYs, nested⟩ := goursatStage.limit with values,
    continuous, inside, horizontal, vertical
  have typedXs : Real(Xs) by exact hXs
  have typedYs : Real(Ys) by exact hYs
  have zero : (0:N) ∈ ℕ by typecheck
  obtain ⟨A0, _, B0, _, C0, _, D0, _, xa, xb, yc, yd, a0, b0, c0, d0, _⟩ :=
    nested with (0:N), zero
  have xsIn : Xs ∈ closedInterval(X0, X1)
    apply closedInterval.membership.backward
    refine ⟨hXs, ?_, ?_⟩
    . linarith
    . linarith
  have ysIn : Ys ∈ closedInterval(Y0, Y1)
    apply closedInterval.membership.backward
    refine ⟨hYs, ?_, ?_⟩
    . linarith
    . linarith
  have z0V := inside with Xs, xsIn, Ys, ysIn
  have z0 := complexCarrier.pair at Xs, Ys
  obtain ⟨D, hD, derivative⟩ := differentiable with Xs, xsIn, Ys, ysIn
  have derivativeCopy := derivative
  obtain ⟨isOpen, _, _, valuesV, close⟩ := derivativeCopy
  have fz0 := values with (Xs, Ys), z0
  have sub := ComplexOpen.subset with isOpen
  have j0 := rectIntegral.member at f, X0, X1, Y0, Y1
  have kReal : R[(X1 - X0) + (Y1 - Y0)] ∈ ℝ by typecheck
  have kNonnegative : R[0] ≤ R[(X1 - X0) + (Y1 - Y0)] by linarith
  have twice := half.add_self at R[1]
  have onePositive : R[0] < R[1] by linarith
  have pPositive := half.positive with onePositive
  have affineContinuous := ComplexContinuousOn.mono with
    (affineFunction.continuous with fz0, hD, z0), sub
  have errorFormula : ∀ w ∈ V, linearError(f, f((Xs, Ys)), D, (Xs, Ys))(w) =
      ℂ[f(w) - affineFunction(f((Xs, Ys)), D, (Xs, Ys))(w)]
    intros w hw
    exact linearError.value with values, fz0, hD, z0, (sub with w, hw)
  have errorContinuous := ComplexContinuousOn.sub with continuous,
    affineContinuous, errorFormula
  -- For every ε > 0: |J| ≤ 4 K² ε with K the half perimeter.
  have estimate : ∀ e ∈ ℝ, R[0] < e →
      complexAbs(rectIntegral(f, X0, X1, Y0, Y1)) ≤
        R[(4 * (((X1 - X0) + (Y1 - Y0)) * ((X1 - X0) + (Y1 - Y0)))) * e]
    intros e he positive
    obtain ⟨δ, hδ, δPositive, near⟩ := close with e, he, positive
    have halfδ := half.positive with δPositive
    have halfδReal : half(δ) ∈ ℝ by typecheck
    have halfBelow := half.lt_self with δPositive
    obtain ⟨t, ht, tPositive, scaledT, _⟩ := realScale.absorb with kReal,
      halfδReal, kNonnegative, halfδ
    obtain ⟨N, hN, small⟩ := realRingPow.half_small with tPositive
    have typedN : Nat(N) := nat.omega.backward at N with hN
    obtain ⟨A, hA, B, hB, C, hC, Dn, hDn, xaN, xbN, ycN, ydN, a0N, b1N, c0N,
      d1N, ab, cd, width, height, mass⟩ := nested with N, hN
    have typedA : Real(A) by exact hA
    have typedB : Real(B) by exact hB
    have typedC : Real(C) by exact hC
    have typedD : Real(Dn) by exact hDn
    have pNReal : R[half(R[1]) ^ N] ∈ ℝ by typecheck
    have pN : R[0] < R[half(R[1]) ^ N]
      have convert : realPow(half(R[1]), N) = R[half(R[1]) ^ N]
        unfold realPow
        rfl
      rw ← convert
      exact realPow.positive at half(R[1]), N with pPositive
    -- The stage is within K pᴺ < δ of the limit point.
    have sizeBound : R[(B - A) + (Dn - C)] < δ
      have expand : R[(B - A) + (Dn - C)] =
          R[((X1 - X0) + (Y1 - Y0)) * half(R[1]) ^ N]
        rw [width, height]
        ring
      rw expand
      have smallLe := realLess.implies_le with small
      have scaled := realLe.mul_left_of_nonnegative with smallLe,
        kNonnegative
      linarith
    have stageInside := RectInside.sub with inside, a0N, b1N, c0N, d1N
    have mReal : R[e * ((B - A) + (Dn - C))] ∈ ℝ by typecheck
    have pointBound : ∀ X ∈ closedInterval(A, B), ∀ Y ∈ closedInterval(C, Dn),
        complexAbs(linearError(f, f((Xs, Ys)), D, (Xs, Ys))((X, Y))) ≤
          R[e * ((B - A) + (Dn - C))]
      intros X hX Y hY
      obtain ⟨xReal, xLow, xHigh⟩ := closedInterval.membership.forward with hX
      obtain ⟨yReal, yLow, yHigh⟩ := closedInterval.membership.forward with hY
      have typedX : Real(X) by exact xReal
      have typedY : Real(Y) by exact yReal
      have point := complexCarrier.pair at X, Y
      have wV := stageInside with X, hX, Y, hY
      have dx : abs(R[X - Xs]) ≤ R[B - A]
        apply abs.le_of_two_sided
        . linarith
        . linarith
      have dy : abs(R[Y - Ys]) ≤ R[Dn - C]
        apply abs.le_of_two_sided
        . linarith
        . linarith
      have distance := complexPoint.dist at X, Y, Xs, Ys
      have closeEnough : complexAbs(ℂ[(X, Y) - (Xs, Ys)]) < δ by linarith
      have bound := near with (X, Y), wV, closeEnough
      have fw := values with (X, Y), point
      rw [(linearError.value with values, fz0, hD, z0, point),
        (affineFunction.value with fz0, hD, z0, point)]
      have same : ℂ[f((X, Y)) - (f((Xs, Ys)) + D * ((X, Y) - (Xs, Ys)))] =
        ℂ[f((X, Y)) - f((Xs, Ys)) - D * ((X, Y) - (Xs, Ys))] by ring
      rw same
      have eNonnegative : R[0] ≤ e by linarith
      have distanceLe : complexAbs(ℂ[(X, Y) - (Xs, Ys)]) ≤
        R[(B - A) + (Dn - C)] by linarith
      have scaled := realLe.mul_left_of_nonnegative with distanceLe,
        eNonnegative
      linarith
    -- So the integral around the stage is small.
    have errorValues : ComplexValuedOn(linearError(f, f((Xs, Ys)), D,
        (Xs, Ys)), ℂ)
      intros w hw
      exact FunctionBetween.apply_closed with
        (linearError.function with values, fz0, hD, z0), hw
    have affineValues : ComplexValuedOn(affineFunction(f((Xs, Ys)), D,
        (Xs, Ys)), ℂ)
      intros w hw
      exact FunctionBetween.apply_closed with
        (affineFunction.function with fz0, hD, z0), hw
    have formula : ∀ w ∈ ℂ, f(w) = ℂ[linearError(f, f((Xs, Ys)), D,
        (Xs, Ys))(w) + affineFunction(f((Xs, Ys)), D, (Xs, Ys))(w)]
      intros w hw
      have fw := values with w, hw
      have aw := affineValues with w, hw
      rw (linearError.value with values, fz0, hD, z0, hw)
      ring
    have split := rectIntegral.add with errorValues, affineValues,
      errorContinuous, affineContinuous, stageInside, ab, cd, formula
    rw (rectIntegral.affine with fz0, hD, z0, ab, cd) at split
    have errorIntegral := rectIntegral.member at
      linearError(f, f((Xs, Ys)), D, (Xs, Ys)), A, B, C, Dn
    have simplify : ℂ[rectIntegral(linearError(f, f((Xs, Ys)), D, (Xs, Ys)),
        A, B, C, Dn) + 0] =
        rectIntegral(linearError(f, f((Xs, Ys)), D, (Xs, Ys)), A, B, C, Dn)
      by ring
    rw simplify at split
    have stageBound := rectIntegral.abs_le with errorValues, errorContinuous,
      stageInside, ab, cd, pointBound
    rw ← split at stageBound
    -- Compare with the mass invariant and cancel p²ᴺ.
    have expandSize : R[(B - A) + (Dn - C)] =
        R[((X1 - X0) + (Y1 - Y0)) * half(R[1]) ^ N]
      rw [width, height]
      ring
    rw expandSize at stageBound
    have squarePositive := realMulValue.positive with pN, pN
    have chain : R[complexAbs(rectIntegral(f, X0, X1, Y0, Y1)) *
        (half(R[1]) ^ N * half(R[1]) ^ N)] ≤
        R[((4 * (((X1 - X0) + (Y1 - Y0)) * ((X1 - X0) + (Y1 - Y0)))) * e) *
        (half(R[1]) ^ N * half(R[1]) ^ N)]
      have regroup : R[4 * (R[e * (((X1 - X0) + (Y1 - Y0)) *
          half(R[1]) ^ N)] * (((X1 - X0) + (Y1 - Y0)) * half(R[1]) ^ N))] =
          R[((4 * (((X1 - X0) + (Y1 - Y0)) * ((X1 - X0) + (Y1 - Y0)))) * e) *
          (half(R[1]) ^ N * half(R[1]) ^ N)] by ring
      linarith
    exact realLe.mul_right_cancel_positive with squarePositive, chain
  by_contra nonzero
  have positiveJ := complexAbs.positive with j0, nonzero
  have halfJ := half.positive with positiveJ
  have halfJReal : half(complexAbs(rectIntegral(f, X0, X1, Y0, Y1))) ∈ ℝ by
    typecheck
  have halfJBelow := half.lt_self with positiveJ
  have wReal : R[4 * (((X1 - X0) + (Y1 - Y0)) * ((X1 - X0) + (Y1 - Y0)))] ∈ ℝ
    by typecheck
  have square := realMulValue.square_nonnegative at R[(X1 - X0) + (Y1 - Y0)]
  have wNonnegative : R[0] ≤
    R[4 * (((X1 - X0) + (Y1 - Y0)) * ((X1 - X0) + (Y1 - Y0)))] by linarith
  obtain ⟨e, he, ePositive, scaledE, _⟩ := realScale.absorb with wReal,
    halfJReal, wNonnegative, halfJ
  have bound := estimate with e, he, ePositive
  linarith

-- Section: Limits and series of holomorphic functions
-- A locally uniform limit of holomorphic functions is holomorphic, and
-- the derivatives converge locally uniformly to its derivative.
theorem HolomorphicOn.uniform_limit (F f U : Set)
  requires holomorphic : ∀ n ∈ ℕ, HolomorphicOn(F(n), U)
  requires values : ComplexValuedOn(f, U)
  requires limit : ComplexLocallyUniformlyConvergesOn(F, f, U)
  shows HolomorphicOn(f, U)
proof
  sorry

theorem HolomorphicOn.uniform_limit_deriv (F f U G : Set)
  requires holomorphic : ∀ n ∈ ℕ, HolomorphicOn(F(n), U)
  requires values : ComplexValuedOn(f, U)
  requires limit : ComplexLocallyUniformlyConvergesOn(F, f, U)
  requires derivatives : ∀ n ∈ ℕ, G(n) = complexDeriv(F(n), U)
  shows ComplexLocallyUniformlyConvergesOn(G, complexDeriv(f, U), U)
proof
  sorry

-- The Weierstrass M-test: a series of holomorphic functions dominated on
-- each compact subset by a convergent series of constants converges, and
-- its sum is holomorphic.
theorem HolomorphicOn.series (F U : Set)
  requires holomorphic : ∀ n ∈ ℕ, HolomorphicOn(F(n), U)
  requires dominated : ∀ K, K ⊆ U → ComplexCompact(K) →
    (∃ M, Summable(M) ∧ (∀ n ∈ ℕ, ∀ z ∈ K, complexAbs(F(n)(z)) ≤ M(n)))
  shows (∀ z ∈ U, ComplexSummable(complexValueSequence(F, z))) ∧
    HolomorphicOn(complexFunctionSeries(F, U), U)
proof
  sorry

-- Section: The identity theorem
-- Two functions holomorphic on a connected open set that agree on a set
-- with an accumulation point in it agree everywhere on it.
theorem holomorphic.identity_accumulation (f g U S a : Set)
  requires holomorphicF : HolomorphicOn(f, U)
  requires holomorphicG : HolomorphicOn(g, U)
  requires connected : ComplexConnected(U)
  requires inside : S ⊆ U
  requires ha : a ∈ U
  requires accumulates : ∀ r ∈ ℝ, R[0] < r →
    (∃ s ∈ S, s ≠ a ∧ complexAbs(ℂ[s - a]) < r)
  requires agree : ∀ z ∈ S, f(z) = g(z)
  shows ∀ z ∈ U, f(z) = g(z)
proof
  sorry

-- Two functions holomorphic on a connected open set that agree on a
-- nonempty open subset agree everywhere on it.
theorem holomorphic.identity (f g U V : Set)
  requires holomorphicF : HolomorphicOn(f, U)
  requires holomorphicG : HolomorphicOn(g, U)
  requires connected : ComplexConnected(U)
  requires isOpen : ComplexOpen(V)
  requires nonempty : ∃ v, v ∈ V
  requires inside : V ⊆ U
  requires agree : ∀ z ∈ V, f(z) = g(z)
  shows ∀ z ∈ U, f(z) = g(z)
proof
  obtain ⟨v, hv⟩ := nonempty
  have vU := inside with v, hv
  obtain ⟨ρ, hρ, ρPositive, disk⟩ := ComplexOpen.disk with isOpen, hv
  have sub := ComplexOpen.subset with isOpen
  have vMember := sub with v, hv
  have accumulates : ∀ s ∈ ℝ, R[0] < s →
      (∃ p ∈ V, p ≠ v ∧ complexAbs(ℂ[p - v]) < s)
    intros s hs sPositive
    obtain ⟨t, ht, tPositive, leS, leρ⟩ := realRadius.common with hs, hρ,
      sPositive, ρPositive
    have halfPositive := half.positive with tPositive
    have halfBelow := half.lt_self with tPositive
    have point : ℂ[v + complexOfReal(half(t))] ∈ ℂ by typecheck
    have distance : complexAbs(ℂ[(v + complexOfReal(half(t))) - v]) = half(t)
      have shift : ℂ[(v + complexOfReal(half(t))) - v] =
        complexOfReal(half(t)) by ring
      have halfNonnegative : R[0] ≤ half(t) by linarith
      rw [shift, (complexAbs.of_real at half(t)),
        (abs.of_nonnegative at half(t) with halfNonnegative)]
    have inDisk : ℂ[v + complexOfReal(half(t))] ∈ complexDisk(v, ρ)
      apply complexDisk.membership.backward
      refine ⟨point, ?_⟩
      rw distance
      linarith
    have inV := disk with ℂ[v + complexOfReal(half(t))], inDisk
    refine ⟨ℂ[v + complexOfReal(half(t))], inV, ?_, ?_⟩
    . intro same
      rw same at distance
      have zero : ℂ[v - v] = ℂ[0] by ring
      rw [zero, complexAbs.zero] at distance
      linarith
    . rw distance
      linarith
  exact holomorphic.identity_accumulation with holomorphicF, holomorphicG,
    connected, inside, vU, accumulates, agree

end Holomorphy

-- The derivative of a holomorphic function is holomorphic.
theorem HolomorphicOn.deriv (f U : Set)
  requires holomorphic : HolomorphicOn(f, U)
  shows HolomorphicOn(complexDeriv(f, U), U)
proof
  have isOpen := holomorphic.left
  have function := complexDeriv.function with holomorphic
  apply HolomorphicOn.of_local with isOpen
  intros a ha
  obtain ⟨r, hr, rPositive, inside⟩ := ComplexOpen.disk with isOpen, ha
  have sub := ComplexOpen.subset with isOpen
  have aMember := sub with a, ha
  obtain ⟨c, radius, sums⟩ := HolomorphicOn.power_series with holomorphic, ha,
    hr, inside
  have diskOpen := complexDisk.open with aMember, hr
  have center := complexDisk.center with aMember, hr, rPositive
  -- On the disk f is the sum of its power series.
  have agree : ∀ z ∈ complexDisk(a, r),
      powerSeriesSum(c, a, r)(z) = f(z)
    intros z hz
    have own := powerSeriesSum.sums with radius, aMember, hz
    exact ComplexSumsTo.unique with own, (sums with z, hz)
  -- So the derivative of f there is the termwise derivative.
  have derivativeAgree : ∀ z ∈ complexDisk(a, r),
      powerSeriesSum(powerSeriesDerivCoefficients(c), a, r)(z) =
      complexDeriv(f, U)(z)
    intros z hz
    have series := powerSeriesSum.has_derivative with radius, aMember, hz
    have moved := HasComplexDerivativeAt.congr with series, agree
    have zU := inside with z, hz
    have own := complexDeriv.has_derivative with holomorphic, zU
    have restricted := HasComplexDerivativeAt.mono with own, diskOpen, inside,
      hz
    exact HasComplexDerivativeAt.unique with moved, restricted
  have radiusDerived := powerSeriesDerivCoefficients.radius_at_least with
    radius
  have holomorphicSeries := powerSeriesSum.holomorphic at
    powerSeriesDerivCoefficients(c), a, r with radiusDerived, aMember
  have holomorphicDisk := HolomorphicOn.congr with holomorphicSeries,
    derivativeAgree
  exact ⟨complexDisk(a, r), diskOpen, center, inside, holomorphicDisk⟩
