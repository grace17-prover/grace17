-- Fourier series on the torus 𝕋ⁿ = ℝⁿ/ℤⁿ: functions on the torus as
-- ℤⁿ-periodic functions on ℝⁿ, integrated over the unit cube [0, 1)ⁿ (a
-- fundamental domain, with the quotient measure of the torus); the
-- characters e_k(x) = e(⟨k, x⟩), k ∈ ℤⁿ, and their orthonormality;
-- Fourier coefficients, density of trigonometric polynomials uniformly
-- and in L², Parseval's identity and L² convergence of Fourier series,
-- pointwise convergence for absolutely summable coefficients, uniqueness;
-- the coefficients of a periodization as values of the Fourier
-- transform; and averages over circles in ℂ, with the mean value
-- property of holomorphic functions.
-- Part of the GRH blueprint.
-- Planned home: Analysis/Fourier/AddCircleMulti.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Fourier.Torus
import GRH.Fourier.Euclidean

section Torus
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Section: Definitions
-- The integer vectors ℤⁿ, read in ℝⁿ, and the lattice they form.
def integerVectors (n : Nat) : Set := functionSpace(n, ℤ)
def integerVectorToReal (n : Nat, k : Set) : Set := { (i, realInt(k(i))) | i ∈ n }
def integerLattice (n : Nat) : Set := { integerVectorToReal(n, k) | k ∈ integerVectors(n) }
def integerVectorAdd (n : Nat, k l : Set) : Set := { (i, integerAddValue(k(i), l(i))) | i ∈ n }
def integerVectorNeg (n : Nat, k : Set) : Set := { (i, integerNegValue(k(i))) | i ∈ n }

-- The character e_k(x) = e(⟨k, x⟩) of the torus (Mathlib's
-- UnitAddTorus.mFourier), as a ℤⁿ-periodic map on ℝⁿ.
def torusCharacter (n : Nat, k : Set) : Set :=
  { (x, expTwoPiI(realInner(n, integerVectorToReal(n, k), x))) | x ∈ functionSpace(n, ℝ) }

-- f is a function on the torus: a ℤⁿ-periodic complex map on ℝⁿ.
predicate TorusFunction (n : Nat, f : Set) :=
  FunctionBetween(f, functionSpace(n, ℝ), complexCarrier) ∧
  (∀ x ∈ functionSpace(n, ℝ), ∀ k ∈ integerLattice(n), f(vectorAdd(n, x, k)) = f(x))

-- The unit cube [0, 1)ⁿ, a fundamental domain of ℤⁿ, and the measure of
-- the torus read on it: Lebesgue measure restricted to the cube.
def torusCube (n : Nat) : Set :=
  { x ∈ functionSpace(n, ℝ) | ∀ i ∈ n, realZero ≤ x(i) ∧ x(i) < realOne }
def torusMeasure (n : Nat) : Set :=
  restrictMeasure(euclideanMeasurableSpace(n), euclideanVolume(n), torusCube(n))
def torusIntegral (n : Nat, f : Set) : Set :=
  complexMeasureIntegral(euclideanMeasurableSpace(n), torusMeasure(n), f)

-- The L² inner product ⟨f, g⟩ = ∫ conj(f) g on the torus, square
-- integrability, and the L² distance squared ∫ |f − g|².
def torusInner (n : Nat, f g : Set) : Set :=
  l2Inner(euclideanMeasurableSpace(n), torusMeasure(n), f, g)
predicate TorusSquareIntegrable (n : Nat, f : Set) :=
  TorusFunction(n, f) ∧ SquareIntegrable(euclideanMeasurableSpace(n), torusMeasure(n), f)
def torusDistanceSquared (n : Nat, f g : Set) : Set :=
  lintegral(euclideanMeasurableSpace(n), torusMeasure(n),
    complexAbsSquareOn(complexSubOn(f, g, functionSpace(n, ℝ)), functionSpace(n, ℝ)))

-- The Fourier coefficient f̂(k) = ∫ e(−⟨k, x⟩) f(x) over the torus
-- (Mathlib's UnitAddTorus.mFourierCoeff), and the family k ↦ f̂(k).
def fourierCoefficient (n : Nat, f k : Set) : Set :=
  torusIntegral(n, complexMulOn(complexConjOn(torusCharacter(n, k), functionSpace(n, ℝ)), f,
    functionSpace(n, ℝ)))
def fourierCoefficients (n : Nat, f : Set) : Set :=
  { (k, fourierCoefficient(n, f, k)) | k ∈ integerVectors(n) }
def coefficientSquares (n : Nat, f : Set) : Set :=
  { (k, R[complexAbs(fourierCoefficient(n, f, k)) * complexAbs(fourierCoefficient(n, f, k))]) |
    k ∈ integerVectors(n) }
def coefficientModuli (n : Nat, f : Set) : Set :=
  { (k, complexAbs(fourierCoefficient(n, f, k))) | k ∈ integerVectors(n) }

-- Trigonometric polynomials Σ_{k ∈ F} c(k) e_k over a finite F ⊆ ℤⁿ, and
-- the terms of a Fourier series at x.
def trigonometricTerms (n : Nat, F c x : Set) : Set :=
  { (k, ℂ[c(k) * torusCharacter(n, k)(x)]) | k ∈ F }
def trigonometricPolynomial (n : Nat, F c : Set) : Set :=
  { (x, complexSetSum(F, trigonometricTerms(n, F, c, x))) | x ∈ functionSpace(n, ℝ) }
def fourierSeriesTerms (n : Nat, f x : Set) : Set :=
  { (k, ℂ[fourierCoefficient(n, f, k) * torusCharacter(n, k)(x)]) | k ∈ integerVectors(n) }

-- The periodization Σ_{k ∈ ℤⁿ} f(x + k) of a map on ℝⁿ.
def latticeTranslates (n : Nat, f x : Set) : Set :=
  { (k, f(vectorAdd(n, x, integerVectorToReal(n, k)))) | k ∈ integerVectors(n) }
def periodization (n : Nat, f : Set) : Set :=
  { (x, complexTsum(latticeTranslates(n, f, x), integerVectors(n))) | x ∈ functionSpace(n, ℝ) }

-- The average of f over the circle of radius r about c in ℂ (Mathlib's
-- Real.circleAverage): ∫_0^1 f(c + r e(t)) dt.
def circlePoints (f c : Set, r : Real) : Set :=
  { (T, f(ℂ[c + complexOfReal(r) * expTwoPiI(T)])) | T ∈ ℝ }
def circleAverage (f c : Set, r : Real) : Set :=
  complexSetIntegral(realMeasurableSpace, realVolume, circlePoints(f, c, r),
    realIoc(realZero, realOne))

-- Section: Characters of the torus
theorem torusCharacter.torus_function (n : Nat, k : Set)
  requires member : k ∈ integerVectors(n)
  shows TorusFunction(n, torusCharacter(n, k))
proof
  sorry

theorem torusCharacter.abs (n : Nat, k x : Set)
  requires member : k ∈ integerVectors(n)
  requires point : x ∈ functionSpace(n, ℝ)
  shows complexAbs(torusCharacter(n, k)(x)) = realOne
proof
  sorry

theorem torusCharacter.mul (n : Nat, k l x : Set)
  requires memberK : k ∈ integerVectors(n)
  requires memberL : l ∈ integerVectors(n)
  requires point : x ∈ functionSpace(n, ℝ)
  shows ℂ[torusCharacter(n, k)(x) * torusCharacter(n, l)(x)] =
      torusCharacter(n, integerVectorAdd(n, k, l))(x) ∧
    complexConj(torusCharacter(n, k)(x)) = torusCharacter(n, integerVectorNeg(n, k))(x)
proof
  sorry

-- Mathlib's hasDerivAt_fourier: ∂ᵢ e_k = 2πi kᵢ e_k.
theorem torusCharacter.partial (n : Nat, k i x : Set)
  requires member : k ∈ integerVectors(n)
  requires coordinate : i ∈ n
  requires point : x ∈ functionSpace(n, ℝ)
  shows HasPartialDerivative(n, torusCharacter(n, k), i, x,
    ℂ[complexOfReal(R[2 * realPi * realInt(k(i))]) * complexImaginaryUnit *
      torusCharacter(n, k)(x)])
proof
  sorry

-- Mathlib's UnitAddTorus.orthonormal_mFourier: ⟨e_k, e_l⟩ = [k = l].
theorem torusCharacter.orthonormal (n : Nat, k l : Set)
  requires memberK : k ∈ integerVectors(n)
  requires memberL : l ∈ integerVectors(n)
  shows (k = l → torusInner(n, torusCharacter(n, k), torusCharacter(n, l)) = complexOne) ∧
    (k ≠ l → torusInner(n, torusCharacter(n, k), torusCharacter(n, l)) = complexZero)
proof
  sorry

-- Section: The measure of the torus
theorem torusMeasure.probability (n : Nat)
  shows ProbabilityMeasure(euclideanMeasurableSpace(n), torusMeasure(n))
proof
  sorry

-- The cube is a fundamental domain of ℤⁿ acting on ℝⁿ by translation, and
-- the torus measure is the quotient measure of Lebesgue measure.
theorem torusCube.fundamental_domain (n : Nat)
  shows Subgroup(integerLattice(n), euclideanAdditiveGroup(n)) ∧
    Countable(integerLattice(n)) ∧
    FundamentalDomain(euclideanAdditiveGroup(n), euclideanTopology(n), euclideanVolume(n),
      integerLattice(n), torusCube(n))
proof
  sorry

theorem torusMeasure.quotient (n : Nat, h : Set)
  requires measurable : Measurable(h, borelSpace(cosetSpace(euclideanAdditiveGroup(n),
    euclideanTopology(n), integerLattice(n))), ennMeasurableSpace)
  shows lintegral(borelSpace(cosetSpace(euclideanAdditiveGroup(n), euclideanTopology(n),
      integerLattice(n))),
      quotientMeasure(euclideanAdditiveGroup(n), euclideanTopology(n), euclideanVolume(n),
        integerLattice(n), torusCube(n)), h) =
    lintegral(euclideanMeasurableSpace(n), torusMeasure(n),
      composeOn(h, cosetProjection(euclideanAdditiveGroup(n), integerLattice(n)),
        functionSpace(n, ℝ)))
proof
  sorry

-- The integral of a function on the torus is invariant under translation
-- (Mathlib's AddCircle.intervalIntegral_preimage: any period cube gives
-- the same integral).
theorem torusIntegral.translate (n : Nat, f c : Set)
  requires periodic : TorusFunction(n, f)
  requires vector : c ∈ functionSpace(n, ℝ)
  shows torusIntegral(n, translateFunction(n, f, c)) = torusIntegral(n, f)
proof
  sorry

-- Section: Density of trigonometric polynomials
-- Uniform density (Mathlib's span_mFourier_closure_eq_top, by
-- Stone–Weierstrass): a continuous function on the torus is a uniform
-- limit of trigonometric polynomials.
theorem trigonometricPolynomial.uniformly_dense (n : Nat, f : Set, e : Real)
  requires periodic : TorusFunction(n, f)
  requires continuous : f : euclideanTopology(n) ⇒ complexSpace
  requires positive : realZero < e
  shows ∃ F ⊆ integerVectors(n), Finite(F) ∧ ∃ c, (∀ k ∈ F, c(k) ∈ complexCarrier) ∧
    (∀ x ∈ functionSpace(n, ℝ),
      complexAbs(ℂ[f(x) - trigonometricPolynomial(n, F, c)(x)]) < e)
proof
  sorry

-- Density in L² (Mathlib's ContinuousMap.toLp_denseRange with the above).
theorem trigonometricPolynomial.l2_dense (n : Nat, f : Set, e : Real)
  requires square : TorusSquareIntegrable(n, f)
  requires positive : realZero < e
  shows ∃ F ⊆ integerVectors(n), Finite(F) ∧ ∃ c, (∀ k ∈ F, c(k) ∈ complexCarrier) ∧
    EnnLt(torusDistanceSquared(n, f, trigonometricPolynomial(n, F, c)), e)
proof
  sorry

-- Section: Fourier series
-- The coefficients of a trigonometric polynomial are its coefficients.
theorem fourierCoefficient.trigonometric (n : Nat, F c k : Set)
  requires finite : Finite(F)
  requires inside : F ⊆ integerVectors(n)
  requires values : ∀ l ∈ F, c(l) ∈ complexCarrier
  requires member : k ∈ F
  shows fourierCoefficient(n, trigonometricPolynomial(n, F, c), k) = c(k)
proof
  sorry

-- Bessel's inequality and Parseval's identity (Mathlib's
-- tsum_sq_fourierCoeff): Σ_k |f̂(k)|² = ∫ |f|².
theorem fourierCoefficients.parseval (n : Nat, f : Set)
  requires square : TorusSquareIntegrable(n, f)
  shows RealHasSum(coefficientSquares(n, f), integerVectors(n),
    ennToReal(torusDistanceSquared(n, f, constantOn(functionSpace(n, ℝ), complexZero))))
proof
  sorry

-- The Fourier series of an L² function converges to it in L²
-- (Mathlib's hasSum_fourier_series_L2): along the finite sets of indices.
theorem fourierSeries.l2_convergence (n : Nat, f : Set, e : Real)
  requires square : TorusSquareIntegrable(n, f)
  requires positive : realZero < e
  shows ∃ F0 ⊆ integerVectors(n), Finite(F0) ∧
    (∀ F ⊆ integerVectors(n), Finite(F) → F0 ⊆ F →
      EnnLt(torusDistanceSquared(n, f,
        trigonometricPolynomial(n, F, fourierCoefficients(n, f))), e))
proof
  sorry

-- Mathlib's has_pointwise_sum_fourier_series_of_summable: a continuous
-- function whose coefficients are absolutely summable is the sum of its
-- Fourier series everywhere.
theorem fourierSeries.pointwise (n : Nat, f x : Set)
  requires periodic : TorusFunction(n, f)
  requires continuous : f : euclideanTopology(n) ⇒ complexSpace
  requires summable : RealSummable(coefficientModuli(n, f), integerVectors(n))
  requires point : x ∈ functionSpace(n, ℝ)
  shows ComplexHasSum(fourierSeriesTerms(n, f, x), integerVectors(n), f(x))
proof
  sorry

-- Uniqueness: an L² function with vanishing coefficients vanishes almost
-- everywhere, and a continuous one everywhere.
theorem fourierCoefficients.unique_l2 (n : Nat, f : Set)
  requires square : TorusSquareIntegrable(n, f)
  requires vanishing : ∀ k ∈ integerVectors(n), fourierCoefficient(n, f, k) = complexZero
  shows AEEqual(euclideanMeasurableSpace(n), euclideanVolume(n), f,
    constantOn(functionSpace(n, ℝ), complexZero))
proof
  sorry

theorem fourierCoefficients.unique_continuous (n : Nat, f : Set)
  requires periodic : TorusFunction(n, f)
  requires continuous : f : euclideanTopology(n) ⇒ complexSpace
  requires vanishing : ∀ k ∈ integerVectors(n), fourierCoefficient(n, f, k) = complexZero
  shows ∀ x ∈ functionSpace(n, ℝ), f(x) = complexZero
proof
  sorry

-- The coefficients of the periodization of an integrable map are the
-- values of its Fourier transform at the integer points.
theorem periodization.coefficients (n : Nat, f k : Set)
  requires integrable : EuclideanIntegrable(n, f)
  requires member : k ∈ integerVectors(n)
  shows fourierCoefficient(n, periodization(n, f), k) =
    fourierTransform(n, f)(integerVectorToReal(n, k))
proof
  sorry

-- Section: Circle averages
theorem circleAverage.const (c v : Set, r : Real)
  requires member : v ∈ complexCarrier
  shows circleAverage(constantOn(complexCarrier, v), c, r) = v
proof
  sorry

-- The mean value property: for f holomorphic on an open set containing
-- the closed disc of radius r about c, the circle average is f(c).
theorem circleAverage.holomorphic (f U c : Set, r : Real)
  requires holomorphic : HolomorphicOn(f, U)
  requires positive : realZero < r
  requires disc : complexClosedDisk(c, r) ⊆ U
  shows circleAverage(f, c, r) = f(c)
proof
  sorry

-- |avg f| ≤ max |f| on the circle.
theorem circleAverage.abs_le (f c : Set, r M : Real)
  requires continuous : ComplexContinuousOn(f, complexCarrier)
  requires bound : ∀ T ∈ ℝ, complexAbs(f(ℂ[c + complexOfReal(r) * expTwoPiI(T)])) ≤ M
  shows complexAbs(circleAverage(f, c, r)) ≤ M
proof
  sorry

end Torus
