-- The Fourier transform on ℝⁿ: 𝓕f(w) = ∫ e(−⟨x, w⟩) f(x) dx and its
-- inverse with e(⟨x, w⟩), for e(t) = e^(2πit) (Mathlib's
-- Real.fourierIntegral and VectorFourier on Euclidean space); linearity,
-- the bound by ∫ |f|, continuity and the Riemann–Lebesgue lemma;
-- translation, modulation and dilation; the transform of a Gaussian;
-- Fourier inversion for integrable f with integrable transform;
-- partial derivatives, Schwartz functions, the transform of a derivative
-- and the derivative of a transform; and the periodization of an
-- integrable function on ℝ.
-- Part of the GRH blueprint.
-- Planned home: Analysis/Fourier/FourierTransform and
-- Analysis/Distribution/SchwartzSpace.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Fourier.Euclidean
import GRH.Fourier.FiniteAbelian
import GRH.Measure.Haar

section EuclideanFourier
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Section: Definitions
-- The inner product ⟨x, w⟩ = Σ xᵢ wᵢ on ℝⁿ.
def realInner (n : Nat, x w : Set) : Set := vecDot(realRing, n, x, w)

-- The Fourier transform and its inverse on ℝⁿ, as maps ℝⁿ → ℂ.
def fourierIntegrand (n : Nat, f w : Set) : Set :=
  { (x, ℂ[expTwoPiI(R[-realInner(n, x, w)]) * f(x)]) | x ∈ functionSpace(n, ℝ) }
def fourierTransform (n : Nat, f : Set) : Set :=
  { (w, complexMeasureIntegral(euclideanMeasurableSpace(n), euclideanVolume(n),
      fourierIntegrand(n, f, w))) | w ∈ functionSpace(n, ℝ) }
def fourierInvIntegrand (n : Nat, f w : Set) : Set :=
  { (x, ℂ[expTwoPiI(realInner(n, x, w)) * f(x)]) | x ∈ functionSpace(n, ℝ) }
def fourierInverse (n : Nat, f : Set) : Set :=
  { (w, complexMeasureIntegral(euclideanMeasurableSpace(n), euclideanVolume(n),
      fourierInvIntegrand(n, f, w))) | w ∈ functionSpace(n, ℝ) }

-- On ℝ itself (Mathlib's Real.fourierIntegral, 𝓕f(w) = ∫ e(−x w) f(x)).
def realFourierIntegrand (f W : Set) : Set :=
  { (X, ℂ[expTwoPiI(R[-(X * W)]) * f(X)]) | X ∈ ℝ }
def realFourierTransform (f : Set) : Set :=
  { (W, complexMeasureIntegral(realMeasurableSpace, realVolume, realFourierIntegrand(f, W))) |
    W ∈ ℝ }
def realFourierInvIntegrand (f W : Set) : Set :=
  { (X, ℂ[expTwoPiI(R[X * W]) * f(X)]) | X ∈ ℝ }
def realFourierInverse (f : Set) : Set :=
  { (W, complexMeasureIntegral(realMeasurableSpace, realVolume, realFourierInvIntegrand(f, W))) |
    W ∈ ℝ }

-- The coordinate of a vector of ℝ¹.
def vectorToReal : Set := { (x, x(∅)) | x ∈ functionSpace(1, ℝ) }

-- An integrable map on ℝⁿ (against Lebesgue measure).
predicate EuclideanIntegrable (n : Nat, f : Set) :=
  ComplexIntegrable(euclideanMeasurableSpace(n), euclideanVolume(n), f)
def euclideanL1Norm (n : Nat, f : Set) : Set :=
  realMeasureIntegral(euclideanMeasurableSpace(n), euclideanVolume(n),
    complexAbsOn(f, functionSpace(n, ℝ)))

-- Translation x ↦ f(x + c), modulation x ↦ e(⟨c, x⟩) f(x), dilation
-- x ↦ f(a x), reflection x ↦ f(−x), pointwise sum and scalar multiple.
def translateFunction (n : Nat, f c : Set) : Set :=
  { (x, f(vectorAdd(n, x, c))) | x ∈ functionSpace(n, ℝ) }
def modulateFunction (n : Nat, f c : Set) : Set :=
  { (x, ℂ[expTwoPiI(realInner(n, c, x)) * f(x)]) | x ∈ functionSpace(n, ℝ) }
def dilateFunction (n : Nat, f a : Set) : Set :=
  { (x, f(vectorScale(n, a, x))) | x ∈ functionSpace(n, ℝ) }
def reflectFunction (n : Nat, f : Set) : Set :=
  { (x, f(vectorScale(n, R[-1], x))) | x ∈ functionSpace(n, ℝ) }

-- The Gaussian x ↦ e^(−π b ‖x‖²) on ℝⁿ for complex b.
def piGaussian (n : Nat, b : Set) : Set :=
  { (x, complexExp(ℂ[-(complexOfReal(realPi) * b * complexOfReal(euclideanSquareNorm(n, x)))])) |
    x ∈ functionSpace(n, ℝ) }

-- Section: Partial derivatives and Schwartz functions
-- The i-th standard basis vector of ℝⁿ, and x + t eᵢ.
def basisVector (n : Nat, i : Set) : Set := standardBasisVector(realRing, n, i)
def shiftAlong (n : Nat, x i t : Set) : Set := vectorAdd(n, x, vectorScale(n, t, basisVector(n, i)))

-- D is the partial derivative ∂ᵢf(x) of a complex map on ℝⁿ.
predicate HasPartialDerivative (n : Nat, f i x D : Set) :=
  D ∈ complexCarrier ∧
  (∀ e ∈ ℝ, realZero < e → ∃ d ∈ ℝ, realZero < d ∧
    (∀ t ∈ ℝ, t ≠ realZero → abs(t) < d →
      complexAbs(ℂ[(f(shiftAlong(n, x, i, t)) - f(x)) * complexOfReal(realInvValue(t)) - D]) < e))

-- The graph of ∂ᵢf, at the points where it exists, and the iterated
-- partial derivative ∂_{d(m−1)} ⋯ ∂_{d(0)} f along a list d of
-- coordinates.
def partialDerivative (n : Nat, f i : Set) : Set :=
  { p ∈ functionSpace(n, ℝ) × complexCarrier | HasPartialDerivative(n, f, i, fst(p), snd(p)) }
def iteratedPartial (n : Nat, f d : Set, m : Nat) → Set
  | n, f, d, zero => f
  | n, f, d, succ(k) => partialDerivative(n, iteratedPartial(n, f, d, k), d(k))

-- f is smooth: every iterated partial derivative exists at every point.
-- A Schwartz function: smooth, and (1 + ‖x‖)^k |∂^d f(x)| is bounded for
-- every k and every list of derivatives d (Mathlib's SchwartzMap, with
-- the iterated Fréchet derivative read through its partial derivatives).
predicate SmoothFunction (n : Nat, f : Set) :=
  FunctionBetween(f, functionSpace(n, ℝ), complexCarrier) ∧
  (∀ m ∈ ℕ, ∀ d ∈ functionSpace(m, n),
    FunctionBetween(iteratedPartial(n, f, d, m), functionSpace(n, ℝ), complexCarrier))
predicate DecayBound (n : Nat, g : Set, k : Nat) :=
  ∃ C ∈ ℝ, ∀ x ∈ functionSpace(n, ℝ),
    R[(1 + euclideanNormMap(n)(x)) ^ k * complexAbs(g(x))] ≤ C
predicate SchwartzFunction (n : Nat, f : Set) :=
  SmoothFunction(n, f) ∧
  (∀ m ∈ ℕ, ∀ d ∈ functionSpace(m, n), ∀ k ∈ ℕ, DecayBound(n, iteratedPartial(n, f, d, m), k))

-- Smooth with compact support: smooth and vanishing outside a box.
predicate SmoothCompactSupport (n : Nat, f : Set) :=
  SmoothFunction(n, f) ∧ ∃ a ∈ functionSpace(n, ℝ), ∃ b ∈ functionSpace(n, ℝ),
    ∀ x ∈ functionSpace(n, ℝ), x ∉ boxSet(n, a, b) → f(x) = complexZero

-- x ↦ −2πi xᵢ f(x), and w ↦ 2πi wᵢ g(w).
def coordinateMultiple (n : Nat, f i : Set) : Set :=
  { (x, ℂ[-(complexOfReal(R[2 * realPi]) * complexImaginaryUnit * complexOfReal(x(i))) * f(x)]) |
    x ∈ functionSpace(n, ℝ) }
def frequencyMultiple (n : Nat, g i : Set) : Set :=
  { (w, ℂ[complexOfReal(R[2 * realPi]) * complexImaginaryUnit * complexOfReal(w(i)) * g(w)]) |
    w ∈ functionSpace(n, ℝ) }

-- Section: Periodization
-- The integrals ∫_0^1 f(x + k), k ∈ ℤ.
def unitIntervalTranslates (f : Set) : Set :=
  { (k, complexSetIntegral(realMeasurableSpace, realVolume,
      realShiftSubstitution(f, realInt(k)), realIoc(realZero, realOne))) | k ∈ ℤ }

-- Section: Basic laws
-- On ℝ¹ the transform is the transform on ℝ (Mathlib's Real.fourier_eq
-- and fourierIntegral_eq').
theorem realFourierTransform.eq_euclidean (f W : Set)
  requires member : W ∈ ℝ
  shows realFourierTransform(f)(W) =
    fourierTransform(1, composeOn(f, vectorToReal, functionSpace(1, ℝ)))(realToVector(W))
proof
  sorry

theorem fourierTransform.add (n : Nat, f g : Set)
  requires first : EuclideanIntegrable(n, f)
  requires second : EuclideanIntegrable(n, g)
  shows fourierTransform(n, complexAddOn(f, g, functionSpace(n, ℝ))) =
    complexAddOn(fourierTransform(n, f), fourierTransform(n, g), functionSpace(n, ℝ))
proof
  sorry

theorem fourierTransform.const_mul (n : Nat, c f : Set)
  requires member : c ∈ complexCarrier
  requires values : ∀ x ∈ functionSpace(n, ℝ), f(x) ∈ complexCarrier
  shows fourierTransform(n, complexConstMulOn(c, f, functionSpace(n, ℝ))) =
    complexConstMulOn(c, fourierTransform(n, f), functionSpace(n, ℝ))
proof
  sorry

-- |𝓕f(w)| ≤ ‖f‖₁ (Mathlib's VectorFourier.norm_fourierIntegral_le_integral_norm).
theorem fourierTransform.abs_le (n : Nat, f w : Set)
  requires integrable : EuclideanIntegrable(n, f)
  requires member : w ∈ functionSpace(n, ℝ)
  shows complexAbs(fourierTransform(n, f)(w)) ≤ euclideanL1Norm(n, f)
proof
  sorry

-- The transform of an integrable map is continuous (Mathlib's
-- VectorFourier.fourierIntegral_continuous).
theorem fourierTransform.continuous (n : Nat, f : Set)
  requires integrable : EuclideanIntegrable(n, f)
  shows fourierTransform(n, f) : euclideanTopology(n) ⇒ complexSpace
proof
  sorry

-- The Riemann–Lebesgue lemma (Mathlib's
-- tendsto_integral_exp_inner_smul_cocompact): 𝓕f(w) → 0 as ‖w‖ → ∞.
theorem fourierTransform.riemann_lebesgue (n : Nat, f : Set)
  requires integrable : EuclideanIntegrable(n, f)
  shows ∀ e ∈ ℝ, realZero < e → ∃ M ∈ ℝ, ∀ w ∈ functionSpace(n, ℝ),
    M ≤ euclideanNormMap(n)(w) → complexAbs(fourierTransform(n, f)(w)) < e
proof
  sorry

-- 𝓕⁻f(w) = 𝓕f(−w) (Mathlib's fourierInv_eq').
theorem fourierInverse.eq_reflect (n : Nat, f w : Set)
  requires member : w ∈ functionSpace(n, ℝ)
  shows fourierInverse(n, f)(w) = fourierTransform(n, f)(vectorScale(n, R[-1], w))
proof
  sorry

-- Translation and modulation (Mathlib's fourierIntegral_comp_add_right
-- and the modulation rule).
theorem fourierTransform.translate (n : Nat, f c w : Set)
  requires vector : c ∈ functionSpace(n, ℝ)
  requires member : w ∈ functionSpace(n, ℝ)
  requires values : ∀ x ∈ functionSpace(n, ℝ), f(x) ∈ complexCarrier
  shows fourierTransform(n, translateFunction(n, f, c))(w) =
    ℂ[expTwoPiI(realInner(n, c, w)) * fourierTransform(n, f)(w)]
proof
  sorry

theorem fourierTransform.modulate (n : Nat, f c w : Set)
  requires vector : c ∈ functionSpace(n, ℝ)
  requires member : w ∈ functionSpace(n, ℝ)
  shows fourierTransform(n, modulateFunction(n, f, c))(w) =
    fourierTransform(n, f)(vectorAdd(n, w, vectorScale(n, R[-1], c)))
proof
  sorry

-- Dilation: 𝓕(f(a ·))(w) = |a|⁻ⁿ 𝓕f(w / a).
theorem fourierTransform.dilate (n : Nat, f w : Set, a : Real)
  requires nonzero : a ≠ realZero
  requires member : w ∈ functionSpace(n, ℝ)
  shows fourierTransform(n, dilateFunction(n, f, a))(w) =
    ℂ[complexOfReal(realInvValue(abs(a) ^ n)) *
      fourierTransform(n, f)(vectorScale(n, realInvValue(a), w))]
proof
  sorry

-- The Gaussian (Mathlib's fourierIntegral_gaussian_innerProductSpace'):
-- 𝓕(e^(−π b ‖x‖²))(w) = b^(−n/2) e^(−π ‖w‖² / b) for re b > 0.
theorem fourierTransform.gaussian (n : Nat, b w : Set)
  requires memberB : b ∈ complexCarrier
  requires positive : realZero < complexRe(b)
  requires member : w ∈ functionSpace(n, ℝ)
  shows fourierTransform(n, piGaussian(n, b))(w) =
    ℂ[complexPrincipalPow(complexInv(b), complexOfReal(R[realNat(n) / 2])) *
      complexExp(ℂ[-(complexOfReal(realPi) * complexOfReal(euclideanSquareNorm(n, w)) /
        b)])]
proof
  sorry

-- The standard Gaussian e^(−π‖x‖²) is its own transform.
theorem fourierTransform.standard_gaussian (n : Nat)
  shows fourierTransform(n, piGaussian(n, complexOne)) = piGaussian(n, complexOne)
proof
  sorry

-- Section: Fourier inversion
-- Mathlib's Continuous.fourierInv_fourier_eq: for continuous integrable f
-- with integrable transform, 𝓕⁻𝓕f = f.
theorem fourierInverse.of_continuous (n : Nat, f : Set)
  requires continuous : f : euclideanTopology(n) ⇒ complexSpace
  requires integrable : EuclideanIntegrable(n, f)
  requires transform : EuclideanIntegrable(n, fourierTransform(n, f))
  shows fourierInverse(n, fourierTransform(n, f)) = f ∩ (functionSpace(n, ℝ) × complexCarrier)
proof
  sorry

-- Mathlib's Integrable.fourierInv_fourier_eq: without continuity, at every
-- point of continuity, and almost everywhere.
theorem fourierInverse.at_continuity_point (n : Nat, f x : Set)
  requires integrable : EuclideanIntegrable(n, f)
  requires transform : EuclideanIntegrable(n, fourierTransform(n, f))
  requires member : x ∈ functionSpace(n, ℝ)
  requires continuous : ContinuousAtPoint(f, euclideanTopology(n), complexSpace, x)
  shows fourierInverse(n, fourierTransform(n, f))(x) = f(x)
proof
  sorry

theorem fourierInverse.ae (n : Nat, f : Set)
  requires integrable : EuclideanIntegrable(n, f)
  requires transform : EuclideanIntegrable(n, fourierTransform(n, f))
  shows AEEqual(euclideanMeasurableSpace(n), euclideanVolume(n),
    fourierInverse(n, fourierTransform(n, f)), f)
proof
  sorry

-- The transform is injective on integrable maps: a transform vanishing
-- identically comes from a map vanishing almost everywhere.
theorem fourierTransform.injective (n : Nat, f : Set)
  requires integrable : EuclideanIntegrable(n, f)
  requires vanishes : ∀ w ∈ functionSpace(n, ℝ), fourierTransform(n, f)(w) = complexZero
  shows AEEqual(euclideanMeasurableSpace(n), euclideanVolume(n), f,
    constantOn(functionSpace(n, ℝ), complexZero))
proof
  sorry

-- Section: Schwartz functions
theorem SchwartzFunction.integrable (n : Nat, f : Set)
  requires schwartz : SchwartzFunction(n, f)
  shows EuclideanIntegrable(n, f) ∧ f : euclideanTopology(n) ⇒ complexSpace
proof
  sorry

-- Mathlib's SchwartzMap.fourier_coe: the transform of a Schwartz function
-- is a Schwartz function, and inversion holds on them.
theorem SchwartzFunction.fourier (n : Nat, f : Set)
  requires schwartz : SchwartzFunction(n, f)
  shows SchwartzFunction(n, fourierTransform(n, f)) ∧
    SchwartzFunction(n, fourierInverse(n, f))
proof
  sorry

theorem SchwartzFunction.inversion (n : Nat, f : Set)
  requires schwartz : SchwartzFunction(n, f)
  shows fourierInverse(n, fourierTransform(n, f)) = f ∩ (functionSpace(n, ℝ) × complexCarrier) ∧
    fourierTransform(n, fourierInverse(n, f)) = f ∩ (functionSpace(n, ℝ) × complexCarrier)
proof
  sorry

-- Mathlib's HasCompactSupport.toSchwartzMap, and Gaussians.
theorem SchwartzFunction.of_compact_support (n : Nat, f : Set)
  requires smooth : SmoothCompactSupport(n, f)
  shows SchwartzFunction(n, f)
proof
  sorry

theorem SchwartzFunction.gaussian (n : Nat, b : Set)
  requires member : b ∈ complexCarrier
  requires positive : realZero < complexRe(b)
  shows SchwartzFunction(n, piGaussian(n, b))
proof
  sorry

theorem SchwartzFunction.partial (n : Nat, f i : Set)
  requires schwartz : SchwartzFunction(n, f)
  requires member : i ∈ n
  shows SchwartzFunction(n, partialDerivative(n, f, i)) ∧
    SchwartzFunction(n, coordinateMultiple(n, f, i))
proof
  sorry

theorem SchwartzFunction.mul (n : Nat, f g : Set)
  requires first : SchwartzFunction(n, f)
  requires second : SchwartzFunction(n, g)
  shows SchwartzFunction(n, complexMulOn(f, g, functionSpace(n, ℝ))) ∧
    SchwartzFunction(n, complexAddOn(f, g, functionSpace(n, ℝ)))
proof
  sorry

-- Mathlib's SchwartzMap.fourier_lineDerivOp_eq: the transform of ∂ᵢf is
-- 2πi wᵢ 𝓕f(w).
theorem fourierTransform.partial (n : Nat, f i : Set)
  requires schwartz : SchwartzFunction(n, f)
  requires member : i ∈ n
  shows fourierTransform(n, partialDerivative(n, f, i)) =
    frequencyMultiple(n, fourierTransform(n, f), i)
proof
  sorry

-- Mathlib's hasDerivAt_fourier / VectorFourier.hasFDerivAt_fourierIntegral:
-- if f and xᵢ f are integrable, ∂ᵢ𝓕f = 𝓕(−2πi xᵢ f).
theorem fourierTransform.has_partial (n : Nat, f i w : Set)
  requires integrable : EuclideanIntegrable(n, f)
  requires moment : EuclideanIntegrable(n, coordinateMultiple(n, f, i))
  requires memberI : i ∈ n
  requires member : w ∈ functionSpace(n, ℝ)
  shows HasPartialDerivative(n, fourierTransform(n, f), i, w,
    fourierTransform(n, coordinateMultiple(n, f, i))(w))
proof
  sorry

-- Section: Periodization
-- Mathlib's Integrable.hasSum_intervalIntegral_comp_add_int: for f
-- integrable on ℝ, Σ_{k ∈ ℤ} ∫_0^1 f(x + k) dx = ∫ f.
theorem complexMeasureIntegral.periodize (f : Set)
  requires integrable : ComplexIntegrable(realMeasurableSpace, realVolume, f)
  shows ComplexHasSum(unitIntervalTranslates(f), ℤ,
    complexMeasureIntegral(realMeasurableSpace, realVolume, f))
proof
  sorry

end EuclideanFourier
