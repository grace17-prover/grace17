-- Fourier analysis on finite abelian groups: additive characters of an
-- abelian group (written in its mul slot) with values in ℂ, their values
-- on the unit circle, negatives and multiples; the dual group; the
-- orthogonality relations, Σₐ ψ(a) = |G| or 0, and the dual
-- orthogonality Σ_ψ ψ(a) = |G| or 0; the characters as a basis, the
-- Fourier transform, inversion and Plancherel; and the discrete Fourier
-- transform on ℤ/Nℤ, for N-periodic functions on ℤ, with its inverse,
-- 𝓕𝓕Φ(k) = N Φ(−k), and the transform of a primitive Dirichlet character
-- as a Gauss sum.
-- Part of the GRH blueprint.
-- Planned home: Analysis/Fourier/FiniteAbelian and Analysis/Fourier/ZMod.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Fourier.FiniteAbelian
import GRH.FunctionalEquation
import GRH.Normed.Groups

section FiniteAbelian
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Section: Additive characters
-- An additive character of the abelian group G with values in ℂ
-- (Mathlib's AddChar G ℂ): 0 ↦ 1 and a + b ↦ ψ(a) ψ(b).
predicate AddCharacter (G ψ : Set) :=
  FunctionBetween(ψ, Group.carrier(G), complexCarrier) ∧
  ψ(Group.one(G)) = complexOne ∧
  (∀ a ∈ Group.carrier(G), ∀ b ∈ Group.carrier(G),
    ψ(Group.mul(G)(a, b)) = ℂ[ψ(a) * ψ(b)])

-- The characters, the trivial character, the product and the conjugate.
def addCharacters (G : Set) : Set :=
  { ψ ∈ functionSpace(Group.carrier(G), complexCarrier) | AddCharacter(G, ψ) }
def trivialCharacter (G : Set) : Set := Group.carrier(G) × {complexOne}
def characterProductOf (G ψ φ : Set) : Set :=
  { (a, ℂ[ψ(a) * φ(a)]) | a ∈ Group.carrier(G) }
def characterConjugate (G ψ : Set) : Set :=
  { (a, complexConj(ψ(a))) | a ∈ Group.carrier(G) }

-- The dual group Ĝ under pointwise multiplication (Mathlib's AddChar G ℂ
-- as a group).
def dualMultiplication (G : Set) : Set :=
  { p ∈ (addCharacters(G) × addCharacters(G)) × addCharacters(G) |
    snd(p) = characterProductOf(G, fst(fst(p)), snd(fst(p))) }
def dualInverse (G : Set) : Set :=
  { p ∈ addCharacters(G) × addCharacters(G) | snd(p) = characterConjugate(G, fst(p)) }
def dualGroup (G : Set) : Set :=
  Group.mk(addCharacters(G), dualMultiplication(G), trivialCharacter(G), dualInverse(G))

-- n · a in an additive group, by recursion on n.
def groupMultiple (G a : Set, n : Nat) → Set
  | G, a, zero => Group.one(G)
  | G, a, succ(k) => Group.mul(G)(groupMultiple(G, a, k), a)

-- Sums over a finite set in ℂ.
def complexSetSum (F w : Set) : Set := groupFiniteSum(complexAdditiveGroup, F, w)

-- The family a ↦ ψ(a) conj(φ(a)) and ψ ↦ ψ(a).
def characterPairing (G ψ φ : Set) : Set :=
  { (a, ℂ[ψ(a) * complexConj(φ(a))]) | a ∈ Group.carrier(G) }
def characterEvaluations (G a : Set) : Set := { (ψ, ψ(a)) | ψ ∈ addCharacters(G) }

-- The Fourier transform on G: f̂(ψ) = Σₐ f(a) conj(ψ(a)), and the
-- inverse sum Σ_ψ f̂(ψ) ψ(a).
def fourierTerms (G f ψ : Set) : Set :=
  { (a, ℂ[f(a) * complexConj(ψ(a))]) | a ∈ Group.carrier(G) }
def finiteFourier (G f : Set) : Set :=
  { (ψ, complexSetSum(Group.carrier(G), fourierTerms(G, f, ψ))) | ψ ∈ addCharacters(G) }
def inversionTerms (G g a : Set) : Set := { (ψ, ℂ[g(ψ) * ψ(a)]) | ψ ∈ addCharacters(G) }
def squareTerms (f A : Set) : Set := { (a, R[complexAbs(f(a)) * complexAbs(f(a))]) | a ∈ A }

-- Section: The discrete Fourier transform on ℤ/Nℤ
-- e(x) = e^(2πix) is layer 1's expTwoPiI (Mathlib's Real.fourierChar 𝐞).
-- The standard character j ↦ e(j/N) of ℤ/Nℤ (Mathlib's
-- ZMod.stdAddChar), read on ℤ; the DFT of an N-periodic Φ : ℤ → ℂ,
-- 𝓕Φ(k) = Σ_{j<N} e(−jk/N) Φ(j), and its inverse
-- 𝓕⁻Ψ(k) = N⁻¹ Σ_{j<N} e(jk/N) Ψ(j) (Mathlib's ZMod.dft and invDFT).
predicate PeriodicMod (N : Nat, Φ : Set) :=
  FunctionBetween(Φ, ℤ, complexCarrier) ∧
  (∀ a ∈ ℤ, Φ(integerAddValue(a, integerOfNat(N))) = Φ(a))
def stdAddChar (N : Nat) : Set :=
  { (a, expTwoPiI(R[realInt(a) / realNat(N)])) | a ∈ ℤ }
def dftTerms (N : Nat, Φ k : Set) : Set :=
  { p ∈ ℕ × complexCarrier | ∃ j ∈ ℕ, fst(p) = j ∧
    snd(p) = ℂ[expTwoPiI(R[-(realNat(j) * realInt(k)) / realNat(N)]) * Φ(integerOfNat(j))] }
def zmodDFT (N : Nat, Φ : Set) : Set :=
  { (k, complexPartialSum(dftTerms(N, Φ, k), N)) | k ∈ ℤ }
def invDFTTerms (N : Nat, Ψ k : Set) : Set :=
  { p ∈ ℕ × complexCarrier | ∃ j ∈ ℕ, fst(p) = j ∧
    snd(p) = ℂ[expTwoPiI(R[(realNat(j) * realInt(k)) / realNat(N)]) * Ψ(integerOfNat(j))] }
def zmodInvDFT (N : Nat, Ψ : Set) : Set :=
  { (k, ℂ[complexOfReal(R[1 / realNat(N)]) * complexPartialSum(invDFTTerms(N, Ψ, k), N)]) |
    k ∈ ℤ }

-- Pointwise operations on functions on ℤ.
def integerFunctionNeg (Φ : Set) : Set := { (a, Φ(integerNegValue(a))) | a ∈ ℤ }
def integerFunctionScale (c Φ : Set) : Set := { (a, ℂ[c * Φ(a)]) | a ∈ ℤ }
def integerFunctionMul (Φ Ψ : Set) : Set := { (a, ℂ[Φ(a) * Ψ(a)]) | a ∈ ℤ }

-- Section: Laws of characters
theorem addCharacters.member (G ψ : Set)
  shows ψ ∈ addCharacters(G) ↔ AddCharacter(G, ψ)
proof
  sorry

theorem AddCharacter.trivial (G : Set)
  requires abelian : AbelianGroup(G)
  shows AddCharacter(G, trivialCharacter(G))
proof
  sorry

-- Mathlib's AddChar.map_zero_eq_one and AddChar.map_add_eq_mul are the
-- defining laws; the values on a finite group are units of modulus 1
-- (AddChar.val_isUnit, and norm_apply for finite groups).
theorem AddCharacter.abs_one (G ψ a : Set)
  requires abelian : AbelianGroup(G)
  requires finite : Finite(Group.carrier(G))
  requires character : AddCharacter(G, ψ)
  requires member : a ∈ Group.carrier(G)
  shows complexAbs(ψ(a)) = realOne ∧ ψ(a) ≠ complexZero
proof
  sorry

-- Mathlib's AddChar.map_neg_eq_inv and map_sub_eq_div, with the inverse
-- as the conjugate on a finite group.
theorem AddCharacter.neg (G ψ a : Set)
  requires abelian : AbelianGroup(G)
  requires finite : Finite(Group.carrier(G))
  requires character : AddCharacter(G, ψ)
  requires member : a ∈ Group.carrier(G)
  shows ψ(Group.inv(G)(a)) = complexConj(ψ(a)) ∧ ℂ[ψ(Group.inv(G)(a)) * ψ(a)] = complexOne
proof
  sorry

theorem AddCharacter.sub (G ψ a b : Set)
  requires abelian : AbelianGroup(G)
  requires finite : Finite(Group.carrier(G))
  requires character : AddCharacter(G, ψ)
  requires memberA : a ∈ Group.carrier(G)
  requires memberB : b ∈ Group.carrier(G)
  shows ψ(Group.mul(G)(a, Group.inv(G)(b))) = ℂ[ψ(a) * complexConj(ψ(b))]
proof
  sorry

-- Mathlib's AddChar.map_nsmul_eq_pow.
theorem AddCharacter.multiple (G ψ a : Set, n : Nat)
  requires abelian : AbelianGroup(G)
  requires character : AddCharacter(G, ψ)
  requires member : a ∈ Group.carrier(G)
  shows ψ(groupMultiple(G, a, n)) = ℂ[ψ(a) ^ n]
proof
  sorry

-- Mathlib's AddChar.eq_one_iff.
theorem AddCharacter.eq_trivial_iff (G ψ : Set)
  requires abelian : AbelianGroup(G)
  requires character : AddCharacter(G, ψ)
  shows ψ = trivialCharacter(G) ↔ (∀ a ∈ Group.carrier(G), ψ(a) = complexOne)
proof
  sorry

-- Mathlib's MonoidHom.compAddChar: a character after a homomorphism.
theorem AddCharacter.comp_hom (G H f ψ χ : Set)
  requires abelianG : AbelianGroup(G)
  requires abelianH : AbelianGroup(H)
  requires hom : f : G →* H
  requires character : AddCharacter(H, ψ)
  requires composite : FunctionBetween(χ, Group.carrier(G), complexCarrier) ∧
    (∀ a ∈ Group.carrier(G), χ(a) = ψ(f(a)))
  shows AddCharacter(G, χ)
proof
  sorry

theorem dualGroup.abelian (G : Set)
  requires abelian : AbelianGroup(G)
  requires finite : Finite(Group.carrier(G))
  shows AbelianGroup(dualGroup(G))
proof
  sorry

-- |Ĝ| = |G| for a finite abelian group.
theorem dualGroup.card (G : Set, m : Nat)
  requires abelian : AbelianGroup(G)
  requires card : HasCardinality(Group.carrier(G), m)
  shows HasCardinality(addCharacters(G), m)
proof
  sorry

-- Characters separate points: for a ≠ 0 some ψ has ψ(a) ≠ 1.
theorem AddCharacter.separates (G a : Set)
  requires abelian : AbelianGroup(G)
  requires finite : Finite(Group.carrier(G))
  requires member : a ∈ Group.carrier(G)
  requires nonzero : a ≠ Group.one(G)
  shows ∃ ψ ∈ addCharacters(G), ψ(a) ≠ complexOne
proof
  sorry

-- Section: Orthogonality
-- Mathlib's AddChar.sum_apply_eq_ite and sum_eq_zero_iff_ne_zero.
theorem AddCharacter.sum_trivial (G : Set, m : Nat)
  requires abelian : AbelianGroup(G)
  requires card : HasCardinality(Group.carrier(G), m)
  shows complexSetSum(Group.carrier(G), trivialCharacter(G)) = complexOfReal(realNat(m))
proof
  sorry

theorem AddCharacter.sum_nontrivial (G ψ : Set)
  requires abelian : AbelianGroup(G)
  requires finite : Finite(Group.carrier(G))
  requires character : AddCharacter(G, ψ)
  requires nontrivial : ψ ≠ trivialCharacter(G)
  shows complexSetSum(Group.carrier(G), ψ) = complexZero
proof
  sorry

-- The orthogonality relations Σₐ ψ(a) conj(φ(a)) = |G| [ψ = φ].
theorem AddCharacter.orthogonal (G ψ φ : Set, m : Nat)
  requires abelian : AbelianGroup(G)
  requires card : HasCardinality(Group.carrier(G), m)
  requires first : AddCharacter(G, ψ)
  requires second : AddCharacter(G, φ)
  shows (ψ = φ → complexSetSum(Group.carrier(G), characterPairing(G, ψ, φ)) =
      complexOfReal(realNat(m))) ∧
    (ψ ≠ φ → complexSetSum(Group.carrier(G), characterPairing(G, ψ, φ)) = complexZero)
proof
  sorry

-- The dual relations Σ_ψ ψ(a) = |G| [a = 0].
theorem AddCharacter.sum_over_characters (G a : Set, m : Nat)
  requires abelian : AbelianGroup(G)
  requires card : HasCardinality(Group.carrier(G), m)
  requires member : a ∈ Group.carrier(G)
  shows (a = Group.one(G) →
      complexSetSum(addCharacters(G), characterEvaluations(G, a)) = complexOfReal(realNat(m))) ∧
    (a ≠ Group.one(G) →
      complexSetSum(addCharacters(G), characterEvaluations(G, a)) = complexZero)
proof
  sorry

-- Section: Fourier inversion on a finite abelian group
-- f(a) = |G|⁻¹ Σ_ψ f̂(ψ) ψ(a) (with Mathlib's AddChar.complexBasis: the
-- characters form a basis of the functions G → ℂ).
theorem finiteFourier.inversion (G f a : Set, m : Nat)
  requires abelian : AbelianGroup(G)
  requires card : HasCardinality(Group.carrier(G), m)
  requires values : ∀ b ∈ Group.carrier(G), f(b) ∈ complexCarrier
  requires member : a ∈ Group.carrier(G)
  shows f(a) = ℂ[complexOfReal(R[1 / realNat(m)]) *
    complexSetSum(addCharacters(G), inversionTerms(G, finiteFourier(G, f), a))]
proof
  sorry

-- A function with vanishing Fourier transform vanishes (the characters are
-- linearly independent and span).
theorem finiteFourier.injective (G f : Set)
  requires abelian : AbelianGroup(G)
  requires finite : Finite(Group.carrier(G))
  requires values : ∀ b ∈ Group.carrier(G), f(b) ∈ complexCarrier
  requires vanishes : ∀ ψ ∈ addCharacters(G), finiteFourier(G, f)(ψ) = complexZero
  shows ∀ a ∈ Group.carrier(G), f(a) = complexZero
proof
  sorry

-- Plancherel: Σₐ |f(a)|² = |G|⁻¹ Σ_ψ |f̂(ψ)|².
theorem finiteFourier.plancherel (G f : Set, m : Nat)
  requires abelian : AbelianGroup(G)
  requires card : HasCardinality(Group.carrier(G), m)
  requires values : ∀ b ∈ Group.carrier(G), f(b) ∈ complexCarrier
  shows realFiniteSum(squareTerms(f, Group.carrier(G)), Group.carrier(G)) =
    R[(1 / realNat(m)) *
      realFiniteSum(squareTerms(finiteFourier(G, f), addCharacters(G)), addCharacters(G))]
proof
  sorry

-- Section: The discrete Fourier transform on ℤ/Nℤ
theorem stdAddChar.periodic (N : Nat, a : Set)
  requires positive : 0 < N
  requires member : a ∈ ℤ
  shows stdAddChar(N)(integerAddValue(a, integerOfNat(N))) = stdAddChar(N)(a) ∧
    complexAbs(stdAddChar(N)(a)) = realOne
proof
  sorry

theorem stdAddChar.add (N : Nat, a b : Set)
  requires positive : 0 < N
  requires memberA : a ∈ ℤ
  requires memberB : b ∈ ℤ
  shows stdAddChar(N)(integerAddValue(a, b)) = ℂ[stdAddChar(N)(a) * stdAddChar(N)(b)]
proof
  sorry

-- The DFT of an N-periodic function is N-periodic, and the sum over any
-- N consecutive residues may be used.
theorem zmodDFT.periodic (N : Nat, Φ : Set)
  requires positive : 0 < N
  requires periodic : PeriodicMod(N, Φ)
  shows PeriodicMod(N, zmodDFT(N, Φ)) ∧ PeriodicMod(N, zmodInvDFT(N, Φ))
proof
  sorry

-- Mathlib's ZMod.dft_dft: 𝓕(𝓕Φ)(k) = N Φ(−k).
theorem zmodDFT.dft_dft (N : Nat, Φ k : Set)
  requires positive : 0 < N
  requires periodic : PeriodicMod(N, Φ)
  requires member : k ∈ ℤ
  shows zmodDFT(N, zmodDFT(N, Φ))(k) = ℂ[complexOfReal(realNat(N)) * Φ(integerNegValue(k))]
proof
  sorry

-- Mathlib's ZMod.invDFT_dft and dft_invDFT: inversion.
theorem zmodDFT.inversion (N : Nat, Φ k : Set)
  requires positive : 0 < N
  requires periodic : PeriodicMod(N, Φ)
  requires member : k ∈ ℤ
  shows zmodInvDFT(N, zmodDFT(N, Φ))(k) = Φ(k) ∧ zmodDFT(N, zmodInvDFT(N, Φ))(k) = Φ(k)
proof
  sorry

-- Mathlib's ZMod.invDFT_apply': 𝓕⁻Ψ(k) = N⁻¹ 𝓕Ψ(−k).
theorem zmodInvDFT.eq_dft_neg (N : Nat, Ψ k : Set)
  requires positive : 0 < N
  requires periodic : PeriodicMod(N, Ψ)
  requires member : k ∈ ℤ
  shows zmodInvDFT(N, Ψ)(k) =
    ℂ[complexOfReal(R[1 / realNat(N)]) * zmodDFT(N, Ψ)(integerNegValue(k))]
proof
  sorry

-- Mathlib's ZMod.dft_comp_neg, dft_const_mul, dft_mul_const.
theorem zmodDFT.comp_neg (N : Nat, Φ k : Set)
  requires positive : 0 < N
  requires periodic : PeriodicMod(N, Φ)
  requires member : k ∈ ℤ
  shows zmodDFT(N, integerFunctionNeg(Φ))(k) = zmodDFT(N, Φ)(integerNegValue(k))
proof
  sorry

theorem zmodDFT.const_mul (N : Nat, c Φ k : Set)
  requires positive : 0 < N
  requires periodic : PeriodicMod(N, Φ)
  requires memberC : c ∈ complexCarrier
  requires member : k ∈ ℤ
  shows zmodDFT(N, integerFunctionScale(c, Φ))(k) = ℂ[c * zmodDFT(N, Φ)(k)]
proof
  sorry

-- The transform of a primitive Dirichlet character modulo N is a Gauss
-- sum times the conjugate character at −k (Mathlib's
-- DirichletCharacter.IsPrimitive.fourierTransform_eq_inv_mul_gaussSum;
-- χ⁻¹ is the conjugate character).
theorem zmodDFT.primitive_character (N : Nat, χ k : Set)
  requires positive : 0 < N
  requires character : DirichletCharacter(N, χ)
  requires primitive : PrimitiveCharacter(N, χ)
  requires member : k ∈ ℤ
  shows zmodDFT(N, χ)(k) = ℂ[complexConj(χ(integerNegValue(k))) * gaussSum(N, χ)]
proof
  sorry

-- Mathlib's DirichletCharacter.fourierTransform_eq_gaussSum_mulShift in
-- the form used: 𝓕χ(k) = Σ_{j<N} χ(j) e(−jk/N) for any character.
theorem zmodDFT.character_apply (N : Nat, χ k : Set)
  requires positive : 0 < N
  requires character : DirichletCharacter(N, χ)
  requires member : k ∈ ℤ
  shows zmodDFT(N, χ)(k) = complexPartialSum(dftTerms(N, χ, k), N)
proof
  sorry

-- The DFT diagonalizes translation: Φ(· + t) has transform e(tk/N) 𝓕Φ.
theorem zmodDFT.translate (N : Nat, Φ Ψ t k : Set)
  requires positive : 0 < N
  requires periodic : PeriodicMod(N, Φ)
  requires memberT : t ∈ ℤ
  requires member : k ∈ ℤ
  requires shifted : ∀ a ∈ ℤ, Ψ(a) = Φ(integerAddValue(a, t))
  shows zmodDFT(N, Ψ)(k) = ℂ[stdAddChar(N)(integerMulValue(t, k)) * zmodDFT(N, Φ)(k)]
proof
  sorry

end FiniteAbelian
