-- The Hurwitz zeta function ζ(s, a), defined on all of ℂ by the
-- Euler–Maclaurin continuation of Σ_{n≥0} (n + a)^(−s). For m ≥ 1 and
-- re s > 1 − 2m, s ≠ 1, the expression of order 2m is
--   H_m(s, a) = a^(1−s)/(s − 1) + a^(−s)/2
--     + Σ_{k=1}^{m} B_{2k}/(2k)! · s(s+1)⋯(s+2k−2) · a^(−s−2k+1)
--     − s(s+1)⋯(s+2m−1)/(2m)! · ∫_0^∞ P̃_{2m}(x) (x + a)^(−s−2m) dx,
-- and ζ(s, a) is H_m(s, a) for the least such m; it does not depend on m.
-- At the pole s = 1 the value recorded is the constant term of the
-- Laurent expansion. The series for re s > 1, holomorphy on ℂ ∖ {1}, the
-- pole, the shift a ↦ a + 1, and the values at the nonpositive integers.
-- Part of the GRH blueprint.
-- Planned home: NumberTheory/Zeta/Hurwitz.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Hurwitz
import GRH.EulerMaclaurin

section Hurwitz
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Section: Definitions
-- The rising factorial s(s + 1)⋯(s + j − 1) in ℂ, 1 for j = 0.
def risingFactorial (s : Set) (j : Nat) → Set
  | s, zero => complexOne
  | s, succ(k) => complexMul(risingFactorial(s, k),
      complexAdd(s, complexOfReal(realNat(k))))

-- The rising factorials are complex (the same fact as
-- risingFactorial.member, needed before it).
theorem risingFactorial.closed (s : Set) (j : Nat)
  requires hs : s ∈ ℂ
  shows risingFactorial(s, j) ∈ ℂ
proof
  induction j
  | zero =>
    rw risingFactorial
    exact complexOne.member
  | succ(k) using ih =>
    have shift := complexOfReal.closed at realNat(k)
    rw risingFactorial
    typecheck

-- The integrand P̃ₙ(x) (x + a)^(−s−n) of the remainder, as a complex
-- function of the real variable x. Only x ≥ 0 matters, where x + a > 0
-- for a > 0; the power is realCpow, x^s = exp(s log x).
defgraph hurwitzIntegrand (n : Nat, a : Real, s : Set) (X ∈ ℝ) :
    complexCarrier :=
  ℂ[complexOfReal(periodicBernoulli(n)(X)) *
    realCpow(R[X + a], ℂ[-s - complexOfReal(realNat(n))])]
requires hs : s ∈ complexCarrier
proof
  have function := periodicBernoulli.function at n
  have value := FunctionBetween.apply_closed with function, member
  have valueReal : Real(periodicBernoulli(n)(X)) by exact value
  have exponent : ℂ[-s - complexOfReal(realNat(n))] ∈ ℂ by typecheck
  have power := realCpow.member at R[X + a], ℂ[-s - complexOfReal(realNat(n))]
    with exponent
  typecheck

-- The same integrands as a family indexed by s, for holomorphy in s.
defgraph hurwitzKernel (n : Nat, a : Real) (s ∈ complexCarrier) :
    functionSpace(ℝ, complexCarrier) := hurwitzIntegrand(n, a, s)
proof
  have function := hurwitzIntegrand.function at n, a, s with member
  exact functionSpace.mem_iff.backward with function

-- The terms of the boundary sum, k = 0, 1, …, standing for k + 1 in the
-- displayed formula: B_{2k+2}/(2k+2)! · s(s+1)⋯(s+2k) · a^(−s−2k−1).
defgraph hurwitzCorrectionTerms (s : Set, a : Real) (k ∈ ℕ) :
    complexCarrier :=
  ℂ[complexOfReal(R[bernoulli(2 * k + 2) / realNat((2 * k + 2)!)]) *
    risingFactorial(s, 2 * k + 1) *
    realCpow(a, ℂ[-s - complexOfReal(realNat(2 * k + 1))])]
requires hs : s ∈ complexCarrier
proof
  have typedK := nat.omega.backward with member
  have number := bernoulli.real at 2 * k + 2
  have factorialReal := realNat.real at (2 * k + 2)!
  have rising := risingFactorial.closed at s, 2 * k + 1 with hs
  have exponent : ℂ[-s - complexOfReal(realNat(2 * k + 1))] ∈ ℂ by typecheck
  have power := realCpow.member at a,
    ℂ[-s - complexOfReal(realNat(2 * k + 1))] with exponent
  typecheck

-- The remainder s(s+1)⋯(s+2m−1)/(2m)! · ∫_0^∞ P̃_{2m}(x)(x + a)^(−s−2m) dx.
def hurwitzRemainder (m : Nat, s : Set, a : Real) : Set :=
  ℂ[complexOfReal(R[1 / realNat((2 * m)!)]) * risingFactorial(s, 2 * m) *
    complexImproperIntegral(hurwitzIntegrand(2 * m, a, s), R[0])]

-- The Euler–Maclaurin expression H_m(s, a) of order 2m, for s ≠ 1; it is
-- ζ(s, a) when re s > 1 − 2m and a > 0.
def hurwitzEulerMaclaurin (m : Nat, s : Set, a : Real) : Set :=
  ℂ[complexDiv(realCpow(a, ℂ[1 - s]), ℂ[s - 1]) +
    complexDiv(realCpow(a, ℂ[-s]), ℂ[2]) +
    complexPartialSum(hurwitzCorrectionTerms(s, a), m) -
    hurwitzRemainder(m, s, a)]

-- The constant term at the pole s = 1: the same expression with
-- a^(1−s)/(s − 1) = 1/(s − 1) − log a + O(s − 1) replaced by −log a, and
-- s = 1 elsewhere (the rising factorials become (2k − 1)! and (2m)!).
-- It is −ψ(a), and Euler's constant γ at a = 1.
def hurwitzRegularEulerMaclaurin (m : Nat, a : Real) : Set :=
  ℂ[complexOfReal(R[-realLog(a)]) + complexDiv(realCpow(a, ℂ[-1]), ℂ[2]) +
    complexPartialSum(hurwitzCorrectionTerms(ℂ[1], a), m) -
    hurwitzRemainder(m, ℂ[1], a)]

-- The orders m ≥ 1 with re s > 1 − 2m, for which H_m(s, a) converges, and
-- the least of them.
def hurwitzOrders (s : Set) : Set :=
  { m ∈ ℕ | 1 ≤ m ∧ R[1 - 2 * realNat(m)] < complexRe(s) }

-- The least natural of the empty set is ∅ (after
-- Grace.Cumulus.GraphTheory.TreePacking.Order, which this module does not
-- import), so leastNatural(S) is a natural for every set S of naturals.
theorem leastNatural.empty_set
  shows leastNatural(∅) = ∅
proof
  unfold leastNatural
  have none : leastNatural.candidates(∅) = ∅
    ext n
    constructor
    . intro member
      exfalso
      exact set.empty with member.right.left
    . intro member
      exfalso
      exact set.empty with member
  rw none
  exact union.empty

theorem leastNatural.natural_of_subset (S : Set)
  requires naturals : S ⊆ ℕ
  shows Nat(leastNatural(S))
proof
  by_cases empty : S = ∅
  . rw [empty, leastNatural.empty_set, ← nat.zero]
    exact Naturals.constructor.zero
  . have inhabited := Nonempty.of_ne_empty with empty
    have member := leastNatural.member with inhabited, naturals
    exact nat.omega.backward with (naturals with leastNatural(S), member)

def hurwitzOrder (s : Set) : Nat := leastNatural(hurwitzOrders(s))
proof
  have naturals : hurwitzOrders(s) ⊆ ℕ
    intros m member
    unfold hurwitzOrders at member
    exact member.left
  unfold hurwitzOrder
  exact leastNatural.natural_of_subset with naturals

-- The constant term of ζ(s, a) at s = 1, computed at order 2 (m = 1);
-- every order gives the same value (`hurwitzZeta.regular_order`).
def hurwitzZeta.regular (a : Real) : Set := hurwitzRegularEulerMaclaurin(1, a)

-- The expressions H_m(s, a) and its constant term at 1 are complex.
theorem hurwitzRemainder.closed (m : Nat, s : Set, a : Real)
  requires hs : s ∈ ℂ
  shows hurwitzRemainder(m, s, a) ∈ ℂ
proof
  have rising := risingFactorial.closed at s, 2 * m with hs
  have integral := complexImproperIntegral.member
    at hurwitzIntegrand(2 * m, a, s), R[0]
  have scale := complexOfReal.closed at R[1 / realNat((2 * m)!)]
  unfold hurwitzRemainder
  typecheck

theorem hurwitzEulerMaclaurin.closed (m : Nat, s : Set, a : Real)
  requires hs : s ∈ ℂ
  shows hurwitzEulerMaclaurin(m, s, a) ∈ ℂ
proof
  have one := complexOne.member
  have two : ℂ[2] ∈ ℂ by typecheck
  have shifted : ℂ[s - 1] ∈ ℂ by typecheck
  have first := realCpow.member at a, ℂ[1 - s] with *
  have second := realCpow.member at a, ℂ[-s] with *
  have firstInverse := complexInv.member at ℂ[s - 1] with shifted
  have secondInverse := complexInv.member at ℂ[2] with two
  have terms := hurwitzCorrectionTerms.function at s, a with hs
  have sequence : ComplexSequence(hurwitzCorrectionTerms(s, a)) by exact terms
  have sum := complexPartialSum.member at hurwitzCorrectionTerms(s, a), m
    with sequence
  have remainder := hurwitzRemainder.closed at m, s, a with hs
  unfold hurwitzEulerMaclaurin
  unfold complexDiv
  typecheck

theorem hurwitzRegularEulerMaclaurin.closed (m : Nat, a : Real)
  shows hurwitzRegularEulerMaclaurin(m, a) ∈ ℂ
proof
  have one := complexOne.member
  have two : ℂ[2] ∈ ℂ by typecheck
  have minusOne : ℂ[-1] ∈ ℂ by typecheck
  have logarithm := realLog.real at a
  have constant := complexOfReal.closed at R[-realLog(a)]
  have power := realCpow.member at a, ℂ[-1] with minusOne
  have inverse := complexInv.member at ℂ[2] with two
  have terms := hurwitzCorrectionTerms.function at ℂ[1], a with one
  have sequence : ComplexSequence(hurwitzCorrectionTerms(ℂ[1], a))
    by exact terms
  have sum := complexPartialSum.member at hurwitzCorrectionTerms(ℂ[1], a), m
    with sequence
  have remainder := hurwitzRemainder.closed at m, ℂ[1], a with one
  unfold hurwitzRegularEulerMaclaurin
  unfold complexDiv
  typecheck

-- ζ(s, a) for s ∈ ℂ and real a; the theorems take a > 0. For s ≠ 1 it is
-- H_m(s, a) at the least admissible order m. At s = 1, where ζ(s, a) has
-- a pole, the value is the constant term hurwitzZeta.regular(a); this is
-- not the value of a continuous function, and the theorems about ζ(·, a)
-- alone exclude s = 1. It is the value the L-functions need: the poles of
-- their terms cancel for a non-principal character, and their constant
-- terms then give the value of the continuous extension at 1.
defunique hurwitzZeta (s : Set, a : Real) (w ∈ complexCarrier) :=
  (s ≠ ℂ[1] → w = hurwitzEulerMaclaurin(hurwitzOrder(s), s, a)) ∧
  (s = ℂ[1] → w = hurwitzZeta.regular(a))
requires hs : s ∈ complexCarrier
proof
  by_cases one : s = ℂ[1]
  . have member := hurwitzRegularEulerMaclaurin.closed at 1, a
    witness hurwitzZeta.regular(a)
    unfold hurwitzZeta.regular
    refine ⟨member, ?_, ?_⟩
    . intro notOne
      exfalso
      exact notOne with one
    . intro same
      rfl
  . have member := hurwitzEulerMaclaurin.closed at hurwitzOrder(s), s, a
      with hs
    witness hurwitzEulerMaclaurin(hurwitzOrder(s), s, a)
    refine ⟨member, ?_, ?_⟩
    . intro notOne
      rfl
    . intro same
      exfalso
      exact one with same
uniqueness
  intros w wMember wValue v vMember vValue
  obtain ⟨wOff, wAt⟩ := wValue
  obtain ⟨vOff, vAt⟩ := vValue
  by_cases one : s = ℂ[1]
  . rw [wAt with one, vAt with one]
  . rw [wOff with one, vOff with one]

-- s ↦ ζ(s, a) as a function on ℂ.
defgraph hurwitzZetaMap (a : Real) (s ∈ complexCarrier) : complexCarrier :=
    hurwitzZeta(s, a)
proof
  have selected := hurwitzZeta.selected at s, a with member
  exact selected.left

-- s ↦ ζ(s, a) − 1/(s − 1) on ℂ. At s = 1 its value is
-- ζ(1, a) − 1/0 = hurwitzZeta.regular(a), since 0⁻¹ = 0 in complexInv;
-- `hurwitzZetaRegularMap.at_one` records this, and
-- `hurwitzZetaRegularMap.holomorphic` says the result is entire.
defgraph hurwitzZetaRegularMap (a : Real) (s ∈ complexCarrier) :
    complexCarrier := ℂ[hurwitzZeta(s, a) - complexDiv(ℂ[1], ℂ[s - 1])]
proof
  obtain ⟨value, _⟩ := hurwitzZeta.selected at s, a with member
  have shifted : ℂ[s - 1] ∈ ℂ by typecheck
  have inverse := complexInv.member at ℂ[s - 1] with shifted
  unfold complexDiv
  typecheck

-- The terms (n + a)^(−s), n = 0, 1, 2, …, of the Hurwitz series.
defgraph hurwitzSeriesTerms (s : Set, a : Real) (n ∈ ℕ) : complexCarrier :=
    realCpow(R[realNat(n) + a], ℂ[-s])
requires hs : s ∈ complexCarrier
proof
  have typedN := nat.omega.backward with member
  have exponent : ℂ[-s] ∈ ℂ by typecheck
  exact realCpow.member at R[realNat(n) + a], ℂ[-s] with exponent

-- The complex function x ↦ c (x + a)^w of a real variable.
defgraph scaledPower (c : Set, a : Real, w : Set) (X ∈ ℝ) : complexCarrier :=
    ℂ[c * realCpow(R[X + a], w)]
requires hc : c ∈ complexCarrier
requires hw : w ∈ complexCarrier
proof
  have power := realCpow.member at R[X + a], w with hw
  typecheck

-- Section: Rising factorials
theorem risingFactorial.zero (s : Set)
  shows risingFactorial(s, 0) = ℂ[1]
proof
  rw risingFactorial
  rfl

theorem risingFactorial.succ (s : Set) (j : Nat)
  shows risingFactorial(s, succ(j)) =
    ℂ[risingFactorial(s, j) * (s + complexOfReal(realNat(j)))]
proof
  rw risingFactorial
  rfl

theorem risingFactorial.member (s : Set) (j : Nat)
  requires hs : s ∈ ℂ
  shows risingFactorial(s, j) ∈ ℂ
proof
  exact risingFactorial.closed with hs

-- 1·2⋯j = j!.
theorem risingFactorial.one (j : Nat)
  shows risingFactorial(ℂ[1], j) = complexOfReal(realNat(j!))
proof
  induction j
  | zero =>
    rw [risingFactorial.zero, factorial, realNat.one, complexOfReal.one]
  | succ(k) using ih =>
    have one : k + 1 = succ(k) := add.right_one with *
    have step := realNat.factorial_succ at k
    rw one at step
    rw [risingFactorial.succ, ih, step, complexOfReal.mul, complexOfReal.add,
      complexOfReal.one]
    have kMember : complexOfReal(realNat(k)) ∈ ℂ by typecheck
    have factorialMember : complexOfReal(realNat(k!)) ∈ ℂ by typecheck
    ring

-- The rising factorial at −n vanishes from j = n + 1 on.
theorem risingFactorial.neg_nat (n j : Nat)
  requires large : n < j
  shows risingFactorial(ℂ[-complexOfReal(realNat(n))], j) = ℂ[0]
proof
  have nMember : complexOfReal(realNat(n)) ∈ ℂ by typecheck
  have closed := risingFactorial.closed at ℂ[-complexOfReal(realNat(n))]
  induction j
  | zero =>
    intro below
    exfalso
    arith
  | succ(k) using ih =>
    intro bound
    have kMember : complexOfReal(realNat(k)) ∈ ℂ by typecheck
    have previous := closed at k with *
    rw risingFactorial.succ
    by_cases below : n < k
    . rw ih with below
      ring
    . have same : n = k by arith
      rw same
      ring

-- Section: The remainder integral
theorem complexAbs.real (z : Set)
  requires hz : z ∈ ℂ
  shows Real(complexAbs(z))
proof
  exact FunctionBetween.apply_closed with complexAbs.function, hz

theorem bernoulliBound.real (n : Nat)
  shows Real(bernoulliBound(n))
proof
  have bounds := bernoulliBoundTerms.function at n
  have boundSequence : RealSequence(bernoulliBoundTerms(n)) by exact bounds
  have total := realPartialSum.real at bernoulliBoundTerms(n), succ(n)
    with boundSequence
  unfold bernoulliBound
  typecheck

-- The real part of the exponent −s − X.
theorem complexRe.neg_sub_real (s : Set) (X : Real)
  requires hs : s ∈ ℂ
  shows complexRe(ℂ[-s - complexOfReal(X)]) = R[-complexRe(s) - X]
proof
  have negative : ℂ[-s] ∈ ℂ by typecheck
  have xMember : complexOfReal(X) ∈ ℂ by typecheck
  rw [(complexRe.sub with negative, xMember), (complexRe.neg with hs),
    complexOfReal.re]

-- |P̃ₙ(x)(x + a)^(−s−n)| ≤ C (x + a)^(−re s − n) for x ≥ 0.
theorem hurwitzIntegrand.abs_le (n : Nat) (a X : Real) (s : Set)
  requires positive : R[0] < a
  requires hs : s ∈ ℂ
  requires nonnegative : R[0] ≤ X
  shows complexAbs(hurwitzIntegrand(n, a, s)(X)) ≤
    R[bernoulliBound(n) * realRpow(R[X + a], R[-complexRe(s) - realNat(n)])]
proof
  have shifted : R[0] < R[X + a] by linarith
  have exponent : ℂ[-s - complexOfReal(realNat(n))] ∈ ℂ by typecheck
  have power := realCpow.member at R[X + a],
    ℂ[-s - complexOfReal(realNat(n))] with exponent
  have function := periodicBernoulli.function at n
  have xMember : X ∈ ℝ by typecheck
  have value := FunctionBetween.apply_closed with function, xMember
  have valueReal : Real(periodicBernoulli(n)(X)) by exact value
  have scalar : complexOfReal(periodicBernoulli(n)(X)) ∈ ℂ by typecheck
  rw [(hurwitzIntegrand.value at n, a, s, X with hs),
    (complexAbs.mul with scalar, power), complexAbs.of_real,
    (realCpow.abs with shifted, exponent), (complexRe.neg_sub_real with hs)]
  have bound := periodicBernoulli.bound at n, X
  have boundReal := bernoulliBound.real at n
  have positivePower := realRpow.positive at R[X + a],
    R[-complexRe(s) - realNat(n)]
  have powerNonnegative :
    R[0] ≤ realRpow(R[X + a], R[-complexRe(s) - realNat(n)]) by linarith
  exact realLe.mul_right_of_nonnegative with bound, powerNonnegative

-- A complex function g of a real variable whose increments are D h up to
-- K h² near X: its real and imaginary parts have derivatives re D, im D.
theorem complexFunction.derivative_parts (g D : Set) (X K W : Real)
  requires values : ComplexValuedOn(g, ℝ)
  requires hD : D ∈ ℂ
  requires positive : R[0] < K
  requires radius : R[0] < W
  requires bound : ∀ H ∈ ℝ, H ≠ R[0] → abs(H) < W →
    complexAbs(ℂ[g(R[X + H]) - g(X) - D * complexOfReal(H)]) ≤
      R[K * (H * H)]
  shows HasDerivativeAt(complexFunctionRe(g), complexRe(D), X) ∧
    HasDerivativeAt(complexFunctionIm(g), complexIm(D), X)
proof
  have functionRe := complexFunctionRe.function with values
  have functionIm := complexFunctionIm.function with values
  have xMember : X ∈ ℝ by typecheck
  have gX := values with X, xMember
  have reD := complexRe.real with hD
  have imD := complexIm.real with hD
  have reX := complexRe.real with gX
  have imX := complexIm.real with gX
  constructor
  . apply HasDerivativeAt.of_quadratic_bound with functionRe, positive, radius
    intros H hMember nonzero small
    have shifted : R[X + H] ∈ ℝ by typecheck
    have gShift := values with R[X + H], shifted
    have reShift := complexRe.real with gShift
    have hComplex : complexOfReal(H) ∈ ℂ by typecheck
    have product : ℂ[D * complexOfReal(H)] ∈ ℂ by typecheck
    have first : ℂ[g(R[X + H]) - g(X)] ∈ ℂ by typecheck
    have error : ℂ[g(R[X + H]) - g(X) - D * complexOfReal(H)] ∈ ℂ
      by typecheck
    have reError := complexAbs.re_le with error
    rw [(complexRe.sub with first, product), (complexRe.sub with gShift, gX),
      (complexRe.mul with hD, hComplex), complexOfReal.re,
      complexOfReal.im] at reError
    have shape : R[complexRe(g(R[X + H])) - complexRe(g(X)) -
        (complexRe(D) * H - complexIm(D) * 0)] =
      R[complexRe(g(R[X + H])) - complexRe(g(X)) - complexRe(D) * H] by ring
    rw shape at reError
    rw [(complexFunctionRe.apply at g, R[X + H] with values),
      (complexFunctionRe.apply at g, X with values)]
    have estimate := bound with H, hMember, nonzero, small
    linarith
  . apply HasDerivativeAt.of_quadratic_bound with functionIm, positive, radius
    intros H hMember nonzero small
    have shifted : R[X + H] ∈ ℝ by typecheck
    have gShift := values with R[X + H], shifted
    have imShift := complexIm.real with gShift
    have hComplex : complexOfReal(H) ∈ ℂ by typecheck
    have product : ℂ[D * complexOfReal(H)] ∈ ℂ by typecheck
    have first : ℂ[g(R[X + H]) - g(X)] ∈ ℂ by typecheck
    have error : ℂ[g(R[X + H]) - g(X) - D * complexOfReal(H)] ∈ ℂ
      by typecheck
    have imError := complexAbs.im_le with error
    rw [(complexIm.sub with first, product), (complexIm.sub with gShift, gX),
      (complexIm.mul with hD, hComplex), complexOfReal.re,
      complexOfReal.im] at imError
    have shape : R[complexIm(g(R[X + H])) - complexIm(g(X)) -
        (complexRe(D) * 0 + complexIm(D) * H)] =
      R[complexIm(g(R[X + H])) - complexIm(g(X)) - complexIm(D) * H] by ring
    rw shape at imError
    rw [(complexFunctionIm.apply at g, R[X + H] with values),
      (complexFunctionIm.apply at g, X with values)]
    have estimate := bound with H, hMember, nonzero, small
    linarith

-- The increments of y ↦ y^w at Y > 0: Y^w (w h / Y) up to a multiple of
-- h², for |h| small against Y and |w|.
theorem realCpow.linear_error (Y H : Real) (w : Set)
  requires positive : R[0] < Y
  requires hw : w ∈ ℂ
  requires small : R[2 * (complexAbs(w) + 1) * abs(H)] < Y
  shows complexAbs(ℂ[realCpow(R[Y + H], w) - realCpow(Y, w) -
      w * realCpow(Y, w) * complexOfReal(R[H * (1 / Y)])]) ≤
    R[realRpow(Y, complexRe(w)) *
      (4 * (complexAbs(w) * complexAbs(w)) + 2 * complexAbs(w)) *
      ((1 / Y) * (1 / Y)) * (H * H)]
proof
  have wAbs := complexAbs.nonnegative with hw
  have hAbs := abs.nonnegative at H
  have yNonzero : Y ≠ R[0] by linarith
  have inverse := realDiv.mul_right at R[1], Y with yNonzero
  have inverseReal : Real(R[1 / Y]) by typecheck
  have yInverse : R[Y * (1 / Y)] = R[1] by linear_combination inverse
  have inversePositive : R[0] < R[1 / Y]
    by_contra notPositive
    have nonpositive : R[1 / Y] ≤ R[0] by linarith
    have scaled := realLe.mul_right_of_nonnegative with nonpositive,
      (realLess.implies_le with positive)
    have zero : R[0 * Y] = R[0] by ring
    linarith
  have inverseNonnegative : R[0] ≤ R[1 / Y] by linarith
  have crossNonnegative := realLe.mul_left_of_nonnegative with hAbs, wAbs
  have zeroCross : R[complexAbs(w) * 0] = R[0] by ring
  have expandSmall : R[2 * (complexAbs(w) + 1) * abs(H)] =
    R[2 * (complexAbs(w) * abs(H)) + 2 * abs(H)] by ring
  have halfSmall : abs(H) < R[Y / 2] by linarith
  have logBound := realLog.derivative_bound with positive, halfSmall
  -- |ℓ| ≤ 2 |h| / Y for ℓ = log(Y + h) − log Y.
  have absProduct := abs.mul at R[1 / Y], H
  have absInverse := abs.of_nonnegative with inverseNonnegative
  have scaledSmall : R[2 * abs(H) * (1 / Y)] ≤ R[1]
    have bound : R[2 * abs(H)] ≤ Y by linarith
    have scaled := realLe.mul_right_of_nonnegative with bound,
      inverseNonnegative
    linarith
  have unitNonnegative := realMulValue.nonnegative with hAbs, inverseNonnegative
  have quadratic := realLe.mul_left_of_nonnegative with scaledSmall,
    unitNonnegative
  have squareH := abs.mul at H, H
  have squareNonnegative := realMulValue.square_nonnegative at H
  have squareAbs := abs.of_nonnegative with squareNonnegative
  have triangle := abs.triangle at
    R[realLog(R[Y + H]) - realLog(Y) - 1 / Y * H], R[1 / Y * H]
  have logShape : R[realLog(R[Y + H]) - realLog(Y) - 1 / Y * H + 1 / Y * H] =
    R[realLog(R[Y + H]) - realLog(Y)] by ring
  rw logShape at triangle
  have hSquare : R[H * H] = R[abs(H) * abs(H)] by rw [← squareAbs, squareH]
  have quadraticShape : R[2 * (1 / Y) * (1 / Y) * (H * H)] =
      R[(abs(H) * (1 / Y)) * (2 * abs(H) * (1 / Y))]
    rw hSquare
    ring
  have unitShape : R[(abs(H) * (1 / Y)) * 1] = R[abs(H) * (1 / Y)] by ring
  have linearShape : abs(R[1 / Y * H]) = R[abs(H) * (1 / Y)]
    rw [absProduct, absInverse]
    ring
  have logSmall : abs(R[realLog(R[Y + H]) - realLog(Y)]) ≤
      R[2 * (abs(H) * (1 / Y))]
    linarith
  -- The exponential error.
  have logY : complexOfReal(realLog(Y)) ∈ ℂ by typecheck
  have logYH : complexOfReal(realLog(R[Y + H])) ∈ ℂ by typecheck
  have difference : ℂ[complexOfReal(realLog(R[Y + H])) -
      complexOfReal(realLog(Y))] =
      complexOfReal(R[realLog(R[Y + H]) - realLog(Y)])
    rw [complexOfReal.add, complexOfReal.neg]
  have absDifference : complexAbs(ℂ[complexOfReal(realLog(R[Y + H])) -
      complexOfReal(realLog(Y))]) = abs(R[realLog(R[Y + H]) - realLog(Y)])
    rw [difference, complexAbs.of_real]
  have logNonnegative := abs.nonnegative at R[realLog(R[Y + H]) - realLog(Y)]
  have scaledLog := realLe.mul_left_of_nonnegative with logSmall, wAbs
  have expSmall : R[complexAbs(w) * complexAbs(ℂ[complexOfReal(realLog(R[Y + H]))
      - complexOfReal(realLog(Y))])] ≤ R[1]
    rw absDifference
    have shape : R[2 * complexAbs(w) * abs(H)] =
      R[2 * (complexAbs(w) * abs(H))] by ring
    have bound : R[2 * complexAbs(w) * abs(H)] ≤ Y by linarith
    have scaled := realLe.mul_right_of_nonnegative with bound,
      inverseNonnegative
    have scaledShape : R[complexAbs(w) * (2 * (abs(H) * (1 / Y)))] =
      R[2 * complexAbs(w) * abs(H) * (1 / Y)] by ring
    linarith
  have expError := complexExp.linear_error with hw, logY, logYH, expSmall
  rw absDifference at expError
  have product : ℂ[w * complexOfReal(realLog(Y))] ∈ ℂ by typecheck
  have expMember := complexExp.member with product
  have exponentAbs := realCpow.abs with positive, hw
  unfold realCpow at exponentAbs
  rw exponentAbs at expError
  -- The logarithm error, scaled by w Y^w.
  have power := realCpow.abs with positive, hw
  have powerPositive := realRpow.positive at Y, complexRe(w)
  have logError : ℂ[complexOfReal(R[realLog(R[Y + H]) - realLog(Y)]) -
      complexOfReal(R[H * (1 / Y)])] =
      complexOfReal(R[realLog(R[Y + H]) - realLog(Y) - 1 / Y * H])
    have shape : R[realLog(R[Y + H]) - realLog(Y) - 1 / Y * H] =
      R[realLog(R[Y + H]) - realLog(Y) + -(H * (1 / Y))] by ring
    have sum := complexOfReal.add at R[realLog(R[Y + H]) - realLog(Y)],
      R[-(H * (1 / Y))]
    have negative := complexOfReal.neg at R[H * (1 / Y)]
    rw [shape, sum, negative]
    have first : complexOfReal(R[realLog(R[Y + H]) - realLog(Y)]) ∈ ℂ
      by typecheck
    have second : complexOfReal(R[H * (1 / Y)]) ∈ ℂ by typecheck
    ring
  have powerMember := realCpow.member at Y, w with hw
  have scale : ℂ[w * realCpow(Y, w)] ∈ ℂ by typecheck
  have errorMember : complexOfReal(R[realLog(R[Y + H]) - realLog(Y) -
    1 / Y * H]) ∈ ℂ by typecheck
  have second := complexAbs.mul with scale, errorMember
  rw [(complexAbs.mul with hw, powerMember), power, complexAbs.of_real]
    at second
  -- The target is the sum of the two errors.
  have expErrorMember : ℂ[complexExp(w * complexOfReal(realLog(R[Y + H]))) -
      complexExp(w * complexOfReal(realLog(Y))) -
      w * complexExp(w * complexOfReal(realLog(Y))) *
      (complexOfReal(realLog(R[Y + H])) - complexOfReal(realLog(Y)))] ∈ ℂ
    have other : ℂ[w * complexOfReal(realLog(R[Y + H]))] ∈ ℂ by typecheck
    have otherMember := complexExp.member with other
    typecheck
  have secondMember : ℂ[w * realCpow(Y, w) *
    complexOfReal(R[realLog(R[Y + H]) - realLog(Y) - 1 / Y * H])] ∈ ℂ
    by typecheck
  have hScaled : complexOfReal(R[H * (1 / Y)]) ∈ ℂ by typecheck
  have split : ℂ[realCpow(R[Y + H], w) - realCpow(Y, w) -
      w * realCpow(Y, w) * complexOfReal(R[H * (1 / Y)])] =
      ℂ[(complexExp(w * complexOfReal(realLog(R[Y + H]))) -
        complexExp(w * complexOfReal(realLog(Y))) -
        w * complexExp(w * complexOfReal(realLog(Y))) *
        (complexOfReal(realLog(R[Y + H])) - complexOfReal(realLog(Y)))) +
      w * realCpow(Y, w) *
        complexOfReal(R[realLog(R[Y + H]) - realLog(Y) - 1 / Y * H])]
    rw [← logError, ← difference]
    unfold realCpow
    have other : ℂ[w * complexOfReal(realLog(R[Y + H]))] ∈ ℂ by typecheck
    have otherMember := complexExp.member with other
    ring
  rw split
  have total := complexAbs.triangle with expErrorMember, secondMember
  -- Bounding the two pieces.
  have scaledLogNonnegative := realMulValue.nonnegative with wAbs,
    logNonnegative
  have twoUnit : R[0] ≤ R[2 * (abs(H) * (1 / Y))] by linarith
  have boundNonnegative := realMulValue.nonnegative with wAbs, twoUnit
  have squareStep := realLe.mul_left_of_nonnegative with scaledLog,
    scaledLogNonnegative
  have squareStep2 := realLe.mul_right_of_nonnegative with scaledLog,
    boundNonnegative
  have powerNonnegative : R[0] ≤ realRpow(Y, complexRe(w)) by linarith
  have squareBound : R[(complexAbs(w) *
      abs(R[realLog(R[Y + H]) - realLog(Y)])) *
      (complexAbs(w) * abs(R[realLog(R[Y + H]) - realLog(Y)]))] ≤
    R[(complexAbs(w) * (2 * (abs(H) * (1 / Y)))) *
      (complexAbs(w) * (2 * (abs(H) * (1 / Y))))] by linarith
  have firstBound := realLe.mul_left_of_nonnegative with squareBound,
    powerNonnegative
  have weight := realMulValue.nonnegative with wAbs, powerNonnegative
  have secondBound := realLe.mul_left_of_nonnegative with logBound, weight
  have firstShape : R[realRpow(Y, complexRe(w)) *
      ((complexAbs(w) * (2 * (abs(H) * (1 / Y)))) *
      (complexAbs(w) * (2 * (abs(H) * (1 / Y)))))] =
    R[realRpow(Y, complexRe(w)) * (4 * (complexAbs(w) * complexAbs(w))) *
      ((1 / Y) * (1 / Y)) * (H * H)]
    rw hSquare
    ring
  have secondShape : R[complexAbs(w) * realRpow(Y, complexRe(w)) *
      (2 * (1 / Y) * (1 / Y) * (H * H))] =
    R[realRpow(Y, complexRe(w)) * (2 * complexAbs(w)) *
      ((1 / Y) * (1 / Y)) * (H * H)] by ring
  have totalShape : R[realRpow(Y, complexRe(w)) *
      (4 * (complexAbs(w) * complexAbs(w)) + 2 * complexAbs(w)) *
      ((1 / Y) * (1 / Y)) * (H * H)] =
    R[realRpow(Y, complexRe(w)) * (4 * (complexAbs(w) * complexAbs(w))) *
      ((1 / Y) * (1 / Y)) * (H * H) +
      realRpow(Y, complexRe(w)) * (2 * complexAbs(w)) *
      ((1 / Y) * (1 / Y)) * (H * H)] by ring
  linarith

-- y^(w − 1) = y^w / y.
theorem realCpow.sub_one (Y : Real) (w : Set)
  requires positive : R[0] < Y
  requires hw : w ∈ ℂ
  shows realCpow(Y, ℂ[w - 1]) = ℂ[realCpow(Y, w) * complexOfReal(R[1 / Y])]
proof
  have one : ℂ[-1] = complexOfReal(R[-1])
    rw [complexOfReal.neg, complexOfReal.one]
  have minusOne : ℂ[-1] ∈ ℂ by typecheck
  rw [(realCpow.add with hw, minusOne), one, realCpow.of_real,
    (realRpow.neg with positive), (realRpow.one with positive)]

-- d/dx c (x + a)^w = c w (x + a)^(w − 1), in the real and imaginary parts.
theorem scaledPower.has_derivative (c : Set) (a X : Real) (w : Set)
  requires hc : c ∈ ℂ
  requires hw : w ∈ ℂ
  requires positive : R[0] < R[X + a]
  shows HasDerivativeAt(complexFunctionRe(scaledPower(c, a, w)),
      complexRe(ℂ[c * w * realCpow(R[X + a], ℂ[w - 1])]), X) ∧
    HasDerivativeAt(complexFunctionIm(scaledPower(c, a, w)),
      complexIm(ℂ[c * w * realCpow(R[X + a], ℂ[w - 1])]), X)
proof
  have function := scaledPower.function at c, a, w with hc, hw
  have values : ComplexValuedOn(scaledPower(c, a, w), ℝ)
    intros Y yMember
    exact FunctionBetween.apply_closed with function, yMember
  have shiftedOne : ℂ[w - 1] ∈ ℂ by typecheck
  have powerShifted := realCpow.member at R[X + a], ℂ[w - 1] with shiftedOne
  have hD : ℂ[c * w * realCpow(R[X + a], ℂ[w - 1])] ∈ ℂ by typecheck
  have cAbs := complexAbs.nonnegative with hc
  have wAbs := complexAbs.nonnegative with hw
  have cAbsReal := complexAbs.real with hc
  have wAbsReal := complexAbs.real with hw
  have powerPositive := realRpow.positive at R[X + a], complexRe(w)
  have yNonzero : R[X + a] ≠ R[0] by linarith
  have inverse := realDiv.mul_right at R[1], R[X + a] with yNonzero
  have inverseReal : Real(R[1 / (X + a)]) by typecheck
  have constant : R[0] ≤ R[complexAbs(c) * (realRpow(R[X + a], complexRe(w)) *
      (4 * (complexAbs(w) * complexAbs(w)) + 2 * complexAbs(w)) *
      ((1 / (X + a)) * (1 / (X + a))))]
    have squareW := realMulValue.nonnegative with wAbs, wAbs
    have weight : R[0] ≤ R[4 * (complexAbs(w) * complexAbs(w)) +
      2 * complexAbs(w)] by linarith
    have inverseSquare := realMulValue.square_nonnegative at R[1 / (X + a)]
    have first := realMulValue.nonnegative with
      (realLess.implies_le with powerPositive), weight
    have second := realMulValue.nonnegative with first, inverseSquare
    exact realMulValue.nonnegative with cAbs, second
  have kReal : Real(R[complexAbs(c) * (realRpow(R[X + a],
      complexRe(w)) * (4 * (complexAbs(w) * complexAbs(w)) +
      2 * complexAbs(w)) * ((1 / (X + a)) * (1 / (X + a))))]) by typecheck
  have kPositive : R[0] < R[complexAbs(c) * (realRpow(R[X + a],
      complexRe(w)) * (4 * (complexAbs(w) * complexAbs(w)) +
      2 * complexAbs(w)) * ((1 / (X + a)) * (1 / (X + a)))) + 1] by linarith
  have scalePositive : R[0] < R[2 * (complexAbs(w) + 1)] by linarith
  have scaleNonzero : R[2 * (complexAbs(w) + 1)] ≠ R[0] by linarith
  have scaleInverse := realDiv.mul_right at R[1], R[2 * (complexAbs(w) + 1)]
    with scaleNonzero
  have scaleInverseReal : Real(R[1 / (2 * (complexAbs(w) + 1))]) by typecheck
  have scaleInversePositive : R[0] < R[1 / (2 * (complexAbs(w) + 1))]
    by_contra notPositive
    have nonpositive : R[1 / (2 * (complexAbs(w) + 1))] ≤ R[0] by linarith
    have scaled := realLe.mul_right_of_nonnegative with nonpositive,
      (realLess.implies_le with scalePositive)
    have zero : R[0 * (2 * (complexAbs(w) + 1))] = R[0] by ring
    linarith
  have radius := realMulValue.positive with positive, scaleInversePositive
  apply complexFunction.derivative_parts with values, hD, kPositive, radius
  intros H hMember nonzero small
  have hReal : Real(H) by exact hMember
  have shiftedPoint : R[X + H] ∈ ℝ by typecheck
  have xMember : X ∈ ℝ by typecheck
  have smallScaled := realLess.mul_left_of_positive with small, scalePositive
  have cancel : R[2 * (complexAbs(w) + 1) * ((X + a) *
      (1 / (2 * (complexAbs(w) + 1))))] = R[X + a]
    linear_combination (X + a) * scaleInverse
  have smallH : R[2 * (complexAbs(w) + 1) * abs(H)] < R[X + a] by linarith
  have error := realCpow.linear_error with positive, hw, smallH
  have pointShift : R[R[X + H] + a] = R[R[X + a] + H] by ring
  rw [(scaledPower.value at c, a, w, R[X + H] with hc, hw),
    (scaledPower.value at c, a, w, X with hc, hw), pointShift,
    (realCpow.sub_one with positive, hw)]
  have powerMember := realCpow.member at R[X + a], w with hw
  have powerHMember := realCpow.member at R[R[X + a] + H], w with hw
  have hComplex : complexOfReal(H) ∈ ℂ by typecheck
  have unitComplex : complexOfReal(R[1 / (X + a)]) ∈ ℂ by typecheck
  have errorMember : ℂ[realCpow(R[X + a + H], w) - realCpow(R[X + a], w) -
      w * realCpow(R[X + a], w) * complexOfReal(R[H * (1 / (X + a))])] ∈ ℂ
    by typecheck
  have factor : ℂ[c * realCpow(R[X + a + H], w) -
      c * realCpow(R[X + a], w) -
      c * w * (realCpow(R[X + a], w) * complexOfReal(R[1 / (X + a)])) *
      complexOfReal(H)] =
      ℂ[c * (realCpow(R[X + a + H], w) - realCpow(R[X + a], w) -
      w * realCpow(R[X + a], w) * complexOfReal(R[H * (1 / (X + a))]))]
    rw complexOfReal.mul
    ring
  rw [factor, (complexAbs.mul with hc, errorMember)]
  have scaled := realLe.mul_left_of_nonnegative with error, cAbs
  have squareNonnegative := realMulValue.square_nonnegative at H
  have shape : R[(complexAbs(c) * (realRpow(R[X + a], complexRe(w)) *
      (4 * (complexAbs(w) * complexAbs(w)) + 2 * complexAbs(w)) *
      ((1 / (X + a)) * (1 / (X + a)))) + 1) * (H * H)] =
    R[complexAbs(c) * (realRpow(R[X + a], complexRe(w)) *
      (4 * (complexAbs(w) * complexAbs(w)) + 2 * complexAbs(w)) *
      ((1 / (X + a)) * (1 / (X + a))) * (H * H)) + H * H] by ring
  linarith

theorem hurwitzIntegrand.local_integrable (n : Nat) (a T : Real) (s : Set)
  requires positive : R[0] < a
  requires hs : s ∈ ℂ
  requires nonnegative : R[0] ≤ T
  shows ComplexRiemannIntegrable(hurwitzIntegrand(n, a, s), R[0], T)
proof
  sorry

-- ∫_0^∞ P̃ₙ(x)(x + a)^(−s−n) dx converges for re s > 1 − n.
theorem hurwitzIntegrand.integrable (n : Nat) (a : Real) (s : Set)
  requires positive : R[0] < a
  requires hs : s ∈ ℂ
  requires halfPlane : R[1 - realNat(n)] < complexRe(s)
  shows ComplexImproperIntegrable(hurwitzIntegrand(n, a, s), R[0])
proof
  sorry

theorem hurwitzKernel.apply (n : Nat) (a : Real) (s : Set)
  requires hs : s ∈ ℂ
  shows hurwitzKernel(n, a)(s) = hurwitzIntegrand(n, a, s)
proof
  exact hurwitzKernel.value at n, a, s with hs

-- s ↦ ∫_0^∞ P̃ₙ(x)(x + a)^(−s−n) dx is holomorphic on re s > 1 − n.
theorem hurwitzKernel.holomorphic (n : Nat) (a : Real)
  requires positive : R[0] < a
  shows HolomorphicOn(parameterIntegral(hurwitzKernel(n, a),
    rightHalfPlane(R[1 - realNat(n)]), R[0]), rightHalfPlane(R[1 - realNat(n)]))
proof
  sorry

-- Section: The order
theorem hurwitzOrder.spec (s : Set)
  requires hs : s ∈ ℂ
  shows 1 ≤ hurwitzOrder(s) ∧
    R[1 - 2 * realNat(hurwitzOrder(s))] < complexRe(s)
proof
  have naturals : hurwitzOrders(s) ⊆ ℕ
    intros m member
    unfold hurwitzOrders at member
    exact member.left
  have reReal := complexRe.real with hs
  obtain ⟨n, nNat, above⟩ := Real.below_natural at R[1 - complexRe(s)]
  have nonnegative := realNat.nonnegative at n
  have successor := realNat.succ_value at n
  have nMember : succ(n) ∈ hurwitzOrders(s)
    unfold hurwitzOrders
    have natural := nat.omega.forward at succ(n) with *
    refine ⟨natural, ?_, ?_⟩
    . arith
    . rw successor
      linarith
  have inhabited : Nonempty(hurwitzOrders(s)) := ⟨succ(n), nMember⟩
  have least := leastNatural.member with inhabited, naturals
  unfold hurwitzOrder
  unfold hurwitzOrders at least
  exact least.right

theorem hurwitzOrder.least (s : Set) (m : Nat)
  requires hs : s ∈ ℂ
  requires positive : 1 ≤ m
  requires halfPlane : R[1 - 2 * realNat(m)] < complexRe(s)
  shows hurwitzOrder(s) ≤ m
proof
  have naturals : hurwitzOrders(s) ⊆ ℕ
    intros k member
    unfold hurwitzOrders at member
    exact member.left
  have mMember : m ∈ hurwitzOrders(s)
    unfold hurwitzOrders
    have natural := nat.omega.forward at m with *
    exact ⟨natural, positive, halfPlane⟩
  have inhabited : Nonempty(hurwitzOrders(s)) := ⟨m, mMember⟩
  unfold hurwitzOrder
  exact leastNatural.least with inhabited, naturals, mMember

-- Section: The definition
theorem hurwitzZeta.member (s : Set) (a : Real)
  requires hs : s ∈ ℂ
  shows hurwitzZeta(s, a) ∈ ℂ
proof
  have selected := hurwitzZeta.selected at s, a with hs
  exact selected.left

theorem hurwitzZeta.eq_order (s : Set) (a : Real)
  requires hs : s ∈ ℂ
  requires notOne : s ≠ ℂ[1]
  shows hurwitzZeta(s, a) = hurwitzEulerMaclaurin(hurwitzOrder(s), s, a)
proof
  obtain ⟨_, offPole, _⟩ := hurwitzZeta.selected at s, a with hs
  exact offPole with notOne

theorem hurwitzZeta.at_one (a : Real)
  shows hurwitzZeta(ℂ[1], a) = hurwitzZeta.regular(a)
proof
  have one := complexOne.member
  obtain ⟨_, _, atPole⟩ := hurwitzZeta.selected at ℂ[1], a with one
  exact atPole with rfl

-- H_m(s, a) does not depend on the admissible order m.
theorem hurwitzZeta.order_independent (s : Set) (a : Real) (m n : Nat)
  requires positive : R[0] < a
  requires hs : s ∈ ℂ
  requires notOne : s ≠ ℂ[1]
  requires positiveM : 1 ≤ m
  requires positiveN : 1 ≤ n
  requires halfPlaneM : R[1 - 2 * realNat(m)] < complexRe(s)
  requires halfPlaneN : R[1 - 2 * realNat(n)] < complexRe(s)
  shows hurwitzEulerMaclaurin(m, s, a) = hurwitzEulerMaclaurin(n, s, a)
proof
  sorry

-- So ζ(s, a) is H_m(s, a) at every admissible order.
theorem hurwitzZeta.eq_euler_maclaurin (s : Set) (a : Real) (m : Nat)
  requires positive : R[0] < a
  requires hs : s ∈ ℂ
  requires notOne : s ≠ ℂ[1]
  requires positiveM : 1 ≤ m
  requires halfPlane : R[1 - 2 * realNat(m)] < complexRe(s)
  shows hurwitzZeta(s, a) = hurwitzEulerMaclaurin(m, s, a)
proof
  sorry

-- The constant term does not depend on the order either.
theorem hurwitzZeta.regular_order (a : Real) (m : Nat)
  requires positive : R[0] < a
  requires positiveM : 1 ≤ m
  shows hurwitzRegularEulerMaclaurin(m, a) = hurwitzZeta.regular(a)
proof
  sorry

-- Section: The series
-- For re s > 1, ζ(s, a) = Σ_{n≥0} (n + a)^(−s), absolutely convergent.
theorem hurwitzZeta.series (s : Set) (a : Real)
  requires positive : R[0] < a
  requires hs : s ∈ ℂ
  requires halfPlane : realOne < complexRe(s)
  shows ComplexSumsTo(hurwitzSeriesTerms(s, a), hurwitzZeta(s, a)) ∧
    ComplexAbsolutelySummable(hurwitzSeriesTerms(s, a))
proof
  sorry

-- ζ(s, a) = a^(−s) + ζ(s, a + 1), at every s including the pole, where it
-- reads −ψ(a) = 1/a − ψ(a + 1).
theorem hurwitzZeta.shift (s : Set) (a : Real)
  requires positive : R[0] < a
  requires hs : s ∈ ℂ
  shows hurwitzZeta(s, a) = ℂ[realCpow(a, ℂ[-s]) + hurwitzZeta(s, R[a + 1])]
proof
  sorry

-- Section: Analytic properties
theorem hurwitzZetaMap.apply (a : Real) (s : Set)
  requires hs : s ∈ ℂ
  shows hurwitzZetaMap(a)(s) = hurwitzZeta(s, a)
proof
  exact hurwitzZetaMap.value at a, s with hs

-- ζ(·, a) is holomorphic on ℂ ∖ {1}.
theorem hurwitzZeta.holomorphic (a : Real)
  requires positive : R[0] < a
  shows HolomorphicOn(hurwitzZetaMap(a), complexCarrier ∖ {ℂ[1]})
proof
  sorry

-- The pole: ζ(s, a) − 1/(s − 1) → hurwitzZeta.regular(a) as s → 1.
theorem hurwitzZeta.pole (a : Real)
  requires positive : R[0] < a
  shows ∀ e ∈ ℝ, R[0] < e → ∃ d ∈ ℝ, R[0] < d ∧
    (∀ s ∈ ℂ, s ≠ ℂ[1] → complexAbs(ℂ[s - 1]) < d →
      complexAbs(ℂ[hurwitzZeta(s, a) - complexDiv(ℂ[1], ℂ[s - 1]) -
        hurwitzZeta.regular(a)]) < e)
proof
  sorry

theorem hurwitzZetaRegularMap.at_one (a : Real)
  shows hurwitzZetaRegularMap(a)(ℂ[1]) = hurwitzZeta.regular(a)
proof
  sorry

-- ζ(s, a) − 1/(s − 1), with its constant term at s = 1, is entire.
theorem hurwitzZetaRegularMap.holomorphic (a : Real)
  requires positive : R[0] < a
  shows HolomorphicOn(hurwitzZetaRegularMap(a), complexCarrier)
proof
  sorry

-- Section: Values
-- ζ(−n, a) = −B_{n+1}(a)/(n + 1); in particular ζ(0, a) = 1/2 − a.
theorem hurwitzZeta.neg_nat (n : Nat) (a : Real)
  requires positive : R[0] < a
  shows hurwitzZeta(ℂ[-complexOfReal(realNat(n))], a) =
    complexOfReal(R[-bernoulliPolynomial(n + 1, a) / realNat(n + 1)])
proof
  sorry

theorem hurwitzZeta.zero (a : Real)
  requires positive : R[0] < a
  shows hurwitzZeta(ℂ[0], a) = complexOfReal(R[1 / 2 - a])
proof
  sorry

-- The constant term is real.
theorem hurwitzZeta.regular_real (a : Real)
  shows complexIm(hurwitzZeta.regular(a)) = R[0]
proof
  sorry

-- For real s the value is real (at s = 1, the constant term).
theorem hurwitzZeta.real (S a : Real)
  requires positive : R[0] < a
  shows complexIm(hurwitzZeta(complexOfReal(S), a)) = R[0]
proof
  sorry

end Hurwitz
