-- The Hurwitz zeta function ζ(s, a), defined on all of ℂ by the
-- Euler–Maclaurin continuation of Σ_{n≥0} (n + a)^(−s). For m ≥ 1 and
-- re s > 1 − 2m, s ≠ 1, the expression of order 2m is
--   H_m(s, a) = a^(1−s)/(s − 1) + a^(−s)/2
--     + Σ_{k=1}^{m} B_{2k}/(2k)! · s(s+1)⋯(s+2k−2) · a^(−s−2k+1)
--     − s(s+1)⋯(s+2m−1)/(2m)! · ∫_0^∞ P̃_{2m}(x) (x + a)^(−s−2m) dx,
-- and ζ(s, a) is H_m(s, a) for the least such m; it does not depend on m.
-- At the pole s = 1 the value recorded is the constant term of the
-- Laurent expansion. The series for re s > 1, holomorphy on ℂ ∖ {1}, the
-- pole, the shift a ↦ a + 1, and the values at the nonpositive integers.
-- Part of the GRH blueprint.
-- Planned home: NumberTheory/Zeta/Hurwitz.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Hurwitz
import GRH.EulerMaclaurin

-- Small natural-number identities, stated outside the ring notations.
theorem natural.one_succ
  shows 1 = succ(0)
proof
  arith

theorem natural.two_succ
  shows 2 = succ(1)
proof
  arith

theorem natural.double_zero_succ
  shows 2 * 0 + 1 = 1
proof
  arith

theorem natural.double_one
  shows 2 * 1 = 2
proof
  arith

theorem natural.zero_add_one
  shows 0 + 1 = 1
proof
  arith

theorem natural.one_add_one
  shows 1 + 1 = 2
proof
  arith

theorem natural.two_add_one
  shows 2 + 1 = 3
proof
  arith

theorem natural.double_zero_two
  shows 2 * 0 + 2 = 2
proof
  arith

theorem natural.odd_zero
  shows 2 * 0 + 1 = succ(0)
proof
  arith

theorem natural.factorial_one
  shows 1! = 1
proof
  compute

theorem natural.factorial_two
  shows 2! = 2
proof
  compute

section Hurwitz
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Section: Definitions
-- The rising factorial s(s + 1)⋯(s + j − 1) in ℂ, 1 for j = 0.
def risingFactorial (s : Set) (j : Nat) → Set
  | s, zero => complexOne
  | s, succ(k) => complexMul(risingFactorial(s, k),
      complexAdd(s, complexOfReal(realNat(k))))

-- The rising factorials are complex (the same fact as
-- risingFactorial.member, needed before it).
theorem risingFactorial.closed (s : Set) (j : Nat)
  requires hs : s ∈ ℂ
  shows risingFactorial(s, j) ∈ ℂ
proof
  induction j
  | zero =>
    rw risingFactorial
    exact complexOne.member
  | succ(k) using ih =>
    have shift := complexOfReal.closed at realNat(k)
    rw risingFactorial
    typecheck

-- The integrand P̃ₙ(x) (x + a)^(−s−n) of the remainder, as a complex
-- function of the real variable x. Only x ≥ 0 matters, where x + a > 0
-- for a > 0; the power is realCpow, x^s = exp(s log x).
defgraph hurwitzIntegrand (n : Nat, a : Real, s : Set) (X ∈ ℝ) :
    complexCarrier :=
  ℂ[complexOfReal(periodicBernoulli(n)(X)) *
    realCpow(R[X + a], ℂ[-s - complexOfReal(realNat(n))])]
requires hs : s ∈ complexCarrier
proof
  have function := periodicBernoulli.function at n
  have value := FunctionBetween.apply_closed with function, member
  have valueReal : Real(periodicBernoulli(n)(X)) by exact value
  have exponent : ℂ[-s - complexOfReal(realNat(n))] ∈ ℂ by typecheck
  have power := realCpow.member at R[X + a], ℂ[-s - complexOfReal(realNat(n))]
    with exponent
  typecheck

-- The same integrands as a family indexed by s, for holomorphy in s.
defgraph hurwitzKernel (n : Nat, a : Real) (s ∈ complexCarrier) :
    functionSpace(ℝ, complexCarrier) := hurwitzIntegrand(n, a, s)
proof
  have function := hurwitzIntegrand.function at n, a, s with member
  exact functionSpace.mem_iff.backward with function

-- The terms of the boundary sum, k = 0, 1, …, standing for k + 1 in the
-- displayed formula: B_{2k+2}/(2k+2)! · s(s+1)⋯(s+2k) · a^(−s−2k−1).
defgraph hurwitzCorrectionTerms (s : Set, a : Real) (k ∈ ℕ) :
    complexCarrier :=
  ℂ[complexOfReal(R[bernoulli(2 * k + 2) / realNat((2 * k + 2)!)]) *
    risingFactorial(s, 2 * k + 1) *
    realCpow(a, ℂ[-s - complexOfReal(realNat(2 * k + 1))])]
requires hs : s ∈ complexCarrier
proof
  have typedK := nat.omega.backward with member
  have number := bernoulli.real at 2 * k + 2
  have factorialReal := realNat.real at (2 * k + 2)!
  have rising := risingFactorial.closed at s, 2 * k + 1 with hs
  have exponent : ℂ[-s - complexOfReal(realNat(2 * k + 1))] ∈ ℂ by typecheck
  have power := realCpow.member at a,
    ℂ[-s - complexOfReal(realNat(2 * k + 1))] with exponent
  typecheck

-- The remainder s(s+1)⋯(s+2m−1)/(2m)! · ∫_0^∞ P̃_{2m}(x)(x + a)^(−s−2m) dx.
def hurwitzRemainder (m : Nat, s : Set, a : Real) : Set :=
  ℂ[complexOfReal(R[1 / realNat((2 * m)!)]) * risingFactorial(s, 2 * m) *
    complexImproperIntegral(hurwitzIntegrand(2 * m, a, s), R[0])]

-- The Euler–Maclaurin expression H_m(s, a) of order 2m, for s ≠ 1; it is
-- ζ(s, a) when re s > 1 − 2m and a > 0.
def hurwitzEulerMaclaurin (m : Nat, s : Set, a : Real) : Set :=
  ℂ[complexDiv(realCpow(a, ℂ[1 - s]), ℂ[s - 1]) +
    complexDiv(realCpow(a, ℂ[-s]), ℂ[2]) +
    complexPartialSum(hurwitzCorrectionTerms(s, a), m) -
    hurwitzRemainder(m, s, a)]

-- The constant term at the pole s = 1: the same expression with
-- a^(1−s)/(s − 1) = 1/(s − 1) − log a + O(s − 1) replaced by −log a, and
-- s = 1 elsewhere (the rising factorials become (2k − 1)! and (2m)!).
-- It is −ψ(a), and Euler's constant γ at a = 1.
def hurwitzRegularEulerMaclaurin (m : Nat, a : Real) : Set :=
  ℂ[complexOfReal(R[-realLog(a)]) + complexDiv(realCpow(a, ℂ[-1]), ℂ[2]) +
    complexPartialSum(hurwitzCorrectionTerms(ℂ[1], a), m) -
    hurwitzRemainder(m, ℂ[1], a)]

-- The orders m ≥ 1 with re s > 1 − 2m, for which H_m(s, a) converges, and
-- the least of them.
def hurwitzOrders (s : Set) : Set :=
  { m ∈ ℕ | 1 ≤ m ∧ R[1 - 2 * realNat(m)] < complexRe(s) }

-- The least natural of the empty set is ∅ (after
-- Grace.Cumulus.GraphTheory.TreePacking.Order, which this module does not
-- import), so leastNatural(S) is a natural for every set S of naturals.
theorem leastNatural.empty_set
  shows leastNatural(∅) = ∅
proof
  unfold leastNatural
  have none : leastNatural.candidates(∅) = ∅
    ext n
    constructor
    . intro member
      exfalso
      exact set.empty with member.right.left
    . intro member
      exfalso
      exact set.empty with member
  rw none
  exact union.empty

theorem leastNatural.natural_of_subset (S : Set)
  requires naturals : S ⊆ ℕ
  shows Nat(leastNatural(S))
proof
  by_cases empty : S = ∅
  . rw [empty, leastNatural.empty_set, ← nat.zero]
    exact Naturals.constructor.zero
  . have inhabited := Nonempty.of_ne_empty with empty
    have member := leastNatural.member with inhabited, naturals
    exact nat.omega.backward with (naturals with leastNatural(S), member)

def hurwitzOrder (s : Set) : Nat := leastNatural(hurwitzOrders(s))
proof
  have naturals : hurwitzOrders(s) ⊆ ℕ
    intros m member
    unfold hurwitzOrders at member
    exact member.left
  unfold hurwitzOrder
  exact leastNatural.natural_of_subset with naturals

-- The constant term of ζ(s, a) at s = 1, computed at order 2 (m = 1);
-- every order gives the same value (`hurwitzZeta.regular_order`).
def hurwitzZeta.regular (a : Real) : Set := hurwitzRegularEulerMaclaurin(1, a)

-- The expressions H_m(s, a) and its constant term at 1 are complex.
theorem hurwitzRemainder.closed (m : Nat, s : Set, a : Real)
  requires hs : s ∈ ℂ
  shows hurwitzRemainder(m, s, a) ∈ ℂ
proof
  have rising := risingFactorial.closed at s, 2 * m with hs
  have integral := complexImproperIntegral.member
    at hurwitzIntegrand(2 * m, a, s), R[0]
  have scale := complexOfReal.closed at R[1 / realNat((2 * m)!)]
  unfold hurwitzRemainder
  typecheck

theorem hurwitzEulerMaclaurin.closed (m : Nat, s : Set, a : Real)
  requires hs : s ∈ ℂ
  shows hurwitzEulerMaclaurin(m, s, a) ∈ ℂ
proof
  have one := complexOne.member
  have two : ℂ[2] ∈ ℂ by typecheck
  have shifted : ℂ[s - 1] ∈ ℂ by typecheck
  have first := realCpow.member at a, ℂ[1 - s] with *
  have second := realCpow.member at a, ℂ[-s] with *
  have firstInverse := complexInv.member at ℂ[s - 1] with shifted
  have secondInverse := complexInv.member at ℂ[2] with two
  have terms := hurwitzCorrectionTerms.function at s, a with hs
  have sequence : ComplexSequence(hurwitzCorrectionTerms(s, a)) by exact terms
  have sum := complexPartialSum.member at hurwitzCorrectionTerms(s, a), m
    with sequence
  have remainder := hurwitzRemainder.closed at m, s, a with hs
  unfold hurwitzEulerMaclaurin
  unfold complexDiv
  typecheck

theorem hurwitzRegularEulerMaclaurin.closed (m : Nat, a : Real)
  shows hurwitzRegularEulerMaclaurin(m, a) ∈ ℂ
proof
  have one := complexOne.member
  have two : ℂ[2] ∈ ℂ by typecheck
  have minusOne : ℂ[-1] ∈ ℂ by typecheck
  have logarithm := realLog.real at a
  have constant := complexOfReal.closed at R[-realLog(a)]
  have power := realCpow.member at a, ℂ[-1] with minusOne
  have inverse := complexInv.member at ℂ[2] with two
  have terms := hurwitzCorrectionTerms.function at ℂ[1], a with one
  have sequence : ComplexSequence(hurwitzCorrectionTerms(ℂ[1], a))
    by exact terms
  have sum := complexPartialSum.member at hurwitzCorrectionTerms(ℂ[1], a), m
    with sequence
  have remainder := hurwitzRemainder.closed at m, ℂ[1], a with one
  unfold hurwitzRegularEulerMaclaurin
  unfold complexDiv
  typecheck

-- ζ(s, a) for s ∈ ℂ and real a; the theorems take a > 0. For s ≠ 1 it is
-- H_m(s, a) at the least admissible order m. At s = 1, where ζ(s, a) has
-- a pole, the value is the constant term hurwitzZeta.regular(a); this is
-- not the value of a continuous function, and the theorems about ζ(·, a)
-- alone exclude s = 1. It is the value the L-functions need: the poles of
-- their terms cancel for a non-principal character, and their constant
-- terms then give the value of the continuous extension at 1.
defunique hurwitzZeta (s : Set, a : Real) (w ∈ complexCarrier) :=
  (s ≠ ℂ[1] → w = hurwitzEulerMaclaurin(hurwitzOrder(s), s, a)) ∧
  (s = ℂ[1] → w = hurwitzZeta.regular(a))
requires hs : s ∈ complexCarrier
proof
  by_cases one : s = ℂ[1]
  . have member := hurwitzRegularEulerMaclaurin.closed at 1, a
    witness hurwitzZeta.regular(a)
    unfold hurwitzZeta.regular
    refine ⟨member, ?_, ?_⟩
    . intro notOne
      exfalso
      exact notOne with one
    . intro same
      rfl
  . have member := hurwitzEulerMaclaurin.closed at hurwitzOrder(s), s, a
      with hs
    witness hurwitzEulerMaclaurin(hurwitzOrder(s), s, a)
    refine ⟨member, ?_, ?_⟩
    . intro notOne
      rfl
    . intro same
      exfalso
      exact one with same
uniqueness
  intros w wMember wValue v vMember vValue
  obtain ⟨wOff, wAt⟩ := wValue
  obtain ⟨vOff, vAt⟩ := vValue
  by_cases one : s = ℂ[1]
  . rw [wAt with one, vAt with one]
  . rw [wOff with one, vOff with one]

-- s ↦ ζ(s, a) as a function on ℂ.
defgraph hurwitzZetaMap (a : Real) (s ∈ complexCarrier) : complexCarrier :=
    hurwitzZeta(s, a)
proof
  have selected := hurwitzZeta.selected at s, a with member
  exact selected.left

-- s ↦ ζ(s, a) − 1/(s − 1) on ℂ. At s = 1 its value is
-- ζ(1, a) − 1/0 = hurwitzZeta.regular(a), since 0⁻¹ = 0 in complexInv;
-- `hurwitzZetaRegularMap.at_one` records this, and
-- `hurwitzZetaRegularMap.holomorphic` says the result is entire.
defgraph hurwitzZetaRegularMap (a : Real) (s ∈ complexCarrier) :
    complexCarrier := ℂ[hurwitzZeta(s, a) - complexDiv(ℂ[1], ℂ[s - 1])]
proof
  obtain ⟨value, _⟩ := hurwitzZeta.selected at s, a with member
  have shifted : ℂ[s - 1] ∈ ℂ by typecheck
  have inverse := complexInv.member at ℂ[s - 1] with shifted
  unfold complexDiv
  typecheck

-- The terms (n + a)^(−s), n = 0, 1, 2, …, of the Hurwitz series.
defgraph hurwitzSeriesTerms (s : Set, a : Real) (n ∈ ℕ) : complexCarrier :=
    realCpow(R[realNat(n) + a], ℂ[-s])
requires hs : s ∈ complexCarrier
proof
  have typedN := nat.omega.backward with member
  have exponent : ℂ[-s] ∈ ℂ by typecheck
  exact realCpow.member at R[realNat(n) + a], ℂ[-s] with exponent

-- The complex function x ↦ c (x + a)^w of a real variable.
defgraph scaledPower (c : Set, a : Real, w : Set) (X ∈ ℝ) : complexCarrier :=
    ℂ[c * realCpow(R[X + a], w)]
requires hc : c ∈ complexCarrier
requires hw : w ∈ complexCarrier
proof
  have power := realCpow.member at R[X + a], w with hw
  typecheck

-- The entire function s ↦ x^(p + q s) for x > 0.
defgraph affinePower (X : Real, p q : Set) (s ∈ complexCarrier) :
    complexCarrier := realCpow(X, ℂ[p + q * s])
requires hp : p ∈ complexCarrier
requires hq : q ∈ complexCarrier
proof
  have exponent : ℂ[p + q * s] ∈ ℂ by typecheck
  exact realCpow.member at X, ℂ[p + q * s] with exponent

-- The pieces of H_m(s, a) as functions of s on ℂ.
defgraph risingMap (k : Nat) (s ∈ complexCarrier) : complexCarrier :=
    risingFactorial(s, k)
proof
  exact risingFactorial.closed with member

defgraph correctionMap (a : Real, k : Nat) (s ∈ complexCarrier) :
    complexCarrier := hurwitzCorrectionTerms(s, a)(k)
proof
  have kMember : k ∈ ℕ := nat.omega.forward at k with *
  exact FunctionBetween.apply_closed with
    (hurwitzCorrectionTerms.function at s, a with member), kMember

defgraph correctionSumMap (a : Real, m : Nat) (s ∈ complexCarrier) :
    complexCarrier := complexPartialSum(hurwitzCorrectionTerms(s, a), m)
proof
  have terms := hurwitzCorrectionTerms.function at s, a with member
  have sequence : ComplexSequence(hurwitzCorrectionTerms(s, a)) by exact terms
  exact complexPartialSum.member at hurwitzCorrectionTerms(s, a), m with
    sequence

defgraph remainderMap (m : Nat, a : Real) (s ∈ complexCarrier) :
    complexCarrier := hurwitzRemainder(m, s, a)
proof
  exact hurwitzRemainder.closed with member

defgraph eulerMaclaurinMap (m : Nat, a : Real) (s ∈ complexCarrier) :
    complexCarrier := hurwitzEulerMaclaurin(m, s, a)
proof
  exact hurwitzEulerMaclaurin.closed with member

-- The power series (e^(κ u) − 1)/u = Σ κ^(n+1) uⁿ/(n + 1)!.
defgraph regularCoefficients (κ : Set) (n ∈ ℕ) : complexCarrier :=
    expTerms(κ)(succ(n))
requires hκ : κ ∈ complexCarrier
proof
  have next : succ(n) ∈ ℕ by typecheck
  exact FunctionBetween.apply_closed with (expTerms.function with hκ), next

-- The even-indexed terms C(n, 2k + 2) B_{2k+2} x^(n−2k−2) of Bₙ(x).
defgraph evenBernoulliTerms (n : Nat, x : Real) (k ∈ ℕ) : ℝ :=
    bernoulliPolynomialTerms(n, x)(2 * k + 2)
proof
  have kNat := nat.omega.backward with member
  have index : 2 * k + 2 ∈ ℕ by typecheck
  exact FunctionBetween.apply_closed with
    (bernoulliPolynomialTerms.function at n, x), index

-- Section: Rising factorials
theorem risingFactorial.zero (s : Set)
  shows risingFactorial(s, 0) = ℂ[1]
proof
  rw risingFactorial
  rfl

theorem risingFactorial.succ (s : Set) (j : Nat)
  shows risingFactorial(s, succ(j)) =
    ℂ[risingFactorial(s, j) * (s + complexOfReal(realNat(j)))]
proof
  rw risingFactorial
  rfl

theorem risingFactorial.member (s : Set) (j : Nat)
  requires hs : s ∈ ℂ
  shows risingFactorial(s, j) ∈ ℂ
proof
  exact risingFactorial.closed with hs

-- 1·2⋯j = j!.
theorem risingFactorial.one (j : Nat)
  shows risingFactorial(ℂ[1], j) = complexOfReal(realNat(j!))
proof
  induction j
  | zero =>
    rw [risingFactorial.zero, factorial, realNat.one, complexOfReal.one]
  | succ(k) using ih =>
    have one : k + 1 = succ(k) := add.right_one with *
    have step := realNat.factorial_succ at k
    rw one at step
    rw [risingFactorial.succ, ih, step, complexOfReal.mul, complexOfReal.add,
      complexOfReal.one]
    have kMember : complexOfReal(realNat(k)) ∈ ℂ by typecheck
    have factorialMember : complexOfReal(realNat(k!)) ∈ ℂ by typecheck
    ring

-- The rising factorial at −n vanishes from j = n + 1 on.
theorem risingFactorial.neg_nat (n j : Nat)
  requires large : n < j
  shows risingFactorial(ℂ[-complexOfReal(realNat(n))], j) = ℂ[0]
proof
  have nMember : complexOfReal(realNat(n)) ∈ ℂ by typecheck
  have closed := risingFactorial.closed at ℂ[-complexOfReal(realNat(n))]
  induction j
  | zero =>
    intro below
    exfalso
    arith
  | succ(k) using ih =>
    intro bound
    have kMember : complexOfReal(realNat(k)) ∈ ℂ by typecheck
    have previous := closed at k with *
    rw risingFactorial.succ
    by_cases below : n < k
    . rw ih with below
      ring
    . have same : n = k by arith
      rw same
      ring

-- Section: The remainder integral
-- The inverse commutes with the embedding of ℝ.
theorem complexOfReal.inv (X : Real)
  requires nonzero : X ≠ R[0]
  shows complexOfReal(realInvValue(X)) = complexInv(complexOfReal(X))
proof
  have inverseReal := realInvValue.real at X
  have one : R[1 * realInvValue(X)] = realInvValue(X) by ring
  rw [(complexInv.of_real with nonzero), realDiv.eq_mul_inv, one]

-- ℂ[2] is the real 2, and 1/2 its inverse.
theorem complexOfReal.two
  shows complexOfReal(R[2]) = ℂ[2]
proof
  have expand : R[2] = R[1 + 1] by ring
  rw [expand, complexOfReal.add, complexOfReal.one]
  ring

theorem complexOfReal.half
  shows complexOfReal(R[1 / 2]) = complexInv(ℂ[2])
proof
  have twoNonzero : R[2] ≠ R[0] by linarith
  rw [← complexOfReal.two, (complexInv.of_real with twoNonzero)]

theorem complexOfReal.mem (X : Real)
  shows complexOfReal(X) ∈ ℂ
proof
  typecheck

theorem complexAbs.real (z : Set)
  requires hz : z ∈ ℂ
  shows Real(complexAbs(z))
proof
  exact FunctionBetween.apply_closed with complexAbs.function, hz

theorem bernoulliBound.real (n : Nat)
  shows Real(bernoulliBound(n))
proof
  have bounds := bernoulliBoundTerms.function at n
  have boundSequence : RealSequence(bernoulliBoundTerms(n)) by exact bounds
  have total := realPartialSum.real at bernoulliBoundTerms(n), succ(n)
    with boundSequence
  unfold bernoulliBound
  typecheck

-- The real part of the exponent −s − X.
theorem complexRe.neg_sub_real (s : Set) (X : Real)
  requires hs : s ∈ ℂ
  shows complexRe(ℂ[-s - complexOfReal(X)]) = R[-complexRe(s) - X]
proof
  have negative : ℂ[-s] ∈ ℂ by typecheck
  have xMember : complexOfReal(X) ∈ ℂ by typecheck
  rw [(complexRe.sub with negative, xMember), (complexRe.neg with hs),
    complexOfReal.re]

-- |P̃ₙ(x)(x + a)^(−s−n)| ≤ C (x + a)^(−re s − n) for x ≥ 0.
theorem hurwitzIntegrand.abs_le (n : Nat) (a X : Real) (s : Set)
  requires positive : R[0] < a
  requires hs : s ∈ ℂ
  requires nonnegative : R[0] ≤ X
  shows complexAbs(hurwitzIntegrand(n, a, s)(X)) ≤
    R[bernoulliBound(n) * realRpow(R[X + a], R[-complexRe(s) - realNat(n)])]
proof
  have shifted : R[0] < R[X + a] by linarith
  have exponent : ℂ[-s - complexOfReal(realNat(n))] ∈ ℂ by typecheck
  have power := realCpow.member at R[X + a],
    ℂ[-s - complexOfReal(realNat(n))] with exponent
  have function := periodicBernoulli.function at n
  have xMember : X ∈ ℝ by typecheck
  have value := FunctionBetween.apply_closed with function, xMember
  have valueReal : Real(periodicBernoulli(n)(X)) by exact value
  have scalar : complexOfReal(periodicBernoulli(n)(X)) ∈ ℂ by typecheck
  rw [(hurwitzIntegrand.value at n, a, s, X with hs),
    (complexAbs.mul with scalar, power), complexAbs.of_real,
    (realCpow.abs with shifted, exponent), (complexRe.neg_sub_real with hs)]
  have bound := periodicBernoulli.bound at n, X
  have boundReal := bernoulliBound.real at n
  have positivePower := realRpow.positive at R[X + a],
    R[-complexRe(s) - realNat(n)]
  have powerNonnegative :
    R[0] ≤ realRpow(R[X + a], R[-complexRe(s) - realNat(n)]) by linarith
  exact realLe.mul_right_of_nonnegative with bound, powerNonnegative

-- A complex function g of a real variable whose increments are D h up to
-- K h² near X: its real and imaginary parts have derivatives re D, im D.
theorem complexFunction.derivative_parts (g D : Set) (X K W : Real)
  requires values : ComplexValuedOn(g, ℝ)
  requires hD : D ∈ ℂ
  requires positive : R[0] < K
  requires radius : R[0] < W
  requires bound : ∀ H ∈ ℝ, H ≠ R[0] → abs(H) < W →
    complexAbs(ℂ[g(R[X + H]) - g(X) - D * complexOfReal(H)]) ≤
      R[K * (H * H)]
  shows HasDerivativeAt(complexFunctionRe(g), complexRe(D), X) ∧
    HasDerivativeAt(complexFunctionIm(g), complexIm(D), X)
proof
  have functionRe := complexFunctionRe.function with values
  have functionIm := complexFunctionIm.function with values
  have xMember : X ∈ ℝ by typecheck
  have gX := values with X, xMember
  have reD := complexRe.real with hD
  have imD := complexIm.real with hD
  have reX := complexRe.real with gX
  have imX := complexIm.real with gX
  constructor
  . apply HasDerivativeAt.of_quadratic_bound with functionRe, positive, radius
    intros H hMember nonzero small
    have shifted : R[X + H] ∈ ℝ by typecheck
    have gShift := values with R[X + H], shifted
    have reShift := complexRe.real with gShift
    have hComplex : complexOfReal(H) ∈ ℂ by typecheck
    have product : ℂ[D * complexOfReal(H)] ∈ ℂ by typecheck
    have first : ℂ[g(R[X + H]) - g(X)] ∈ ℂ by typecheck
    have error : ℂ[g(R[X + H]) - g(X) - D * complexOfReal(H)] ∈ ℂ
      by typecheck
    have reError := complexAbs.re_le with error
    rw [(complexRe.sub with first, product), (complexRe.sub with gShift, gX),
      (complexRe.mul with hD, hComplex), complexOfReal.re,
      complexOfReal.im] at reError
    have shape : R[complexRe(g(R[X + H])) - complexRe(g(X)) -
        (complexRe(D) * H - complexIm(D) * 0)] =
      R[complexRe(g(R[X + H])) - complexRe(g(X)) - complexRe(D) * H] by ring
    rw shape at reError
    rw [(complexFunctionRe.apply at g, R[X + H] with values),
      (complexFunctionRe.apply at g, X with values)]
    have estimate := bound with H, hMember, nonzero, small
    linarith
  . apply HasDerivativeAt.of_quadratic_bound with functionIm, positive, radius
    intros H hMember nonzero small
    have shifted : R[X + H] ∈ ℝ by typecheck
    have gShift := values with R[X + H], shifted
    have imShift := complexIm.real with gShift
    have hComplex : complexOfReal(H) ∈ ℂ by typecheck
    have product : ℂ[D * complexOfReal(H)] ∈ ℂ by typecheck
    have first : ℂ[g(R[X + H]) - g(X)] ∈ ℂ by typecheck
    have error : ℂ[g(R[X + H]) - g(X) - D * complexOfReal(H)] ∈ ℂ
      by typecheck
    have imError := complexAbs.im_le with error
    rw [(complexIm.sub with first, product), (complexIm.sub with gShift, gX),
      (complexIm.mul with hD, hComplex), complexOfReal.re,
      complexOfReal.im] at imError
    have shape : R[complexIm(g(R[X + H])) - complexIm(g(X)) -
        (complexRe(D) * 0 + complexIm(D) * H)] =
      R[complexIm(g(R[X + H])) - complexIm(g(X)) - complexIm(D) * H] by ring
    rw shape at imError
    rw [(complexFunctionIm.apply at g, R[X + H] with values),
      (complexFunctionIm.apply at g, X with values)]
    have estimate := bound with H, hMember, nonzero, small
    linarith

-- The increments of y ↦ y^w at Y > 0: Y^w (w h / Y) up to a multiple of
-- h², for |h| small against Y and |w|.
theorem realCpow.linear_error (Y H : Real) (w : Set)
  requires positive : R[0] < Y
  requires hw : w ∈ ℂ
  requires small : R[2 * (complexAbs(w) + 1) * abs(H)] < Y
  shows complexAbs(ℂ[realCpow(R[Y + H], w) - realCpow(Y, w) -
      w * realCpow(Y, w) * complexOfReal(R[H * (1 / Y)])]) ≤
    R[realRpow(Y, complexRe(w)) *
      (4 * (complexAbs(w) * complexAbs(w)) + 2 * complexAbs(w)) *
      ((1 / Y) * (1 / Y)) * (H * H)]
proof
  have wAbs := complexAbs.nonnegative with hw
  have hAbs := abs.nonnegative at H
  have yNonzero : Y ≠ R[0] by linarith
  have inverse := realDiv.mul_right at R[1], Y with yNonzero
  have inverseReal : Real(R[1 / Y]) by typecheck
  have yInverse : R[Y * (1 / Y)] = R[1] by linear_combination inverse
  have inversePositive : R[0] < R[1 / Y]
    by_contra notPositive
    have nonpositive : R[1 / Y] ≤ R[0] by linarith
    have scaled := realLe.mul_right_of_nonnegative with nonpositive,
      (realLess.implies_le with positive)
    have zero : R[0 * Y] = R[0] by ring
    linarith
  have inverseNonnegative : R[0] ≤ R[1 / Y] by linarith
  have crossNonnegative := realLe.mul_left_of_nonnegative with hAbs, wAbs
  have zeroCross : R[complexAbs(w) * 0] = R[0] by ring
  have expandSmall : R[2 * (complexAbs(w) + 1) * abs(H)] =
    R[2 * (complexAbs(w) * abs(H)) + 2 * abs(H)] by ring
  have halfSmall : abs(H) < R[Y / 2] by linarith
  have logBound := realLog.derivative_bound with positive, halfSmall
  -- |ℓ| ≤ 2 |h| / Y for ℓ = log(Y + h) − log Y.
  have absProduct := abs.mul at R[1 / Y], H
  have absInverse := abs.of_nonnegative with inverseNonnegative
  have scaledSmall : R[2 * abs(H) * (1 / Y)] ≤ R[1]
    have bound : R[2 * abs(H)] ≤ Y by linarith
    have scaled := realLe.mul_right_of_nonnegative with bound,
      inverseNonnegative
    linarith
  have unitNonnegative := realMulValue.nonnegative with hAbs, inverseNonnegative
  have quadratic := realLe.mul_left_of_nonnegative with scaledSmall,
    unitNonnegative
  have squareH := abs.mul at H, H
  have squareNonnegative := realMulValue.square_nonnegative at H
  have squareAbs := abs.of_nonnegative with squareNonnegative
  have triangle := abs.triangle at
    R[realLog(R[Y + H]) - realLog(Y) - 1 / Y * H], R[1 / Y * H]
  have logShape : R[realLog(R[Y + H]) - realLog(Y) - 1 / Y * H + 1 / Y * H] =
    R[realLog(R[Y + H]) - realLog(Y)] by ring
  rw logShape at triangle
  have hSquare : R[H * H] = R[abs(H) * abs(H)] by rw [← squareAbs, squareH]
  have quadraticShape : R[2 * (1 / Y) * (1 / Y) * (H * H)] =
      R[(abs(H) * (1 / Y)) * (2 * abs(H) * (1 / Y))]
    rw hSquare
    ring
  have unitShape : R[(abs(H) * (1 / Y)) * 1] = R[abs(H) * (1 / Y)] by ring
  have linearShape : abs(R[1 / Y * H]) = R[abs(H) * (1 / Y)]
    rw [absProduct, absInverse]
    ring
  have logSmall : abs(R[realLog(R[Y + H]) - realLog(Y)]) ≤
      R[2 * (abs(H) * (1 / Y))]
    linarith
  -- The exponential error.
  have logY : complexOfReal(realLog(Y)) ∈ ℂ by typecheck
  have logYH : complexOfReal(realLog(R[Y + H])) ∈ ℂ by typecheck
  have difference : ℂ[complexOfReal(realLog(R[Y + H])) -
      complexOfReal(realLog(Y))] =
      complexOfReal(R[realLog(R[Y + H]) - realLog(Y)])
    rw [complexOfReal.add, complexOfReal.neg]
  have absDifference : complexAbs(ℂ[complexOfReal(realLog(R[Y + H])) -
      complexOfReal(realLog(Y))]) = abs(R[realLog(R[Y + H]) - realLog(Y)])
    rw [difference, complexAbs.of_real]
  have logNonnegative := abs.nonnegative at R[realLog(R[Y + H]) - realLog(Y)]
  have scaledLog := realLe.mul_left_of_nonnegative with logSmall, wAbs
  have expSmall : R[complexAbs(w) * complexAbs(ℂ[complexOfReal(realLog(R[Y + H]))
      - complexOfReal(realLog(Y))])] ≤ R[1]
    rw absDifference
    have shape : R[2 * complexAbs(w) * abs(H)] =
      R[2 * (complexAbs(w) * abs(H))] by ring
    have bound : R[2 * complexAbs(w) * abs(H)] ≤ Y by linarith
    have scaled := realLe.mul_right_of_nonnegative with bound,
      inverseNonnegative
    have scaledShape : R[complexAbs(w) * (2 * (abs(H) * (1 / Y)))] =
      R[2 * complexAbs(w) * abs(H) * (1 / Y)] by ring
    linarith
  have expError := complexExp.linear_error with hw, logY, logYH, expSmall
  rw absDifference at expError
  have product : ℂ[w * complexOfReal(realLog(Y))] ∈ ℂ by typecheck
  have expMember := complexExp.member with product
  have exponentAbs := realCpow.abs with positive, hw
  unfold realCpow at exponentAbs
  rw exponentAbs at expError
  -- The logarithm error, scaled by w Y^w.
  have power := realCpow.abs with positive, hw
  have powerPositive := realRpow.positive at Y, complexRe(w)
  have logError : ℂ[complexOfReal(R[realLog(R[Y + H]) - realLog(Y)]) -
      complexOfReal(R[H * (1 / Y)])] =
      complexOfReal(R[realLog(R[Y + H]) - realLog(Y) - 1 / Y * H])
    have shape : R[realLog(R[Y + H]) - realLog(Y) - 1 / Y * H] =
      R[realLog(R[Y + H]) - realLog(Y) + -(H * (1 / Y))] by ring
    have sum := complexOfReal.add at R[realLog(R[Y + H]) - realLog(Y)],
      R[-(H * (1 / Y))]
    have negative := complexOfReal.neg at R[H * (1 / Y)]
    rw [shape, sum, negative]
    have first : complexOfReal(R[realLog(R[Y + H]) - realLog(Y)]) ∈ ℂ
      by typecheck
    have second : complexOfReal(R[H * (1 / Y)]) ∈ ℂ by typecheck
    ring
  have powerMember := realCpow.member at Y, w with hw
  have scale : ℂ[w * realCpow(Y, w)] ∈ ℂ by typecheck
  have errorMember : complexOfReal(R[realLog(R[Y + H]) - realLog(Y) -
    1 / Y * H]) ∈ ℂ by typecheck
  have second := complexAbs.mul with scale, errorMember
  rw [(complexAbs.mul with hw, powerMember), power, complexAbs.of_real]
    at second
  -- The target is the sum of the two errors.
  have expErrorMember : ℂ[complexExp(w * complexOfReal(realLog(R[Y + H]))) -
      complexExp(w * complexOfReal(realLog(Y))) -
      w * complexExp(w * complexOfReal(realLog(Y))) *
      (complexOfReal(realLog(R[Y + H])) - complexOfReal(realLog(Y)))] ∈ ℂ
    have other : ℂ[w * complexOfReal(realLog(R[Y + H]))] ∈ ℂ by typecheck
    have otherMember := complexExp.member with other
    typecheck
  have secondMember : ℂ[w * realCpow(Y, w) *
    complexOfReal(R[realLog(R[Y + H]) - realLog(Y) - 1 / Y * H])] ∈ ℂ
    by typecheck
  have hScaled : complexOfReal(R[H * (1 / Y)]) ∈ ℂ by typecheck
  have split : ℂ[realCpow(R[Y + H], w) - realCpow(Y, w) -
      w * realCpow(Y, w) * complexOfReal(R[H * (1 / Y)])] =
      ℂ[(complexExp(w * complexOfReal(realLog(R[Y + H]))) -
        complexExp(w * complexOfReal(realLog(Y))) -
        w * complexExp(w * complexOfReal(realLog(Y))) *
        (complexOfReal(realLog(R[Y + H])) - complexOfReal(realLog(Y)))) +
      w * realCpow(Y, w) *
        complexOfReal(R[realLog(R[Y + H]) - realLog(Y) - 1 / Y * H])]
    rw [← logError, ← difference]
    unfold realCpow
    have other : ℂ[w * complexOfReal(realLog(R[Y + H]))] ∈ ℂ by typecheck
    have otherMember := complexExp.member with other
    ring
  rw split
  have total := complexAbs.triangle with expErrorMember, secondMember
  -- Bounding the two pieces.
  have scaledLogNonnegative := realMulValue.nonnegative with wAbs,
    logNonnegative
  have twoUnit : R[0] ≤ R[2 * (abs(H) * (1 / Y))] by linarith
  have boundNonnegative := realMulValue.nonnegative with wAbs, twoUnit
  have squareStep := realLe.mul_left_of_nonnegative with scaledLog,
    scaledLogNonnegative
  have squareStep2 := realLe.mul_right_of_nonnegative with scaledLog,
    boundNonnegative
  have powerNonnegative : R[0] ≤ realRpow(Y, complexRe(w)) by linarith
  have squareBound : R[(complexAbs(w) *
      abs(R[realLog(R[Y + H]) - realLog(Y)])) *
      (complexAbs(w) * abs(R[realLog(R[Y + H]) - realLog(Y)]))] ≤
    R[(complexAbs(w) * (2 * (abs(H) * (1 / Y)))) *
      (complexAbs(w) * (2 * (abs(H) * (1 / Y))))] by linarith
  have firstBound := realLe.mul_left_of_nonnegative with squareBound,
    powerNonnegative
  have weight := realMulValue.nonnegative with wAbs, powerNonnegative
  have secondBound := realLe.mul_left_of_nonnegative with logBound, weight
  have firstShape : R[realRpow(Y, complexRe(w)) *
      ((complexAbs(w) * (2 * (abs(H) * (1 / Y)))) *
      (complexAbs(w) * (2 * (abs(H) * (1 / Y)))))] =
    R[realRpow(Y, complexRe(w)) * (4 * (complexAbs(w) * complexAbs(w))) *
      ((1 / Y) * (1 / Y)) * (H * H)]
    rw hSquare
    ring
  have secondShape : R[complexAbs(w) * realRpow(Y, complexRe(w)) *
      (2 * (1 / Y) * (1 / Y) * (H * H))] =
    R[realRpow(Y, complexRe(w)) * (2 * complexAbs(w)) *
      ((1 / Y) * (1 / Y)) * (H * H)] by ring
  have totalShape : R[realRpow(Y, complexRe(w)) *
      (4 * (complexAbs(w) * complexAbs(w)) + 2 * complexAbs(w)) *
      ((1 / Y) * (1 / Y)) * (H * H)] =
    R[realRpow(Y, complexRe(w)) * (4 * (complexAbs(w) * complexAbs(w))) *
      ((1 / Y) * (1 / Y)) * (H * H) +
      realRpow(Y, complexRe(w)) * (2 * complexAbs(w)) *
      ((1 / Y) * (1 / Y)) * (H * H)] by ring
  linarith

-- y^(w − 1) = y^w / y.
theorem realCpow.sub_one (Y : Real) (w : Set)
  requires positive : R[0] < Y
  requires hw : w ∈ ℂ
  shows realCpow(Y, ℂ[w - 1]) = ℂ[realCpow(Y, w) * complexOfReal(R[1 / Y])]
proof
  have one : ℂ[-1] = complexOfReal(R[-1])
    rw [complexOfReal.neg, complexOfReal.one]
  have minusOne : ℂ[-1] ∈ ℂ by typecheck
  rw [(realCpow.add with hw, minusOne), one, realCpow.of_real,
    (realRpow.neg with positive), (realRpow.one with positive)]

-- d/dx c (x + a)^w = c w (x + a)^(w − 1), in the real and imaginary parts.
theorem scaledPower.has_derivative (c : Set) (a X : Real) (w : Set)
  requires hc : c ∈ ℂ
  requires hw : w ∈ ℂ
  requires positive : R[0] < R[X + a]
  shows HasDerivativeAt(complexFunctionRe(scaledPower(c, a, w)),
      complexRe(ℂ[c * w * realCpow(R[X + a], ℂ[w - 1])]), X) ∧
    HasDerivativeAt(complexFunctionIm(scaledPower(c, a, w)),
      complexIm(ℂ[c * w * realCpow(R[X + a], ℂ[w - 1])]), X)
proof
  have function := scaledPower.function at c, a, w with hc, hw
  have values : ComplexValuedOn(scaledPower(c, a, w), ℝ)
    intros Y yMember
    exact FunctionBetween.apply_closed with function, yMember
  have shiftedOne : ℂ[w - 1] ∈ ℂ by typecheck
  have powerShifted := realCpow.member at R[X + a], ℂ[w - 1] with shiftedOne
  have hD : ℂ[c * w * realCpow(R[X + a], ℂ[w - 1])] ∈ ℂ by typecheck
  have cAbs := complexAbs.nonnegative with hc
  have wAbs := complexAbs.nonnegative with hw
  have cAbsReal := complexAbs.real with hc
  have wAbsReal := complexAbs.real with hw
  have powerPositive := realRpow.positive at R[X + a], complexRe(w)
  have yNonzero : R[X + a] ≠ R[0] by linarith
  have inverse := realDiv.mul_right at R[1], R[X + a] with yNonzero
  have inverseReal : Real(R[1 / (X + a)]) by typecheck
  have constant : R[0] ≤ R[complexAbs(c) * (realRpow(R[X + a], complexRe(w)) *
      (4 * (complexAbs(w) * complexAbs(w)) + 2 * complexAbs(w)) *
      ((1 / (X + a)) * (1 / (X + a))))]
    have squareW := realMulValue.nonnegative with wAbs, wAbs
    have weight : R[0] ≤ R[4 * (complexAbs(w) * complexAbs(w)) +
      2 * complexAbs(w)] by linarith
    have inverseSquare := realMulValue.square_nonnegative at R[1 / (X + a)]
    have first := realMulValue.nonnegative with
      (realLess.implies_le with powerPositive), weight
    have second := realMulValue.nonnegative with first, inverseSquare
    exact realMulValue.nonnegative with cAbs, second
  have kReal : Real(R[complexAbs(c) * (realRpow(R[X + a],
      complexRe(w)) * (4 * (complexAbs(w) * complexAbs(w)) +
      2 * complexAbs(w)) * ((1 / (X + a)) * (1 / (X + a))))]) by typecheck
  have kPositive : R[0] < R[complexAbs(c) * (realRpow(R[X + a],
      complexRe(w)) * (4 * (complexAbs(w) * complexAbs(w)) +
      2 * complexAbs(w)) * ((1 / (X + a)) * (1 / (X + a)))) + 1] by linarith
  have scalePositive : R[0] < R[2 * (complexAbs(w) + 1)] by linarith
  have scaleNonzero : R[2 * (complexAbs(w) + 1)] ≠ R[0] by linarith
  have scaleInverse := realDiv.mul_right at R[1], R[2 * (complexAbs(w) + 1)]
    with scaleNonzero
  have scaleInverseReal : Real(R[1 / (2 * (complexAbs(w) + 1))]) by typecheck
  have scaleInversePositive : R[0] < R[1 / (2 * (complexAbs(w) + 1))]
    by_contra notPositive
    have nonpositive : R[1 / (2 * (complexAbs(w) + 1))] ≤ R[0] by linarith
    have scaled := realLe.mul_right_of_nonnegative with nonpositive,
      (realLess.implies_le with scalePositive)
    have zero : R[0 * (2 * (complexAbs(w) + 1))] = R[0] by ring
    linarith
  have radius := realMulValue.positive with positive, scaleInversePositive
  apply complexFunction.derivative_parts with values, hD, kPositive, radius
  intros H hMember nonzero small
  have hReal : Real(H) by exact hMember
  have shiftedPoint : R[X + H] ∈ ℝ by typecheck
  have xMember : X ∈ ℝ by typecheck
  have smallScaled := realLess.mul_left_of_positive with small, scalePositive
  have cancel : R[2 * (complexAbs(w) + 1) * ((X + a) *
      (1 / (2 * (complexAbs(w) + 1))))] = R[X + a]
    linear_combination (X + a) * scaleInverse
  have smallH : R[2 * (complexAbs(w) + 1) * abs(H)] < R[X + a] by linarith
  have error := realCpow.linear_error with positive, hw, smallH
  have pointShift : R[R[X + H] + a] = R[R[X + a] + H] by ring
  rw [(scaledPower.value at c, a, w, R[X + H] with hc, hw),
    (scaledPower.value at c, a, w, X with hc, hw), pointShift,
    (realCpow.sub_one with positive, hw)]
  have powerMember := realCpow.member at R[X + a], w with hw
  have powerHMember := realCpow.member at R[R[X + a] + H], w with hw
  have hComplex : complexOfReal(H) ∈ ℂ by typecheck
  have unitComplex : complexOfReal(R[1 / (X + a)]) ∈ ℂ by typecheck
  have errorMember : ℂ[realCpow(R[X + a + H], w) - realCpow(R[X + a], w) -
      w * realCpow(R[X + a], w) * complexOfReal(R[H * (1 / (X + a))])] ∈ ℂ
    by typecheck
  have factor : ℂ[c * realCpow(R[X + a + H], w) -
      c * realCpow(R[X + a], w) -
      c * w * (realCpow(R[X + a], w) * complexOfReal(R[1 / (X + a)])) *
      complexOfReal(H)] =
      ℂ[c * (realCpow(R[X + a + H], w) - realCpow(R[X + a], w) -
      w * realCpow(R[X + a], w) * complexOfReal(R[H * (1 / (X + a))]))]
    rw complexOfReal.mul
    ring
  rw [factor, (complexAbs.mul with hc, errorMember)]
  have scaled := realLe.mul_left_of_nonnegative with error, cAbs
  have squareNonnegative := realMulValue.square_nonnegative at H
  have shape : R[(complexAbs(c) * (realRpow(R[X + a], complexRe(w)) *
      (4 * (complexAbs(w) * complexAbs(w)) + 2 * complexAbs(w)) *
      ((1 / (X + a)) * (1 / (X + a)))) + 1) * (H * H)] =
    R[complexAbs(c) * (realRpow(R[X + a], complexRe(w)) *
      (4 * (complexAbs(w) * complexAbs(w)) + 2 * complexAbs(w)) *
      ((1 / (X + a)) * (1 / (X + a))) * (H * H)) + H * H] by ring
  linarith

-- So the parts of c (x + a)^w are continuous on [A, B] when A + a > 0.
theorem scaledPower.continuous_parts (c : Set) (a A B : Real) (w : Set)
  requires hc : c ∈ ℂ
  requires hw : w ∈ ℂ
  requires positive : R[0] < R[A + a]
  shows ContinuousOn(complexFunctionRe(scaledPower(c, a, w)),
      closedInterval(A, B)) ∧
    ContinuousOn(complexFunctionIm(scaledPower(c, a, w)),
      closedInterval(A, B))
proof
  have function := scaledPower.function at c, a, w with hc, hw
  have values : ComplexValuedOn(scaledPower(c, a, w), ℝ)
    intros Y yMember
    exact FunctionBetween.apply_closed with function, yMember
  have functionRe := complexFunctionRe.function with values
  have functionIm := complexFunctionIm.function with values
  have subset := closedInterval.subset_reals at A, B
  constructor
  . apply ContinuousOn.of_differentiable with functionRe, subset
    intros X xMember
    obtain ⟨xReal, lower, _⟩ := closedInterval.membership.forward with xMember
    have xTyped : Real(X) by exact xReal
    have shifted : R[0] < R[X + a] by linarith
    obtain ⟨derivativeRe, _⟩ := scaledPower.has_derivative at c, a, X, w
      with hc, hw, shifted
    exact HasDerivativeAt.differentiable_at with derivativeRe
  . apply ContinuousOn.of_differentiable with functionIm, subset
    intros X xMember
    obtain ⟨xReal, lower, _⟩ := closedInterval.membership.forward with xMember
    have xTyped : Real(X) by exact xReal
    have shifted : R[0] < R[X + a] by linarith
    obtain ⟨_, derivativeIm⟩ := scaledPower.has_derivative at c, a, X, w
      with hc, hw, shifted
    exact HasDerivativeAt.differentiable_at with derivativeIm

-- ∫_A^B c (x + a)^w dx = c (x + a)^(w+1)/(w + 1) |_A^B for w ≠ −1.
theorem scaledPower.integral (c : Set) (a A B : Real) (w : Set)
  requires hc : c ∈ ℂ
  requires hw : w ∈ ℂ
  requires notMinusOne : ℂ[w + 1] ≠ ℂ[0]
  requires positive : R[0] < R[A + a]
  requires ordered : A ≤ B
  shows ComplexRiemannIntegrable(scaledPower(c, a, w), A, B) ∧
    complexIntegral(scaledPower(c, a, w), A, B) =
      ℂ[scaledPower(ℂ[c * complexInv(w + 1)], a, ℂ[w + 1])(B) -
        scaledPower(ℂ[c * complexInv(w + 1)], a, ℂ[w + 1])(A)]
proof
  have raised : ℂ[w + 1] ∈ ℂ by typecheck
  have inverse := complexInv.member with raised
  have scale : ℂ[c * complexInv(w + 1)] ∈ ℂ by typecheck
  have function := scaledPower.function at c, a, w with hc, hw
  have values : ComplexValuedOn(scaledPower(c, a, w), ℝ)
    intros Y yMember
    exact FunctionBetween.apply_closed with function, yMember
  have primitive := scaledPower.function at ℂ[c * complexInv(w + 1)], a,
    ℂ[w + 1] with scale, raised
  have primitiveValues : ComplexValuedOn(scaledPower(ℂ[c * complexInv(w + 1)],
      a, ℂ[w + 1]), ℝ)
    intros Y yMember
    exact FunctionBetween.apply_closed with primitive, yMember
  obtain ⟨continuousRe, continuousIm⟩ := scaledPower.continuous_parts at
    c, a, A, B, w with hc, hw, positive
  obtain ⟨primitiveRe, primitiveIm⟩ := scaledPower.continuous_parts at
    ℂ[c * complexInv(w + 1)], a, A, B, ℂ[w + 1] with scale, raised, positive
  have integrableRe := ContinuousOn.integrable_interval with ordered,
    continuousRe
  have integrableIm := ContinuousOn.integrable_interval with ordered,
    continuousIm
  have cancel := complexInv.mul_cancel with raised, notMinusOne
  have derivativeValue : ∀ X ∈ ℝ, R[0] < R[X + a] →
      ℂ[ℂ[c * complexInv(w + 1)] * ℂ[w + 1] *
        realCpow(R[X + a], ℂ[ℂ[w + 1] - 1])] = scaledPower(c, a, w)(X)
    intros X xMember shifted
    have xReal : Real(X) by exact xMember
    have back : ℂ[ℂ[w + 1] - 1] = w by ring
    have powerMember := realCpow.member at R[X + a], w with hw
    rw [back, (scaledPower.value at c, a, w, X with hc, hw)]
    have shape : ℂ[c * complexInv(w + 1) * (w + 1) * realCpow(R[X + a], w)] =
      ℂ[c * ((w + 1) * complexInv(w + 1)) * realCpow(R[X + a], w)] by ring
    rw [shape, cancel]
    ring
  have derivatives : ∀ X ∈ ℝ, A < X → X < B →
      HasDerivativeAt(complexFunctionRe(scaledPower(ℂ[c * complexInv(w + 1)],
        a, ℂ[w + 1])), complexFunctionRe(scaledPower(c, a, w))(X), X) ∧
      HasDerivativeAt(complexFunctionIm(scaledPower(ℂ[c * complexInv(w + 1)],
        a, ℂ[w + 1])), complexFunctionIm(scaledPower(c, a, w))(X), X)
    intros X xMember lower upper
    have xReal : Real(X) by exact xMember
    have shifted : R[0] < R[X + a] by linarith
    obtain ⟨derivativeRe, derivativeIm⟩ := scaledPower.has_derivative at
      ℂ[c * complexInv(w + 1)], a, X, ℂ[w + 1] with scale, raised, shifted
    rw [(derivativeValue with X, xMember, shifted)] at derivativeRe
    rw [(derivativeValue with X, xMember, shifted)] at derivativeIm
    rw [(complexFunctionRe.apply at scaledPower(c, a, w), X with values),
      (complexFunctionIm.apply at scaledPower(c, a, w), X with values)]
    exact ⟨derivativeRe, derivativeIm⟩
  have derivativesRe : ∀ X ∈ ℝ, A < X → X < B →
      HasDerivativeAt(complexFunctionRe(scaledPower(ℂ[c * complexInv(w + 1)],
        a, ℂ[w + 1])), complexFunctionRe(scaledPower(c, a, w))(X), X)
    intros X xMember lower upper
    obtain ⟨derivativeRe, _⟩ := derivatives with X, xMember, lower, upper
    exact derivativeRe
  have derivativesIm : ∀ X ∈ ℝ, A < X → X < B →
      HasDerivativeAt(complexFunctionIm(scaledPower(ℂ[c * complexInv(w + 1)],
        a, ℂ[w + 1])), complexFunctionIm(scaledPower(c, a, w))(X), X)
    intros X xMember lower upper
    obtain ⟨_, derivativeIm⟩ := derivatives with X, xMember, lower, upper
    exact derivativeIm
  have valueRe := HasRiemannIntegral.eq_endpoint_of_local_derivative with
    primitiveRe, derivativesRe, (riemannIntegral.integral with integrableRe)
  have valueIm := HasRiemannIntegral.eq_endpoint_of_local_derivative with
    primitiveIm, derivativesIm, (riemannIntegral.integral with integrableIm)
  refine ⟨⟨values, integrableRe, integrableIm⟩, ?_⟩
  have aMember : A ∈ ℝ by typecheck
  have bMember : B ∈ ℝ by typecheck
  have atA := primitiveValues with A, aMember
  have atB := primitiveValues with B, bMember
  have integralMember := complexIntegral.member at scaledPower(c, a, w), A, B
  have differenceMember : ℂ[scaledPower(ℂ[c * complexInv(w + 1)], a,
    ℂ[w + 1])(B) - scaledPower(ℂ[c * complexInv(w + 1)], a, ℂ[w + 1])(A)]
    ∈ ℂ by typecheck
  apply complex.eq_of_parts with integralMember, differenceMember
  . rw [complexIntegral.re, valueRe, (complexRe.sub with atB, atA),
      (complexFunctionRe.apply at scaledPower(ℂ[c * complexInv(w + 1)], a,
        ℂ[w + 1]), B with primitiveValues),
      (complexFunctionRe.apply at scaledPower(ℂ[c * complexInv(w + 1)], a,
        ℂ[w + 1]), A with primitiveValues)]
    unfold realSubValue
    rfl
  . rw [complexIntegral.im, valueIm, (complexIm.sub with atB, atA),
      (complexFunctionIm.apply at scaledPower(ℂ[c * complexInv(w + 1)], a,
        ℂ[w + 1]), B with primitiveValues),
      (complexFunctionIm.apply at scaledPower(ℂ[c * complexInv(w + 1)], a,
        ℂ[w + 1]), A with primitiveValues)]
    unfold realSubValue
    rfl

-- For K ≥ 0 and E > 0 some D > 0 has K D < E.
theorem real.small_multiple (K E : Real)
  requires nonnegative : R[0] ≤ K
  requires positive : R[0] < E
  shows ∃ D ∈ ℝ, R[0] < D ∧ R[K * D] < E
proof
  have weightPositive : R[0] < R[K + 1] by linarith
  have weightNonzero : R[K + 1] ≠ R[0] by linarith
  have cancel := realDiv.mul_right at E, R[K + 1] with weightNonzero
  have quotientReal : R[E / (K + 1)] ∈ ℝ by typecheck
  have quotientPositive : R[0] < R[E / (K + 1)]
    by_contra notPositive
    have nonpositive : R[E / (K + 1)] ≤ R[0] by linarith
    have scaled := realLe.mul_right_of_nonnegative with nonpositive,
      (realLess.implies_le with weightPositive)
    have zero : R[0 * (K + 1)] = R[0] by ring
    linarith
  refine ⟨R[E / (K + 1)], quotientReal, quotientPositive, ?_⟩
  have expand : R[E / (K + 1) * (K + 1)] = R[K * (E / (K + 1)) + E / (K + 1)]
    by ring
  linarith

-- x ↦ x^σ is decreasing for σ < 0.
theorem realRpow.lt_of_base_neg (X Y S : Real)
  requires positive : R[0] < X
  requires less : X < Y
  requires exponent : S < R[0]
  shows realRpow(Y, S) < realRpow(X, S)
proof
  have logLess := realLog.strictly_increasing with positive, less
  have flipped : R[0] < R[-S] by linarith
  have scaled := realLess.mul_left_of_positive with logLess, flipped
  have shapeX : R[-S * realLog(X)] = R[-(S * realLog(X))] by ring
  have shapeY : R[-S * realLog(Y)] = R[-(S * realLog(Y))] by ring
  have reversed : R[S * realLog(Y)] < R[S * realLog(X)] by linarith
  unfold realRpow
  exact realExp.strictly_increasing with reversed

-- exp is nondecreasing.
theorem realExp.monotone (X Y : Real)
  requires below : X ≤ Y
  shows realExp(X) ≤ realExp(Y)
proof
  obtain less | same | greater := realLess.trichotomy at X, Y
  . exact realLess.implies_le with (realExp.strictly_increasing with less)
  . rw same
    have value := realExp.real at Y
    exact realLe.reflexive with *
  . exfalso
    linarith

-- y^(−t) ≤ y^(−p) + y^(−q) for p ≤ t ≤ q.
theorem realRpow.two_sided (Y P T Q : Real)
  requires lower : P ≤ T
  requires upper : T ≤ Q
  shows realRpow(Y, R[-T]) ≤ R[realRpow(Y, R[-P]) + realRpow(Y, R[-Q])]
proof
  have positiveP := realRpow.positive at Y, R[-P]
  have positiveQ := realRpow.positive at Y, R[-Q]
  have logReal := realLog.real at Y
  unfold realRpow
  by_cases sign : R[0] ≤ realLog(Y)
  . have gap : R[0] ≤ R[T - P] by linarith
    have product := realMulValue.nonnegative with gap, sign
    have expand : R[(T - P) * realLog(Y)] = R[T * realLog(Y) - P * realLog(Y)]
      by ring
    have shapeT : R[-T * realLog(Y)] = R[-(T * realLog(Y))] by ring
    have shapeP : R[-P * realLog(Y)] = R[-(P * realLog(Y))] by ring
    have exponent : R[-T * realLog(Y)] ≤ R[-P * realLog(Y)] by linarith
    have bound := realExp.monotone with exponent
    unfold realRpow at positiveQ
    linarith
  . have flipped : R[0] ≤ R[-realLog(Y)] by linarith
    have gap : R[0] ≤ R[Q - T] by linarith
    have product := realMulValue.nonnegative with gap, flipped
    have expand : R[(Q - T) * -realLog(Y)] =
      R[T * realLog(Y) - Q * realLog(Y)] by ring
    have shapeT : R[-T * realLog(Y)] = R[-(T * realLog(Y))] by ring
    have shapeQ : R[-Q * realLog(Y)] = R[-(Q * realLog(Y))] by ring
    have exponent : R[-T * realLog(Y)] ≤ R[-Q * realLog(Y)] by linarith
    have bound := realExp.monotone with exponent
    unfold realRpow at positiveP
    linarith

-- y^(−u) → 0 as y → ∞, for u > 0.
theorem realRpow.eventually_small (U E : Real)
  requires positive : R[0] < U
  requires small : R[0] < E
  shows ∃ M ∈ ℝ, R[0] < M ∧ ∀ Y ∈ ℝ, M ≤ Y → realRpow(Y, R[-U]) < E
proof
  have uNonzero : U ≠ R[0] by linarith
  have inverse := realDiv.mul_right at R[1], U with uNonzero
  have threshold := realRpow.positive at E, R[-(1 / U)]
  have thresholdReal : Real(realRpow(E, R[-(1 / U)])) by typecheck
  have mReal : R[realRpow(E, R[-(1 / U)]) + 1] ∈ ℝ by typecheck
  have mPositive : R[0] < R[realRpow(E, R[-(1 / U)]) + 1] by linarith
  refine ⟨R[realRpow(E, R[-(1 / U)]) + 1], mReal, mPositive, ?_⟩
  intros Y yMember later
  have yReal : Real(Y) by exact yMember
  have beyond : realRpow(E, R[-(1 / U)]) < Y by linarith
  have negative : R[-U] < R[0] by linarith
  have smaller := realRpow.lt_of_base_neg with threshold, beyond, negative
  rw (realRpow.mul_exponent with small) at smaller
  have exponent : R[-(1 / U) * -U] = R[1] by linear_combination inverse
  rw [exponent, (realRpow.one with small)] at smaller
  exact smaller

-- Real parts of an improper integral.
theorem HasComplexImproperIntegral.parts (g : Set) (A : Real) (I : Set)
  requires integral : HasComplexImproperIntegral(g, A, I)
  shows HasImproperIntegral(complexFunctionRe(g), A, complexRe(I)) ∧
    HasImproperIntegral(complexFunctionIm(g), A, complexIm(I))
proof
  obtain ⟨values, memberI, local, limit⟩ := integral
  have functionRe := complexFunctionRe.function with values
  have functionIm := complexFunctionIm.function with values
  constructor
  . refine ⟨functionRe, ?_, ?_⟩
    . intros T tMember later
      obtain ⟨_, integrable, _⟩ := local with T, tMember, later
      exact integrable
    . intros e eMember ePositive
      obtain ⟨T0, t0Real, near⟩ := limit with e, eMember, ePositive
      refine ⟨T0, t0Real, ?_⟩
      intros T tMember later afterA
      have close := near with T, tMember, later, afterA
      have integralMember := complexIntegral.member at g, A, T
      have difference : ℂ[complexIntegral(g, A, T) - I] ∈ ℂ by typecheck
      have part := complexAbs.re_le with difference
      rw [(complexRe.sub with integralMember, memberI), complexIntegral.re]
        at part
      linarith
  . refine ⟨functionIm, ?_, ?_⟩
    . intros T tMember later
      obtain ⟨_, _, integrable⟩ := local with T, tMember, later
      exact integrable
    . intros e eMember ePositive
      obtain ⟨T0, t0Real, near⟩ := limit with e, eMember, ePositive
      refine ⟨T0, t0Real, ?_⟩
      intros T tMember later afterA
      have close := near with T, tMember, later, afterA
      have integralMember := complexIntegral.member at g, A, T
      have difference : ℂ[complexIntegral(g, A, T) - I] ∈ ℂ by typecheck
      have part := complexAbs.im_le with difference
      rw [(complexIm.sub with integralMember, memberI), complexIntegral.im]
        at part
      linarith

-- ∫_A^∞ c (x + a)^w dx = −c (A + a)^(w+1)/(w + 1) for re w < −1.
theorem scaledPower.improper (c : Set) (a A : Real) (w : Set)
  requires hc : c ∈ ℂ
  requires hw : w ∈ ℂ
  requires exponent : R[complexRe(w) + 1] < R[0]
  requires positive : R[0] < R[A + a]
  shows HasComplexImproperIntegral(scaledPower(c, a, w), A,
    ℂ[-scaledPower(ℂ[c * complexInv(w + 1)], a, ℂ[w + 1])(A)])
proof
  have one := complexOne.member
  have raised : ℂ[w + 1] ∈ ℂ by typecheck
  have reRaised : complexRe(ℂ[w + 1]) = R[complexRe(w) + 1]
    rw [(complexRe.add with hw, one), ← complexOfReal.one, complexOfReal.re]
  have notMinusOne : ℂ[w + 1] ≠ ℂ[0]
    intro zero
    rw zero at reRaised
    rw [← complexOfReal.zero, complexOfReal.re] at reRaised
    linarith
  have inverse := complexInv.member with raised
  have scale : ℂ[c * complexInv(w + 1)] ∈ ℂ by typecheck
  have function := scaledPower.function at c, a, w with hc, hw
  have values : ComplexValuedOn(scaledPower(c, a, w), ℝ)
    intros Y yMember
    exact FunctionBetween.apply_closed with function, yMember
  have primitive := scaledPower.function at ℂ[c * complexInv(w + 1)], a,
    ℂ[w + 1] with scale, raised
  have aMember : A ∈ ℝ by typecheck
  have atA := FunctionBetween.apply_closed with primitive, aMember
  have limitMember : ℂ[-scaledPower(ℂ[c * complexInv(w + 1)], a,
    ℂ[w + 1])(A)] ∈ ℂ by typecheck
  refine ⟨values, limitMember, ?_, ?_⟩
  . intros T tMember later
    have tReal : Real(T) by exact tMember
    obtain ⟨integrable, _⟩ := scaledPower.integral at c, a, A, T, w with hc,
      hw, notMinusOne, positive, later
    exact integrable
  . intros e eMember ePositive
    have scaleAbs := complexAbs.nonnegative with scale
    have scaleAbsReal := complexAbs.real with scale
    have weightPositive : R[0] < R[complexAbs(ℂ[c * complexInv(w + 1)]) + 1]
      by linarith
    have weightNonzero : R[complexAbs(ℂ[c * complexInv(w + 1)]) + 1] ≠ R[0]
      by linarith
    have cancel := realDiv.mul_right at e,
      R[complexAbs(ℂ[c * complexInv(w + 1)]) + 1] with weightNonzero
    have quotientReal : Real(R[e / (complexAbs(ℂ[c * complexInv(w + 1)]) +
      1)]) by typecheck
    have quotientPositive : R[0] < R[e / (complexAbs(ℂ[c *
        complexInv(w + 1)]) + 1)]
      by_contra notPositive
      have nonpositive : R[e / (complexAbs(ℂ[c * complexInv(w + 1)]) + 1)] ≤
        R[0] by linarith
      have scaled := realLe.mul_right_of_nonnegative with nonpositive,
        (realLess.implies_le with weightPositive)
      have zero : R[0 * (complexAbs(ℂ[c * complexInv(w + 1)]) + 1)] = R[0]
        by ring
      linarith
    have decay : R[0] < R[-(complexRe(w) + 1)] by linarith
    obtain ⟨M, mReal, mPositive, eventually⟩ := realRpow.eventually_small with
      decay, quotientPositive
    have t0Real : R[M - a] ∈ ℝ by typecheck
    refine ⟨R[M - a], t0Real, ?_⟩
    intros T tMember later afterA
    have tReal : Real(T) by exact tMember
    obtain ⟨_, value⟩ := scaledPower.integral at c, a, A, T, w with hc,
      hw, notMinusOne, positive, afterA
    have atT := FunctionBetween.apply_closed with primitive, tMember
    have shape : ℂ[complexIntegral(scaledPower(c, a, w), A, T) -
        -scaledPower(ℂ[c * complexInv(w + 1)], a, ℂ[w + 1])(A)] =
        scaledPower(ℂ[c * complexInv(w + 1)], a, ℂ[w + 1])(T)
      rw value
      ring
    rw shape
    have shiftedT : R[0] < R[T + a] by linarith
    have powerMember := realCpow.member at R[T + a], ℂ[w + 1] with raised
    rw [(scaledPower.value at ℂ[c * complexInv(w + 1)], a, ℂ[w + 1], T with
      scale, raised), (complexAbs.mul with scale, powerMember),
      (realCpow.abs with shiftedT, raised), reRaised]
    have farEnough : M ≤ R[T + a] by linarith
    have small := eventually with R[T + a], farEnough
    have shapeExponent : R[-(-(complexRe(w) + 1))] = R[complexRe(w) + 1]
      by ring
    rw shapeExponent at small
    have powerPositive := realRpow.positive at R[T + a], R[complexRe(w) + 1]
    have strict := realLess.mul_left_of_positive with small, weightPositive
    have cancelShape : R[(complexAbs(ℂ[c * complexInv(w + 1)]) + 1) *
        (e / (complexAbs(ℂ[c * complexInv(w + 1)]) + 1))] = e
      by linear_combination cancel
    have expand : R[(complexAbs(ℂ[c * complexInv(w + 1)]) + 1) *
        realRpow(R[T + a], R[complexRe(w) + 1])] =
      R[complexAbs(ℂ[c * complexInv(w + 1)]) *
        realRpow(R[T + a], R[complexRe(w) + 1]) +
        realRpow(R[T + a], R[complexRe(w) + 1])] by ring
    linarith

-- The parts of the integrand are P̃ₙ times the parts of (x + a)^(−s−n).
theorem hurwitzIntegrand.parts (n : Nat) (a : Real) (s : Set)
  requires hs : s ∈ ℂ
  shows complexFunctionRe(hurwitzIntegrand(n, a, s)) =
      pointwiseMul(periodicBernoulli(n), complexFunctionRe(scaledPower(ℂ[1],
        a, ℂ[-s - complexOfReal(realNat(n))]))) ∧
    complexFunctionIm(hurwitzIntegrand(n, a, s)) =
      pointwiseMul(periodicBernoulli(n), complexFunctionIm(scaledPower(ℂ[1],
        a, ℂ[-s - complexOfReal(realNat(n))])))
proof
  have one := complexOne.member
  have exponent : ℂ[-s - complexOfReal(realNat(n))] ∈ ℂ by typecheck
  have integrand := hurwitzIntegrand.function at n, a, s with hs
  have integrandValues : ComplexValuedOn(hurwitzIntegrand(n, a, s), ℝ)
    intros Y yMember
    exact FunctionBetween.apply_closed with integrand, yMember
  have power := scaledPower.function at ℂ[1], a,
    ℂ[-s - complexOfReal(realNat(n))] with one, exponent
  have powerValues : ComplexValuedOn(scaledPower(ℂ[1], a,
      ℂ[-s - complexOfReal(realNat(n))]), ℝ)
    intros Y yMember
    exact FunctionBetween.apply_closed with power, yMember
  have bernoulliFunction := periodicBernoulli.function at n
  have functionRe := complexFunctionRe.function with integrandValues
  have functionIm := complexFunctionIm.function with integrandValues
  have powerRe := complexFunctionRe.function with powerValues
  have powerIm := complexFunctionIm.function with powerValues
  have productRe := pointwiseMul.function with bernoulliFunction, powerRe
  have productIm := pointwiseMul.function with bernoulliFunction, powerIm
  constructor
  . apply FunctionBetween.ext with functionRe, productRe
    intros X xMember
    have xReal : Real(X) by exact xMember
    have value := FunctionBetween.apply_closed with bernoulliFunction, xMember
    have valueReal : Real(periodicBernoulli(n)(X)) by exact value
    have powerMember := realCpow.member at R[X + a],
      ℂ[-s - complexOfReal(realNat(n))] with exponent
    have scalar : complexOfReal(periodicBernoulli(n)(X)) ∈ ℂ by typecheck
    have unit : ℂ[1 * realCpow(R[X + a], ℂ[-s - complexOfReal(realNat(n))])] =
      realCpow(R[X + a], ℂ[-s - complexOfReal(realNat(n))]) by ring
    have reReal := complexRe.real with powerMember
    have imReal := complexIm.real with powerMember
    have powerValue := FunctionBetween.apply_closed with powerRe, xMember
    have powerReal : Real(complexFunctionRe(scaledPower(ℂ[1], a,
      ℂ[-s - complexOfReal(realNat(n))]))(X)) by exact powerValue
    rw [(pointwiseMul.value at periodicBernoulli(n),
      complexFunctionRe(scaledPower(ℂ[1], a,
        ℂ[-s - complexOfReal(realNat(n))])), X with bernoulliFunction,
      powerRe, valueReal, powerReal), (complexFunctionRe.apply with integrandValues),
      (complexFunctionRe.apply with powerValues),
      (hurwitzIntegrand.value at n, a, s, X with hs),
      (scaledPower.value at ℂ[1], a, ℂ[-s - complexOfReal(realNat(n))], X
        with one, exponent), unit, (complexRe.mul with scalar, powerMember),
      complexOfReal.re, complexOfReal.im]
    ring
  . apply FunctionBetween.ext with functionIm, productIm
    intros X xMember
    have xReal : Real(X) by exact xMember
    have value := FunctionBetween.apply_closed with bernoulliFunction, xMember
    have valueReal : Real(periodicBernoulli(n)(X)) by exact value
    have powerMember := realCpow.member at R[X + a],
      ℂ[-s - complexOfReal(realNat(n))] with exponent
    have scalar : complexOfReal(periodicBernoulli(n)(X)) ∈ ℂ by typecheck
    have unit : ℂ[1 * realCpow(R[X + a], ℂ[-s - complexOfReal(realNat(n))])] =
      realCpow(R[X + a], ℂ[-s - complexOfReal(realNat(n))]) by ring
    have reReal := complexRe.real with powerMember
    have imReal := complexIm.real with powerMember
    have powerValue := FunctionBetween.apply_closed with powerIm, xMember
    have powerReal : Real(complexFunctionIm(scaledPower(ℂ[1], a,
      ℂ[-s - complexOfReal(realNat(n))]))(X)) by exact powerValue
    rw [(pointwiseMul.value at periodicBernoulli(n),
      complexFunctionIm(scaledPower(ℂ[1], a,
        ℂ[-s - complexOfReal(realNat(n))])), X with bernoulliFunction,
      powerIm, valueReal, powerReal), (complexFunctionIm.apply with integrandValues),
      (complexFunctionIm.apply with powerValues),
      (hurwitzIntegrand.value at n, a, s, X with hs),
      (scaledPower.value at ℂ[1], a, ℂ[-s - complexOfReal(realNat(n))], X
        with one, exponent), unit, (complexIm.mul with scalar, powerMember),
      complexOfReal.re, complexOfReal.im]
    ring

theorem hurwitzIntegrand.local_integrable (n : Nat) (a T : Real) (s : Set)
  requires positive : R[0] < a
  requires hs : s ∈ ℂ
  requires nonnegative : R[0] ≤ T
  shows ComplexRiemannIntegrable(hurwitzIntegrand(n, a, s), R[0], T)
proof
  have one := complexOne.member
  have exponent : ℂ[-s - complexOfReal(realNat(n))] ∈ ℂ by typecheck
  have integrand := hurwitzIntegrand.function at n, a, s with hs
  have values : ComplexValuedOn(hurwitzIntegrand(n, a, s), ℝ)
    intros Y yMember
    exact FunctionBetween.apply_closed with integrand, yMember
  obtain ⟨M, mNat, above⟩ := Real.below_natural at T
  have shifted : R[0] < R[0 + a] by linarith
  obtain ⟨continuousRe, continuousIm⟩ := scaledPower.continuous_parts at
    ℂ[1], a, R[0], realNat(M), ℂ[-s - complexOfReal(realNat(n))]
    with one, exponent, shifted
  have integrableRe := periodicBernoulli.prefix_integrable at n,
    complexFunctionRe(scaledPower(ℂ[1], a,
      ℂ[-s - complexOfReal(realNat(n))])), M with continuousRe
  have integrableIm := periodicBernoulli.prefix_integrable at n,
    complexFunctionIm(scaledPower(ℂ[1], a,
      ℂ[-s - complexOfReal(realNat(n))])), M with continuousIm
  obtain ⟨partsRe, partsIm⟩ := hurwitzIntegrand.parts at n, a, s with hs
  rw ← partsRe at integrableRe
  rw ← partsIm at integrableIm
  have below : T ≤ realNat(M) by linarith
  obtain ⟨restrictRe, _⟩ := RiemannIntegrable.restrict with integrableRe,
    nonnegative, below
  obtain ⟨restrictIm, _⟩ := RiemannIntegrable.restrict with integrableIm,
    nonnegative, below
  exact ⟨values, restrictRe, restrictIm⟩

-- Restricting a complex integrable function to a subinterval.
theorem ComplexRiemannIntegrable.restrict (g : Set) (A B C : Real)
  requires integrable : ComplexRiemannIntegrable(g, A, C)
  requires first : A ≤ B
  requires second : B ≤ C
  shows ComplexRiemannIntegrable(g, A, B) ∧ ComplexRiemannIntegrable(g, B, C)
proof
  obtain ⟨values, integrableRe, integrableIm⟩ := integrable
  obtain ⟨leftRe, rightRe⟩ := RiemannIntegrable.restrict with integrableRe,
    first, second
  obtain ⟨leftIm, rightIm⟩ := RiemannIntegrable.restrict with integrableIm,
    first, second
  exact ⟨⟨values, leftRe, leftIm⟩, ⟨values, rightRe, rightIm⟩⟩

-- For n ≥ 2 the primitive P̃ₙ₊₁/(n + 1) of P̃ₙ is differentiable
-- everywhere.
theorem periodicBernoulliPrimitive.derivative_everywhere (n : Nat) (x : Real)
  requires large : 2 ≤ n
  shows HasDerivativeAt(periodicBernoulliPrimitive(n),
    periodicBernoulli(n)(x), x)
proof
  have succNonzero : succ(n) ≠ (0:N) by arith
  have nonzero := realNat.ne_zero with succNonzero
  have scale := realNat.real at succ(n)
  have inverse := realInvValue.real at realNat(succ(n))
  have cancel := realInvValue.mul_left with nonzero
  have constantDerivative := constantRealFunction.has_derivative_at
    at realInvValue(realNat(succ(n))), x
  have function := periodicBernoulli.function at succ(n)
  have lower := periodicBernoulli.function at n
  have xMember : x ∈ ℝ by typecheck
  have upperMember := FunctionBetween.apply_closed with function, xMember
  have upperReal : Real(periodicBernoulli(succ(n))(x)) by exact upperMember
  have lowerMember := FunctionBetween.apply_closed with lower, xMember
  have lowerReal : Real(periodicBernoulli(n)(x)) by exact lowerMember
  have periodicDerivative := periodicBernoulli.derivative_everywhere at n, x
    with large
  have product := HasDerivativeAt.mul with constantDerivative,
    periodicDerivative
  have constantValue := constantRealFunction.value
    at realInvValue(realNat(succ(n))), x
  rw constantValue at product
  have value : realAddValue(realMulValue(realZero,
      periodicBernoulli(succ(n))(x)), realMulValue(realInvValue(
      realNat(succ(n))), realNat(succ(n)) * periodicBernoulli(n)(x))) =
      periodicBernoulli(n)(x)
    have expand : realAddValue(realMulValue(realZero,
        periodicBernoulli(succ(n))(x)), realMulValue(realInvValue(
        realNat(succ(n))), realNat(succ(n)) * periodicBernoulli(n)(x))) =
        realInvValue(realNat(succ(n))) * realNat(succ(n)) *
          periodicBernoulli(n)(x) by ring
    rw expand
    linear_combination periodicBernoulli(n)(x) * cancel
  rw value at product
  unfold periodicBernoulliPrimitive
  exact product

-- The exponent −s − (n + 1) is (−s − n) − 1.
theorem hurwitzExponent.succ (s : Set) (n : Nat)
  requires hs : s ∈ ℂ
  shows ℂ[-s - complexOfReal(realNat(succ(n)))] =
    ℂ[(-s - complexOfReal(realNat(n))) - 1]
proof
  have nMember : complexOfReal(realNat(n)) ∈ ℂ by typecheck
  rw [realNat.succ_value, complexOfReal.add, complexOfReal.one]
  ring

-- The second product of the integration by parts, P̃ₙ₊₁/(n + 1) times
-- (−s − n)(x + a)^(−s−n−1), is (−s − n)/(n + 1) times the next integrand.
theorem hurwitzIntegrand.primitive_parts (n : Nat) (a : Real) (s : Set)
  requires hs : s ∈ ℂ
  shows pointwiseMul(periodicBernoulliPrimitive(n),
      complexFunctionRe(scaledPower(ℂ[-s - complexOfReal(realNat(n))], a,
        ℂ[(-s - complexOfReal(realNat(n))) - 1]))) =
      complexFunctionRe(complexFunctionMul(complexFunctionConst(
        ℂ[(-s - complexOfReal(realNat(n))) *
          complexOfReal(realInvValue(realNat(succ(n))))], ℝ),
        hurwitzIntegrand(succ(n), a, s), ℝ)) ∧
    pointwiseMul(periodicBernoulliPrimitive(n),
      complexFunctionIm(scaledPower(ℂ[-s - complexOfReal(realNat(n))], a,
        ℂ[(-s - complexOfReal(realNat(n))) - 1]))) =
      complexFunctionIm(complexFunctionMul(complexFunctionConst(
        ℂ[(-s - complexOfReal(realNat(n))) *
          complexOfReal(realInvValue(realNat(succ(n))))], ℝ),
        hurwitzIntegrand(succ(n), a, s), ℝ))
proof
  have exponent : ℂ[-s - complexOfReal(realNat(n))] ∈ ℂ by typecheck
  have lowered : ℂ[(-s - complexOfReal(realNat(n))) - 1] ∈ ℂ by typecheck
  have inverseReal := realInvValue.real at realNat(succ(n))
  have scale : ℂ[(-s - complexOfReal(realNat(n))) *
    complexOfReal(realInvValue(realNat(succ(n))))] ∈ ℂ by typecheck
  have power := scaledPower.function at ℂ[-s - complexOfReal(realNat(n))], a,
    ℂ[(-s - complexOfReal(realNat(n))) - 1] with exponent, lowered
  have powerValues : ComplexValuedOn(scaledPower(ℂ[-s -
      complexOfReal(realNat(n))], a, ℂ[(-s - complexOfReal(realNat(n))) - 1]),
      ℝ)
    intros Y yMember
    exact FunctionBetween.apply_closed with power, yMember
  have constant := complexFunctionConst.function at ℂ[(-s -
    complexOfReal(realNat(n))) * complexOfReal(realInvValue(realNat(succ(n))))],
    ℝ with scale
  have constantValues : ComplexValuedOn(complexFunctionConst(ℂ[(-s -
      complexOfReal(realNat(n))) *
      complexOfReal(realInvValue(realNat(succ(n))))], ℝ), ℝ)
    intros Y yMember
    exact FunctionBetween.apply_closed with constant, yMember
  have integrand := hurwitzIntegrand.function at succ(n), a, s with hs
  have integrandValues : ComplexValuedOn(hurwitzIntegrand(succ(n), a, s), ℝ)
    intros Y yMember
    exact FunctionBetween.apply_closed with integrand, yMember
  have product := complexFunctionMul.function at complexFunctionConst(ℂ[(-s -
    complexOfReal(realNat(n))) * complexOfReal(realInvValue(realNat(succ(n))))],
    ℝ), hurwitzIntegrand(succ(n), a, s), ℝ with constantValues, integrandValues
  have productValues : ComplexValuedOn(complexFunctionMul(complexFunctionConst(
      ℂ[(-s - complexOfReal(realNat(n))) *
        complexOfReal(realInvValue(realNat(succ(n))))], ℝ),
      hurwitzIntegrand(succ(n), a, s), ℝ), ℝ)
    intros Y yMember
    exact FunctionBetween.apply_closed with product, yMember
  have primitiveFunction : periodicBernoulliPrimitive(n) : ℝ → ℝ
    have inverseConstant := constantRealFunction.function
      at realInvValue(realNat(succ(n)))
    have periodic := periodicBernoulli.function at succ(n)
    unfold periodicBernoulliPrimitive
    exact pointwiseMul.function with inverseConstant, periodic
  have powerRe := complexFunctionRe.function with powerValues
  have powerIm := complexFunctionIm.function with powerValues
  have productRe := complexFunctionRe.function with productValues
  have productIm := complexFunctionIm.function with productValues
  have leftRe := pointwiseMul.function with primitiveFunction, powerRe
  have leftIm := pointwiseMul.function with primitiveFunction, powerIm
  -- The complex values agree.
  have same : ∀ X ∈ ℝ, complexFunctionMul(complexFunctionConst(
      ℂ[(-s - complexOfReal(realNat(n))) *
        complexOfReal(realInvValue(realNat(succ(n))))], ℝ),
      hurwitzIntegrand(succ(n), a, s), ℝ)(X) =
      ℂ[complexOfReal(periodicBernoulliPrimitive(n)(X)) *
        scaledPower(ℂ[-s - complexOfReal(realNat(n))], a,
          ℂ[(-s - complexOfReal(realNat(n))) - 1])(X)]
    intros X xMember
    have xReal : Real(X) by exact xMember
    have periodic := periodicBernoulli.function at succ(n)
    have periodicValue := FunctionBetween.apply_closed with periodic, xMember
    have periodicReal : Real(periodicBernoulli(succ(n))(X))
      by exact periodicValue
    have powerMember := realCpow.member at R[X + a],
      ℂ[(-s - complexOfReal(realNat(n))) - 1] with lowered
    rw [(complexFunctionMul.value with constantValues, integrandValues,
      xMember), (complexFunctionConst.value with scale, xMember),
      (hurwitzIntegrand.value at succ(n), a, s, X with hs),
      (hurwitzExponent.succ with hs),
      (scaledPower.value at ℂ[-s - complexOfReal(realNat(n))], a,
        ℂ[(-s - complexOfReal(realNat(n))) - 1], X with exponent, lowered),
      periodicBernoulliPrimitive.value, complexOfReal.mul]
    ring
  constructor
  . apply FunctionBetween.ext with leftRe, productRe
    intros X xMember
    have xReal : Real(X) by exact xMember
    have primitiveReal := periodicBernoulliPrimitive.real at n, X
    have powerValue := powerValues with X, xMember
    have scalar : complexOfReal(periodicBernoulliPrimitive(n)(X)) ∈ ℂ
      by typecheck
    have reReal := complexRe.real with powerValue
    have imReal := complexIm.real with powerValue
    have powerReal : Real(complexFunctionRe(scaledPower(ℂ[-s -
        complexOfReal(realNat(n))], a, ℂ[(-s - complexOfReal(realNat(n))) -
        1]))(X))
      rw (complexFunctionRe.apply with powerValues)
      exact reReal
    rw [(pointwiseMul.value at periodicBernoulliPrimitive(n),
      complexFunctionRe(scaledPower(ℂ[-s - complexOfReal(realNat(n))], a,
        ℂ[(-s - complexOfReal(realNat(n))) - 1])), X with primitiveFunction,
      powerRe, primitiveReal, powerReal),
      (complexFunctionRe.apply with productValues), (same with X, xMember),
      (complexRe.mul with scalar, powerValue), complexOfReal.re,
      complexOfReal.im, (complexFunctionRe.apply with powerValues)]
    ring
  . apply FunctionBetween.ext with leftIm, productIm
    intros X xMember
    have xReal : Real(X) by exact xMember
    have primitiveReal := periodicBernoulliPrimitive.real at n, X
    have powerValue := powerValues with X, xMember
    have scalar : complexOfReal(periodicBernoulliPrimitive(n)(X)) ∈ ℂ
      by typecheck
    have reReal := complexRe.real with powerValue
    have imReal := complexIm.real with powerValue
    have powerReal : Real(complexFunctionIm(scaledPower(ℂ[-s -
        complexOfReal(realNat(n))], a, ℂ[(-s - complexOfReal(realNat(n))) -
        1]))(X))
      rw (complexFunctionIm.apply with powerValues)
      exact imReal
    rw [(pointwiseMul.value at periodicBernoulliPrimitive(n),
      complexFunctionIm(scaledPower(ℂ[-s - complexOfReal(realNat(n))], a,
        ℂ[(-s - complexOfReal(realNat(n))) - 1])), X with primitiveFunction,
      powerIm, primitiveReal, powerReal),
      (complexFunctionIm.apply with productValues), (same with X, xMember),
      (complexIm.mul with scalar, powerValue), complexOfReal.re,
      complexOfReal.im, (complexFunctionIm.apply with powerValues)]
    ring

-- Integration by parts on [0, T], n ≥ 2: with w = −s − n,
-- ∫_0^T P̃ₙ (x + a)^w + w/(n + 1) ∫_0^T P̃ₙ₊₁ (x + a)^(w−1)
--   = [P̃ₙ₊₁(x)/(n + 1) · (x + a)^w]_0^T.
theorem hurwitzIntegrand.finite_parts (n : Nat) (a T : Real) (s : Set)
  requires positive : R[0] < a
  requires hs : s ∈ ℂ
  requires large : 2 ≤ n
  requires nonnegative : R[0] ≤ T
  shows ℂ[complexIntegral(hurwitzIntegrand(n, a, s), R[0], T) +
      ℂ[(-s - complexOfReal(realNat(n))) *
        complexOfReal(realInvValue(realNat(succ(n))))] *
      complexIntegral(hurwitzIntegrand(succ(n), a, s), R[0], T)] =
    ℂ[complexOfReal(periodicBernoulliPrimitive(n)(T)) *
        realCpow(R[T + a], ℂ[-s - complexOfReal(realNat(n))]) -
      complexOfReal(periodicBernoulliPrimitive(n)(R[0])) *
        realCpow(R[0 + a], ℂ[-s - complexOfReal(realNat(n))])]
proof
  have one := complexOne.member
  have exponent : ℂ[-s - complexOfReal(realNat(n))] ∈ ℂ by typecheck
  have lowered : ℂ[(-s - complexOfReal(realNat(n))) - 1] ∈ ℂ by typecheck
  have inverseReal := realInvValue.real at realNat(succ(n))
  have scale : ℂ[(-s - complexOfReal(realNat(n))) * complexOfReal(realInvValue(realNat(succ(n))))] ∈ ℂ by typecheck
  have shifted : R[0] < R[0 + a] by linarith
  have localN := hurwitzIntegrand.local_integrable at n, a, T, s with
    positive, hs, nonnegative
  have localNext := hurwitzIntegrand.local_integrable at succ(n), a, T, s with
    positive, hs, nonnegative
  obtain ⟨integrableProduct, productValue⟩ := complexIntegral.const_mul at
    ℂ[(-s - complexOfReal(realNat(n))) * complexOfReal(realInvValue(realNat(succ(n))))], hurwitzIntegrand(succ(n), a, s), R[0], T with scale, nonnegative,
    localNext
  obtain ⟨partsRe, partsIm⟩ := hurwitzIntegrand.parts at n, a, s with hs
  obtain ⟨primitiveRe, primitiveIm⟩ := hurwitzIntegrand.primitive_parts at
    n, a, s with hs
  obtain ⟨_, integrableNRe, integrableNIm⟩ := localN
  obtain ⟨_, integrableProductRe, integrableProductIm⟩ := integrableProduct
  rw partsRe at integrableNRe
  rw partsIm at integrableNIm
  rw ← primitiveRe at integrableProductRe
  rw ← primitiveIm at integrableProductIm
  -- The factors and their derivatives.
  have primitiveFunction : periodicBernoulliPrimitive(n) : ℝ → ℝ
    have inverseConstant := constantRealFunction.function
      at realInvValue(realNat(succ(n)))
    have periodic := periodicBernoulli.function at succ(n)
    unfold periodicBernoulliPrimitive
    exact pointwiseMul.function with inverseConstant, periodic
  have bernoulliFunction := periodicBernoulli.function at n
  have subset := closedInterval.subset_reals at R[0], T
  have positiveN : 0 < n by arith
  have continuousU := Continuous.continuous_on with
    (periodicBernoulliPrimitive.continuous at n with positiveN), subset
  obtain ⟨continuousRe, continuousIm⟩ := scaledPower.continuous_parts at
    ℂ[1], a, R[0], T, ℂ[-s - complexOfReal(realNat(n))] with one, exponent, shifted
  have power := scaledPower.function at ℂ[-s - complexOfReal(realNat(n))], a,
    ℂ[(-s - complexOfReal(realNat(n))) - 1] with exponent, lowered
  have powerValues : ComplexValuedOn(scaledPower(ℂ[-s - complexOfReal(realNat(n))], a,
      ℂ[(-s - complexOfReal(realNat(n))) - 1]), ℝ)
    intros Y yMember
    exact FunctionBetween.apply_closed with power, yMember
  have unitPower := scaledPower.function at ℂ[1], a, ℂ[-s - complexOfReal(realNat(n))] with one, exponent
  have unitValues : ComplexValuedOn(scaledPower(ℂ[1], a, ℂ[-s - complexOfReal(realNat(n))]), ℝ)
    intros Y yMember
    exact FunctionBetween.apply_closed with unitPower, yMember
  have derivativeU : ∀ X ∈ ℝ, R[0] < X → X < T →
      HasDerivativeAt(periodicBernoulliPrimitive(n), periodicBernoulli(n)(X), X)
    intros X xMember lower upper
    have xReal : Real(X) by exact xMember
    exact periodicBernoulliPrimitive.derivative_everywhere with large
  have derivativeValue : ∀ X ∈ ℝ, ℂ[1 * ℂ[-s - complexOfReal(realNat(n))] *
      realCpow(R[X + a], ℂ[(-s - complexOfReal(realNat(n))) - 1])] =
      scaledPower(ℂ[-s - complexOfReal(realNat(n))], a, ℂ[(-s - complexOfReal(realNat(n))) - 1])(X)
    intros X xMember
    have xReal : Real(X) by exact xMember
    have powerMember := realCpow.member at R[X + a],
      ℂ[(-s - complexOfReal(realNat(n))) - 1] with lowered
    rw (scaledPower.value at ℂ[-s - complexOfReal(realNat(n))], a, ℂ[(-s - complexOfReal(realNat(n))) - 1],
      X with exponent, lowered)
    ring
  have derivativeRe : ∀ X ∈ ℝ, R[0] < X → X < T →
      HasDerivativeAt(complexFunctionRe(scaledPower(ℂ[1], a, ℂ[-s - complexOfReal(realNat(n))])),
        complexFunctionRe(scaledPower(ℂ[-s - complexOfReal(realNat(n))], a,
          ℂ[(-s - complexOfReal(realNat(n))) - 1]))(X), X)
    intros X xMember lower upper
    have xReal : Real(X) by exact xMember
    have shiftedX : R[0] < R[X + a] by linarith
    obtain ⟨derivative, _⟩ := scaledPower.has_derivative at ℂ[1], a, X, ℂ[-s - complexOfReal(realNat(n))]
      with one, exponent, shiftedX
    rw (derivativeValue with X, xMember) at derivative
    rw (complexFunctionRe.apply with powerValues)
    exact derivative
  have derivativeIm : ∀ X ∈ ℝ, R[0] < X → X < T →
      HasDerivativeAt(complexFunctionIm(scaledPower(ℂ[1], a, ℂ[-s - complexOfReal(realNat(n))])),
        complexFunctionIm(scaledPower(ℂ[-s - complexOfReal(realNat(n))], a,
          ℂ[(-s - complexOfReal(realNat(n))) - 1]))(X), X)
    intros X xMember lower upper
    have xReal : Real(X) by exact xMember
    have shiftedX : R[0] < R[X + a] by linarith
    obtain ⟨_, derivative⟩ := scaledPower.has_derivative at ℂ[1], a, X, ℂ[-s - complexOfReal(realNat(n))]
      with one, exponent, shiftedX
    rw (derivativeValue with X, xMember) at derivative
    rw (complexFunctionIm.apply with powerValues)
    exact derivative
  have functionRe := complexFunctionRe.function with powerValues
  have functionIm := complexFunctionIm.function with powerValues
  have partsByRe := riemannIntegral.by_parts with nonnegative,
    bernoulliFunction, functionRe, continuousU, continuousRe, derivativeU,
    derivativeRe, integrableNRe, integrableProductRe
  have partsByIm := riemannIntegral.by_parts with nonnegative,
    bernoulliFunction, functionIm, continuousU, continuousIm, derivativeU,
    derivativeIm, integrableNIm, integrableProductIm
  rw [← partsRe, primitiveRe, ← complexIntegral.re, ← complexIntegral.re,
    productValue] at partsByRe
  rw [← partsIm, primitiveIm, ← complexIntegral.im, ← complexIntegral.im,
    productValue] at partsByIm
  have tMember : T ∈ ℝ by typecheck
  have zeroMember : R[0] ∈ ℝ by typecheck
  have primitiveT := periodicBernoulliPrimitive.real at n, T
  have primitiveZero := periodicBernoulliPrimitive.real at n, R[0]
  have powerT := realCpow.member at R[T + a], ℂ[-s - complexOfReal(realNat(n))] with exponent
  have powerZero := realCpow.member at R[0 + a], ℂ[-s - complexOfReal(realNat(n))] with exponent
  have unitT : ℂ[1 * realCpow(R[T + a], ℂ[-s - complexOfReal(realNat(n))])] = realCpow(R[T + a], ℂ[-s - complexOfReal(realNat(n))])
    by ring
  have unitZero : ℂ[1 * realCpow(R[0 + a], ℂ[-s - complexOfReal(realNat(n))])] = realCpow(R[0 + a], ℂ[-s - complexOfReal(realNat(n))])
    by ring
  rw [(complexFunctionRe.apply at scaledPower(ℂ[1], a, ℂ[-s - complexOfReal(realNat(n))]), T with
      unitValues),
    (complexFunctionRe.apply at scaledPower(ℂ[1], a, ℂ[-s - complexOfReal(realNat(n))]), R[0] with
      unitValues),
    (scaledPower.value at ℂ[1], a, ℂ[-s - complexOfReal(realNat(n))], T with one, exponent),
    (scaledPower.value at ℂ[1], a, ℂ[-s - complexOfReal(realNat(n))], R[0] with one, exponent),
    unitT, unitZero] at partsByRe
  rw [(complexFunctionIm.apply at scaledPower(ℂ[1], a, ℂ[-s - complexOfReal(realNat(n))]), T with
      unitValues),
    (complexFunctionIm.apply at scaledPower(ℂ[1], a, ℂ[-s - complexOfReal(realNat(n))]), R[0] with
      unitValues),
    (scaledPower.value at ℂ[1], a, ℂ[-s - complexOfReal(realNat(n))], T with one, exponent),
    (scaledPower.value at ℂ[1], a, ℂ[-s - complexOfReal(realNat(n))], R[0] with one, exponent),
    unitT, unitZero] at partsByIm
  have integralN := complexIntegral.member at hurwitzIntegrand(n, a, s),
    R[0], T
  have integralNext := complexIntegral.member at
    hurwitzIntegrand(succ(n), a, s), R[0], T
  have scaled : ℂ[ℂ[(-s - complexOfReal(realNat(n))) * complexOfReal(realInvValue(realNat(succ(n))))] * complexIntegral(hurwitzIntegrand(succ(n), a, s),
    R[0], T)] ∈ ℂ by typecheck
  have scalarT : complexOfReal(periodicBernoulliPrimitive(n)(T)) ∈ ℂ
    by typecheck
  have scalarZero : complexOfReal(periodicBernoulliPrimitive(n)(R[0])) ∈ ℂ
    by typecheck
  have boundaryT : ℂ[complexOfReal(periodicBernoulliPrimitive(n)(T)) *
    realCpow(R[T + a], ℂ[-s - complexOfReal(realNat(n))])] ∈ ℂ by typecheck
  have boundaryZero : ℂ[complexOfReal(periodicBernoulliPrimitive(n)(R[0])) *
    realCpow(R[0 + a], ℂ[-s - complexOfReal(realNat(n))])] ∈ ℂ by typecheck
  have left : ℂ[complexIntegral(hurwitzIntegrand(n, a, s), R[0], T) +
    ℂ[(-s - complexOfReal(realNat(n))) * complexOfReal(realInvValue(realNat(succ(n))))] * complexIntegral(hurwitzIntegrand(succ(n), a, s), R[0], T)] ∈ ℂ
    by typecheck
  have right : ℂ[complexOfReal(periodicBernoulliPrimitive(n)(T)) *
      realCpow(R[T + a], ℂ[-s - complexOfReal(realNat(n))]) -
    complexOfReal(periodicBernoulliPrimitive(n)(R[0])) *
      realCpow(R[0 + a], ℂ[-s - complexOfReal(realNat(n))])] ∈ ℂ by typecheck
  apply complex.eq_of_parts with left, right
  . rw [(complexRe.add with integralN, scaled),
      (complexRe.sub with boundaryT, boundaryZero),
      (complexRe.mul with scalarT, powerT),
      (complexRe.mul with scalarZero, powerZero), complexOfReal.re,
      complexOfReal.im, complexOfReal.re, complexOfReal.im]
    have reT := complexRe.real with powerT
    have imT := complexIm.real with powerT
    have reZero := complexRe.real with powerZero
    have imZero := complexIm.real with powerZero
    linear_combination partsByRe
  . rw [(complexIm.add with integralN, scaled),
      (complexIm.sub with boundaryT, boundaryZero),
      (complexIm.mul with scalarT, powerT),
      (complexIm.mul with scalarZero, powerZero), complexOfReal.re,
      complexOfReal.im, complexOfReal.re, complexOfReal.im]
    have reT := complexRe.real with powerT
    have imT := complexIm.real with powerT
    have reZero := complexRe.real with powerZero
    have imZero := complexIm.real with powerZero
    linear_combination partsByIm

-- ∫_0^∞ P̃ₙ(x)(x + a)^(−s−n) dx converges for re s > 1 − n.
theorem hurwitzIntegrand.integrable (n : Nat) (a : Real) (s : Set)
  requires positive : R[0] < a
  requires hs : s ∈ ℂ
  requires halfPlane : R[1 - realNat(n)] < complexRe(s)
  shows ComplexImproperIntegrable(hurwitzIntegrand(n, a, s), R[0])
proof
  have reReal := complexRe.real with hs
  have exponentGap : R[1] < R[complexRe(s) + realNat(n)] by linarith
  have unitPositive : R[0] < R[1] by linarith
  have boundReal := bernoulliBound.real at n
  have boundNonnegative : R[0] ≤ bernoulliBound(n)
    have xZero : R[0] ∈ ℝ by typecheck
    have function := periodicBernoulli.function at n
    have value := FunctionBetween.apply_closed with function, xZero
    have valueReal : Real(periodicBernoulli(n)(R[0])) by exact value
    have bound := periodicBernoulli.bound at n, R[0]
    have nonnegative := abs.nonnegative at periodicBernoulli(n)(R[0])
    linarith
  have local : ∀ T ∈ ℝ, R[1] ≤ T →
      ComplexRiemannIntegrable(hurwitzIntegrand(n, a, s), R[1], T)
    intros T tMember later
    have tReal : Real(T) by exact tMember
    have nonnegative : R[0] ≤ T by linarith
    have whole := hurwitzIntegrand.local_integrable with positive, hs,
      nonnegative
    have first : R[0] ≤ R[1] by linarith
    obtain ⟨_, restricted⟩ := ComplexRiemannIntegrable.restrict with whole,
      first, later
    exact restricted
  have bound : ∀ X ∈ ℝ, R[1] ≤ X →
      complexAbs(hurwitzIntegrand(n, a, s)(X)) ≤
        R[bernoulliBound(n) * realRpow(X, R[-(complexRe(s) + realNat(n))])]
    intros X xMember later
    have xReal : Real(X) by exact xMember
    have nonnegative : R[0] ≤ X by linarith
    have xPositive : R[0] < X by linarith
    have estimate := hurwitzIntegrand.abs_le with positive, hs, nonnegative
    have shape : R[-(complexRe(s) + realNat(n))] =
      R[-complexRe(s) - realNat(n)] by ring
    rw shape
    have further : X < R[X + a] by linarith
    have negative : R[-complexRe(s) - realNat(n)] < R[0] by linarith
    have smaller := realRpow.lt_of_base_neg with xPositive, further, negative
    have scaled := realLe.mul_left_of_nonnegative with
      (realLess.implies_le with smaller), boundNonnegative
    linarith
  obtain ⟨tail, _⟩ := ComplexImproperIntegrable.of_rpow_bound with
    unitPositive, exponentGap, local, bound
  have first : R[0] ≤ R[1] by linarith
  have head := hurwitzIntegrand.local_integrable with positive, hs, first
  obtain ⟨equivalent, _⟩ := complexImproperIntegral.split with first, head
  exact equivalent.backward with tail

-- Letting T → ∞: for n ≥ 2 and re s > 1 − n, with w = −s − n,
-- ∫_0^∞ P̃ₙ (x + a)^w = −P̃ₙ₊₁(0)/(n + 1) · a^w
--   − w/(n + 1) ∫_0^∞ P̃ₙ₊₁ (x + a)^(w−1).
theorem hurwitzIntegrand.improper_parts (n : Nat) (a : Real) (s : Set)
  requires positive : R[0] < a
  requires hs : s ∈ ℂ
  requires large : 2 ≤ n
  requires halfPlane : R[1 - realNat(n)] < complexRe(s)
  shows complexImproperIntegral(hurwitzIntegrand(n, a, s), R[0]) =
    ℂ[-(complexOfReal(periodicBernoulliPrimitive(n)(R[0])) *
        realCpow(R[0 + a], ℂ[-s - complexOfReal(realNat(n))])) -
      ℂ[(-s - complexOfReal(realNat(n))) * complexOfReal(realInvValue(realNat(succ(n))))] * complexImproperIntegral(hurwitzIntegrand(succ(n), a, s), R[0])]
proof
  have exponent : ℂ[-s - complexOfReal(realNat(n))] ∈ ℂ by typecheck
  have inverseReal := realInvValue.real at realNat(succ(n))
  have scale : ℂ[(-s - complexOfReal(realNat(n))) * complexOfReal(realInvValue(realNat(succ(n))))] ∈ ℂ by typecheck
  have reReal := complexRe.real with hs
  have nextHalfPlane : R[1 - realNat(succ(n))] < complexRe(s)
    rw realNat.succ_value
    have nonnegative := realNat.nonnegative at n
    linarith
  have integrableNext := hurwitzIntegrand.integrable at succ(n), a, s with
    positive, hs, nextHalfPlane
  have specNext := complexImproperIntegral.spec with integrableNext
  have specNextCopy : HasComplexImproperIntegral(hurwitzIntegrand(succ(n), a,
    s), R[0], complexImproperIntegral(hurwitzIntegrand(succ(n), a, s), R[0]))
    by exact specNext
  obtain ⟨_, memberNext, _, limitNext⟩ := specNextCopy
  have integrand := hurwitzIntegrand.function at n, a, s with hs
  have values : ComplexValuedOn(hurwitzIntegrand(n, a, s), ℝ)
    intros Y yMember
    exact FunctionBetween.apply_closed with integrand, yMember
  have zeroMember : R[0] ∈ ℝ by typecheck
  have primitiveZero := periodicBernoulliPrimitive.real at n, R[0]
  have powerZero := realCpow.member at R[0 + a], ℂ[-s - complexOfReal(realNat(n))] with exponent
  have limitMember : ℂ[-(complexOfReal(periodicBernoulliPrimitive(n)(R[0])) *
      realCpow(R[0 + a], ℂ[-s - complexOfReal(realNat(n))])) -
    ℂ[(-s - complexOfReal(realNat(n))) * complexOfReal(realInvValue(realNat(succ(n))))] * complexImproperIntegral(hurwitzIntegrand(succ(n), a, s), R[0])] ∈ ℂ
    by typecheck
  apply complexImproperIntegral.eq
  refine ⟨values, limitMember, ?_, ?_⟩
  . intros T tMember later
    have tReal : Real(T) by exact tMember
    exact hurwitzIntegrand.local_integrable with positive, hs, later
  intros e eMember ePositive
  have half : R[0] < R[e / 2] by linarith
  have halfReal : R[e / 2] ∈ ℝ by typecheck
  -- The integral of the next integrand.
  have scaleAbs := complexAbs.nonnegative with scale
  have scaleAbsReal := complexAbs.real with scale
  obtain ⟨D1, d1Real, d1Positive, d1Small⟩ := real.small_multiple with
    scaleAbs, half
  obtain ⟨T1, t1Real, near⟩ := limitNext with D1, d1Real, d1Positive
  -- The boundary term.
  have boundNext := bernoulliBound.real at succ(n)
  have inversePositive : R[0] < realInvValue(realNat(succ(n)))
    exact realInvValue.positive with (realNat.positive_succ at n)
  have boundNonnegative : R[0] ≤ bernoulliBound(succ(n))
    have function := periodicBernoulli.function at succ(n)
    have value := FunctionBetween.apply_closed with function, zeroMember
    have valueReal : Real(periodicBernoulli(succ(n))(R[0])) by exact value
    have bound := periodicBernoulli.bound at succ(n), R[0]
    have nonnegative := abs.nonnegative at periodicBernoulli(succ(n))(R[0])
    linarith
  have weightNonnegative := realMulValue.nonnegative with
    (realLess.implies_le with inversePositive), boundNonnegative
  obtain ⟨D2, d2Real, d2Positive, d2Small⟩ := real.small_multiple with
    weightNonnegative, half
  have decay : R[0] < R[complexRe(s) + realNat(n)]
    have nonnegative := realNat.nonnegative at n
    have two := realNat.le_of_natural_le at 2, n with large
    rw realNat.two at two
    linarith
  obtain ⟨M, mReal, mPositive, eventually⟩ := realRpow.eventually_small with
    decay, d2Positive
  have shiftedM : R[M - a] ∈ ℝ by typecheck
  obtain ⟨T0, t0Real, aboveT1, aboveM⟩ := real.exists_upper at T1, R[M - a]
  refine ⟨T0, t0Real, ?_⟩
  intros T tMember later nonnegative
  have tReal : Real(T) by exact tMember
  have finite := hurwitzIntegrand.finite_parts with positive, hs, large,
    nonnegative
  have integralN := complexIntegral.member at hurwitzIntegrand(n, a, s),
    R[0], T
  have integralNext := complexIntegral.member at
    hurwitzIntegrand(succ(n), a, s), R[0], T
  have primitiveT := periodicBernoulliPrimitive.real at n, T
  have powerT := realCpow.member at R[T + a], ℂ[-s - complexOfReal(realNat(n))] with exponent
  have scalarT := complexOfReal.mem at periodicBernoulliPrimitive(n)(T)
  have scalarZero := complexOfReal.mem at periodicBernoulliPrimitive(n)(R[0])
  have boundaryT : ℂ[complexOfReal(periodicBernoulliPrimitive(n)(T)) *
    realCpow(R[T + a], ℂ[-s - complexOfReal(realNat(n))])] ∈ ℂ by typecheck
  have differenceNext : ℂ[complexIntegral(hurwitzIntegrand(succ(n), a, s),
      R[0], T) - complexImproperIntegral(hurwitzIntegrand(succ(n), a, s),
      R[0])] ∈ ℂ by typecheck
  have scaledDifference : ℂ[ℂ[(-s - complexOfReal(realNat(n))) * complexOfReal(realInvValue(realNat(succ(n))))] * (complexIntegral(hurwitzIntegrand(succ(n),
      a, s), R[0], T) - complexImproperIntegral(hurwitzIntegrand(succ(n), a,
      s), R[0]))] ∈ ℂ by typecheck
  have shape : ℂ[complexIntegral(hurwitzIntegrand(n, a, s), R[0], T) -
      (-(complexOfReal(periodicBernoulliPrimitive(n)(R[0])) *
        realCpow(R[0 + a], ℂ[-s - complexOfReal(realNat(n))])) -
      ℂ[(-s - complexOfReal(realNat(n))) * complexOfReal(realInvValue(realNat(succ(n))))] * complexImproperIntegral(hurwitzIntegrand(succ(n), a, s), R[0]))] =
      ℂ[complexOfReal(periodicBernoulliPrimitive(n)(T)) *
        realCpow(R[T + a], ℂ[-s - complexOfReal(realNat(n))]) -
      ℂ[(-s - complexOfReal(realNat(n))) * complexOfReal(realInvValue(realNat(succ(n))))] * (complexIntegral(hurwitzIntegrand(succ(n), a, s), R[0], T) -
        complexImproperIntegral(hurwitzIntegrand(succ(n), a, s), R[0]))]
    have solved : complexIntegral(hurwitzIntegrand(n, a, s), R[0], T) =
        ℂ[complexOfReal(periodicBernoulliPrimitive(n)(T)) *
          realCpow(R[T + a], ℂ[-s - complexOfReal(realNat(n))]) -
        complexOfReal(periodicBernoulliPrimitive(n)(R[0])) *
          realCpow(R[0 + a], ℂ[-s - complexOfReal(realNat(n))]) -
        ℂ[(-s - complexOfReal(realNat(n))) * complexOfReal(realInvValue(realNat(succ(n))))] * complexIntegral(hurwitzIntegrand(succ(n), a, s), R[0], T)]
      linear_combination finite
    rw solved
    ring
  rw shape
  have triangle := complexAbs.sub_le with boundaryT, scaledDifference
  -- The boundary term is small.
  have shiftedT : R[0] < R[T + a] by linarith
  rw [(complexAbs.mul with scalarT, powerT), complexAbs.of_real,
    (realCpow.abs with shiftedT, exponent), (complexRe.neg_sub_real with hs)]
    at triangle
  have farEnough : M ≤ R[T + a] by linarith
  have small := eventually with R[T + a], farEnough
  have exponentShape : R[-(complexRe(s) + realNat(n))] =
    R[-complexRe(s) - realNat(n)] by ring
  rw exponentShape at small
  have primitiveBound : abs(periodicBernoulliPrimitive(n)(T)) ≤
      R[realInvValue(realNat(succ(n))) * bernoulliBound(succ(n))]
    have periodic := periodicBernoulli.function at succ(n)
    have periodicValue := FunctionBetween.apply_closed with periodic, tMember
    have periodicReal : Real(periodicBernoulli(succ(n))(T))
      by exact periodicValue
    rw [periodicBernoulliPrimitive.value, abs.mul,
      (abs.of_nonnegative with (realLess.implies_le with inversePositive))]
    have bound := periodicBernoulli.bound at succ(n), T
    exact realLe.mul_left_of_nonnegative with bound,
      (realLess.implies_le with inversePositive)
  have powerPositive := realRpow.positive at R[T + a],
    R[-complexRe(s) - realNat(n)]
  have absNonnegative := abs.nonnegative at periodicBernoulliPrimitive(n)(T)
  have first := realLe.mul_right_of_nonnegative with primitiveBound,
    (realLess.implies_le with powerPositive)
  have second := realLe.mul_left_of_nonnegative with
    (realLess.implies_le with small), weightNonnegative
  have close := near with T, tMember, (realLe.transitive with aboveT1, later),
    nonnegative
  have differenceAbs := complexAbs.nonnegative with differenceNext
  rw (complexAbs.mul with scale, differenceNext) at triangle
  have third := realLe.mul_left_of_nonnegative with
    (realLess.implies_le with close), scaleAbs
  linarith

-- The remainder of order m is that of order m + 1 less the next term of
-- the boundary sum (two integrations by parts; B_{2m+1} = 0).
theorem hurwitzRemainder.step (m : Nat) (s : Set) (a : Real)
  requires positive : R[0] < a
  requires hs : s ∈ ℂ
  requires positiveM : 1 ≤ m
  requires halfPlane : R[1 - 2 * realNat(m)] < complexRe(s)
  shows hurwitzRemainder(m, s, a) =
    ℂ[hurwitzRemainder(succ(m), s, a) - hurwitzCorrectionTerms(s, a)(m)]
proof
  have large : 2 ≤ 2 * m by arith
  have largeNext : 2 ≤ succ(2 * m) by arith
  have succNat : Nat(succ(m)) by typecheck
  have twoNext : 2 * succ(m) = succ(succ(2 * m)) by arith
  have indexOdd : 2 * m + 1 = succ(2 * m) by arith
  have indexEven : 2 * m + 2 = succ(succ(2 * m)) by arith
  have reReal := complexRe.real with hs
  have doubled : realNat(2 * m) = R[2 * realNat(m)]
    rw [realNat.mul, realNat.two]
  have halfN : R[1 - realNat(2 * m)] < complexRe(s)
    rw doubled
    exact halfPlane
  have halfNext : R[1 - realNat(succ(2 * m))] < complexRe(s)
    rw realNat.succ_value
    have nonnegative := realNat.nonnegative at 2 * m
    linarith
  have stepN := hurwitzIntegrand.improper_parts at 2 * m, a, s with positive,
    hs, large, halfN
  have stepNext := hurwitzIntegrand.improper_parts at succ(2 * m), a, s with
    positive, hs, largeNext, halfNext
  -- The boundary values P̃ₖ(0) = Bₖ.
  have zeroInteger : Integer(integerOfNat(0)) by typecheck
  have atZeroOdd := periodicBernoulli.at_integer at succ(2 * m),
    integerOfNat(0)
  have atZeroEven := periodicBernoulli.at_integer at succ(succ(2 * m)),
    integerOfNat(0)
  rw [realInt.nat, realNat.zero] at atZeroOdd
  rw [realInt.nat, realNat.zero] at atZeroEven
  have oddZero : bernoulli(succ(2 * m)) = (0:R)
    obtain zero | ⟨k, kNat, same⟩ := natural.zero_or_successor at m
    . exfalso
      arith
    . have index : 2 * k + 3 = succ(2 * m) by arith
      have odd := bernoulli.odd at k
      rwa index at odd
  have inverseOdd := realInvValue.real at realNat(succ(2 * m))
  have inverseEven := realInvValue.real at realNat(succ(succ(2 * m)))
  have primitiveOdd : periodicBernoulliPrimitive(2 * m)(R[0]) = (0:R)
    rw [periodicBernoulliPrimitive.value, atZeroOdd, oddZero]
    ring
  rw [primitiveOdd, complexOfReal.zero] at stepN
  rw [periodicBernoulliPrimitive.value, atZeroEven] at stepNext
  -- The factorials and their inverses.
  have factorialOdd := realNat.factorial_succ at 2 * m
  rw [indexOdd, ← realNat.succ_value] at factorialOdd
  have factorialEven := realNat.factorial_succ at succ(2 * m)
  rw [(add.right_one at succ(2 * m)), ← realNat.succ_value] at factorialEven
  rw factorialOdd at factorialEven
  have factorialNonzero := realNat.factorial_nonzero at 2 * m
  have oddNatNonzero : succ(2 * m) ≠ (0:N) by arith
  have evenNatNonzero : succ(succ(2 * m)) ≠ (0:N) by arith
  have oddNonzero := realNat.ne_zero with oddNatNonzero
  have evenNonzero := realNat.ne_zero with evenNatNonzero
  have productReal : Real(R[realNat(succ(succ(2 * m))) *
    (realNat(succ(2 * m)) * realNat((2 * m)!))]) by typecheck
  have productNonzero : R[realNat(succ(succ(2 * m))) *
      (realNat(succ(2 * m)) * realNat((2 * m)!))] ≠ R[0]
    rw ← factorialEven
    exact realNat.factorial_nonzero at succ(succ(2 * m))
  have factorialMember : complexOfReal(realNat((2 * m)!)) ∈ ℂ by typecheck
  have oddMember : complexOfReal(realNat(succ(2 * m))) ∈ ℂ by typecheck
  have evenMember : complexOfReal(realNat(succ(succ(2 * m)))) ∈ ℂ
    by typecheck
  have bernoulliReal := bernoulli.real at succ(succ(2 * m))
  have bernoulliMember : complexOfReal(bernoulli(succ(succ(2 * m)))) ∈ ℂ
    by typecheck
  have inverseFirst : complexOfReal(R[1 / realNat((2 * m)!)]) =
      complexInv(complexOfReal(realNat((2 * m)!)))
    rw (complexInv.of_real with factorialNonzero)
  have inverseLast : complexOfReal(R[1 / realNat(succ(succ(2 * m))!)]) =
      ℂ[complexInv(complexOfReal(realNat(succ(succ(2 * m))))) *
        complexInv(complexOfReal(realNat(succ(2 * m)))) *
        complexInv(complexOfReal(realNat((2 * m)!)))]
    rw [factorialEven, ← (complexInv.of_real with productNonzero),
      complexOfReal.mul, complexOfReal.mul]
    have inner : ℂ[complexOfReal(realNat(succ(2 * m))) *
      complexOfReal(realNat((2 * m)!))] ∈ ℂ by typecheck
    rw [(complexInv.mul with evenMember, inner),
      (complexInv.mul with oddMember, factorialMember)]
    ring
  have coefficient : complexOfReal(R[bernoulli(succ(succ(2 * m))) /
      realNat(succ(succ(2 * m))!)]) =
      ℂ[complexOfReal(bernoulli(succ(succ(2 * m)))) *
        complexInv(complexOfReal(realNat(succ(succ(2 * m))))) *
        complexInv(complexOfReal(realNat(succ(2 * m)))) *
        complexInv(complexOfReal(realNat((2 * m)!)))]
    have quotient : R[bernoulli(succ(succ(2 * m))) /
        realNat(succ(succ(2 * m))!)] =
        R[bernoulli(succ(succ(2 * m))) * (1 / realNat(succ(succ(2 * m))!))]
      rw [realDiv.eq_mul_inv, realDiv.eq_mul_inv]
      have inverseReal := realInvValue.real at realNat(succ(succ(2 * m))!)
      ring
    rw [quotient, complexOfReal.mul, inverseLast]
    ring
  have inverseOddValue := complexOfReal.inv at realNat(succ(2 * m)) with
    oddNonzero
  have inverseEvenValue := complexOfReal.inv at realNat(succ(succ(2 * m)))
    with evenNonzero
  have weighted : complexOfReal(R[realInvValue(realNat(succ(succ(2 * m)))) *
      bernoulli(succ(succ(2 * m)))]) =
      ℂ[complexInv(complexOfReal(realNat(succ(succ(2 * m))))) *
        complexOfReal(bernoulli(succ(succ(2 * m))))]
    rw [complexOfReal.mul, inverseEvenValue]
  -- The rising factorials.
  have risingOdd := risingFactorial.succ at s, 2 * m
  have risingEven := risingFactorial.succ at s, succ(2 * m)
  rw risingOdd at risingEven
  have origin : R[0 + a] = a by ring
  rw [inverseOddValue, origin] at stepN
  rw [weighted, inverseEvenValue, origin] at stepNext
  unfold hurwitzRemainder
  rw [twoNext, (hurwitzCorrectionTerms.value at s, a, m with hs), indexOdd,
    indexEven, inverseFirst, inverseLast, coefficient, risingOdd, risingEven,
    stepN, stepNext]
  have rising := risingFactorial.closed at s, 2 * m with hs
  have nMember : complexOfReal(realNat(2 * m)) ∈ ℂ by typecheck
  have powerMember := realCpow.member at a,
    ℂ[-s - complexOfReal(realNat(succ(2 * m)))]
  have powerZero := realCpow.member at a, ℂ[-s - complexOfReal(realNat(2 * m))]
  have integralMember := complexImproperIntegral.member at
    hurwitzIntegrand(succ(succ(2 * m)), a, s), R[0]
  have inverseFactorial := complexInv.member with factorialMember
  have inverseOddMember := complexInv.member with oddMember
  have inverseEvenMember := complexInv.member with evenMember
  ring

-- A real function equal to a part of c (x + a)^w on x > −a has the
-- derivative of that part there.
theorem scaledPower.derivative_agree (f c : Set) (a X : Real) (w : Set)
  requires hc : c ∈ ℂ
  requires hw : w ∈ ℂ
  requires function : f : ℝ → ℝ
  requires positive : R[0] < R[X + a]
  requires agreeRe : ∀ Y ∈ ℝ, R[0] < R[Y + a] →
    f(Y) = complexFunctionRe(scaledPower(c, a, w))(Y)
  shows HasDerivativeAt(f, complexFunctionRe(scaledPower(ℂ[c * w], a,
    ℂ[w - 1]))(X), X)
proof
  have power := scaledPower.function at c, a, w with hc, hw
  have values : ComplexValuedOn(scaledPower(c, a, w), ℝ)
    intros Y yMember
    exact FunctionBetween.apply_closed with power, yMember
  have product : ℂ[c * w] ∈ ℂ by typecheck
  have lowered : ℂ[w - 1] ∈ ℂ by typecheck
  have next := scaledPower.function at ℂ[c * w], a, ℂ[w - 1] with product,
    lowered
  have nextValues : ComplexValuedOn(scaledPower(ℂ[c * w], a, ℂ[w - 1]), ℝ)
    intros Y yMember
    exact FunctionBetween.apply_closed with next, yMember
  have functionRe := complexFunctionRe.function with values
  obtain ⟨derivative, _⟩ := scaledPower.has_derivative at c, a, X, w with hc,
    hw, positive
  rw [← (scaledPower.value at ℂ[c * w], a, ℂ[w - 1], X with product, lowered),
    ← (complexFunctionRe.apply with nextValues)] at derivative
  have below : R[-a] < X by linarith
  have above : X < R[X + 1] by linarith
  have agree : ∀ x ∈ openInterval(R[-a], R[X + 1]),
      f(x) = complexFunctionRe(scaledPower(c, a, w))(x)
    intros x xMember
    obtain ⟨xReal, lower, _⟩ := openInterval.membership.forward with xMember
    have xTyped : Real(x) by exact xReal
    have shifted : R[0] < R[x + a] by linarith
    exact agreeRe with x, xReal, shifted
  have equivalent := HasDerivativeAt.local_iff at f,
    complexFunctionRe(scaledPower(c, a, w)),
    complexFunctionRe(scaledPower(ℂ[c * w], a, ℂ[w - 1]))(X), X, R[-a],
    R[X + 1] with function, functionRe, below, above, agree
  exact equivalent.backward with derivative

theorem scaledPower.derivative_agree_im (f c : Set) (a X : Real) (w : Set)
  requires hc : c ∈ ℂ
  requires hw : w ∈ ℂ
  requires function : f : ℝ → ℝ
  requires positive : R[0] < R[X + a]
  requires agreeIm : ∀ Y ∈ ℝ, R[0] < R[Y + a] →
    f(Y) = complexFunctionIm(scaledPower(c, a, w))(Y)
  shows HasDerivativeAt(f, complexFunctionIm(scaledPower(ℂ[c * w], a,
    ℂ[w - 1]))(X), X)
proof
  have power := scaledPower.function at c, a, w with hc, hw
  have values : ComplexValuedOn(scaledPower(c, a, w), ℝ)
    intros Y yMember
    exact FunctionBetween.apply_closed with power, yMember
  have product : ℂ[c * w] ∈ ℂ by typecheck
  have lowered : ℂ[w - 1] ∈ ℂ by typecheck
  have next := scaledPower.function at ℂ[c * w], a, ℂ[w - 1] with product,
    lowered
  have nextValues : ComplexValuedOn(scaledPower(ℂ[c * w], a, ℂ[w - 1]), ℝ)
    intros Y yMember
    exact FunctionBetween.apply_closed with next, yMember
  have functionIm := complexFunctionIm.function with values
  obtain ⟨_, derivative⟩ := scaledPower.has_derivative at c, a, X, w with hc,
    hw, positive
  rw [← (scaledPower.value at ℂ[c * w], a, ℂ[w - 1], X with product, lowered),
    ← (complexFunctionIm.apply with nextValues)] at derivative
  have below : R[-a] < X by linarith
  have above : X < R[X + 1] by linarith
  have agree : ∀ x ∈ openInterval(R[-a], R[X + 1]),
      f(x) = complexFunctionIm(scaledPower(c, a, w))(x)
    intros x xMember
    obtain ⟨xReal, lower, _⟩ := openInterval.membership.forward with xMember
    have xTyped : Real(x) by exact xReal
    have shifted : R[0] < R[x + a] by linarith
    exact agreeIm with x, xReal, shifted
  have equivalent := HasDerivativeAt.local_iff at f,
    complexFunctionIm(scaledPower(c, a, w)),
    complexFunctionIm(scaledPower(ℂ[c * w], a, ℂ[w - 1]))(X), X, R[-a],
    R[X + 1] with function, functionIm, below, above, agree
  exact equivalent.backward with derivative

-- The Re part of c (x + a)^w is of class C² on [0, B], with its first two
-- derivatives the Re parts of the derivatives of c (x + a)^w.
theorem scaledPower.smooth_re (c : Set) (a B : Real) (w : Set)
  requires hc : c ∈ ℂ
  requires hw : w ∈ ℂ
  requires positive : R[0] < a
  requires nonnegative : R[0] ≤ B
  shows ContinuouslyDifferentiableOn(complexFunctionRe(scaledPower(c, a, w)), 2,
      R[0], B) ∧
    (∀ X ∈ ℝ, R[0] < R[X + a] →
      iteratedDerivative(complexFunctionRe(scaledPower(c, a, w)), 1)(X) =
        complexFunctionRe(scaledPower(ℂ[c * w], a, ℂ[w - 1]))(X)) ∧
    (∀ X ∈ ℝ, R[0] < R[X + a] →
      iteratedDerivative(complexFunctionRe(scaledPower(c, a, w)), 2)(X) =
        complexFunctionRe(scaledPower(ℂ[c * w * (w - 1)], a, ℂ[w - 1 - 1]))(X))
proof
  have power := scaledPower.function at c, a, w with hc, hw
  have values : ComplexValuedOn(scaledPower(c, a, w), ℝ)
    intros Y yMember
    exact FunctionBetween.apply_closed with power, yMember
  have function := complexFunctionRe.function with values
  have product : ℂ[c * w] ∈ ℂ by typecheck
  have lowered : ℂ[w - 1] ∈ ℂ by typecheck
  have productNext : ℂ[c * w * (w - 1)] ∈ ℂ by typecheck
  have loweredNext : ℂ[w - 1 - 1] ∈ ℂ by typecheck
  have next := scaledPower.function at ℂ[c * w], a, ℂ[w - 1] with product,
    lowered
  have nextValues : ComplexValuedOn(scaledPower(ℂ[c * w], a, ℂ[w - 1]), ℝ)
    intros Y yMember
    exact FunctionBetween.apply_closed with next, yMember
  have nextPart := complexFunctionRe.function with nextValues
  have later := scaledPower.function at ℂ[c * w * (w - 1)], a, ℂ[w - 1 - 1]
    with productNext, loweredNext
  have laterValues : ComplexValuedOn(scaledPower(ℂ[c * w * (w - 1)], a,
      ℂ[w - 1 - 1]), ℝ)
    intros Y yMember
    exact FunctionBetween.apply_closed with later, yMember
  have laterPart := complexFunctionRe.function with laterValues
  have self : ∀ Y ∈ ℝ, R[0] < R[Y + a] →
      complexFunctionRe(scaledPower(c, a, w))(Y) =
        complexFunctionRe(scaledPower(c, a, w))(Y)
    intros Y yMember shifted
    rfl
  have firstDerivative : ∀ X ∈ ℝ, R[0] < R[X + a] →
      HasDerivativeAt(complexFunctionRe(scaledPower(c, a, w)),
        complexFunctionRe(scaledPower(ℂ[c * w], a, ℂ[w - 1]))(X), X)
    intros X xMember shifted
    have xReal : Real(X) by exact xMember
    exact scaledPower.derivative_agree with hc, hw, function, shifted, self
  have oneIndex := natural.one_succ
  have twoIndex := natural.two_succ
  have firstValue : ∀ X ∈ ℝ, R[0] < R[X + a] →
      iteratedDerivative(complexFunctionRe(scaledPower(c, a, w)), 1)(X) =
        complexFunctionRe(scaledPower(ℂ[c * w], a, ℂ[w - 1]))(X)
    intros X xMember shifted
    have xReal : Real(X) by exact xMember
    have nextValue := FunctionBetween.apply_closed with nextPart, xMember
    rw [oneIndex, iteratedDerivative, iteratedDerivative]
    exact derivative.of_has_derivative with
      (firstDerivative with X, xMember, shifted)
  have firstFunction := iteratedDerivative.function at
    complexFunctionRe(scaledPower(c, a, w)), 1 with function
  have secondDerivative : ∀ X ∈ ℝ, R[0] < R[X + a] →
      HasDerivativeAt(iteratedDerivative(complexFunctionRe(scaledPower(c, a, w)),
        1), complexFunctionRe(scaledPower(ℂ[c * w * (w - 1)], a,
        ℂ[w - 1 - 1]))(X), X)
    intros X xMember shifted
    have xReal : Real(X) by exact xMember
    exact scaledPower.derivative_agree with product, lowered, firstFunction, shifted,
      firstValue
  have secondValue : ∀ X ∈ ℝ, R[0] < R[X + a] →
      iteratedDerivative(complexFunctionRe(scaledPower(c, a, w)), 2)(X) =
        complexFunctionRe(scaledPower(ℂ[c * w * (w - 1)], a, ℂ[w - 1 - 1]))(X)
    intros X xMember shifted
    have xReal : Real(X) by exact xMember
    have laterValue := FunctionBetween.apply_closed with laterPart, xMember
    rw [twoIndex, iteratedDerivative]
    exact derivative.of_has_derivative with
      (secondDerivative with X, xMember, shifted)
  have secondFunction := iteratedDerivative.function at
    complexFunctionRe(scaledPower(c, a, w)), 2 with function
  have thirdDerivative : ∀ X ∈ ℝ, R[0] < R[X + a] →
      HasDerivativeAt(iteratedDerivative(complexFunctionRe(scaledPower(c, a, w)),
        2), complexFunctionRe(scaledPower(ℂ[c * w * (w - 1) * (w - 1 - 1)], a,
        ℂ[w - 1 - 1 - 1]))(X), X)
    intros X xMember shifted
    have xReal : Real(X) by exact xMember
    exact scaledPower.derivative_agree with productNext, loweredNext, secondFunction,
      shifted, secondValue
  refine ⟨⟨function, ?_, ?_⟩, firstValue, secondValue⟩
  . intros k kMember below X xMember
    obtain ⟨xReal, lower, _⟩ := closedInterval.membership.forward with xMember
    have xTyped : Real(X) by exact xReal
    have shifted : R[0] < R[X + a] by linarith
    have kNat := nat.omega.backward with kMember
    by_cases zero : k = (0:N)
    . rw [zero, iteratedDerivative.zero]
      exact HasDerivativeAt.differentiable_at with
        (firstDerivative with X, xReal, shifted)
    . have same : k = (1:N) by arith
      rw same
      exact HasDerivativeAt.differentiable_at with
        (secondDerivative with X, xReal, shifted)
  . have subset := closedInterval.subset_reals at R[0], B
    have productLast : ℂ[c * w * (w - 1) * (w - 1 - 1)] ∈ ℂ by typecheck
    have loweredLast : ℂ[w - 1 - 1 - 1] ∈ ℂ by typecheck
    have last := scaledPower.function at ℂ[c * w * (w - 1) * (w - 1 - 1)], a,
      ℂ[w - 1 - 1 - 1] with productLast, loweredLast
    have lastValues : ComplexValuedOn(scaledPower(ℂ[c * w * (w - 1) *
        (w - 1 - 1)], a, ℂ[w - 1 - 1 - 1]), ℝ)
      intros Y yMember
      exact FunctionBetween.apply_closed with last, yMember
    have lastPart := complexFunctionRe.function with lastValues
    apply ContinuousOn.of_differentiable with secondFunction, subset
    intros X xMember
    obtain ⟨xReal, lower, _⟩ := closedInterval.membership.forward with xMember
    have xTyped : Real(X) by exact xReal
    have shifted : R[0] < R[X + a] by linarith
    have lastValue := FunctionBetween.apply_closed with lastPart, xReal
    exact HasDerivativeAt.differentiable_at with
      (thirdDerivative with X, xReal, shifted)

-- The Im part of c (x + a)^w is of class C² on [0, B], with its first two
-- derivatives the Im parts of the derivatives of c (x + a)^w.
theorem scaledPower.smooth_im (c : Set) (a B : Real) (w : Set)
  requires hc : c ∈ ℂ
  requires hw : w ∈ ℂ
  requires positive : R[0] < a
  requires nonnegative : R[0] ≤ B
  shows ContinuouslyDifferentiableOn(complexFunctionIm(scaledPower(c, a, w)), 2,
      R[0], B) ∧
    (∀ X ∈ ℝ, R[0] < R[X + a] →
      iteratedDerivative(complexFunctionIm(scaledPower(c, a, w)), 1)(X) =
        complexFunctionIm(scaledPower(ℂ[c * w], a, ℂ[w - 1]))(X)) ∧
    (∀ X ∈ ℝ, R[0] < R[X + a] →
      iteratedDerivative(complexFunctionIm(scaledPower(c, a, w)), 2)(X) =
        complexFunctionIm(scaledPower(ℂ[c * w * (w - 1)], a, ℂ[w - 1 - 1]))(X))
proof
  have power := scaledPower.function at c, a, w with hc, hw
  have values : ComplexValuedOn(scaledPower(c, a, w), ℝ)
    intros Y yMember
    exact FunctionBetween.apply_closed with power, yMember
  have function := complexFunctionIm.function with values
  have product : ℂ[c * w] ∈ ℂ by typecheck
  have lowered : ℂ[w - 1] ∈ ℂ by typecheck
  have productNext : ℂ[c * w * (w - 1)] ∈ ℂ by typecheck
  have loweredNext : ℂ[w - 1 - 1] ∈ ℂ by typecheck
  have next := scaledPower.function at ℂ[c * w], a, ℂ[w - 1] with product,
    lowered
  have nextValues : ComplexValuedOn(scaledPower(ℂ[c * w], a, ℂ[w - 1]), ℝ)
    intros Y yMember
    exact FunctionBetween.apply_closed with next, yMember
  have nextPart := complexFunctionIm.function with nextValues
  have later := scaledPower.function at ℂ[c * w * (w - 1)], a, ℂ[w - 1 - 1]
    with productNext, loweredNext
  have laterValues : ComplexValuedOn(scaledPower(ℂ[c * w * (w - 1)], a,
      ℂ[w - 1 - 1]), ℝ)
    intros Y yMember
    exact FunctionBetween.apply_closed with later, yMember
  have laterPart := complexFunctionIm.function with laterValues
  have self : ∀ Y ∈ ℝ, R[0] < R[Y + a] →
      complexFunctionIm(scaledPower(c, a, w))(Y) =
        complexFunctionIm(scaledPower(c, a, w))(Y)
    intros Y yMember shifted
    rfl
  have firstDerivative : ∀ X ∈ ℝ, R[0] < R[X + a] →
      HasDerivativeAt(complexFunctionIm(scaledPower(c, a, w)),
        complexFunctionIm(scaledPower(ℂ[c * w], a, ℂ[w - 1]))(X), X)
    intros X xMember shifted
    have xReal : Real(X) by exact xMember
    exact scaledPower.derivative_agree_im with hc, hw, function, shifted, self
  have oneIndex := natural.one_succ
  have twoIndex := natural.two_succ
  have firstValue : ∀ X ∈ ℝ, R[0] < R[X + a] →
      iteratedDerivative(complexFunctionIm(scaledPower(c, a, w)), 1)(X) =
        complexFunctionIm(scaledPower(ℂ[c * w], a, ℂ[w - 1]))(X)
    intros X xMember shifted
    have xReal : Real(X) by exact xMember
    have nextValue := FunctionBetween.apply_closed with nextPart, xMember
    rw [oneIndex, iteratedDerivative, iteratedDerivative]
    exact derivative.of_has_derivative with
      (firstDerivative with X, xMember, shifted)
  have firstFunction := iteratedDerivative.function at
    complexFunctionIm(scaledPower(c, a, w)), 1 with function
  have secondDerivative : ∀ X ∈ ℝ, R[0] < R[X + a] →
      HasDerivativeAt(iteratedDerivative(complexFunctionIm(scaledPower(c, a, w)),
        1), complexFunctionIm(scaledPower(ℂ[c * w * (w - 1)], a,
        ℂ[w - 1 - 1]))(X), X)
    intros X xMember shifted
    have xReal : Real(X) by exact xMember
    exact scaledPower.derivative_agree_im with product, lowered, firstFunction, shifted,
      firstValue
  have secondValue : ∀ X ∈ ℝ, R[0] < R[X + a] →
      iteratedDerivative(complexFunctionIm(scaledPower(c, a, w)), 2)(X) =
        complexFunctionIm(scaledPower(ℂ[c * w * (w - 1)], a, ℂ[w - 1 - 1]))(X)
    intros X xMember shifted
    have xReal : Real(X) by exact xMember
    have laterValue := FunctionBetween.apply_closed with laterPart, xMember
    rw [twoIndex, iteratedDerivative]
    exact derivative.of_has_derivative with
      (secondDerivative with X, xMember, shifted)
  have secondFunction := iteratedDerivative.function at
    complexFunctionIm(scaledPower(c, a, w)), 2 with function
  have thirdDerivative : ∀ X ∈ ℝ, R[0] < R[X + a] →
      HasDerivativeAt(iteratedDerivative(complexFunctionIm(scaledPower(c, a, w)),
        2), complexFunctionIm(scaledPower(ℂ[c * w * (w - 1) * (w - 1 - 1)], a,
        ℂ[w - 1 - 1 - 1]))(X), X)
    intros X xMember shifted
    have xReal : Real(X) by exact xMember
    exact scaledPower.derivative_agree_im with productNext, loweredNext, secondFunction,
      shifted, secondValue
  refine ⟨⟨function, ?_, ?_⟩, firstValue, secondValue⟩
  . intros k kMember below X xMember
    obtain ⟨xReal, lower, _⟩ := closedInterval.membership.forward with xMember
    have xTyped : Real(X) by exact xReal
    have shifted : R[0] < R[X + a] by linarith
    have kNat := nat.omega.backward with kMember
    by_cases zero : k = (0:N)
    . rw [zero, iteratedDerivative.zero]
      exact HasDerivativeAt.differentiable_at with
        (firstDerivative with X, xReal, shifted)
    . have same : k = (1:N) by arith
      rw same
      exact HasDerivativeAt.differentiable_at with
        (secondDerivative with X, xReal, shifted)
  . have subset := closedInterval.subset_reals at R[0], B
    have productLast : ℂ[c * w * (w - 1) * (w - 1 - 1)] ∈ ℂ by typecheck
    have loweredLast : ℂ[w - 1 - 1 - 1] ∈ ℂ by typecheck
    have last := scaledPower.function at ℂ[c * w * (w - 1) * (w - 1 - 1)], a,
      ℂ[w - 1 - 1 - 1] with productLast, loweredLast
    have lastValues : ComplexValuedOn(scaledPower(ℂ[c * w * (w - 1) *
        (w - 1 - 1)], a, ℂ[w - 1 - 1 - 1]), ℝ)
      intros Y yMember
      exact FunctionBetween.apply_closed with last, yMember
    have lastPart := complexFunctionIm.function with lastValues
    apply ContinuousOn.of_differentiable with secondFunction, subset
    intros X xMember
    obtain ⟨xReal, lower, _⟩ := closedInterval.membership.forward with xMember
    have xTyped : Real(X) by exact xReal
    have shifted : R[0] < R[X + a] by linarith
    have lastValue := FunctionBetween.apply_closed with lastPart, xReal
    exact HasDerivativeAt.differentiable_at with
      (thirdDerivative with X, xReal, shifted)

-- The complex iterated derivatives of c (x + a)^w, for x > −a.
theorem scaledPower.iterated (c : Set) (a X : Real) (w : Set)
  requires hc : c ∈ ℂ
  requires hw : w ∈ ℂ
  requires positive : R[0] < a
  requires shifted : R[0] < R[X + a]
  shows complexIteratedDeriv(scaledPower(c, a, w), 0)(X) =
      scaledPower(c, a, w)(X) ∧
    complexIteratedDeriv(scaledPower(c, a, w), 1)(X) =
      scaledPower(ℂ[c * w], a, ℂ[w - 1])(X) ∧
    complexIteratedDeriv(scaledPower(c, a, w), 2)(X) =
      scaledPower(ℂ[c * w * (w - 1)], a, ℂ[w - 1 - 1])(X)
proof
  have power := scaledPower.function at c, a, w with hc, hw
  have values : ComplexValuedOn(scaledPower(c, a, w), ℝ)
    intros Y yMember
    exact FunctionBetween.apply_closed with power, yMember
  have product : ℂ[c * w] ∈ ℂ by typecheck
  have lowered : ℂ[w - 1] ∈ ℂ by typecheck
  have productNext : ℂ[c * w * (w - 1)] ∈ ℂ by typecheck
  have loweredNext : ℂ[w - 1 - 1] ∈ ℂ by typecheck
  have next := scaledPower.function at ℂ[c * w], a, ℂ[w - 1] with product,
    lowered
  have later := scaledPower.function at ℂ[c * w * (w - 1)], a, ℂ[w - 1 - 1]
    with productNext, loweredNext
  have xMember : X ∈ ℝ by typecheck
  have reflexive : R[0] ≤ R[0] by linarith
  obtain ⟨_, firstRe, secondRe⟩ := scaledPower.smooth_re at c, a, R[0], w
    with hc, hw, positive, reflexive
  obtain ⟨_, firstIm, secondIm⟩ := scaledPower.smooth_im at c, a, R[0], w
    with hc, hw, positive, reflexive
  have nextValues : ComplexValuedOn(scaledPower(ℂ[c * w], a, ℂ[w - 1]), ℝ)
    intros Y yMember
    exact FunctionBetween.apply_closed with next, yMember
  have laterValues : ComplexValuedOn(scaledPower(ℂ[c * w * (w - 1)], a,
      ℂ[w - 1 - 1]), ℝ)
    intros Y yMember
    exact FunctionBetween.apply_closed with later, yMember
  have atX := values with X, xMember
  have nextX := nextValues with X, xMember
  have laterX := laterValues with X, xMember
  refine ⟨?_, ?_, ?_⟩
  . rw [(complexIteratedDeriv.value at scaledPower(c, a, w), 0, X with values),
      iteratedDerivative.zero, iteratedDerivative.zero,
      (complexFunctionRe.apply with values),
      (complexFunctionIm.apply with values)]
    symm
    exact complex.ext with atX
  . rw [(complexIteratedDeriv.value at scaledPower(c, a, w), 1, X with values),
      (firstRe with X, xMember, shifted), (firstIm with X, xMember, shifted),
      (complexFunctionRe.apply with nextValues),
      (complexFunctionIm.apply with nextValues)]
    symm
    exact complex.ext with nextX
  . rw [(complexIteratedDeriv.value at scaledPower(c, a, w), 2, X with values),
      (secondRe with X, xMember, shifted), (secondIm with X, xMember, shifted),
      (complexFunctionRe.apply with laterValues),
      (complexFunctionIm.apply with laterValues)]
    symm
    exact complex.ext with laterX

-- Complex integrals of functions agreeing inside [A, B] agree.
theorem complexIntegral.congr_interior (f g : Set) (A B : Real)
  requires integrable : ComplexRiemannIntegrable(g, A, B)
  requires values : ComplexValuedOn(f, ℝ)
  requires agree : ∀ X ∈ ℝ, A < X → X < B → f(X) = g(X)
  shows ComplexRiemannIntegrable(f, A, B) ∧
    complexIntegral(f, A, B) = complexIntegral(g, A, B)
proof
  obtain ⟨valuesG, integrableRe, integrableIm⟩ := integrable
  have functionRe := complexFunctionRe.function with values
  have functionIm := complexFunctionIm.function with values
  have agreeRe : ∀ X ∈ ℝ, A < X → X < B →
      complexFunctionRe(f)(X) = complexFunctionRe(g)(X)
    intros X xMember lower upper
    have xReal : Real(X) by exact xMember
    rw [(complexFunctionRe.apply with values),
      (complexFunctionRe.apply with valuesG), (agree with X, xMember, lower,
      upper)]
  have agreeIm : ∀ X ∈ ℝ, A < X → X < B →
      complexFunctionIm(f)(X) = complexFunctionIm(g)(X)
    intros X xMember lower upper
    have xReal : Real(X) by exact xMember
    rw [(complexFunctionIm.apply with values),
      (complexFunctionIm.apply with valuesG), (agree with X, xMember, lower,
      upper)]
  have integralRe := HasRiemannIntegral.congr_interior with
    (riemannIntegral.integral with integrableRe), functionRe, agreeRe
  have integralIm := HasRiemannIntegral.congr_interior with
    (riemannIntegral.integral with integrableIm), functionIm, agreeIm
  have valueRe := riemannIntegral.eq_of_integral with integralRe
  have valueIm := riemannIntegral.eq_of_integral with integralIm
  obtain ⟨realRe, _⟩ := riemannIntegral.selected at complexFunctionRe(g), A, B
  obtain ⟨realIm, _⟩ := riemannIntegral.selected at complexFunctionIm(g), A, B
  refine ⟨⟨values, ⟨riemannIntegral(complexFunctionRe(g), A, B), realRe,
    integralRe⟩, ⟨riemannIntegral(complexFunctionIm(g), A, B), realIm,
    integralIm⟩⟩, ?_⟩
  unfold complexIntegral
  rw [valueRe, valueIm]

-- The finite Euler–Maclaurin formula of order 2 for Σ_{n<M} (n + a)^(−s):
-- the partial sum is H_1(s, a) plus terms that vanish as M → ∞ when
-- re s > 1.
theorem hurwitzSeries.finite (M : Nat) (s : Set) (a : Real)
  requires positive : R[0] < a
  requires hs : s ∈ ℂ
  requires notOne : s ≠ ℂ[1]
  shows complexPartialSum(hurwitzSeriesTerms(s, a), M) =
    ℂ[hurwitzEulerMaclaurin(1, s, a) +
      scaledPower(ℂ[1 * complexInv(-s + 1)], a, ℂ[-s + 1])(realNat(M)) +
      complexOfReal(R[bernoulli(1) / realNat(1!)]) *
        scaledPower(ℂ[1], a, ℂ[-s])(realNat(M)) +
      complexOfReal(R[bernoulli(2) / realNat(2!)]) *
        scaledPower(ℂ[1 * -s], a, ℂ[-s - 1])(realNat(M)) +
      complexOfReal(R[(-1) ^ 3 / realNat(2!)]) * ℂ[1 * -s * (-s - 1)] *
        (complexIntegral(hurwitzIntegrand(2, a, s), R[0], realNat(M)) -
          complexImproperIntegral(hurwitzIntegrand(2, a, s), R[0]))]
proof
  have one := complexOne.member
  have negative : ℂ[-s] ∈ ℂ by typecheck
  have power := scaledPower.function at ℂ[1], a, ℂ[-s] with one, negative
  have values : ComplexValuedOn(scaledPower(ℂ[1], a, ℂ[-s]), ℝ)
    intros Y yMember
    exact FunctionBetween.apply_closed with power, yMember
  have nonnegative := realNat.nonnegative at M
  obtain ⟨smoothRe, _, _⟩ := scaledPower.smooth_re at ℂ[1], a, realNat(M),
    ℂ[-s] with one, negative, positive, nonnegative
  obtain ⟨smoothIm, _, _⟩ := scaledPower.smooth_im at ℂ[1], a, realNat(M),
    ℂ[-s] with one, negative, positive, nonnegative
  have order : 1 ≤ 2 by arith
  have formula := eulerMaclaurin.complex at scaledPower(ℂ[1], a, ℂ[-s]), 2, M
    with order, values, smoothRe, smoothIm
  -- The values at the naturals are the terms of the series.
  have naturals := complexNaturalValues.function with values
  have terms := hurwitzSeriesTerms.function at s, a with hs
  have sameTerms : complexNaturalValues(scaledPower(ℂ[1], a, ℂ[-s])) =
      hurwitzSeriesTerms(s, a)
    apply FunctionBetween.ext with naturals, terms
    intros n nMember
    have nNat := nat.omega.backward with nMember
    have point := realCpow.member at R[realNat(n) + a], ℂ[-s] with negative
    rw [(complexNaturalValues.value with values),
      (scaledPower.value at ℂ[1], a, ℂ[-s], realNat(n) with one, negative),
      (hurwitzSeriesTerms.value at s, a, n with hs)]
    ring
  rw sameTerms at formula
  -- The integral of (x + a)^(−s).
  have reOne : ℂ[-s + 1] ≠ ℂ[0]
    intro zero
    apply notOne
    linear_combination (-1) * zero
  have mMember : realNat(M) ∈ ℝ by typecheck
  have shiftedZero : R[0] < R[0 + a] by linarith
  obtain ⟨_, integral⟩ := scaledPower.integral at ℂ[1], a, R[0], realNat(M),
    ℂ[-s] with one, negative, reOne, shiftedZero, nonnegative
  rw integral at formula
  -- The two boundary terms.
  have twoIndex := natural.two_succ
  have oneIndex := natural.one_succ
  have emTerms := complexEulerMaclaurinTerms.function at
    scaledPower(ℂ[1], a, ℂ[-s]), R[0], realNat(M) with values
  have emSequence : ComplexSequence(complexEulerMaclaurinTerms(
    scaledPower(ℂ[1], a, ℂ[-s]), R[0], realNat(M))) by exact emTerms
  have zeroNatural : (0:N) ∈ ℕ := nat.omega.forward at (0:N) with *
  have oneNatural : (1:N) ∈ ℕ := nat.omega.forward at (1:N) with *
  rw [twoIndex, complexPartialSum.succ, oneIndex, complexPartialSum.succ,
    complexPartialSum.zero] at formula
  rw [(complexEulerMaclaurinTerms.value at scaledPower(ℂ[1], a, ℂ[-s]), R[0],
      realNat(M), 0 with values),
    (complexEulerMaclaurinTerms.value at scaledPower(ℂ[1], a, ℂ[-s]), R[0],
      realNat(M), succ(0) with values)] at formula
  rw [natural.zero_add_one, natural.one_add_one] at formula
  have shiftedM : R[0] < R[realNat(M) + a] by linarith
  obtain ⟨atM0, atM1, atM2⟩ := scaledPower.iterated at ℂ[1], a, realNat(M),
    ℂ[-s] with one, negative, positive, shiftedM
  obtain ⟨atZero0, atZero1, _⟩ := scaledPower.iterated at ℂ[1], a, R[0],
    ℂ[-s] with one, negative, positive, shiftedZero
  rw [atM0, atM1, atZero0, atZero1] at formula
  -- The remainder integrand is s(s + 1) P̃₂(x)(x + a)^(−s−2) for x ≥ 0.
  have productTwo : ℂ[1 * -s * (-s - 1)] ∈ ℂ by typecheck
  have local := hurwitzIntegrand.local_integrable at 2, a, realNat(M), s with
    positive, hs, nonnegative
  obtain ⟨scaledIntegrable, scaledValue⟩ := complexIntegral.const_mul at
    ℂ[1 * -s * (-s - 1)], hurwitzIntegrand(2, a, s), R[0], realNat(M) with
    productTwo, nonnegative, local
  have periodicValues : ComplexValuedOn(complexPeriodicBernoulli(2), ℝ)
    intros Y yMember
    exact FunctionBetween.apply_closed with
      (complexPeriodicBernoulli.function at 2), yMember
  have iteratedValues : ComplexValuedOn(complexIteratedDeriv(scaledPower(ℂ[1],
      a, ℂ[-s]), 2), ℝ)
    intros Y yMember
    exact FunctionBetween.apply_closed with
      (complexIteratedDeriv.function at scaledPower(ℂ[1], a, ℂ[-s]), 2 with
        values), yMember
  have remainderValues : ComplexValuedOn(complexFunctionMul(
      complexPeriodicBernoulli(2), complexIteratedDeriv(scaledPower(ℂ[1], a,
      ℂ[-s]), 2), ℝ), ℝ)
    intros Y yMember
    exact FunctionBetween.apply_closed with
      (complexFunctionMul.function with periodicValues, iteratedValues), yMember
  have constantValues : ComplexValuedOn(complexFunctionConst(
      ℂ[1 * -s * (-s - 1)], ℝ), ℝ)
    intros Y yMember
    exact FunctionBetween.apply_closed with
      (complexFunctionConst.function at ℂ[1 * -s * (-s - 1)], ℝ with
        productTwo), yMember
  have integrandValues : ComplexValuedOn(hurwitzIntegrand(2, a, s), ℝ)
    intros Y yMember
    exact FunctionBetween.apply_closed with
      (hurwitzIntegrand.function at 2, a, s with hs), yMember
  have exponentTwo : ℂ[-s - 1 - 1] = ℂ[-s - complexOfReal(realNat(2))]
    rw [realNat.two, complexOfReal.two]
    ring
  have agree : ∀ X ∈ ℝ, R[0] < X → X < realNat(M) →
      complexFunctionMul(complexPeriodicBernoulli(2),
        complexIteratedDeriv(scaledPower(ℂ[1], a, ℂ[-s]), 2), ℝ)(X) =
      complexFunctionMul(complexFunctionConst(ℂ[1 * -s * (-s - 1)], ℝ),
        hurwitzIntegrand(2, a, s), ℝ)(X)
    intros X xMember lower upper
    have xReal : Real(X) by exact xMember
    have shiftedX : R[0] < R[X + a] by linarith
    obtain ⟨_, _, atX2⟩ := scaledPower.iterated at ℂ[1], a, X, ℂ[-s] with one,
      negative, positive, shiftedX
    have periodicReal : Real(periodicBernoulli(2)(X))
      exact FunctionBetween.apply_closed with (periodicBernoulli.function at 2),
        xMember
    have powerMember := realCpow.member at R[X + a], ℂ[-s - 1 - 1]
    rw [(complexFunctionMul.value with periodicValues, iteratedValues, xMember),
      (complexFunctionMul.value with constantValues, integrandValues, xMember),
      atX2, (complexPeriodicBernoulli.value at 2, X),
      (complexFunctionConst.value with productTwo, xMember),
      (hurwitzIntegrand.value at 2, a, s, X with hs),
      (scaledPower.value at ℂ[1 * -s * (-s - 1)], a, ℂ[-s - 1 - 1], X with
        productTwo), exponentTwo]
    have bernoulliMember := complexOfReal.mem at periodicBernoulli(2)(X)
    rw exponentTwo at powerMember
    ring
  obtain ⟨_, remainderIntegral⟩ := complexIntegral.congr_interior with
    scaledIntegrable, remainderValues, agree
  rw [remainderIntegral, scaledValue] at formula
  rw formula
  -- The values at 0 and the constants.
  have exponentRaised : ℂ[-s + 1] ∈ ℂ by typecheck
  have inverseRaised := complexInv.member with exponentRaised
  have scaleRaised : ℂ[1 * complexInv(-s + 1)] ∈ ℂ by typecheck
  have productOne : ℂ[1 * -s] ∈ ℂ by typecheck
  have loweredOne : ℂ[-s - 1] ∈ ℂ by typecheck
  have origin : R[0 + a] = a by ring
  rw [(scaledPower.value at ℂ[1 * complexInv(-s + 1)], a, ℂ[-s + 1], R[0]
      with scaleRaised, exponentRaised),
    (scaledPower.value at ℂ[1], a, ℂ[-s], R[0] with one, negative),
    (scaledPower.value at ℂ[1 * -s], a, ℂ[-s - 1], R[0] with productOne,
      loweredOne), origin]
  have shiftedNonzero : ℂ[s - 1] ≠ ℂ[0]
    intro zero
    apply notOne
    linear_combination zero
  have shiftedMember : ℂ[s - 1] ∈ ℂ by typecheck
  have inverseShifted := complexInv.member with shiftedMember
  have cancel := complexInv.mul_cancel with shiftedMember, shiftedNonzero
  have flipped : complexInv(ℂ[-s + 1]) = ℂ[-complexInv(s - 1)]
    have negated : ℂ[-complexInv(s - 1)] ∈ ℂ by typecheck
    apply GRH.Exp.complexInv.unique with exponentRaised, negated
    linear_combination cancel
  have halfValue := complexOfReal.half
  have firstConstant : complexOfReal(R[bernoulli(1) / realNat(1!)]) =
      ℂ[-complexInv(2)]
    have value : R[bernoulli(1) / realNat(1!)] = R[-(1 / 2)]
      rw [natural.factorial_one, realNat.one, bernoulli.one]
      have oneNonzero : R[1] ≠ R[0] by linarith
      have quotient := realDiv.mul_right at R[-1 / 2], R[1] with oneNonzero
      linear_combination quotient
    rw [value, complexOfReal.neg, halfValue]
  have lastConstant : complexOfReal(R[(-1) ^ 3 / realNat(2!)]) =
      ℂ[-complexInv(2)]
    have value : R[(-1) ^ 3 / realNat(2!)] = R[-(1 / 2)]
      rw [natural.factorial_two, realNat.two]
      have cube : R[(-1) ^ 3] = R[-1] by ring
      rw cube
      linarith
    rw [value, complexOfReal.neg, halfValue]
  have remainderConstant : complexOfReal(R[1 / realNat(2!)]) = complexInv(ℂ[2])
    rw [natural.factorial_two, realNat.two, halfValue]
  -- H_1(s, a) itself.
  have risingOne : risingFactorial(s, 1) = s
    rw [natural.one_succ, risingFactorial.succ, risingFactorial.zero,
      realNat.zero, complexOfReal.zero]
    ring
  have risingTwo : risingFactorial(s, 2) = ℂ[s * (s + 1)]
    rw [natural.two_succ, risingFactorial.succ, risingOne, realNat.one,
      complexOfReal.one]
  have correction := hurwitzCorrectionTerms.function at s, a with hs
  unfold hurwitzEulerMaclaurin
  unfold hurwitzRemainder
  rw [natural.one_succ, complexPartialSum.succ, complexPartialSum.zero,
    (hurwitzCorrectionTerms.value at s, a, 0 with hs)]
  rw [← natural.one_succ, natural.double_zero_two, natural.double_zero_succ,
    natural.double_one, risingOne, risingTwo, realNat.one, complexOfReal.one,
    remainderConstant, firstConstant, lastConstant, flipped]
  have exponentOrder : ℂ[1 - s] = ℂ[-s + 1] by ring
  rw exponentOrder
  unfold complexDiv
  have powerRaised := realCpow.member at a, ℂ[-s + 1] with exponentRaised
  have powerNegative := realCpow.member at a, ℂ[-s] with negative
  have powerLowered := realCpow.member at a, ℂ[-s - 1] with loweredOne
  have two : ℂ[2] ∈ ℂ by typecheck
  have inverseTwo := complexInv.member with two
  have bernoulliTwo := complexOfReal.mem at R[bernoulli(2) / realNat(2!)]
  have improper := complexImproperIntegral.member at hurwitzIntegrand(2, a, s),
    R[0]
  have partial := complexIntegral.member at hurwitzIntegrand(2, a, s), R[0],
    realNat(M)
  have atM := scaledPower.function at ℂ[1 * complexInv(-s + 1)], a, ℂ[-s + 1]
    with scaleRaised, exponentRaised
  have atMValue := FunctionBetween.apply_closed with atM, mMember
  have atMOne := FunctionBetween.apply_closed with power, mMember
  have atMTwo := FunctionBetween.apply_closed with
    (scaledPower.function at ℂ[1 * -s], a, ℂ[-s - 1] with productOne,
      loweredOne), mMember
  ring

-- c (n + a)^w → 0 along the naturals when re w < 0, also times a constant.
theorem scaledPower.eventually_small (c : Set) (a : Real) (w : Set) (K E : Real)
  requires hc : c ∈ ℂ
  requires hw : w ∈ ℂ
  requires positive : R[0] < a
  requires decay : complexRe(w) < realZero
  requires nonnegative : R[0] ≤ K
  requires small : R[0] < E
  shows ∃ N ∈ ℕ, ∀ n ∈ ℕ, N ≤ n →
    R[K * complexAbs(scaledPower(c, a, w)(realNat(n)))] < E
proof
  have cAbs := complexAbs.nonnegative with hc
  have cAbsReal := complexAbs.real with hc
  have weight := realMulValue.nonnegative with nonnegative, cAbs
  obtain ⟨D, dReal, dPositive, dSmall⟩ := real.small_multiple with weight, small
  have reReal := complexRe.real with hw
  have exponent : R[0] < R[-complexRe(w)] by linarith
  obtain ⟨M0, m0Real, m0Positive, eventually⟩ := realRpow.eventually_small
    with exponent, dPositive
  obtain ⟨N, nNat, above⟩ := Real.below_natural at M0
  have bigMember := nat.omega.forward at N with nNat
  refine ⟨N, bigMember, ?_⟩
  intros n nMember later
  have nTyped := nat.omega.backward with nMember
  have monotone := realNat.le_of_natural_le with later
  have shifted : R[0] < R[realNat(n) + a] by
    have nonnegativeN := realNat.nonnegative at n
    linarith
  have farEnough : M0 ≤ R[realNat(n) + a] by linarith
  have decayed := eventually with R[realNat(n) + a], farEnough
  have shape : R[-(-complexRe(w))] = complexRe(w) by ring
  rw shape at decayed
  have power := realCpow.member at R[realNat(n) + a], w with hw
  rw [(scaledPower.value at c, a, w, realNat(n) with hc, hw),
    (complexAbs.mul with hc, power), (realCpow.abs with shifted, hw)]
  have scaled := realLe.mul_left_of_nonnegative with
    (realLess.implies_le with decayed), weight
  have regroup : R[K * (complexAbs(c) * realRpow(R[realNat(n) + a],
      complexRe(w)))] = R[K * complexAbs(c) * realRpow(R[realNat(n) + a],
      complexRe(w))] by ring
  linarith

-- For re s > 1 the series Σ (n + a)^(−s) sums to H_1(s, a).
theorem hurwitzSeries.sums (s : Set) (a : Real)
  requires positive : R[0] < a
  requires hs : s ∈ ℂ
  requires halfPlane : realOne < complexRe(s)
  shows ComplexSumsTo(hurwitzSeriesTerms(s, a), hurwitzEulerMaclaurin(1, s, a))
proof
  have reReal := complexRe.real with hs
  have notOne : s ≠ ℂ[1]
    intro same
    rw [same, ← complexOfReal.one, complexOfReal.re] at halfPlane
    linarith
  have terms := hurwitzSeriesTerms.function at s, a with hs
  have sequence : ComplexSequence(hurwitzSeriesTerms(s, a)) by exact terms
  have prefixes := complexPrefixSums.function with sequence
  have prefixSequence : ComplexSequence(complexPrefixSums(
    hurwitzSeriesTerms(s, a))) by exact prefixes
  have limit := hurwitzEulerMaclaurin.closed at 1, s, a with hs
  refine ⟨sequence, ?_⟩
  apply (ComplexConvergesTo.iff_abs with prefixSequence, limit).backward
  intros e eMember ePositive
  have quarter : R[0] < R[e / 4] by linarith
  have quarterReal : R[e / 4] ∈ ℝ by typecheck
  have one := complexOne.member
  have negative : ℂ[-s] ∈ ℂ by typecheck
  have raised : ℂ[-s + 1] ∈ ℂ by typecheck
  have lowered : ℂ[-s - 1] ∈ ℂ by typecheck
  have inverseRaised := complexInv.member with raised
  have scaleRaised : ℂ[1 * complexInv(-s + 1)] ∈ ℂ by typecheck
  have productOne : ℂ[1 * -s] ∈ ℂ by typecheck
  have reRaised : complexRe(ℂ[-s + 1]) < realZero
    rw [(complexRe.add with negative, one), (complexRe.neg with hs),
      ← complexOfReal.one, complexOfReal.re]
    linarith
  have reNegative : complexRe(ℂ[-s]) < realZero
    rw (complexRe.neg with hs)
    linarith
  have reLowered : complexRe(ℂ[-s - 1]) < realZero
    have minusOne : ℂ[-1] ∈ ℂ by typecheck
    rw [(complexRe.add with negative, minusOne), (complexRe.neg with hs),
      (complexRe.neg with one), ← complexOfReal.one, complexOfReal.re]
    linarith
  have unit : R[0] ≤ R[1] by linarith
  obtain ⟨N1, n1Member, small1⟩ := scaledPower.eventually_small at
    ℂ[1 * complexInv(-s + 1)], a, ℂ[-s + 1], R[1], R[e / 4] with scaleRaised,
    raised, positive, reRaised, unit, quarter
  have constant2 := complexOfReal.mem at R[bernoulli(1) / realNat(1!)]
  have abs2 := complexAbs.nonnegative with constant2
  obtain ⟨N2, n2Member, small2⟩ := scaledPower.eventually_small at
    ℂ[1], a, ℂ[-s], complexAbs(complexOfReal(R[bernoulli(1) / realNat(1!)])),
    R[e / 4] with one, negative, positive, reNegative, abs2, quarter
  have constant3 := complexOfReal.mem at R[bernoulli(2) / realNat(2!)]
  have abs3 := complexAbs.nonnegative with constant3
  obtain ⟨N3, n3Member, small3⟩ := scaledPower.eventually_small at
    ℂ[1 * -s], a, ℂ[-s - 1],
    complexAbs(complexOfReal(R[bernoulli(2) / realNat(2!)])), R[e / 4] with
    productOne, lowered, positive, reLowered, abs3, quarter
  -- The remainder integral.
  have twoHalf : R[1 - realNat(2)] < complexRe(s)
    rw realNat.two
    linarith
  have integrable := hurwitzIntegrand.integrable at 2, a, s with positive, hs,
    twoHalf
  have spec := complexImproperIntegral.spec with integrable
  obtain ⟨_, _, _, tail⟩ := spec
  have constant4 : ℂ[complexOfReal(R[(-1) ^ 3 / realNat(2!)]) *
    (1 * -s * (-s - 1))] ∈ ℂ by typecheck
  have abs4 := complexAbs.nonnegative with constant4
  obtain ⟨D4, d4Real, d4Positive, d4Small⟩ := real.small_multiple with abs4,
    quarter
  obtain ⟨T4, t4Real, near⟩ := tail with D4, d4Real, d4Positive
  obtain ⟨N4, n4Nat, above4⟩ := Real.below_natural at T4
  have n4Member := nat.omega.forward at N4 with n4Nat
  have nSum : N1 + N2 + N3 + N4 ∈ ℕ by typecheck
  refine ⟨N1 + N2 + N3 + N4, nSum, ?_⟩
  intros n nMember later
  have nTyped := nat.omega.backward with nMember
  have later1 : N1 ≤ n by arith
  have later2 : N2 ≤ n by arith
  have later3 : N3 ≤ n by arith
  have later4 : N4 ≤ n by arith
  have bound1 := small1 with n, nMember, later1
  have bound2 := small2 with n, nMember, later2
  have bound3 := small3 with n, nMember, later3
  have monotone := realNat.le_of_natural_le with later4
  have nonnegativeN := realNat.nonnegative at n
  have farEnough : T4 ≤ realNat(n) by linarith
  have bound4 := near with realNat(n), (realNat.real at n), farEnough,
    nonnegativeN
  rw [(complexPrefixSums.value with sequence),
    (hurwitzSeries.finite at n, s, a with positive, hs, notOne)]
  have mMember : realNat(n) ∈ ℝ by typecheck
  have term1 := FunctionBetween.apply_closed with
    (scaledPower.function at ℂ[1 * complexInv(-s + 1)], a, ℂ[-s + 1] with
      scaleRaised, raised), mMember
  have term2 := FunctionBetween.apply_closed with
    (scaledPower.function at ℂ[1], a, ℂ[-s] with one, negative), mMember
  have term3 := FunctionBetween.apply_closed with
    (scaledPower.function at ℂ[1 * -s], a, ℂ[-s - 1] with productOne,
      lowered), mMember
  have partial := complexIntegral.member at hurwitzIntegrand(2, a, s), R[0],
    realNat(n)
  have improper := complexImproperIntegral.member at
    hurwitzIntegrand(2, a, s), R[0]
  have difference : ℂ[complexIntegral(hurwitzIntegrand(2, a, s), R[0],
      realNat(n)) - complexImproperIntegral(hurwitzIntegrand(2, a, s), R[0])]
    ∈ ℂ by typecheck
  have piece2 : ℂ[complexOfReal(R[bernoulli(1) / realNat(1!)]) *
    scaledPower(ℂ[1], a, ℂ[-s])(realNat(n))] ∈ ℂ by typecheck
  have piece3 : ℂ[complexOfReal(R[bernoulli(2) / realNat(2!)]) *
    scaledPower(ℂ[1 * -s], a, ℂ[-s - 1])(realNat(n))] ∈ ℂ by typecheck
  have piece4 : ℂ[complexOfReal(R[(-1) ^ 3 / realNat(2!)]) *
      (1 * -s * (-s - 1)) * (complexIntegral(hurwitzIntegrand(2, a, s), R[0],
      realNat(n)) - complexImproperIntegral(hurwitzIntegrand(2, a, s), R[0]))]
    ∈ ℂ by typecheck
  have shape : ℂ[hurwitzEulerMaclaurin(1, s, a) +
      scaledPower(ℂ[1 * complexInv(-s + 1)], a, ℂ[-s + 1])(realNat(n)) +
      complexOfReal(R[bernoulli(1) / realNat(1!)]) *
        scaledPower(ℂ[1], a, ℂ[-s])(realNat(n)) +
      complexOfReal(R[bernoulli(2) / realNat(2!)]) *
        scaledPower(ℂ[1 * -s], a, ℂ[-s - 1])(realNat(n)) +
      complexOfReal(R[(-1) ^ 3 / realNat(2!)]) * ℂ[1 * -s * (-s - 1)] *
        (complexIntegral(hurwitzIntegrand(2, a, s), R[0], realNat(n)) -
          complexImproperIntegral(hurwitzIntegrand(2, a, s), R[0])) -
      hurwitzEulerMaclaurin(1, s, a)] =
    ℂ[scaledPower(ℂ[1 * complexInv(-s + 1)], a, ℂ[-s + 1])(realNat(n)) +
      complexOfReal(R[bernoulli(1) / realNat(1!)]) *
        scaledPower(ℂ[1], a, ℂ[-s])(realNat(n)) +
      complexOfReal(R[bernoulli(2) / realNat(2!)]) *
        scaledPower(ℂ[1 * -s], a, ℂ[-s - 1])(realNat(n)) +
      complexOfReal(R[(-1) ^ 3 / realNat(2!)]) * (1 * -s * (-s - 1)) *
        (complexIntegral(hurwitzIntegrand(2, a, s), R[0], realNat(n)) -
          complexImproperIntegral(hurwitzIntegrand(2, a, s), R[0]))] by ring
  rw shape
  have sum12 : ℂ[scaledPower(ℂ[1 * complexInv(-s + 1)], a,
      ℂ[-s + 1])(realNat(n)) + complexOfReal(R[bernoulli(1) / realNat(1!)]) *
      scaledPower(ℂ[1], a, ℂ[-s])(realNat(n))] ∈ ℂ by typecheck
  have sum123 : ℂ[scaledPower(ℂ[1 * complexInv(-s + 1)], a,
      ℂ[-s + 1])(realNat(n)) + complexOfReal(R[bernoulli(1) / realNat(1!)]) *
      scaledPower(ℂ[1], a, ℂ[-s])(realNat(n)) +
      complexOfReal(R[bernoulli(2) / realNat(2!)]) *
      scaledPower(ℂ[1 * -s], a, ℂ[-s - 1])(realNat(n))] ∈ ℂ by typecheck
  have triangle1 := complexAbs.triangle with sum123, piece4
  have triangle2 := complexAbs.triangle with sum12, piece3
  have triangle3 := complexAbs.triangle with term1, piece2
  rw [(complexAbs.mul with constant2, term2)] at triangle3
  rw [(complexAbs.mul with constant3, term3)] at triangle2
  rw [(complexAbs.mul with constant4, difference)] at triangle1
  have unitShape : R[1 * complexAbs(scaledPower(ℂ[1 * complexInv(-s + 1)], a,
      ℂ[-s + 1])(realNat(n)))] = complexAbs(scaledPower(ℂ[1 *
      complexInv(-s + 1)], a, ℂ[-s + 1])(realNat(n))) by ring
  have scaled4 := realLe.mul_left_of_nonnegative with
    (realLess.implies_le with bound4), abs4
  linarith

-- Section: Holomorphy by formulas
-- A function given on U by a sum, product, quotient of holomorphic
-- functions, a constant, or the identity, is holomorphic on U.
theorem HolomorphicOn.add_formula (f g h U : Set)
  requires holomorphicF : HolomorphicOn(f, U)
  requires holomorphicG : HolomorphicOn(g, U)
  requires formula : ∀ z ∈ U, h(z) = ℂ[f(z) + g(z)]
  shows HolomorphicOn(h, U)
proof
  have sum := HolomorphicOn.add with holomorphicF, holomorphicG
  obtain ⟨_, valuesF, _⟩ := holomorphicF
  obtain ⟨_, valuesG, _⟩ := holomorphicG
  apply HolomorphicOn.congr with sum
  intros z hz
  rw [(complexFunctionAdd.value with valuesF, valuesG, hz), (formula with z, hz)]

theorem HolomorphicOn.mul_formula (f g h U : Set)
  requires holomorphicF : HolomorphicOn(f, U)
  requires holomorphicG : HolomorphicOn(g, U)
  requires formula : ∀ z ∈ U, h(z) = ℂ[f(z) * g(z)]
  shows HolomorphicOn(h, U)
proof
  have product := HolomorphicOn.mul with holomorphicF, holomorphicG
  obtain ⟨_, valuesF, _⟩ := holomorphicF
  obtain ⟨_, valuesG, _⟩ := holomorphicG
  apply HolomorphicOn.congr with product
  intros z hz
  rw [(complexFunctionMul.value with valuesF, valuesG, hz), (formula with z, hz)]

theorem HolomorphicOn.div_formula (f g h U : Set)
  requires holomorphicF : HolomorphicOn(f, U)
  requires holomorphicG : HolomorphicOn(g, U)
  requires nonvanishing : ∀ z ∈ U, g(z) ≠ ℂ[0]
  requires formula : ∀ z ∈ U, h(z) = complexDiv(f(z), g(z))
  shows HolomorphicOn(h, U)
proof
  have quotient := HolomorphicOn.div with holomorphicF, holomorphicG,
    nonvanishing
  obtain ⟨_, valuesF, _⟩ := holomorphicF
  obtain ⟨_, valuesG, _⟩ := holomorphicG
  apply HolomorphicOn.congr with quotient
  intros z hz
  rw [(complexFunctionDiv.value with valuesF, valuesG, hz), (formula with z, hz)]

theorem HolomorphicOn.const_formula (c h U : Set)
  requires isOpen : ComplexOpen(U)
  requires hc : c ∈ ℂ
  requires formula : ∀ z ∈ U, h(z) = c
  shows HolomorphicOn(h, U)
proof
  have constant := HolomorphicOn.const with isOpen, hc
  apply HolomorphicOn.congr with constant
  intros z hz
  rw [(complexFunctionConst.value with hc, hz), (formula with z, hz)]

theorem HolomorphicOn.id_formula (h U : Set)
  requires isOpen : ComplexOpen(U)
  requires formula : ∀ z ∈ U, h(z) = z
  shows HolomorphicOn(h, U)
proof
  have identity := HolomorphicOn.id with isOpen
  have subset := ComplexOpen.subset with isOpen
  apply HolomorphicOn.congr with identity
  intros z hz
  rw [(complexFunctionId.value with subset, hz), (formula with z, hz)]

-- s ↦ x^(p + q s) is entire, so holomorphic on every open U.
theorem affinePower.holomorphic (X : Real) (p q U : Set)
  requires hp : p ∈ ℂ
  requires hq : q ∈ ℂ
  requires isOpen : ComplexOpen(U)
  requires inside : U ⊆ complexCarrier
  shows HolomorphicOn(affinePower(X, p, q), U)
proof
  have logMember := complexOfReal.mem at realLog(X)
  have scale : ℂ[complexExp(p * complexOfReal(realLog(X)))] ∈ ℂ
    have product : ℂ[p * complexOfReal(realLog(X))] ∈ ℂ by typecheck
    have value := complexExp.member with product
    exact value
  have rate : ℂ[q * complexOfReal(realLog(X))] ∈ ℂ by typecheck
  have zero : ℂ[0] ∈ ℂ by typecheck
  have formula : ∀ x ∈ ℂ, affinePower(X, p, q)(x) =
      ℂ[complexExp(p * complexOfReal(realLog(X))) *
        complexExp(q * complexOfReal(realLog(X)) * x) +
        0 * complexExp(0 * x)]
    intros x hx
    have first : ℂ[p * complexOfReal(realLog(X))] ∈ ℂ by typecheck
    have second : ℂ[q * complexOfReal(realLog(X)) * x] ∈ ℂ by typecheck
    have zeroScaled : ℂ[0 * x] ∈ ℂ by typecheck
    have expZero := complexExp.member with zeroScaled
    have expFirst := complexExp.member with first
    have expSecond := complexExp.member with second
    have split := complexExp.add with first, second
    have shape : ℂ[(p + q * x) * complexOfReal(realLog(X))] =
      ℂ[p * complexOfReal(realLog(X)) + q * complexOfReal(realLog(X)) * x]
      by ring
    rw (affinePower.value with hp, hq, hx)
    unfold realCpow
    rw [shape, split]
    ring
  have function := affinePower.function at X, p, q with hp, hq
  have values : ComplexValuedOn(affinePower(X, p, q), U)
    intros z hz
    exact FunctionBetween.apply_closed with function, (inside with z, hz)
  refine ⟨isOpen, values, ?_⟩
  intros z hz
  have zMember := inside with z, hz
  have derivative := HasComplexDerivativeAt.of_exp_combination with zMember,
    scale, zero, rate, zero, formula
  have restricted := HasComplexDerivativeAt.mono with derivative, isOpen,
    inside, hz
  obtain ⟨_, _, slope, _⟩ := restricted
  exact ⟨ℂ[complexExp(p * complexOfReal(realLog(X))) *
    (q * complexOfReal(realLog(X))) *
    complexExp(q * complexOfReal(realLog(X)) * z) +
    0 * 0 * complexExp(0 * z)], slope, restricted⟩

-- x ↦ (x + a)^(−p), p > 1, is improperly integrable over [0, ∞), as the
-- real part of a complex power.
theorem scaledPower.real_integrable (a P : Real)
  requires positive : R[0] < a
  requires exponent : R[1] < P
  shows ImproperIntegrable(complexFunctionRe(scaledPower(ℂ[1], a,
      complexOfReal(R[-P]))), R[0]) ∧
    (∀ X ∈ ℝ, complexFunctionRe(scaledPower(ℂ[1], a,
      complexOfReal(R[-P])))(X) = realRpow(R[X + a], R[-P]))
proof
  have one := complexOne.member
  have power := complexOfReal.mem at R[-P]
  have reExponent : R[complexRe(complexOfReal(R[-P])) + 1] < R[0]
    rw complexOfReal.re
    linarith
  have shifted : R[0] < R[0 + a] by linarith
  have improper := scaledPower.improper at ℂ[1], a, R[0], complexOfReal(R[-P])
    with one, power, reExponent, shifted
  obtain ⟨integralRe, _⟩ := HasComplexImproperIntegral.parts with improper
  have values : ComplexValuedOn(scaledPower(ℂ[1], a, complexOfReal(R[-P])), ℝ)
    intros Y yMember
    exact FunctionBetween.apply_closed with
      (scaledPower.function at ℂ[1], a, complexOfReal(R[-P]) with one, power),
      yMember
  have improperCopy : HasComplexImproperIntegral(scaledPower(ℂ[1], a,
      complexOfReal(R[-P])), R[0], ℂ[-scaledPower(ℂ[1 *
      complexInv(complexOfReal(R[-P]) + 1)], a, ℂ[complexOfReal(R[-P]) +
      1])(R[0])]) by exact improper
  obtain ⟨_, limitMember, _, _⟩ := improperCopy
  have limitReal := complexRe.real with limitMember
  constructor
  . exact ⟨complexRe(ℂ[-scaledPower(ℂ[1 * complexInv(complexOfReal(R[-P]) +
      1)], a, ℂ[complexOfReal(R[-P]) + 1])(R[0])]), limitReal, integralRe⟩
  . intros X xMember
    have xReal : Real(X) by exact xMember
    have powerMember := realCpow.member at R[X + a], complexOfReal(R[-P])
    have unit : ℂ[1 * realCpow(R[X + a], complexOfReal(R[-P]))] =
      realCpow(R[X + a], complexOfReal(R[-P])) by ring
    rw [(complexFunctionRe.apply with values),
      (scaledPower.value at ℂ[1], a, complexOfReal(R[-P]), X with one, power),
      unit, realCpow.of_real, complexOfReal.re]

theorem hurwitzKernel.apply (n : Nat) (a : Real) (s : Set)
  requires hs : s ∈ ℂ
  shows hurwitzKernel(n, a)(s) = hurwitzIntegrand(n, a, s)
proof
  exact hurwitzKernel.value at n, a, s with hs

-- s ↦ ∫_0^∞ P̃ₙ(x)(x + a)^(−s−n) dx is holomorphic on re s > 1 − n.
theorem hurwitzKernel.holomorphic (n : Nat) (a : Real)
  requires positive : R[0] < a
  shows HolomorphicOn(parameterIntegral(hurwitzKernel(n, a),
    rightHalfPlane(R[1 - realNat(n)]), R[0]), rightHalfPlane(R[1 - realNat(n)]))
proof
  have isOpen := rightHalfPlane.open at R[1 - realNat(n)]
  have inside := ComplexOpen.subset with isOpen
  have values : ∀ s ∈ rightHalfPlane(R[1 - realNat(n)]),
      ComplexValuedOn(hurwitzKernel(n, a)(s), ℝ)
    intros s hs
    have sMember := inside with s, hs
    rw (hurwitzKernel.apply with sMember)
    intros Y yMember
    exact FunctionBetween.apply_closed with
      (hurwitzIntegrand.function at n, a, s with sMember), yMember
  have local : ∀ s ∈ rightHalfPlane(R[1 - realNat(n)]), ∀ T ∈ ℝ, R[0] ≤ T →
      ComplexRiemannIntegrable(hurwitzKernel(n, a)(s), R[0], T)
    intros s hs T tMember later
    have sMember := inside with s, hs
    have tReal : Real(T) by exact tMember
    rw (hurwitzKernel.apply with sMember)
    exact hurwitzIntegrand.local_integrable with positive, sMember, later
  -- Holomorphy in s for fixed x ≥ 0.
  have pointwise : ∀ X ∈ ℝ, R[0] ≤ X → HolomorphicOn(kernelSlice(
      hurwitzKernel(n, a), rightHalfPlane(R[1 - realNat(n)]), X),
      rightHalfPlane(R[1 - realNat(n)]))
    intros X xMember later
    have xReal : Real(X) by exact xMember
    have bernoulliReal : Real(periodicBernoulli(n)(X))
      exact FunctionBetween.apply_closed with (periodicBernoulli.function at n),
        xMember
    have scalar := complexOfReal.mem at periodicBernoulli(n)(X)
    have shift : ℂ[-complexOfReal(realNat(n))] ∈ ℂ by typecheck
    have rate : ℂ[-1] ∈ ℂ by typecheck
    have constant := HolomorphicOn.const with isOpen, scalar
    have powerMap := affinePower.holomorphic at R[X + a],
      ℂ[-complexOfReal(realNat(n))], ℂ[-1],
      rightHalfPlane(R[1 - realNat(n)]) with shift, rate, isOpen, inside
    apply HolomorphicOn.mul_formula with constant, powerMap
    intros s hs
    have sMember := inside with s, hs
    have exponent : ℂ[-s - complexOfReal(realNat(n))] =
      ℂ[-complexOfReal(realNat(n)) + -1 * s] by ring
    rw [(kernelSlice.value with values, hs), (hurwitzKernel.apply with sMember),
      (hurwitzIntegrand.value at n, a, s, X with sMember),
      (complexFunctionConst.value with scalar, hs),
      (affinePower.value with shift, rate, sMember), exponent]
  -- Domination on compact subsets.
  have dominated : ∀ C, C ⊆ rightHalfPlane(R[1 - realNat(n)]) →
      ComplexCompact(C) → (∃ G, ImproperIntegrable(G, R[0]) ∧
        (∀ s ∈ C, ∀ X ∈ ℝ, R[0] ≤ X →
          complexAbs(hurwitzKernel(n, a)(s)(X)) ≤ G(X)))
    intros C subset compact
    obtain ⟨r, rReal, rPositive, margin⟩ := ComplexCompact.margin with
      compact, isOpen, subset
    have identity := HolomorphicOn.id with isOpen
    have continuous := HolomorphicOn.continuous with identity
    have restricted := ComplexContinuousOn.mono with continuous, subset
    obtain ⟨B, bReal, bounded⟩ := ComplexContinuousOn.abs_bounded with
      restricted, compact
    have nonnegativeN := realNat.nonnegative at n
    have lowerExponent : R[1] < R[1 + r / 2] by linarith
    have absB := abs.nonnegative at B
    have upperExponent : R[1] < R[abs(B) + realNat(n) + (1 + r / 2)]
      by linarith
    obtain ⟨integrableP, valuesP⟩ := scaledPower.real_integrable with positive,
      lowerExponent
    obtain ⟨integrableQ, valuesQ⟩ := scaledPower.real_integrable with
      positive, upperExponent
    have integrablePCopy := integrableP
    obtain ⟨IP, ipReal, integralP⟩ := integrablePCopy
    obtain ⟨IQ, iqReal, integralQ⟩ := integrableQ
    have boundReal := bernoulliBound.real at n
    have integralPCopy := integralP
    have integralQCopy := integralQ
    obtain ⟨functionP, _, _⟩ := integralPCopy
    obtain ⟨functionQ, _, _⟩ := integralQCopy
    have functionG := realLinearCombination.function at bernoulliBound(n),
      bernoulliBound(n), complexFunctionRe(scaledPower(ℂ[1], a, complexOfReal(R[-(1 + r / 2)]))),
      complexFunctionRe(scaledPower(ℂ[1], a, complexOfReal(R[-(abs(B) + realNat(n) + (1 + r / 2))]))) with functionP, functionQ
    have valuesG : ∀ X ∈ ℝ, realLinearCombination(bernoulliBound(n),
        bernoulliBound(n), complexFunctionRe(scaledPower(ℂ[1], a, complexOfReal(R[-(1 + r / 2)]))),
        complexFunctionRe(scaledPower(ℂ[1], a, complexOfReal(R[-(abs(B) + realNat(n) + (1 + r / 2))]))))(X) =
        R[bernoulliBound(n) * complexFunctionRe(scaledPower(ℂ[1], a, complexOfReal(R[-(1 + r / 2)])))(X) +
          bernoulliBound(n) * complexFunctionRe(scaledPower(ℂ[1], a, complexOfReal(R[-(abs(B) + realNat(n) + (1 + r / 2))])))(X)]
      intros X xMember
      exact realLinearCombination.value with functionP, functionQ, xMember
    have integralG := HasImproperIntegral.linear with integralP, integralQ,
      functionG, valuesG
    have totalReal : R[bernoulliBound(n) * IP + bernoulliBound(n) * IQ] ∈ ℝ
      by typecheck
    refine ⟨realLinearCombination(bernoulliBound(n), bernoulliBound(n),
      complexFunctionRe(scaledPower(ℂ[1], a, complexOfReal(R[-(1 + r / 2)]))),
      complexFunctionRe(scaledPower(ℂ[1], a, complexOfReal(R[-(abs(B) + realNat(n) + (1 + r / 2))])))),
      ⟨R[bernoulliBound(n) * IP + bernoulliBound(n) * IQ], totalReal,
        integralG⟩, ?_⟩
    intros z hz X xMember later
    have xReal : Real(X) by exact xMember
    have zHalf := subset with z, hz
    have zMember := inside with z, zHalf
    have reReal := complexRe.real with zMember
    -- re z > 1 − n + r/2, from the disk of radius r around z.
    have halfRadius := complexOfReal.mem at R[r / 2]
    have shiftedPoint : ℂ[z - complexOfReal(R[r / 2])] ∈ ℂ by typecheck
    have nearby : ℂ[z - complexOfReal(R[r / 2])] ∈ complexDisk(z, r)
      apply complexDisk.membership.backward
      refine ⟨shiftedPoint, ?_⟩
      have shape : ℂ[z - complexOfReal(R[r / 2]) - z] =
          complexOfReal(R[-(r / 2)])
        rw complexOfReal.neg
        ring
      rw [shape, complexAbs.of_real]
      have value : R[-(r / 2)] ≤ R[0] by linarith
      rw (abs.of_nonpositive with value)
      linarith
    have inU := (margin with z, hz) with ℂ[z - complexOfReal(R[r / 2])], nearby
    obtain ⟨_, lowerBound⟩ := rightHalfPlane.membership.forward with inU
    rw [(complexRe.sub with zMember, halfRadius), complexOfReal.re]
      at lowerBound
    -- re z ≤ |z| ≤ B.
    have absBound := bounded with z, hz
    have zInC : C ⊆ complexCarrier
      intros w hw
      exact inside with w, (subset with w, hw)
    rw (complexFunctionId.value with inside, zHalf) at absBound
    have reAbs := complexAbs.re_le with zMember
    have reUpper := abs.upper at complexRe(z)
    have bUpper := abs.upper at B
    have exponentLower : R[1 + r / 2] ≤ R[complexRe(z) + realNat(n)]
      by linarith
    have exponentUpper : R[complexRe(z) + realNat(n)] ≤
      R[abs(B) + realNat(n) + (1 + r / 2)] by linarith
    have twoSided := realRpow.two_sided at R[X + a], R[1 + r / 2],
      R[complexRe(z) + realNat(n)], R[abs(B) + realNat(n) + (1 + r / 2)] with
      exponentLower, exponentUpper
    have shape : R[-(complexRe(z) + realNat(n))] =
      R[-complexRe(z) - realNat(n)] by ring
    rw shape at twoSided
    have estimate := hurwitzIntegrand.abs_le with positive, zMember, later
    have boundNonnegative : R[0] ≤ bernoulliBound(n)
      have zeroMember : R[0] ∈ ℝ by typecheck
      have bernoulliZero : Real(periodicBernoulli(n)(R[0]))
        exact FunctionBetween.apply_closed with
          (periodicBernoulli.function at n), zeroMember
      have bound := periodicBernoulli.bound at n, R[0]
      have nonnegative := abs.nonnegative at periodicBernoulli(n)(R[0])
      linarith
    have scaled := realLe.mul_left_of_nonnegative with twoSided,
      boundNonnegative
    rw [(hurwitzKernel.apply with zMember), (valuesG with X, xMember),
      (valuesP with X, xMember), (valuesQ with X, xMember)]
    have expand : R[bernoulliBound(n) * (realRpow(R[X + a], R[-(1 + r / 2)]) +
        realRpow(R[X + a], R[-(abs(B) + realNat(n) + (1 + r / 2))]))] =
      R[bernoulliBound(n) * realRpow(R[X + a], R[-(1 + r / 2)]) +
        bernoulliBound(n) * realRpow(R[X + a],
          R[-(abs(B) + realNat(n) + (1 + r / 2))])] by ring
    linarith
  obtain ⟨_, holomorphic⟩ := parameterIntegral.holomorphic with isOpen, values,
    local, pointwise, dominated
  exact holomorphic

-- A sum of three holomorphic functions less a fourth.
theorem HolomorphicOn.sum4_formula (f1 f2 f3 f4 h U : Set)
  requires holomorphic1 : HolomorphicOn(f1, U)
  requires holomorphic2 : HolomorphicOn(f2, U)
  requires holomorphic3 : HolomorphicOn(f3, U)
  requires holomorphic4 : HolomorphicOn(f4, U)
  requires formula : ∀ z ∈ U, h(z) = ℂ[f1(z) + f2(z) + f3(z) - f4(z)]
  shows HolomorphicOn(h, U)
proof
  have first := HolomorphicOn.add with holomorphic1, holomorphic2
  have second := HolomorphicOn.add with first, holomorphic3
  have negated := HolomorphicOn.neg with holomorphic4
  obtain ⟨_, values1, _⟩ := holomorphic1
  obtain ⟨_, values2, _⟩ := holomorphic2
  obtain ⟨_, values3, _⟩ := holomorphic3
  obtain ⟨_, values4, _⟩ := holomorphic4
  have firstCopy := first
  obtain ⟨_, valuesFirst, _⟩ := firstCopy
  apply HolomorphicOn.add_formula with second, negated
  intros z hz
  rw [(complexFunctionAdd.value with valuesFirst, values3, hz),
    (complexFunctionAdd.value with values1, values2, hz),
    (complexFunctionNeg.value with values4, hz), (formula with z, hz)]

theorem risingMap.holomorphic (k : Nat) (U : Set)
  requires isOpen : ComplexOpen(U)
  shows HolomorphicOn(risingMap(k), U)
proof
  have inside := ComplexOpen.subset with isOpen
  induction k
  | zero =>
    have one := complexOne.member
    apply HolomorphicOn.const_formula with isOpen, one
    intros z hz
    rw [(risingMap.value with (inside with z, hz)), risingFactorial.zero]
  | succ(j) using ih =>
    have shift := complexOfReal.mem at realNat(j)
    have identity := HolomorphicOn.id with isOpen
    have constant := HolomorphicOn.const with isOpen, shift
    have shifted := HolomorphicOn.add with identity, constant
    obtain ⟨_, valuesId, _⟩ := identity
    obtain ⟨_, valuesConstant, _⟩ := constant
    apply HolomorphicOn.mul_formula with ih, shifted
    intros z hz
    have zMember := inside with z, hz
    rw [(risingMap.value with zMember), (risingMap.value with zMember),
      risingFactorial.succ,
      (complexFunctionAdd.value with valuesId, valuesConstant, hz),
      (complexFunctionId.value with inside, hz),
      (complexFunctionConst.value with shift, hz)]

theorem correctionMap.holomorphic (a : Real) (k : Nat) (U : Set)
  requires isOpen : ComplexOpen(U)
  shows HolomorphicOn(correctionMap(a, k), U)
proof
  have inside := ComplexOpen.subset with isOpen
  have scale := complexOfReal.mem at R[bernoulli(2 * k + 2) /
    realNat((2 * k + 2)!)]
  have constant := HolomorphicOn.const with isOpen, scale
  have rising := risingMap.holomorphic at 2 * k + 1, U with isOpen
  have product := HolomorphicOn.mul with constant, rising
  have shift : ℂ[-complexOfReal(realNat(2 * k + 1))] ∈ ℂ by typecheck
  have rate : ℂ[-1] ∈ ℂ by typecheck
  have power := affinePower.holomorphic at a,
    ℂ[-complexOfReal(realNat(2 * k + 1))], ℂ[-1], U with shift, rate, isOpen,
    inside
  obtain ⟨_, valuesConstant, _⟩ := constant
  obtain ⟨_, valuesRising, _⟩ := rising
  apply HolomorphicOn.mul_formula with product, power
  intros z hz
  have zMember := inside with z, hz
  have exponent : ℂ[-z - complexOfReal(realNat(2 * k + 1))] =
    ℂ[-complexOfReal(realNat(2 * k + 1)) + -1 * z] by ring
  rw [(correctionMap.value with zMember),
    (hurwitzCorrectionTerms.value at z, a, k with zMember),
    (complexFunctionMul.value with valuesConstant, valuesRising, hz),
    (complexFunctionConst.value with scale, hz), (risingMap.value with zMember),
    (affinePower.value with shift, rate, zMember), exponent]

theorem correctionSumMap.holomorphic (a : Real) (m : Nat) (U : Set)
  requires isOpen : ComplexOpen(U)
  shows HolomorphicOn(correctionSumMap(a, m), U)
proof
  have inside := ComplexOpen.subset with isOpen
  induction m
  | zero =>
    have zero : ℂ[0] ∈ ℂ by typecheck
    apply HolomorphicOn.const_formula with isOpen, zero
    intros z hz
    rw [(correctionSumMap.value with (inside with z, hz)),
      complexPartialSum.zero]
  | succ(j) using ih =>
    have term := correctionMap.holomorphic at a, j, U with isOpen
    apply HolomorphicOn.add_formula with ih, term
    intros z hz
    have zMember := inside with z, hz
    rw [(correctionSumMap.value with zMember),
      (correctionSumMap.value with zMember), complexPartialSum.succ,
      (correctionMap.value with zMember)]

-- The remainder of order m is holomorphic on re s > 1 − 2m.
theorem remainderMap.holomorphic (m : Nat) (a : Real)
  requires positive : R[0] < a
  shows HolomorphicOn(remainderMap(m, a), rightHalfPlane(R[1 - 2 * realNat(m)]))
proof
  have kernel := hurwitzKernel.holomorphic at 2 * m, a with positive
  rw [realNat.mul, realNat.two] at kernel
  have isOpen := rightHalfPlane.open at R[1 - 2 * realNat(m)]
  have inside := ComplexOpen.subset with isOpen
  have scale := complexOfReal.mem at R[1 / realNat((2 * m)!)]
  have constant := HolomorphicOn.const with isOpen, scale
  have rising := risingMap.holomorphic at 2 * m, rightHalfPlane(R[1 -
    2 * realNat(m)]) with isOpen
  have product := HolomorphicOn.mul with constant, rising
  obtain ⟨_, valuesConstant, _⟩ := constant
  obtain ⟨_, valuesRising, _⟩ := rising
  apply HolomorphicOn.mul_formula with product, kernel
  intros z hz
  have zMember := inside with z, hz
  rw [(remainderMap.value with zMember),
    (complexFunctionMul.value with valuesConstant, valuesRising, hz),
    (complexFunctionConst.value with scale, hz), (risingMap.value with zMember),
    (parameterIntegral.value with hz), (hurwitzKernel.apply with zMember)]
  unfold hurwitzRemainder
  rfl

-- H_m(·, a) is holomorphic on re s > 1 − 2m, s ≠ 1.
theorem eulerMaclaurinMap.holomorphic (m : Nat) (a : Real)
  requires positive : R[0] < a
  shows HolomorphicOn(eulerMaclaurinMap(m, a),
    rightHalfPlane(R[1 - 2 * realNat(m)]) ∩ (complexCarrier ∖ {ℂ[1]}))
proof
  have one := complexOne.member
  have halfOpen := rightHalfPlane.open at R[1 - 2 * realNat(m)]
  have puncturedOpen := complexPunctured.open with one
  have isOpen := ComplexOpen.inter with halfOpen, puncturedOpen
  have inside := ComplexOpen.subset with isOpen
  have halfInside : rightHalfPlane(R[1 - 2 * realNat(m)]) ∩
      (complexCarrier ∖ {ℂ[1]}) ⊆ rightHalfPlane(R[1 - 2 * realNat(m)])
    intros z hz
    exact hz.left
  -- (a^(1−s)) / (s − 1).
  have minusOne : ℂ[-1] ∈ ℂ by typecheck
  have power := affinePower.holomorphic at a, ℂ[1], ℂ[-1],
    rightHalfPlane(R[1 - 2 * realNat(m)]) ∩ (complexCarrier ∖ {ℂ[1]}) with
    one, minusOne, isOpen, inside
  have identity := HolomorphicOn.id with isOpen
  have constant := HolomorphicOn.const with isOpen, minusOne
  have shifted := HolomorphicOn.add with identity, constant
  have identityCopy := identity
  have constantCopy := constant
  obtain ⟨_, valuesId, _⟩ := identityCopy
  obtain ⟨_, valuesConstant, _⟩ := constantCopy
  have nonvanishing : ∀ z ∈ rightHalfPlane(R[1 - 2 * realNat(m)]) ∩
      (complexCarrier ∖ {ℂ[1]}), complexFunctionAdd(complexFunctionId(
      rightHalfPlane(R[1 - 2 * realNat(m)]) ∩ (complexCarrier ∖ {ℂ[1]})),
      complexFunctionConst(ℂ[-1], rightHalfPlane(R[1 - 2 * realNat(m)]) ∩
      (complexCarrier ∖ {ℂ[1]})), rightHalfPlane(R[1 - 2 * realNat(m)]) ∩
      (complexCarrier ∖ {ℂ[1]}))(z) ≠ ℂ[0]
    intros z hz
    have zMember := inside with z, hz
    rw [(complexFunctionAdd.value with valuesId, valuesConstant, hz),
      (complexFunctionId.value with inside, hz),
      (complexFunctionConst.value with minusOne, hz)]
    intro zero
    obtain ⟨_, punctured⟩ := hz
    obtain ⟨_, notOne⟩ := punctured
    apply notOne
    have same : z = ℂ[1] by linear_combination zero
    rw same
    exact singleton.self at ℂ[1]
  have first := HolomorphicOn.div with power, shifted, nonvanishing
  -- a^(−s)/2.
  have zero : ℂ[0] ∈ ℂ by typecheck
  have two : ℂ[2] ∈ ℂ by typecheck
  have powerNegative := affinePower.holomorphic at a, ℂ[0], ℂ[-1],
    rightHalfPlane(R[1 - 2 * realNat(m)]) ∩ (complexCarrier ∖ {ℂ[1]}) with
    zero, minusOne, isOpen, inside
  have constantTwo := HolomorphicOn.const with isOpen, two
  have twoNonzero : ∀ z ∈ rightHalfPlane(R[1 - 2 * realNat(m)]) ∩
      (complexCarrier ∖ {ℂ[1]}), complexFunctionConst(ℂ[2],
      rightHalfPlane(R[1 - 2 * realNat(m)]) ∩ (complexCarrier ∖ {ℂ[1]}))(z) ≠
      ℂ[0]
    intros z hz
    rw (complexFunctionConst.value with two, hz)
    rw ← complexOfReal.two
    rw ← complexOfReal.zero
    intro same
    have real := complexOfReal.injective with same
    linarith
  have second := HolomorphicOn.div with powerNegative, constantTwo, twoNonzero
  have third := correctionSumMap.holomorphic at a, m, rightHalfPlane(R[1 -
    2 * realNat(m)]) ∩ (complexCarrier ∖ {ℂ[1]}) with isOpen
  have remainder := remainderMap.holomorphic at m, a with positive
  have fourth := HolomorphicOn.mono with remainder, isOpen, halfInside
  have powerCopy := power
  have shiftedCopy := shifted
  have powerNegativeCopy := powerNegative
  have constantTwoCopy := constantTwo
  obtain ⟨_, valuesPower, _⟩ := powerCopy
  obtain ⟨_, valuesShifted, _⟩ := shiftedCopy
  obtain ⟨_, valuesPowerNegative, _⟩ := powerNegativeCopy
  obtain ⟨_, valuesTwo, _⟩ := constantTwoCopy
  apply HolomorphicOn.sum4_formula with first, second, third, fourth
  intros z hz
  have zMember := inside with z, hz
  have exponentOne : ℂ[1 + -1 * z] = ℂ[1 - z] by ring
  have exponentZero : ℂ[0 + -1 * z] = ℂ[-z] by ring
  rw [(eulerMaclaurinMap.value with zMember),
    (complexFunctionDiv.value with valuesPower, valuesShifted, hz),
    (complexFunctionDiv.value with valuesPowerNegative, valuesTwo, hz),
    (affinePower.value with one, minusOne, zMember),
    (affinePower.value with zero, minusOne, zMember),
    (complexFunctionAdd.value with valuesId, valuesConstant, hz),
    (complexFunctionId.value with inside, hz),
    (complexFunctionConst.value with minusOne, hz),
    (complexFunctionConst.value with two, hz),
    (correctionSumMap.value with zMember), (remainderMap.value with zMember),
    exponentOne, exponentZero]
  unfold hurwitzEulerMaclaurin
  rfl

-- Section: The order
theorem hurwitzOrder.spec (s : Set)
  requires hs : s ∈ ℂ
  shows 1 ≤ hurwitzOrder(s) ∧
    R[1 - 2 * realNat(hurwitzOrder(s))] < complexRe(s)
proof
  have naturals : hurwitzOrders(s) ⊆ ℕ
    intros m member
    unfold hurwitzOrders at member
    exact member.left
  have reReal := complexRe.real with hs
  obtain ⟨n, nNat, above⟩ := Real.below_natural at R[1 - complexRe(s)]
  have nonnegative := realNat.nonnegative at n
  have successor := realNat.succ_value at n
  have nMember : succ(n) ∈ hurwitzOrders(s)
    unfold hurwitzOrders
    have natural := nat.omega.forward at succ(n) with *
    refine ⟨natural, ?_, ?_⟩
    . arith
    . rw successor
      linarith
  have inhabited : Nonempty(hurwitzOrders(s)) := ⟨succ(n), nMember⟩
  have least := leastNatural.member with inhabited, naturals
  unfold hurwitzOrder
  unfold hurwitzOrders at least
  exact least.right

theorem hurwitzOrder.least (s : Set) (m : Nat)
  requires hs : s ∈ ℂ
  requires positive : 1 ≤ m
  requires halfPlane : R[1 - 2 * realNat(m)] < complexRe(s)
  shows hurwitzOrder(s) ≤ m
proof
  have naturals : hurwitzOrders(s) ⊆ ℕ
    intros k member
    unfold hurwitzOrders at member
    exact member.left
  have mMember : m ∈ hurwitzOrders(s)
    unfold hurwitzOrders
    have natural := nat.omega.forward at m with *
    exact ⟨natural, positive, halfPlane⟩
  have inhabited : Nonempty(hurwitzOrders(s)) := ⟨m, mMember⟩
  unfold hurwitzOrder
  exact leastNatural.least with inhabited, naturals, mMember

-- Section: The definition
theorem hurwitzZeta.member (s : Set) (a : Real)
  requires hs : s ∈ ℂ
  shows hurwitzZeta(s, a) ∈ ℂ
proof
  have selected := hurwitzZeta.selected at s, a with hs
  exact selected.left

theorem hurwitzZeta.eq_order (s : Set) (a : Real)
  requires hs : s ∈ ℂ
  requires notOne : s ≠ ℂ[1]
  shows hurwitzZeta(s, a) = hurwitzEulerMaclaurin(hurwitzOrder(s), s, a)
proof
  obtain ⟨_, offPole, _⟩ := hurwitzZeta.selected at s, a with hs
  exact offPole with notOne

theorem hurwitzZeta.at_one (a : Real)
  shows hurwitzZeta(ℂ[1], a) = hurwitzZeta.regular(a)
proof
  have one := complexOne.member
  obtain ⟨_, _, atPole⟩ := hurwitzZeta.selected at ℂ[1], a with one
  exact atPole with rfl

-- One more order: H_{m+1}(s, a) = H_m(s, a) (s = 1 included).
theorem hurwitzEulerMaclaurin.succ_order (m : Nat) (s : Set) (a : Real)
  requires positive : R[0] < a
  requires hs : s ∈ ℂ
  requires positiveM : 1 ≤ m
  requires halfPlane : R[1 - 2 * realNat(m)] < complexRe(s)
  shows hurwitzEulerMaclaurin(succ(m), s, a) = hurwitzEulerMaclaurin(m, s, a)
proof
  have step := hurwitzRemainder.step with positive, hs, positiveM, halfPlane
  have terms := hurwitzCorrectionTerms.function at s, a with hs
  have sequence : ComplexSequence(hurwitzCorrectionTerms(s, a)) by exact terms
  have sum := complexPartialSum.member at hurwitzCorrectionTerms(s, a), m
    with sequence
  have mMember : m ∈ ℕ := nat.omega.forward at m with *
  have term := FunctionBetween.apply_closed with terms, mMember
  have remainderNext := hurwitzRemainder.closed at succ(m), s, a with hs
  have one := complexOne.member
  have first := realCpow.member at a, ℂ[1 - s]
  have second := realCpow.member at a, ℂ[-s]
  have shifted : ℂ[s - 1] ∈ ℂ by typecheck
  have two : ℂ[2] ∈ ℂ by typecheck
  have firstInverse := complexInv.member with shifted
  have secondInverse := complexInv.member with two
  unfold hurwitzEulerMaclaurin
  rw [complexPartialSum.succ, step]
  unfold complexDiv
  ring

-- So H_{m+k}(s, a) = H_m(s, a) for every k.
theorem hurwitzEulerMaclaurin.add_order (m k : Nat) (s : Set) (a : Real)
  requires positive : R[0] < a
  requires hs : s ∈ ℂ
  requires positiveM : 1 ≤ m
  requires halfPlane : R[1 - 2 * realNat(m)] < complexRe(s)
  shows hurwitzEulerMaclaurin(m + k, s, a) = hurwitzEulerMaclaurin(m, s, a)
proof
  induction k
  | zero =>
    have same : m + 0 = m by arith
    rw same
  | succ(j) using ih =>
    have jNat : Nat(succ(j)) by typecheck
    have same : m + succ(j) = succ(m + j) by arith
    have positiveSum : 1 ≤ m + j by arith
    have below : m ≤ m + j by arith
    have monotone := realNat.le_of_natural_le at m, m + j with below
    have halfPlaneSum : R[1 - 2 * realNat(m + j)] < complexRe(s) by linarith
    rw [same, (hurwitzEulerMaclaurin.succ_order with positive, hs,
      positiveSum, halfPlaneSum), ih]

-- H_m(s, a) does not depend on the admissible order m.
theorem hurwitzZeta.order_independent (s : Set) (a : Real) (m n : Nat)
  requires positive : R[0] < a
  requires hs : s ∈ ℂ
  requires notOne : s ≠ ℂ[1]
  requires positiveM : 1 ≤ m
  requires positiveN : 1 ≤ n
  requires halfPlaneM : R[1 - 2 * realNat(m)] < complexRe(s)
  requires halfPlaneN : R[1 - 2 * realNat(n)] < complexRe(s)
  shows hurwitzEulerMaclaurin(m, s, a) = hurwitzEulerMaclaurin(n, s, a)
proof
  obtain below | above := LessEqual.total at m, n
  . obtain ⟨k, kNat, same⟩ := LessEqual.exists_add with below
    rw [same, (hurwitzEulerMaclaurin.add_order with positive, hs, positiveM,
      halfPlaneM)]
  . obtain ⟨k, kNat, same⟩ := LessEqual.exists_add with above
    rw [same, (hurwitzEulerMaclaurin.add_order with positive, hs, positiveN,
      halfPlaneN)]

-- So ζ(s, a) is H_m(s, a) at every admissible order.
theorem hurwitzZeta.eq_euler_maclaurin (s : Set) (a : Real) (m : Nat)
  requires positive : R[0] < a
  requires hs : s ∈ ℂ
  requires notOne : s ≠ ℂ[1]
  requires positiveM : 1 ≤ m
  requires halfPlane : R[1 - 2 * realNat(m)] < complexRe(s)
  shows hurwitzZeta(s, a) = hurwitzEulerMaclaurin(m, s, a)
proof
  obtain ⟨positiveOrder, halfPlaneOrder⟩ := hurwitzOrder.spec with hs
  rw (hurwitzZeta.eq_order with hs, notOne)
  exact hurwitzZeta.order_independent with positive, hs, notOne, positiveOrder,
    positiveM, halfPlaneOrder, halfPlane

-- The same for the constant term at 1.
theorem hurwitzRegularEulerMaclaurin.add_order (m k : Nat) (a : Real)
  requires positive : R[0] < a
  requires positiveM : 1 ≤ m
  shows hurwitzRegularEulerMaclaurin(m + k, a) =
    hurwitzRegularEulerMaclaurin(m, a)
proof
  have one := complexOne.member
  induction k
  | zero =>
    have same : m + 0 = m by arith
    rw same
  | succ(j) using ih =>
    have jNat : Nat(succ(j)) by typecheck
    have same : m + succ(j) = succ(m + j) by arith
    have positiveSum : 1 ≤ m + j by arith
    have sumNonzero : m + j ≠ (0:N) by arith
    have sumPositive := realNat.positive with sumNonzero
    have reOne : complexRe(ℂ[1]) = R[1]
      rw [← complexOfReal.one, complexOfReal.re]
    have halfPlane : R[1 - 2 * realNat(m + j)] < complexRe(ℂ[1]) by linarith
    have step := hurwitzRemainder.step at m + j, ℂ[1], a with positive, one,
      positiveSum, halfPlane
    have terms := hurwitzCorrectionTerms.function at ℂ[1], a with one
    have sequence : ComplexSequence(hurwitzCorrectionTerms(ℂ[1], a))
      by exact terms
    have sum := complexPartialSum.member at hurwitzCorrectionTerms(ℂ[1], a),
      m + j with sequence
    have index : m + j ∈ ℕ := nat.omega.forward at m + j with *
    have term := FunctionBetween.apply_closed with terms, index
    have remainderNext := hurwitzRemainder.closed at succ(m + j), ℂ[1], a
      with one
    have logarithm := realLog.real at a
    have constant := complexOfReal.mem at R[-realLog(a)]
    have minusOne : ℂ[-1] ∈ ℂ by typecheck
    have power := realCpow.member at a, ℂ[-1] with minusOne
    have two : ℂ[2] ∈ ℂ by typecheck
    have inverse := complexInv.member with two
    rw [same, ← ih]
    unfold hurwitzRegularEulerMaclaurin
    rw [complexPartialSum.succ, step]
    unfold complexDiv
    ring

-- The constant term does not depend on the order either.
theorem hurwitzZeta.regular_order (a : Real) (m : Nat)
  requires positive : R[0] < a
  requires positiveM : 1 ≤ m
  shows hurwitzRegularEulerMaclaurin(m, a) = hurwitzZeta.regular(a)
proof
  have unit : 1 ≤ 1 by arith
  obtain ⟨k, kNat, same⟩ := LessEqual.exists_add with positiveM
  unfold hurwitzZeta.regular
  rw [same, (hurwitzRegularEulerMaclaurin.add_order with positive, unit)]

-- Section: The series
-- For re s > 1, ζ(s, a) = Σ_{n≥0} (n + a)^(−s), absolutely convergent.
theorem hurwitzZeta.series (s : Set) (a : Real)
  requires positive : R[0] < a
  requires hs : s ∈ ℂ
  requires halfPlane : realOne < complexRe(s)
  shows ComplexSumsTo(hurwitzSeriesTerms(s, a), hurwitzZeta(s, a)) ∧
    ComplexAbsolutelySummable(hurwitzSeriesTerms(s, a))
proof
  have reReal := complexRe.real with hs
  have notOne : s ≠ ℂ[1]
    intro same
    rw [same, ← complexOfReal.one, complexOfReal.re] at halfPlane
    linarith
  have unit : 1 ≤ 1 by arith
  have orderOne : R[1 - 2 * realNat(1)] < complexRe(s)
    rw realNat.one
    linarith
  rw (hurwitzZeta.eq_euler_maclaurin with positive, hs, notOne, unit, orderOne)
  have sums := hurwitzSeries.sums with positive, hs, halfPlane
  refine ⟨sums, ?_⟩
  -- Absolute convergence: the series at the real point re s.
  have terms := hurwitzSeriesTerms.function at s, a with hs
  have sequence : ComplexSequence(hurwitzSeriesTerms(s, a)) by exact terms
  have realPoint := complexOfReal.mem at complexRe(s)
  have realHalfPlane : realOne < complexRe(complexOfReal(complexRe(s)))
    rw complexOfReal.re
    exact halfPlane
  have realSums := hurwitzSeries.sums with positive, realPoint, realHalfPlane
  obtain ⟨realSequence, converges⟩ := realSums
  obtain ⟨_, limitMember, convergesX, _⟩ := converges
  rw (complexSequenceX.prefix with realSequence) at convergesX
  have realTerms := hurwitzSeriesTerms.function at complexOfReal(complexRe(s)),
    a with realPoint
  have absolute := complexAbsSequence.function with sequence
  have parts := complexSequenceX.sequence with realSequence
  have partsFunction : complexSequenceX(hurwitzSeriesTerms(
    complexOfReal(complexRe(s)), a)) : ℕ → ℝ by exact parts
  have same : complexSequenceX(hurwitzSeriesTerms(complexOfReal(complexRe(s)),
      a)) = complexAbsSequence(hurwitzSeriesTerms(s, a))
    apply FunctionBetween.ext with partsFunction, absolute
    intros n nMember
    have nNat := nat.omega.backward with nMember
    have shifted : R[0] < R[realNat(n) + a]
      have nonnegative := realNat.nonnegative at n
      linarith
    have negative : ℂ[-s] ∈ ℂ by typecheck
    have term := FunctionBetween.apply_closed with realTerms, nMember
    rw [(complexSequenceX.value with realSequence), (complexRe.x with term),
      (complexAbsSequence.value with sequence),
      (hurwitzSeriesTerms.value at complexOfReal(complexRe(s)), a, n with
        realPoint), (hurwitzSeriesTerms.value at s, a, n with hs),
      (realCpow.abs with shifted, negative), (complexRe.neg with hs),
      ← complexOfReal.neg, realCpow.of_real, complexOfReal.re]
  rw same at convergesX
  have xReal := complexRe.real with limitMember
  rw (complexRe.x with limitMember) at convergesX
  have sumsAbs : SumsTo(complexAbsSequence(hurwitzSeriesTerms(s, a)),
    complexRe(hurwitzEulerMaclaurin(1, complexOfReal(complexRe(s)), a)))
    exact ⟨absolute, convergesX⟩
  have xMember : complexRe(hurwitzEulerMaclaurin(1,
    complexOfReal(complexRe(s)), a)) ∈ ℝ by typecheck
  exact ⟨sequence, ⟨complexRe(hurwitzEulerMaclaurin(1,
    complexOfReal(complexRe(s)), a)), xMember, sumsAbs⟩⟩

-- Section: Analytic properties
theorem hurwitzZetaMap.apply (a : Real) (s : Set)
  requires hs : s ∈ ℂ
  shows hurwitzZetaMap(a)(s) = hurwitzZeta(s, a)
proof
  exact hurwitzZetaMap.value at a, s with hs

-- ζ(·, a) is holomorphic on ℂ ∖ {1}.
theorem hurwitzZeta.holomorphic (a : Real)
  requires positive : R[0] < a
  shows HolomorphicOn(hurwitzZetaMap(a), complexCarrier ∖ {ℂ[1]})
proof
  have one := complexOne.member
  have isOpen := complexPunctured.open with one
  apply HolomorphicOn.of_local with isOpen
  intros s hs
  have hsCopy := hs
  obtain ⟨sMember, notSingleton⟩ := hsCopy
  have notOne : s ≠ ℂ[1]
    intro same
    apply notSingleton
    rw same
    exact singleton.self at ℂ[1]
  obtain ⟨positiveOrder, halfPlane⟩ := hurwitzOrder.spec with sMember
  have halfOpen := rightHalfPlane.open at R[1 - 2 * realNat(hurwitzOrder(s))]
  have neighborhoodOpen := ComplexOpen.inter with halfOpen, isOpen
  have inHalf : s ∈ rightHalfPlane(R[1 - 2 * realNat(hurwitzOrder(s))])
    exact rightHalfPlane.membership.backward with ⟨sMember, halfPlane⟩
  have inNeighborhood : s ∈ rightHalfPlane(R[1 - 2 *
      realNat(hurwitzOrder(s))]) ∩ (complexCarrier ∖ {ℂ[1]})
    exact ⟨inHalf, hs⟩
  have smaller : rightHalfPlane(R[1 - 2 * realNat(hurwitzOrder(s))]) ∩
      (complexCarrier ∖ {ℂ[1]}) ⊆ complexCarrier ∖ {ℂ[1]}
    intros z hz
    exact hz.right
  have expression := eulerMaclaurinMap.holomorphic at hurwitzOrder(s), a with
    positive
  refine ⟨rightHalfPlane(R[1 - 2 * realNat(hurwitzOrder(s))]) ∩
    (complexCarrier ∖ {ℂ[1]}), neighborhoodOpen, inNeighborhood, smaller, ?_⟩
  apply HolomorphicOn.congr with expression
  intros z hz
  obtain ⟨zHalf, zPunctured⟩ := hz
  obtain ⟨zMember, zHalfPlane⟩ := rightHalfPlane.membership.forward with zHalf
  obtain ⟨_, zNotSingleton⟩ := zPunctured
  have zNotOne : z ≠ ℂ[1]
    intro same
    apply zNotSingleton
    rw same
    exact singleton.self at ℂ[1]
  rw [(eulerMaclaurinMap.value with zMember), (hurwitzZetaMap.apply with
    zMember), (hurwitzZeta.eq_euler_maclaurin with positive, zMember, zNotOne,
    positiveOrder, zHalfPlane)]

-- Section: The regular part at 1
theorem complexPow.mul_base (x y : Set) (n : Nat)
  requires hx : x ∈ ℂ
  requires hy : y ∈ ℂ
  shows ℂ[(x * y) ^ n] = ℂ[x ^ n * y ^ n]
proof
  induction n
  | zero =>
    rw [monoidPow.zero, monoidPow.zero, monoidPow.zero]
    ring
  | succ(k) using ih =>
    have powerX := complexPow.member at x, k with hx
    have powerY := complexPow.member at y, k with hy
    rw [monoidPow.succ, monoidPow.succ, monoidPow.succ, ih]
    ring

-- F P = d⁻¹ (F (d P)) for d ≠ 0.
theorem complexInv.cancel_left (F P d : Set)
  requires hF : F ∈ ℂ
  requires hP : P ∈ ℂ
  requires hd : d ∈ ℂ
  requires nonzero : d ≠ ℂ[0]
  shows ℂ[F * P] = ℂ[complexInv(d) * (F * (d * P))]
proof
  have cancel := complexInv.mul_cancel with hd, nonzero
  linear_combination (-(F * P)) * cancel

-- A series whose terms after the first vanish sums to its first term.
theorem complexPartialSum.first_only (u : Set) (n : Nat)
  requires vanishing : ∀ k ∈ ℕ, (0:N) < k → u(k) = ℂ[0]
  requires sequence : ComplexSequence(u)
  shows (0:N) < n → complexPartialSum(u, n) = u((0:N))
proof
  have zeroMember : (0:N) ∈ ℕ := nat.omega.forward at (0:N) with *
  have first := FunctionBetween.apply_closed with sequence, zeroMember
  induction n
  | zero =>
    intro positiveN
    exfalso
    arith
  | succ(k) using ih =>
    intro positiveN
    have kMember : k ∈ ℕ := nat.omega.forward at k with *
    rw complexPartialSum.succ
    by_cases zero : k = (0:N)
    . rw [zero, complexPartialSum.zero]
      ring
    . have kPositive : (0:N) < k by arith
      rw [(ih with kPositive), (vanishing with k, kMember, kPositive)]
      ring

theorem ComplexSumsTo.first_only (u : Set)
  requires sequence : ComplexSequence(u)
  requires vanishing : ∀ n ∈ ℕ, (0:N) < n → u(n) = ℂ[0]
  shows ComplexSumsTo(u, u((0:N)))
proof
  have zeroMember : (0:N) ∈ ℕ := nat.omega.forward at (0:N) with *
  have first := FunctionBetween.apply_closed with sequence, zeroMember
  have prefixes := complexPrefixSums.function with sequence
  have prefixSequence : ComplexSequence(complexPrefixSums(u)) by exact prefixes
  refine ⟨sequence, ?_⟩
  apply (ComplexConvergesTo.iff_abs with prefixSequence, first).backward
  intros e eMember ePositive
  have oneMember : (1:N) ∈ ℕ := nat.omega.forward at (1:N) with *
  refine ⟨(1:N), oneMember, ?_⟩
  intros n nMember later
  have nNat := nat.omega.backward with nMember
  have positiveN : (0:N) < n by arith
  have constant := complexPartialSum.first_only at u, n with vanishing,
    sequence
  rw [(complexPrefixSums.value with sequence), (constant with positiveN)]
  have zero : ℂ[u((0:N)) - u((0:N))] = ℂ[0] by ring
  rw [zero, complexAbs.zero]
  exact ePositive

-- For z ≠ 1 the series Σ κ^(n+1)(z − 1)ⁿ/(n + 1)! sums to
-- (e^(κ (z − 1)) − 1)/(z − 1); at z = 1 it sums to κ.
theorem regularCoefficients.sums (κ z : Set)
  requires hκ : κ ∈ ℂ
  requires hz : z ∈ ℂ
  requires notOne : z ≠ ℂ[1]
  shows ComplexSumsTo(powerSeriesTerms(regularCoefficients(κ), ℂ[1], z),
    ℂ[(complexExp(κ * (z - 1)) - 1) * complexInv(z - 1)])
proof
  have one := complexOne.member
  have shifted : ℂ[z - 1] ∈ ℂ by typecheck
  have argument : ℂ[κ * (z - 1)] ∈ ℂ by typecheck
  have coefficients := regularCoefficients.function with hκ
  have coefficientSequence : ComplexSequence(regularCoefficients(κ))
    by exact coefficients
  have exponential := complexExp.sums with argument
  have shiftedSums := complexShift.sums with exponential
  rw (expTerms.zero_value with argument) at shiftedSums
  have inverse := complexInv.member with shifted
  have scale : ℂ[-complexInv(z - 1)] ∈ ℂ by typecheck
  have terms := powerSeriesTerms.function with coefficientSequence, one, hz
  have termSequence : ComplexSequence(powerSeriesTerms(regularCoefficients(κ),
    ℂ[1], z)) by exact terms
  have expSequence := expTerms.function with argument
  have expSequenceCopy : ComplexSequence(expTerms(ℂ[κ * (z - 1)]))
    by exact expSequence
  have combined := ComplexSumsTo.combination at
    complexShift(expTerms(ℂ[κ * (z - 1)])),
    complexShift(expTerms(ℂ[κ * (z - 1)])),
    complexShift(expTerms(ℂ[κ * (z - 1)])),
    powerSeriesTerms(regularCoefficients(κ), ℂ[1], z), ℂ[-complexInv(z - 1)]
    with shiftedSums, shiftedSums, shiftedSums, scale, termSequence
  have shiftedNonzero : ℂ[z - 1] ≠ ℂ[0]
    intro zero
    apply notOne
    linear_combination zero
  have cancel := complexInv.mul_cancel with shifted, shiftedNonzero
  have pointwise : ∀ m ∈ ℕ, powerSeriesTerms(regularCoefficients(κ), ℂ[1],
      z)(m) = ℂ[complexShift(expTerms(ℂ[κ * (z - 1)]))(m) -
      complexShift(expTerms(ℂ[κ * (z - 1)]))(m) - ℂ[-complexInv(z - 1)] *
      complexShift(expTerms(ℂ[κ * (z - 1)]))(m)]
    intros m mMember
    have mNat := nat.omega.backward with mMember
    have next : succ(m) ∈ ℕ by typecheck
    rw [(powerSeriesTerms.value with coefficientSequence, one, hz),
      (regularCoefficients.value with hκ, mMember),
      (complexShift.value with expSequenceCopy, mMember),
      (expTerms.value with hκ, next), (expTerms.value with argument, next),
      (complexPow.mul_base with hκ, shifted), monoidPow.succ]
    rw monoidPow.succ
    have factor := complexOfReal.mem at R[1 / realNat(succ(m)!)]
    have powerκ := complexPow.member at κ, m with hκ
    have powerShifted := complexPow.member at ℂ[z - 1], m with shifted
    have coefficient : ℂ[complexOfReal(R[1 / realNat(succ(m)!)]) *
      (κ * κ ^ m)] ∈ ℂ by typecheck
    rw (complexInv.cancel_left with coefficient, powerShifted, shifted,
      shiftedNonzero)
    ring
  have sums := combined with pointwise
  have expMember := complexExp.member with argument
  have value : ℂ[(complexExp(κ * (z - 1)) - 1) - (complexExp(κ * (z - 1)) - 1)
      - -complexInv(z - 1) * (complexExp(κ * (z - 1)) - 1)] =
    ℂ[(complexExp(κ * (z - 1)) - 1) * complexInv(z - 1)] by ring
  rwa value at sums

-- At the center the series sums to κ.
theorem regularCoefficients.at_center (κ : Set)
  requires hκ : κ ∈ ℂ
  shows ComplexSumsTo(powerSeriesTerms(regularCoefficients(κ), ℂ[1], ℂ[1]), κ)
proof
  have one := complexOne.member
  have coefficients := regularCoefficients.function with hκ
  have coefficientSequence : ComplexSequence(regularCoefficients(κ)) by exact coefficients
  have terms := powerSeriesTerms.function with coefficientSequence, one, one
  have termSequence : ComplexSequence(powerSeriesTerms(regularCoefficients(κ), ℂ[1], ℂ[1]))
    by exact terms
  have zeroDifference : ℂ[1 - 1] = ℂ[0] by ring
  have vanishing : ∀ n ∈ ℕ, (0:N) < n →
      powerSeriesTerms(regularCoefficients(κ), ℂ[1], ℂ[1])(n) = ℂ[0]
    intros n nMember positiveN
    have nNat := nat.omega.backward with nMember
    obtain zero | ⟨k, kNat, same⟩ := natural.zero_or_successor at n
    . exfalso
      arith
    . have coefficient := FunctionBetween.apply_closed with coefficients,
        nMember
      have zeroMember : ℂ[0] ∈ ℂ by typecheck
      have power := complexPow.member at ℂ[0], k with zeroMember
      rw [(powerSeriesTerms.value with coefficientSequence, one, one),
        zeroDifference, same, monoidPow.succ]
      ring
  have sums := ComplexSumsTo.first_only with termSequence, vanishing
  have zeroMember : (0:N) ∈ ℕ := nat.omega.forward at (0:N) with *
  have oneMember : succ((0:N)) ∈ ℕ by typecheck
  rw [(powerSeriesTerms.value with coefficientSequence, one, one),
    zeroDifference, monoidPow.zero, (regularCoefficients.value with hκ,
    zeroMember), (expTerms.value with hκ, oneMember), monoidPow.succ,
    monoidPow.zero, ← natural.one_succ, natural.factorial_one, realNat.one]
    at sums
  have oneNonzero : R[1] ≠ R[0] by linarith
  have quotient := realDiv.mul_right at R[1], R[1] with oneNonzero
  have unitQuotient : R[1 / 1] = R[1] by linear_combination quotient
  rw [unitQuotient, complexOfReal.one] at sums
  have value : ℂ[1 * (κ * 1) * 1] = κ by ring
  rwa value at sums

-- The series converges on the disk of radius 2 about 1.
theorem regularCoefficients.radius (κ : Set)
  requires hκ : κ ∈ ℂ
  shows PowerSeriesRadiusAtLeast(regularCoefficients(κ), R[2])
proof
  have one := complexOne.member
  have three : ℂ[3] ∈ ℂ by typecheck
  have difference : ℂ[3 - 1] = complexOfReal(R[2])
    rw complexOfReal.two
    ring
  have notOne : ℂ[3] ≠ ℂ[1]
    intro same
    have zero : ℂ[3 - 1] = ℂ[0]
      rw same
      ring
    rw [difference, ← complexOfReal.zero] at zero
    have real := complexOfReal.injective with zero
    linarith
  have coefficients := regularCoefficients.function with hκ
  have coefficientSequence : ComplexSequence(regularCoefficients(κ)) by exact coefficients
  have sums := regularCoefficients.sums with hκ, three, notOne
  have value : ℂ[(complexExp(κ * (3 - 1)) - 1) * complexInv(3 - 1)] ∈ ℂ
    have argument : ℂ[κ * (3 - 1)] ∈ ℂ by typecheck
    have expMember := complexExp.member with argument
    have shifted : ℂ[3 - 1] ∈ ℂ by typecheck
    have inverse := complexInv.member with shifted
    typecheck
  have summable : ComplexSummable(powerSeriesTerms(regularCoefficients(κ), ℂ[1], ℂ[3]))
    exact ⟨ℂ[(complexExp(κ * (3 - 1)) - 1) * complexInv(3 - 1)], value, sums⟩
  have radius := PowerSeriesRadiusAtLeast.of_summable with
    coefficientSequence, one, three, summable
  have twoReal : R[0] ≤ R[2] by linarith
  rw [difference, complexAbs.of_real, (abs.of_nonnegative with twoReal)]
    at radius
  exact radius

theorem hurwitzZetaRegularMap.at_one (a : Real)
  shows hurwitzZetaRegularMap(a)(ℂ[1]) = hurwitzZeta.regular(a)
proof
  have one := complexOne.member
  have value := hurwitzZetaRegularMap.value at a, ℂ[1] with one
  have zero : ℂ[1 - 1] = ℂ[0] by ring
  have regular := hurwitzZeta.member at ℂ[1], a with one
  rw [value, zero, hurwitzZeta.at_one]
  unfold complexDiv
  rw complexInv.zero
  rw hurwitzZeta.at_one at regular
  ring

-- ζ(s, a) − 1/(s − 1), with its constant term at s = 1, is entire.
theorem hurwitzZetaRegularMap.holomorphic (a : Real)
  requires positive : R[0] < a
  shows HolomorphicOn(hurwitzZetaRegularMap(a), complexCarrier)
proof
  have one := complexOne.member
  have zero : ℂ[0] ∈ ℂ by typecheck
  have two : ℂ[2] ∈ ℂ by typecheck
  have minusOne : ℂ[-1] ∈ ℂ by typecheck
  have logReal := realLog.real at a
  have hκ := complexOfReal.mem at R[-realLog(a)]
  have radius := regularCoefficients.radius with hκ
  have twoReal : R[2] ∈ ℝ by typecheck
  have twoPositive : R[0] < R[2] by linarith
  have series := powerSeriesSum.holomorphic with radius, one
  have diskOpen := complexDisk.open with one, twoReal
  have halfOpen := rightHalfPlane.open at R[1 - 2 * realNat(1)]
  have nearOpen := ComplexOpen.inter with diskOpen, halfOpen
  have nearInside := ComplexOpen.subset with nearOpen
  have nearDisk : complexDisk(ℂ[1], R[2]) ∩ rightHalfPlane(R[1 - 2 * realNat(1)]) ⊆ complexDisk(ℂ[1], R[2])
    intros z hz
    exact hz.left
  have nearHalf : complexDisk(ℂ[1], R[2]) ∩ rightHalfPlane(R[1 - 2 * realNat(1)]) ⊆ rightHalfPlane(R[1 - 2 * realNat(1)])
    intros z hz
    exact hz.right
  -- The four pieces near 1.
  have first := HolomorphicOn.mono with series, nearOpen, nearDisk
  have power := affinePower.holomorphic at a, ℂ[0], ℂ[-1], complexDisk(ℂ[1], R[2]) ∩ rightHalfPlane(R[1 - 2 * realNat(1)]) with zero,
    minusOne, nearOpen, nearInside
  have constantTwo := HolomorphicOn.const with nearOpen, two
  have twoNonzero : ∀ z ∈ complexDisk(ℂ[1], R[2]) ∩ rightHalfPlane(R[1 - 2 * realNat(1)]), complexFunctionConst(ℂ[2], complexDisk(ℂ[1], R[2]) ∩ rightHalfPlane(R[1 - 2 * realNat(1)]))(z) ≠ ℂ[0]
    intros z hz
    rw [(complexFunctionConst.value with two, hz), ← complexOfReal.two,
      ← complexOfReal.zero]
    intro same
    have real := complexOfReal.injective with same
    linarith
  have second := HolomorphicOn.div with power, constantTwo, twoNonzero
  have third := correctionSumMap.holomorphic at a, 1, complexDisk(ℂ[1], R[2]) ∩ rightHalfPlane(R[1 - 2 * realNat(1)]) with nearOpen
  have remainder := remainderMap.holomorphic at 1, a with positive
  have fourth := HolomorphicOn.mono with remainder, nearOpen, nearHalf
  have powerCopy := power
  have constantTwoCopy := constantTwo
  obtain ⟨_, valuesPower, _⟩ := powerCopy
  obtain ⟨_, valuesTwo, _⟩ := constantTwoCopy
  have near : HolomorphicOn(hurwitzZetaRegularMap(a), complexDisk(ℂ[1], R[2]) ∩ rightHalfPlane(R[1 - 2 * realNat(1)]))
    apply HolomorphicOn.sum4_formula with first, second, third, fourth
    intros z hz
    have zMember := nearInside with z, hz
    have zDisk := nearDisk with z, hz
    have zHalf := nearHalf with z, hz
    obtain ⟨_, zHalfPlane⟩ := rightHalfPlane.membership.forward with zHalf
    have psSums := powerSeriesSum.sums with radius, one, zDisk
    have exponentZero : ℂ[0 + -1 * z] = ℂ[-z] by ring
    rw [(complexFunctionDiv.value with valuesPower, valuesTwo, hz),
      (affinePower.value with zero, minusOne, zMember),
      (complexFunctionConst.value with two, hz),
      (correctionSumMap.value with zMember), (remainderMap.value with zMember),
      exponentZero]
    by_cases atOne : z = ℂ[1]
    . rw atOne at psSums
      have center := regularCoefficients.at_center with hκ
      have value := ComplexSumsTo.unique with psSums, center
      rw [atOne, value, hurwitzZetaRegularMap.at_one]
      unfold hurwitzZeta.regular
      unfold hurwitzRegularEulerMaclaurin
      rfl
    . have elsewhere := regularCoefficients.sums with hκ, zMember, atOne
      have value := ComplexSumsTo.unique with psSums, elsewhere
      have unit : 1 ≤ 1 by arith
      rw [value, (hurwitzZetaRegularMap.value with zMember),
        (hurwitzZeta.eq_euler_maclaurin with positive, zMember, atOne, unit,
          zHalfPlane)]
      unfold hurwitzEulerMaclaurin
      unfold complexDiv
      unfold realCpow
      have logMember := complexOfReal.mem at realLog(a)
      have exponent : ℂ[complexOfReal(R[-realLog(a)]) * (z - 1)] =
          ℂ[(1 - z) * complexOfReal(realLog(a))]
        rw complexOfReal.neg
        ring
      rw exponent
      have shifted : ℂ[z - 1] ∈ ℂ by typecheck
      have inverse := complexInv.member with shifted
      have argument : ℂ[(1 - z) * complexOfReal(realLog(a))] ∈ ℂ by typecheck
      have expMember := complexExp.member with argument
      have negative : ℂ[-z * complexOfReal(realLog(a))] ∈ ℂ by typecheck
      have expNegative := complexExp.member with negative
      have inverseTwo := complexInv.member with two
      have sum := correctionSumMap.closed at a, 1, z with zMember
      have rest := hurwitzRemainder.closed at 1, z, a with zMember
      ring
  -- Away from 1.
  have puncturedOpen := complexPunctured.open with one
  have puncturedInside := ComplexOpen.subset with puncturedOpen
  have zeta := hurwitzZeta.holomorphic with positive
  have identity := HolomorphicOn.id with puncturedOpen
  have shiftConstant := HolomorphicOn.const with puncturedOpen, minusOne
  have shiftedMap := HolomorphicOn.add with identity, shiftConstant
  have unitConstant := HolomorphicOn.const with puncturedOpen, one
  have identityCopy := identity
  have shiftConstantCopy := shiftConstant
  obtain ⟨_, valuesId, _⟩ := identityCopy
  obtain ⟨_, valuesShift, _⟩ := shiftConstantCopy
  have shiftedNonzero : ∀ z ∈ complexCarrier ∖ {ℂ[1]},
      complexFunctionAdd(complexFunctionId(complexCarrier ∖ {ℂ[1]}),
      complexFunctionConst(ℂ[-1], complexCarrier ∖ {ℂ[1]}),
      complexCarrier ∖ {ℂ[1]})(z) ≠ ℂ[0]
    intros z hz
    rw [(complexFunctionAdd.value with valuesId, valuesShift, hz),
      (complexFunctionId.value with puncturedInside, hz),
      (complexFunctionConst.value with minusOne, hz)]
    intro vanishes
    have zMember := puncturedInside with z, hz
    obtain ⟨_, notSingleton⟩ := hz
    apply notSingleton
    have same : z = ℂ[1] by linear_combination vanishes
    rw same
    exact singleton.self at ℂ[1]
  have reciprocal := HolomorphicOn.div with unitConstant, shiftedMap,
    shiftedNonzero
  have negated := HolomorphicOn.neg with reciprocal
  have unitConstantCopy := unitConstant
  have shiftedMapCopy := shiftedMap
  have reciprocalCopy := reciprocal
  obtain ⟨_, valuesUnit, _⟩ := unitConstantCopy
  obtain ⟨_, valuesShifted, _⟩ := shiftedMapCopy
  obtain ⟨_, valuesReciprocal, _⟩ := reciprocalCopy
  have away : HolomorphicOn(hurwitzZetaRegularMap(a), complexCarrier ∖ {ℂ[1]})
    apply HolomorphicOn.add_formula with zeta, negated
    intros z hz
    have zMember := puncturedInside with z, hz
    rw [(hurwitzZetaRegularMap.value with zMember),
      (hurwitzZetaMap.apply with zMember),
      (complexFunctionNeg.value with valuesReciprocal, hz),
      (complexFunctionDiv.value with valuesUnit, valuesShifted, hz),
      (complexFunctionConst.value with one, hz),
      (complexFunctionAdd.value with valuesId, valuesShift, hz),
      (complexFunctionId.value with puncturedInside, hz),
      (complexFunctionConst.value with minusOne, hz)]
  have whole := ComplexOpen.whole
  apply HolomorphicOn.of_local with whole
  intros s hs
  by_cases atOne : s = ℂ[1]
  . have inDisk := complexDisk.center with one, twoReal, twoPositive
    have halfPlane : ℂ[1] ∈ rightHalfPlane(R[1 - 2 * realNat(1)])
      apply rightHalfPlane.membership.backward
      refine ⟨one, ?_⟩
      rw [← complexOfReal.one, complexOfReal.re, realNat.one]
      linarith
    have inNear : ℂ[1] ∈ complexDisk(ℂ[1], R[2]) ∩ rightHalfPlane(R[1 - 2 * realNat(1)]) := ⟨inDisk, halfPlane⟩
    rw atOne
    exact ⟨complexDisk(ℂ[1], R[2]) ∩ rightHalfPlane(R[1 - 2 * realNat(1)]), nearOpen, inNear, nearInside, near⟩
  . have inPunctured : s ∈ complexCarrier ∖ {ℂ[1]}
      refine ⟨hs, ?_⟩
      intro inSingleton
      apply atOne
      exact (singleton.membership at s, ℂ[1]).forward with inSingleton
    exact ⟨complexCarrier ∖ {ℂ[1]}, puncturedOpen, inPunctured,
      puncturedInside, away⟩

-- The pole: ζ(s, a) − 1/(s − 1) → hurwitzZeta.regular(a) as s → 1.
theorem hurwitzZeta.pole (a : Real)
  requires positive : R[0] < a
  shows ∀ e ∈ ℝ, R[0] < e → ∃ d ∈ ℝ, R[0] < d ∧
    (∀ s ∈ ℂ, s ≠ ℂ[1] → complexAbs(ℂ[s - 1]) < d →
      complexAbs(ℂ[hurwitzZeta(s, a) - complexDiv(ℂ[1], ℂ[s - 1]) -
        hurwitzZeta.regular(a)]) < e)
proof
  have holomorphic := hurwitzZetaRegularMap.holomorphic with positive
  have continuous := HolomorphicOn.continuous with holomorphic
  obtain ⟨_, _, close⟩ := continuous
  have one := complexOne.member
  intros e eMember ePositive
  obtain ⟨d, dReal, dPositive, near⟩ := close with ℂ[1], one, e, eMember,
    ePositive
  refine ⟨d, dReal, dPositive, ?_⟩
  intros s hs notOne small
  have estimate := near with s, hs, small
  rw [(hurwitzZetaRegularMap.value with hs), hurwitzZetaRegularMap.at_one]
    at estimate
  exact estimate

-- ζ(s, a) = a^(−s) + ζ(s, a + 1), at every s including the pole, where it
-- reads −ψ(a) = 1/a − ψ(a + 1).
theorem hurwitzZeta.shift (s : Set) (a : Real)
  requires positive : R[0] < a
  requires hs : s ∈ ℂ
  shows hurwitzZeta(s, a) = ℂ[realCpow(a, ℂ[-s]) + hurwitzZeta(s, R[a + 1])]
proof
  have shiftedPositive : R[0] < R[a + 1] by linarith
  have whole := ComplexOpen.whole
  have wholeInside := ComplexOpen.subset with whole
  have zero : ℂ[0] ∈ ℂ by typecheck
  have minusOne : ℂ[-1] ∈ ℂ by typecheck
  have one := complexOne.member
  have regularA := hurwitzZetaRegularMap.holomorphic with positive
  have regularNext := hurwitzZetaRegularMap.holomorphic with shiftedPositive
  have power := affinePower.holomorphic at a, ℂ[0], ℂ[-1], complexCarrier with
    zero, minusOne, whole, wholeInside
  have sum := HolomorphicOn.add with power, regularNext
  have powerCopy := power
  have regularNextCopy := regularNext
  obtain ⟨_, valuesPower, _⟩ := powerCopy
  obtain ⟨_, valuesNext, _⟩ := regularNextCopy
  -- Both sides agree on re s > 1, by the series.
  have halfOpen := rightHalfPlane.open at R[1]
  have halfInside := ComplexOpen.subset with halfOpen
  have twoPoint : complexOfReal(R[2]) ∈ rightHalfPlane(R[1])
    apply rightHalfPlane.membership.backward
    refine ⟨(complexOfReal.mem at R[2]), ?_⟩
    rw complexOfReal.re
    linarith
  have nonempty : ∃ v, v ∈ rightHalfPlane(R[1]) :=
    ⟨complexOfReal(R[2]), twoPoint⟩
  have agree : ∀ z ∈ rightHalfPlane(R[1]), hurwitzZetaRegularMap(a)(z) =
      complexFunctionAdd(affinePower(a, ℂ[0], ℂ[-1]),
        hurwitzZetaRegularMap(R[a + 1]), complexCarrier)(z)
    intros z hz
    obtain ⟨zMember, zHalfPlane⟩ := rightHalfPlane.membership.forward with hz
    have halfPlane : realOne < complexRe(z) by exact zHalfPlane
    obtain ⟨seriesA, _⟩ := hurwitzZeta.series with positive, zMember,
      halfPlane
    obtain ⟨seriesNext, _⟩ := hurwitzZeta.series with shiftedPositive,
      zMember, halfPlane
    have shifted := complexShift.sums with seriesA
    have terms := hurwitzSeriesTerms.function at z, a with zMember
    have sequence : ComplexSequence(hurwitzSeriesTerms(z, a)) by exact terms
    have shiftedFunction := complexShift.function with sequence
    have nextFunction := hurwitzSeriesTerms.function at z, R[a + 1] with
      zMember
    have same : complexShift(hurwitzSeriesTerms(z, a)) =
        hurwitzSeriesTerms(z, R[a + 1])
      apply FunctionBetween.ext with shiftedFunction, nextFunction
      intros n nMember
      have nNat := nat.omega.backward with nMember
      have next : succ(n) ∈ ℕ by typecheck
      have point : R[realNat(succ(n)) + a] = R[realNat(n) + (a + 1)]
        rw realNat.succ_value
        ring
      rw [(complexShift.value with sequence, nMember),
        (hurwitzSeriesTerms.value at z, a, succ(n) with zMember),
        (hurwitzSeriesTerms.value at z, R[a + 1], n with zMember), point]
    rw same at shifted
    have value := ComplexSumsTo.unique with seriesNext, shifted
    have zeroMember : (0:N) ∈ ℕ := nat.omega.forward at (0:N) with *
    have first : R[realNat((0:N)) + a] = a
      rw realNat.zero
      ring
    rw [(hurwitzSeriesTerms.value at z, a, (0:N) with zMember), first] at value
    have exponent : ℂ[0 + -1 * z] = ℂ[-z] by ring
    rw [(complexFunctionAdd.value with valuesPower, valuesNext,
      (wholeInside with z, (halfInside with z, hz))),
      (hurwitzZetaRegularMap.value with zMember),
      (hurwitzZetaRegularMap.value with zMember),
      (affinePower.value with zero, minusOne, zMember), exponent, value]
    have powerMember := realCpow.member at a, ℂ[-z]
    have zetaMember := hurwitzZeta.member at z, a with zMember
    have shiftedZ : ℂ[z - 1] ∈ ℂ by typecheck
    have inverse := complexInv.member with shiftedZ
    unfold complexDiv
    ring
  have halfWhole : rightHalfPlane(R[1]) ⊆ complexCarrier by exact halfInside
  have identity := holomorphic.identity with regularA, sum,
    ComplexConnected.whole, halfOpen, nonempty, halfWhole, agree
  have atS := identity with s, hs
  have powerS := realCpow.member at a, ℂ[-s]
  have exponent : ℂ[0 + -1 * s] = ℂ[-s] by ring
  rw [(complexFunctionAdd.value with valuesPower, valuesNext, hs),
    (affinePower.value with zero, minusOne, hs), exponent] at atS
  by_cases atOne : s = ℂ[1]
  . rw [atOne, hurwitzZetaRegularMap.at_one, hurwitzZetaRegularMap.at_one]
      at atS
    rw [atOne, hurwitzZeta.at_one, hurwitzZeta.at_one, atS]
  . rw [(hurwitzZetaRegularMap.value with hs),
      (hurwitzZetaRegularMap.value with hs)] at atS
    have zetaA := hurwitzZeta.member at s, a with hs
    have zetaNext := hurwitzZeta.member at s, R[a + 1] with hs
    have shiftedS : ℂ[s - 1] ∈ ℂ by typecheck
    have inverse := complexInv.member with shiftedS
    unfold complexDiv at atS
    linear_combination atS

-- Section: Conjugation
theorem complexConj.member (z : Set)
  requires hz : z ∈ ℂ
  shows complexConj(z) ∈ ℂ
proof
  exact FunctionBetween.apply_closed with complexConj.function, hz

-- The integral of the conjugate function is the conjugate integral.
theorem complexIntegral.conj (g h : Set) (A B : Real)
  requires integrable : ComplexRiemannIntegrable(g, A, B)
  requires valuesH : ComplexValuedOn(h, ℝ)
  requires conjugate : ∀ X ∈ ℝ, h(X) = complexConj(g(X))
  shows ComplexRiemannIntegrable(h, A, B) ∧
    complexIntegral(h, A, B) = complexConj(complexIntegral(g, A, B))
proof
  obtain ⟨values, integrableRe, integrableIm⟩ := integrable
  have functionRe := complexFunctionRe.function with values
  have functionIm := complexFunctionIm.function with values
  have functionHRe := complexFunctionRe.function with valuesH
  have functionHIm := complexFunctionIm.function with valuesH
  have sameRe : complexFunctionRe(h) = complexFunctionRe(g)
    apply FunctionBetween.ext with functionHRe, functionRe
    intros X xMember
    have xReal : Real(X) by exact xMember
    have value := values with X, xMember
    rw [(complexFunctionRe.apply with valuesH), (complexFunctionRe.apply with
      values), (conjugate with X, xMember), (complexConj.re with value)]
  have valuesIm : ∀ X ∈ ℝ, complexFunctionIm(h)(X) =
      R[-1 * complexFunctionIm(g)(X) + 0 * complexFunctionIm(g)(X)]
    intros X xMember
    have xReal : Real(X) by exact xMember
    have value := values with X, xMember
    have imReal := complexIm.real with value
    rw [(complexFunctionIm.apply with valuesH), (complexFunctionIm.apply with
      values), (conjugate with X, xMember), (complexConj.im with value)]
    ring
  have integralIm := riemannIntegral.integral with integrableIm
  have negated := HasRiemannIntegral.linear with integralIm, integralIm,
    functionHIm, valuesIm
  have valueIm := riemannIntegral.eq_of_integral with negated
  obtain ⟨realIm, _⟩ := riemannIntegral.selected at complexFunctionIm(g), A, B
  obtain ⟨realRe, _⟩ := riemannIntegral.selected at complexFunctionRe(g), A, B
  have negatedReal : R[-1 * riemannIntegral(complexFunctionIm(g), A, B) +
    0 * riemannIntegral(complexFunctionIm(g), A, B)] ∈ ℝ by typecheck
  refine ⟨⟨valuesH, ?_, ⟨R[-1 * riemannIntegral(complexFunctionIm(g), A, B) +
    0 * riemannIntegral(complexFunctionIm(g), A, B)], negatedReal, negated⟩⟩,
    ?_⟩
  . rw sameRe
    exact integrableRe
  unfold complexIntegral
  rw [sameRe, valueIm, complexConj.pair]
  have shape : R[-1 * riemannIntegral(complexFunctionIm(g), A, B) +
      0 * riemannIntegral(complexFunctionIm(g), A, B)] =
    R[-riemannIntegral(complexFunctionIm(g), A, B)] by ring
  rw shape

theorem HasComplexImproperIntegral.conj (g h : Set) (A : Real) (I : Set)
  requires integral : HasComplexImproperIntegral(g, A, I)
  requires valuesH : ComplexValuedOn(h, ℝ)
  requires conjugate : ∀ X ∈ ℝ, h(X) = complexConj(g(X))
  shows HasComplexImproperIntegral(h, A, complexConj(I))
proof
  obtain ⟨values, memberI, local, limit⟩ := integral
  have conjI := complexConj.member with memberI
  refine ⟨valuesH, conjI, ?_, ?_⟩
  . intros T tMember later
    obtain ⟨integrable, _⟩ := complexIntegral.conj with
      (local with T, tMember, later), valuesH, conjugate
    exact integrable
  . intros e eMember ePositive
    obtain ⟨T0, t0Real, near⟩ := limit with e, eMember, ePositive
    refine ⟨T0, t0Real, ?_⟩
    intros T tMember later afterA
    have tReal : Real(T) by exact tMember
    obtain ⟨_, value⟩ := complexIntegral.conj with
      (local with T, tMember, afterA), valuesH, conjugate
    have integralMember := complexIntegral.member at g, A, T
    have difference : ℂ[complexIntegral(g, A, T) - I] ∈ ℂ by typecheck
    have negatedI : ℂ[-I] ∈ ℂ by typecheck
    rw [value, ← (GRH.Exp.complexConj.neg with memberI), ← (complexConj.add
      with integralMember, negatedI), (complexAbs.conj with difference)]
    exact near with T, tMember, later, afterA

theorem complexImproperIntegral.conj (g h : Set) (A : Real)
  requires values : ComplexValuedOn(g, ℝ)
  requires valuesH : ComplexValuedOn(h, ℝ)
  requires conjugate : ∀ X ∈ ℝ, h(X) = complexConj(g(X))
  shows complexImproperIntegral(h, A) =
    complexConj(complexImproperIntegral(g, A))
proof
  by_cases integrable : ComplexImproperIntegrable(g, A)
  . have spec := complexImproperIntegral.spec with integrable
    have conjugated := HasComplexImproperIntegral.conj with spec, valuesH,
      conjugate
    exact complexImproperIntegral.eq with conjugated
  . have back : ∀ X ∈ ℝ, g(X) = complexConj(h(X))
      intros X xMember
      have value := values with X, xMember
      rw [(conjugate with X, xMember), (complexConj.involutive with value)]
    have notH : ¬ComplexImproperIntegrable(h, A)
      intro integrableH
      apply integrable
      obtain ⟨J, jMember, integralH⟩ := integrableH
      have conjugated := HasComplexImproperIntegral.conj with integralH, values,
        back
      exact ⟨complexConj(J), (complexConj.member with jMember), conjugated⟩
    obtain ⟨_, _, absentG⟩ := complexImproperIntegral.selected at g, A
    obtain ⟨_, _, absentH⟩ := complexImproperIntegral.selected at h, A
    rw [(absentG with integrable), (absentH with notH), complexConj.zero]

theorem complexConj.inv (z : Set)
  requires hz : z ∈ ℂ
  shows complexConj(complexInv(z)) = complexInv(complexConj(z))
proof
  by_cases zero : z = ℂ[0]
  . rw [zero, complexInv.zero, complexConj.zero, complexInv.zero]
  . have inverse := complexInv.member with hz
    have conjZ := complexConj.member with hz
    have conjInverse := complexConj.member with inverse
    have cancel := complexInv.mul_cancel with hz, zero
    have product : ℂ[complexConj(z) * complexConj(complexInv(z))] = ℂ[1]
      rw [← (complexConj.mul with hz, inverse), cancel, GRH.Exp.complexConj.one]
    symm
    exact GRH.Exp.complexInv.unique with conjZ, conjInverse, product

theorem complexConj.div (z w : Set)
  requires hz : z ∈ ℂ
  requires hw : w ∈ ℂ
  shows complexConj(complexDiv(z, w)) =
    complexDiv(complexConj(z), complexConj(w))
proof
  have inverse := complexInv.member with hw
  unfold complexDiv
  rw [(complexConj.mul with hz, inverse), (complexConj.inv with hw)]

-- The conjugate of −s − x for real x.
theorem complexConj.neg_sub_real (s : Set) (X : Real)
  requires hs : s ∈ ℂ
  shows complexConj(ℂ[-s - complexOfReal(X)]) =
    ℂ[-complexConj(s) - complexOfReal(X)]
proof
  have negative : ℂ[-s] ∈ ℂ by typecheck
  have negativeX : ℂ[-complexOfReal(X)] ∈ ℂ by typecheck
  have xMember := complexOfReal.mem at X
  rw [(complexConj.add with negative, negativeX),
    (GRH.Exp.complexConj.neg with hs), (GRH.Exp.complexConj.neg with xMember),
    complexConj.of_real]

theorem risingFactorial.conj (s : Set) (k : Nat)
  requires hs : s ∈ ℂ
  shows complexConj(risingFactorial(s, k)) =
    risingFactorial(complexConj(s), k)
proof
  induction k
  | zero =>
    rw [risingFactorial.zero, risingFactorial.zero, GRH.Exp.complexConj.one]
  | succ(j) using ih =>
    have rising := risingFactorial.closed at s, j with hs
    have shift := complexOfReal.mem at realNat(j)
    have sum : ℂ[s + complexOfReal(realNat(j))] ∈ ℂ by typecheck
    rw [risingFactorial.succ, risingFactorial.succ,
      (complexConj.mul with rising, sum), ih, (complexConj.add with hs, shift),
      complexConj.of_real]

theorem hurwitzCorrectionTerms.conj (s : Set) (a : Real) (k : Nat)
  requires hs : s ∈ ℂ
  shows complexConj(hurwitzCorrectionTerms(s, a)(k)) =
    hurwitzCorrectionTerms(complexConj(s), a)(k)
proof
  have conjS := complexConj.member with hs
  have scale := complexOfReal.mem at R[bernoulli(2 * k + 2) /
    realNat((2 * k + 2)!)]
  have rising := risingFactorial.closed at s, 2 * k + 1 with hs
  have exponent : ℂ[-s - complexOfReal(realNat(2 * k + 1))] ∈ ℂ by typecheck
  have power := realCpow.member at a, ℂ[-s - complexOfReal(realNat(2 * k + 1))]
    with exponent
  have product : ℂ[complexOfReal(R[bernoulli(2 * k + 2) /
    realNat((2 * k + 2)!)]) * risingFactorial(s, 2 * k + 1)] ∈ ℂ by typecheck
  rw [(hurwitzCorrectionTerms.value at s, a, k with hs),
    (hurwitzCorrectionTerms.value at complexConj(s), a, k with conjS),
    (complexConj.mul with product, power), (complexConj.mul with scale, rising),
    complexConj.of_real, (risingFactorial.conj with hs),
    (realCpow.conj with exponent), (complexConj.neg_sub_real with hs)]

theorem complexPartialSum.conj_corrections (s : Set) (a : Real) (m : Nat)
  requires hs : s ∈ ℂ
  shows complexConj(complexPartialSum(hurwitzCorrectionTerms(s, a), m)) =
    complexPartialSum(hurwitzCorrectionTerms(complexConj(s), a), m)
proof
  have terms := hurwitzCorrectionTerms.function at s, a with hs
  have sequence : ComplexSequence(hurwitzCorrectionTerms(s, a)) by exact terms
  induction m
  | zero =>
    rw [complexPartialSum.zero, complexPartialSum.zero, complexConj.zero]
  | succ(j) using ih =>
    have sum := complexPartialSum.member at hurwitzCorrectionTerms(s, a), j
      with sequence
    have jMember : j ∈ ℕ := nat.omega.forward at j with *
    have term := FunctionBetween.apply_closed with terms, jMember
    rw [complexPartialSum.succ, complexPartialSum.succ,
      (complexConj.add with sum, term), ih,
      (hurwitzCorrectionTerms.conj with hs)]

theorem hurwitzRemainder.conj (m : Nat) (s : Set) (a : Real)
  requires hs : s ∈ ℂ
  shows complexConj(hurwitzRemainder(m, s, a)) =
    hurwitzRemainder(m, complexConj(s), a)
proof
  have conjS := complexConj.member with hs
  have values : ComplexValuedOn(hurwitzIntegrand(2 * m, a, s), ℝ)
    intros Y yMember
    exact FunctionBetween.apply_closed with
      (hurwitzIntegrand.function at 2 * m, a, s with hs), yMember
  have valuesConj : ComplexValuedOn(hurwitzIntegrand(2 * m, a,
      complexConj(s)), ℝ)
    intros Y yMember
    exact FunctionBetween.apply_closed with
      (hurwitzIntegrand.function at 2 * m, a, complexConj(s) with conjS),
      yMember
  have conjugate : ∀ X ∈ ℝ, hurwitzIntegrand(2 * m, a, complexConj(s))(X) =
      complexConj(hurwitzIntegrand(2 * m, a, s)(X))
    intros X xMember
    have xReal : Real(X) by exact xMember
    have bernoulliReal : Real(periodicBernoulli(2 * m)(X))
      exact FunctionBetween.apply_closed with
        (periodicBernoulli.function at 2 * m), xMember
    have scalar := complexOfReal.mem at periodicBernoulli(2 * m)(X)
    have exponent : ℂ[-s - complexOfReal(realNat(2 * m))] ∈ ℂ by typecheck
    have power := realCpow.member at R[X + a],
      ℂ[-s - complexOfReal(realNat(2 * m))] with exponent
    rw [(hurwitzIntegrand.value at 2 * m, a, complexConj(s), X with conjS),
      (hurwitzIntegrand.value at 2 * m, a, s, X with hs),
      (complexConj.mul with scalar, power), complexConj.of_real,
      (realCpow.conj with exponent), (complexConj.neg_sub_real with hs)]
  have integral := complexImproperIntegral.conj at
    hurwitzIntegrand(2 * m, a, s), hurwitzIntegrand(2 * m, a, complexConj(s)),
    R[0] with values, valuesConj, conjugate
  have scale := complexOfReal.mem at R[1 / realNat((2 * m)!)]
  have rising := risingFactorial.closed at s, 2 * m with hs
  have improper := complexImproperIntegral.member at
    hurwitzIntegrand(2 * m, a, s), R[0]
  have product : ℂ[complexOfReal(R[1 / realNat((2 * m)!)]) *
    risingFactorial(s, 2 * m)] ∈ ℂ by typecheck
  unfold hurwitzRemainder
  rw [(complexConj.mul with product, improper),
    (complexConj.mul with scale, rising), complexConj.of_real,
    (risingFactorial.conj with hs), integral]

theorem hurwitzEulerMaclaurin.conj (m : Nat) (s : Set) (a : Real)
  requires hs : s ∈ ℂ
  shows complexConj(hurwitzEulerMaclaurin(m, s, a)) =
    hurwitzEulerMaclaurin(m, complexConj(s), a)
proof
  have one := complexOne.member
  have two : ℂ[2] ∈ ℂ by typecheck
  have raised : ℂ[1 - s] ∈ ℂ by typecheck
  have negative : ℂ[-s] ∈ ℂ by typecheck
  have shifted : ℂ[s - 1] ∈ ℂ by typecheck
  have first := realCpow.member at a, ℂ[1 - s] with raised
  have second := realCpow.member at a, ℂ[-s] with negative
  have firstInverse := complexInv.member with shifted
  have secondInverse := complexInv.member with two
  have firstTerm : complexDiv(realCpow(a, ℂ[1 - s]), ℂ[s - 1]) ∈ ℂ
    unfold complexDiv
    typecheck
  have secondTerm : complexDiv(realCpow(a, ℂ[-s]), ℂ[2]) ∈ ℂ
    unfold complexDiv
    typecheck
  have terms := hurwitzCorrectionTerms.function at s, a with hs
  have sequence : ComplexSequence(hurwitzCorrectionTerms(s, a)) by exact terms
  have sum := complexPartialSum.member at hurwitzCorrectionTerms(s, a), m with
    sequence
  have remainder := hurwitzRemainder.closed at m, s, a with hs
  have pair : ℂ[complexDiv(realCpow(a, ℂ[1 - s]), ℂ[s - 1]) +
    complexDiv(realCpow(a, ℂ[-s]), ℂ[2])] ∈ ℂ by typecheck
  have triple : ℂ[complexDiv(realCpow(a, ℂ[1 - s]), ℂ[s - 1]) +
    complexDiv(realCpow(a, ℂ[-s]), ℂ[2]) +
    complexPartialSum(hurwitzCorrectionTerms(s, a), m)] ∈ ℂ by typecheck
  have negatedRemainder : ℂ[-hurwitzRemainder(m, s, a)] ∈ ℂ by typecheck
  have minusOne : ℂ[-1] ∈ ℂ by typecheck
  have conjTwo : complexConj(ℂ[2]) = ℂ[2]
    rw [← complexOfReal.two, complexConj.of_real]
  unfold hurwitzEulerMaclaurin
  rw [(complexConj.add with triple, negatedRemainder),
    (complexConj.add with pair, sum), (complexConj.add with firstTerm,
    secondTerm), (complexConj.div with first, shifted), (complexConj.div with
    second, two), (realCpow.conj with raised), (realCpow.conj with negative),
    (complexConj.add with one, negative),
    (GRH.Exp.complexConj.neg with hs), GRH.Exp.complexConj.one,
    (complexConj.add with hs, minusOne), (GRH.Exp.complexConj.neg with one),
    GRH.Exp.complexConj.one, conjTwo, (complexPartialSum.conj_corrections with
    hs), (GRH.Exp.complexConj.neg with remainder), (hurwitzRemainder.conj with
    hs)]

theorem hurwitzRegularEulerMaclaurin.conj (m : Nat) (a : Real)
  shows complexConj(hurwitzRegularEulerMaclaurin(m, a)) =
    hurwitzRegularEulerMaclaurin(m, a)
proof
  have one := complexOne.member
  have two : ℂ[2] ∈ ℂ by typecheck
  have minusOne : ℂ[-1] ∈ ℂ by typecheck
  have logReal := realLog.real at a
  have constant := complexOfReal.mem at R[-realLog(a)]
  have power := realCpow.member at a, ℂ[-1] with minusOne
  have inverse := complexInv.member with two
  have secondTerm : complexDiv(realCpow(a, ℂ[-1]), ℂ[2]) ∈ ℂ
    unfold complexDiv
    typecheck
  have terms := hurwitzCorrectionTerms.function at ℂ[1], a with one
  have sequence : ComplexSequence(hurwitzCorrectionTerms(ℂ[1], a))
    by exact terms
  have sum := complexPartialSum.member at hurwitzCorrectionTerms(ℂ[1], a), m
    with sequence
  have remainder := hurwitzRemainder.closed at m, ℂ[1], a with one
  have pair : ℂ[complexOfReal(R[-realLog(a)]) +
    complexDiv(realCpow(a, ℂ[-1]), ℂ[2])] ∈ ℂ by typecheck
  have triple : ℂ[complexOfReal(R[-realLog(a)]) +
    complexDiv(realCpow(a, ℂ[-1]), ℂ[2]) +
    complexPartialSum(hurwitzCorrectionTerms(ℂ[1], a), m)] ∈ ℂ by typecheck
  have negatedRemainder : ℂ[-hurwitzRemainder(m, ℂ[1], a)] ∈ ℂ by typecheck
  have conjTwo : complexConj(ℂ[2]) = ℂ[2]
    rw [← complexOfReal.two, complexConj.of_real]
  unfold hurwitzRegularEulerMaclaurin
  rw [(complexConj.add with triple, negatedRemainder),
    (complexConj.add with pair, sum), (complexConj.add with constant,
    secondTerm), complexConj.of_real, (complexConj.div with power, two),
    (realCpow.conj with minusOne), (GRH.Exp.complexConj.neg with one),
    GRH.Exp.complexConj.one, conjTwo, (complexPartialSum.conj_corrections with
    one), GRH.Exp.complexConj.one, (GRH.Exp.complexConj.neg with remainder),
    (hurwitzRemainder.conj with one), GRH.Exp.complexConj.one]

theorem hurwitzOrder.conj (s : Set)
  requires hs : s ∈ ℂ
  shows hurwitzOrder(complexConj(s)) = hurwitzOrder(s)
proof
  have same : hurwitzOrders(complexConj(s)) = hurwitzOrders(s)
    ext m
    constructor
    . intro member
      unfold hurwitzOrders at member
      rw (complexConj.re with hs) at member
      unfold hurwitzOrders
      exact member
    . intro member
      unfold hurwitzOrders at member
      unfold hurwitzOrders
      rw (complexConj.re with hs)
      exact member
  unfold hurwitzOrder
  rw same

-- ζ(s̄, a) is the conjugate of ζ(s, a).
theorem hurwitzZeta.conj (s : Set) (a : Real)
  requires hs : s ∈ ℂ
  shows hurwitzZeta(complexConj(s), a) = complexConj(hurwitzZeta(s, a))
proof
  by_cases atOne : s = ℂ[1]
  . rw [atOne, GRH.Exp.complexConj.one, hurwitzZeta.at_one]
    unfold hurwitzZeta.regular
    rw hurwitzRegularEulerMaclaurin.conj
  . have conjS := complexConj.member with hs
    have conjNotOne : complexConj(s) ≠ ℂ[1]
      intro same
      apply atOne
      rw [← (complexConj.involutive with hs), same, GRH.Exp.complexConj.one]
    rw [(hurwitzZeta.eq_order with conjS, conjNotOne),
      (hurwitzZeta.eq_order with hs, atOne), (hurwitzOrder.conj with hs),
      (hurwitzEulerMaclaurin.conj with hs)]

-- (−1)^(2k+1) = −1.
theorem complexPow.neg_one_odd (k : Nat)
  shows ℂ[(-1) ^ (2 * k + 1)] = ℂ[-1]
proof
  have minusOne : ℂ[-1] ∈ ℂ by typecheck
  induction k
  | zero =>
    rw [natural.odd_zero, monoidPow.succ, monoidPow.zero]
    ring
  | succ(j) using ih =>
    have succNat : Nat(succ(j)) by typecheck
    have index : 2 * succ(j) + 1 = succ(succ(2 * j + 1)) by arith
    have power := complexPow.member at ℂ[-1], 2 * j + 1 with minusOne
    rw [index, monoidPow.succ, monoidPow.succ, ih]
    ring

-- At −(j + m): s(s + 1)⋯(s + j − 1) m! = (−1)^j (j + m)!.
theorem risingFactorial.neg_factorial (j m : Nat)
  shows ℂ[risingFactorial(ℂ[-complexOfReal(realNat(j + m))], j) *
    complexOfReal(realNat(m!))] =
    ℂ[(-1) ^ j * complexOfReal(realNat((j + m)!))]
proof
  have minusOne : ℂ[-1] ∈ ℂ by typecheck
  induction j generalizing m
  | zero =>
    intros m mNat
    have index : 0 + m = m by arith
    rw [index, risingFactorial.zero, monoidPow.zero]
    have value := complexOfReal.mem at realNat(m!)
    ring
  | succ(i) using ih =>
    intros m mNat
    have succNat : Nat(succ(i)) by typecheck
    have succM : Nat(succ(m)) by typecheck
    have index : succ(i) + m = i + succ(m) by arith
    rw [index, risingFactorial.succ]
    have previous := ih at succ(m)
    have point := complexOfReal.mem at realNat(i + succ(m))
    have negated : ℂ[-complexOfReal(realNat(i + succ(m)))] ∈ ℂ by typecheck
    have rising := risingFactorial.closed at ℂ[-complexOfReal(realNat(i +
      succ(m)))], i with negated
    have factor : ℂ[-complexOfReal(realNat(i + succ(m))) +
        complexOfReal(realNat(i))] = ℂ[-complexOfReal(realNat(succ(m)))]
      have first := complexOfReal.mem at realNat(i)
      have second := complexOfReal.mem at realNat(succ(m))
      rw [realNat.add, complexOfReal.add]
      ring
    have factorial := realNat.factorial_succ at m
    rw [(add.right_one at m), ← realNat.succ_value] at factorial
    rw [factorial, complexOfReal.mul] at previous
    rw [factor, monoidPow.succ]
    have succMember := complexOfReal.mem at realNat(succ(m))
    have factorialMember := complexOfReal.mem at realNat(m!)
    have bigMember := complexOfReal.mem at realNat((i + succ(m))!)
    have power := complexPow.member at ℂ[-1], i with minusOne
    linear_combination (-1) * previous

-- Quotients of reals in ℂ.
theorem complexOfReal.div (Y X : Real)
  requires nonzero : X ≠ R[0]
  shows complexOfReal(R[Y / X]) =
    ℂ[complexOfReal(Y) * complexInv(complexOfReal(X))]
proof
  rw [realDiv.eq_mul_inv, complexOfReal.mul, (complexOfReal.inv with nonzero)]

theorem complexOfReal.neg_inv_mul (X Y : Real)
  requires nonzero : X ≠ R[0]
  shows complexOfReal(R[-(1 / X) * Y]) =
    ℂ[-(complexInv(complexOfReal(X)) * complexOfReal(Y))]
proof
  have inverseReal := realInvValue.real at X
  have shape : R[-(1 / X) * Y] = R[-(realInvValue(X) * Y)]
    rw realDiv.eq_mul_inv
    ring
  rw [shape, complexOfReal.neg, complexOfReal.mul,
    (complexOfReal.inv with nonzero)]

-- The algebra of one boundary term at s = −n.
theorem negNat.term_algebra (B P rf fn fm fK c n1 : Set)
  requires hB : B ∈ ℂ
  requires hP : P ∈ ℂ
  requires hrf : rf ∈ ℂ
  requires hfn : fn ∈ ℂ
  requires hfm : fm ∈ ℂ
  requires hfK : fK ∈ ℂ
  requires hc : c ∈ ℂ
  requires hn1 : n1 ∈ ℂ
  requires nonzeroM : fm ≠ ℂ[0]
  requires nonzeroK : fK ≠ ℂ[0]
  requires nonzeroN : n1 ≠ ℂ[0]
  requires risingFact : ℂ[rf * fm] = ℂ[-fn]
  requires chooseFact : ℂ[c * (fK * fm)] = ℂ[n1 * fn]
  shows ℂ[B * complexInv(fK) * rf * P] =
    ℂ[-(complexInv(n1) * (c * B * P))]
proof
  have inverseM := complexInv.member with hfm
  have inverseK := complexInv.member with hfK
  have inverseN := complexInv.member with hn1
  have cancelM := complexInv.mul_cancel with hfm, nonzeroM
  have cancelK := complexInv.mul_cancel with hfK, nonzeroK
  have cancelN := complexInv.mul_cancel with hn1, nonzeroN
  have rfValue : rf = ℂ[-fn * complexInv(fm)]
    linear_combination complexInv(fm) * risingFact - rf * cancelM
  have cValue : c = ℂ[n1 * fn * complexInv(fK) * complexInv(fm)]
    linear_combination (complexInv(fK) * complexInv(fm)) * chooseFact -
      (c * fm * complexInv(fm)) * cancelK - c * cancelM
  rw [rfValue, cValue]
  linear_combination (B * complexInv(fK) * fn * complexInv(fm) * P) * cancelN

-- The boundary term k at s = −n is −C(n + 1, 2k + 2) B_{2k+2} a^(n−2k−1)/(n + 1).
theorem hurwitzCorrectionTerms.neg_nat (n k : Nat) (a : Real)
  requires positive : R[0] < a
  shows hurwitzCorrectionTerms(ℂ[-complexOfReal(realNat(n))], a)(k) =
    complexOfReal(R[-(1 / realNat(n + 1)) *
      bernoulliPolynomialTerms(n + 1, a)(2 * k + 2)])
proof
  have bernoulliReal := bernoulli.real at 2 * k + 2
  have bernoulliMember := complexOfReal.mem at bernoulli(2 * k + 2)
  have indexMember : 2 * k + 2 ∈ ℕ := nat.omega.forward at 2 * k + 2 with *
  have nPositive : realNat(n + 1) ≠ R[0]
    have nonzero : n + 1 ≠ (0:N) by arith
    exact realNat.ne_zero with nonzero
  by_cases small : 2 * k + 1 ≤ n
  . obtain ⟨m, mNat, same⟩ := LessEqual.exists_add with small
    rw same
    rw same at nPositive
    have point : ℂ[-complexOfReal(realNat(2 * k + 1 + m))] ∈ ℂ by typecheck
    rw [(hurwitzCorrectionTerms.value at ℂ[-complexOfReal(realNat(2 * k + 1 + m))], a, k with point),
      (bernoulliPolynomialTerms.value at 2 * k + 1 + m + 1, a, 2 * k + 2)]
    -- The power a^m.
    have exponent : ℂ[-ℂ[-complexOfReal(realNat(2 * k + 1 + m))] - complexOfReal(realNat(2 * k + 1))] =
        complexOfReal(realNat(m))
      have first := complexOfReal.mem at realNat(2 * k + 1)
      have second := complexOfReal.mem at realNat(m)
      rw [realNat.add, complexOfReal.add]
      ring
    have remaining : 2 * k + 1 + m + 1 - (2 * k + 2) = m by arith
    rw [exponent, (realCpow.nat with positive), remaining]
    -- The rising factorial and the binomial coefficient.
    have rising := risingFactorial.neg_factorial at 2 * k + 1, m
    rw complexPow.neg_one_odd at rising
    have chooseFactorial := choose.factorial at m
    have kk : Nat(2 * k + 2) by typecheck
    have instance := chooseFactorial with 2 * k + 2, kk
    have total : m + (2 * k + 2) = 2 * k + 1 + m + 1 by arith
    rw total at instance
    have bigFactorial := realNat.factorial_succ at 2 * k + 1 + m
    have realChoose : R[realNat(choose(2 * k + 1 + m + 1, 2 * k + 2)) *
        (realNat((2 * k + 2)!) * realNat(m!))] =
        R[(realNat(2 * k + 1 + m) + 1) * realNat((2 * k + 1 + m)!)]
      rw [← bigFactorial, ← realNat.mul, ← realNat.mul, instance]
    have successor := realNat.add at 2 * k + 1 + m, 1
    rw realNat.one at successor
    rw ← successor at realChoose
    have complexChoose : complexOfReal(R[realNat(choose(2 * k + 1 + m + 1, 2 * k + 2)) *
        (realNat((2 * k + 2)!) * realNat(m!))]) =
        complexOfReal(R[realNat(2 * k + 1 + m + 1) * realNat((2 * k + 1 + m)!)])
      rw realChoose
    rw [complexOfReal.mul, complexOfReal.mul, complexOfReal.mul] at
      complexChoose
    have kFactorial := realNat.factorial_nonzero at 2 * k + 2
    have mFactorial := realNat.factorial_nonzero at m
    rw [(complexOfReal.div with kFactorial), (complexOfReal.neg_inv_mul with
      nPositive), complexOfReal.mul, complexOfReal.mul]
    have powerValue : complexOfReal(realPow(a, m)) = ℂ[complexOfReal(a) ^ m]
      unfold realPow
      exact complexOfReal.pow at a, m
    rw powerValue
    have risingFact : ℂ[risingFactorial(ℂ[-complexOfReal(realNat(2 * k + 1 + m))], 2 * k + 1) *
        complexOfReal(realNat(m!))] = ℂ[-complexOfReal(realNat((2 * k + 1 + m)!))]
      have bigMember := complexOfReal.mem at realNat((2 * k + 1 + m)!)
      rw rising
      ring
    have power := complexPow.member at complexOfReal(a), m with
      (complexOfReal.mem at a)
    have risingMember := risingFactorial.closed at ℂ[-complexOfReal(realNat(2 * k + 1 + m))], 2 * k + 1 with point
    have mNonzero : complexOfReal(realNat(m!)) ≠ ℂ[0]
      intro zero
      rw ← complexOfReal.zero at zero
      exact mFactorial with (complexOfReal.injective with zero)
    have kNonzero : complexOfReal(realNat((2 * k + 2)!)) ≠ ℂ[0]
      intro zero
      rw ← complexOfReal.zero at zero
      exact kFactorial with (complexOfReal.injective with zero)
    have nNonzero : complexOfReal(realNat(2 * k + 1 + m + 1)) ≠ ℂ[0]
      intro zero
      rw ← complexOfReal.zero at zero
      exact nPositive with (complexOfReal.injective with zero)
    exact negNat.term_algebra with bernoulliMember, power, risingMember,
      (complexOfReal.mem at realNat((2 * k + 1 + m)!)), (complexOfReal.mem at
      realNat(m!)), (complexOfReal.mem at realNat((2 * k + 2)!)),
      (complexOfReal.mem at realNat(choose(2 * k + 1 + m + 1, 2 * k + 2))),
      (complexOfReal.mem at realNat(2 * k + 1 + m + 1)), mNonzero, kNonzero, nNonzero,
      risingFact, complexChoose
  . have large : n < 2 * k + 1 by arith
    have point : ℂ[-complexOfReal(realNat(n))] ∈ ℂ by typecheck
    have vanishing := risingFactorial.neg_nat with large
    rw [(hurwitzCorrectionTerms.value at ℂ[-complexOfReal(realNat(n))], a, k
      with point), vanishing,
      (bernoulliPolynomialTerms.value at n + 1, a, 2 * k + 2)]
    have below : n + 1 + 1 ≤ 2 * k + 2 by arith
    obtain ⟨j, jNat, same⟩ := LessEqual.exists_add with below
    have succJ : Nat(succ(j)) by typecheck
    have index : n + 1 + 1 + j = n + 1 + succ(j) by arith
    rw index at same
    have chooseZero := choose.above at n + 1
    have instance := chooseZero with j, jNat
    rw ← same at instance
    rw [instance, realNat.zero]
    have exponent : ℂ[-ℂ[-complexOfReal(realNat(n))] -
      complexOfReal(realNat(2 * k + 1))] ∈ ℂ by typecheck
    have power := realCpow.member at a, ℂ[-ℂ[-complexOfReal(realNat(n))] -
      complexOfReal(realNat(2 * k + 1))] with exponent
    have coefficient := complexOfReal.mem at R[bernoulli(2 * k + 2) /
      realNat((2 * k + 2)!)]
    have inverseReal : Real(R[1 / realNat(n + 1)]) by typecheck
    have powerReal : Real(realPow(a, n + 1 - (2 * k + 2))) by typecheck
    have zeroValue : R[-(1 / realNat(n + 1)) * (0 * bernoulli(2 * k + 2) *
      realPow(a, n + 1 - (2 * k + 2)))] = R[0] by ring
    rw [zeroValue, complexOfReal.zero]
    ring

-- The partial sums of the boundary terms at s = −n.
theorem hurwitzCorrectionTerms.neg_nat_sum (n K : Nat) (a : Real)
  requires positive : R[0] < a
  shows complexPartialSum(hurwitzCorrectionTerms(ℂ[-complexOfReal(realNat(n))],
    a), K) = complexOfReal(R[-(1 / realNat(n + 1)) *
      (∑ k < K, evenBernoulliTerms(n + 1, a)(k))])
proof
  have sequence := evenBernoulliTerms.function at n + 1, a
  have realSequence : RealSequence(evenBernoulliTerms(n + 1, a))
    by exact sequence
  have inverseReal : Real(R[1 / realNat(n + 1)]) by typecheck
  induction K
  | zero =>
    rw [complexPartialSum.zero, realPartialSum.zero]
    have zero : R[-(1 / realNat(n + 1)) * 0] = R[0] by ring
    rw [zero, complexOfReal.zero]
  | succ(j) using ih =>
    have jMember : j ∈ ℕ := nat.omega.forward at j with *
    have previous := realPartialSum.real at evenBernoulliTerms(n + 1, a), j
      with realSequence
    have term := FunctionBetween.apply_closed with sequence, jMember
    have termReal : Real(evenBernoulliTerms(n + 1, a)(j)) by exact term
    rw [complexPartialSum.succ, ih, realPartialSum.succ, realAddValue.eq_add,
      (hurwitzCorrectionTerms.neg_nat with positive),
      (evenBernoulliTerms.value at n + 1, a, j with jMember)]
    have split : R[-(1 / realNat(n + 1)) *
        ((∑ k < j, evenBernoulliTerms(n + 1, a)(k)) +
          bernoulliPolynomialTerms(n + 1, a)(2 * j + 2))] =
      R[-(1 / realNat(n + 1)) * (∑ k < j, evenBernoulliTerms(n + 1, a)(k)) +
        -(1 / realNat(n + 1)) * bernoulliPolynomialTerms(n + 1, a)(2 * j + 2)]
      by ring
    rw [split, complexOfReal.add]

-- Pairing: the sum over j < 2K + 2 is u₀ + u₁ + Σ_{k<K} u_{2k+2} when the
-- odd terms u_{2k+3} vanish.
theorem bernoulliPolynomialTerms.pairing (n K : Nat) (x : Real)
  requires odd : ∀ k ∈ ℕ, bernoulliPolynomialTerms(n, x)(2 * k + 3) = R[0]
  shows (∑ j < 2 * K + 2, bernoulliPolynomialTerms(n, x)(j)) =
    R[bernoulliPolynomialTerms(n, x)((0:N)) + bernoulliPolynomialTerms(n, x)((1:N)) +
      (∑ k < K, evenBernoulliTerms(n, x)(k))]
proof
  have terms := bernoulliPolynomialTerms.function at n, x
  have sequence : RealSequence(bernoulliPolynomialTerms(n, x)) by exact terms
  have evens := evenBernoulliTerms.function at n, x
  have evenSequence : RealSequence(evenBernoulliTerms(n, x)) by exact evens
  have zeroMember : (0:N) ∈ ℕ := nat.omega.forward at (0:N) with *
  have oneMember : (1:N) ∈ ℕ := nat.omega.forward at (1:N) with *
  have first := FunctionBetween.apply_closed with terms, zeroMember
  have second := FunctionBetween.apply_closed with terms, oneMember
  have firstReal : Real(bernoulliPolynomialTerms(n, x)((0:N))) by exact first
  have secondReal : Real(bernoulliPolynomialTerms(n, x)((1:N))) by exact second
  induction K
  | zero =>
    have index := natural.double_zero_two
    rw [index, realPartialSum.zero, natural.two_succ, realPartialSum.succ,
      natural.one_succ, realPartialSum.succ, realPartialSum.zero,
      ← natural.one_succ, realAddValue.eq_add, realAddValue.eq_add]
    ring
  | succ(j) using ih =>
    have jMember : j ∈ ℕ := nat.omega.forward at j with *
    have succNat : Nat(succ(j)) by typecheck
    have index : 2 * succ(j) + 2 = succ(succ(2 * j + 2)) by arith
    have oddIndex : succ(2 * j + 2) = 2 * j + 3 by arith
    have evenMember : 2 * j + 2 ∈ ℕ by typecheck
    have oddMember : 2 * j + 3 ∈ ℕ by typecheck
    have evenTerm := FunctionBetween.apply_closed with terms, evenMember
    have evenReal : Real(bernoulliPolynomialTerms(n, x)(2 * j + 2))
      by exact evenTerm
    have previous := realPartialSum.real at bernoulliPolynomialTerms(n, x),
      2 * j + 2 with sequence
    have previousEven := realPartialSum.real at evenBernoulliTerms(n, x), j
      with evenSequence
    rw [index, realPartialSum.succ, realPartialSum.succ, ih, oddIndex,
      (odd with j, jMember), realPartialSum.succ,
      (evenBernoulliTerms.value at n, x, j with jMember), realAddValue.eq_add,
      realAddValue.eq_add, realAddValue.eq_add]
    ring

-- A sum is unchanged by terms beyond its range that vanish.
theorem realPartialSum.vanishing_tail (w : Set) (A d : Nat)
  requires vanishing : ∀ j ∈ ℕ, A ≤ j → w(j) = R[0]
  requires sequence : RealSequence(w)
  shows (∑ j < A + d, w(j)) = (∑ j < A, w(j))
proof
  have function : w : ℕ → ℝ by exact sequence
  induction d
  | zero =>
    have same : A + 0 = A by arith
    rw same
  | succ(i) using ih =>
    have succNat : Nat(succ(i)) by typecheck
    have index : A + succ(i) = succ(A + i) by arith
    have member : A + i ∈ ℕ by typecheck
    have later : A ≤ A + i by arith
    have previous := realPartialSum.real at w, A + i with sequence
    rw [index, realPartialSum.succ, ih, (vanishing with A + i, member, later),
      realAddValue.eq_add]
    have previousA := realPartialSum.real at w, A with sequence
    ring

-- Section: Values
-- ζ(−n, a) = −B_{n+1}(a)/(n + 1); in particular ζ(0, a) = 1/2 − a.
theorem hurwitzZeta.neg_nat (n : Nat) (a : Real)
  requires positive : R[0] < a
  shows hurwitzZeta(ℂ[-complexOfReal(realNat(n))], a) =
    complexOfReal(R[-bernoulliPolynomial(n + 1, a) / realNat(n + 1)])
proof
  have point : ℂ[-complexOfReal(realNat(n))] ∈ ℂ by typecheck
  have nMember := complexOfReal.mem at realNat(n)
  have nonnegative := realNat.nonnegative at n
  have successor := realNat.add at n, 1
  rw realNat.one at successor
  have reValue : complexRe(ℂ[-complexOfReal(realNat(n))]) = R[-realNat(n)]
    rw [(complexRe.neg with nMember), complexOfReal.re]
  have notOne : ℂ[-complexOfReal(realNat(n))] ≠ ℂ[1]
    intro same
    have reSame : complexRe(ℂ[-complexOfReal(realNat(n))]) = complexRe(ℂ[1])
      rw same
    rw [reValue, ← complexOfReal.one, complexOfReal.re] at reSame
    linarith
  have positiveOrder : 1 ≤ n + 1 by arith
  have halfPlane : R[1 - 2 * realNat(n + 1)] <
      complexRe(ℂ[-complexOfReal(realNat(n))])
    rw [reValue, successor]
    linarith
  rw (hurwitzZeta.eq_euler_maclaurin with positive, point, notOne,
    positiveOrder, halfPlane)
  -- The remainder vanishes.
  have large : n < 2 * (n + 1) by arith
  have vanishing := risingFactorial.neg_nat with large
  have remainderZero : hurwitzRemainder(n + 1, ℂ[-complexOfReal(realNat(n))],
      a) = ℂ[0]
    unfold hurwitzRemainder
    rw vanishing
    have scale := complexOfReal.mem at R[1 / realNat((2 * (n + 1))!)]
    have integral := complexImproperIntegral.member at hurwitzIntegrand(2 *
      (n + 1), a, ℂ[-complexOfReal(realNat(n))]), R[0]
    ring
  -- The powers of a.
  have raised : ℂ[1 - ℂ[-complexOfReal(realNat(n))]] =
      complexOfReal(realNat(n + 1))
    rw [successor, complexOfReal.add, complexOfReal.one]
    ring
  have lowered : ℂ[-ℂ[-complexOfReal(realNat(n))]] = complexOfReal(realNat(n))
    ring
  have shifted : ℂ[ℂ[-complexOfReal(realNat(n))] - 1] =
      ℂ[-complexOfReal(realNat(n + 1))]
    rw [successor, complexOfReal.add, complexOfReal.one]
    ring
  unfold hurwitzEulerMaclaurin
  rw [remainderZero, raised, lowered, shifted, (realCpow.nat with positive),
    (realCpow.nat with positive), (hurwitzCorrectionTerms.neg_nat_sum with
    positive)]
  -- The Bernoulli polynomial.
  have terms := bernoulliPolynomialTerms.function at n + 1, a
  have sequence : RealSequence(bernoulliPolynomialTerms(n + 1, a))
    by exact terms
  have odd : ∀ k ∈ ℕ, bernoulliPolynomialTerms(n + 1, a)(2 * k + 3) = R[0]
    intros k kMember
    have kNat := nat.omega.backward with kMember
    rw [bernoulliPolynomialTerms.value, bernoulli.odd]
    have chooseReal := realNat.real at choose(n + 1, 2 * k + 3)
    have powerReal : Real(realPow(a, n + 1 - (2 * k + 3))) by typecheck
    ring
  have beyond : ∀ j ∈ ℕ, succ(n + 1) ≤ j →
      bernoulliPolynomialTerms(n + 1, a)(j) = R[0]
    intros j jMember later
    have jNat := nat.omega.backward with jMember
    obtain ⟨i, iNat, same⟩ := LessEqual.exists_add with later
    have succI : Nat(succ(i)) by typecheck
    have succN : Nat(succ(n + 1)) by typecheck
    have index : succ(n + 1) + i = n + 1 + succ(i) by arith
    rw index at same
    have chooseZero := choose.above at n + 1
    have instance := chooseZero with i, iNat
    rw ← same at instance
    rw [bernoulliPolynomialTerms.value, instance, realNat.zero]
    have bernoulliReal := bernoulli.real at j
    have powerReal : Real(realPow(a, n + 1 - j)) by typecheck
    ring
  have tail := realPartialSum.vanishing_tail at
    bernoulliPolynomialTerms(n + 1, a), succ(n + 1), n + 2 with beyond,
    sequence
  have succTotal : Nat(succ(n + 1)) by typecheck
  have total : succ(n + 1) + (n + 2) = 2 * (n + 1) + 2 by arith
  rw total at tail
  have paired := bernoulliPolynomialTerms.pairing at n + 1, n + 1, a with odd
  rw tail at paired
  unfold bernoulliPolynomial
  rw paired
  sorry

theorem hurwitzZeta.zero (a : Real)
  requires positive : R[0] < a
  shows hurwitzZeta(ℂ[0], a) = complexOfReal(R[1 / 2 - a])
proof
  have zero : ℂ[0] ∈ ℂ by typecheck
  have one := complexOne.member
  have notOne : ℂ[0] ≠ ℂ[1]
    intro same
    rw [← complexOfReal.zero, ← complexOfReal.one] at same
    have real := complexOfReal.injective with same
    linarith
  have unit : (1:N) ≤ (1:N) by arith
  have halfPlane : R[1 - 2 * realNat((1:N))] < complexRe(ℂ[0])
    rw [← complexOfReal.zero, complexOfReal.re, realNat.one]
    linarith
  rw (hurwitzZeta.eq_euler_maclaurin with positive, zero, notOne, unit,
    halfPlane)
  -- The rising factorials at 0 vanish from order 1 on.
  have risingOne : risingFactorial(ℂ[0], (1:N)) = ℂ[0]
    have index := natural.one_succ
    rw [index, risingFactorial.succ, risingFactorial.zero, realNat.zero,
      complexOfReal.zero]
    ring
  have risingTwo : risingFactorial(ℂ[0], (2:N)) = ℂ[0]
    have index := natural.two_succ
    rw [index, risingFactorial.succ, risingOne]
    have shift : complexOfReal(realNat((1:N))) ∈ ℂ by typecheck
    ring
  have terms := hurwitzCorrectionTerms.function at ℂ[0], a with zero
  have zeroMember : (0:N) ∈ ℕ := nat.omega.forward at (0:N) with *
  have sumOne : complexPartialSum(hurwitzCorrectionTerms(ℂ[0], a), (1:N)) = ℂ[0]
    have index := natural.one_succ
    have indexTerm := natural.double_zero_succ
    rw [index, complexPartialSum.succ, complexPartialSum.zero,
      (hurwitzCorrectionTerms.value at ℂ[0], a, 0 with zero), indexTerm,
      risingOne]
    have coefficient := complexOfReal.mem at
      R[bernoulli((2:N) * (0:N) + (2:N)) / realNat(((2:N) * (0:N) + (2:N))!)]
    have power := realCpow.member at a,
      ℂ[-ℂ[0] - complexOfReal(realNat((1:N)))]
    ring
  have remainderZero : hurwitzRemainder((1:N), ℂ[0], a) = ℂ[0]
    have index := natural.double_one
    unfold hurwitzRemainder
    rw [index, risingTwo]
    have coefficient := complexOfReal.mem at R[1 / realNat((2:N)!)]
    have integral := complexImproperIntegral.member at
      hurwitzIntegrand((2:N), a, ℂ[0]), R[0]
    ring
  have exponentOne : ℂ[1 - 0] = ℂ[1] by ring
  have exponentZero : ℂ[-0] = ℂ[0] by ring
  have minusOne : ℂ[0 - 1] = complexOfReal(R[-1])
    rw [complexOfReal.neg, complexOfReal.one]
    ring
  have minusOneNonzero : R[-1] ≠ R[0] by linarith
  have twoNonzero : R[2] ≠ R[0] by linarith
  have two : ℂ[2] = complexOfReal(R[2])
    have expand : R[2] = R[1 + 1] by ring
    rw [expand, complexOfReal.add, complexOfReal.one]
    ring
  unfold hurwitzEulerMaclaurin
  unfold complexDiv
  rw [sumOne, remainderZero, exponentOne, exponentZero,
    (realCpow.one with positive), realCpow.zero, minusOne, two,
    (complexInv.of_real with minusOneNonzero),
    (complexInv.of_real with twoNonzero)]
  have quotientOne : R[1 / -1] = R[-1]
    rw realDiv.eq_mul_inv
    have inverse := realInvValue.mul_left with minusOneNonzero
    have inverseReal := realInvValue.real at R[-1]
    linear_combination (-1) * inverse
  rw [quotientOne, ← complexOfReal.mul]
  have aMember := complexOfReal.mem at R[a * -1]
  have halfMember := complexOfReal.mem at R[1 / 2]
  have target : R[1 / 2 - a] = R[a * -1 + 1 / 2] by ring
  rw [target, complexOfReal.add]
  ring

-- The constant term is real.
theorem hurwitzZeta.regular_real (a : Real)
  shows complexIm(hurwitzZeta.regular(a)) = R[0]
proof
  have member := hurwitzRegularEulerMaclaurin.closed at 1, a
  have same := hurwitzRegularEulerMaclaurin.conj at 1, a
  have parts := complexConj.im with member
  rw same at parts
  have imReal := complexIm.real with member
  unfold hurwitzZeta.regular
  linarith

-- For real s the value is real (at s = 1, the constant term).
theorem hurwitzZeta.real (S a : Real)
  requires positive : R[0] < a
  shows complexIm(hurwitzZeta(complexOfReal(S), a)) = R[0]
proof
  have point := complexOfReal.mem at S
  have member := hurwitzZeta.member at complexOfReal(S), a with point
  have same := hurwitzZeta.conj at complexOfReal(S), a with point
  rw complexConj.of_real at same
  have parts := complexConj.im with member
  rw ← same at parts
  have imReal := complexIm.real with member
  linarith

end Hurwitz
