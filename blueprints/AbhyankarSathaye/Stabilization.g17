-- Stabilization: in every dimension 4 + k, the polynomial F read in the
-- first four variables still has a polynomial fibre, ℂ[4 + k] ⧸ (F) ≅
-- ℂ[3 + k], and is still not a coordinate, by the same critical point
-- extended by zeros.
-- Part of the Abhyankar–Sathaye blueprint. Planned home: AlgebraicGeometry/Coordinates/Stabilization.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module AbhyankarSathaye.Stabilization
import Fibre
import CriticalPoint
import NoCoordinate

-- F in ℂ[4 + k], by the inclusion of the first four variables.
def extendedF (k : Nat) : Set :=
  polynomialRename(complexRing, 4, 4 + k, identity(4))(ambientF)

def extendedIdeal (k : Nat) : Set :=
  generatedIdeal(polynomialRing(complexRing, 4 + k), {extendedF(k)})

-- The critical point extended by zeros.
def extendedPoint (k : Nat) : Set :=
  { p ∈ (4 + k) × complexCarrier | (fst(p) ∈ 4 ∧ snd(p) = criticalPoint(fst(p))) ∨
    (fst(p) ∉ 4 ∧ snd(p) = complexZero) }

section Stabilization
variable (k : Nat)

theorem extendedF.mem
  shows extendedF(k) ∈ Ring.carrier(polynomialRing(complexRing, 4 + k))
proof
  sorry

theorem extendedPoint.function
  shows extendedPoint(k) : 4 + k → Ring.carrier(complexRing)
proof
  sorry

-- Evaluation at the extended point reads the first four coordinates.
theorem extendedPoint.eval (f : Set)
  requires member : f ∈ Ring.carrier(polynomialRing(complexRing, 4))
  shows evaluationAt(complexRing, 4 + k, extendedPoint(k))(polynomialRename(complexRing, 4, 4 + k, identity(4))(f)) =
    evaluationAt(complexRing, 4, criticalPoint)(f)
proof
  sorry

theorem extendedF.eval
  shows evaluationAt(complexRing, 4 + k, extendedPoint(k))(extendedF(k)) = complexNeg(complexOne)
proof
  sorry

theorem extendedF.critical (i : Set)
  requires index : i ∈ 4 + k
  shows evaluationAt(complexRing, 4 + k, extendedPoint(k))(
    partialDerivative(complexRing, 4 + k, i)(extendedF(k))) = complexZero
proof
  sorry

-- ℂ[4 + k] ⧸ (F) is ℂ[3 + k]: the fibre of F tensored with k more variables.
theorem extended_fibre
  shows ∃ e, e : quotientAlgebra(polynomialAlgebra(complexRing, 4 + k), extendedIdeal(k)) ≃ₐ
    polynomialAlgebra(complexRing, 3 + k)
proof
  sorry

theorem extendedF.not_coordinate
  shows ¬ (∃ e, ∃ i ∈ 4 + k,
    (e : polynomialAlgebra(complexRing, 4 + k) ≃ₐ polynomialAlgebra(complexRing, 4 + k)) ∧
    e(X(complexRing, 4 + k, i)) = extendedF(k))
proof
  sorry

end Stabilization
