-- Stabilization: in every dimension 4 + k, the polynomial F read in the
-- first four variables still has a polynomial fibre, ℂ[4 + k] ⧸ (F) ≅
-- ℂ[3 + k], and is still not a coordinate, by the same critical point
-- extended by zeros.
-- Part of the Abhyankar–Sathaye blueprint. Planned home: AlgebraicGeometry/Coordinates/Stabilization.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module AbhyankarSathaye.Stabilization
import Fibre
import CriticalPoint
import NoCoordinate

-- F in ℂ[4 + k], by the inclusion of the first four variables.
def extendedF (k : Nat) : Set :=
  polynomialRename(complexRing, 4, 4 + k, identity(4))(ambientF)

def extendedIdeal (k : Nat) : Set :=
  generatedIdeal(polynomialRing(complexRing, 4 + k), {extendedF(k)})

-- The critical point extended by zeros.
def extendedPoint (k : Nat) : Set :=
  { p ∈ (4 + k) × complexCarrier | (fst(p) ∈ 4 ∧ snd(p) = criticalPoint(fst(p))) ∨
    (fst(p) ∉ 4 ∧ snd(p) = complexZero) }

-- The inclusion of the first four positions into 4 + k.
theorem identity.into_extended (k : Nat)
  shows identity(4) : 4 → 4 + k
proof
  have subset := natural.subset_add at 4, k
  exact identity.inclusion with subset

section Rename
variable (k : Nat)
hypothesis complexes : CommRing(complexRing)
hypothesis ambient : CommRing(polynomialRing(complexRing, 4))
hypothesis extended : CommRing(polynomialRing(complexRing, 4 + k))

-- The renaming along the inclusion, as an algebra homomorphism and as a
-- ring homomorphism, and its values on the variables.
theorem extendedRename.hom
  shows polynomialRename(complexRing, 4, 4 + k, identity(4)) :
    polynomialAlgebra(complexRing, 4) →ₐ polynomialAlgebra(complexRing, 4 + k)
proof
  have map := identity.into_extended at k
  exact polynomialRename.hom at complexRing, 4, 4 + k, identity(4) with complexes, map

theorem extendedRename.ring_hom
  shows polynomialRename(complexRing, 4, 4 + k, identity(4)) :
    polynomialRing(complexRing, 4) →+* polynomialRing(complexRing, 4 + k)
proof
  have hom := extendedRename.hom at k with *
  exact AlgebraHom.polynomial_ring_hom with hom

theorem extendedRename.map_X (j : Set)
  requires index : j ∈ 4
  shows polynomialRename(complexRing, 4, 4 + k, identity(4))(X(complexRing, 4, j)) =
    X(complexRing, 4 + k, j)
proof
  have map := identity.into_extended at k
  rw polynomialRename.map_X at complexRing, 4, 4 + k, identity(4), j with complexes, map, index
  rw identity.apply with index

-- The derivative of a renamed polynomial: in a variable among the first
-- four it is the renamed derivative, by the chain rule with a single
-- surviving term; in a later variable it vanishes.
theorem extendedRename.derivative_inside (f i : Set)
  requires member : f ∈ Ring.carrier(polynomialRing(complexRing, 4))
  requires index : i ∈ 4
  shows partialDerivative(complexRing, 4 + k, i)(
      polynomialRename(complexRing, 4, 4 + k, identity(4))(f)) =
    polynomialRename(complexRing, 4, 4 + k, identity(4))(partialDerivative(complexRing, 4, i)(f))
proof
  have hom := extendedRename.hom at k with *
  have ringHom := extendedRename.ring_hom at k with *
  have subset := natural.subset_add at 4, k
  have wide := subset with i, index
  have chain := polynomial_chain_rule at complexRing, 4 + k, 4,
    polynomialRename(complexRing, 4, 4 + k, identity(4)), f, i with complexes, hom, member, wide
  have values := chainTerms.values at complexRing, 4 + k,
    polynomialRename(complexRing, 4, 4 + k, identity(4)), f, i, 4 with complexes, hom, member, wide
  have derivative := partialDerivative.map_mem at complexRing, 4, i, f with complexes, ambient, index
  have image := RingHom.map_mem with ringHom, derivative
  have others : ∀ t ∈ 4, t ≠ i →
      chainTerms(complexRing, 4 + k, polynomialRename(complexRing, 4, 4 + k, identity(4)), f, i, 4)(t) =
        Ring.zero(polynomialRing(complexRing, 4 + k))
    intros t tIn apart
    have tWide := subset with t, tIn
    rw chainTerms.value at complexRing, 4 + k, polynomialRename(complexRing, 4, 4 + k, identity(4)),
      f, i, 4, t with complexes, hom, member, wide, tIn
    rw extendedRename.map_X at k, t with *
    rw partialDerivative.X_other at complexRing, 4 + k, i, t with complexes, extended, wide, tWide, apart
    have derivativeT := partialDerivative.map_mem at complexRing, 4, t, f with complexes, ambient, tIn
    have imageT := RingHom.map_mem with ringHom, derivativeT
    ring
  have own : chainTerms(complexRing, 4 + k, polynomialRename(complexRing, 4, 4 + k, identity(4)), f, i, 4)(i) =
      polynomialRename(complexRing, 4, 4 + k, identity(4))(partialDerivative(complexRing, 4, i)(f))
    rw chainTerms.value at complexRing, 4 + k, polynomialRename(complexRing, 4, 4 + k, identity(4)),
      f, i, 4, i with complexes, hom, member, wide, index
    rw extendedRename.map_X at k, i with *
    rw partialDerivative.X_self at complexRing, 4 + k, i with complexes, extended, wide
    ring
  have single := indexedRingSum.identity_single at polynomialRing(complexRing, 4 + k),
    chainTerms(complexRing, 4 + k, polynomialRename(complexRing, 4, 4 + k, identity(4)), f, i, 4), i,
    polynomialRename(complexRing, 4, 4 + k, identity(4))(partialDerivative(complexRing, 4, i)(f)), 4
    with extended, image
  rw chain
  exact single with index, others, own

theorem extendedRename.derivative_outside (f i : Set)
  requires member : f ∈ Ring.carrier(polynomialRing(complexRing, 4))
  requires index : i ∈ 4 + k
  requires outside : i ∉ 4
  shows partialDerivative(complexRing, 4 + k, i)(
      polynomialRename(complexRing, 4, 4 + k, identity(4))(f)) =
    Ring.zero(polynomialRing(complexRing, 4 + k))
proof
  have hom := extendedRename.hom at k with *
  have ringHom := extendedRename.ring_hom at k with *
  have subset := natural.subset_add at 4, k
  have chain := polynomial_chain_rule at complexRing, 4 + k, 4,
    polynomialRename(complexRing, 4, 4 + k, identity(4)), f, i with complexes, hom, member, index
  have all : ∀ t ∈ 4,
      chainTerms(complexRing, 4 + k, polynomialRename(complexRing, 4, 4 + k, identity(4)), f, i, 4)(t) =
        Ring.zero(polynomialRing(complexRing, 4 + k))
    intros t tIn
    have tWide := subset with t, tIn
    have apart : t ≠ i
      intro same
      rw same at tIn
      exact outside with tIn
    rw chainTerms.value at complexRing, 4 + k, polynomialRename(complexRing, 4, 4 + k, identity(4)),
      f, i, 4, t with complexes, hom, member, index, tIn
    rw extendedRename.map_X at k, t with *
    rw partialDerivative.X_other at complexRing, 4 + k, i, t with complexes, extended, index, tWide, apart
    have derivativeT := partialDerivative.map_mem at complexRing, 4, t, f with complexes, ambient, tIn
    have imageT := RingHom.map_mem with ringHom, derivativeT
    ring
  have zero := indexedRingSum.identity_zero at polynomialRing(complexRing, 4 + k),
    chainTerms(complexRing, 4 + k, polynomialRename(complexRing, 4, 4 + k, identity(4)), f, i, 4), 4
    with extended
  rw chain
  exact zero with all

end Rename

-- The extended quotient ℂ[4 + k] ⧸ (F) with its projection, and the maps
-- that identify it with ℂ[3 + k] given an isomorphism e of the fibre
-- ℂ[4] ⧸ (F) with ℂ[3]: forward, the variables X_i for i < 4 go to the
-- image under e of their classes, read in ℂ[3 + k] by the inclusion of
-- the first three variables, and X_{4 + j} to X_{3 + j}; backward, X_j for
-- j < 3 goes through the inverse of e and the map of the fibre into the
-- extended quotient, and X_{3 + j} to the class of X_{4 + j}.
def extendedQuotient (k : Nat) : Set :=
  quotientAlgebra(polynomialAlgebra(complexRing, 4 + k), extendedIdeal(k))

def extendedProjection (k : Nat) : Set :=
  algebraProjection(polynomialAlgebra(complexRing, 4 + k), extendedIdeal(k))

def fibreRename (k : Nat) : Set := polynomialRename(complexRing, 3, 3 + k, identity(3))

def forwardValues (e : Set, k : Nat) : Set :=
  { p ∈ (4 + k) × Ring.carrier(polynomialRing(complexRing, 3 + k)) |
    (fst(p) ∈ 4 ∧ snd(p) = fibreRename(k)(e(fibreProjection(X(complexRing, 4, fst(p)))))) ∨
    (∃ j ∈ k, fst(p) = add(4, j) ∧ snd(p) = X(complexRing, 3 + k, add(3, j))) }

def forwardHom (e : Set, k : Nat) : Set :=
  evaluationHom(complexRing, polynomialRing(complexRing, 3 + k), 4 + k,
    polynomialConstant(complexRing, 3 + k), forwardValues(e, k))

def forwardLift (e : Set, k : Nat) : Set :=
  algebraLift(forwardHom(e, k), polynomialAlgebra(complexRing, 4 + k),
    polynomialAlgebra(complexRing, 3 + k), extendedIdeal(k))

-- ℂ[4] → ℂ[4 + k] ⧸ (F): rename, then project; it kills F, so it descends
-- to the fibre.
def throughRename (k : Nat) : Set :=
  compose(extendedProjection(k), polynomialRename(complexRing, 4, 4 + k, identity(4)),
    algebraCarrier(polynomialAlgebra(complexRing, 4)),
    algebraCarrier(polynomialAlgebra(complexRing, 4 + k)), algebraCarrier(extendedQuotient(k)))

def fibreToQuotient (k : Nat) : Set :=
  algebraLift(throughRename(k), ambientAlgebra, extendedQuotient(k), fibreIdeal)

def backwardValues (e : Set, k : Nat) : Set :=
  { p ∈ (3 + k) × algebraCarrier(extendedQuotient(k)) |
    (fst(p) ∈ 3 ∧ snd(p) = fibreToQuotient(k)(
      converse(e, algebraCarrier(fibreAlgebra), algebraCarrier(polynomialAlgebra(complexRing, 3)))(
        X(complexRing, 3, fst(p))))) ∨
    (∃ j ∈ k, fst(p) = add(3, j) ∧ snd(p) = extendedProjection(k)(X(complexRing, 4 + k, add(4, j)))) }

def backwardHom (e : Set, k : Nat) : Set :=
  evaluationHom(complexRing, Algebra.ring(extendedQuotient(k)), 3 + k,
    Algebra.map(extendedQuotient(k)), backwardValues(e, k))

section Extension
variable (e : Set, k : Nat)
hypothesis complexes : CommRing(complexRing)
hypothesis ambient : CommRing(polynomialRing(complexRing, 4))
hypothesis extended : CommRing(polynomialRing(complexRing, 4 + k))
hypothesis iso : e : fibreAlgebra ≃ₐ polynomialAlgebra(complexRing, 3)

-- The algebras and ideals in play.
theorem extendedIdeal.ideal
  shows Ideal(Algebra.ring(polynomialAlgebra(complexRing, 4 + k)), extendedIdeal(k))
proof
  rw polynomialAlgebra.ring
  unfold extendedIdeal
  exact generatedIdeal.ideal at polynomialRing(complexRing, 4 + k), {extendedF(k)} with extended

theorem extendedQuotient.algebra
  shows Algebra(extendedQuotient(k))
proof
  have algebra := polynomialAlgebra.algebra at complexRing, 4 + k with complexes
  have ideal := extendedIdeal.ideal at e, k with *
  unfold extendedQuotient
  exact quotientAlgebra.algebra with algebra, ideal

theorem extendedQuotient.base
  shows Algebra.base(extendedQuotient(k)) = complexRing
proof
  unfold extendedQuotient
  rw quotientAlgebra.baseOf
  exact polynomialAlgebra.base at complexRing, 4 + k

theorem extendedProjection.hom
  shows extendedProjection(k) : polynomialAlgebra(complexRing, 4 + k) →ₐ extendedQuotient(k)
proof
  have algebra := polynomialAlgebra.algebra at complexRing, 4 + k with complexes
  have ideal := extendedIdeal.ideal at e, k with *
  unfold extendedProjection
  unfold extendedQuotient
  exact algebraProjection.hom with algebra, ideal

theorem extendedF.generators
  shows {extendedF(k)} ⊆ algebraCarrier(polynomialAlgebra(complexRing, 4 + k))
proof
  have ringHom := extendedRename.ring_hom at k with *
  have memberF := ambientF.mem with *
  have member : extendedF(k) ∈ Ring.carrier(polynomialRing(complexRing, 4 + k))
    unfold extendedF
    exact RingHom.map_mem with ringHom, memberF
  intros g gIn
  simp [singleton, pair.membership] at gIn
  rw gIn
  unfold algebraCarrier
  rw polynomialAlgebra.ring
  exact member

theorem ambientF.generators
  shows {ambientF} ⊆ algebraCarrier(ambientAlgebra)
proof
  have member := ambientF.mem with *
  intros g gIn
  simp [singleton, pair.membership] at gIn
  rw gIn
  unfold algebraCarrier
  unfold ambientAlgebra
  rw polynomialAlgebra.ring
  exact member

theorem extendedProjection.kills
  shows extendedProjection(k)(extendedF(k)) = Ring.zero(Algebra.ring(extendedQuotient(k)))
proof
  have algebra := polynomialAlgebra.algebra at complexRing, 4 + k with complexes
  have generators := extendedF.generators at e, k with *
  have own := singleton.self at extendedF(k)
  have kills := algebraProjection.kills_generator at polynomialAlgebra(complexRing, 4 + k),
    {extendedF(k)}, extendedF(k) with algebra, generators, own
  rw polynomialAlgebra.ring at kills
  unfold extendedProjection
  unfold extendedQuotient
  unfold extendedIdeal
  rw quotientAlgebra.ringOf
  rw polynomialAlgebra.ring
  exact kills

theorem fibreIdeal.ideal
  shows Ideal(Algebra.ring(ambientAlgebra), fibreIdeal)
proof
  unfold ambientAlgebra
  rw polynomialAlgebra.ring
  unfold fibreIdeal
  exact generatedIdeal.ideal at polynomialRing(complexRing, 4), {ambientF} with ambient

theorem ambientAlgebra.algebra
  shows Algebra(ambientAlgebra)
proof
  unfold ambientAlgebra
  exact polynomialAlgebra.algebra at complexRing, 4 with complexes

theorem fibreProjection.hom
  shows fibreProjection : ambientAlgebra →ₐ fibreAlgebra
proof
  have algebra := ambientAlgebra.algebra at e, k with *
  have ideal := fibreIdeal.ideal at e, k with *
  unfold fibreProjection
  unfold fibreAlgebra
  exact algebraProjection.hom with algebra, ideal

theorem fibreRename.hom
  shows fibreRename(k) : polynomialAlgebra(complexRing, 3) →ₐ polynomialAlgebra(complexRing, 3 + k)
proof
  have subset := natural.subset_add at 3, k
  have map := identity.inclusion with subset
  unfold fibreRename
  exact polynomialRename.hom at complexRing, 3, 3 + k, identity(3) with complexes, map

theorem fibreRename.map_X (j : Set)
  requires index : j ∈ 3
  shows fibreRename(k)(X(complexRing, 3, j)) = X(complexRing, 3 + k, j)
proof
  have subset := natural.subset_add at 3, k
  have map := identity.inclusion with subset
  unfold fibreRename
  rw polynomialRename.map_X at complexRing, 3, 3 + k, identity(3), j with complexes, map, index
  rw identity.apply with index

-- The forward assignment is a function with the stated values.
theorem forwardValues.function
  shows forwardValues(e, k) : 4 + k → Ring.carrier(polynomialRing(complexRing, 3 + k))
proof
  have projection := AlgebraHom.function with (fibreProjection.hom at e, k with *)
  have isoFunction := AlgebraHom.function with iso.left
  have renameFunction := AlgebraHom.function with (fibreRename.hom at e, k with *)
  have kNat : Nat(k) by typecheck
  constructor
  . intros p member
    exact member.left
  constructor
  . intros x y relatedY z relatedZ
    obtain ⟨inY, shapeY⟩ := relatedY
    obtain ⟨_, shapeZ⟩ := relatedZ
    simp [fst.pair, snd.pair] at shapeY, shapeZ
    rcases shapeY with innerY | outerY
    . obtain ⟨xIn, yValue⟩ := innerY
      rcases shapeZ with innerZ | outerZ
      . obtain ⟨_, zValue⟩ := innerZ
        cc
      . obtain ⟨j, hj, xEq, zValue⟩ := outerZ
        simp [fst.pair, snd.pair] at xEq, zValue
        exfalso
        have jNat := natural.member at k with hj
        have apart := membership.ne_add at 4, x, j with xIn, jNat
        exact apart with xEq
    . obtain ⟨j, hj, xEq, yValue⟩ := outerY
      simp [fst.pair, snd.pair] at xEq, yValue
      rcases shapeZ with innerZ | outerZ
      . obtain ⟨xIn, zValue⟩ := innerZ
        exfalso
        have jNat := natural.member at k with hj
        have apart := membership.ne_add at 4, x, j with xIn, jNat
        exact apart with xEq
      . obtain ⟨l, hl, xEq2, zValue⟩ := outerZ
        simp [fst.pair, snd.pair] at xEq2, zValue
        have same : add(4, j) = add(4, l) by cc
        have cancel := add.left_cancel at j, l, 4
        have equal := cancel with same
        cc
  . intros i input
    have split := membership.add_cases at 4, k, i with input
    rcases split with iIn | shifted
    . have variable := X.mem at complexRing, 4, i with *
      have variableA : X(complexRing, 4, i) ∈ algebraCarrier(ambientAlgebra)
        unfold algebraCarrier
        unfold ambientAlgebra
        rw polynomialAlgebra.ring
        exact variable
      have class := FunctionBetween.apply_closed with projection, variableA
      have image := FunctionBetween.apply_closed with isoFunction, class
      have value := FunctionBetween.apply_closed with renameFunction, image
      unfold algebraCarrier at value
      rw polynomialAlgebra.ring at value
      refine ⟨fibreRename(k)(e(fibreProjection(X(complexRing, 4, i)))), value, _⟩
      apply forwardValues.membership.backward
      refine ⟨(product.pair with input, value), _⟩
      simp [fst.pair, snd.pair, iIn]
    . obtain ⟨j, hj, iEq⟩ := shifted
      have offset := membership.add_offset at 3, k, j with hj
      have value := X.mem at complexRing, 3 + k, add(3, j) with *
      refine ⟨X(complexRing, 3 + k, add(3, j)), value, _⟩
      apply forwardValues.membership.backward
      refine ⟨(product.pair with input, value), _⟩
      simp [fst.pair, snd.pair]

theorem forwardValues.inner (i : Set)
  requires index : i ∈ 4
  shows forwardValues(e, k)(i) = fibreRename(k)(e(fibreProjection(X(complexRing, 4, i))))
proof
  have function := forwardValues.function at e, k with *
  have subset := natural.subset_add at 4, k
  have wide := subset with i, index
  have shape := FunctionBetween.relates_apply with function, wide
  have data := forwardValues.membership.forward with shape
  simp [fst.pair, snd.pair] at data
  rcases data.right with inside | outside
  . exact inside.right
  . obtain ⟨j, hj, iEq, _⟩ := outside
    simp [fst.pair, snd.pair] at iEq
    exfalso
    have jNat := natural.member at k with hj
    have apart := membership.ne_add at 4, i, j with index, jNat
    exact apart with iEq

theorem forwardValues.outer (j : Set)
  requires index : j ∈ k
  shows forwardValues(e, k)(add(4, j)) = X(complexRing, 3 + k, add(3, j))
proof
  have function := forwardValues.function at e, k with *
  have offset := membership.add_offset at 4, k, j with index
  have shape := FunctionBetween.relates_apply with function, offset
  have data := forwardValues.membership.forward with shape
  simp [fst.pair, snd.pair] at data
  rcases data.right with inside | outside
  . exfalso
    have jNat := natural.member at k with index
    have apart := membership.ne_add at 4, add(4, j), j with inside.left, jNat
    exact apart with rfl
  . obtain ⟨l, hl, same, value⟩ := outside
    simp [fst.pair, snd.pair] at same, value
    have cancel := add.left_cancel at j, l, 4
    have equal := cancel with same
    rw ← equal at value
    exact value

-- The forward homomorphism: its values on the variables, its composite
-- with the renaming of ℂ[4], and its vanishing on F.
theorem forwardHom.hom
  shows forwardHom(e, k) : polynomialAlgebra(complexRing, 4 + k) →ₐ polynomialAlgebra(complexRing, 3 + k)
proof
  have algebra := polynomialAlgebra.algebra at complexRing, 3 + k with complexes
  have over := polynomialAlgebra.base at complexRing, 3 + k
  have values := forwardValues.function at e, k with *
  have carrier := polynomialAlgebra.carrier at complexRing, 3 + k with complexes
  rw ← carrier at values
  have hom := evaluationHom.algebra_hom at complexRing, 4 + k, polynomialAlgebra(complexRing, 3 + k),
    forwardValues(e, k) with complexes, algebra, over, values
  rw [polynomialAlgebra.ring, polynomialAlgebra.map] at hom
  unfold forwardHom
  exact hom

theorem forwardHom.map_X_inner (i : Set)
  requires index : i ∈ 4
  shows forwardHom(e, k)(X(complexRing, 4 + k, i)) =
    fibreRename(k)(e(fibreProjection(X(complexRing, 4, i))))
proof
  have algebra := polynomialAlgebra.algebra at complexRing, 3 + k with complexes
  have over := polynomialAlgebra.base at complexRing, 3 + k
  have values := forwardValues.function at e, k with *
  have carrier := polynomialAlgebra.carrier at complexRing, 3 + k with complexes
  rw ← carrier at values
  have subset := natural.subset_add at 4, k
  have wide := subset with i, index
  have value := evaluationHom.algebra_X at complexRing, 4 + k, polynomialAlgebra(complexRing, 3 + k),
    forwardValues(e, k), i with complexes, algebra, over, values, wide
  rw [polynomialAlgebra.ring, polynomialAlgebra.map] at value
  unfold forwardHom
  rw value
  exact forwardValues.inner at e, k, i with *

theorem forwardHom.map_X_outer (j : Set)
  requires index : j ∈ k
  shows forwardHom(e, k)(X(complexRing, 4 + k, add(4, j))) = X(complexRing, 3 + k, add(3, j))
proof
  have algebra := polynomialAlgebra.algebra at complexRing, 3 + k with complexes
  have over := polynomialAlgebra.base at complexRing, 3 + k
  have values := forwardValues.function at e, k with *
  have carrier := polynomialAlgebra.carrier at complexRing, 3 + k with complexes
  rw ← carrier at values
  have offset := membership.add_offset at 4, k, j with index
  have value := evaluationHom.algebra_X at complexRing, 4 + k, polynomialAlgebra(complexRing, 3 + k),
    forwardValues(e, k), add(4, j) with complexes, algebra, over, values, offset
  rw [polynomialAlgebra.ring, polynomialAlgebra.map] at value
  unfold forwardHom
  rw value
  exact forwardValues.outer at e, k, j with *

theorem forwardHom.after_rename (y : Set)
  requires member : y ∈ algebraCarrier(polynomialAlgebra(complexRing, 4))
  shows forwardHom(e, k)(polynomialRename(complexRing, 4, 4 + k, identity(4))(y)) =
    fibreRename(k)(e(fibreProjection(y)))
proof
  have renameHom := extendedRename.hom at k with *
  have forward := forwardHom.hom at e, k with *
  have projectionHom := fibreProjection.hom at e, k with *
  have renameF := fibreRename.hom at e, k with *
  have renameFunction := AlgebraHom.function with renameHom
  have forwardFunction := AlgebraHom.function with forward
  have projectionFunction := AlgebraHom.function with projectionHom
  have isoFunction := AlgebraHom.function with iso.left
  have renameFFunction := AlgebraHom.function with renameF
  unfold ambientAlgebra at projectionHom, projectionFunction
  have left := AlgebraHom.compose with renameHom, forward
  have inner := AlgebraHom.compose with projectionHom, iso.left
  have innerFunction := AlgebraHom.function with inner
  have right := AlgebraHom.compose with inner, renameF
  have agree : ∀ j ∈ 4,
      compose(forwardHom(e, k), polynomialRename(complexRing, 4, 4 + k, identity(4)),
        algebraCarrier(polynomialAlgebra(complexRing, 4)),
        algebraCarrier(polynomialAlgebra(complexRing, 4 + k)),
        algebraCarrier(polynomialAlgebra(complexRing, 3 + k)))(X(complexRing, 4, j)) =
      compose(fibreRename(k),
        compose(e, fibreProjection, algebraCarrier(polynomialAlgebra(complexRing, 4)),
          algebraCarrier(fibreAlgebra), algebraCarrier(polynomialAlgebra(complexRing, 3))),
        algebraCarrier(polynomialAlgebra(complexRing, 4)),
        algebraCarrier(polynomialAlgebra(complexRing, 3)),
        algebraCarrier(polynomialAlgebra(complexRing, 3 + k)))(X(complexRing, 4, j))
    intros j jIn
    have variable := X.mem at complexRing, 4, j with *
    have carrier := polynomialAlgebra.carrier at complexRing, 4 with complexes
    rw ← carrier at variable
    rw compose.apply with renameFunction, forwardFunction, variable
    rw compose.apply with innerFunction, renameFFunction, variable
    rw compose.apply with projectionFunction, isoFunction, variable
    rw extendedRename.map_X at k, j with *
    exact forwardHom.map_X_inner at e, k, j with *
  have same := AlgebraHom.polynomial_ext at complexRing, 4, polynomialAlgebra(complexRing, 3 + k),
    compose(forwardHom(e, k), polynomialRename(complexRing, 4, 4 + k, identity(4)),
      algebraCarrier(polynomialAlgebra(complexRing, 4)),
      algebraCarrier(polynomialAlgebra(complexRing, 4 + k)),
      algebraCarrier(polynomialAlgebra(complexRing, 3 + k))),
    compose(fibreRename(k),
      compose(e, fibreProjection, algebraCarrier(polynomialAlgebra(complexRing, 4)),
        algebraCarrier(fibreAlgebra), algebraCarrier(polynomialAlgebra(complexRing, 3))),
      algebraCarrier(polynomialAlgebra(complexRing, 4)),
      algebraCarrier(polynomialAlgebra(complexRing, 3)),
      algebraCarrier(polynomialAlgebra(complexRing, 3 + k)))
    with complexes, left, right, agree
  have applied : compose(forwardHom(e, k), polynomialRename(complexRing, 4, 4 + k, identity(4)),
      algebraCarrier(polynomialAlgebra(complexRing, 4)),
      algebraCarrier(polynomialAlgebra(complexRing, 4 + k)),
      algebraCarrier(polynomialAlgebra(complexRing, 3 + k)))(y) =
    compose(fibreRename(k),
      compose(e, fibreProjection, algebraCarrier(polynomialAlgebra(complexRing, 4)),
        algebraCarrier(fibreAlgebra), algebraCarrier(polynomialAlgebra(complexRing, 3))),
      algebraCarrier(polynomialAlgebra(complexRing, 4)),
      algebraCarrier(polynomialAlgebra(complexRing, 3)),
      algebraCarrier(polynomialAlgebra(complexRing, 3 + k)))(y)
    rw same
  rw compose.apply with renameFunction, forwardFunction, member at applied
  rw compose.apply with innerFunction, renameFFunction, member at applied
  rw compose.apply with projectionFunction, isoFunction, member at applied
  exact applied

theorem forwardHom.kills
  shows forwardHom(e, k)(extendedF(k)) = Ring.zero(polynomialRing(complexRing, 3 + k))
proof
  have memberF := ambientF.mem with *
  have carrier := polynomialAlgebra.carrier at complexRing, 4 with complexes
  rw ← carrier at memberF
  have renameF := fibreRename.hom at e, k with *
  have isoRing := AlgebraHom.ring_hom with iso.left
  have renameRing := AlgebraHom.ring_hom with renameF
  unfold extendedF
  rw forwardHom.after_rename at e, k, ambientF with *
  rw fibreProjection.F
  rw RingHom.map_zero with isoRing
  rw RingHom.map_zero with renameRing
  rw polynomialAlgebra.ring

-- The forward homomorphism descends to the extended quotient.
theorem forwardLift.hom
  shows forwardLift(e, k) : extendedQuotient(k) →ₐ polynomialAlgebra(complexRing, 3 + k)
proof
  have algebra := polynomialAlgebra.algebra at complexRing, 4 + k with complexes
  have generators := extendedF.generators at e, k with *
  have forward := forwardHom.hom at e, k with *
  have killed : ∀ g ∈ {extendedF(k)},
      forwardHom(e, k)(g) = Ring.zero(Algebra.ring(polynomialAlgebra(complexRing, 3 + k)))
    intros g gIn
    simp [singleton, pair.membership] at gIn
    rw gIn
    rw polynomialAlgebra.ring
    exact forwardHom.kills at e, k with *
  have lift := AlgebraHom.lift_generated at polynomialAlgebra(complexRing, 4 + k), {extendedF(k)},
    forwardHom(e, k), polynomialAlgebra(complexRing, 3 + k) with algebra, generators, forward, killed
  rw polynomialAlgebra.ring at lift
  unfold forwardLift
  unfold extendedQuotient
  unfold extendedIdeal
  exact lift

theorem forwardLift.factors (x : Set)
  requires member : x ∈ algebraCarrier(polynomialAlgebra(complexRing, 4 + k))
  shows forwardLift(e, k)(extendedProjection(k)(x)) = forwardHom(e, k)(x)
proof
  have algebra := polynomialAlgebra.algebra at complexRing, 4 + k with complexes
  have generators := extendedF.generators at e, k with *
  have forward := forwardHom.hom at e, k with *
  have killed : ∀ g ∈ {extendedF(k)},
      forwardHom(e, k)(g) = Ring.zero(Algebra.ring(polynomialAlgebra(complexRing, 3 + k)))
    intros g gIn
    simp [singleton, pair.membership] at gIn
    rw gIn
    rw polynomialAlgebra.ring
    exact forwardHom.kills at e, k with *
  have factors := AlgebraHom.lift_generated_factors at polynomialAlgebra(complexRing, 4 + k),
    {extendedF(k)}, forwardHom(e, k), polynomialAlgebra(complexRing, 3 + k), x
    with algebra, generators, forward, killed, member
  rw polynomialAlgebra.ring at factors
  unfold forwardLift
  unfold extendedProjection
  unfold extendedIdeal
  exact factors

-- ℂ[4] into the extended quotient through the renaming, and its descent
-- to the fibre.
theorem throughRename.hom
  shows throughRename(k) : ambientAlgebra →ₐ extendedQuotient(k)
proof
  have renameHom := extendedRename.hom at k with *
  have projectionHom := extendedProjection.hom at e, k with *
  unfold throughRename
  unfold ambientAlgebra
  exact AlgebraHom.compose with renameHom, projectionHom

theorem throughRename.apply (y : Set)
  requires member : y ∈ algebraCarrier(polynomialAlgebra(complexRing, 4))
  shows throughRename(k)(y) = extendedProjection(k)(polynomialRename(complexRing, 4, 4 + k, identity(4))(y))
proof
  have renameFunction := AlgebraHom.function with (extendedRename.hom at k with *)
  have projectionFunction := AlgebraHom.function with (extendedProjection.hom at e, k with *)
  unfold throughRename
  exact compose.apply with renameFunction, projectionFunction, member

theorem throughRename.kills
  shows throughRename(k)(ambientF) = Ring.zero(Algebra.ring(extendedQuotient(k)))
proof
  have memberF := ambientF.mem with *
  have carrier := polynomialAlgebra.carrier at complexRing, 4 with complexes
  rw ← carrier at memberF
  rw throughRename.apply at e, k, ambientF with *
  have kills := extendedProjection.kills at e, k with *
  unfold extendedF at kills
  exact kills

theorem fibreToQuotient.hom
  shows fibreToQuotient(k) : fibreAlgebra →ₐ extendedQuotient(k)
proof
  have algebra := ambientAlgebra.algebra at e, k with *
  have generators := ambientF.generators at e, k with *
  have through := throughRename.hom at e, k with *
  have killed : ∀ g ∈ {ambientF}, throughRename(k)(g) = Ring.zero(Algebra.ring(extendedQuotient(k)))
    intros g gIn
    simp [singleton, pair.membership] at gIn
    rw gIn
    exact throughRename.kills at e, k with *
  have lift := AlgebraHom.lift_generated at ambientAlgebra, {ambientF}, throughRename(k),
    extendedQuotient(k) with algebra, generators, through, killed
  have ringA : Algebra.ring(ambientAlgebra) = polynomialRing(complexRing, 4)
    unfold ambientAlgebra
    exact polynomialAlgebra.ring at complexRing, 4
  rw ringA at lift
  unfold fibreToQuotient
  unfold fibreAlgebra
  unfold fibreIdeal
  exact lift

theorem fibreToQuotient.factors (y : Set)
  requires member : y ∈ algebraCarrier(ambientAlgebra)
  shows fibreToQuotient(k)(fibreProjection(y)) = throughRename(k)(y)
proof
  have algebra := ambientAlgebra.algebra at e, k with *
  have generators := ambientF.generators at e, k with *
  have through := throughRename.hom at e, k with *
  have killed : ∀ g ∈ {ambientF}, throughRename(k)(g) = Ring.zero(Algebra.ring(extendedQuotient(k)))
    intros g gIn
    simp [singleton, pair.membership] at gIn
    rw gIn
    exact throughRename.kills at e, k with *
  have factors := AlgebraHom.lift_generated_factors at ambientAlgebra, {ambientF}, throughRename(k),
    extendedQuotient(k), y with algebra, generators, through, killed, member
  have ringA : Algebra.ring(ambientAlgebra) = polynomialRing(complexRing, 4)
    unfold ambientAlgebra
    exact polynomialAlgebra.ring at complexRing, 4
  rw ringA at factors
  unfold fibreToQuotient
  unfold fibreProjection
  unfold fibreIdeal
  exact factors

-- The backward assignment is a function with the stated values.
theorem backwardValues.function
  shows backwardValues(e, k) : 3 + k → algebraCarrier(extendedQuotient(k))
proof
  have inverseFunction := converse.function_of_bijective with iso.right
  have descentFunction := AlgebraHom.function with (fibreToQuotient.hom at e, k with *)
  have projectionFunction := AlgebraHom.function with (extendedProjection.hom at e, k with *)
  have kNat : Nat(k) by typecheck
  constructor
  . intros p member
    exact member.left
  constructor
  . intros x y relatedY z relatedZ
    obtain ⟨inY, shapeY⟩ := relatedY
    obtain ⟨_, shapeZ⟩ := relatedZ
    simp [fst.pair, snd.pair] at shapeY, shapeZ
    rcases shapeY with innerY | outerY
    . obtain ⟨xIn, yValue⟩ := innerY
      rcases shapeZ with innerZ | outerZ
      . obtain ⟨_, zValue⟩ := innerZ
        cc
      . obtain ⟨j, hj, xEq, zValue⟩ := outerZ
        simp [fst.pair, snd.pair] at xEq, zValue
        exfalso
        have jNat := natural.member at k with hj
        have apart := membership.ne_add at 3, x, j with xIn, jNat
        exact apart with xEq
    . obtain ⟨j, hj, xEq, yValue⟩ := outerY
      simp [fst.pair, snd.pair] at xEq, yValue
      rcases shapeZ with innerZ | outerZ
      . obtain ⟨xIn, zValue⟩ := innerZ
        exfalso
        have jNat := natural.member at k with hj
        have apart := membership.ne_add at 3, x, j with xIn, jNat
        exact apart with xEq
      . obtain ⟨l, hl, xEq2, zValue⟩ := outerZ
        simp [fst.pair, snd.pair] at xEq2, zValue
        have same : add(3, j) = add(3, l) by cc
        have cancel := add.left_cancel at j, l, 3
        have equal := cancel with same
        cc
  . intros i input
    have split := membership.add_cases at 3, k, i with input
    rcases split with iIn | shifted
    . have variable := X.mem at complexRing, 3, i with *
      have carrier := polynomialAlgebra.carrier at complexRing, 3 with complexes
      rw ← carrier at variable
      have class := FunctionBetween.apply_closed with inverseFunction, variable
      have value := FunctionBetween.apply_closed with descentFunction, class
      refine ⟨fibreToQuotient(k)(converse(e, algebraCarrier(fibreAlgebra),
        algebraCarrier(polynomialAlgebra(complexRing, 3)))(X(complexRing, 3, i))), value, _⟩
      apply backwardValues.membership.backward
      refine ⟨(product.pair with input, value), _⟩
      simp [fst.pair, snd.pair, iIn]
    . obtain ⟨j, hj, iEq⟩ := shifted
      have offset := membership.add_offset at 4, k, j with hj
      have variable := X.mem at complexRing, 4 + k, add(4, j) with *
      have carrier := polynomialAlgebra.carrier at complexRing, 4 + k with complexes
      rw ← carrier at variable
      have value := FunctionBetween.apply_closed with projectionFunction, variable
      refine ⟨extendedProjection(k)(X(complexRing, 4 + k, add(4, j))), value, _⟩
      apply backwardValues.membership.backward
      refine ⟨(product.pair with input, value), _⟩
      simp [fst.pair, snd.pair]

theorem backwardValues.inner (i : Set)
  requires index : i ∈ 3
  shows backwardValues(e, k)(i) = fibreToQuotient(k)(
    converse(e, algebraCarrier(fibreAlgebra), algebraCarrier(polynomialAlgebra(complexRing, 3)))(
      X(complexRing, 3, i)))
proof
  have function := backwardValues.function at e, k with *
  have subset := natural.subset_add at 3, k
  have wide := subset with i, index
  have shape := FunctionBetween.relates_apply with function, wide
  have data := backwardValues.membership.forward with shape
  simp [fst.pair, snd.pair] at data
  rcases data.right with inside | outside
  . exact inside.right
  . obtain ⟨j, hj, iEq, _⟩ := outside
    simp [fst.pair, snd.pair] at iEq
    exfalso
    have jNat := natural.member at k with hj
    have apart := membership.ne_add at 3, i, j with index, jNat
    exact apart with iEq

theorem backwardValues.outer (j : Set)
  requires index : j ∈ k
  shows backwardValues(e, k)(add(3, j)) = extendedProjection(k)(X(complexRing, 4 + k, add(4, j)))
proof
  have function := backwardValues.function at e, k with *
  have offset := membership.add_offset at 3, k, j with index
  have shape := FunctionBetween.relates_apply with function, offset
  have data := backwardValues.membership.forward with shape
  simp [fst.pair, snd.pair] at data
  rcases data.right with inside | outside
  . exfalso
    have jNat := natural.member at k with index
    have apart := membership.ne_add at 3, add(3, j), j with inside.left, jNat
    exact apart with rfl
  . obtain ⟨l, hl, same, value⟩ := outside
    simp [fst.pair, snd.pair] at same, value
    have cancel := add.left_cancel at j, l, 3
    have equal := cancel with same
    rw ← equal at value
    exact value

-- The backward homomorphism and its values on the variables.
theorem backwardHom.hom
  shows backwardHom(e, k) : polynomialAlgebra(complexRing, 3 + k) →ₐ extendedQuotient(k)
proof
  have algebra := extendedQuotient.algebra at e, k with *
  have over := extendedQuotient.base at e, k with *
  have values := backwardValues.function at e, k with *
  unfold backwardHom
  exact evaluationHom.algebra_hom at complexRing, 3 + k, extendedQuotient(k), backwardValues(e, k)
    with complexes, algebra, over, values

theorem backwardHom.map_X_inner (i : Set)
  requires index : i ∈ 3
  shows backwardHom(e, k)(X(complexRing, 3 + k, i)) = fibreToQuotient(k)(
    converse(e, algebraCarrier(fibreAlgebra), algebraCarrier(polynomialAlgebra(complexRing, 3)))(
      X(complexRing, 3, i)))
proof
  have algebra := extendedQuotient.algebra at e, k with *
  have over := extendedQuotient.base at e, k with *
  have values := backwardValues.function at e, k with *
  have subset := natural.subset_add at 3, k
  have wide := subset with i, index
  unfold backwardHom
  rw evaluationHom.algebra_X at complexRing, 3 + k, extendedQuotient(k), backwardValues(e, k), i
    with complexes, algebra, over, values, wide
  exact backwardValues.inner at e, k, i with *

theorem backwardHom.map_X_outer (j : Set)
  requires index : j ∈ k
  shows backwardHom(e, k)(X(complexRing, 3 + k, add(3, j))) =
    extendedProjection(k)(X(complexRing, 4 + k, add(4, j)))
proof
  have algebra := extendedQuotient.algebra at e, k with *
  have over := extendedQuotient.base at e, k with *
  have values := backwardValues.function at e, k with *
  have offset := membership.add_offset at 3, k, j with index
  unfold backwardHom
  rw evaluationHom.algebra_X at complexRing, 3 + k, extendedQuotient(k), backwardValues(e, k),
    add(3, j) with complexes, algebra, over, values, offset
  exact backwardValues.outer at e, k, j with *

-- The backward homomorphism after the inclusion of ℂ[3] is the descent of
-- the inverse of e to the extended quotient.
theorem backwardHom.after_rename (p : Set)
  requires member : p ∈ algebraCarrier(polynomialAlgebra(complexRing, 3))
  shows backwardHom(e, k)(fibreRename(k)(p)) = fibreToQuotient(k)(
    converse(e, algebraCarrier(fibreAlgebra), algebraCarrier(polynomialAlgebra(complexRing, 3)))(p))
proof
  have renameF := fibreRename.hom at e, k with *
  have backward := backwardHom.hom at e, k with *
  have descent := fibreToQuotient.hom at e, k with *
  have inverse := AlgebraIso.inverse with iso
  have renameFFunction := AlgebraHom.function with renameF
  have backwardFunction := AlgebraHom.function with backward
  have descentFunction := AlgebraHom.function with descent
  have inverseFunction := AlgebraHom.function with inverse.left
  have left := AlgebraHom.compose with renameF, backward
  have right := AlgebraHom.compose with inverse.left, descent
  have agree : ∀ j ∈ 3,
      compose(backwardHom(e, k), fibreRename(k), algebraCarrier(polynomialAlgebra(complexRing, 3)),
        algebraCarrier(polynomialAlgebra(complexRing, 3 + k)), algebraCarrier(extendedQuotient(k)))(
        X(complexRing, 3, j)) =
      compose(fibreToQuotient(k),
        converse(e, algebraCarrier(fibreAlgebra), algebraCarrier(polynomialAlgebra(complexRing, 3))),
        algebraCarrier(polynomialAlgebra(complexRing, 3)), algebraCarrier(fibreAlgebra),
        algebraCarrier(extendedQuotient(k)))(X(complexRing, 3, j))
    intros j jIn
    have variable := X.mem at complexRing, 3, j with *
    have carrier := polynomialAlgebra.carrier at complexRing, 3 with complexes
    rw ← carrier at variable
    rw compose.apply with renameFFunction, backwardFunction, variable
    rw compose.apply with inverseFunction, descentFunction, variable
    rw fibreRename.map_X at e, k, j with *
    exact backwardHom.map_X_inner at e, k, j with *
  have same := AlgebraHom.polynomial_ext at complexRing, 3, extendedQuotient(k),
    compose(backwardHom(e, k), fibreRename(k), algebraCarrier(polynomialAlgebra(complexRing, 3)),
      algebraCarrier(polynomialAlgebra(complexRing, 3 + k)), algebraCarrier(extendedQuotient(k))),
    compose(fibreToQuotient(k),
      converse(e, algebraCarrier(fibreAlgebra), algebraCarrier(polynomialAlgebra(complexRing, 3))),
      algebraCarrier(polynomialAlgebra(complexRing, 3)), algebraCarrier(fibreAlgebra),
      algebraCarrier(extendedQuotient(k)))
    with complexes, left, right, agree
  have applied : compose(backwardHom(e, k), fibreRename(k),
      algebraCarrier(polynomialAlgebra(complexRing, 3)),
      algebraCarrier(polynomialAlgebra(complexRing, 3 + k)), algebraCarrier(extendedQuotient(k)))(p) =
    compose(fibreToQuotient(k),
      converse(e, algebraCarrier(fibreAlgebra), algebraCarrier(polynomialAlgebra(complexRing, 3))),
      algebraCarrier(polynomialAlgebra(complexRing, 3)), algebraCarrier(fibreAlgebra),
      algebraCarrier(extendedQuotient(k)))(p)
    rw same
  rw compose.apply with renameFFunction, backwardFunction, member at applied
  rw compose.apply with inverseFunction, descentFunction, member at applied
  exact applied

-- The forward lift after the descent of the fibre is e read in ℂ[3 + k].
theorem forwardLift.after_descent (q : Set)
  requires member : q ∈ algebraCarrier(fibreAlgebra)
  shows forwardLift(e, k)(fibreToQuotient(k)(q)) = fibreRename(k)(e(q))
proof
  have algebra := ambientAlgebra.algebra at e, k with *
  have ideal := fibreIdeal.ideal at e, k with *
  have descent := fibreToQuotient.hom at e, k with *
  have lift := forwardLift.hom at e, k with *
  have renameF := fibreRename.hom at e, k with *
  have projectionHom := fibreProjection.hom at e, k with *
  have renameHom := extendedRename.hom at k with *
  have descentFunction := AlgebraHom.function with descent
  have liftFunction := AlgebraHom.function with lift
  have isoFunction := AlgebraHom.function with iso.left
  have renameFFunction := AlgebraHom.function with renameF
  have projectionFunction := AlgebraHom.function with projectionHom
  have renameFunction := AlgebraHom.function with renameHom
  have first := AlgebraHom.compose with descent, lift
  have second := AlgebraHom.compose with iso.left, renameF
  have agree : ∀ x ∈ algebraCarrier(ambientAlgebra),
      compose(forwardLift(e, k), fibreToQuotient(k), algebraCarrier(fibreAlgebra),
        algebraCarrier(extendedQuotient(k)), algebraCarrier(polynomialAlgebra(complexRing, 3 + k)))(
        fibreProjection(x)) =
      compose(fibreRename(k), e, algebraCarrier(fibreAlgebra),
        algebraCarrier(polynomialAlgebra(complexRing, 3)),
        algebraCarrier(polynomialAlgebra(complexRing, 3 + k)))(fibreProjection(x))
    intros x xIn
    have xIn4 := xIn
    unfold ambientAlgebra at xIn4
    have class := FunctionBetween.apply_closed with projectionFunction, xIn
    have renamed := FunctionBetween.apply_closed with renameFunction, xIn4
    rw compose.apply with descentFunction, liftFunction, class
    rw compose.apply with isoFunction, renameFFunction, class
    rw fibreToQuotient.factors at e, k, x with *
    rw throughRename.apply at e, k, x with *
    rw forwardLift.factors at e, k, polynomialRename(complexRing, 4, 4 + k, identity(4))(x) with *
    exact forwardHom.after_rename at e, k, x with *
  unfold fibreAlgebra at first, second, agree, descentFunction, isoFunction
  unfold fibreProjection at agree
  have same := AlgebraHom.quotient_ext at ambientAlgebra, fibreIdeal,
    compose(forwardLift(e, k), fibreToQuotient(k),
      algebraCarrier(quotientAlgebra(ambientAlgebra, fibreIdeal)),
      algebraCarrier(extendedQuotient(k)), algebraCarrier(polynomialAlgebra(complexRing, 3 + k))),
    compose(fibreRename(k), e, algebraCarrier(quotientAlgebra(ambientAlgebra, fibreIdeal)),
      algebraCarrier(polynomialAlgebra(complexRing, 3)),
      algebraCarrier(polynomialAlgebra(complexRing, 3 + k))),
    polynomialAlgebra(complexRing, 3 + k)
    with algebra, ideal, first, second, agree
  have memberQ := member
  unfold fibreAlgebra at memberQ
  have applied : compose(forwardLift(e, k), fibreToQuotient(k),
      algebraCarrier(quotientAlgebra(ambientAlgebra, fibreIdeal)),
      algebraCarrier(extendedQuotient(k)), algebraCarrier(polynomialAlgebra(complexRing, 3 + k)))(q) =
    compose(fibreRename(k), e, algebraCarrier(quotientAlgebra(ambientAlgebra, fibreIdeal)),
      algebraCarrier(polynomialAlgebra(complexRing, 3)),
      algebraCarrier(polynomialAlgebra(complexRing, 3 + k)))(q)
    rw same
  rw compose.apply with descentFunction, liftFunction, memberQ at applied
  rw compose.apply with isoFunction, renameFFunction, memberQ at applied
  exact applied

-- Backward after forward is the projection on ℂ[4 + k], hence the
-- identity of the extended quotient.
theorem backwardHom.after_forward (x : Set)
  requires member : x ∈ algebraCarrier(polynomialAlgebra(complexRing, 4 + k))
  shows backwardHom(e, k)(forwardHom(e, k)(x)) = extendedProjection(k)(x)
proof
  have forward := forwardHom.hom at e, k with *
  have backward := backwardHom.hom at e, k with *
  have projectionHom := extendedProjection.hom at e, k with *
  have forwardFunction := AlgebraHom.function with forward
  have backwardFunction := AlgebraHom.function with backward
  have fibreProjectionFunction := AlgebraHom.function with (fibreProjection.hom at e, k with *)
  have isoFunction := AlgebraHom.function with iso.left
  have left := AlgebraHom.compose with forward, backward
  have agree : ∀ i ∈ 4 + k,
      compose(backwardHom(e, k), forwardHom(e, k), algebraCarrier(polynomialAlgebra(complexRing, 4 + k)),
        algebraCarrier(polynomialAlgebra(complexRing, 3 + k)), algebraCarrier(extendedQuotient(k)))(
        X(complexRing, 4 + k, i)) =
      extendedProjection(k)(X(complexRing, 4 + k, i))
    intros i iIn
    have variable := X.mem at complexRing, 4 + k, i with *
    have carrier := polynomialAlgebra.carrier at complexRing, 4 + k with complexes
    rw ← carrier at variable
    rw compose.apply with forwardFunction, backwardFunction, variable
    have split := membership.add_cases at 4, k, i with iIn
    rcases split with inside | shifted
    . have variable4 := X.mem at complexRing, 4, i with *
      have carrier4 := polynomialAlgebra.carrier at complexRing, 4 with complexes
      rw ← carrier4 at variable4
      have variableAmbient : X(complexRing, 4, i) ∈ algebraCarrier(ambientAlgebra)
        unfold ambientAlgebra
        exact variable4
      have class := FunctionBetween.apply_closed with fibreProjectionFunction, variableAmbient
      have image := FunctionBetween.apply_closed with isoFunction, class
      rw forwardHom.map_X_inner at e, k, i with *
      rw backwardHom.after_rename at e, k, e(fibreProjection(X(complexRing, 4, i))) with *
      rw Bijective.inverse_apply with iso.right, class
      rw fibreToQuotient.factors at e, k, X(complexRing, 4, i) with *
      rw throughRename.apply at e, k, X(complexRing, 4, i) with *
      rw extendedRename.map_X at k, i with *
    . obtain ⟨j, hj, iEq⟩ := shifted
      rw iEq
      rw forwardHom.map_X_outer at e, k, j with *
      exact backwardHom.map_X_outer at e, k, j with *
  have same := AlgebraHom.polynomial_ext at complexRing, 4 + k, extendedQuotient(k),
    compose(backwardHom(e, k), forwardHom(e, k), algebraCarrier(polynomialAlgebra(complexRing, 4 + k)),
      algebraCarrier(polynomialAlgebra(complexRing, 3 + k)), algebraCarrier(extendedQuotient(k))),
    extendedProjection(k) with complexes, left, projectionHom, agree
  have applied : compose(backwardHom(e, k), forwardHom(e, k),
      algebraCarrier(polynomialAlgebra(complexRing, 4 + k)),
      algebraCarrier(polynomialAlgebra(complexRing, 3 + k)), algebraCarrier(extendedQuotient(k)))(x) =
    extendedProjection(k)(x)
    rw same
  rw compose.apply with forwardFunction, backwardFunction, member at applied
  exact applied

theorem backwardHom.after_lift (x : Set)
  requires member : x ∈ algebraCarrier(extendedQuotient(k))
  shows backwardHom(e, k)(forwardLift(e, k)(x)) = x
proof
  have algebra := polynomialAlgebra.algebra at complexRing, 4 + k with complexes
  have ideal := extendedIdeal.ideal at e, k with *
  have quotientIsAlgebra := extendedQuotient.algebra at e, k with *
  have lift := forwardLift.hom at e, k with *
  have backward := backwardHom.hom at e, k with *
  have projectionHom := extendedProjection.hom at e, k with *
  have liftFunction := AlgebraHom.function with lift
  have backwardFunction := AlgebraHom.function with backward
  have projectionFunction := AlgebraHom.function with projectionHom
  have first := AlgebraHom.compose with lift, backward
  have second := AlgebraHom.identity with quotientIsAlgebra
  have agree : ∀ y ∈ algebraCarrier(polynomialAlgebra(complexRing, 4 + k)),
      compose(backwardHom(e, k), forwardLift(e, k), algebraCarrier(extendedQuotient(k)),
        algebraCarrier(polynomialAlgebra(complexRing, 3 + k)), algebraCarrier(extendedQuotient(k)))(
        extendedProjection(k)(y)) =
      identity(algebraCarrier(extendedQuotient(k)))(extendedProjection(k)(y))
    intros y yIn
    have class := FunctionBetween.apply_closed with projectionFunction, yIn
    rw compose.apply with liftFunction, backwardFunction, class
    rw identity.apply with class
    rw forwardLift.factors at e, k, y with *
    exact backwardHom.after_forward at e, k, y with *
  unfold extendedQuotient at first, second, agree, liftFunction, backwardFunction
  unfold extendedProjection at agree
  have same := AlgebraHom.quotient_ext at polynomialAlgebra(complexRing, 4 + k), extendedIdeal(k),
    compose(backwardHom(e, k), forwardLift(e, k),
      algebraCarrier(quotientAlgebra(polynomialAlgebra(complexRing, 4 + k), extendedIdeal(k))),
      algebraCarrier(polynomialAlgebra(complexRing, 3 + k)),
      algebraCarrier(quotientAlgebra(polynomialAlgebra(complexRing, 4 + k), extendedIdeal(k)))),
    identity(algebraCarrier(quotientAlgebra(polynomialAlgebra(complexRing, 4 + k), extendedIdeal(k)))),
    quotientAlgebra(polynomialAlgebra(complexRing, 4 + k), extendedIdeal(k))
    with algebra, ideal, first, second, agree
  have memberQ := member
  unfold extendedQuotient at memberQ
  have applied : compose(backwardHom(e, k), forwardLift(e, k),
      algebraCarrier(quotientAlgebra(polynomialAlgebra(complexRing, 4 + k), extendedIdeal(k))),
      algebraCarrier(polynomialAlgebra(complexRing, 3 + k)),
      algebraCarrier(quotientAlgebra(polynomialAlgebra(complexRing, 4 + k), extendedIdeal(k))))(x) =
    identity(algebraCarrier(quotientAlgebra(polynomialAlgebra(complexRing, 4 + k), extendedIdeal(k))))(x)
    rw same
  rw compose.apply with liftFunction, backwardFunction, memberQ at applied
  rw identity.apply with memberQ at applied
  exact applied

-- Forward after backward is the identity of ℂ[3 + k].
theorem forwardLift.after_backward (p : Set)
  requires member : p ∈ algebraCarrier(polynomialAlgebra(complexRing, 3 + k))
  shows forwardLift(e, k)(backwardHom(e, k)(p)) = p
proof
  have target := polynomialAlgebra.algebra at complexRing, 3 + k with complexes
  have lift := forwardLift.hom at e, k with *
  have backward := backwardHom.hom at e, k with *
  have liftFunction := AlgebraHom.function with lift
  have backwardFunction := AlgebraHom.function with backward
  have inverseFunction := converse.function_of_bijective with iso.right
  have first := AlgebraHom.compose with backward, lift
  have second := AlgebraHom.identity with target
  have agree : ∀ j ∈ 3 + k,
      compose(forwardLift(e, k), backwardHom(e, k), algebraCarrier(polynomialAlgebra(complexRing, 3 + k)),
        algebraCarrier(extendedQuotient(k)), algebraCarrier(polynomialAlgebra(complexRing, 3 + k)))(
        X(complexRing, 3 + k, j)) =
      identity(algebraCarrier(polynomialAlgebra(complexRing, 3 + k)))(X(complexRing, 3 + k, j))
    intros j jIn
    have variable := X.mem at complexRing, 3 + k, j with *
    have carrier := polynomialAlgebra.carrier at complexRing, 3 + k with complexes
    rw ← carrier at variable
    rw compose.apply with backwardFunction, liftFunction, variable
    rw identity.apply with variable
    have split := membership.add_cases at 3, k, j with jIn
    rcases split with inside | shifted
    . have variable3 := X.mem at complexRing, 3, j with *
      have carrier3 := polynomialAlgebra.carrier at complexRing, 3 with complexes
      rw ← carrier3 at variable3
      have class := FunctionBetween.apply_closed with inverseFunction, variable3
      rw backwardHom.map_X_inner at e, k, j with *
      rw forwardLift.after_descent at e, k,
        converse(e, algebraCarrier(fibreAlgebra), algebraCarrier(polynomialAlgebra(complexRing, 3)))(
          X(complexRing, 3, j)) with *
      rw Bijective.apply_inverse with iso.right, variable3
      exact fibreRename.map_X at e, k, j with *
    . obtain ⟨l, hl, jEq⟩ := shifted
      rw jEq
      have offset := membership.add_offset at 4, k, l with hl
      have variableO := X.mem at complexRing, 4 + k, add(4, l) with *
      have carrierO := polynomialAlgebra.carrier at complexRing, 4 + k with complexes
      rw ← carrierO at variableO
      rw backwardHom.map_X_outer at e, k, l with *
      rw forwardLift.factors at e, k, X(complexRing, 4 + k, add(4, l)) with *
      exact forwardHom.map_X_outer at e, k, l with *
  have same := AlgebraHom.polynomial_ext at complexRing, 3 + k, polynomialAlgebra(complexRing, 3 + k),
    compose(forwardLift(e, k), backwardHom(e, k), algebraCarrier(polynomialAlgebra(complexRing, 3 + k)),
      algebraCarrier(extendedQuotient(k)), algebraCarrier(polynomialAlgebra(complexRing, 3 + k))),
    identity(algebraCarrier(polynomialAlgebra(complexRing, 3 + k)))
    with complexes, first, second, agree
  have applied : compose(forwardLift(e, k), backwardHom(e, k),
      algebraCarrier(polynomialAlgebra(complexRing, 3 + k)),
      algebraCarrier(extendedQuotient(k)), algebraCarrier(polynomialAlgebra(complexRing, 3 + k)))(p) =
    identity(algebraCarrier(polynomialAlgebra(complexRing, 3 + k)))(p)
    rw same
  rw compose.apply with backwardFunction, liftFunction, member at applied
  rw identity.apply with member at applied
  exact applied

-- The forward lift is an isomorphism of the extended quotient with
-- ℂ[3 + k].
theorem forwardLift.iso
  shows forwardLift(e, k) : extendedQuotient(k) ≃ₐ polynomialAlgebra(complexRing, 3 + k)
proof
  have lift := forwardLift.hom at e, k with *
  have backward := backwardHom.hom at e, k with *
  have left : ∀ x ∈ algebraCarrier(extendedQuotient(k)),
      backwardHom(e, k)(forwardLift(e, k)(x)) = x
    intros x xIn
    exact backwardHom.after_lift at e, k, x with *
  have right : ∀ p ∈ algebraCarrier(polynomialAlgebra(complexRing, 3 + k)),
      forwardLift(e, k)(backwardHom(e, k)(p)) = p
    intros p pIn
    exact forwardLift.after_backward at e, k, p with *
  exact AlgebraIso.of_inverse with lift, backward, left, right

end Extension

section Stabilization
variable (k : Nat)

theorem extendedF.mem
  shows extendedF(k) ∈ Ring.carrier(polynomialRing(complexRing, 4 + k))
proof
  have complexes := complexRing.comm_ring
  have ambient := polynomialRing.comm_ring at complexRing, 4 with complexes
  have extended := polynomialRing.comm_ring at complexRing, 4 + k with complexes
  have ringHom := extendedRename.ring_hom at k with *
  have member := ambientF.mem with *
  unfold extendedF
  exact RingHom.map_mem with ringHom, member

theorem extendedPoint.function
  shows extendedPoint(k) : 4 + k → Ring.carrier(complexRing)
proof
  have values := criticalPoint.function
  rw complexRing.carrierOf at values
  rw complexRing.carrierOf
  constructor
  . intros p member
    exact member.left
  constructor
  . intros x y relatedY z relatedZ
    obtain ⟨inY, shapeY⟩ := relatedY
    obtain ⟨_, shapeZ⟩ := relatedZ
    simp [fst.pair, snd.pair] at shapeY, shapeZ
    rcases shapeY with insideY | outsideY
    . rcases shapeZ with insideZ | outsideZ
      . cc
      . exfalso
        exact outsideZ.left with insideY.left
    . rcases shapeZ with insideZ | outsideZ
      . exfalso
        exact outsideY.left with insideZ.left
      . cc
  . intros x input
    by_cases inside : x ∈ 4
    . have value := FunctionBetween.apply_closed with values, inside
      refine ⟨criticalPoint(x), value, _⟩
      apply extendedPoint.membership.backward
      refine ⟨(product.pair with input, value), _⟩
      simp [fst.pair, snd.pair, inside]
    . have value := complexZero.member
      refine ⟨complexZero, value, _⟩
      apply extendedPoint.membership.backward
      refine ⟨(product.pair with input, value), _⟩
      simp [fst.pair, snd.pair, inside]

-- The extended point agrees with the critical point on the first four
-- positions.
theorem extendedPoint.inside (j : Set)
  requires index : j ∈ 4
  shows extendedPoint(k)(j) = criticalPoint(j)
proof
  have function := extendedPoint.function at k
  have subset := natural.subset_add at 4, k
  have wide := subset with j, index
  have shape := FunctionBetween.relates_apply with function, wide
  have data := extendedPoint.membership.forward with shape
  simp [fst.pair, snd.pair] at data
  rcases data.right with inside | outside
  . exact inside.right
  . exfalso
    exact outside.left with index

-- Evaluation at the extended point reads the first four coordinates.
theorem extendedPoint.eval (f : Set)
  requires member : f ∈ Ring.carrier(polynomialRing(complexRing, 4))
  shows evaluationAt(complexRing, 4 + k, extendedPoint(k))(polynomialRename(complexRing, 4, 4 + k, identity(4))(f)) =
    evaluationAt(complexRing, 4, criticalPoint)(f)
proof
  have complexes := complexRing.comm_ring
  have ambient := polynomialRing.comm_ring at complexRing, 4 with complexes
  have extended := polynomialRing.comm_ring at complexRing, 4 + k with complexes
  have values := extendedPoint.function at k
  have critical := criticalPoint.function
  have hom := extendedRename.hom at k with *
  have renameHom := extendedRename.ring_hom at k with *
  obtain ⟨_, _, renameFunction, _⟩ := renameHom
  have evalExtended := evaluationAt.hom at complexRing, 4 + k, extendedPoint(k) with complexes, values
  have evalCritical := evaluationAt.hom at complexRing, 4, criticalPoint with complexes, critical
  obtain ⟨_, _, evalFunction, _⟩ := evalExtended
  have composite := RingHom.comp with ambient, renameHom, evalExtended
  have constants : ∀ a ∈ Ring.carrier(complexRing),
      compose(evaluationAt(complexRing, 4 + k, extendedPoint(k)),
        polynomialRename(complexRing, 4, 4 + k, identity(4)), Ring.carrier(polynomialRing(complexRing, 4)),
        Ring.carrier(polynomialRing(complexRing, 4 + k)), Ring.carrier(complexRing))(
        polynomialConstant(complexRing, 4)(a)) =
      evaluationAt(complexRing, 4, criticalPoint)(polynomialConstant(complexRing, 4)(a))
    intros a aIn
    have constant := polynomialConstant.mem at complexRing, 4, a with *
    rw compose.apply with renameFunction, evalFunction, constant
    rw AlgebraHom.polynomial_constant with hom, aIn
    rw evaluationAt.map_constant at complexRing, 4 + k, extendedPoint(k), a with complexes, values
    rw evaluationAt.map_constant at complexRing, 4, criticalPoint, a with complexes, critical
  have variables : ∀ j ∈ 4,
      compose(evaluationAt(complexRing, 4 + k, extendedPoint(k)),
        polynomialRename(complexRing, 4, 4 + k, identity(4)), Ring.carrier(polynomialRing(complexRing, 4)),
        Ring.carrier(polynomialRing(complexRing, 4 + k)), Ring.carrier(complexRing))(
        X(complexRing, 4, j)) =
      evaluationAt(complexRing, 4, criticalPoint)(X(complexRing, 4, j))
    intros j jIn
    have subset := natural.subset_add at 4, k
    have wide := subset with j, jIn
    have variable := X.mem at complexRing, 4, j with *
    rw compose.apply with renameFunction, evalFunction, variable
    rw extendedRename.map_X at k, j with *
    rw evaluationAt.map_X at complexRing, 4 + k, extendedPoint(k), j with complexes, values, wide
    rw evaluationAt.map_X at complexRing, 4, criticalPoint, j with complexes, critical, jIn
    exact extendedPoint.inside at k, j with jIn
  have same := polynomialRing.hom_ext with complexes, composite, evalCritical, constants, variables
  rw ← same
  rw compose.apply with renameFunction, evalFunction, member

theorem extendedF.eval
  shows evaluationAt(complexRing, 4 + k, extendedPoint(k))(extendedF(k)) = complexNeg(complexOne)
proof
  have complexes := complexRing.comm_ring
  have ambient := polynomialRing.comm_ring at complexRing, 4 with complexes
  have member := ambientF.mem with *
  unfold extendedF
  rw extendedPoint.eval at k, ambientF with member
  exact criticalPoint.eval_F

theorem extendedF.critical (i : Set)
  requires index : i ∈ 4 + k
  shows evaluationAt(complexRing, 4 + k, extendedPoint(k))(
    partialDerivative(complexRing, 4 + k, i)(extendedF(k))) = complexZero
proof
  have complexes := complexRing.comm_ring
  have ambient := polynomialRing.comm_ring at complexRing, 4 with complexes
  have extended := polynomialRing.comm_ring at complexRing, 4 + k with complexes
  have member := ambientF.mem with *
  unfold extendedF
  by_cases inside : i ∈ 4
  . rw extendedRename.derivative_inside at k, ambientF, i with *
    have derivative := partialDerivative.map_mem at complexRing, 4, i, ambientF with complexes,
      ambient, inside
    rw extendedPoint.eval at k, partialDerivative(complexRing, 4, i)(ambientF) with derivative
    exact criticalPoint.derivatives with inside
  . rw extendedRename.derivative_outside at k, ambientF, i with *
    have values := extendedPoint.function at k
    have evalExtended := evaluationAt.hom at complexRing, 4 + k, extendedPoint(k) with complexes, values
    rw RingHom.map_zero with evalExtended
    exact complexRing.zeroOf

-- ℂ[4 + k] ⧸ (F) is ℂ[3 + k]: the fibre of F tensored with k more variables.
theorem extended_fibre
  shows ∃ e, e : quotientAlgebra(polynomialAlgebra(complexRing, 4 + k), extendedIdeal(k)) ≃ₐ
    polynomialAlgebra(complexRing, 3 + k)
proof
  have complexes := complexRing.comm_ring
  have ambient := polynomialRing.comm_ring at complexRing, 4 with complexes
  have extended := polynomialRing.comm_ring at complexRing, 4 + k with complexes
  obtain ⟨e, iso⟩ := fibre_equivalence
  have equivalence := forwardLift.iso at e, k with *
  unfold extendedQuotient at equivalence
  witness forwardLift(e, k)
  exact equivalence

theorem extendedF.not_coordinate
  shows ¬ (∃ e, ∃ i ∈ 4 + k,
    (e : polynomialAlgebra(complexRing, 4 + k) ≃ₐ polynomialAlgebra(complexRing, 4 + k)) ∧
    e(X(complexRing, 4 + k, i)) = extendedF(k))
proof
  have complexes := complexRing.comm_ring
  have member := extendedF.mem at k
  have values := extendedPoint.function at k
  have critical : ∀ i ∈ 4 + k, evaluationAt(complexRing, 4 + k, extendedPoint(k))(
      partialDerivative(complexRing, 4 + k, i)(extendedF(k))) = Ring.zero(complexRing)
    intros i index
    rw complexRing.zeroOf
    exact extendedF.critical at k, i with index
  exact no_coordinate_of_critical at complexRing, 4 + k, extendedF(k), extendedPoint(k) with
    complexes, complexRing.nontrivial, member, values, critical

end Stabilization
