-- Polynomial rings as algebras over their coefficient ring: evaluation as
-- the algebra homomorphism with prescribed variable images, its uniqueness,
-- renaming of variables along a map of index sets, and the flattening of a
-- polynomial ring over a polynomial ring with numeral index sets.
-- Part of the Abhyankar–Sathaye blueprint. Planned home: Algebra/Polynomial/Algebra.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module AbhyankarSathaye.PolynomialAlgebras
import Algebras
import Grace.Cumulus.Algebra.Polynomial.BundledEvaluation
import Grace.Cumulus.Algebra.Ring.Pow

-- The polynomial ring over K in the variables I, as an algebra over K by
-- the constants.
def polynomialAlgebra (K I : Set) : Set :=
  Algebra.mk(K, polynomialRing(K, I), polynomialConstant(K, I))

-- The polynomial ring over the polynomial ring, as an algebra over K.
def iteratedPolynomialAlgebra (K I J : Set) : Set :=
  Algebra.mk(K, polynomialRing(polynomialRing(K, I), J),
    compose(polynomialConstant(polynomialRing(K, I), J), polynomialConstant(K, I),
      Ring.carrier(K), Ring.carrier(polynomialRing(K, I)),
      Ring.carrier(polynomialRing(polynomialRing(K, I), J))))

-- The variables of K[J] indexed along σ : I → J.
def variableAssignment (K I J σ : Set) : Set :=
  { p ∈ I × Ring.carrier(polynomialRing(K, J)) | snd(p) = X(K, J, σ(fst(p))) }

-- Renaming: the K-algebra homomorphism K[I] → K[J] sending X_i to X_σ(i).
def polynomialRename (K I J σ : Set) : Set :=
  evaluationHom(K, polynomialRing(K, J), I, polynomialConstant(K, J),
    variableAssignment(K, I, J, σ))

section Polynomials
variable (K I : Set)
hypothesis base : CommRing(K)

theorem polynomialAlgebra.algebra
  shows Algebra(polynomialAlgebra(K, I))
proof
  sorry

theorem polynomialAlgebra.carrier
  shows algebraCarrier(polynomialAlgebra(K, I)) = Ring.carrier(polynomialRing(K, I))
proof
  simp [algebraCarrier, polynomialAlgebra, Algebra.mk.ring]

-- Evaluation at values in an algebra B over K is the K-algebra
-- homomorphism sending X_j to v(j), and it is the only one.
theorem evaluationHom.algebra_hom (B v : Set)
  requires algebra : Algebra(B)
  requires over : Algebra.base(B) = K
  requires values : v : I → algebraCarrier(B)
  shows evaluationHom(K, Algebra.ring(B), I, Algebra.map(B), v) :
    polynomialAlgebra(K, I) →ₐ B
proof
  sorry

theorem evaluationHom.algebra_X (B v j : Set)
  requires algebra : Algebra(B)
  requires over : Algebra.base(B) = K
  requires values : v : I → algebraCarrier(B)
  requires index : j ∈ I
  shows evaluationHom(K, Algebra.ring(B), I, Algebra.map(B), v)(X(K, I, j)) = v(j)
proof
  sorry

theorem AlgebraHom.polynomial_ext (B f g : Set)
  requires first : f : polynomialAlgebra(K, I) →ₐ B
  requires second : g : polynomialAlgebra(K, I) →ₐ B
  requires agree : ∀ j ∈ I, f(X(K, I, j)) = g(X(K, I, j))
  shows f = g
proof
  sorry

theorem polynomialRename.hom (J σ : Set)
  requires map : σ : I → J
  shows polynomialRename(K, I, J, σ) : polynomialAlgebra(K, I) →ₐ polynomialAlgebra(K, J)
proof
  sorry

theorem polynomialRename.map_X (J σ j : Set)
  requires map : σ : I → J
  requires index : j ∈ I
  shows polynomialRename(K, I, J, σ)(X(K, I, j)) = X(K, J, σ(j))
proof
  sorry

theorem polynomialRename.iso (J σ : Set)
  requires bijection : BijectiveBetween(σ, I, J)
  shows polynomialRename(K, I, J, σ) : polynomialAlgebra(K, I) ≃ₐ polynomialAlgebra(K, J)
proof
  sorry

end Polynomials

section Flattening
variable (K : Set, m n : Nat)
hypothesis base : CommRing(K)

theorem iteratedPolynomialAlgebra.algebra
  shows Algebra(iteratedPolynomialAlgebra(K, m, n))
proof
  sorry

-- K[m][n] is K[m + n]: the inner variable X_i goes to X_i and the outer
-- variable X_j to X_{m + j}.
theorem polynomialRing.flatten
  shows ∃ e, (e : iteratedPolynomialAlgebra(K, m, n) ≃ₐ polynomialAlgebra(K, m + n)) ∧
    (∀ i ∈ m, e(polynomialConstant(polynomialRing(K, m), n)(X(K, m, i))) =
      X(K, m + n, i)) ∧
    (∀ j ∈ n, e(X(polynomialRing(K, m), n, j)) = X(K, m + n, add(m, j)))
proof
  sorry

end Flattening

section Transport
variable (A C φ I : Set)
hypothesis iso : φ : A ≃ₐ C

-- An isomorphism of algebras over K carries polynomial algebras over their
-- rings to each other, as algebras over K.
theorem polynomialAlgebra.map_iso
  shows ∃ e, (e : restrictScalars(polynomialAlgebra(Algebra.ring(A), I), Algebra.base(A), Algebra.map(A)) ≃ₐ
      restrictScalars(polynomialAlgebra(Algebra.ring(C), I), Algebra.base(C), Algebra.map(C))) ∧
    (∀ a ∈ algebraCarrier(A),
      e(polynomialConstant(Algebra.ring(A), I)(a)) = polynomialConstant(Algebra.ring(C), I)(φ(a))) ∧
    (∀ j ∈ I, e(X(Algebra.ring(A), I, j)) = X(Algebra.ring(C), I, j))
proof
  sorry

end Transport
