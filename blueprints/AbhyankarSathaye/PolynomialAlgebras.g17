-- Polynomial rings as algebras over their coefficient ring: evaluation as
-- the algebra homomorphism with prescribed variable images, its uniqueness,
-- renaming of variables along a map of index sets, and the flattening of a
-- polynomial ring over a polynomial ring with numeral index sets.
-- Part of the Abhyankar–Sathaye blueprint. Planned home: Algebra/Polynomial/Algebra.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module AbhyankarSathaye.PolynomialAlgebras
import Algebras
import Grace.Cumulus.Algebra.Polynomial.BundledEvaluation
import Grace.Cumulus.Algebra.Ring.Pow

-- The polynomial ring over K in the variables I, as an algebra over K by
-- the constants.
def polynomialAlgebra (K I : Set) : Set :=
  Algebra.mk(K, polynomialRing(K, I), polynomialConstant(K, I))

-- The polynomial ring over the polynomial ring, as an algebra over K.
def iteratedPolynomialAlgebra (K I J : Set) : Set :=
  Algebra.mk(K, polynomialRing(polynomialRing(K, I), J),
    compose(polynomialConstant(polynomialRing(K, I), J), polynomialConstant(K, I),
      Ring.carrier(K), Ring.carrier(polynomialRing(K, I)),
      Ring.carrier(polynomialRing(polynomialRing(K, I), J))))

-- The variables of K[J] indexed along σ : I → J.
def variableAssignment (K I J σ : Set) : Set :=
  { p ∈ I × Ring.carrier(polynomialRing(K, J)) | snd(p) = X(K, J, σ(fst(p))) }

-- Renaming: the K-algebra homomorphism K[I] → K[J] sending X_i to X_σ(i).
def polynomialRename (K I J σ : Set) : Set :=
  evaluationHom(K, polynomialRing(K, J), I, polynomialConstant(K, J),
    variableAssignment(K, I, J, σ))

-- The projections of the polynomial algebra.
theorem polynomialAlgebra.base (K I : Set)
  shows Algebra.base(polynomialAlgebra(K, I)) = K
proof
  simp [polynomialAlgebra, Algebra.mk.base]

theorem polynomialAlgebra.ring (K I : Set)
  shows Algebra.ring(polynomialAlgebra(K, I)) = polynomialRing(K, I)
proof
  simp [polynomialAlgebra, Algebra.mk.ring]

theorem polynomialAlgebra.map (K I : Set)
  shows Algebra.map(polynomialAlgebra(K, I)) = polynomialConstant(K, I)
proof
  simp [polynomialAlgebra, Algebra.mk.map]

-- The variable assignment along σ is a function into K[J] with the
-- values X_σ(i).
theorem variableAssignment.function (K I J σ : Set)
  requires base : CommRing(K)
  requires map : σ : I → J
  shows variableAssignment(K, I, J, σ) : I → Ring.carrier(polynomialRing(K, J))
proof
  constructor
  . intros p member
    exact member.left
  constructor
  . intros x y relatedY z relatedZ
    obtain ⟨inY, shapeY⟩ := relatedY
    obtain ⟨_, shapeZ⟩ := relatedZ
    simp [fst.pair, snd.pair] at shapeY, shapeZ
    cc
  . intros i input
    have index := FunctionBetween.apply_closed with map, input
    have member := X.mem at K, J, σ(i) with base
    refine ⟨X(K, J, σ(i)), member, _⟩
    apply variableAssignment.membership.backward
    refine ⟨(product.pair with input, member), _⟩
    simp [fst.pair, snd.pair]

theorem variableAssignment.apply (K I J σ i : Set)
  requires base : CommRing(K)
  requires map : σ : I → J
  requires index : i ∈ I
  shows variableAssignment(K, I, J, σ)(i) = X(K, J, σ(i))
proof
  have function := variableAssignment.function with base, map
  have image := FunctionBetween.apply_closed with function, index
  have shape := FunctionBetween.relates_apply with function, index
  have data := variableAssignment.membership.forward with shape
  simp [fst.pair, snd.pair] at data
  exact data.right

-- Homomorphisms out of a polynomial ring agreeing on the constants and
-- the variables are equal.
theorem polynomialRing.hom_ext (K I S g h : Set)
  requires base : CommRing(K)
  requires first : g : polynomialRing(K, I) →+* S
  requires second : h : polynomialRing(K, I) →+* S
  requires constants : ∀ a ∈ K,
    g(polynomialConstant(K, I)(a)) = h(polynomialConstant(K, I)(a))
  requires variables : ∀ j ∈ I, g(X(K, I, j)) = h(X(K, I, j))
  shows g = h
proof
  have parts := CommRing.parts with base
  have gParts := RingHom.parts with first
  have hParts := RingHom.parts with second
  rw [polynomialRing.carrierOf, polynomialRing.addOf, polynomialRing.zeroOf,
    polynomialRing.negOf, polynomialRing.mulOf, polynomialRing.oneOf] at gParts, hParts
  have engineConstants : ∀ a ∈ K,
      g(polynomialConstant(I, K.carrier, K.zero, a)) =
        h(polynomialConstant(I, K.carrier, K.zero, a))
    intros a ha
    rw ← polynomialConstant.apply
    exact constants with a, ha
  have engineVariables : ∀ j ∈ I,
      g(polynomialVariable(I, K.carrier, K.zero, K.one, j)) =
        h(polynomialVariable(I, K.carrier, K.zero, K.one, j))
    intros j hj
    rw ← X.value
    exact variables with j, hj
  exact IsRingHom.polynomial_ext with parts, gParts, hParts, engineConstants,
    engineVariables

section Polynomials
variable (K I : Set)
hypothesis base : CommRing(K)

theorem polynomialAlgebra.algebra
  shows Algebra(polynomialAlgebra(K, I))
proof
  have ring := polynomialRing.comm_ring at K, I with base
  have hom := polynomialConstant.hom at K, I with base
  unfold polynomialAlgebra
  exact Algebra.intro with base, ring, hom

theorem polynomialAlgebra.carrier
  shows algebraCarrier(polynomialAlgebra(K, I)) = Ring.carrier(polynomialRing(K, I))
proof
  simp [algebraCarrier, polynomialAlgebra, Algebra.mk.ring]

-- Evaluation at values in an algebra B over K is the K-algebra
-- homomorphism sending X_j to v(j), and it is the only one.
theorem evaluationHom.algebra_hom (B v : Set)
  requires algebra : Algebra(B)
  requires over : Algebra.base(B) = K
  requires values : v : I → algebraCarrier(B)
  shows evaluationHom(K, Algebra.ring(B), I, Algebra.map(B), v) :
    polynomialAlgebra(K, I) →ₐ B
proof
  have ringB := Algebra.comm_ring with algebra
  have structureMap := algebra.right.right.right
  rw over at structureMap
  have valuesIn : v : I → Ring.carrier(Algebra.ring(B))
    unfold algebraCarrier at values
    exact values
  have hom := evaluationHom.hom at K, Algebra.ring(B), I, Algebra.map(B), v
    with base, ringB, structureMap, valuesIn
  have polynomial := polynomialAlgebra.algebra at K, I with base
  unfold AlgebraHom
  refine ⟨polynomial, algebra, ?_, ?_, ?_⟩
  . simp [polynomialAlgebra, Algebra.mk.base, over]
  . simp [polynomialAlgebra, Algebra.mk.ring]
  . intros a ha
    simp [polynomialAlgebra, Algebra.mk.base] at ha
    simp [polynomialAlgebra, Algebra.mk.map]
    exact evaluationHom.map_constant with base, ringB, structureMap, valuesIn, ha

theorem evaluationHom.algebra_X (B v j : Set)
  requires algebra : Algebra(B)
  requires over : Algebra.base(B) = K
  requires values : v : I → algebraCarrier(B)
  requires index : j ∈ I
  shows evaluationHom(K, Algebra.ring(B), I, Algebra.map(B), v)(X(K, I, j)) = v(j)
proof
  have ringB := Algebra.comm_ring with algebra
  have structureMap := algebra.right.right.right
  rw over at structureMap
  have valuesIn : v : I → Ring.carrier(Algebra.ring(B))
    unfold algebraCarrier at values
    exact values
  exact evaluationHom.map_X with base, ringB, structureMap, valuesIn, index

theorem AlgebraHom.polynomial_ext (B f g : Set)
  requires first : f : polynomialAlgebra(K, I) →ₐ B
  requires second : g : polynomialAlgebra(K, I) →ₐ B
  requires agree : ∀ j ∈ I, f(X(K, I, j)) = g(X(K, I, j))
  shows f = g
proof
  have fHom := AlgebraHom.ring_hom with first
  have gHom := AlgebraHom.ring_hom with second
  simp [polynomialAlgebra, Algebra.mk.ring] at fHom, gHom
  have constants : ∀ a ∈ K,
      f(polynomialConstant(K, I)(a)) = g(polynomialConstant(K, I)(a))
    intros a ha
    have member : a ∈ Ring.carrier(Algebra.base(polynomialAlgebra(K, I)))
      simp [polynomialAlgebra, Algebra.mk.base]
    have fBase := AlgebraHom.map_base with first, member
    have gBase := AlgebraHom.map_base with second, member
    simp [polynomialAlgebra, Algebra.mk.map] at fBase, gBase
    cc
  exact polynomialRing.hom_ext with base, fHom, gHom, constants, agree

theorem polynomialRename.hom (J σ : Set)
  requires map : σ : I → J
  shows polynomialRename(K, I, J, σ) : polynomialAlgebra(K, I) →ₐ polynomialAlgebra(K, J)
proof
  have algebra := polynomialAlgebra.algebra at K, J with base
  have over := polynomialAlgebra.base at K, J
  have values : variableAssignment(K, I, J, σ) : I → algebraCarrier(polynomialAlgebra(K, J))
    rw polynomialAlgebra.carrier
    exact variableAssignment.function with base, map
  have hom := evaluationHom.algebra_hom at K, I, polynomialAlgebra(K, J),
    variableAssignment(K, I, J, σ) with base, algebra, over, values
  rw [polynomialAlgebra.ring, polynomialAlgebra.map] at hom
  unfold polynomialRename
  exact hom

theorem polynomialRename.map_X (J σ j : Set)
  requires map : σ : I → J
  requires index : j ∈ I
  shows polynomialRename(K, I, J, σ)(X(K, I, j)) = X(K, J, σ(j))
proof
  have target := polynomialRing.comm_ring at K, J with base
  have constants := polynomialConstant.hom at K, J with base
  have values := variableAssignment.function with base, map
  have value := variableAssignment.apply with base, map, index
  unfold polynomialRename
  rw evaluationHom.map_X with base, target, constants, values, index
  exact value

theorem polynomialRename.iso (J σ : Set)
  requires bijection : BijectiveBetween(σ, I, J)
  shows polynomialRename(K, I, J, σ) : polynomialAlgebra(K, I) ≃ₐ polynomialAlgebra(K, J)
proof
  have injective := Bijective.injective with bijection
  have function := Injective.function with injective
  have inverse := converse.function_of_bijective with bijection
  have forward := polynomialRename.hom with base, function
  have backward := polynomialRename.hom at K, J, I, converse(σ, I, J)
    with base, inverse
  have forwardFunction := AlgebraHom.function with forward
  have backwardFunction := AlgebraHom.function with backward
  have algebraI := polynomialAlgebra.algebra at K, I with base
  have algebraJ := polynomialAlgebra.algebra at K, J with base
  -- Renaming back after renaming forward fixes every variable of K[I].
  have leftComposite := AlgebraHom.compose with forward, backward
  have identityI := AlgebraHom.identity with algebraI
  have leftAgree : ∀ j ∈ I,
      compose(polynomialRename(K, J, I, converse(σ, I, J)),
        polynomialRename(K, I, J, σ), algebraCarrier(polynomialAlgebra(K, I)),
        algebraCarrier(polynomialAlgebra(K, J)),
        algebraCarrier(polynomialAlgebra(K, I)))(X(K, I, j)) =
      identity(algebraCarrier(polynomialAlgebra(K, I)))(X(K, I, j))
    intros j hj
    have xIn : X(K, I, j) ∈ algebraCarrier(polynomialAlgebra(K, I))
      rw polynomialAlgebra.carrier
      exact X.mem at K, I, j with base
    have imageIn := FunctionBetween.apply_closed with function, hj
    have step := compose.apply with forwardFunction, backwardFunction, xIn
    have first := polynomialRename.map_X with base, function, hj
    have second := polynomialRename.map_X at K, J, I, converse(σ, I, J), σ(j)
      with base, inverse, imageIn
    have back := Bijective.inverse_apply with bijection, hj
    have fixed := identity.apply with xIn
    cc
  have leftEqual := AlgebraHom.polynomial_ext with leftComposite, identityI,
    leftAgree
  have left : ∀ x ∈ algebraCarrier(polynomialAlgebra(K, I)),
      polynomialRename(K, J, I, converse(σ, I, J))(polynomialRename(K, I, J, σ)(x)) = x
    intros x hx
    have step := compose.apply with forwardFunction, backwardFunction, hx
    have fixed := identity.apply with hx
    rw leftEqual at step
    cc
  -- And renaming forward after renaming back fixes every variable of K[J].
  have rightComposite := AlgebraHom.compose with backward, forward
  have identityJ := AlgebraHom.identity with algebraJ
  have rightAgree : ∀ k ∈ J,
      compose(polynomialRename(K, I, J, σ),
        polynomialRename(K, J, I, converse(σ, I, J)),
        algebraCarrier(polynomialAlgebra(K, J)),
        algebraCarrier(polynomialAlgebra(K, I)),
        algebraCarrier(polynomialAlgebra(K, J)))(X(K, J, k)) =
      identity(algebraCarrier(polynomialAlgebra(K, J)))(X(K, J, k))
    intros k hk
    have xIn : X(K, J, k) ∈ algebraCarrier(polynomialAlgebra(K, J))
      rw polynomialAlgebra.carrier
      exact X.mem at K, J, k with base
    have preimageIn := FunctionBetween.apply_closed with inverse, hk
    have step := compose.apply with backwardFunction, forwardFunction, xIn
    have first := polynomialRename.map_X at K, J, I, converse(σ, I, J), k
      with base, inverse, hk
    have second := polynomialRename.map_X with base, function, preimageIn
    have back := Bijective.apply_inverse with bijection, hk
    have fixed := identity.apply with xIn
    cc
  have rightEqual := AlgebraHom.polynomial_ext with rightComposite, identityJ,
    rightAgree
  have right : ∀ y ∈ algebraCarrier(polynomialAlgebra(K, J)),
      polynomialRename(K, I, J, σ)(polynomialRename(K, J, I, converse(σ, I, J))(y)) = y
    intros y hy
    have step := compose.apply with backwardFunction, forwardFunction, hy
    have fixed := identity.apply with hy
    rw rightEqual at step
    cc
  exact AlgebraIso.of_inverse with forward, backward, left, right

end Polynomials

-- The projections of the iterated polynomial algebra.
theorem iteratedPolynomialAlgebra.base (K I J : Set)
  shows Algebra.base(iteratedPolynomialAlgebra(K, I, J)) = K
proof
  simp [iteratedPolynomialAlgebra, Algebra.mk.base]

theorem iteratedPolynomialAlgebra.ring (K I J : Set)
  shows Algebra.ring(iteratedPolynomialAlgebra(K, I, J)) =
    polynomialRing(polynomialRing(K, I), J)
proof
  simp [iteratedPolynomialAlgebra, Algebra.mk.ring]

theorem iteratedPolynomialAlgebra.map (K I J : Set)
  shows Algebra.map(iteratedPolynomialAlgebra(K, I, J)) =
    compose(polynomialConstant(polynomialRing(K, I), J), polynomialConstant(K, I),
      Ring.carrier(K), Ring.carrier(polynomialRing(K, I)),
      Ring.carrier(polynomialRing(polynomialRing(K, I), J)))
proof
  simp [iteratedPolynomialAlgebra, Algebra.mk.map]

-- A position below m + n is below m or is m + j for a position j below n,
-- and the two cases are exclusive.
theorem membership.add_cases (m n : Nat) (k : Set)
  requires member : k ∈ add(m, n)
  shows k ∈ m ∨ ∃ j ∈ n, k = add(m, j)
proof
  have sumNat := add.closed at n, m
  have mNat : Nat(m) by typecheck
  have nNat : Nat(n) by typecheck
  have kNat := natural.member at add(m, n) with member
  have below := Less.of_membership at k, add(m, n) with member
  have split := Less.or_LessEqual at k, m
  cases split with small | large
  . left
    exact membership.of_Less with kNat, mNat, small
  . right
    obtain ⟨j, jNat, equation⟩ := LessEqual.exists_add at m, k with large
    have jBelow : j < n
      rw equation at below
      exact Less.add_left_cancel at j, n, m with below
    have jIn := membership.of_Less with jNat, nNat, jBelow
    witness j
    exact ⟨jIn, equation⟩

theorem membership.ne_add (m : Nat) (i j : Set)
  requires member : i ∈ m
  requires natural : Nat(j)
  shows i ≠ add(m, j)
proof
  have iNat := natural.member at m with member
  have below := Less.of_membership at i, m with member
  have above := LessEqual.add_right at m, j
  intro equal
  rw equal at below
  have refuted := LessEqual.not_Less with above
  exact refuted with below

theorem membership.add_offset (m n : Nat) (j : Set)
  requires index : j ∈ n
  shows add(m, j) ∈ add(m, n)
proof
  have jNat := natural.member at n with index
  have sumNat := add.closed at n, m
  have below := Less.of_membership at j, n with index
  have shifted := Less.add_monotone_left at j, n, m with below
  exact membership.of_Less with (add.closed at j, m), sumNat, shifted

theorem natural.subset_add (m n : Nat)
  shows m ⊆ add(m, n)
proof
  have sumNat := add.closed at n, m
  have bound := LessEqual.add_right at m, n
  intros i hi
  have iNat := natural.member at m with hi
  have below := Less.of_membership at i, m with hi
  have under := Less.transitive_LessEqual with below, bound
  exact membership.of_Less with iNat, sumNat, under

-- The offset j ↦ m + j from n into m + n.
def offsetMap (m n : Set) : Set :=
  { p ∈ n × add(m, n) | snd(p) = add(m, fst(p)) }

theorem offsetMap.function (m n : Nat)
  shows offsetMap(m, n) : n → add(m, n)
proof
  have sumNat := add.closed at n, m
  have nNat : Nat(n) by typecheck
  constructor
  . intros p member
    exact member.left
  constructor
  . intros x y relatedY z relatedZ
    obtain ⟨inY, shapeY⟩ := relatedY
    obtain ⟨_, shapeZ⟩ := relatedZ
    simp [fst.pair, snd.pair] at shapeY, shapeZ
    cc
  . intros j input
    have jNat := natural.member at n with input
    have below := Less.of_membership at j, n with input
    have shifted := Less.add_monotone_left at j, n, m with below
    have member := membership.of_Less with (add.closed at j, m), sumNat, shifted
    refine ⟨add(m, j), member, _⟩
    apply offsetMap.membership.backward
    refine ⟨(product.pair with input, member), _⟩
    simp [fst.pair, snd.pair]

theorem offsetMap.apply (m n : Nat) (j : Set)
  requires index : j ∈ n
  shows offsetMap(m, n)(j) = add(m, j)
proof
  have function := offsetMap.function at m, n
  have shape := FunctionBetween.relates_apply with function, index
  have data := offsetMap.membership.forward with shape
  simp [fst.pair, snd.pair] at data
  exact data.right

-- The assignment splitting the variables of K[m + n]: a position below m
-- goes to the inner variable X_i as a constant of K[m][n], and m + j to
-- the outer variable X_j.
def splitAssignment (K m n : Set) : Set :=
  { p ∈ add(m, n) × Ring.carrier(polynomialRing(polynomialRing(K, m), n)) |
    (fst(p) ∈ m ∧
      snd(p) = polynomialConstant(polynomialRing(K, m), n)(X(K, m, fst(p)))) ∨
    (∃ j ∈ n, fst(p) = add(m, j) ∧ snd(p) = X(polynomialRing(K, m), n, j)) }

theorem splitAssignment.function (K : Set, m n : Nat)
  requires base : CommRing(K)
  shows splitAssignment(K, m, n) :
    add(m, n) → Ring.carrier(polynomialRing(polynomialRing(K, m), n))
proof
  have inner := polynomialRing.comm_ring at K, m with base
  have nNat : Nat(n) by typecheck
  constructor
  . intros p member
    exact member.left
  constructor
  . intros x y relatedY z relatedZ
    obtain ⟨inY, shapeY⟩ := relatedY
    obtain ⟨_, shapeZ⟩ := relatedZ
    simp [fst.pair, snd.pair] at shapeY, shapeZ
    rcases shapeY with innerY | outerY
    . obtain ⟨xIn, yValue⟩ := innerY
      rcases shapeZ with innerZ | outerZ
      . obtain ⟨_, zValue⟩ := innerZ
        cc
      . obtain ⟨j, hj, xEq, zValue⟩ := outerZ
        simp [fst.pair, snd.pair] at xEq, zValue
        exfalso
        have jNat := natural.member at n with hj
        have apart := membership.ne_add at m, x, j with xIn, jNat
        exact apart with xEq
    . obtain ⟨j, hj, xEq, yValue⟩ := outerY
      simp [fst.pair, snd.pair] at xEq, yValue
      rcases shapeZ with innerZ | outerZ
      . obtain ⟨xIn, zValue⟩ := innerZ
        exfalso
        have jNat := natural.member at n with hj
        have apart := membership.ne_add at m, x, j with xIn, jNat
        exact apart with xEq
      . obtain ⟨l, hl, xEq2, zValue⟩ := outerZ
        simp [fst.pair, snd.pair] at xEq2, zValue
        have same : add(m, j) = add(m, l) by cc
        have cancel := add.left_cancel at j, l, m
        have equal := cancel with same
        cc
  . intros k input
    have split := membership.add_cases at m, n, k with input
    rcases split with kIn | shifted
    . have xIn := X.mem at K, m, k with base
      have member := polynomialConstant.mem at polynomialRing(K, m), n, X(K, m, k)
        with inner
      refine ⟨polynomialConstant(polynomialRing(K, m), n)(X(K, m, k)), member, _⟩
      apply splitAssignment.membership.backward
      refine ⟨(product.pair with input, member), _⟩
      simp [fst.pair, snd.pair]
    . obtain ⟨j, hj, kEq⟩ := shifted
      have member := X.mem at polynomialRing(K, m), n, j with inner
      refine ⟨X(polynomialRing(K, m), n, j), member, _⟩
      apply splitAssignment.membership.backward
      refine ⟨(product.pair with input, member), _⟩
      simp [fst.pair, snd.pair]

theorem splitAssignment.inner (K : Set, m n : Nat) (i : Set)
  requires base : CommRing(K)
  requires index : i ∈ m
  shows splitAssignment(K, m, n)(i) =
    polynomialConstant(polynomialRing(K, m), n)(X(K, m, i))
proof
  have nNat : Nat(n) by typecheck
  have below := Less.of_membership at i, m with index
  have iNat := natural.member at m with index
  have sumNat := add.closed at n, m
  have bound := LessEqual.add_right at m, n
  have input := membership.of_Less with iNat, sumNat, (Less.transitive_LessEqual with below, bound)
  have function := splitAssignment.function at K, m, n with base
  have shape := FunctionBetween.relates_apply with function, input
  have data := splitAssignment.membership.forward with shape
  simp [fst.pair, snd.pair] at data
  rcases data.right with innerCase | outerCase
  . exact innerCase.right
  . obtain ⟨j, hj, iEq, value⟩ := outerCase
    simp [fst.pair, snd.pair] at iEq, value
    exfalso
    have jNat := natural.member at n with hj
    have apart := membership.ne_add at m, i, j with index, jNat
    exact apart with iEq

theorem splitAssignment.outer (K : Set, m n : Nat) (j : Set)
  requires base : CommRing(K)
  requires index : j ∈ n
  shows splitAssignment(K, m, n)(add(m, j)) = X(polynomialRing(K, m), n, j)
proof
  have jNat := natural.member at n with index
  have sumNat := add.closed at n, m
  have below := Less.of_membership at j, n with index
  have shifted := Less.add_monotone_left at j, n, m with below
  have input := membership.of_Less with (add.closed at j, m), sumNat, shifted
  have function := splitAssignment.function at K, m, n with base
  have shape := FunctionBetween.relates_apply with function, input
  have data := splitAssignment.membership.forward with shape
  simp [fst.pair, snd.pair] at data
  rcases data.right with innerCase | outerCase
  . obtain ⟨member, value⟩ := innerCase
    exfalso
    have apart := membership.ne_add at m, add(m, j), j with member, jNat
    apply apart
    rfl
  . obtain ⟨l, hl, equation, value⟩ := outerCase
    simp [fst.pair, snd.pair] at equation, value
    have cancel := add.left_cancel at j, l, m
    have equal := cancel with equation
    cc

-- Homomorphisms out of an iterated polynomial ring agreeing on the
-- constants, the inner variables, and the outer variables are equal.
theorem polynomialRing.iterated_hom_ext (K I J S g h : Set)
  requires base : CommRing(K)
  requires first : g : polynomialRing(polynomialRing(K, I), J) →+* S
  requires second : h : polynomialRing(polynomialRing(K, I), J) →+* S
  requires constants : ∀ a ∈ K,
    g(polynomialConstant(polynomialRing(K, I), J)(polynomialConstant(K, I)(a))) =
      h(polynomialConstant(polynomialRing(K, I), J)(polynomialConstant(K, I)(a)))
  requires inner : ∀ i ∈ I,
    g(polynomialConstant(polynomialRing(K, I), J)(X(K, I, i))) =
      h(polynomialConstant(polynomialRing(K, I), J)(X(K, I, i)))
  requires outer : ∀ j ∈ J,
    g(X(polynomialRing(K, I), J, j)) = h(X(polynomialRing(K, I), J, j))
  shows g = h
proof
  have innerRing := polynomialRing.comm_ring at K, I with base
  have constantsHom := polynomialConstant.hom at polynomialRing(K, I), J with innerRing
  have gInner := RingHom.comp with innerRing, constantsHom, first
  have hInner := RingHom.comp with innerRing, constantsHom, second
  have constFunction := constantsHom.right.right.left
  have gFunction := first.right.right.left
  have hFunction := second.right.right.left
  have innerConstants : ∀ a ∈ K,
      compose(g, polynomialConstant(polynomialRing(K, I), J),
        Ring.carrier(polynomialRing(K, I)),
        Ring.carrier(polynomialRing(polynomialRing(K, I), J)),
        Ring.carrier(S))(polynomialConstant(K, I)(a)) =
      compose(h, polynomialConstant(polynomialRing(K, I), J),
        Ring.carrier(polynomialRing(K, I)),
        Ring.carrier(polynomialRing(polynomialRing(K, I), J)),
        Ring.carrier(S))(polynomialConstant(K, I)(a))
    intros a ha
    have member := polynomialConstant.mem at K, I, a with base
    have stepG := compose.apply with constFunction, gFunction, member
    have stepH := compose.apply with constFunction, hFunction, member
    have agree := constants with a, ha
    cc
  have innerVariables : ∀ i ∈ I,
      compose(g, polynomialConstant(polynomialRing(K, I), J),
        Ring.carrier(polynomialRing(K, I)),
        Ring.carrier(polynomialRing(polynomialRing(K, I), J)),
        Ring.carrier(S))(X(K, I, i)) =
      compose(h, polynomialConstant(polynomialRing(K, I), J),
        Ring.carrier(polynomialRing(K, I)),
        Ring.carrier(polynomialRing(polynomialRing(K, I), J)),
        Ring.carrier(S))(X(K, I, i))
    intros i hi
    have member := X.mem at K, I, i with base
    have stepG := compose.apply with constFunction, gFunction, member
    have stepH := compose.apply with constFunction, hFunction, member
    have agree := inner with i, hi
    cc
  have innerEqual := polynomialRing.hom_ext with base, gInner, hInner,
    innerConstants, innerVariables
  have outerConstants : ∀ q ∈ Ring.carrier(polynomialRing(K, I)),
      g(polynomialConstant(polynomialRing(K, I), J)(q)) =
        h(polynomialConstant(polynomialRing(K, I), J)(q))
    intros q hq
    have stepG := compose.apply with constFunction, gFunction, hq
    have stepH := compose.apply with constFunction, hFunction, hq
    rw innerEqual at stepG
    cc
  exact polynomialRing.hom_ext with innerRing, first, second, outerConstants, outer

-- Flattening K[m][n] onto K[m + n]: the inner ring goes in by the
-- inclusion of m into m + n, the outer variables by the offset; the
-- inverse splits the variables of K[m + n].
def innerFlatten (K m n : Set) : Set :=
  evaluationHom(K, polynomialRing(K, add(m, n)), m, polynomialConstant(K, add(m, n)),
    variableAssignment(K, m, add(m, n), identity(m)))

def flattenHom (K m n : Set) : Set :=
  evaluationHom(polynomialRing(K, m), polynomialRing(K, add(m, n)), n,
    innerFlatten(K, m, n), variableAssignment(K, n, add(m, n), offsetMap(m, n)))

def unflattenHom (K m n : Set) : Set :=
  evaluationHom(K, polynomialRing(polynomialRing(K, m), n), add(m, n),
    compose(polynomialConstant(polynomialRing(K, m), n), polynomialConstant(K, m),
      Ring.carrier(K), Ring.carrier(polynomialRing(K, m)),
      Ring.carrier(polynomialRing(polynomialRing(K, m), n))),
    splitAssignment(K, m, n))

section FlattenLaws
variable (K : Set, m n : Nat)
hypothesis base : CommRing(K)

theorem innerFlatten.hom
  shows innerFlatten(K, m, n) : polynomialRing(K, m) →+* polynomialRing(K, add(m, n))
proof
  have sumRing := polynomialRing.comm_ring at K, add(m, n) with base
  have constants := polynomialConstant.hom at K, add(m, n) with base
  have inclusion := identity.inclusion with (natural.subset_add at m, n)
  have values := variableAssignment.function with base, inclusion
  unfold innerFlatten
  exact evaluationHom.hom with base, sumRing, constants, values

theorem innerFlatten.map_constant (a : Set)
  requires member : a ∈ Ring.carrier(K)
  shows innerFlatten(K, m, n)(polynomialConstant(K, m)(a)) =
    polynomialConstant(K, add(m, n))(a)
proof
  have sumRing := polynomialRing.comm_ring at K, add(m, n) with base
  have constants := polynomialConstant.hom at K, add(m, n) with base
  have inclusion := identity.inclusion with (natural.subset_add at m, n)
  have values := variableAssignment.function with base, inclusion
  unfold innerFlatten
  exact evaluationHom.map_constant with base, sumRing, constants, values, member

theorem innerFlatten.map_X (i : Set)
  requires index : i ∈ m
  shows innerFlatten(K, m, n)(X(K, m, i)) = X(K, add(m, n), i)
proof
  have sumRing := polynomialRing.comm_ring at K, add(m, n) with base
  have constants := polynomialConstant.hom at K, add(m, n) with base
  have inclusion := identity.inclusion with (natural.subset_add at m, n)
  have values := variableAssignment.function with base, inclusion
  have step := evaluationHom.map_X with base, sumRing, constants, values, index
  have value := variableAssignment.apply with base, inclusion, index
  have fixed := identity.apply with index
  unfold innerFlatten
  rw [step, value, fixed]
  rfl

theorem flattenHom.hom
  shows flattenHom(K, m, n) :
    polynomialRing(polynomialRing(K, m), n) →+* polynomialRing(K, add(m, n))
proof
  have innerRing := polynomialRing.comm_ring at K, m with base
  have sumRing := polynomialRing.comm_ring at K, add(m, n) with base
  have innerHom := innerFlatten.hom at K, m, n with base
  have offset := offsetMap.function at m, n
  have values := variableAssignment.function with base, offset
  unfold flattenHom
  exact evaluationHom.hom with innerRing, sumRing, innerHom, values

theorem flattenHom.map_inner (q : Set)
  requires member : q ∈ Ring.carrier(polynomialRing(K, m))
  shows flattenHom(K, m, n)(polynomialConstant(polynomialRing(K, m), n)(q)) =
    innerFlatten(K, m, n)(q)
proof
  have innerRing := polynomialRing.comm_ring at K, m with base
  have sumRing := polynomialRing.comm_ring at K, add(m, n) with base
  have innerHom := innerFlatten.hom at K, m, n with base
  have offset := offsetMap.function at m, n
  have values := variableAssignment.function with base, offset
  unfold flattenHom
  exact evaluationHom.map_constant with innerRing, sumRing, innerHom, values, member

theorem flattenHom.map_X (j : Set)
  requires index : j ∈ n
  shows flattenHom(K, m, n)(X(polynomialRing(K, m), n, j)) = X(K, add(m, n), add(m, j))
proof
  have innerRing := polynomialRing.comm_ring at K, m with base
  have sumRing := polynomialRing.comm_ring at K, add(m, n) with base
  have innerHom := innerFlatten.hom at K, m, n with base
  have offset := offsetMap.function at m, n
  have values := variableAssignment.function with base, offset
  have step := evaluationHom.map_X with innerRing, sumRing, innerHom, values, index
  have value := variableAssignment.apply with base, offset, index
  have shifted := offsetMap.apply at m, n, j with index
  unfold flattenHom
  rw [step, value, shifted]
  rfl

theorem unflattenHom.hom
  shows unflattenHom(K, m, n) :
    polynomialRing(K, add(m, n)) →+* polynomialRing(polynomialRing(K, m), n)
proof
  have innerRing := polynomialRing.comm_ring at K, m with base
  have outerRing := polynomialRing.comm_ring at polynomialRing(K, m), n with innerRing
  have innerConstants := polynomialConstant.hom at K, m with base
  have outerConstants := polynomialConstant.hom at polynomialRing(K, m), n with innerRing
  have scalars := RingHom.comp with base, innerConstants, outerConstants
  have values := splitAssignment.function at K, m, n with base
  unfold unflattenHom
  exact evaluationHom.hom with base, outerRing, scalars, values

theorem unflattenHom.map_constant (a : Set)
  requires member : a ∈ Ring.carrier(K)
  shows unflattenHom(K, m, n)(polynomialConstant(K, add(m, n))(a)) =
    polynomialConstant(polynomialRing(K, m), n)(polynomialConstant(K, m)(a))
proof
  have innerRing := polynomialRing.comm_ring at K, m with base
  have outerRing := polynomialRing.comm_ring at polynomialRing(K, m), n with innerRing
  have innerConstants := polynomialConstant.hom at K, m with base
  have outerConstants := polynomialConstant.hom at polynomialRing(K, m), n with innerRing
  have scalars := RingHom.comp with base, innerConstants, outerConstants
  have values := splitAssignment.function at K, m, n with base
  have step := evaluationHom.map_constant with base, outerRing, scalars, values, member
  have innerFunction := innerConstants.right.right.left
  have outerFunction := outerConstants.right.right.left
  have composite := compose.apply with innerFunction, outerFunction, member
  unfold unflattenHom
  rw step
  exact composite

theorem unflattenHom.map_inner_X (i : Set)
  requires index : i ∈ m
  shows unflattenHom(K, m, n)(X(K, add(m, n), i)) =
    polynomialConstant(polynomialRing(K, m), n)(X(K, m, i))
proof
  have innerRing := polynomialRing.comm_ring at K, m with base
  have outerRing := polynomialRing.comm_ring at polynomialRing(K, m), n with innerRing
  have innerConstants := polynomialConstant.hom at K, m with base
  have outerConstants := polynomialConstant.hom at polynomialRing(K, m), n with innerRing
  have scalars := RingHom.comp with base, innerConstants, outerConstants
  have values := splitAssignment.function at K, m, n with base
  have inclusion := natural.subset_add at m, n
  have input := inclusion with i, index
  have step := evaluationHom.map_X with base, outerRing, scalars, values, input
  have value := splitAssignment.inner at K, m, n, i with base, index
  unfold unflattenHom
  rw [step, value]
  rfl

theorem unflattenHom.map_outer_X (j : Set)
  requires index : j ∈ n
  shows unflattenHom(K, m, n)(X(K, add(m, n), add(m, j))) = X(polynomialRing(K, m), n, j)
proof
  have innerRing := polynomialRing.comm_ring at K, m with base
  have outerRing := polynomialRing.comm_ring at polynomialRing(K, m), n with innerRing
  have innerConstants := polynomialConstant.hom at K, m with base
  have outerConstants := polynomialConstant.hom at polynomialRing(K, m), n with innerRing
  have scalars := RingHom.comp with base, innerConstants, outerConstants
  have values := splitAssignment.function at K, m, n with base
  have input := membership.add_offset at m, n, j with index
  have step := evaluationHom.map_X with base, outerRing, scalars, values, input
  have value := splitAssignment.outer at K, m, n, j with base, index
  unfold unflattenHom
  rw [step, value]
  rfl

-- Unflattening after flattening fixes K[m][n], and flattening after
-- unflattening fixes K[m + n].
theorem flattenHom.left_inverse
  shows ∀ p ∈ Ring.carrier(polynomialRing(polynomialRing(K, m), n)),
    unflattenHom(K, m, n)(flattenHom(K, m, n)(p)) = p
proof
  have innerRing := polynomialRing.comm_ring at K, m with base
  have outerRing := polynomialRing.comm_ring at polynomialRing(K, m), n with innerRing
  have first := flattenHom.hom at K, m, n with base
  have second := unflattenHom.hom at K, m, n with base
  have composite := RingHom.comp with outerRing, first, second
  have identityHom := RingHom.id with outerRing
  have firstFunction := first.right.right.left
  have secondFunction := second.right.right.left
  have constants : ∀ a ∈ K,
      compose(unflattenHom(K, m, n), flattenHom(K, m, n),
        Ring.carrier(polynomialRing(polynomialRing(K, m), n)),
        Ring.carrier(polynomialRing(K, add(m, n))),
        Ring.carrier(polynomialRing(polynomialRing(K, m), n)))(polynomialConstant(polynomialRing(K, m), n)(polynomialConstant(K, m)(a))) =
      identity(Ring.carrier(polynomialRing(polynomialRing(K, m), n)))(
        polynomialConstant(polynomialRing(K, m), n)(polynomialConstant(K, m)(a)))
    intros a ha
    have innerIn := polynomialConstant.mem at K, m, a with base
    have member := polynomialConstant.mem at polynomialRing(K, m), n,
      polynomialConstant(K, m)(a) with innerRing
    have step := compose.apply with firstFunction, secondFunction, member
    have flat := flattenHom.map_inner at K, m, n, polynomialConstant(K, m)(a)
      with base, innerIn
    have flatInner := innerFlatten.map_constant at K, m, n, a with base, ha
    have back := unflattenHom.map_constant at K, m, n, a with base, ha
    have fixed := identity.apply with member
    cc
  have inner : ∀ i ∈ m,
      compose(unflattenHom(K, m, n), flattenHom(K, m, n),
        Ring.carrier(polynomialRing(polynomialRing(K, m), n)),
        Ring.carrier(polynomialRing(K, add(m, n))),
        Ring.carrier(polynomialRing(polynomialRing(K, m), n)))(polynomialConstant(polynomialRing(K, m), n)(X(K, m, i))) =
      identity(Ring.carrier(polynomialRing(polynomialRing(K, m), n)))(
        polynomialConstant(polynomialRing(K, m), n)(X(K, m, i)))
    intros i hi
    have xIn := X.mem at K, m, i with base
    have member := polynomialConstant.mem at polynomialRing(K, m), n, X(K, m, i)
      with innerRing
    have step := compose.apply with firstFunction, secondFunction, member
    have flat := flattenHom.map_inner at K, m, n, X(K, m, i) with base, xIn
    have flatInner := innerFlatten.map_X at K, m, n, i with base, hi
    have back := unflattenHom.map_inner_X at K, m, n, i with base, hi
    have fixed := identity.apply with member
    cc
  have outer : ∀ j ∈ n,
      compose(unflattenHom(K, m, n), flattenHom(K, m, n),
        Ring.carrier(polynomialRing(polynomialRing(K, m), n)),
        Ring.carrier(polynomialRing(K, add(m, n))),
        Ring.carrier(polynomialRing(polynomialRing(K, m), n)))(X(polynomialRing(K, m), n, j)) =
      identity(Ring.carrier(polynomialRing(polynomialRing(K, m), n)))(
        X(polynomialRing(K, m), n, j))
    intros j hj
    have member := X.mem at polynomialRing(K, m), n, j with innerRing
    have step := compose.apply with firstFunction, secondFunction, member
    have flat := flattenHom.map_X at K, m, n, j with base, hj
    have back := unflattenHom.map_outer_X at K, m, n, j with base, hj
    have fixed := identity.apply with member
    cc
  have equal := polynomialRing.iterated_hom_ext with base, composite, identityHom,
    constants, inner, outer
  intros p hp
  have step := compose.apply with firstFunction, secondFunction, hp
  have fixed := identity.apply with hp
  rw equal at step
  cc

theorem flattenHom.right_inverse
  shows ∀ q ∈ Ring.carrier(polynomialRing(K, add(m, n))),
    flattenHom(K, m, n)(unflattenHom(K, m, n)(q)) = q
proof
  have sumRing := polynomialRing.comm_ring at K, add(m, n) with base
  have first := unflattenHom.hom at K, m, n with base
  have second := flattenHom.hom at K, m, n with base
  have composite := RingHom.comp with sumRing, first, second
  have identityHom := RingHom.id with sumRing
  have firstFunction := first.right.right.left
  have secondFunction := second.right.right.left
  have constants : ∀ a ∈ K,
      compose(flattenHom(K, m, n), unflattenHom(K, m, n),
        Ring.carrier(polynomialRing(K, add(m, n))),
        Ring.carrier(polynomialRing(polynomialRing(K, m), n)),
        Ring.carrier(polynomialRing(K, add(m, n))))(polynomialConstant(K, add(m, n))(a)) =
      identity(Ring.carrier(polynomialRing(K, add(m, n))))(polynomialConstant(K, add(m, n))(a))
    intros a ha
    have member := polynomialConstant.mem at K, add(m, n), a with base
    have innerIn := polynomialConstant.mem at K, m, a with base
    have step := compose.apply with firstFunction, secondFunction, member
    have back := unflattenHom.map_constant at K, m, n, a with base, ha
    have flat := flattenHom.map_inner at K, m, n, polynomialConstant(K, m)(a)
      with base, innerIn
    have flatInner := innerFlatten.map_constant at K, m, n, a with base, ha
    have fixed := identity.apply with member
    cc
  have variables : ∀ k ∈ add(m, n),
      compose(flattenHom(K, m, n), unflattenHom(K, m, n),
        Ring.carrier(polynomialRing(K, add(m, n))),
        Ring.carrier(polynomialRing(polynomialRing(K, m), n)),
        Ring.carrier(polynomialRing(K, add(m, n))))(X(K, add(m, n), k)) =
      identity(Ring.carrier(polynomialRing(K, add(m, n))))(X(K, add(m, n), k))
    intros k hk
    have member := X.mem at K, add(m, n), k with base
    have step := compose.apply with firstFunction, secondFunction, member
    have fixed := identity.apply with member
    have split := membership.add_cases at m, n, k with hk
    rcases split with kIn | shifted
    . have xIn := X.mem at K, m, k with base
      have back := unflattenHom.map_inner_X at K, m, n, k with base, kIn
      have flat := flattenHom.map_inner at K, m, n, X(K, m, k) with base, xIn
      have flatInner := innerFlatten.map_X at K, m, n, k with base, kIn
      cc
    . obtain ⟨j, hj, kEq⟩ := shifted
      have back := unflattenHom.map_outer_X at K, m, n, j with base, hj
      have flat := flattenHom.map_X at K, m, n, j with base, hj
      cc
  have equal := polynomialRing.hom_ext with base, composite, identityHom,
    constants, variables
  intros q hq
  have step := compose.apply with firstFunction, secondFunction, hq
  have fixed := identity.apply with hq
  rw equal at step
  cc

end FlattenLaws

section Flattening
variable (K : Set, m n : Nat)
hypothesis base : CommRing(K)

theorem iteratedPolynomialAlgebra.algebra
  shows Algebra(iteratedPolynomialAlgebra(K, m, n))
proof
  have inner := polynomialRing.comm_ring at K, m with base
  have outer := polynomialRing.comm_ring at polynomialRing(K, m), n with inner
  have innerHom := polynomialConstant.hom at K, m with base
  have outerHom := polynomialConstant.hom at polynomialRing(K, m), n with inner
  have hom := RingHom.comp with base, innerHom, outerHom
  unfold iteratedPolynomialAlgebra
  exact Algebra.intro with base, outer, hom

theorem flattenHom.algebra_hom
  shows flattenHom(K, m, n) :
    iteratedPolynomialAlgebra(K, m, n) →ₐ polynomialAlgebra(K, m + n)
proof
  have iterated := iteratedPolynomialAlgebra.algebra at K, m, n with base
  have target := polynomialAlgebra.algebra at K, add(m, n) with base
  have hom := flattenHom.hom at K, m, n with base
  have innerConstants := polynomialConstant.hom at K, m with base
  have innerRing := polynomialRing.comm_ring at K, m with base
  have outerConstants := polynomialConstant.hom at polynomialRing(K, m), n with innerRing
  have innerFunction := innerConstants.right.right.left
  have outerFunction := outerConstants.right.right.left
  unfold AlgebraHom
  refine ⟨iterated, target, ?_, ?_, ?_⟩
  . rw [iteratedPolynomialAlgebra.base, polynomialAlgebra.base]
    rfl
  . rw [iteratedPolynomialAlgebra.ring, polynomialAlgebra.ring]
    exact hom
  . intros a ha
    rw iteratedPolynomialAlgebra.base at ha
    rw [iteratedPolynomialAlgebra.map, polynomialAlgebra.map]
    have composite := compose.apply with innerFunction, outerFunction, ha
    have innerIn := polynomialConstant.mem at K, m, a with base
    have flat := flattenHom.map_inner at K, m, n, polynomialConstant(K, m)(a)
      with base, innerIn
    have flatInner := innerFlatten.map_constant at K, m, n, a with base, ha
    cc

theorem unflattenHom.algebra_hom
  shows unflattenHom(K, m, n) :
    polynomialAlgebra(K, m + n) →ₐ iteratedPolynomialAlgebra(K, m, n)
proof
  have iterated := iteratedPolynomialAlgebra.algebra at K, m, n with base
  have over := iteratedPolynomialAlgebra.base at K, m, n
  have values : splitAssignment(K, m, n) : add(m, n) → algebraCarrier(iteratedPolynomialAlgebra(K, m, n))
    unfold algebraCarrier
    rw iteratedPolynomialAlgebra.ring
    exact splitAssignment.function at K, m, n with base
  have hom := evaluationHom.algebra_hom at K, add(m, n),
    iteratedPolynomialAlgebra(K, m, n), splitAssignment(K, m, n)
    with base, iterated, over, values
  rw [iteratedPolynomialAlgebra.ring, iteratedPolynomialAlgebra.map] at hom
  unfold unflattenHom
  exact hom

-- K[m][n] is K[m + n]: the inner variable X_i goes to X_i and the outer
-- variable X_j to X_{m + j}.
theorem polynomialRing.flatten
  shows ∃ e, (e : iteratedPolynomialAlgebra(K, m, n) ≃ₐ polynomialAlgebra(K, m + n)) ∧
    (∀ i ∈ m, e(polynomialConstant(polynomialRing(K, m), n)(X(K, m, i))) =
      X(K, m + n, i)) ∧
    (∀ j ∈ n, e(X(polynomialRing(K, m), n, j)) = X(K, m + n, add(m, j)))
proof
  have forward := flattenHom.algebra_hom at K, m, n with base
  have backward := unflattenHom.algebra_hom at K, m, n with base
  have leftInverse := flattenHom.left_inverse at K, m, n with base
  have rightInverse := flattenHom.right_inverse at K, m, n with base
  have carrierIterated : algebraCarrier(iteratedPolynomialAlgebra(K, m, n)) =
      Ring.carrier(polynomialRing(polynomialRing(K, m), n))
    unfold algebraCarrier
    rw iteratedPolynomialAlgebra.ring
    rfl
  have carrierSum : algebraCarrier(polynomialAlgebra(K, add(m, n))) =
      Ring.carrier(polynomialRing(K, add(m, n)))
    unfold algebraCarrier
    rw polynomialAlgebra.ring
    rfl
  have left : ∀ x ∈ algebraCarrier(iteratedPolynomialAlgebra(K, m, n)),
      unflattenHom(K, m, n)(flattenHom(K, m, n)(x)) = x
    intros x hx
    rw carrierIterated at hx
    exact leftInverse with x, hx
  have right : ∀ y ∈ algebraCarrier(polynomialAlgebra(K, add(m, n))),
      flattenHom(K, m, n)(unflattenHom(K, m, n)(y)) = y
    intros y hy
    rw carrierSum at hy
    exact rightInverse with y, hy
  have iso := AlgebraIso.of_inverse with forward, backward, left, right
  have innerLaw : ∀ i ∈ m,
      flattenHom(K, m, n)(polynomialConstant(polynomialRing(K, m), n)(X(K, m, i))) =
        X(K, add(m, n), i)
    intros i hi
    have xIn := X.mem at K, m, i with base
    have flat := flattenHom.map_inner at K, m, n, X(K, m, i) with base, xIn
    have flatInner := innerFlatten.map_X at K, m, n, i with base, hi
    cc
  have outerLaw : ∀ j ∈ n,
      flattenHom(K, m, n)(X(polynomialRing(K, m), n, j)) = X(K, add(m, n), add(m, j))
    intros j hj
    exact flattenHom.map_X at K, m, n, j with base, hj
  witness flattenHom(K, m, n)
  exact ⟨iso, innerLaw, outerLaw⟩

end Flattening

-- The projections of the restriction of scalars.
theorem restrictScalars.base (A K ι : Set)
  shows Algebra.base(restrictScalars(A, K, ι)) = K
proof
  simp [restrictScalars, Algebra.mk.base]

theorem restrictScalars.ring (A K ι : Set)
  shows Algebra.ring(restrictScalars(A, K, ι)) = Algebra.ring(A)
proof
  simp [restrictScalars, Algebra.mk.ring]

theorem restrictScalars.map (A K ι : Set)
  shows Algebra.map(restrictScalars(A, K, ι)) =
    compose(Algebra.map(A), ι, Ring.carrier(K), Ring.carrier(Algebra.base(A)),
      algebraCarrier(A))
proof
  simp [restrictScalars, Algebra.mk.map]

-- Transport of a polynomial ring along a homomorphism φ of coefficient
-- algebras: the constants go through φ and each variable to itself.
def polynomialTransport (A C φ I : Set) : Set :=
  evaluationHom(Algebra.ring(A), polynomialRing(Algebra.ring(C), I), I,
    compose(polynomialConstant(Algebra.ring(C), I), φ,
      Ring.carrier(Algebra.ring(A)), Ring.carrier(Algebra.ring(C)),
      Ring.carrier(polynomialRing(Algebra.ring(C), I))),
    variableAssignment(Algebra.ring(C), I, I, identity(I)))

section TransportHom
variable (A C φ I : Set)
hypothesis hom : φ : A →ₐ C

theorem polynomialTransport.ring_hom
  shows polynomialTransport(A, C, φ, I) :
    polynomialRing(Algebra.ring(A), I) →+* polynomialRing(Algebra.ring(C), I)
proof
  have algebraA := hom.left
  have algebraC := hom.right.left
  have ringA := Algebra.comm_ring with algebraA
  have ringC := Algebra.comm_ring with algebraC
  have polyC := polynomialRing.comm_ring at Algebra.ring(C), I with ringC
  have ringHom := AlgebraHom.ring_hom with hom
  have constants := polynomialConstant.hom at Algebra.ring(C), I with ringC
  have scalars := RingHom.comp with ringA, ringHom, constants
  have values := variableAssignment.function with ringC, (identity.function at I)
  unfold polynomialTransport
  exact evaluationHom.hom with ringA, polyC, scalars, values

theorem polynomialTransport.map_constant (a : Set)
  requires member : a ∈ Ring.carrier(Algebra.ring(A))
  shows polynomialTransport(A, C, φ, I)(polynomialConstant(Algebra.ring(A), I)(a)) =
    polynomialConstant(Algebra.ring(C), I)(φ(a))
proof
  have algebraA := hom.left
  have algebraC := hom.right.left
  have ringA := Algebra.comm_ring with algebraA
  have ringC := Algebra.comm_ring with algebraC
  have polyC := polynomialRing.comm_ring at Algebra.ring(C), I with ringC
  have ringHom := AlgebraHom.ring_hom with hom
  have constants := polynomialConstant.hom at Algebra.ring(C), I with ringC
  have scalars := RingHom.comp with ringA, ringHom, constants
  have values := variableAssignment.function with ringC, (identity.function at I)
  have phiFunction := ringHom.right.right.left
  have constantFunction := constants.right.right.left
  have step := evaluationHom.map_constant with ringA, polyC, scalars, values, member
  have composite := compose.apply with phiFunction, constantFunction, member
  unfold polynomialTransport
  rw step
  exact composite

theorem polynomialTransport.map_X (j : Set)
  requires index : j ∈ I
  shows polynomialTransport(A, C, φ, I)(X(Algebra.ring(A), I, j)) =
    X(Algebra.ring(C), I, j)
proof
  have algebraA := hom.left
  have algebraC := hom.right.left
  have ringA := Algebra.comm_ring with algebraA
  have ringC := Algebra.comm_ring with algebraC
  have polyC := polynomialRing.comm_ring at Algebra.ring(C), I with ringC
  have ringHom := AlgebraHom.ring_hom with hom
  have constants := polynomialConstant.hom at Algebra.ring(C), I with ringC
  have scalars := RingHom.comp with ringA, ringHom, constants
  have values := variableAssignment.function with ringC, (identity.function at I)
  have step := evaluationHom.map_X with ringA, polyC, scalars, values, index
  have value := variableAssignment.apply with ringC, (identity.function at I), index
  have fixed := identity.apply with index
  unfold polynomialTransport
  rw [step, value, fixed]
  rfl

-- The transport is a homomorphism of algebras over the common base.
theorem polynomialTransport.hom
  shows polynomialTransport(A, C, φ, I) :
    restrictScalars(polynomialAlgebra(Algebra.ring(A), I), Algebra.base(A), Algebra.map(A)) →ₐ
    restrictScalars(polynomialAlgebra(Algebra.ring(C), I), Algebra.base(C), Algebra.map(C))
proof
  have algebraA := hom.left
  have algebraC := hom.right.left
  have bases := hom.right.right.left
  have ringA := Algebra.comm_ring with algebraA
  have ringC := Algebra.comm_ring with algebraC
  have baseA := algebraA.right.left
  have baseC := algebraC.right.left
  have mapA := algebraA.right.right.right
  have mapC := algebraC.right.right.right
  have polyA := polynomialAlgebra.algebra at Algebra.ring(A), I with ringA
  have polyC := polynomialAlgebra.algebra at Algebra.ring(C), I with ringC
  have scalarsA : Algebra.map(A) : Algebra.base(A) →+* Algebra.base(polynomialAlgebra(Algebra.ring(A), I))
    rw polynomialAlgebra.base
    exact mapA
  have scalarsC : Algebra.map(C) : Algebra.base(C) →+* Algebra.base(polynomialAlgebra(Algebra.ring(C), I))
    rw polynomialAlgebra.base
    exact mapC
  have sourceAlgebra := restrictScalars.algebra with polyA, baseA, scalarsA
  have targetAlgebra := restrictScalars.algebra with polyC, baseC, scalarsC
  have ringHom := polynomialTransport.ring_hom at A, C, φ, I with hom
  have carrierA : algebraCarrier(polynomialAlgebra(Algebra.ring(A), I)) =
      Ring.carrier(polynomialRing(Algebra.ring(A), I))
    unfold algebraCarrier
    rw polynomialAlgebra.ring
    rfl
  have carrierC : algebraCarrier(polynomialAlgebra(Algebra.ring(C), I)) =
      Ring.carrier(polynomialRing(Algebra.ring(C), I))
    unfold algebraCarrier
    rw polynomialAlgebra.ring
    rfl
  unfold AlgebraHom
  refine ⟨sourceAlgebra, targetAlgebra, ?_, ?_, ?_⟩
  . rw [restrictScalars.base, restrictScalars.base]
    exact bases
  . rw [restrictScalars.ring, restrictScalars.ring, polynomialAlgebra.ring,
      polynomialAlgebra.ring]
    exact ringHom
  . intros a ha
    rw restrictScalars.base at ha
    have haC : a ∈ Ring.carrier(Algebra.base(C))
      rw ← bases
      exact ha
    rw [restrictScalars.map, restrictScalars.map, polynomialAlgebra.map,
      polynomialAlgebra.map, polynomialAlgebra.base, polynomialAlgebra.base,
      carrierA, carrierC]
    have mapAFunction := mapA.right.right.left
    have mapCFunction := mapC.right.right.left
    have constantsA := polynomialConstant.hom at Algebra.ring(A), I with ringA
    have constantsC := polynomialConstant.hom at Algebra.ring(C), I with ringC
    have constAFunction := constantsA.right.right.left
    have constCFunction := constantsC.right.right.left
    have stepA := compose.apply with mapAFunction, constAFunction, ha
    have stepC := compose.apply with mapCFunction, constCFunction, haC
    have imageIn := FunctionBetween.apply_closed with mapAFunction, ha
    have mapped := polynomialTransport.map_constant at A, C, φ, I, Algebra.map(A)(a)
      with hom, imageIn
    have agree := AlgebraHom.map_base with hom, ha
    cc

end TransportHom

-- Transports along inverse homomorphisms are inverse on the polynomials.
theorem polynomialTransport.inverse (A C φ ψ I : Set)
  requires forward : φ : A →ₐ C
  requires backward : ψ : C →ₐ A
  requires cancel : ∀ a ∈ Ring.carrier(Algebra.ring(A)), ψ(φ(a)) = a
  shows ∀ p ∈ Ring.carrier(polynomialRing(Algebra.ring(A), I)),
    polynomialTransport(C, A, ψ, I)(polynomialTransport(A, C, φ, I)(p)) = p
proof
  have algebraA := forward.left
  have ringA := Algebra.comm_ring with algebraA
  have polyA := polynomialRing.comm_ring at Algebra.ring(A), I with ringA
  have first := polynomialTransport.ring_hom at A, C, φ, I with forward
  have second := polynomialTransport.ring_hom at C, A, ψ, I with backward
  have composite := RingHom.comp with polyA, first, second
  have identityHom := RingHom.id with polyA
  have firstFunction := first.right.right.left
  have secondFunction := second.right.right.left
  have phiFunction := (AlgebraHom.ring_hom with forward).right.right.left
  have constants : ∀ a ∈ Ring.carrier(Algebra.ring(A)),
      compose(polynomialTransport(C, A, ψ, I), polynomialTransport(A, C, φ, I),
        Ring.carrier(polynomialRing(Algebra.ring(A), I)),
        Ring.carrier(polynomialRing(Algebra.ring(C), I)),
        Ring.carrier(polynomialRing(Algebra.ring(A), I)))(polynomialConstant(Algebra.ring(A), I)(a)) =
      identity(Ring.carrier(polynomialRing(Algebra.ring(A), I)))(polynomialConstant(Algebra.ring(A), I)(a))
    intros a ha
    have constIn := polynomialConstant.mem at Algebra.ring(A), I, a with ringA
    have step := compose.apply with firstFunction, secondFunction, constIn
    have mappedA := polynomialTransport.map_constant at A, C, φ, I, a with forward, ha
    have imageIn := FunctionBetween.apply_closed with phiFunction, ha
    have mappedC := polynomialTransport.map_constant at C, A, ψ, I, φ(a)
      with backward, imageIn
    have back := cancel with a, ha
    have fixed := identity.apply with constIn
    cc
  have variables : ∀ j ∈ I,
      compose(polynomialTransport(C, A, ψ, I), polynomialTransport(A, C, φ, I),
        Ring.carrier(polynomialRing(Algebra.ring(A), I)),
        Ring.carrier(polynomialRing(Algebra.ring(C), I)),
        Ring.carrier(polynomialRing(Algebra.ring(A), I)))(X(Algebra.ring(A), I, j)) =
      identity(Ring.carrier(polynomialRing(Algebra.ring(A), I)))(X(Algebra.ring(A), I, j))
    intros j hj
    have xIn := X.mem at Algebra.ring(A), I, j with ringA
    have step := compose.apply with firstFunction, secondFunction, xIn
    have mappedA := polynomialTransport.map_X with forward, hj
    have mappedC := polynomialTransport.map_X with backward, hj
    have fixed := identity.apply with xIn
    cc
  have equal := polynomialRing.hom_ext with ringA, composite, identityHom,
    constants, variables
  intros p hp
  have step := compose.apply with firstFunction, secondFunction, hp
  have fixed := identity.apply with hp
  rw equal at step
  cc

section Transport
variable (A C φ I : Set)
hypothesis iso : φ : A ≃ₐ C

-- An isomorphism of algebras over K carries polynomial algebras over their
-- rings to each other, as algebras over K.
theorem polynomialAlgebra.map_iso
  shows ∃ e, (e : restrictScalars(polynomialAlgebra(Algebra.ring(A), I), Algebra.base(A), Algebra.map(A)) ≃ₐ
      restrictScalars(polynomialAlgebra(Algebra.ring(C), I), Algebra.base(C), Algebra.map(C))) ∧
    (∀ a ∈ algebraCarrier(A),
      e(polynomialConstant(Algebra.ring(A), I)(a)) = polynomialConstant(Algebra.ring(C), I)(φ(a))) ∧
    (∀ j ∈ I, e(X(Algebra.ring(A), I, j)) = X(Algebra.ring(C), I, j))
proof
  have forward := iso.left
  have bijection := iso.right
  unfold algebraCarrier at bijection
  have inverseIso := AlgebraIso.inverse with iso
  have backward := inverseIso.left
  unfold algebraCarrier at backward
  have leftCancel : ∀ a ∈ Ring.carrier(Algebra.ring(A)),
      converse(φ, Ring.carrier(Algebra.ring(A)), Ring.carrier(Algebra.ring(C)))(φ(a)) = a
    intros a ha
    exact Bijective.inverse_apply with bijection, ha
  have rightCancel : ∀ c ∈ Ring.carrier(Algebra.ring(C)),
      φ(converse(φ, Ring.carrier(Algebra.ring(A)), Ring.carrier(Algebra.ring(C)))(c)) = c
    intros c hc
    exact Bijective.apply_inverse with bijection, hc
  have forwardHom := polynomialTransport.hom at A, C, φ, I with forward
  have backwardHom := polynomialTransport.hom at C, A,
    converse(φ, Ring.carrier(Algebra.ring(A)), Ring.carrier(Algebra.ring(C))), I
    with backward
  have leftInverse := polynomialTransport.inverse at A, C, φ,
    converse(φ, Ring.carrier(Algebra.ring(A)), Ring.carrier(Algebra.ring(C))), I
    with forward, backward, leftCancel
  have rightInverse := polynomialTransport.inverse at C, A,
    converse(φ, Ring.carrier(Algebra.ring(A)), Ring.carrier(Algebra.ring(C))), φ, I
    with backward, forward, rightCancel
  have carrierA : algebraCarrier(restrictScalars(polynomialAlgebra(Algebra.ring(A), I),
      Algebra.base(A), Algebra.map(A))) = Ring.carrier(polynomialRing(Algebra.ring(A), I))
    unfold algebraCarrier
    rw [restrictScalars.ring, polynomialAlgebra.ring]
    rfl
  have carrierC : algebraCarrier(restrictScalars(polynomialAlgebra(Algebra.ring(C), I),
      Algebra.base(C), Algebra.map(C))) = Ring.carrier(polynomialRing(Algebra.ring(C), I))
    unfold algebraCarrier
    rw [restrictScalars.ring, polynomialAlgebra.ring]
    rfl
  have left : ∀ x ∈ algebraCarrier(restrictScalars(polynomialAlgebra(Algebra.ring(A), I),
      Algebra.base(A), Algebra.map(A))),
      polynomialTransport(C, A, converse(φ, Ring.carrier(Algebra.ring(A)),
        Ring.carrier(Algebra.ring(C))), I)(polynomialTransport(A, C, φ, I)(x)) = x
    intros x hx
    rw carrierA at hx
    exact leftInverse with x, hx
  have right : ∀ y ∈ algebraCarrier(restrictScalars(polynomialAlgebra(Algebra.ring(C), I),
      Algebra.base(C), Algebra.map(C))),
      polynomialTransport(A, C, φ, I)(polynomialTransport(C, A, converse(φ,
        Ring.carrier(Algebra.ring(A)), Ring.carrier(Algebra.ring(C))), I)(y)) = y
    intros y hy
    rw carrierC at hy
    exact rightInverse with y, hy
  have transportIso := AlgebraIso.of_inverse with forwardHom, backwardHom, left, right
  have constants : ∀ a ∈ algebraCarrier(A),
      polynomialTransport(A, C, φ, I)(polynomialConstant(Algebra.ring(A), I)(a)) =
        polynomialConstant(Algebra.ring(C), I)(φ(a))
    intros a ha
    unfold algebraCarrier at ha
    exact polynomialTransport.map_constant at A, C, φ, I, a with forward, ha
  have variables : ∀ j ∈ I,
      polynomialTransport(A, C, φ, I)(X(Algebra.ring(A), I, j)) = X(Algebra.ring(C), I, j)
    intros j hj
    exact polynomialTransport.map_X with forward, hj
  witness polynomialTransport(A, C, φ, I)
  exact ⟨transportIso, constants, variables⟩

end Transport
