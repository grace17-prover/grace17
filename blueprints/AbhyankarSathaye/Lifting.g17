-- The lifting lemma: over a commutative ring B with elements h, x, y, s
-- satisfying the cusp relation x² + y³ = hs and Bézout coefficients
-- αh + βy = 1, the algebra B[U, V, W] ⧸ (U³ + hV − x, −U² + hW − y,
-- S(h, U, V, W) − s) is a polynomial algebra in one variable T over B, by
-- T = αU + β(V + UW) and the inverse formulas.
-- Part of the Abhyankar–Sathaye blueprint. Planned home: AlgebraicGeometry/Coordinates/Lifting.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module AbhyankarSathaye.Lifting
import LiftingIdentities
import QuotientAlgebras
import PolynomialAlgebras
import FiniteMaps

section Relations
variable (B : Set)
hypothesis polynomials : CommRing(polynomialRing(B, 3))

-- The three relations in B[U, V, W], with U, V, W the variables 0, 1, 2.
def relX (h x : Set) : Set :=
  X(B, 3, 0)^3 + polynomialConstant(B, 3)(h)*X(B, 3, 1) - polynomialConstant(B, 3)(x)

def relY (h y : Set) : Set :=
  -X(B, 3, 0)^2 + polynomialConstant(B, 3)(h)*X(B, 3, 2) - polynomialConstant(B, 3)(y)

def relS (h s : Set) : Set :=
  cuspS(polynomialRing(B, 3), polynomialConstant(B, 3)(h), X(B, 3, 0), X(B, 3, 1),
    X(B, 3, 2)) - polynomialConstant(B, 3)(s)

end Relations

def liftingRelations (B h x y s : Set) : Set :=
  {relX(B, h, x), relY(B, h, y), relS(B, h, s)}

def liftingIdeal (B h x y s : Set) : Set :=
  generatedIdeal(polynomialRing(B, 3), liftingRelations(B, h, x, y, s))

-- The presented algebra Q = B[U, V, W] ⧸ (relX, relY, relS).
def liftingAlgebra (B h x y s : Set) : Set :=
  quotientAlgebra(polynomialAlgebra(B, 3), liftingIdeal(B, h, x, y, s))

-- The classes of U, V, W in the presented algebra.
def liftingVariable (B h x y s i : Set) : Set :=
  algebraProjection(polynomialAlgebra(B, 3), liftingIdeal(B, h, x, y, s))(X(B, 3, i))

-- The values of U, V, W in B[T] given by the inverse formulas, with T the
-- variable 0 of B[1].
def polyU (B h x β : Set) : Set :=
  inverseU(polynomialRing(B, 1), polynomialConstant(B, 1)(h), polynomialConstant(B, 1)(x),
    polynomialConstant(B, 1)(β), X(B, 1, 0))

def polyG (B x y α : Set) : Set :=
  inverseG(polynomialRing(B, 1), polynomialConstant(B, 1)(x), polynomialConstant(B, 1)(y),
    polynomialConstant(B, 1)(α), X(B, 1, 0))

def polyW (B h x y s α β : Set) : Set :=
  inverseW(polynomialRing(B, 1), polynomialConstant(B, 1)(h), polynomialConstant(B, 1)(y),
    polynomialConstant(B, 1)(s), polynomialConstant(B, 1)(α), polynomialConstant(B, 1)(β),
    polyU(B, h, x, β), polyG(B, x, y, α))

def polyV (B h x y s α β : Set) : Set :=
  inverseV(polynomialRing(B, 1), polyU(B, h, x, β), polyG(B, x, y, α),
    polyW(B, h, x, y, s, α, β))

def liftingValues (B h x y s α β : Set) : Set :=
  tripleMap(Ring.carrier(polynomialRing(B, 1)), polyU(B, h, x, β),
    polyV(B, h, x, y, s, α, β), polyW(B, h, x, y, s, α, β))

-- Forward: Q → B[T], the evaluation at the inverse formulas, lifted.
def liftingForward (B h x y s α β : Set) : Set :=
  algebraLift(evaluationHom(B, polynomialRing(B, 1), 3, polynomialConstant(B, 1),
      liftingValues(B, h, x, y, s, α, β)),
    polynomialAlgebra(B, 3), polynomialAlgebra(B, 1), liftingIdeal(B, h, x, y, s))

-- The parameter T = αU + β(V + UW) in Q.
def liftingParameter (B h x y s α β : Set) : Set :=
  parameter(Algebra.ring(liftingAlgebra(B, h, x, y, s)),
    Algebra.map(liftingAlgebra(B, h, x, y, s))(α),
    Algebra.map(liftingAlgebra(B, h, x, y, s))(β),
    liftingVariable(B, h, x, y, s, 0), liftingVariable(B, h, x, y, s, 1),
    liftingVariable(B, h, x, y, s, 2))

-- Backward: B[T] → Q, the evaluation at the parameter.
def liftingBackward (B h x y s α β : Set) : Set :=
  evaluationHom(B, Algebra.ring(liftingAlgebra(B, h, x, y, s)), 1,
    Algebra.map(liftingAlgebra(B, h, x, y, s)),
    pointMap(algebraCarrier(liftingAlgebra(B, h, x, y, s)),
      liftingParameter(B, h, x, y, s, α, β)))

section Members
variable (B h x y s : Set)
hypothesis base : CommRing(B)
hypothesis hIn : h ∈ Ring.carrier(B)
hypothesis xIn : x ∈ Ring.carrier(B)
hypothesis yIn : y ∈ Ring.carrier(B)
hypothesis sIn : s ∈ Ring.carrier(B)

theorem liftingAlgebra.algebra
  shows Algebra(liftingAlgebra(B, h, x, y, s))
proof
  sorry

theorem liftingVariable.mem (i : Set)
  requires index : i ∈ 3
  shows liftingVariable(B, h, x, y, s, i) ∈
    Ring.carrier(Algebra.ring(liftingAlgebra(B, h, x, y, s)))
proof
  sorry

instance liftingU.mem
  shows liftingVariable(B, h, x, y, s, 0) ∈
    Ring.carrier(Algebra.ring(liftingAlgebra(B, h, x, y, s)))
proof
  sorry

instance liftingV.mem
  shows liftingVariable(B, h, x, y, s, 1) ∈
    Ring.carrier(Algebra.ring(liftingAlgebra(B, h, x, y, s)))
proof
  sorry

instance liftingW.mem
  shows liftingVariable(B, h, x, y, s, 2) ∈
    Ring.carrier(Algebra.ring(liftingAlgebra(B, h, x, y, s)))
proof
  sorry

instance liftingConstant.mem (a : Set)
  requires member : a ∈ Ring.carrier(B)
  shows Algebra.map(liftingAlgebra(B, h, x, y, s))(a) ∈
    Ring.carrier(Algebra.ring(liftingAlgebra(B, h, x, y, s)))
proof
  sorry

instance liftingAlgebra.comm_ring
  shows CommRing(Algebra.ring(liftingAlgebra(B, h, x, y, s)))
proof
  sorry

end Members

section Lifting
variable (B h x y s α β : Set)
hypothesis base : CommRing(B)
hypothesis hIn : h ∈ Ring.carrier(B)
hypothesis xIn : x ∈ Ring.carrier(B)
hypothesis yIn : y ∈ Ring.carrier(B)
hypothesis sIn : s ∈ Ring.carrier(B)
hypothesis αIn : α ∈ Ring.carrier(B)
hypothesis βIn : β ∈ Ring.carrier(B)
hypothesis cusp : x^2 + y^3 = h*s
hypothesis bezout : α*h + β*y = B[1]
hypothesis quotient : CommRing(Algebra.ring(liftingAlgebra(B, h, x, y, s)))

-- The relations hold between the classes of U, V, W.
theorem liftingAlgebra.relations
  shows liftingVariable(B, h, x, y, s, 0)^3 +
      Algebra.map(liftingAlgebra(B, h, x, y, s))(h) * liftingVariable(B, h, x, y, s, 1) =
      Algebra.map(liftingAlgebra(B, h, x, y, s))(x) ∧
    -liftingVariable(B, h, x, y, s, 0)^2 +
      Algebra.map(liftingAlgebra(B, h, x, y, s))(h) * liftingVariable(B, h, x, y, s, 2) =
      Algebra.map(liftingAlgebra(B, h, x, y, s))(y) ∧
    cuspS(Algebra.ring(liftingAlgebra(B, h, x, y, s)),
      Algebra.map(liftingAlgebra(B, h, x, y, s))(h), liftingVariable(B, h, x, y, s, 0),
      liftingVariable(B, h, x, y, s, 1), liftingVariable(B, h, x, y, s, 2)) =
      Algebra.map(liftingAlgebra(B, h, x, y, s))(s)
proof
  sorry

-- The inverse formulas satisfy the relations in B[T].
theorem liftingValues.relations
  shows evaluationHom(B, polynomialRing(B, 1), 3, polynomialConstant(B, 1),
      liftingValues(B, h, x, y, s, α, β))(relX(B, h, x)) = Ring.zero(polynomialRing(B, 1)) ∧
    evaluationHom(B, polynomialRing(B, 1), 3, polynomialConstant(B, 1),
      liftingValues(B, h, x, y, s, α, β))(relY(B, h, y)) = Ring.zero(polynomialRing(B, 1)) ∧
    evaluationHom(B, polynomialRing(B, 1), 3, polynomialConstant(B, 1),
      liftingValues(B, h, x, y, s, α, β))(relS(B, h, s)) = Ring.zero(polynomialRing(B, 1))
proof
  sorry

theorem liftingForward.hom
  shows liftingForward(B, h, x, y, s, α, β) :
    liftingAlgebra(B, h, x, y, s) →ₐ polynomialAlgebra(B, 1)
proof
  sorry

theorem liftingForward.variable (i : Set)
  requires index : i ∈ 3
  shows liftingForward(B, h, x, y, s, α, β)(liftingVariable(B, h, x, y, s, i)) =
    liftingValues(B, h, x, y, s, α, β)(i)
proof
  sorry

theorem liftingBackward.hom
  shows liftingBackward(B, h, x, y, s, α, β) :
    polynomialAlgebra(B, 1) →ₐ liftingAlgebra(B, h, x, y, s)
proof
  sorry

theorem liftingBackward.variable
  shows liftingBackward(B, h, x, y, s, α, β)(X(B, 1, 0)) =
    liftingParameter(B, h, x, y, s, α, β)
proof
  sorry

-- Forward after backward is the identity of B[T]: T goes to the parameter
-- and back to T by inverse_parameter.
theorem liftingForward.after_backward (p : Set)
  requires member : p ∈ Ring.carrier(polynomialRing(B, 1))
  shows liftingForward(B, h, x, y, s, α, β)(liftingBackward(B, h, x, y, s, α, β)(p)) = p
proof
  sorry

-- Backward after forward is the identity of Q: the classes of U, V, W are
-- recovered from the parameter by original_reconstruction.
theorem liftingBackward.after_forward (q : Set)
  requires member : q ∈ algebraCarrier(liftingAlgebra(B, h, x, y, s))
  shows liftingBackward(B, h, x, y, s, α, β)(liftingForward(B, h, x, y, s, α, β)(q)) = q
proof
  sorry

theorem lifting_equivalence
  shows liftingForward(B, h, x, y, s, α, β) :
    liftingAlgebra(B, h, x, y, s) ≃ₐ polynomialAlgebra(B, 1)
proof
  sorry

end Lifting
