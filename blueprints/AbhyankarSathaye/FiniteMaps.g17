-- Functions on two and four points: the function on 2 with two given
-- values and the function on 4 with four, as graphs, with their values
-- read off, and the four cases of membership in 4.
-- Part of the Abhyankar–Sathaye blueprint. Planned home: Set/Function/Quadruples.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module AbhyankarSathaye.FiniteMaps
import Grace.Cumulus.Set.Function.Triples
import Grace.Cumulus.Nat.Foundation

theorem membership.four (x : Set)
  shows x ∈ 4 ↔ (x = 0 ∨ x = 1 ∨ x = 2 ∨ x = 3)
proof
  have split := membership.successor_set{n := 3} at x
  have three := membership.three at x
  tauto

-- The function on 2 with the values a, b in S.
def pairMap (S a b : Set) : Set :=
  { p ∈ 2 × S | (fst(p) = 0 ∧ snd(p) = a) ∨ (fst(p) = 1 ∧ snd(p) = b) }

-- The function on 4 with the values a, b, c, d in S.
def quadrupleMap (S a b c d : Set) : Set :=
  { p ∈ 4 × S | (fst(p) = 0 ∧ snd(p) = a) ∨ (fst(p) = 1 ∧ snd(p) = b) ∨
    (fst(p) = 2 ∧ snd(p) = c) ∨ (fst(p) = 3 ∧ snd(p) = d) }

section Pairs
variable (S a b : Set)
hypothesis first : a ∈ S
hypothesis second : b ∈ S

theorem pairMap.function
  shows pairMap(S, a, b) : 2 → S
proof
  sorry

theorem pairMap.zero
  shows pairMap(S, a, b)(0) = a
proof
  sorry

theorem pairMap.one
  shows pairMap(S, a, b)(1) = b
proof
  sorry

end Pairs

section Quadruples
variable (S a b c d : Set)
hypothesis first : a ∈ S
hypothesis second : b ∈ S
hypothesis third : c ∈ S
hypothesis fourth : d ∈ S

theorem quadrupleMap.function
  shows quadrupleMap(S, a, b, c, d) : 4 → S
proof
  sorry

theorem quadrupleMap.zero
  shows quadrupleMap(S, a, b, c, d)(0) = a
proof
  sorry

theorem quadrupleMap.one
  shows quadrupleMap(S, a, b, c, d)(1) = b
proof
  sorry

theorem quadrupleMap.two
  shows quadrupleMap(S, a, b, c, d)(2) = c
proof
  sorry

theorem quadrupleMap.three
  shows quadrupleMap(S, a, b, c, d)(3) = d
proof
  sorry

end Quadruples

-- The function on 1 with the value a in S.
def pointMap (S a : Set) : Set := { p ∈ 1 × S | snd(p) = a }

theorem pointMap.function (S a : Set)
  requires member : a ∈ S
  shows pointMap(S, a) : 1 → S
proof
  sorry

theorem pointMap.zero (S a : Set)
  requires member : a ∈ S
  shows pointMap(S, a)(0) = a
proof
  sorry
