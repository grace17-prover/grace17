-- The ambient ring ℂ[h, u, v, w] and the explicit polynomial F: with
-- x = u³ + hv, y = −u² + hw, s = S(h, u, v, w), and p = P(x, y, s), the
-- polynomial is F = h − p − 1, and the shifted cusp satisfies
-- (x + s³)² + (y − s²)³ = s(1 + F).
-- Part of the Abhyankar–Sathaye blueprint. Planned home: AlgebraicGeometry/Coordinates/Ambient.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module AbhyankarSathaye.Ambient
import Identities
import PolynomialAlgebras
import Grace.Cumulus.Complex.Field

-- The ambient algebra ℂ[4], with h, u, v, w the variables 0, 1, 2, 3.
def ambientAlgebra : Set := polynomialAlgebra(complexRing, 4)

section Ambient
hypothesis complexes : CommRing(complexRing)
hypothesis ambient : CommRing(polynomialRing(complexRing, 4))

def ambientX : Set := X(complexRing, 4, 1)^3 + X(complexRing, 4, 0)*X(complexRing, 4, 2)

instance ambientX.mem
  shows ambientX ∈ Ring.carrier(polynomialRing(complexRing, 4))
proof
  unfold ambientX
  typecheck

def ambientY : Set := -X(complexRing, 4, 1)^2 + X(complexRing, 4, 0)*X(complexRing, 4, 3)

instance ambientY.mem
  shows ambientY ∈ Ring.carrier(polynomialRing(complexRing, 4))
proof
  unfold ambientY
  typecheck

def ambientS : Set :=
  cuspS(polynomialRing(complexRing, 4), X(complexRing, 4, 0), X(complexRing, 4, 1),
    X(complexRing, 4, 2), X(complexRing, 4, 3))

instance ambientS.mem
  shows ambientS ∈ Ring.carrier(polynomialRing(complexRing, 4))
proof
  unfold ambientS
  typecheck

def ambientP : Set := shiftP(polynomialRing(complexRing, 4), ambientX, ambientY, ambientS)

instance ambientP.mem
  shows ambientP ∈ Ring.carrier(polynomialRing(complexRing, 4))
proof
  unfold ambientP
  typecheck

-- The explicit polynomial F = h − P(x, y, s) − 1.
def ambientF : Set :=
  X(complexRing, 4, 0) - ambientP - Ring.one(polynomialRing(complexRing, 4))

instance ambientF.mem
  shows ambientF ∈ Ring.carrier(polynomialRing(complexRing, 4))
proof
  unfold ambientF
  typecheck

def shiftX : Set := ambientX + ambientS^3

instance shiftX.mem
  shows shiftX ∈ Ring.carrier(polynomialRing(complexRing, 4))
proof
  unfold shiftX
  typecheck

def shiftY : Set := ambientY - ambientS^2

instance shiftY.mem
  shows shiftY ∈ Ring.carrier(polynomialRing(complexRing, 4))
proof
  unfold shiftY
  typecheck

theorem ambient.cusp
  shows ambientX^2 + ambientY^3 = X(complexRing, 4, 0) * ambientS
proof
  unfold ambientX
  unfold ambientY
  unfold ambientS
  exact cusp_universal with *

theorem ambient.shift
  shows shiftX^2 + shiftY^3 = ambientX^2 + ambientY^3 - ambientS * ambientP
proof
  unfold shiftX
  unfold shiftY
  unfold ambientP
  exact shift_universal with *

-- The identity that makes the critical point: the shifted cusp is s(1 + F).
theorem ambient.identity
  shows shiftX^2 + shiftY^3 = ambientS * (Ring.one(polynomialRing(complexRing, 4)) + ambientF)
proof
  have shift := ambient.shift with *
  have cusp := ambient.cusp with *
  unfold ambientF
  linear_combination shift + cusp

end Ambient
