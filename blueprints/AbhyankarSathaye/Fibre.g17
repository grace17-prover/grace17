module AbhyankarSathaye.Fibre
import Elimination

-- The base algebra over ℂ is a polynomial algebra, and its ring carries
-- the cusp relation and the Bézout certificate among h, x, y, s.
theorem baseAlgebra.equivalence
  shows planeForward(complexRing) : baseAlgebra ≃ₐ polynomialAlgebra(complexRing, 2)
proof
  sorry

-- L over B is B[T], as algebras over ℂ.
theorem lifted_equivalence
  shows ∃ e, e : liftedAlgebra ≃ₐ
    restrictScalars(polynomialAlgebra(baseRing, 1), complexRing, Algebra.map(baseAlgebra))
proof
  sorry

-- B[T] is ℂ[2][T], as algebras over ℂ.
theorem plane_extension_equivalence
  shows ∃ e, e : restrictScalars(polynomialAlgebra(baseRing, 1), complexRing, Algebra.map(baseAlgebra)) ≃ₐ
    iteratedPolynomialAlgebra(complexRing, 2, 1)
proof
  sorry

theorem flatten_three
  shows ∃ e, e : iteratedPolynomialAlgebra(complexRing, 2, 1) ≃ₐ polynomialAlgebra(complexRing, 3)
proof
  sorry

theorem fibre_equivalence
  shows ∃ e, e : fibreAlgebra ≃ₐ polynomialAlgebra(complexRing, 3)
proof
  sorry
