-- The fibre is affine three-space: D = ℂ[h, u, v, w] ⧸ (F) is isomorphic
-- to ℂ[3] as a ℂ-algebra, by elimination to L, the lifting lemma over B,
-- the plane presentation B ≅ ℂ[2] applied to coefficients, and the
-- flattening ℂ[2][1] ≅ ℂ[3].
-- Part of the Abhyankar–Sathaye blueprint. Planned home: AlgebraicGeometry/Coordinates/Fibre.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module AbhyankarSathaye.Fibre
import Elimination

-- The base ring is a commutative ring, and the base algebra is over ℂ.
theorem baseRing.comm_ring
  shows CommRing(baseRing)
proof
  have complexes := complexRing.comm_ring
  unfold baseRing
  unfold baseAlgebra
  exact planeAlgebra.comm_ring at complexRing with complexes

theorem baseAlgebra.base
  shows Algebra.base(baseAlgebra) = complexRing
proof
  unfold baseAlgebra
  unfold planeAlgebra
  rw quotientAlgebra.baseOf
  exact polynomialAlgebra.base at complexRing, 4

-- The structure map of the base algebra, as a ring homomorphism from ℂ.
theorem baseAlgebra.scalars
  shows Algebra.map(baseAlgebra) : complexRing →+* baseRing
proof
  have algebra := baseAlgebra.algebra
  obtain ⟨shape, baseRing, ringRing, structureMap⟩ := algebra
  rw baseAlgebra.base at structureMap
  unfold baseRing
  exact structureMap

-- The base algebra over ℂ is a polynomial algebra, and its ring carries
-- the cusp relation and the Bézout certificate among h, x, y, s.
theorem baseAlgebra.equivalence
  shows planeForward(complexRing) : baseAlgebra ≃ₐ polynomialAlgebra(complexRing, 2)
proof
  have complexes := complexRing.comm_ring
  have quotient := planeAlgebra.comm_ring at complexRing with complexes
  have plane := polynomialRing.comm_ring at complexRing, 2 with complexes
  unfold baseAlgebra
  exact plane_equivalence at complexRing with complexes, quotient, plane

section Base
hypothesis complexes : CommRing(complexRing)
hypothesis base : CommRing(baseRing)

instance baseH.mem
  shows baseH ∈ Ring.carrier(baseRing)
proof
  unfold baseH
  unfold baseRing
  unfold baseAlgebra
  exact planeH.class_mem at complexRing with complexes

instance baseX.mem
  shows baseX ∈ Ring.carrier(baseRing)
proof
  unfold baseX
  unfold baseRing
  unfold baseAlgebra
  exact planeX.class_mem at complexRing with complexes

instance baseY.mem
  shows baseY ∈ Ring.carrier(baseRing)
proof
  unfold baseY
  unfold baseRing
  unfold baseAlgebra
  exact planeY.class_mem at complexRing with complexes

instance baseS.mem
  shows baseS ∈ Ring.carrier(baseRing)
proof
  unfold baseS
  unfold baseRing
  unfold baseAlgebra
  exact planeS.class_mem at complexRing with complexes

-- The cusp relation and the Bézout certificate among the base classes.
theorem baseRing.cusp
  shows baseX^2 + baseY^3 = baseH * baseS
proof
  have quotient := planeAlgebra.comm_ring at complexRing with complexes
  have plane := polynomialRing.comm_ring at complexRing, 2 with complexes
  unfold baseX
  unfold baseY
  unfold baseH
  unfold baseS
  unfold baseRing
  unfold baseAlgebra
  exact planeAlgebra.relation_cusp at complexRing with complexes, quotient, plane

theorem baseRing.bezout
  shows bezoutAlpha(baseRing, baseX, baseS) * baseH +
    bezoutBeta(baseRing, baseX, baseY, baseS) * baseY = Ring.one(baseRing)
proof
  have quotient := planeAlgebra.comm_ring at complexRing with complexes
  have plane := polynomialRing.comm_ring at complexRing, 2 with complexes
  unfold baseX
  unfold baseY
  unfold baseH
  unfold baseS
  unfold baseRing
  unfold baseAlgebra
  exact planeAlgebra.bezout at complexRing with complexes, quotient, plane

-- The lifting lemma over the base ring, with the Bézout coefficients.
theorem baseRing.lifting
  shows liftingForward(baseRing, baseH, baseX, baseY, baseS,
      bezoutAlpha(baseRing, baseX, baseS), bezoutBeta(baseRing, baseX, baseY, baseS)) :
    liftingAlgebra(baseRing, baseH, baseX, baseY, baseS) ≃ₐ polynomialAlgebra(baseRing, 1)
proof
  have hIn := baseH.mem with *
  have xIn := baseX.mem with *
  have yIn := baseY.mem with *
  have sIn := baseS.mem with *
  have αIn := bezoutAlpha.mem at baseRing, baseX, baseS with *
  have βIn := bezoutBeta.mem at baseRing, baseX, baseY, baseS with *
  have cusp := baseRing.cusp with *
  have bezout := baseRing.bezout with *
  have quotient := liftingAlgebra.comm_ring at baseRing, baseH, baseX, baseY, baseS with *
  exact lifting_equivalence at baseRing, baseH, baseX, baseY, baseS,
    bezoutAlpha(baseRing, baseX, baseS), bezoutBeta(baseRing, baseX, baseY, baseS) with *

end Base

-- The base of the lifting algebra is the base ring.
theorem liftingAlgebra.base_of
  shows Algebra.base(liftingAlgebra(baseRing, baseH, baseX, baseY, baseS)) = baseRing
proof
  unfold liftingAlgebra
  rw quotientAlgebra.baseOf
  exact polynomialAlgebra.base at baseRing, 3

-- L over B is B[T], as algebras over ℂ.
theorem lifted_equivalence
  shows ∃ e, e : liftedAlgebra ≃ₐ
    restrictScalars(polynomialAlgebra(baseRing, 1), complexRing, Algebra.map(baseAlgebra))
proof
  have complexes := complexRing.comm_ring
  have base := baseRing.comm_ring
  have lifting := baseRing.lifting with *
  have scalars := baseAlgebra.scalars
  rw ← liftingAlgebra.base_of at scalars
  have restricted := AlgebraIso.restrict with lifting, complexes, scalars
  witness liftingForward(baseRing, baseH, baseX, baseY, baseS,
    bezoutAlpha(baseRing, baseX, baseS), bezoutBeta(baseRing, baseX, baseY, baseS))
  unfold liftedAlgebra
  exact restricted

-- B[T] is ℂ[2][T], as algebras over ℂ.
theorem plane_extension_equivalence
  shows ∃ e, e : restrictScalars(polynomialAlgebra(baseRing, 1), complexRing, Algebra.map(baseAlgebra)) ≃ₐ
    iteratedPolynomialAlgebra(complexRing, 2, 1)
proof
  have iso := baseAlgebra.equivalence
  have transport := polynomialAlgebra.map_iso at baseAlgebra, polynomialAlgebra(complexRing, 2),
    planeForward(complexRing), 1 with iso
  obtain ⟨e, equivalence, constants, variables⟩ := transport
  have target : restrictScalars(polynomialAlgebra(Algebra.ring(polynomialAlgebra(complexRing, 2)), 1),
      Algebra.base(polynomialAlgebra(complexRing, 2)), Algebra.map(polynomialAlgebra(complexRing, 2))) =
      iteratedPolynomialAlgebra(complexRing, 2, 1)
    rw [polynomialAlgebra.ring, polynomialAlgebra.base, polynomialAlgebra.map]
    unfold restrictScalars
    unfold iteratedPolynomialAlgebra
    unfold algebraCarrier
    rw [polynomialAlgebra.ring, polynomialAlgebra.base, polynomialAlgebra.map]
  rw target at equivalence
  rw baseAlgebra.base at equivalence
  witness e
  unfold baseRing
  exact equivalence

theorem flatten_three
  shows ∃ e, e : iteratedPolynomialAlgebra(complexRing, 2, 1) ≃ₐ polynomialAlgebra(complexRing, 3)
proof
  have complexes := complexRing.comm_ring
  have flatten := polynomialRing.flatten at complexRing, 2, 1 with complexes
  have three : 2 + 1 = 3
    arith
  rw three at flatten
  obtain ⟨e, equivalence, inner, outer⟩ := flatten
  witness e
  exact equivalence

theorem fibre_equivalence
  shows ∃ e, e : fibreAlgebra ≃ₐ polynomialAlgebra(complexRing, 3)
proof
  have elimination := elimination_equivalence
  have back := AlgebraIso.inverse with elimination
  obtain ⟨lifted, liftedIso⟩ := lifted_equivalence
  obtain ⟨extension, extensionIso⟩ := plane_extension_equivalence
  obtain ⟨flat, flatIso⟩ := flatten_three
  have first := AlgebraIso.compose with back, liftedIso
  have second := AlgebraIso.compose with first, extensionIso
  have third := AlgebraIso.compose with second, flatIso
  witness compose(flat,
    compose(extension,
      compose(lifted, converse(toOriginal, algebraCarrier(liftedAlgebra), algebraCarrier(fibreAlgebra)),
        algebraCarrier(fibreAlgebra), algebraCarrier(liftedAlgebra),
        algebraCarrier(restrictScalars(polynomialAlgebra(baseRing, 1), complexRing,
          Algebra.map(baseAlgebra)))),
      algebraCarrier(fibreAlgebra),
      algebraCarrier(restrictScalars(polynomialAlgebra(baseRing, 1), complexRing,
        Algebra.map(baseAlgebra))),
      algebraCarrier(iteratedPolynomialAlgebra(complexRing, 2, 1))),
    algebraCarrier(fibreAlgebra), algebraCarrier(iteratedPolynomialAlgebra(complexRing, 2, 1)),
    algebraCarrier(polynomialAlgebra(complexRing, 3)))
  exact third
