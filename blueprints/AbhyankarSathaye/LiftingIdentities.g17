-- The identities behind the lifting lemma: the substitution of V = G − UW
-- into S, the compatibility of the linear presentation with the cusp, the
-- squared Bézout relation, the solution of a pair of linear equations with
-- a Bézout certificate, and the passage between the original relations
-- (x, y, s) and the linear ones (h, G, W) in both directions.
-- Part of the Abhyankar–Sathaye blueprint.
-- Planned home: AlgebraicGeometry/Coordinates/LiftingIdentities.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module AbhyankarSathaye.LiftingIdentities
import Identities
import Grace.Cumulus.Algebra.Ring

section LiftingIdentities
variable (R : Set)
hypothesis ring : CommRing(R)

-- The substitution V = G − UW in S, and the cusp in the linear variables.

theorem substitute_S (h U G W : R)
  shows cuspS(R, h, U, G - U*W, W) =
    h*G^2 - R[2]*U*(h*W - U^2)*G + (h*W - U^2)^2*W
proof
  unfold cuspS
  ring

theorem compatibility_identity (h y s U G : R)
  shows y^2*(y + U^2) - h*(s - h*G^2 + R[2]*U*y*G) =
    (h*G - y*U)^2 + y^3 - h*s
proof
  ring

theorem compatibility (h x y s U G : R)
  requires cusp : x^2 + y^3 = h*s
  requires linear : h*G - y*U = x
  shows y^2*(y + U^2) = h*(s - h*G^2 + R[2]*U*y*G)
proof
  linear_combination (h*G - y*U + x) * linear + cusp

-- Linear equations hW = a, cW = b with a Bézout certificate rh + qc = 1:
-- W = ra + qb is a solution when ca = hb, and the only one.

theorem squared_bezout (h y α β : R)
  requires bezout : α*h + β*y = R[1]
  shows α*(R[1] + β*y)*h + β^2*y^2 = R[1]
proof
  linear_combination (R[1] + β*y) * bezout

theorem solve_h (h c a b r q : R)
  requires cross : c*a = h*b
  requires bezout : r*h + q*c = R[1]
  shows h*(r*a + q*b) = a
proof
  linear_combination a * bezout - q * cross

theorem solve_c (h c a b r q : R)
  requires cross : c*a = h*b
  requires bezout : r*h + q*c = R[1]
  shows c*(r*a + q*b) = b
proof
  linear_combination b * bezout + r * cross

theorem solve_unique (h c a b r q W : R)
  requires bezout : r*h + q*c = R[1]
  requires first : h*W = a
  requires second : c*W = b
  shows W = r*a + q*b
proof
  linear_combination (-W) * bezout + r * first + q * second

-- The parameter T against U and G: U = hT − βx, G = yT + αx satisfy the
-- linear relation, T = αU + βG recovers T, and U, G are recovered from T.

theorem linear_parameter_relation (h x y α β T : R)
  requires bezout : α*h + β*y = R[1]
  shows h*(y*T + α*x) - y*(h*T - β*x) = x
proof
  linear_combination x * bezout

theorem linear_parameter_inverse (h x y α β T : R)
  requires bezout : α*h + β*y = R[1]
  shows α*(h*T - β*x) + β*(y*T + α*x) = T
proof
  linear_combination T * bezout

theorem recover_U (h x y α β U G : R)
  requires bezout : α*h + β*y = R[1]
  requires linear : h*G - y*U = x
  shows h*(α*U + β*G) - β*x = U
proof
  linear_combination U * bezout + β * linear

theorem recover_G (h x y α β U G : R)
  requires bezout : α*h + β*y = R[1]
  requires linear : h*G - y*U = x
  shows y*(α*U + β*G) + α*x = G
proof
  linear_combination G * bezout - α * linear

-- The two presentations are equivalent.

-- From the original relations to the linear ones, with G = V + UW.
theorem original_to_linear (h x y s U V W : R)
  requires relX : U^3 + h*V = x
  requires relY : -U^2 + h*W = y
  requires relS : cuspS(R, h, U, V, W) = s
  shows h*(V + U*W) - y*U = x ∧ h*W = y + U^2 ∧
    y^2*W = s - h*(V + U*W)^2 + R[2]*U*y*(V + U*W)
proof
  unfold cuspS at relS
  constructor
  . linear_combination relX + U * relY
  constructor
  . linear_combination relY
  . linear_combination relS -
      (W*(y + h*W - U^2) - R[2]*U*(V + U*W)) * relY

-- From the linear relations back to the original ones, with V = G − UW.
theorem linear_to_original (h x y s U G W : R)
  requires linear : h*G - y*U = x
  requires square : h*W = y + U^2
  requires cubic : y^2*W = s - h*G^2 + R[2]*U*y*G
  shows U^3 + h*(G - U*W) = x ∧ -U^2 + h*W = y ∧
    cuspS(R, h, U, G - U*W, W) = s
proof
  unfold cuspS
  constructor
  . linear_combination linear - U * square
  constructor
  . linear_combination square
  . linear_combination cubic + (W*(h*W - U^2 + y) - R[2]*U*G) * square

end LiftingIdentities

-- The inverse formulas: from the parameter T, the point (U, V, W) over
-- (h, x, y, s) with the Bézout coefficients α, β.
section Reconstruction
variable (R : Set)
hypothesis ring : CommRing(R)

-- The formulas.

def inverseU (h x β T : Set) : Set := h*T - β*x

def inverseG (x y α T : Set) : Set := y*T + α*x

def inverseW (h y s α β U G : Set) : Set :=
  α*(R[1] + β*y)*(y + U^2) + β^2*(s - h*G^2 + R[2]*U*y*G)

def inverseV (U G W : Set) : Set := G - U*W

def parameter (α β U V W : Set) : Set := α*U + β*(V + U*W)

-- Each is a member of R.

instance inverseU.mem (h x β T : R)
  shows inverseU(R, h, x, β, T) ∈ R
proof
  unfold inverseU
  typecheck

instance inverseG.mem (x y α T : R)
  shows inverseG(R, x, y, α, T) ∈ R
proof
  unfold inverseG
  typecheck

instance inverseW.mem (h y s α β U G : R)
  shows inverseW(R, h, y, s, α, β, U, G) ∈ R
proof
  unfold inverseW
  typecheck

instance inverseV.mem (U G W : R)
  shows inverseV(R, U, G, W) ∈ R
proof
  unfold inverseV
  typecheck

instance parameter.mem (α β U V W : R)
  shows parameter(R, α, β, U, V, W) ∈ R
proof
  unfold parameter
  typecheck

-- The point given by the formulas satisfies the original relations, its
-- parameter is T, and the formulas applied to the parameter of a point
-- satisfying the relations return the point.

theorem inverse_relations (h x y s α β T : R)
  requires cusp : x^2 + y^3 = h*s
  requires bezout : α*h + β*y = R[1]
  shows inverseU(R, h, x, β, T)^3 +
      h*inverseV(R, inverseU(R, h, x, β, T), inverseG(R, x, y, α, T),
        inverseW(R, h, y, s, α, β, inverseU(R, h, x, β, T),
          inverseG(R, x, y, α, T))) = x ∧
    -inverseU(R, h, x, β, T)^2 +
      h*inverseW(R, h, y, s, α, β, inverseU(R, h, x, β, T),
        inverseG(R, x, y, α, T)) = y ∧
    cuspS(R, h, inverseU(R, h, x, β, T),
      inverseV(R, inverseU(R, h, x, β, T), inverseG(R, x, y, α, T),
        inverseW(R, h, y, s, α, β, inverseU(R, h, x, β, T),
          inverseG(R, x, y, α, T))),
      inverseW(R, h, y, s, α, β, inverseU(R, h, x, β, T),
        inverseG(R, x, y, α, T))) = s
proof
  -- U = hT − βx and G = yT + αx satisfy the linear relation; W solves the
  -- pair hW = y + U², y²W = s − hG² + 2UyG by the squared Bézout relation.
  have linear := linear_parameter_relation at R, h, x, y, α, β, T with *
  have cross := compatibility at R, h, x, y, s, h*T - β*x, y*T + α*x with *
  have squared := squared_bezout at R, h, y, α, β with *
  have square := solve_h at R, h, y^2, y + (h*T - β*x)^2,
    s - h*(y*T + α*x)^2 + R[2]*(h*T - β*x)*y*(y*T + α*x),
    α*(R[1] + β*y), β^2 with *
  have cubic := solve_c at R, h, y^2, y + (h*T - β*x)^2,
    s - h*(y*T + α*x)^2 + R[2]*(h*T - β*x)*y*(y*T + α*x),
    α*(R[1] + β*y), β^2 with *
  unfold inverseV
  unfold inverseW
  unfold inverseU
  unfold inverseG
  exact linear_to_original with linear, square, cubic

theorem inverse_parameter (h x y s α β T : R)
  requires bezout : α*h + β*y = R[1]
  shows parameter(R, α, β, inverseU(R, h, x, β, T),
    inverseV(R, inverseU(R, h, x, β, T), inverseG(R, x, y, α, T),
      inverseW(R, h, y, s, α, β, inverseU(R, h, x, β, T),
        inverseG(R, x, y, α, T))),
    inverseW(R, h, y, s, α, β, inverseU(R, h, x, β, T),
      inverseG(R, x, y, α, T))) = T
proof
  have identity := linear_parameter_inverse at R, h, x, y, α, β, T with *
  unfold parameter
  unfold inverseV
  unfold inverseU
  unfold inverseG
  linear_combination identity

theorem original_reconstruction (h x y s α β U V W : R)
  requires bezout : α*h + β*y = R[1]
  requires relX : U^3 + h*V = x
  requires relY : -U^2 + h*W = y
  requires relS : cuspS(R, h, U, V, W) = s
  shows inverseU(R, h, x, β, parameter(R, α, β, U, V, W)) = U ∧
    inverseV(R, inverseU(R, h, x, β, parameter(R, α, β, U, V, W)),
      inverseG(R, x, y, α, parameter(R, α, β, U, V, W)),
      inverseW(R, h, y, s, α, β,
        inverseU(R, h, x, β, parameter(R, α, β, U, V, W)),
        inverseG(R, x, y, α, parameter(R, α, β, U, V, W)))) = V ∧
    inverseW(R, h, y, s, α, β,
      inverseU(R, h, x, β, parameter(R, α, β, U, V, W)),
      inverseG(R, x, y, α, parameter(R, α, β, U, V, W))) = W
proof
  obtain ⟨linear, square, cubic⟩ :=
    original_to_linear at R, h, x, y, s, U, V, W with *
  have squared := squared_bezout at R, h, y, α, β with *
  have recoverU := recover_U at R, h, x, y, α, β, U, V + U*W with *
  have recoverG := recover_G at R, h, x, y, α, β, U, V + U*W with *
  have valueU : inverseU(R, h, x, β, parameter(R, α, β, U, V, W)) = U
    unfold inverseU
    unfold parameter
    exact recoverU
  have valueG : inverseG(R, x, y, α, parameter(R, α, β, U, V, W)) = V + U*W
    unfold inverseG
    unfold parameter
    exact recoverG
  have valueW : inverseW(R, h, y, s, α, β, U, V + U*W) = W
    unfold inverseW
    symm
    exact solve_unique at R, h, y^2, y + U^2,
      s - h*(V + U*W)^2 + R[2]*U*y*(V + U*W), α*(R[1] + β*y), β^2, W with *
  rw valueU
  rw valueG
  rw valueW
  constructor
  . rfl
  constructor
  . unfold inverseV
    ring
  . rfl

end Reconstruction

-- Ring homomorphisms carry the inverse formulas and the parameter along.
section Transport
variable (R S f : Set)
hypothesis source : CommRing(R)
hypothesis target : CommRing(S)
hypothesis hom : f : R →+* S

theorem inverseU.map (h x β T : R)
  shows f(inverseU(R, h, x, β, T)) = inverseU(S, f(h), f(x), f(β), f(T))
proof
  unfold inverseU
  simp [RingHom.map_sub, RingHom.map_mul]

theorem inverseG.map (x y α T : R)
  shows f(inverseG(R, x, y, α, T)) = inverseG(S, f(x), f(y), f(α), f(T))
proof
  unfold inverseG
  simp [RingHom.map_add, RingHom.map_mul]

theorem inverseW.map (h y s α β U G : R)
  shows f(inverseW(R, h, y, s, α, β, U, G)) =
    inverseW(S, f(h), f(y), f(s), f(α), f(β), f(U), f(G))
proof
  have two := RingHom.map_two with *
  have one := RingHom.map_one with hom
  unfold inverseW
  simp [RingHom.map_add, RingHom.map_mul, RingHom.map_sub, RingHom.map_pow,
    two, one]

theorem inverseV.map (U G W : R)
  shows f(inverseV(R, U, G, W)) = inverseV(S, f(U), f(G), f(W))
proof
  unfold inverseV
  simp [RingHom.map_sub, RingHom.map_mul]

theorem parameter.map (α β U V W : R)
  shows f(parameter(R, α, β, U, V, W)) =
    parameter(S, f(α), f(β), f(U), f(V), f(W))
proof
  unfold parameter
  simp [RingHom.map_add, RingHom.map_mul]

end Transport
