-- Elimination: the fibre algebra D = ℂ[h, u, v, w] ⧸ (F) is the lifted
-- algebra L = B[U, V, W] ⧸ (relX, relY, relS) over the plane presentation
-- B = ℂ[h, x, y, s] ⧸ (relH, relCusp), as ℂ-algebras: h, x, y, s go to the
-- classes of h, u³ + hv, −u² + hw, S(h, u, v, w), and U, V, W to u, v, w.
-- Part of the Abhyankar–Sathaye blueprint. Planned home: AlgebraicGeometry/Coordinates/Elimination.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module AbhyankarSathaye.Elimination
import Ambient
import Plane
import Lifting

-- The fibre algebra D = ℂ[4] ⧸ (F) and its projection.
def fibreIdeal : Set := generatedIdeal(polynomialRing(complexRing, 4), {ambientF})

def fibreAlgebra : Set := quotientAlgebra(ambientAlgebra, fibreIdeal)

def fibreProjection : Set := algebraProjection(ambientAlgebra, fibreIdeal)

-- The plane presentation over ℂ as the base B, with its classes h, x, y, s.
def baseAlgebra : Set := planeAlgebra(complexRing)

def baseRing : Set := Algebra.ring(baseAlgebra)

def baseH : Set := planeVariable(complexRing, 0)

def baseX : Set := planeVariable(complexRing, 1)

def baseY : Set := planeVariable(complexRing, 2)

def baseS : Set := planeVariable(complexRing, 3)

-- The lifted algebra L over B, as an algebra over ℂ.
def liftedAlgebra : Set :=
  restrictScalars(liftingAlgebra(baseRing, baseH, baseX, baseY, baseS), complexRing,
    Algebra.map(baseAlgebra))

def liftedConstant : Set := Algebra.map(liftingAlgebra(baseRing, baseH, baseX, baseY, baseS))

def liftedVariable (i : Set) : Set := liftingVariable(baseRing, baseH, baseX, baseY, baseS, i)

-- B → D: h, x, y, s to the classes of h, x, y, s in D.
def auxValues : Set :=
  quadrupleMap(algebraCarrier(fibreAlgebra), fibreProjection(X(complexRing, 4, 0)),
    fibreProjection(ambientX), fibreProjection(ambientY), fibreProjection(ambientS))

def auxEval : Set :=
  evaluationHom(complexRing, Algebra.ring(fibreAlgebra), 4, Algebra.map(fibreAlgebra), auxValues)

def auxToD : Set := algebraLift(auxEval, ambientAlgebra, fibreAlgebra, planeIdeal(complexRing))

-- B[U, V, W] → D: constants by auxToD, and U, V, W to the classes of u, v, w.
def liftValues : Set :=
  tripleMap(algebraCarrier(fibreAlgebra), fibreProjection(X(complexRing, 4, 1)),
    fibreProjection(X(complexRing, 4, 2)), fibreProjection(X(complexRing, 4, 3)))

def liftEval : Set := evaluationHom(baseRing, Algebra.ring(fibreAlgebra), 3, auxToD, liftValues)

def toOriginal : Set :=
  quotientMap(liftEval, Ring.carrier(polynomialRing(baseRing, 3)), algebraCarrier(fibreAlgebra),
    quotientRelation(polynomialRing(baseRing, 3), liftingIdeal(baseRing, baseH, baseX, baseY, baseS)))

-- ℂ[h, u, v, w] → L: h to the constant h, and u, v, w to U, V, W.
def originalValues : Set :=
  quadrupleMap(algebraCarrier(liftedAlgebra), liftedConstant(baseH), liftedVariable(0),
    liftedVariable(1), liftedVariable(2))

def originalEval : Set :=
  evaluationHom(complexRing, Algebra.ring(liftedAlgebra), 4, Algebra.map(liftedAlgebra),
    originalValues)

def fromOriginal : Set := algebraLift(originalEval, ambientAlgebra, liftedAlgebra, fibreIdeal)

theorem fibreAlgebra.algebra
  shows Algebra(fibreAlgebra)
proof
  sorry

theorem baseAlgebra.algebra
  shows Algebra(baseAlgebra)
proof
  sorry

theorem liftedAlgebra.algebra
  shows Algebra(liftedAlgebra)
proof
  sorry

theorem fibreProjection.F
  shows fibreProjection(ambientF) = Ring.zero(Algebra.ring(fibreAlgebra))
proof
  sorry

-- The plane relations hold among the classes of h, x, y, s in D.
theorem auxEval.relH
  shows auxEval(relH(complexRing)) = Ring.zero(Algebra.ring(fibreAlgebra))
proof
  sorry

theorem auxEval.relCusp
  shows auxEval(relCusp(complexRing)) = Ring.zero(Algebra.ring(fibreAlgebra))
proof
  sorry

theorem auxToD.hom
  shows auxToD : baseAlgebra →ₐ fibreAlgebra
proof
  sorry

-- The lifting relations hold among the classes of u, v, w in D.
theorem liftEval.hom
  shows liftEval : polynomialRing(baseRing, 3) →+* Algebra.ring(fibreAlgebra)
proof
  sorry

theorem liftEval.relX
  shows liftEval(relX(baseRing, baseH, baseX)) = Ring.zero(Algebra.ring(fibreAlgebra))
proof
  sorry

theorem liftEval.relY
  shows liftEval(relY(baseRing, baseH, baseY)) = Ring.zero(Algebra.ring(fibreAlgebra))
proof
  sorry

theorem liftEval.relS
  shows liftEval(relS(baseRing, baseH, baseS)) = Ring.zero(Algebra.ring(fibreAlgebra))
proof
  sorry

theorem toOriginal.hom
  shows toOriginal : liftedAlgebra →ₐ fibreAlgebra
proof
  sorry

-- F vanishes under h ↦ h, u ↦ U, v ↦ V, w ↦ W in L.
theorem originalEval.F
  shows originalEval(ambientF) = Ring.zero(Algebra.ring(liftedAlgebra))
proof
  sorry

theorem fromOriginal.hom
  shows fromOriginal : fibreAlgebra →ₐ liftedAlgebra
proof
  sorry

theorem toOriginal.after_from (d : Set)
  requires member : d ∈ algebraCarrier(fibreAlgebra)
  shows toOriginal(fromOriginal(d)) = d
proof
  sorry

theorem fromOriginal.after_to (l : Set)
  requires member : l ∈ algebraCarrier(liftedAlgebra)
  shows fromOriginal(toOriginal(l)) = l
proof
  sorry

theorem elimination_equivalence
  shows toOriginal : liftedAlgebra ≃ₐ fibreAlgebra
proof
  sorry
