-- Algebras over a commutative ring: a commutative ring with a structure map
-- from the base ring, their homomorphisms f : A →ₐ B, which are ring
-- homomorphisms commuting with the structure maps, and isomorphisms.
-- Part of the Abhyankar–Sathaye blueprint. Planned home: Algebra/Algebra/Basic.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module AbhyankarSathaye.Algebras
import Grace.Cumulus.Algebra.Ring

-- An algebra over its base: the base ring, the ring, and the structure map
-- from the base into the ring.
structure Algebra
  | base ring map : Set
  where
    base_ring : CommRing(base)
    ring_ring : CommRing(ring)
    structure_map : map : base →+* ring

def algebraCarrier (A : Set) : Set := Ring.carrier(Algebra.ring(A))

-- A homomorphism of algebras over one base: a ring homomorphism that
-- commutes with the structure maps.
predicate AlgebraHom (f A B : Set) :=
  Algebra(A) ∧ Algebra(B) ∧ Algebra.base(A) = Algebra.base(B) ∧
  RingHom(f, Algebra.ring(A), Algebra.ring(B)) ∧
  (∀ a ∈ Ring.carrier(Algebra.base(A)),
    f(Algebra.map(A)(a)) = Algebra.map(B)(a))

predicate AlgebraIso (f A B : Set) :=
  AlgebraHom(f, A, B) ∧ BijectiveBetween(f, algebraCarrier(A), algebraCarrier(B))

notation guard "_ : _ →ₐ _" => AlgebraHom
notation guard "_ : _ ≃ₐ _" => AlgebraIso

theorem AlgebraHom.ring_hom (f A B : Set)
  requires hom : f : A →ₐ B
  shows f : Algebra.ring(A) →+* Algebra.ring(B)
proof
  exact hom.right.right.right.left

theorem AlgebraHom.function (f A B : Set)
  requires hom : f : A →ₐ B
  shows f : algebraCarrier(A) → algebraCarrier(B)
proof
  have ringHom := AlgebraHom.ring_hom with hom
  obtain ⟨source, target, function, rest⟩ := ringHom
  unfold algebraCarrier
  exact function

theorem AlgebraHom.map_base (f A B a : Set)
  requires hom : f : A →ₐ B
  requires member : a ∈ Ring.carrier(Algebra.base(A))
  shows f(Algebra.map(A)(a)) = Algebra.map(B)(a)
proof
  exact hom.right.right.right.right with a, member

theorem AlgebraHom.identity (A : Set)
  requires algebra : Algebra(A)
  shows identity(algebraCarrier(A)) : A →ₐ A
proof
  obtain ⟨shape, baseRing, ringRing, structureMap⟩ := algebra
  have ringHom := RingHom.id with ringRing
  unfold AlgebraHom
  refine ⟨algebra, algebra, rfl, ?_, ?_⟩
  . unfold algebraCarrier
    exact ringHom
  . intros a aIn
    have image := RingHom.map_mem with structureMap, aIn
    unfold algebraCarrier
    exact identity.apply with image

theorem AlgebraHom.compose (f g A B C : Set)
  requires first : f : A →ₐ B
  requires second : g : B →ₐ C
  shows compose(g, f, algebraCarrier(A), algebraCarrier(B), algebraCarrier(C)) :
    A →ₐ C
proof
  obtain ⟨algebraA, algebraB, sameBase, homF, commuteF⟩ := first
  obtain ⟨algebraB2, algebraC, sameBase2, homG, commuteG⟩ := second
  obtain ⟨shape, baseRing, ringRing, structureMap⟩ := algebraA
  have ringHom := RingHom.comp with ringRing, homF, homG
  have functionF := AlgebraHom.function with first
  have functionG := AlgebraHom.function with second
  unfold AlgebraHom
  refine ⟨algebraA, algebraC, ?_, ?_, ?_⟩
  . rw sameBase
    exact sameBase2
  . unfold algebraCarrier
    exact ringHom
  . intros a aIn
    have image : Algebra.map(A)(a) ∈ algebraCarrier(A)
      unfold algebraCarrier
      exact RingHom.map_mem with structureMap, aIn
    rw compose.apply with functionF, functionG, image
    rw AlgebraHom.map_base with first, aIn
    rw sameBase at aIn
    exact AlgebraHom.map_base with second, aIn

-- A function with a two-sided inverse is a bijection.
theorem AlgebraIso.bijective_of_inverse (f g A B : Set)
  requires function : f : A → B
  requires inverse : g : B → A
  requires left : ∀ x ∈ A, g(f(x)) = x
  requires right : ∀ y ∈ B, f(g(y)) = y
  shows BijectiveBetween(f, A, B)
proof
  unfold BijectiveBetween
  constructor
  . unfold InjectiveBetween
    refine ⟨function, ?_⟩
    intros x xIn y yIn z zIn relatesX relatesY
    have valueX := FunctionBetween.apply_value with function, xIn, relatesX
    have valueY := FunctionBetween.apply_value with function, yIn, relatesY
    have leftX := left with x, xIn
    have leftY := left with y, yIn
    cc
  . unfold SurjectiveBetween
    refine ⟨function, ?_⟩
    intros y yIn
    have preimage := FunctionBetween.apply_closed with inverse, yIn
    have edge := FunctionBetween.relates_apply with function, preimage
    have value := right with y, yIn
    refine ⟨g(y), preimage, ?_⟩
    rwa value at edge

-- Two homomorphisms inverse to each other on the carriers are isomorphisms.
theorem AlgebraIso.of_inverse (f g A B : Set)
  requires forward : f : A →ₐ B
  requires backward : g : B →ₐ A
  requires left : ∀ x ∈ algebraCarrier(A), g(f(x)) = x
  requires right : ∀ y ∈ algebraCarrier(B), f(g(y)) = y
  shows f : A ≃ₐ B
proof
  have functionF := AlgebraHom.function with forward
  have functionG := AlgebraHom.function with backward
  have bijective := AlgebraIso.bijective_of_inverse with functionF, functionG,
    left, right
  unfold AlgebraIso
  exact ⟨forward, bijective⟩

theorem AlgebraIso.inverse (f A B : Set)
  requires iso : f : A ≃ₐ B
  shows converse(f, algebraCarrier(A), algebraCarrier(B)) : B ≃ₐ A
proof
  obtain ⟨hom, bijective⟩ := iso
  obtain ⟨algebraA, algebraB, sameBase, ringHom, commute⟩ := hom
  obtain ⟨shapeA, baseRingA, ringRingA, mapA⟩ := algebraA
  obtain ⟨shapeB, baseRingB, ringRingB, mapB⟩ := algebraB
  unfold algebraCarrier at bijective
  have ringIso : f : A.ring ≃+* B.ring
    unfold RingIso
    exact ⟨ringHom, bijective⟩
  have inverseIso := RingIso.symm with ringRingA, ringRingB, ringIso
  have inverseHom := RingIso.hom_of with inverseIso
  unfold AlgebraIso
  unfold algebraCarrier
  constructor
  . unfold AlgebraHom
    refine ⟨algebraB, algebraA, ?_, inverseHom, ?_⟩
    . rw sameBase
    . intros a aIn
      rw ← sameBase at aIn
      have image := RingHom.map_mem with mapA, aIn
      have forward := commute with a, aIn
      rw ← forward
      exact Bijective.inverse_apply with bijective, image
  . exact converse.bijective with bijective

theorem AlgebraIso.compose (f g A B C : Set)
  requires first : f : A ≃ₐ B
  requires second : g : B ≃ₐ C
  shows compose(g, f, algebraCarrier(A), algebraCarrier(B), algebraCarrier(C)) :
    A ≃ₐ C
proof
  obtain ⟨homF, bijectiveF⟩ := first
  obtain ⟨homG, bijectiveG⟩ := second
  have hom := AlgebraHom.compose with homF, homG
  have bijective := compose.bijective with bijectiveF, bijectiveG
  unfold AlgebraIso
  exact ⟨hom, bijective⟩

theorem AlgebraIso.identity (A : Set)
  requires algebra : Algebra(A)
  shows identity(algebraCarrier(A)) : A ≃ₐ A
proof
  have hom := AlgebraHom.identity with algebra
  have bijective := identity.bijective at algebraCarrier(A)
  unfold AlgebraIso
  exact ⟨hom, bijective⟩

-- Restriction of scalars: an algebra over B is an algebra over K along a
-- homomorphism K →+* B, and homomorphisms over B are homomorphisms over K.
def restrictScalars (A K ι : Set) : Set :=
  Algebra.mk(K, Algebra.ring(A),
    compose(Algebra.map(A), ι, Ring.carrier(K), Ring.carrier(Algebra.base(A)),
      algebraCarrier(A)))

theorem restrictScalars.algebra (A K ι : Set)
  requires algebra : Algebra(A)
  requires base : CommRing(K)
  requires scalars : ι : K →+* Algebra.base(A)
  shows Algebra(restrictScalars(A, K, ι))
proof
  obtain ⟨shape, baseRing, ringRing, structureMap⟩ := algebra
  have composite := RingHom.comp with base, scalars, structureMap
  unfold restrictScalars
  unfold algebraCarrier
  exact Algebra.intro with base, ringRing, composite

theorem AlgebraHom.restrict (f A B K ι : Set)
  requires hom : f : A →ₐ B
  requires base : CommRing(K)
  requires scalars : ι : K →+* Algebra.base(A)
  shows f : restrictScalars(A, K, ι) →ₐ restrictScalars(B, K, ι)
proof
  obtain ⟨algebraA, algebraB, sameBase, ringHom, commute⟩ := hom
  obtain ⟨shapeA, baseRingA, ringRingA, mapA⟩ := algebraA
  obtain ⟨shapeB, baseRingB, ringRingB, mapB⟩ := algebraB
  have scalarsB : ι : K →+* Algebra.base(B)
    rw ← sameBase
    exact scalars
  have restrictedA := restrictScalars.algebra with algebraA, base, scalars
  have restrictedB := restrictScalars.algebra with algebraB, base, scalarsB
  obtain ⟨sourceK, targetA, functionI, restI⟩ := scalars
  obtain ⟨sourceK2, targetB, functionIB, restIB⟩ := scalarsB
  obtain ⟨sourceA, targetRingA, functionA, restA⟩ := mapA
  obtain ⟨sourceB, targetRingB, functionB, restB⟩ := mapB
  unfold AlgebraHom
  refine ⟨restrictedA, restrictedB, ?_, ?_, ?_⟩
  . unfold restrictScalars
    rw [Algebra.mk.base, Algebra.mk.base]
  . unfold restrictScalars
    rw [Algebra.mk.ring, Algebra.mk.ring]
    exact ringHom
  . intros a aIn
    unfold restrictScalars at aIn
    rw Algebra.mk.base at aIn
    unfold restrictScalars
    rw [Algebra.mk.map, Algebra.mk.map]
    unfold algebraCarrier
    have image := RingHom.map_mem with scalars, aIn
    rw compose.apply with functionI, functionA, aIn
    rw compose.apply with functionIB, functionB, aIn
    exact AlgebraHom.map_base with hom, image

theorem AlgebraIso.restrict (f A B K ι : Set)
  requires iso : f : A ≃ₐ B
  requires base : CommRing(K)
  requires scalars : ι : K →+* Algebra.base(A)
  shows f : restrictScalars(A, K, ι) ≃ₐ restrictScalars(B, K, ι)
proof
  obtain ⟨hom, bijective⟩ := iso
  have restricted := AlgebraHom.restrict with hom, base, scalars
  unfold AlgebraIso
  refine ⟨restricted, ?_⟩
  unfold algebraCarrier
  unfold restrictScalars
  rw [Algebra.mk.ring, Algebra.mk.ring]
  unfold algebraCarrier at bijective
  exact bijective

section Members
variable (A : Set)
hypothesis algebra : Algebra(A)

instance Algebra.map_mem (a : Set)
  requires member : a ∈ Ring.carrier(Algebra.base(A))
  shows Algebra.map(A)(a) ∈ Ring.carrier(Algebra.ring(A))
proof
  obtain ⟨shape, baseRing, ringRing, structureMap⟩ := algebra
  exact RingHom.map_mem with structureMap, member

instance Algebra.comm_ring
  shows CommRing(Algebra.ring(A))
proof
  exact algebra.right.right.left

end Members
