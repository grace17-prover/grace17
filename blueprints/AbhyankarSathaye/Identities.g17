-- The polynomial identities behind the explicit hypersurface: the cusp
-- identity (u³ + hv)² + (−u² + hw)³ = h·S, the shift identity, and the
-- Bézout certificate, over every commutative ring.
-- Part of the Abhyankar–Sathaye blueprint. Planned home: AlgebraicGeometry/Coordinates/Identities.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module AbhyankarSathaye.Identities
import Grace.Cumulus.Algebra.Ring

section Identities
variable (R : Set)
hypothesis ring : CommRing(R)

-- S(h, u, v, w), with h·S the cusp x² + y³ of x = u³ + hv, y = −u² + hw.
def cuspS (h u v w : Set) : Set :=
  R[2]*u^3*v + R[3]*u^4*w + h*(v^2 - R[3]*u^2*w^2) + h^2*w^3

-- P(x, y, s), the correction in the shift identity.
def shiftP (x y s : Set) : Set := -R[2]*s^2*x + R[3]*s*y^2 - R[3]*s^3*y

-- The Bézout coefficients of h and y.
def bezoutAlpha (x s : Set) : Set := R[1] + R[2]*s^2*x + R[4]*s^5

def bezoutBeta (x y s : Set) : Set :=
  (R[3]*s^3 - R[3]*s*y)*(R[1] + R[2]*s^2*x) - R[4]*s^4*y^2

theorem cusp_universal (h u v w : R)
  shows (u^3 + h*v)^2 + (-u^2 + h*w)^3 = h * cuspS(R, h, u, v, w)
proof
  unfold cuspS
  ring

theorem shift_universal (x y s : R)
  shows (x + s^3)^2 + (y - s^2)^3 = x^2 + y^3 - s * shiftP(R, x, y, s)
proof
  unfold shiftP
  ring

theorem bezout_certificate (h x y s : R)
  shows bezoutAlpha(R, x, s)*h + bezoutBeta(R, x, y, s)*y - R[1] =
    (R[1] + R[2]*s^2*x)*(h - R[1] - shiftP(R, x, y, s)) -
      R[4]*s^4*(x^2 + y^3 - s*h)
proof
  unfold bezoutAlpha
  unfold bezoutBeta
  unfold shiftP
  ring

instance cuspS.mem (h u v w : R)
  shows cuspS(R, h, u, v, w) ∈ R
proof
  unfold cuspS
  typecheck

instance shiftP.mem (x y s : R)
  shows shiftP(R, x, y, s) ∈ R
proof
  unfold shiftP
  typecheck

instance bezoutAlpha.mem (x s : R)
  shows bezoutAlpha(R, x, s) ∈ R
proof
  unfold bezoutAlpha
  typecheck

instance bezoutBeta.mem (x y s : R)
  shows bezoutBeta(R, x, y, s) ∈ R
proof
  unfold bezoutBeta
  typecheck

end Identities
