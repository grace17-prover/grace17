-- The polynomial identities behind the explicit hypersurface: the cusp
-- identity (u³ + hv)² + (−u² + hw)³ = h·S, the shift identity, and the
-- Bézout certificate, over every commutative ring.
-- Part of the Abhyankar–Sathaye blueprint. Planned home: AlgebraicGeometry/Coordinates/Identities.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module AbhyankarSathaye.Identities
import Grace.Cumulus.Algebra.Ring

section Identities
variable (R : Set)
hypothesis ring : CommRing(R)

-- S(h, u, v, w), with h·S the cusp x² + y³ of x = u³ + hv, y = −u² + hw.
def cuspS (h u v w : Set) : Set :=
  R[2]*u^3*v + R[3]*u^4*w + h*(v^2 - R[3]*u^2*w^2) + h^2*w^3

-- P(x, y, s), the correction in the shift identity.
def shiftP (x y s : Set) : Set := -R[2]*s^2*x + R[3]*s*y^2 - R[3]*s^3*y

-- The Bézout coefficients of h and y.
def bezoutAlpha (x s : Set) : Set := R[1] + R[2]*s^2*x + R[4]*s^5

def bezoutBeta (x y s : Set) : Set :=
  (R[3]*s^3 - R[3]*s*y)*(R[1] + R[2]*s^2*x) - R[4]*s^4*y^2

theorem cusp_universal (h u v w : R)
  shows (u^3 + h*v)^2 + (-u^2 + h*w)^3 = h * cuspS(R, h, u, v, w)
proof
  unfold cuspS
  ring

theorem shift_universal (x y s : R)
  shows (x + s^3)^2 + (y - s^2)^3 = x^2 + y^3 - s * shiftP(R, x, y, s)
proof
  unfold shiftP
  ring

theorem bezout_certificate (h x y s : R)
  shows bezoutAlpha(R, x, s)*h + bezoutBeta(R, x, y, s)*y - R[1] =
    (R[1] + R[2]*s^2*x)*(h - R[1] - shiftP(R, x, y, s)) -
      R[4]*s^4*(x^2 + y^3 - s*h)
proof
  unfold bezoutAlpha
  unfold bezoutBeta
  unfold shiftP
  ring

instance cuspS.mem (h u v w : R)
  shows cuspS(R, h, u, v, w) ∈ R
proof
  unfold cuspS
  typecheck

instance shiftP.mem (x y s : R)
  shows shiftP(R, x, y, s) ∈ R
proof
  unfold shiftP
  typecheck

instance bezoutAlpha.mem (x s : R)
  shows bezoutAlpha(R, x, s) ∈ R
proof
  unfold bezoutAlpha
  typecheck

instance bezoutBeta.mem (x y s : R)
  shows bezoutBeta(R, x, y, s) ∈ R
proof
  unfold bezoutBeta
  typecheck

end Identities

-- Ring homomorphisms carry powers, numerals, S, and P along.
section Transport
variable (R S f : Set)
hypothesis source : CommRing(R)
hypothesis target : CommRing(S)
hypothesis hom : f : R →+* S

theorem RingHom.map_pow (a : R) (n : Nat)
  shows f(a ^ n) = f(a) ^ n
proof
  have ringR := CommRing.to_ring with source
  have ringS := CommRing.to_ring with target
  induction n
  | zero =>
    have left := Ring.pow_zero at R, a with ringR
    have right := Ring.pow_zero at S, f(a) with ringS
    have one := RingHom.map_one with hom
    rw [left, right, one]
  | succ(k) using ih =>
    have shift := add.right_one at k with *
    rw ← shift
    have left := Ring.pow_succ at R, a, k with ringR
    have right := Ring.pow_succ at S, f(a), k with ringS
    have mul := RingHom.map_mul at f, R, S, a ^ k, a with hom
    rw [left, right, mul, ih]

theorem RingHom.map_numeral (n : Nat)
  shows f(ringNat(R.add, R.zero, R.one, n)) = ringNat(S.add, S.zero, S.one, n)
proof
  induction n
  | zero =>
    have left := ringNat.zero at R.add, R.zero, R.one
    have right := ringNat.zero at S.add, S.zero, S.one
    have zero := RingHom.map_zero with hom
    rw [left, right, zero]
  | succ(k) using ih =>
    have left := ringNat.succ at R.add, R.zero, R.one, k
    have right := ringNat.succ at S.add, S.zero, S.one, k
    have one := RingHom.map_one with hom
    have add := RingHom.map_add at f, R, S, ringNat(R.add, R.zero, R.one, k),
      R.one with hom
    rw [left, right, add, ih, one]

theorem RingHom.map_two
  shows f(R[2]) = S[2]
proof
  exact RingHom.map_numeral at R, S, f, 2 with *

theorem RingHom.map_three
  shows f(R[3]) = S[3]
proof
  exact RingHom.map_numeral at R, S, f, 3 with *

theorem cuspS.map (h u v w : R)
  shows f(cuspS(R, h, u, v, w)) = cuspS(S, f(h), f(u), f(v), f(w))
proof
  have two := RingHom.map_two with *
  have three := RingHom.map_three with *
  unfold cuspS
  simp [RingHom.map_add, RingHom.map_mul, RingHom.map_sub, RingHom.map_pow,
    two, three]

theorem RingHom.map_shiftP (x y s : R)
  shows f(shiftP(R, x, y, s)) = shiftP(S, f(x), f(y), f(s))
proof
  have two := RingHom.map_two with *
  have three := RingHom.map_three with *
  unfold shiftP
  simp [RingHom.map_sub, RingHom.map_add, RingHom.map_mul, RingHom.map_neg,
    RingHom.map_pow, two, three]

end Transport
