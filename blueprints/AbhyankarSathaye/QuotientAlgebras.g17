-- Quotients of algebras by ideals: the quotient algebra, its projection,
-- and the lift of a homomorphism that kills the ideal, in particular an
-- ideal generated by finitely many elements the homomorphism sends to zero.
-- Part of the Abhyankar–Sathaye blueprint. Planned home: Algebra/Algebra/Quotient.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module AbhyankarSathaye.QuotientAlgebras
import Algebras
import Grace.Cumulus.Algebra.Ring

-- The projection of the ring of A onto its quotient by J.
def algebraProjection (A J : Set) : Set :=
  quotientProjection(algebraCarrier(A), quotientRelation(Algebra.ring(A), J))

-- The quotient algebra: the quotient ring with the projected structure map.
def quotientAlgebra (A J : Set) : Set :=
  Algebra.mk(Algebra.base(A), quotientRing(Algebra.ring(A), J),
    compose(algebraProjection(A, J), Algebra.map(A),
      Ring.carrier(Algebra.base(A)), algebraCarrier(A),
      Ring.carrier(quotientRing(Algebra.ring(A), J))))

-- The homomorphism a quotient inherits from one that kills the ideal.
def algebraLift (f A B J : Set) : Set :=
  quotientMap(f, algebraCarrier(A), algebraCarrier(B),
    quotientRelation(Algebra.ring(A), J))

section Quotients
variable (A J : Set)
hypothesis algebra : Algebra(A)
hypothesis ideal : Ideal(Algebra.ring(A), J)

theorem quotientAlgebra.algebra
  shows Algebra(quotientAlgebra(A, J))
proof
  sorry

theorem algebraProjection.hom
  shows algebraProjection(A, J) : A →ₐ quotientAlgebra(A, J)
proof
  sorry

theorem algebraProjection.surjective
  shows SurjectiveBetween(algebraProjection(A, J), algebraCarrier(A),
    algebraCarrier(quotientAlgebra(A, J)))
proof
  sorry

theorem algebraProjection.kills (x : Set)
  requires member : x ∈ J
  shows algebraProjection(A, J)(x) = Ring.zero(quotientRing(Algebra.ring(A), J))
proof
  sorry

theorem algebraProjection.zero_iff (x : Set)
  requires member : x ∈ algebraCarrier(A)
  shows algebraProjection(A, J)(x) = Ring.zero(quotientRing(Algebra.ring(A), J)) ↔
    x ∈ J
proof
  sorry

theorem AlgebraHom.lift (f B : Set)
  requires hom : f : A →ₐ B
  requires killed : ∀ x ∈ J, f(x) = Ring.zero(Algebra.ring(B))
  shows algebraLift(f, A, B, J) : quotientAlgebra(A, J) →ₐ B
proof
  sorry

theorem AlgebraHom.lift_factors (f B x : Set)
  requires hom : f : A →ₐ B
  requires killed : ∀ x ∈ J, f(x) = Ring.zero(Algebra.ring(B))
  requires member : x ∈ algebraCarrier(A)
  shows algebraLift(f, A, B, J)(algebraProjection(A, J)(x)) = f(x)
proof
  sorry

-- Homomorphisms out of a quotient are determined by their composites with
-- the projection.
theorem AlgebraHom.quotient_ext (g h B : Set)
  requires first : g : quotientAlgebra(A, J) →ₐ B
  requires second : h : quotientAlgebra(A, J) →ₐ B
  requires agree : ∀ x ∈ algebraCarrier(A),
    g(algebraProjection(A, J)(x)) = h(algebraProjection(A, J)(x))
  shows g = h
proof
  sorry

end Quotients

section Generated
variable (A G : Set)
hypothesis algebra : Algebra(A)
hypothesis generators : G ⊆ algebraCarrier(A)

theorem generatedIdeal.subset_kernel (f B : Set)
  requires hom : f : A →ₐ B
  requires killed : ∀ g ∈ G, f(g) = Ring.zero(Algebra.ring(B))
  shows ∀ x ∈ generatedIdeal(Algebra.ring(A), G), f(x) = Ring.zero(Algebra.ring(B))
proof
  sorry

theorem AlgebraHom.lift_generated (f B : Set)
  requires hom : f : A →ₐ B
  requires killed : ∀ g ∈ G, f(g) = Ring.zero(Algebra.ring(B))
  shows algebraLift(f, A, B, generatedIdeal(Algebra.ring(A), G)) :
    quotientAlgebra(A, generatedIdeal(Algebra.ring(A), G)) →ₐ B
proof
  sorry

theorem AlgebraHom.lift_generated_factors (f B x : Set)
  requires hom : f : A →ₐ B
  requires killed : ∀ g ∈ G, f(g) = Ring.zero(Algebra.ring(B))
  requires member : x ∈ algebraCarrier(A)
  shows algebraLift(f, A, B, generatedIdeal(Algebra.ring(A), G))(
    algebraProjection(A, generatedIdeal(Algebra.ring(A), G))(x)) = f(x)
proof
  sorry

theorem algebraProjection.kills_generator (g : Set)
  requires member : g ∈ G
  shows algebraProjection(A, generatedIdeal(Algebra.ring(A), G))(g) =
    Ring.zero(quotientRing(Algebra.ring(A), generatedIdeal(Algebra.ring(A), G)))
proof
  sorry

end Generated
