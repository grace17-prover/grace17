-- Partial derivatives of polynomials: the formal derivative in one
-- variable, its rules for constants, variables, sums, products, and powers,
-- and the chain rule for an algebra homomorphism between polynomial rings
-- with a numeral index set.
-- Part of the Abhyankar–Sathaye blueprint.
-- Planned home: Algebra/Polynomial/Derivative.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module AbhyankarSathaye.Derivatives
import PolynomialAlgebras
import Grace.Cumulus.Cardinal.Dominance
import Grace.Cumulus.Algebra.Polynomial.MonomialShift

-- The definitions. The monomial m with its exponent at i raised by one;
-- the coefficient of m in ∂p/∂Xᵢ, which is (m(i) + 1) times the
-- coefficient of the shifted monomial in p; and the derivative in the
-- variable i as a function on the polynomial ring.
def shiftMonomial (I m i : Set) : Set :=
  { e ∈ I × ℕ | (fst(e) = i ∧ snd(e) = succ(m(i))) ∨
    (fst(e) ≠ i ∧ snd(e) = m(fst(e))) }

def partialDerivativeOf (R I i p : Set) : Set :=
  { c ∈ monomials(I) × Ring.carrier(R) |
    snd(c) = call2(Ring.mul(R),
      ringNat(Ring.add(R), Ring.zero(R), Ring.one(R), succ(fst(c)(i))),
      p(shiftMonomial(I, fst(c), i))) }

def partialDerivative (R I i : Set) : Set :=
  { q ∈ Ring.carrier(polynomialRing(R, I)) ×
      Ring.carrier(polynomialRing(R, I)) |
    snd(q) = partialDerivativeOf(R, I, i, fst(q)) }

-- The shifted monomial: a graph on I with the raised exponent at i and
-- the old exponents elsewhere, which is the product of m by the monomial
-- of Xᵢ, so a monomial, injective in m, and never the unit monomial or a
-- variable other than Xᵢ.
section Shift
variable (I i : Set)
hypothesis index : i ∈ I

theorem shiftMonomial.function (m : Set)
  requires member : m ∈ monomials(I)
  shows shiftMonomial(I, m, i) : I → ℕ
proof
  have function := monomials.function with member
  constructor
  . intros e he
    exact he.left
  constructor
  . intros x y relatedY z relatedZ
    obtain ⟨_, shapeY⟩ := relatedY
    obtain ⟨_, shapeZ⟩ := relatedZ
    simp [fst.pair, snd.pair] at shapeY, shapeZ
    rcases shapeY with ⟨sameY, valueY⟩ | ⟨otherY, valueY⟩
    . rcases shapeZ with ⟨sameZ, valueZ⟩ | ⟨otherZ, valueZ⟩
      . cc
      . exfalso
        exact otherZ with sameY
    . rcases shapeZ with ⟨sameZ, valueZ⟩ | ⟨otherZ, valueZ⟩
      . exfalso
        exact otherY with sameZ
      . cc
  . intros x hx
    have alternatives : x = i ∨ x ≠ i by tauto
    cases alternatives with same | other
    . have exponent := monomials.exponent with member, index
      have successor := Naturals.constructor.succ with exponent
      have successorIn := nat.omega.forward with successor
      refine ⟨succ(m(i)), successorIn, _⟩
      apply shiftMonomial.membership.backward
      refine ⟨(product.pair with hx, successorIn), _⟩
      rw same
      simp [fst.pair, snd.pair]
    . have valueIn := FunctionBetween.apply_closed with function, hx
      refine ⟨m(x), valueIn, _⟩
      apply shiftMonomial.membership.backward
      refine ⟨(product.pair with hx, valueIn), _⟩
      simp [fst.pair, snd.pair, other]

theorem shiftMonomial.same (m : Set)
  requires member : m ∈ monomials(I)
  shows shiftMonomial(I, m, i)(i) = succ(m(i))
proof
  have function := shiftMonomial.function at I, i, m with *
  have exponent := monomials.exponent with member, index
  have successor := Naturals.constructor.succ with exponent
  have successorIn := nat.omega.forward with successor
  have related : relates(shiftMonomial(I, m, i), i, succ(m(i)))
    apply shiftMonomial.membership.backward
    refine ⟨(product.pair with index, successorIn), _⟩
    simp [fst.pair, snd.pair]
  exact FunctionBetween.apply_value with function, index, related

theorem shiftMonomial.other (m j : Set)
  requires member : m ∈ monomials(I)
  requires other : j ∈ I
  requires apart : j ≠ i
  shows shiftMonomial(I, m, i)(j) = m(j)
proof
  have function := shiftMonomial.function at I, i, m with *
  have valueIn :=
    FunctionBetween.apply_closed with (monomials.function with member), other
  have related : relates(shiftMonomial(I, m, i), j, m(j))
    apply shiftMonomial.membership.backward
    refine ⟨(product.pair with other, valueIn), _⟩
    simp [fst.pair, snd.pair, apart]
  exact FunctionBetween.apply_value with function, other, related

theorem shiftMonomial.product (m : Set)
  requires member : m ∈ monomials(I)
  shows shiftMonomial(I, m, i) = monomialProduct(I, monomialVariable(I, i), m)
proof
  have variable := monomialVariable.member at I, i
  have product := monomialProduct.member with variable, member
  have left := shiftMonomial.function at I, i, m with *
  have right := monomials.function with product
  apply FunctionBetween.ext with left, right
  intros j hj
  have exponent := monomials.exponent with member, hj
  have value :=
    monomialProduct.value at I, monomialVariable(I, i), m, j with *
  rw value
  have alternatives : j = i ∨ j ≠ i by tauto
  cases alternatives with same | apart
  . rw same
    have shifted := shiftMonomial.same at I, i, m with *
    have unit := monomialVariable.same at I, i with index
    have exponentI := monomials.exponent with member, index
    have successor := add.right_one at m(i) with *
    rw [shifted, unit, ← successor]
    exact add.commutative with *
  . have shifted := shiftMonomial.other at I, i, m, j with *
    have unit := monomialVariable.other at I, i, j with hj, apart
    rw [shifted, unit]
    symm
    exact add.left_unit with *

theorem shiftMonomial.member (m : Set)
  requires member : m ∈ monomials(I)
  shows shiftMonomial(I, m, i) ∈ monomials(I)
proof
  have variable := monomialVariable.member at I, i
  rw shiftMonomial.product at I, i, m with *
  exact monomialProduct.member with variable, member

theorem shiftMonomial.injective (m n : Set)
  requires left : m ∈ monomials(I)
  requires right : n ∈ monomials(I)
  requires equal : shiftMonomial(I, m, i) = shiftMonomial(I, n, i)
  shows m = n
proof
  have variable := monomialVariable.member at I, i
  have productM := shiftMonomial.product at I, i, m with *
  have productN := shiftMonomial.product at I, i, n with *
  rw [productM, productN] at equal
  exact monomialProduct.cancel with variable, left, right, equal

theorem shiftMonomial.exponent_nonzero (m : Set)
  requires member : m ∈ monomials(I)
  shows shiftMonomial(I, m, i)(i) ≠ 0
proof
  have shifted := shiftMonomial.same at I, i, m with *
  rw shifted
  intro equal
  symm at equal
  exact Naturals.disjoint.zero.succ at m(i) with equal

theorem shiftMonomial.ne_one (m : Set)
  requires member : m ∈ monomials(I)
  shows shiftMonomial(I, m, i) ≠ monomialOne(I)
proof
  have nonzero := shiftMonomial.exponent_nonzero at I, i, m with *
  have unit := monomialOne.value at I, i with index
  intro equal
  apply nonzero
  rw equal
  exact unit

theorem shiftMonomial.ne_variable (m j : Set)
  requires member : m ∈ monomials(I)
  requires other : j ∈ I
  requires apart : j ≠ i
  shows shiftMonomial(I, m, i) ≠ monomialVariable(I, j)
proof
  have nonzero := shiftMonomial.exponent_nonzero at I, i, m with *
  have reverse : i ≠ j by cc
  have vanishes := monomialVariable.other at I, j, i with index, reverse
  intro equal
  apply nonzero
  rw equal
  exact vanishes

-- A monomial with a positive exponent at i is a shifted monomial.
theorem monomials.unshift (m : Set)
  requires member : m ∈ monomials(I)
  requires nonzero : m(i) ≠ 0
  shows ∃ n ∈ monomials(I), m = shiftMonomial(I, n, i)
proof
  have exponent := monomials.exponent with member, index
  have shape := natural.zero_or_successor at m(i) with *
  cases shape with vanishes | successor
  . exfalso
    exact nonzero with vanishes
  . obtain ⟨k, kNat, equal⟩ := successor
    have variable := monomialVariable.member at I, i
    have restore := monomialErase.restore with member, index
    have single := monomialSingle.member at I, i, k with *
    have erased := monomialErase.member at I, m, i with *
    have split := monomialSingle.succ at I, i, k with index
    have plusOne := add.right_one at k with *
    rw plusOne at split
    rw [equal, split] at restore
    have rest := monomialProduct.member with single, erased
    have reassociate :=
      monomialProduct.associative with variable, single, erased
    have shifted := shiftMonomial.product at I, i,
      monomialProduct(I, coefficientSingle(I, ℕ, 0, k, i),
        coefficientErase(I, ℕ, 0, m, i)) with *
    refine ⟨monomialProduct(I, coefficientSingle(I, ℕ, 0, k, i),
      coefficientErase(I, ℕ, 0, m, i)), rest, _⟩
    cc

end Shift

-- The derivative's coefficient map: its values, its finite support (the
-- shift injects the support of the derivative into the support of p), and
-- so its membership in the polynomial carrier.
def derivativeSupportShift (R I i p : Set) : Set :=
  { q ∈ functionSupport(partialDerivativeOf(R, I, i, p), monomials(I),
      Ring.zero(R)) × functionSupport(p, monomials(I), Ring.zero(R)) |
    snd(q) = shiftMonomial(I, fst(q), i) }

section Coefficients
variable (R I i : Set)
hypothesis ring : CommRing(R)
hypothesis index : i ∈ I

theorem partialDerivativeOf.numeral_mem (m : Set)
  requires monomial : m ∈ monomials(I)
  shows ringNat(R.add, R.zero, R.one, succ(m(i))) ∈ R.carrier
proof
  have exponent := monomials.exponent with monomial, index
  have natural := Naturals.constructor.succ with exponent
  exact Ring.numeral_mem at R, succ(m(i)) with *

theorem partialDerivativeOf.value_mem (p m : Set)
  requires polynomial : p ∈ polynomials(I, R.carrier, R.zero)
  requires monomial : m ∈ monomials(I)
  shows call2(R.mul, ringNat(R.add, R.zero, R.one, succ(m(i))),
    p(shiftMonomial(I, m, i))) ∈ R.carrier
proof
  have numeral := partialDerivativeOf.numeral_mem at R, I, i, m with *
  have shifted := shiftMonomial.member at I, i, m with *
  have coefficient := polynomials.coefficient with polynomial, shifted
  exact Ring.mul_mem with *

theorem partialDerivativeOf.function (p : Set)
  requires polynomial : p ∈ polynomials(I, R.carrier, R.zero)
  shows partialDerivativeOf(R, I, i, p) : monomials(I) → R.carrier
proof
  constructor
  . intros e he
    exact he.left
  constructor
  . intros x y relatedY z relatedZ
    obtain ⟨_, shapeY⟩ := relatedY
    obtain ⟨_, shapeZ⟩ := relatedZ
    simp [fst.pair, snd.pair] at shapeY, shapeZ
    cc
  . intros m hm
    have valueIn := partialDerivativeOf.value_mem at R, I, i, p, m with *
    refine ⟨call2(R.mul, ringNat(R.add, R.zero, R.one, succ(m(i))),
      p(shiftMonomial(I, m, i))), valueIn, _⟩
    apply partialDerivativeOf.membership.backward
    refine ⟨(product.pair with hm, valueIn), _⟩
    simp [fst.pair, snd.pair]

theorem partialDerivativeOf.coefficient (p m : Set)
  requires polynomial : p ∈ polynomials(I, R.carrier, R.zero)
  requires monomial : m ∈ monomials(I)
  shows partialDerivativeOf(R, I, i, p)(m) =
    call2(R.mul, ringNat(R.add, R.zero, R.one, succ(m(i))),
      p(shiftMonomial(I, m, i)))
proof
  have function := partialDerivativeOf.function at R, I, i, p with *
  have valueIn := partialDerivativeOf.value_mem at R, I, i, p, m with *
  have related : relates(partialDerivativeOf(R, I, i, p), m,
      call2(R.mul, ringNat(R.add, R.zero, R.one, succ(m(i))),
        p(shiftMonomial(I, m, i))))
    apply partialDerivativeOf.membership.backward
    refine ⟨(product.pair with monomial, valueIn), _⟩
    simp [fst.pair, snd.pair]
  exact FunctionBetween.apply_value with function, monomial, related

theorem partialDerivativeOf.support (p m : Set)
  requires polynomial : p ∈ polynomials(I, R.carrier, R.zero)
  requires supported : m ∈ functionSupport(partialDerivativeOf(R, I, i, p),
    monomials(I), R.zero)
  shows shiftMonomial(I, m, i) ∈ functionSupport(p, monomials(I), R.zero)
proof
  have data := functionSupport.membership.forward with supported
  have monomial := data.left
  have shifted := shiftMonomial.member at I, i, m with *
  have value := partialDerivativeOf.coefficient at R, I, i, p, m with *
  have numeral := partialDerivativeOf.numeral_mem at R, I, i, m with *
  have parts := Ring.parts with (CommRing.to_ring with ring)
  have annihilate := IsRing.mul_zero with parts, numeral
  apply functionSupport.membership.backward
  refine ⟨shifted, _⟩
  intro vanishes
  apply data.right
  rw [value, vanishes]
  exact annihilate

theorem partialDerivativeOf.support_injection (p : Set)
  requires polynomial : p ∈ polynomials(I, R.carrier, R.zero)
  shows InjectiveBetween(derivativeSupportShift(R, I, i, p),
    functionSupport(partialDerivativeOf(R, I, i, p), monomials(I), R.zero),
    functionSupport(p, monomials(I), R.zero))
proof
  constructor
  . constructor
    . intros e he
      exact he.left
    constructor
    . intros x y relatedY z relatedZ
      obtain ⟨_, shapeY⟩ := relatedY
      obtain ⟨_, shapeZ⟩ := relatedZ
      simp [fst.pair, snd.pair] at shapeY, shapeZ
      cc
    . intros m hm
      have shifted := partialDerivativeOf.support at R, I, i, p, m with *
      refine ⟨shiftMonomial(I, m, i), shifted, _⟩
      apply derivativeSupportShift.membership.backward
      refine ⟨(product.pair with hm, shifted), _⟩
      simp [fst.pair, snd.pair]
  . intros x hx y hy z hz relatedX relatedY
    obtain ⟨_, shapeX⟩ := relatedX
    obtain ⟨_, shapeY⟩ := relatedY
    simp [fst.pair, snd.pair] at shapeX, shapeY
    have dataX := functionSupport.membership.forward with hx
    have dataY := functionSupport.membership.forward with hy
    have equal : shiftMonomial(I, x, i) = shiftMonomial(I, y, i) by cc
    exact shiftMonomial.injective at I, i, x, y
      with index, dataX.left, dataY.left, equal

theorem partialDerivativeOf.finite_support (p : Set)
  requires polynomial : p ∈ polynomials(I, R.carrier, R.zero)
  shows Finite(functionSupport(partialDerivativeOf(R, I, i, p), monomials(I),
    R.zero))
proof
  have finite := polynomials.finite_support with polynomial
  have injective :=
    partialDerivativeOf.support_injection at R, I, i, p with *
  have dominated : Dominated(functionSupport(partialDerivativeOf(R, I, i, p),
      monomials(I), R.zero), functionSupport(p, monomials(I), R.zero))
    witness derivativeSupportShift(R, I, i, p)
    exact injective
  exact Finite.of_dominated with finite, dominated

theorem partialDerivativeOf.member (p : Set)
  requires polynomial : p ∈ polynomials(I, R.carrier, R.zero)
  shows partialDerivativeOf(R, I, i, p) ∈ polynomials(I, R.carrier, R.zero)
proof
  have function := partialDerivativeOf.function at R, I, i, p with *
  have finite := partialDerivativeOf.finite_support at R, I, i, p with *
  apply polynomials.contains
  unfold CoefficientMap
  exact ⟨function, finite⟩

end Coefficients

-- Generation. Polynomials are generated from the constants and the
-- variables by sums and products: the induction principle in that form,
-- through the monomial induction on the terms with coefficient one.
theorem polynomialConstant.term (I A zero a : Set)
  shows polynomialConstant(I, A, zero, a) =
    polynomialTerm(I, A, zero, a, monomialOne(I))
proof
  simp [Polynomial.polynomialConstant]

theorem polynomials.generated (I A add zero neg mul one S p : Set)
  requires ring : IsCommRing(A, add, zero, neg, mul, one)
  requires member : p ∈ polynomials(I, A, zero)
  requires constants : ∀ a ∈ A, polynomialConstant(I, A, zero, a) ∈ S
  requires variables : ∀ j ∈ I, polynomialVariable(I, A, zero, one, j) ∈ S
  requires sums : ∀ f ∈ S, ∀ g ∈ S,
    coefficientAdd(monomials(I), A, add, zero, neg, mul, one, f, g) ∈ S
  requires products : ∀ f ∈ S, ∀ g ∈ S,
    polynomialProduct(I, A, add, zero, neg, mul, one, f, g) ∈ S
  shows p ∈ S
proof
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have multiplicative := IsRing.multiplicative with ordinary
  have oneIn := IsMonoid.unit_in_carrier with multiplicative
  have unitMonomial := monomialOne.member at I
  have base : constantFunction(monomials(I), A, zero) ∈ S
    have zeroConstant := polynomialConstant.zero at I, A, zero with zeroIn
    have inS := constants with zero, zeroIn
    rwa zeroConstant at inS
  have unit : monomialOne(I) ∈ subalgebraMonomials(I, A, zero, one, S)
    have inS := constants with one, oneIn
    rw polynomialConstant.term at inS
    exact subalgebraMonomials.membership.backward with ⟨unitMonomial, inS⟩
  have monomialVariables : ∀ j ∈ I,
      monomialVariable(I, j) ∈ subalgebraMonomials(I, A, zero, one, S)
    intros j hj
    have inS := variables with j, hj
    have variable := monomialVariable.member at I, j
    unfold polynomialVariable at inS
    exact subalgebraMonomials.membership.backward with ⟨variable, inS⟩
  have monomialProducts : ∀ m ∈ subalgebraMonomials(I, A, zero, one, S),
      ∀ n ∈ subalgebraMonomials(I, A, zero, one, S),
      monomialProduct(I, m, n) ∈ subalgebraMonomials(I, A, zero, one, S)
    intros m hm n hn
    have dataM := subalgebraMonomials.membership.forward with hm
    have dataN := subalgebraMonomials.membership.forward with hn
    have product := monomialProduct.member with dataM.left, dataN.left
    have termProduct := polynomialProduct.terms at I, A, add, zero, neg, mul,
      one, one, one, m, n with *
    have unitLaw := IsCommRing.one_right with ring, oneIn
    rw unitLaw at termProduct
    have inS := products with polynomialTerm(I, A, zero, one, m), dataM.right,
      polynomialTerm(I, A, zero, one, n), dataN.right
    rw termProduct at inS
    exact subalgebraMonomials.membership.backward with ⟨product, inS⟩
  have terms : ∀ a ∈ A, ∀ m ∈ monomials(I),
      polynomialTerm(I, A, zero, a, m) ∈ S
    intros a ha m hm
    have generated := monomials.induction
      at I, subalgebraMonomials(I, A, zero, one, S), m
      with unit, monomialVariables, monomialProducts, hm
    have data := subalgebraMonomials.membership.forward with generated
    have constant := constants with a, ha
    have inS := products with polynomialConstant(I, A, zero, a), constant,
      polynomialTerm(I, A, zero, one, m), data.right
    have termProduct := polynomialProduct.terms at I, A, add, zero, neg, mul,
      one, a, one, monomialOne(I), m with *
    have scalar := IsCommRing.one_right with ring, ha
    have commute := monomialProduct.commutative with unitMonomial, hm
    have unitMonomialLaw := monomialProduct.one with hm
    rw polynomialConstant.term at inS
    rw [termProduct, scalar, commute, unitMonomialLaw] at inS
    exact inS
  exact polynomials.induction with ring, member, base, terms, sums

-- Multiplication by a constant scales every coefficient, by the same
-- induction on the polynomial.
def constantMultiples (I A add zero neg mul one a : Set) : Set :=
  { f ∈ polynomials(I, A, zero) | ∀ n ∈ monomials(I),
    polynomialProduct(I, A, add, zero, neg, mul, one,
      polynomialConstant(I, A, zero, a), f)(n) = call2(mul, a, f(n)) }

theorem polynomialProduct.constant_scale (I A add zero neg mul one a q m : Set)
  requires ring : IsCommRing(A, add, zero, neg, mul, one)
  requires scalar : a ∈ A
  requires polynomial : q ∈ polynomials(I, A, zero)
  requires monomial : m ∈ monomials(I)
  shows polynomialProduct(I, A, add, zero, neg, mul, one,
    polynomialConstant(I, A, zero, a), q)(m) = call2(mul, a, q(m))
proof
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have constant := polynomialConstant.member at I, A, zero, a with *
  have annihilate := IsRing.mul_zero with ordinary, scalar
  have unitMonomial := monomialOne.member at I
  have base : constantFunction(monomials(I), A, zero) ∈
      constantMultiples(I, A, add, zero, neg, mul, one, a)
    have zeroPoly :=
      polynomials.zero at I, A, add, zero, neg, mul, one with ring
    have product := polynomialProduct.zero_right at I, A, add, zero, neg,
      mul, one, polynomialConstant(I, A, zero, a) with *
    apply constantMultiples.membership.backward
    refine ⟨zeroPoly, _⟩
    intros n hn
    have zeroValue := constantFunction.apply at monomials(I), A, n, zero with *
    rw [product, zeroValue]
    symm
    exact annihilate
  have terms : ∀ b ∈ A, ∀ n ∈ monomials(I),
      polynomialTerm(I, A, zero, b, n) ∈
        constantMultiples(I, A, add, zero, neg, mul, one, a)
    intros b hb n hn
    have term := polynomialTerm.member at I, A, zero, b, n with *
    have termProduct := polynomialProduct.terms at I, A, add, zero, neg, mul,
      one, a, b, monomialOne(I), n with *
    have commute := monomialProduct.commutative with unitMonomial, hn
    have unitLaw := monomialProduct.one with hn
    have productIn := IsRing.mul_closed with ordinary, scalar, hb
    apply constantMultiples.membership.backward
    refine ⟨term, _⟩
    intros k hk
    rw [polynomialConstant.term, termProduct, commute, unitLaw]
    have alternatives : k = n ∨ k ≠ n by tauto
    cases alternatives with same | different
    . rw same
      have left :=
        polynomialTerm.same at I, A, zero, call2(mul, a, b), n with *
      have right := polynomialTerm.same at I, A, zero, b, n with *
      rw [left, right]
      rfl
    . have left :=
        polynomialTerm.other at I, A, zero, call2(mul, a, b), n, k with *
      have right := polynomialTerm.other at I, A, zero, b, n, k with *
      rw [left, right]
      symm
      exact annihilate
  have sums : ∀ f ∈ constantMultiples(I, A, add, zero, neg, mul, one, a),
      ∀ g ∈ constantMultiples(I, A, add, zero, neg, mul, one, a),
      coefficientAdd(monomials(I), A, add, zero, neg, mul, one, f, g) ∈
        constantMultiples(I, A, add, zero, neg, mul, one, a)
    intros f hf g hg
    have dataF := constantMultiples.membership.forward with hf
    have dataG := constantMultiples.membership.forward with hg
    have memberF := dataF.left
    have memberG := dataG.left
    have sum := polynomials.add at I, A, add, zero, neg, mul, one, f, g with *
    have distribute := polynomialProduct.add_right at I, A, add, zero, neg,
      mul, one, polynomialConstant(I, A, zero, a), f, g with *
    have productF := polynomialProduct.member at I, A, add, zero, neg, mul,
      one, polynomialConstant(I, A, zero, a), f with *
    have productG := polynomialProduct.member at I, A, add, zero, neg, mul,
      one, polynomialConstant(I, A, zero, a), g with *
    have functionF := polynomials.function with memberF
    have functionG := polynomials.function with memberG
    have functionPF := polynomials.function with productF
    have functionPG := polynomials.function with productG
    apply constantMultiples.membership.backward
    refine ⟨sum, _⟩
    intros n hn
    have valueF := dataF.right with n, hn
    have valueG := dataG.right with n, hn
    have fIn := polynomials.coefficient at I, A, zero, f, n with *
    have gIn := polynomials.coefficient at I, A, zero, g, n with *
    have sumValue := coefficientAdd.value at monomials(I), A, add, zero, neg,
      mul, one, f, g, n with *
    have productValue := coefficientAdd.value at monomials(I), A, add, zero,
      neg, mul, one,
      polynomialProduct(I, A, add, zero, neg, mul, one,
        polynomialConstant(I, A, zero, a), f),
      polynomialProduct(I, A, add, zero, neg, mul, one,
        polynomialConstant(I, A, zero, a), g), n with *
    have law := IsCommRing.mul_add with ring, scalar, fIn, gIn
    rw [distribute, productValue, valueF, valueG, sumValue]
    symm
    exact law
  have generated :=
    polynomials.induction with ring, polynomial, base, terms, sums
  have data := constantMultiples.membership.forward with generated
  exact data.right with m, monomial

-- The bundled polynomial ring and its coefficient engine: membership in
-- the ring is membership in the polynomial carrier, equality is
-- coefficientwise, and the sum, negative, zero, and product have their
-- coefficient formulas.
section Carrier
variable (R I : Set)
hypothesis ring : CommRing(R)
hypothesis polynomials : CommRing(polynomialRing(R, I))

theorem polynomialRing.member_parts (p : polynomialRing(R, I))
  shows p ∈ polynomials(I, R.carrier, R.zero)
proof
  have member : p ∈ Ring.carrier(polynomialRing(R, I)) by assumption
  rw polynomialRing.carrierOf at member
  exact member

theorem polynomialRing.member_of_parts (p : Set)
  requires polynomial : p ∈ polynomials(I, R.carrier, R.zero)
  shows p ∈ Ring.carrier(polynomialRing(R, I))
proof
  rw polynomialRing.carrierOf
  exact polynomial

theorem polynomialRing.coefficient_mem (p : polynomialRing(R, I)) (m : Set)
  requires monomial : m ∈ monomials(I)
  shows p(m) ∈ R.carrier
proof
  have polynomial := polynomialRing.member_parts at R, I, p with *
  exact polynomials.coefficient with polynomial, monomial

theorem polynomialRing.ext (p q : polynomialRing(R, I))
  requires coefficients : ∀ m ∈ monomials(I), p(m) = q(m)
  shows p = q
proof
  have left := polynomialRing.member_parts at R, I, p with *
  have right := polynomialRing.member_parts at R, I, q with *
  exact polynomials.ext with left, right, coefficients

theorem polynomialRing.add_apply (p q : polynomialRing(R, I))
  shows p + q = coefficientAdd(monomials(I), R.carrier, R.add, R.zero, R.neg,
    R.mul, R.one, p, q)
proof
  have parts := CommRing.parts with ring
  have left := polynomialRing.member_parts at R, I, p with *
  have right := polynomialRing.member_parts at R, I, q with *
  have value := polynomialAdd.apply at I, R.carrier, R.add, R.zero, R.neg,
    R.mul, R.one, p, q with *
  rw polynomialRing.addOf
  exact value

theorem polynomialRing.coefficient_add (p q : polynomialRing(R, I)) (m : Set)
  requires monomial : m ∈ monomials(I)
  shows (p + q)(m) = call2(R.add, p(m), q(m))
proof
  have parts := CommRing.parts with ring
  have left := polynomialRing.member_parts at R, I, p with *
  have right := polynomialRing.member_parts at R, I, q with *
  have functionP := polynomials.function with left
  have functionQ := polynomials.function with right
  have sum := polynomialRing.add_apply at R, I, p, q with *
  rw sum
  exact coefficientAdd.value at monomials(I), R.carrier, R.add, R.zero, R.neg,
    R.mul, R.one, p, q, m with *

theorem polynomialRing.neg_apply (p : polynomialRing(R, I))
  shows -p = coefficientNeg(monomials(I), R.carrier, R.add, R.zero, R.neg,
    R.mul, R.one, p)
proof
  have parts := CommRing.parts with ring
  have member := polynomialRing.member_parts at R, I, p with *
  have value := polynomialNeg.apply at I, R.carrier, R.add, R.zero, R.neg,
    R.mul, R.one, p with *
  rw polynomialRing.negOf
  exact value

theorem polynomialRing.coefficient_neg (p : polynomialRing(R, I)) (m : Set)
  requires monomial : m ∈ monomials(I)
  shows (-p)(m) = R.neg(p(m))
proof
  have parts := CommRing.parts with ring
  have member := polynomialRing.member_parts at R, I, p with *
  have function := polynomials.function with member
  have negative := polynomialRing.neg_apply at R, I, p with *
  rw negative
  exact coefficientNeg.value at monomials(I), R.carrier, R.add, R.zero, R.neg,
    R.mul, R.one, p, m with *

theorem polynomialRing.coefficient_zero (m : Set)
  requires monomial : m ∈ monomials(I)
  shows Ring.zero(polynomialRing(R, I))(m) = R.zero
proof
  have zeroIn : R[0] ∈ R := Ring.zero_mem with *
  rw polynomialRing.zeroOf
  exact constantFunction.apply with monomial, zeroIn

theorem polynomialRing.mul_apply (p q : polynomialRing(R, I))
  shows p * q = polynomialProduct(I, R.carrier, R.add, R.zero, R.neg, R.mul,
    R.one, p, q)
proof
  have parts := CommRing.parts with ring
  have left := polynomialRing.member_parts at R, I, p with *
  have right := polynomialRing.member_parts at R, I, q with *
  have value := polynomialMul.apply at I, R.carrier, R.add, R.zero, R.neg,
    R.mul, R.one, p, q with *
  rw polynomialRing.mulOf
  exact value

-- The coefficients of a variable and of a constant.
theorem X.coefficient_same (j : Set)
  requires member : j ∈ I
  shows X(R, I, j)(monomialVariable(I, j)) = R.one
proof
  have zeroIn : R[0] ∈ R := Ring.zero_mem with *
  have oneIn : R[1] ∈ R := Ring.one_mem with *
  rw X.value
  exact polynomialVariable.coefficient at I, R.carrier, R.zero, R.one, j with *

theorem X.coefficient_other (j n : Set)
  requires monomial : n ∈ monomials(I)
  requires different : n ≠ monomialVariable(I, j)
  shows X(R, I, j)(n) = R.zero
proof
  have zeroIn : R[0] ∈ R := Ring.zero_mem with *
  have oneIn : R[1] ∈ R := Ring.one_mem with *
  rw X.value
  unfold polynomialVariable
  exact polynomialTerm.other at I, R.carrier, R.zero, R.one,
    monomialVariable(I, j), n with *

theorem polynomialConstant.coefficient_other (a : R) (n : Set)
  requires monomial : n ∈ monomials(I)
  requires different : n ≠ monomialOne(I)
  shows polynomialConstant(R, I)(a)(n) = R.zero
proof
  have aIn : a ∈ R by assumption
  have zeroIn : R[0] ∈ R := Ring.zero_mem with *
  have value := polynomialConstant.apply at R, I, a with *
  have selected :=
    polynomialConstant.value at I, R.carrier, R.zero, a, n with *
  have other :=
    singleValue.other at R.carrier, R.zero, a, monomialOne(I), n with *
  rw [value, selected, other]
  rfl

-- The coefficients of a product by a constant and by a variable: a
-- constant scales every coefficient; Xⱼ moves the coefficient at n to the
-- monomial Xⱼ·n and leaves zero at every monomial with exponent zero in j.
theorem polynomialRing.constant_mul (a : R) (q : polynomialRing(R, I)) (m : Set)
  requires monomial : m ∈ monomials(I)
  shows (polynomialConstant(R, I)(a) * q)(m) = call2(R.mul, a, q(m))
proof
  have aIn : a ∈ R by assumption
  have parts := CommRing.parts with ring
  have constantIn : polynomialConstant(R, I)(a) ∈ polynomialRing(R, I) :=
    polynomialConstant.mem at R, I, a with *
  have qParts := polynomialRing.member_parts at R, I, q with *
  have product :=
    polynomialRing.mul_apply at R, I, polynomialConstant(R, I)(a), q with *
  have value := polynomialConstant.apply at R, I, a with *
  rw [product, value]
  exact polynomialProduct.constant_scale at I, R.carrier, R.add, R.zero,
    R.neg, R.mul, R.one, a, q, m with *

theorem polynomialRing.X_mul (j : Set) (q : polynomialRing(R, I)) (n : Set)
  requires member : j ∈ I
  requires monomial : n ∈ monomials(I)
  shows (X(R, I, j) * q)(monomialProduct(I, monomialVariable(I, j), n)) = q(n)
proof
  have parts := CommRing.parts with ring
  have variableIn : X(R, I, j) ∈ polynomialRing(R, I) :=
    X.mem at R, I, j with *
  have qParts := polynomialRing.member_parts at R, I, q with *
  have variable := monomialVariable.member at I, j
  have product := polynomialRing.mul_apply at R, I, X(R, I, j), q with *
  rw [product, X.value]
  unfold polynomialVariable
  exact polynomialProduct.monomial_shift at I, R.carrier, R.add, R.zero,
    R.neg, R.mul, R.one, monomialVariable(I, j), n, q with *

theorem polynomialRing.X_mul_zero (j : Set) (q : polynomialRing(R, I)) (m : Set)
  requires member : j ∈ I
  requires monomial : m ∈ monomials(I)
  requires exponent : m(j) = 0
  shows (X(R, I, j) * q)(m) = R.zero
proof
  have parts := CommRing.parts with ring
  have variableIn : X(R, I, j) ∈ polynomialRing(R, I) :=
    X.mem at R, I, j with *
  have qParts := polynomialRing.member_parts at R, I, q with *
  have product := polynomialRing.mul_apply at R, I, X(R, I, j), q with *
  rw [product, X.value]
  exact polynomialProduct.variable_zero at I, R.carrier, R.add, R.zero, R.neg,
    R.mul, R.one, j, m, q with *

end Carrier

-- The rules of differentiation. The derivative is a function on the
-- carrier with the coefficient formula; it is additive, kills constants,
-- sends Xᵢ to 1 and the other variables to 0, satisfies the Leibniz rule
-- (first against a constant and a variable, then for all polynomials by
-- generation), and so the power rule.
predicate LeibnizRule (R I i p : Set) :=
  ∀ q ∈ Ring.carrier(polynomialRing(R, I)),
    partialDerivative(R, I, i)(call2(Ring.mul(polynomialRing(R, I)), p, q)) =
    call2(Ring.add(polynomialRing(R, I)),
      call2(Ring.mul(polynomialRing(R, I)), partialDerivative(R, I, i)(p), q),
      call2(Ring.mul(polynomialRing(R, I)), p, partialDerivative(R, I, i)(q)))

def leibnizPolynomials (R I i : Set) : Set :=
  { f ∈ polynomials(I, Ring.carrier(R), Ring.zero(R)) |
    LeibnizRule(R, I, i, f) }

section Rules
variable (R I i : Set)
hypothesis ring : CommRing(R)
hypothesis polynomials : CommRing(polynomialRing(R, I))
hypothesis index : i ∈ I

theorem partialDerivative.function
  shows partialDerivative(R, I, i) :
    Ring.carrier(polynomialRing(R, I)) → Ring.carrier(polynomialRing(R, I))
proof
  constructor
  . intros e he
    exact he.left
  constructor
  . intros x y relatedY z relatedZ
    obtain ⟨_, shapeY⟩ := relatedY
    obtain ⟨_, shapeZ⟩ := relatedZ
    simp [fst.pair, snd.pair] at shapeY, shapeZ
    cc
  . intros p hp
    have polynomial := polynomialRing.member_parts at R, I, p with *
    have derivative := partialDerivativeOf.member at R, I, i, p with *
    have inCarrier := polynomialRing.member_of_parts at R, I,
      partialDerivativeOf(R, I, i, p) with *
    refine ⟨partialDerivativeOf(R, I, i, p), inCarrier, _⟩
    apply partialDerivative.membership.backward
    refine ⟨(product.pair with hp, inCarrier), _⟩
    simp [fst.pair, snd.pair]

theorem partialDerivative.apply (p : polynomialRing(R, I))
  shows partialDerivative(R, I, i)(p) = partialDerivativeOf(R, I, i, p)
proof
  have member : p ∈ Ring.carrier(polynomialRing(R, I)) by assumption
  have polynomial := polynomialRing.member_parts at R, I, p with *
  have function := partialDerivative.function at R, I, i with *
  have derivative := partialDerivativeOf.member at R, I, i, p with *
  have inCarrier := polynomialRing.member_of_parts at R, I,
    partialDerivativeOf(R, I, i, p) with *
  have related :
      relates(partialDerivative(R, I, i), p, partialDerivativeOf(R, I, i, p))
    apply partialDerivative.membership.backward
    refine ⟨(product.pair with member, inCarrier), _⟩
    simp [fst.pair, snd.pair]
  exact FunctionBetween.apply_value with function, member, related

instance partialDerivative.map_mem (p : polynomialRing(R, I))
  shows partialDerivative(R, I, i)(p) ∈ polynomialRing(R, I)
proof
  have member : p ∈ Ring.carrier(polynomialRing(R, I)) by assumption
  have function := partialDerivative.function at R, I, i with *
  exact FunctionBetween.apply_closed with function, member

theorem partialDerivative.coefficient (p : polynomialRing(R, I)) (m : Set)
  requires monomial : m ∈ monomials(I)
  shows partialDerivative(R, I, i)(p)(m) =
    call2(R.mul, ringNat(R.add, R.zero, R.one, succ(m(i))),
      p(shiftMonomial(I, m, i)))
proof
  have polynomial := polynomialRing.member_parts at R, I, p with *
  have value := partialDerivative.apply at R, I, i, p with *
  rw value
  exact partialDerivativeOf.coefficient at R, I, i, p, m with *

theorem partialDerivative.add (p q : polynomialRing(R, I))
  shows partialDerivative(R, I, i)(p + q) =
    partialDerivative(R, I, i)(p) + partialDerivative(R, I, i)(q)
proof
  have sumIn : p + q ∈ polynomialRing(R, I) := Ring.add_mem with *
  have leftIn : partialDerivative(R, I, i)(p) ∈ polynomialRing(R, I) :=
    partialDerivative.map_mem at R, I, i, p with *
  have rightIn : partialDerivative(R, I, i)(q) ∈ polynomialRing(R, I) :=
    partialDerivative.map_mem at R, I, i, q with *
  have coefficients : ∀ m ∈ monomials(I),
      partialDerivative(R, I, i)(p + q)(m) =
      (partialDerivative(R, I, i)(p) + partialDerivative(R, I, i)(q))(m)
    intros m hm
    have shifted := shiftMonomial.member at I, i, m with *
    have numeral := partialDerivativeOf.numeral_mem at R, I, i, m with *
    have pIn :=
      polynomialRing.coefficient_mem at R, I, p, shiftMonomial(I, m, i) with *
    have qIn :=
      polynomialRing.coefficient_mem at R, I, q, shiftMonomial(I, m, i) with *
    have left := partialDerivative.coefficient at R, I, i, p + q, m with *
    have right := polynomialRing.coefficient_add at R, I,
      partialDerivative(R, I, i)(p), partialDerivative(R, I, i)(q), m with *
    have derivativeP := partialDerivative.coefficient at R, I, i, p, m with *
    have derivativeQ := partialDerivative.coefficient at R, I, i, q, m with *
    have sum := polynomialRing.coefficient_add at R, I, p, q,
      shiftMonomial(I, m, i) with *
    rw [left, right, derivativeP, derivativeQ, sum]
    ring
  exact polynomialRing.ext at R, I, partialDerivative(R, I, i)(p + q),
    partialDerivative(R, I, i)(p) + partialDerivative(R, I, i)(q) with *

theorem partialDerivative.neg (p : polynomialRing(R, I))
  shows partialDerivative(R, I, i)(-p) = -partialDerivative(R, I, i)(p)
proof
  have negIn : -p ∈ polynomialRing(R, I) := Ring.neg_mem with *
  have derivativeIn : partialDerivative(R, I, i)(p) ∈ polynomialRing(R, I) :=
    partialDerivative.map_mem at R, I, i, p with *
  have coefficients : ∀ m ∈ monomials(I),
      partialDerivative(R, I, i)(-p)(m) = (-partialDerivative(R, I, i)(p))(m)
    intros m hm
    have shifted := shiftMonomial.member at I, i, m with *
    have numeral := partialDerivativeOf.numeral_mem at R, I, i, m with *
    have pIn :=
      polynomialRing.coefficient_mem at R, I, p, shiftMonomial(I, m, i) with *
    have left := partialDerivative.coefficient at R, I, i, -p, m with *
    have right := polynomialRing.coefficient_neg at R, I,
      partialDerivative(R, I, i)(p), m with *
    have derivativeP := partialDerivative.coefficient at R, I, i, p, m with *
    have negative := polynomialRing.coefficient_neg at R, I, p,
      shiftMonomial(I, m, i) with *
    rw [left, right, derivativeP, negative]
    ring
  exact polynomialRing.ext at R, I, partialDerivative(R, I, i)(-p),
    -partialDerivative(R, I, i)(p) with *

theorem partialDerivative.constant (a : R)
  shows partialDerivative(R, I, i)(polynomialConstant(R, I)(a)) =
    Ring.zero(polynomialRing(R, I))
proof
  have aIn : a ∈ R by assumption
  have constantIn : polynomialConstant(R, I)(a) ∈ polynomialRing(R, I) :=
    polynomialConstant.mem at R, I, a with *
  have zeroPoly : Ring.zero(polynomialRing(R, I)) ∈ polynomialRing(R, I) :=
    Ring.zero_mem with *
  have coefficients : ∀ m ∈ monomials(I),
      partialDerivative(R, I, i)(polynomialConstant(R, I)(a))(m) =
      Ring.zero(polynomialRing(R, I))(m)
    intros m hm
    have shifted := shiftMonomial.member at I, i, m with *
    have numeral := partialDerivativeOf.numeral_mem at R, I, i, m with *
    have different := shiftMonomial.ne_one at I, i, m with *
    have left := partialDerivative.coefficient at R, I, i,
      polynomialConstant(R, I)(a), m with *
    have right := polynomialRing.coefficient_zero at R, I, m with *
    have vanishes := polynomialConstant.coefficient_other at R, I, a,
      shiftMonomial(I, m, i) with *
    rw [left, right, vanishes]
    ring
  exact polynomialRing.ext at R, I,
    partialDerivative(R, I, i)(polynomialConstant(R, I)(a)),
    Ring.zero(polynomialRing(R, I)) with *

theorem partialDerivative.X_self
  shows partialDerivative(R, I, i)(X(R, I, i)) = Ring.one(polynomialRing(R, I))
proof
  have zeroIn : R[0] ∈ R := Ring.zero_mem with *
  have oneIn : R[1] ∈ R := Ring.one_mem with *
  have variableIn : X(R, I, i) ∈ polynomialRing(R, I) :=
    X.mem at R, I, i with *
  have onePoly : Ring.one(polynomialRing(R, I)) ∈ polynomialRing(R, I) :=
    Ring.one_mem with *
  have unit := monomialOne.member at I
  have variable := monomialVariable.member at I, i
  have shiftUnit : shiftMonomial(I, monomialOne(I), i) = monomialVariable(I, i)
    have product := shiftMonomial.product at I, i, monomialOne(I) with *
    have law := monomialProduct.one with variable
    cc
  have coefficients : ∀ m ∈ monomials(I),
      partialDerivative(R, I, i)(X(R, I, i))(m) =
      Ring.one(polynomialRing(R, I))(m)
    intros m hm
    have shifted := shiftMonomial.member at I, i, m with *
    have numeral := partialDerivativeOf.numeral_mem at R, I, i, m with *
    have left := partialDerivative.coefficient at R, I, i, X(R, I, i), m with *
    rw [left, polynomialRing.oneOf]
    have alternatives : m = monomialOne(I) ∨ m ≠ monomialOne(I) by tauto
    cases alternatives with same | different
    . rw same
      have variableValue := X.coefficient_same at R, I, i with *
      have constantValue :=
        polynomialConstant.coefficient at I, R.carrier, R.zero, R.one with *
      have unitExponent := monomialOne.value at I, i with index
      have zeroNat := Naturals.constructor.zero
      have step := ringNat.succ at R.add, R.zero, R.one, 0 with *
      have base := ringNat.zero at R.add, R.zero, R.one
      rw [shiftUnit, variableValue, constantValue, unitExponent, step, base]
      ring
    . have shiftDifferent : shiftMonomial(I, m, i) ≠ monomialVariable(I, i)
        intro equal
        rw ← shiftUnit at equal
        have same :=
          shiftMonomial.injective at I, i, m, monomialOne(I) with *
        exact different with same
      have variableValue :=
        X.coefficient_other at R, I, i, shiftMonomial(I, m, i) with *
      have selected :=
        polynomialConstant.value at I, R.carrier, R.zero, R.one, m with *
      have other :=
        singleValue.other at R.carrier, R.zero, R.one, monomialOne(I), m with *
      rw [variableValue, selected, other]
      ring
  exact polynomialRing.ext at R, I, partialDerivative(R, I, i)(X(R, I, i)),
    Ring.one(polynomialRing(R, I)) with *

theorem partialDerivative.X_other (j : Set)
  requires other : j ∈ I
  requires apart : j ≠ i
  shows partialDerivative(R, I, i)(X(R, I, j)) = Ring.zero(polynomialRing(R, I))
proof
  have zeroIn : R[0] ∈ R := Ring.zero_mem with *
  have variableIn : X(R, I, j) ∈ polynomialRing(R, I) :=
    X.mem at R, I, j with *
  have zeroPoly : Ring.zero(polynomialRing(R, I)) ∈ polynomialRing(R, I) :=
    Ring.zero_mem with *
  have coefficients : ∀ m ∈ monomials(I),
      partialDerivative(R, I, i)(X(R, I, j))(m) =
      Ring.zero(polynomialRing(R, I))(m)
    intros m hm
    have shifted := shiftMonomial.member at I, i, m with *
    have numeral := partialDerivativeOf.numeral_mem at R, I, i, m with *
    have different := shiftMonomial.ne_variable at I, i, m, j with *
    have left := partialDerivative.coefficient at R, I, i, X(R, I, j), m with *
    have right := polynomialRing.coefficient_zero at R, I, m with *
    have variableValue :=
      X.coefficient_other at R, I, j, shiftMonomial(I, m, i) with *
    rw [left, right, variableValue]
    ring
  exact polynomialRing.ext at R, I, partialDerivative(R, I, i)(X(R, I, j)),
    Ring.zero(polynomialRing(R, I)) with *

-- The Leibniz rule against a constant and against a variable.
theorem partialDerivative.constant_mul (a : R) (q : polynomialRing(R, I))
  shows partialDerivative(R, I, i)(polynomialConstant(R, I)(a) * q) =
    polynomialConstant(R, I)(a) * partialDerivative(R, I, i)(q)
proof
  have aIn : a ∈ R by assumption
  have constantIn : polynomialConstant(R, I)(a) ∈ polynomialRing(R, I) :=
    polynomialConstant.mem at R, I, a with *
  have productIn : polynomialConstant(R, I)(a) * q ∈ polynomialRing(R, I) :=
    Ring.mul_mem with *
  have derivativeIn : partialDerivative(R, I, i)(q) ∈ polynomialRing(R, I) :=
    partialDerivative.map_mem at R, I, i, q with *
  have rightIn : polynomialConstant(R, I)(a) * partialDerivative(R, I, i)(q) ∈
    polynomialRing(R, I) := Ring.mul_mem with *
  have coefficients : ∀ m ∈ monomials(I),
      partialDerivative(R, I, i)(polynomialConstant(R, I)(a) * q)(m) =
      (polynomialConstant(R, I)(a) * partialDerivative(R, I, i)(q))(m)
    intros m hm
    have shifted := shiftMonomial.member at I, i, m with *
    have numeral := partialDerivativeOf.numeral_mem at R, I, i, m with *
    have qIn :=
      polynomialRing.coefficient_mem at R, I, q, shiftMonomial(I, m, i) with *
    have left := partialDerivative.coefficient at R, I, i,
      polynomialConstant(R, I)(a) * q, m with *
    have productValue := polynomialRing.constant_mul at R, I, a, q,
      shiftMonomial(I, m, i) with *
    have right := polynomialRing.constant_mul at R, I, a,
      partialDerivative(R, I, i)(q), m with *
    have derivativeQ := partialDerivative.coefficient at R, I, i, q, m with *
    rw [left, productValue, right, derivativeQ]
    ring
  exact polynomialRing.ext at R, I,
    partialDerivative(R, I, i)(polynomialConstant(R, I)(a) * q),
    polynomialConstant(R, I)(a) * partialDerivative(R, I, i)(q) with *

theorem partialDerivative.X_self_mul (q : polynomialRing(R, I))
  shows partialDerivative(R, I, i)(X(R, I, i) * q) =
    q + X(R, I, i) * partialDerivative(R, I, i)(q)
proof
  have qIn : q ∈ polynomialRing(R, I) by assumption
  have variableIn : X(R, I, i) ∈ polynomialRing(R, I) :=
    X.mem at R, I, i with *
  have productIn : X(R, I, i) * q ∈ polynomialRing(R, I) :=
    Ring.mul_mem with *
  have derivativeIn : partialDerivative(R, I, i)(q) ∈ polynomialRing(R, I) :=
    partialDerivative.map_mem at R, I, i, q with *
  have shiftedIn : X(R, I, i) * partialDerivative(R, I, i)(q) ∈
    polynomialRing(R, I) := Ring.mul_mem with *
  have rightIn : q + X(R, I, i) * partialDerivative(R, I, i)(q) ∈
    polynomialRing(R, I) := Ring.add_mem with *
  have coefficients : ∀ m ∈ monomials(I),
      partialDerivative(R, I, i)(X(R, I, i) * q)(m) =
      (q + X(R, I, i) * partialDerivative(R, I, i)(q))(m)
    intros m hm
    have shifted := shiftMonomial.member at I, i, m with *
    have numeral := partialDerivativeOf.numeral_mem at R, I, i, m with *
    have qValue := polynomialRing.coefficient_mem at R, I, q, m with *
    have left :=
      partialDerivative.coefficient at R, I, i, X(R, I, i) * q, m with *
    have productForm := shiftMonomial.product at I, i, m with *
    have productValue := polynomialRing.X_mul at R, I, i, q, m with *
    have right := polynomialRing.coefficient_add at R, I, q,
      X(R, I, i) * partialDerivative(R, I, i)(q), m with *
    rw [left, productForm, productValue, right]
    have alternatives : m(i) = 0 ∨ m(i) ≠ 0 by tauto
    cases alternatives with vanishes | nonzero
    . have shiftValue := polynomialRing.X_mul_zero at R, I, i,
        partialDerivative(R, I, i)(q), m with *
      have zeroNat := Naturals.constructor.zero
      have step := ringNat.succ at R.add, R.zero, R.one, 0 with *
      have base := ringNat.zero at R.add, R.zero, R.one
      rw [shiftValue, vanishes, step, base]
      ring
    . obtain ⟨n, hn, equal⟩ := monomials.unshift at I, i, m with *
      have shiftN := shiftMonomial.member at I, i, n with *
      have exponentN := monomials.exponent with hn, index
      have naturalN := Naturals.constructor.succ with exponentN
      have numeralN := partialDerivativeOf.numeral_mem at R, I, i, n with *
      have productN := shiftMonomial.product at I, i, n with *
      have exponentM : m(i) = succ(n(i))
        have same := shiftMonomial.same at I, i, n with *
        rw equal
        exact same
      have shiftValue : (X(R, I, i) * partialDerivative(R, I, i)(q))(m) =
          partialDerivative(R, I, i)(q)(n)
        have value := polynomialRing.X_mul at R, I, i,
          partialDerivative(R, I, i)(q), n with *
        rw [equal, productN]
        exact value
      have derivativeN := partialDerivative.coefficient at R, I, i, q, n with *
      have qShift : q(shiftMonomial(I, n, i)) = q(m)
        rw equal
        rfl
      have step := ringNat.succ at R.add, R.zero, R.one, succ(n(i)) with *
      rw [shiftValue, derivativeN, qShift, exponentM, step]
      ring
  exact polynomialRing.ext at R, I, partialDerivative(R, I, i)(X(R, I, i) * q),
    q + X(R, I, i) * partialDerivative(R, I, i)(q) with *

theorem partialDerivative.X_other_mul (j : Set) (q : polynomialRing(R, I))
  requires other : j ∈ I
  requires apart : j ≠ i
  shows partialDerivative(R, I, i)(X(R, I, j) * q) =
    X(R, I, j) * partialDerivative(R, I, i)(q)
proof
  have qIn : q ∈ polynomialRing(R, I) by assumption
  have reverse : i ≠ j by cc
  have variableIn : X(R, I, j) ∈ polynomialRing(R, I) :=
    X.mem at R, I, j with *
  have productIn : X(R, I, j) * q ∈ polynomialRing(R, I) :=
    Ring.mul_mem with *
  have derivativeIn : partialDerivative(R, I, i)(q) ∈ polynomialRing(R, I) :=
    partialDerivative.map_mem at R, I, i, q with *
  have rightIn : X(R, I, j) * partialDerivative(R, I, i)(q) ∈
    polynomialRing(R, I) := Ring.mul_mem with *
  have variableI := monomialVariable.member at I, i
  have variableJ := monomialVariable.member at I, j
  have coefficients : ∀ m ∈ monomials(I),
      partialDerivative(R, I, i)(X(R, I, j) * q)(m) =
      (X(R, I, j) * partialDerivative(R, I, i)(q))(m)
    intros m hm
    have shifted := shiftMonomial.member at I, i, m with *
    have numeral := partialDerivativeOf.numeral_mem at R, I, i, m with *
    have left :=
      partialDerivative.coefficient at R, I, i, X(R, I, j) * q, m with *
    rw left
    have alternatives : m(j) = 0 ∨ m(j) ≠ 0 by tauto
    cases alternatives with vanishes | nonzero
    . have shiftExponent : shiftMonomial(I, m, i)(j) = 0
        have value := shiftMonomial.other at I, i, m, j with *
        rw value
        exact vanishes
      have productValue := polynomialRing.X_mul_zero at R, I, j, q,
        shiftMonomial(I, m, i) with *
      have right := polynomialRing.X_mul_zero at R, I, j,
        partialDerivative(R, I, i)(q), m with *
      rw [productValue, right]
      ring
    . obtain ⟨n, hn, equal⟩ := monomials.unshift at I, j, m with *
      have productN := shiftMonomial.product at I, j, n with *
      have shiftN := shiftMonomial.member at I, i, n with *
      have exponentM : m(i) = n(i)
        have value := shiftMonomial.other at I, j, n, i with *
        rw equal
        exact value
      have commute : shiftMonomial(I, m, i) =
          monomialProduct(I, monomialVariable(I, j), shiftMonomial(I, n, i))
        have productM := shiftMonomial.product at I, i, m with *
        have productIN := shiftMonomial.product at I, i, n with *
        have assocLeft :=
          monomialProduct.associative with variableI, variableJ, hn
        have swap := monomialProduct.commutative with variableI, variableJ
        have assocRight :=
          monomialProduct.associative with variableJ, variableI, hn
        cc
      have productValue :
          (X(R, I, j) * q)(shiftMonomial(I, m, i)) = q(shiftMonomial(I, n, i))
        have value :=
          polynomialRing.X_mul at R, I, j, q, shiftMonomial(I, n, i) with *
        rw commute
        exact value
      have right : (X(R, I, j) * partialDerivative(R, I, i)(q))(m) =
          partialDerivative(R, I, i)(q)(n)
        have value := polynomialRing.X_mul at R, I, j,
          partialDerivative(R, I, i)(q), n with *
        rw [equal, productN]
        exact value
      have derivativeN := partialDerivative.coefficient at R, I, i, q, n with *
      rw [productValue, right, derivativeN, exponentM]
      rfl
  exact polynomialRing.ext at R, I, partialDerivative(R, I, i)(X(R, I, j) * q),
    X(R, I, j) * partialDerivative(R, I, i)(q) with *

-- The Leibniz rule for all polynomials, by generation: the set of the
-- polynomials satisfying it contains the constants and the variables and
-- is closed under sums and products.
theorem partialDerivative.mul (p q : polynomialRing(R, I))
  shows partialDerivative(R, I, i)(p * q) =
    partialDerivative(R, I, i)(p) * q + p * partialDerivative(R, I, i)(q)
proof
  have parts := CommRing.parts with ring
  have pParts := polynomialRing.member_parts at R, I, p with *
  have qIn : q ∈ Ring.carrier(polynomialRing(R, I)) by assumption
  have constants : ∀ a ∈ R.carrier,
      polynomialConstant(I, R.carrier, R.zero, a) ∈
        leibnizPolynomials(R, I, i)
    intros a ha
    have value := polynomialConstant.apply at R, I, a with *
    have constantIn : polynomialConstant(R, I)(a) ∈ polynomialRing(R, I) :=
      polynomialConstant.mem at R, I, a with *
    have constantParts := polynomialRing.member_parts at R, I,
      polynomialConstant(R, I)(a) with *
    rw ← value
    apply leibnizPolynomials.membership.backward
    refine ⟨constantParts, _⟩
    intros f hf
    have derivativeF : partialDerivative(R, I, i)(f) ∈ polynomialRing(R, I) :=
      partialDerivative.map_mem at R, I, i, f with *
    have scaled := partialDerivative.constant_mul at R, I, i, a, f with *
    have vanishes := partialDerivative.constant at R, I, i, a with *
    rw [scaled, vanishes]
    ring
  have variables : ∀ j ∈ I,
      polynomialVariable(I, R.carrier, R.zero, R.one, j) ∈
        leibnizPolynomials(R, I, i)
    intros j hj
    have variableIn : X(R, I, j) ∈ polynomialRing(R, I) :=
      X.mem at R, I, j with *
    have variableParts := polynomialRing.member_parts at R, I, X(R, I, j) with *
    rw ← X.value
    apply leibnizPolynomials.membership.backward
    refine ⟨variableParts, _⟩
    intros f hf
    have derivativeF : partialDerivative(R, I, i)(f) ∈ polynomialRing(R, I) :=
      partialDerivative.map_mem at R, I, i, f with *
    have alternatives : j = i ∨ j ≠ i by tauto
    cases alternatives with same | apart
    . rw same
      have variableI : X(R, I, i) ∈ polynomialRing(R, I) :=
        X.mem at R, I, i with *
      have rule := partialDerivative.X_self_mul at R, I, i, f with *
      have unit := partialDerivative.X_self at R, I, i with *
      rw [rule, unit]
      ring
    . have rule := partialDerivative.X_other_mul at R, I, i, j, f with *
      have vanishes := partialDerivative.X_other at R, I, i, j with *
      rw [rule, vanishes]
      ring
  have sums : ∀ f ∈ leibnizPolynomials(R, I, i),
      ∀ g ∈ leibnizPolynomials(R, I, i),
      coefficientAdd(monomials(I), R.carrier, R.add, R.zero, R.neg, R.mul,
        R.one, f, g) ∈ leibnizPolynomials(R, I, i)
    intros f hf g hg
    have dataF := leibnizPolynomials.membership.forward with hf
    have dataG := leibnizPolynomials.membership.forward with hg
    have fParts := dataF.left
    have fIn := polynomialRing.member_of_parts at R, I, f with *
    have gParts := dataG.left
    have gIn := polynomialRing.member_of_parts at R, I, g with *
    have sumForm := polynomialRing.add_apply at R, I, f, g with *
    have sumIn : f + g ∈ polynomialRing(R, I) := Ring.add_mem with *
    have sumParts := polynomialRing.member_parts at R, I, f + g with *
    rw ← sumForm
    apply leibnizPolynomials.membership.backward
    refine ⟨sumParts, _⟩
    intros h hh
    have fh : f * h ∈ polynomialRing(R, I) := Ring.mul_mem with *
    have gh : g * h ∈ polynomialRing(R, I) := Ring.mul_mem with *
    have derivativeF : partialDerivative(R, I, i)(f) ∈ polynomialRing(R, I) :=
      partialDerivative.map_mem at R, I, i, f with *
    have derivativeG : partialDerivative(R, I, i)(g) ∈ polynomialRing(R, I) :=
      partialDerivative.map_mem at R, I, i, g with *
    have derivativeH : partialDerivative(R, I, i)(h) ∈ polynomialRing(R, I) :=
      partialDerivative.map_mem at R, I, i, h with *
    have ruleF := dataF.right with h, hh
    have ruleG := dataG.right with h, hh
    have distribute : (f + g) * h = f * h + g * h by ring
    have additive := partialDerivative.add at R, I, i, f * h, g * h with *
    have additiveFG := partialDerivative.add at R, I, i, f, g with *
    rw [distribute, additive, ruleF, ruleG, additiveFG]
    ring
  have products : ∀ f ∈ leibnizPolynomials(R, I, i),
      ∀ g ∈ leibnizPolynomials(R, I, i),
      polynomialProduct(I, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, f, g)
        ∈ leibnizPolynomials(R, I, i)
    intros f hf g hg
    have dataF := leibnizPolynomials.membership.forward with hf
    have dataG := leibnizPolynomials.membership.forward with hg
    have fParts := dataF.left
    have fIn := polynomialRing.member_of_parts at R, I, f with *
    have gParts := dataG.left
    have gIn := polynomialRing.member_of_parts at R, I, g with *
    have productForm := polynomialRing.mul_apply at R, I, f, g with *
    have productIn : f * g ∈ polynomialRing(R, I) := Ring.mul_mem with *
    have productParts := polynomialRing.member_parts at R, I, f * g with *
    rw ← productForm
    apply leibnizPolynomials.membership.backward
    refine ⟨productParts, _⟩
    intros h hh
    have gh : g * h ∈ polynomialRing(R, I) := Ring.mul_mem with *
    have derivativeF : partialDerivative(R, I, i)(f) ∈ polynomialRing(R, I) :=
      partialDerivative.map_mem at R, I, i, f with *
    have derivativeG : partialDerivative(R, I, i)(g) ∈ polynomialRing(R, I) :=
      partialDerivative.map_mem at R, I, i, g with *
    have derivativeH : partialDerivative(R, I, i)(h) ∈ polynomialRing(R, I) :=
      partialDerivative.map_mem at R, I, i, h with *
    have derivativeGH :
        partialDerivative(R, I, i)(g * h) ∈ polynomialRing(R, I) :=
      partialDerivative.map_mem at R, I, i, g * h with *
    have ruleF := dataF.right with g * h, gh
    have ruleG := dataG.right with h, hh
    have ruleFG := dataF.right with g, gIn
    have reassociate : (f * g) * h = f * (g * h) by ring
    rw [reassociate, ruleF, ruleG, ruleFG]
    ring
  have generated := polynomials.generated at I, R.carrier, R.add, R.zero,
    R.neg, R.mul, R.one, leibnizPolynomials(R, I, i), p
    with parts, pParts, constants, variables, sums, products
  have data := leibnizPolynomials.membership.forward with generated
  exact data.right with q, qIn

theorem partialDerivative.pow (p : polynomialRing(R, I)) (n : Nat)
  shows partialDerivative(R, I, i)(p ^ (n + 1)) =
    ringNat(Ring.add(polynomialRing(R, I)), Ring.zero(polynomialRing(R, I)),
      Ring.one(polynomialRing(R, I)), n + 1) * p ^ n *
      partialDerivative(R, I, i)(p)
proof
  induction n
  | zero =>
    have pIn : p ∈ polynomialRing(R, I) by assumption
    have derivativeIn :
        partialDerivative(R, I, i)(p) ∈ polynomialRing(R, I) :=
      partialDerivative.map_mem at R, I, i, p with *
    have onePoly : Ring.one(polynomialRing(R, I)) ∈ polynomialRing(R, I) :=
      Ring.one_mem with *
    have plus := add.left_unit at 1
    have one := Ring.pow_one at polynomialRing(R, I), p with *
    have zeroPow := Ring.pow_zero at polynomialRing(R, I), p with *
    have numeralOne := IsRing.numeral_one with
      (Ring.parts with (CommRing.to_ring with polynomials))
    rw [plus, one, zeroPow, numeralOne]
    ring
  | succ(k) using ih =>
    have pIn : p ∈ polynomialRing(R, I) by assumption
    have derivativeIn :
        partialDerivative(R, I, i)(p) ∈ polynomialRing(R, I) :=
      partialDerivative.map_mem at R, I, i, p with *
    have shift := add.right_one at k with *
    rw ← shift
    have powerIn : p ^ (k + 1) ∈ polynomialRing(R, I) :=
      Ring.pow_mem at polynomialRing(R, I), p, k + 1 with *
    have powerK : p ^ k ∈ polynomialRing(R, I) :=
      Ring.pow_mem at polynomialRing(R, I), p, k with *
    have numeralIn : ringNat(Ring.add(polynomialRing(R, I)),
        Ring.zero(polynomialRing(R, I)), Ring.one(polynomialRing(R, I)), k + 1)
        ∈ polynomialRing(R, I) :=
      Ring.numeral_mem at polynomialRing(R, I), k + 1 with *
    have step := Ring.pow_succ at polynomialRing(R, I), p, k + 1 with *
    have product := partialDerivative.mul at R, I, i, p ^ (k + 1), p with *
    have powStep := Ring.pow_succ at polynomialRing(R, I), p, k with *
    have shiftOne := add.right_one at k + 1 with *
    have numeralStep := ringNat.succ at Ring.add(polynomialRing(R, I)),
      Ring.zero(polynomialRing(R, I)), Ring.one(polynomialRing(R, I)), k + 1
      with *
    rw [step, product, ih, shiftOne, numeralStep, powStep]
    ring

end Rules

-- Finite sums of the values of a graph on n in a bundled ring, with the
-- identity as the weight: membership, bilinear combinations and sums,
-- vanishing, and a sum with a single nonzero term.
section Sums
variable (S : Set)
hypothesis comm : CommRing(S)

theorem indexedRingSum.identity_mem (g : Set, n : Nat)
  shows (∀ k ∈ n, g(k) ∈ Ring.carrier(S)) →
    indexedRingSum(identity(Ring.carrier(S)), g, Ring.add(S), Ring.zero(S), n)
      ∈ Ring.carrier(S)
proof
  intro values
  have parts := CommRing.parts with comm
  have weighted :
      WeightedValues(identity(Ring.carrier(S)), g, Ring.carrier(S), n)
    intros k hk
    have member := values with k, hk
    have value := identity.apply at g(k), Ring.carrier(S) with member
    rw value
    exact member
  exact indexedRingSum.closed at S.carrier, S.add, S.zero, S.neg, S.mul, S.one,
    identity(Ring.carrier(S)), g, n with parts, weighted

theorem indexedRingSum.identity_bilinear (g h s a b : Set, n : Nat)
  requires left : a ∈ Ring.carrier(S)
  requires right : b ∈ Ring.carrier(S)
  shows (∀ k ∈ n, g(k) ∈ Ring.carrier(S)) →
    (∀ k ∈ n, h(k) ∈ Ring.carrier(S)) →
    (∀ k ∈ n, s(k) = call2(Ring.add(S), call2(Ring.mul(S), g(k), b),
      call2(Ring.mul(S), a, h(k)))) →
    indexedRingSum(identity(Ring.carrier(S)), s, Ring.add(S), Ring.zero(S), n) =
      call2(Ring.add(S),
        call2(Ring.mul(S), indexedRingSum(identity(Ring.carrier(S)), g,
          Ring.add(S), Ring.zero(S), n), b),
        call2(Ring.mul(S), a, indexedRingSum(identity(Ring.carrier(S)), h,
          Ring.add(S), Ring.zero(S), n)))
proof
  induction n
  | zero =>
    intros valuesG valuesH equations
    have zeroIn : S[0] ∈ S := Ring.zero_mem with *
    simp [indexedRingSum]
    ring
  | succ(k) using ih =>
    intros valuesG valuesH equations
    have prefixG : ∀ l ∈ k, g(l) ∈ Ring.carrier(S)
      intros l hl
      have next := membership.into_successor at l, k with hl
      exact valuesG with l, next
    have prefixH : ∀ l ∈ k, h(l) ∈ Ring.carrier(S)
      intros l hl
      have next := membership.into_successor at l, k with hl
      exact valuesH with l, next
    have prefixS : ∀ l ∈ k, s(l) = call2(Ring.add(S),
        call2(Ring.mul(S), g(l), b), call2(Ring.mul(S), a, h(l)))
      intros l hl
      have next := membership.into_successor at l, k with hl
      exact equations with l, next
    have lastG := valuesG with k, membership.self_successor at k with *
    have lastH := valuesH with k, membership.self_successor at k with *
    have lastS := equations with k, membership.self_successor at k with *
    have previous := ih with prefixG, prefixH, prefixS
    have sumG := indexedRingSum.identity_mem at S, g, k with *, prefixG
    have sumH := indexedRingSum.identity_mem at S, h, k with *, prefixH
    have leftIn : call2(Ring.mul(S), g(k), b) ∈ Ring.carrier(S) :=
      Ring.mul_mem with *
    have rightIn : call2(Ring.mul(S), a, h(k)) ∈ Ring.carrier(S) :=
      Ring.mul_mem with *
    have sumIn : call2(Ring.add(S), call2(Ring.mul(S), g(k), b),
        call2(Ring.mul(S), a, h(k))) ∈ Ring.carrier(S) :=
      Ring.add_mem with *
    have sIn : s(k) ∈ Ring.carrier(S)
      rw lastS
      exact sumIn
    have valueG := identity.apply at g(k), Ring.carrier(S) with lastG
    have valueH := identity.apply at h(k), Ring.carrier(S) with lastH
    have valueS := identity.apply at s(k), Ring.carrier(S) with sIn
    rw [indexedRingSum, indexedRingSum, indexedRingSum, previous,
      valueG, valueH, valueS, lastS]
    ring

-- A sum of sums is the bilinear combination with both scalars one.
theorem indexedRingSum.identity_add (g h s : Set, n : Nat)
  shows (∀ k ∈ n, g(k) ∈ Ring.carrier(S)) →
    (∀ k ∈ n, h(k) ∈ Ring.carrier(S)) →
    (∀ k ∈ n, s(k) = call2(Ring.add(S), g(k), h(k))) →
    indexedRingSum(identity(Ring.carrier(S)), s, Ring.add(S), Ring.zero(S), n) =
      call2(Ring.add(S),
        indexedRingSum(identity(Ring.carrier(S)), g, Ring.add(S), Ring.zero(S),
          n),
        indexedRingSum(identity(Ring.carrier(S)), h, Ring.add(S), Ring.zero(S),
          n))
proof
  intros valuesG valuesH equations
  have oneIn : S[1] ∈ S := Ring.one_mem with *
  have scaled : ∀ k ∈ n, s(k) = call2(Ring.add(S),
      call2(Ring.mul(S), g(k), S[1]), call2(Ring.mul(S), S[1], h(k)))
    intros k hk
    have gIn := valuesG with k, hk
    have hIn := valuesH with k, hk
    have sum := equations with k, hk
    rw sum
    ring
  have sumG := indexedRingSum.identity_mem at S, g, n with *, valuesG
  have sumH := indexedRingSum.identity_mem at S, h, n with *, valuesH
  have bilinear := indexedRingSum.identity_bilinear at S, g, h, s, S[1], S[1], n
    with comm, oneIn, oneIn, valuesG, valuesH, scaled
  rw bilinear
  ring

theorem indexedRingSum.identity_zero (g : Set, n : Nat)
  shows (∀ k ∈ n, g(k) = Ring.zero(S)) →
    indexedRingSum(identity(Ring.carrier(S)), g, Ring.add(S), Ring.zero(S), n)
      = Ring.zero(S)
proof
  induction n
  | zero =>
    intro values
    rw indexedRingSum
    rfl
  | succ(k) using ih =>
    intro values
    have prefix : ∀ l ∈ k, g(l) = Ring.zero(S)
      intros l hl
      have next := membership.into_successor at l, k with hl
      exact values with l, next
    have last := values with k, membership.self_successor at k with *
    have previous := ih with prefix
    have zeroIn : S[0] ∈ S := Ring.zero_mem with *
    have value := identity.apply at Ring.zero(S), Ring.carrier(S) with zeroIn
    rw [indexedRingSum, previous, last, value]
    ring

theorem indexedRingSum.identity_single (g m v : Set, n : Nat)
  requires value : v ∈ Ring.carrier(S)
  shows m ∈ n → (∀ k ∈ n, k ≠ m → g(k) = Ring.zero(S)) →
    g(m) = v →
    indexedRingSum(identity(Ring.carrier(S)), g, Ring.add(S), Ring.zero(S), n)
      = v
proof
  induction n
  | zero =>
    intros position others same
    exfalso
    rw nat.zero at position
    exact set.empty with position
  | succ(k) using ih =>
    intros position others same
    have zeroIn : S[0] ∈ S := Ring.zero_mem with *
    have valueZero :=
      identity.apply at Ring.zero(S), Ring.carrier(S) with zeroIn
    have shape := membership.successor_forward{n := k} with position
    cases shape with inside | atLast
    . have prefixOthers : ∀ l ∈ k, l ≠ m → g(l) = Ring.zero(S)
        intros l hl different
        have next := membership.into_successor at l, k with hl
        have step := others with l, next
        exact step with different
      have previous := ih with inside, prefixOthers, same
      have different : k ≠ m
        intro equal
        rw equal at inside
        exact membership.irreflexive with inside
      have step := others with k, membership.self_successor at k with *
      have last := step with different
      rw [indexedRingSum, previous, last, valueZero]
      ring
    . have prefixZero : ∀ l ∈ k, g(l) = Ring.zero(S)
        intros l hl
        have next := membership.into_successor at l, k with hl
        have different : l ≠ m
          intro equal
          rw [equal, atLast] at hl
          exact membership.irreflexive with hl
        have step := others with l, next
        exact step with different
      have vanishing :=
        indexedRingSum.identity_zero at S, g, k with *, prefixZero
      have valueV := identity.apply at v, Ring.carrier(S) with value
      have last : g(k) = v
        rw ← atLast
        exact same
      rw [indexedRingSum, vanishing, last, valueV]
      ring

end Sums

-- The chain rule for an algebra homomorphism φ : R[n] → R[J]: the
-- derivative of φ(f) in Xⱼ is the sum over i < n of φ(∂f/∂Xᵢ) times
-- the derivative of φ(Xᵢ) in Xⱼ. The terms of the sum, the rule for f,
-- and the polynomials satisfying it.
def chainTerms (R J φ f j : Set, n : Nat) : Set :=
  { t ∈ n × Ring.carrier(polynomialRing(R, J)) |
    snd(t) = call2(Ring.mul(polynomialRing(R, J)),
      φ(partialDerivative(R, n, fst(t))(f)),
      partialDerivative(R, J, j)(φ(X(R, n, fst(t))))) }

predicate ChainRule (R J φ f j : Set, n : Nat) :=
  partialDerivative(R, J, j)(φ(f)) =
    indexedRingSum(identity(Ring.carrier(polynomialRing(R, J))),
      chainTerms(R, J, φ, f, j, n), Ring.add(polynomialRing(R, J)),
      Ring.zero(polynomialRing(R, J)), n)

def chainPolynomials (R J φ j : Set, n : Nat) : Set :=
  { f ∈ polynomials(n, Ring.carrier(R), Ring.zero(R)) |
    ChainRule(R, J, φ, f, j, n) }

-- An algebra homomorphism between polynomial algebras is a ring
-- homomorphism between the polynomial rings fixing the constants.
theorem AlgebraHom.polynomial_ring_hom (R I J φ : Set)
  requires hom : φ : polynomialAlgebra(R, I) →ₐ polynomialAlgebra(R, J)
  shows φ : polynomialRing(R, I) →+* polynomialRing(R, J)
proof
  have ringHom := AlgebraHom.ring_hom with hom
  rw [polynomialAlgebra.ring, polynomialAlgebra.ring] at ringHom
  exact ringHom

theorem AlgebraHom.polynomial_constant (R I J φ a : Set)
  requires hom : φ : polynomialAlgebra(R, I) →ₐ polynomialAlgebra(R, J)
  requires scalar : a ∈ Ring.carrier(R)
  shows φ(polynomialConstant(R, I)(a)) = polynomialConstant(R, J)(a)
proof
  have baseIn : a ∈ Ring.carrier(Algebra.base(polynomialAlgebra(R, I)))
    rw polynomialAlgebra.base
    exact scalar
  have mapped := AlgebraHom.map_base with hom, baseIn
  rw [polynomialAlgebra.map, polynomialAlgebra.map] at mapped
  exact mapped

-- The chain terms as a function on n, and their values.
section ChainTerms
variable (R J φ f j : Set, n : Nat)
hypothesis ring : CommRing(R)
hypothesis hom : φ : polynomialAlgebra(R, n) →ₐ polynomialAlgebra(R, J)
hypothesis member : f ∈ Ring.carrier(polynomialRing(R, n))
hypothesis index : j ∈ J

theorem chainTerms.value_mem (k : Set)
  requires position : k ∈ n
  shows call2(Ring.mul(polynomialRing(R, J)), φ(partialDerivative(R, n, k)(f)),
    partialDerivative(R, J, j)(φ(X(R, n, k)))) ∈
    Ring.carrier(polynomialRing(R, J))
proof
  have ringN := polynomialRing.comm_ring at R, n with ring
  have ringJ := polynomialRing.comm_ring at R, J with ring
  have ringHom := AlgebraHom.polynomial_ring_hom at R, n, J, φ with hom
  have derivative := partialDerivative.map_mem at R, n, k, f with *
  have mapped : φ(partialDerivative(R, n, k)(f)) ∈ polynomialRing(R, J) :=
    RingHom.map_mem at φ, polynomialRing(R, n), polynomialRing(R, J),
      partialDerivative(R, n, k)(f) with *
  have variable : X(R, n, k) ∈ polynomialRing(R, n) := X.mem at R, n, k with *
  have mappedVariable : φ(X(R, n, k)) ∈ polynomialRing(R, J) :=
    RingHom.map_mem at φ, polynomialRing(R, n), polynomialRing(R, J),
      X(R, n, k) with *
  have derivativeJ :=
    partialDerivative.map_mem at R, J, j, φ(X(R, n, k)) with *
  exact Ring.mul_mem with *

theorem chainTerms.function
  shows chainTerms(R, J, φ, f, j, n) : n → Ring.carrier(polynomialRing(R, J))
proof
  constructor
  . intros e he
    exact he.left
  constructor
  . intros x y relatedY z relatedZ
    obtain ⟨_, shapeY⟩ := relatedY
    obtain ⟨_, shapeZ⟩ := relatedZ
    simp [fst.pair, snd.pair] at shapeY, shapeZ
    cc
  . intros k hk
    have valueIn := chainTerms.value_mem at R, J, φ, f, j, n, k with *
    refine ⟨call2(Ring.mul(polynomialRing(R, J)),
      φ(partialDerivative(R, n, k)(f)),
      partialDerivative(R, J, j)(φ(X(R, n, k)))), valueIn, _⟩
    apply chainTerms.membership.backward
    refine ⟨(product.pair with hk, valueIn), _⟩
    simp [fst.pair, snd.pair]

theorem chainTerms.value (k : Set)
  requires position : k ∈ n
  shows chainTerms(R, J, φ, f, j, n)(k) =
    call2(Ring.mul(polynomialRing(R, J)), φ(partialDerivative(R, n, k)(f)),
      partialDerivative(R, J, j)(φ(X(R, n, k))))
proof
  have function := chainTerms.function at R, J, φ, f, j, n with *
  have valueIn := chainTerms.value_mem at R, J, φ, f, j, n, k with *
  have related : relates(chainTerms(R, J, φ, f, j, n), k,
      call2(Ring.mul(polynomialRing(R, J)), φ(partialDerivative(R, n, k)(f)),
        partialDerivative(R, J, j)(φ(X(R, n, k)))))
    apply chainTerms.membership.backward
    refine ⟨(product.pair with position, valueIn), _⟩
    simp [fst.pair, snd.pair]
  exact FunctionBetween.apply_value with function, position, related

theorem chainTerms.values
  shows ∀ k ∈ n,
    chainTerms(R, J, φ, f, j, n)(k) ∈ Ring.carrier(polynomialRing(R, J))
proof
  intros k hk
  have function := chainTerms.function at R, J, φ, f, j, n with *
  exact FunctionBetween.apply_closed with function, hk

end ChainTerms

-- The chain rule, by generation: the polynomials satisfying it contain
-- the constants (both sides vanish) and the variables (a single term
-- survives), and are closed under sums and products (the sums add and
-- combine bilinearly termwise).
section ChainRule
variable (R J : Set, n : Nat)
hypothesis ring : CommRing(R)

theorem polynomial_chain_rule (φ f j : Set)
  requires hom : φ : polynomialAlgebra(R, n) →ₐ polynomialAlgebra(R, J)
  requires member : f ∈ Ring.carrier(polynomialRing(R, n))
  requires index : j ∈ J
  shows partialDerivative(R, J, j)(φ(f)) =
    indexedRingSum(identity(Ring.carrier(polynomialRing(R, J))),
      chainTerms(R, J, φ, f, j, n), Ring.add(polynomialRing(R, J)),
      Ring.zero(polynomialRing(R, J)), n)
proof
  have parts := CommRing.parts with ring
  have ringN := polynomialRing.comm_ring at R, n with ring
  have ringJ := polynomialRing.comm_ring at R, J with ring
  have ringHom := AlgebraHom.polynomial_ring_hom at R, n, J, φ with hom
  have mappedZero := RingHom.map_zero at φ, polynomialRing(R, n),
    polynomialRing(R, J) with ringHom
  have mappedOne := RingHom.map_one at φ, polynomialRing(R, n),
    polynomialRing(R, J) with ringHom
  have fParts := polynomialRing.member_parts at R, n, f with *
  have variableTerms : ∀ k ∈ n, φ(X(R, n, k)) ∈ polynomialRing(R, J) ∧
      partialDerivative(R, J, j)(φ(X(R, n, k))) ∈ polynomialRing(R, J)
    intros k hk
    have variable : X(R, n, k) ∈ polynomialRing(R, n) :=
      X.mem at R, n, k with *
    have mappedVariable : φ(X(R, n, k)) ∈ polynomialRing(R, J) :=
      RingHom.map_mem at φ, polynomialRing(R, n), polynomialRing(R, J),
        X(R, n, k) with *
    have derivativeJ :=
      partialDerivative.map_mem at R, J, j, φ(X(R, n, k)) with *
    exact ⟨mappedVariable, derivativeJ⟩
  have constants : ∀ a ∈ R.carrier,
      polynomialConstant(n, R.carrier, R.zero, a) ∈
        chainPolynomials(R, J, φ, j, n)
    intros a ha
    have value := polynomialConstant.apply at R, n, a with *
    have constantN : polynomialConstant(R, n)(a) ∈ polynomialRing(R, n) :=
      polynomialConstant.mem at R, n, a with *
    have constantParts := polynomialRing.member_parts at R, n,
      polynomialConstant(R, n)(a) with *
    rw ← value
    apply chainPolynomials.membership.backward
    refine ⟨constantParts, _⟩
    unfold ChainRule
    have mapped := AlgebraHom.polynomial_constant at R, n, J, φ, a with *
    have constantJ : polynomialConstant(R, J)(a) ∈ polynomialRing(R, J) :=
      polynomialConstant.mem at R, J, a with *
    have vanishes := partialDerivative.constant at R, J, j, a with *
    rw [mapped, vanishes]
    have terms : ∀ k ∈ n,
        chainTerms(R, J, φ, polynomialConstant(R, n)(a), j, n)(k) =
        Ring.zero(polynomialRing(R, J))
      intros k hk
      have termValue := chainTerms.value at R, J, φ,
        polynomialConstant(R, n)(a), j, n, k with *
      have derivativeZero := partialDerivative.constant at R, n, k, a with *
      have pieces := variableTerms with k, hk
      have derivativeJ := pieces.right
      rw [termValue, derivativeZero, mappedZero]
      ring
    have vanishing := indexedRingSum.identity_zero at polynomialRing(R, J),
      chainTerms(R, J, φ, polynomialConstant(R, n)(a), j, n), n with *, terms
    rw vanishing
    rfl
  have variables : ∀ m ∈ n,
      polynomialVariable(n, R.carrier, R.zero, R.one, m) ∈
        chainPolynomials(R, J, φ, j, n)
    intros m hm
    have variableN : X(R, n, m) ∈ polynomialRing(R, n) :=
      X.mem at R, n, m with *
    have variableParts := polynomialRing.member_parts at R, n, X(R, n, m) with *
    rw ← X.value
    apply chainPolynomials.membership.backward
    refine ⟨variableParts, _⟩
    unfold ChainRule
    have piecesM := variableTerms with m, hm
    have derivativeJ := piecesM.right
    have others : ∀ k ∈ n, k ≠ m →
        chainTerms(R, J, φ, X(R, n, m), j, n)(k) =
        Ring.zero(polynomialRing(R, J))
      intros k hk different
      have reverse : m ≠ k by cc
      have termValue := chainTerms.value at R, J, φ, X(R, n, m), j, n, k with *
      have derivativeZero := partialDerivative.X_other at R, n, k, m with *
      have pieces := variableTerms with k, hk
      have derivativeJK := pieces.right
      rw [termValue, derivativeZero, mappedZero]
      ring
    have same : chainTerms(R, J, φ, X(R, n, m), j, n)(m) =
        partialDerivative(R, J, j)(φ(X(R, n, m)))
      have termValue := chainTerms.value at R, J, φ, X(R, n, m), j, n, m with *
      have derivativeOne := partialDerivative.X_self at R, n, m with *
      rw [termValue, derivativeOne, mappedOne]
      ring
    have single := indexedRingSum.identity_single at polynomialRing(R, J),
      chainTerms(R, J, φ, X(R, n, m), j, n), m,
      partialDerivative(R, J, j)(φ(X(R, n, m))), n
      with ringJ, derivativeJ, hm, others, same
    rw single
    rfl
  have sums : ∀ u ∈ chainPolynomials(R, J, φ, j, n),
      ∀ v ∈ chainPolynomials(R, J, φ, j, n),
      coefficientAdd(monomials(n), R.carrier, R.add, R.zero, R.neg, R.mul,
        R.one, u, v) ∈ chainPolynomials(R, J, φ, j, n)
    intros u hu v hv
    have dataU := chainPolynomials.membership.forward with hu
    have dataV := chainPolynomials.membership.forward with hv
    have uParts := dataU.left
    have uIn := polynomialRing.member_of_parts at R, n, u with *
    have vParts := dataV.left
    have vIn := polynomialRing.member_of_parts at R, n, v with *
    have ruleU := dataU.right
    have ruleV := dataV.right
    unfold ChainRule at ruleU
    unfold ChainRule at ruleV
    have sumForm := polynomialRing.add_apply at R, n, u, v with *
    have sumIn : u + v ∈ polynomialRing(R, n) := Ring.add_mem with *
    have sumParts := polynomialRing.member_parts at R, n, u + v with *
    rw ← sumForm
    apply chainPolynomials.membership.backward
    refine ⟨sumParts, _⟩
    unfold ChainRule
    have mappedU : φ(u) ∈ polynomialRing(R, J) :=
      RingHom.map_mem at φ, polynomialRing(R, n), polynomialRing(R, J), u
        with *
    have mappedV : φ(v) ∈ polynomialRing(R, J) :=
      RingHom.map_mem at φ, polynomialRing(R, n), polynomialRing(R, J), v
        with *
    have mappedSum := RingHom.map_add at φ, polynomialRing(R, n),
      polynomialRing(R, J), u, v with *
    have additive := partialDerivative.add at R, J, j, φ(u), φ(v) with *
    rw [mappedSum, additive, ruleU, ruleV]
    have valuesU := chainTerms.values at R, J, φ, u, j, n with *
    have valuesV := chainTerms.values at R, J, φ, v, j, n with *
    have equations : ∀ k ∈ n, chainTerms(R, J, φ, u + v, j, n)(k) =
        call2(Ring.add(polynomialRing(R, J)), chainTerms(R, J, φ, u, j, n)(k),
          chainTerms(R, J, φ, v, j, n)(k))
      intros k hk
      have termSum := chainTerms.value at R, J, φ, u + v, j, n, k with *
      have termU := chainTerms.value at R, J, φ, u, j, n, k with *
      have termV := chainTerms.value at R, J, φ, v, j, n, k with *
      have derivativeSum := partialDerivative.add at R, n, k, u, v with *
      have derivativeU :
          partialDerivative(R, n, k)(u) ∈ polynomialRing(R, n) :=
        partialDerivative.map_mem at R, n, k, u with *
      have derivativeV :
          partialDerivative(R, n, k)(v) ∈ polynomialRing(R, n) :=
        partialDerivative.map_mem at R, n, k, v with *
      have mappedDerivativeU :
          φ(partialDerivative(R, n, k)(u)) ∈ polynomialRing(R, J) :=
        RingHom.map_mem at φ, polynomialRing(R, n), polynomialRing(R, J),
          partialDerivative(R, n, k)(u) with *
      have mappedDerivativeV :
          φ(partialDerivative(R, n, k)(v)) ∈ polynomialRing(R, J) :=
        RingHom.map_mem at φ, polynomialRing(R, n), polynomialRing(R, J),
          partialDerivative(R, n, k)(v) with *
      have mappedDerivativeSum := RingHom.map_add at φ, polynomialRing(R, n),
        polynomialRing(R, J), partialDerivative(R, n, k)(u),
        partialDerivative(R, n, k)(v) with *
      have pieces := variableTerms with k, hk
      have derivativeJK := pieces.right
      rw [termSum, termU, termV, derivativeSum, mappedDerivativeSum]
      ring
    have combined := indexedRingSum.identity_add at polynomialRing(R, J),
      chainTerms(R, J, φ, u, j, n), chainTerms(R, J, φ, v, j, n),
      chainTerms(R, J, φ, u + v, j, n), n
      with ringJ, valuesU, valuesV, equations
    rw combined
    rfl
  have products : ∀ u ∈ chainPolynomials(R, J, φ, j, n),
      ∀ v ∈ chainPolynomials(R, J, φ, j, n),
      polynomialProduct(n, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, u, v)
        ∈ chainPolynomials(R, J, φ, j, n)
    intros u hu v hv
    have dataU := chainPolynomials.membership.forward with hu
    have dataV := chainPolynomials.membership.forward with hv
    have uParts := dataU.left
    have uIn := polynomialRing.member_of_parts at R, n, u with *
    have vParts := dataV.left
    have vIn := polynomialRing.member_of_parts at R, n, v with *
    have ruleU := dataU.right
    have ruleV := dataV.right
    unfold ChainRule at ruleU
    unfold ChainRule at ruleV
    have productForm := polynomialRing.mul_apply at R, n, u, v with *
    have productIn : u * v ∈ polynomialRing(R, n) := Ring.mul_mem with *
    have productParts := polynomialRing.member_parts at R, n, u * v with *
    rw ← productForm
    apply chainPolynomials.membership.backward
    refine ⟨productParts, _⟩
    unfold ChainRule
    have mappedU : φ(u) ∈ polynomialRing(R, J) :=
      RingHom.map_mem at φ, polynomialRing(R, n), polynomialRing(R, J), u
        with *
    have mappedV : φ(v) ∈ polynomialRing(R, J) :=
      RingHom.map_mem at φ, polynomialRing(R, n), polynomialRing(R, J), v
        with *
    have mappedProduct := RingHom.map_mul at φ, polynomialRing(R, n),
      polynomialRing(R, J), u, v with *
    have leibniz := partialDerivative.mul at R, J, j, φ(u), φ(v) with *
    rw [mappedProduct, leibniz, ruleU, ruleV]
    have valuesU := chainTerms.values at R, J, φ, u, j, n with *
    have valuesV := chainTerms.values at R, J, φ, v, j, n with *
    have equations : ∀ k ∈ n, chainTerms(R, J, φ, u * v, j, n)(k) =
        call2(Ring.add(polynomialRing(R, J)),
          call2(Ring.mul(polynomialRing(R, J)),
            chainTerms(R, J, φ, u, j, n)(k), φ(v)),
          call2(Ring.mul(polynomialRing(R, J)),
            φ(u), chainTerms(R, J, φ, v, j, n)(k)))
      intros k hk
      have termProduct := chainTerms.value at R, J, φ, u * v, j, n, k with *
      have termU := chainTerms.value at R, J, φ, u, j, n, k with *
      have termV := chainTerms.value at R, J, φ, v, j, n, k with *
      have derivativeU :
          partialDerivative(R, n, k)(u) ∈ polynomialRing(R, n) :=
        partialDerivative.map_mem at R, n, k, u with *
      have derivativeV :
          partialDerivative(R, n, k)(v) ∈ polynomialRing(R, n) :=
        partialDerivative.map_mem at R, n, k, v with *
      have leftIn :
          partialDerivative(R, n, k)(u) * v ∈ polynomialRing(R, n) :=
        Ring.mul_mem with *
      have rightIn :
          u * partialDerivative(R, n, k)(v) ∈ polynomialRing(R, n) :=
        Ring.mul_mem with *
      have derivativeProduct := partialDerivative.mul at R, n, k, u, v with *
      have mappedDerivativeU :
          φ(partialDerivative(R, n, k)(u)) ∈ polynomialRing(R, J) :=
        RingHom.map_mem at φ, polynomialRing(R, n), polynomialRing(R, J),
          partialDerivative(R, n, k)(u) with *
      have mappedDerivativeV :
          φ(partialDerivative(R, n, k)(v)) ∈ polynomialRing(R, J) :=
        RingHom.map_mem at φ, polynomialRing(R, n), polynomialRing(R, J),
          partialDerivative(R, n, k)(v) with *
      have mappedSum := RingHom.map_add at φ, polynomialRing(R, n),
        polynomialRing(R, J), partialDerivative(R, n, k)(u) * v,
        u * partialDerivative(R, n, k)(v) with *
      have mappedLeft := RingHom.map_mul at φ, polynomialRing(R, n),
        polynomialRing(R, J), partialDerivative(R, n, k)(u), v with *
      have mappedRight := RingHom.map_mul at φ, polynomialRing(R, n),
        polynomialRing(R, J), u, partialDerivative(R, n, k)(v) with *
      have pieces := variableTerms with k, hk
      have derivativeJK := pieces.right
      rw [termProduct, termU, termV, derivativeProduct, mappedSum,
        mappedLeft, mappedRight]
      ring
    have combined := indexedRingSum.identity_bilinear at polynomialRing(R, J),
      chainTerms(R, J, φ, u, j, n), chainTerms(R, J, φ, v, j, n),
      chainTerms(R, J, φ, u * v, j, n), φ(u), φ(v), n
      with ringJ, mappedU, mappedV, valuesU, valuesV, equations
    rw combined
    rfl
  have generated := polynomials.generated at n, R.carrier, R.add, R.zero,
    R.neg, R.mul, R.one, chainPolynomials(R, J, φ, j, n), f
    with parts, fParts, constants, variables, sums, products
  have data := chainPolynomials.membership.forward with generated
  exact data.right

end ChainRule
