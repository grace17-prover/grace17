-- Authors: Grant Passmore

module Constructible.CubicIntegerRoots
import CubicConjugation
import ReducedFraction
import RationalQuotients

-- x = p/q in lowest terms; q³ · cubic(x) = 0 gives the integer equation
-- p³ + a p² q + b p q² + c q³ = 0 by realInt.injective, so q divides p³
-- and q = ±1 by IntegerCoprime.divides_cube.
theorem cubic.rational_root_integer (a b c : Integer) (x : Real)
  requires xIn : x ∈ rationalReals
  requires root : cubic(realInt(a), realInt(b), realInt(c), x) = 0
  shows ∃ z ∈ ℤ, x = realInt(z)
proof
  sorry

-- z divides 2, so |z| ≤ 2 (IntegerDivides.abs_le), and the five cases
-- fail by computation.
theorem cube.ne_two (z : Integer)
  shows z * z * z ≠ integerOfNat(2)
proof
  sorry

-- z · (z² − 3) = 1 makes z a unit, and z = ±1 fails by computation.
theorem cube.ne_three_self_plus_one (z : Integer)
  shows z * z * z ≠ integerOfNat(3) * z + 1
proof
  sorry

-- The two cubics of the theorem, over the rationals: x³ − 2 and
-- x³ − 3x − 1 have no rational root.
theorem cubic.no_rational_cube_root_two (x : Real)
  requires xIn : x ∈ rationalReals
  shows cubic((0:R), (0:R), -(2:R), x) ≠ 0
proof
  sorry

theorem cubic.no_rational_trisection_root (x : Real)
  requires xIn : x ∈ rationalReals
  shows cubic((0:R), -(3:R), -(1:R), x) ≠ 0
proof
  sorry
