-- Monic real cubics and conjugation: a root p + q√d of a cubic over F
-- with √d ∉ F has the conjugate root p − q√d, two distinct roots give the
-- third by Vieta, and a root in F(√d) descends to a root in F.
-- Part of the Constructible blueprint.
-- Planned home: Algebra/Field/CubicConjugation.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Constructible.CubicConjugation
import QuadraticAdjoin

-- The monic cubic x³ + a x² + b x + c, with the cube written as a product
-- so that ring normalizes it.
def cubic (a b c x : Real) : Real := x * x * x + a * (x * x) + b * x + c

theorem cubic.real (a b c x : Real)
  shows Real(cubic(a, b, c, x))
proof
  unfold cubic
  typecheck

instance cubic.mem (F : Set) (a b c x : Real)
  requires field : RealSubfield(F)
  requires aIn : a ∈ F
  requires bIn : b ∈ F
  requires cIn : c ∈ F
  requires xIn : x ∈ F
  shows cubic(a, b, c, x) ∈ F
proof
  sorry

-- Vieta for two distinct roots. The certificate is
-- (r − s) · cubic(−a − r − s) = (−a − 2s − r) · cubic(r)
--                             − (−a − 2r − s) · cubic(s),
-- a ring identity, after which r − s cancels.
theorem cubic.third_root (a b c r s : Real)
  requires rootR : cubic(a, b, c, r) = 0
  requires rootS : cubic(a, b, c, s) = 0
  requires distinct : r ≠ s
  shows cubic(a, b, c, -a - r - s) = 0
proof
  sorry

-- The value at p ± q√d splits as U ± V√d with U, V polynomial in
-- a, b, c, p, q, d: ring after sqrt.square.
theorem cubic.split (a b c d p q : Real)
  requires dNonneg : (0:R) ≤ d
  shows cubic(a, b, c, p + q * √d) =
      (p * p * p + (3:R) * p * (q * q) * d + a * (p * p + q * q * d) +
        b * p + c) +
      ((3:R) * (p * p) * q + q * q * q * d + (2:R) * a * p * q + b * q) *
        √d ∧
    cubic(a, b, c, p - q * √d) =
      (p * p * p + (3:R) * p * (q * q) * d + a * (p * p + q * q * d) +
        b * p + c) -
      ((3:R) * (p * p) * q + q * q * q * d + (2:R) * a * p * q + b * q) *
        √d
proof
  sorry

-- U + V√d = 0 with U, V ∈ F and √d ∉ F forces U = V = 0, so U − V√d = 0.
theorem cubic.conjugate_root (F : Set) (d a b c p q : Real)
  requires field : RealSubfield(F)
  requires dIn : d ∈ F
  requires dNonneg : (0:R) ≤ d
  requires rootOut : √d ∉ F
  requires aIn : a ∈ F
  requires bIn : b ∈ F
  requires cIn : c ∈ F
  requires pIn : p ∈ F
  requires qIn : q ∈ F
  requires root : cubic(a, b, c, p + q * √d) = 0
  shows cubic(a, b, c, p - q * √d) = 0
proof
  sorry

-- r = p + q√d. If q = 0 or √d ∈ F then r ∈ F; otherwise the conjugate is
-- a distinct root and the third root −a − 2p lies in F.
theorem cubic.root_descends (F : Set) (d a b c r : Real)
  requires field : RealSubfield(F)
  requires dIn : d ∈ F
  requires dNonneg : (0:R) ≤ d
  requires aIn : a ∈ F
  requires bIn : b ∈ F
  requires cIn : c ∈ F
  requires rIn : r ∈ adjoinSqrt(F, d)
  requires root : cubic(a, b, c, r) = 0
  shows ∃ s ∈ F, cubic(a, b, c, s) = 0
proof
  sorry
