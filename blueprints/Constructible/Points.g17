-- Constructible points of the plane: the least set containing (0, 0) and
-- (1, 0) and closed under the three intersections. Their coordinates are
-- constructible numbers, so no constructible point has abscissa ∛2 and no
-- constructible point of the unit circle trisects the angle of sixty
-- degrees.
-- Part of the Constructible blueprint.
-- Planned home: Geometry/Construction/Points.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Constructible.Points
import Intersections
import Impossibility

-- A set of points closed under ruler and compass: it holds the two base
-- points and every intersection of two nonparallel lines, of a line and a
-- circle, and of two circles with distinct centers, each determined by
-- points of the set.
predicate ConstructionClosed (P : Set) :=
  P ⊆ ℝ × ℝ ∧ ((0:R), (0:R)) ∈ P ∧ ((1:R), (0:R)) ∈ P ∧
  (∀ a b c d ∈ P, ∀ p ∈ ℝ × ℝ, ∀ t u ∈ ℝ,
    directionCross(a, b, c, d) ≠ (0:R) → OnLine(p, a, b, t) →
    OnLine(p, c, d, u) → p ∈ P) ∧
  (∀ a b c w ∈ P, ∀ p ∈ ℝ × ℝ, ∀ t ∈ ℝ,
    a ≠ b → OnLine(p, a, b, t) → OnCircle(p, c, w) → p ∈ P) ∧
  (∀ c w e v ∈ P, ∀ p ∈ ℝ × ℝ,
    c ≠ e → OnCircle(p, c, w) → OnCircle(p, e, v) → p ∈ P)

def constructiblePoints : Set :=
  { p ∈ ℝ × ℝ | ∀ P, ConstructionClosed(P) → p ∈ P }

theorem constructiblePoints.mem_iff (p : Set)
  shows p ∈ constructiblePoints ↔
    p ∈ ℝ × ℝ ∧ (∀ P, ConstructionClosed(P) → p ∈ P)
proof
  sorry

theorem constructiblePoints.least (P : Set)
  requires closed : ConstructionClosed(P)
  shows constructiblePoints ⊆ P
proof
  sorry

theorem constructiblePoints.point (p : Set)
  requires constructible : p ∈ constructiblePoints
  shows Point(p)
proof
  sorry

theorem constructiblePoints.origin
  shows ((0:R), (0:R)) ∈ constructiblePoints
proof
  sorry

theorem constructiblePoints.unit
  shows ((1:R), (0:R)) ∈ constructiblePoints
proof
  sorry

-- The points with constructible coordinates form a construction-closed
-- set, by the three intersection lemmas at S = constructibles.
theorem constructiblePoints.coordinates (p : Point)
  requires constructible : p ∈ constructiblePoints
  shows Constructible(x(p)) ∧ Constructible(y(p))
proof
  sorry

theorem doublingTheCube.no_point (p : Point)
  requires constructible : p ∈ constructiblePoints
  shows x(p) * x(p) * x(p) ≠ (2:R)
proof
  sorry

-- On the unit circle x² + y² = 1, the real part x³ − 3xy² of the cube of
-- the point is 4x³ − 3x, the cosine of three times its angle; the angle
-- of sixty degrees has cosine 1/2.
theorem trisection.no_point
  shows ¬(∃ p ∈ constructiblePoints,
    x(p) * x(p) + y(p) * y(p) = (1:R) ∧
    x(p) * x(p) * x(p) - (3:R) * x(p) * (y(p) * y(p)) = (1:R) / (2:R))
proof
  sorry
