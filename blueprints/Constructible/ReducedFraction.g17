module Constructible.ReducedFraction
import Grace.Cumulus.NumberTheory.IntegerDivisibility

-- Dividing by the greatest common divisor: g = integerGCD(p, q) is
-- positive since q ≠ 0, p = g p' and q = g q', and the Bézout identity
-- u p + v q = g cancels to u p' + v q' = 1.
theorem Integer.reduced_fraction (p q : Integer)
  requires nonzero : q ≠ 0
  shows ∃ p2 ∈ ℤ, ∃ q2 ∈ ℤ,
    q2 ≠ 0 ∧ IntegerCoprime(p2, q2) ∧ p * q2 = p2 * q
proof
  sorry

-- A divisor of p³ coprime to p divides 1: three coprime cancellations and
-- IntegerDivides.unit_iff.
theorem IntegerCoprime.divides_cube (p q : Integer)
  requires coprime : IntegerCoprime(q, p)
  requires divides : IntegerDivides(q, p * p * p)
  shows q = 1 ∨ q = -1
proof
  sorry
