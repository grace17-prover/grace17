-- Fractions in lowest terms over the integers: every quotient p/q with
-- q ≠ 0 is a coprime quotient, and a denominator coprime to p that divides
-- p³ is a unit.
-- Part of the Constructible blueprint.
-- Planned home: NumberTheory/ReducedFraction.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Constructible.ReducedFraction
import Grace.Cumulus.NumberTheory.IntegerDivisibility

-- Dividing by the greatest common divisor: g = integerGCD(p, q) is
-- positive since q ≠ 0, p = g p' and q = g q', and the Bézout identity
-- u p + v q = g cancels to u p' + v q' = 1.
theorem Integer.reduced_fraction (p q : Integer)
  requires nonzero : q ≠ 0
  shows ∃ p2 ∈ ℤ, ∃ q2 ∈ ℤ,
    q2 ≠ 0 ∧ IntegerCoprime(p2, q2) ∧ p * q2 = p2 * q
proof
  obtain ⟨p2, p2Integer, pShape⟩ := integerGCD.divides_left at p, q
  obtain ⟨q2, q2Integer, qShape⟩ := integerGCD.divides_right at p, q
  obtain ⟨u, uInteger, v, vInteger, identity⟩ := integerGCD.bezout at p, q
  have gNonzero : integerOfNat(integerGCD(p, q)) ≠ 0
    intro zero
    apply nonzero
    rw [← qShape, zero]
    ring
  have q2Nonzero : q2 ≠ 0
    intro zero
    apply nonzero
    rw [← qShape, zero]
    ring
  have scaled : integerOfNat(integerGCD(p, q)) * (u * p2 + v * q2) =
      integerOfNat(integerGCD(p, q)) * integerOne
    linear_combination identity + u * pShape + v * qShape
  have bezout := integerMulValue.left_cancel at u * p2 + v * q2, integerOne,
    integerOfNat(integerGCD(p, q)) with gNonzero, scaled
  have coprime := IntegerCoprime.of_bezout at p2, q2, u, v with bezout
  have cross : p * q2 = p2 * q
    linear_combination p2 * qShape - q2 * pShape
  exact ⟨p2, p2Integer, q2, q2Integer, q2Nonzero, coprime, cross⟩

-- A divisor of p³ coprime to p divides 1: three coprime cancellations and
-- IntegerDivides.unit_iff.
theorem IntegerCoprime.divides_cube (p q : Integer)
  requires coprime : IntegerCoprime(q, p)
  requires divides : IntegerDivides(q, p * p * p)
  shows q = 1 ∨ q = -1
proof
  have shape : p * p * p = p * (p * p) by ring
  rw shape at divides
  have square := IntegerCoprime.cancel at q, p, p * p with coprime, divides
  have linear := IntegerCoprime.cancel at q, p, p with coprime, square
  have unit : IntegerDivides(q, p * integerOne)
    rw integerMulValue.one_right
    exact linear
  have one := IntegerCoprime.cancel at q, p, integerOne with coprime, unit
  exact IntegerDivides.unit_iff.forward with one
