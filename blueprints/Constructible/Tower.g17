-- Every constructible number lies in the field of a quadratic tower: the
-- union of the tower fields is constructibly closed, so it contains the
-- least closed set, and it is contained in it.
-- Part of the Constructible blueprint.
-- Planned home: Geometry/Construction/Tower.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Constructible.Tower
import QuadraticTower
import Numbers

-- The reals reached by some quadratic tower.
def towerReals : Set :=
  { x ∈ ℝ | ∃ ds, List(ℝ, ds) ∧ QuadraticTower(ds) ∧ x ∈ towerField(ds) }

theorem towerReals.mem_iff (x : Set)
  shows x ∈ towerReals ↔
    x ∈ ℝ ∧ (∃ ds, List(ℝ, ds) ∧ QuadraticTower(ds) ∧ x ∈ towerField(ds))
proof
  sorry

-- 0 and 1 by the empty tower; x in towerField(ds) and y in towerField(es)
-- both lie in the subfield towerField(append(ds, es)); √x by x :: ds.
theorem towerReals.closed
  shows ConstructiblyClosed(towerReals)
proof
  sorry

theorem Constructible.in_tower (x : Real)
  requires constructible : Constructible(x)
  shows ∃ ds, List(ℝ, ds) ∧ QuadraticTower(ds) ∧ x ∈ towerField(ds)
proof
  sorry

-- Induction on ds: the rationals are constructible, and a constructibly
-- closed set containing F contains adjoinSqrt(F, d) for d ≥ 0 in F.
theorem towerField.constructible (ds : List(ℝ))
  requires tower : QuadraticTower(ds)
  shows towerField(ds) ⊆ constructibles
proof
  sorry

theorem constructibles.eq_tower
  shows constructibles = towerReals
proof
  sorry
