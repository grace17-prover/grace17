-- Every constructible number lies in the field of a quadratic tower: the
-- union of the tower fields is constructibly closed, so it contains the
-- least closed set, and it is contained in it.
-- Part of the Constructible blueprint.
-- Planned home: Geometry/Construction/Tower.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Constructible.Tower
import QuadraticTower
import Numbers

-- The reals reached by some quadratic tower.
def towerReals : Set :=
  { x ∈ ℝ | ∃ ds, List(ℝ, ds) ∧ QuadraticTower(ds) ∧ x ∈ towerField(ds) }

theorem towerReals.mem_iff (x : Set)
  shows x ∈ towerReals ↔
    x ∈ ℝ ∧ (∃ ds, List(ℝ, ds) ∧ QuadraticTower(ds) ∧ x ∈ towerField(ds))
proof
  simp

theorem towerReals.subset_reals
  shows towerReals ⊆ ℝ
proof
  simp

-- A member of a tower field reached by a tower: a member of towerReals.
theorem towerReals.of_tower (ds : List(ℝ)) (x : Set)
  requires tower : QuadraticTower(ds)
  requires xIn : x ∈ towerField(ds)
  shows x ∈ towerReals
proof
  have bounded := towerField.subset_reals at ds
  have xReal := bounded with x, xIn
  apply towerReals.mem_iff.backward
  exact ⟨xReal, ds, ?_, tower, xIn⟩
  typecheck

-- 0 and 1 by the empty tower; x in towerField(ds) and y in towerField(es)
-- both lie in the subfield towerField(append(ds, es)); √x by x :: ds.
theorem towerReals.closed
  shows ConstructiblyClosed(towerReals)
proof
  have bounded := towerReals.subset_reals
  have nilList : List(ℝ, []) by typecheck
  have nilTower := QuadraticTower.nil
  have zeroMember : (0:R) ∈ towerReals
    have zeroIn : (0:R) ∈ towerField([])
      rw towerField.nil
      exact rationalReals.zero_mem
    exact towerReals.of_tower with nilTower, zeroIn
  have oneMember : (1:R) ∈ towerReals
    have oneIn : (1:R) ∈ towerField([])
      rw towerField.nil
      exact rationalReals.one_mem
    exact towerReals.of_tower with nilTower, oneIn
  have negatives : ∀ x ∈ towerReals, -(x:R) ∈ towerReals
    intros x hx
    have data := towerReals.mem_iff.forward with hx
    have xReal : Real(x) by exact data.left
    obtain ⟨ds, dsList, tower, xIn⟩ := data.right
    have field := towerField.subfield with tower
    have negIn := RealSubfield.neg_mem with field, xIn
    exact towerReals.of_tower with tower, negIn
  have sums : ∀ x y ∈ towerReals, (x:R) + (y:R) ∈ towerReals
    intros x hx y hy
    have first := towerReals.mem_iff.forward with hx
    have second := towerReals.mem_iff.forward with hy
    have xReal : Real(x) by exact first.left
    have yReal : Real(y) by exact second.left
    obtain ⟨ds, dsList, towerD, xIn⟩ := first.right
    obtain ⟨es, esList, towerE, yIn⟩ := second.right
    have joined : List(ℝ, append{ℝ}(ds, es)) by typecheck
    have both := QuadraticTower.append_subset with towerD, towerE
    have right := towerField.subset_append_right at ds, es with towerD
    have xUp := both.right with x, xIn
    have yUp := right with y, yIn
    have field := towerField.subfield with both.left
    have sumIn := RealSubfield.add_mem with field, xUp, yUp
    exact towerReals.of_tower with both.left, sumIn
  have products : ∀ x y ∈ towerReals, (x:R) * (y:R) ∈ towerReals
    intros x hx y hy
    have first := towerReals.mem_iff.forward with hx
    have second := towerReals.mem_iff.forward with hy
    have xReal : Real(x) by exact first.left
    have yReal : Real(y) by exact second.left
    obtain ⟨ds, dsList, towerD, xIn⟩ := first.right
    obtain ⟨es, esList, towerE, yIn⟩ := second.right
    have joined : List(ℝ, append{ℝ}(ds, es)) by typecheck
    have both := QuadraticTower.append_subset with towerD, towerE
    have right := towerField.subset_append_right at ds, es with towerD
    have xUp := both.right with x, xIn
    have yUp := right with y, yIn
    have field := towerField.subfield with both.left
    have productIn := RealSubfield.mul_mem with field, xUp, yUp
    exact towerReals.of_tower with both.left, productIn
  have inverses : ∀ x ∈ towerReals,
      x ≠ (0:R) → realInvValue(x) ∈ towerReals
    intros x hx nonzero
    have data := towerReals.mem_iff.forward with hx
    have xReal : Real(x) by exact data.left
    obtain ⟨ds, dsList, tower, xIn⟩ := data.right
    have field := towerField.subfield with tower
    have inverseIn := RealSubfield.inv_mem with field, xIn, nonzero
    exact towerReals.of_tower with tower, inverseIn
  have roots : ∀ x ∈ towerReals,
      (0:R) ≤ (x:R) → realSqrt(x) ∈ towerReals
    intros x hx nonneg
    have data := towerReals.mem_iff.forward with hx
    have xReal : Real(x) by exact data.left
    obtain ⟨ds, dsList, tower, xIn⟩ := data.right
    have field := towerField.subfield with tower
    have taller := QuadraticTower.cons with tower, xIn, nonneg
    have rootIn : realSqrt(x) ∈ towerField(x :: ds)
      rw towerField.cons
      have member := adjoinSqrt.sqrt_mem with field, nonneg
      unfold sqrt at member
      exact member
    exact towerReals.of_tower with taller, rootIn
  have field := RealSubfield.mk with
    bounded, zeroMember, oneMember, negatives, sums, products, inverses
  unfold ConstructiblyClosed
  exact ⟨field, roots⟩

theorem Constructible.in_tower (x : Real)
  requires constructible : Constructible(x)
  shows ∃ ds, List(ℝ, ds) ∧ QuadraticTower(ds) ∧ x ∈ towerField(ds)
proof
  have closed := towerReals.closed
  have least := constructibles.least with closed
  unfold Constructible at constructible
  have member := least with x, constructible
  have data := towerReals.mem_iff.forward with member
  exact data.right

-- Induction on ds: the rationals are constructible, and a constructibly
-- closed set containing F contains adjoinSqrt(F, d) for d ≥ 0 in F.
theorem towerField.constructible (ds : List(ℝ))
  requires tower : QuadraticTower(ds)
  shows towerField(ds) ⊆ constructibles
proof
  induction ds
  | List.nil =>
    intro tower
    rw towerField.nil
    have field := constructibles.subfield
    exact RealSubfield.rationals_subset with field
  | List.cons(d, tail) using ih =>
    intro tower
    have dReal : d ∈ ℝ by assumption
    have below := QuadraticTower.tail with tower
    have top := QuadraticTower.head with tower
    have field := towerField.subfield with below
    have inner := ih with below
    have dC : Constructible(d)
      unfold Constructible
      exact inner with d, top.left
    have rootC := Constructible.sqrt_of_le with dC, top.right
    rw towerField.cons
    intros z hz
    obtain ⟨a, aIn, b, bIn, same⟩ := adjoinSqrt.cases with top.right, hz
    have realA := RealSubfield.real with field, aIn
    have realB := RealSubfield.real with field, bIn
    have aC : Constructible(a)
      unfold Constructible
      exact inner with a, aIn
    have bC : Constructible(b)
      unfold Constructible
      exact inner with b, bIn
    have productC := Constructible.mul with bC, rootC
    have sumC := Constructible.add with aC, productC
    unfold Constructible at sumC
    rw same
    unfold sqrt
    exact sumC

theorem constructibles.eq_tower
  shows constructibles = towerReals
proof
  have closed := towerReals.closed
  have least := constructibles.least with closed
  have back : towerReals ⊆ constructibles
    intros x hx
    have data := towerReals.mem_iff.forward with hx
    obtain ⟨ds, dsList, tower, xIn⟩ := data.right
    have included := towerField.constructible with tower
    exact included with x, xIn
  exact Subset.antisymmetric with least, back
