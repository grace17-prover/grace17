-- Adjoining a square root to a subfield of the reals: F(√d) as the set of
-- a + b√d with a, b in F, a subfield when d ∈ F is nonnegative, equal to F
-- when √d ∈ F, and with unique coefficients when √d ∉ F.
-- Part of the Constructible blueprint.
-- Planned home: Algebra/Field/QuadraticAdjoin.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Constructible.QuadraticAdjoin
import RealSubfield

-- The total realSqrt keeps the comprehension unconditional; the laws below
-- take d nonnegative, where realSqrt(d) is √d.
def adjoinSqrt (F d : Set) : Set :=
  { z ∈ ℝ | ∃ a ∈ F, ∃ b ∈ F, z = (a:R) + (b:R) * (realSqrt(d):R) }

theorem adjoinSqrt.mem_iff (F d z : Set)
  shows z ∈ adjoinSqrt(F, d) ↔
    z ∈ ℝ ∧ ∃ a ∈ F, ∃ b ∈ F, z = (a:R) + (b:R) * (realSqrt(d):R)
proof
  sorry

theorem adjoinSqrt.subset_reals (F d : Set)
  shows adjoinSqrt(F, d) ⊆ ℝ
proof
  sorry

theorem adjoinSqrt.intro (F : Set) (d a b : Real)
  requires field : RealSubfield(F)
  requires dNonneg : (0:R) ≤ d
  requires aIn : a ∈ F
  requires bIn : b ∈ F
  shows a + b * √d ∈ adjoinSqrt(F, d)
proof
  sorry

theorem adjoinSqrt.cases (F : Set) (d : Real) (r : Set)
  requires dNonneg : (0:R) ≤ d
  requires rIn : r ∈ adjoinSqrt(F, d)
  shows ∃ a ∈ F, ∃ b ∈ F, r = (a:R) + (b:R) * √d
proof
  sorry

-- x = x + 0 · √d.
theorem adjoinSqrt.contains (F : Set) (d : Real)
  requires field : RealSubfield(F)
  requires dNonneg : (0:R) ≤ d
  shows F ⊆ adjoinSqrt(F, d)
proof
  sorry

theorem adjoinSqrt.sqrt_mem (F : Set) (d : Real)
  requires field : RealSubfield(F)
  requires dNonneg : (0:R) ≤ d
  shows √d ∈ adjoinSqrt(F, d)
proof
  sorry

theorem adjoinSqrt.mono (F G d : Set)
  requires sub : F ⊆ G
  shows adjoinSqrt(F, d) ⊆ adjoinSqrt(G, d)
proof
  sorry

-- The inverse of a + b√d is (a − b√d) / (a² − b²d). When √d ∈ F the
-- element lies in F and its inverse with it; otherwise a² − b²d ≠ 0 by
-- coefficients_unique applied to a − b√d.
theorem adjoinSqrt.subfield (F : Set) (d : Real)
  requires field : RealSubfield(F)
  requires dIn : d ∈ F
  requires dNonneg : (0:R) ≤ d
  shows RealSubfield(adjoinSqrt(F, d))
proof
  sorry

theorem adjoinSqrt.eq_of_sqrt_mem (F : Set) (d : Real)
  requires field : RealSubfield(F)
  requires dNonneg : (0:R) ≤ d
  requires rootIn : √d ∈ F
  shows adjoinSqrt(F, d) = F
proof
  sorry

-- If b ≠ 0 then √d = -a / b lies in F.
theorem adjoinSqrt.coefficients_unique (F : Set) (d a b : Real)
  requires field : RealSubfield(F)
  requires dNonneg : (0:R) ≤ d
  requires rootOut : √d ∉ F
  requires aIn : a ∈ F
  requires bIn : b ∈ F
  requires zero : a + b * √d = 0
  shows a = 0 ∧ b = 0
proof
  sorry
