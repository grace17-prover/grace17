-- The theorem: no constructible number is a cube root of 2, and no
-- constructible number is the cosine of twenty degrees, the root of
-- 4x³ − 3x = 1/2, so the cube cannot be doubled and the angle of sixty
-- degrees cannot be trisected with ruler and compass.
-- Part of the Constructible blueprint.
-- Planned home: Geometry/Construction/Impossibility.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Constructible.Impossibility
import Descent
import CubicIntegerRoots

-- Doubling the cube

-- x³ = 2 is cubic(0, 0, −2, x) = 0; descent gives a rational root, which
-- cubic.no_rational_cube_root_two refutes.
theorem cubeRootTwo.not_constructible (x : Real)
  requires cube : x * x * x = (2:R)
  shows ¬Constructible(x)
proof
  intro xC
  have rationals := RealSubfield.rationals
  have zeroIn := rationalReals.zero_mem
  have two := realNumeral.subfield_mem at rationalReals, 2 with rationals
  have negTwo := rationalReals.neg_mem with two
  have root : cubic((0:R), (0:R), -(2:R), x) = 0
    unfold cubic
    linear_combination cube
  obtain ⟨s, sIn, sRoot⟩ := cubic.constructible_root_rational
    with zeroIn, zeroIn, negTwo, xC, root
  have refuted := cubic.no_rational_cube_root_two with sIn
  exact refuted with sRoot

theorem doublingTheCube.impossible
  shows ¬(∃ x ∈ constructibles, (x:R) * (x:R) * (x:R) = (2:R))
proof
  intro witnessed
  obtain ⟨x, xIn, cube⟩ := witnessed
  exact cubeRootTwo.not_constructible with cube, xIn

-- Trisecting the angle

-- 8x³ − 6x − 1 = 0 is the monic cubic(0, −3/4, −1/8, x) = 0, with
-- coefficients in rationalReals by rationalReals.div_mem; a rational root
-- s gives the rational root 2s of x³ − 3x − 1, which
-- cubic.no_rational_trisection_root refutes. The quotients are handled
-- through their inverses: 4 · 4⁻¹ = 1 and 8 · 8⁻¹ = 1.
theorem cosTwenty.not_constructible (x : Real)
  requires equation : (8:R) * (x * x * x) - (6:R) * x - (1:R) = 0
  shows ¬Constructible(x)
proof
  intro xC
  have rationals := RealSubfield.rationals
  have zeroIn := rationalReals.zero_mem
  have oneIn := rationalReals.one_mem
  have two := realNumeral.subfield_mem at rationalReals, 2 with rationals
  have three := realNumeral.subfield_mem at rationalReals, 3 with rationals
  have four := realNumeral.subfield_mem at rationalReals, 4 with rationals
  have eight := realNumeral.subfield_mem at rationalReals, 8 with rationals
  have negThree := rationalReals.neg_mem with three
  have negOne := rationalReals.neg_mem with oneIn
  have fourNonzero : (4:R) ≠ 0
    intro zero
    linarith
  have eightNonzero : (8:R) ≠ 0
    intro zero
    linarith
  have bIn := rationalReals.div_mem with negThree, four, fourNonzero
  have cIn := rationalReals.div_mem with negOne, eight, eightNonzero
  have fourView := realDiv.eq_mul_inv at -(3:R), (4:R)
  have eightView := realDiv.eq_mul_inv at -(1:R), (8:R)
  have fourUnit := realInvValue.mul_right with fourNonzero
  have eightUnit := realInvValue.mul_right with eightNonzero
  have root : cubic((0:R), -(3:R) / (4:R), -(1:R) / (8:R), x) = 0
    unfold cubic
    rw [fourView, eightView]
    linear_combination realInvValue((8:R)) * equation +
      (-(x * x * x) + (3:R) * x * realInvValue((4:R))) * eightUnit -
      ((6:R) * x * realInvValue((8:R))) * fourUnit
  obtain ⟨s, sIn, sRoot⟩ := cubic.constructible_root_rational
    with zeroIn, bIn, cIn, xC, root
  have doubleIn := rationalReals.mul_mem with two, sIn
  have doubleRoot : cubic((0:R), -(3:R), -(1:R), (2:R) * s) = 0
    unfold cubic at sRoot
    rw [fourView, eightView] at sRoot
    unfold cubic
    linear_combination (8:R) * sRoot + ((6:R) * s) * fourUnit + eightUnit
  have refuted := cubic.no_rational_trisection_root with doubleIn
  exact refuted with doubleRoot

-- 4c³ − 3c is cos 3θ for c = cos θ, and cos(π/3) = 1/2: a constructible
-- cosine of twenty degrees would be a constructible root of this equation.
theorem trisection.impossible
  shows ¬(∃ x ∈ constructibles,
    (4:R) * ((x:R) * (x:R) * (x:R)) - (3:R) * (x:R) = (1:R) / (2:R))
proof
  intro witnessed
  obtain ⟨x, xIn, half⟩ := witnessed
  have twoNonzero : (2:R) ≠ 0
    intro zero
    linarith
  have halfView := realDiv.eq_mul_inv at (1:R), (2:R)
  have twoUnit := realInvValue.mul_right with twoNonzero
  have equation : (8:R) * ((x:R) * (x:R) * (x:R)) - (6:R) * (x:R) - (1:R) = 0
    rw halfView at half
    linear_combination (2:R) * half + twoUnit
  exact cosTwenty.not_constructible with equation, xIn
