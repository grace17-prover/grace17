-- The theorem: no constructible number is a cube root of 2, and no
-- constructible number is the cosine of twenty degrees, the root of
-- 4x³ − 3x = 1/2, so the cube cannot be doubled and the angle of sixty
-- degrees cannot be trisected with ruler and compass.
-- Part of the Constructible blueprint.
-- Planned home: Geometry/Construction/Impossibility.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Constructible.Impossibility
import Descent
import CubicIntegerRoots

-- x³ = 2 is cubic(0, 0, −2, x) = 0; descent gives a rational root, which
-- cubic.no_rational_cube_root_two refutes.
theorem cubeRootTwo.not_constructible (x : Real)
  requires cube : x * x * x = (2:R)
  shows ¬Constructible(x)
proof
  sorry

theorem doublingTheCube.impossible
  shows ¬(∃ x ∈ constructibles, (x:R) * (x:R) * (x:R) = (2:R))
proof
  sorry

-- 8x³ − 6x − 1 = 0 is the monic cubic(0, −3/4, −1/8, x) = 0, with
-- coefficients in rationalReals by rationalReals.div_int; a rational root
-- s gives the rational root 2s of x³ − 3x − 1, which
-- cubic.no_rational_trisection_root refutes.
theorem cosTwenty.not_constructible (x : Real)
  requires equation : (8:R) * (x * x * x) - (6:R) * x - (1:R) = 0
  shows ¬Constructible(x)
proof
  sorry

-- 4c³ − 3c is cos 3θ for c = cos θ, and cos(π/3) = 1/2: a constructible
-- cosine of twenty degrees would be a constructible root of this equation.
theorem trisection.impossible
  shows ¬(∃ x ∈ constructibles,
    (4:R) * ((x:R) * (x:R) * (x:R)) - (3:R) * (x:R) = (1:R) / (2:R))
proof
  sorry
