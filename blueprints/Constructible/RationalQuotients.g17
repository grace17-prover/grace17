-- The rationals inside the reals as quotients of integers: x is rational
-- exactly when x q = p for integers p, q with q ≠ 0, and the closure laws
-- of rationalReals that follow from this form through realInt alone.
-- Part of the Constructible blueprint.
-- Planned home: Real/RationalQuotients.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Constructible.RationalQuotients
import Grace.Cumulus.Real.Rationals
import Grace.Cumulus.Real.Integer

-- Forward: Rational.coordinates writes the rational as a class (a, b, m),
-- and rationalCut.scaled, realInt.class, realInt.nat give the quotient.
-- Backward: realInt.range writes p and q as differences of naturals, and
-- rationalCut.scaled applies after the sign cases of q.
theorem rationalReals.quotient (x : Real)
  shows x ∈ rationalReals ↔
    ∃ p ∈ ℤ, ∃ q ∈ ℤ, q ≠ 0 ∧ x * realInt(q) = realInt(p)
proof
  sorry

theorem rationalReals.real (x : Set)
  requires member : x ∈ rationalReals
  shows Real(x)
proof
  sorry

theorem rationalReals.zero_mem
  shows (0:R) ∈ rationalReals
proof
  sorry

theorem rationalReals.one_mem
  shows (1:R) ∈ rationalReals
proof
  sorry

theorem rationalReals.add_mem (x y : Real)
  requires xIn : x ∈ rationalReals
  requires yIn : y ∈ rationalReals
  shows x + y ∈ rationalReals
proof
  sorry

theorem rationalReals.neg_mem (x : Real)
  requires xIn : x ∈ rationalReals
  shows -x ∈ rationalReals
proof
  sorry

theorem rationalReals.sub_mem (x y : Real)
  requires xIn : x ∈ rationalReals
  requires yIn : y ∈ rationalReals
  shows x - y ∈ rationalReals
proof
  sorry

theorem rationalReals.mul_mem (x y : Real)
  requires xIn : x ∈ rationalReals
  requires yIn : y ∈ rationalReals
  shows x * y ∈ rationalReals
proof
  sorry

-- The inverse of p/q is q/p: the quotient form needs no inverse on ℚ.
theorem rationalReals.inv_mem (x : Real)
  requires xIn : x ∈ rationalReals
  requires nonzero : x ≠ 0
  shows realInvValue(x) ∈ rationalReals
proof
  sorry

theorem rationalReals.div_mem (x y : Real)
  requires xIn : x ∈ rationalReals
  requires yIn : y ∈ rationalReals
  requires nonzero : y ≠ 0
  shows x / y ∈ rationalReals
proof
  sorry

theorem rationalReals.int_mem (z : Integer)
  shows realInt(z) ∈ rationalReals
proof
  sorry

theorem rationalReals.nat_mem (n : Nat)
  shows realNat(n) ∈ rationalReals
proof
  sorry

theorem rationalReals.div_int (p q : Integer)
  requires nonzero : q ≠ 0
  shows realInt(p) / realInt(q) ∈ rationalReals
proof
  sorry
