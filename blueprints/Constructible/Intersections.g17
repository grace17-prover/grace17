-- The coordinates of an intersection of two lines, a line and a circle,
-- or two circles lie in every constructibly closed set containing the
-- coordinates of the defining points: the first is a linear system, the
-- other two reduce to a quadratic equation over the set.
-- Part of the Constructible blueprint.
-- Planned home: Geometry/Construction/Intersections.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Constructible.Intersections
import Numbers
import Grace.Cumulus.Geometry

-- A root of a quadratic with coefficients in S and leading coefficient
-- nonzero lies in S: t = (−β ± √(β² − 4αγ)) / (2α), where the square root
-- is realSqrt((2αt + β)²) = |2αt + β| ∈ S.
theorem ConstructiblyClosed.quadratic_root (S : Set) (α β γ t : Real)
  requires closed : ConstructiblyClosed(S)
  requires αIn : α ∈ S
  requires βIn : β ∈ S
  requires γIn : γ ∈ S
  requires nonzero : α ≠ 0
  requires root : α * (t * t) + β * t + γ = 0
  shows t ∈ S
proof
  sorry

-- Two lines: p = a + t(b − a) = c + u(d − c) is a linear system in t, u
-- with determinant directionCross(a, b, c, d), solved by LinearSystem2.
theorem lineLine.coordinates_closed (S : Set) (a b c d p : Point)
  (t u : Real)
  requires closed : ConstructiblyClosed(S)
  requires aIn : x(a) ∈ S ∧ y(a) ∈ S
  requires bIn : x(b) ∈ S ∧ y(b) ∈ S
  requires cIn : x(c) ∈ S ∧ y(c) ∈ S
  requires dIn : x(d) ∈ S ∧ y(d) ∈ S
  requires notParallel : directionCross(a, b, c, d) ≠ 0
  requires onFirst : OnLine(p, a, b, t)
  requires onSecond : OnLine(p, c, d, u)
  shows x(p) ∈ S ∧ y(p) ∈ S
proof
  sorry

-- A line and a circle: substituting p = a + t(b − a) into the circle
-- equation gives αt² + βt + γ = 0 with α = distanceSquared(a, b) > 0.
theorem lineCircle.coordinates_closed (S : Set) (a b c w p : Point)
  (t : Real)
  requires closed : ConstructiblyClosed(S)
  requires aIn : x(a) ∈ S ∧ y(a) ∈ S
  requires bIn : x(b) ∈ S ∧ y(b) ∈ S
  requires cIn : x(c) ∈ S ∧ y(c) ∈ S
  requires wIn : x(w) ∈ S ∧ y(w) ∈ S
  requires distinct : a ≠ b
  requires onLine : OnLine(p, a, b, t)
  requires onCircle : OnCircle(p, c, w)
  shows x(p) ∈ S ∧ y(p) ∈ S
proof
  sorry

-- Two circles: the difference of the circle equations is linear in the
-- coordinates of p with a nonzero coefficient, which eliminates one
-- coordinate and leaves a quadratic over S in the other.
theorem circleCircle.coordinates_closed (S : Set) (c w e v p : Point)
  requires closed : ConstructiblyClosed(S)
  requires cIn : x(c) ∈ S ∧ y(c) ∈ S
  requires wIn : x(w) ∈ S ∧ y(w) ∈ S
  requires eIn : x(e) ∈ S ∧ y(e) ∈ S
  requires vIn : x(v) ∈ S ∧ y(v) ∈ S
  requires centers : c ≠ e
  requires onFirst : OnCircle(p, c, w)
  requires onSecond : OnCircle(p, e, v)
  shows x(p) ∈ S ∧ y(p) ∈ S
proof
  sorry
