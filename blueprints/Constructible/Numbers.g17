-- Constructible real numbers: the least subset of ℝ that is a subfield
-- closed under square roots of its nonnegative elements, with its
-- induction principle and closure laws.
-- Part of the Constructible blueprint.
-- Planned home: Geometry/Construction/Numbers.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Constructible.Numbers
import RealSubfield

-- A set of reals closed under the field operations and square roots.
predicate ConstructiblyClosed (S : Set) :=
  RealSubfield(S) ∧ (∀ x ∈ S, (0:R) ≤ (x:R) → realSqrt(x) ∈ S)

-- The intersection of every constructibly closed set.
def constructibles : Set :=
  { x ∈ ℝ | ∀ S, ConstructiblyClosed(S) → x ∈ S }

predicate Constructible (x : Set) := x ∈ constructibles

theorem constructibles.mem_iff (x : Set)
  shows x ∈ constructibles ↔
    x ∈ ℝ ∧ (∀ S, ConstructiblyClosed(S) → x ∈ S)
proof
  sorry

theorem constructibles.subset_reals
  shows constructibles ⊆ ℝ
proof
  sorry

-- The induction principle: a closed set contains every constructible.
theorem constructibles.least (S : Set)
  requires closed : ConstructiblyClosed(S)
  shows constructibles ⊆ S
proof
  sorry

-- The intersection of closed sets is closed (ℝ itself is one).
theorem constructibles.closed
  shows ConstructiblyClosed(constructibles)
proof
  sorry

theorem constructibles.subfield
  shows RealSubfield(constructibles)
proof
  sorry

theorem Constructible.real (x : Set)
  requires constructible : Constructible(x)
  shows Real(x)
proof
  sorry

instance Constructible.add (x y : Real)
  requires xC : Constructible(x)
  requires yC : Constructible(y)
  shows Constructible(x + y)
proof
  sorry

instance Constructible.mul (x y : Real)
  requires xC : Constructible(x)
  requires yC : Constructible(y)
  shows Constructible(x * y)
proof
  sorry

instance Constructible.neg (x : Real)
  requires xC : Constructible(x)
  shows Constructible(-x)
proof
  sorry

instance Constructible.sub (x y : Real)
  requires xC : Constructible(x)
  requires yC : Constructible(y)
  shows Constructible(x - y)
proof
  sorry

-- The square root law takes its nonnegativity as the predicate
-- NonnegativeReal, which also discharges the soft type of √x.
instance Constructible.sqrt (x : Real)
  requires xC : Constructible(x)
  requires nonneg : NonnegativeReal(x)
  shows Constructible(√x)
proof
  sorry

theorem Constructible.sqrt_of_le (x : Real)
  requires xC : Constructible(x)
  requires nonneg : (0:R) ≤ x
  shows Constructible(realSqrt(x))
proof
  sorry

theorem Constructible.inv (x : Real)
  requires xC : Constructible(x)
  requires nonzero : x ≠ 0
  shows Constructible(realInvValue(x))
proof
  sorry

theorem Constructible.div (x y : Real)
  requires xC : Constructible(x)
  requires yC : Constructible(y)
  requires nonzero : y ≠ 0
  shows Constructible(x / y)
proof
  sorry

theorem Constructible.zero
  shows Constructible((0:R))
proof
  sorry

theorem Constructible.one
  shows Constructible((1:R))
proof
  sorry

theorem Constructible.numeral (n : Nat)
  shows Constructible(realNat(n))
proof
  sorry

theorem Constructible.rational (x : Set)
  requires xIn : x ∈ rationalReals
  shows Constructible(x)
proof
  sorry
