-- Authors: Grant Passmore

module Constructible.RealSubfield
import RationalQuotients
import Grace.Cumulus.Real.Field
import Grace.Cumulus.Algebra.Ring.Subring

-- The definition

-- A subfield of ℝ: a set of reals with 0 and 1, closed under negation,
-- addition, multiplication, and inverses of nonzero elements.
predicate RealSubfield (F : Set) :=
  F ⊆ ℝ ∧ (0:R) ∈ F ∧ (1:R) ∈ F ∧
  (∀ x ∈ F, -(x:R) ∈ F) ∧ (∀ x y ∈ F, (x:R) + (y:R) ∈ F) ∧
  (∀ x y ∈ F, (x:R) * (y:R) ∈ F) ∧
  (∀ x ∈ F, x ≠ (0:R) → realInvValue(x) ∈ F)

theorem RealSubfield.mk (F : Set)
  requires bounded : F ⊆ ℝ
  requires zeroIn : (0:R) ∈ F
  requires oneIn : (1:R) ∈ F
  requires negatives : ∀ x ∈ F, -(x:R) ∈ F
  requires sums : ∀ x y ∈ F, (x:R) + (y:R) ∈ F
  requires products : ∀ x y ∈ F, (x:R) * (y:R) ∈ F
  requires inverses : ∀ x ∈ F, x ≠ (0:R) → realInvValue(x) ∈ F
  shows RealSubfield(F)
proof
  unfold RealSubfield
  exact ⟨bounded, zeroIn, oneIn, negatives, sums, products, inverses⟩

theorem RealSubfield.subset (F : Set)
  requires field : RealSubfield(F)
  shows F ⊆ ℝ
proof
  exact field.left

theorem RealSubfield.real (F x : Set)
  requires field : RealSubfield(F)
  requires member : x ∈ F
  shows Real(x)
proof
  have bounded := RealSubfield.subset with field
  exact bounded with x, member

-- The membership laws

instance RealSubfield.zero_mem (F : Set)
  requires field : RealSubfield(F)
  shows (0:R) ∈ F
proof
  obtain ⟨_, zeroIn, _⟩ := field
  exact zeroIn

instance RealSubfield.one_mem (F : Set)
  requires field : RealSubfield(F)
  shows (1:R) ∈ F
proof
  obtain ⟨_, _, oneIn, _⟩ := field
  exact oneIn

instance RealSubfield.neg_mem (F : Set) (x : Real)
  requires field : RealSubfield(F)
  requires xIn : x ∈ F
  shows -x ∈ F
proof
  obtain ⟨_, _, _, negatives, _⟩ := field
  exact negatives with x, xIn

instance RealSubfield.add_mem (F : Set) (x y : Real)
  requires field : RealSubfield(F)
  requires xIn : x ∈ F
  requires yIn : y ∈ F
  shows x + y ∈ F
proof
  obtain ⟨_, _, _, _, sums, _⟩ := field
  exact sums with x, xIn, y, yIn

instance RealSubfield.mul_mem (F : Set) (x y : Real)
  requires field : RealSubfield(F)
  requires xIn : x ∈ F
  requires yIn : y ∈ F
  shows x * y ∈ F
proof
  obtain ⟨_, _, _, _, _, products, _⟩ := field
  exact products with x, xIn, y, yIn

instance RealSubfield.sub_mem (F : Set) (x y : Real)
  requires field : RealSubfield(F)
  requires xIn : x ∈ F
  requires yIn : y ∈ F
  shows x - y ∈ F
proof
  have negIn : -y ∈ F := RealSubfield.neg_mem with field, yIn
  unfold realSubValue
  exact RealSubfield.add_mem with field, xIn, negIn

-- A nonvanishing premise is not a predicate, so the inverse and quotient
-- laws are theorems rather than instances.
theorem RealSubfield.inv_mem (F : Set) (x : Real)
  requires field : RealSubfield(F)
  requires xIn : x ∈ F
  requires nonzero : x ≠ 0
  shows realInvValue(x) ∈ F
proof
  obtain ⟨_, _, _, _, _, _, inverses⟩ := field
  exact inverses with x, xIn, nonzero

theorem RealSubfield.div_mem (F : Set) (x y : Real)
  requires field : RealSubfield(F)
  requires xIn : x ∈ F
  requires yIn : y ∈ F
  requires nonzero : y ≠ 0
  shows x / y ∈ F
proof
  have invIn := RealSubfield.inv_mem with field, yIn, nonzero
  rw realDiv.eq_mul_inv
  exact RealSubfield.mul_mem with field, xIn, invIn

-- Naturals, integers, and rationals

-- Induction on n: the step is realNumeral.succ through realNumeral.nat.
theorem RealSubfield.numeral_mem (F : Set) (n : Nat)
  requires field : RealSubfield(F)
  shows realNat(n) ∈ F
proof
  induction n
  | zero =>
    rw realNat.zero
    exact RealSubfield.zero_mem with field
  | succ(k) using ih =>
    have oneIn : (1:R) ∈ F := RealSubfield.one_mem with field
    rw [← realNumeral.nat, realNumeral.succ, realNumeral.nat]
    exact RealSubfield.add_mem with field, ih, oneIn

-- A real numeral literal lies in every subfield: it is realNat(n).
theorem realNumeral.subfield_mem (F : Set) (n : Nat)
  requires field : RealSubfield(F)
  shows realNumeral(n) ∈ F
proof
  rw realNumeral.nat
  exact RealSubfield.numeral_mem with field

theorem RealSubfield.int_mem (F : Set) (z : Integer)
  requires field : RealSubfield(F)
  shows realInt(z) ∈ F
proof
  obtain ⟨a, aNat, b, bNat, shape⟩ := Integer.representatives at z with *
  have value := realInt.class at a, b with aNat, bNat
  have aIn := RealSubfield.numeral_mem at F, a with field
  have bIn := RealSubfield.numeral_mem at F, b with field
  rw [shape, value]
  exact RealSubfield.sub_mem with field, aIn, bIn

theorem RealSubfield.whole
  shows RealSubfield(ℝ)
proof
  have reflexive := Subset.reflexive at ℝ
  have zeroIn : (0:R) ∈ ℝ := realZero.real
  have oneIn : (1:R) ∈ ℝ := realOne.real
  apply RealSubfield.mk with reflexive, zeroIn, oneIn
  . intros x hx
    exact realNegValue.real at x
  . intros x hx y hy
    exact realAddValue.real at x, y
  . intros x hx y hy
    exact realMulValue.real at x, y
  . intros x hx nonzero
    exact realInvValue.real at x

theorem RealSubfield.rationals
  shows RealSubfield(rationalReals)
proof
  have bounded : rationalReals ⊆ ℝ
    intros x hx
    exact rationalReals.real with hx
  have zeroIn := rationalReals.zero_mem
  have oneIn := rationalReals.one_mem
  apply RealSubfield.mk with bounded, zeroIn, oneIn
  . intros x hx
    exact rationalReals.neg_mem with hx
  . intros x hx y hy
    exact rationalReals.add_mem with hx, hy
  . intros x hx y hy
    exact rationalReals.mul_mem with hx, hy
  . intros x hx nonzero
    exact rationalReals.inv_mem with hx, nonzero

-- A rational is a quotient realInt(p) / realInt(q) of elements of F.
theorem RealSubfield.rationals_subset (F : Set)
  requires field : RealSubfield(F)
  shows rationalReals ⊆ F
proof
  intros x hx
  have quotient := rationalReals.quotient at x
  obtain ⟨p, pInt, q, qInt, qNonzero, equation⟩ := quotient.forward with hx
  have pIn := RealSubfield.int_mem at F, p with field
  have qIn := RealSubfield.int_mem at F, q with field
  have qNonzeroReal := realInt.nonzero at q with qNonzero
  have cancel := realInvValue.mul_right with qNonzeroReal
  have shape : x = realInt(p) / realInt(q)
    rw realDiv.eq_mul_inv
    linear_combination realInvValue(realInt(q)) * equation - x * cancel
  rw shape
  exact RealSubfield.div_mem with field, pIn, qIn, qNonzeroReal

-- The bridges

-- To the bundled ring of the reals.
theorem RealSubfield.subring (F : Set)
  requires field : RealSubfield(F)
  shows Subring(realRing, F)
proof
  obtain ⟨bounded, zeroIn, oneIn, negatives, sums, products, _⟩ := field
  have parts : IsSubring(ℝ, realAdd, realZero, realNeg, realMul, realOne, F)
    unfold IsSubring
    refine ⟨bounded, zeroIn, oneIn, ?_, ?_, ?_⟩
    . unfold ClosedUnary
      exact negatives
    . unfold ClosedBinary
      exact sums
    . unfold ClosedBinary
      exact products
  unfold realRing
  exact Subring.of_parts with parts

-- Zero product over the reals, in real notation: a field has no zero
-- divisors (IsField.no_zero_divisors with reals.field).
theorem realMulValue.eq_zero_or (a b : Real)
  requires product : a * b = 0
  shows a = 0 ∨ b = 0
proof
  have field := IsFieldWithInverse.is_field with reals.field
  have noZero := IsField.no_zero_divisors with field
  have realA : a ∈ ℝ by simp [Real]
  have realB : b ∈ ℝ by simp [Real]
  exact noZero with a, realA, b, realB, product
