-- Descent of a cubic root through a quadratic tower: a rational cubic with
-- a root in a tower field has a rational root, so a constructible root
-- forces a rational one.
-- Part of the Constructible blueprint.
-- Planned home: Geometry/Construction/Descent.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Constructible.Descent
import CubicConjugation
import Tower

-- Induction on ds with cubic.root_descends at each level, the root
-- quantified inside the conclusion so that the descended root feeds the
-- induction hypothesis; the coefficients lie in every tower field by
-- towerField.rationals.
theorem cubic.tower_descent_all (ds : List(ℝ)) (a b c : Real)
  requires tower : QuadraticTower(ds)
  requires aIn : a ∈ rationalReals
  requires bIn : b ∈ rationalReals
  requires cIn : c ∈ rationalReals
  shows ∀ r ∈ towerField(ds),
    cubic(a, b, c, (r:R)) = 0 → (∃ s ∈ rationalReals, cubic(a, b, c, s) = 0)
proof
  induction ds
  | List.nil =>
    intros tower r rIn root
    rw towerField.nil at rIn
    exact ⟨r, rIn, root⟩
  | List.cons(d, tail) using ih =>
    intros tower r rIn root
    have dReal : d ∈ ℝ by assumption
    have below := QuadraticTower.tail with tower
    have top := QuadraticTower.head with tower
    have field := towerField.subfield with below
    have rationals := towerField.rationals with below
    have aUp := rationals with a, aIn
    have bUp := rationals with b, bIn
    have cUp := rationals with c, cIn
    rw towerField.cons at rIn
    have bounded := adjoinSqrt.subset_reals at towerField(tail), d
    have rReal := bounded with r, rIn
    obtain ⟨s, sIn, sRoot⟩ := cubic.root_descends
      with field, top.left, top.right, aUp, bUp, cUp, rIn, root
    have inner := ih with below
    exact inner with s, sIn, sRoot

theorem cubic.tower_descent (ds : List(ℝ)) (a b c r : Real)
  requires tower : QuadraticTower(ds)
  requires aIn : a ∈ rationalReals
  requires bIn : b ∈ rationalReals
  requires cIn : c ∈ rationalReals
  requires rIn : r ∈ towerField(ds)
  requires root : cubic(a, b, c, r) = 0
  shows ∃ s ∈ rationalReals, cubic(a, b, c, s) = 0
proof
  have all := cubic.tower_descent_all with tower, aIn, bIn, cIn
  exact all with r, rIn, root

theorem cubic.constructible_root_rational (a b c r : Real)
  requires aIn : a ∈ rationalReals
  requires bIn : b ∈ rationalReals
  requires cIn : c ∈ rationalReals
  requires rC : Constructible(r)
  requires root : cubic(a, b, c, r) = 0
  shows ∃ s ∈ rationalReals, cubic(a, b, c, s) = 0
proof
  obtain ⟨ds, dsList, tower, rIn⟩ := Constructible.in_tower with rC
  exact cubic.tower_descent with tower, aIn, bIn, cIn, rIn, root
