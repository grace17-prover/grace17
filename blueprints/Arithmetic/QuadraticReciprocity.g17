-- Authors: Grant Passmore

module Arithmetic.QuadraticReciprocity
import LatticeCount
import GaussLemma
import EulerCriterion

-- Distinct primes do not divide each other.
theorem Prime.not_divides_distinct (p q : Nat)
  requires primeP : Prime(p)
  requires primeQ : Prime(q)
  requires distinct : p ≠ q
  shows ¬(p ∣ q)
proof
  sorry

-- The residue of an odd prime modulo 4 reads off the parity of its half.
theorem oddPrime.one_mod_four_iff (p h : Nat)
  requires odd : p = 2 * h + 1
  shows p % 4 = 1 ↔ Even(h)
proof
  sorry

theorem oddPrime.three_mod_four_iff (p h : Nat)
  requires odd : p = 2 * h + 1
  shows p % 4 = 3 ↔ Odd(h)
proof
  sorry

-- Parities: the Gauss counts have the parities of the two floor sums
-- (gauss.parity, with q odd and p ∤ q), which add to hp · hq
-- (lattice.count); the residue statements are the two parities
-- (gauss.residue_iff).
theorem quadratic_reciprocity (p q hp hq : Nat)
  requires primeP : Prime(p)
  requires primeQ : Prime(q)
  requires distinct : p ≠ q
  requires oddP : p = 2 * hp + 1
  requires oddQ : q = 2 * hq + 1
  shows (QuadraticResidue(q, p) ↔ QuadraticResidue(p, q)) ↔ Even(hp * hq)
proof
  sorry

theorem quadratic_reciprocity.one_mod_four (p q hp hq : Nat)
  requires primeP : Prime(p)
  requires primeQ : Prime(q)
  requires distinct : p ≠ q
  requires oddP : p = 2 * hp + 1
  requires oddQ : q = 2 * hq + 1
  requires pOne : p % 4 = 1
  shows QuadraticResidue(q, p) ↔ QuadraticResidue(p, q)
proof
  sorry

theorem quadratic_reciprocity.three_mod_four (p q hp hq : Nat)
  requires primeP : Prime(p)
  requires primeQ : Prime(q)
  requires distinct : p ≠ q
  requires oddP : p = 2 * hp + 1
  requires oddQ : q = 2 * hq + 1
  requires pThree : p % 4 = 3
  requires qThree : q % 4 = 3
  shows QuadraticResidue(q, p) ↔ ¬QuadraticResidue(p, q)
proof
  sorry
