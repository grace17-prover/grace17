-- Quadratic residues modulo a prime and Euler's criterion by the Wilson
-- pairing: for an odd prime p = 2h + 1 and a not divisible by p, a is a
-- square modulo p exactly when a^h ≡ 1, and otherwise a^h ≡ −1; the first
-- supplement, −1 is a square modulo p exactly when h is even.
-- Part of the Arithmetic blueprint.
-- Planned home: NumberTheory/EulerCriterion.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Arithmetic.EulerCriterion
import Grace.Cumulus.NumberTheory.Wilson
import Grace.Cumulus.NumberTheory.ModularMore
import Grace.Cumulus.NumberTheory.CoprimeCancel

predicate QuadraticResidue (a p : Nat) :=
  ∃ x, Nat(x) ∧ CongruentMod(x * x, a, p)

theorem QuadraticResidue.intro (a p x : Nat)
  requires square : CongruentMod(x * x, a, p)
  shows QuadraticResidue(a, p)
proof
  unfold QuadraticResidue
  witness x
  exact square

theorem QuadraticResidue.mod_iff (a p : Nat)
  shows QuadraticResidue(a % p, p) ↔ QuadraticResidue(a, p)
proof
  constructor
  . intro residue
    obtain ⟨x, xNat, square⟩ := residue
    have back := CongruentMod.mod_left at a, p
    have chain := CongruentMod.transitive with square, back
    exact QuadraticResidue.intro with chain
  . intro residue
    obtain ⟨x, xNat, square⟩ := residue
    have forward := CongruentMod.mod_right at a, p
    have chain := CongruentMod.transitive with square, forward
    exact QuadraticResidue.intro with chain

theorem QuadraticResidue.of_congruent (a b p : Nat)
  requires congruent : CongruentMod(a, b, p)
  requires residue : QuadraticResidue(a, p)
  shows QuadraticResidue(b, p)
proof
  obtain ⟨x, xNat, square⟩ := residue
  have chain := CongruentMod.transitive with square, congruent
  exact QuadraticResidue.intro with chain

theorem QuadraticResidue.mul (a b p : Nat)
  requires first : QuadraticResidue(a, p)
  requires second : QuadraticResidue(b, p)
  shows QuadraticResidue(a * b, p)
proof
  obtain ⟨x, xNat, squareX⟩ := first
  obtain ⟨y, yNat, squareY⟩ := second
  have product := CongruentMod.mul with squareX, squareY
  have rearrange : (x * y) * (x * y) = (x * x) * (y * y) by ring
  rw ← rearrange at product
  exact QuadraticResidue.intro with product

-- The length of the factorial list m, …, 1 is m.
theorem factorialList.length (m : Nat)
  shows length{ℕ}(factorialList(m)) = m
proof
  induction m
  | zero =>
    rw factorialList.zero
    exact length.nil at ℕ
  | succ(k) using ih =>
    have restList := factorialList.list at k
    have expand := length.cons at ℕ, succ(k), factorialList(k) with *
    rw [factorialList.succ, expand, ih]
    rfl

-- A root x of x² ≡ a is coprime to p, so a^h ≡ x^(2h) = x^(p−1) ≡ 1.
theorem euler.residue_pow (a p h : Nat)
  requires prime : Prime(p)
  requires odd : p = 2 * h + 1
  requires notDivides : ¬(p ∣ a)
  requires residue : QuadraticResidue(a, p)
  shows a ^ h % p = 1
proof
  obtain ⟨x, xNat, square⟩ := residue
  have nonzero := Prime.nonzero with prime
  have xNotDivides : ¬(p ∣ x)
    intro divides
    apply notDivides
    have dividesSquare := divides.multiply_right at p, x, x with divides
    have zero := mod.of_divides with dividesSquare
    unfold CongruentMod at square
    rw zero at square
    symm at square
    have characterization := mod.zero_iff at p, a with nonzero
    exact characterization.forward with square
  have fermat := fermat.little with prime, xNotDivides
  have exponent : p - 1 = 2 * h
    rw odd
    exact sub.add_one_right at 2 * h
  rw exponent at fermat
  have squareForm : (x * x) ^ h = x ^ (2 * h)
    have split := pow.mul_base at x, x, h
    have double := pow.double_exponent at x, h
    have two := pow.two at x ^ h
    rw [split, double, two]
    rfl
  have powers := CongruentMod.pow at x * x, a, h, p with square
  unfold CongruentMod at powers
  rw [squareForm, fermat] at powers
  symm at powers
  exact powers

-- The selected inverse is a natural for every p and x: the candidates lie
-- in p, so their union is an ordinal within p.
theorem modInverse.natural_total (p x : Nat)
  shows Nat(modInverse(p, x))
proof
  unfold modInverse
  have pOrdinal := Ordinal.natural at p
  have members : ∀ y, y ∈ modInverse.candidates(p, x) → y ∈ p
    intros y yMember
    unfold modInverse.candidates at yMember
    exact yMember.left
  have ordinals : ∀ α ∈ modInverse.candidates(p, x), α ∈ Ordinal
    intros α αMember
    have inP := members with αMember
    exact Ordinal.member with pOrdinal, inP
  have subsets : ∀ α ∈ modInverse.candidates(p, x), α ⊆ p
    intros α αMember
    have inP := members with αMember
    exact Ordinal.member_subset with pOrdinal, inP
  have unionOrdinal := Ordinal.union with ordinals
  have within := Ordinal.union_least with subsets
  have bounded := Ordinal.subset_bound with unionOrdinal, pOrdinal, within
  have same := next.natural at p
  rw ← same at bounded
  have split := membership.successor_forward with bounded
  cases split with inP | equal
  . have naturals := natural.member at p
    exact naturals with inP
  . rw equal
    typecheck

-- The partner of x under a: a · x⁻¹ mod p.
def pairPartner (p a x : Nat) : Nat := mod(mul(a, modInverse(p, x)), p)
proof
  have inverseNat := modInverse.natural_total at p, x
  unfold pairPartner
  typecheck

theorem pairPartner.value (p a x : Nat)
  shows pairPartner(p, a, x) = mul(a, modInverse(p, x)) % p
proof
  unfold pairPartner
  rfl

theorem pairPartner.below (p a x : Nat)
  requires prime : Prime(p)
  shows pairPartner(p, a, x) < p
proof
  have nonzero := Prime.nonzero with prime
  have inverseNat := modInverse.natural_total at p, x
  have productNat : Nat(mul(a, modInverse(p, x))) by typecheck
  rw pairPartner.value
  exact mod.less at mul(a, modInverse(p, x)), p with nonzero

-- x times its partner is a modulo p when x is a unit.
theorem pairPartner.product (p a x : Nat)
  requires prime : Prime(p)
  requires unit : gcd(x, p) = 1
  shows (x * pairPartner(p, a, x)) % p = a % p
proof
  have nonzero := Prime.nonzero with prime
  have inverseNat := modInverse.natural with prime, unit
  have inverse := modInverse.product with prime, unit
  rw pairPartner.value
  have step1 := mod.mul_right at p, x, a * modInverse(p, x) with nonzero
  have rearrange : x * (a * modInverse(p, x)) = a * (x * modInverse(p, x))
    ring
  have step2 := mod.mul at p, a, x * modInverse(p, x) with nonzero
  have one : a % p * 1 = a % p by ring
  have idempotent := mod.mod at p, a with nonzero
  rw [step1, rearrange, step2, inverse, one, idempotent]
  rfl

-- The partner of the partner is x: modInverse.involution and
-- coprime.mul_cancel_mod.
theorem pairPartner.involution (p a x : Nat)
  requires prime : Prime(p)
  requires coprimeA : gcd(a, p) = 1
  requires positive : 0 < x
  requires below : x < p
  shows pairPartner(p, a, pairPartner(p, a, x)) = x
proof
  have nonzero := Prime.nonzero with prime
  have unit := prime.coprime_below with prime, positive, below
  have inverseUnit := modInverse.unit with prime, unit
  have inverseNat := modInverse.natural with prime, unit
  have partnerUnit : gcd(pairPartner(p, a, x), p) = 1
    rw pairPartner.value
    exact coprime.mul_mod with nonzero, coprimeA, inverseUnit
  have partnerNat : Nat(pairPartner(p, a, x)) by typecheck
  have secondBelow := pairPartner.below at p, a, pairPartner(p, a, x)
    with prime
  have first := pairPartner.product at p, a, x with prime, unit
  have commute : x * pairPartner(p, a, x) = pairPartner(p, a, x) * x by ring
  rw commute at first
  have second := pairPartner.product at p, a, pairPartner(p, a, x)
    with prime, partnerUnit
  rw ← first at second
  have cancelled := coprime.mul_cancel_mod with nonzero, partnerUnit, second
  have leftSelf := mod.of_less with secondBelow
  have rightSelf := mod.of_less with below
  rwa [leftSelf, rightSelf] at cancelled

-- A list is paired by a when every entry x occurs once, lies in 1..p−1,
-- differs from its partner, and the partner is an entry too.
predicate PairedBy (p a : Nat, xs : List(ℕ)) :=
  ∀ x, Nat(x) → 0 < multiplicity(x, xs) →
    (multiplicity(x, xs) = 1 ∧ 0 < x ∧ x < p ∧
      pairPartner(p, a, x) ≠ x ∧ 0 < multiplicity(pairPartner(p, a, x), xs))

-- A paired list of length 2k has product a^k modulo p: remove an entry and
-- its partner, whose product is a modulo p, and induct on k.
theorem PairedBy.product (p a k : Nat)
  requires prime : Prime(p)
  requires coprimeA : gcd(a, p) = 1
  shows ∀ xs, List(ℕ, xs) → length{ℕ}(xs) = 2 * k → PairedBy(p, a, xs) →
    (∏ xs) % p = a ^ k % p
proof
  induction k
  | zero =>
    intros xs xsList lengthXs paired
    have shape := List.cases with xsList
    cases shape with nil | cons
    . rw [nil, listProduct.nil, pow.zero]
      rfl
    . exfalso
      obtain ⟨x, xIn, rest, restList, equal⟩ := cons
      rw equal at lengthXs
      have expand := length.cons at ℕ, x, rest with *
      rw expand at lengthXs
      have lengthNat : Nat(length{ℕ}(rest)) by typecheck
      have impossible : succ(length{ℕ}(rest)) ≠ 2 * 0 by arith
      exact impossible with lengthXs
  | j + 1 using ih =>
    intros xs xsList lengthXs paired
    have nonzero := Prime.nonzero with prime
    have shape := List.cases with xsList
    cases shape with nil | cons
    . exfalso
      rw nil at lengthXs
      have empty := length.nil at ℕ
      rw empty at lengthXs
      have positive : 0 < 2 * (j + 1) by arith
      rw ← lengthXs at positive
      exact Less.irreflexive with *, positive
    . obtain ⟨x, xIn, rest, restList, equal⟩ := cons
      have xNat : Nat(x) by typecheck
      rw equal at lengthXs
      rw equal at paired
      rw equal
      unfold PairedBy at paired
      have xPositive : 0 < multiplicity(x, x :: rest)
        have self := multiplicity.cons_self at x, rest with *
        rw self
        arith
      obtain ⟨once, xPos, xBelow, notFixed, partnerIn⟩ :=
        paired with x, xNat, xPositive
      have unit := prime.coprime_below with prime, xPos, xBelow
      have yNat : Nat(pairPartner(p, a, x)) by typecheck
      have product := pairPartner.product at p, a, x with prime, unit
      have involution := pairPartner.involution at p, a, x
        with prime, coprimeA, xPos, xBelow
      have restZero : multiplicity(x, rest) = 0
        have self := multiplicity.cons_self at x, rest with *
        rw self at once
        have shifted : 1 + multiplicity(x, rest) = 1 + 0
          have zeroForm : 1 + 0 = (1:N) by ring
          rwa zeroForm
        have cancel := add.left_cancel at multiplicity(x, rest), 0, 1
        exact cancel with shifted
      have yInRest : 0 < multiplicity(pairPartner(p, a, x), rest)
        have other := multiplicity.cons_other at pairPartner(p, a, x), x, rest
          with notFixed
        rwa other at partnerIn
      have remove := multiplicity.remove_length at pairPartner(p, a, x), rest
        with *
      obtain ⟨zs, zsList, productRest, lengthRest, counts⟩ :=
        remove with yInRest
      have lengthZs : length{ℕ}(zs) = 2 * j
        unfold OneShorter at lengthRest
        have expand := length.cons at ℕ, x, rest with *
        rw [expand, lengthRest] at lengthXs
        have zsLengthNat : Nat(length{ℕ}(zs)) by typecheck
        arith
      have yOnce : multiplicity(pairPartner(p, a, x), x :: rest) = 1
        have propsY := paired with pairPartner(p, a, x), partnerIn
        exact propsY.left
      have yZero : multiplicity(pairPartner(p, a, x), zs) = 0
        have other := multiplicity.cons_other at pairPartner(p, a, x), x, rest
          with notFixed
        have count := counts with pairPartner(p, a, x)
        have self := multiplicity.cons_self at pairPartner(p, a, x), zs with *
        rw [other, count, self] at yOnce
        have shifted : 1 + multiplicity(pairPartner(p, a, x), zs) = 1 + 0
          have zeroForm : 1 + 0 = (1:N) by ring
          rwa zeroForm
        have cancel := add.left_cancel
          at multiplicity(pairPartner(p, a, x), zs), 0, 1
        exact cancel with shifted
      have pairedZs : PairedBy(p, a, zs)
        unfold PairedBy
        intros q qNat qPositive
        have countQ := counts with q, qNat
        have consQ := multiplicity.cons at q, pairPartner(p, a, x), zs with *
        have weightNat := chooseNat.natural
          at equalNat(q, pairPartner(p, a, x)), 1, 0
        have qInRest : 0 < multiplicity(q, rest)
          rw [countQ, consQ]
          arith
        have qInXs := multiplicity.positive_cons at q, x, rest with qInRest
        obtain ⟨onceQ, qPos, qBelow, qNotFixed, qPartnerIn⟩ :=
          paired with q, qNat, qInXs
        have rNat : Nat(pairPartner(p, a, q)) by typecheck
        have qInvolution := pairPartner.involution at p, a, q
          with prime, coprimeA, qPos, qBelow
        have qNotX : q ≠ x
          intro same
          rw [same, restZero] at qInRest
          exact Less.irreflexive with *, qInRest
        have qNotY : q ≠ pairPartner(p, a, x)
          intro same
          rw [same, yZero] at qPositive
          exact Less.irreflexive with *, qPositive
        constructor
        . have consX := multiplicity.cons_other at q, x, rest with qNotX
          rw consX at onceQ
          rw [countQ, consQ] at onceQ
          have otherY := equalNat.false_iff.backward with qNotY
          rw otherY at onceQ
          have weightZero : chooseNat(Bool.false, 1, 0) = 0 by compute
          rw weightZero at onceQ
          have zeroForm : 0 + multiplicity(q, zs) = multiplicity(q, zs) by ring
          rwa zeroForm at onceQ
        . constructor
          . exact qPos
          . constructor
            . exact qBelow
            . constructor
              . exact qNotFixed
              . have rNotX : pairPartner(p, a, q) ≠ x
                  intro same
                  apply qNotY
                  rw [← qInvolution, same]
                  rfl
                have rNotY : pairPartner(p, a, q) ≠ pairPartner(p, a, x)
                  intro same
                  apply qNotX
                  rw ← qInvolution
                  rw [same, involution]
                  rfl
                have countR := counts with pairPartner(p, a, q)
                have consRX := multiplicity.cons_other
                  at pairPartner(p, a, q), x, rest with rNotX
                have consRY := multiplicity.cons_other
                  at pairPartner(p, a, q), pairPartner(p, a, x), zs with rNotY
                rw consRX at qPartnerIn
                rwa [countR, consRY] at qPartnerIn
      have previous := ih with zs, zsList, lengthZs, pairedZs
      have expandXs := listProduct.cons at x, rest with *
      have expandRest := listProduct.cons at pairPartner(p, a, x), zs with *
      have zsProduct : Nat(∏ zs) by typecheck
      rw expandRest at productRest
      have rearrange := mul.associative_reverse
        at pairPartner(p, a, x), ∏ zs, x with *
      have split := mod.mul at p, x * pairPartner(p, a, x), ∏ zs with nonzero
      have powerStep := pow.add_one at a, j
      have powerMod := mod.mul at p, a, a ^ j with nonzero
      rw [expandXs, productRest, rearrange, split, product, previous]
      rw [powerStep, powerMod]
      rfl

-- The multiplicity of x in the list m, …, 1 is 1 when 1 ≤ x ≤ m and 0
-- otherwise.
theorem factorialList.multiplicity_out (m x : Nat)
  requires outside : ¬(1 ≤ x ∧ x ≤ m)
  shows multiplicity(x, factorialList(m)) = 0
proof
  induction m
  | zero =>
    intro outside
    rw factorialList.zero
    exact multiplicity.nil at x
  | succ(k) using ih =>
    intro outside
    have restList := factorialList.list at k
    have different : x ≠ succ(k)
      intro same
      apply outside
      rw same
      constructor
      . arith
      . arith
    have smaller : ¬(1 ≤ x ∧ x ≤ k)
      intro both
      obtain ⟨lower, upper⟩ := both
      apply outside
      constructor
      . exact lower
      . arith
    have previous := ih with smaller
    have other := multiplicity.cons_other at x, succ(k), factorialList(k)
      with different
    rw [factorialList.succ, other]
    exact previous

theorem factorialList.multiplicity_in (m x : Nat)
  requires lower : 1 ≤ x
  requires upper : x ≤ m
  shows multiplicity(x, factorialList(m)) = 1
proof
  induction m
  | zero =>
    intro upper
    exfalso
    have impossible : ¬x ≤ 0 by arith
    exact impossible with upper
  | succ(k) using ih =>
    intro upper
    have restList := factorialList.list at k
    have trichotomy := Less.trichotomy at x, succ(k)
    rcases trichotomy with below | same | above
    . have smaller : x ≤ k by arith
      have previous := ih with smaller
      have different : x ≠ succ(k)
        intro equal
        rw equal at below
        exact Less.irreflexive at succ(k) with *, below
      have other := multiplicity.cons_other at x, succ(k), factorialList(k)
        with different
      rw [factorialList.succ, other]
      exact previous
    . have outside : ¬(1 ≤ x ∧ x ≤ k)
        intro both
        obtain ⟨lowerX, upperX⟩ := both
        rw same at upperX
        have impossible : ¬succ(k) ≤ k by arith
        exact impossible with upperX
      have zero := factorialList.multiplicity_out at k, x with outside
      rw factorialList.succ
      rw same
      have self := multiplicity.cons_self at succ(k), factorialList(k) with *
      rw self
      rw same at zero
      rw zero
      ring
    . exfalso
      have impossible : ¬succ(k) < x by arith
      exact impossible with above

theorem factorialList.member (m x : Nat)
  requires positive : 0 < multiplicity(x, factorialList(m))
  shows 1 ≤ x ∧ x ≤ m
proof
  by_contra none
  have zero := factorialList.multiplicity_out with none
  rw zero at positive
  exact Less.irreflexive with *, positive

-- When a is not a square modulo p, no entry of 1..p−1 is its own partner.
theorem factorialList.pairedBy (a p h : Nat)
  requires prime : Prime(p)
  requires odd : p = 2 * h + 1
  requires notDivides : ¬(p ∣ a)
  requires nonresidue : ¬QuadraticResidue(a, p)
  shows PairedBy(p, a, factorialList(2 * h))
proof
  have nonzero := Prime.nonzero with prime
  unfold PairedBy
  intros x xNat positive
  obtain ⟨lower, upper⟩ := factorialList.member at 2 * h, x with positive
  have xPos : 0 < x by arith
  have xBelow : x < p
    rw odd
    arith
  have unit := prime.coprime_below with prime, xPos, xBelow
  have yNat : Nat(pairPartner(p, a, x)) by typecheck
  have yBelow := pairPartner.below at p, a, x with prime
  have product := pairPartner.product at p, a, x with prime, unit
  have notFixed : pairPartner(p, a, x) ≠ x
    intro fixed
    apply nonresidue
    rw fixed at product
    have congruent : CongruentMod(x * x, a, p)
      unfold CongruentMod
      exact product
    exact QuadraticResidue.intro with congruent
  have yPos : 0 < pairPartner(p, a, x)
    have trichotomy := Less.trichotomy at 0, pairPartner(p, a, x)
    rcases trichotomy with positiveY | zero | negative
    . exact positiveY
    . exfalso
      apply notDivides
      rw ← zero at product
      have vanish : x * 0 = 0 by ring
      rw [vanish, mod.zero_left] at product
      symm at product
      have characterization := mod.zero_iff at p, a with nonzero
      exact characterization.forward with product
    . exfalso
      have impossible : ¬pairPartner(p, a, x) < 0 by arith
      exact impossible with negative
  have yLower : 1 ≤ pairPartner(p, a, x) by arith
  have yUpper : pairPartner(p, a, x) ≤ 2 * h
    have bound : pairPartner(p, a, x) < 2 * h + 1
      rw ← odd
      exact yBelow
    arith
  have once := factorialList.multiplicity_in with lower, upper
  have yIn := factorialList.multiplicity_in with yLower, yUpper
  constructor
  . exact once
  . constructor
    . exact xPos
    . constructor
      . exact xBelow
      . constructor
        . exact notFixed
        . rw yIn
          arith

-- The product 1 · 2 ⋯ (p − 1) is a^h by the pairing and −1 by Wilson.
theorem euler.nonresidue_pow (a p h : Nat)
  requires prime : Prime(p)
  requires odd : p = 2 * h + 1
  requires notDivides : ¬(p ∣ a)
  requires nonresidue : ¬QuadraticResidue(a, p)
  shows (a ^ h + 1) % p = 0
proof
  have nonzero := Prime.nonzero with prime
  have coprimeA : gcd(a, p) = 1
    have certificate := Prime.coprime_of_not_divides with prime, notDivides
    have flipped := gcd.unique with certificate
    have commute := gcd.commutative at a, p
    rwa commute
  have paired := factorialList.pairedBy with prime, odd, notDivides, nonresidue
  have listFact := factorialList.list at 2 * h
  have lengthFact := factorialList.length at 2 * h
  have products := PairedBy.product at p, a, h with prime, coprimeA
  have productMod := products with factorialList(2 * h), listFact, lengthFact,
    paired
  have factorialValue := factorialList.product at 2 * h
  have wilson := wilson.theorem with prime
  have predecessor : p - 1 = 2 * h
    rw odd
    exact sub.add_one_right at 2 * h
  rw [predecessor, ← factorialValue] at wilson
  have left := mod.add at p, a ^ h, 1 with nonzero
  have right := mod.add at p, ∏ factorialList(2 * h), 1 with nonzero
  rw [left, ← productMod, ← right]
  exact wilson

-- For an odd prime, a^h ≡ 1 and a^h ≡ −1 cannot both hold: p would
-- divide 2.
theorem euler.pow_not_both (a p h : Nat)
  requires prime : Prime(p)
  requires odd : p = 2 * h + 1
  requires one : a ^ h % p = 1
  shows (a ^ h + 1) % p ≠ 0
proof
  intro zero
  have nonzero := Prime.nonzero with prime
  have aboveOne := Prime.greater_than_one with prime
  obtain ⟨q, qNat, equation⟩ := mod.equation at a ^ h, p with nonzero
  rw one at equation
  have form : a ^ h + 1 = p * q + 2
    rw equation
    ring
  have characterization := mod.zero_iff at p, a ^ h + 1 with nonzero
  have dividesSum := characterization.forward with zero
  rw form at dividesSum
  have dividesMultiple := divides.mul_left_self at p, q
  have dividesTwo := divides.add_cancel_left with dividesMultiple, dividesSum
  have twoNonzero : (2:N) ≠ 0 by arith
  have le := divides.le with dividesTwo, twoNonzero
  rw odd at le
  rw odd at aboveOne
  have impossible : ¬(2 * h + 1 ≤ 2) by arith
  exact impossible with le

theorem euler.criterion (a p h : Nat)
  requires prime : Prime(p)
  requires odd : p = 2 * h + 1
  requires notDivides : ¬(p ∣ a)
  shows QuadraticResidue(a, p) ↔ a ^ h % p = 1
proof
  constructor
  . intro residue
    exact euler.residue_pow with prime, odd, notDivides, residue
  . intro one
    by_contra nonresidue
    have zero := euler.nonresidue_pow with prime, odd, notDivides, nonresidue
    have notBoth := euler.pow_not_both with prime, odd, one
    exact notBoth with zero

theorem euler.nonresidue_iff (a p h : Nat)
  requires prime : Prime(p)
  requires odd : p = 2 * h + 1
  requires notDivides : ¬(p ∣ a)
  shows ¬QuadraticResidue(a, p) ↔ (a ^ h + 1) % p = 0
proof
  constructor
  . intro nonresidue
    exact euler.nonresidue_pow with prime, odd, notDivides, nonresidue
  . intros zero residue
    have one := euler.residue_pow with prime, odd, notDivides, residue
    have notBoth := euler.pow_not_both with prime, odd, one
    exact notBoth with zero

-- (2h)² is 1 modulo p = 2h + 1, so every even power of 2h is 1.
theorem negOne.even_pow (p h m : Nat)
  requires prime : Prime(p)
  requires odd : p = 2 * h + 1
  shows (2 * h) ^ (2 * m) % p = 1
proof
  have nonzero := Prime.nonzero with prime
  have aboveOne := Prime.greater_than_one with prime
  have hShape := natural.zero_or_successor at h
  cases hShape with zero | successor
  . exfalso
    rw [odd, zero] at aboveOne
    have impossible : ¬(1:N) < 2 * 0 + 1 by arith
    exact impossible with aboveOne
  . obtain ⟨n, nNat, form⟩ := successor
    have squareValue : (2 * h) * (2 * h) = p * (2 * n + 1) + 1
      rw [odd, form]
      ring
    have square : ((2 * h) * (2 * h)) % p = 1
      exact mod.unique with nonzero, squareValue, aboveOne
    have expand : (2 * h) ^ (2 * m) = ((2 * h) * (2 * h)) ^ m
      have double := pow.double_exponent at 2 * h, m
      have two := pow.two at (2 * h) ^ m
      have base := pow.mul_base at 2 * h, 2 * h, m
      rw [double, two, base]
      rfl
    have reduce := mod.pow at p, (2 * h) * (2 * h), m with nonzero
    have oneBase := pow.one_left at m
    rw [expand, reduce, square, oneBase]
    exact mod.of_less with aboveOne

-- The first supplement: 2h is −1 modulo p = 2h + 1, and (2h)^h ≡ (−1)^h.
theorem negOne.residue_iff (p h : Nat)
  requires prime : Prime(p)
  requires odd : p = 2 * h + 1
  shows QuadraticResidue(2 * h, p) ↔ Even(h)
proof
  have nonzero := Prime.nonzero with prime
  have aboveOne := Prime.greater_than_one with prime
  have hPositive : 0 < h
    rw odd at aboveOne
    arith
  have notDivides : ¬(p ∣ 2 * h)
    intro divides
    have doubleNonzero : 2 * h ≠ 0 by arith
    have le := divides.le with divides, doubleNonzero
    rw odd at le
    have impossible : ¬(2 * h + 1 ≤ 2 * h) by arith
    exact impossible with le
  have criterion := euler.criterion at 2 * h, p, h with prime, odd, notDivides
  have doubleBelow : 2 * h < p
    rw odd
    arith
  have doubleSelf := mod.of_less with doubleBelow
  have parity := Even.iff_not_odd at h
  constructor
  . intro residue
    have power := criterion.forward with residue
    apply parity.backward
    intro oddH
    obtain ⟨m, mNat, form⟩ := oddH
    have exponent : h = 2 * m + 1
      rw form
      ring
    have step : (2 * h) ^ h = (2 * h) * (2 * h) ^ (2 * m)
      have expand := pow.add_one at 2 * h, 2 * m
      rw ← exponent at expand
      exact expand
    have evenPower := negOne.even_pow at p, h, m with prime, odd
    have split := mod.mul_right at p, 2 * h, (2 * h) ^ (2 * m) with nonzero
    rw [step, ← split, evenPower] at power
    have one : 2 * h * 1 = 2 * h by ring
    rw [one, doubleSelf] at power
    have impossible : 2 * h ≠ 1 by arith
    exact impossible with power
  . intro evenH
    apply criterion.backward
    have twoMul := Even.iff_two_mul at h
    obtain ⟨m, mNat, form⟩ := twoMul.forward with evenH
    have evenPower := negOne.even_pow at p, h, m with prime, odd
    rw ← form at evenPower
    exact evenPower

-- The usable form for two squares: a root of x² + 1 ≡ 0 when h is even.
theorem negOne.square (p h : Nat)
  requires prime : Prime(p)
  requires odd : p = 2 * h + 1
  requires even : Even(h)
  shows ∃ a, Nat(a) ∧ (a * a + 1) % p = 0
proof
  have nonzero := Prime.nonzero with prime
  have aboveOne := Prime.greater_than_one with prime
  have characterization := negOne.residue_iff with prime, odd
  have residue := characterization.backward with even
  obtain ⟨x, xNat, square⟩ := residue
  witness x
  unfold CongruentMod at square
  have doubleBelow : 2 * h < p
    rw odd
    arith
  have doubleSelf := mod.of_less with doubleBelow
  have oneSelf := mod.of_less with aboveOne
  have split := mod.add at p, x * x, 1 with nonzero
  rw [split, square, doubleSelf, oneSelf, ← odd]
  exact mod.self at p
