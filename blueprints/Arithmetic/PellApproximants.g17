-- Pairs (x, y) with |x² − d y²| below a bound: Dirichlet's approximation
-- of √d gives one with the bound 3d, and for a nonsquare d there are
-- arbitrarily many, since each pair keeps a positive distance |x − y √d|.
-- Part of the Arithmetic blueprint.
-- Planned home: NumberTheory/PellApproximants.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Arithmetic.PellApproximants
import Dirichlet
import SqrtNonsquare
import Grace.Cumulus.Cardinal

-- The pairs of naturals (x, y) with y > 0 and |x² − d y²| < M.
def pellPairs (d M : Set) : Set :=
  { q ∈ ℕ × ℕ | 0 < snd(q) ∧
    natDist(mul(fst(q), fst(q)), mul(d, mul(snd(q), snd(q)))) < M }

theorem pellPairs.mem_iff (d M x y : Nat)
  shows (x, y) ∈ pellPairs(d, M) ↔ 0 < y ∧ natDist(x * x, d * (y * y)) < M
proof
  sorry

theorem pellPairs.subset (d M : Nat)
  shows pellPairs(d, M) ⊆ ℕ × ℕ
proof
  sorry

-- x² − d y² = (x − y √d)(x + y √d) in ℝ, and the natural distance is
-- the real absolute value of that difference.
theorem pellPairs.real_distance (d x y : Nat)
  shows (realNat(natDist(x * x, d * (y * y))):R) =
    abs((realNat(x):R) - (realNat(y):R) * sqrtNat(d)) *
      ((realNat(x):R) + (realNat(y):R) * sqrtNat(d))
proof
  sorry

-- |x − y √d| < 1/N ≤ 1/y gives x < y √d + 1, so
-- |x² − d y²| < (2 y √d + 1) / y ≤ 2 √d + 1 ≤ 3d.
theorem pellPairs.of_approximation (d x y N : Nat)
  requires above : 1 < d
  requires positive : 0 < y
  requires below : y ≤ N
  requires close : abs((realNat(x):R) - (realNat(y):R) * sqrtNat(d)) *
    (realNat(N):R) < (1:R)
  shows (x, y) ∈ pellPairs(d, 3 * d)
proof
  sorry

-- Each pair with y > 0 keeps a positive distance from the line x = y √d.
theorem pellPairs.gap (d x y : Nat)
  requires nonsquare : ¬IsSquare(d)
  requires positive : 0 < y
  shows (0:R) < abs((realNat(x):R) - (realNat(y):R) * sqrtNat(d))
proof
  sorry

-- A finite set of pairs has a common positive gap ε below every distance;
-- Real.below_natural gives N with 1/N < ε, and Dirichlet's pair for that N
-- is a new pair. Induction on n with cardinality.insert_add_one.
theorem pellPairs.many_gap (d n : Nat)
  requires nonsquare : ¬IsSquare(d)
  shows ∃ S, S ⊆ pellPairs(d, 3 * d) ∧ HasCardinality(S, n) ∧
    (∃ ε ∈ ℝ, (0:R) < (ε:R) ∧ (∀ q ∈ S,
      (ε:R) ≤ abs(realNat(fst(q)) - realNat(snd(q)) * sqrtNat(d))))
proof
  sorry

theorem pellPairs.many (d n : Nat)
  requires nonsquare : ¬IsSquare(d)
  shows ∃ S, S ⊆ pellPairs(d, 3 * d) ∧ HasCardinality(S, n)
proof
  sorry
