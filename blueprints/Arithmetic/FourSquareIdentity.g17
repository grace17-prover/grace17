-- Sums of four squares in ℕ and ℤ, Euler's four-square identity, and
-- closure of sums of four squares under products.
-- Part of the Arithmetic blueprint.
-- Planned home: NumberTheory/FourSquareIdentity.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Arithmetic.FourSquareIdentity
import Grace.Cumulus.Int
import Grace.Cumulus.Nat

predicate SumOfFourSquares (n : Nat) :=
  ∃ a, Nat(a) ∧ ∃ b, Nat(b) ∧ ∃ c, Nat(c) ∧ ∃ d, Nat(d) ∧
    n = a * a + b * b + c * c + d * d

predicate IntegerSumOfFourSquares (z : Set) :=
  ∃ a ∈ ℤ, ∃ b ∈ ℤ, ∃ c ∈ ℤ, ∃ d ∈ ℤ, z = a * a + b * b + c * c + d * d

theorem SumOfFourSquares.intro (a b c d : Nat)
  shows SumOfFourSquares(a * a + b * b + c * c + d * d)
proof
  sorry

theorem SumOfFourSquares.zero
  shows SumOfFourSquares(0)
proof
  sorry

theorem SumOfFourSquares.one
  shows SumOfFourSquares(1)
proof
  sorry

theorem SumOfFourSquares.two
  shows SumOfFourSquares(2)
proof
  sorry

theorem IntegerSumOfFourSquares.intro (a b c d : Integer)
  shows IntegerSumOfFourSquares(a * a + b * b + c * c + d * d)
proof
  sorry

theorem IntegerSumOfFourSquares.of_natural (n : Nat)
  requires sum : SumOfFourSquares(n)
  shows IntegerSumOfFourSquares(integerOfNat(n))
proof
  sorry

-- The squares of a, …, d are the squares of their absolute values:
-- integerNatAbs.cases and integerNatAbs.mul.
theorem SumOfFourSquares.of_integer (n : Nat)
  requires sum : IntegerSumOfFourSquares(integerOfNat(n))
  shows SumOfFourSquares(n)
proof
  sorry

-- Euler's identity, closed by ring.
theorem euler.four_square_identity (a b c d e f g k : Integer)
  shows (a * a + b * b + c * c + d * d) * (e * e + f * f + g * g + k * k) =
    (a * e + b * f + c * g + d * k) * (a * e + b * f + c * g + d * k) +
    (a * f - b * e + c * k - d * g) * (a * f - b * e + c * k - d * g) +
    (a * g - b * k - c * e + d * f) * (a * g - b * k - c * e + d * f) +
    (a * k + b * g - c * f - d * e) * (a * k + b * g - c * f - d * e)
proof
  sorry

theorem IntegerSumOfFourSquares.mul (x y : Integer)
  requires first : IntegerSumOfFourSquares(x)
  requires second : IntegerSumOfFourSquares(y)
  shows IntegerSumOfFourSquares(x * y)
proof
  sorry

theorem SumOfFourSquares.mul (m n : Nat)
  requires first : SumOfFourSquares(m)
  requires second : SumOfFourSquares(n)
  shows SumOfFourSquares(m * n)
proof
  sorry
