-- Authors: Grant Passmore

module Arithmetic.FourSquaresModPrime
import Grace.Cumulus.Cardinal
import Grace.Cumulus.NumberTheory.ModularMore
import Grace.Cumulus.Combinatorics.Pigeonhole

-- x ↦ x² mod p on 0..h, and y ↦ (2h − y² mod p) mod p, which is
-- −1 − y² modulo p = 2h + 1.
defgraph squareResidues (p h : Nat) (x ∈ succ(h)) : p := mod(mul(x, x), p)
requires positive : 0 < p
proof
  sorry

defgraph negSquareResidues (p h : Nat) (y ∈ succ(h)) : p :=
  mod(sub(add(h, h), mod(mul(y, y), p)), p)
requires positive : 0 < p
proof
  sorry

-- x² ≡ y² with x, y ≤ h gives p ∣ (x − y)(x + y) and x + y ≤ 2h < p.
theorem squareResidues.injective (p h x y : Nat)
  requires prime : Prime(p)
  requires odd : p = 2 * h + 1
  requires xBound : x ≤ h
  requires yBound : y ≤ h
  requires same : (x * x) % p = (y * y) % p
  shows x = y
proof
  sorry

theorem squareResidues.image_count (p h : Nat)
  requires prime : Prime(p)
  requires odd : p = 2 * h + 1
  shows cardinality(functionImage(squareResidues(p, h), succ(h), p)) = h + 1
proof
  sorry

theorem negSquareResidues.image_count (p h : Nat)
  requires prime : Prime(p)
  requires odd : p = 2 * h + 1
  shows cardinality(functionImage(negSquareResidues(p, h), succ(h), p)) = h + 1
proof
  sorry

-- Two subsets of p of size h + 1 each meet, since 2h + 2 > p.
theorem residues.meet (p h : Nat)
  requires prime : Prime(p)
  requires odd : p = 2 * h + 1
  shows ∃ x ∈ succ(h), ∃ y ∈ succ(h),
    squareResidues(p, h)(x) = negSquareResidues(p, h)(y)
proof
  sorry

-- x² + y² + 1 ≡ 0 with x, y ≤ h; it is positive and below p² since
-- 2h² + 1 < (2h + 1)².
theorem prime.multiple_sum_squares_one (p h : Nat)
  requires prime : Prime(p)
  requires odd : p = 2 * h + 1
  shows ∃ m, Nat(m) ∧ ∃ a, Nat(a) ∧ ∃ b, Nat(b) ∧
    0 < m ∧ m < p ∧ m * p = a * a + b * b + 1
proof
  sorry
