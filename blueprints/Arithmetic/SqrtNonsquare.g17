-- The square root of a natural as a real, its elementary bounds, and its
-- irrationality when the natural is not a square: no natural x and
-- positive y have x = y √d.
-- Part of the Arithmetic blueprint.
-- Planned home: NumberTheory/SqrtNonsquare.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Arithmetic.SqrtNonsquare
import IntegerPrime
import Grace.Cumulus.Real.Sqrt
import Grace.Cumulus.Real.RootTwo

def sqrtNat (d : Nat) : Real := realSqrt(realNat(d))
proof
  sorry

theorem sqrtNat.nonnegative (d : Nat)
  shows (0:R) ≤ sqrtNat(d)
proof
  sorry

theorem sqrtNat.square (d : Nat)
  shows sqrtNat(d) * sqrtNat(d) = realNat(d)
proof
  sorry

theorem sqrtNat.of_square (k : Nat)
  shows sqrtNat(k * k) = realNat(k)
proof
  sorry

theorem sqrtNat.positive (d : Nat)
  requires positive : 0 < d
  shows (0:R) < sqrtNat(d)
proof
  sorry

theorem sqrtNat.gt_one (d : Nat)
  requires above : 1 < d
  shows (1:R) < sqrtNat(d)
proof
  sorry

-- √d ≤ d for d ≥ 1, as d ≤ d².
theorem sqrtNat.le_self (d : Nat)
  requires positive : 0 < d
  shows sqrtNat(d) ≤ realNat(d)
proof
  sorry

-- Squaring x = y √d gives x² = d y² in ℕ by realNat.injective, so d is a
-- square (IsSquare.of_square_multiple).
theorem sqrtNat.irrational (d x y : Nat)
  requires nonsquare : ¬IsSquare(d)
  requires positive : 0 < y
  shows (realNat(x):R) ≠ (realNat(y):R) * sqrtNat(d)
proof
  sorry
