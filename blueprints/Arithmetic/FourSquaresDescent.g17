-- Fermat's descent for four squares: a multiple m p of a prime with
-- 1 < m < p that is a sum of four squares yields a smaller positive
-- multiple that is, so every prime is a sum of four squares.
-- Part of the Arithmetic blueprint.
-- Planned home: NumberTheory/FourSquaresDescent.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Arithmetic.FourSquaresDescent
import FourSquareIdentity
import FourSquaresModPrime
import IntegerRemainder

-- When a, b, c, d are congruent to e, f, g, k modulo m and m divides
-- a² + b² + c² + d², m divides each cross term of Euler's identity: the
-- first is congruent to a² + b² + c² + d², the others to 0.
theorem fourSquares.cross_terms (m : Nat) (a b c d e f g k : Integer)
  requires sum : IntegerDivides(integerOfNat(m), a * a + b * b + c * c + d * d)
  requires congruentA : IntegerCongruent(integerOfNat(m), a, e)
  requires congruentB : IntegerCongruent(integerOfNat(m), b, f)
  requires congruentC : IntegerCongruent(integerOfNat(m), c, g)
  requires congruentD : IntegerCongruent(integerOfNat(m), d, k)
  shows IntegerDivides(integerOfNat(m), a * e + b * f + c * g + d * k) ∧
    IntegerDivides(integerOfNat(m), a * f - b * e + c * k - d * g) ∧
    IntegerDivides(integerOfNat(m), a * g - b * k - c * e + d * f) ∧
    IntegerDivides(integerOfNat(m), a * k + b * g - c * f - d * e)
proof
  sorry

-- Dividing Euler's identity by m² when m divides every cross term.
theorem fourSquares.quotient (m : Nat) (a b c d e f g k : Integer)
  requires sum : IntegerDivides(integerOfNat(m), a * a + b * b + c * c + d * d)
  requires congruentA : IntegerCongruent(integerOfNat(m), a, e)
  requires congruentB : IntegerCongruent(integerOfNat(m), b, f)
  requires congruentC : IntegerCongruent(integerOfNat(m), c, g)
  requires congruentD : IntegerCongruent(integerOfNat(m), d, k)
  shows ∃ z ∈ ℤ, IntegerSumOfFourSquares(z) ∧
    (a * a + b * b + c * c + d * d) * (e * e + f * f + g * g + k * k) =
      integerOfNat(m * m) * z
proof
  sorry

-- Four residues of absolute value at most m/2 have squares summing to at
-- most m².
theorem fourSquares.residue_bound (m : Nat) (e f g k : Integer)
  requires boundE : 2 * integerNatAbs(e) ≤ m
  requires boundF : 2 * integerNatAbs(f) ≤ m
  requires boundG : 2 * integerNatAbs(g) ≤ m
  requires boundK : 2 * integerNatAbs(k) ≤ m
  shows integerNatAbs(e * e + f * f + g * g + k * k) ≤ m * m
proof
  sorry

-- The extreme cases: residues all zero, or all of absolute value exactly
-- m/2; either way m² divides the original sum of squares.
theorem fourSquares.extreme (m : Nat) (a b c d e f g k : Integer)
  requires boundE : 2 * integerNatAbs(e) ≤ m
  requires boundF : 2 * integerNatAbs(f) ≤ m
  requires boundG : 2 * integerNatAbs(g) ≤ m
  requires boundK : 2 * integerNatAbs(k) ≤ m
  requires congruentA : IntegerCongruent(integerOfNat(m), a, e)
  requires congruentB : IntegerCongruent(integerOfNat(m), b, f)
  requires congruentC : IntegerCongruent(integerOfNat(m), c, g)
  requires congruentD : IntegerCongruent(integerOfNat(m), d, k)
  requires extreme : e * e + f * f + g * g + k * k = 0 ∨
    e * e + f * f + g * g + k * k = integerOfNat(m * m)
  shows IntegerDivides(integerOfNat(m * m), a * a + b * b + c * c + d * d)
proof
  sorry

-- m² dividing m p with p prime forces m ∣ p, so m = 1 or m = p.
theorem fourSquares.no_extreme (p m : Nat)
  requires prime : Prime(p)
  requires aboveOne : 1 < m
  requires below : m < p
  shows ¬(m * m ∣ m * p)
proof
  sorry

-- Take least absolute residues e, …, k of a, …, d modulo m; their squares
-- sum to m r with 0 < r < m by the bound and the extreme cases, and
-- Euler's identity divided by m² writes r p as a sum of four squares.
theorem fourSquares.descent_step (p m : Nat)
  requires prime : Prime(p)
  requires aboveOne : 1 < m
  requires below : m < p
  requires sum : SumOfFourSquares(m * p)
  shows ∃ r, Nat(r) ∧ 0 < r ∧ r < m ∧ SumOfFourSquares(r * p)
proof
  sorry

-- The least positive m with m p a sum of four squares is 1: the odd case
-- is seeded by prime.multiple_sum_squares_one, and 2 = 1 + 1 + 0 + 0.
theorem lagrange.prime (p : Nat)
  requires prime : Prime(p)
  shows SumOfFourSquares(p)
proof
  sorry
