-- Eisenstein's lattice count: for distinct odd primes p = 2hp + 1 and
-- q = 2hq + 1, the floor sums Σ ⌊q k / p⌋ (k = 1..hp) and Σ ⌊p j / q⌋
-- (j = 1..hq) count the lattice points of the hp × hq rectangle below and
-- above the line p j = q k, which has no lattice point on it; together they
-- count hp · hq.
-- Part of the Arithmetic blueprint.
-- Planned home: NumberTheory/LatticeCount.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Arithmetic.LatticeCount
import GaussParity
import Grace.Cumulus.Cardinal

-- The points (k, j) of 1..hp × 1..hq with p j < q k, and those with
-- q k < p j.
def lowerLattice (p q hp hq : Nat) : Set :=
  { r ∈ halfRange(hp) × halfRange(hq) | mul(p, snd(r)) < mul(q, fst(r)) }

def upperLattice (p q hp hq : Nat) : Set :=
  { r ∈ halfRange(hp) × halfRange(hq) | mul(q, fst(r)) < mul(p, snd(r)) }

theorem lowerLattice.mem_iff (p q hp hq k j : Nat)
  shows (k, j) ∈ lowerLattice(p, q, hp, hq) ↔
    k ∈ halfRange(hp) ∧ j ∈ halfRange(hq) ∧ p * j < q * k
proof
  sorry

theorem upperLattice.mem_iff (p q hp hq k j : Nat)
  shows (k, j) ∈ upperLattice(p, q, hp, hq) ↔
    k ∈ halfRange(hp) ∧ j ∈ halfRange(hq) ∧ q * k < p * j
proof
  sorry

-- No lattice point of the rectangle lies on the line: p j = q k gives
-- p ∣ k with 0 < k ≤ hp < p.
theorem lattice.off_line (p q hp hq k j : Nat)
  requires primeP : Prime(p)
  requires primeQ : Prime(q)
  requires distinct : p ≠ q
  requires oddP : p = 2 * hp + 1
  requires oddQ : q = 2 * hq + 1
  requires kIn : k ∈ halfRange(hp)
  requires jIn : j ∈ halfRange(hq)
  shows p * j ≠ q * k
proof
  sorry

theorem lattice.partition (p q hp hq : Nat)
  requires primeP : Prime(p)
  requires primeQ : Prime(q)
  requires distinct : p ≠ q
  requires oddP : p = 2 * hp + 1
  requires oddQ : q = 2 * hq + 1
  shows lowerLattice(p, q, hp, hq) ∪ upperLattice(p, q, hp, hq) =
      halfRange(hp) × halfRange(hq) ∧
    Disjoint(lowerLattice(p, q, hp, hq), upperLattice(p, q, hp, hq))
proof
  sorry

-- For 0 < k ≤ hp the floor ⌊q k / p⌋ is at most hq: q k / p < q / 2.
theorem floorWeights.le_half (p q hp hq k : Nat)
  requires primeP : Prime(p)
  requires oddP : p = 2 * hp + 1
  requires oddQ : q = 2 * hq + 1
  requires kIn : k ∈ halfRange(hp)
  shows quotientNat(q * k, p) ≤ hq
proof
  sorry

-- j ≤ ⌊q k / p⌋ exactly when p j ≤ q k, and off the line p j < q k; so
-- the weighted pairs of the floor sum are the lower lattice points,
-- after shifting i < ⌊q k / p⌋ to j = i + 1.
theorem lowerLattice.count (p q hp hq : Nat)
  requires primeP : Prime(p)
  requires primeQ : Prime(q)
  requires distinct : p ≠ q
  requires oddP : p = 2 * hp + 1
  requires oddQ : q = 2 * hq + 1
  shows natSum(halfRange(hp), floorWeights(q, p, hp)) =
    cardinality(lowerLattice(p, q, hp, hq))
proof
  sorry

-- The upper points are the lower points of the roles exchanged, under the
-- swap (k, j) ↦ (j, k).
theorem upperLattice.count (p q hp hq : Nat)
  requires primeP : Prime(p)
  requires primeQ : Prime(q)
  requires distinct : p ≠ q
  requires oddP : p = 2 * hp + 1
  requires oddQ : q = 2 * hq + 1
  shows natSum(halfRange(hq), floorWeights(p, q, hq)) =
    cardinality(upperLattice(p, q, hp, hq))
proof
  sorry

theorem lattice.count (p q hp hq : Nat)
  requires primeP : Prime(p)
  requires primeQ : Prime(q)
  requires distinct : p ≠ q
  requires oddP : p = 2 * hp + 1
  requires oddQ : q = 2 * hq + 1
  shows add(natSum(halfRange(hp), floorWeights(q, p, hp)),
    natSum(halfRange(hq), floorWeights(p, q, hq))) = hp * hq
proof
  sorry
