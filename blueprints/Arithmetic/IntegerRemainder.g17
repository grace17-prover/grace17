-- Authors: Grant Passmore

module Arithmetic.IntegerRemainder
import Grace.Cumulus.NumberTheory.IntegerDivisibility

-- The natural r < m congruent to x modulo m. Existence: x = ±n for a
-- natural n, and n % m or (m − n % m) % m serves; uniqueness: m divides
-- the difference of two such remainders, whose absolute value is below m.
defunique integerMod (x : Set, m : Nat) (r ∈ ℕ) :=
  r < m ∧ IntegerCongruent(integerOfNat(m), x, integerOfNat(r))
requires integer : Integer(x)
requires positive : 0 < m
proof
  have nonzero : m ≠ 0 by arith
  obtain ⟨n, nNat, sign⟩ := Integer.signed_natural at x
  have remainderNat : Nat(n % m) by typecheck
  have below := mod.less at n, m with nonzero
  have reduced := CongruentMod.mod_right at n, m
  have lifted := IntegerCongruent.ofNat_iff.backward at m, n, n % m
    with reduced
  cases sign with positive | negative
  . rw positive
    refine ⟨n % m, ?_, below, lifted⟩
    typecheck
  . -- x = −n: negate the congruence n ≡ n % m and shift by m.
    have negated := IntegerCongruent.neg with lifted
    have remainderLe : n % m ≤ m by arith
    have difference := integerOfNat.sub at m, n % m with remainderLe
    have differenceNat : Nat(m - n % m) by typecheck
    have shift : IntegerCongruent(integerOfNat(m), -integerOfNat(n % m),
        integerOfNat(m - n % m))
      unfold IntegerCongruent
      witness -integerOne
      rw difference
      ring
    have reducedAgain := CongruentMod.mod_right at m - n % m, m
    have liftedAgain := IntegerCongruent.ofNat_iff.backward
      at m, m - n % m, (m - n % m) % m with reducedAgain
    have first := IntegerCongruent.transitive with negated, shift
    have chain := IntegerCongruent.transitive with first, liftedAgain
    have negativeForm := integerNegativeOfNat.eq_neg at n
    rw [negative, negativeForm]
    refine ⟨(m - n % m) % m, ?_, ?_, chain⟩
    . typecheck
    . exact mod.less at m - n % m, m with nonzero
uniqueness
  intros r rMember first t tMember second
  have rNat := nat.omega.backward with rMember
  have tNat := nat.omega.backward with tMember
  rcases first with ⟨rBelow, rCongruent⟩
  rcases second with ⟨tBelow, tCongruent⟩
  have reverse := IntegerCongruent.symmetric with rCongruent
  have chain := IntegerCongruent.transitive with reverse, tCongruent
  have natural := IntegerCongruent.ofNat_iff.forward at m, r, t with chain
  unfold CongruentMod at natural
  have rValue := mod.of_less at m, r with rBelow
  have tValue := mod.of_less at m, t with tBelow
  rw [rValue, tValue] at natural
  exact natural

theorem integerMod.natural (x : Integer, m : Nat)
  requires positive : 0 < m
  shows Nat(integerMod(x, m))
proof
  have selected := integerMod.selected at x, m with positive
  exact nat.omega.backward with selected.left

theorem integerMod.below (x : Integer, m : Nat)
  requires positive : 0 < m
  shows integerMod(x, m) < m
proof
  have selected := integerMod.selected at x, m with positive
  exact selected.right.left

theorem integerMod.congruent (x : Integer, m : Nat)
  requires positive : 0 < m
  shows IntegerCongruent(integerOfNat(m), x, integerOfNat(integerMod(x, m)))
proof
  have selected := integerMod.selected at x, m with positive
  exact selected.right.right

theorem integerMod.eq_of_below (x : Integer, m r : Nat)
  requires positive : 0 < m
  requires below : r < m
  requires congruent : IntegerCongruent(integerOfNat(m), x, integerOfNat(r))
  shows integerMod(x, m) = r
proof
  have selected := integerMod.selected at x, m with positive
  have unique := integerMod.unique at x, m with positive
  have rMember : r ∈ ℕ by typecheck
  have property : r < m ∧
      IntegerCongruent(integerOfNat(m), x, integerOfNat(r))
    exact ⟨below, congruent⟩
  exact unique with integerMod(x, m), selected.left, selected.right, r,
    rMember, property

theorem integerMod.eq_of_congruent (x y : Integer, m : Nat)
  requires positive : 0 < m
  requires congruent : IntegerCongruent(integerOfNat(m), x, y)
  shows integerMod(x, m) = integerMod(y, m)
proof
  have yNat := integerMod.natural at y, m with positive
  have yBelow := integerMod.below at y, m with positive
  have yCongruent := integerMod.congruent at y, m with positive
  have chain := IntegerCongruent.transitive with congruent, yCongruent
  exact integerMod.eq_of_below at x, m, integerMod(y, m)
    with positive, yBelow, chain

theorem integerMod.ofNat (n m : Nat)
  requires positive : 0 < m
  shows integerMod(integerOfNat(n), m) = n % m
proof
  have nonzero : m ≠ 0 by arith
  have remainderNat : Nat(n % m) by typecheck
  have below := mod.less at n, m with nonzero
  have reduced := CongruentMod.mod_right at n, m
  have lifted := IntegerCongruent.ofNat_iff.backward at m, n, n % m
    with reduced
  exact integerMod.eq_of_below at integerOfNat(n), m, n % m
    with positive, below, lifted

theorem integerMod.zero_iff (x : Integer, m : Nat)
  requires positive : 0 < m
  shows integerMod(x, m) = 0 ↔ IntegerDivides(integerOfNat(m), x)
proof
  have characterization := IntegerCongruent.zero_right_iff at integerOfNat(m), x
  constructor
  . intro zero
    have congruent := integerMod.congruent at x, m with positive
    rw [zero, integerOfNat.zero] at congruent
    exact characterization.forward with congruent
  . intro divides
    have congruent := characterization.backward with divides
    rw ← integerOfNat.zero at congruent
    exact integerMod.eq_of_below at x, m, 0 with positive, positive, congruent

-- The least absolute residue: the remainder r itself when 2r ≤ m, and
-- r − m otherwise, whose absolute value m − r satisfies 2(m − r) < m.
theorem IntegerCongruent.least_absolute (x : Integer, m : Nat)
  requires positive : 0 < m
  shows ∃ y ∈ ℤ, IntegerCongruent(integerOfNat(m), x, y) ∧
    2 * integerNatAbs(y) ≤ m
proof
  have rNat := integerMod.natural at x, m with positive
  have below := integerMod.below at x, m with positive
  have congruent := integerMod.congruent at x, m with positive
  have total := LessEqual.total at 2 * integerMod(x, m), m
  cases total with small | large
  . refine ⟨integerOfNat(integerMod(x, m)), ?_, congruent, ?_⟩
    . typecheck
    . rw integerNatAbs.ofNat
      exact small
  . -- The residue r − m, a negative natural of magnitude m − r.
    have rLe : integerMod(x, m) ≤ m by arith
    obtain ⟨d, dNat, shape⟩ := LessEqual.exists_add with rLe
    have shift : IntegerCongruent(integerOfNat(m),
        integerOfNat(integerMod(x, m)),
        integerOfNat(integerMod(x, m)) - integerOfNat(m))
      unfold IntegerCongruent
      witness integerOne
      ring
    have chain := IntegerCongruent.transitive with congruent, shift
    have negativeForm := integerOfNat.sub_of_le with rLe
    have differenceNat : Nat(m - integerMod(x, m)) by typecheck
    have magnitude := integerNatAbs.ofNegativeNat at m - integerMod(x, m)
    have sum : d + integerMod(x, m) = m by arith
    have difference := sub.of_add_eq with sum
    refine ⟨integerOfNat(integerMod(x, m)) - integerOfNat(m), ?_, chain, ?_⟩
    . typecheck
    . rw [negativeForm, magnitude, difference]
      arith

-- A residue of absolute value at most m/2 has square at most m²/4, in the
-- form without division: four times the square is at most m².
theorem integerNatAbs.square_bound (y : Integer, m : Nat)
  requires bound : 2 * integerNatAbs(y) ≤ m
  shows integerNatAbs(y * y) * 4 ≤ m * m
proof
  have aNat := integerNatAbs.natural at y
  have product := integerNatAbs.mul at y, y
  have squares := LessEqual.mul with bound, bound
  have shape : integerNatAbs(y) * integerNatAbs(y) * 4 =
      (2 * integerNatAbs(y)) * (2 * integerNatAbs(y)) by ring
  rw [product, shape]
  exact squares
