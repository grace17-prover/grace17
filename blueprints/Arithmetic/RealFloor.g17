-- The floor of a nonnegative real as the least natural n with X < n + 1,
-- its characterizing bounds, monotonicity, and the fractional part in
-- [0, 1).
-- Part of the Arithmetic blueprint.
-- Planned home: Real/Floor.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Arithmetic.RealFloor
import Grace.Cumulus.Real.HarmonicSeries
import Grace.Cumulus.Real.RootTwo
import Grace.Cumulus.Nat.Least

-- Existence: leastNatural({ n ∈ ℕ | X < realNat(n) + 1 }), nonempty by
-- Real.below_natural; uniqueness by realNat.lt_of_lt.
defunique realFloor (X : Real) (n ∈ ℕ) :=
  (realNat(n):R) ≤ X ∧ X < (realNat(n):R) + 1
requires nonnegative : (0:R) ≤ X
proof
  sorry
uniqueness
  sorry

theorem realFloor.natural (X : Real)
  requires nonnegative : (0:R) ≤ X
  shows Nat(realFloor(X))
proof
  sorry

theorem realFloor.le (X : Real)
  requires nonnegative : (0:R) ≤ X
  shows (realNat(realFloor(X)):R) ≤ X
proof
  sorry

theorem realFloor.lt (X : Real)
  requires nonnegative : (0:R) ≤ X
  shows X < (realNat(realFloor(X)):R) + 1
proof
  sorry

theorem realFloor.eq_of_bounds (X : Real) (n : Nat)
  requires nonnegative : (0:R) ≤ X
  requires lower : (realNat(n):R) ≤ X
  requires upper : X < (realNat(n):R) + 1
  shows realFloor(X) = n
proof
  sorry

theorem realFloor.of_natural (n : Nat)
  shows realFloor(realNat(n)) = n
proof
  sorry

theorem realFloor.monotone (X Y : Real)
  requires nonnegative : (0:R) ≤ X
  requires le : X ≤ Y
  shows realFloor(X) ≤ realFloor(Y)
proof
  sorry

theorem realFloor.lt_natural (X : Real) (N : Nat)
  requires nonnegative : (0:R) ≤ X
  requires below : X < realNat(N)
  shows realFloor(X) < N
proof
  sorry

theorem realFloor.natural_le (X : Real) (N : Nat)
  requires nonnegative : (0:R) ≤ X
  requires below : realNat(N) ≤ X
  shows N ≤ realFloor(X)
proof
  sorry

def realFrac (X : Real) : Real := X - realNat(realFloor(X))
proof
  sorry

theorem realFrac.value (X : Real)
  shows realFrac(X) = X - realNat(realFloor(X))
proof
  sorry

theorem realFrac.nonnegative (X : Real)
  requires nonnegative : (0:R) ≤ X
  shows (0:R) ≤ realFrac(X)
proof
  sorry

theorem realFrac.lt_one (X : Real)
  requires nonnegative : (0:R) ≤ X
  shows realFrac(X) < (1:R)
proof
  sorry

-- The floor and fractional part recover the number.
theorem realFrac.decomposition (X : Real)
  requires nonnegative : (0:R) ≤ X
  shows X = (realNat(realFloor(X)):R) + realFrac(X)
proof
  sorry
