-- Authors: Grant Passmore

module Arithmetic.IntegerPrime
import Grace.Cumulus.NumberTheory.IntegerDivisibility
import Grace.Cumulus.NumberTheory.PerfectSquares
import Grace.Cumulus.NumberTheory.CoprimeSquares

-- Euclid's lemma in ℤ: through IntegerDivides.natural_left and
-- integerNatAbs.mul, then Prime.divides_mul in ℕ.
theorem Prime.integer_divides_mul (p : Nat) (x y : Integer)
  requires prime : Prime(p)
  requires divides : IntegerDivides(integerOfNat(p), x * y)
  shows IntegerDivides(integerOfNat(p), x) ∨
    IntegerDivides(integerOfNat(p), y)
proof
  have xNat := integerNatAbs.natural at x
  have yNat := integerNatAbs.natural at y
  have bridge := IntegerDivides.natural_left at p, x * y
  have magnitudes := bridge.forward with divides
  have product := integerNatAbs.mul at x, y
  rw product at magnitudes
  have split := Prime.divides_mul with prime, magnitudes
  cases split with left | right
  . left
    exact IntegerDivides.natural_left.backward at p, x with left
  . right
    exact IntegerDivides.natural_left.backward at p, y with right

-- x² ≡ 1 factors as (x − 1)(x + 1) ≡ 0, with the integer one written as
-- integerOne: a bare numeral in an IntegerCongruent argument is the
-- natural one, so this is the form the natural corollary below uses.
theorem IntegerCongruent.square_one (p : Nat) (x : Integer)
  requires prime : Prime(p)
  requires square : IntegerCongruent(integerOfNat(p), x * x, integerOne)
  shows IntegerCongruent(integerOfNat(p), x, integerOne) ∨
    IntegerCongruent(integerOfNat(p), x, -integerOne)
proof
  unfold IntegerCongruent at square
  have factored : x * x - integerOne = (x - integerOne) * (x + integerOne)
    ring
  rw factored at square
  have split := Prime.integer_divides_mul with prime, square
  cases split with left | right
  . left
    unfold IntegerCongruent
    exact left
  . right
    unfold IntegerCongruent
    have shape : x - (-integerOne) = x + integerOne by ring
    rw shape
    exact right

-- The same in ℕ: a natural whose square is 1 modulo p is 1 or −1 modulo p.
theorem Prime.square_mod_one (p x : Nat)
  requires prime : Prime(p)
  requires square : (x * x) % p = 1
  shows x % p = 1 ∨ (x + 1) % p = 0
proof
  have above := Prime.greater_than_one with prime
  have oneValue := mod.one_left with above
  have congruent : CongruentMod(x * x, 1, p)
    unfold CongruentMod
    rw [square, oneValue]
    rfl
  have lifted := IntegerCongruent.ofNat_iff.backward at p, x * x, 1
    with congruent
  rw [integerOfNat.mul, integerOfNat.one] at lifted
  have split := IntegerCongruent.square_one with prime, lifted
  cases split with one | negOne
  . left
    rw ← integerOfNat.one at one
    have natural := IntegerCongruent.ofNat_iff.forward at p, x, 1 with one
    unfold CongruentMod at natural
    rw oneValue at natural
    exact natural
  . right
    have reflexive := IntegerCongruent.reflexive at integerOfNat(p), integerOne
    have sum := IntegerCongruent.add with negOne, reflexive
    have cancel : -integerOne + integerOne = integerZero by ring
    have successor := integerOfNat.add_one at x
    rw [cancel, ← successor, ← integerOfNat.zero] at sum
    have natural := IntegerCongruent.ofNat_iff.forward at p, x + 1, 0 with sum
    unfold CongruentMod at natural
    rw mod.zero_left at natural
    exact natural

-- A natural whose square is 0 modulo p is 0 modulo p.
theorem Prime.square_mod_zero (p x : Nat)
  requires prime : Prime(p)
  requires square : (x * x) % p = 0
  shows x % p = 0
proof
  have nonzero := Prime.nonzero with prime
  have characterization := mod.zero_iff at p, x * x with nonzero
  have divides := characterization.forward with square
  have split := Prime.divides_mul with prime, divides
  have dividesX : p ∣ x
    cases split with left | right
    . exact left
    . exact right
  exact mod.of_divides with dividesX

theorem Prime.not_square (p : Nat)
  requires prime : Prime(p)
  shows ¬IsSquare(p)
proof
  intro square
  obtain ⟨k, kNat, shape⟩ := square
  have above := Prime.greater_than_one with prime
  have nonzero := Prime.nonzero with prime
  have divides : k ∣ p
    rw shape
    exact divides.mul_left_self at k, k
  have bound := divides.le with divides, nonzero
  have alternatives := LessEqual.cases with bound
  cases alternatives with less | equal
  . -- A proper divisor of a prime is 1, so p = 1 · 1.
    have pNat : Nat(p) by typecheck
    have member := membership.of_Less at k, p with kNat, pNat, less
    have one := Prime.divisor with prime, kNat, member, divides
    rw one at shape
    arith
  . -- k = p gives p = p · p, so p = 1.
    rw equal at shape
    have unit : p * 1 = p * p
      rw ← shape
      ring
    have cancelled := mul.left_cancel_positive with nonzero, unit
    arith

-- y² divides x², so y divides x (divides.of_mul_self), x = y c, and
-- cancelling y² leaves d = c².
theorem IsSquare.of_square_multiple (d x y : Nat)
  requires positive : 0 < y
  requires square : x * x = d * (y * y)
  shows IsSquare(d)
proof
  have yNonzero : y ≠ 0 by arith
  have squaresDivide : y * y ∣ x * x
    witness d
    rw square
    ring
  obtain ⟨c, cNat, shape⟩ := divides.of_mul_self with squaresDivide
  have squareNonzero := mul.nonzero with yNonzero, yNonzero
  rw ← shape at square
  have products : y * y * (c * c) = y * y * d
    linear_combination square
  have cancelled := mul.left_cancel_positive with squareNonzero, products
  witness c
  symm
  exact cancelled

theorem Prime.not_divides_two (p h : Nat)
  requires prime : Prime(p)
  requires odd : p = 2 * h + 1
  shows ¬(p ∣ 2)
proof
  intro divides
  have above := Prime.greater_than_one with prime
  have twoNonzero : 2 ≠ 0 by arith
  have bound := divides.le with divides, twoNonzero
  arith

-- An odd prime 2h + 1 has h ≥ 1, so p ≥ 3 and 1 < p − 1 = 2h.
theorem Prime.odd_half_positive (p h : Nat)
  requires prime : Prime(p)
  requires odd : p = 2 * h + 1
  shows 0 < h
proof
  have above := Prime.greater_than_one with prime
  arith

-- A natural not a square is at least 2: 0 and 1 are squares.
theorem IsSquare.above_one_of_not (d : Nat)
  requires nonsquare : ¬IsSquare(d)
  shows 1 < d
proof
  by_contra notAbove
  have below : d ≤ 1 by arith
  have alternatives := LessEqual.cases with below
  cases alternatives with less | equal
  . have zero : d = 0 by arith
    rw zero at nonsquare
    exact nonsquare with IsSquare.zero
  . rw equal at nonsquare
    exact nonsquare with IsSquare.one
