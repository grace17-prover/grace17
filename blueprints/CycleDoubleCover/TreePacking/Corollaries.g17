-- Consequences of tree packing: a 2k-edge-connected graph has k disjoint
-- spanning trees, and a 3-edge-connected graph has three spanning trees with
-- no edge common to all three, found in the graph with every edge doubled.
-- Part of the cycle double cover blueprint. Planned home: GraphTheory/TreePacking/Corollaries.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module CycleDoubleCover.TreePacking.Corollaries
import Kaiser

-- Summing the cut sizes over the classes of a partition counts each crossing
-- edge twice, so 2k-edge-connectivity gives the packing condition for k.
theorem EdgeConnected.packing_condition (V E leftEnd rightEnd : Set, k : Nat)
  requires graph : Graph(V, E, leftEnd, rightEnd)
  requires finiteVertices : Finite(V)
  requires finiteEdges : Finite(E)
  requires connected : EdgeConnected(V, E, leftEnd, rightEnd, 2 * k)
  shows PackingCondition(V, E, leftEnd, rightEnd, k)
proof
  sorry

theorem EdgeConnected.tree_packing (V E leftEnd rightEnd : Set, k : Nat)
  requires graph : Graph(V, E, leftEnd, rightEnd)
  requires finiteVertices : Finite(V)
  requires finiteEdges : Finite(E)
  requires nonempty : V ≠ ∅
  requires connected : EdgeConnected(V, E, leftEnd, rightEnd, 2 * k)
  shows TreePacking(V, E, leftEnd, rightEnd, k)
proof
  sorry

-- Every edge doubled: the edges are the pairs (e, i) with i ∈ 2, with the ends of e.
def doubledEdges (E : Set) : Set := E × 2
def doubledEnd (V E endpoint : Set) : Set := { p ∈ (E × 2) × V | ∃ e ∈ E, ∃ i ∈ 2, p = ((e, i), endpoint(e)) }

theorem doubled.graph (V E leftEnd rightEnd : Set)
  requires graph : Graph(V, E, leftEnd, rightEnd)
  shows Graph(V, doubledEdges(E), doubledEnd(V, E, leftEnd), doubledEnd(V, E, rightEnd))
proof
  sorry

theorem doubled.edge_connected (V E leftEnd rightEnd : Set, k : Nat)
  requires graph : Graph(V, E, leftEnd, rightEnd)
  requires finiteEdges : Finite(E)
  requires connected : EdgeConnected(V, E, leftEnd, rightEnd, k)
  shows EdgeConnected(V, doubledEdges(E), doubledEnd(V, E, leftEnd), doubledEnd(V, E, rightEnd), 2 * k)
proof
  sorry

-- Three spanning trees of the doubled graph correspond to three spanning
-- trees of G, and no edge of G lies in all three.
theorem EdgeConnected.three_trees (V E leftEnd rightEnd : Set)
  requires graph : Graph(V, E, leftEnd, rightEnd)
  requires finiteVertices : Finite(V)
  requires finiteEdges : Finite(E)
  requires nonempty : V ≠ ∅
  requires connected : EdgeConnected(V, E, leftEnd, rightEnd, 3)
  shows ∃ T, FunctionBetween(T, 3, 𝒫(E)) ∧ (∀ i ∈ 3, SpanningTree(V, leftEnd, rightEnd, T(i))) ∧
    T(0) ∩ T(1) ∩ T(2) = ∅
proof
  sorry
