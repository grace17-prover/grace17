-- Kaiser's proof of the tree-packing theorem: the partition sequence of a
-- decomposition, edge levels, the exchange step, and the well-founded order
-- under which a maximal decomposition is a packing.
-- Part of the cycle double cover blueprint. Planned home: GraphTheory/TreePacking/Kaiser.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module CycleDoubleCover.TreePacking.Kaiser
import Decompositions
import Grace.Cumulus.Nat.Least

-- The least colour whose class is not internally connected on P, or k when
-- every colour is: the colour c_i of the proof.
def disconnectedColour (leftEnd rightEnd T P : Set, k : Nat) : Set :=
  { i ∈ k | ¬InternallyConnected(leftEnd, rightEnd, T(i), P) }

-- The partition sequence P_0 = {V}, P_{n+1} = P_n refined by the least
-- disconnected colour, fixed once every colour is internally connected.
def partitionStep (V leftEnd rightEnd T P : Set, k : Nat) : Set :=
  { X ∈ 𝒫(V) | (disconnectedColour(leftEnd, rightEnd, T, P, k) = ∅ ∧ X ∈ P) ∨
    (disconnectedColour(leftEnd, rightEnd, T, P, k) ≠ ∅ ∧
      X ∈ refineBy(leftEnd, rightEnd, T(leastNatural(disconnectedColour(leftEnd, rightEnd, T, P, k))), P)) }

def partitionSequence (V leftEnd rightEnd T : Set, k n : Nat) → Set
  | V, leftEnd, rightEnd, T, k, zero => {V}
  | V, leftEnd, rightEnd, T, k, succ(m) =>
    partitionStep(V, leftEnd, rightEnd, T, partitionSequence(V, leftEnd, rightEnd, T, k, m), k)

theorem partitionSequence.partition (V E leftEnd rightEnd T : Set, k n : Nat)
  requires graph : Graph(V, E, leftEnd, rightEnd)
  requires nonempty : V ≠ ∅
  requires decomposition : Decomposition(E, T, k)
  shows Partition(V, partitionSequence(V, leftEnd, rightEnd, T, k, n))
proof
  sorry

theorem partitionSequence.refines (V E leftEnd rightEnd T : Set, k n : Nat)
  requires graph : Graph(V, E, leftEnd, rightEnd)
  requires decomposition : Decomposition(E, T, k)
  shows Refines(partitionSequence(V, leftEnd, rightEnd, T, k, succ(n)), partitionSequence(V, leftEnd, rightEnd, T, k, n))
proof
  sorry

-- A strictly refining chain of partitions of a finite set has at most |V|
-- steps, so the sequence is fixed from some stage on.
theorem partitionSequence.stabilises (V E leftEnd rightEnd T : Set, k : Nat)
  requires graph : Graph(V, E, leftEnd, rightEnd)
  requires finiteVertices : Finite(V)
  requires nonempty : V ≠ ∅
  requires decomposition : Decomposition(E, T, k)
  shows ∃ n ∈ ℕ, n ≤ cardinality(V) ∧
    partitionSequence(V, leftEnd, rightEnd, T, k, succ(n)) = partitionSequence(V, leftEnd, rightEnd, T, k, n)
proof
  sorry

-- The stable partition P_∞ and, on it, every colour is internally connected.
def stablePartition (V leftEnd rightEnd T : Set, k : Nat) : Set :=
  partitionSequence(V, leftEnd, rightEnd, T, k, cardinality(V))

theorem stablePartition.internal (V E leftEnd rightEnd T : Set, k : Nat)
  requires graph : Graph(V, E, leftEnd, rightEnd)
  requires finiteVertices : Finite(V)
  requires nonempty : V ≠ ∅
  requires decomposition : Decomposition(E, T, k)
  shows ∀ i ∈ k, InternallyConnected(leftEnd, rightEnd, T(i), stablePartition(V, leftEnd, rightEnd, T, k))
proof
  sorry

-- The level of an edge: the largest n at which both ends share a class of
-- P_n; an edge inside a class of the stable partition has infinite level.
predicate FiniteLevel (V leftEnd rightEnd T e : Set, k n : Nat) :=
  (∃ X ∈ partitionSequence(V, leftEnd, rightEnd, T, k, n), leftEnd(e) ∈ X ∧ rightEnd(e) ∈ X) ∧
  ¬(∃ X ∈ partitionSequence(V, leftEnd, rightEnd, T, k, succ(n)), leftEnd(e) ∈ X ∧ rightEnd(e) ∈ X)

-- When the last colour is disconnected, the packing condition leaves it at
-- least |P_∞| − 1 edges crossing the stable partition, so it contains an even
-- set, and that even set has an edge of finite level.
theorem Kaiser.cycle_edge (V E leftEnd rightEnd T : Set, k : Nat)
  requires graph : Graph(V, E, leftEnd, rightEnd)
  requires finiteVertices : Finite(V)
  requires finiteEdges : Finite(E)
  requires nonempty : V ≠ ∅
  requires decomposition : Decomposition(E, T, succ(k))
  requires trees : ∀ i ∈ k, SpanningTree(V, leftEnd, rightEnd, T(i))
  requires condition : PackingCondition(V, E, leftEnd, rightEnd, succ(k))
  requires disconnected : ¬Connects(V, leftEnd, rightEnd, T(k))
  shows ∃ C, C ⊆ T(k) ∧ EvenEdgeSet(V, leftEnd, rightEnd, C) ∧
    (∃ e ∈ C, ∃ n ∈ ℕ, FiniteLevel(V, leftEnd, rightEnd, T, e, succ(k), n))
proof
  sorry

-- The exchange: e of least finite level m in an even set of T_k, P its class
-- at level m, c_m the colour refined there, e' an edge of least level on the
-- even set closed by e in T_{c_m}. Exchanging e and e' between the two
-- colours keeps the first k colours trees.
def exchange (T e f : Set, c k : Nat) : Set :=
  { p ∈ succ(k) × 𝒫(T(c) ∪ T(k)) | ∃ i ∈ succ(k),
    (i = c ∧ p = (i, (T(c) ∪ {e}) ∖ {f})) ∨ (i = k ∧ p = (i, (T(k) ∪ {f}) ∖ {e})) ∨
    (i ≠ c ∧ i ≠ k ∧ p = (i, T(i))) }

theorem exchange.decomposition (V E leftEnd rightEnd T e f : Set, c k : Nat)
  requires decomposition : Decomposition(E, T, succ(k))
  requires colour : c ∈ k
  requires first : e ∈ T(k)
  requires second : f ∈ T(c)
  shows Decomposition(E, exchange(T, e, f, c, k), succ(k))
proof
  sorry

-- The order on decompositions: T precedes T' when their partition sequences
-- and refining colours agree below some stage j, and at j the partition of
-- T' is strictly coarser or the colour of T' is larger.
predicate Precedes (V leftEnd rightEnd T U : Set, k : Nat) :=
  ∃ j ∈ ℕ, (∀ i ∈ j, partitionSequence(V, leftEnd, rightEnd, T, k, i) = partitionSequence(V, leftEnd, rightEnd, U, k, i) ∧
      disconnectedColour(leftEnd, rightEnd, T, partitionSequence(V, leftEnd, rightEnd, T, k, i), k) =
        disconnectedColour(leftEnd, rightEnd, U, partitionSequence(V, leftEnd, rightEnd, U, k, i), k)) ∧
    ((Refines(partitionSequence(V, leftEnd, rightEnd, T, k, j), partitionSequence(V, leftEnd, rightEnd, U, k, j)) ∧
      partitionSequence(V, leftEnd, rightEnd, T, k, j) ≠ partitionSequence(V, leftEnd, rightEnd, U, k, j)) ∨
     (partitionSequence(V, leftEnd, rightEnd, T, k, j) = partitionSequence(V, leftEnd, rightEnd, U, k, j) ∧
      leastNatural(disconnectedColour(leftEnd, rightEnd, T, partitionSequence(V, leftEnd, rightEnd, T, k, j), k)) <
        leastNatural(disconnectedColour(leftEnd, rightEnd, U, partitionSequence(V, leftEnd, rightEnd, U, k, j), k))))

-- Claims 1 and 2 of the proof, as the exchange step improving the
-- decomposition in the order.
theorem exchange.precedes (V E leftEnd rightEnd T e f : Set, c k m : Nat)
  requires graph : Graph(V, E, leftEnd, rightEnd)
  requires finiteVertices : Finite(V)
  requires finiteEdges : Finite(E)
  requires nonempty : V ≠ ∅
  requires decomposition : Decomposition(E, T, succ(k))
  requires trees : ∀ i ∈ k, SpanningTree(V, leftEnd, rightEnd, T(i))
  requires level : FiniteLevel(V, leftEnd, rightEnd, T, e, succ(k), m)
  requires least : ∀ g ∈ T(k), ∀ n ∈ ℕ, FiniteLevel(V, leftEnd, rightEnd, T, g, succ(k), n) →
    (∃ C, C ⊆ T(k) ∧ g ∈ C ∧ EvenEdgeSet(V, leftEnd, rightEnd, C)) → m ≤ n
  requires cycle : ∃ C, C ⊆ T(k) ∧ e ∈ C ∧ EvenEdgeSet(V, leftEnd, rightEnd, C)
  requires colour : c = leastNatural(disconnectedColour(leftEnd, rightEnd, T, partitionSequence(V, leftEnd, rightEnd, T, succ(k), m), succ(k)))
  requires closes : ∃ C, C ⊆ T(c) ∪ {e} ∧ e ∈ C ∧ f ∈ C ∧ f ≠ e ∧ EvenEdgeSet(V, leftEnd, rightEnd, C) ∧
    (∀ g ∈ C, ∀ n ∈ ℕ, FiniteLevel(V, leftEnd, rightEnd, T, g, succ(k), n) →
      (∃ p ∈ ℕ, FiniteLevel(V, leftEnd, rightEnd, T, f, succ(k), p) ∧ p ≤ n))
  shows Precedes(V, leftEnd, rightEnd, T, exchange(T, e, f, c, k), succ(k)) ∧
    (∀ i ∈ k, SpanningTree(V, leftEnd, rightEnd, exchange(T, e, f, c, k)(i)))
proof
  sorry

-- The order is a strict partial order on the finitely many decompositions,
-- so a maximal one exists among those whose first k colours are trees.
theorem Precedes.maximal (V E leftEnd rightEnd : Set, k : Nat)
  requires graph : Graph(V, E, leftEnd, rightEnd)
  requires finiteVertices : Finite(V)
  requires finiteEdges : Finite(E)
  requires nonempty : V ≠ ∅
  requires some : ∃ T, Decomposition(E, T, succ(k)) ∧ (∀ i ∈ k, SpanningTree(V, leftEnd, rightEnd, T(i)))
  shows ∃ T, Decomposition(E, T, succ(k)) ∧ (∀ i ∈ k, SpanningTree(V, leftEnd, rightEnd, T(i))) ∧
    ¬(∃ U, Decomposition(E, U, succ(k)) ∧ (∀ i ∈ k, SpanningTree(V, leftEnd, rightEnd, U(i))) ∧
      Precedes(V, leftEnd, rightEnd, T, U, succ(k)))
proof
  sorry

-- Tutte and Nash-Williams: the packing condition suffices.
theorem treePacking (V E leftEnd rightEnd : Set, k : Nat)
  requires graph : Graph(V, E, leftEnd, rightEnd)
  requires finiteVertices : Finite(V)
  requires finiteEdges : Finite(E)
  requires nonempty : V ≠ ∅
  requires condition : PackingCondition(V, E, leftEnd, rightEnd, k)
  shows TreePacking(V, E, leftEnd, rightEnd, k)
proof
  sorry
