-- Decompositions of the edge set into k colour classes, the tree-packing
-- condition of Tutte and Nash-Williams, and partitions of the vertex set as
-- they refine along a decomposition.
-- Part of the cycle double cover blueprint. Planned home: GraphTheory/TreePacking/Decompositions.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module CycleDoubleCover.TreePacking.Decompositions
import CycleDoubleCover.Graphs.Trees

-- A k-decomposition: T assigns to every colour i ∈ k an edge class, and the
-- classes partition E.
predicate Decomposition (E T : Set, k : Nat) :=
  FunctionBetween(T, k, 𝒫(E)) ∧ (∀ e ∈ E, ∃ i ∈ k, e ∈ T(i)) ∧
  (∀ i ∈ k, ∀ j ∈ k, i ≠ j → Disjoint(T(i), T(j)))

predicate TreePacking (V E leftEnd rightEnd : Set, k : Nat) :=
  ∃ T, Decomposition(E, T, k) ∧ (∀ i ∈ k, SpanningTree(V, leftEnd, rightEnd, T(i)))

-- Every partition P of V is joined by at least k(|P| − 1) edges.
predicate PackingCondition (V E leftEnd rightEnd : Set, k : Nat) :=
  ∀ P, Partition(V, P) → k * cardinality(P) ≤ cardinality(crossingClasses(P, leftEnd, rightEnd, E)) + k

-- F connecting every class of P from within, by its edges inside the class.
predicate InternallyConnected (leftEnd rightEnd F P : Set) :=
  ∀ X ∈ P, Connects(X, leftEnd, rightEnd, inside(leftEnd, rightEnd, F, X))

-- Refining P by the components of F within each class.
def refinements (leftEnd rightEnd F P : Set) : Set :=
  { componentsBy(X, leftEnd, rightEnd, inside(leftEnd, rightEnd, F, X)) | X ∈ P }
def refineBy (leftEnd rightEnd F P : Set) : Set := ⋃(refinements(leftEnd, rightEnd, F, P))

theorem refineBy.partition (V leftEnd rightEnd F P : Set)
  requires partition : Partition(V, P)
  requires ends : ∀ e ∈ F, leftEnd(e) ∈ V ∧ rightEnd(e) ∈ V
  shows Partition(V, refineBy(leftEnd, rightEnd, F, P))
proof
  sorry

theorem refineBy.refines (leftEnd rightEnd F P : Set)
  shows Refines(refineBy(leftEnd, rightEnd, F, P), P)
proof
  sorry

theorem refineBy.fixed_iff (V leftEnd rightEnd F P : Set)
  requires partition : Partition(V, P)
  requires ends : ∀ e ∈ F, leftEnd(e) ∈ V ∧ rightEnd(e) ∈ V
  shows refineBy(leftEnd, rightEnd, F, P) = P ↔ InternallyConnected(leftEnd, rightEnd, F, P)
proof
  sorry

-- Necessity of the packing condition: a tree meets every partition in at
-- least |P| − 1 crossing edges, and the k trees are disjoint.
theorem TreePacking.condition (V E leftEnd rightEnd : Set, k : Nat)
  requires graph : Graph(V, E, leftEnd, rightEnd)
  requires finiteVertices : Finite(V)
  requires finiteEdges : Finite(E)
  requires packing : TreePacking(V, E, leftEnd, rightEnd, k)
  shows PackingCondition(V, E, leftEnd, rightEnd, k)
proof
  sorry

-- A spanning tree crosses a partition in exactly |P| − 1 edges when it is
-- internally connected on it.
theorem SpanningTree.crossing_count (V leftEnd rightEnd T P : Set)
  requires finiteVertices : Finite(V)
  requires partition : Partition(V, P)
  requires ends : ∀ e ∈ T, leftEnd(e) ∈ V ∧ rightEnd(e) ∈ V
  requires tree : SpanningTree(V, leftEnd, rightEnd, T)
  requires internal : InternallyConnected(leftEnd, rightEnd, T, P)
  shows cardinality(crossingClasses(P, leftEnd, rightEnd, T)) + 1 = cardinality(P)
proof
  sorry
