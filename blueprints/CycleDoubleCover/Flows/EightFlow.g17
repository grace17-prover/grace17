-- Every finite bridgeless multigraph has an even cover: the eight-flow
-- theorem of Jaeger and Kilpatrick, by induction on the number of edges
-- through cuts of size zero and two, with three spanning trees in the
-- 3-edge-connected case.
-- Part of the cycle double cover blueprint. Planned home: GraphTheory/Flows/EightFlow.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module CycleDoubleCover.Flows.EightFlow
import Contraction

-- A vertex set left by no edge splits the graph; covers of the two sides join.
theorem EvenCover.join (V E leftEnd rightEnd X F G : Set)
  requires graph : Graph(V, E, leftEnd, rightEnd)
  requires split : X ⊆ V ∧ crossing(leftEnd, rightEnd, E, X) = ∅
  requires first : EvenCover(X, inside(leftEnd, rightEnd, E, X), leftEnd, rightEnd, F)
  requires second : EvenCover(V ∖ X, inside(leftEnd, rightEnd, E, V ∖ X), leftEnd, rightEnd, G)
  shows ∃ H, EvenCover(V, E, leftEnd, rightEnd, H)
proof
  sorry

-- A bridgeless graph that is neither split nor 3-edge-connected has a cut of
-- exactly two edges, and both of its edges are proper.
theorem Bridgeless.two_cut (V E leftEnd rightEnd : Set)
  requires graph : Graph(V, E, leftEnd, rightEnd)
  requires finiteVertices : Finite(V)
  requires finiteEdges : Finite(E)
  requires bridgeless : Bridgeless(V, E, leftEnd, rightEnd)
  requires unsplit : ∀ X ⊆ V, X ≠ ∅ → X ≠ V → crossing(leftEnd, rightEnd, E, X) ≠ ∅
  requires loose : ¬EdgeConnected(V, E, leftEnd, rightEnd, 3)
  shows ∃ X, ∃ e ∈ E, ∃ f ∈ E, X ⊆ V ∧ e ≠ f ∧ crossing(leftEnd, rightEnd, E, X) = {e, f}
proof
  sorry

-- One vertex: every edge is a loop and E itself is an even set.
theorem EvenCover.single_vertex (V E leftEnd rightEnd : Set)
  requires graph : Graph(V, E, leftEnd, rightEnd)
  requires finiteEdges : Finite(E)
  requires single : ∃ v, V = {v}
  shows ∃ F, EvenCover(V, E, leftEnd, rightEnd, F)
proof
  sorry

theorem eightFlow (V E leftEnd rightEnd : Set)
  requires graph : Graph(V, E, leftEnd, rightEnd)
  requires finiteVertices : Finite(V)
  requires finiteEdges : Finite(E)
  requires bridgeless : Bridgeless(V, E, leftEnd, rightEnd)
  shows ∃ F, EvenCover(V, E, leftEnd, rightEnd, F)
proof
  sorry
