-- Contracting an edge of a bridgeless graph keeps it bridgeless, and an even
-- cover of the contraction lifts when the edge lies in a cut of two edges.
-- Part of the cycle double cover blueprint. Planned home: GraphTheory/Flows/Contraction.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module CycleDoubleCover.Flows.Contraction
import EvenCovers

-- The partition of V that merges the two ends of e: the components of {e}.
def contractionPartition (V leftEnd rightEnd e : Set) : Set := componentsBy(V, leftEnd, rightEnd, {e})

def contractedLeft (V E leftEnd rightEnd e : Set) : Set :=
  quotientEnd(E ∖ {e}, contractionPartition(V, leftEnd, rightEnd, e), leftEnd)
def contractedRight (V E leftEnd rightEnd e : Set) : Set :=
  quotientEnd(E ∖ {e}, contractionPartition(V, leftEnd, rightEnd, e), rightEnd)

theorem contraction.graph (V E leftEnd rightEnd e : Set)
  requires graph : Graph(V, E, leftEnd, rightEnd)
  requires edge : e ∈ E
  shows Graph(contractionPartition(V, leftEnd, rightEnd, e), E ∖ {e},
    contractedLeft(V, E, leftEnd, rightEnd, e), contractedRight(V, E, leftEnd, rightEnd, e))
proof
  sorry

theorem contraction.vertex_count (V E leftEnd rightEnd e : Set)
  requires graph : Graph(V, E, leftEnd, rightEnd)
  requires finiteVertices : Finite(V)
  requires edge : e ∈ E
  requires proper : leftEnd(e) ≠ rightEnd(e)
  shows cardinality(contractionPartition(V, leftEnd, rightEnd, e)) + 1 = cardinality(V)
proof
  sorry

-- A cut of the contraction is a cut of the graph not separating the ends of e.
theorem contraction.bridgeless (V E leftEnd rightEnd e : Set)
  requires graph : Graph(V, E, leftEnd, rightEnd)
  requires finiteEdges : Finite(E)
  requires edge : e ∈ E
  requires bridgeless : Bridgeless(V, E, leftEnd, rightEnd)
  shows Bridgeless(contractionPartition(V, leftEnd, rightEnd, e), E ∖ {e},
    contractedLeft(V, E, leftEnd, rightEnd, e), contractedRight(V, E, leftEnd, rightEnd, e))
proof
  sorry

-- An even set of the contraction lifts to the graph, with or without e: the
-- two ends of e have degrees of equal parity in it.
theorem contraction.lift_even (V E leftEnd rightEnd e F : Set)
  requires graph : Graph(V, E, leftEnd, rightEnd)
  requires finiteVertices : Finite(V)
  requires edge : e ∈ E
  requires even : EvenEdgeSet(contractionPartition(V, leftEnd, rightEnd, e),
    contractedLeft(V, E, leftEnd, rightEnd, e), contractedRight(V, E, leftEnd, rightEnd, e), F)
  requires edges : F ⊆ E ∖ {e}
  shows EvenEdgeSet(V, leftEnd, rightEnd, F) ∨ EvenEdgeSet(V, leftEnd, rightEnd, F ∪ {e})
proof
  sorry

-- When e lies in a cut {e, f} of the graph, every lifted even set holding f
-- holds e, so a cover of the contraction lifts to a cover of the graph.
theorem contraction.lift_cover (V E leftEnd rightEnd e f X F : Set)
  requires graph : Graph(V, E, leftEnd, rightEnd)
  requires finiteVertices : Finite(V)
  requires finiteEdges : Finite(E)
  requires cut : X ⊆ V ∧ crossing(leftEnd, rightEnd, E, X) = {e, f} ∧ e ≠ f
  requires cover : EvenCover(contractionPartition(V, leftEnd, rightEnd, e), E ∖ {e},
    contractedLeft(V, E, leftEnd, rightEnd, e), contractedRight(V, E, leftEnd, rightEnd, e), F)
  shows ∃ G, EvenCover(V, E, leftEnd, rightEnd, G)
proof
  sorry
