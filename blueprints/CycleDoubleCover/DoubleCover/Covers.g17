-- Double covers of a multigraph: an indexed family of even edge sets, or of
-- cycles, holding every edge exactly twice. Two-element labels on the edges
-- with even local multiplicity give one.
-- Part of the cycle double cover blueprint. Planned home: GraphTheory/DoubleCover/Covers.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module CycleDoubleCover.DoubleCover.Covers
import CycleDoubleCover.Graphs.Trees

-- A cycle: a nonempty even edge set in which every vertex has degree 0 or 2
-- and whose edges are all joined to one another.
predicate Cycle (V leftEnd rightEnd C : Set) :=
  C ≠ ∅ ∧ EvenEdgeSet(V, leftEnd, rightEnd, C) ∧
  (∀ v ∈ V, degreeIn(leftEnd, rightEnd, C, v) = 0 ∨ degreeIn(leftEnd, rightEnd, C, v) = 2) ∧
  (∀ e ∈ C, ∀ f ∈ C, Joined(leftEnd, rightEnd, C, leftEnd(e), leftEnd(f)))

-- Cubic and loopless: every vertex meets three edge ends, no edge is a loop.
predicate Cubic (V E leftEnd rightEnd : Set) :=
  (∀ v ∈ V, degreeIn(leftEnd, rightEnd, E, v) = 3) ∧ (∀ e ∈ E, leftEnd(e) ≠ rightEnd(e))

def holding (H I e : Set) : Set := { i ∈ I | e ∈ H(i) }
def multiplicity (H I e : Set) : Set := cardinality(holding(H, I, e))

predicate EvenDoubleCover (V E leftEnd rightEnd H I : Set) :=
  Finite(I) ∧ FunctionBetween(H, I, 𝒫(E)) ∧ (∀ i ∈ I, EvenEdgeSet(V, leftEnd, rightEnd, H(i))) ∧
  (∀ e ∈ E, multiplicity(H, I, e) = 2)

predicate CycleDoubleCover (V E leftEnd rightEnd H I : Set) :=
  Finite(I) ∧ FunctionBetween(H, I, 𝒫(E)) ∧ (∀ i ∈ I, Cycle(V, leftEnd, rightEnd, H(i))) ∧
  (∀ e ∈ E, multiplicity(H, I, e) = 2)

-- Two-element labels: P(e) ⊆ L has two elements, and at every vertex each
-- label s is carried by an even number of incident ends. The family
-- H(s) = {e | s ∈ P(e)} is then an even double cover.
def labelClass (E P s : Set) : Set := { e ∈ E | s ∈ P(e) }
def labelledEnds (leftEnd rightEnd E P v s : Set) : Set :=
  { p ∈ incidentEnds(leftEnd, rightEnd, E, v) | s ∈ P(fst(p)) }
def labelFamily (E P L : Set) : Set := { p ∈ L × 𝒫(E) | ∃ s ∈ L, p = (s, labelClass(E, P, s)) }

theorem labels.double_cover (V E leftEnd rightEnd P L : Set)
  requires graph : Graph(V, E, leftEnd, rightEnd)
  requires finiteEdges : Finite(E)
  requires finiteLabels : Finite(L)
  requires labels : FunctionBetween(P, E, 𝒫(L)) ∧ (∀ e ∈ E, cardinality(P(e)) = 2)
  requires balanced : ∀ v ∈ V, ∀ s ∈ L, EvenSet(labelledEnds(leftEnd, rightEnd, E, P, v, s))
  shows EvenDoubleCover(V, E, leftEnd, rightEnd, labelFamily(E, P, L), L)
proof
  sorry

-- Every nonempty even edge set contains a cycle, and so splits into cycles.
theorem EvenEdgeSet.contains_cycle (V leftEnd rightEnd F : Set)
  requires finiteVertices : Finite(V)
  requires ends : ∀ e ∈ F, leftEnd(e) ∈ V ∧ rightEnd(e) ∈ V
  requires even : EvenEdgeSet(V, leftEnd, rightEnd, F)
  requires nonempty : F ≠ ∅
  shows ∃ C, C ⊆ F ∧ Cycle(V, leftEnd, rightEnd, C)
proof
  sorry

theorem EvenEdgeSet.cycle_decomposition (V leftEnd rightEnd F : Set)
  requires finiteVertices : Finite(V)
  requires ends : ∀ e ∈ F, leftEnd(e) ∈ V ∧ rightEnd(e) ∈ V
  requires even : EvenEdgeSet(V, leftEnd, rightEnd, F)
  shows ∃ D, Finite(D) ∧ (∀ C ∈ D, Cycle(V, leftEnd, rightEnd, C)) ∧
    (∀ C ∈ D, ∀ B ∈ D, C ≠ B → Disjoint(C, B)) ∧ ⋃(D) = F
proof
  sorry

-- Replacing each even set of a double cover by its cycles gives a cycle
-- double cover, indexed by the pairs (i, C).
theorem EvenDoubleCover.to_cycles (V E leftEnd rightEnd H I : Set)
  requires graph : Graph(V, E, leftEnd, rightEnd)
  requires finiteVertices : Finite(V)
  requires cover : EvenDoubleCover(V, E, leftEnd, rightEnd, H, I)
  shows ∃ K, ∃ J, CycleDoubleCover(V, E, leftEnd, rightEnd, K, J)
proof
  sorry
