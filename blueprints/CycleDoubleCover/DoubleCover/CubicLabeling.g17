-- The labels of a cubic loopless graph from an even cover: at each vertex the
-- three flow values are nonzero and distinct and sum to zero, the local base
-- points define a parity system for the vertex vectors, and the dual
-- obstruction computation shows it is solvable.
-- Part of the cycle double cover blueprint. Planned home: GraphTheory/DoubleCover/CubicLabeling.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module CycleDoubleCover.DoubleCover.CubicLabeling
import Covers
import CycleDoubleCover.Flows.EvenCovers
import CycleDoubleCover.Parity.Systems

-- Vectors over the two-element field with three coordinates are the subsets
-- of 3; the sum is the symmetric difference, the span of p is {∅, p}.
def span (p : Set) : Set := {∅, p}

-- At a cubic vertex the three values are nonzero, pairwise distinct, and
-- their sum vanishes: the third is the sum of the other two.
theorem flowValue.cubic_vertex (V E leftEnd rightEnd F v e f g : Set)
  requires graph : Graph(V, E, leftEnd, rightEnd)
  requires cubic : Cubic(V, E, leftEnd, rightEnd)
  requires cover : EvenCover(V, E, leftEnd, rightEnd, F)
  requires vertex : v ∈ V
  requires edges : e ∈ E ∧ f ∈ E ∧ g ∈ E
  requires incident : (leftEnd(e) = v ∨ rightEnd(e) = v) ∧ (leftEnd(f) = v ∨ rightEnd(f) = v) ∧ (leftEnd(g) = v ∨ rightEnd(g) = v)
  requires distinct : e ≠ f ∧ f ≠ g ∧ e ≠ g
  shows flowValue(F, e) ≠ flowValue(F, f) ∧ flowValue(F, g) = flowValue(F, e) △ flowValue(F, f)
proof
  sorry

-- The local base point of an end: the value of one other edge at that vertex,
-- determined up to the span of the edge's own value.
predicate BasePoint (V E leftEnd rightEnd F v e c : Set) :=
  ∃ f ∈ E, f ≠ e ∧ (leftEnd(f) = v ∨ rightEnd(f) = v) ∧ c = flowValue(F, f)

-- Vertex vectors t with t(u) △ t(v) ∈ d(e) + span(value(e)) for every edge
-- e = uv, where d(e) is the sum of the two base points of e.
predicate Compatible (V E leftEnd rightEnd F t d : Set) :=
  FunctionBetween(t, V, 𝒫(3)) ∧
  (∀ e ∈ E, ∃ s ∈ span(flowValue(F, e)), t(leftEnd(e)) △ t(rightEnd(e)) = d(e) △ s)

-- The parity system of the compatibility condition: unknowns are the
-- coordinates (v, i) of the vertex vectors and one switch per edge; rows are
-- the coordinates (e, i) of the edges.
def compatibilityMatrix (V E leftEnd rightEnd F : Set) : Set :=
  { p ∈ (E × 3) × ((V × 3) ∪ E) | ∃ e ∈ E, ∃ i ∈ 3,
    p = ((e, i), (leftEnd(e), i)) ∨ p = ((e, i), (rightEnd(e), i)) ∨ (i ∈ flowValue(F, e) ∧ p = ((e, i), e)) }

def compatibilitySide (E d : Set) : Set := { p ∈ E × 3 | ∃ e ∈ E, ∃ i ∈ 3, i ∈ d(e) ∧ p = (e, i) }

theorem Compatible.of_solution (V E leftEnd rightEnd F d t : Set)
  requires graph : Graph(V, E, leftEnd, rightEnd)
  requires cubic : Cubic(V, E, leftEnd, rightEnd)
  requires solution : Solves(compatibilityMatrix(V, E, leftEnd, rightEnd, F), E × 3, (V × 3) ∪ E, compatibilitySide(E, d), t)
  shows ∃ u, Compatible(V, E, leftEnd, rightEnd, F, u, d)
proof
  sorry

-- The dual obstruction computation of the proof: a left-kernel vector y of the
-- system, read at a vertex as the three vectors h(e), satisfies
-- h(e2) · value(e1) = the number of nonzero h(e) at v, modulo two, and summing
-- over all vertices gives y · side = 0.
theorem compatibility.unobstructed (V E leftEnd rightEnd F d : Set)
  requires graph : Graph(V, E, leftEnd, rightEnd)
  requires finiteVertices : Finite(V)
  requires finiteEdges : Finite(E)
  requires cubic : Cubic(V, E, leftEnd, rightEnd)
  requires cover : EvenCover(V, E, leftEnd, rightEnd, F)
  requires base : FunctionBetween(d, E, 𝒫(3)) ∧ (∀ e ∈ E, ∃ a, ∃ b,
    BasePoint(V, E, leftEnd, rightEnd, F, leftEnd(e), e, a) ∧ BasePoint(V, E, leftEnd, rightEnd, F, rightEnd(e), e, b) ∧ d(e) = a △ b)
  shows ¬(∃ y, Obstructs(compatibilityMatrix(V, E, leftEnd, rightEnd, F), E × 3, (V × 3) ∪ E, compatibilitySide(E, d), y))
proof
  sorry

-- From compatible vertex vectors, the label pair of an edge e = uv is
-- {t(u) △ c, t(u) △ c △ value(e)} for a base point c of u at e; the pair is
-- independent of the end and the base point, and at each vertex every label
-- is carried by an even number of the three ends.
theorem Compatible.labels (V E leftEnd rightEnd F t d : Set)
  requires graph : Graph(V, E, leftEnd, rightEnd)
  requires finiteEdges : Finite(E)
  requires cubic : Cubic(V, E, leftEnd, rightEnd)
  requires cover : EvenCover(V, E, leftEnd, rightEnd, F)
  requires base : FunctionBetween(d, E, 𝒫(3)) ∧ (∀ e ∈ E, ∃ a, ∃ b,
    BasePoint(V, E, leftEnd, rightEnd, F, leftEnd(e), e, a) ∧ BasePoint(V, E, leftEnd, rightEnd, F, rightEnd(e), e, b) ∧ d(e) = a △ b)
  requires compatible : Compatible(V, E, leftEnd, rightEnd, F, t, d)
  shows ∃ P, FunctionBetween(P, E, 𝒫(𝒫(3))) ∧ (∀ e ∈ E, cardinality(P(e)) = 2) ∧
    (∀ v ∈ V, ∀ s ∈ 𝒫(3), EvenSet(labelledEnds(leftEnd, rightEnd, E, P, v, s)))
proof
  sorry

-- A cubic loopless graph with an even cover has an even double cover indexed
-- by the eight vectors.
theorem Cubic.even_double_cover (V E leftEnd rightEnd F : Set)
  requires graph : Graph(V, E, leftEnd, rightEnd)
  requires finiteVertices : Finite(V)
  requires finiteEdges : Finite(E)
  requires cubic : Cubic(V, E, leftEnd, rightEnd)
  requires cover : EvenCover(V, E, leftEnd, rightEnd, F)
  shows ∃ H, EvenDoubleCover(V, E, leftEnd, rightEnd, H, 𝒫(3))
proof
  sorry
