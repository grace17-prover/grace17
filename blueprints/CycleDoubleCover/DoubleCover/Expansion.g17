-- The cubic expansion: each vertex becomes a cycle through its edge ends, a
-- rotation system choosing the cyclic order. The expansion of a bridgeless
-- graph is cubic, loopless, and bridgeless, and an even double cover of it
-- projects to one of the graph.
-- Part of the cycle double cover blueprint. Planned home: GraphTheory/DoubleCover/Expansion.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module CycleDoubleCover.DoubleCover.Expansion
import Covers
import CycleDoubleCover.Graphs.Cuts

-- The ends of all edges, (e, 0) and (e, 1), and the vertex an end lies at.
def halfEdges (E : Set) : Set := E × 2
def endVertex (V E leftEnd rightEnd : Set) : Set :=
  { p ∈ halfEdges(E) × V | ∃ e ∈ E, p = ((e, 0), leftEnd(e)) ∨ p = ((e, 1), rightEnd(e)) }

-- The n-th iterate of σ at h.
def orbitStep (σ h : Set, n : Nat) → Set
  | σ, h, zero => h
  | σ, h, succ(m) => σ(orbitStep(σ, h, m))

-- A rotation system: a permutation of the ends carrying each end to another
-- end at the same vertex, whose orbit through an end is all the ends there.
predicate RotationSystem (V E leftEnd rightEnd σ : Set) :=
  BijectiveBetween(σ, halfEdges(E), halfEdges(E)) ∧
  (∀ v ∈ V, ∀ h ∈ incidentEnds(leftEnd, rightEnd, E, v), σ(h) ∈ incidentEnds(leftEnd, rightEnd, E, v)) ∧
  (∀ v ∈ V, ∀ h ∈ incidentEnds(leftEnd, rightEnd, E, v), ∀ k ∈ incidentEnds(leftEnd, rightEnd, E, v),
    ∃ n ∈ ℕ, orbitStep(σ, h, n) = k)

-- Every finite nonempty set has a cyclic permutation.
theorem cyclicPermutation.exists (A : Set)
  requires finite : Finite(A)
  shows ∃ σ, BijectiveBetween(σ, A, A) ∧ (∀ a ∈ A, ∀ b ∈ A, ∃ n ∈ ℕ, orbitStep(σ, a, n) = b)
proof
  sorry

theorem RotationSystem.exists (V E leftEnd rightEnd : Set)
  requires graph : Graph(V, E, leftEnd, rightEnd)
  requires finiteVertices : Finite(V)
  requires finiteEdges : Finite(E)
  shows ∃ σ, RotationSystem(V, E, leftEnd, rightEnd, σ)
proof
  sorry

-- The expanded graph: vertices are the ends; the spoke of e joins (e, 0) to
-- (e, 1), and the ring edge of an end h joins h to σ(h).
def spokes (E : Set) : Set := {0} × E
def rings (E : Set) : Set := {1} × halfEdges(E)
def expandedEdges (E : Set) : Set := spokes(E) ∪ rings(E)
def expandedLeft (E σ : Set) : Set :=
  { p ∈ expandedEdges(E) × halfEdges(E) | ∃ e ∈ E, p = ((0, e), (e, 0)) ∨ (∃ h ∈ halfEdges(E), p = ((1, h), h)) }
def expandedRight (E σ : Set) : Set :=
  { p ∈ expandedEdges(E) × halfEdges(E) | ∃ e ∈ E, p = ((0, e), (e, 1)) ∨ (∃ h ∈ halfEdges(E), p = ((1, h), σ(h))) }

theorem expansion.graph (V E leftEnd rightEnd σ : Set)
  requires graph : Graph(V, E, leftEnd, rightEnd)
  requires rotation : RotationSystem(V, E, leftEnd, rightEnd, σ)
  shows Graph(halfEdges(E), expandedEdges(E), expandedLeft(E, σ), expandedRight(E, σ))
proof
  sorry

-- With every degree at least two, each end meets its spoke and two ring edges.
theorem expansion.cubic (V E leftEnd rightEnd σ : Set)
  requires graph : Graph(V, E, leftEnd, rightEnd)
  requires finiteEdges : Finite(E)
  requires rotation : RotationSystem(V, E, leftEnd, rightEnd, σ)
  requires degrees : ∀ v ∈ V, 2 ≤ degreeIn(leftEnd, rightEnd, E, v)
  shows Cubic(halfEdges(E), expandedEdges(E), expandedLeft(E, σ), expandedRight(E, σ))
proof
  sorry

theorem Bridgeless.degrees (V E leftEnd rightEnd : Set)
  requires graph : Graph(V, E, leftEnd, rightEnd)
  requires finiteEdges : Finite(E)
  requires bridgeless : Bridgeless(V, E, leftEnd, rightEnd)
  shows ∀ v ∈ V, degreeIn(leftEnd, rightEnd, E, v) ≠ 1
proof
  sorry

-- A cut of the expansion crossed by one edge would, after pulling the ends of
-- each vertex together, give a cut of the graph crossed by one edge.
theorem expansion.bridgeless (V E leftEnd rightEnd σ : Set)
  requires graph : Graph(V, E, leftEnd, rightEnd)
  requires finiteVertices : Finite(V)
  requires finiteEdges : Finite(E)
  requires rotation : RotationSystem(V, E, leftEnd, rightEnd, σ)
  requires bridgeless : Bridgeless(V, E, leftEnd, rightEnd)
  shows Bridgeless(halfEdges(E), expandedEdges(E), expandedLeft(E, σ), expandedRight(E, σ))
proof
  sorry

-- The projection of an edge set of the expansion: the edges whose spokes it holds.
def projected (E F : Set) : Set := { e ∈ E | (0, e) ∈ F }

theorem projected.even (V E leftEnd rightEnd σ F : Set)
  requires graph : Graph(V, E, leftEnd, rightEnd)
  requires finiteEdges : Finite(E)
  requires rotation : RotationSystem(V, E, leftEnd, rightEnd, σ)
  requires even : EvenEdgeSet(halfEdges(E), expandedLeft(E, σ), expandedRight(E, σ), F)
  shows EvenEdgeSet(V, leftEnd, rightEnd, projected(E, F))
proof
  sorry

def projectedFamily (E H I : Set) : Set := { p ∈ I × 𝒫(E) | ∃ i ∈ I, p = (i, projected(E, H(i))) }

theorem projected.double_cover (V E leftEnd rightEnd σ H I : Set)
  requires graph : Graph(V, E, leftEnd, rightEnd)
  requires finiteEdges : Finite(E)
  requires rotation : RotationSystem(V, E, leftEnd, rightEnd, σ)
  requires cover : EvenDoubleCover(halfEdges(E), expandedEdges(E), expandedLeft(E, σ), expandedRight(E, σ), H, I)
  shows EvenDoubleCover(V, E, leftEnd, rightEnd, projectedFamily(E, H, I), I)
proof
  sorry
