-- Linear systems over the two-element field in the language of finite sets:
-- a matrix is a relation between rows and columns, a vector a set of its
-- coordinates, and a row equation asks for the parity of a finite set. The
-- alternative: a system is solvable exactly when no left-kernel vector sees
-- an odd right-hand side, proved by elimination of one column at a time.
-- Part of the cycle double cover blueprint. Planned home: Combinatorics/ParitySystems.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module CycleDoubleCover.Parity.Systems
import CycleDoubleCover.Graphs.EdgeSets

-- t solves A t = b: for every row r, the row of A meets t in an odd number of
-- columns exactly when r ∈ b.
predicate Solves (A R C b t : Set) :=
  t ⊆ C ∧ (∀ r ∈ R, (EvenSet(fiber(A, C, r) ∩ t) ↔ ¬r ∈ b))

-- y obstructs: y A = 0, every column meets y evenly, while y b is odd.
predicate Obstructs (A R C b y : Set) :=
  y ⊆ R ∧ (∀ c ∈ C, EvenSet(cofiber(A, R, c) ∩ y)) ∧ ¬EvenSet(y ∩ b)

theorem Solves.not_obstructed (A R C b t y : Set)
  requires finiteRows : Finite(R)
  requires finiteColumns : Finite(C)
  requires matrix : A ⊆ R × C
  requires solution : Solves(A, R, C, b, t)
  requires obstruction : Obstructs(A, R, C, b, y)
  shows ⊥
proof
  sorry

-- Elimination of a column c: the rows of A meeting c are added to a pivot
-- row, and a solution of the reduced system extends by choosing c.
theorem paritySystem.eliminate (A R C b c : Set)
  requires finiteRows : Finite(R)
  requires finiteColumns : Finite(C)
  requires matrix : A ⊆ R × C
  requires column : c ∈ C
  requires unobstructed : ¬(∃ y, Obstructs(A, R, C, b, y))
  shows ∃ B, ∃ d, B ⊆ R × (C ∖ {c}) ∧ d ⊆ R ∧ ¬(∃ y, Obstructs(B, R, C ∖ {c}, d, y)) ∧
    (∀ t, Solves(B, R, C ∖ {c}, d, t) → ∃ s, Solves(A, R, C, b, s))
proof
  sorry

theorem paritySystem.alternative (A R C b : Set)
  requires finiteRows : Finite(R)
  requires finiteColumns : Finite(C)
  requires matrix : A ⊆ R × C
  requires side : b ⊆ R
  shows (∃ t, Solves(A, R, C, b, t)) ↔ ¬(∃ y, Obstructs(A, R, C, b, y))
proof
  sorry
