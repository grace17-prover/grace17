-- Finite sets as a parity algebra: symmetric difference is the sum, and a set
-- is read as a vector over the two-element field.
-- Part of the cycle double cover blueprint. Planned home: Cardinal/Parity.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module CycleDoubleCover.Graphs.EdgeSets
import Grace.Cumulus.Cardinal
import Grace.Cumulus.Nat.Parity
import Grace.Cumulus.Set.Algebra

-- Symmetric difference and its notation △ come from Set.Algebra.

-- Parity of a finite set: the sum over the two-element field of its indicator.
predicate EvenSet (A : Set) := Even(cardinality(A))

theorem EvenSet.empty
  shows EvenSet(∅)
proof
  have zero : cardinality(∅) = 0 :=
    cardinality.eq_of_has with HasCardinality.empty_set
  unfold EvenSet
  rw zero
  exact Even.zero

-- A sum of naturals is even exactly when its summands have the same parity.
theorem Even.add_iff (a b : Nat)
  shows Even(a + b) ↔ (Even(a) ↔ Even(b))
proof
  have splitA := parity.exhaustive at a
  have splitB := parity.exhaustive at b
  have splitSum := parity.exhaustive at a + b
  have bothEven := Even.add at a, b
  have bothOdd := Odd.add_odd at a, b
  have oddEven := Odd.add_even at a, b
  have evenOdd := Odd.even_add at a, b
  have exclusiveA := Odd.not_even at a
  have exclusiveB := Odd.not_even at b
  have exclusiveSum := Odd.not_even at a + b
  tauto

-- |A △ B| ≡ |A| + |B| (mod 2): the parity of a symmetric difference is the
-- sum of the parities.
theorem EvenSet.symmetricDifference (A B : Set)
  requires first : Finite(A)
  requires second : Finite(B)
  shows EvenSet(A △ B) ↔ (EvenSet(A) ↔ EvenSet(B))
proof
  -- A △ B, A, and B are disjoint unions of A ∖ B, B ∖ A, and A ∩ B.
  have finiteAB : Finite(A ∖ B) :=
    Finite.subset with first, (difference.subset_left at A, B)
  have finiteBA : Finite(B ∖ A) :=
    Finite.subset with second, (difference.subset_left at B, A)
  have finiteMeet : Finite(A ∩ B) :=
    Finite.subset with first, (intersection.subset_left at A, B)
  have apart : Disjoint(A ∖ B, B ∖ A)
    unfold Disjoint
    ext x
    simp
  have apartA : Disjoint(A ∖ B, A ∩ B) :=
    Disjoint.of_subset_right with (Disjoint.difference_left at A, B),
      (intersection.subset_right at A, B)
  have apartB : Disjoint(B ∖ A, A ∩ B) :=
    Disjoint.of_subset_right with (Disjoint.difference_left at B, A),
      (intersection.subset_left at A, B)
  have sumSym : cardinality(A △ B) =
      cardinality(A ∖ B) + cardinality(B ∖ A)
    unfold symmetricDifference
    exact cardinality.union_disjoint with finiteAB, finiteBA, apart
  have sumA : cardinality(A) = cardinality(A ∖ B) + cardinality(A ∩ B)
    have union := cardinality.union_disjoint with finiteAB, finiteMeet, apartA
    rw difference.union2_intersection at union
    exact union
  have sumB : cardinality(B) = cardinality(B ∖ A) + cardinality(A ∩ B)
    have union := cardinality.union_disjoint with finiteBA, finiteMeet, apartB
    have swap := intersection.commutative at A, B
    rw [swap, difference.union2_intersection] at union
    rw swap
    exact union
  have natAB := cardinality.nat with finiteAB
  have natBA := cardinality.nat with finiteBA
  have natMeet := cardinality.nat with finiteMeet
  have paritySym := Even.add_iff at cardinality(A ∖ B), cardinality(B ∖ A)
  have parityA := Even.add_iff at cardinality(A ∖ B), cardinality(A ∩ B)
  have parityB := Even.add_iff at cardinality(B ∖ A), cardinality(A ∩ B)
  unfold EvenSet
  rw [sumSym, sumA, sumB]
  tauto

theorem EvenSet.union_disjoint (A B : Set)
  requires first : Finite(A)
  requires second : Finite(B)
  requires apart : Disjoint(A, B)
  shows EvenSet(A ∪ B) ↔ (EvenSet(A) ↔ EvenSet(B))
proof
  have sum := cardinality.union_disjoint with first, second, apart
  have natA := cardinality.nat with first
  have natB := cardinality.nat with second
  have parity := Even.add_iff at cardinality(A), cardinality(B)
  unfold EvenSet
  rw sum
  exact parity

-- The parity of an intersection is the dot product of the two indicators.
def dot (A B : Set) : Set := cardinality(A ∩ B)

theorem dot.commutative (A B : Set)
  shows dot(A, B) = dot(B, A)
proof
  have swap := intersection.commutative at A, B
  unfold dot
  cc

-- Bilinearity of the dot product modulo two.
theorem dot.symmetricDifference (A B C : Set)
  requires first : Finite(A)
  requires second : Finite(B)
  requires third : Finite(C)
  shows Even(dot(A △ B, C)) ↔ (Even(dot(A, C)) ↔ Even(dot(B, C)))
proof
  -- Intersection with C distributes over △, so this is the parity law
  -- for A ∩ C and B ∩ C.
  have finiteAC : Finite(A ∩ C) :=
    Finite.subset with first, (intersection.subset_left at A, C)
  have finiteBC : Finite(B ∩ C) :=
    Finite.subset with second, (intersection.subset_left at B, C)
  have distribute : (A △ B) ∩ C = (A ∩ C) △ (B ∩ C)
    ext y
    simp [symmetricDifference]
  have parity := EvenSet.symmetricDifference with finiteAC, finiteBC
  -- unfold at a fact opens one occurrence per step; the fact has three.
  unfold EvenSet at parity
  unfold dot
  rw distribute
  exact parity
