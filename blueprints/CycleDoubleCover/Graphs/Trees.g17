-- Forests and spanning trees as edge sets: a forest contains no nonempty
-- even edge set, a spanning tree connects V with one edge fewer than
-- vertices, and adding an edge to a tree closes exactly one even set.
-- Part of the cycle double cover blueprint.
-- Planned home: GraphTheory/Multigraph/Trees.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module CycleDoubleCover.Graphs.Trees
import Connectivity

predicate Forest (V leftEnd rightEnd F : Set) :=
  Finite(F) ∧ (∀ C ⊆ F, EvenEdgeSet(V, leftEnd, rightEnd, C) → C = ∅)

predicate SpanningTree (V leftEnd rightEnd T : Set) :=
  Finite(T) ∧ Connects(V, leftEnd, rightEnd, T)
  ∧ cardinality(T) + 1 = cardinality(V)

-- Components. A vertex lies in its own component, two vertices with the same
-- component are joined, and the components are finitely many subsets of V.
theorem componentBy.self (V leftEnd rightEnd F u : Set)
  requires vertex : u ∈ V
  shows u ∈ componentBy(V, leftEnd, rightEnd, F, u)
proof
  have reflexive := Joined.reflexive at leftEnd, rightEnd, F, u
  exact componentBy.membership.backward with ⟨vertex, reflexive⟩

theorem componentBy.joined (V leftEnd rightEnd F u v : Set)
  requires member : v ∈ componentBy(V, leftEnd, rightEnd, F, u)
  shows Joined(leftEnd, rightEnd, F, u, v)
proof
  obtain ⟨_, joined⟩ := componentBy.membership.forward with member
  exact joined

theorem componentBy.subset (V leftEnd rightEnd F u : Set)
  shows componentBy(V, leftEnd, rightEnd, F, u) ⊆ V
proof
  intros w hw
  obtain ⟨inV, _⟩ := componentBy.membership.forward with hw
  exact inV

theorem componentBy.joined_of_eq (V leftEnd rightEnd F u v : Set)
  requires vertex : v ∈ V
  requires same : componentBy(V, leftEnd, rightEnd, F, u) =
    componentBy(V, leftEnd, rightEnd, F, v)
  shows Joined(leftEnd, rightEnd, F, u, v)
proof
  have self := componentBy.self at V, leftEnd, rightEnd, F, v with vertex
  rw ← same at self
  exact componentBy.joined with self

theorem componentsBy.contains (V leftEnd rightEnd F u : Set)
  requires vertex : u ∈ V
  shows componentBy(V, leftEnd, rightEnd, F, u) ∈
    componentsBy(V, leftEnd, rightEnd, F)
proof
  exact componentsBy.membership.backward with ⟨u, vertex, rfl⟩

theorem componentsBy.subset_powerset (V leftEnd rightEnd F : Set)
  shows componentsBy(V, leftEnd, rightEnd, F) ⊆ 𝒫(V)
proof
  intros X hX
  obtain ⟨u, hu, rfl⟩ := componentsBy.membership.forward with hX
  exact powerset.membership_iff.backward with
    (componentBy.subset at V, leftEnd, rightEnd, F, u)

theorem componentsBy.finite (V leftEnd rightEnd F : Set)
  requires finiteVertices : Finite(V)
  shows Finite(componentsBy(V, leftEnd, rightEnd, F))
proof
  have subset := componentsBy.subset_powerset at V, leftEnd, rightEnd, F
  exact Finite.subset with (Finite.powerset with finiteVertices), subset

-- Ends stay in V under passing to a subset and under adding an edge with
-- ends in V.
theorem ends_in.subset (V leftEnd rightEnd F G : Set)
  requires ends : ∀ e ∈ F, leftEnd(e) ∈ V ∧ rightEnd(e) ∈ V
  requires subset : G ⊆ F
  shows ∀ e ∈ G, leftEnd(e) ∈ V ∧ rightEnd(e) ∈ V
proof
  intros e he
  exact ends with e, (subset with e, he)

theorem ends_in.union_edge (V leftEnd rightEnd F e : Set)
  requires ends : ∀ f ∈ F, leftEnd(f) ∈ V ∧ rightEnd(f) ∈ V
  requires edgeEnds : leftEnd(e) ∈ V ∧ rightEnd(e) ∈ V
  shows ∀ f ∈ F ∪ {e}, leftEnd(f) ∈ V ∧ rightEnd(f) ∈ V
proof
  intros f hf
  rw [union2.membership, singleton.membership] at hf
  cases hf with inF | same
  . exact ends with f, inF
  . rw same
    exact edgeEnds

-- A set closed under F holds both ends of an edge whose ends F joins, or
-- neither; so it stays closed when that edge is added.
theorem Joined.balanced (V leftEnd rightEnd F A u v : Set)
  requires ends : ∀ e ∈ F, leftEnd(e) ∈ V ∧ rightEnd(e) ∈ V
  requires first : u ∈ V
  requires second : v ∈ V
  requires joined : Joined(leftEnd, rightEnd, F, u, v)
  requires closed : ClosedUnder(leftEnd, rightEnd, F, A)
  shows u ∈ A ↔ v ∈ A
proof
  have back := Joined.symmetric with ends, first, second, joined
  constructor
  . intro hu
    exact joined with A, hu, closed
  . intro hv
    exact back with A, hv, closed

theorem ClosedUnder.add_edge (leftEnd rightEnd F g A : Set)
  requires closed : ClosedUnder(leftEnd, rightEnd, F, A)
  requires balanced : leftEnd(g) ∈ A ↔ rightEnd(g) ∈ A
  shows ClosedUnder(leftEnd, rightEnd, F ∪ {g}, A)
proof
  intros e he
  rw [union2.membership, singleton.membership] at he
  cases he with inF | same
  . exact closed with e, inF
  . rw same
    exact balanced

-- An edge whose ends F already joins adds nothing to connectivity.
theorem Joined.drop_edge (V leftEnd rightEnd F g u v : Set)
  requires ends : ∀ e ∈ F, leftEnd(e) ∈ V ∧ rightEnd(e) ∈ V
  requires edgeEnds : leftEnd(g) ∈ V ∧ rightEnd(g) ∈ V
  requires joined : Joined(leftEnd, rightEnd, F ∪ {g}, u, v)
  requires bridged : Joined(leftEnd, rightEnd, F, leftEnd(g), rightEnd(g))
  shows Joined(leftEnd, rightEnd, F, u, v)
proof
  intros A hu closed
  have balanced := Joined.balanced with
    ends, edgeEnds.left, edgeEnds.right, bridged, closed
  exact joined with A, hu, (ClosedUnder.add_edge with closed, balanced)

-- A vertex joined by F to neither end of e is joined by F ∪ {e} only to
-- what F joins it to: its F-component is closed under the new edge.
theorem Joined.drop_edge_apart (V leftEnd rightEnd F e u v : Set)
  requires ends : ∀ f ∈ F, leftEnd(f) ∈ V ∧ rightEnd(f) ∈ V
  requires vertex : u ∈ V
  requires apartLeft : ¬Joined(leftEnd, rightEnd, F, u, leftEnd(e))
  requires apartRight : ¬Joined(leftEnd, rightEnd, F, u, rightEnd(e))
  requires joined : Joined(leftEnd, rightEnd, F ∪ {e}, u, v)
  shows Joined(leftEnd, rightEnd, F, u, v)
proof
  have closed := componentBy.closed at V, leftEnd, rightEnd, F, u with ends
  have leftOut : ¬leftEnd(e) ∈ componentBy(V, leftEnd, rightEnd, F, u)
    intro member
    exact apartLeft with (componentBy.joined with member)
  have rightOut : ¬rightEnd(e) ∈ componentBy(V, leftEnd, rightEnd, F, u)
    intro member
    exact apartRight with (componentBy.joined with member)
  have balanced : leftEnd(e) ∈ componentBy(V, leftEnd, rightEnd, F, u) ↔
      rightEnd(e) ∈ componentBy(V, leftEnd, rightEnd, F, u) by tauto
  have self := componentBy.self at V, leftEnd, rightEnd, F, u with vertex
  have member := joined with componentBy(V, leftEnd, rightEnd, F, u), self,
    (ClosedUnder.add_edge with closed, balanced)
  exact componentBy.joined with member

-- Adding an edge changes no component away from its ends, and none at all
-- when its ends were already joined.
theorem componentBy.add_edge_apart (V leftEnd rightEnd F e u : Set)
  requires ends : ∀ f ∈ F, leftEnd(f) ∈ V ∧ rightEnd(f) ∈ V
  requires vertex : u ∈ V
  requires apartLeft : ¬Joined(leftEnd, rightEnd, F, u, leftEnd(e))
  requires apartRight : ¬Joined(leftEnd, rightEnd, F, u, rightEnd(e))
  shows componentBy(V, leftEnd, rightEnd, F ∪ {e}, u) =
    componentBy(V, leftEnd, rightEnd, F, u)
proof
  ext v
  constructor
  . intro hv
    obtain ⟨inV, joinedMore⟩ := componentBy.membership.forward with hv
    have joined := Joined.drop_edge_apart with
      ends, vertex, apartLeft, apartRight, joinedMore
    exact componentBy.membership.backward with ⟨inV, joined⟩
  . intro hv
    obtain ⟨inV, joined⟩ := componentBy.membership.forward with hv
    have joinedMore := Joined.monotone with
      (union2.subset_left at F, {e}), joined
    exact componentBy.membership.backward with ⟨inV, joinedMore⟩

theorem componentBy.add_edge_joined (V leftEnd rightEnd F e u : Set)
  requires ends : ∀ f ∈ F, leftEnd(f) ∈ V ∧ rightEnd(f) ∈ V
  requires edgeEnds : leftEnd(e) ∈ V ∧ rightEnd(e) ∈ V
  requires bridged : Joined(leftEnd, rightEnd, F, leftEnd(e), rightEnd(e))
  shows componentBy(V, leftEnd, rightEnd, F ∪ {e}, u) =
    componentBy(V, leftEnd, rightEnd, F, u)
proof
  ext v
  constructor
  . intro hv
    obtain ⟨inV, joinedMore⟩ := componentBy.membership.forward with hv
    have joined := Joined.drop_edge with ends, edgeEnds, joinedMore, bridged
    exact componentBy.membership.backward with ⟨inV, joined⟩
  . intro hv
    obtain ⟨inV, joined⟩ := componentBy.membership.forward with hv
    have joinedMore := Joined.monotone with
      (union2.subset_left at F, {e}), joined
    exact componentBy.membership.backward with ⟨inV, joinedMore⟩

-- The components of an edge set are determined by the component of each
-- vertex.
theorem componentsBy.congr (V leftEnd rightEnd F G : Set)
  requires same : ∀ u ∈ V, componentBy(V, leftEnd, rightEnd, F, u) =
    componentBy(V, leftEnd, rightEnd, G, u)
  shows componentsBy(V, leftEnd, rightEnd, F) =
    componentsBy(V, leftEnd, rightEnd, G)
proof
  ext X
  constructor
  . intro hX
    obtain ⟨u, hu, rfl⟩ := componentsBy.membership.forward with hX
    have keep := same with u, hu
    rw keep
    exact componentsBy.contains with hu
  . intro hX
    obtain ⟨u, hu, rfl⟩ := componentsBy.membership.forward with hX
    have keep := same with u, hu
    rw ← keep
    exact componentsBy.contains with hu

theorem componentsBy.add_edge_joined (V leftEnd rightEnd F e : Set)
  requires ends : ∀ f ∈ F, leftEnd(f) ∈ V ∧ rightEnd(f) ∈ V
  requires edgeEnds : leftEnd(e) ∈ V ∧ rightEnd(e) ∈ V
  requires bridged : Joined(leftEnd, rightEnd, F, leftEnd(e), rightEnd(e))
  shows componentsBy(V, leftEnd, rightEnd, F ∪ {e}) =
    componentsBy(V, leftEnd, rightEnd, F)
proof
  apply componentsBy.congr
  intros u hu
  exact componentBy.add_edge_joined with ends, edgeEnds, bridged

-- Adding an edge between two different components merges them and leaves
-- every other component alone, so the number of components drops by one.
theorem componentsBy.add_edge_apart (V leftEnd rightEnd F e : Set)
  requires finiteVertices : Finite(V)
  requires ends : ∀ f ∈ F, leftEnd(f) ∈ V ∧ rightEnd(f) ∈ V
  requires edgeEnds : leftEnd(e) ∈ V ∧ rightEnd(e) ∈ V
  requires apart : ¬Joined(leftEnd, rightEnd, F, leftEnd(e), rightEnd(e))
  shows cardinality(componentsBy(V, leftEnd, rightEnd, F ∪ {e})) + 1 =
    cardinality(componentsBy(V, leftEnd, rightEnd, F))
proof
  have moreEnds := ends_in.union_edge with ends, edgeEnds
  have subset := union2.subset_left at F, {e}
  have edge : e ∈ F ∪ {e} by simp
  have stepBack := Joined.of_edge_reverse at leftEnd, rightEnd, F ∪ {e}, e
    with edge
  have leftIn := componentsBy.contains at V, leftEnd, rightEnd, F, leftEnd(e)
    with edgeEnds.left
  have rightIn := componentsBy.contains at V, leftEnd, rightEnd, F,
    rightEnd(e) with edgeEnds.right
  have mergedIn := componentsBy.contains at V, leftEnd, rightEnd, F ∪ {e},
    leftEnd(e) with edgeEnds.left
  have different : componentBy(V, leftEnd, rightEnd, F, rightEnd(e)) ≠
      componentBy(V, leftEnd, rightEnd, F, leftEnd(e))
    intro same
    symm at same
    exact apart with (componentBy.joined_of_eq with edgeEnds.right, same)
  -- Away from the two components of the ends, nothing changes.
  have rest : (componentsBy(V, leftEnd, rightEnd, F) ∖
        {componentBy(V, leftEnd, rightEnd, F, leftEnd(e))}) ∖
        {componentBy(V, leftEnd, rightEnd, F, rightEnd(e))} =
      componentsBy(V, leftEnd, rightEnd, F ∪ {e}) ∖
        {componentBy(V, leftEnd, rightEnd, F ∪ {e}, leftEnd(e))}
    ext X
    constructor
    . intro hX
      obtain ⟨inner, notRight⟩ :=
        difference.singleton_membership.forward with hX
      obtain ⟨inOld, notLeft⟩ :=
        difference.singleton_membership.forward with inner
      obtain ⟨w, hw, rfl⟩ := componentsBy.membership.forward with inOld
      have apartLeft : ¬Joined(leftEnd, rightEnd, F, w, leftEnd(e))
        intro joined
        exact notLeft with
          (componentBy.eq_of_joined with ends, hw, edgeEnds.left, joined)
      have apartRight : ¬Joined(leftEnd, rightEnd, F, w, rightEnd(e))
        intro joined
        exact notRight with
          (componentBy.eq_of_joined with ends, hw, edgeEnds.right, joined)
      have keep := componentBy.add_edge_apart with
        ends, hw, apartLeft, apartRight
      have notMerged : componentBy(V, leftEnd, rightEnd, F ∪ {e}, w) ≠
          componentBy(V, leftEnd, rightEnd, F ∪ {e}, leftEnd(e))
        intro same
        have joinedMore := componentBy.joined_of_eq with edgeEnds.left, same
        exact apartLeft with (Joined.drop_edge_apart with
          ends, hw, apartLeft, apartRight, joinedMore)
      have inNew := componentsBy.contains at V, leftEnd, rightEnd, F ∪ {e}, w
        with hw
      rw ← keep
      exact difference.singleton_membership.backward with ⟨inNew, notMerged⟩
    . intro hX
      obtain ⟨inNew, notMerged⟩ :=
        difference.singleton_membership.forward with hX
      obtain ⟨w, hw, rfl⟩ := componentsBy.membership.forward with inNew
      have apartMore : ¬Joined(leftEnd, rightEnd, F ∪ {e}, w, leftEnd(e))
        intro joined
        exact notMerged with
          (componentBy.eq_of_joined with moreEnds, hw, edgeEnds.left, joined)
      have apartLeft : ¬Joined(leftEnd, rightEnd, F, w, leftEnd(e))
        intro joined
        exact apartMore with (Joined.monotone with subset, joined)
      have apartRight : ¬Joined(leftEnd, rightEnd, F, w, rightEnd(e))
        intro joined
        have more := Joined.monotone with subset, joined
        exact apartMore with (Joined.transitive with more, stepBack)
      have keep := componentBy.add_edge_apart with
        ends, hw, apartLeft, apartRight
      have notLeft : componentBy(V, leftEnd, rightEnd, F, w) ≠
          componentBy(V, leftEnd, rightEnd, F, leftEnd(e))
        intro same
        exact apartLeft with
          (componentBy.joined_of_eq with edgeEnds.left, same)
      have notRight : componentBy(V, leftEnd, rightEnd, F, w) ≠
          componentBy(V, leftEnd, rightEnd, F, rightEnd(e))
        intro same
        exact apartRight with
          (componentBy.joined_of_eq with edgeEnds.right, same)
      have inOld := componentsBy.contains at V, leftEnd, rightEnd, F, w with hw
      have inner : componentBy(V, leftEnd, rightEnd, F, w) ∈
          componentsBy(V, leftEnd, rightEnd, F) ∖
            {componentBy(V, leftEnd, rightEnd, F, leftEnd(e))} :=
        difference.singleton_membership.backward with ⟨inOld, notLeft⟩
      rw keep
      exact difference.singleton_membership.backward with ⟨inner, notRight⟩
  -- Count: two components removed on one side, one on the other.
  have finiteOld := componentsBy.finite at V, leftEnd, rightEnd, F
    with finiteVertices
  have finiteNew := componentsBy.finite at V, leftEnd, rightEnd, F ∪ {e}
    with finiteVertices
  have finiteInner : Finite(componentsBy(V, leftEnd, rightEnd, F) ∖
      {componentBy(V, leftEnd, rightEnd, F, leftEnd(e))}) :=
    Finite.subset with finiteOld, (difference.subset_left at
      componentsBy(V, leftEnd, rightEnd, F),
      {componentBy(V, leftEnd, rightEnd, F, leftEnd(e))})
  have finiteRest : Finite(componentsBy(V, leftEnd, rightEnd, F ∪ {e}) ∖
      {componentBy(V, leftEnd, rightEnd, F ∪ {e}, leftEnd(e))}) :=
    Finite.subset with finiteNew, (difference.subset_left at
      componentsBy(V, leftEnd, rightEnd, F ∪ {e}),
      {componentBy(V, leftEnd, rightEnd, F ∪ {e}, leftEnd(e))})
  have rightInner : componentBy(V, leftEnd, rightEnd, F, rightEnd(e)) ∈
      componentsBy(V, leftEnd, rightEnd, F) ∖
        {componentBy(V, leftEnd, rightEnd, F, leftEnd(e))} :=
    difference.singleton_membership.backward with ⟨rightIn, different⟩
  have removeLeft := cardinality.remove with finiteOld, leftIn
  have removeRight := cardinality.remove with finiteInner, rightInner
  have removeMerged := cardinality.remove with finiteNew, mergedIn
  have natRest := cardinality.nat with finiteRest
  rw rest at removeRight
  rw [removeMerged, removeLeft, removeRight]
  arith

-- Along no edges a vertex is joined only to itself, so the components of ∅
-- are the singletons and there are as many as vertices.
theorem Joined.empty (leftEnd rightEnd u v : Set)
  requires joined : Joined(leftEnd, rightEnd, ∅, u, v)
  shows v = u
proof
  have closed : ClosedUnder(leftEnd, rightEnd, ∅, {u}) by simp [ClosedUnder]
  have self : u ∈ {u} by simp
  exact singleton.membership.forward with (joined with {u}, self, closed)

defgraph componentMap (V leftEnd rightEnd F : Set) (u ∈ V) : 𝒫(V) :=
  componentBy(V, leftEnd, rightEnd, F, u)
proof
  apply powerset.membership_iff.backward
  exact componentBy.subset at V, leftEnd, rightEnd, F, u

theorem componentMap.image (V leftEnd rightEnd F : Set)
  shows functionImage(componentMap(V, leftEnd, rightEnd, F), V, 𝒫(V)) =
    componentsBy(V, leftEnd, rightEnd, F)
proof
  ext X
  constructor
  . intro hX
    obtain ⟨_, u, hu, rfl⟩ := functionImage.membership.forward with hX
    have value := componentMap.value at V, leftEnd, rightEnd, F, u with hu
    rw value
    exact componentsBy.contains with hu
  . intro hX
    obtain ⟨u, hu, rfl⟩ := componentsBy.membership.forward with hX
    have value := componentMap.value at V, leftEnd, rightEnd, F, u with hu
    have inPowerset : componentBy(V, leftEnd, rightEnd, F, u) ∈ 𝒫(V) :=
      powerset.membership_iff.backward with
        (componentBy.subset at V, leftEnd, rightEnd, F, u)
    symm at value
    exact functionImage.membership.backward with ⟨inPowerset, u, hu, value⟩

theorem componentsBy.empty_count (V leftEnd rightEnd : Set)
  requires finiteVertices : Finite(V)
  shows cardinality(componentsBy(V, leftEnd, rightEnd, ∅)) = cardinality(V)
proof
  have function := componentMap.function at V, leftEnd, rightEnd, ∅
  have injective :
      InjectiveBetween(componentMap(V, leftEnd, rightEnd, ∅), V, 𝒫(V))
    constructor
    . exact function
    . intros x hx y hy z hz relatesX relatesY
      have valueX := FunctionBetween.apply_value with function, hx, relatesX
      have valueY := FunctionBetween.apply_value with function, hy, relatesY
      have shapeX := componentMap.value at V, leftEnd, rightEnd, ∅, x with hx
      have shapeY := componentMap.value at V, leftEnd, rightEnd, ∅, y with hy
      have same : componentBy(V, leftEnd, rightEnd, ∅, x) =
          componentBy(V, leftEnd, rightEnd, ∅, y) by cc
      symm
      exact Joined.empty with (componentBy.joined_of_eq with hy, same)
  have reflexive : V ⊆ V by simp
  have count := cardinality.injective_image with
    injective, reflexive, finiteVertices
  have image := componentMap.image at V, leftEnd, rightEnd, ∅
  rw image at count
  exact count

theorem Forest.subset (V leftEnd rightEnd F G : Set)
  requires forest : Forest(V, leftEnd, rightEnd, F)
  requires subset : G ⊆ F
  shows Forest(V, leftEnd, rightEnd, G)
proof
  obtain ⟨finite, acyclic⟩ := forest
  constructor
  . exact Finite.subset with finite, subset
  . intros C bound even
    exact acyclic with C, (Subset.transitive with bound, subset), even

-- A set of size k + 1 is a set of size k with one element put back.
theorem cardinality.exists_remove (F : Set) (k : Nat)
  requires finite : Finite(F)
  requires size : cardinality(F) = succ(k)
  shows ∃ e ∈ F, cardinality(F ∖ {e}) = k ∧ (F ∖ {e}) ∪ {e} = F
proof
  have has := cardinality.correct with finite
  rw size at has
  obtain ⟨e, he⟩ := HasCardinality.exists_member with has
  have removed := cardinality.remove with finite, he
  rw size at removed
  have restored : (F ∖ {e}) ∪ {e} = F
    ext y
    simp
  refine ⟨e, he, _, restored⟩
  symm
  exact Naturals.injective.succ with removed

-- Each edge merges at most two components: |V| ≤ |F| + |components of F|.
theorem componentsBy.lower_bound_of_size (V leftEnd rightEnd F : Set) (n : Nat)
  requires finiteVertices : Finite(V)
  requires finite : Finite(F)
  requires size : cardinality(F) = n
  requires ends : ∀ e ∈ F, leftEnd(e) ∈ V ∧ rightEnd(e) ∈ V
  shows cardinality(V) ≤
    cardinality(F) + cardinality(componentsBy(V, leftEnd, rightEnd, F))
proof
  have natV := cardinality.nat with finiteVertices
  induction n generalizing F
  | zero =>
    intros F finite size ends
    have has := cardinality.correct with finite
    rw size at has
    have empty := HasCardinality.empty_of_zero at F with has
    have count := componentsBy.empty_count at V, leftEnd, rightEnd
      with finiteVertices
    rw [empty, count, cardinality.empty]
    arith
  | succ(k) using ih =>
    intros F finite size ends
    obtain ⟨e, he, restSize, restored⟩ :=
      cardinality.exists_remove with finite, size
    have restSubset := difference.subset_left at F, {e}
    have restFinite := Finite.subset with finite, restSubset
    have restEnds := ends_in.subset with ends, restSubset
    have rest := ih with F ∖ {e}, restFinite, restSize, restEnds
    have edgeEnds := ends with e, he
    have natF := cardinality.nat with finite
    have natRest := cardinality.nat with (componentsBy.finite at
      V, leftEnd, rightEnd, F ∖ {e} with finiteVertices)
    have natWhole := cardinality.nat with
      (componentsBy.finite at V, leftEnd, rightEnd, F with finiteVertices)
    by_cases bridged :
      Joined(leftEnd, rightEnd, F ∖ {e}, leftEnd(e), rightEnd(e))
    . have same := componentsBy.add_edge_joined with restEnds, edgeEnds, bridged
      rw restored at same
      rw same
      arith
    . have count := componentsBy.add_edge_apart with
        finiteVertices, restEnds, edgeEnds, bridged
      rw restored at count
      arith

theorem componentsBy.lower_bound (V leftEnd rightEnd F : Set)
  requires finiteVertices : Finite(V)
  requires finite : Finite(F)
  requires ends : ∀ e ∈ F, leftEnd(e) ∈ V ∧ rightEnd(e) ∈ V
  shows cardinality(V) ≤
    cardinality(F) + cardinality(componentsBy(V, leftEnd, rightEnd, F))
proof
  have natF := cardinality.nat with finite
  have same : cardinality(F) = cardinality(F) by rfl
  exact componentsBy.lower_bound_of_size at V, leftEnd, rightEnd, F,
    cardinality(F) with finiteVertices, finite, same, ends

-- In an even edge set the ends of every edge are joined by the other edges:
-- otherwise the edge alone would leave the component of one of its ends,
-- and an even edge set leaves every vertex set an even number of times.
theorem EvenEdgeSet.ends_joined (V leftEnd rightEnd C f : Set)
  requires finiteVertices : Finite(V)
  requires ends : ∀ e ∈ C, leftEnd(e) ∈ V ∧ rightEnd(e) ∈ V
  requires even : EvenEdgeSet(V, leftEnd, rightEnd, C)
  requires edge : f ∈ C
  shows Joined(leftEnd, rightEnd, C ∖ {f}, leftEnd(f), rightEnd(f))
proof
  by_contra apart
  have restEnds := ends_in.subset with ends, (difference.subset_left at C, {f})
  have edgeEnds := ends with f, edge
  have closed := componentBy.closed at V, leftEnd, rightEnd, C ∖ {f},
    leftEnd(f) with restEnds
  have subsetV := componentBy.subset at V, leftEnd, rightEnd, C ∖ {f},
    leftEnd(f)
  have leftIn := componentBy.self at V, leftEnd, rightEnd, C ∖ {f}, leftEnd(f)
    with edgeEnds.left
  have rightOut :
      ¬rightEnd(f) ∈ componentBy(V, leftEnd, rightEnd, C ∖ {f}, leftEnd(f))
    intro member
    exact apart with (componentBy.joined with member)
  have cut : crossing(leftEnd, rightEnd, C,
      componentBy(V, leftEnd, rightEnd, C ∖ {f}, leftEnd(f))) = {f}
    ext g
    rw singleton.membership
    constructor
    . intro hg
      obtain ⟨inC, unbalanced⟩ := crossing.membership.forward with hg
      by_contra other
      have inRest : g ∈ C ∖ {f} :=
        difference.singleton_membership.backward with ⟨inC, other⟩
      have balanced := closed with g, inRest
      tauto
    . intro same
      rw same
      apply crossing.membership.backward
      tauto
  exact EvenEdgeSet.crossing_ne_singleton with
    finiteVertices, even, subsetV, ends, cut

-- A path between the two ends of an edge, together with the edge, is even.
theorem EvenEdgeSet.of_path_edge (V leftEnd rightEnd P e : Set)
  requires finite : Finite(P)
  requires outside : ¬e ∈ P
  requires distinct : leftEnd(e) ≠ rightEnd(e)
  requires path : ∀ w ∈ V, (Even(degreeIn(leftEnd, rightEnd, P, w)) ↔
    (w ≠ leftEnd(e) ∧ w ≠ rightEnd(e)))
  shows EvenEdgeSet(V, leftEnd, rightEnd, P ∪ {e})
proof
  have finiteEdge := Finite.singleton at e
  have apart : Disjoint(P, {e})
    unfold Disjoint
    ext x
    simp
  constructor
  . exact Finite.union with finite, finiteEdge
  . intros w hw
    have sum := degreeIn.union_disjoint at leftEnd, rightEnd, P, {e}, w
      with finite, finiteEdge, apart
    have parity := path with w, hw
    have natDegree := degreeIn.natural at leftEnd, rightEnd, P, w with finite
    rw sum
    by_cases atEnd : leftEnd(e) = w ∨ rightEnd(e) = w
    . -- At an end of e the path has odd degree and e supplies one more.
      have one := degreeIn.end with distinct, atEnd
      have odd : ¬Even(degreeIn(leftEnd, rightEnd, P, w))
        intro even
        have away := parity.forward with even
        tauto
      have notOne := Even.not_one
      rw [one, Even.add_iff]
      tauto
    . have notLeft : leftEnd(e) ≠ w by tauto
      have notRight : rightEnd(e) ≠ w by tauto
      have away : w ≠ leftEnd(e) ∧ w ≠ rightEnd(e) by tauto
      have zero := degreeIn.absent with notLeft, notRight
      rw [zero, add.right_unit]
      exact parity.backward with away

-- In a forest the ends of an edge are joined only through that edge: a path
-- around it would close a nonempty even set, and a loop is one by itself.
theorem Forest.ends_apart (V leftEnd rightEnd F e : Set)
  requires ends : ∀ f ∈ F, leftEnd(f) ∈ V ∧ rightEnd(f) ∈ V
  requires forest : Forest(V, leftEnd, rightEnd, F)
  requires edge : e ∈ F
  shows ¬Joined(leftEnd, rightEnd, F ∖ {e}, leftEnd(e), rightEnd(e))
proof
  intro joined
  obtain ⟨finite, acyclic⟩ := forest
  have restSubset := difference.subset_left at F, {e}
  have restFinite := Finite.subset with finite, restSubset
  have restEnds := ends_in.subset with ends, restSubset
  have edgeSubset : {e} ⊆ F := singleton.subset_iff.backward with edge
  have self : e ∈ {e} by simp
  by_cases loop : leftEnd(e) = rightEnd(e)
  . have even := EvenEdgeSet.loop at V, leftEnd, rightEnd, e with loop
    have empty := acyclic with {e}, edgeSubset, even
    rw empty at self
    exact set.empty with self
  . obtain ⟨P, subsetP, path⟩ :=
      Joined.path with restFinite, restEnds, loop, joined
    have finiteP := Finite.subset with restFinite, subsetP
    have outside : ¬e ∈ P
      intro inP
      obtain ⟨_, different⟩ :=
        difference.singleton_membership.forward with (subsetP with e, inP)
      apply different
      rfl
    have even := EvenEdgeSet.of_path_edge with finiteP, outside, loop, path
    have inside : P ∪ {e} ⊆ F := Subset.union2_iff.backward with
      ⟨(Subset.transitive with subsetP, restSubset), edgeSubset⟩
    have empty := acyclic with P ∪ {e}, inside, even
    have member : e ∈ P ∪ {e} by simp
    rw empty at member
    exact set.empty with member

-- Adding an edge between vertices a forest does not join keeps it a forest:
-- an even set through the new edge would join its ends by the old edges.
theorem Forest.add_edge (V leftEnd rightEnd F e : Set)
  requires finiteVertices : Finite(V)
  requires ends : ∀ f ∈ F, leftEnd(f) ∈ V ∧ rightEnd(f) ∈ V
  requires edgeEnds : leftEnd(e) ∈ V ∧ rightEnd(e) ∈ V
  requires forest : Forest(V, leftEnd, rightEnd, F)
  requires apart : ¬Joined(leftEnd, rightEnd, F, leftEnd(e), rightEnd(e))
  shows Forest(V, leftEnd, rightEnd, F ∪ {e})
proof
  obtain ⟨finite, acyclic⟩ := forest
  have moreEnds := ends_in.union_edge with ends, edgeEnds
  constructor
  . exact Finite.union with finite, (Finite.singleton at e)
  . intros C bound even
    have endsC := ends_in.subset with moreEnds, bound
    have inF : C ∖ {e} ⊆ F
      intros g hg
      obtain ⟨inC, different⟩ :=
        difference.singleton_membership.forward with hg
      have split := union2.membership.forward with (bound with g, inC)
      rw singleton.membership at split
      tauto
    by_cases inC : e ∈ C
    . exfalso
      have joined := EvenEdgeSet.ends_joined with
        finiteVertices, endsC, even, inC
      exact apart with (Joined.monotone with inF, joined)
    . have same : C ∖ {e} = C
        ext g
        rw difference.singleton_membership
        constructor
        . intro hg
          exact hg.left
        . intro hg
          have different : g ≠ e
            intro same
            rw same at hg
            exact inC with hg
          exact ⟨hg, different⟩
      rw same at inF
      exact acyclic with C, inF, even

-- Removing an edge of a forest splits a component in two, so a forest has
-- |F| + |components| ≤ |V|.
theorem Forest.edge_bound_of_size (V leftEnd rightEnd F : Set) (n : Nat)
  requires finiteVertices : Finite(V)
  requires size : cardinality(F) = n
  requires ends : ∀ e ∈ F, leftEnd(e) ∈ V ∧ rightEnd(e) ∈ V
  requires forest : Forest(V, leftEnd, rightEnd, F)
  shows cardinality(F) + cardinality(componentsBy(V, leftEnd, rightEnd, F)) ≤
    cardinality(V)
proof
  have natV := cardinality.nat with finiteVertices
  induction n generalizing F
  | zero =>
    intros F size ends forest
    obtain ⟨finite, _⟩ := forest
    have has := cardinality.correct with finite
    rw size at has
    have empty := HasCardinality.empty_of_zero at F with has
    have count := componentsBy.empty_count at V, leftEnd, rightEnd
      with finiteVertices
    rw [empty, count, cardinality.empty]
    arith
  | succ(k) using ih =>
    intros F size ends forest
    obtain ⟨finite, _⟩ := forest
    obtain ⟨e, he, restSize, restored⟩ :=
      cardinality.exists_remove with finite, size
    have restSubset := difference.subset_left at F, {e}
    have restEnds := ends_in.subset with ends, restSubset
    have restForest := Forest.subset with forest, restSubset
    have rest := ih with F ∖ {e}, restSize, restEnds, restForest
    have edgeEnds := ends with e, he
    have apart := Forest.ends_apart with ends, forest, he
    have count := componentsBy.add_edge_apart with
      finiteVertices, restEnds, edgeEnds, apart
    rw restored at count
    have natF := cardinality.nat with finite
    have natRest := cardinality.nat with (componentsBy.finite at
      V, leftEnd, rightEnd, F ∖ {e} with finiteVertices)
    have natWhole := cardinality.nat with
      (componentsBy.finite at V, leftEnd, rightEnd, F with finiteVertices)
    arith

-- Connectivity and the number of components: a disconnected edge set has
-- two components or more, a connected one exactly one.
theorem Connects.witness_apart (V leftEnd rightEnd F : Set)
  requires disconnected : ¬Connects(V, leftEnd, rightEnd, F)
  shows ∃ u ∈ V, ∃ v ∈ V, ¬Joined(leftEnd, rightEnd, F, u, v)
proof
  by_contra none
  apply disconnected
  intros u hu v hv
  by_contra apart
  exact none with ⟨u, hu, v, hv, apart⟩

theorem componentsBy.two_of_disconnected (V leftEnd rightEnd F : Set)
  requires finiteVertices : Finite(V)
  requires disconnected : ¬Connects(V, leftEnd, rightEnd, F)
  shows 2 ≤ cardinality(componentsBy(V, leftEnd, rightEnd, F))
proof
  obtain ⟨u, hu, v, hv, apart⟩ := Connects.witness_apart with disconnected
  have inU := componentsBy.contains at V, leftEnd, rightEnd, F, u with hu
  have inV := componentsBy.contains at V, leftEnd, rightEnd, F, v with hv
  have finiteComponents := componentsBy.finite at V, leftEnd, rightEnd, F
    with finiteVertices
  have singletonSubset : {componentBy(V, leftEnd, rightEnd, F, u)} ⊆
      componentsBy(V, leftEnd, rightEnd, F) :=
    singleton.subset_iff.backward with inU
  have fresh : ¬componentBy(V, leftEnd, rightEnd, F, v) ∈
      {componentBy(V, leftEnd, rightEnd, F, u)}
    intro member
    have same := singleton.membership.forward with member
    symm at same
    exact apart with (componentBy.joined_of_eq with hv, same)
  have strict := cardinality.strict with
    finiteComponents, singletonSubset, inV, fresh
  have natComponents := cardinality.nat with finiteComponents
  rw cardinality.singleton at strict
  arith

theorem componentBy.eq_vertices (V leftEnd rightEnd F u : Set)
  requires connected : Connects(V, leftEnd, rightEnd, F)
  requires vertex : u ∈ V
  shows componentBy(V, leftEnd, rightEnd, F, u) = V
proof
  ext v
  constructor
  . intro hv
    exact componentBy.subset at V, leftEnd, rightEnd, F, u with v, hv
  . intro hv
    have joined := connected with u, vertex, v, hv
    exact componentBy.membership.backward with ⟨hv, joined⟩

theorem componentsBy.connected_subset (V leftEnd rightEnd F : Set)
  requires connected : Connects(V, leftEnd, rightEnd, F)
  shows componentsBy(V, leftEnd, rightEnd, F) ⊆ {V}
proof
  intros X hX
  obtain ⟨u, hu, rfl⟩ := componentsBy.membership.forward with hX
  have same := componentBy.eq_vertices with connected, hu
  rw same
  simp

theorem componentsBy.le_one_of_connected (V leftEnd rightEnd F : Set)
  requires connected : Connects(V, leftEnd, rightEnd, F)
  shows cardinality(componentsBy(V, leftEnd, rightEnd, F)) ≤ 1
proof
  have subset := componentsBy.connected_subset with connected
  have bound := cardinality.monotone with (Finite.singleton at V), subset
  rw cardinality.singleton at bound
  exact bound

theorem componentsBy.connected_count (V leftEnd rightEnd F : Set)
  requires connected : Connects(V, leftEnd, rightEnd, F)
  requires nonempty : V ≠ ∅
  shows cardinality(componentsBy(V, leftEnd, rightEnd, F)) = 1
proof
  have subset := componentsBy.connected_subset with connected
  obtain ⟨u, hu⟩ := Nonempty.of_ne_empty with nonempty
  have contains := componentsBy.contains at V, leftEnd, rightEnd, F, u with hu
  have same := componentBy.eq_vertices with connected, hu
  rw same at contains
  have reverse : {V} ⊆ componentsBy(V, leftEnd, rightEnd, F) :=
    singleton.subset_iff.backward with contains
  have equal := Subset.antisymmetric with subset, reverse
  rw equal
  exact cardinality.singleton at V

-- A forest on a finite vertex set has at most |V| − c edges, c the number of
-- its components; connected forests have exactly |V| − 1.
theorem Forest.edge_bound (V leftEnd rightEnd F : Set)
  requires finiteVertices : Finite(V)
  requires ends : ∀ e ∈ F, leftEnd(e) ∈ V ∧ rightEnd(e) ∈ V
  requires forest : Forest(V, leftEnd, rightEnd, F)
  shows cardinality(F) + cardinality(componentsBy(V, leftEnd, rightEnd, F)) ≤
    cardinality(V)
proof
  obtain ⟨finite, _⟩ := forest
  have natF := cardinality.nat with finite
  have same : cardinality(F) = cardinality(F) by rfl
  exact Forest.edge_bound_of_size at V, leftEnd, rightEnd, F, cardinality(F)
    with finiteVertices, same, ends, forest

-- An edge set on V with at least |V| − 1 edges that does not connect V
-- holds a nonempty even edge set: the key counting step of tree packing.
theorem EvenEdgeSet.of_dense_disconnected (V leftEnd rightEnd F : Set)
  requires finiteVertices : Finite(V)
  requires finite : Finite(F)
  requires ends : ∀ e ∈ F, leftEnd(e) ∈ V ∧ rightEnd(e) ∈ V
  requires dense : cardinality(V) ≤ cardinality(F) + 1
  requires disconnected : ¬Connects(V, leftEnd, rightEnd, F)
  shows ∃ C ⊆ F, C ≠ ∅ ∧ EvenEdgeSet(V, leftEnd, rightEnd, C)
proof
  by_contra none
  -- Without a nonempty even subset, F is a forest with at least two components.
  have forest : Forest(V, leftEnd, rightEnd, F)
    constructor
    . exact finite
    . intros C bound even
      by_contra nonempty
      exact none with ⟨C, bound, nonempty, even⟩
  have upper := Forest.edge_bound with finiteVertices, ends, forest
  have two := componentsBy.two_of_disconnected with finiteVertices, disconnected
  have natF := cardinality.nat with finite
  have natV := cardinality.nat with finiteVertices
  have natComponents := cardinality.nat with
    (componentsBy.finite at V, leftEnd, rightEnd, F with finiteVertices)
  arith

-- A spanning tree is a forest: an edge of an even subset could be dropped
-- without disconnecting V, leaving too few edges for a connected edge set.
theorem SpanningTree.forest (V leftEnd rightEnd T : Set)
  requires finiteVertices : Finite(V)
  requires ends : ∀ e ∈ T, leftEnd(e) ∈ V ∧ rightEnd(e) ∈ V
  requires tree : SpanningTree(V, leftEnd, rightEnd, T)
  shows Forest(V, leftEnd, rightEnd, T)
proof
  obtain ⟨finite, connected, count⟩ := tree
  constructor
  . exact finite
  . intros C bound even
    by_contra nonempty
    obtain ⟨e, he⟩ := Nonempty.of_ne_empty with nonempty
    have inT := bound with e, he
    have restSubset := difference.subset_left at T, {e}
    have restFinite := Finite.subset with finite, restSubset
    have restEnds := ends_in.subset with ends, restSubset
    have edgeEnds := ends with e, inT
    have endsC := ends_in.subset with ends, bound
    have joinedC := EvenEdgeSet.ends_joined with finiteVertices, endsC, even, he
    have restC : C ∖ {e} ⊆ T ∖ {e} :=
      difference.subset_of_subset with bound
    have bridged := Joined.monotone with restC, joinedC
    have same := componentsBy.add_edge_joined with restEnds, edgeEnds, bridged
    have restored : (T ∖ {e}) ∪ {e} = T
      ext y
      simp
    rw restored at same
    have lower := componentsBy.lower_bound with
      finiteVertices, restFinite, restEnds
    rw ← same at lower
    have one := componentsBy.le_one_of_connected with connected
    have removed := cardinality.remove with finite, inT
    have natRest := cardinality.nat with restFinite
    have natV := cardinality.nat with finiteVertices
    have natComponents := cardinality.nat with
      (componentsBy.finite at V, leftEnd, rightEnd, T with finiteVertices)
    rw removed at count
    arith

theorem SpanningTree.of_connected_forest (V leftEnd rightEnd T : Set)
  requires finiteVertices : Finite(V)
  requires nonempty : V ≠ ∅
  requires ends : ∀ e ∈ T, leftEnd(e) ∈ V ∧ rightEnd(e) ∈ V
  requires forest : Forest(V, leftEnd, rightEnd, T)
  requires connected : Connects(V, leftEnd, rightEnd, T)
  shows SpanningTree(V, leftEnd, rightEnd, T)
proof
  obtain ⟨finite, _⟩ := forest
  have upper := Forest.edge_bound with finiteVertices, ends, forest
  have lower := componentsBy.lower_bound with finiteVertices, finite, ends
  have one := componentsBy.connected_count with connected, nonempty
  rw one at upper
  rw one at lower
  have natT := cardinality.nat with finite
  have natV := cardinality.nat with finiteVertices
  refine ⟨finite, connected, _⟩
  arith

-- The forests inside an edge set, a finite family when the edge set is finite.
def forestsIn (V leftEnd rightEnd E : Set) : Set :=
  { F ∈ 𝒫(E) | Forest(V, leftEnd, rightEnd, F) }

theorem Graph.ends (V E leftEnd rightEnd : Set)
  requires graph : Graph(V, E, leftEnd, rightEnd)
  shows ∀ e ∈ E, leftEnd(e) ∈ V ∧ rightEnd(e) ∈ V
proof
  obtain ⟨leftFunction, rightFunction⟩ := graph
  intros e he
  exact ⟨(FunctionBetween.apply_closed with leftFunction, he),
    (FunctionBetween.apply_closed with rightFunction, he)⟩

-- Every connected finite multigraph has a spanning tree: a maximal forest
-- inside E is connected, else an edge of E leaving one of its components
-- could be added to it.
theorem SpanningTree.exists (V E leftEnd rightEnd : Set)
  requires graph : Graph(V, E, leftEnd, rightEnd)
  requires finiteVertices : Finite(V)
  requires finiteEdges : Finite(E)
  requires nonempty : V ≠ ∅
  requires connected : Connects(V, leftEnd, rightEnd, E)
  shows ∃ T ⊆ E, SpanningTree(V, leftEnd, rightEnd, T)
proof
  have endsE := Graph.ends with graph
  have finiteFamily : Finite(forestsIn(V, leftEnd, rightEnd, E))
    have subset : forestsIn(V, leftEnd, rightEnd, E) ⊆ 𝒫(E)
      intros F hF
      obtain ⟨inPowerset, _⟩ := forestsIn.membership.forward with hF
      exact inPowerset
    exact Finite.subset with (Finite.powerset with finiteEdges), subset
  have emptyForest : ∅ ∈ forestsIn(V, leftEnd, rightEnd, E)
    have emptySubset : ∅ ∈ 𝒫(E) :=
      powerset.membership_iff.backward with (empty.subset at E)
    have forest : Forest(V, leftEnd, rightEnd, ∅)
      constructor
      . exact Finite.empty
      . intros C bound even
        exact Subset.antisymmetric with bound, (empty.subset at C)
    exact forestsIn.membership.backward with ⟨emptySubset, forest⟩
  obtain ⟨T, inFamily, _, maximal⟩ :=
    Finite.maximal_extension with finiteFamily, emptyForest
  obtain ⟨inPowerset, forest⟩ := forestsIn.membership.forward with inFamily
  have subsetE := powerset.membership_iff.forward with inPowerset
  have endsT := ends_in.subset with endsE, subsetE
  have connectedT : Connects(V, leftEnd, rightEnd, T)
    by_contra disconnected
    obtain ⟨u, hu, v, hv, apart⟩ := Connects.witness_apart with disconnected
    have closedT := componentBy.closed at V, leftEnd, rightEnd, T, u
      with endsT
    have selfU := componentBy.self at V, leftEnd, rightEnd, T, u with hu
    -- Some edge of E leaves the T-component of u, since v lies outside it.
    have crossingEdge : ∃ e ∈ E,
        ¬(leftEnd(e) ∈ componentBy(V, leftEnd, rightEnd, T, u) ↔
          rightEnd(e) ∈ componentBy(V, leftEnd, rightEnd, T, u))
      by_contra none
      have closedE : ClosedUnder(leftEnd, rightEnd, E,
          componentBy(V, leftEnd, rightEnd, T, u))
        intros e he
        by_contra unbalanced
        exact none with ⟨e, he, unbalanced⟩
      have inComponent := connected with u, hu, v, hv,
        componentBy(V, leftEnd, rightEnd, T, u), selfU, closedE
      exact apart with (componentBy.joined with inComponent)
    obtain ⟨e, he, unbalanced⟩ := crossingEdge
    have edgeEnds := endsE with e, he
    have outside : ¬e ∈ T
      intro inT
      exact unbalanced with (closedT with e, inT)
    have apartEnds : ¬Joined(leftEnd, rightEnd, T, leftEnd(e), rightEnd(e))
      intro joined
      exact unbalanced with (Joined.balanced with
        endsT, edgeEnds.left, edgeEnds.right, joined, closedT)
    -- Then T ∪ {e} is a larger forest inside E, against maximality.
    have bigger := Forest.add_edge with
      finiteVertices, endsT, edgeEnds, forest, apartEnds
    have biggerSubset : T ∪ {e} ⊆ E := Subset.union2_iff.backward with
      ⟨subsetE, (singleton.subset_iff.backward with he)⟩
    have biggerIn : T ∪ {e} ∈ forestsIn(V, leftEnd, rightEnd, E) :=
      forestsIn.membership.backward with
        ⟨(powerset.membership_iff.backward with biggerSubset), bigger⟩
    have equal := maximal with
      T ∪ {e}, biggerIn, (union2.subset_left at T, {e})
    have member : e ∈ T ∪ {e} by simp
    rw equal at member
    exact outside with member
  refine ⟨T, subsetE, _⟩
  exact SpanningTree.of_connected_forest with
    finiteVertices, nonempty, endsT, forest, connectedT

-- The fundamental even set of an edge outside a spanning tree: an even set
-- inside T ∪ {e} that contains e.
theorem SpanningTree.fundamental (V leftEnd rightEnd T e : Set)
  requires finiteVertices : Finite(V)
  requires ends : (∀ f ∈ T, leftEnd(f) ∈ V ∧ rightEnd(f) ∈ V)
    ∧ leftEnd(e) ∈ V ∧ rightEnd(e) ∈ V
  requires tree : SpanningTree(V, leftEnd, rightEnd, T)
  requires outside : ¬e ∈ T
  shows ∃ C ⊆ T ∪ {e}, e ∈ C ∧ EvenEdgeSet(V, leftEnd, rightEnd, C)
proof
  obtain ⟨finite, connected, _⟩ := tree
  obtain ⟨endsT, leftIn, rightIn⟩ := ends
  have member : e ∈ {e} by simp
  by_cases loop : leftEnd(e) = rightEnd(e)
  . refine ⟨{e}, (union2.subset_right at T, {e}), member, _⟩
    exact EvenEdgeSet.loop at V, leftEnd, rightEnd, e with loop
  . have joined := connected with leftEnd(e), leftIn, rightEnd(e), rightIn
    obtain ⟨P, subsetP, path⟩ :=
      Joined.path with finite, endsT, loop, joined
    have finiteP := Finite.subset with finite, subsetP
    have outsideP : ¬e ∈ P
      intro inP
      exact outside with (subsetP with e, inP)
    have even := EvenEdgeSet.of_path_edge with finiteP, outsideP, loop, path
    have inside : P ∪ {e} ⊆ T ∪ {e} := union2.monotone_left with subsetP
    have inC : e ∈ P ∪ {e} by simp
    exact ⟨P ∪ {e}, inside, inC, even⟩

-- Exchanging an edge of a tree for another edge of the even set it closes
-- gives a tree again: the one-edge exchange of the tree-packing proof.
theorem SpanningTree.exchange (V leftEnd rightEnd T C e f : Set)
  requires finiteVertices : Finite(V)
  requires ends : (∀ g ∈ T, leftEnd(g) ∈ V ∧ rightEnd(g) ∈ V)
    ∧ leftEnd(e) ∈ V ∧ rightEnd(e) ∈ V
  requires tree : SpanningTree(V, leftEnd, rightEnd, T)
  requires outside : ¬e ∈ T
  requires even : EvenEdgeSet(V, leftEnd, rightEnd, C)
  requires closes : C ⊆ T ∪ {e} ∧ e ∈ C
  requires other : f ∈ C ∧ f ≠ e
  shows SpanningTree(V, leftEnd, rightEnd, (T ∖ {f}) ∪ {e})
proof
  obtain ⟨finite, connected, count⟩ := tree
  obtain ⟨endsT, leftIn, rightIn⟩ := ends
  obtain ⟨inside, inC⟩ := closes
  obtain ⟨fInC, different⟩ := other
  have edgeEnds : leftEnd(e) ∈ V ∧ rightEnd(e) ∈ V :=
    ⟨leftIn, rightIn⟩
  have fInT : f ∈ T
    have split := union2.membership.forward with (inside with f, fInC)
    rw singleton.membership at split
    tauto
  have fEnds := endsT with f, fInT
  have restSubset := difference.subset_left at T, {f}
  have restFinite := Finite.subset with finite, restSubset
  have restEnds := ends_in.subset with endsT, restSubset
  have newEnds := ends_in.union_edge with restEnds, edgeEnds
  have keep := union2.subset_left at T ∖ {f}, {e}
  refine ⟨(Finite.union with restFinite, (Finite.singleton at e)), _, _⟩
  . -- The ends of f stay joined through C ∖ {f}, so dropping f from
    -- T ∪ {e} loses no connection.
    have endsC := ends_in.subset with (ends_in.union_edge with endsT, edgeEnds),
      inside
    have joinedC := EvenEdgeSet.ends_joined with
      finiteVertices, endsC, even, fInC
    have restC : C ∖ {f} ⊆ (T ∖ {f}) ∪ {e}
      intros g hg
      obtain ⟨inCg, notF⟩ := difference.singleton_membership.forward with hg
      have split := union2.membership.forward with (inside with g, inCg)
      cases split with old | single
      . exact keep with g,
          (difference.singleton_membership.backward with ⟨old, notF⟩)
      . exact union2.subset_right at T ∖ {f}, {e} with g, single
    have bridged := Joined.monotone with restC, joinedC
    have grow : T ⊆ ((T ∖ {f}) ∪ {e}) ∪ {f}
      intros g hg
      by_cases same : g = f
      . rw same
        simp
      . have inRest : g ∈ T ∖ {f} :=
          difference.singleton_membership.backward with ⟨hg, same⟩
        exact union2.subset_left at (T ∖ {f}) ∪ {e}, {f}
          with g, (keep with g, inRest)
    intros u hu v hv
    have joinedBig := Joined.monotone with grow, (connected with u, hu, v, hv)
    exact Joined.drop_edge with newEnds, fEnds, joinedBig, bridged
  . have fresh : ¬e ∈ T ∖ {f}
      intro inRest
      exact outside with (restSubset with e, inRest)
    have inserted := cardinality.insert with restFinite, fresh
    have removed := cardinality.remove with finite, fInT
    have same : (T ∖ {f}) ∪ {e} = insert(e, T ∖ {f})
      unfold insert
      exact union2.commutative at T ∖ {f}, {e}
    rw [same, inserted, ← removed]
    exact count
