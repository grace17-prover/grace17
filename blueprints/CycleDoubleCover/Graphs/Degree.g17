-- Degrees of vertices in an edge set of a multigraph: the ends of edges at a
-- vertex, counted with a loop contributing both of its ends.
-- Part of the cycle double cover blueprint. Planned home: GraphTheory/Multigraph/Degree.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module CycleDoubleCover.Graphs.Degree
import EdgeSets
import Grace.Cumulus.GraphTheory.Multigraph

-- The ends of the edges of F at v: (e, 0) for the left end, (e, 1) for the right.
def incidentEnds (leftEnd rightEnd F v : Set) : Set :=
  { p ∈ F × 2 | (snd(p) = 0 ∧ leftEnd(fst(p)) = v) ∨ (snd(p) = 1 ∧ rightEnd(fst(p)) = v) }

def degreeIn (leftEnd rightEnd F v : Set) : Set := cardinality(incidentEnds(leftEnd, rightEnd, F, v))

-- A member of incidentEnds is a pair (e, i): e an edge of F and i the side
-- whose end is v.
theorem incidentEnds.pair (leftEnd rightEnd F v e i : Set)
  shows (e, i) ∈ incidentEnds(leftEnd, rightEnd, F, v) ↔
    e ∈ F ∧ ((i = 0 ∧ leftEnd(e) = v) ∨ (i = 1 ∧ rightEnd(e) = v))
proof
  have member := incidentEnds.membership at leftEnd, rightEnd, F, v, (e, i)
  rw [fst.pair, snd.pair] at member
  constructor
  . intro h
    have parts := member.forward with h
    have inProduct := product.membership.forward with parts.left
    obtain ⟨_, x, hx, y, hy, shape⟩ := inProduct
    obtain ⟨ex, iy⟩ := orderedPair.injective with shape
    have inF : e ∈ F
      rw ex
      exact hx
    exact ⟨inF, parts.right⟩
  . intro h
    rcases h with ⟨inF, side⟩
    have two := membership.two at i
    have inTwo : i ∈ 2
      apply two.backward
      rcases side with ⟨zero, _⟩ | ⟨one, _⟩
      . left
        exact zero
      . right
        exact one
    apply member.backward
    exact ⟨(product.pair with inF, inTwo), side⟩

theorem incidentEnds.shape (leftEnd rightEnd F v p : Set)
  requires member : p ∈ incidentEnds(leftEnd, rightEnd, F, v)
  shows ∃ e ∈ F, ∃ i ∈ 2, p = (e, i)
proof
  have parts := incidentEnds.membership.forward with member
  have inProduct := product.membership.forward with parts.left
  exact inProduct.right

theorem incidentEnds.subset_product (leftEnd rightEnd F v : Set)
  shows incidentEnds(leftEnd, rightEnd, F, v) ⊆ F × 2
proof
  intros p hp
  have parts := incidentEnds.membership.forward with hp
  exact parts.left

theorem incidentEnds.finite (leftEnd rightEnd F v : Set)
  requires finite : Finite(F)
  shows Finite(incidentEnds(leftEnd, rightEnd, F, v))
proof
  have product : Finite(F × 2) :=
    Finite.product with finite, (Finite.natural at 2)
  exact Finite.subset with product,
    (incidentEnds.subset_product at leftEnd, rightEnd, F, v)

theorem degreeIn.natural (leftEnd rightEnd F v : Set)
  requires finite : Finite(F)
  shows Nat(degreeIn(leftEnd, rightEnd, F, v))
proof
  have ends := incidentEnds.finite at leftEnd, rightEnd, F, v with finite
  unfold degreeIn
  exact cardinality.nat with ends

theorem degreeIn.empty (leftEnd rightEnd v : Set)
  shows degreeIn(leftEnd, rightEnd, ∅, v) = 0
proof
  have none : incidentEnds(leftEnd, rightEnd, ∅, v) = ∅
    apply Subset.antisymmetric
    . intros p hp
      obtain ⟨e, he, i, hi, shape⟩ := incidentEnds.shape with hp
      exfalso
      exact empty.membership at e with he
    . exact empty.subset at incidentEnds(leftEnd, rightEnd, ∅, v)
  -- unfold rewrites with the local equation none as it exposes the body.
  unfold degreeIn
  rw none
  exact cardinality.eq_of_has with HasCardinality.empty_set

-- The ends of a single edge e at v: e paired with each side whose end is v.
theorem incidentEnds.singleton (leftEnd rightEnd e v S : Set)
  requires sides : ∀ i, i ∈ S ↔
    ((i = 0 ∧ leftEnd(e) = v) ∨ (i = 1 ∧ rightEnd(e) = v))
  shows incidentEnds(leftEnd, rightEnd, {e}, v) = {e} × S
proof
  apply Subset.antisymmetric
  . intros p hp
    obtain ⟨x, hx, i, hi, rfl⟩ := incidentEnds.shape with hp
    have pairs := incidentEnds.pair at leftEnd, rightEnd, {e}, v, x, i
    have parts := pairs.forward with hp
    have same := singleton.membership.forward with hx
    rw same at parts
    have side := sides at i
    exact product.pair with hx, (side.backward with parts.right)
  . intros p hp
    have inProduct := product.membership.forward with hp
    obtain ⟨_, x, hx, i, hi, rfl⟩ := inProduct
    have same := singleton.membership.forward with hx
    rw same
    have pairs := incidentEnds.pair at leftEnd, rightEnd, {e}, v, e, i
    have side := sides at i
    have inS := side.forward with hi
    exact pairs.backward with ⟨(singleton.self at e), inS⟩

theorem degreeIn.singleton (leftEnd rightEnd e v S : Set)
  requires finite : Finite(S)
  requires sides : ∀ i, i ∈ S ↔
    ((i = 0 ∧ leftEnd(e) = v) ∨ (i = 1 ∧ rightEnd(e) = v))
  shows degreeIn(leftEnd, rightEnd, {e}, v) = cardinality(S)
proof
  have ends := incidentEnds.singleton at leftEnd, rightEnd, e, v, S with sides
  unfold degreeIn
  rw ends
  exact cardinality.singleton_product with finite

-- A loop contributes two ends at its vertex; any other edge one end at each of its ends.
theorem degreeIn.loop (leftEnd rightEnd e v : Set)
  requires left : leftEnd(e) = v
  requires right : rightEnd(e) = v
  shows degreeIn(leftEnd, rightEnd, {e}, v) = 2
proof
  have sides : ∀ i, i ∈ 2 ↔
      ((i = 0 ∧ leftEnd(e) = v) ∨ (i = 1 ∧ rightEnd(e) = v))
    intro i
    have two := membership.two at i
    tauto
  have count := degreeIn.singleton with (Finite.natural at 2), sides
  rw count
  exact cardinality.natural at 2

theorem degreeIn.end (leftEnd rightEnd e v : Set)
  requires distinct : leftEnd(e) ≠ rightEnd(e)
  requires end : leftEnd(e) = v ∨ rightEnd(e) = v
  shows degreeIn(leftEnd, rightEnd, {e}, v) = 1
proof
  cases end with atLeft | atRight
  . have notRight : rightEnd(e) ≠ v
      intro same
      apply distinct
      rw [atLeft, same]
      rfl
    have sides : ∀ i, i ∈ {0} ↔
        ((i = 0 ∧ leftEnd(e) = v) ∨ (i = 1 ∧ rightEnd(e) = v))
      intro i
      have single := singleton.membership at i, 0
      tauto
    have count := degreeIn.singleton with (Finite.singleton at 0), sides
    rw count
    exact cardinality.singleton at 0
  . have notLeft : leftEnd(e) ≠ v
      intro same
      apply distinct
      rw [atRight, same]
      rfl
    have sides : ∀ i, i ∈ {1} ↔
        ((i = 0 ∧ leftEnd(e) = v) ∨ (i = 1 ∧ rightEnd(e) = v))
      intro i
      have single := singleton.membership at i, 1
      tauto
    have count := degreeIn.singleton with (Finite.singleton at 1), sides
    rw count
    exact cardinality.singleton at 1

theorem degreeIn.absent (leftEnd rightEnd e v : Set)
  requires left : leftEnd(e) ≠ v
  requires right : rightEnd(e) ≠ v
  shows degreeIn(leftEnd, rightEnd, {e}, v) = 0
proof
  have sides : ∀ i, i ∈ ∅ ↔
      ((i = 0 ∧ leftEnd(e) = v) ∨ (i = 1 ∧ rightEnd(e) = v))
    intro i
    have none := empty.membership at i
    tauto
  have count := degreeIn.singleton with Finite.empty, sides
  rw count
  exact cardinality.eq_of_has with HasCardinality.empty_set

theorem incidentEnds.monotone (leftEnd rightEnd F G v : Set)
  requires subset : F ⊆ G
  shows incidentEnds(leftEnd, rightEnd, F, v) ⊆
    incidentEnds(leftEnd, rightEnd, G, v)
proof
  intros p hp
  obtain ⟨e, he, i, hi, rfl⟩ := incidentEnds.shape with hp
  have pairsF := incidentEnds.pair at leftEnd, rightEnd, F, v, e, i
  have pairsG := incidentEnds.pair at leftEnd, rightEnd, G, v, e, i
  have parts := pairsF.forward with hp
  exact pairsG.backward with ⟨(subset with e, parts.left), parts.right⟩

theorem incidentEnds.union_disjoint (leftEnd rightEnd F G v : Set)
  requires apart : Disjoint(F, G)
  shows incidentEnds(leftEnd, rightEnd, F ∪ G, v) =
    incidentEnds(leftEnd, rightEnd, F, v) ∪ incidentEnds(leftEnd, rightEnd, G, v) ∧
    Disjoint(incidentEnds(leftEnd, rightEnd, F, v), incidentEnds(leftEnd, rightEnd, G, v))
proof
  constructor
  . apply Subset.antisymmetric
    . intros p hp
      obtain ⟨e, he, i, hi, rfl⟩ := incidentEnds.shape with hp
      have pairs := incidentEnds.pair at leftEnd, rightEnd, F ∪ G, v, e, i
      have pairsF := incidentEnds.pair at leftEnd, rightEnd, F, v, e, i
      have pairsG := incidentEnds.pair at leftEnd, rightEnd, G, v, e, i
      have parts := pairs.forward with hp
      have split := union2.membership.forward with parts.left
      apply union2.membership.backward
      cases split with inF | inG
      . left
        exact pairsF.backward with ⟨inF, parts.right⟩
      . right
        exact pairsG.backward with ⟨inG, parts.right⟩
    . apply Subset.union2_iff.backward
      constructor
      . exact incidentEnds.monotone with (union2.subset_left at F, G)
      . exact incidentEnds.monotone with (union2.subset_right at F, G)
  . apply Disjoint.iff.backward
    intros p inF inG
    obtain ⟨e, he, i, hi, rfl⟩ := incidentEnds.shape with inF
    have pairsG := incidentEnds.pair at leftEnd, rightEnd, G, v, e, i
    have partsG := pairsG.forward with inG
    have absent := Disjoint.iff.forward with apart
    exact absent with e, he, partsG.left

theorem degreeIn.union_disjoint (leftEnd rightEnd F G v : Set)
  requires first : Finite(F)
  requires second : Finite(G)
  requires apart : Disjoint(F, G)
  shows degreeIn(leftEnd, rightEnd, F ∪ G, v) =
    degreeIn(leftEnd, rightEnd, F, v) + degreeIn(leftEnd, rightEnd, G, v)
proof
  have parts := incidentEnds.union_disjoint at leftEnd, rightEnd, F, G, v
    with apart
  have finiteF := incidentEnds.finite at leftEnd, rightEnd, F, v with first
  have finiteG := incidentEnds.finite at leftEnd, rightEnd, G, v with second
  have joined := parts.left
  unfold degreeIn
  rw joined
  exact cardinality.union_disjoint with finiteF, finiteG, parts.right

theorem degreeIn.monotone (leftEnd rightEnd F G v : Set)
  requires finite : Finite(G)
  requires subset : F ⊆ G
  shows degreeIn(leftEnd, rightEnd, F, v) ≤ degreeIn(leftEnd, rightEnd, G, v)
proof
  have finiteG := incidentEnds.finite at leftEnd, rightEnd, G, v with finite
  have ends := incidentEnds.monotone at leftEnd, rightEnd, F, G, v with subset
  -- under ≤, unfold opens one occurrence per step.
  unfold degreeIn
  exact cardinality.monotone with finiteG, ends

-- Taking ends is pointwise in the edge set, so it commutes with △.
theorem incidentEnds.symmetricDifference (leftEnd rightEnd F G v : Set)
  shows incidentEnds(leftEnd, rightEnd, F △ G, v) =
    incidentEnds(leftEnd, rightEnd, F, v) △
    incidentEnds(leftEnd, rightEnd, G, v)
proof
  ext p
  have both := symmetricDifference.membership at p,
    incidentEnds(leftEnd, rightEnd, F, v), incidentEnds(leftEnd, rightEnd, G, v)
  constructor
  . intro hp
    obtain ⟨e, he, i, hi, rfl⟩ := incidentEnds.shape with hp
    have pairs := incidentEnds.pair at leftEnd, rightEnd, F △ G, v, e, i
    have pairsF := incidentEnds.pair at leftEnd, rightEnd, F, v, e, i
    have pairsG := incidentEnds.pair at leftEnd, rightEnd, G, v, e, i
    have edge := symmetricDifference.membership at e, F, G
    tauto
  . intro hp
    have apart := both.forward with hp
    by_cases inF : p ∈ incidentEnds(leftEnd, rightEnd, F, v)
    . obtain ⟨e, he, i, hi, rfl⟩ := incidentEnds.shape with inF
      have pairs := incidentEnds.pair at leftEnd, rightEnd, F △ G, v, e, i
      have pairsF := incidentEnds.pair at leftEnd, rightEnd, F, v, e, i
      have pairsG := incidentEnds.pair at leftEnd, rightEnd, G, v, e, i
      have edge := symmetricDifference.membership at e, F, G
      tauto
    . have inG : p ∈ incidentEnds(leftEnd, rightEnd, G, v) by tauto
      obtain ⟨e, he, i, hi, rfl⟩ := incidentEnds.shape with inG
      have pairs := incidentEnds.pair at leftEnd, rightEnd, F △ G, v, e, i
      have pairsF := incidentEnds.pair at leftEnd, rightEnd, F, v, e, i
      have pairsG := incidentEnds.pair at leftEnd, rightEnd, G, v, e, i
      have edge := symmetricDifference.membership at e, F, G
      tauto

-- Degrees add modulo two under symmetric difference.
theorem degreeIn.symmetricDifference_parity (leftEnd rightEnd F G v : Set)
  requires first : Finite(F)
  requires second : Finite(G)
  shows Even(degreeIn(leftEnd, rightEnd, F △ G, v)) ↔
    (Even(degreeIn(leftEnd, rightEnd, F, v)) ↔ Even(degreeIn(leftEnd, rightEnd, G, v)))
proof
  have split := incidentEnds.symmetricDifference at leftEnd, rightEnd, F, G, v
  have finiteF := incidentEnds.finite at leftEnd, rightEnd, F, v with first
  have finiteG := incidentEnds.finite at leftEnd, rightEnd, G, v with second
  have parity := EvenSet.symmetricDifference with finiteF, finiteG
  -- unfold at a fact opens one occurrence per step; the fact has three.
  unfold EvenSet at parity
  unfold degreeIn
  rw split
  exact parity

-- The degree function of F on V, as the weight of a natural sum.
def degreeWeights (V leftEnd rightEnd F : Set) : Set :=
  { p ∈ V × ℕ | ∃ v ∈ V, p = (v, degreeIn(leftEnd, rightEnd, F, v)) }

theorem degreeWeights.function (V leftEnd rightEnd F : Set)
  requires finite : Finite(F)
  shows degreeWeights(V, leftEnd, rightEnd, F) : V → ℕ
proof
  constructor
  . intros p member
    have parts := degreeWeights.membership.forward with member
    exact parts.left
  . constructor
    . intros x y xy z xz
      unfold relates at xy
      have first := degreeWeights.membership.forward with xy
      obtain ⟨_, a, aInV, firstShape⟩ := first
      unfold relates at xz
      have second := degreeWeights.membership.forward with xz
      obtain ⟨_, b, bInV, secondShape⟩ := second
      obtain ⟨sameA, shapeY⟩ := orderedPair.injective with firstShape
      obtain ⟨sameB, shapeZ⟩ := orderedPair.injective with secondShape
      cc
    . intros x input
      have natural := degreeIn.natural at leftEnd, rightEnd, F, x with finite
      have member : degreeIn(leftEnd, rightEnd, F, x) ∈ ℕ :=
        nat.omega.forward with natural
      refine ⟨degreeIn(leftEnd, rightEnd, F, x), member, _⟩
      unfold relates
      apply degreeWeights.membership.backward
      exact ⟨(product.pair with input, member), x, input, rfl⟩

theorem degreeWeights.value (V leftEnd rightEnd F v : Set)
  requires finite : Finite(F)
  requires member : v ∈ V
  shows degreeWeights(V, leftEnd, rightEnd, F)(v) =
    degreeIn(leftEnd, rightEnd, F, v)
proof
  have function := degreeWeights.function at V, leftEnd, rightEnd, F with finite
  have natural := degreeIn.natural at leftEnd, rightEnd, F, v with finite
  have weight : degreeIn(leftEnd, rightEnd, F, v) ∈ ℕ :=
    nat.omega.forward with natural
  have related : relates(degreeWeights(V, leftEnd, rightEnd, F), v,
      degreeIn(leftEnd, rightEnd, F, v))
    unfold relates
    apply degreeWeights.membership.backward
    exact ⟨(product.pair with member, weight), v, member, rfl⟩
  exact FunctionBetween.apply_value with function, member, related

theorem degreeWeights.natural (V leftEnd rightEnd F : Set)
  requires finite : Finite(F)
  shows ∀ v ∈ V, degreeWeights(V, leftEnd, rightEnd, F)(v) ∈ ℕ
proof
  intros v hv
  have value := degreeWeights.value at V, leftEnd, rightEnd, F, v
    with finite, hv
  have natural := degreeIn.natural at leftEnd, rightEnd, F, v with finite
  rw value
  exact nat.omega.forward with natural

-- A sum of vanishing weights vanishes: no weighted pair exists.
theorem natSum.zero_weights (V w : Set)
  requires zero : ∀ v ∈ V, w(v) = 0
  shows natSum(V, w) = 0
proof
  have none : weightedPairs(V, w) = ∅
    apply Subset.antisymmetric
    . intros p hp
      have parts := weightedPairs.membership.forward with hp
      obtain ⟨v, hv, i, hi, _⟩ := parts.right
      have vanish := zero with v, hv
      rw [vanish, nat.zero] at hi
      exfalso
      exact empty.membership at i with hi
    . exact empty.subset at weightedPairs(V, w)
  unfold natSum
  rw none
  exact cardinality.eq_of_has with HasCardinality.empty_set

-- A sum may be restricted to a subset outside which the weights vanish.
theorem natSum.restrict (V S w : Set)
  requires finite : Finite(V)
  requires subset : S ⊆ V
  requires weights : ∀ v ∈ V, w(v) ∈ ℕ
  requires outside : ∀ v ∈ V ∖ S, w(v) = 0
  shows natSum(V, w) = natSum(S, w)
proof
  have finiteS := Finite.subset with finite, subset
  have restSubset := difference.subset_left at V, S
  have finiteRest := Finite.subset with finite, restSubset
  have weightsS : ∀ v ∈ S, w(v) ∈ ℕ
    intros v hv
    exact weights with v, (subset with v, hv)
  have weightsRest : ∀ v ∈ V ∖ S, w(v) ∈ ℕ
    intros v hv
    exact weights with v, (restSubset with v, hv)
  have apart : Disjoint(S, V ∖ S) := Disjoint.difference_right at V, S
  have cover : S ∪ (V ∖ S) = V := difference.union2_of_subset with subset
  have split := natSum.union_disjoint
    with finiteS, finiteRest, weightsS, weightsRest, apart
  have vanish := natSum.zero_weights at V ∖ S, w with outside
  have natural := natSum.natural with finiteS, weightsS
  have unit := add.right_unit at natSum(S, w)
  rw [cover, vanish, unit] at split
  exact split

-- One edge with both ends in V contributes two to the degree sum over V.
theorem degreeWeights.single_sum (V leftEnd rightEnd e : Set)
  requires finiteVertices : Finite(V)
  requires atLeft : leftEnd(e) ∈ V
  requires atRight : rightEnd(e) ∈ V
  shows natSum(V, degreeWeights(V, leftEnd, rightEnd, {e})) = 2
proof
  have finite : Finite({e}) := Finite.singleton at e
  have weights := degreeWeights.natural at V, leftEnd, rightEnd, {e} with finite
  have ends : {leftEnd(e), rightEnd(e)} ⊆ V
    intros x hx
    have split := pair.membership at leftEnd(e), rightEnd(e), x
    have alternatives := split.forward with hx
    cases alternatives with isLeft | isRight
    . rw isLeft
      exact atLeft
    . rw isRight
      exact atRight
  -- Away from the two ends of e the weight is zero.
  have outside : ∀ v ∈ V ∖ {leftEnd(e), rightEnd(e)},
      degreeWeights(V, leftEnd, rightEnd, {e})(v) = 0
    intros v hv
    have parts := difference.membership.forward with hv
    have value := degreeWeights.value at V, leftEnd, rightEnd, {e}, v
      with finite, parts.left
    have split := pair.membership at leftEnd(e), rightEnd(e), v
    rw value
    apply degreeIn.absent
    . intro same
      apply parts.right
      apply split.backward
      left
      symm
      exact same
    . intro same
      apply parts.right
      apply split.backward
      right
      symm
      exact same
  have restrict := natSum.restrict with finiteVertices, ends, weights, outside
  have valueLeft := degreeWeights.value at V, leftEnd, rightEnd, {e}, leftEnd(e)
    with finite, atLeft
  have valueRight := degreeWeights.value at V, leftEnd, rightEnd, {e},
    rightEnd(e) with finite, atRight
  rw restrict
  by_cases loop : leftEnd(e) = rightEnd(e)
  . -- A loop: both ends are one vertex, which carries weight two.
    have same : {leftEnd(e), rightEnd(e)} = {leftEnd(e)}
      ext x
      rw ← loop
      simp [pair.membership, singleton.membership]
    have single := natSum.singleton with (weights with leftEnd(e), atLeft)
    rw [same, single, valueLeft]
    have reflexive : leftEnd(e) = leftEnd(e) by rfl
    have symmetric : rightEnd(e) = leftEnd(e) by symm; exact loop
    exact degreeIn.loop with reflexive, symmetric
  . have both := natSum.pair with (weights with leftEnd(e), atLeft),
      (weights with rightEnd(e), atRight), loop
    rw [both, valueLeft, valueRight]
    have atLeftEnd : leftEnd(e) = leftEnd(e) ∨ rightEnd(e) = leftEnd(e)
      left
      rfl
    have atRightEnd : leftEnd(e) = rightEnd(e) ∨ rightEnd(e) = rightEnd(e)
      right
      rfl
    have oneLeft := degreeIn.end with loop, atLeftEnd
    have oneRight := degreeIn.end with loop, atRightEnd
    rw [oneLeft, oneRight]
    compute

-- Handshake by induction on the number of edges: removing an edge lowers
-- the degree sum by two.
theorem degreeIn.handshake_of_cardinality (V leftEnd rightEnd : Set, n : Nat)
  requires finiteVertices : Finite(V)
  shows ∀ F, Finite(F) → cardinality(F) = n →
    (∀ e ∈ F, leftEnd(e) ∈ V ∧ rightEnd(e) ∈ V) →
    natSum(V, degreeWeights(V, leftEnd, rightEnd, F)) = 2 * cardinality(F)
proof
  induction n
  | zero =>
    intros F finite size ends
    have has := cardinality.correct with finite
    rw size at has
    have empty := HasCardinality.empty_of_zero at F with has
    have zeroCard : cardinality(∅) = 0 :=
      cardinality.eq_of_has with HasCardinality.empty_set
    have vanish : ∀ v ∈ V, degreeWeights(V, leftEnd, rightEnd, ∅)(v) = 0
      intros v hv
      have value := degreeWeights.value at V, leftEnd, rightEnd, ∅, v
        with Finite.empty, hv
      rw value
      exact degreeIn.empty at leftEnd, rightEnd, v
    have sum := natSum.zero_weights with vanish
    rw [empty, sum, zeroCard]
    compute
  | succ(k) using ih =>
    intros F finite size ends
    have has := cardinality.correct with finite
    rw size at has
    obtain ⟨a, ha⟩ := HasCardinality.exists_member with has
    have removed := cardinality.remove with finite, ha
    rw size at removed
    have restSize : cardinality(F ∖ {a}) = k
      symm
      exact Naturals.injective.succ with removed
    have restSubset := difference.subset_left at F, {a}
    have restFinite := Finite.subset with finite, restSubset
    have restEnds : ∀ e ∈ F ∖ {a}, leftEnd(e) ∈ V ∧ rightEnd(e) ∈ V
      intros e he
      exact ends with e, (restSubset with e, he)
    have rest := ih with F ∖ {a}, restFinite, restSize, restEnds
    have endsA := ends with a, ha
    have single := degreeWeights.single_sum at V, leftEnd, rightEnd, a
      with finiteVertices, endsA.left, endsA.right
    have singleFinite : Finite({a}) := Finite.singleton at a
    have restore := insert.restore with ha
    unfold insert at restore
    have apart : Disjoint({a}, F ∖ {a}) := Disjoint.difference_right at F, {a}
    -- The degree at each vertex splits along F = {a} ∪ (F ∖ {a}).
    have pointwise : ∀ v ∈ V, degreeWeights(V, leftEnd, rightEnd, F)(v) =
        degreeWeights(V, leftEnd, rightEnd, F ∖ {a})(v) +
        degreeWeights(V, leftEnd, rightEnd, {a})(v)
      intros v hv
      have valueF := degreeWeights.value at V, leftEnd, rightEnd, F, v
        with finite, hv
      have valueRest := degreeWeights.value at V, leftEnd, rightEnd,
        F ∖ {a}, v with restFinite, hv
      have valueA := degreeWeights.value at V, leftEnd, rightEnd, {a}, v
        with singleFinite, hv
      have sum := degreeIn.union_disjoint at leftEnd, rightEnd, {a},
        F ∖ {a}, v with singleFinite, restFinite, apart
      have naturalRest := degreeIn.natural at leftEnd, rightEnd, F ∖ {a}, v
        with restFinite
      have naturalA := degreeIn.natural at leftEnd, rightEnd, {a}, v
        with singleFinite
      rw restore at sum
      have commute := add.commutative at degreeIn(leftEnd, rightEnd, {a}, v),
        degreeIn(leftEnd, rightEnd, F ∖ {a}, v)
      rw [valueF, valueRest, valueA, sum]
      cc
    have weightsRest := degreeWeights.natural at V, leftEnd, rightEnd, F ∖ {a}
      with restFinite
    have weightsA := degreeWeights.natural at V, leftEnd, rightEnd, {a}
      with singleFinite
    have sameSize : cardinality(V) = cardinality(V) by rfl
    have total := natSum.add_pointwise
      at degreeWeights(V, leftEnd, rightEnd, F),
        degreeWeights(V, leftEnd, rightEnd, F ∖ {a}),
        degreeWeights(V, leftEnd, rightEnd, {a}), cardinality(V)
      with V, finiteVertices, sameSize, weightsRest, weightsA, pointwise
    rw [total, rest, single, restSize, size]
    ring

-- Handshake: the degrees over V sum to twice the number of edges whose ends lie in V.
theorem degreeIn.handshake (V leftEnd rightEnd F : Set)
  requires finiteVertices : Finite(V)
  requires finite : Finite(F)
  requires ends : ∀ e ∈ F, leftEnd(e) ∈ V ∧ rightEnd(e) ∈ V
  shows natSum(V, degreeWeights(V, leftEnd, rightEnd, F)) = 2 * cardinality(F)
proof
  have size : cardinality(F) = cardinality(F) by rfl
  exact degreeIn.handshake_of_cardinality
    at V, leftEnd, rightEnd, cardinality(F)
    with finiteVertices, F, finite, size, ends
