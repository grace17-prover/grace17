-- Edge cuts of a multigraph: the edges with exactly one end in a vertex set,
-- edge-connectivity, and bridges. An even edge set crosses every cut an even
-- number of times, so a bridge lies in no even edge set.
-- Part of the cycle double cover blueprint. Planned home: GraphTheory/Multigraph/Cuts.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module CycleDoubleCover.Graphs.Cuts
import Even

def crossing (leftEnd rightEnd F X : Set) : Set :=
  { e ∈ F | (leftEnd(e) ∈ X ∧ ¬rightEnd(e) ∈ X) ∨ (rightEnd(e) ∈ X ∧ ¬leftEnd(e) ∈ X) }

-- At least k edges leave every nonempty proper vertex set.
predicate EdgeConnected (V E leftEnd rightEnd : Set, k : Nat) :=
  ∀ X, X ⊆ V → X ≠ ∅ → X ≠ V → k ≤ cardinality(crossing(leftEnd, rightEnd, E, X))

-- No vertex set is left by exactly one edge.
predicate Bridgeless (V E leftEnd rightEnd : Set) :=
  ∀ X, X ⊆ V → cardinality(crossing(leftEnd, rightEnd, E, X)) ≠ 1

theorem crossing.subset (leftEnd rightEnd F X : Set)
  shows crossing(leftEnd, rightEnd, F, X) ⊆ F
proof
  sorry

theorem crossing.monotone (leftEnd rightEnd F G X : Set)
  requires subset : F ⊆ G
  shows crossing(leftEnd, rightEnd, F, X) ⊆ crossing(leftEnd, rightEnd, G, X)
proof
  sorry

theorem crossing.complement (V leftEnd rightEnd F X : Set)
  requires ends : ∀ e ∈ F, leftEnd(e) ∈ V ∧ rightEnd(e) ∈ V
  shows crossing(leftEnd, rightEnd, F, V ∖ X) = crossing(leftEnd, rightEnd, F, X)
proof
  sorry

theorem crossing.finite (leftEnd rightEnd F X : Set)
  requires finite : Finite(F)
  shows Finite(crossing(leftEnd, rightEnd, F, X))
proof
  sorry

-- The cut parity: the number of edges of F leaving X has the parity of the
-- sum of the degrees of F over X, because an edge inside X contributes two
-- ends there and an edge outside none.
theorem crossing.parity (V leftEnd rightEnd F X : Set)
  requires finiteVertices : Finite(V)
  requires finite : Finite(F)
  requires subset : X ⊆ V
  requires ends : ∀ e ∈ F, leftEnd(e) ∈ V ∧ rightEnd(e) ∈ V
  shows Even(cardinality(crossing(leftEnd, rightEnd, F, X))) ↔
    Even(natSum(X, degreeWeights(X, leftEnd, rightEnd, F)))
proof
  sorry

theorem EvenEdgeSet.crossing_even (V leftEnd rightEnd F X : Set)
  requires finiteVertices : Finite(V)
  requires even : EvenEdgeSet(V, leftEnd, rightEnd, F)
  requires subset : X ⊆ V
  requires ends : ∀ e ∈ F, leftEnd(e) ∈ V ∧ rightEnd(e) ∈ V
  shows Even(cardinality(crossing(leftEnd, rightEnd, F, X)))
proof
  sorry

-- A bridge is an edge that alone leaves some vertex set; no even edge set
-- contains one. Conversely a cut of two edges is met by an even set in both
-- or neither.
theorem EvenEdgeSet.avoids_bridge (V E leftEnd rightEnd F X e : Set)
  requires finiteVertices : Finite(V)
  requires even : EvenEdgeSet(V, leftEnd, rightEnd, F)
  requires subset : X ⊆ V
  requires edges : F ⊆ E
  requires ends : ∀ e ∈ E, leftEnd(e) ∈ V ∧ rightEnd(e) ∈ V
  requires cut : crossing(leftEnd, rightEnd, E, X) = {e}
  shows ¬e ∈ F
proof
  sorry

theorem EvenEdgeSet.two_cut (V E leftEnd rightEnd F X e f : Set)
  requires finiteVertices : Finite(V)
  requires even : EvenEdgeSet(V, leftEnd, rightEnd, F)
  requires subset : X ⊆ V
  requires edges : F ⊆ E
  requires ends : ∀ e ∈ E, leftEnd(e) ∈ V ∧ rightEnd(e) ∈ V
  requires cut : crossing(leftEnd, rightEnd, E, X) = {e, f}
  requires distinct : e ≠ f
  shows e ∈ F ↔ f ∈ F
proof
  sorry

theorem EdgeConnected.bridgeless (V E leftEnd rightEnd : Set, k : Nat)
  requires two : 2 ≤ k
  requires connected : EdgeConnected(V, E, leftEnd, rightEnd, k)
  shows Bridgeless(V, E, leftEnd, rightEnd)
proof
  sorry

theorem EdgeConnected.monotone (V E leftEnd rightEnd : Set, k m : Nat)
  requires order : m ≤ k
  requires connected : EdgeConnected(V, E, leftEnd, rightEnd, k)
  shows EdgeConnected(V, E, leftEnd, rightEnd, m)
proof
  sorry
