-- Edge cuts of a multigraph: the edges with exactly one end in a vertex set,
-- edge-connectivity, and bridges. An even edge set crosses every cut an even
-- number of times, so a bridge lies in no even edge set.
-- Part of the cycle double cover blueprint.
-- Planned home: GraphTheory/Multigraph/Cuts.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module CycleDoubleCover.Graphs.Cuts
import Even

-- The edges of F with exactly one end in X.
def crossing (leftEnd rightEnd F X : Set) : Set :=
  { e ∈ F | (leftEnd(e) ∈ X ∧ rightEnd(e) ∉ X) ∨
            (rightEnd(e) ∈ X ∧ leftEnd(e) ∉ X) }

-- At least k edges leave every nonempty proper vertex set.
predicate EdgeConnected (V E leftEnd rightEnd : Set, k : Nat) :=
  ∀ X ⊆ V, X ≠ ∅ → X ≠ V →
    k ≤ cardinality(crossing(leftEnd, rightEnd, E, X))

-- No vertex set is left by exactly one edge.
predicate Bridgeless (V E leftEnd rightEnd : Set) :=
  ∀ X ⊆ V, cardinality(crossing(leftEnd, rightEnd, E, X)) ≠ 1

theorem crossing.subset (leftEnd rightEnd F X : Set)
  shows crossing(leftEnd, rightEnd, F, X) ⊆ F
proof
  intros e he
  have parts := crossing.membership.forward with he
  exact parts.left

theorem crossing.finite (leftEnd rightEnd F X : Set)
  requires finite : Finite(F)
  shows Finite(crossing(leftEnd, rightEnd, F, X))
proof
  exact Finite.subset with finite, (crossing.subset at leftEnd, rightEnd, F, X)

theorem crossing.monotone (leftEnd rightEnd F G X : Set)
  requires subset : F ⊆ G
  shows crossing(leftEnd, rightEnd, F, X) ⊆ crossing(leftEnd, rightEnd, G, X)
proof
  intros e he
  have parts := crossing.membership.forward with he
  have inG := subset with e, parts.left
  exact crossing.membership.backward with ⟨inG, parts.right⟩

-- The cut of a subset of the edges is the restriction of the larger cut.
theorem crossing.restrict (leftEnd rightEnd E F X : Set)
  requires edges : F ⊆ E
  shows crossing(leftEnd, rightEnd, F, X) =
    crossing(leftEnd, rightEnd, E, X) ∩ F
proof
  ext e
  by_cases inF : e ∈ F
  . have inE := edges with e, inF
    simp [crossing.membership, inF, inE]
  . simp [crossing.membership, inF]

-- A vertex set and its complement are left by the same edges.
theorem crossing.complement (V leftEnd rightEnd F X : Set)
  requires ends : ∀ e ∈ F, leftEnd(e) ∈ V ∧ rightEnd(e) ∈ V
  shows crossing(leftEnd, rightEnd, F, V ∖ X) =
    crossing(leftEnd, rightEnd, F, X)
proof
  ext e
  by_cases inF : e ∈ F
  . obtain ⟨leftV, rightV⟩ := ends with e, inF
    simp [crossing.membership, difference.membership]
  . simp [crossing.membership]

-- The empty set and the whole vertex set are left by no edge.
theorem crossing.trivial (V leftEnd rightEnd F X : Set)
  requires ends : ∀ e ∈ F, leftEnd(e) ∈ V ∧ rightEnd(e) ∈ V
  requires trivial : X = ∅ ∨ X = V
  shows crossing(leftEnd, rightEnd, F, X) = ∅
proof
  apply Subset.antisymmetric
  . intros e member
    obtain ⟨edge, sides⟩ := crossing.membership.forward with member
    have inV := ends with e, edge
    exfalso
    rcases trivial with rfl | rfl
    . simp [set.empty]
    . tauto
  . exact empty.subset at crossing(leftEnd, rightEnd, F, X)

-- A single edge contributes one end at each of its ends, two at a loop.
theorem degreeIn.singleton_indicators (leftEnd rightEnd e v : Set)
  shows degreeIn(leftEnd, rightEnd, {e}, v) =
    indicator({leftEnd(e)}, v) + indicator({rightEnd(e)}, v)
proof
  by_cases atLeft : leftEnd(e) = v
  . rw [atLeft, indicator.singleton_self]
    by_cases atRight : rightEnd(e) = v
    . rw [atRight, indicator.singleton_self]
      rw degreeIn.loop with atLeft, atRight
      compute
    . have distinct : leftEnd(e) ≠ rightEnd(e) by intro same; cc
      have atEnd : leftEnd(e) = v ∨ rightEnd(e) = v by tauto
      rw indicator.singleton_other with atRight
      rw degreeIn.end with distinct, atEnd
      compute
  . rw indicator.singleton_other with atLeft
    by_cases atRight : rightEnd(e) = v
    . rw [atRight, indicator.singleton_self]
      have distinct : leftEnd(e) ≠ rightEnd(e) by intro same; cc
      have atEnd : leftEnd(e) = v ∨ rightEnd(e) = v by tauto
      rw degreeIn.end with distinct, atEnd
      compute
    . rw indicator.singleton_other with atRight
      rw degreeIn.absent with atLeft, atRight
      compute

-- The degrees of a single edge over X sum to the number of its ends in X.
theorem natSum.single_edge (X leftEnd rightEnd e : Set)
  requires finite : Finite(X)
  shows natSum(X, degreeWeights(X, leftEnd, rightEnd, {e})) =
    indicator(X, leftEnd(e)) + indicator(X, rightEnd(e))
proof
  have finiteE := Finite.singleton at e
  have leftWeights : ∀ v ∈ X, indicatorMap({leftEnd(e)}, X)(v) ∈ ℕ
    intros v hv
    rw indicatorMap.value at {leftEnd(e)}, X, v with hv
    exact indicatorMap.closed at {leftEnd(e)}, X, v with hv
  have rightWeights : ∀ v ∈ X, indicatorMap({rightEnd(e)}, X)(v) ∈ ℕ
    intros v hv
    rw indicatorMap.value at {rightEnd(e)}, X, v with hv
    exact indicatorMap.closed at {rightEnd(e)}, X, v with hv
  -- Pointwise, the degree of {e} is the sum of the two indicators.
  have agree : ∀ v ∈ X, degreeWeights(X, leftEnd, rightEnd, {e})(v) =
      indicatorMap({leftEnd(e)}, X)(v) + indicatorMap({rightEnd(e)}, X)(v)
    intros v hv
    rw degreeWeights.value at X, leftEnd, rightEnd, {e}, v with finiteE, hv
    rw indicatorMap.value at {leftEnd(e)}, X, v with hv
    rw indicatorMap.value at {rightEnd(e)}, X, v with hv
    exact degreeIn.singleton_indicators at leftEnd, rightEnd, e, v
  have split := natSum.add_pointwise
    at X, degreeWeights(X, leftEnd, rightEnd, {e}),
      indicatorMap({leftEnd(e)}, X), indicatorMap({rightEnd(e)}, X)
    with finite, leftWeights, rightWeights, agree
  have leftSum := natSum.indicator at X, {leftEnd(e)} with finite
  have rightSum := natSum.indicator at X, {rightEnd(e)} with finite
  rw [split, leftSum, rightSum]
  rw [cardinality.intersection_singleton, cardinality.intersection_singleton]
  rfl

-- The number of ends of an edge of F that lie in X, as a weight on F.
defgraph endsIn (X leftEnd rightEnd F : Set) (e ∈ F) : ℕ :=
  indicator(X, leftEnd(e)) + indicator(X, rightEnd(e))
proof
  have left := indicator.natural at X, leftEnd(e)
  have right := indicator.natural at X, rightEnd(e)
  have sum : Nat(indicator(X, leftEnd(e)) + indicator(X, rightEnd(e)))
    typecheck
  exact nat.omega.forward with sum

theorem endsIn.natural (X leftEnd rightEnd F e : Set)
  requires member : e ∈ F
  shows endsIn(X, leftEnd, rightEnd, F)(e) ∈ ℕ
proof
  rw endsIn.value at X, leftEnd, rightEnd, F, e with member
  exact endsIn.closed at X, leftEnd, rightEnd, F, e with member

-- An edge has zero, one, or two ends in X.
theorem endsIn.cases (X leftEnd rightEnd F e : Set)
  requires member : e ∈ F
  shows endsIn(X, leftEnd, rightEnd, F)(e) = 0 ∨
    endsIn(X, leftEnd, rightEnd, F)(e) = 1 ∨
    endsIn(X, leftEnd, rightEnd, F)(e) = 2
proof
  rw endsIn.value at X, leftEnd, rightEnd, F, e with member
  by_cases inLeft : leftEnd(e) ∈ X
  . rw indicator.member with inLeft
    by_cases inRight : rightEnd(e) ∈ X
    . rw indicator.member with inRight
      right; right; compute
    . rw indicator.absent with inRight
      right; left; compute
  . rw indicator.absent with inLeft
    by_cases inRight : rightEnd(e) ∈ X
    . rw indicator.member with inRight
      right; left; compute
    . rw indicator.absent with inRight
      left; compute

-- An edge has exactly one end in X precisely when it crosses the cut.
theorem endsIn.one_iff (X leftEnd rightEnd F e : Set)
  requires member : e ∈ F
  shows endsIn(X, leftEnd, rightEnd, F)(e) = 1 ↔
    (leftEnd(e) ∈ X ∧ rightEnd(e) ∉ X) ∨
    (rightEnd(e) ∈ X ∧ leftEnd(e) ∉ X)
proof
  rw endsIn.value at X, leftEnd, rightEnd, F, e with member
  by_cases inLeft : leftEnd(e) ∈ X
  . rw indicator.member with inLeft
    by_cases inRight : rightEnd(e) ∈ X
    . rw indicator.member with inRight
      have two : 1 + 1 ≠ 1 by arith
      tauto
    . rw indicator.absent with inRight
      have one : 1 + 0 = 1 by compute
      tauto
  . rw indicator.absent with inLeft
    by_cases inRight : rightEnd(e) ∈ X
    . rw indicator.member with inRight
      have one : 0 + 1 = 1 by compute
      tauto
    . rw indicator.absent with inRight
      have zero : 0 + 0 ≠ 1 by arith
      tauto

-- Exchanging the order of summation: the degrees over X sum to the number of
-- edge ends in X, counted edge by edge. By induction on the edge set.
theorem natSum.degrees_count_ends (X leftEnd rightEnd : Set, n : Nat)
  shows ∀ F, Finite(F) → cardinality(F) = n → Finite(X) →
    natSum(X, degreeWeights(X, leftEnd, rightEnd, F)) =
    natSum(F, endsIn(X, leftEnd, rightEnd, F))
proof
  induction n
  | zero =>
    intros F finite size finiteX
    have has := cardinality.correct with finite
    rw size at has
    have empty := HasCardinality.empty_of_zero at F with has
    have vanish : ∀ v ∈ X, degreeWeights(X, leftEnd, rightEnd, ∅)(v) = 0
      intros v hv
      rw degreeWeights.value at X, leftEnd, rightEnd, ∅, v
        with Finite.empty, hv
      exact degreeIn.empty at leftEnd, rightEnd, v
    rw [empty, natSum.empty]
    exact NaturalSumLaws.natSum.zero_weights with vanish
  | succ(k) using ih =>
    intros F finite size finiteX
    have has := cardinality.correct with finite
    rw size at has
    obtain ⟨a, ha⟩ := HasCardinality.exists_member with has
    have restSubset := difference.subset_left at F, {a}
    have restFinite := Finite.subset with finite, restSubset
    have restSize : cardinality(F ∖ {a}) = k
      have removed := cardinality.remove with finite, ha
      rw size at removed
      symm
      exact Naturals.injective.succ with removed
    have rest := ih with F ∖ {a}, restFinite, restSize, finiteX
    have finiteA := Finite.singleton at a
    have restore : insert(a, F ∖ {a}) = F := insert.restore with ha
    have cover : (F ∖ {a}) ∪ {a} = F
      ext y
      simp
    have apart := Disjoint.difference_left at F, {a}
    have fresh : a ∉ F ∖ {a} by simp
    -- Over the vertices: the degree in F is the degree in F ∖ {a} plus the
    -- degree in {a}.
    have agree : ∀ v ∈ X, degreeWeights(X, leftEnd, rightEnd, F)(v) =
        degreeWeights(X, leftEnd, rightEnd, F ∖ {a})(v) +
        degreeWeights(X, leftEnd, rightEnd, {a})(v)
      intros v hv
      have sum := degreeIn.union_disjoint at leftEnd, rightEnd, F ∖ {a},
        {a}, v with restFinite, finiteA, apart
      rw cover at sum
      rw degreeWeights.value at X, leftEnd, rightEnd, F, v with finite, hv
      rw degreeWeights.value at X, leftEnd, rightEnd, F ∖ {a}, v
        with restFinite, hv
      rw degreeWeights.value at X, leftEnd, rightEnd, {a}, v with finiteA, hv
      exact sum
    have restWeights := degreeWeights.natural at X, leftEnd, rightEnd, F ∖ {a}
      with restFinite
    have singleWeights := degreeWeights.natural at X, leftEnd, rightEnd, {a}
      with finiteA
    have split := natSum.add_pointwise
      at X, degreeWeights(X, leftEnd, rightEnd, F),
        degreeWeights(X, leftEnd, rightEnd, F ∖ {a}),
        degreeWeights(X, leftEnd, rightEnd, {a})
      with finiteX, restWeights, singleWeights, agree
    have single := natSum.single_edge at X, leftEnd, rightEnd, a with finiteX
    -- Over the edges: the sum over F is the sum over F ∖ {a} plus the ends of
    -- a in X, and the weight of an edge does not depend on the edge set.
    have endWeights : ∀ e ∈ F ∖ {a},
        endsIn(X, leftEnd, rightEnd, F)(e) ∈ ℕ
      intros e he
      exact endsIn.natural at X, leftEnd, rightEnd, F, e
        with (restSubset with e, he)
    have endWeightA := endsIn.natural at X, leftEnd, rightEnd, F, a with ha
    have inserted := natSum.insert
      at F ∖ {a}, endsIn(X, leftEnd, rightEnd, F), a
      with restFinite, endWeights, endWeightA, fresh
    rw restore at inserted
    have agreeEnds : ∀ e ∈ F ∖ {a}, endsIn(X, leftEnd, rightEnd, F)(e) =
        endsIn(X, leftEnd, rightEnd, F ∖ {a})(e)
      intros e he
      rw endsIn.value at X, leftEnd, rightEnd, F, e with (restSubset with e, he)
      rw endsIn.value at X, leftEnd, rightEnd, F ∖ {a}, e with he
      rfl
    have restEnds := natSum.congr at F ∖ {a}, endsIn(X, leftEnd, rightEnd, F),
      endsIn(X, leftEnd, rightEnd, F ∖ {a}) with agreeEnds
    rw endsIn.value at X, leftEnd, rightEnd, F, a with ha at inserted
    rw [split, single, inserted, restEnds, rest]
    rfl

-- The cut parity: the number of edges of F leaving X has the parity of the
-- sum of the degrees of F over X, because an edge inside X contributes two
-- ends there and an edge outside none.
theorem crossing.parity (leftEnd rightEnd F X : Set)
  requires finiteX : Finite(X)
  requires finite : Finite(F)
  shows Even(cardinality(crossing(leftEnd, rightEnd, F, X))) ↔
    Even(natSum(X, degreeWeights(X, leftEnd, rightEnd, F)))
proof
  have size : cardinality(F) = cardinality(F) by rfl
  have exchange := natSum.degrees_count_ends at X, leftEnd, rightEnd,
    cardinality(F) with F, finite, size, finiteX
  have weights : ∀ e ∈ F, endsIn(X, leftEnd, rightEnd, F)(e) = 0 ∨
      endsIn(X, leftEnd, rightEnd, F)(e) = 1 ∨
      endsIn(X, leftEnd, rightEnd, F)(e) = 2
    intros e he
    exact endsIn.cases with he
  have parity := natSum.parity at F, endsIn(X, leftEnd, rightEnd, F)
    with finite, weights
  -- The edges with exactly one end in X are the crossing edges.
  have same : ones(F, endsIn(X, leftEnd, rightEnd, F)) =
      crossing(leftEnd, rightEnd, F, X)
    ext e
    by_cases he : e ∈ F
    . have one := endsIn.one_iff at X, leftEnd, rightEnd, F, e with he
      simp [ones.membership, crossing.membership, he, one]
    . simp [ones.membership, crossing.membership, he]
  rw [exchange, ← same]
  tauto

theorem EvenEdgeSet.crossing_even (V leftEnd rightEnd F X : Set)
  requires finiteVertices : Finite(V)
  requires even : EvenEdgeSet(V, leftEnd, rightEnd, F)
  requires subset : X ⊆ V
  shows Even(cardinality(crossing(leftEnd, rightEnd, F, X)))
proof
  have finiteF := even.left
  have finiteX := Finite.subset with finiteVertices, subset
  have parity := crossing.parity at leftEnd, rightEnd, F, X
    with finiteX, finiteF
  -- The degrees over X are even, so their sum is.
  have evens : ∀ v ∈ X, Even(degreeWeights(X, leftEnd, rightEnd, F)(v))
    intros v hv
    rw degreeWeights.value at X, leftEnd, rightEnd, F, v with finiteF, hv
    exact even.right with v, (subset with v, hv)
  have weights := degreeWeights.natural at X, leftEnd, rightEnd, F with finiteF
  apply parity.backward
  exact natSum.even_of_even_weights at X, degreeWeights(X, leftEnd, rightEnd, F)
    with finiteX, weights, evens

-- An even edge set never meets a cut in exactly one edge.
theorem EvenEdgeSet.crossing_ne_singleton (V leftEnd rightEnd F X g : Set)
  requires finiteVertices : Finite(V)
  requires even : EvenEdgeSet(V, leftEnd, rightEnd, F)
  requires subset : X ⊆ V
  shows crossing(leftEnd, rightEnd, F, X) ≠ {g}
proof
  intro single
  have evenCount := EvenEdgeSet.crossing_even
    with finiteVertices, even, subset
  rw [single, cardinality.singleton] at evenCount
  exact Even.not_one with evenCount

-- A bridge is an edge that alone leaves some vertex set; no even edge set
-- contains one.
theorem EvenEdgeSet.avoids_bridge (V E leftEnd rightEnd F X e : Set)
  requires finiteVertices : Finite(V)
  requires even : EvenEdgeSet(V, leftEnd, rightEnd, F)
  requires subset : X ⊆ V
  requires edges : F ⊆ E
  requires ends : ∀ e ∈ E, leftEnd(e) ∈ V ∧ rightEnd(e) ∈ V
  requires cut : crossing(leftEnd, rightEnd, E, X) = {e}
  shows e ∉ F
proof
  intro inF
  have single : crossing(leftEnd, rightEnd, F, X) = {e}
    rw crossing.restrict at leftEnd, rightEnd, E, F, X with edges
    rw cut
    ext g
    simp [inF]
  exact EvenEdgeSet.crossing_ne_singleton
    with finiteVertices, even, subset, single

-- If exactly one edge of a two-edge cut lies in F, that edge alone leaves X
-- within F.
theorem crossing.restrict_pair (leftEnd rightEnd E F X e f : Set)
  requires edges : F ⊆ E
  requires cut : crossing(leftEnd, rightEnd, E, X) = {e, f}
  requires inside : e ∈ F
  requires outside : f ∉ F
  shows crossing(leftEnd, rightEnd, F, X) = {e}
proof
  rw crossing.restrict at leftEnd, rightEnd, E, F, X with edges
  rw cut
  ext g
  by_cases ge : g = e
  . simp [ge, inside]
  . by_cases gf : g = f
    . simp [gf, outside]
    . simp [ge, gf]

-- A cut of two edges is met by an even set in both or neither.
theorem EvenEdgeSet.two_cut (V E leftEnd rightEnd F X e f : Set)
  requires finiteVertices : Finite(V)
  requires even : EvenEdgeSet(V, leftEnd, rightEnd, F)
  requires subset : X ⊆ V
  requires edges : F ⊆ E
  requires ends : ∀ e ∈ E, leftEnd(e) ∈ V ∧ rightEnd(e) ∈ V
  requires cut : crossing(leftEnd, rightEnd, E, X) = {e, f}
  requires distinct : e ≠ f
  shows e ∈ F ↔ f ∈ F
proof
  have swapped : crossing(leftEnd, rightEnd, E, X) = {f, e}
    rw cut
    exact pair.commutative at e, f
  constructor
  . intro eIn
    by_contra fOut
    have single := crossing.restrict_pair with edges, cut, eIn, fOut
    exact EvenEdgeSet.crossing_ne_singleton
      with finiteVertices, even, subset, single
  . intro fIn
    by_contra eOut
    have single := crossing.restrict_pair with edges, swapped, fIn, eOut
    exact EvenEdgeSet.crossing_ne_singleton
      with finiteVertices, even, subset, single

theorem EdgeConnected.bridgeless (V E leftEnd rightEnd : Set, k : Nat)
  requires two : 2 ≤ k
  requires ends : ∀ e ∈ E, leftEnd(e) ∈ V ∧ rightEnd(e) ∈ V
  requires connected : EdgeConnected(V, E, leftEnd, rightEnd, k)
  shows Bridgeless(V, E, leftEnd, rightEnd)
proof
  intros X bound
  by_cases trivial : X = ∅ ∨ X = V
  . have none := crossing.trivial with ends, trivial
    rw [none, cardinality.empty]
    arith
  . have nonempty : X ≠ ∅ by tauto
    have proper : X ≠ V by tauto
    have many := connected with X, bound, nonempty, proper
    arith

theorem EdgeConnected.monotone (V E leftEnd rightEnd : Set, k m : Nat)
  requires order : m ≤ k
  requires connected : EdgeConnected(V, E, leftEnd, rightEnd, k)
  shows EdgeConnected(V, E, leftEnd, rightEnd, m)
proof
  intros X bound nonempty proper
  have above := connected with X, bound, nonempty, proper
  -- The bound itself shows that the size of the cut is a natural number.
  have natural := LessEqual.natural_right with above
  linarith
