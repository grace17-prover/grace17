-- Edge cuts of a multigraph: the edges with exactly one end in a vertex set,
-- edge-connectivity, and bridges. An even edge set crosses every cut an even
-- number of times, so a bridge lies in no even edge set.
-- Part of the cycle double cover blueprint. Planned home: GraphTheory/Multigraph/Cuts.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module CycleDoubleCover.Graphs.Cuts
import Even

def crossing (leftEnd rightEnd F X : Set) : Set :=
  { e ∈ F | (leftEnd(e) ∈ X ∧ ¬rightEnd(e) ∈ X) ∨ (rightEnd(e) ∈ X ∧ ¬leftEnd(e) ∈ X) }

-- At least k edges leave every nonempty proper vertex set.
predicate EdgeConnected (V E leftEnd rightEnd : Set, k : Nat) :=
  ∀ X ⊆ V, X ≠ ∅ → X ≠ V → k ≤ cardinality(crossing(leftEnd, rightEnd, E, X))

-- No vertex set is left by exactly one edge.
predicate Bridgeless (V E leftEnd rightEnd : Set) :=
  ∀ X ⊆ V, cardinality(crossing(leftEnd, rightEnd, E, X)) ≠ 1

theorem crossing.subset (leftEnd rightEnd F X : Set)
  shows crossing(leftEnd, rightEnd, F, X) ⊆ F
proof
  intros e he
  have parts := crossing.membership.forward with he
  exact parts.left

theorem crossing.monotone (leftEnd rightEnd F G X : Set)
  requires subset : F ⊆ G
  shows crossing(leftEnd, rightEnd, F, X) ⊆ crossing(leftEnd, rightEnd, G, X)
proof
  intros e he
  have parts := crossing.membership.forward with he
  have inG := subset with e, parts.left
  exact crossing.membership.backward with ⟨inG, parts.right⟩

theorem crossing.complement (V leftEnd rightEnd F X : Set)
  requires ends : ∀ e ∈ F, leftEnd(e) ∈ V ∧ rightEnd(e) ∈ V
  shows crossing(leftEnd, rightEnd, F, V ∖ X) = crossing(leftEnd, rightEnd, F, X)
proof
  ext e
  by_cases inF : e ∈ F
  . have endsE := ends with e, inF
    have leftV := endsE.left
    have rightV := endsE.right
    simp [crossing.membership, difference.membership]
  . simp [crossing.membership]

theorem crossing.finite (leftEnd rightEnd F X : Set)
  requires finite : Finite(F)
  shows Finite(crossing(leftEnd, rightEnd, F, X))
proof
  exact Finite.subset with finite, (crossing.subset at leftEnd, rightEnd, F, X)

-- The degree weights relate each vertex of V to its degree in F.
theorem degreeWeights.relates (V leftEnd rightEnd F v : Set)
  requires finite : Finite(F)
  requires member : v ∈ V
  shows relates(degreeWeights(V, leftEnd, rightEnd, F), v,
    degreeIn(leftEnd, rightEnd, F, v))
proof
  have natural := degreeIn.natural at leftEnd, rightEnd, F, v with finite
  have inNat := nat.omega.forward with natural
  unfold relates
  apply degreeWeights.membership.backward
  constructor
  . exact product.pair with member, inNat
  . witness v
    constructor
    . exact member
    . rfl

theorem degreeWeights.function_between (V leftEnd rightEnd F : Set)
  requires finite : Finite(F)
  shows degreeWeights(V, leftEnd, rightEnd, F) : V → ℕ
proof
  refine ⟨?_, ?_, ?_⟩
  . unfold RelationBetween
    intros p hp
    have parts := degreeWeights.membership.forward with hp
    exact parts.left
  . intros x y hxy z hxz
    unfold relates at hxy
    unfold relates at hxz
    have partsY := degreeWeights.membership.forward with hxy
    have partsZ := degreeWeights.membership.forward with hxz
    obtain ⟨u, hu, shapeY⟩ := partsY.right
    obtain ⟨t, ht, shapeZ⟩ := partsZ.right
    obtain ⟨xu, yu⟩ := orderedPair.injective with shapeY
    obtain ⟨xt, zt⟩ := orderedPair.injective with shapeZ
    cc
  . intros x hx
    witness degreeIn(leftEnd, rightEnd, F, x)
    have natural := degreeIn.natural at leftEnd, rightEnd, F, x with finite
    constructor
    . exact nat.omega.forward with natural
    . exact degreeWeights.relates at V, leftEnd, rightEnd, F, x with finite, hx

theorem degreeWeights.at_vertex (V leftEnd rightEnd F v : Set)
  requires finite : Finite(F)
  requires member : v ∈ V
  shows degreeWeights(V, leftEnd, rightEnd, F)(v) =
    degreeIn(leftEnd, rightEnd, F, v)
proof
  have function := degreeWeights.function_between at V, leftEnd, rightEnd, F
    with finite
  have related := degreeWeights.relates at V, leftEnd, rightEnd, F, v
    with finite, member
  exact FunctionBetween.apply_value with function, member, related

theorem degreeWeights.naturals (V leftEnd rightEnd F : Set)
  requires finite : Finite(F)
  shows ∀ v ∈ V, degreeWeights(V, leftEnd, rightEnd, F)(v) ∈ ℕ
proof
  intros v hv
  have function := degreeWeights.function_between at V, leftEnd, rightEnd, F
    with finite
  exact FunctionBetween.apply_closed with function, hv

-- A single edge contributes one end at each of its ends, two at a loop.
theorem degreeIn.singleton_indicators (leftEnd rightEnd e v : Set)
  shows degreeIn(leftEnd, rightEnd, {e}, v) =
    indicator({leftEnd(e)}, v) + indicator({rightEnd(e)}, v)
proof
  by_cases atLeft : leftEnd(e) = v
  . have leftOne : indicator({leftEnd(e)}, v) = 1
      rw atLeft
      exact indicator.singleton_self at v
    by_cases atRight : rightEnd(e) = v
    . have rightOne : indicator({rightEnd(e)}, v) = 1
        rw atRight
        exact indicator.singleton_self at v
      have two := degreeIn.loop at leftEnd, rightEnd, e, v with atLeft, atRight
      rw [two, leftOne, rightOne]
      compute
    . have rightZero := indicator.singleton_other at rightEnd(e), v with atRight
      have distinct : leftEnd(e) ≠ rightEnd(e)
        intro same
        apply atRight
        rw ← same
        exact atLeft
      have atEnd : leftEnd(e) = v ∨ rightEnd(e) = v
        left
        exact atLeft
      have one := degreeIn.end at leftEnd, rightEnd, e, v with distinct, atEnd
      rw [one, leftOne, rightZero]
      compute
  . have leftZero := indicator.singleton_other at leftEnd(e), v with atLeft
    by_cases atRight : rightEnd(e) = v
    . have rightOne : indicator({rightEnd(e)}, v) = 1
        rw atRight
        exact indicator.singleton_self at v
      have distinct : leftEnd(e) ≠ rightEnd(e)
        intro same
        apply atLeft
        rw same
        exact atRight
      have atEnd : leftEnd(e) = v ∨ rightEnd(e) = v
        right
        exact atRight
      have one := degreeIn.end at leftEnd, rightEnd, e, v with distinct, atEnd
      rw [one, leftZero, rightOne]
      compute
    . have rightZero := indicator.singleton_other at rightEnd(e), v with atRight
      have zero := degreeIn.absent at leftEnd, rightEnd, e, v
        with atLeft, atRight
      rw [zero, leftZero, rightZero]
      compute

theorem cardinality.intersection_singleton (X a : Set)
  shows cardinality(X ∩ {a}) = indicator(X, a)
proof
  by_cases member : a ∈ X
  . have same : X ∩ {a} = {a}
      ext y
      simp
    have one := indicator.member at X, a with member
    rw [same, cardinality.singleton, one]
    rfl
  . have same : X ∩ {a} = ∅
      ext y
      simp
    have zero := indicator.absent at X, a with member
    rw [same, zero, ← nat.zero]
    exact cardinality.natural

-- The degrees of a single edge over X sum to the number of its ends in X.
theorem natSum.single_edge (X leftEnd rightEnd e : Set)
  requires finite : Finite(X)
  shows natSum(X, degreeWeights(X, leftEnd, rightEnd, {e})) =
    indicator(X, leftEnd(e)) + indicator(X, rightEnd(e))
proof
  have finiteE := Finite.singleton at e
  have size : cardinality(X) = cardinality(X) by rfl
  have leftWeights : ∀ v ∈ X, indicatorMap({leftEnd(e)}, X)(v) ∈ ℕ
    intros v hv
    have value := indicatorMap.value at {leftEnd(e)}, X, v with hv
    rw value
    exact indicatorMap.closed at {leftEnd(e)}, X, v with hv
  have rightWeights : ∀ v ∈ X, indicatorMap({rightEnd(e)}, X)(v) ∈ ℕ
    intros v hv
    have value := indicatorMap.value at {rightEnd(e)}, X, v with hv
    rw value
    exact indicatorMap.closed at {rightEnd(e)}, X, v with hv
  have agree : ∀ v ∈ X, degreeWeights(X, leftEnd, rightEnd, {e})(v) =
      indicatorMap({leftEnd(e)}, X)(v) + indicatorMap({rightEnd(e)}, X)(v)
    intros v hv
    have degree := degreeWeights.at_vertex at X, leftEnd, rightEnd, {e}, v
      with finiteE, hv
    have leftValue := indicatorMap.value at {leftEnd(e)}, X, v with hv
    have rightValue := indicatorMap.value at {rightEnd(e)}, X, v with hv
    rw [degree, leftValue, rightValue]
    exact degreeIn.singleton_indicators at leftEnd, rightEnd, e, v
  have split := natSum.add_pointwise
    at degreeWeights(X, leftEnd, rightEnd, {e}), indicatorMap({leftEnd(e)}, X),
      indicatorMap({rightEnd(e)}, X), cardinality(X)
    with X, finite, size, leftWeights, rightWeights, agree
  have leftSum := natSum.indicator at {leftEnd(e)}, cardinality(X)
    with X, finite, size
  have rightSum := natSum.indicator at {rightEnd(e)}, cardinality(X)
    with X, finite, size
  have leftCount := cardinality.intersection_singleton at X, leftEnd(e)
  have rightCount := cardinality.intersection_singleton at X, rightEnd(e)
  rw [split, leftSum, rightSum, leftCount, rightCount]
  rfl

-- The number of ends of an edge of F that lie in X, as a weight on F.
defgraph endsIn (X leftEnd rightEnd F : Set) (e ∈ F) : ℕ :=
  indicator(X, leftEnd(e)) + indicator(X, rightEnd(e))
proof
  have left := indicator.natural at X, leftEnd(e)
  have right := indicator.natural at X, rightEnd(e)
  have sum : Nat(indicator(X, leftEnd(e)) + indicator(X, rightEnd(e)))
    typecheck
  exact nat.omega.forward with sum

theorem endsIn.natural (X leftEnd rightEnd F e : Set)
  requires member : e ∈ F
  shows endsIn(X, leftEnd, rightEnd, F)(e) ∈ ℕ
proof
  have value := endsIn.value at X, leftEnd, rightEnd, F, e with member
  rw value
  exact endsIn.closed at X, leftEnd, rightEnd, F, e with member

-- Exchanging the order of summation: the degrees over X sum to the number
-- of edge ends in X, counted edge by edge. By induction on the edge set.
theorem natSum.degrees_count_ends (X leftEnd rightEnd : Set, n : Nat)
  shows ∀ F, Finite(F) → cardinality(F) = n → Finite(X) →
    natSum(X, degreeWeights(X, leftEnd, rightEnd, F)) =
    natSum(F, endsIn(X, leftEnd, rightEnd, F))
proof
  induction n
  | zero =>
    intros F finite size finiteX
    have has := cardinality.correct with finite
    rw size at has
    have empty := HasCardinality.empty_of_zero at F with has
    rw [empty, natSum.empty]
    have sizeX : cardinality(X) = cardinality(X) by rfl
    have zeroSum := natSum.indicator at ∅, cardinality(X)
      with X, finiteX, sizeX
    have agree : ∀ v ∈ X, degreeWeights(X, leftEnd, rightEnd, ∅)(v) =
        indicatorMap(∅, X)(v)
      intros v hv
      have degree := degreeWeights.at_vertex at X, leftEnd, rightEnd, ∅, v
        with Finite.empty, hv
      have value := indicatorMap.value at ∅, X, v with hv
      have notIn : ¬(v ∈ ∅) by simp
      have absent := indicator.absent at ∅, v with notIn
      rw [degree, value, absent]
      exact degreeIn.empty at leftEnd, rightEnd, v
    have same := natSum.congr at X, degreeWeights(X, leftEnd, rightEnd, ∅),
      indicatorMap(∅, X) with agree
    rw [same, zeroSum, intersection.right_empty, ← nat.zero]
    exact cardinality.natural
  | succ(k) using ih =>
    intros F finite size finiteX
    have has := cardinality.correct with finite
    rw size at has
    obtain ⟨a, ha⟩ := HasCardinality.exists_member with has
    have removed := cardinality.remove with finite, ha
    rw size at removed
    have smaller := Naturals.injective.succ with removed
    have restSize : cardinality(F ∖ {a}) = k
      symm
      exact smaller
    have restSubset := difference.subset_left at F, {a}
    have restFinite := Finite.subset with finite, restSubset
    have rest := ih with F ∖ {a}, restFinite, restSize, finiteX
    have fresh : ¬a ∈ F ∖ {a}
      intro inside
      have parts := difference.singleton_membership.forward with inside
      apply parts.right
      rfl
    have restore := insert.restore with ha
    have finiteA := Finite.singleton at a
    have unionEq : (F ∖ {a}) ∪ {a} = F
      ext y
      simp
    have apart := Disjoint.difference_left at F, {a}
    have sizeX : cardinality(X) = cardinality(X) by rfl
    have restWeights := degreeWeights.naturals at X, leftEnd, rightEnd,
      F ∖ {a} with restFinite
    have singleWeights := degreeWeights.naturals at X, leftEnd, rightEnd, {a}
      with finiteA
    -- The degree in F is the degree in F ∖ {a} plus the degree in {a}.
    have agree : ∀ v ∈ X, degreeWeights(X, leftEnd, rightEnd, F)(v) =
        degreeWeights(X, leftEnd, rightEnd, F ∖ {a})(v) +
        degreeWeights(X, leftEnd, rightEnd, {a})(v)
      intros v hv
      have whole := degreeWeights.at_vertex at X, leftEnd, rightEnd, F, v
        with finite, hv
      have restValue := degreeWeights.at_vertex at X, leftEnd, rightEnd,
        F ∖ {a}, v with restFinite, hv
      have singleValue := degreeWeights.at_vertex at X, leftEnd, rightEnd,
        {a}, v with finiteA, hv
      have sum := degreeIn.union_disjoint at leftEnd, rightEnd, F ∖ {a},
        {a}, v with restFinite, finiteA, apart
      rw unionEq at sum
      rw [whole, restValue, singleValue]
      exact sum
    have split := natSum.add_pointwise
      at degreeWeights(X, leftEnd, rightEnd, F),
        degreeWeights(X, leftEnd, rightEnd, F ∖ {a}),
        degreeWeights(X, leftEnd, rightEnd, {a}), cardinality(X)
      with X, finiteX, sizeX, restWeights, singleWeights, agree
    have single := natSum.single_edge at X, leftEnd, rightEnd, a with finiteX
    -- On the edge side, the sum over F is the sum over F ∖ {a} plus the
    -- ends of a in X.
    have endWeights : ∀ e ∈ F ∖ {a},
        endsIn(X, leftEnd, rightEnd, F)(e) ∈ ℕ
      intros e he
      have inF := difference.subset_left at F, {a} with e, he
      exact endsIn.natural at X, leftEnd, rightEnd, F, e with inF
    have endWeightA := endsIn.natural at X, leftEnd, rightEnd, F, a with ha
    have insertSum := natSum.insert at F ∖ {a},
      endsIn(X, leftEnd, rightEnd, F), a
      with restFinite, endWeights, endWeightA, fresh
    rw restore at insertSum
    have agreeEnds : ∀ e ∈ F ∖ {a}, endsIn(X, leftEnd, rightEnd, F)(e) =
        endsIn(X, leftEnd, rightEnd, F ∖ {a})(e)
      intros e he
      have inF := difference.subset_left at F, {a} with e, he
      have whole := endsIn.value at X, leftEnd, rightEnd, F, e with inF
      have part := endsIn.value at X, leftEnd, rightEnd, F ∖ {a}, e with he
      rw [whole, part]
      rfl
    have restEnds := natSum.congr at F ∖ {a}, endsIn(X, leftEnd, rightEnd, F),
      endsIn(X, leftEnd, rightEnd, F ∖ {a}) with agreeEnds
    have valueA := endsIn.value at X, leftEnd, rightEnd, F, a with ha
    rw [split, single, insertSum, restEnds, valueA, rest]
    rfl

-- The cut parity: the number of edges of F leaving X has the parity of the
-- sum of the degrees of F over X, because an edge inside X contributes two
-- ends there and an edge outside none.
theorem crossing.parity (V leftEnd rightEnd F X : Set)
  requires finiteVertices : Finite(V)
  requires finite : Finite(F)
  requires subset : X ⊆ V
  requires ends : ∀ e ∈ F, leftEnd(e) ∈ V ∧ rightEnd(e) ∈ V
  shows Even(cardinality(crossing(leftEnd, rightEnd, F, X))) ↔
    Even(natSum(X, degreeWeights(X, leftEnd, rightEnd, F)))
proof
  have finiteX := Finite.subset with finiteVertices, subset
  have size : cardinality(F) = cardinality(F) by rfl
  have exchange := natSum.degrees_count_ends at X, leftEnd, rightEnd,
    cardinality(F) with F, finite, size, finiteX
  -- Each edge has zero, one, or two ends in X, and exactly one when it crosses.
  have weights : ∀ e ∈ F, endsIn(X, leftEnd, rightEnd, F)(e) = 0 ∨
      endsIn(X, leftEnd, rightEnd, F)(e) = 1 ∨
      endsIn(X, leftEnd, rightEnd, F)(e) = 2
    intros e he
    have value := endsIn.value at X, leftEnd, rightEnd, F, e with he
    rw value
    by_cases inLeft : leftEnd(e) ∈ X
    . have leftOne := indicator.member at X, leftEnd(e) with inLeft
      rw leftOne
      by_cases inRight : rightEnd(e) ∈ X
      . have rightOne := indicator.member at X, rightEnd(e) with inRight
        rw rightOne
        right
        right
        compute
      . have rightZero := indicator.absent at X, rightEnd(e) with inRight
        rw rightZero
        right
        left
        compute
    . have leftZero := indicator.absent at X, leftEnd(e) with inLeft
      rw leftZero
      by_cases inRight : rightEnd(e) ∈ X
      . have rightOne := indicator.member at X, rightEnd(e) with inRight
        rw rightOne
        right
        left
        compute
      . have rightZero := indicator.absent at X, rightEnd(e) with inRight
        rw rightZero
        left
        compute
  have parity := natSum.parity at F, endsIn(X, leftEnd, rightEnd, F),
    cardinality(F) with finite, size, weights
  have same : ones(F, endsIn(X, leftEnd, rightEnd, F)) =
      crossing(leftEnd, rightEnd, F, X)
    ext e
    constructor
    . intro h
      have parts := ones.membership.forward with h
      have inF := parts.left
      have value := endsIn.value at X, leftEnd, rightEnd, F, e with inF
      have one : indicator(X, leftEnd(e)) + indicator(X, rightEnd(e)) = 1
        rw ← value
        exact parts.right
      apply crossing.membership.backward
      refine ⟨inF, ?_⟩
      by_cases inLeft : leftEnd(e) ∈ X
      . by_cases inRight : rightEnd(e) ∈ X
        . exfalso
          have leftOne := indicator.member at X, leftEnd(e) with inLeft
          have rightOne := indicator.member at X, rightEnd(e) with inRight
          rw [leftOne, rightOne] at one
          arith
        . left
          exact ⟨inLeft, inRight⟩
      . by_cases inRight : rightEnd(e) ∈ X
        . right
          exact ⟨inRight, inLeft⟩
        . exfalso
          have leftZero := indicator.absent at X, leftEnd(e) with inLeft
          have rightZero := indicator.absent at X, rightEnd(e) with inRight
          rw [leftZero, rightZero] at one
          arith
    . intro h
      have parts := crossing.membership.forward with h
      have inF := parts.left
      have value := endsIn.value at X, leftEnd, rightEnd, F, e with inF
      apply ones.membership.backward
      refine ⟨inF, ?_⟩
      rw value
      have sides := parts.right
      cases sides with leftIn | rightIn
      . have leftOne := indicator.member at X, leftEnd(e) with leftIn.left
        have rightZero := indicator.absent at X, rightEnd(e) with leftIn.right
        rw [leftOne, rightZero]
        compute
      . have rightOne := indicator.member at X, rightEnd(e) with rightIn.left
        have leftZero := indicator.absent at X, leftEnd(e) with rightIn.right
        rw [leftZero, rightOne]
        compute
  rw [exchange, ← same]
  tauto

-- A sum of even weights is even.
theorem natSum.even_of_even_weights (w : Set, n : Nat)
  shows ∀ V, Finite(V) → cardinality(V) = n →
    (∀ v ∈ V, w(v) ∈ ℕ) → (∀ v ∈ V, Even(w(v))) →
    Even(natSum(V, w))
proof
  induction n
  | zero =>
    intros V finite size weights even
    have has := cardinality.correct with finite
    rw size at has
    have empty := HasCardinality.empty_of_zero at V with has
    rw [empty, natSum.empty]
    exact Even.zero
  | succ(k) using ih =>
    intros V finite size weights even
    have has := cardinality.correct with finite
    rw size at has
    obtain ⟨a, ha⟩ := HasCardinality.exists_member with has
    have removed := cardinality.remove with finite, ha
    rw size at removed
    have smaller := Naturals.injective.succ with removed
    have restSize : cardinality(V ∖ {a}) = k
      symm
      exact smaller
    have restSubset := difference.subset_left at V, {a}
    have restFinite := Finite.subset with finite, restSubset
    have restWeights : ∀ v ∈ V ∖ {a}, w(v) ∈ ℕ
      intros v hv
      have parts := difference.singleton_membership.forward with hv
      exact weights with v, parts.left
    have restEven : ∀ v ∈ V ∖ {a}, Even(w(v))
      intros v hv
      have parts := difference.singleton_membership.forward with hv
      exact even with v, parts.left
    have rest := ih with V ∖ {a}, restFinite, restSize, restWeights, restEven
    have fresh : ¬a ∈ V ∖ {a}
      intro inside
      have parts := difference.singleton_membership.forward with inside
      apply parts.right
      rfl
    have restore := insert.restore with ha
    have weightA := weights with a, ha
    have evenA := even with a, ha
    have inserted := natSum.insert at V ∖ {a}, w, a
      with restFinite, restWeights, weightA, fresh
    rw restore at inserted
    rw inserted
    exact Even.add with rest, evenA

theorem EvenEdgeSet.crossing_even (V leftEnd rightEnd F X : Set)
  requires finiteVertices : Finite(V)
  requires even : EvenEdgeSet(V, leftEnd, rightEnd, F)
  requires subset : X ⊆ V
  requires ends : ∀ e ∈ F, leftEnd(e) ∈ V ∧ rightEnd(e) ∈ V
  shows Even(cardinality(crossing(leftEnd, rightEnd, F, X)))
proof
  have finiteF := even.left
  have finiteX := Finite.subset with finiteVertices, subset
  have parity := crossing.parity at V, leftEnd, rightEnd, F, X
    with finiteVertices, finiteF, subset, ends
  apply parity.backward
  have weights := degreeWeights.naturals at X, leftEnd, rightEnd, F with finiteF
  have evens : ∀ v ∈ X, Even(degreeWeights(X, leftEnd, rightEnd, F)(v))
    intros v hv
    have value := degreeWeights.at_vertex at X, leftEnd, rightEnd, F, v
      with finiteF, hv
    rw value
    exact even.right with v, (subset with v, hv)
  have size : cardinality(X) = cardinality(X) by rfl
  exact natSum.even_of_even_weights at degreeWeights(X, leftEnd, rightEnd, F),
    cardinality(X) with X, finiteX, size, weights, evens

-- An even edge set never meets a cut in exactly one edge.
theorem EvenEdgeSet.crossing_ne_singleton (V leftEnd rightEnd F X g : Set)
  requires finiteVertices : Finite(V)
  requires even : EvenEdgeSet(V, leftEnd, rightEnd, F)
  requires subset : X ⊆ V
  requires ends : ∀ e ∈ F, leftEnd(e) ∈ V ∧ rightEnd(e) ∈ V
  shows crossing(leftEnd, rightEnd, F, X) ≠ {g}
proof
  intro single
  have evenCount := EvenEdgeSet.crossing_even at V, leftEnd, rightEnd, F, X
    with finiteVertices, even, subset, ends
  rw [single, cardinality.singleton] at evenCount
  exact Even.not_one with evenCount

-- A bridge is an edge that alone leaves some vertex set; no even edge set
-- contains one. Conversely a cut of two edges is met by an even set in both
-- or neither.
theorem EvenEdgeSet.avoids_bridge (V E leftEnd rightEnd F X e : Set)
  requires finiteVertices : Finite(V)
  requires even : EvenEdgeSet(V, leftEnd, rightEnd, F)
  requires subset : X ⊆ V
  requires edges : F ⊆ E
  requires ends : ∀ e ∈ E, leftEnd(e) ∈ V ∧ rightEnd(e) ∈ V
  requires cut : crossing(leftEnd, rightEnd, E, X) = {e}
  shows ¬e ∈ F
proof
  intro inF
  have endsF : ∀ f ∈ F, leftEnd(f) ∈ V ∧ rightEnd(f) ∈ V
    intros f hf
    exact ends with f, (edges with f, hf)
  have mono := crossing.monotone at leftEnd, rightEnd, F, E, X with edges
  have inCut : e ∈ crossing(leftEnd, rightEnd, E, X)
    rw cut
    exact singleton.self at e
  have crossE := crossing.membership.forward with inCut
  have single : crossing(leftEnd, rightEnd, F, X) = {e}
    ext g
    constructor
    . intro hg
      have inE := mono with g, hg
      rw cut at inE
      exact inE
    . intro hg
      have same := singleton.membership.forward with hg
      rw same
      exact crossing.membership.backward with ⟨inF, crossE.right⟩
  exact EvenEdgeSet.crossing_ne_singleton at V, leftEnd, rightEnd, F, X, e
    with finiteVertices, even, subset, endsF, single

theorem EvenEdgeSet.two_cut (V E leftEnd rightEnd F X e f : Set)
  requires finiteVertices : Finite(V)
  requires even : EvenEdgeSet(V, leftEnd, rightEnd, F)
  requires subset : X ⊆ V
  requires edges : F ⊆ E
  requires ends : ∀ e ∈ E, leftEnd(e) ∈ V ∧ rightEnd(e) ∈ V
  requires cut : crossing(leftEnd, rightEnd, E, X) = {e, f}
  requires distinct : e ≠ f
  shows e ∈ F ↔ f ∈ F
proof
  have endsF : ∀ g ∈ F, leftEnd(g) ∈ V ∧ rightEnd(g) ∈ V
    intros g hg
    exact ends with g, (edges with g, hg)
  have mono := crossing.monotone at leftEnd, rightEnd, F, E, X with edges
  have inCutE : e ∈ crossing(leftEnd, rightEnd, E, X)
    rw cut
    simp
  have inCutF : f ∈ crossing(leftEnd, rightEnd, E, X)
    rw cut
    simp
  have crossE := crossing.membership.forward with inCutE
  have crossF := crossing.membership.forward with inCutF
  -- If only one of the two is in F, that one alone leaves X.
  constructor
  . intro eIn
    by_cases fIn : f ∈ F
    . exact fIn
    . exfalso
      have single : crossing(leftEnd, rightEnd, F, X) = {e}
        ext g
        constructor
        . intro hg
          have inE := mono with g, hg
          rw cut at inE
          have parts := crossing.membership.forward with hg
          have inF := parts.left
          simp
        . intro hg
          have same := singleton.membership.forward with hg
          rw same
          exact crossing.membership.backward with ⟨eIn, crossE.right⟩
      exact EvenEdgeSet.crossing_ne_singleton at V, leftEnd, rightEnd, F, X, e
        with finiteVertices, even, subset, endsF, single
  . intro fIn
    by_cases eIn : e ∈ F
    . exact eIn
    . exfalso
      have single : crossing(leftEnd, rightEnd, F, X) = {f}
        ext g
        constructor
        . intro hg
          have inE := mono with g, hg
          rw cut at inE
          have parts := crossing.membership.forward with hg
          have inF := parts.left
          simp
        . intro hg
          have same := singleton.membership.forward with hg
          rw same
          exact crossing.membership.backward with ⟨fIn, crossF.right⟩
      exact EvenEdgeSet.crossing_ne_singleton at V, leftEnd, rightEnd, F, X, f
        with finiteVertices, even, subset, endsF, single

-- The empty set and the whole vertex set are left by no edge.
theorem crossing.trivial (V leftEnd rightEnd F X : Set)
  requires ends : ∀ e ∈ F, leftEnd(e) ∈ V ∧ rightEnd(e) ∈ V
  requires trivial : X = ∅ ∨ X = V
  shows crossing(leftEnd, rightEnd, F, X) = ∅
proof
  apply Subset.antisymmetric
  . intros e member
    obtain ⟨edge, sides⟩ := crossing.membership.forward with member
    have inV := ends with e, edge
    exfalso
    cases trivial with isEmpty | isWhole
    . rw isEmpty at sides
      settle with set.empty
    . rw isWhole at sides
      tauto
  . exact empty.subset at crossing(leftEnd, rightEnd, F, X)

theorem EdgeConnected.bridgeless (V E leftEnd rightEnd : Set, k : Nat)
  requires two : 2 ≤ k
  requires ends : ∀ e ∈ E, leftEnd(e) ∈ V ∧ rightEnd(e) ∈ V
  requires connected : EdgeConnected(V, E, leftEnd, rightEnd, k)
  shows Bridgeless(V, E, leftEnd, rightEnd)
proof
  intros X bound
  by_cases trivial : (X = ∅ ∨ X = V)
  . have none := crossing.trivial with ends, trivial
    rw none
    have zero : cardinality(∅) = 0 :=
      cardinality.eq_of_has with HasCardinality.empty_set
    rw zero
    intro absurd
    arith
  . have nonempty : X ≠ ∅ by tauto
    have proper : X ≠ V by tauto
    have many := connected with X, bound, nonempty, proper
    intro one
    rw one at many
    arith

theorem EdgeConnected.monotone (V E leftEnd rightEnd : Set, k m : Nat)
  requires order : m ≤ k
  requires connected : EdgeConnected(V, E, leftEnd, rightEnd, k)
  shows EdgeConnected(V, E, leftEnd, rightEnd, m)
proof
  intros X bound nonempty proper
  have above := connected with X, bound, nonempty, proper
  have natural : Nat(cardinality(crossing(leftEnd, rightEnd, E, X)))
    obtain ⟨j, jNat, equation⟩ := above
    rw ← equation
    typecheck
  linarith
