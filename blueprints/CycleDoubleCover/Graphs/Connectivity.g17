-- Connectivity through an edge set, components, partitions of the vertex
-- set, and the quotient multigraph of a partition, in which every class is
-- one vertex and an edge keeps its identity.
-- Part of the cycle double cover blueprint. Planned home:
-- GraphTheory/Multigraph/Connectivity and GraphTheory/Multigraph/Quotient.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module CycleDoubleCover.Graphs.Connectivity
import Cuts

-- A vertex set that no edge of F leaves.
predicate ClosedUnder (leftEnd rightEnd F A : Set) :=
  ∀ e ∈ F, (leftEnd(e) ∈ A ↔ rightEnd(e) ∈ A)

-- v is reached from u along edges of F: every closed set containing u
-- contains v.
predicate Joined (leftEnd rightEnd F u v : Set) :=
  ∀ A, u ∈ A → ClosedUnder(leftEnd, rightEnd, F, A) → v ∈ A

predicate Connects (V leftEnd rightEnd F : Set) :=
  ∀ u ∈ V, ∀ v ∈ V, Joined(leftEnd, rightEnd, F, u, v)

-- The component of u: the vertices joined to u along F.
def componentBy (V leftEnd rightEnd F u : Set) : Set :=
  { v ∈ V | Joined(leftEnd, rightEnd, F, u, v) }

def componentsBy (V leftEnd rightEnd F : Set) : Set :=
  { componentBy(V, leftEnd, rightEnd, F, u) | u ∈ V }

theorem Joined.reflexive (leftEnd rightEnd F u : Set)
  shows Joined(leftEnd, rightEnd, F, u, u)
proof
  intros A start closed
  exact start

theorem Joined.of_edge (leftEnd rightEnd F e : Set)
  requires edge : e ∈ F
  shows Joined(leftEnd, rightEnd, F, leftEnd(e), rightEnd(e))
proof
  intros A start closed
  have crossed := closed with e, edge
  exact crossed.forward with start

theorem Joined.of_edge_reverse (leftEnd rightEnd F e : Set)
  requires edge : e ∈ F
  shows Joined(leftEnd, rightEnd, F, rightEnd(e), leftEnd(e))
proof
  intros A start closed
  have crossed := closed with e, edge
  exact crossed.backward with start

theorem Joined.transitive (leftEnd rightEnd F u v w : Set)
  requires first : Joined(leftEnd, rightEnd, F, u, v)
  requires second : Joined(leftEnd, rightEnd, F, v, w)
  shows Joined(leftEnd, rightEnd, F, u, w)
proof
  intros A start closed
  have middle := first with A, start, closed
  exact second with A, middle, closed

theorem Joined.monotone (leftEnd rightEnd F G u v : Set)
  requires subset : F ⊆ G
  requires joined : Joined(leftEnd, rightEnd, F, u, v)
  shows Joined(leftEnd, rightEnd, G, u, v)
proof
  intros A start closed
  have closedF : ClosedUnder(leftEnd, rightEnd, F, A)
    intros e edge
    exact closed with e, (subset with e, edge)
  exact joined with A, start, closedF

-- Symmetry: the vertices joined to u form a closed set containing u, so it
-- contains every vertex that u is joined to.
def joinedTo (V leftEnd rightEnd F u : Set) : Set :=
  { w ∈ V | Joined(leftEnd, rightEnd, F, w, u) }

theorem joinedTo.closed (V leftEnd rightEnd F u : Set)
  requires ends : ∀ e ∈ F, leftEnd(e) ∈ V ∧ rightEnd(e) ∈ V
  shows ClosedUnder(leftEnd, rightEnd, F, joinedTo(V, leftEnd, rightEnd, F, u))
proof
  intros e edge
  obtain ⟨leftV, rightV⟩ := ends with e, edge
  have across := Joined.of_edge at leftEnd, rightEnd, F, e with edge
  have back := Joined.of_edge_reverse at leftEnd, rightEnd, F, e with edge
  unfold joinedTo
  constructor
  . intro member
    exact ⟨rightV, (Joined.transitive with back, member.right)⟩
  . intro member
    exact ⟨leftV, (Joined.transitive with across, member.right)⟩

theorem Joined.symmetric (V leftEnd rightEnd F u v : Set)
  requires ends : ∀ e ∈ F, leftEnd(e) ∈ V ∧ rightEnd(e) ∈ V
  requires first : u ∈ V
  requires second : v ∈ V
  requires joined : Joined(leftEnd, rightEnd, F, u, v)
  shows Joined(leftEnd, rightEnd, F, v, u)
proof
  have start : u ∈ joinedTo(V, leftEnd, rightEnd, F, u)
    by simp [joinedTo, first, Joined.reflexive]
  have reached := joined with joinedTo(V, leftEnd, rightEnd, F, u), start,
    (joinedTo.closed with ends)
  unfold joinedTo at reached
  exact reached.right

-- A vertex outside V is a closed set on its own, so it is joined to nothing
-- else.
theorem Joined.start_in (V leftEnd rightEnd F u v : Set)
  requires ends : ∀ e ∈ F, leftEnd(e) ∈ V ∧ rightEnd(e) ∈ V
  requires distinct : u ≠ v
  requires joined : Joined(leftEnd, rightEnd, F, u, v)
  shows u ∈ V
proof
  by_contra outside
  have closed : ClosedUnder(leftEnd, rightEnd, F, {u})
    intros e edge
    have bounds := ends with e, edge
    simp
  have reached := joined with {u}, (singleton.self at u), closed
  simp at reached
  cc

-- A single non-loop edge has odd degree exactly at its two ends.
theorem degreeIn.single_parity (leftEnd rightEnd e : Set)
  requires distinct : leftEnd(e) ≠ rightEnd(e)
  shows ∀ x, (Even(degreeIn(leftEnd, rightEnd, {e}, x)) ↔
    (x ≠ leftEnd(e) ∧ x ≠ rightEnd(e)))
proof
  intro x
  have odd := Even.not_one
  have even := Even.zero
  by_cases hit : x = leftEnd(e) ∨ x = rightEnd(e)
  . have atEnd : leftEnd(e) = x ∨ rightEnd(e) = x by tauto
    rw degreeIn.end with distinct, atEnd
    tauto
  . have notLeft : leftEnd(e) ≠ x by tauto
    have notRight : rightEnd(e) ≠ x by tauto
    rw degreeIn.absent with notLeft, notRight
    tauto

-- The vertices reached from u by a path along F, with u itself: w ≠ u is
-- reached when some P ⊆ F has odd degree exactly at u and w.
def pathReached (V leftEnd rightEnd F u : Set) : Set :=
  { w ∈ V | w = u ∨ ∃ P ⊆ F, ∀ x ∈ V,
    (Even(degreeIn(leftEnd, rightEnd, P, x)) ↔ (x ≠ u ∧ x ≠ w)) }

-- An edge with ends a and b carries a path from u to a on to b: the edge
-- alone when a = u, and otherwise the symmetric difference with the edge.
theorem pathReached.step (V leftEnd rightEnd F u e a b : Set)
  requires finite : Finite(F)
  requires edge : e ∈ F
  requires distinct : a ≠ b
  requires vertex : b ∈ V
  requires parity : ∀ x, (Even(degreeIn(leftEnd, rightEnd, {e}, x)) ↔
    (x ≠ a ∧ x ≠ b))
  requires reached : a ∈ pathReached(V, leftEnd, rightEnd, F, u)
  shows b ∈ pathReached(V, leftEnd, rightEnd, F, u)
proof
  unfold pathReached at reached
  obtain ⟨_, alternatives⟩ := reached
  have single : {e} ⊆ F := singleton.subset_iff.backward with edge
  unfold pathReached
  refine ⟨vertex, _⟩
  by_cases start : a = u
  . right
    witness {e}
    refine ⟨single, _⟩
    intros x inV
    rw ← start
    exact parity with x
  rcases alternatives with same | ⟨P, subset, parityP⟩
  . contradiction
  by_cases finish : b = u
  . left
    exact finish
  right
  witness P △ {e}
  refine ⟨(symmetricDifference.subset with subset, single), _⟩
  intros x inV
  have finiteP := Finite.subset with finite, subset
  have atP := parityP with x, inV
  have atEdge := parity with x
  -- P and {e} are both odd at a, so their sum is odd exactly at u and b.
  rw degreeIn.symmetricDifference_parity with finiteP, (Finite.singleton at e)
  simp [atP, atEdge]

theorem pathReached.closed (V leftEnd rightEnd F u : Set)
  requires finite : Finite(F)
  requires ends : ∀ e ∈ F, leftEnd(e) ∈ V ∧ rightEnd(e) ∈ V
  shows ClosedUnder(leftEnd, rightEnd, F,
    pathReached(V, leftEnd, rightEnd, F, u))
proof
  intros e edge
  have bounds := ends with e, edge
  by_cases loop : leftEnd(e) = rightEnd(e)
  . simp [loop]
  have parity := degreeIn.single_parity at leftEnd, rightEnd, e with loop
  have flipped : ∀ x, (Even(degreeIn(leftEnd, rightEnd, {e}, x)) ↔
      (x ≠ rightEnd(e) ∧ x ≠ leftEnd(e)))
    intro x
    have direct := parity with x
    tauto
  have reverse : rightEnd(e) ≠ leftEnd(e) by cc
  constructor
  . intro reached
    exact pathReached.step
      with finite, edge, loop, bounds.right, parity, reached
  . intro reached
    exact pathReached.step
      with finite, edge, reverse, bounds.left, flipped, reached

-- Along edges of F, a vertex joined to u is reached by a path from u: an
-- edge set P ⊆ F whose degrees are odd exactly at u and v when u ≠ v.
theorem Joined.path (V leftEnd rightEnd F u v : Set)
  requires finite : Finite(F)
  requires ends : ∀ e ∈ F, leftEnd(e) ∈ V ∧ rightEnd(e) ∈ V
  requires distinct : u ≠ v
  requires joined : Joined(leftEnd, rightEnd, F, u, v)
  shows ∃ P ⊆ F, ∀ w ∈ V,
    (Even(degreeIn(leftEnd, rightEnd, P, w)) ↔ (w ≠ u ∧ w ≠ v))
proof
  have start := Joined.start_in with ends, distinct, joined
  have self : u ∈ pathReached(V, leftEnd, rightEnd, F, u)
    by simp [pathReached, start]
  have reached := joined with pathReached(V, leftEnd, rightEnd, F, u), self,
    (pathReached.closed with finite, ends)
  unfold pathReached at reached
  obtain ⟨_, alternatives⟩ := reached
  rcases alternatives with same | path
  . cc
  . exact path

theorem componentBy.closed (V leftEnd rightEnd F u : Set)
  requires ends : ∀ e ∈ F, leftEnd(e) ∈ V ∧ rightEnd(e) ∈ V
  shows ClosedUnder(leftEnd, rightEnd, F,
    componentBy(V, leftEnd, rightEnd, F, u))
proof
  intros e edge
  obtain ⟨leftV, rightV⟩ := ends with e, edge
  have across := Joined.of_edge at leftEnd, rightEnd, F, e with edge
  have back := Joined.of_edge_reverse at leftEnd, rightEnd, F, e with edge
  unfold componentBy
  constructor
  . intro member
    exact ⟨rightV, (Joined.transitive with member.right, across)⟩
  . intro member
    exact ⟨leftV, (Joined.transitive with member.right, back)⟩

theorem componentBy.eq_of_joined (V leftEnd rightEnd F u w : Set)
  requires ends : ∀ e ∈ F, leftEnd(e) ∈ V ∧ rightEnd(e) ∈ V
  requires first : u ∈ V
  requires second : w ∈ V
  requires joined : Joined(leftEnd, rightEnd, F, u, w)
  shows componentBy(V, leftEnd, rightEnd, F, u) =
    componentBy(V, leftEnd, rightEnd, F, w)
proof
  have back := Joined.symmetric with ends, first, second, joined
  ext z
  unfold componentBy
  constructor
  . intro member
    exact ⟨member.left, (Joined.transitive with back, member.right)⟩
  . intro member
    exact ⟨member.left, (Joined.transitive with joined, member.right)⟩

-- The edges of F with both ends in X.
def inside (leftEnd rightEnd F X : Set) : Set :=
  { e ∈ F | leftEnd(e) ∈ X ∧ rightEnd(e) ∈ X }

-- A partition of V: nonempty classes, pairwise disjoint, covering V.
predicate Partition (V P : Set) :=
  (∀ X ∈ P, X ⊆ V ∧ X ≠ ∅) ∧
    (∀ X ∈ P, ∀ Y ∈ P, X ≠ Y → Disjoint(X, Y)) ∧
    (∀ v ∈ V, ∃ X ∈ P, v ∈ X)

theorem componentsBy.partition (V leftEnd rightEnd F : Set)
  requires ends : ∀ e ∈ F, leftEnd(e) ∈ V ∧ rightEnd(e) ∈ V
  shows Partition(V, componentsBy(V, leftEnd, rightEnd, F))
proof
  constructor
  -- A component is a subset of V containing its own vertex.
  . intros X inFamily
    obtain ⟨u, inV, rfl⟩ := componentsBy.membership.forward with inFamily
    have self := Joined.reflexive at leftEnd, rightEnd, F, u
    constructor
    . intros w member
      unfold componentBy at member
      exact member.left
    . apply Nonempty.ne_empty
      witness u
      exact componentBy.membership.backward with ⟨inV, self⟩
  constructor
  -- Two components sharing a vertex are one component.
  . intros X inFamilyX Y inFamilyY different
    obtain ⟨u, uInV, rfl⟩ := componentsBy.membership.forward with inFamilyX
    obtain ⟨w, wInV, rfl⟩ := componentsBy.membership.forward with inFamilyY
    apply Disjoint.iff.backward
    intros x inU inW
    obtain ⟨xInV, fromU⟩ := componentBy.membership.forward with inU
    obtain ⟨_, fromW⟩ := componentBy.membership.forward with inW
    have back := Joined.symmetric with ends, wInV, xInV, fromW
    have joined := Joined.transitive with fromU, back
    apply different
    exact componentBy.eq_of_joined with ends, uInV, wInV, joined
  . intros v inV
    have self := Joined.reflexive at leftEnd, rightEnd, F, v
    witness componentBy(V, leftEnd, rightEnd, F, v)
    constructor
    . exact componentsBy.membership.backward with ⟨v, inV, rfl⟩
    . exact componentBy.membership.backward with ⟨inV, self⟩

-- The class of v: the union of the classes containing v, which under a
-- partition is the one class containing v.
def classesContaining (P v : Set) : Set := { X ∈ P | v ∈ X }
def classOf (P v : Set) : Set := ⋃(classesContaining(P, v))

theorem classOf.membership (P v z : Set)
  shows z ∈ classOf(P, v) ↔ ∃ X ∈ P, v ∈ X ∧ z ∈ X
proof
  simp [classOf, classesContaining, union.membership]

theorem classOf.eq_of_member (P v X : Set)
  requires apart : ∀ X ∈ P, ∀ Y ∈ P, X ≠ Y → Disjoint(X, Y)
  requires class : X ∈ P
  requires member : v ∈ X
  shows classOf(P, v) = X
proof
  ext z
  rw classOf.membership
  constructor
  . intro inUnion
    obtain ⟨Y, classY, vInY, inY⟩ := inUnion
    have same : X = Y
      by_contra different
      have disjoint := apart with X, class, Y, classY, different
      have separated := Disjoint.iff.forward with disjoint
      exact separated with v, member, vInY
    cc
  . intro inX
    exact ⟨X, class, member, inX⟩

theorem classOf.member (V P v : Set)
  requires partition : Partition(V, P)
  requires vertex : v ∈ V
  shows classOf(P, v) ∈ P ∧ v ∈ classOf(P, v)
proof
  rcases partition with ⟨classes, apart, cover⟩
  obtain ⟨X, class, member⟩ := cover with v, vertex
  rw classOf.eq_of_member with apart, class, member
  exact ⟨class, member⟩

theorem classOf.eq_iff (V P u v : Set)
  requires partition : Partition(V, P)
  requires first : u ∈ V
  requires second : v ∈ V
  shows classOf(P, u) = classOf(P, v) ↔ (∃ X ∈ P, u ∈ X ∧ v ∈ X)
proof
  rcases partition with ⟨classes, apart, cover⟩
  constructor
  . intro equal
    obtain ⟨X, classX, uInX⟩ := cover with u, first
    obtain ⟨Y, classY, vInY⟩ := cover with v, second
    have classU := classOf.eq_of_member with apart, classX, uInX
    have classV := classOf.eq_of_member with apart, classY, vInY
    witness X
    refine ⟨classX, uInX, _⟩
    cc
  . intro common
    obtain ⟨X, class, uInX, vInX⟩ := common
    have classU := classOf.eq_of_member with apart, class, uInX
    have classV := classOf.eq_of_member with apart, class, vInX
    cc

-- A vertex lies in a union of classes exactly when its class is one of them.
theorem classOf.mem_union_iff (V P Y v : Set)
  requires partition : Partition(V, P)
  requires subfamily : Y ⊆ P
  requires vertex : v ∈ V
  shows v ∈ ⋃(Y) ↔ classOf(P, v) ∈ Y
proof
  rcases partition with ⟨classes, apart, cover⟩
  constructor
  . intro inUnion
    obtain ⟨Z, inY, inZ⟩ := union.membership.forward with inUnion
    have classZ := subfamily with Z, inY
    rw classOf.eq_of_member with apart, classZ, inZ
    exact inY
  . intro inY
    obtain ⟨X, class, member⟩ := cover with v, vertex
    rw classOf.eq_of_member with apart, class, member at inY
    exact union.membership.backward with ⟨X, inY, member⟩

-- A partition refines another when every class of the first lies in a class
-- of the second.
predicate Refines (P Q : Set) := ∀ X ∈ P, ∃ Y ∈ Q, X ⊆ Y

-- The quotient multigraph: the vertices are the classes, and an edge joins
-- the classes of its ends. Edges inside a class become loops; the crossing
-- classes of F are its edges joining distinct classes.
def quotientEnd (E P endpoint : Set) : Set :=
  { p ∈ E × P | ∃ e ∈ E, p = (e, classOf(P, endpoint(e))) }

def crossingClasses (P leftEnd rightEnd F : Set) : Set :=
  { e ∈ F | classOf(P, leftEnd(e)) ≠ classOf(P, rightEnd(e)) }

theorem quotientEnd.relates (E P endpoint e X : Set)
  requires related : relates(quotientEnd(E, P, endpoint), e, X)
  shows e ∈ E ∧ X = classOf(P, endpoint(e))
proof
  obtain ⟨_, f, inE, equation⟩ :=
    quotientEnd.membership.forward with related
  obtain ⟨rfl, value⟩ := orderedPair.injective with equation
  exact ⟨inE, value⟩

theorem quotientEnd.relates_class (V E P endpoint e : Set)
  requires function : endpoint : E → V
  requires partition : Partition(V, P)
  requires edge : e ∈ E
  shows relates(quotientEnd(E, P, endpoint), e, classOf(P, endpoint(e)))
proof
  have vertex := FunctionBetween.apply_closed with function, edge
  obtain ⟨class, _⟩ := classOf.member with partition, vertex
  unfold relates
  apply quotientEnd.membership.backward
  refine ⟨(product.pair with edge, class), e, edge, _⟩
  rfl

theorem quotientEnd.function (V E P endpoint : Set)
  requires function : endpoint : E → V
  requires partition : Partition(V, P)
  shows quotientEnd(E, P, endpoint) : E → P
proof
  constructor
  . intros p member
    obtain ⟨inProduct, _⟩ := quotientEnd.membership.forward with member
    exact inProduct
  constructor
  . intros x y relatedY z relatedZ
    obtain ⟨_, valueY⟩ := quotientEnd.relates with relatedY
    obtain ⟨_, valueZ⟩ := quotientEnd.relates with relatedZ
    cc
  . intros x edge
    have vertex := FunctionBetween.apply_closed with function, edge
    obtain ⟨class, _⟩ := classOf.member with partition, vertex
    witness classOf(P, endpoint(x))
    exact ⟨class,
      (quotientEnd.relates_class with function, partition, edge)⟩

theorem quotientEnd.graph (V E P leftEnd rightEnd : Set)
  requires graph : Graph(V, E, leftEnd, rightEnd)
  requires partition : Partition(V, P)
  shows Graph(P, E, quotientEnd(E, P, leftEnd), quotientEnd(E, P, rightEnd))
proof
  rcases graph with ⟨leftMap, rightMap⟩
  constructor
  . exact quotientEnd.function with leftMap, partition
  . exact quotientEnd.function with rightMap, partition

theorem quotientEnd.value (V E P leftEnd rightEnd e : Set)
  requires graph : Graph(V, E, leftEnd, rightEnd)
  requires partition : Partition(V, P)
  requires edge : e ∈ E
  shows quotientEnd(E, P, leftEnd)(e) = classOf(P, leftEnd(e)) ∧
    quotientEnd(E, P, rightEnd)(e) = classOf(P, rightEnd(e))
proof
  rcases graph with ⟨leftMap, rightMap⟩
  constructor
  . exact FunctionBetween.apply_value with
      (quotientEnd.function with leftMap, partition), edge,
      (quotientEnd.relates_class with leftMap, partition, edge)
  . exact FunctionBetween.apply_value with
      (quotientEnd.function with rightMap, partition), edge,
      (quotientEnd.relates_class with rightMap, partition, edge)

-- Edges within a class contribute nothing to crossing a union of classes, so
-- crossing in the quotient is crossing in the graph.
theorem crossing.quotient (V E P leftEnd rightEnd F Y : Set)
  requires graph : Graph(V, E, leftEnd, rightEnd)
  requires partition : Partition(V, P)
  requires edges : F ⊆ E
  requires classes : Y ⊆ P
  shows crossing(quotientEnd(E, P, leftEnd), quotientEnd(E, P, rightEnd), F, Y)
    = crossing(leftEnd, rightEnd, F, ⋃(Y))
proof
  ext e
  by_cases inF : e ∈ F
  . have inE := edges with e, inF
    obtain ⟨leftValue, rightValue⟩ :=
      quotientEnd.value with graph, partition, inE
    rcases graph with ⟨leftMap, rightMap⟩
    have leftIn := FunctionBetween.apply_closed with leftMap, inE
    have rightIn := FunctionBetween.apply_closed with rightMap, inE
    have leftIff := classOf.mem_union_iff with partition, classes, leftIn
    have rightIff := classOf.mem_union_iff with partition, classes, rightIn
    simp [crossing, leftValue, rightValue, leftIff, rightIff]
  . simp [crossing, inF]

-- F connects the classes of P in the quotient when its crossing edges do: an
-- edge inside a class is a loop of the quotient and leaves no vertex set.
theorem Connects.quotient_iff (V E P leftEnd rightEnd F : Set)
  requires graph : Graph(V, E, leftEnd, rightEnd)
  requires partition : Partition(V, P)
  requires edges : F ⊆ E
  shows Connects(P, quotientEnd(E, P, leftEnd), quotientEnd(E, P, rightEnd), F)
    ↔ Connects(P, quotientEnd(E, P, leftEnd), quotientEnd(E, P, rightEnd),
      crossingClasses(P, leftEnd, rightEnd, F))
proof
  have crossingSubset : crossingClasses(P, leftEnd, rightEnd, F) ⊆ F
    intros e member
    unfold crossingClasses at member
    exact member.left
  constructor
  . intros connected X classX Y classY A start closed
    have closedF : ClosedUnder(quotientEnd(E, P, leftEnd),
        quotientEnd(E, P, rightEnd), F, A)
      intros e inF
      by_cases same : classOf(P, leftEnd(e)) = classOf(P, rightEnd(e))
      . have inE := edges with e, inF
        obtain ⟨leftValue, rightValue⟩ :=
          quotientEnd.value with graph, partition, inE
        simp [leftValue, rightValue, same]
      . exact closed with e,
          (crossingClasses.membership.backward with ⟨inF, same⟩)
    exact connected with X, classX, Y, classY, A, start, closedF
  . intros connected X classX Y classY
    have joined := connected with X, classX, Y, classY
    exact Joined.monotone with crossingSubset, joined
