-- Connectivity through an edge set, components, partitions of the vertex
-- set, and the quotient multigraph of a partition, in which every class is
-- one vertex and an edge keeps its identity.
-- Part of the cycle double cover blueprint. Planned home: GraphTheory/Multigraph/Connectivity
-- and GraphTheory/Multigraph/Quotient.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module CycleDoubleCover.Graphs.Connectivity
import Cuts

-- A vertex set that no edge of F leaves.
predicate ClosedUnder (leftEnd rightEnd F A : Set) :=
  ∀ e ∈ F, (leftEnd(e) ∈ A ↔ rightEnd(e) ∈ A)

-- v is reached from u along edges of F: every closed set containing u contains v.
predicate Joined (leftEnd rightEnd F u v : Set) :=
  ∀ A, u ∈ A → ClosedUnder(leftEnd, rightEnd, F, A) → v ∈ A

predicate Connects (V leftEnd rightEnd F : Set) :=
  ∀ u ∈ V, ∀ v ∈ V, Joined(leftEnd, rightEnd, F, u, v)

def componentBy (V leftEnd rightEnd F u : Set) : Set := { v ∈ V | Joined(leftEnd, rightEnd, F, u, v) }

def componentsBy (V leftEnd rightEnd F : Set) : Set := { componentBy(V, leftEnd, rightEnd, F, u) | u ∈ V }

theorem Joined.reflexive (leftEnd rightEnd F u : Set)
  shows Joined(leftEnd, rightEnd, F, u, u)
proof
  intros A start closed
  exact start

theorem Joined.of_edge (leftEnd rightEnd F e : Set)
  requires edge : e ∈ F
  shows Joined(leftEnd, rightEnd, F, leftEnd(e), rightEnd(e))
proof
  intros A start closed
  have crossed := closed with e, edge
  exact crossed.forward with start

theorem Joined.of_edge_reverse (leftEnd rightEnd F e : Set)
  requires edge : e ∈ F
  shows Joined(leftEnd, rightEnd, F, rightEnd(e), leftEnd(e))
proof
  intros A start closed
  have crossed := closed with e, edge
  exact crossed.backward with start

-- The vertices from which u is reached. It is closed because an edge is
-- crossed in both directions, and it carries the symmetry of Joined.
def joinedTo (V leftEnd rightEnd F u : Set) : Set :=
  { w ∈ V | Joined(leftEnd, rightEnd, F, w, u) }

theorem joinedTo.closed (V leftEnd rightEnd F u : Set)
  requires ends : ∀ e ∈ F, leftEnd(e) ∈ V ∧ rightEnd(e) ∈ V
  shows ClosedUnder(leftEnd, rightEnd, F, joinedTo(V, leftEnd, rightEnd, F, u))
proof
  intros e edge
  have bounds := ends with e, edge
  constructor
  . intro left
    obtain ⟨_, joined⟩ := joinedTo.membership.forward with left
    have back := Joined.of_edge_reverse at leftEnd, rightEnd, F, e with edge
    have further : Joined(leftEnd, rightEnd, F, rightEnd(e), u)
      intros A start closed
      have leftIn := back with A, start, closed
      exact joined with A, leftIn, closed
    exact joinedTo.membership.backward with ⟨bounds.right, further⟩
  . intro right
    obtain ⟨_, joined⟩ := joinedTo.membership.forward with right
    have across := Joined.of_edge at leftEnd, rightEnd, F, e with edge
    have further : Joined(leftEnd, rightEnd, F, leftEnd(e), u)
      intros A start closed
      have rightIn := across with A, start, closed
      exact joined with A, rightIn, closed
    exact joinedTo.membership.backward with ⟨bounds.left, further⟩

theorem Joined.symmetric (V leftEnd rightEnd F u v : Set)
  requires ends : ∀ e ∈ F, leftEnd(e) ∈ V ∧ rightEnd(e) ∈ V
  requires first : u ∈ V
  requires second : v ∈ V
  requires joined : Joined(leftEnd, rightEnd, F, u, v)
  shows Joined(leftEnd, rightEnd, F, v, u)
proof
  have closed := joinedTo.closed at V, leftEnd, rightEnd, F, u with ends
  have start : u ∈ joinedTo(V, leftEnd, rightEnd, F, u)
    have self := Joined.reflexive at leftEnd, rightEnd, F, u
    exact joinedTo.membership.backward with ⟨first, self⟩
  have reached := joined with joinedTo(V, leftEnd, rightEnd, F, u),
    start, closed
  obtain ⟨_, back⟩ := joinedTo.membership.forward with reached
  exact back

theorem Joined.transitive (leftEnd rightEnd F u v w : Set)
  requires first : Joined(leftEnd, rightEnd, F, u, v)
  requires second : Joined(leftEnd, rightEnd, F, v, w)
  shows Joined(leftEnd, rightEnd, F, u, w)
proof
  intros A start closed
  have middle := first with A, start, closed
  exact second with A, middle, closed

theorem Joined.monotone (leftEnd rightEnd F G u v : Set)
  requires subset : F ⊆ G
  requires joined : Joined(leftEnd, rightEnd, F, u, v)
  shows Joined(leftEnd, rightEnd, G, u, v)
proof
  intros A start closed
  have closedF : ClosedUnder(leftEnd, rightEnd, F, A)
    intros e edge
    have inG := subset with e, edge
    exact closed with e, inG
  exact joined with A, start, closedF

-- A vertex outside V is closed off on its own, so it is joined to nothing else.
theorem Joined.start_in (V leftEnd rightEnd F u v : Set)
  requires ends : ∀ e ∈ F, leftEnd(e) ∈ V ∧ rightEnd(e) ∈ V
  requires distinct : u ≠ v
  requires joined : Joined(leftEnd, rightEnd, F, u, v)
  shows u ∈ V
proof
  by_contra outside
  have closed : ClosedUnder(leftEnd, rightEnd, F, {u})
    intros e edge
    have bounds := ends with e, edge
    constructor
    . intro left
      have equal := singleton.membership.forward with left
      have leftIn := bounds.left
      rw equal at leftIn
      exfalso
      exact outside with leftIn
    . intro right
      have equal := singleton.membership.forward with right
      have rightIn := bounds.right
      rw equal at rightIn
      exfalso
      exact outside with rightIn
  have self := singleton.self at u
  have reached := joined with {u}, self, closed
  have equal := singleton.membership.forward with reached
  symm at equal
  exact distinct with equal

-- A single non-loop edge has odd degree exactly at its two ends.
theorem degreeIn.single_parity (leftEnd rightEnd e : Set)
  requires distinct : leftEnd(e) ≠ rightEnd(e)
  shows ∀ x, (Even(degreeIn(leftEnd, rightEnd, {e}, x)) ↔
    (x ≠ leftEnd(e) ∧ x ≠ rightEnd(e)))
proof
  intro x
  by_cases hit : x = leftEnd(e) ∨ x = rightEnd(e)
  . have atEnd : leftEnd(e) = x ∨ rightEnd(e) = x
      cases hit with onLeft | onRight
      . left
        symm at onLeft
        exact onLeft
      . right
        symm at onRight
        exact onRight
    have one := degreeIn.end at leftEnd, rightEnd, e, x with distinct, atEnd
    rw one
    have odd := Even.not_one
    tauto
  . have notLeft : leftEnd(e) ≠ x
      intro equal
      symm at equal
      apply hit
      left
      exact equal
    have notRight : rightEnd(e) ≠ x
      intro equal
      symm at equal
      apply hit
      right
      exact equal
    have zero := degreeIn.absent at leftEnd, rightEnd, e, x
      with notLeft, notRight
    rw zero
    have even := Even.zero
    tauto

-- The vertices reached from u by a path along F, with u itself.
def pathReached (V leftEnd rightEnd F u : Set) : Set :=
  { w ∈ V | w = u ∨ ∃ P ⊆ F, ∀ x ∈ V,
    (Even(degreeIn(leftEnd, rightEnd, P, x)) ↔ (x ≠ u ∧ x ≠ w)) }

-- Adding an edge ab to a path from u to a cancels the odd degree at a.
theorem parity.exchange (x u a b : Set)
  requires first : a ≠ u
  requires second : a ≠ b
  requires third : b ≠ u
  shows ((x ≠ u ∧ x ≠ a) ↔ (x ≠ a ∧ x ≠ b)) ↔
    (x ≠ u ∧ x ≠ b)
proof
  have ua : x = u → x = a → ⊥ by intros h1 h2; cc
  have ab : x = a → x = b → ⊥ by intros h1 h2; cc
  have bu : x = b → x = u → ⊥ by intros h1 h2; cc
  tauto

-- An edge with ends a and b carries a path from u to a on to b: the edge
-- alone when a = u, and otherwise the symmetric difference with the edge.
theorem pathReached.step (V leftEnd rightEnd F u e a b : Set)
  requires finite : Finite(F)
  requires edge : e ∈ F
  requires distinct : a ≠ b
  requires vertex : b ∈ V
  requires parity : ∀ x, (Even(degreeIn(leftEnd, rightEnd, {e}, x)) ↔
    (x ≠ a ∧ x ≠ b))
  requires reached : a ∈ pathReached(V, leftEnd, rightEnd, F, u)
  shows b ∈ pathReached(V, leftEnd, rightEnd, F, u)
proof
  obtain ⟨_, alternatives⟩ := pathReached.membership.forward with reached
  apply pathReached.membership.backward
  constructor
  . exact vertex
  by_cases start : a = u
  . right
    witness {e}
    constructor
    . intros f member
      have equal := singleton.membership.forward with member
      rw equal
      exact edge
    . intros x inV
      have single := parity with x
      rw start at single
      exact single
  . by_cases finish : b = u
    . left
      exact finish
    . have path : ∃ P ⊆ F, ∀ x ∈ V,
        (Even(degreeIn(leftEnd, rightEnd, P, x)) ↔ (x ≠ u ∧ x ≠ a))
        cases alternatives with same | path
        . exfalso
          exact start with same
        . exact path
      obtain ⟨P, subset, parityP⟩ := path
      right
      witness P △ {e}
      constructor
      . intros f member
        have split := symmetricDifference.membership.forward with member
        by_cases inP : f ∈ P
        . exact subset with f, inP
        . have inSingle : f ∈ {e} by tauto
          have equal := singleton.membership.forward with inSingle
          rw equal
          exact edge
      . intros x inV
        have finiteP := Finite.subset at P, F with finite, subset
        have finiteSingle := Finite.singleton at e
        have combined := degreeIn.symmetricDifference_parity at leftEnd,
          rightEnd, P, {e}, x with finiteP, finiteSingle
        have atP := parityP with x, inV
        have atEdge := parity with x
        have exchange := parity.exchange at x, u, a, b
          with start, distinct, finish
        rw combined
        tauto

theorem pathReached.closed (V leftEnd rightEnd F u : Set)
  requires finite : Finite(F)
  requires ends : ∀ e ∈ F, leftEnd(e) ∈ V ∧ rightEnd(e) ∈ V
  shows ClosedUnder(leftEnd, rightEnd, F,
    pathReached(V, leftEnd, rightEnd, F, u))
proof
  intros e edge
  have bounds := ends with e, edge
  by_cases loop : leftEnd(e) = rightEnd(e)
  . rw loop
    tauto
  . have parity := degreeIn.single_parity at leftEnd, rightEnd, e with loop
    have flipped : ∀ x, (Even(degreeIn(leftEnd, rightEnd, {e}, x)) ↔
        (x ≠ rightEnd(e) ∧ x ≠ leftEnd(e)))
      intro x
      have direct := parity with x
      tauto
    have reverse : rightEnd(e) ≠ leftEnd(e)
      intro equal
      symm at equal
      exact loop with equal
    constructor
    . intro reached
      exact pathReached.step at V, leftEnd, rightEnd, F, u, e, leftEnd(e),
        rightEnd(e) with finite, edge, loop, bounds.right, parity, reached
    . intro reached
      exact pathReached.step at V, leftEnd, rightEnd, F, u, e, rightEnd(e),
        leftEnd(e) with finite, edge, reverse, bounds.left, flipped, reached

-- Along edges of F, a vertex joined to u is reached by a path from u: an edge
-- set P ⊆ F whose degrees are odd exactly at u and v when u ≠ v.
theorem Joined.path (V leftEnd rightEnd F u v : Set)
  requires finite : Finite(F)
  requires ends : ∀ e ∈ F, leftEnd(e) ∈ V ∧ rightEnd(e) ∈ V
  requires distinct : u ≠ v
  requires joined : Joined(leftEnd, rightEnd, F, u, v)
  shows ∃ P ⊆ F, ∀ w ∈ V, (Even(degreeIn(leftEnd, rightEnd, P, w)) ↔ (w ≠ u ∧ w ≠ v))
proof
  have start := Joined.start_in at V, leftEnd, rightEnd, F, u, v with *
  have closed := pathReached.closed at V, leftEnd, rightEnd, F, u
    with finite, ends
  have self : u ∈ pathReached(V, leftEnd, rightEnd, F, u)
    apply pathReached.membership.backward
    constructor
    . exact start
    . left
      rfl
  have reached := joined with pathReached(V, leftEnd, rightEnd, F, u),
    self, closed
  obtain ⟨_, alternatives⟩ := pathReached.membership.forward with reached
  cases alternatives with same | path
  . exfalso
    symm at same
    exact distinct with same
  . exact path

theorem componentBy.closed (V leftEnd rightEnd F u : Set)
  requires ends : ∀ e ∈ F, leftEnd(e) ∈ V ∧ rightEnd(e) ∈ V
  shows ClosedUnder(leftEnd, rightEnd, F, componentBy(V, leftEnd, rightEnd, F, u))
proof
  intros e edge
  have bounds := ends with e, edge
  constructor
  . intro left
    obtain ⟨_, joined⟩ := componentBy.membership.forward with left
    have across := Joined.of_edge at leftEnd, rightEnd, F, e with edge
    have further := Joined.transitive at leftEnd, rightEnd, F, u, leftEnd(e),
      rightEnd(e) with joined, across
    exact componentBy.membership.backward with ⟨bounds.right, further⟩
  . intro right
    obtain ⟨_, joined⟩ := componentBy.membership.forward with right
    have back := Joined.of_edge_reverse at leftEnd, rightEnd, F, e with edge
    have further := Joined.transitive at leftEnd, rightEnd, F, u, rightEnd(e),
      leftEnd(e) with joined, back
    exact componentBy.membership.backward with ⟨bounds.left, further⟩

-- The edges of F with both ends in X.
def inside (leftEnd rightEnd F X : Set) : Set := { e ∈ F | leftEnd(e) ∈ X ∧ rightEnd(e) ∈ X }

-- A partition of V: nonempty classes, pairwise disjoint, covering V.
predicate Partition (V P : Set) :=
  (∀ X ∈ P, X ⊆ V ∧ X ≠ ∅) ∧ (∀ X ∈ P, ∀ Y ∈ P, X ≠ Y → Disjoint(X, Y)) ∧ (∀ v ∈ V, ∃ X ∈ P, v ∈ X)

def classesContaining (P v : Set) : Set := { X ∈ P | v ∈ X }
def classOf (P v : Set) : Set := ⋃(classesContaining(P, v))

-- A class containing v is the only class containing v, so it is classOf(P, v).
theorem classOf.eq_of_member (P v X : Set)
  requires apart : ∀ X ∈ P, ∀ Y ∈ P, X ≠ Y → Disjoint(X, Y)
  requires class : X ∈ P
  requires member : v ∈ X
  shows classOf(P, v) = X
proof
  unfold classOf
  ext z
  constructor
  . intro inUnion
    obtain ⟨Y, inFamily, inY⟩ := union.membership.forward with inUnion
    obtain ⟨classY, vInY⟩ := classesContaining.membership.forward
      with inFamily
    have same : X = Y
      by_contra different
      have disjoint := apart with X, class, Y, classY, different
      have separated := Disjoint.iff.forward with disjoint
      exact separated with v, member, vInY
    rw same
    exact inY
  . intro inX
    apply union.membership.backward
    witness X
    constructor
    . exact classesContaining.membership.backward with ⟨class, member⟩
    . exact inX

theorem classOf.member (V P v : Set)
  requires partition : Partition(V, P)
  requires vertex : v ∈ V
  shows classOf(P, v) ∈ P ∧ v ∈ classOf(P, v)
proof
  rcases partition with ⟨classes, apart, cover⟩
  obtain ⟨X, class, member⟩ := cover with v, vertex
  have equal := classOf.eq_of_member at P, v, X with apart, class, member
  rw equal
  exact ⟨class, member⟩

theorem classOf.eq_iff (V P u v : Set)
  requires partition : Partition(V, P)
  requires first : u ∈ V
  requires second : v ∈ V
  shows classOf(P, u) = classOf(P, v) ↔ (∃ X ∈ P, u ∈ X ∧ v ∈ X)
proof
  rcases partition with ⟨classes, apart, cover⟩
  constructor
  . intro equal
    obtain ⟨X, classX, uInX⟩ := cover with u, first
    obtain ⟨Y, classY, vInY⟩ := cover with v, second
    have classU := classOf.eq_of_member at P, u, X with apart, classX, uInX
    have classV := classOf.eq_of_member at P, v, Y with apart, classY, vInY
    witness X
    constructor
    . exact classX
    . constructor
      . exact uInX
      . rw [← classU, equal, classV]
        exact vInY
  . intro common
    obtain ⟨X, class, uInX, vInX⟩ := common
    have classU := classOf.eq_of_member at P, u, X with apart, class, uInX
    have classV := classOf.eq_of_member at P, v, X with apart, class, vInX
    rw [classU, classV]
    rfl

theorem componentBy.eq_of_joined (V leftEnd rightEnd F u w : Set)
  requires ends : ∀ e ∈ F, leftEnd(e) ∈ V ∧ rightEnd(e) ∈ V
  requires first : u ∈ V
  requires second : w ∈ V
  requires joined : Joined(leftEnd, rightEnd, F, u, w)
  shows componentBy(V, leftEnd, rightEnd, F, u) =
    componentBy(V, leftEnd, rightEnd, F, w)
proof
  have back := Joined.symmetric at V, leftEnd, rightEnd, F, u, w with *
  ext z
  constructor
  . intro member
    obtain ⟨inV, fromU⟩ := componentBy.membership.forward with member
    have fromW := Joined.transitive at leftEnd, rightEnd, F, w, u, z
      with back, fromU
    exact componentBy.membership.backward with ⟨inV, fromW⟩
  . intro member
    obtain ⟨inV, fromW⟩ := componentBy.membership.forward with member
    have fromU := Joined.transitive at leftEnd, rightEnd, F, u, w, z
      with joined, fromW
    exact componentBy.membership.backward with ⟨inV, fromU⟩

theorem componentsBy.partition (V leftEnd rightEnd F : Set)
  requires ends : ∀ e ∈ F, leftEnd(e) ∈ V ∧ rightEnd(e) ∈ V
  shows Partition(V, componentsBy(V, leftEnd, rightEnd, F))
proof
  constructor
  . intros X inFamily
    obtain ⟨u, inV, rfl⟩ := componentsBy.membership.forward with inFamily
    constructor
    . intros w member
      obtain ⟨wInV, _⟩ := componentBy.membership.forward with member
      exact wInV
    . have self := Joined.reflexive at leftEnd, rightEnd, F, u
      have inhabited : Nonempty(componentBy(V, leftEnd, rightEnd, F, u))
        witness u
        exact componentBy.membership.backward with ⟨inV, self⟩
      exact Nonempty.ne_empty with inhabited
  constructor
  . intros X inFamilyX Y inFamilyY different
    obtain ⟨u, uInV, rfl⟩ := componentsBy.membership.forward with inFamilyX
    obtain ⟨w, wInV, rfl⟩ := componentsBy.membership.forward with inFamilyY
    apply Disjoint.iff.backward
    intros x inU inW
    obtain ⟨xInV, fromU⟩ := componentBy.membership.forward with inU
    obtain ⟨_, fromW⟩ := componentBy.membership.forward with inW
    have back := Joined.symmetric at V, leftEnd, rightEnd, F, w, x with *
    have joined := Joined.transitive at leftEnd, rightEnd, F, u, x, w
      with fromU, back
    apply different
    exact componentBy.eq_of_joined at V, leftEnd, rightEnd, F, u, w with *
  . intros v inV
    witness componentBy(V, leftEnd, rightEnd, F, v)
    constructor
    . apply componentsBy.membership.backward
      witness v
      constructor
      . exact inV
      . rfl
    . have self := Joined.reflexive at leftEnd, rightEnd, F, v
      exact componentBy.membership.backward with ⟨inV, self⟩

-- The quotient of a partition refines another when every class of the first
-- lies in a class of the second.
predicate Refines (P Q : Set) := ∀ X ∈ P, ∃ Y ∈ Q, X ⊆ Y

-- The quotient multigraph: the vertices are the classes, and an edge joins the
-- classes of its ends. Edges inside a class become loops; crossingClasses are
-- the edges joining distinct classes.
def quotientEnd (E P endpoint : Set) : Set :=
  { p ∈ E × P | ∃ e ∈ E, p = (e, classOf(P, endpoint(e))) }

def crossingClasses (P leftEnd rightEnd F : Set) : Set :=
  { e ∈ F | classOf(P, leftEnd(e)) ≠ classOf(P, rightEnd(e)) }

theorem quotientEnd.relates (E P endpoint e X : Set)
  requires related : relates(quotientEnd(E, P, endpoint), e, X)
  shows e ∈ E ∧ X = classOf(P, endpoint(e))
proof
  have member : (e, X) ∈ quotientEnd(E, P, endpoint) := related
  obtain ⟨_, f, inE, equation⟩ := quotientEnd.membership.forward with member
  obtain ⟨same, value⟩ := orderedPair.injective with equation
  rw same
  exact ⟨inE, value⟩

theorem quotientEnd.relates_class (V E P endpoint e : Set)
  requires function : endpoint : E → V
  requires partition : Partition(V, P)
  requires edge : e ∈ E
  shows relates(quotientEnd(E, P, endpoint), e, classOf(P, endpoint(e)))
proof
  have vertex := FunctionBetween.apply_closed at endpoint, E, V, e
    with function, edge
  obtain ⟨class, _⟩ := classOf.member at V, P, endpoint(e)
    with partition, vertex
  have pairIn := product.pair at e, classOf(P, endpoint(e)), E, P
    with edge, class
  have member : (e, classOf(P, endpoint(e))) ∈ quotientEnd(E, P, endpoint)
    apply quotientEnd.membership.backward
    constructor
    . exact pairIn
    . witness e
      constructor
      . exact edge
      . rfl
  exact member

theorem quotientEnd.function (V E P endpoint : Set)
  requires function : endpoint : E → V
  requires partition : Partition(V, P)
  shows quotientEnd(E, P, endpoint) : E → P
proof
  constructor
  . unfold RelationBetween
    intros p member
    obtain ⟨inProduct, _⟩ := quotientEnd.membership.forward with member
    exact inProduct
  constructor
  . intros x y relatedY z relatedZ
    obtain ⟨_, valueY⟩ := quotientEnd.relates at E, P, endpoint, x, y
      with relatedY
    obtain ⟨_, valueZ⟩ := quotientEnd.relates at E, P, endpoint, x, z
      with relatedZ
    rw [valueY, valueZ]
    rfl
  . intros x edge
    have vertex := FunctionBetween.apply_closed at endpoint, E, V, x
      with function, edge
    obtain ⟨class, _⟩ := classOf.member at V, P, endpoint(x)
      with partition, vertex
    witness classOf(P, endpoint(x))
    constructor
    . exact class
    . exact quotientEnd.relates_class at V, E, P, endpoint, x
        with function, partition, edge

theorem quotientEnd.graph (V E P leftEnd rightEnd : Set)
  requires graph : Graph(V, E, leftEnd, rightEnd)
  requires partition : Partition(V, P)
  shows Graph(P, E, quotientEnd(E, P, leftEnd), quotientEnd(E, P, rightEnd))
proof
  rcases graph with ⟨leftMap, rightMap⟩
  constructor
  . exact quotientEnd.function at V, E, P, leftEnd with leftMap, partition
  . exact quotientEnd.function at V, E, P, rightEnd with rightMap, partition

theorem quotientEnd.value (V E P leftEnd rightEnd e : Set)
  requires graph : Graph(V, E, leftEnd, rightEnd)
  requires partition : Partition(V, P)
  requires edge : e ∈ E
  shows quotientEnd(E, P, leftEnd)(e) = classOf(P, leftEnd(e)) ∧
    quotientEnd(E, P, rightEnd)(e) = classOf(P, rightEnd(e))
proof
  rcases graph with ⟨leftMap, rightMap⟩
  have leftFunction := quotientEnd.function at V, E, P, leftEnd
    with leftMap, partition
  have rightFunction := quotientEnd.function at V, E, P, rightEnd
    with rightMap, partition
  have leftRelated := quotientEnd.relates_class at V, E, P, leftEnd, e
    with leftMap, partition, edge
  have rightRelated := quotientEnd.relates_class at V, E, P, rightEnd, e
    with rightMap, partition, edge
  constructor
  . exact FunctionBetween.apply_value at quotientEnd(E, P, leftEnd), E, P, e,
      classOf(P, leftEnd(e)) with leftFunction, edge, leftRelated
  . exact FunctionBetween.apply_value at quotientEnd(E, P, rightEnd), E, P, e,
      classOf(P, rightEnd(e)) with rightFunction, edge, rightRelated

-- A vertex lies in a union of classes exactly when its class is one of them.
theorem classOf.mem_union_iff (V P Y v : Set)
  requires partition : Partition(V, P)
  requires subfamily : Y ⊆ P
  requires vertex : v ∈ V
  shows v ∈ ⋃(Y) ↔ classOf(P, v) ∈ Y
proof
  rcases partition with ⟨classes, apart, cover⟩
  obtain ⟨X, class, member⟩ := cover with v, vertex
  have equal := classOf.eq_of_member at P, v, X with apart, class, member
  rw equal
  constructor
  . intro inUnion
    obtain ⟨Z, inY, inZ⟩ := union.membership.forward with inUnion
    have classZ := subfamily with Z, inY
    have same := classOf.eq_of_member at P, v, Z with apart, classZ, inZ
    rw equal at same
    rw same
    exact inY
  . intro inY
    apply union.membership.backward
    witness X
    constructor
    . exact inY
    . exact member

-- Edges within a class contribute nothing to crossing a union of classes, so
-- crossing in the quotient is crossing in the graph.
theorem crossing.quotient (V E P leftEnd rightEnd F Y : Set)
  requires graph : Graph(V, E, leftEnd, rightEnd)
  requires partition : Partition(V, P)
  requires edges : F ⊆ E
  requires classes : Y ⊆ P
  shows crossing(quotientEnd(E, P, leftEnd), quotientEnd(E, P, rightEnd), F, Y) =
    crossing(leftEnd, rightEnd, F, ⋃(Y))
proof
  rcases graph with ⟨leftMap, rightMap⟩
  ext e
  rw [crossing.membership, crossing.membership]
  by_cases inF : e ∈ F
  . have inE := edges with e, inF
    have values := quotientEnd.value at V, E, P, leftEnd, rightEnd, e
      with ⟨leftMap, rightMap⟩, partition, inE
    rcases values with ⟨leftValue, rightValue⟩
    rw [leftValue, rightValue]
    have leftIn := FunctionBetween.apply_closed at leftEnd, E, V, e
      with leftMap, inE
    have rightIn := FunctionBetween.apply_closed at rightEnd, E, V, e
      with rightMap, inE
    have leftIff := classOf.mem_union_iff at V, P, Y, leftEnd(e)
      with partition, classes, leftIn
    have rightIff := classOf.mem_union_iff at V, P, Y, rightEnd(e)
      with partition, classes, rightIn
    rw [leftIff, rightIff]
    tauto
  . tauto

-- F connects the classes of P in the quotient when its crossing edges do.
theorem Connects.quotient_iff (V E P leftEnd rightEnd F : Set)
  requires graph : Graph(V, E, leftEnd, rightEnd)
  requires partition : Partition(V, P)
  requires edges : F ⊆ E
  shows Connects(P, quotientEnd(E, P, leftEnd), quotientEnd(E, P, rightEnd), F) ↔
    Connects(P, quotientEnd(E, P, leftEnd), quotientEnd(E, P, rightEnd), crossingClasses(P, leftEnd, rightEnd, F))
proof
  have crossingSubset : crossingClasses(P, leftEnd, rightEnd, F) ⊆ F
    intros e member
    obtain ⟨inF, _⟩ := crossingClasses.membership.forward with member
    exact inF
  constructor
  . intro connected
    intros X classX Y classY
    have joined := connected with X, classX, Y, classY
    intros A start closed
    -- An edge inside a class is a loop of the quotient, so it never leaves A.
    have closedF : ClosedUnder(quotientEnd(E, P, leftEnd),
        quotientEnd(E, P, rightEnd), F, A)
      intros e inF
      by_cases crosses : classOf(P, leftEnd(e)) ≠ classOf(P, rightEnd(e))
      . have member := crossingClasses.membership.backward at P, leftEnd,
          rightEnd, F, e with ⟨inF, crosses⟩
        exact closed with e, member
      . have inE := edges with e, inF
        have values := quotientEnd.value at V, E, P, leftEnd, rightEnd, e
          with graph, partition, inE
        rcases values with ⟨leftValue, rightValue⟩
        have same : classOf(P, leftEnd(e)) = classOf(P, rightEnd(e)) by tauto
        rw [leftValue, rightValue, same]
        tauto
    exact joined with A, start, closedF
  . intro connected
    intros X classX Y classY
    have joined := connected with X, classX, Y, classY
    exact Joined.monotone at quotientEnd(E, P, leftEnd),
      quotientEnd(E, P, rightEnd), crossingClasses(P, leftEnd, rightEnd, F),
      F, X, Y with crossingSubset, joined
