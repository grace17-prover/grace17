{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grace17.org/schemas/machine-interface.schema.json",
  "title": "Grace17 machine interface, protocol version 1",
  "description": "Requests and responses of `g17 serve` and the result objects of the method subcommands. See docs/machine-interface.md.",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/response"
    }
  ],
  "$defs": {
    "id": {
      "type": [
        "string",
        "integer",
        "null"
      ]
    },
    "request": {
      "type": "object",
      "required": [
        "method"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "method": {
          "enum": [
            "capabilities",
            "check",
            "goal",
            "suggest",
            "search",
            "declaration",
            "signature",
            "elaborate",
            "audit",
            "library",
            "notations",
            "pin"
          ]
        },
        "params": {
          "type": "object"
        }
      }
    },
    "response": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "id",
            "version",
            "ok",
            "method",
            "result"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "version": {
              "type": "string"
            },
            "ok": {
              "const": true
            },
            "method": {
              "type": "string"
            },
            "result": {
              "oneOf": [
                {
                  "$ref": "#/$defs/capabilitiesResult"
                },
                {
                  "$ref": "#/$defs/checkResult"
                },
                {
                  "$ref": "#/$defs/goalResult"
                },
                {
                  "$ref": "#/$defs/suggestResult"
                },
                {
                  "$ref": "#/$defs/searchResult"
                },
                {
                  "$ref": "#/$defs/declarationResult"
                },
                {
                  "$ref": "#/$defs/signatureResult"
                },
                {
                  "$ref": "#/$defs/elaborateResult"
                },
                {
                  "$ref": "#/$defs/auditResult"
                },
                {
                  "$ref": "#/$defs/auditsResult"
                },
                {
                  "$ref": "#/$defs/libraryResult"
                },
                {
                  "$ref": "#/$defs/notationsResult"
                },
                {
                  "$ref": "#/$defs/pinResult"
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "id",
            "version",
            "ok",
            "error"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "version": {
              "type": "string"
            },
            "ok": {
              "const": false
            },
            "method": {
              "type": "string"
            },
            "error": {
              "$ref": "#/$defs/error"
            }
          }
        }
      ]
    },
    "error": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "enum": [
            "invalid_request",
            "unknown_method",
            "invalid_params",
            "unknown_file",
            "check_failed",
            "no_theorem_at_position",
            "after_failure",
            "dependency_failed",
            "no_proof_block",
            "bad_query",
            "unknown_declaration",
            "ambiguous_name",
            "unknown_theorem",
            "unknown_module",
            "elaboration_failed",
            "surface",
            "kernel",
            "internal"
          ]
        },
        "message": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer"
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "modules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "declarations": {
          "type": "array",
          "description": "For ambiguous_name: each candidate with the module that declares it.",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "module": {
                "type": "string"
              },
              "file": {
                "type": "string"
              },
              "line": {
                "type": "integer"
              }
            }
          }
        },
        "import": {
          "type": "string",
          "description": "The module that declares the name or its prefix."
        },
        "failureFile": {
          "type": "string"
        },
        "failureLine": {
          "type": "integer"
        },
        "theorem": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        }
      }
    },
    "file": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      }
    },
    "foundation": {
      "enum": [
        "ZF",
        "ZFC",
        "ZFG"
      ]
    },
    "workspaceParams": {
      "type": "object",
      "required": [
        "files"
      ],
      "properties": {
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/file"
          }
        },
        "activeFile": {
          "type": "string"
        },
        "foundation": {
          "$ref": "#/$defs/foundation"
        },
        "moduleRoots": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "checkParams": {
      "allOf": [
        {
          "$ref": "#/$defs/workspaceParams"
        },
        {
          "properties": {
            "audit": {
              "type": "boolean",
              "default": false
            },
            "dependencies": {
              "type": "boolean",
              "default": true
            },
            "kernel": {
              "type": "boolean",
              "default": false
            },
            "symbols": {
              "type": "boolean",
              "default": false
            },
            "digest": {
              "type": "boolean",
              "default": false
            }
          }
        }
      ]
    },
    "positionParams": {
      "allOf": [
        {
          "$ref": "#/$defs/workspaceParams"
        },
        {
          "required": [
            "line"
          ],
          "properties": {
            "file": {
              "type": "string"
            },
            "line": {
              "type": "integer",
              "minimum": 1
            },
            "column": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          }
        }
      ]
    },
    "suggestParams": {
      "allOf": [
        {
          "$ref": "#/$defs/positionParams"
        },
        {
          "required": [
            "tactic"
          ],
          "properties": {
            "tactic": {
              "enum": [
                "exact?",
                "apply?",
                "rw?",
                "exact",
                "apply",
                "rw"
              ]
            }
          }
        }
      ]
    },
    "searchParams": {
      "type": "object",
      "required": [
        "query"
      ],
      "properties": {
        "query": {
          "type": "string",
          "maxLength": 1024
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/file"
          }
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200,
          "default": 60
        }
      }
    },
    "declarationParams": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "module": {
          "type": "string"
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/file"
          }
        },
        "activeFile": {
          "type": "string"
        },
        "foundation": {
          "$ref": "#/$defs/foundation"
        },
        "moduleRoots": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "description": "A name with a workspace, a module, or neither; a generated name without either loads the module of its longest named prefix."
    },
    "auditParams": {
      "allOf": [
        {
          "$ref": "#/$defs/workspaceParams"
        },
        {
          "properties": {
            "theorem": {
              "type": "string"
            },
            "theorems": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          },
          "anyOf": [
            {
              "required": [
                "theorem"
              ]
            },
            {
              "required": [
                "theorems"
              ]
            }
          ]
        }
      ]
    },
    "libraryParams": {
      "type": "object",
      "properties": {
        "area": {
          "type": "string"
        },
        "module": {
          "type": "string"
        },
        "declarations": {
          "type": "boolean"
        }
      }
    },
    "notationsParams": {
      "type": "object",
      "properties": {
        "module": {
          "type": "string"
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/file"
          }
        },
        "activeFile": {
          "type": "string"
        },
        "foundation": {
          "$ref": "#/$defs/foundation"
        },
        "moduleRoots": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "capabilitiesResult": {
      "type": "object",
      "required": [
        "protocol",
        "grace17",
        "methods",
        "foundations"
      ],
      "properties": {
        "protocol": {
          "type": "string"
        },
        "grace17": {
          "type": "string"
        },
        "methods": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "description"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            }
          }
        },
        "foundations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/foundation"
          }
        },
        "pinned": {
          "type": "boolean"
        }
      }
    },
    "local": {
      "type": "object",
      "required": [
        "name",
        "formula"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "formula": {
          "type": "string"
        }
      }
    },
    "goal": {
      "type": "object",
      "required": [
        "goal",
        "assumptions",
        "locals"
      ],
      "properties": {
        "goal": {
          "type": "string"
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "locals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/local"
          }
        }
      }
    },
    "state": {
      "type": "object",
      "required": [
        "goals"
      ],
      "properties": {
        "goals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/goal"
          }
        }
      }
    },
    "suggestion": {
      "type": "object",
      "required": [
        "command",
        "tactic",
        "name",
        "reference",
        "source",
        "arguments",
        "premises",
        "closes"
      ],
      "properties": {
        "command": {
          "type": "string"
        },
        "tactic": {
          "enum": [
            "exact",
            "apply",
            "rw"
          ]
        },
        "name": {
          "type": "string"
        },
        "reference": {
          "type": "string"
        },
        "source": {
          "enum": [
            "local",
            "theorem",
            "axiom",
            "definition"
          ]
        },
        "arguments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "premises": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "formula"
            ],
            "properties": {
              "formula": {
                "type": "string"
              },
              "evidence": {
                "type": "string"
              },
              "routine": {
                "type": "boolean"
              }
            }
          }
        },
        "closes": {
          "type": "boolean"
        },
        "reverse": {
          "type": "boolean"
        },
        "goal": {
          "type": "string"
        }
      }
    },
    "stepInfo": {
      "type": "object",
      "required": [
        "title",
        "items"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "suggestions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/suggestion"
          }
        }
      }
    },
    "step": {
      "type": "object",
      "required": [
        "line",
        "command",
        "before",
        "after"
      ],
      "properties": {
        "line": {
          "type": "integer"
        },
        "columnStart": {
          "type": "integer"
        },
        "columnEnd": {
          "type": "integer"
        },
        "command": {
          "type": "string"
        },
        "info": {
          "$ref": "#/$defs/stepInfo"
        },
        "before": {
          "$ref": "#/$defs/state"
        },
        "after": {
          "$ref": "#/$defs/state"
        }
      }
    },
    "sorry": {
      "type": "object",
      "required": [
        "file",
        "theorem",
        "axiom",
        "line",
        "goal"
      ],
      "properties": {
        "file": {
          "type": "string"
        },
        "theorem": {
          "type": "string"
        },
        "axiom": {
          "type": "string"
        },
        "line": {
          "type": "integer"
        },
        "goal": {
          "type": "string"
        }
      }
    },
    "proofMapEntry": {
      "type": "object",
      "required": [
        "line",
        "indent",
        "kind",
        "text"
      ],
      "properties": {
        "line": {
          "type": "integer"
        },
        "indent": {
          "type": "integer"
        },
        "kind": {
          "enum": [
            "heading",
            "note"
          ]
        },
        "text": {
          "type": "string"
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "required": [
        "severity",
        "kind",
        "file",
        "line",
        "column",
        "endColumn",
        "message"
      ],
      "properties": {
        "severity": {
          "enum": [
            "error",
            "warning"
          ]
        },
        "kind": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer"
        },
        "column": {
          "type": "integer"
        },
        "endColumn": {
          "type": "integer"
        },
        "message": {
          "type": "string"
        },
        "theorem": {
          "type": "string"
        }
      }
    },
    "theorem": {
      "type": "object",
      "required": [
        "file",
        "lineStart",
        "lineEnd",
        "status",
        "sorries",
        "proofMap",
        "steps"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "lineStart": {
          "type": "integer"
        },
        "lineEnd": {
          "type": "integer"
        },
        "status": {
          "enum": [
            "proved",
            "admitted",
            "failed"
          ]
        },
        "statement": {
          "type": "string"
        },
        "sorries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sorry"
          }
        },
        "dependencies": {
          "type": "object",
          "properties": {
            "axioms": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "theorems": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "definitions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "proofMap": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/proofMapEntry"
          }
        },
        "initial": {
          "$ref": "#/$defs/state"
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "kind", "line"],
            "properties": {
              "name": { "type": "string" },
              "kind": { "type": "string", "enum": ["section variable", "section hypothesis", "binder", "premise"] },
              "line": { "type": "integer" },
              "sort": { "type": "string" }
            }
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "audit": {
          "$ref": "#/$defs/auditResult"
        },
        "proofNodes": {
          "type": "integer"
        },
        "judgments": {
          "type": "integer"
        },
        "kernel": {
          "type": "array"
        },
        "canonical": {
          "type": "string"
        }
      }
    },
    "foundationReport": {
      "type": "object",
      "required": [
        "profile"
      ],
      "properties": {
        "profile": {
          "$ref": "#/$defs/foundation"
        },
        "axioms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "schemaInstances": {
          "type": "object"
        }
      }
    },
    "fileSummary": {
      "type": "object",
      "required": [
        "name",
        "status"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "module": {
          "type": "string"
        },
        "status": {
          "enum": [
            "checked",
            "context",
            "failed",
            "unchecked"
          ]
        },
        "definitions": {
          "type": "integer"
        },
        "theorems": {
          "type": "integer"
        },
        "evaluations": {
          "type": "integer"
        },
        "sorries": {
          "type": "integer"
        },
        "admittedSorries": {
          "type": "integer"
        }
      }
    },
    "loadedModule": {
      "type": "object",
      "required": [
        "file",
        "definitions",
        "theorems",
        "evaluations",
        "sorries"
      ],
      "properties": {
        "file": {
          "type": "string"
        },
        "module": {
          "type": "string"
        },
        "definitions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "theorems": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "theoremLocations": {
          "type": "array"
        },
        "evaluations": {
          "type": "array"
        },
        "sorries": {
          "type": "array"
        }
      }
    },
    "notation": {
      "type": "object",
      "required": [
        "token",
        "precedence",
        "associativity",
        "kind",
        "reversed",
        "target"
      ],
      "properties": {
        "token": {
          "type": "string"
        },
        "precedence": {
          "type": "integer"
        },
        "fixity": {
          "type": "string"
        },
        "associativity": {
          "enum": [
            "left",
            "right",
            "none"
          ]
        },
        "kind": {
          "enum": [
            "function",
            "predicate"
          ]
        },
        "reversed": {
          "type": "boolean"
        },
        "target": {
          "type": "string"
        },
        "module": {
          "type": "string"
        },
        "operandType": {
          "type": "string"
        },
        "leftOperandType": {
          "type": "string"
        },
        "rightOperandType": {
          "type": "string"
        },
        "resultType": {
          "type": "string"
        },
        "parameters": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "index": {
          "type": "string"
        },
        "transparent": {
          "type": "boolean"
        }
      }
    },
    "checkResult": {
      "type": "object",
      "required": [
        "status",
        "foundation",
        "files",
        "checked",
        "modules",
        "notations",
        "theorems",
        "diagnostics",
        "sorries",
        "evaluations"
      ],
      "properties": {
        "status": {
          "enum": [
            "checked",
            "failed"
          ]
        },
        "foundation": {
          "$ref": "#/$defs/foundationReport"
        },
        "context": {
          "enum": [
            "workspace",
            "bootstrap"
          ]
        },
        "milliseconds": {
          "type": "number"
        },
        "digest": {
          "type": "string"
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fileSummary"
          }
        },
        "checked": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/loadedModule"
          }
        },
        "modules": {
          "type": "array"
        },
        "notations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/notation"
          }
        },
        "theorems": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/theorem"
          }
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        },
        "sorries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sorry"
          }
        },
        "evaluations": {
          "type": "array"
        },
        "symbols": {
          "type": "array"
        },
        "failures": {
          "type": "array",
          "description": "check --continue only: one diagnostic per failed module, with its module and file.",
          "items": {
            "type": "object",
            "required": [
              "module",
              "file",
