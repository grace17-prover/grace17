-- Primitive logical reasoning over sets.

-- Closed propositions evaluate by producing a checked proof.
eval 1 in {1, 2}

theorem pair.left (x y : Set)
  shows x in pair(x, y)
proof
  have membership := pair.membership at x, y, x
  apply membership.backward
  left
  reflexivity

theorem pair.right (x y : Set)
  shows y ∈ pair(x, y)
proof
  simp

theorem equality.or_example (x y : Set)
  shows x = x or x = y
proof
  simp

theorem equality.and_example (x : Set)
  shows x = x and x = x
proof
  simp

theorem equality.exists_self (x : Set)
  shows exists y, y = x
proof
  simp

theorem membership.identity (x y : Set)
  requires x in y
  shows x in y
proof
  simp

theorem epsilon0.less.unfold (a b : Set)
  shows relates(epsilon0.less, a, b) <-> a in epsilon0 and b in epsilon0 and a in b
proof
  simp
