module RationalComputeStarter
import Grace.Cumulus.Rat

theorem addition_means_rational_addition (a b m c d n : Nat)
  requires first : m ≠ 0
  requires second : n ≠ 0
  shows RationalCellOps.meaning(RationalCellOps.cellAdd(
      RationalCell.fraction(a, b, m), RationalCell.fraction(c, d, n))) =
    rationalAddValue(rationalClass(a, b, m), rationalClass(c, d, n))
proof
  show RationalCellOps.meaning(RationalCellOps.cellAdd(
      RationalCell.fraction(a, b, m), RationalCell.fraction(c, d, n))) =
    rationalAddValue(rationalClass(a, b, m), rationalClass(c, d, n)) :=
      RationalCellOps.add.sound at a, b, m, c, d, n with first, second

theorem pivot_zero_iff_rational_zero (a b m : Nat)
  requires valid : m ≠ 0
  shows RationalCellOps.isZero(RationalCell.fraction(a, b, m)) = Bool.true ↔
    RationalCellOps.meaning(RationalCell.fraction(a, b, m)) = rationalZero
proof
  exact RationalCellOps.isZero.quotient_iff with valid

theorem reverse_representative_equality (a b m c d n : Nat)
  requires first : m ≠ 0
  requires second : n ≠ 0
  requires same : rationalClass(a, b, m) = rationalClass(c, d, n)
  shows rationalClass(c, d, n) = rationalClass(a, b, m)
proof
  simp

theorem two_halves_equal_one
  shows RationalCellOps.sameValue(RationalCell.fraction(2, 0, 2),
    RationalCell.fraction(1, 0, 1)) = Bool.true
proof
  compute

theorem two_halves_quotient_one
  shows RationalCellOps.meaning(RationalCell.fraction(2, 0, 2)) =
    RationalCellOps.meaning(RationalCell.fraction(1, 0, 1))
proof
  have nonzeroTwo : 2 ≠ 0
    intro h
    have distinct := Naturals.disjoint.zero.succ at 1
    apply distinct
    rw h
    rfl
  have nonzeroOne : 1 ≠ 0
    intro h
    have distinct := Naturals.disjoint.zero.succ at 0
    apply distinct
    rw h
    rfl
  have iff := RationalCellOps.sameValue.quotient_iff at 2, 0, 2, 1, 0, 1 with
    *
  exact iff.forward with two_halves_equal_one
