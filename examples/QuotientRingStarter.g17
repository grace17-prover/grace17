module QuotientRingStarter
import Grace.Cumulus.Algebra.Ring

theorem quotient_is_ring (A add zero neg mul one I : Set)
  requires ring : IsCommRing(A, add, zero, neg, mul, one)
  requires ideal : IsIdeal(A, add, zero, neg, mul, I)
  shows IsCommRing((A ⧸ idealRelation(A, add, neg, I)),
    quotientBinary(A, idealRelation(A, add, neg, I), add),
    ⟦zero⟧[A, idealRelation(A, add, neg, I)],
    quotientUnary(A, idealRelation(A, add, neg, I), neg),
    quotientBinary(A, idealRelation(A, add, neg, I), mul),
    ⟦one⟧[A, idealRelation(A, add, neg, I)])
proof
  exact idealQuotient.comm_ring at A, add, zero, neg, mul, one, I with *

-- R/I is an integral domain precisely when I is prime.
theorem domain_iff_prime (A add zero neg mul one I : Set)
  requires ring : IsCommRing(A, add, zero, neg, mul, one)
  requires ideal : IsIdeal(A, add, zero, neg, mul, I)
  shows IsIntegralDomain((A ⧸ idealRelation(A, add, neg, I)),
    quotientBinary(A, idealRelation(A, add, neg, I), add),
    ⟦zero⟧[A, idealRelation(A, add, neg, I)],
    quotientUnary(A, idealRelation(A, add, neg, I), neg),
    quotientBinary(A, idealRelation(A, add, neg, I), mul),
    ⟦one⟧[A, idealRelation(A, add, neg, I)]) ↔
      IsPrimeIdeal(A, add, zero, neg, mul, one, I)
proof
  exact idealQuotient.domain_iff_prime at A, add, zero, neg, mul, one, I with *

-- Polynomial normalization works directly inside ideal membership.
theorem rearrange_member (A add zero neg mul one I x y : Set)
  requires ring : IsCommRing(A, add, zero, neg, mul, one)
  requires hx : x ∈ A
  requires hy : y ∈ A
  requires member : call2(add, x, y) ∈ I
  shows call2(add, y, x) ∈ I
proof
  ring_nf at member
  ring_nf
  exact member

-- Partial constructors preserve the authored nesting and leave focused goals.
theorem proof_patterns (x y : Set)
  requires h : x = x ∧ (y = y ∧ x = x)
  shows (y = y ∧ x = x) ∧ (∃ z, z = x ∧ x = x)
proof
  simp
