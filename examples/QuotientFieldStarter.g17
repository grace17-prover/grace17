module QuotientFieldStarter
import Grace.Cumulus.Algebra.Field

theorem field_iff_maximal (A add zero neg mul one I : Set)
  requires ring : IsCommRing(A, add, zero, neg, mul, one)
  requires ideal : IsIdeal(A, add, zero, neg, mul, I)
  shows IsField((A ⧸ idealRelation(A, add, neg, I)),
    quotientBinary(A, idealRelation(A, add, neg, I), add), ⟦zero⟧[A, idealRelation(A, add, neg, I)],
    quotientUnary(A, idealRelation(A, add, neg, I), neg), quotientBinary(A, idealRelation(A, add, neg, I), mul), ⟦one⟧[A, idealRelation(A, add, neg, I)]) ↔ IsMaximalIdeal(A, add, zero, neg, mul, one, I)
proof
  exact idealQuotient.is_field_iff_maximal at A, add, zero, neg, mul, one, I with *

-- Fieldness need not carry an arbitrarily supplied inverse operation.
theorem canonical_field (A add zero neg mul one : Set)
  requires structure : IsField(A, add, zero, neg, mul, one)
  shows IsFieldWithInverse(A, add, zero, neg, mul, one, fieldInverse(A, add, zero, neg, mul, one))
proof
  exact IsField.field at A, add, zero, neg, mul, one with *

theorem inverse_at_zero (A add zero neg mul one : Set)
  requires structure : IsField(A, add, zero, neg, mul, one)
  shows (fieldInverse(A, add, zero, neg, mul, one))(zero) = zero
proof
  exact fieldInverse.zero at A, add, zero, neg, mul, one with *
