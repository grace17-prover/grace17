module IntegerRingStarter
import Grace.Cumulus.Int

theorem signed_product (x y : Integer)
  shows (-x) * (-y) = x * y
proof
  ring

theorem difference_of_squares (x y : Integer)
  shows (x + y) * (x - y) = x * x - y * y
proof
  ring

theorem cancellation (x y : Integer)
  shows (x + y) + (-y) = x
proof
  ring

theorem units (x : Integer)
  shows x * 1 + 0 = x
proof
  ring

theorem cubic (x y : Integer)
  shows (x - y) * (x * x + x * y + y * y) = x * x * x - y * y * y
proof
  ring
