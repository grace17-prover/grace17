module DicksonExamples
import Grace.Cumulus.Algebra.Polynomial

theorem finite_basis (V S : Set)
  requires variables : Finite(V)
  requires monomials : S ⊆ monomials(V)
  shows ∃ B, Finite(B) ∧ B ⊆ S ∧ (∀ m ∈ S, ∃ b ∈ B, ∃ q ∈ monomials(V), monomialProduct(V, b, q) = m)
proof
  exact Dickson.finite_factor_basis at V, S with *

theorem finite_generators (V U : Set)
  requires variables : Finite(V)
  requires ideal : MonomialIdeal(V, U)
  shows ∃ B, Finite(B) ∧ B ⊆ U ∧ U = monomialSpan(V, B)
proof
  exact MonomialIdeal.finite_generated with variables, ideal

theorem finite_antichains (V S : Set)
  requires variables : Finite(V)
  requires monomials : S ⊆ monomials(V)
  requires antichain : MonomialAntichain(V, S)
  shows Finite(S)
proof
  exact Dickson.antichains_finite with variables, monomials, antichain

theorem finitely_many_minimal_elements (V S : Set)
  requires variables : Finite(V)
  requires monomials : S ⊆ monomials(V)
  shows Finite(minimalMonomials(V, S))
proof
  exact Dickson.minimal_finite with variables, monomials

theorem two_variables (x y U : Set)
  requires ideal : MonomialIdeal(insert(y, {x}), U)
  shows ∃ B, Finite(B) ∧ B ⊆ U ∧ U = monomialSpan(insert(y, {x}), B)
proof
  have singleton := Finite.singleton at x
  have variables := Finite.insert at {x}, y with singleton
  exact MonomialIdeal.finite_generated with variables, ideal
