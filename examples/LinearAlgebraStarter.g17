module LinearAlgebraStarter
import Grace.Cumulus.LinearAlgebra

theorem dot_is_symmetric (u v : Set, n : Nat)
  requires vectorsU : RealSequence(u)
  requires vectorsV : RealSequence(v)
  shows dotProduct(u, v, n) = dotProduct(v, u, n)
proof
  exact dotProduct.symmetric with vectorsU, vectorsV

theorem dot_distributes (u v w : Set, n : Nat)
  requires vectorsU : RealSequence(u)
  requires vectorsV : RealSequence(v)
  requires vectorsW : RealSequence(w)
  shows dotProduct(u, addSequence(v, w), n) =
    (dotProduct(u, v, n):R) + (dotProduct(u, w, n):R)
proof
  exact dotProduct.add_right with vectorsU, vectorsV, vectorsW

theorem squares_are_nonnegative (u : Set, n : Nat)
  requires vector : RealSequence(u)
  shows (0:R) ≤ (squaredNorm(u, n):R)
proof
  exact squaredNorm.nonnegative with vector

theorem scaling_squares (u : Set, C : Real, n : Nat)
  requires vector : RealSequence(u)
  shows squaredNorm(mulSequence(constantSequence(C), u), n) =
    (C * C) * (squaredNorm(u, n):R)
proof
  exact squaredNorm.scale with vector

theorem parallelogram_identity (u v : Set, n : Nat)
  requires vectorsU : RealSequence(u)
  requires vectorsV : RealSequence(v)
  shows (squaredNorm(addSequence(u, v), n):R) +
      (squaredNorm(subSequence(u, v), n):R) =
    (2:R) * (squaredNorm(u, n):R) +
      (2:R) * (squaredNorm(v, n):R)
proof
  exact squaredNorm.parallelogram with vectorsU, vectorsV

theorem pythagorean_identity (u v : Set, n : Nat)
  requires vectorsU : RealSequence(u)
  requires vectorsV : RealSequence(v)
  requires perpendicular : Orthogonal(u, v, n)
  shows squaredNorm(addSequence(u, v), n) =
    (squaredNorm(u, n):R) + (squaredNorm(v, n):R)
proof
  exact squaredNorm.pythagorean at u, v, n with
    vectorsU, vectorsV, perpendicular

-- A matrix is a function from pairs of natural indices to real entries.
-- The finite column cutoff n determines the part used by multiplication.
theorem matrix_entry_is_real (M : Set, i j : Nat)
  requires matrix : RealMatrix(M)
  shows Real(M[i, j])
proof
  exact RealMatrix.entry with matrix

theorem matrix_times_sum (M u v : Set, n i : Nat)
  requires matrix : RealMatrix(M)
  requires vectorsU : RealSequence(u)
  requires vectorsV : RealSequence(v)
  shows matrixVectorProduct(M, addSequence(u, v), n)[i] =
    (matrixVectorProduct(M, u, n)[i]:R) +
    (matrixVectorProduct(M, v, n)[i]:R)
proof
  exact matrixVectorProduct.add with matrix, vectorsU, vectorsV

theorem matrix_times_scalar (M u : Set, C : Real, n i : Nat)
  requires matrix : RealMatrix(M)
  requires vector : RealSequence(u)
  shows matrixVectorProduct(M, mulSequence(constantSequence(C), u), n)[i] =
    C * (matrixVectorProduct(M, u, n)[i]:R)
proof
  exact matrixVectorProduct.scale with matrix, vector

theorem matrix_ignores_later_coordinates (M u v : Set, n i : Nat)
  requires matrix : RealMatrix(M)
  requires vectorsU : RealSequence(u)
  requires vectorsV : RealSequence(v)
  requires samePrefix : ∀ k ∈ ℕ, k < n → u[k] = v[k]
  shows matrixVectorProduct(M, u, n)[i] = matrixVectorProduct(M, v, n)[i]
proof
  exact matrixVectorProduct.eq_prefix at M, u, v, n, i with
    matrix, vectorsU, vectorsV, samePrefix

theorem transpose_swaps_entries (M : Set, i j : Nat)
  requires matrix : RealMatrix(M)
  shows matrixTranspose(M)[i, j] = M[j, i]
proof
  exact matrixTranspose.entry with matrix

theorem transpose_twice (M : Set, i j : Nat)
  requires matrix : RealMatrix(M)
  shows matrixTranspose(matrixTranspose(M))[i, j] = M[i, j]
proof
  exact matrixTranspose.involutive_entry with matrix

theorem product_is_row_by_column (A B : Set, n i j : Nat)
  requires matricesA : RealMatrix(A)
  requires matricesB : RealMatrix(B)
  shows matrixProduct(A, B, n)[i, j] =
    dotProduct(matrixRow(A, i), matrixColumn(B, j), n)
proof
  exact matrixProduct.entry with matricesA, matricesB

theorem product_transpose_reverses (A B : Set, n i j : Nat)
  requires matricesA : RealMatrix(A)
  requires matricesB : RealMatrix(B)
  shows matrixTranspose(matrixProduct(A, B, n))[i, j] =
    matrixProduct(matrixTranspose(B), matrixTranspose(A), n)[i, j]
proof
  exact matrixProduct.transpose_entry with matricesA, matricesB

theorem matrix_sum_entry (A B : Set, i j : Nat)
  requires matricesA : RealMatrix(A)
  requires matricesB : RealMatrix(B)
  shows matrixAdd(A, B)[i, j] = (A[i, j]:R) + (B[i, j]:R)
proof
  exact matrixAdd.entry with matricesA, matricesB

theorem transpose_distributes (A B : Set, i j : Nat)
  requires matricesA : RealMatrix(A)
  requires matricesB : RealMatrix(B)
  shows matrixTranspose(matrixAdd(A, B))[i, j] =
    matrixAdd(matrixTranspose(A), matrixTranspose(B))[i, j]
proof
  exact matrixTranspose.add_entry with matricesA, matricesB

theorem matrix_action_distributes (A B u : Set, i n : Nat)
  requires matricesA : RealMatrix(A)
  requires matricesB : RealMatrix(B)
  requires vector : RealSequence(u)
  shows matrixVectorProduct(matrixAdd(A, B), u, n)[i] =
    (matrixVectorProduct(A, u, n)[i]:R) + (matrixVectorProduct(B, u, n)[i]:R)
proof
  exact matrixVectorProduct.add_matrix at A, B, u, i, n with
    matricesA, matricesB, vector

theorem product_distributes (A B C : Set, i j n : Nat)
  requires matricesA : RealMatrix(A)
  requires matricesB : RealMatrix(B)
  requires matricesC : RealMatrix(C)
  shows matrixProduct(A, matrixAdd(B, C), n)[i, j] =
    matrixAdd(matrixProduct(A, B, n), matrixProduct(A, C, n))[i, j]
proof
  exact matrixProduct.add_right_entry at A, B, C, i, j, n with
    matricesA, matricesB, matricesC

theorem identity_diagonal (n i : Nat)
  shows identityMatrix(n)[i, i] = (1:R)
proof
  exact identityMatrix.diagonal with assumption, assumption

theorem identity_off_diagonal (n i j : Nat)
  requires different : i ≠ j
  shows identityMatrix(n)[i, j] = (0:R)
proof
  exact identityMatrix.off_diagonal at n, i, j with
    assumption, assumption, assumption, different

theorem identity_acts_on_vector (u : Set, n i : Nat)
  requires vector : RealSequence(u)
  requires inRange : i < n
  shows matrixVectorProduct(identityMatrix(n), u, n)[i] = u[i]
proof
  exact identityMatrix.action with vector, inRange

theorem identity_acts_on_left (A : Set, n i j : Nat)
  requires matrix : RealMatrix(A)
  requires inRange : i < n
  shows matrixProduct(identityMatrix(n), A, n)[i, j] = A[i, j]
proof
  exact matrixProduct.identity_left with matrix, inRange

theorem identity_acts_on_right (A : Set, n i j : Nat)
  requires matrix : RealMatrix(A)
  requires inRange : j < n
  shows matrixProduct(A, identityMatrix(n), n)[i, j] = A[i, j]
proof
  exact matrixProduct.identity_right with matrix, inRange

theorem product_distributes_on_left (A B C : Set, i j n : Nat)
  requires matricesA : RealMatrix(A)
  requires matricesB : RealMatrix(B)
  requires matricesC : RealMatrix(C)
  shows matrixProduct(matrixAdd(A, B), C, n)[i, j] =
    matrixAdd(matrixProduct(A, C, n), matrixProduct(B, C, n))[i, j]
proof
  exact matrixProduct.add_left_entry at A, B, C, i, j, n with
    matricesA, matricesB, matricesC

theorem finite_double_sum_interchange (M : Set, n m : Nat)
  requires matrix : RealMatrix(M)
  shows realPartialSum(matrixRowTotals(M, m), n) =
    realPartialSum(matrixColumnTotals(M, n), m)
proof
  exact matrixTotals.interchange with matrix

-- Exact rational elimination is available through the same subject import.
theorem exact_rational_pivot
  shows RationalCellOps.isZero(RationalMatrixOps.entry(
    RationalMatrixOps.firstRow(RationalEliminationExamples.reduced), 0)) = Bool.false
proof
  simp

theorem exact_rational_row_swap
  shows RationalMatrixOps.entry(RationalMatrixOps.firstRow(
    RationalMatrixOps.forward(1, 0, RationalEliminationExamples.swapped)), 0) =
    RationalCell.fraction(1, 0, 1)
proof
  simp

theorem exact_rational_reduced_solution
  shows RationalCellOps.sameValue(RationalMatrixOps.entry(
      RationalMatrixOps.firstRow(RationalEliminationExamples.completelyReduced), 2),
    RationalCell.fraction(2, 0, 1)) = Bool.true
proof
  simp

-- The replayable row operations encode a worked augmented-system reduction.
theorem checked_row_trace
  shows RationalRowCertificates.replayChecked(RationalRowCertificates.twoEquationTrace,
    RationalEliminationExamples.system) =
    Option.some(RationalRowCertificates.twoEquationResult)
proof
  simp

theorem checked_row_trace_solution
  shows RationalCellOps.sameValue(RationalMatrixOps.entry(
    RationalRowCertificates.rowAt(RationalRowCertificates.twoEquationResult, 1), 2),
    RationalCellOps.one) = Bool.true
proof
  simp

theorem three_variable_pivot_and_solution
  shows BoolOps.and(RationalRowTraceExamples.hasFourValues(
    RationalRowCertificates.rowAt(RationalRowTraceExamples.threeResult, 0),
    RationalRowTraceExamples.cell(1), RationalRowTraceExamples.cell(0),
    RationalRowTraceExamples.cell(0), RationalRowTraceExamples.cell(1)),
    BoolOps.and(RationalRowTraceExamples.hasFourValues(
      RationalRowCertificates.rowAt(RationalRowTraceExamples.threeResult, 1),
      RationalRowTraceExamples.cell(0), RationalRowTraceExamples.cell(1),
      RationalRowTraceExamples.cell(0), RationalRowTraceExamples.cell(2)),
      RationalRowTraceExamples.hasFourValues(
        RationalRowCertificates.rowAt(RationalRowTraceExamples.threeResult, 2),
        RationalRowTraceExamples.cell(0), RationalRowTraceExamples.cell(0),
        RationalRowTraceExamples.cell(1), RationalRowTraceExamples.cell(3)))) = Bool.true
proof
  simp

theorem inconsistent_system_detected
  shows RationalCellOps.isZero(RationalMatrixOps.entry(
    RationalRowCertificates.rowAt(RationalRowTraceExamples.inconsistentResult, 1), 2)) = Bool.false
proof
  simp

theorem dependent_system_zero_row
  shows RationalCellOps.isZero(RationalMatrixOps.entry(
    RationalRowCertificates.rowAt(RationalRowTraceExamples.dependentResult, 1), 2)) = Bool.true
proof
  compute
