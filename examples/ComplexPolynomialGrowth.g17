module ComplexPolynomialGrowthExample
import Grace.Cumulus.Complex.PolynomialGrowth

section Growth
notation ring C := (complexCarrier, complexAdd, complexZero, complexNeg, complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

theorem escape (c : Set) (target : Real) (cs : List(complexCarrier))
  requires coefficient : c ∈ C
  shows ∃ radius ∈ ℝ, realZero ≤ radius ∧ (∀ z ∈ C, radius ≤ complexNormSquared(z) → target < complexNormSquared(complexPolynomial(c :: cs)(z)))
proof
  exact complexPolynomial.grows_at_infinity with *

theorem lower_step (c z w : Set) (target : Real)
  requires coefficient : c ∈ C
  requires first : z ∈ C
  requires second : w ∈ C
  requires unitBound : R[1] ≤ complexNormSquared(w)
  requires large : R[2 * (target + complexNormSquared(c))] ≤ complexNormSquared(z)
  shows target ≤ complexNormSquared(C[c + z * w])
proof
  exact complexNormSquared.horner_step_lower_bound with *

-- Disk minimization is a hypothesis here.
theorem minimum (c : Set) (cs : List(complexCarrier))
  requires coefficient : c ∈ C
  requires diskMinima : ∀ radius ∈ ℝ, realZero ≤ radius → ComplexDiskMinimum(complexPolynomial(c :: cs), radius)
  shows ∃ a ∈ C, ∀ z ∈ C, complexNormSquared(complexPolynomial(c :: cs)(a)) ≤ complexNormSquared(complexPolynomial(c :: cs)(z))
proof
  exact complexPolynomial.minimum_of_disk_minima with *

theorem root (c : Set) (cs : List(complexCarrier))
  requires coefficient : c ∈ C
  requires diskMinima : ∀ radius ∈ ℝ, realZero ≤ radius → ComplexDiskMinimum(complexPolynomial(c :: cs), radius)
  requires descent : ∀ a ∈ C, complexPolynomial(c :: cs)(a) ≠ C[0] → ∃ z ∈ C, complexNormSquared(complexPolynomial(c :: cs)(z)) < complexNormSquared(complexPolynomial(c :: cs)(a))
  shows ∃ a ∈ C, monicValue(C, identity(C), C, a, c :: cs) = C[0]
proof
  exact complexPolynomial.root_of_disk_minima_and_descent with *

end Growth
