module IntegerGCDStarter
import Grace.Cumulus.NumberTheory

theorem all_integer_inputs (x y : Integer)
  shows ∃ u, Integer(u) ∧ ∃ v, Integer(v) ∧ u * x + v * y = integerOfNat(integerGCD(x, y))
proof
  exact integerGCD.bezout at x, y with *

theorem canonical_gcd (x y : Integer)
  shows IsIntegerGCD(x, y, integerGCD(x, y))
proof
  exact integerGCD.correct at x, y with *

theorem negative_gcd
  shows integerGCD(integerNegativeOfNat(252), integerOfNat(198)) = 18
proof
  simp [integerGCD, integerNatAbs.ofNegativeNat, integerNatAbs.ofNat]
  compute

theorem absolute_product (x y : Integer)
  shows integerNatAbs(x * y) = integerNatAbs(x) * integerNatAbs(y)
proof
  exact integerNatAbs.mul at x, y with *

-- (-4)*(-252) + (-5)*198 = 18, an equality in the quotient integers.
theorem signed_identity
  shows integerNegativeOfNat(4) * integerNegativeOfNat(252) + integerNegativeOfNat(5) * integerOfNat(198) = integerOfNat(18)
proof
  simp [integerMulValue.negative_negative, integerMulValue.negative_ofNat]
  simp [integerOfNat, integerNegativeOfNat, integerAddValue.classes, integerClassSum]
  apply integerClass.eq with *{4}
  compute
