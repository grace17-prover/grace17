-- Authors: Grant Passmore

module PolynomialVariableCoefficients
import Grace.Cumulus.Algebra.Polynomial.VariableExpansion

section Coefficients
variable (I A add z neg mul one p j : Set)
notation ring R := (A, add, z, neg, mul, one)
notation ring P := R[I]
hypothesis ring : IsCommRing(R)
hypothesis polynomial : p ∈ P

theorem ring_constants
  shows R[0] ∈ R ∧ R[1] ∈ R
proof
  constructor
  . typecheck
  . typecheck

theorem coefficient_is_polynomial (n : Nat)
  shows polynomialVariableCoefficient(I, R, p, j, n) ∈ P
proof
  have zeroIn : R[0] ∈ R by typecheck
  exact polynomialVariableCoefficient.member with *

theorem coefficient_uses_fewer_variables (n : Nat)
  shows polynomialVariablesUsed(I, R, polynomialVariableCoefficient(I, R, p, j, n)) ⊆ polynomialVariablesUsed(I, R, p) ∖ {j}
proof
  have zeroIn : R[0] ∈ R by typecheck
  exact polynomialVariableCoefficient.variables with *

theorem coefficients_determine_polynomial (q : Set)
  requires other : q ∈ P
  requires index : j ∈ I
  requires coefficients : ∀ n ∈ ℕ, polynomialVariableCoefficient(I, R, p, j, n) = polynomialVariableCoefficient(I, R, q, j, n)
  shows p = q
proof
  have zeroIn : R[0] ∈ R by typecheck
  exact polynomialVariableCoefficient.ext with *

theorem nonzero_coefficient
  requires index : j ∈ I
  requires nonzero : p ≠ P[0]
  shows ∃ n ∈ ℕ, polynomialVariableCoefficient(I, R, p, j, n) ≠ P[0]
proof
  have zeroIn : R[0] ∈ R by typecheck
  exact polynomialVariableCoefficient.exists_nonzero with *

theorem finitely_many_coefficients
  requires index : j ∈ I
  shows CoefficientMap(polynomialCoefficientFamily(I, R, p, j), ℕ, P, P[0])
proof
  have zeroIn : R[0] ∈ R by typecheck
  exact polynomialCoefficientFamily.map with *

theorem coefficient_evaluation_ignores_chosen_variable (v w : Set, n : Nat)
  requires first : v : I → R
  requires second : w : I → R
  requires agreement : ∀ i ∈ I, i ≠ j → v(i) = w(i)
  shows polynomialAt(I, R, v)(polynomialVariableCoefficient(I, R, p, j, n)) = polynomialAt(I, R, w)(polynomialVariableCoefficient(I, R, p, j, n))
proof
  exact polynomialVariableCoefficient.agree_away with *

end Coefficients
