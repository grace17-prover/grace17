module PolynomialNonvanishing
import Grace.Cumulus.Algebra.Polynomial.InfiniteFieldLocalization

section Polynomials
variable (I A add z neg mul one : Set)
notation ring R := (A, add, z, neg, mul, one)
notation ring P := R[I]
hypothesis field : IsField(R)
hypothesis infinite : ¬Finite(R)

-- No finiteness or nonemptiness assumption on I is needed here.
theorem nonvanishing (p : Set)
  requires polynomial : p ∈ P
  requires nonzero : p ≠ P[0]
  shows ∃ v, FunctionBetween(v, I, R) ∧ polynomialAt(I, R, v)(p) ≠ z
proof
  exact polynomialAt.exists_nonzero with *

theorem determined_by_values (p q : Set)
  requires left : p ∈ P
  requires right : q ∈ P
  requires agreement : ∀ v, FunctionBetween(v, I, R) → polynomialAt(I, R, v)(p) = polynomialAt(I, R, v)(q)
  shows p = q
proof
  exact polynomialAt.ext with *

end Polynomials

section Localizations
variable (I A add z neg mul one B plus o minus times unit g s j T : Set)
notation ring R := (A, add, z, neg, mul, one)
notation ring P := R[I]
notation ring S := (B, plus, o, minus, times, unit)
notation ring L := S ↾ T
hypothesis coefficients : IsField(R)
hypothesis infinite : ¬Finite(R)
hypothesis polynomial : s ∈ P
hypothesis nonzero : s ≠ P[0]
hypothesis index : j ∈ I
hypothesis embedding : IsRingHom(g, P, S)
hypothesis injective : InjectiveBetween(g, P, S)
hypothesis carrier : T = localizationWithin(S, functionImage(g, P, S), functionImage(g, denominatorPowers(P, s), S))

theorem localization_not_field
  requires target : IsCommRing(S)
  shows ¬IsField(L)
proof
  exact polynomialLocalization.not_field with *

theorem nonintegral_element
  requires target : IsField(S)
  shows ∃ y ∈ S, ¬IntegralOver(identity(T), L, S, y)
proof
  exact polynomialLocalization.exists_nonintegral with *

end Localizations
