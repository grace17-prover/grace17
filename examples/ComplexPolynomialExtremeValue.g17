module ComplexPolynomialExtremeValueExample
import Grace.Cumulus.Complex.ExtremeValue
theorem disk_minimum (cs : List(complexCarrier)) (radius : Real)
  requires nonnegative : realZero ≤ radius
  shows ComplexDiskMinimum(complexPolynomial(cs), radius)
proof
  exact complexPolynomial.disk_minimum with *

theorem global_minimum (c : Set) (cs : List(complexCarrier))
  requires coefficient : c ∈ complexCarrier
  shows ∃ a ∈ complexCarrier, ∀ z ∈ complexCarrier,
    complexNormSquared(complexPolynomial(c :: cs)(a)) ≤ complexNormSquared(complexPolynomial(c :: cs)(z))
proof
  exact complexPolynomial.global_minimum with *

-- Local descent remains a hypothesis here.
section Complexes
notation ring C := (complexCarrier, complexAdd, complexZero, complexNeg, complexMul, complexOne)

theorem root_if_descent (c : Set) (cs : List(C))
  requires coefficient : c ∈ C
  requires descent : ∀ a ∈ C, complexPolynomial(c :: cs)(a) ≠ C[0] → ∃ z ∈ C, complexNormSquared(complexPolynomial(c :: cs)(z)) < complexNormSquared(complexPolynomial(c :: cs)(a))
  shows ∃ a ∈ C, monicValue(C, identity(C), C, a, c :: cs) = C[0]
proof
  exact complexPolynomial.root_of_descent with *

end Complexes
