module DoubleSums
import Grace.Cumulus.Algebra.Ring.DoubleSum

-- No fixed dimensions: both bounds may be any natural numbers, including zero.
theorem rows_equal_columns (A add zero neg mul one w : Set, m n : Nat)
  requires ring : IsCommRing(A, add, zero, neg, mul, one)
  requires matrix : w : m × n → A
  shows ringDoubleSum(w, add, zero, m, n) = ringDoubleSum(transposedMatrix(m, n, A, w), add, zero, n, m)
proof
  exact ringDoubleSum.interchange at A, add, zero, neg, mul, one, w, m, n with *

theorem transpose_twice (D E A w : Set)
  requires matrix : w : D × E → A
  shows transposedMatrix(E, D, A, transposedMatrix(D, E, A, w)) = w
proof
  exact transposedMatrix.involution with matrix

-- Independent local proofs may use the same names.
theorem local_witness_names (a : Set)
  requires inhabited : ∃ x, x = a
  shows a = a
proof
  simp
