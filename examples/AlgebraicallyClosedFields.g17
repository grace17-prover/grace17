module AlgebraicallyClosedFields
import Grace.Cumulus.Algebra.Field.Infinite

section Fields
variable (A add zero neg mul one : Set)
notation ring R := (A, add, zero, neg, mul, one)

theorem infinite
  requires closed : IsAlgebraicallyClosed(R)
  shows ¬Finite(R)
proof
  exact IsAlgebraicallyClosed.infinite with *

-- The reusable polynomial construction needs only a commutative ring.
-- A nonempty lower-coefficient list ensures that the polynomial is nonconstant.
theorem vanishing (xs : List(A))
  requires ring : IsCommRing(R)
  shows ∃ c ∈ R, ∃ cs, List(A, cs) ∧ (∀ x ∈ R, x ∈ listSupport{A}(xs) → hornerAt{A}(add, mul, one, x, c :: cs) = R[0])
proof
  exact hornerAt.monic_vanishing_on_list with *

end Fields
