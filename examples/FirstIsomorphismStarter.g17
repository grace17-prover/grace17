module FirstIsomorphismStarter
import Grace.Cumulus.Algebra.Ring

theorem first_isomorphism (f A add zero neg mul one B plus z minus times unit : Set)
  requires source : IsCommRing(A, add, zero, neg, mul, one)
  requires target : IsCommRing(B, plus, z, minus, times, unit)
  requires hom : IsRingHom(f, A, add, zero, neg, mul, one, B, plus, z, minus, times, unit)
  requires onto : SurjectiveBetween(f, A, B)
  shows IsRingIso(quotientMap(f, A, B, idealRelation(A, add, neg, ringKernel(f, A, z))), (A ⧸ idealRelation(A, add, neg, ringKernel(f, A, z))),
    quotientBinary(A, idealRelation(A, add, neg, ringKernel(f, A, z)), add), ⟦zero⟧[A, idealRelation(A, add, neg, ringKernel(f, A, z))],
    quotientUnary(A, idealRelation(A, add, neg, ringKernel(f, A, z)), neg), quotientBinary(A, idealRelation(A, add, neg, ringKernel(f, A, z)), mul), ⟦one⟧[A, idealRelation(A, add, neg, ringKernel(f, A, z))], B, plus, z, minus, times, unit)
proof
  exact idealQuotient.first_isomorphism at f, A, add, zero, neg, mul, one, B, plus, z, minus, times, unit with *

-- The mathematical argument does not expose graph encodings.
theorem equal_mod_kernel (f A add zero neg mul one B plus z minus times unit x y : Set)
  requires source : IsCommRing(A, add, zero, neg, mul, one)
  requires target : IsCommRing(B, plus, z, minus, times, unit)
  requires hom : IsRingHom(f, A, add, zero, neg, mul, one, B, plus, z, minus, times, unit)
  requires hx : x ∈ A
  requires hy : y ∈ A
  requires same : f(x) = f(y)
  shows ⟦x⟧[A, idealRelation(A, add, neg, ringKernel(f, A, z))] =
    ⟦y⟧[A, idealRelation(A, add, neg, ringKernel(f, A, z))]
proof
  have ideal := IsRingHom.kernel_ideal at f, A, add, zero, neg, mul, one, B, plus, z, minus, times, unit with *
  have congruent := IsRingHom.kernel_congruent.backward at f, A, add, zero, neg, mul, one, B, plus, z, minus, times, unit, x, y with *
  exact idealClass.eq_iff_congruent.backward with *

-- Uniqueness is now pointwise reasoning on quotient elements.
theorem unique_descent (f g A B r : Set)
  requires function : f : A → B
  requires equivalence : Equivalence(A, r)
  requires respects : Respects(f, A, r)
  requires candidate : g : (A ⧸ r) → B
  requires factors : ∀ x ∈ A, g(⟦x⟧[A, r]) = f(x)
  shows g = quotientMap(f, A, B, r)
proof
  exact quotientMap.unique at f, g, A, B, r with *
