-- Authors: Grant Passmore

module PolynomialOrigin
import Grace.Cumulus.Algebra.Polynomial.Origin

section Rings
variable (I A add zero neg mul one : Set)
hypothesis coefficients : IsCommRing(A, add, zero, neg, mul, one)
notation ring R := (A, add, zero, neg, mul, one)
notation ring P := R[I]

theorem embed_product (a b : Set)
  requires ha : a ∈ A
  requires hb : b ∈ A
  shows polynomialCoefficients(I, A, zero)(R[a * b]) = P[polynomialCoefficients(I, A, zero)(a) * polynomialCoefficients(I, A, zero)(b)]
proof
  have hom := polynomialCoefficients.hom at I, A, add, zero, neg, mul, one with coefficients
  exact IsRingHom.mul with hom, ha, hb

theorem evaluate_product (p q : Set)
  requires hp : p ∈ P
  requires hq : q ∈ P
  shows polynomialAtOrigin(I, A, zero)(P[p * q]) = R[polynomialAtOrigin(I, A, zero)(p) * polynomialAtOrigin(I, A, zero)(q)]
proof
  have hom := polynomialAtOrigin.hom at I, A, add, zero, neg, mul, one with coefficients
  exact IsRingHom.mul with hom, hp, hq

theorem evaluate_sum (p q : Set)
  requires hp : p ∈ P
  requires hq : q ∈ P
  shows polynomialAtOrigin(I, A, zero)(P[p + q]) = R[polynomialAtOrigin(I, A, zero)(p) + polynomialAtOrigin(I, A, zero)(q)]
proof
  have hom := polynomialAtOrigin.hom at I, A, add, zero, neg, mul, one with coefficients
  exact IsRingHom.add with hom, hp, hq

theorem recover_coefficient (a : Set)
  requires ha : a ∈ A
  shows polynomialAtOrigin(I, A, zero)(polynomialCoefficients(I, A, zero)(a)) = a
proof
  have ordinary := IsCommRing.ring with coefficients
  have zeroIn := IsRing.zero_in_carrier with ordinary
  exact polynomialAtOrigin.coefficients at I, A, zero, a with *

theorem variable_vanishes (j : Set)
  requires hj : j ∈ I
  shows polynomialAtOrigin(I, A, zero)(polynomialVariable(I, A, zero, one, j)) = R[0]
proof
  have ordinary := IsCommRing.ring with coefficients
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have multiplicative := IsRing.multiplicative with ordinary
  have oneIn := IsMonoid.unit_in_carrier with multiplicative
  exact polynomialAtOrigin.variable at I, A, zero, one, j with *

theorem vanishing_is_closed_under_products (p q : Set)
  requires hp : p ∈ P
  requires hq : q ∈ P
  requires vanishes : polynomialAtOrigin(I, A, zero)(p) = R[0]
  shows polynomialAtOrigin(I, A, zero)(P[p * q]) = R[0]
proof
  have hom := polynomialAtOrigin.hom at I, A, add, zero, neg, mul, one with coefficients
  have product := IsRingHom.mul with hom, hp, hq
  have valueQ := IsRingHom.closed with hom, hq
  rw product
  rw vanishes
  ring

end Rings
