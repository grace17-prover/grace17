module FiniteIdealCertificate
import Grace.Cumulus.Algebra.Ring

section Rings
variable (A add zero neg mul one G : Set)
hypothesis source : IsCommRing(A, add, zero, neg, mul, one)
hypothesis bounded : G ⊆ A
notation ring R := (A, add, zero, neg, mul, one)

theorem finite_witness (x : Set)
  requires member : x ∈ idealSpan(A, add, zero, neg, mul, G)
  shows ∃ terms, List(idealProducts(A, mul, G), terms) ∧ x = ringSum{idealProducts(A, mul, G)}(add, zero, terms)
proof
  exact idealSpan.finite_certificate.forward with source, bounded, member

section Evaluations
variable (f B plus z minus times unit : Set)
hypothesis target : IsCommRing(B, plus, z, minus, times, unit)
hypothesis hom : IsRingHom(f, A, add, zero, neg, mul, one, B, plus, z, minus, times, unit)
hypothesis nontrivial : Nontrivial(B, z, unit)
notation ring S := (B, plus, z, minus, times, unit)

theorem no_common_zero (terms : List(idealProducts(A, mul, G)))
  requires identity : R[1] = ringSum{idealProducts(A, mul, G)}(add, zero, terms)
  shows ¬(∀ p ∈ G, f(p) = S[0])
proof
  exact idealSpan.finite_certificate_obstructs_vanishing at A, add, zero, neg, mul, one, G, f, B, plus, z, minus, times, unit, terms with *

end Evaluations
end Rings
