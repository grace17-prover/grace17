module MultiplicationMatrices
import Grace.Cumulus.Algebra.MultiplicationMatrix

theorem lists_are_determined_by_entries (A z : Set) (xs ys : List(A))
  requires sameLength : length{A}(xs) = length{A}(ys)
  requires entries : ∀ n, Nat(n) → n < length{A}(xs) → listCoefficient{A}(z, xs, n) = listCoefficient{A}(z, ys, n)
  shows xs = ys
proof
  exact listCoefficient.ext with *

theorem positions_cover_the_support (A z : Set) (xs : List(A))
  shows SurjectiveBetween(listEntries(A, z, xs), length{A}(xs), listSupport{A}(xs))
proof
  exact listEntries.surjective with *

theorem repeated_generators_keep_both_positions (A z a : Set)
  requires element : a ∈ A
  shows length{A}([a, a]) = 2 ∧ listCoefficient{A}(z, [a, a], 0) = a ∧ listCoefficient{A}(z, [a, a], 1) = a
proof
  have nil : List(A, []) by typecheck
  have single : List(A, [a]) by typecheck
  have double : List(A, [a, a]) by typecheck
  constructor
  . rw length.cons
    rw length.cons
    rw length.nil
    rfl
  . constructor
    . exact listCoefficient.zero with *
    . rw listCoefficient.succ
      exact listCoefficient.zero with *

theorem empty_list_has_no_positions (A z : Set)
  shows listEntries(A, z, []) : ∅ → ∅
proof
  have list : List(A, []) by typecheck
  have function := listEntries.function at A, z, [] with *
  rw length.nil at function
  rw nat.zero at function
  rw listSupport.nil at function
  exact function

theorem recover_a_coefficient_row (n A zero C rows i : Set) (cs : List(A))
  requires natural : Nat(n)
  requires default : zero ∈ A
  requires function : rows : n → C
  requires rowTypes : ∀ ds ∈ C, List(A, ds)
  requires rowLengths : ∀ ds ∈ C, length{A}(ds) = n
  requires row : i ∈ n
  requires size : length{A}(cs) = n
  requires coefficients : ∀ j ∈ n, coefficientMatrix(n, A, zero, C, rows)[i, j] = listCoefficient{A}(zero, cs, j)
  shows rows(i) = cs
proof
  exact coefficientMatrix.row_unique with *

section Algebras
variable (A add zero neg mul one B plus z minus times unit f x : Set)
notation ring R := (A, add, zero, neg, mul, one)
notation ring S := (B, plus, z, minus, times, unit)
hypothesis source : IsCommRing(R)
hypothesis target : IsCommRing(S)
hypothesis hom : IsRingHom(f, R, S)
hypothesis element : x ∈ S

theorem square_multiplication_matrix
  requires finiteModule : FiniteAlgebraModule(f, R, S)
  shows ∃ xs, List(B, xs) ∧ linearSpan(f, R, S, listSupport{B}(xs)) = S ∧
    (∃ M, RingMatrix(length{B}(xs), R, M) ∧
      (∀ i ∈ length{B}(xs), ∃ cs, List(A, cs) ∧ length{A}(cs) = length{B}(xs) ∧
        S[x * listCoefficient{B}(z, xs, i)] = linearCombination(R, S, f, xs, cs) ∧
        (∀ j ∈ length{B}(xs), M[i, j] = listCoefficient{A}(zero, cs, j))))
proof
  exact FiniteAlgebraModule.multiplication_matrix with *

end Algebras
