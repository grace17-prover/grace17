module PolynomialPoints
import Grace.Cumulus.Algebra.Polynomial.PointIdeal

section Coordinates
variable (I A add zero neg mul one v : Set)
hypothesis coefficients : IsCommRing(A, add, zero, neg, mul, one)
hypothesis assignment : v : I → A
notation ring R := (A, add, zero, neg, mul, one)
notation ring P := R[I]

-- x denotes X_j and c denotes the constant polynomial with coefficient a.
theorem coordinate_equation (j a x c : Set)
  requires hj : j ∈ I
  requires ha : a ∈ R
  requires variable : x = polynomialVariable(I, R, j)
  requires constant : c = polynomialConstant(I, R, a)
  shows P[x - c] ∈ pointIdeal(I, R, v) ↔ v(j) = a
proof
  have characterization := pointIdeal.coordinate_difference at I, A, add, zero, neg, mul, one, v, j, a with *
  unfold polynomialCoordinateDifference at characterization
  rw ← variable at characterization
  rw ← constant at characterization
  exact characterization

theorem points_determined_by_their_ideals (w : Set)
  requires other : w : I → A
  shows pointIdeal(I, R, v) = pointIdeal(I, R, w) ↔ v = w
proof
  exact pointIdeal.eq_iff at I, A, add, zero, neg, mul, one, v, w with *

theorem common_zero_is_ideal_containment (G : Set)
  requires generators : G ⊆ P
  shows PolynomialCommonZero(I, A, add, zero, neg, mul, one, G, v) ↔ G ⊆ pointIdeal(I, R, v)
proof
  exact PolynomialCommonZero.iff_subset_pointIdeal at I, A, add, zero, neg, mul, one, v, G with *

end Coordinates

section Fields
variable (I A add zero neg mul one v : Set)
hypothesis field : IsField(A, add, zero, neg, mul, one)
hypothesis assignment : v : I → A
notation ring R := (A, add, zero, neg, mul, one)
notation ring P := R[I]

theorem point_ideal_is_maximal
  shows IsMaximalIdeal(P, pointIdeal(I, R, v))
proof
  exact pointIdeal.maximal at I, A, add, zero, neg, mul, one, v with *

theorem maximal_ideal_has_at_most_one_zero (M w : Set)
  requires maximal : IsMaximalIdeal(P, M)
  requires other : w : I → A
  requires first : PolynomialCommonZero(I, A, add, zero, neg, mul, one, M, v)
  requires second : PolynomialCommonZero(I, A, add, zero, neg, mul, one, M, w)
  shows v = w
proof
  exact IsMaximalIdeal.common_zero_unique at I, A, add, zero, neg, mul, one, v, M, w with *

end Fields
