module Grace.Core.Nat
namespace Rec

def add (x y : Nat) -> Nat
  | zero, y => y
  | succ(x), y => succ(add(x, y))

notation infixl 60 "+" => add

theorem add.left_unit (y : Nat)
  shows add(0, y) = y
proof
  settle with add

end Rec
