module ArithmeticSeriesStarter
import Grace.Cumulus.Real.ArithmeticSeries

-- Arbitrary real starting term and common difference; n + 1 terms.
theorem sum_formula (A D : Real, n : Nat)
  shows ∑ i < n + 1, arithmeticTerms(A, D)(i) =
    (((realNat(n):R) + (1:R)) * ((2:R) * A + (realNat(n):R) * D)) /
      (2:R)
proof
  exact arithmeticSeries.quotient at A, D, n with *

-- 1 + 3 + ... + (2n - 1) = n², including n = 0.
theorem odd_numbers (n : Nat)
  shows ∑ i < n, arithmeticTerms(realOne, (2:R))(i) =
    (realNat(n):R) * (realNat(n):R)
proof
  exact arithmeticSeries.odd_sum at n with *

theorem empty_sum (A D : Real)
  shows ∑ i < 0, arithmeticTerms(A, D)(i) = (0:R)
proof
  exact realPartialSum.zero

theorem singleton_sum (A D : Real)
  shows ∑ i < 1, arithmeticTerms(A, D)(i) = A
proof
  have value := arithmeticTerms.value at A, D, 0 with *
  rw realPartialSum.succ
  rw realPartialSum.zero
  rw value
  rw realNat.zero
  ring
