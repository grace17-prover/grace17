module FiniteModuleIntegralityExample
import Grace.Cumulus.Algebra.MatrixAnnihilator

section Algebras
variable (A add zero neg mul one B plus z minus times unit f x : Set)
notation ring R := (A, add, zero, neg, mul, one)
notation ring S := (B, plus, z, minus, times, unit)
hypothesis source : IsCommRing(R)
hypothesis target : IsCommRing(S)
hypothesis hom : IsRingHom(f, R, S)
hypothesis element : x ∈ S

theorem integral
  requires finiteModule : FiniteAlgebraModule(f, R, S)
  shows IntegralOver(f, R, S, x)
proof
  exact FiniteAlgebraModule.integral with *

theorem annihilator (xs : List(B)) (M : Set)
  requires matrix : RingMatrix(length{B}(xs), R, M)
  requires rows : ∀ i ∈ length{B}(xs), ∃ cs, List(A, cs) ∧ length{A}(cs) = length{B}(xs) ∧ S[x * listCoefficient{B}(z, xs, i)] = linearCombination(R, S, f, xs, cs) ∧ (∀ j ∈ length{B}(xs), M[i, j] = listCoefficient{A}(zero, cs, j))
  shows ∃ cs, List(A, cs) ∧ length{A}(cs) = length{B}(xs) ∧ (∀ g ∈ listSupport{B}(xs), S[monicValue(R, f, S, x, cs) * g] = S[0])
proof
  exact multiplicationMatrix.monic_annihilator with *

end Algebras
