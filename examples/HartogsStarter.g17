-- Authors: Grant Passmore

module HartogsStarter
import Grace.Cumulus.Cardinal

-- No well-ordering of A, and no Choice assumption, is needed.
theorem larger_ordinal (A : Set)
  shows ∃ α, α ∈ Ordinal ∧ (∀ f, ¬InjectiveBetween(f, α, A))
proof
  exact Hartogs.theorem

-- The explicit constructed ordinal cannot be injected into A.
theorem no_injection (A f : Set)
  shows ¬InjectiveBetween(f, hartogsBound(A), A)
proof
  exact hartogsBound.no_injection

-- Well-orders can be transported to the image of any injection.
theorem transport (f A B r : Set)
  requires injective : InjectiveBetween(f, A, B)
  requires order : WellOrder(A, r)
  shows WellOrder(functionImage(f, A, B), transportedOrder(f, A, B, r))
proof
  exact transportedOrder.well_order at f, A, B, r with *
