module CumulusStarter
import Grace.Cumulus.Real

theorem constant_integral (A B C : Real)
  requires ordered : A ≤ B
  shows ∫[A, B] constantRealFunction(C) = C * (B - A)
proof
  exact riemannIntegral.constant with ordered

theorem integral_notation (f : Set) (A B : Real)
  shows ∫[A, B] f = riemannIntegral(f, A, B)
proof
  rfl

theorem integral_notation_in_expression (f : Set) (A B : Real)
  shows (∫[A, B] f) + (1:R) = (riemannIntegral(f, A, B):R) + (1:R)
proof
  rfl

theorem finite_sum_add (u v : Set, n : Nat)
  requires uReal : RealSequence(u)
  requires vReal : RealSequence(v)
  shows realPartialSum(addSequence(u, v), n) =
    (realPartialSum(u, n):R) + (realPartialSum(v, n):R)
proof
  exact realPartialSum.add with uReal, vReal

theorem finite_sum_sub (u v : Set, n : Nat)
  requires uReal : RealSequence(u)
  requires vReal : RealSequence(v)
  shows realPartialSum(subSequence(u, v), n) =
    (realPartialSum(u, n):R) - (realPartialSum(v, n):R)
proof
  exact realPartialSum.sub with uReal, vReal

theorem finite_sum_split (u : Set, m n : Nat)
  requires sequence : RealSequence(u)
  shows realPartialSum(u, add(m, n)) =
    (realPartialSum(u, m):R) + realPartialSum(shiftedRealSequence(u, m), n)
proof
  exact realPartialSum.split_at with sequence

theorem geometric_series (X : Real, n : Nat)
  shows ((1:R) - X) * (realPartialSum(geometricTerms(X), n):R) =
    (1:R) - X ^ n
proof
  exact realPartialSum.geometric with assumption, assumption

theorem geometric_series_quotient (X : Real, n : Nat)
  requires nonzero : ((1:R) - X) ≠ (0:R)
  shows realPartialSum(geometricTerms(X), n) =
    ((1:R) - X ^ n) / ((1:R) - X)
proof
  exact realPartialSum.geometric_quotient with nonzero

theorem telescoping_sum (u : Set, n : Nat)
  requires sequence : RealSequence(u)
  shows realPartialSum(adjacentDifferences(u), n) = (u[n]:R) - (u[0]:R)
proof
  exact realPartialSum.telescoping with sequence

theorem adjacent_product_rule (u v : Set, n : Nat)
  requires sequenceU : RealSequence(u)
  requires sequenceV : RealSequence(v)
  shows adjacentDifferences(mulSequence(u, v))[n] =
    (u[succ(n)]:R) * (adjacentDifferences(v)[n]:R) +
      (v[n]:R) * (adjacentDifferences(u)[n]:R)
proof
  exact adjacentDifferences.product with sequenceU, sequenceV

theorem finite_product_telescoping (u v : Set, n : Nat)
  requires sequenceU : RealSequence(u)
  requires sequenceV : RealSequence(v)
  shows (realPartialSum(forwardProductIncrements(u, v), n):R) +
      (realPartialSum(backwardProductIncrements(u, v), n):R) =
    (u[n]:R) * (v[n]:R) - (u[0]:R) * (v[0]:R)
proof
  exact realPartialSum.product_telescoping with sequenceU, sequenceV

theorem abel_summation (u v : Set, n : Nat)
  requires sequenceU : RealSequence(u)
  requires sequenceV : RealSequence(v)
  shows realPartialSum(mulSequence(u, v), n) =
    (realPartialSum(u, n):R) * (v[n]:R) -
      (realPartialSum(forwardProductIncrements(prefixSums(u), v), n):R)
proof
  exact realPartialSum.abel with sequenceU, sequenceV

theorem polynomial_add (u v : Set, n : Nat, X : Real)
  requires uReal : RealSequence(u)
  requires vReal : RealSequence(v)
  shows polynomialEval(addSequence(u, v), n, X) =
    (polynomialEval(u, n, X):R) + (polynomialEval(v, n, X):R)
proof
  exact polynomialEval.add with uReal, vReal

theorem polynomial_same_prefix (u v : Set, n : Nat, X : Real)
  requires uReal : RealSequence(u)
  requires vReal : RealSequence(v)
  requires equal : ∀ k ∈ ℕ, k < n → u[k] = v[k]
  shows polynomialEval(u, n, X) = polynomialEval(v, n, X)
proof
  exact polynomialEval.eq_prefix with uReal, vReal, equal

theorem polynomial_scale (coeff : Set, n : Nat, X C : Real)
  requires coefficients : RealSequence(coeff)
  shows polynomialEval(mulSequence(constantSequence(C), coeff), n, X) =
    C * (polynomialEval(coeff, n, X):R)
proof
  exact polynomialEval.scale with coefficients

theorem polynomial_sub (u v : Set, n : Nat, X : Real)
  requires uReal : RealSequence(u)
  requires vReal : RealSequence(v)
  shows polynomialEval(subSequence(u, v), n, X) =
    (polynomialEval(u, n, X):R) - (polynomialEval(v, n, X):R)
proof
  exact polynomialEval.sub with uReal, vReal

theorem polynomial_at_one (coeff : Set, n : Nat)
  requires coefficients : RealSequence(coeff)
  shows polynomialEval(coeff, n, realOne) = realPartialSum(coeff, n)
proof
  exact polynomialEval.at_one with coefficients

theorem polynomial_as_sum (coeff : Set, n : Nat, X : Real)
  requires coefficients : RealSequence(coeff)
  shows polynomialEval(coeff, n, X) = realPartialSum(polynomialTerms(coeff, X), n)
proof
  exact polynomialEval.as_sum with coefficients

theorem polynomial_geometric (X : Real, n : Nat)
  shows ((1:R) - X) * (polynomialEval(constantSequence(realOne), n, X):R) =
    (1:R) - X ^ n
proof
  exact polynomialEval.geometric_identity with assumption, assumption

theorem affine_polynomial (coeff : Set, X : Real)
  requires coefficients : RealSequence(coeff)
  shows polynomialEval(coeff, succ(succ(0)), X) =
    (coeff[0]:R) + (coeff[succ(0)]:R) * X
proof
  exact polynomialEval.linear with coefficients

theorem polynomial_at_zero (coeff : Set, n : Nat)
  requires coefficients : RealSequence(coeff)
  shows polynomialEval(coeff, succ(n), realZero) = coeff[0]
proof
  exact polynomialEval.at_zero_succ with coefficients

theorem quadratic_polynomial (coeff : Set, X : Real)
  requires coefficients : RealSequence(coeff)
  shows polynomialEval(coeff, succ(succ(succ(0))), X) =
    ((coeff[0]:R) + (coeff[succ(0)]:R) * X) +
      (coeff[succ(succ(0))]:R) * (X * X)
proof
  exact polynomialEval.quadratic with coefficients

theorem identity_integral (A B : Real)
  requires ordered : A ≤ B
  shows riemannIntegral(constantRealFunction(realOne), A, B) = B - A
proof
  exact FTC.integral_one with ordered
