module NullstellensatzCertificate
import Grace.Cumulus.Algebra.Ring

section Rings
variable (A add zero neg mul one G p q a b : Set)
hypothesis source : IsCommRing(A, add, zero, neg, mul, one)
hypothesis bounded : G ⊆ A
hypothesis hp : p ∈ G
hypothesis hq : q ∈ G
hypothesis ha : a ∈ A
hypothesis hb : b ∈ A
notation ring R := (A, add, zero, neg, mul, one)
hypothesis identity : a * p + b * q = 1

theorem unit_certificate
  shows 1 ∈ idealSpan(A, add, zero, neg, mul, G)
proof
  exact idealSpan.unit_of_linear_combination2 with source, bounded, hp, hq, ha, hb, identity

section Evaluations
variable (f B plus z minus times unit : Set)
hypothesis target : IsCommRing(B, plus, z, minus, times, unit)
hypothesis hom : IsRingHom(f, A, add, zero, neg, mul, one, B, plus, z, minus, times, unit)
hypothesis nontrivial : Nontrivial(B, z, unit)
notation ring S := (B, plus, z, minus, times, unit)

theorem no_common_zero
  shows ¬(∀ g ∈ G, f(g) = S[0])
proof
  have certificate := idealSpan.unit_of_linear_combination2 with source, bounded, hp, hq, ha, hb, identity
  exact idealSpan.unit_obstructs_vanishing with source, target, hom, nontrivial, bounded, certificate

end Evaluations
end Rings
