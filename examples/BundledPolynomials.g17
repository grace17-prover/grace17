-- Bundled polynomial rings: the ring polynomialRing(R, I) over a bundled
-- coefficient ring, ring arithmetic on its elements, evaluation at a point
-- through the homomorphism laws, the point ideal over a field, and the
-- factor theorem in Horner form.
-- Part of Cumulus, the Grace17 mathematics library.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module BundledPolynomials
import Grace.Cumulus.Algebra.Polynomial.BundledIdeals
import Grace.Cumulus.Algebra.Polynomial.BundledRoots

-- Under CommRing(R) the instance polynomialRing.comm_ring makes
-- polynomialRing(R, I) a commutative ring, and the instance supplies the
-- ring the way a hypothesis does: a binder (p : polynomialRing(R, I)) is
-- membership in its carrier, its elements carry the ring notation, and
-- `ring` proves identities between polynomials.
section Polynomials
variable (R I : Set)
hypothesis comm : CommRing(R)

theorem difference_of_squares (p q : polynomialRing(R, I))
  shows (p + q) * (p - q) = p * p - q * q
proof
  ring

-- Evaluation at a point v : I → R is a homomorphism sending X_j to v(j)
-- and a constant to itself.
theorem evaluate_square_plus (v j : Set) (a : R)
  requires assignment : v : I → R.carrier
  requires index : j ∈ I
  shows evaluationAt(R, I, v)(X(R, I, j) * X(R, I, j) +
    polynomialConstant(R, I)(a)) = v(j) * v(j) + a
proof
  have evaluation := evaluationAt.hom with comm, assignment
  rw [RingHom.map_add, RingHom.map_mul, evaluationAt.map_X,
    evaluationAt.map_constant]
  rfl
end Polynomials

-- Over a field the point ideal is maximal, and X - a divides a Horner
-- polynomial vanishing at a.
section Fields
variable (R : Set)
hypothesis field : Field(R)

theorem point_ideal_maximal (I v : Set)
  requires assignment : v : I → R.carrier
  shows MaximalIdeal(polynomialRing(R, I), pointIdeal(R, I, v))
proof
  exact MaximalIdeal.point with *

theorem factor (leading a x c : R) (cs : List(R.carrier))
  requires root : horner(R, leading, a, c :: cs) = R[0]
  shows horner(R, leading, x, c :: cs) =
    (x - a) * horner(R, leading, x, syntheticQuotient(R, leading, a, cs))
proof
  have comm := Field.to_comm_ring with field
  exact horner.factor with *
end Fields
