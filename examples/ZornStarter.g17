module ZornStarter
import Grace.Cumulus.Set.Zorn

theorem maximal_element (A r : Set)
  requires order : IsPartialOrder(A, r)
  requires bounds : ∀ C, Chain(A, r, C) → ∃ u, UpperBound(A, r, C, u)
  shows ∃ m, Maximal(A, r, m)
proof
  have condition : ZornCondition(A, r)
    unfold ZornCondition
    refine ⟨order, bounds⟩
  exact Zorn.theorem with condition

-- The inclusion poset of chains supplies the first reusable application.
theorem maximal_chain (A r : Set)
  shows ∃ C, Chain(A, r, C) ∧ (∀ D, Chain(A, r, D) → C ⊆ D → D = C)
proof
  exact Chain.exists_maximal
