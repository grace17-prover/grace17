module User.MultigraphStarter
import Grace.Cumulus.GraphTheory

-- Two distinct bridges with the same endpoints contribute two to the degree.
theorem parallel_bridges_count_twice (leftEnd rightEnd edges x y : Set)
  requires distinct : edges[0] ≠ edges[1]
  requires endpoints : x ≠ y
  requires left0 : leftEnd(edges[0]) = x
  requires left1 : leftEnd(edges[1]) = x
  requires right0 : rightEnd(edges[0]) = y
  requires right1 : rightEnd(edges[1]) = y
  shows Multigraph.incidences(leftEnd, rightEnd, edges, x, 2) = 2
proof
  have xMember := singleton.self at x
  have xCount := indicator.member with xMember
  have yMissing : ¬(y ∈ {x})
    intro member
    have equal := singleton.membership.forward with member
    cc
  have yCount := indicator.absent with yMissing
  simp [Multigraph.incidences]

-- A loop has two incident ends even though it has just one edge identity.
theorem a_loop_counts_twice (leftEnd rightEnd edges x : Set)
  requires left : leftEnd(edges[0]) = x
  requires right : rightEnd(edges[0]) = x
  shows Multigraph.incidences(leftEnd, rightEnd, edges, x, 1) = 2
proof
  have member := singleton.self at x
  have value := indicator.member with member
  simp [Multigraph.incidences]

theorem closed_walk_degrees_are_even (V E leftEnd rightEnd edges vertices x : Set, n : Nat)
  requires walk : Multigraph.Walk(V, E, leftEnd, rightEnd, edges, vertices, n)
  requires closed : vertices[n] = vertices[0]
  shows Even(Multigraph.incidences(leftEnd, rightEnd, edges, x, n))
proof
  exact Multigraph.Walk.closed_even at V, E, leftEnd, rightEnd, edges, vertices, x, n with *

-- The obstruction uses a fixed enumeration, independently of the alleged trail.
theorem three_noneven_degrees_preclude_an_euler_trail (V E leftEnd rightEnd edges vertices enumeration a b c : Set, n m : Nat)
  requires enumeration : BijectiveBetween(enumeration, m, E)
  requires ab : a ≠ b
  requires ac : a ≠ c
  requires bc : b ≠ c
  requires degreeA : ¬Even(Multigraph.incidences(leftEnd, rightEnd, enumeration, a, m))
  requires degreeB : ¬Even(Multigraph.incidences(leftEnd, rightEnd, enumeration, b, m))
  requires degreeC : ¬Even(Multigraph.incidences(leftEnd, rightEnd, enumeration, c, m))
  shows ¬Multigraph.EulerTrail(V, E, leftEnd, rightEnd, edges, vertices, n)
proof
  exact Multigraph.EulerTrail.three_noneven_obstruction at V, E, leftEnd, rightEnd,
    edges, vertices, enumeration, a, b, c, n, m with *
