module BezoutStarter
import Grace.Cumulus.NumberTheory

-- Every natural-input GCD has coefficients in the existing integer carrier.
theorem bezout (a b : Nat)
  shows ∃ u, Integer(u) ∧ ∃ v, Integer(v) ∧
    integerLinearCombination(u, v, a, b) = integerOfNat(gcd(a, b))
proof
  exact gcd.bezout at a, b with *

-- 1*54 + (-2)*24 = 6. The equality is between quotient integers.
theorem signed_example
  shows integerLinearCombination(integerOfNat(1), integerNegativeOfNat(2), 54, 24) = integerOfNat(gcd(54, 24))
proof
  have result : gcd(54, 24) = 6
  . compute
  rw result
  simp [integerOfNat, integerNegativeOfNat, integerLinearCombination.classes]
  apply integerClass.eq with *{4}
  compute

-- Ordinary signed arithmetic has familiar notation and reusable laws.
theorem cancel (x : Integer)
  shows x + (-x) = integerZero
proof
  exact integerAddValue.neg_right at x with *

theorem distribute (x y z : Integer)
  shows x * (y + z) = x * y + x * z
proof
  exact integerMulValue.distribute_right at x, y, z with *
