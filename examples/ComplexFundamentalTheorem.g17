module ComplexFundamentalTheoremExample
import Grace.Cumulus.Complex.Nullstellensatz

section Complexes
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg, complexMul, complexOne)

theorem root_exists (cs : List(ℂ))
  requires nonconstant : cs ≠ []
  shows ∃ a ∈ ℂ, complexPolynomial(cs)(a) = ℂ[0]
proof
  exact complexPolynomial.has_root at cs with *

theorem square_root (b : Set)
  requires member : b ∈ ℂ
  shows ∃ a ∈ ℂ, ℂ[a * a] = b
proof
  exact complex.square_root at b with *

section Polynomials
variable (I G : Set)
notation ring P := ℂ[I]
hypothesis finite : Finite(I)
hypothesis generators : G ⊆ P

theorem no_common_zero_iff_unit
  shows P[1] ∈ idealSpan(P, G) ↔ ¬(∃ v, PolynomialCommonZero(I, ℂ, G, v))
proof
  exact complexes.weak_nullstellensatz at I, G with *

theorem no_common_zero_iff_certificate
  shows (∃ terms, List(idealProducts(P, G), terms) ∧ P[1] = ringSum{idealProducts(P, G)}(polynomialAdd(I, ℂ), P[0], terms)) ↔ ¬(∃ v, PolynomialCommonZero(I, ℂ, G, v))
proof
  exact complexes.unsatisfiable_iff_certificate at I, G with *

end Polynomials
end Complexes
