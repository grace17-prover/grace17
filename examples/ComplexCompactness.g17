module ComplexCompactnessExample
import Grace.Cumulus.Complex.Compactness
theorem disk_compact (radius : Real)
  shows ComplexSequentiallyCompact(closedComplexDisk(radius))
proof
  exact closedComplexDisk.sequentially_compact with *

theorem extract (u : Set) (radius : Real)
  requires sequence : ComplexSequence(u)
  requires terms : TermsIn(u, closedComplexDisk(radius))
  shows ∃ k, StrictlyIncreasingNat(k) ∧ ∃ a ∈ closedComplexDisk(radius),
    ComplexConvergesTo(complexSubsequence(u, k), a)
proof
  exact closedComplexDisk.bolzano_weierstrass with *

theorem norm_limit (u a : Set)
  requires converges : ComplexConvergesTo(u, a)
  shows ConvergesTo(complexNormSequence(u), complexNormSquared(a))
proof
  exact ComplexConvergesTo.norm_squared with *

theorem coordinate_bound (a radius : Real)
  requires squareBound : a * a ≤ radius
  shows -(radius + 1) ≤ a ∧ a ≤ radius + 1
proof
  exact realSquare.coordinate_bounds with *
