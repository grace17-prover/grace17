module DeterminantMaps
import Grace.Cumulus.Algebra.Polynomial.Determinant

section Maps
variable (A add zero neg mul one B plus z minus times unit h : Set)
notation ring R := (A, add, zero, neg, mul, one)
notation ring S := (B, plus, z, minus, times, unit)
hypothesis source : IsCommRing(R)
hypothesis target : IsCommRing(S)
hypothesis hom : IsRingHom(h, R, S)

theorem transport (n : Nat) (M N : Set)
  requires matrixM : RingMatrix(n, R, M)
  requires matrixN : RingMatrix(n, S, N)
  requires entries : ∀ i ∈ n, ∀ j ∈ n, N[i, j] = h(M[i, j])
  shows h(determinant(n, R, M)) = determinant(n, S, N)
proof
  exact determinant.map with *

end Maps

section Polynomials
variable (I A add zero neg mul one v : Set)
notation ring R := (A, add, zero, neg, mul, one)
notation ring P := R[I]
hypothesis ring : IsCommRing(R)
hypothesis assignment : v : I → R

theorem evaluate (n : Nat) (M N : Set)
  requires matrixM : RingMatrix(n, P, M)
  requires matrixN : RingMatrix(n, R, N)
  requires entries : ∀ i ∈ n, ∀ j ∈ n, N[i, j] = polynomialAt(I, R, v)(M[i, j])
  shows polynomialAt(I, R, v)(determinant(n, P, M)) = determinant(n, R, N)
proof
  exact determinant.evaluate with *

theorem evaluate_without_auxiliary_matrix (n : Nat) (M : Set)
  requires matrix : RingMatrix(n, P, M)
  shows polynomialAt(I, R, v)(determinant(n, P, M)) =
    determinant(n, R, matrixMap(n, P, R, polynomialAt(I, R, v), M))
proof
  exact determinant.evaluate_matrix with *

end Polynomials
