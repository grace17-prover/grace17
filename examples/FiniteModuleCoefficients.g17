-- Authors: Grant Passmore

module FiniteModuleCoefficients
import Grace.Cumulus.Algebra.SpanAnnihilator

section Algebras
variable (A add zero neg mul one B plus z minus times unit f : Set)
notation ring R := (A, add, zero, neg, mul, one)
notation ring S := (B, plus, z, minus, times, unit)
hypothesis source : IsCommRing(R)
hypothesis target : IsCommRing(S)
hypothesis hom : IsRingHom(f, R, S)

theorem extract_coefficients
  requires finiteModule : FiniteAlgebraModule(f, R, S)
  shows ∃ xs, List(B, xs) ∧ (∀ y ∈ S, ∃ cs, List(A, cs) ∧
    ListOps.length{A}(cs) = ListOps.length{B}(xs) ∧ y = linearCombination(R, S, f, xs, cs))
proof
  exact FiniteAlgebraModule.coefficients with *

theorem certify_finite_module (xs : List(B))
  requires representations : ∀ y ∈ S, ∃ cs, List(A, cs) ∧ y = linearCombination(R, S, f, xs, cs)
  shows FiniteAlgebraModule(f, R, S)
proof
  exact FiniteAlgebraModule.of_coefficients with *

theorem expose_one_coefficient (G x y : Set)
  requires bounded : G ⊆ S
  requires element : x ∈ S
  shows y ∈ linearSpan(f, R, S, insert(x, G)) ↔
    y ∈ S ∧ (∃ a ∈ R, ∃ u ∈ linearSpan(f, R, S, G), y = S[f(a) * x + u])
proof
  exact linearSpan.insert_membership with *

theorem span_membership (xs : List(B)) (y : Set)
  shows y ∈ linearSpan(f, R, S, listSupport{B}(xs)) ↔
    (∃ cs, List(A, cs) ∧ ListOps.length{A}(cs) = ListOps.length{B}(xs) ∧ y = linearCombination(R, S, f, xs, cs))
proof
  exact linearSpan.list_membership with *

theorem faithful_generators (G p : Set)
  requires bounded : G ⊆ S
  requires element : p ∈ S
  requires annihilates : ∀ g ∈ G, S[p * g] = S[0]
  requires unitIn : S[1] ∈ linearSpan(f, R, S, G)
  shows p = S[0]
proof
  exact linearSpan.annihilator_zero with *

theorem monic_annihilator_is_integral (G x : Set) (cs : List(A))
  requires bounded : G ⊆ S
  requires element : x ∈ S
  requires unitIn : S[1] ∈ linearSpan(f, R, S, G)
  requires annihilates : ∀ g ∈ G, S[monicValue(R, f, S, x, cs) * g] = S[0]
  shows IntegralOver(f, R, S, x)
proof
  exact IntegralOver.of_annihilates_generators with *

-- Duplicate generators are allowed; this is not a basis representation.
theorem repeated_generator (x a b : Set)
  requires element : x ∈ S
  requires first : a ∈ R
  requires second : b ∈ R
  shows linearCombination(R, S, f, [x, x], [a, b]) = S[f(R[a + b]) * x]
proof
  have imageA := IsRingHom.closed with hom, first
  have imageB := IsRingHom.closed with hom, second
  have mapped := IsRingHom.add with hom, first, second
  simp [linearCombination, listHeadOr, listTail]
  ring

theorem no_generators (cs : List(A))
  shows linearCombination(R, S, f, [], cs) = S[0]
proof
  rw linearCombination
  rfl

end Algebras
