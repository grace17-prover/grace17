-- Authors: Grant Passmore

module PolynomialGeneration
import Grace.Cumulus.Algebra.Polynomial.FiniteGeneration

section Polynomials
variable (I A add zero neg mul one : Set)
notation ring R := (A, add, zero, neg, mul, one)
notation ring P := R[I]
hypothesis coefficients : IsCommRing(R)

theorem coefficients_and_variables_suffice (T : Set)
  requires subalgebra : Subalgebra(polynomialCoefficients(I, R), R, P, T)
  requires variables : ∀ j ∈ I, polynomialVariable(I, R, j) ∈ T
  shows T = P
proof
  exact polynomialSubalgebra.eq_carrier with coefficients, subalgebra, variables

theorem adjoining_variables_gives_polynomials
  shows algebraAdjoin(polynomialCoefficients(I, R), R, P, polynomialGenerators(I, R)) = P
proof
  exact polynomialGenerators.adjoin at I, A, add, zero, neg, mul, one with *

theorem finite_variables_give_finite_generation
  requires variables : Finite(I)
  shows FinitelyGeneratedAlgebra(polynomialCoefficients(I, R), R, P)
proof
  exact polynomials.finitely_generated at I, A, add, zero, neg, mul, one with *

section ResidueFields
variable (J : Set)
notation ring Q := P ⧸ J

theorem maximal_quotient_is_a_finitely_generated_field
  requires finite : Finite(I)
  requires maximal : IsMaximalIdeal(P, J)
  shows IsField(Q) ∧ FinitelyGeneratedAlgebra(compose(quotientProjection(P, idealRelation(P, J)), polynomialCoefficients(I, R), R, P, Q), R, Q)
proof
  exact polynomialQuotient.maximal_residue at I, A, add, zero, neg, mul, one, J with *

end ResidueFields
end Polynomials
