module FiniteSupportCoefficients
import Grace.Cumulus.Algebra.Coefficients

section Coefficients
variable (I A add zero neg mul one : Set)
hypothesis ring : IsCommRing(A, add, zero, neg, mul, one)

theorem zero_in_carrier
  shows constantFunction(I, A, zero) ∈ coefficientMaps(I, A, zero)
proof
  have map := CoefficientMap.zero at I, A, add, zero, neg, mul, one with *
  exact coefficientMaps.contains with map

theorem linear_combination (a f g : Set)
  requires scalar : a ∈ A
  requires left : CoefficientMap(f, I, A, zero)
  requires right : CoefficientMap(g, I, A, zero)
  shows coefficientAdd(I, A, add, zero, neg, mul, one, coefficientScale(I, A, add, zero, neg, mul, one, a, f), g) ∈ coefficientMaps(I, A, zero)
proof
  have scaled := CoefficientMap.scale at I, A, add, zero, neg, mul, one, a, f with *
  have combined := CoefficientMap.add with ring, scaled, right
  exact coefficientMaps.contains with combined

theorem finite_enumeration (f : Set)
  requires map : CoefficientMap(f, I, A, zero)
  shows ∃ xs, List(I, xs) ∧ functionSupport(f, I, zero) ⊆ listSupport{I}(xs)
proof
  exact CoefficientMap.support_list at I, A, add, zero, neg, mul, one, f with *

theorem cancellation (f : Set)
  requires map : CoefficientMap(f, I, A, zero)
  shows coefficientAdd(I, A, add, zero, neg, mul, one, f, coefficientNeg(I, A, add, zero, neg, mul, one, f)) = constantFunction(I, A, zero)
proof
  have function := CoefficientMap.function with map
  exact coefficientAdd.inverse with ring, function

end Coefficients
