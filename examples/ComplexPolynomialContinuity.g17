module ComplexPolynomialContinuityExample
import Grace.Cumulus.Complex.Continuity

theorem everywhere (cs : List(complexCarrier))
  shows ComplexContinuous(complexPolynomial(cs))
proof
  exact complexPolynomial.continuous with *

theorem at_point (a : Set) (cs : List(complexCarrier))
  requires center : a ∈ complexCarrier
  shows ComplexContinuousAt(complexPolynomial(cs), a)
proof
  exact complexPolynomial.continuous_at with *

theorem small_product (e b t : Real)
  requires epsilon : 0 < e
  requires nonnegative : 0 ≤ t
  requires small : t < scaledRadius(e, limitScale(b))
  shows t * b < e
proof
  exact scaledRadius.product_control with *

section Geometry
notation ring C := (complexCarrier, complexAdd, complexZero, complexNeg, complexMul, complexOne)

theorem distance (z w : Set)
  requires first : z ∈ C
  requires second : w ∈ C
  shows complexNormSquared(C[z - w]) = Euclidean.distanceSquared(z, w)
proof
  exact complexNormSquared.difference_distance with *

end Geometry
