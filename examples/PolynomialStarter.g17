module PolynomialStarter
import Grace.Cumulus.Algebra.Polynomial

theorem monomial_structure (I : Set)
  shows IsCommMonoid(monomials(I), monomialMul(I), monomialOne(I))
proof
  exact monomials.comm_monoid

theorem squared_variable (I j : Set)
  requires index : j ∈ I
  shows monomialProduct(I, monomialVariable(I, j), monomialVariable(I, j))(j) = 2
proof
  have variable := monomialVariable.member at I, j
  have product := monomialProduct.value at I, monomialVariable(I, j), monomialVariable(I, j), j with *
  have exponent := monomialVariable.same with index
  rw product
  rw exponent
  compute

theorem faithful_constants (I A z a b : Set)
  requires zeroIn : z ∈ A
  requires left : a ∈ A
  requires right : b ∈ A
  requires equal : polynomialConstant(I, A, z, a) = polynomialConstant(I, A, z, b)
  shows a = b
proof
  exact polynomialConstant.injective at I, A, z, a, b with *

theorem faithful_variables (I A z unit j k : Set)
  requires zeroIn : z ∈ A
  requires unitIn : unit ∈ A
  requires nonzero : unit ≠ z
  requires first : j ∈ I
  requires second : k ∈ I
  requires equal : polynomialVariable(I, A, z, unit, j) = polynomialVariable(I, A, z, unit, k)
  shows j = k
proof
  exact polynomialVariable.injective at I, A, z, unit, j, k with *

theorem ignore_new_zero_term (V A add zero neg mul one w a : Set)
  requires ring : IsCommRing(A, add, zero, neg, mul, one)
  requires finite : Finite(V)
  requires weights : w : insert(a, V) → A
  requires fresh : ¬(a ∈ V)
  requires vanishes : w(a) = zero
  shows finiteRingSum(insert(a, V), A, add, zero, neg, mul, one, w) =
    finiteRingSum(V, A, add, zero, neg, mul, one, restrict(w, V))
proof
  exact finiteRingSum.insert_zero at V, A, add, zero, neg, mul, one, w, a with *
