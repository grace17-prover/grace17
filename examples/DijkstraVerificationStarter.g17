module User.DijkstraVerificationStarter
import Grace.Cumulus.GraphTheory

theorem executable_comparison (a b : Nat)
  shows Dijkstra.less(a, b) = Bool.true ↔ a < b
proof
  exact Dijkstra.less.true_iff with assumption, assumption

theorem relaxation_improves (old weight distance : Option(ℕ), flag : Bool)
  shows Dijkstra.DistanceAtMost(Dijkstra.relaxValue(old, weight, flag, distance), old)
proof
  exact Dijkstra.relaxValue.no_increase with assumption, assumption, assumption, assumption

-- The competing paths have arbitrary finite length.
theorem certified_greedy_step (V E weights source S labels bound target : Set)
  requires settled : SettledLowerBounds(V, E, weights, source, S, labels)
  requires frontier : FrontierCutBound(V, E, weights, source, S, labels, bound)
  requires targetIn : target ∈ V
  requires outside : ¬(target ∈ S)
  requires path : HasPathCost(V, E, weights, source, target, bound)
  shows ShortestPathCost(V, E, weights, source, target, bound)
proof
  exact FrontierCutBound.certifies_next with settled, frontier, targetIn, outside, path

theorem no_path_across_closed_boundary (V E weights source target cost S : Set)
  requires start : source ∈ S
  requires closed : EdgeClosed(V, E, S)
  requires targetIn : target ∈ V
  requires outside : ¬(target ∈ S)
  requires costNat : Nat(cost)
  shows ¬HasPathCost(V, E, weights, source, target, cost)
proof
  exact EdgeClosed.excludes_path with start, closed, targetIn, outside, costNat

theorem finite_update
  shows Dijkstra.relaxValue(Option.some(20), Option.some(4), Bool.false, Option.some(7)) = Option.some(11)
proof
  compute

theorem settled_update
  shows Dijkstra.relaxValue(Option.some(20), Option.some(4), Bool.true, Option.some(7)) = Option.some(20)
proof
  compute

-- The public theorem applies to arbitrary represented matrices and sizes.
theorem computed_cost_is_shortest (count source target distance : Nat, E weights rows : Set)
  requires sourceIn : source ∈ Dijkstra.Vertices(count)
  requires targetIn : target ∈ Dijkstra.Vertices(count)
  requires matrix : Dijkstra.MatrixRepresents(count, rows, E, weights)
  requires value : Dijkstra.entry(Dijkstra.distances(Dijkstra.solve(count, source, rows)), target) = Option.some(distance)
  shows ShortestPathCost(Dijkstra.Vertices(count), E, weights, source, target, distance)
proof
  have correct := Dijkstra.solve.correct with assumption, assumption, assumption, sourceIn, targetIn, matrix
  rcases correct with ⟨finite, unreachable⟩
  have distanceIn := nat.omega.forward at distance with assumption
  have characterization := finite with distance, distanceIn
  exact characterization.forward with value

theorem none_exactly_unreachable (count source target : Nat, E weights rows : Set)
  requires sourceIn : source ∈ Dijkstra.Vertices(count)
  requires targetIn : target ∈ Dijkstra.Vertices(count)
  requires matrix : Dijkstra.MatrixRepresents(count, rows, E, weights)
  shows Dijkstra.entry(Dijkstra.distances(Dijkstra.solve(count, source, rows)), target) = Option.none ↔
    (∀ cost ∈ ℕ, ¬HasPathCost(Dijkstra.Vertices(count), E, weights, source, target, cost))
proof
  have correct := Dijkstra.solve.correct with assumption, assumption, assumption, sourceIn, targetIn, matrix
  rcases correct with ⟨finite, unreachable⟩
  exact unreachable
