module MaximalIndependentFamily
import Grace.Cumulus.Algebra.Polynomial.IndependentSubfamily

theorem finite_subsets (I : Set)
  requires finite : Finite(I)
  shows Finite(𝒫(I))
proof
  exact Finite.powerset with *

theorem maximal_member (F J : Set)
  requires finite : Finite(F)
  requires seed : J ∈ F
  shows ∃ M ∈ F, J ⊆ M ∧ (∀ T ∈ F, M ⊆ T → T = M)
proof
  exact Finite.maximal_extension with *

section Rings
variable (I A add z neg mul one B plus o minus times unit f v : Set)
notation ring R := (A, add, z, neg, mul, one)
notation ring S := (B, plus, o, minus, times, unit)
hypothesis source : IsCommRing(R)
hypothesis target : IsCommRing(S)
hypothesis hom : IsRingHom(f, R, S)

theorem empty_family
  requires injective : InjectiveBetween(f, R, S)
  requires emptyAssignment : v : ∅ → S
  shows AlgebraicallyIndependent(∅, R, S, f, v)
proof
  exact AlgebraicallyIndependent.empty with *

theorem maximal_independent_family
  requires finite : Finite(I)
  requires injective : InjectiveBetween(f, R, S)
  requires assignment : v : I → S
  shows ∃ M, M ⊆ I ∧ AlgebraicallyIndependent(M, R, S, f, restrict(v, M)) ∧
    (∀ T, T ⊆ I → M ⊆ T → AlgebraicallyIndependent(T, R, S, f, restrict(v, T)) → T = M)
proof
  exact AlgebraicallyIndependent.exists_maximal with *

theorem extend_independent_family (J : Set)
  requires finite : Finite(I)
  requires subset : J ⊆ I
  requires independent : AlgebraicallyIndependent(J, R, S, f, restrict(v, J))
  shows ∃ M, M ⊆ I ∧ J ⊆ M ∧ AlgebraicallyIndependent(M, R, S, f, restrict(v, M)) ∧
    (∀ T, T ⊆ I → M ⊆ T → AlgebraicallyIndependent(T, R, S, f, restrict(v, T)) → T = M)
proof
  exact AlgebraicallyIndependent.maximal_extension with *

section Adjoin
variable (M j : Set)
notation ring Q := R[insert(j, M)]

theorem excluded_generator_has_relation
  requires assignment : v : I → S
  requires subset : M ⊆ I
  requires maximal : ∀ T, T ⊆ I → M ⊆ T → AlgebraicallyIndependent(T, R, S, f, restrict(v, T)) → T = M
  requires index : j ∈ I
  requires outside : ¬(j ∈ M)
  shows ∃ p ∈ Q, p ≠ Q[0] ∧
    polynomialAtOver(insert(j, M), R, S, f, restrict(v, insert(j, M)))(p) = S[0]
proof
  exact AlgebraicallyIndependent.maximal_adjoin_relation with *

end Adjoin
end Rings
