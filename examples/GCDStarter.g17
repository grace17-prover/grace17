module GCDStarter
import Grace.Cumulus.NumberTheory

-- Each step is a checked equality; no GCD computation is trusted.
theorem euclidean_example
  shows IsGCD(252, 198, 18)
proof
  have terminal := IsGCD.zero_right at 18 with *
  have last : 36 = 18 * 2 + 0
  . compute
  have third := IsGCD.euclidean_backward at 36, 18, 2, 0, 18 with *
  have secondEquation : 54 = 36 * 1 + 18
  . compute
  have second := IsGCD.euclidean_backward at 54, 36, 1, 18, 18 with *
  have firstEquation : 198 = 54 * 3 + 36
  . compute
  have first := IsGCD.euclidean_backward at 198, 54, 3, 36, 18 with *
  have start : 252 = 198 * 1 + 54
  . compute
  exact IsGCD.euclidean_backward at 252, 198, 1, 54, 18 with *

theorem all_common_divisors (d : Nat)
  requires left : d ∣ 252
  requires right : d ∣ 198
  shows d ∣ 18
proof
  exact IsGCD.greatest with *{4}, euclidean_example, left, right

theorem zero_pair
  shows IsGCD(0, 0, 0)
proof
  exact IsGCD.zero_right at 0 with *

theorem divisible_pair (a b : Nat)
  shows IsGCD(a, a * b, a)
proof
  have self := divides.reflexive at a with *
  have multiple := divides.multiply_right at a, a, b with *
  exact IsGCD.of_divides at a, a * b with *

-- Preservation also holds for zero divisors and noncanonical remainders.
theorem add_multiple (a b q g : Nat)
  requires gcd : IsGCD(a, b, g)
  shows IsGCD(b * q + a, b, g)
proof
  have reversed := IsGCD.symmetric at a, b, g with *
  have equation : b * q + a = b * q + a
  . rfl
  exact IsGCD.euclidean_backward at b * q + a, b, q, a, g with *


-- The executable function is now correct for all natural inputs.
theorem executable_example
  shows gcd(252, 198) = 18
proof
  compute

theorem certificate_agrees
  shows gcd(252, 198) = 18
proof
  simp

theorem consecutive (n : Nat)
  shows gcd(n, succ(n)) = 1
proof
  have natural := gcd.natural at n, succ(n) with *
  have left := gcd.divides_left at n, succ(n) with *
  have right := gcd.divides_right at n, succ(n) with *
  exact divides.consecutive_one at gcd(n, succ(n)), n with *
