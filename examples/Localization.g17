module Localization
import Grace.Cumulus.Algebra.Field.PrincipalLocalization

section Coefficients
variable (B plus z minus times unit T s y : Set)
notation ring S := (B, plus, z, minus, times, unit)
hypothesis field : IsField(S)
hypothesis subring : IsSubring(S, T)
hypothesis element : s ∈ T
hypothesis nonzero : s ≠ S[0]
hypothesis inverse : IsInverse(B, times, unit, s, y)

theorem clear_coefficients (cs : List(B))
  requires coefficients : listSupport{B}(cs) ⊆ generatedSubring(S, insert(y, T))
  shows ∃ n, Nat(n) ∧ (∀ a ∈ listSupport{B}(cs), S[monoidPow(S, s, n) * a] ∈ T)
proof
  have finite := listSupport.finite at B, cs with *
  have localization := localizationWithin.adjoin_single_inverse at B, plus, z, minus, times, unit, T, s, y with *
  rw ← localization at coefficients
  exact localizationWithin.clear_common_power with field, subring, element, nonzero, finite, coefficients

end Coefficients

section Obstruction
variable (A add zero neg mul one B plus z minus times unit f T D : Set)
notation ring R := (A, add, zero, neg, mul, one)
notation ring S := (B, plus, z, minus, times, unit)
hypothesis source : IsCommRing(R)
hypothesis field : IsField(S)
hypothesis hom : IsRingHom(f, R, S)
hypothesis subalgebra : Subalgebra(f, R, S, T)
hypothesis denominators : Denominators(S, T, D)

theorem proper_fraction_field_is_not_module_finite
  requires proper : T ≠ S
  requires fractions : localizationWithin(S, T, D) = S
  shows ¬FiniteAlgebraModule(f, R, S)
proof
  intro finite
  have equal := localizationWithin.eq_field_of_finite_module with source, field, hom, subalgebra, denominators, finite, fractions
  exact proper with equal

end Obstruction
