module Introduction
import Grace.Cumulus.Set.Core
import Grace.Cumulus.Int

theorem subset_step (A B x : Set)
  requires included : A ⊆ B
  requires member : x ∈ A
  shows x ∈ B
proof
  simp

theorem subset_chain (A B C : Set)
  requires first : A ⊆ B
  requires second : B ⊆ C
  shows A ⊆ C
proof
  exact Subset.transitive with *

theorem difference_of_squares (x y : Integer)
  shows (x + y) * (x - y) = x * x - y * y
proof
  ring
