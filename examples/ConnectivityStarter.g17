module User.ConnectivityStarter
import Grace.Cumulus.GraphTheory

-- Components form a set-sized partition, even for infinite V.
theorem every_vertex_is_covered (V E : Set)
  shows ⋃(components(V, E)) = V
proof
  exact components.cover

theorem overlap_forces_equality (V E x y z : Set)
  requires graph : SimpleGraph(V, E)
  requires hx : x ∈ V
  requires hy : y ∈ V
  requires first : z ∈ component(V, E, x)
  requires second : z ∈ component(V, E, y)
  shows component(V, E, x) = component(V, E, y)
proof
  exact component.equal_of_common_vertex with graph, hx, hy, first, second

-- The connecting routes stay in the component itself.
theorem routes_stay_inside (V E x : Set)
  requires graph : SimpleGraph(V, E)
  requires hx : x ∈ V
  shows GraphConnected(component(V, E, x), inducedEdges(E, component(V, E, x)))
proof
  exact component.induced_connected with graph, hx

theorem no_edges_between_components (V E x u v : Set)
  requires inside : u ∈ component(V, E, x)
  requires hv : v ∈ V
  requires outside : ¬(v ∈ component(V, E, x))
  shows ¬Adjacent(E, u, v)
proof
  exact component.no_crossing_edge with inside, hv, outside

-- Opposite extremes: no edges give singleton components; all edges give V.
theorem isolated_components (V x : Set)
  requires hx : x ∈ V
  shows component(V, empty, x) = {x}
proof
  exact component.empty_graph with hx

theorem complete_component (V x : Set)
  requires hx : x ∈ V
  shows component(V, completeEdges(V), x) = V
proof
  have connected := completeEdges.connected at V
  exact GraphConnected.component with connected, hx

-- Every inhabited proper vertex subset of a connected graph has an exit edge.
theorem a_connected_graph_crosses_every_cut (V E A : Set)
  requires connected : GraphConnected(V, E)
  requires included : A ⊆ V
  requires inhabited : Nonempty(A)
  requires proper : A ≠ V
  shows ∃ u ∈ A, ∃ v ∈ V, ¬(v ∈ A) ∧ Adjacent(E, u, v)
proof
  exact GraphConnected.crossing_edge at V, E, A with *
