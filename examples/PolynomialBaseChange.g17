module PolynomialBaseChange
import Grace.Cumulus.Algebra.Polynomial.EvaluationOver

section Rings
variable (I A add z neg mul one B plus o minus times unit f v : Set)
notation ring R := (A, add, z, neg, mul, one)
notation ring S := (B, plus, o, minus, times, unit)
notation ring P := R[I]
notation ring Q := S[I]
hypothesis source : IsCommRing(R)
hypothesis target : IsCommRing(S)
hypothesis hom : IsRingHom(f, R, S)

theorem map_is_hom
  shows IsRingHom(polynomialMap(I, R, S, f), P, Q)
proof
  exact polynomialMap.hom with *

theorem faithful_base_change
  requires injective : InjectiveBetween(f, R, S)
  shows InjectiveBetween(polynomialMap(I, R, S, f), P, Q)
proof
  exact polynomialMap.injective with *

theorem evaluation_is_hom
  requires assignment : v : I → S
  shows IsRingHom(polynomialAtOver(I, R, S, f, v), P, S)
proof
  exact polynomialAtOver.hom with *

theorem evaluate_variable (j : Set)
  requires assignment : v : I → S
  requires index : j ∈ I
  shows polynomialAtOver(I, R, S, f, v)(polynomialVariable(I, R, j)) = v(j)
proof
  exact polynomialAtOver.variable with *

theorem no_polynomial_relation (p : Set)
  requires assignment : v : I → S
  requires independent : AlgebraicallyIndependent(I, R, S, f, v)
  requires polynomial : p ∈ P
  shows polynomialAtOver(I, R, S, f, v)(p) = S[0] ↔ p = P[0]
proof
  exact AlgebraicallyIndependent.relation_iff with *

end Rings

section Canonical
variable (I A add z neg mul one : Set)
notation ring R := (A, add, z, neg, mul, one)
notation ring P := R[I]
hypothesis ring : IsCommRing(R)

theorem canonical_independence
  shows AlgebraicallyIndependent(I, R, P, polynomialCoefficients(I, R), polynomialVariables(I, R))
proof
  exact polynomialVariables.algebraically_independent with *

end Canonical
