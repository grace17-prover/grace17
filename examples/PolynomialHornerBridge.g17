module PolynomialHornerBridge
import Grace.Cumulus.Algebra.Polynomial.HornerLocalization
import Grace.Cumulus.Algebra.Polynomial.Variables

section Sparse
variable (I A add z neg mul one p v w : Set)
notation ring R := (A, add, z, neg, mul, one)
notation ring P := R[I]
hypothesis ring : IsCommRing(R)
hypothesis polynomial : p ∈ P

theorem finitely_many_variables
  shows Finite(polynomialVariablesUsed(I, R, p))
proof
  exact polynomialVariablesUsed.finite with *

theorem evaluation_depends_on_used_variables
  requires first : v : I → R
  requires second : w : I → R
  requires agreement : ∀ i ∈ polynomialVariablesUsed(I, R, p), v(i) = w(i)
  shows polynomialAt(I, R, v)(p) = polynomialAt(I, R, w)(p)
proof
  exact polynomialAt.agree_on_variables with *

end Sparse

section Horner
variable (I A add z neg mul one j leading : Set)
notation ring R := (A, add, z, neg, mul, one)
notation ring P := R[I]
hypothesis field : IsField(R)
hypothesis initial : leading ∈ R
hypothesis nonzero : leading ≠ R[0]
hypothesis infinite : ¬Finite(R)
hypothesis index : j ∈ I

theorem nonvanishing (cs : List(A))
  shows ∃ v, FunctionBetween(v, I, R) ∧ polynomialAt(I, R, v)(polynomialFromHorner(I, R, j, leading, cs)) ≠ R[0]
proof
  exact polynomialFromHorner.nonvanishing with *

end Horner

section Localizations
variable (I A add z neg mul one B plus o minus times unit g j leading T : Set)
notation ring R := (A, add, z, neg, mul, one)
notation ring P := R[I]
notation ring S := (B, plus, o, minus, times, unit)
notation ring L := S ↾ T
hypothesis coefficients : IsField(R)
hypothesis infinite : ¬Finite(R)
hypothesis initial : leading ∈ R
hypothesis nonzero : leading ≠ R[0]
hypothesis index : j ∈ I
hypothesis target : IsCommRing(S)
hypothesis embedding : IsRingHom(g, P, S)
hypothesis injective : InjectiveBetween(g, P, S)

theorem not_a_field (cs : List(A))
  requires carrier : T = localizationWithin(S, functionImage(g, P, S), functionImage(g, denominatorPowers(P, polynomialFromHorner(I, R, j, leading, cs)), S))
  shows ¬IsField(L)
proof
  exact polynomialLocalization.not_field_from_horner with *

end Localizations
