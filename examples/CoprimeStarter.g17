module CoprimeStarter
import Grace.Cumulus.NumberTheory

theorem cancel_coprime_factor (a b c : Integer)
  requires coprime : IntegerCoprime(a, b)
  requires product : IntegerDivides(a, b * c)
  shows IntegerDivides(a, c)
proof
  exact IntegerCoprime.cancel at a, b, c with *

theorem inverse_exists (a m : Integer)
  requires coprime : IntegerCoprime(a, m)
  shows ∃ u, Integer(u) ∧ IntegerCongruent(m, a * u, integerOne)
proof
  exact IntegerCoprime.modular_inverse at a, m with *

theorem inverse_unique_modulo (a m u v : Integer)
  requires first : IntegerCongruent(m, a * u, integerOne)
  requires second : IntegerCongruent(m, a * v, integerOne)
  shows IntegerCongruent(m, u, v)
proof
  exact IntegerCongruent.inverse_unique at m, a, u, v with *

-- 4 is an inverse of 3 modulo 11, certified from 12 = 1 + 11*1.
theorem inverse_three_mod_eleven
  shows IntegerCongruent(integerOfNat(11), integerOfNat(3) * integerOfNat(4), integerOne)
proof
  have difference : 12 = 1 + 11 * 1
  . compute
  have congruent := IntegerCongruent.of_natural_difference at 11, 12, 1, 1 with *
  have product := integerOfNat.mul at 3, 4 with *
  have twelve : 3 * 4 = 12
  . compute
  rw twelve at product
  rw product at congruent
  simpa [integerOne] using congruent
