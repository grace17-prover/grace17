module LeastNaturalStarter
import Grace.Cumulus.Nat
import Grace.Cumulus.Set.Core

theorem least_of_unordered_pair
  shows leastNatural({7, 3}) = 3
proof
  have three : Nat(3) by typecheck
  have seven : Nat(7) by typecheck
  have inhabited : Nonempty({7, 3})
    unfold Nonempty
    witness 3
    exact pair.right
  have naturals : {7, 3} ⊆ ℕ
    have threeIn := nat.omega.forward with three
    have sevenIn := nat.omega.forward with seven
    simp
  have selected := leastNatural.selected at {7, 3} with *
  rcases selected with ⟨natural, member, minimal⟩
  have chosenNat := nat.omega.backward with natural
  have threeMember := pair.right at 7, 3
  have bound := leastNatural.least at {7, 3}, 3 with *
  have alternatives := pair.membership.forward at 7, 3, leastNatural({7, 3}) with member
  cases alternatives with isSeven | isThree
  . rw isSeven at bound
    have impossible : 7 < 7 by arith
    exfalso
    exact Less.irreflexive with seven, impossible
  . exact isThree
