module ZornApplications
import Grace.Cumulus.Algebra.Field.Quotient
import Grace.Cumulus.Algebra.Ring.MaximalIdeal
import Grace.Cumulus.Algebra.Ring.Quotient

-- Hausdorff's maximal principle, preserving any chain we already have.
theorem extend_chain (A r C : Set)
  requires chain : Chain(A, r, C)
  shows ∃ M, Chain(A, r, M) ∧ C ⊆ M ∧
    (∀ D, Chain(A, r, D) → M ⊆ D → D = M)
proof
  exact Chain.extends_maximal at A, r, C with *

-- Starting at a specified element, and obtaining a maximal element above it.
theorem maximal_above (A r a : Set)
  requires zorn : ZornCondition(A, r)
  requires start : a ∈ A
  shows ∃ m, Maximal(A, r, m) ∧ relates(r, a, m)
proof
  exact Zorn.above at A, r, a with *

-- Krull's theorem. The carrier and all ring operations are sets.
-- This works for arbitrary unital rings and two-sided ideals.
theorem maximal_ideal (A add zero neg mul one : Set)
  requires ring : IsRing(A, add, zero, neg, mul, one)
  requires nontrivial : Nontrivial(A, zero, one)
  shows ∃ M, IsMaximalIdeal(A, add, zero, neg, mul, one, M)
proof
  exact IsMaximalIdeal.exists_of_nontrivial at A, add, zero, neg, mul,
    one with *

-- The usual textbook formulation, with a prescribed proper ideal I.
theorem extend_ideal (A add zero neg mul one I : Set)
  requires ring : IsRing(A, add, zero, neg, mul, one)
  requires proper : IsProperIdeal(A, add, zero, neg, mul, one, I)
  shows ∃ M, IsProperIdeal(A, add, zero, neg, mul, one, M) ∧ I ⊆ M ∧
    (∀ J, IsIdeal(A, add, zero, neg, mul, J) → M ⊆ J → J = M ∨ J = A)
proof
  obtain ⟨M, maximal, contains⟩ := IsMaximalIdeal.exists_above at A, add, zero, neg, mul, one, I with proper
  have properM : IsProperIdeal(A, add, zero, neg, mul, one, M) by settle with IsMaximalIdeal
  witness M
  constructor
  . exact properM
  . constructor
    . exact contains
    . intros J ideal includes
      exact IsMaximalIdeal.eq_or_whole at A, add, zero, neg, mul, one, M,
        J with *

-- Ordinary AC gives a prime ideal extending any given proper ideal.
theorem extend_to_prime (A add zero neg mul one I : Set)
  requires ring : IsCommRing(A, add, zero, neg, mul, one)
  requires proper : IsProperIdeal(A, add, zero, neg, mul, one, I)
  shows ∃ P, IsPrimeIdeal(A, add, zero, neg, mul, one, P) ∧ I ⊆ P
proof
  exact IsPrimeIdeal.exists_above at A, add, zero, neg, mul, one, I with *

-- Zorn supplies a domain quotient whose kernel contains the prescribed ideal.
theorem exists_domain_quotient (A add zero neg mul one I : Set)
  requires ring : IsCommRing(A, add, zero, neg, mul, one)
  requires proper : IsProperIdeal(A, add, zero, neg, mul, one, I)
  shows ∃ P, I ⊆ P ∧ IsIntegralDomain((A ⧸ idealRelation(A, add, neg, P)),
    quotientBinary(A, idealRelation(A, add, neg, P), add),
    ⟦zero⟧[A, idealRelation(A, add, neg, P)],
    quotientUnary(A, idealRelation(A, add, neg, P), neg),
    quotientBinary(A, idealRelation(A, add, neg, P), mul),
    ⟦one⟧[A, idealRelation(A, add, neg, P)])
proof
  obtain ⟨P, prime, contains⟩ := IsPrimeIdeal.exists_above at A, add, zero, neg, mul, one, I with *
  have domain := idealQuotient.domain_of_prime at A, add, zero, neg, mul, one, P with *
  refine ⟨P, contains, domain⟩

-- Every prescribed proper ideal lies in the kernel of a field quotient.
-- Choice is used to obtain M; constructing the quotient and inverse is ZF.
theorem exists_field_quotient (A add zero neg mul one I : Set)
  requires ring : IsCommRing(A, add, zero, neg, mul, one)
  requires proper : IsProperIdeal(A, add, zero, neg, mul, one, I)
  shows ∃ M, I ⊆ M ∧ IsFieldWithInverse((A ⧸ idealRelation(A, add, neg, M)),
    quotientBinary(A, idealRelation(A, add, neg, M), add), ⟦zero⟧[A, idealRelation(A, add, neg, M)],
    quotientUnary(A, idealRelation(A, add, neg, M), neg), quotientBinary(A, idealRelation(A, add, neg, M), mul), ⟦one⟧[A, idealRelation(A, add, neg, M)],
    idealQuotientInverse(A, add, zero, neg, mul, one, M))
proof
  obtain ⟨M, maximal, contains⟩ := IsMaximalIdeal.exists_above at A, add, zero, neg, mul, one, I with proper
  have field := idealQuotient.field_of_maximal at A, add, zero, neg, mul, one, M with *
  refine ⟨M, contains, field⟩
