module User.KonigsbergStarter
import Grace.Cumulus.GraphTheory

theorem the_seven_bridges
  shows ¬(∃ n ∈ ℕ, ∃ edges, ∃ vertices,
    Multigraph.EulerTrail(4, 7, Konigsberg.leftEnd, Konigsberg.rightEnd, edges, vertices, n))
proof
  exact Konigsberg.no_euler_trail_exists

theorem the_city_is_a_multigraph
  shows Multigraph.Graph(4, 7, Konigsberg.leftEnd, Konigsberg.rightEnd)
proof
  exact Konigsberg.graph

theorem the_four_degrees
  shows Multigraph.incidences(Konigsberg.leftEnd, Konigsberg.rightEnd, identity(7), 0, 7) = 3 ∧
    Multigraph.incidences(Konigsberg.leftEnd, Konigsberg.rightEnd, identity(7), 1, 7) = 3 ∧
    Multigraph.incidences(Konigsberg.leftEnd, Konigsberg.rightEnd, identity(7), 2, 7) = 5 ∧
    Multigraph.incidences(Konigsberg.leftEnd, Konigsberg.rightEnd, identity(7), 3, 7) = 3
proof
  refine ⟨Konigsberg.degree_land1, Konigsberg.degree_land2,
    Konigsberg.degree_island1, Konigsberg.degree_island2⟩
