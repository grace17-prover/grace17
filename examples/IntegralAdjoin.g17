-- Authors: Grant Passmore

module IntegralAdjoin
import Grace.Cumulus.Algebra.Field.Algebraic

section Algebras
variable (A add zero neg mul one B plus z minus times unit f x a : Set)
notation ring R := (A, add, zero, neg, mul, one)
notation ring S := (B, plus, z, minus, times, unit)
hypothesis source : IsCommRing(R)
hypothesis target : IsCommRing(S)
hypothesis hom : IsRingHom(f, R, S)
hypothesis element : x ∈ S
hypothesis coefficient : a ∈ R
hypothesis quadratic : S[x * x] = f(a)

theorem quadratic_root_is_integral
  shows IntegralOver(f, R, S, x)
proof
  exact IntegralOver.of_square with *

theorem adjoining_a_quadratic_root_is_module_finite
  shows ∃ G, Finite(G) ∧ G ⊆ algebraAdjoin(f, R, S, {x}) ∧ linearSpan(f, R, S, G) = algebraAdjoin(f, R, S, {x})
proof
  have integral := quadratic_root_is_integral at A, add, zero, neg, mul, one, B, plus, z, minus, times, unit, f, x, a with *
  exact IntegralOver.finite_adjoin with *

end Algebras
section Fields
variable (A add zero neg mul one B plus z minus times unit f x : Set)
notation ring R := (A, add, zero, neg, mul, one)
notation ring S := (B, plus, z, minus, times, unit)
hypothesis field : IsField(R)
hypothesis target : IsCommRing(S)
hypothesis hom : IsRingHom(f, R, S)

theorem algebraic_generator_gives_finite_module
  requires algebraic : AlgebraicOver(f, R, S, x)
  requires generates : algebraAdjoin(f, R, S, {x}) = S
  shows FiniteAlgebraModule(f, R, S)
proof
  exact AlgebraicOver.finite_module_of_generates with *

end Fields
