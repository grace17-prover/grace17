module ChineseRemainderStarter
import Grace.Cumulus.NumberTheory

theorem simultaneous_residues (m n a b : Integer)
  requires coprime : IntegerCoprime(m, n)
  shows ∃ x, Integer(x) ∧ IntegerCongruent(m, x, a) ∧ IntegerCongruent(n, x, b)
proof
  exact ChineseRemainder.exists at m, n, a, b with *

theorem unique_modulo_product (m n a b x y : Integer)
  requires coprime : IntegerCoprime(m, n)
  requires xm : IntegerCongruent(m, x, a)
  requires xn : IntegerCongruent(n, x, b)
  requires ym : IntegerCongruent(m, y, a)
  requires yn : IntegerCongruent(n, y, b)
  shows IntegerCongruent(m * n, x, y)
proof
  exact ChineseRemainder.unique at m, n, a, b, x, y with *

-- 8 has residue 2 modulo 3 and residue 3 modulo 5.
theorem eight_mod_three
  shows IntegerCongruent(integerOfNat(3), integerOfNat(8), integerOfNat(2))
proof
  have equation : 8 = 2 + 3 * 2
  . compute
  exact IntegerCongruent.of_natural_difference at 3, 8, 2, 2 with *

theorem eight_mod_five
  shows IntegerCongruent(integerOfNat(5), integerOfNat(8), integerOfNat(3))
proof
  have equation : 8 = 3 + 5 * 1
  . compute
  exact IntegerCongruent.of_natural_difference at 5, 8, 3, 1 with *
