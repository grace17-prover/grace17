module HierarchyDemo
import Grace.Cumulus.Set

-- Evaluates to four nested powersets over the empty set.
eval finite(4)

theorem naturals_are_ordinals (n : Nat)
  shows n in Ordinal
proof
  simp [Ordinal.natural]

theorem V_three_membership (x : Set)
  shows x in finite(3) <-> Subset(x, finite(2))
proof
  simp [finite, set.powerset, Subset]
