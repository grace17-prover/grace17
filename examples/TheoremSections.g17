module TheoremSections
namespace SectionExamples
import Grace.Cumulus.Set

section Membership
variable (A x : Set)
hypothesis hx : x ∈ A

theorem member
  shows x ∈ A
proof
  simp

section Pair
variable (y : Set)
hypothesis hy : y ∈ A

theorem both
  shows x ∈ A ∧ y ∈ A
proof
  simp
end Pair

theorem member_again
  shows x ∈ A
proof
  simp
end Membership

-- The exported theorem takes the former section context as arguments.
theorem use_both (B a b : Set)
  requires ha : a ∈ B
  requires hb : b ∈ B
  shows a ∈ B ∧ b ∈ B
proof
  simp

end SectionExamples
