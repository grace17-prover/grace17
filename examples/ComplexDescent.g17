import Grace.Cumulus.Complex.Descent

section Complexes
notation ring C := (complexCarrier, complexAdd, complexZero, complexNeg, complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

theorem power (t : Real) (z : Set) (n : Nat)
  requires member : z ∈ C
  shows monoidPow(C, complexScale(t, z), n) = complexScale(realPow(t, n), monoidPow(C, z, n))
proof
  exact complexScale.power at t, z, n with *

theorem directional_descent (z w : Set) (t : Real)
  requires first : z ∈ C
  requires second : w ∈ C
  requires direction : Euclidean.dot(z, w) < realZero
  requires positive : realZero < t
  requires small : t < scaledRadius(R[-Euclidean.dot(z, w)], limitScale(complexNormSquared(w)))
  shows complexNormSquared(C[z + complexScale(t, w)]) < complexNormSquared(z)
proof
  exact complexNormSquared.directional_descent at z, w, t with *

theorem descent_radius (z w : Set)
  requires first : z ∈ C
  requires second : w ∈ C
  requires direction : Euclidean.dot(z, w) < realZero
  shows ∃ d ∈ ℝ, realZero < d ∧
    (∀ t ∈ ℝ, realZero < t → t < d → complexNormSquared(C[z + complexScale(t, w)]) < complexNormSquared(z))
proof
  exact complexNormSquared.descent_radius at z, w with *

theorem ray_normal_form (c a : Set) (cs : List(C))
  requires coefficient : c ∈ C
  requires center : a ∈ C
  shows ∃ n ∈ ℕ, ∃ ds, List(C, ds) ∧ complexPolynomial(ds)(C[0]) ≠ C[0] ∧
    length{C}(cs) = Grace.Core.Nat.Rec.add(n, length{C}(ds)) ∧
    ComplexContinuous(complexPolynomial(ds)) ∧
    (∀ u ∈ C, ∀ t ∈ ℝ, complexPolynomial(c :: cs)(C[a + complexScale(t, u)]) = C[complexPolynomial(c :: cs)(a) + complexScale(realPow(t, succ(n)), C[monoidPow(C, u, succ(n)) * complexPolynomial(ds)(complexScale(t, u))])])
proof
  exact complexPolynomial.ray_normal_form at c, a, cs with *

end Complexes
