-- Unicode and ASCII spellings elaborate to the same kernel syntax.

def διπλό (ν : ℕ) → ℕ
  | 0 ⇒ 0
  | succ(κ) ⇒ succ(succ(διπλό(κ)))

theorem διπλό.correct (ν : ℕ)
  shows διπλό(ν) = ν + ν
proof
  induction ν
  | 0 => settle with διπλό, plus
  | succ(κ) using ih => settle with διπλό, plus, plus.succ_right, ih

theorem pair.both_unicode (α β : Set)
  shows α ∈ pair(α, β) ∧ β ∈ pair(α, β)
proof
  settle with pair.membership

theorem equality.exists_unicode (α : Set)
  shows ∃ β, β = α
proof
  witness α ⇒ settle

theorem equality.iff_unicode (α : Set)
  shows α = α ↔ α = α
proof
  settle

theorem epsilon0.less.unicode (α β : Set)
  shows relates(ε₀.less, α, β) ↔ α ∈ ε₀ ∧ β ∈ ε₀ ∧ α ∈ β
proof
  settle with epsilon0.less.membership

theorem logic.unicode_quantifiers (α : Set)
  shows ∀ γ, γ = γ ∨ ¬(α ≠ α)
proof
  settle

theorem logic.unicode_implication (α : Set)
  shows α = α → α = α
proof
  settle
