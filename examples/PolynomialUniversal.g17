module PolynomialUniversal
import Grace.Cumulus.Algebra.Polynomial.ResidueCriterion

section Evaluation
variable (I A add zero neg mul one h : Set)
notation ring R := (A, add, zero, neg, mul, one)
notation ring P := R[I]
hypothesis ring : IsCommRing(R)
hypothesis hom : IsRingHom(h, P, R)

theorem evaluation_is_determined_by_variable_values
  requires constants : ∀ a ∈ R, h(polynomialConstant(I, R, a)) = a
  shows h = polynomialAt(I, R, polynomialValues(I, R, h))
proof
  exact IsRingHom.eq_polynomialAt with ring, hom, constants

end Evaluation

section Residues
variable (I A add zero neg mul one J : Set)
notation ring R := (A, add, zero, neg, mul, one)
notation ring P := R[I]
notation ring Q := P ⧸ J
hypothesis field : IsField(R)
hypothesis maximal : IsMaximalIdeal(P, J)

theorem a_point_exists_exactly_when_coefficients_fill_the_residue_field
  shows SurjectiveBetween(polynomialResidueCoefficients(I, R, J), R, Q) ↔ ∃ v, PolynomialCommonZero(I, A, add, zero, neg, mul, one, J, v)
proof
  exact polynomialResidueCoefficients.surjective_iff_common_zero at I, A, add, zero, neg, mul, one, J with *

end Residues
