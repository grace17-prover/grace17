-- The first executable GRACE17 surface module.

def plus (x y : Nat) -> Nat
  | zero, y => y
  | succ(x), y => succ(plus(x, y))

notation infixl 60 "+" => plus

theorem plus.left_unit (n : Set)
  shows 0 + n = n
proof
  simp [plus]

theorem plus.right_unit (n : Nat)
  shows n + 0 = n
proof
  induction n
  | zero => settle with plus
  | succ(k) using ih => settle with plus, ih

theorem plus.succ_right (m : Set, n : Nat)
  shows n + succ(m) = succ(n + m)
proof
  induction n
  | zero => settle with plus
  | succ(k) using ih => settle with plus, ih

theorem plus.associative (y z : Set, n : Nat)
  shows (n + y) + z = n + (y + z)
proof
  induction n
  | zero => settle with plus
  | succ(k) using ih => settle with plus, ih

theorem plus.commutative (y n : Nat)
  shows n + y = y + n
proof
  induction n
  | zero => settle with plus, plus.right_unit
  | succ(k) using ih => settle with plus, plus.succ_right, ih

theorem plus.swap (b : Nat, c : Set, a : Nat)
  shows a + (b + c) = b + (a + c)
proof
  induction a
  | zero => settle with plus
  | succ(k) using ih => settle with plus, plus.succ_right, ih

def times (x y : Nat) -> Nat
  | zero, y => zero
  | succ(x), y => y + times(x, y)

notation infixl 70 "*" => times

theorem times.right_zero (n : Nat)
  shows n * 0 = 0
proof
  induction n
  | zero => settle with times
  | succ(k) using ih => settle with times, plus, ih

theorem times.succ_right (y n : Nat)
  shows n * succ(y) = n + n * y
proof
  induction n
  | zero => settle with times, plus
  | succ(k) using ih => settle with times, plus, plus.swap, ih

theorem times.commutative (y n : Nat)
  shows n * y = y * n
proof
  induction n
  | zero => settle with times, times.right_zero
  | succ(k) using ih => settle with times, times.succ_right, ih

theorem times.distributes_right (y z n : Nat)
  shows (n + y) * z = n * z + y * z
proof
  induction n
  | zero => settle with plus, times
  | succ(k) using ih => settle with plus, times, plus.associative, ih

-- Hundreds of reductions, but exactly one kernel proof node.
theorem times.ground_700
  shows 7 * 100 = 700
proof
  compute

-- A value beyond JavaScript's safe-integer range. The source term, checked
-- computation certificate, and machine term each contain compact decimals.
eval 7000000000 * 1000000000

theorem times.ground_bigint
  shows 7000000000 * 1000000000 = 7000000000000000000
proof
  compute
