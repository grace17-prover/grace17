module ComplexPolynomialMinimumExample
import Grace.Cumulus.Complex.PolynomialMinimum

section Complexes
notation ring C := (complexCarrier, complexAdd, complexZero, complexNeg, complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

theorem product (z w : Set)
  requires first : z ∈ C
  requires second : w ∈ C
  shows complexNormSquared(C[z * w]) = R[complexNormSquared(z) * complexNormSquared(w)]
proof
  exact complexNormSquared.mul with *

theorem decrease (z w : Set)
  requires first : z ∈ C
  requires second : w ∈ C
  requires direction : R[2 * Euclidean.dot(z, w) + complexNormSquared(w)] < R[0]
  shows complexNormSquared(C[z + w]) < complexNormSquared(z)
proof
  exact complexNormSquared.strict_descent with *

-- Neither analytic premise below is yet proved for all nonconstant polynomials.
theorem root (cs : List(complexCarrier))
  requires minimum : ∃ a ∈ C, ∀ z ∈ C, complexNormSquared(complexPolynomial(cs)(a)) ≤ complexNormSquared(complexPolynomial(cs)(z))
  requires descent : ∀ a ∈ C, complexPolynomial(cs)(a) ≠ C[0] → ∃ z ∈ C, complexNormSquared(complexPolynomial(cs)(z)) < complexNormSquared(complexPolynomial(cs)(a))
  shows ∃ a ∈ C, monicValue(C, identity(C), C, a, cs) = C[0]
proof
  exact complexPolynomial.root_of_minimum_and_descent with *

end Complexes
section Translation
variable (A add zero neg mul one leading a x : Set)
notation ring R := (A, add, zero, neg, mul, one)
hypothesis ring : IsCommRing(R)
hypothesis initial : leading ∈ R
hypothesis center : a ∈ R
hypothesis element : x ∈ R

theorem translated_value (cs : List(A))
  shows hornerAt{A}(add, mul, leading, x, hornerTranslate{A}(add, mul, one, leading, a, cs)) = hornerAt{A}(add, mul, leading, R[a + x], cs)
proof
  exact hornerTranslate.value with *

theorem translated_constant (cs : List(A))
  shows listHeadOr{A}(leading, hornerTranslate{A}(add, mul, one, leading, a, cs)) = hornerAt{A}(add, mul, leading, a, cs)
proof
  exact hornerTranslate.constant with *

end Translation
