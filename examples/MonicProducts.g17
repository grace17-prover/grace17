module MonicProductsExample
import Grace.Cumulus.Algebra.Polynomial.MonicProducts

section Polynomials
variable (I A add zero neg mul one j : Set)
notation ring R := (A, add, zero, neg, mul, one)
notation ring P := R[I]
hypothesis ring : IsCommRing(R)
hypothesis index : j ∈ I

theorem leading (xs : List(A))
  shows polynomialLinearFactors(I, R, j, xs)(monomialShift(I, j, monomialOne(I), length{A}(xs))) = R[1]
proof
  exact polynomialLinearFactors.leading_coefficient with *

theorem factor (a : Set) (xs : List(A))
  requires center : a ∈ R
  shows polynomialLinearFactors(I, R, j, a :: xs) =
    P[(polynomialVariable(I, R, j) - polynomialCoefficients(I, R)(a)) * polynomialLinearFactors(I, R, j, xs)]
proof
  exact polynomialLinearFactors.cons with *

theorem nonzero (xs : List(A))
  requires nontrivial : R[1] ≠ R[0]
  shows polynomialLinearFactors(I, R, j, xs) ≠ P[0]
proof
  exact polynomialLinearFactors.nonzero with *

-- Degree uniqueness requires nonzero leading coefficients, but no domain.
theorem degree_unique (a b : Set) (cs ds : List(A))
  requires left : a ∈ R
  requires right : b ∈ R
  requires leftNonzero : a ≠ R[0]
  requires rightNonzero : b ≠ R[0]
  requires equal : polynomialFromHorner(I, R, j, a, cs) = polynomialFromHorner(I, R, j, b, ds)
  shows length{A}(cs) = length{A}(ds)
proof
  exact polynomialFromHorner.length_unique with *

end Polynomials

section Extensions
variable (I A add zero neg mul one B plus z minus times unit f v j : Set)
notation ring R := (A, add, zero, neg, mul, one)
notation ring S := (B, plus, z, minus, times, unit)
hypothesis source : IsCommRing(R)
hypothesis target : IsCommRing(S)
hypothesis hom : IsRingHom(f, R, S)
hypothesis assignment : v : I → S
hypothesis index : j ∈ I

theorem evaluate (cs : List(A))
  shows polynomialAtOver(I, R, S, f, v)(polynomialFromHorner(I, R, j, R[1], cs)) = monicValue(R, f, S, v(j), cs)
proof
  exact polynomialAtOver.from_monic_horner with *

theorem annihilate (n : Nat) (M N w k : Set) (cs : List(A))
  requires matrixM : RingMatrix(n, R, M)
  requires matrixN : RingMatrix(n, S, N)
  requires entries : ∀ a ∈ n, ∀ b ∈ n, N[a, b] = f(M[a, b])
  requires eigenvector : LeftEigenvector(n, S, N, v(j), w)
  requires coordinate : k ∈ n
  requires representation : characteristicPolynomial(n, I, R, M, j) = polynomialFromHorner(I, R, j, R[1], cs)
  shows S[monicValue(R, f, S, v(j), cs) * w(k)] = S[0]
proof
  exact characteristicPolynomial.horner_annihilates with *

end Extensions
