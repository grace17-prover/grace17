module PrimeIdealStarter
import Grace.Cumulus.Algebra.Ring

theorem maximal_is_prime (A add zero neg mul one M : Set)
  requires ring : IsCommRing(A, add, zero, neg, mul, one)
  requires maximal : IsMaximalIdeal(A, add, zero, neg, mul, one, M)
  shows IsPrimeIdeal(A, add, zero, neg, mul, one, M)
proof
  exact IsMaximalIdeal.is_prime at A, add, zero, neg, mul, one, M with *

-- If xy lies in a prime ideal and y does not, then x lies in the ideal.
theorem cancel_outside_factor (A add zero neg mul one P x y : Set)
  requires prime : IsPrimeIdeal(A, add, zero, neg, mul, one, P)
  requires hx : x ∈ A
  requires hy : y ∈ A
  requires productIn : call2(mul, x, y) ∈ P
  requires outside : ¬(y ∈ P)
  shows x ∈ P
proof
  exact IsPrimeIdeal.left_of_mul at A, add, zero, neg, mul, one, P, x, y with *

-- The zero ideal is prime precisely when the commutative ring is a domain.
theorem zero_prime_iff_domain (A add zero neg mul one : Set)
  requires ring : IsCommRing(A, add, zero, neg, mul, one)
  shows IsPrimeIdeal(A, add, zero, neg, mul, one, {zero}) ↔
    IsIntegralDomain(A, add, zero, neg, mul, one)
proof
  exact IsPrimeIdeal.zero_iff_domain at A, add, zero, neg, mul, one with *
