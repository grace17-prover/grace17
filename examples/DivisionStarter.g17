module DivisionStarter
import Grace.Cumulus.NumberTheory

theorem division (n d : Nat)
  requires nonzero : d ≠ 0
  shows Nat(quotientNat(n, d)) ∧ n = d * quotientNat(n, d) + n % d ∧ n % d < d
proof
  exact quotientNat.division at n, d with *

theorem quotient_sample
  shows quotientNat(1234, 37) = 33
proof
  compute

theorem remainder_sample
  shows 1234 % 37 = 13
proof
  compute

theorem zero_divisor (n : Nat)
  shows quotientNat(n, 0) = 0
proof
  exact quotientNat.zero_right at n with *

theorem coefficient_step (u v : Integer, a b : Nat)
  shows integerLinearCombination(v, u + (-(integerOfNat(quotientNat(a, b)) * v)), a, b) =
    integerLinearCombination(u, v, b, a % b)
proof
  exact integerLinearCombination.remainder_step at u, v, a, b with *
