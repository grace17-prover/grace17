module ComplexField
import Grace.Cumulus.Complex

section Complexes
notation ring C := (complexCarrier, complexAdd, complexZero, complexNeg, complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

theorem field
  shows IsField(C)
proof
  exact complexes.is_field

theorem square_of_i
  shows C[(R[0], R[1]) * (R[0], R[1])] = C[-1]
proof
  have zero := realZero.real
  have one := realOne.real
  have realPart : R[0 * 0 - 1 * 1] = R[-1] by ring
  have imaginaryPart : R[0 * 1 + 1 * 0] = R[0] by ring
  have negZero : R[-0] = R[0] by ring
  simp [complexOne, complexMul.pair, complexNeg.pair]

theorem inverse (a b : Real)
  requires nonzero : (a, b) ≠ C[0]
  shows IsInverse(complexCarrier, complexMul, complexOne, (a, b),
    (R[a * realInvValue(a * a + b * b)], R[-b * realInvValue(a * a + b * b)]))
proof
  exact complex.inverse_pair with *

end Complexes
