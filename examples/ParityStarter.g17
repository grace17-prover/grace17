module User.ParityStarter
import Grace.Cumulus.Nat

theorem every_natural_has_parity (n : Nat)
  shows Even(n) ∨ Odd(n)
proof
  exact parity.exhaustive at n with *

theorem consecutive_numbers_have_opposite_parity (n : Nat)
  shows (Even(n) ∧ Odd(succ(n))) ∨ (Odd(n) ∧ Even(succ(n)))
proof
  have alternatives := parity.exhaustive at n with *
  have fromEven := Odd.succ_of_even at n
  have fromOdd := Even.succ_of_odd at n
  tauto

theorem two_odd_counts_make_even (a b : Set)
  requires first : Odd(a)
  requires second : Odd(b)
  shows Even(add(a, b))
proof
  exact Odd.add_odd at a, b with *

theorem double_plus_one_is_odd (n : Nat)
  shows Odd(2 * n + 1)
proof
  have result := Odd.double_successor at n with *
  rw mul.two_left
  rw add.right_one
  exact result
