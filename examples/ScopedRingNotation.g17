module ScopedRingNotation
import Grace.Cumulus.Algebra.Ring

section Rings
variable (A add zero neg mul one : Set)
hypothesis source : IsCommRing(A, add, zero, neg, mul, one)
notation ring R := (A, add, zero, neg, mul, one)

theorem simplify (x y : Set)
  requires hx : x ∈ A
  requires hy : y ∈ A
  shows (x + y) * 1 - y + 0 = x
proof
  ring

section Maps
variable (f B plus z minus times unit : Set)
hypothesis target : IsCommRing(B, plus, z, minus, times, unit)
hypothesis hom : IsRingHom(f, A, add, zero, neg, mul, one, B, plus, z, minus, times, unit)
notation ring S := (B, plus, z, minus, times, unit)

theorem preserves_sum (x y : Set)
  requires hx : x ∈ A
  requires hy : y ∈ A
  shows f(x + y) = f(x) + f(y)
proof
  exact IsRingHom.add with hom, hx, hy

theorem explicit_scopes (x y : Set)
  requires hx : x ∈ A
  requires hy : y ∈ A
  shows f(R[x * y]) = S[f(x) * f(y)]
proof
  exact IsRingHom.mul with hom, hx, hy

theorem preserves_one
  shows f(R[1]) = S[1]
proof
  exact IsRingHom.one with hom
end Maps

-- Ending Maps restores the single-ring notation context.
theorem restored (x : Set)
  requires hx : x ∈ A
  shows -x + x = 0
proof
  ring
end Rings
