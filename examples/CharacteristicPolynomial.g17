module CharacteristicPolynomialExample
import Grace.Cumulus.Algebra.Polynomial.Characteristic

section Extensions
variable (I A add zero neg mul one B plus z minus times unit f v : Set)
notation ring R := (A, add, zero, neg, mul, one)
notation ring S := (B, plus, z, minus, times, unit)
notation ring P := R[I]
hypothesis source : IsCommRing(R)
hypothesis target : IsCommRing(S)
hypothesis hom : IsRingHom(f, R, S)
hypothesis assignment : v : I → S

theorem polynomial (n : Nat) (M j : Set)
  requires matrix : RingMatrix(n, R, M)
  requires index : j ∈ I
  shows characteristicPolynomial(n, I, R, M, j) ∈ P
proof
  exact characteristicPolynomial.member with *

theorem evaluate (n : Nat) (M j : Set)
  requires matrix : RingMatrix(n, R, M)
  requires index : j ∈ I
  shows polynomialAtOver(I, R, S, f, v)(characteristicPolynomial(n, I, R, M, j)) =
    determinant(n, S, characteristicMatrix(n, S, matrixMap(n, R, S, f, M), v(j)))
proof
  exact characteristicPolynomial.evaluate_mapped with *

theorem annihilate (n : Nat) (M N j w k : Set)
  requires matrixM : RingMatrix(n, R, M)
  requires matrixN : RingMatrix(n, S, N)
  requires index : j ∈ I
  requires entries : ∀ a ∈ n, ∀ b ∈ n, N[a, b] = f(M[a, b])
  requires eigenvector : LeftEigenvector(n, S, N, v(j), w)
  requires coordinate : k ∈ n
  shows S[polynomialAtOver(I, R, S, f, v)(characteristicPolynomial(n, I, R, M, j)) * w(k)] = S[0]
proof
  exact characteristicPolynomial.annihilates with *

theorem root (n : Nat) (M N j w k : Set)
  requires domain : IsIntegralDomain(S)
  requires matrixM : RingMatrix(n, R, M)
  requires matrixN : RingMatrix(n, S, N)
  requires index : j ∈ I
  requires entries : ∀ a ∈ n, ∀ b ∈ n, N[a, b] = f(M[a, b])
  requires eigenvector : LeftEigenvector(n, S, N, v(j), w)
  requires coordinate : k ∈ n
  requires nonzero : w(k) ≠ S[0]
  shows polynomialAtOver(I, R, S, f, v)(characteristicPolynomial(n, I, R, M, j)) = S[0]
proof
  exact characteristicPolynomial.root with *

end Extensions
