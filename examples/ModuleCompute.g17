module Grace.Examples.Compute
import Grace.Core.Nat
open Grace.Core.Nat.Rec

namespace Demo

def double (n : Nat) -> Nat
  | zero => zero
  | succ(n) => succ(succ(double(n)))

theorem double.three (u : Set)
  shows double(3) = 6
proof
  simp

theorem imported_add (u : Set)
  shows add(4, 5) = 9
proof
  simp

end Demo
