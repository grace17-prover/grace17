module BundledRings
import Grace.Cumulus.Algebra.Ring
import Grace.Cumulus.Int.Ring

-- Under the hypothesis CommRing(R) a binder (x : R) is x ∈ R.carrier, the
-- operations are x + y, x * y, and -x, and R[0], R[1], R[2] are the ring's
-- own constants and numerals; `ring` reads the operation graphs off R.
section Rings
variable (R : Set)
hypothesis ring : CommRing(R)

theorem square_sum (x y : R)
  shows (x + y) * (x + y) = x * x + R[2] * (x * y) + y * y
proof
  ring

theorem neg_cancel (x y : R)
  shows -x + x + y * R[1] + R[0] = y
proof
  ring

theorem closed (x y : R)
  shows (x + y) * -x ∈ R.carrier
proof
  typecheck

theorem mul_comm (x y : R)
  shows x * y = y * x
proof
  have comm := CommRing.parts with ring
  exact IsCommRing.mul_comm with comm, *
end Rings

-- The integers as a bundled ring: the structure value over the existing
-- instance, and the section theorem instantiated at it.
def integerRing : Set := Ring.mk(ℤ, integerAdd, integerZero, integerNeg, integerMul, integerOne)

instance integerRing.comm_ring
  shows CommRing(integerRing)
proof
  unfold integerRing
  exact CommRing.of_parts with integers.comm_ring

theorem square_sum.integers (x y : Set)
  requires xIn : x ∈ integerRing.carrier
  requires yIn : y ∈ integerRing.carrier
  shows (x + y) * (x + y) = x * x + integerRing[2] * (x * y) + y * y
proof
  exact square_sum with *
