module PermutationExchange
import Grace.Cumulus.Algebra.Ring.DeterminantCancellation

section Exchanges
variable (I a b : Set)
hypothesis ha : a ∈ I
hypothesis hb : b ∈ I

theorem exchange_twice (i : Set)
  requires index : i ∈ I
  shows transposition(I, a, b)(transposition(I, a, b)(i)) = i
proof
  have involution := transposition.involution at I, a, b with *
  exact InvolutionOn.apply with *

theorem pairing
  shows InvolutionOn(permutationExchange(I, a, b), permutations(I))
proof
  exact permutationExchange.involution with *

theorem no_fixed_permutation (p : Set)
  requires distinct : a ≠ b
  requires permutation : p ∈ permutations(I)
  shows permutationExchange(I, a, b)(p) ≠ p
proof
  exact permutationExchange.free with *

end Exchanges

theorem coincident_choices (I a : Set)
  requires member : a ∈ I
  shows InvolutionOn(transposition(I, a, a), I)
proof
  exact transposition.involution with *

section Determinants
variable (A add zero neg mul one M : Set)
notation ring R := (A, add, zero, neg, mul, one)
hypothesis ring : IsCommRing(R)

theorem equal_rows_reduce_to_sign (n : Nat) (a b : Set)
  requires matrix : RingMatrix(n, R, M)
  requires ha : a ∈ n
  requires hb : b ∈ n
  requires distinct : a ≠ b
  requires rows : ∀ j ∈ n, M[a, j] = M[b, j]
  requires signs : ∀ p ∈ permutations(n), permutationSign(n, A, add, zero, neg, mul, one, permutationExchange(n, a, b)(p)) = R[-permutationSign(n, A, add, zero, neg, mul, one, p)]
  shows determinant(n, R, M) = R[0]
proof
  exact determinant.equal_rows_of_exchange_sign with *

end Determinants
