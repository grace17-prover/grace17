module HornerNormalization
import Grace.Cumulus.Algebra.Polynomial.HornerNormalization

section Fields
variable (A add z neg mul one : Set)
notation ring R := (A, add, z, neg, mul, one)
hypothesis field : IsField(R)

theorem finite_roots (cs : List(A))
  requires nonzero : ∃ n, Nat(n) ∧ listCoefficient{A}(z, cs, n) ≠ z
  shows Finite(hornerRoots{A}(add, z, mul, z, cs))
proof
  exact hornerRoots.finite_of_coefficient with *

theorem nonvanishing (cs : List(A))
  requires infinite : ¬Finite(R)
  requires nonzero : ∃ n, Nat(n) ∧ listCoefficient{A}(z, cs, n) ≠ z
  shows ∃ x ∈ R, hornerAt{A}(add, mul, z, x, cs) ≠ z
proof
  exact hornerAt.exists_nonzero_of_coefficient with *

theorem nonvanishing_away (F : Set) (cs : List(A))
  requires infinite : ¬Finite(R)
  requires excluded : Finite(F)
  requires nonzero : ∃ n, Nat(n) ∧ listCoefficient{A}(z, cs, n) ≠ z
  shows ∃ x ∈ R, ¬(x ∈ F) ∧ hornerAt{A}(add, mul, z, x, cs) ≠ z
proof
  exact hornerAt.exists_nonzero_avoiding_of_coefficient with *

theorem trailing_zeros (a : Set)
  requires element : a ∈ R
  requires nonzero : a ≠ z
  shows Finite(hornerRoots{A}(add, z, mul, z, [a, z, z]))
proof
  have ring := IsField.comm_ring with field
  have zeroIn : z ∈ R by typecheck
  have list : List(A, [a, z, z]) by typecheck
  have tail : List(A, [z, z]) by typecheck
  have witness : ∃ n, Nat(n) ∧ listCoefficient{A}(z, [a, z, z], n) ≠ z
    refine ⟨(0:Nat), Naturals.constructor.zero, ?_⟩
    rw listCoefficient.zero
    exact nonzero
  exact hornerRoots.finite_of_coefficient with *

end Fields
