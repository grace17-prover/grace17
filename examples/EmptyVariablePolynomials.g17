module EmptyVariablePolynomials
import Grace.Cumulus.Algebra.Polynomial.EmptyVariables

theorem every_polynomial_is_constant (A zero p : Set)
  requires zeroIn : zero ∈ A
  requires polynomial : p ∈ polynomials(∅, A, zero)
  shows p = polynomialConstant(∅, A, zero, emptyPolynomialCoefficient(A, zero)(p))
proof
  exact polynomial.empty_constant with *

theorem nonzero_coefficient (A zero p : Set)
  requires zeroIn : zero ∈ A
  requires polynomial : p ∈ polynomials(∅, A, zero)
  requires nonzero : p ≠ constantFunction(monomials(∅), A, zero)
  shows emptyPolynomialCoefficient(A, zero)(p) ≠ zero
proof
  exact emptyPolynomialCoefficient.nonzero with *

section Algebras
variable (A add zero neg mul one B plus z minus times unit f v x : Set)
notation ring R := (A, add, zero, neg, mul, one)
notation ring S := (B, plus, z, minus, times, unit)
notation ring Q := R[∅]
hypothesis source : IsCommRing(R)
hypothesis target : IsCommRing(S)
hypothesis hom : IsRingHom(f, R, S)
hypothesis assignment : v : ∅ → S

theorem evaluation_is_coefficient_evaluation (p : Set)
  requires polynomial : p ∈ Q
  shows polynomialAtOver(∅, R, S, f, v)(p) = f(emptyPolynomialCoefficient(A, zero)(p))
proof
  exact polynomialAtOver.empty_value with *

theorem transport_algebraicity
  requires algebraic : AlgebraicOver(polynomialAtOver(∅, R, S, f, v), Q, S, x)
  shows AlgebraicOver(f, R, S, x)
proof
  exact AlgebraicOver.empty_variables with *

end Algebras
