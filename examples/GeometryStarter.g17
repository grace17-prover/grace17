module GeometryStarter
import Grace.Cumulus.Geometry

-- Equal legs give equal base angles: compare the triangle with its reversal.
theorem equal_base_angles (a b c : Euclidean.Point)
  requires base : a ≠ b
  requires leg : a ≠ c
  requires equalLegs : Euclidean.distanceSquared(a, c) = Euclidean.distanceSquared(b, c)
  shows Euclidean.EqualAngle(c, a, b, c, b, a)
proof
  exact Euclidean.isosceles at a, b, c with *

-- A diameter subtends a right angle, and its two rays really are nonzero.
theorem angle_in_semicircle (a b p center : Euclidean.Point)
  requires diameter : Euclidean.Midpoint(center, a, b)
  requires onCircle : Euclidean.OnCircle(p, center, a)
  requires firstRay : a ≠ p
  requires secondRay : p ≠ b
  shows Euclidean.RightAngle(a, p, b) ∧
    0 < Euclidean.distanceSquared(a, p) ∧ 0 < Euclidean.distanceSquared(p, b)
proof
  exact Euclidean.thales at a, b, p, center with *

-- The familiar distance equation characterizes a right angle.
theorem right_angle_from_sides (a b c : Euclidean.Point)
  requires sides : Euclidean.distanceSquared(a, c) =
    Euclidean.distanceSquared(a, b) + Euclidean.distanceSquared(b, c)
  shows Euclidean.RightAngle(a, b, c)
proof
  exact Euclidean.pythagoras_converse at a, b, c with *

-- The isosceles median is an altitude: a one-step geometric application.
theorem median_is_altitude (a b c m : Euclidean.Point)
  requires middle : Euclidean.Midpoint(m, a, b)
  requires legs : Euclidean.distanceSquared(c, a) = Euclidean.distanceSquared(c, b)
  shows Euclidean.RightAngle(c, m, a)
proof
  exact Euclidean.isosceles_median_perpendicular at a, b, c, m with *

-- Join the midpoints of two sides: the resulting segment is parallel
-- to the third side. A nonzero base guarantees a nonzero midsegment.
theorem triangle_midsegment (a b c m n : Euclidean.Point)
  requires first : Euclidean.Midpoint(m, c, a)
  requires second : Euclidean.Midpoint(n, c, b)
  requires base : a ≠ b
  shows Euclidean.ParallelSegments(m, n, a, b)
proof
  exact Euclidean.midsegment.parallel at a, b, c, m, n with *

-- Every pair of points has a midpoint, and every such midpoint lies on
-- their supporting line. The point is constructed using halves.
theorem constructed_midpoint (a b : Euclidean.Point)
  shows Euclidean.Point(Euclidean.midpoint(a, b)) ∧
    Euclidean.Midpoint(Euclidean.midpoint(a, b), a, b) ∧
    Euclidean.Collinear(a, Euclidean.midpoint(a, b), b)
proof
  have point := Euclidean.midpoint.point at a, b with *
  have middle := Euclidean.midpoint.correct at a, b with *
  have onLine := Euclidean.midpoint.collinear at a, b, Euclidean.midpoint(a, b) with *
  refine ⟨point, middle, onLine⟩

-- Varignon: the four side midpoints of any quadrilateral form an affine
-- parallelogram. This includes concave, crossed, and degenerate inputs.
theorem midpoint_quadrilateral (a b c d : Euclidean.Point)
  shows Euclidean.Parallelogram(Euclidean.midpoint(a, b), Euclidean.midpoint(b, c),
    Euclidean.midpoint(c, d), Euclidean.midpoint(d, a))
proof
  exact Euclidean.varignon.constructed at a, b, c, d with *

-- A synthetic consequence: the diagonals of the midpoint figure bisect
-- one another. The proof uses only Varignon and the parallelogram API.
theorem midpoint_figure_diagonals (a b c d m n p q : Euclidean.Point)
  requires first : Euclidean.Midpoint(m, a, b)
  requires second : Euclidean.Midpoint(n, b, c)
  requires third : Euclidean.Midpoint(p, c, d)
  requires fourth : Euclidean.Midpoint(q, d, a)
  shows ∃ center, Euclidean.Point(center) ∧
    Euclidean.Midpoint(center, m, p) ∧ Euclidean.Midpoint(center, n, q)
proof
  have shape := Euclidean.varignon at a, b, c, d, m, n, p, q with *
  exact Euclidean.parallelogram.diagonals at m, n, p, q with *

-- Zero-length sides satisfy the affine identity, but they are not nonzero
-- parallel segments. The distinction is explicit in the public predicates.
theorem collapsed_figure (a : Euclidean.Point)
  shows Euclidean.Parallelogram(a, a, a, a) ∧ ¬Euclidean.ParallelSegments(a, a, a, a)
proof
  constructor
  . unfold Euclidean.Parallelogram
    rfl
  . intro parallel
    rcases parallel with ⟨distinct, rest⟩
    have same : a = a by rfl
    exact distinct with same

-- The medians meet at the constructed centroid, with no coordinate calculation
-- in this application. Each median carries the same directed 2:1 relation.
theorem triangle_medians (a b c m n p : Euclidean.Point)
  requires first : Euclidean.Midpoint(m, b, c)
  requires second : Euclidean.Midpoint(n, c, a)
  requires third : Euclidean.Midpoint(p, a, b)
  shows ∃ g, Euclidean.Point(g) ∧ Euclidean.Centroid(g, a, b, c) ∧
    Euclidean.Collinear(a, g, m) ∧ Euclidean.Collinear(b, g, n) ∧ Euclidean.Collinear(c, g, p)
proof
  exact Euclidean.centroid.concurrency at a, b, c, m, n, p with *

theorem median_squared_lengths (a b c g m : Euclidean.Point)
  requires center : Euclidean.Centroid(g, a, b, c)
  requires middle : Euclidean.Midpoint(m, b, c)
  shows Euclidean.distanceSquared(a, g) =
    Euclidean.distanceSquared(g, m) + Euclidean.distanceSquared(g, m) +
    Euclidean.distanceSquared(g, m) + Euclidean.distanceSquared(g, m)
proof
  have ratio := Euclidean.centroid.median_ratio at a, b, c, g, m with *
  exact Euclidean.medianRatio.length at a, g, m with *

theorem collapsed_triangle (a : Euclidean.Point)
  shows Euclidean.centroid(a, a, a) = a
proof
  exact Euclidean.centroid.repeated at a with *

-- Given the circumcenter and centroid, construct an orthocenter on Euler's line.
theorem triangle_centers (o a b c g : Euclidean.Point)
  requires circle : Euclidean.Circumcenter(o, a, b, c)
  requires center : Euclidean.Centroid(g, a, b, c)
  shows ∃ h, Euclidean.Point(h) ∧ Euclidean.Orthocenter(h, a, b, c) ∧
    Euclidean.Collinear(h, g, o) ∧ Euclidean.MedianRatio(h, g, o)
proof
  exact Euclidean.euler_line at o, a, b, c, g with *

-- The same 2:1 lemma used for medians gives HG² = 4 GO².
theorem center_squared_distances (o a b c g : Euclidean.Point)
  requires circle : Euclidean.Circumcenter(o, a, b, c)
  requires center : Euclidean.Centroid(g, a, b, c)
  shows Euclidean.distanceSquared(Euclidean.orthocenter(o, a, b, c), g) =
    Euclidean.distanceSquared(g, o) + Euclidean.distanceSquared(g, o) +
    Euclidean.distanceSquared(g, o) + Euclidean.distanceSquared(g, o)
proof
  have point := Euclidean.orthocenter.point at o, a, b, c with *
  have ratio := Euclidean.orthocenter.centroid_ratio at o, a, b, c, g with *
  exact Euclidean.medianRatio.length at Euclidean.orthocenter(o, a, b, c), g, o with *

theorem coincident_centers (o a b c : Euclidean.Point)
  requires circle : Euclidean.Circumcenter(o, a, b, c)
  requires center : Euclidean.Centroid(o, a, b, c)
  shows Euclidean.Orthocenter(o, a, b, c)
proof
  exact Euclidean.euler_line.coincident at o, a, b, c with *

-- A collapsed triangle has coincident centers too, without a unique Euler line.
theorem collapsed_centers (a : Euclidean.Point)
  shows Euclidean.Circumcenter(a, a, a, a) ∧ Euclidean.Orthocenter(a, a, a, a)
proof
  have circle : Euclidean.Circumcenter(a, a, a, a)
    unfold Euclidean.Circumcenter
    constructor
    . rfl
    . rfl
  have center : Euclidean.Centroid(a, a, a, a)
    unfold Euclidean.Centroid
    constructor
    . rfl
    . rfl
  have altitudes := Euclidean.euler_line.coincident at a, a, a, a with *
  refine ⟨circle, altitudes⟩

-- For a right triangle, the known hypotenuse midpoint supplies the circumcenter.
theorem right_triangle_euler_line (a b c m g : Euclidean.Point)
  requires middle : Euclidean.Midpoint(m, a, b)
  requires right : Euclidean.RightAngle(a, c, b)
  requires center : Euclidean.Centroid(g, a, b, c)
  shows ∃ h, Euclidean.Point(h) ∧ Euclidean.Orthocenter(h, a, b, c) ∧
    Euclidean.Collinear(h, g, m) ∧ Euclidean.MedianRatio(h, g, m)
proof
  have circle := Euclidean.circumcenter.right_triangle at a, b, c, m with *
  exact Euclidean.euler_line at m, a, b, c, g with *

-- Every noncollinear triangle supplies its own centers: no center hypotheses.
theorem all_triangle_centers (a b c : Euclidean.Point)
  requires noncollinear : ¬Euclidean.Collinear(a, b, c)
  shows ∃ o, ∃ g, ∃ h, Euclidean.Point(o) ∧ Euclidean.Point(g) ∧ Euclidean.Point(h) ∧
    Euclidean.Circumcenter(o, a, b, c) ∧ Euclidean.Centroid(g, a, b, c) ∧ Euclidean.Orthocenter(h, a, b, c) ∧
    Euclidean.Collinear(h, g, o) ∧ Euclidean.MedianRatio(h, g, o)
proof
  exact Euclidean.euler_line.exists at a, b, c with *

theorem circumcenter_is_unique (a b c o p : Euclidean.Point)
  requires noncollinear : ¬Euclidean.Collinear(a, b, c)
  requires first : Euclidean.Circumcenter(o, a, b, c)
  requires second : Euclidean.Circumcenter(p, a, b, c)
  shows o = p
proof
  exact Euclidean.circumcenter.unique at a, b, c, o, p with *

-- Any two altitudes determine the unique orthocenter; the third follows.
theorem two_altitudes_suffice (a b c h : Euclidean.Point)
  requires triangle : ¬Euclidean.Collinear(a, b, c)
  requires first : Euclidean.PerpendicularDirections(a, h, b, c)
  requires second : Euclidean.PerpendicularDirections(b, h, c, a)
  shows Euclidean.Orthocenter(h, a, b, c)
proof
  exact Euclidean.orthocenter.of_two_altitudes at a, b, c, h with *

theorem unique_orthocenter (a b c h k : Euclidean.Point)
  requires triangle : ¬Euclidean.Collinear(a, b, c)
  requires first : Euclidean.Orthocenter(h, a, b, c)
  requires second : Euclidean.Orthocenter(k, a, b, c)
  shows h = k
proof
  exact Euclidean.orthocenter.unique at a, b, c, h, k with *
