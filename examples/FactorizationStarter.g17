module FactorizationStarter
import Grace.Cumulus.NumberTheory

-- A factorization is a list of primes; its product is computed by recursion.
theorem twelve
  shows ∏ [2, 2, 3] = 12
proof
  compute

-- Multiplicities say how many times a prime is used.
theorem twelve.twos
  shows multiplicity(2, [2, 2, 3]) = 2
proof
  compute

-- Every positive natural number has a prime factorization.
theorem factorization_exists (n : Nat)
  requires positive : n ≠ 0
  shows ∃ xs, List(ℕ, xs) ∧ PrimeList(xs) ∧ ∏ xs = n
proof
  exact primeFactorization.exists at n with *

-- Two prime factorizations of the same number use every prime equally often.
theorem factorization_unique (xs ys : List(ℕ)) (q : Nat)
  requires primesXs : PrimeList(xs)
  requires primesYs : PrimeList(ys)
  requires equal : ∏ xs = ∏ ys
  shows multiplicity(q, xs) = multiplicity(q, ys)
proof
  have unique := primeFactorization.unique at xs with *
  exact unique with ys, assumption, primesXs, primesYs, equal, q, assumption

-- Euclid's lemma, the step that makes uniqueness work.
theorem euclid (p a b : Nat)
  requires prime : Prime(p)
  requires divides : p ∣ a * b
  shows p ∣ a ∨ p ∣ b
proof
  exact Prime.divides_mul at p, a, b with *
