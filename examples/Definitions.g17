module DefinitionExamples
import Grace.Cumulus.Set.Choice
import Grace.Cumulus.Set
import Grace.Cumulus.Real.Metric
open Grace.Cumulus.Set.Foundation

-- Give a reusable construction a name.
def duplicate (x : Set) : Set := {x, x}

-- duplicate(a) is definitionally {a}

-- Define a bounded function graph from a codomain proof.
defgraph inclusionMap (A B : Set) (x ∈ A) : B := x
requires subset : A ⊆ B
proof
  unfold Subset at subset
  exact subset with x, member

-- inclusionMap.function and inclusionMap.value are checked laws.

-- Choose a witness from a bounded predicate, justified by existence.
defchoose selected (A : Set) (x ∈ A) := x ∈ A
requires inhabited : ∃ x, x ∈ A
proof
  obtain ⟨x, member⟩ := inhabited
  witness x
  refine ⟨member, member⟩

-- Extract a uniquely determined value without Choice.
defunique identityValue (A : Set) (x ∈ {A}) := x = A
proof
  witness A
  refine ⟨singleton.self at A, rfl⟩
uniqueness
  intro x
  intro xMember
  intro xValue
  intro y
  intro yMember
  intro yValue
  cc

-- Name a proposition or a mathematical collection.
predicate FixedBy (f x : Set) := f(x) = x
class Natural (x : Set) := Nat(x)

-- Define executable functions by checked structural recursion.
def copies (x : Set, n : Nat) → Set
  | x, zero => empty
  | x, succ(k) => {x, copies(x, k)}

-- Introduce a set-encoded inductive datatype.
datatype Branches(A : Set)
  | leaf(value : A)
  | fork(left : self, right : self)

-- Form a bounded subset by Separation.
def fixedPoints (A f : Set) : Set := {x ∈ A | f(x) = x}

-- Form the image of a set by bounded Replacement.
def singletons (A : Set) : Set := {{x} | x ∈ A}

-- Define an ordinal-indexed construction by transfinite recursion.
noncomputable transfinite def stages (α : Ordinal) : Set
  | 0 => empty
  | succ β => 𝒫(stages β)
  | limit λ => ⋃ { stages β | β < λ }

-- Recurse through set membership using a checked history graph.
noncomputable foundation def memberLayers (x : Set) : Set
  | x using history => 𝒫(history)

-- Recurse over a set with a certified well-founded relation.
noncomputable well-founded def rankOn (A x : Set) : Set
  over A ordered by membershipOn(A)
  certified by membershipOn.wellFounded
  | x using history => 𝒫(history)

-- The graph is a set-valued object, and its application has a proved value.
theorem inclusion_value (A B x : Set)
  requires subset : A ⊆ B
  requires member : x ∈ A
  shows inclusionMap(A, B)(x) = x
proof
  exact inclusionMap.value with subset, member

-- Selection is justified under the same existence hypothesis.
theorem selected_member (A : Set)
  requires inhabited : ∃ x ∈ A, x = x
  shows selected(A) ∈ A
proof
  have exists : ∃ x, x ∈ A
    rcases inhabited with ⟨x, member, equal⟩
    refine ⟨x, member⟩
  have chosen := selected.selected with exists
  tauto
