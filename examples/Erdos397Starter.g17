module Erdos397Starter
import Grace.Cumulus.NumberTheory.Erdos397

-- Binomial coefficients compute: C(6, 3) = 20 and C(10, 5) = 252.
theorem central_three
  shows central(3) = 20
proof
  compute

theorem central_five
  shows central(5) = 252
proof
  compute

-- The first member of the family, a = 2 and c = 49:
-- C(4, 2) · C(12, 6) · C(98, 49) = C(6, 3) · C(8, 4) · C(100, 50).
theorem first_solution
  shows central(2) * (central(6) * central(49)) = central(3) * (central(4) * central(50))
proof
  simp

-- Its indices are distinct, as the problem requires.
theorem first_solution_indices
  shows 2 ≠ 2 * 2 + 2 ∧ 2 ≠ 8 * 2 * 2 + 8 * 2 + 1 ∧ 2 * 2 + 2 ≠ 8 * 2 * 2 + 8 * 2 + 1
proof
  have two : 2 ≤ 2 by arith
  have all := erdos397.distinct with two
  rcases all with ⟨left, rest⟩
  exact left
