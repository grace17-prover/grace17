module PolynomialEvaluation
import Grace.Cumulus.Algebra.Polynomial.EvaluationHom

section Evaluation
variable (I A add zero neg mul one h e : Set)
hypothesis coefficients : IsCommRing(A, add, zero, neg, mul, one)
hypothesis character : MonomialCharacter(I, A, mul, one, h)
hypothesis evaluation : e = polynomialEvaluate(I, A, add, zero, neg, mul, one, h)
notation ring R := (A, add, zero, neg, mul, one)
notation ring P := R[I]

theorem evaluate_product (p q : Set)
  requires hp : p ∈ P
  requires hq : q ∈ P
  shows e(P[p * q]) = R[e(p) * e(q)]
proof
  have hom := polynomialEvaluate.hom at I, A, add, zero, neg, mul, one, h with *
  rw evaluation
  exact IsRingHom.mul with hom, hp, hq

theorem evaluate_sum (p q : Set)
  requires hp : p ∈ P
  requires hq : q ∈ P
  shows e(P[p + q]) = R[e(p) + e(q)]
proof
  have hom := polynomialEvaluate.hom at I, A, add, zero, neg, mul, one, h with *
  rw evaluation
  exact IsRingHom.add with hom, hp, hq

theorem evaluate_constant (a : Set)
  requires ha : a ∈ R
  shows e(polynomialConstant(I, A, zero, a)) = a
proof
  rw evaluation
  exact polynomialEvaluate.constant at I, A, add, zero, neg, mul, one, h, a with *

end Evaluation
