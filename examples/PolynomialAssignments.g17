module PolynomialAssignments
import Grace.Cumulus.Algebra.Polynomial.Assignment

section Evaluation
variable (I A add zero neg mul one v e : Set)
hypothesis coefficients : IsCommRing(A, add, zero, neg, mul, one)
hypothesis assignment : v : I → A
hypothesis evaluation : e = polynomialAt(I, A, add, zero, neg, mul, one, v)
notation ring R := (A, add, zero, neg, mul, one)
notation ring P := R[I]

theorem evaluate_variable (j : Set)
  requires hj : j ∈ I
  shows e(polynomialVariable(I, A, zero, one, j)) = v(j)
proof
  rw evaluation
  exact polynomialAt.variable at I, A, add, zero, neg, mul, one, v, j with *

theorem evaluate_product (p q : Set)
  requires hp : p ∈ P
  requires hq : q ∈ P
  shows e(P[p * q]) = R[e(p) * e(q)]
proof
  have hom := polynomialAt.hom at I, A, add, zero, neg, mul, one, v with *
  rw evaluation
  exact IsRingHom.mul with hom, hp, hq

theorem evaluate_constant (a : Set)
  requires ha : a ∈ R
  shows e(polynomialConstant(I, A, zero, a)) = a
proof
  rw evaluation
  exact polynomialAt.constant at I, A, add, zero, neg, mul, one, v, a with *

end Evaluation

section Certificates
variable (I A add zero neg mul one : Set)
hypothesis coefficients : IsCommRing(A, add, zero, neg, mul, one)
hypothesis nontrivial : Nontrivial(A, zero, one)
notation ring R := (A, add, zero, neg, mul, one)
notation ring P := R[I]

-- This applies to every polynomial p, hence in particular to p = X_j.
-- The certificate 1*p + 1*(1-p) = 1 is discharged by ring automation.
theorem incompatible_equations (p : Set)
  requires hp : p ∈ P
  shows ¬(∃ v, PolynomialCommonZero(I, A, add, zero, neg, mul, one, {p, P[1 - p]}, v))
proof
  have source := polynomials.comm_ring at I, A, add, zero, neg, mul, one with *
  have ordinary := IsCommRing.ring with source
  have multiplicative := IsRing.multiplicative with ordinary
  have unit := IsMonoid.unit_in_carrier with multiplicative
  have negative := IsRing.neg_closed with ordinary, hp
  have complement := IsRing.add_closed with ordinary, unit, negative
  have generators : {p, P[1 - p]} ⊆ P by settle with Subset, pair.membership
  have first : p ∈ {p, P[1 - p]} by settle with pair.membership
  have second : P[1 - p] ∈ {p, P[1 - p]} by settle with pair.membership
  have identity : P[1 * p + 1 * (1 - p)] = P[1] by ring
  exact polynomialIdeal.no_common_zero_of_combination at I, A, add, zero, neg, mul, one, {p, P[1 - p]}, p, P[1 - p], P[1], P[1] with *

end Certificates
