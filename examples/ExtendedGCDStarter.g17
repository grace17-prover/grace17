module ExtendedGCDStarter
import Grace.Cumulus.NumberTheory

theorem all_inputs (a b : Nat)
  shows integerLinearCombination(bezoutLeft(a, b), bezoutRight(a, b), a, b) = integerOfNat(gcd(a, b))
proof
  exact bezout.correct at a, b with *

-- The algorithm returns 4 and -5: 252*4 + 198*(-5) = 18.
theorem left_coefficient
  shows bezoutLeft(252, 198) = integerOfNat(4)
proof
  simp

theorem right_coefficient
  shows bezoutRight(252, 198) = integerNegativeOfNat(5)
proof
  simp

theorem gcd_value
  shows gcd(252, 198) = 18
proof
  compute

theorem computed_identity
  shows integerLinearCombination(integerOfNat(4), integerNegativeOfNat(5), 252, 198) = integerOfNat(18)
proof
  have identity := bezout.correct at 252, 198 with *
  rw left_coefficient at identity
  rw right_coefficient at identity
  rw gcd_value at identity
  exact identity
