module GraphCountingStarter
import Grace.Cumulus.GraphTheory.Counting

theorem degree_sum_is_twice_edges (V E enumeration : Set, n : Nat)
  requires graph : SimpleGraph(V, E)
  requires vertices : BijectiveBetween(enumeration, n, V)
  shows GraphCount.degreeSum(E, enumeration, n, n) =
    2 * GraphCount.edgeCount(E, enumeration, n)
proof
  exact SimpleGraph.handshaking with assumption, graph, vertices

theorem degree_counts_neighbors (V E enumeration x : Set, n : Nat)
  requires vertices : ∀ i ∈ n, enumeration[i] ∈ V
  shows GraphCount.degree(E, enumeration, x, n) =
    countMembers(neighbors(V, E, x), enumeration, n)
proof
  exact GraphCount.degree.neighbors with assumption, vertices
