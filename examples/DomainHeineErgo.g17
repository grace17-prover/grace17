module DomainHeineErgo
import Grace.Cumulus.Real.Analysis

theorem constant_interval_uniform (A B L : Real)
  shows UniformContinuousOnDomain(
    constantFunction(closedInterval(A, B), ℝ, L), closedInterval(A, B))
proof
  have subset := closedInterval.subset_reals at A, B with assumption, assumption
  have continuous := constantFunction.continuous_on_domain at
    closedInterval(A, B), L with subset
  exact closedInterval.heine_cantor_on_domain at
    constantFunction(closedInterval(A, B), ℝ, L), A, B with
      assumption, assumption, continuous
