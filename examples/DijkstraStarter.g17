module DijkstraStarter
import Grace.Cumulus.GraphTheory

-- A directed graph with six vertices; vertex 5 is unreachable from 0.
theorem sample_distances
  shows Dijkstra.distances(DijkstraExamples.result) =
    List.cons(DijkstraExamples.weight(0), List.cons(DijkstraExamples.weight(7),
      List.cons(DijkstraExamples.weight(3), List.cons(DijkstraExamples.weight(9),
        List.cons(DijkstraExamples.weight(5),
          List.cons(DijkstraExamples.absent, List.nil))))))
proof
  simp

-- Zero-weight edges are traversed; they are not confused with missing edges.
theorem zero_weight_edges
  shows Dijkstra.distances(Dijkstra.solve(4, 0, DijkstraExamples.zeroRows)) =
    List.cons(DijkstraExamples.weight(0), List.cons(DijkstraExamples.weight(0),
      List.cons(DijkstraExamples.weight(0),
        List.cons(DijkstraExamples.weight(1), List.nil))))
proof
  simp
