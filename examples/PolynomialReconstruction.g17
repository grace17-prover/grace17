module PolynomialReconstruction
import Grace.Cumulus.Algebra.Polynomial.HornerReconstruction

section Polynomials
variable (I A add z neg mul one p j : Set)
notation ring R := (A, add, z, neg, mul, one)
notation ring P := R[I]
hypothesis ring : IsCommRing(R)
hypothesis polynomial : p ∈ P
hypothesis index : j ∈ I

theorem representation
  shows ∃ cs, List(P, cs) ∧ coefficientsOmitVariable(I, A, z, j, cs) ∧ polynomialFromCoefficients(I, R, j, cs) = p
proof
  exact polynomials.exists_coefficient_horner with *

theorem reconstruction (cs : List(P))
  requires coefficients : ∀ n, Nat(n) → listCoefficient{P}(P[0], cs, n) = polynomialVariableCoefficient(I, R, p, j, n)
  shows polynomialFromCoefficients(I, R, j, cs) = p
proof
  exact polynomialFromCoefficients.reconstruct with *

theorem nonzero_representation
  requires nonzero : p ≠ P[0]
  shows ∃ cs, List(P, cs) ∧ coefficientsOmitVariable(I, A, z, j, cs) ∧ polynomialFromCoefficients(I, R, j, cs) = p ∧ (∃ n ∈ ℕ, listCoefficient{P}(P[0], cs, n) ≠ P[0])
proof
  exact polynomials.exists_nonzero_coefficient_horner with *

theorem evaluation (v : Set) (cs : List(P))
  requires assignment : v : I → R
  requires coefficients : ∀ n, Nat(n) → listCoefficient{P}(P[0], cs, n) = polynomialVariableCoefficient(I, R, p, j, n)
  shows polynomialAt(I, R, v)(p) = hornerAt{A}(add, mul, z, v(j), listMap{P}(polynomialAt(I, R, v), cs))
proof
  exact polynomialAt.reconstruction with *

end Polynomials
