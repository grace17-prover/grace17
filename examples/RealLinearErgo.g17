module RealLinearErgo
import Grace.Cumulus.Real.Analysis.HeineCantor

theorem add_bounds (x y u v : Real)
  requires first : x < y
  requires second : u < v
  shows x + u < y + v
proof
  linarith

theorem mixed_bounds (x y z : Real)
  requires first : x ≤ y
  requires second : y < z
  shows x < z
proof
  linarith
