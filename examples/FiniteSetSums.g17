module FiniteSetSums
import Grace.Cumulus.Algebra.CoefficientSingle
import Grace.Cumulus.Algebra.Ring.FiniteSetSum

section Sums
variable (V A add zero neg mul one w : Set)
hypothesis ring : IsCommRing(A, add, zero, neg, mul, one)
hypothesis weights : w : V → A
notation ring R := (A, add, zero, neg, mul, one)

theorem enumeration_independent (f g : Set, n m : Nat)
  requires first : BijectiveBetween(f, n, V)
  requires second : BijectiveBetween(g, m, V)
  shows indexedRingSum(w, f, add, zero, n) = indexedRingSum(w, g, add, zero, m)
proof
  exact indexedRingSum.reindex at A, add, zero, neg, mul, one, w, V, f, g, n, m with *

theorem evaluate_with_any_enumeration (f : Set, n : Nat)
  requires enumeration : BijectiveBetween(f, n, V)
  shows finiteRingSum(V, A, add, zero, neg, mul, one, w) = indexedRingSum(w, f, add, zero, n)
proof
  exact finiteRingSum.enumeration at V, A, add, zero, neg, mul, one, w, f, n with *

theorem scalar_linearity (a : Set)
  requires finite : Finite(V)
  requires scalar : a ∈ A
  shows finiteRingSum(V, A, add, zero, neg, mul, one, coefficientScale(V, A, add, zero, neg, mul, one, a, w)) =
    a * finiteRingSum(V, A, add, zero, neg, mul, one, w)
proof
  exact finiteRingSum.scale with ring, finite, weights, scalar

theorem single_nonzero_support (a j : Set)
  requires coefficient : a ∈ A
  requires index : j ∈ V
  requires nonzero : a ≠ zero
  shows functionSupport(coefficientSingle(V, A, zero, a, j), V, zero) = {j}
proof
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  exact coefficientSingle.support_nonzero with zeroIn, coefficient, index, nonzero

end Sums
