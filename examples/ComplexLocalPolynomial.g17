import Grace.Cumulus.Complex.LocalPolynomial

section Complexes
notation ring C := (complexCarrier, complexAdd, complexZero, complexNeg, complexMul, complexOne)

theorem local_normal_form (c a : Set) (cs : List(C))
  requires coefficient : c ∈ C
  requires center : a ∈ C
  shows ∃ n ∈ ℕ, ∃ ds, List(C, ds) ∧ complexPolynomial(ds)(C[0]) ≠ C[0] ∧
    length{C}(cs) = Grace.Core.Nat.Rec.add(n, length{C}(ds)) ∧
    ComplexContinuous(complexPolynomial(ds)) ∧
    (∀ h ∈ C, complexPolynomial(c :: cs)(C[a + h]) = C[complexPolynomial(c :: cs)(a) + monoidPow(C, h, succ(n)) * complexPolynomial(ds)(h)])
proof
  exact complexPolynomial.local_normal_form at c, a, cs with *

theorem isolated_root (c a : Set) (cs : List(C))
  requires coefficient : c ∈ C
  requires center : a ∈ C
  requires root : complexPolynomial(c :: cs)(a) = C[0]
  shows ∃ d ∈ ℝ, realZero < d ∧
    (∀ h ∈ C, h ≠ C[0] → complexNormSquared(h) < d → complexPolynomial(c :: cs)(C[a + h]) ≠ C[0])
proof
  exact complexPolynomial.isolated_root at c, a, cs with *

end Complexes
