module NullstellensatzExample
import Grace.Cumulus.Algebra.Polynomial.Nullstellensatz

section Fields
variable (I A add zero neg mul one G : Set)
notation ring R := (A, add, zero, neg, mul, one)
notation ring P := R[I]
hypothesis closed : IsAlgebraicallyClosed(R)
hypothesis finite : Finite(I)
hypothesis generators : G ⊆ P

theorem unit_iff_unsatisfiable
  shows P[1] ∈ idealSpan(P, G) ↔ ¬(∃ v, PolynomialCommonZero(I, A, add, zero, neg, mul, one, G, v))
proof
  exact polynomialIdeal.unit_iff_no_common_zero with *

theorem certificate_iff_unsatisfiable
  shows (∃ terms, List(idealProducts(P, G), terms) ∧ P[1] = ringSum{idealProducts(P, G)}(polynomialAdd(I, R), P[0], terms)) ↔ ¬(∃ v, PolynomialCommonZero(I, A, add, zero, neg, mul, one, G, v))
proof
  exact polynomialIdeal.finite_certificate_iff_no_common_zero with *

end Fields
