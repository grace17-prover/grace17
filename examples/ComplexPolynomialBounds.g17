module ComplexPolynomialBoundsExample
import Grace.Cumulus.Complex.PolynomialBounds

section Bounds
notation ring C := (complexCarrier, complexAdd, complexZero, complexNeg, complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

theorem evaluate (leading z : Set) (radius : Real) (cs : List(complexCarrier))
  requires initial : leading ∈ C
  requires element : z ∈ C
  requires nonnegative : realZero ≤ radius
  requires within : complexNormSquared(z) ≤ radius
  shows complexNormSquared(hornerAt{complexCarrier}(complexAdd, complexMul, leading, z, cs)) ≤ complexHornerBound(leading, radius, cs)
proof
  exact complexHornerBound.bounds with *

theorem bounded (radius : Real) (cs : List(complexCarrier))
  requires nonnegative : realZero ≤ radius
  shows ∃ bound ∈ ℝ, realZero ≤ bound ∧ (∀ z ∈ C, complexNormSquared(z) ≤ radius → complexNormSquared(complexPolynomial(cs)(z)) ≤ bound)
proof
  exact complexPolynomial.bounded_on_disk with *

-- For each fixed center a, one constant controls every x in the disk.
theorem difference (a c : Set) (radius : Real) (cs : List(complexCarrier))
  requires center : a ∈ C
  requires coefficient : c ∈ C
  requires nonnegative : realZero ≤ radius
  shows ∃ bound ∈ ℝ, realZero ≤ bound ∧ (∀ x ∈ C, complexNormSquared(x) ≤ radius → complexNormSquared(C[complexPolynomial(c :: cs)(x) - complexPolynomial(c :: cs)(a)]) ≤ R[complexNormSquared(C[x - a]) * bound])
proof
  exact complexPolynomial.difference_bound_on_disk with *

end Bounds
