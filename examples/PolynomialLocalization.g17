module PolynomialLocalization
import Grace.Cumulus.Algebra.Polynomial.LocalizationObstruction
import Grace.Cumulus.Algebra.Field.IntegralDescent

section Embeddings
variable (I A add zero neg mul one B plus z minus times unit g v s j : Set)
notation ring R := (A, add, zero, neg, mul, one)
notation ring P := R[I]
notation ring S := (B, plus, z, minus, times, unit)
hypothesis coefficients : IsField(R)
hypothesis field : IsField(S)
hypothesis embedding : IsRingHom(g, P, S)
hypothesis injective : InjectiveBetween(g, P, S)
hypothesis assignment : v : I → R
hypothesis polynomial : s ∈ P
hypothesis nonvanishing : polynomialAt(I, R, v)(s) ≠ R[0]
hypothesis index : j ∈ I

theorem cannot_exhaust_field
  shows localizationWithin(S, functionImage(g, P, S), functionImage(g, denominatorPowers(P, s), S)) ≠ S
proof
  exact polynomialLocalization.proper_at_point with *

end Embeddings
section Localizations
variable (I A add zero neg mul one B plus z minus times unit g v s j T : Set)
notation ring R := (A, add, zero, neg, mul, one)
notation ring P := R[I]
notation ring S := (B, plus, z, minus, times, unit)
hypothesis coefficients : IsField(R)
hypothesis target : IsCommRing(S)
hypothesis embedding : IsRingHom(g, P, S)
hypothesis injective : InjectiveBetween(g, P, S)
hypothesis assignment : v : I → R
hypothesis polynomial : s ∈ P
hypothesis nonvanishing : polynomialAt(I, R, v)(s) ≠ R[0]
hypothesis index : j ∈ I

notation ring L := S ↾ T
hypothesis carrier : T = localizationWithin(S, functionImage(g, P, S), functionImage(g, denominatorPowers(P, s), S))

theorem not_a_field
  shows ¬IsField(L)
proof
  exact polynomialLocalization.not_field_at_point with *

section IntegralExtensions
variable (C sum o inverse product e f : Set)
notation ring F := (C, sum, o, inverse, product, e)
hypothesis localRing : IsCommRing(L)
hypothesis field : IsField(F)
hypothesis hom : IsRingHom(f, L, F)
hypothesis faithful : InjectiveBetween(f, L, F)

theorem cannot_have_integral_field_extension
  shows ¬(∀ y ∈ F, IntegralOver(f, L, F, y))
proof
  have obstruction : ¬IsField(L)
    exact polynomialLocalization.not_field_at_point with *
  intro integral
  have contradiction : IsField(L)
    exact IsField.of_integral_extension with *
  exact obstruction with contradiction

end IntegralExtensions
end Localizations
