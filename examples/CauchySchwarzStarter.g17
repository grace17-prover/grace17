module CauchySchwarzStarter
import Grace.Cumulus.LinearAlgebra

theorem cauchy_schwarz (u v : Set, n : Nat)
  requires sequenceU : RealSequence(u)
  requires sequenceV : RealSequence(v)
  shows (dotProduct(u, v, n):R) * (dotProduct(u, v, n):R) ≤
    (squaredNorm(u, n):R) * (squaredNorm(v, n):R)
proof
  exact dotProduct.cauchy_schwarz at u, v, n with *

theorem equality_for_scalar_multiples (v : Set, C : Real, n : Nat)
  requires sequence : RealSequence(v)
  shows (dotProduct(mulSequence(constantSequence(C), v), v, n):R) *
      (dotProduct(mulSequence(constantSequence(C), v), v, n):R) =
    (squaredNorm(mulSequence(constantSequence(C), v), n):R) * (squaredNorm(v, n):R)
proof
  exact dotProduct.cauchy_schwarz_scalar_equality at v, C, n with *

-- The zero-vector alternative is essential, including at dimension zero.
theorem equality_characterization (u v : Set, n : Nat)
  requires sequenceU : RealSequence(u)
  requires sequenceV : RealSequence(v)
  shows (dotProduct(u, v, n):R) * (dotProduct(u, v, n):R) =
      (squaredNorm(u, n):R) * (squaredNorm(v, n):R) ↔
    (squaredNorm(v, n) = (0:R) ∨
      (∃ C ∈ ℝ, (∀ i ∈ ℕ, i < n → u[i] = C * (v[i]:R))))
proof
  exact dotProduct.cauchy_schwarz_equality_iff at u, v, n with *

theorem zero_norm_means_zero_coordinates (u : Set, n : Nat)
  requires sequence : RealSequence(u)
  shows squaredNorm(u, n) = (0:R) ↔ (∀ i ∈ ℕ, i < n → u[i] = (0:R))
proof
  exact squaredNorm.eq_zero_iff at u, n with *
