module EuclideanDistance
import Grace.Cumulus.Geometry.Angle

-- Distances are square roots of squared distances; the square root is a
-- real function, defined from the least-upper-bound property.
theorem distance_squared (a b : Point)
  shows distance(a, b) * distance(a, b) = distanceSquared(a, b)
proof
  exact distance.square at a, b with *

-- The triangle inequality for Euclidean distance in the plane.
theorem triangle (a b c : Point)
  shows distance(a, c) ≤ distance(a, b) + distance(b, c)
proof
  exact distance.triangle at a, b, c with *

-- The law of cosines, with the cosine of the angle at b.
theorem cosines (a b c : Point)
  requires firstRay : a ≠ b
  requires secondRay : c ≠ b
  shows distanceSquared(a, c) =
    distanceSquared(a, b) + distanceSquared(b, c) - 2 * (distance(a, b) * distance(b, c) * cosAngle(a, b, c))
proof
  exact law_of_cosines at a, b, c with *

-- A right angle has cosine zero, so the law of cosines becomes Pythagoras.
theorem right_angle_cosine (a b c : Point)
  requires firstRay : a ≠ b
  requires secondRay : c ≠ b
  requires right : RightAngle(a, b, c)
  shows cosAngle(a, b, c) = 0
proof
  have positive := rayProduct.positive at a, b, c with *
  have product := cosAngle.mul_rays at a, b, c with *
  unfold RightAngle at right
  rw right at product
  have nonzero : distance(b, a) * distance(b, c) ≠ 0
    intro zero
    rw zero at positive
    exact realLess.not_self with realZero.real, positive
  have cosReal := cosAngle.real at a, b, c with *
  have productReal : Real(distance(b, a) * distance(b, c)) by typecheck
  have zeroProduct : 0 * (distance(b, a) * distance(b, c)) = 0 by exact realMulValue.zero_left with productReal
  have equation : cosAngle(a, b, c) * (distance(b, a) * distance(b, c)) = 0 * (distance(b, a) * distance(b, c))
    rw zeroProduct
    exact product
  have le := realLe.reflexive at cosAngle(a, b, c) * (distance(b, a) * distance(b, c)) with *
  have forward : cosAngle(a, b, c) * (distance(b, a) * distance(b, c)) ≤ 0 * (distance(b, a) * distance(b, c))
    rw ← equation
    exact le
  have backward : 0 * (distance(b, a) * distance(b, c)) ≤ cosAngle(a, b, c) * (distance(b, a) * distance(b, c))
    rw ← equation
    exact le
  have upper := realLe.mul_right_cancel_positive at cosAngle(a, b, c), realZero, distance(b, a) * distance(b, c) with *
  have lower := realLe.mul_right_cancel_positive at realZero, cosAngle(a, b, c), distance(b, a) * distance(b, c) with *
  exact realLe.antisymmetric at cosAngle(a, b, c), realZero with *
