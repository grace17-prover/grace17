module PolynomialConvolution
import Grace.Cumulus.Algebra.Polynomial.IdealSupport

section Polynomials
variable (I A add zero neg mul one : Set)
hypothesis ring : IsCommRing(A, add, zero, neg, mul, one)

theorem multiply (p q : Set)
  requires memberP : p ∈ polynomials(I, A, zero)
  requires memberQ : q ∈ polynomials(I, A, zero)
  shows polynomialProduct(I, A, add, zero, neg, mul, one, p, q) ∈ polynomials(I, A, zero)
proof
  exact polynomialProduct.member at I, A, add, zero, neg, mul, one, p, q with *

-- A nonzero product coefficient must have a contributing pair of monomials.
-- Cancellation can remove such coefficients, so this is only one direction.
theorem supported_product_has_factors (p q m : Set)
  requires memberP : p ∈ polynomials(I, A, zero)
  requires memberQ : q ∈ polynomials(I, A, zero)
  requires supported : m ∈ functionSupport(polynomialProduct(I, A, add, zero, neg, mul, one, p, q), monomials(I), zero)
  shows ∃ u ∈ functionSupport(p, monomials(I), zero), ∃ v ∈ functionSupport(q, monomials(I), zero), m = monomialProduct(I, u, v)
proof
  exact polynomialProduct.support_factor at I, A, add, zero, neg, mul, one, p, q, m with *

theorem zero_product (p : Set)
  requires memberP : p ∈ polynomials(I, A, zero)
  shows polynomialProduct(I, A, add, zero, neg, mul, one, p, constantFunction(monomials(I), A, zero)) = constantFunction(monomials(I), A, zero)
proof
  exact polynomialProduct.zero_right at I, A, add, zero, neg, mul, one, p with *

theorem ideal_absorbs_product (U p q : Set)
  requires ideal : MonomialIdeal(I, U)
  requires memberP : p ∈ monomialIdealPolynomials(I, A, zero, U)
  requires memberQ : q ∈ polynomials(I, A, zero)
  shows polynomialProduct(I, A, add, zero, neg, mul, one, p, q) ∈ monomialIdealPolynomials(I, A, zero, U)
proof
  exact monomialIdealPolynomials.mul_right at I, A, add, zero, neg, mul, one, U, p, q with *

-- Combine multiplication closure with the finite generators from Dickson.
theorem finite_generators_cover_product (U p q : Set)
  requires variables : Finite(I)
  requires ideal : MonomialIdeal(I, U)
  requires memberP : p ∈ monomialIdealPolynomials(I, A, zero, U)
  requires memberQ : q ∈ polynomials(I, A, zero)
  shows ∃ B, Finite(B) ∧ B ⊆ U ∧
    (∀ m ∈ functionSupport(polynomialProduct(I, A, add, zero, neg, mul, one, p, q), monomials(I), zero), ∃ b ∈ B, MonomialDivides(I, b, m))
proof
  have data := monomialIdealPolynomials.membership.forward with memberP
  have product := polynomialProduct.member at I, A, add, zero, neg, mul, one, p, q with *
  have inIdeal := monomialIdealPolynomials.mul_right at I, A, add, zero, neg, mul, one, U, p, q with *
  obtain ⟨B, finite, subset, description⟩ := monomialIdealPolynomials.finite_description at I, A, zero, U with *
  have equivalence := description with polynomialProduct(I, A, add, zero, neg, mul, one, p, q), product
  refine ⟨B, finite, subset, _⟩
  tauto

end Polynomials
