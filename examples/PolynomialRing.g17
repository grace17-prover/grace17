module PolynomialRing
import Grace.Cumulus.Algebra.Polynomial.IdealSupport

section Polynomials
variable (I A add zero neg mul one : Set)
hypothesis coefficients : IsCommRing(A, add, zero, neg, mul, one)
notation ring R := (A, add, zero, neg, mul, one)
notation ring P := R[I]

theorem square_of_sum (p q : Set)
  requires hp : p ∈ P
  requires hq : q ∈ P
  shows (p + q) * (p + q) = p * p + p * q + p * q + q * q
proof
  ring

theorem difference_of_squares (p q : Set)
  requires hp : p ∈ P
  requires hq : q ∈ P
  shows (p + q) * (p - q) = p * p - q * q
proof
  ring

theorem reassociate_and_cancel (p q r : Set)
  requires hp : p ∈ P
  requires hq : q ∈ P
  requires hr : r ∈ P
  shows ((p * q) * r + p) - p = p * (q * r)
proof
  ring

theorem unit_laws (p : Set)
  requires hp : p ∈ P
  shows 1 * p + p * 0 = p
proof
  ring

theorem monomial_support_is_an_ideal (U : Set)
  requires monomialIdeal : MonomialIdeal(I, U)
  shows IsIdeal(polynomials(I, A, zero), polynomialAdd(I, A, add, zero, neg, mul, one), constantFunction(monomials(I), A, zero), polynomialNeg(I, A, add, zero, neg, mul, one), polynomialMul(I, A, add, zero, neg, mul, one), monomialIdealPolynomials(I, A, zero, U))
proof
  exact monomialIdealPolynomials.ideal with coefficients, monomialIdeal

end Polynomials
