module CharacteristicMonicExample
import Grace.Cumulus.Algebra.Polynomial.CharacteristicMonic

section Polynomials
variable (I A add zero neg mul one j : Set)
notation ring R := (A, add, zero, neg, mul, one)
notation ring P := R[I]
hypothesis ring : IsCommRing(R)
hypothesis index : j ∈ I

theorem affine_determinant (n : Nat) (M B D : Set)
  requires matrixM : RingMatrix(n, P, M)
  requires matrixB : RingMatrix(n, R, B)
  requires matrixD : RingMatrix(n, R, D)
  requires entries : ∀ r ∈ n, ∀ c ∈ n, M[r, c] = P[polynomialCoefficients(I, R)(B[r, c]) + polynomialCoefficients(I, R)(D[r, c]) * polynomialVariable(I, R, j)]
  shows HornerForm(I, R, j, determinant(n, P, M), n, determinant(n, R, D))
proof
  exact determinant.affine_horner with *

theorem monic (n : Nat) (M : Set)
  requires matrix : RingMatrix(n, R, M)
  shows ∃ cs, List(A, cs) ∧ length{A}(cs) = n ∧ characteristicPolynomial(n, I, R, M, j) = polynomialFromHorner(I, R, j, R[1], cs)
proof
  exact characteristicPolynomial.monic with *

theorem add_forms (p q n a b : Set)
  requires first : HornerForm(I, R, j, p, n, a)
  requires second : HornerForm(I, R, j, q, n, b)
  shows HornerForm(I, R, j, P[p + q], n, R[a + b])
proof
  exact HornerForm.add with *

end Polynomials

section Extensions
variable (A add zero neg mul one B plus z minus times unit f : Set)
notation ring R := (A, add, zero, neg, mul, one)
notation ring S := (B, plus, z, minus, times, unit)
hypothesis source : IsCommRing(R)
hypothesis target : IsCommRing(S)
hypothesis hom : IsRingHom(f, R, S)

theorem common_annihilator (n : Nat) (M N x w : Set)
  requires matrixM : RingMatrix(n, R, M)
  requires matrixN : RingMatrix(n, S, N)
  requires entries : ∀ r ∈ n, ∀ c ∈ n, N[r, c] = f(M[r, c])
  requires element : x ∈ S
  requires eigenvector : LeftEigenvector(n, S, N, x, w)
  shows ∃ cs, List(A, cs) ∧ length{A}(cs) = n ∧ (∀ k ∈ n, S[monicValue(R, f, S, x, cs) * w(k)] = S[0])
proof
  exact LeftEigenvector.monic_annihilator with *

end Extensions
