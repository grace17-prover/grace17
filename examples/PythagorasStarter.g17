module PythagorasStarter
import Grace.Cumulus.Geometry

theorem right_triangle (a₁ a₂ b₁ b₂ c₁ c₂ : Real)
  requires right : Plane.RightAt(a₁, a₂, b₁, b₂, c₁, c₂)
  shows Plane.distanceSquared(a₁, a₂, b₁, b₂) =
    Plane.distanceSquared(a₁, a₂, c₁, c₂) + Plane.distanceSquared(b₁, b₂, c₁, c₂)
proof
  exact Plane.pythagoras at a₁, a₂, b₁, b₂, c₁, c₂ with
    assumption, assumption, assumption, assumption, assumption, assumption, right

theorem coordinate_axes (x y : Real)
  shows Plane.distanceSquared(x, 0, 0, y) = x * x + y * y
proof
  unfold Plane.distanceSquared
  ring
