module Determinants
import Grace.Cumulus.Algebra.CoefficientMatrix
import Grace.Cumulus.Algebra.Ring.DeterminantZero

section Rings
variable (A add zero neg mul one M : Set)
notation ring R := (A, add, zero, neg, mul, one)
hypothesis ring : IsCommRing(R)

theorem value_is_in_ring (n : Nat)
  requires matrix : RingMatrix(n, R, M)
  shows determinant(n, R, M) ∈ R
proof
  exact determinant.closed with *

theorem empty_determinant
  requires matrix : RingMatrix(∅, R, M)
  shows determinant(∅, R, M) = R[1]
proof
  exact determinant.empty with *

theorem equal_entries (n : Nat) (N : Set)
  requires matrix : RingMatrix(n, R, M)
  requires other : RingMatrix(n, R, N)
  requires entries : ∀ i ∈ n, ∀ j ∈ n, M[i, j] = N[i, j]
  shows determinant(n, R, M) = determinant(n, R, N)
proof
  exact determinant.congr with *

theorem zero_row (n : Nat) (i : Set)
  requires matrix : RingMatrix(n, R, M)
  requires row : i ∈ n
  requires vanishes : ∀ j ∈ n, M[i, j] = R[0]
  shows determinant(n, R, M) = R[0]
proof
  exact determinant.zero_row with *

end Rings

section Algebras
variable (A add zero neg mul one B plus z minus times unit f x : Set)
notation ring R := (A, add, zero, neg, mul, one)
notation ring S := (B, plus, z, minus, times, unit)
hypothesis source : IsCommRing(R)
hypothesis target : IsCommRing(S)
hypothesis hom : IsRingHom(f, R, S)
hypothesis element : x ∈ S

theorem select_all_multiplication_rows
  requires finiteModule : FiniteAlgebraModule(f, R, S)
  shows ∃ xs, List(B, xs) ∧ linearSpan(f, R, S, listSupport{B}(xs)) = S ∧
    (∃ C, Finite(C) ∧ (∀ cs ∈ C, List(A, cs) ∧ ListOps.length{A}(cs) = ListOps.length{B}(xs)) ∧
      (∃ rows, FunctionBetween(rows, listSupport{B}(xs), C) ∧
        (∀ g ∈ listSupport{B}(xs), S[x * g] = linearCombination(R, S, f, xs, rows(g)))))
proof
  exact FiniteAlgebraModule.multiplication_rows with *

end Algebras
