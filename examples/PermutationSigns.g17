module PermutationSigns
import Grace.Cumulus.Algebra.Ring.PermutationSign

section Rings
variable (A add zero neg mul one : Set)
notation ring R := (A, add, zero, neg, mul, one)
hypothesis ring : IsCommRing(R)

theorem exchange_reverses_sign (n : Nat) (a b p : Set)
  requires ha : a ∈ n
  requires hb : b ∈ n
  requires distinct : a ≠ b
  requires permutation : p ∈ permutations(n)
  shows permutationSign(n, A, add, zero, neg, mul, one, permutationExchange(n, a, b)(p)) = R[-permutationSign(n, A, add, zero, neg, mul, one, p)]
proof
  exact permutationSign.exchange with *

theorem equal_rows_vanish (n : Nat) (a b M : Set)
  requires matrix : RingMatrix(n, R, M)
  requires ha : a ∈ n
  requires hb : b ∈ n
  requires distinct : a ≠ b
  requires rows : ∀ j ∈ n, M[a, j] = M[b, j]
  shows determinant(n, R, M) = R[0]
proof
  exact determinant.equal_rows with *

end Rings

theorem fresh_insertion_counts (S a : Set)
  requires finite : Finite(S)
  requires fresh : ¬(a ∈ S)
  shows cardinality(insert(a, S)) = succ(cardinality(S))
proof
  exact cardinality.insert with *
