-- Authors: Grant Passmore

module AlgebraAdjoin
import Grace.Cumulus.Algebra.Adjoin

section Algebras
variable (A add zero neg mul one B plus z minus times unit f : Set)
notation ring R := (A, add, zero, neg, mul, one)
notation ring S := (B, plus, z, minus, times, unit)
hypothesis source : IsCommRing(R)
hypothesis target : IsCommRing(S)
hypothesis hom : IsRingHom(f, R, S)

theorem adjoining_in_stages (G H : Set)
  requires generators : G ⊆ S
  requires more : H ⊆ S
  shows algebraAdjoin(f, R, S, algebraAdjoin(f, R, S, G) ∪ H) = algebraAdjoin(f, R, S, G ∪ H)
proof
  exact algebraAdjoin.union at A, add, zero, neg, mul, one, B, plus, z, minus, times, unit, f, G, H with *

theorem no_generators_gives_coefficients
  shows algebraAdjoin(f, R, S, ∅) = functionImage(f, R, S)
proof
  exact algebraAdjoin.empty at A, add, zero, neg, mul, one, B, plus, z, minus, times, unit, f with *

theorem scalar_closure (T a x : Set)
  requires subalgebra : Subalgebra(f, R, S, T)
  requires scalar : a ∈ R
  requires element : x ∈ T
  shows S[f(a) * x] ∈ T
proof
  exact Subalgebra.scalar_mul_mem at A, add, zero, neg, mul, one, B, plus, z, minus, times, unit, f, T, a, x with *

theorem surjective_coefficients_generate
  requires onto : SurjectiveBetween(f, R, S)
  shows FinitelyGeneratedAlgebra(f, R, S)
proof
  exact FinitelyGeneratedAlgebra.of_surjective at A, add, zero, neg, mul, one, B, plus, z, minus, times, unit, f with *

end Algebras
