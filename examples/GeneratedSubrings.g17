module GeneratedSubrings
import Grace.Cumulus.Algebra.Ring.GeneratedSubring

section Generation
variable (A add zero neg mul one : Set)
notation ring R := (A, add, zero, neg, mul, one)
hypothesis ring : IsCommRing(R)

theorem generated_elements_stay_in_subring (G S : Set)
  requires subring : IsSubring(R, S)
  requires generators : G ⊆ S
  shows generatedSubring(R, G) ⊆ S
proof
  exact generatedSubring.least at A, add, zero, neg, mul, one, G, S with *

theorem generating_twice_changes_nothing (G : Set)
  shows generatedSubring(R, generatedSubring(R, G)) = generatedSubring(R, G)
proof
  exact generatedSubring.idempotent at A, add, zero, neg, mul, one, G with *

theorem a_subring_generates_itself (S : Set)
  requires subring : IsSubring(R, S)
  shows generatedSubring(R, S) = S
proof
  exact generatedSubring.eq_of_subring at A, add, zero, neg, mul, one, S with *

end Generation
