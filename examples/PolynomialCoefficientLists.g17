module PolynomialCoefficientLists
import Grace.Cumulus.Algebra.Polynomial.CoefficientHorner

section Polynomials
variable (I A add z neg mul one j : Set)
notation ring R := (A, add, z, neg, mul, one)
notation ring P := R[I]
hypothesis ring : IsCommRing(R)

theorem coefficient_list (p : Set)
  requires polynomial : p ∈ P
  requires index : j ∈ I
  shows ∃ cs, List(P, cs) ∧ (∀ n, Nat(n) → listCoefficient{P}(P[0], cs, n) = polynomialVariableCoefficient(I, R, p, j, n))
proof
  have zeroIn : R[0] ∈ R by typecheck
  exact polynomialCoefficientFamily.list_representation with *

theorem horner_is_polynomial (cs : List(P))
  shows polynomialFromCoefficients(I, R, j, cs) ∈ P
proof
  exact polynomialFromCoefficients.member with *

theorem evaluate_horner (v : Set) (cs : List(P))
  requires assignment : v : I → R
  requires index : j ∈ I
  shows polynomialAt(I, R, v)(polynomialFromCoefficients(I, R, j, cs)) = hornerAt{A}(add, mul, z, v(j), listMap{P}(polynomialAt(I, R, v), cs))
proof
  exact polynomialAt.coefficient_horner with *

end Polynomials
