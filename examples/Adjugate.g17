module AdjugateExample
import Grace.Cumulus.Algebra.Ring.DeterminantKernel

section Rings
variable (A add zero neg mul one : Set)
notation ring R := (A, add, zero, neg, mul, one)
hypothesis ring : IsCommRing(R)

theorem diagonal (n : Nat) (M i : Set)
  requires matrix : RingMatrix(n, R, M)
  requires row : i ∈ n
  shows matrixProductEntry(n, R, M, adjugate(n, R, M), i, i) = determinant(n, R, M)
proof
  exact adjugate.right_diagonal with *

theorem off_diagonal (n : Nat) (M i j : Set)
  requires matrix : RingMatrix(n, R, M)
  requires row : i ∈ n
  requires column : j ∈ n
  requires distinct : i ≠ j
  shows matrixProductEntry(n, R, M, adjugate(n, R, M), i, j) = R[0]
proof
  exact adjugate.right_off_diagonal with *

theorem annihilate (n : Nat) (M v j : Set)
  requires matrix : RingMatrix(n, R, M)
  requires kernel : LeftKernelVector(n, R, M, v)
  requires index : j ∈ n
  shows determinant(n, R, M) * v(j) = R[0]
proof
  exact determinant.annihilates_left_kernel with *

-- Over a domain, a nonzero kernel coordinate forces the determinant to vanish.
theorem singular (n : Nat) (M v j : Set)
  requires domain : IsIntegralDomain(R)
  requires matrix : RingMatrix(n, R, M)
  requires kernel : LeftKernelVector(n, R, M, v)
  requires index : j ∈ n
  requires nonzero : v(j) ≠ R[0]
  shows determinant(n, R, M) = R[0]
proof
  exact determinant.zero_of_nonzero_left_kernel with *

end Rings
