module DeterminantRows
import Grace.Cumulus.Algebra.Ring.DeterminantRows

section Rings
variable (A add zero neg mul one : Set)
notation ring R := (A, add, zero, neg, mul, one)
hypothesis ring : IsCommRing(R)

theorem add_row (n : Nat) (M N i r a : Set)
  requires matrixM : RingMatrix(n, R, M)
  requires matrixN : RingMatrix(n, R, N)
  requires row : i ∈ n
  requires source : r ∈ n
  requires distinct : i ≠ r
  requires scalar : a ∈ R
  requires outside : ∀ k ∈ n, k ≠ i → ∀ j ∈ n, N[k, j] = M[k, j]
  requires entries : ∀ j ∈ n, N[i, j] = M[i, j] + a * M[r, j]
  shows determinant(n, R, N) = determinant(n, R, M)
proof
  exact determinant.row_add_multiple with *

theorem scale_row (n : Nat) (M N i a : Set)
  requires matrixM : RingMatrix(n, R, M)
  requires matrixN : RingMatrix(n, R, N)
  requires row : i ∈ n
  requires scalar : a ∈ R
  requires outside : ∀ k ∈ n, k ≠ i → ∀ j ∈ n, N[k, j] = M[k, j]
  requires entries : ∀ j ∈ n, N[i, j] = a * M[i, j]
  shows determinant(n, R, N) = a * determinant(n, R, M)
proof
  exact determinant.row_scale with *

end Rings
