module NullstellensatzReduction
import Grace.Cumulus.Algebra.Polynomial.NullstellensatzReduction

section Residues
variable (I A add zero neg mul one G : Set)
notation ring R := (A, add, zero, neg, mul, one)
notation ring P := R[I]
hypothesis field : IsField(R)
hypothesis generators : G ⊆ P
-- This is the remaining obligation. It is not asserted as an axiom or hidden in a definition.
hypothesis residues : ∀ J, IsMaximalIdeal(P, J) → SurjectiveBetween(polynomialResidueCoefficients(I, R, J), R, (P ⧸ idealRelation(P, J)))

theorem unit_certificate_iff_unsatisfiable_given_residue_surjectivity
  shows P[1] ∈ idealSpan(P, G) ↔ ¬(∃ v, PolynomialCommonZero(I, A, add, zero, neg, mul, one, G, v))
proof
  exact polynomialIdeal.unit_iff_no_common_zero_of_residue_surjectivity with field, residues, generators

end Residues
