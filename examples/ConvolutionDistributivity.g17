module ConvolutionDistributivity
import Grace.Cumulus.Algebra.Polynomial.Distributivity

section Rings
variable (A add zero neg mul one : Set)
hypothesis ring : IsCommRing(A, add, zero, neg, mul, one)

theorem two_stage_grouping (D C B h k w : Set)
  requires finiteD : Finite(D)
  requires finiteC : Finite(C)
  requires weights : w : D → A
  requires firstMap : h : D → C
  requires secondMap : k : C → B
  shows finitePushforward(C, B, A, add, zero, neg, mul, one, k, finitePushforward(D, C, A, add, zero, neg, mul, one, h, w)) =
    finitePushforward(D, B, A, add, zero, neg, mul, one, compose(k, h, D, C, B), w)
proof
  exact finitePushforward.compose with ring, finiteD, weights, firstMap, secondMap, finiteC

theorem singleton_groups (D w : Set)
  requires finite : Finite(D)
  requires weights : w : D → A
  shows finitePushforward(D, D, A, add, zero, neg, mul, one, identity(D), w) = w
proof
  exact finitePushforward.identity with ring, finite, weights

theorem distribute_right (I p q r : Set)
  requires memberP : p ∈ polynomials(I, A, zero)
  requires memberQ : q ∈ polynomials(I, A, zero)
  requires memberR : r ∈ polynomials(I, A, zero)
  shows polynomialProduct(I, A, add, zero, neg, mul, one, p, coefficientAdd(monomials(I), A, add, zero, neg, mul, one, q, r)) =
    coefficientAdd(monomials(I), A, add, zero, neg, mul, one, polynomialProduct(I, A, add, zero, neg, mul, one, p, q), polynomialProduct(I, A, add, zero, neg, mul, one, p, r))
proof
  exact polynomialProduct.add_right with ring, memberP, memberQ, memberR

theorem distribute_left (I p q r : Set)
  requires memberP : p ∈ polynomials(I, A, zero)
  requires memberQ : q ∈ polynomials(I, A, zero)
  requires memberR : r ∈ polynomials(I, A, zero)
  shows polynomialProduct(I, A, add, zero, neg, mul, one, coefficientAdd(monomials(I), A, add, zero, neg, mul, one, p, q), r) =
    coefficientAdd(monomials(I), A, add, zero, neg, mul, one, polynomialProduct(I, A, add, zero, neg, mul, one, p, r), polynomialProduct(I, A, add, zero, neg, mul, one, q, r))
proof
  exact polynomialProduct.add_left with ring, memberP, memberQ, memberR

end Rings
