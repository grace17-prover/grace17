module FiniteRegrouping
import Grace.Cumulus.Algebra.Ring.Regrouping

section Rings
variable (A add zero neg mul one : Set)
hypothesis ring : IsCommRing(A, add, zero, neg, mul, one)

theorem rows_equal_columns (D E w : Set)
  requires finiteD : Finite(D)
  requires finiteE : Finite(E)
  requires matrix : w : D × E → A
  shows finiteDoubleSum(D, E, A, add, zero, neg, mul, one, w) = finiteDoubleSum(E, D, A, add, zero, neg, mul, one, transposedMatrix(D, E, A, w))
proof
  exact finiteDoubleSum.interchange with ring, finiteD, finiteE, matrix

-- No injectivity is assumed: different inputs may go to the same group.
theorem regroup (D C h w : Set)
  requires finiteD : Finite(D)
  requires finiteC : Finite(C)
  requires weights : w : D → A
  requires indexMap : h : D → C
  shows finiteRingSum(C, A, add, zero, neg, mul, one, finitePushforward(D, C, A, add, zero, neg, mul, one, h, w)) = finiteRingSum(D, A, add, zero, neg, mul, one, w)
proof
  exact finitePushforward.sum with ring, weights, finiteD, finiteC, indexMap

-- All collisions are allowed, even when every input has the same output.
theorem one_group (D w c : Set)
  requires finite : Finite(D)
  requires weights : w : D → A
  shows finitePushforward(D, {c}, A, add, zero, neg, mul, one, constantFunction(D, {c}, c), w)(c) = finiteRingSum(D, A, add, zero, neg, mul, one, w)
proof
  exact finitePushforward.constant_index at D, A, add, zero, neg, mul, one, w, c with *

-- The ambient codomain need not be finite: sum over the finite image.
theorem regroup_image (D C h w : Set)
  requires finite : Finite(D)
  requires weights : w : D → A
  requires indexMap : h : D → C
  shows finiteRingSum(functionImage(h, D, C), A, add, zero, neg, mul, one, finitePushforward(D, functionImage(h, D, C), A, add, zero, neg, mul, one, h, w)) = finiteRingSum(D, A, add, zero, neg, mul, one, w)
proof
  exact finitePushforward.sum_image with ring, weights, finite, indexMap

end Rings
