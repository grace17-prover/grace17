module ClassicalResultsStarter
import Grace.Cumulus.NumberTheory
import Grace.Cumulus.Real

-- The principle of induction as a theorem about subsets of ℕ.
theorem naturals_in_closed_set (S : Set)
  requires base : 0 ∈ S
  requires step : ∀ n ∈ ℕ, n ∈ S → n + 1 ∈ S
  shows 5 ∈ S
proof
  have fiveNat : Nat(5) by typecheck
  have five := nat.omega.forward with fiveNat
  exact natural.induction at S with *, 5, five

-- √2 is not 7/5, or any other ratio of naturals.
theorem root_two_not_seven_fifths
  shows √2 ≠ realNat(7) / realNat(5)
proof
  have fiveNonzero : 5 ≠ 0
    intro zero
    have positive : 0 < 5 by arith
    rw zero at positive
    exact Less.irreflexive with *, positive
  exact sqrtTwo.ne_quotient at 7, 5 with *

-- The arithmetic mean dominates the geometric mean.
theorem mean_bound (a b : Real)
  requires nonnegativeA : 0 ≤ a
  requires nonnegativeB : 0 ≤ b
  shows √(a * b) ≤ (a + b) / 2
proof
  exact sqrt.le_mean at a, b with *

-- 123 written by its digits, least significant first, and its digit sum.
theorem one_two_three
  shows digitsValue([3, 2, 1]) = 123
proof
  compute

theorem one_two_three.digit_sum
  shows digitSum([3, 2, 1]) = 6
proof
  compute

theorem one_two_three.divisible
  shows 3 ∣ digitsValue([3, 2, 1])
proof
  have digits : 3 ∣ digitSum([3, 2, 1])
    have sum := one_two_three.digit_sum
    rw sum
    unfold Divides
    witness 2
    compute
  exact digitsValue.three_divides_iff.backward at [3, 2, 1] with *
