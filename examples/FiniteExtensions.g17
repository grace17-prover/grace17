module FiniteExtensions
import Grace.Cumulus.Algebra.IntegralFinite
import Grace.Cumulus.Algebra.FiniteModuleTower

section QuadraticRoots
variable (A add zero neg mul one B plus z minus times unit f x y a b : Set)
notation ring R := (A, add, zero, neg, mul, one)
notation ring S := (B, plus, z, minus, times, unit)
hypothesis source : IsCommRing(R)
hypothesis target : IsCommRing(S)
hypothesis hom : IsRingHom(f, R, S)
hypothesis xIn : x ∈ S
hypothesis yIn : y ∈ S
hypothesis aIn : a ∈ R
hypothesis bIn : b ∈ R
hypothesis squareX : S[x * x] = f(a)
hypothesis squareY : S[y * y] = f(b)

theorem two_quadratic_roots
  shows FiniteSpan(f, R, S, algebraAdjoin(f, R, S, insert(x, {y})))
proof
  have integralX := IntegralOver.of_square with source, target, hom, xIn, aIn, squareX
  have integralY := IntegralOver.of_square with source, target, hom, yIn, bIn, squareY
  have single := Finite.singleton at y
  have finite := Finite.insert at {y}, x with single
  have bounded : insert(x, {y}) ⊆ S
    unfold Subset
    intros u hu
    simp [insert.membership, singleton.membership]
  have integral : ∀ u ∈ insert(x, {y}), IntegralOver(f, R, S, u)
    intros u hu
    have casesU := insert.membership.forward with hu
    cases casesU with equal | member
    . rw equal
      exact integralX
    . have equal := singleton.membership.forward at u, y with member
      rw equal
      exact integralY
  exact integralGenerators.finite_adjoin with source, target, hom, finite, bounded, integral

end QuadraticRoots

section Towers
variable (A add zero neg mul one B plus z minus times unit C sum o inverse product e f g : Set)
notation ring R := (A, add, zero, neg, mul, one)
notation ring S := (B, plus, z, minus, times, unit)
notation ring U := (C, sum, o, inverse, product, e)
hypothesis fieldR : IsField(R)
hypothesis fieldS : IsField(S)
hypothesis target : IsCommRing(U)
hypothesis mapRS : IsRingHom(f, R, S)
hypothesis mapSU : IsRingHom(g, S, U)

theorem algebraic_tower_is_finite
  requires generatedS : FinitelyGeneratedAlgebra(f, R, S)
  requires algebraicS : ∀ x ∈ S, AlgebraicOver(f, R, S, x)
  requires generatedU : FinitelyGeneratedAlgebra(g, S, U)
  requires algebraicU : ∀ x ∈ U, AlgebraicOver(g, S, U, x)
  shows FiniteAlgebraModule(compose(g, f, R, S, U), R, U)
proof
  have ringR := IsField.comm_ring with fieldR
  have ringS := IsField.comm_ring with fieldS
  have finiteS := FinitelyGeneratedAlgebra.finite_module_of_algebraic with fieldR, ringS, mapRS, generatedS, algebraicS
  have finiteU := FinitelyGeneratedAlgebra.finite_module_of_algebraic with fieldS, target, mapSU, generatedU, algebraicU
  exact FiniteAlgebraModule.tower with ringR, ringS, target, mapRS, mapSU, finiteS, finiteU

end Towers
