module ProjectionStarter
import Grace.Cumulus.LinearAlgebra

theorem perpendicular_error (u v : RealSequence, n : Nat)
  requires nonzero : squaredNorm(v, n) ≠ 0
  shows Orthogonal(subSequence(u, lineProjection(u, v, n)), v, n)
proof
  exact lineProjection.orthogonal at u, v, n with *

theorem best_approximation (u v : RealSequence, C : Real, n : Nat)
  requires nonzero : squaredNorm(v, n) ≠ 0
  shows lineDistanceSquared(u, v, projectionCoefficient(u, v, n), n) ≤
    lineDistanceSquared(u, v, C, n)
proof
  exact lineProjection.minimum at u, v, C, n with *

theorem unique_best_coefficient (u v : RealSequence, C : Real, n : Nat)
  requires nonzero : squaredNorm(v, n) ≠ 0
  requires minimizing : lineDistanceSquared(u, v, C, n) ≤
    lineDistanceSquared(u, v, projectionCoefficient(u, v, n), n)
  shows C = projectionCoefficient(u, v, n)
proof
  exact lineProjection.unique_minimizer at u, v, C, n with *

-- This is one unnormalized Gram–Schmidt step in any finite dimension.
theorem orthogonal_decomposition (u v : RealSequence, n : Nat)
  requires nonzero : squaredNorm(v, n) ≠ 0
  shows squaredNorm(u, n) = squaredNorm(lineProjection(u, v, n), n) +
    squaredNorm(orthogonalResidual(u, v, n), n)
proof
  exact orthogonalResidual.pythagorean at u, v, n with *

theorem projecting_twice (u v : RealSequence, n : Nat)
  requires nonzero : squaredNorm(v, n) ≠ 0
  shows lineProjection(lineProjection(u, v, n), v, n) = lineProjection(u, v, n)
proof
  exact lineProjection.idempotent at u, v, n with *
