module InvolutionCancellation
import Grace.Cumulus.Algebra.Ring.DeterminantCancellation

section Rings
variable (D A add zero neg mul one w t : Set)
notation ring R := (A, add, zero, neg, mul, one)
hypothesis ring : IsCommRing(R)

theorem paired_sum
  requires finite : Finite(D)
  requires weights : w : D → A
  requires involution : InvolutionOn(t, D)
  requires opposite : ∀ a ∈ D, w(t(a)) = R[-w(a)]
  requires fixed : ∀ a ∈ D, t(a) = a → w(a) = R[0]
  shows finiteRingSum(D, A, add, zero, neg, mul, one, w) = R[0]
proof
  exact finiteRingSum.involution with *

theorem paired_sum_without_fixed_points
  requires finite : Finite(D)
  requires weights : w : D → A
  requires involution : InvolutionOn(t, D)
  requires opposite : ∀ a ∈ D, w(t(a)) = R[-w(a)]
  requires free : ∀ a ∈ D, t(a) ≠ a
  shows finiteRingSum(D, A, add, zero, neg, mul, one, w) = R[0]
proof
  exact finiteRingSum.involution_free with *

theorem paired_determinant (n : Nat) (M : Set)
  requires matrix : RingMatrix(n, R, M)
  requires involution : InvolutionOn(t, permutations(n))
  requires free : ∀ p ∈ permutations(n), t(p) ≠ p
  requires signs : ∀ p ∈ permutations(n), permutationSign(n, A, add, zero, neg, mul, one, t(p)) = R[-permutationSign(n, A, add, zero, neg, mul, one, p)]
  requires products : ∀ p ∈ permutations(n), finiteRingProduct(n, A, add, zero, neg, mul, one, permutationEntries(n, A, M, t(p))) = finiteRingProduct(n, A, add, zero, neg, mul, one, permutationEntries(n, A, M, p))
  shows determinant(n, R, M) = R[0]
proof
  exact determinant.cancel_pairs with *

end Rings
