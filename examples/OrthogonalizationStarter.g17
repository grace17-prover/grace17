module OrthogonalizationStarter
import Grace.Cumulus.LinearAlgebra

theorem preserve_previous_direction (u v w : RealSequence, n : Nat)
  requires old : Orthogonal(u, w, n)
  requires directions : Orthogonal(v, w, n)
  shows Orthogonal(orthogonalResidual(u, v, n), w, n)
proof
  exact orthogonalResidual.preserve_orthogonal at u, v, w, n with *

theorem perpendicular_to_both (u v w : RealSequence, n : Nat)
  requires nonzeroV : squaredNorm(v, n) ≠ 0
  requires nonzeroW : squaredNorm(w, n) ≠ 0
  requires perpendicular : Orthogonal(v, w, n)
  shows Orthogonal(orthogonalResidual(orthogonalResidual(u, v, n), w, n), v, n) ∧
    Orthogonal(orthogonalResidual(orthogonalResidual(u, v, n), w, n), w, n)
proof
  exact orthogonalResidual.orthogonal_pair at u, v, w, n with *

theorem order_independent (u v w : RealSequence, n i : Nat)
  requires perpendicular : Orthogonal(v, w, n)
  shows orthogonalResidual(orthogonalResidual(u, v, n), w, n)[i] =
    orthogonalResidual(orthogonalResidual(u, w, n), v, n)[i]
proof
  exact orthogonalResidual.commute at u, v, w, n, i with *

theorem three_part_energy (u v w : RealSequence, n : Nat)
  requires nonzeroV : squaredNorm(v, n) ≠ 0
  requires nonzeroW : squaredNorm(w, n) ≠ 0
  requires perpendicular : Orthogonal(v, w, n)
  shows squaredNorm(u, n) = squaredNorm(lineProjection(u, v, n), n) +
    squaredNorm(lineProjection(u, w, n), n) +
    squaredNorm(orthogonalResidual(orthogonalResidual(u, v, n), w, n), n)
proof
  exact orthogonalResidual.two_step_pythagorean at u, v, w, n with *

-- The two orthogonal components capture at most the original squared length.
theorem captured_energy (u v w : RealSequence, n : Nat)
  requires nonzeroV : squaredNorm(v, n) ≠ 0
  requires nonzeroW : squaredNorm(w, n) ≠ 0
  requires perpendicular : Orthogonal(v, w, n)
  shows squaredNorm(lineProjection(u, v, n), n) +
    squaredNorm(lineProjection(u, w, n), n) ≤ squaredNorm(u, n)
proof
  exact lineProjection.bessel_pair at u, v, w, n with *
