module PolynomialTranscendence
import Grace.Cumulus.Algebra.Polynomial.TranscendenceLocalization

section Transfer
variable (I J A add z neg mul one : Set)
notation ring R := (A, add, z, neg, mul, one)
notation ring P := R[I]
notation ring Q := R[J]
hypothesis source : IsCommRing(R)

theorem retain_used_variables (p : Set)
  requires polynomial : p ∈ P
  requires supported : polynomialVariablesUsed(I, R, p) ⊆ J
  shows polynomialTransfer(J, I, R)(polynomialTransfer(I, J, R)(p)) = p
proof
  exact polynomialTransfer.roundtrip with *

theorem inclusion_is_injective
  requires subset : I ⊆ J
  shows InjectiveBetween(polynomialTransfer(I, J, R), P, Q)
proof
  exact polynomialTransfer.injective with *

theorem retain_nonzero_coefficients (p : Set)
  requires polynomial : p ∈ P
  requires supported : polynomialVariablesUsed(I, R, p) ⊆ J
  requires nonzero : p ≠ P[0]
  shows polynomialTransfer(I, J, R)(p) ≠ Q[0]
proof
  exact polynomialTransfer.nonzero_supported with *

theorem omitted_variable_is_one (i : Set)
  requires index : i ∈ I
  requires outside : ¬(i ∈ J)
  shows polynomialTransfer(I, J, R)(polynomialVariable(I, R, i)) = Q[1]
proof
  exact polynomialTransfer.outside_variable with *

end Transfer
section Localization
variable (A add z neg mul one B plus o minus times unit f K : Set)
notation ring R := (A, add, z, neg, mul, one)
notation ring S := (B, plus, o, minus, times, unit)
hypothesis source : IsCommRing(R)
hypothesis field : IsField(S)
hypothesis hom : IsRingHom(f, R, S)
hypothesis injective : InjectiveBetween(f, R, S)

theorem localize_an_algebraic_element (x : Set)
  requires algebraic : AlgebraicOver(f, R, S, x)
  shows ∃ a ∈ R, a ≠ R[0] ∧
    IntegralOver(identity(localizationWithin(S, functionImage(f, R, S), denominatorPowers(S, f(a)))), localizationWithin(S, functionImage(f, R, S), denominatorPowers(S, f(a))), S, x)
proof
  exact AlgebraicOver.exists_principal_integral with *

theorem one_localization_for_a_finite_family
  requires finite : Finite(K)
  requires algebraic : ∀ x ∈ K, AlgebraicOver(f, R, S, x)
  shows ∃ s ∈ R, s ≠ R[0] ∧ (∀ x ∈ K,
    IntegralOver(identity(localizationWithin(S, functionImage(f, R, S), denominatorPowers(S, f(s)))), localizationWithin(S, functionImage(f, R, S), denominatorPowers(S, f(s))), S, x))
proof
  exact AlgebraicOver.finite_principal_integral with *

end Localization
section Families
variable (I M A add z neg mul one B plus o minus times unit f v : Set)
notation ring R := (A, add, z, neg, mul, one)
notation ring S := (B, plus, o, minus, times, unit)
notation ring Q := R[M]
hypothesis source : IsCommRing(R)
hypothesis field : IsField(S)
hypothesis hom : IsRingHom(f, R, S)
hypothesis assignment : v : I → S
hypothesis subset : M ⊆ I
hypothesis independent : AlgebraicallyIndependent(M, R, S, f, restrict(v, M))
hypothesis maximal : ∀ T, T ⊆ I → M ⊆ T → AlgebraicallyIndependent(T, R, S, f, restrict(v, T)) → T = M

theorem all_generators_are_algebraic
  shows ∀ x ∈ functionImage(v, I, S), AlgebraicOver(polynomialAtOver(M, R, S, f, restrict(v, M)), Q, S, x)
proof
  exact AlgebraicallyIndependent.maximal_generators_algebraic with *

theorem finite_over_one_localization
  requires finite : Finite(I)
  requires generates : algebraAdjoin(f, R, S, functionImage(v, I, S)) = S
  shows ∃ s ∈ Q, s ≠ Q[0] ∧ (∃ T,
    T = localizationWithin(S, functionImage(polynomialAtOver(M, R, S, f, restrict(v, M)), Q, S), denominatorPowers(S, polynomialAtOver(M, R, S, f, restrict(v, M))(s))) ∧
    FiniteAlgebraModule(identity(T), T, S))
proof
  exact AlgebraicallyIndependent.maximal_finite_module with *

end Families
