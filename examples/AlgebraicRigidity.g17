module AlgebraicRigidity
import Grace.Cumulus.Algebra.Field.Rigidity

section Extensions
variable (A add zero neg mul one B plus z minus times unit f : Set)
notation ring R := (A, add, zero, neg, mul, one)
notation ring S := (B, plus, z, minus, times, unit)
hypothesis closed : IsAlgebraicallyClosed(R)
hypothesis field : IsField(S)
hypothesis hom : IsRingHom(f, R, S)

theorem algebraic_element (x : Set)
  requires algebraic : AlgebraicOver(f, R, S, x)
  shows ∃ a ∈ R, f(a) = x
proof
  exact IsAlgebraicallyClosed.algebraic_in_image with *

theorem no_proper_algebraic_extension
  requires algebraic : ∀ x ∈ S, AlgebraicOver(f, R, S, x)
  shows SurjectiveBetween(f, R, S)
proof
  exact IsAlgebraicallyClosed.algebraic_extension_surjective with *

end Extensions
