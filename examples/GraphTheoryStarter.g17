module GraphTheoryStarter
import Grace.Cumulus.GraphTheory

theorem neighbors_are_mutual (V E x y : Set)
  requires graph : SimpleGraph(V, E)
  requires hx : x ∈ V
  requires neighbor : y ∈ neighbors(V, E, x)
  shows x ∈ neighbors(V, E, y)
proof
  exact neighbors.symmetric with graph, hx, neighbor

theorem induced_graph_is_subgraph (V E W : Set)
  requires graph : SimpleGraph(V, E)
  requires vertices : W ⊆ V
  shows Subgraph(V, E, W, inducedEdges(E, W))
proof
  exact inducedEdges.subgraph with graph, vertices

theorem triangle_has_three_distinct_vertices (V E x y z : Set)
  requires graph : SimpleGraph(V, E)
  requires triangle : Triangle(E, x, y, z)
  shows x ≠ y ∧ y ≠ z ∧ z ≠ x
proof
  exact Triangle.distinct with graph, triangle

theorem complement_twice (V E : Set)
  requires graph : SimpleGraph(V, E)
  shows complementEdges(V, complementEdges(V, E)) = E
proof
  exact complementEdges.involution with graph

theorem vertices_cannot_enumerate_all_independent_subsets (V f : Set)
  shows ¬SurjectiveBetween(f, V, independentSets(V, empty))
proof
  exact Independent.no_surjection_from_vertices

theorem path_certificate (V E weights source labels target cost : Set)
  requires feasible : PathPotential(V, E, weights, source, labels)
  requires targetIn : target ∈ V
  requires costNat : Nat(cost)
  requires path : HasPathCost(V, E, weights, source, target, cost)
  requires label : labels(target) = cost
  shows ShortestPathCost(V, E, weights, source, target, cost)
proof
  exact PathPotential.certifies_shortest at V, E, weights, source, labels,
    target, cost with feasible, targetIn, costNat, path, label
